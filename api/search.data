1945":60788,"_41947":60791,"_41949":60794,"_41951":60797,"_41953":60800,"_41955":60803,"_41957":60806,"_41959":60809,"_41961":60812,"_41963":60815,"_41965":60818,"_41967":60821,"_41969":60824,"_41971":60827,"_41973":60830,"_41975":60833,"_41977":60836,"_41979":60839,"_41981":60842,"_41983":60845,"_41985":60848,"_41987":60851,"_41989":60854,"_41991":60857,"_41993":60860,"_41995":60863,"_41997":60866,"_41999":60869,"_42001":60872,"_31347":60875,"_42005":60878,"_42007":60881,"_42009":60884},{"_3706":15,"_31461":15,"_5":15367,"_3094":51310,"_31799":51311,"_21806":51315,"_28616":15},"Deploy from AWS Marketplace",[51312,51313,51314],"Docs","Deployment","Other models",[],{"_3706":16,"_31461":15,"_21806":51317,"_5":15007,"_28616":15,"_3094":51318},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3706":17,"_31461":15,"_5":31796,"_21806":51320,"_28616":51321,"_3094":51322},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3706":18,"_31461":15,"_5":31796,"_21806":51324,"_28616":51325,"_3094":51326},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3706":19,"_31461":15,"_5":31796,"_21806":51328,"_28616":51329,"_3094":51330},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3706":20,"_31461":15,"_5":31796,"_21806":51332,"_28616":51333,"_3094":51334},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3706":21,"_31461":15,"_5":31796,"_21806":51336,"_28616":51337,"_3094":51338},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3706":22,"_31461":15,"_5":31796,"_21806":51340,"_28616":51341,"_3094":51342},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3706":23,"_31461":15,"_5":31796,"_21806":51344,"_28616":51345,"_3094":51346},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3706":24,"_31461":15,"_21806":51348,"_5":15007,"_28616":15,"_3094":51349},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3706":25,"_31461":15,"_21806":51351,"_5":15007,"_28616":51321,"_3094":51352},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3706":26,"_31461":15,"_21806":51354,"_5":15007,"_28616":51321,"_3094":51355},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3706":27,"_31461":15,"_21806":51357,"_5":15007,"_28616":51321,"_3094":51358},[],"A security group allowing the necessary endpoints.",{"_3706":28,"_31461":15,"_21806":51360,"_5":15007,"_28616":51325,"_3094":51361},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3706":29,"_31461":15,"_21806":51363,"_5":15007,"_28616":51325,"_3094":51364},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3706":30,"_31461":15,"_21806":51366,"_5":15007,"_28616":51325,"_3094":51367},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3706":31,"_31461":15,"_21806":51369,"_5":15007,"_28616":51329,"_3094":51370},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3706":32,"_31461":15,"_21806":51372,"_5":15007,"_28616":51333,"_3094":51373},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3706":33,"_31461":15,"_21806":51375,"_5":15007,"_28616":51337,"_3094":51376},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3706":34,"_31461":15,"_21806":51378,"_5":15007,"_28616":51341,"_3094":51379},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3706":35,"_31461":15,"_21806":51381,"_5":15007,"_28616":51345,"_3094":51382},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3706":36,"_31461":36,"_5":15367,"_3094":51384,"_31799":51385,"_21806":51386,"_28616":36},"Deploy Lamassu",[51312,51313],[],{"_3706":37,"_31461":36,"_21806":51388,"_5":15007,"_28616":36,"_3094":51389},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3706":38,"_31461":36,"_5":31796,"_21806":51391,"_28616":51392,"_3094":51393},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3706":39,"_31461":36,"_5":31796,"_21806":51395,"_28616":51396,"_3094":51397},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3706":40,"_31461":36,"_5":31796,"_21806":51399,"_28616":51400,"_3094":51401},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3706":41,"_31461":36,"_21806":51403,"_5":15007,"_28616":36,"_3094":51404},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3706":42,"_31461":36,"_21806":51406,"_5":15007,"_28616":51392,"_3094":51407},[],"Model",{"_3706":43,"_31461":36,"_21806":51409,"_5":15007,"_28616":51392,"_3094":51410},[],"Recommended for",{"_3706":44,"_31461":36,"_21806":51412,"_5":15007,"_28616":51392,"_3094":51413},[],"Who operates the infrastructure",{"_3706":45,"_31461":36,"_21806":51415,"_5":15007,"_28616":51392,"_3094":51416},[],"Starting point",{"_3706":46,"_31461":36,"_21806":51418,"_5":15007,"_28616":51392,"_3094":51419},[],"Kubernetes self-managed",{"_3706":47,"_31461":36,"_21806":51421,"_5":15007,"_28616":51392,"_3094":51422},[],"Production, regulated environments and custom deployments",{"_3706":48,"_31461":36,"_21806":51424,"_5":15007,"_28616":51392,"_3094":51425},[],"Your team",{"_3706":49,"_31461":36,"_21806":51427,"_5":15007,"_28616":51392,"_3094":51428},[],"Helm or Fastlane",{"_3706":50,"_31461":36,"_21806":51430,"_5":15007,"_28616":51392,"_3094":51431},[],"AWS Marketplace",{"_3706":51,"_31461":36,"_21806":51433,"_5":15007,"_28616":51392,"_3094":51434},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3706":52,"_31461":36,"_21806":51436,"_5":15007,"_28616":51392,"_3094":51425},[],{"_3706":53,"_31461":36,"_21806":51438,"_5":15007,"_28616":51392,"_3094":51439},[],"Preconfigured image on EC2",{"_3706":54,"_31461":36,"_21806":51441,"_5":15007,"_28616":51392,"_3094":51442},[],"SaaS",{"_3706":55,"_31461":36,"_21806":51444,"_5":15007,"_28616":51392,"_3094":51445},[],"Teams that want to use the platform without operating it",{"_3706":56,"_31461":36,"_21806":51447,"_5":15007,"_28616":51392,"_3094":51448},[],"Lamassu",{"_3706":57,"_31461":36,"_21806":51450,"_5":15007,"_28616":51392,"_3094":51451},[],"Managed subscription",{"_3706":58,"_31461":36,"_21806":51453,"_5":15007,"_28616":51392,"_3094":51454},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3706":59,"_31461":36,"_21806":51456,"_5":15007,"_28616":51392,"_3094":51457},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3706":60,"_31461":36,"_21806":51459,"_5":15007,"_28616":51392,"_3094":51460},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3706":61,"_31461":36,"_21806":51462,"_5":15007,"_28616":51396,"_3094":51463},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3706":62,"_31461":36,"_21806":51465,"_5":15007,"_28616":51400,"_3094":51466},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3706":63,"_31461":63,"_5":15367,"_3094":51468,"_31799":51469,"_21806":51470,"_28616":63},"Use Lamassu as SaaS",[51312,51313,51314],[],{"_3706":64,"_31461":63,"_21806":51472,"_5":15007,"_28616":63,"_3094":51473},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3706":65,"_31461":63,"_5":31796,"_21806":51475,"_28616":51476,"_3094":51477},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3706":66,"_31461":63,"_5":31796,"_21806":51479,"_28616":51480,"_3094":51481},[],"/docs/deployment/saas#plans","Plans",{"_3706":67,"_31461":63,"_5":31796,"_21806":51483,"_28616":51484,"_3094":51485},[],"/docs/deployment/saas#request-access","Request access",{"_3706":68,"_31461":63,"_21806":51487,"_5":15007,"_28616":63,"_3094":51488},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3706":69,"_31461":63,"_21806":51490,"_5":15007,"_28616":51476,"_3094":51491},[],"Platform availability and maintenance.",{"_3706":70,"_31461":63,"_21806":51493,"_5":15007,"_28616":51476,"_3094":51494},[],"Automatic backups.",{"_3706":71,"_31461":63,"_21806":51496,"_5":15007,"_28616":51476,"_3094":51497},[],"Version upgrades.",{"_3706":72,"_31461":63,"_21806":51499,"_5":15007,"_28616":51476,"_3094":51500},[],"Technical support and SLA according to your plan.",{"_3706":73,"_31461":63,"_21806":51502,"_5":15007,"_28616":51480,"_3094":51503},[],"Plan",{"_3706":74,"_31461":63,"_21806":51505,"_5":15007,"_28616":51480,"_3094":51506},[],"Devices",{"_3706":75,"_31461":63,"_21806":51508,"_5":15007,"_28616":51480,"_3094":51509},[],"Support",{"_3706":76,"_31461":63,"_21806":51511,"_5":15007,"_28616":51480,"_3094":51512},[],"SLA",{"_3706":77,"_31461":63,"_21806":51514,"_5":15007,"_28616":51480,"_3094":51515},[],"Starter",{"_3706":78,"_31461":63,"_21806":51517,"_5":15007,"_28616":51480,"_3094":51518},[],"Up to 1,000",{"_3706":79,"_31461":63,"_21806":51520,"_5":15007,"_28616":51480,"_3094":51521},[],"Email",{"_3706":80,"_31461":63,"_21806":51523,"_5":15007,"_28616":51480,"_3094":51524},[],"99.5 %",{"_3706":81,"_31461":63,"_21806":51526,"_5":15007,"_28616":51480,"_3094":51527},[],"Professional",{"_3706":82,"_31461":63,"_21806":51529,"_5":15007,"_28616":51480,"_3094":51530},[],"Up to 10,000",{"_3706":83,"_31461":63,"_21806":51532,"_5":15007,"_28616":51480,"_3094":51533},[],"Email and chat",{"_3706":84,"_31461":63,"_21806":51535,"_5":15007,"_28616":51480,"_3094":51536},[],"99.9 %",{"_3706":85,"_31461":63,"_21806":51538,"_5":15007,"_28616":51480,"_3094":51539},[],"Enterprise",{"_3706":86,"_31461":63,"_21806":51541,"_5":15007,"_28616":51480,"_3094":51542},[],"Unlimited",{"_3706":87,"_31461":63,"_21806":51544,"_5":15007,"_28616":51480,"_3094":51545},[],"Dedicated",{"_3706":88,"_31461":63,"_21806":51547,"_5":15007,"_28616":51480,"_3094":51548},[],"99.99 %",{"_3706":89,"_31461":63,"_21806":51550,"_5":15007,"_28616":51484,"_3094":51551},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3706":90,"_31461":63,"_21806":51553,"_5":15007,"_28616":51484,"_3094":51554},[],"When you receive your instance's credentials, continue with Get started.",{"_3706":91,"_31461":91,"_5":15367,"_3094":51556,"_31799":51557,"_21806":51558,"_28616":91},"Fastlane",[51312,51313,51419],[],{"_3706":92,"_31461":91,"_21806":51560,"_5":15007,"_28616":91,"_3094":51561},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3706":93,"_31461":91,"_5":31796,"_21806":51563,"_28616":51564,"_3094":51565},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3706":94,"_31461":91,"_5":31796,"_21806":51567,"_28616":51568,"_3094":51569},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3706":95,"_31461":91,"_5":31796,"_21806":51571,"_28616":51572,"_3094":51322},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3706":96,"_31461":91,"_5":31796,"_21806":51574,"_28616":51575,"_3094":51576},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3706":97,"_31461":91,"_5":31796,"_21806":51578,"_28616":51579,"_3094":51580},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3706":98,"_31461":91,"_5":31796,"_21806":51582,"_28616":51583,"_3094":51584},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3706":99,"_31461":91,"_5":31796,"_21806":51586,"_28616":51587,"_3094":51588},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3706":100,"_31461":91,"_5":31796,"_21806":51590,"_28616":51591,"_3094":51592},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3706":101,"_31461":91,"_5":31796,"_21806":51594,"_28616":51595,"_3094":51596},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3706":102,"_31461":91,"_5":31796,"_21806":51598,"_28616":51599,"_3094":51600},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3706":103,"_31461":91,"_5":31796,"_21806":51602,"_28616":51603,"_3094":51604},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3706":104,"_31461":91,"_21806":51606,"_5":15007,"_28616":51564,"_3094":51607},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3706":105,"_31461":91,"_21806":51609,"_5":15007,"_28616":51564,"_3094":51610},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3706":106,"_31461":91,"_21806":51612,"_5":15007,"_28616":51568,"_3094":51613},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3706":107,"_31461":91,"_21806":51615,"_5":15007,"_28616":51568,"_3094":51616},[],"Fastlane installs or configures",{"_3706":108,"_31461":91,"_21806":51618,"_5":15007,"_28616":51568,"_3094":51619},[],"You still provide",{"_3706":109,"_31461":91,"_21806":51621,"_5":15007,"_28616":51568,"_3094":51622},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3706":110,"_31461":91,"_21806":51624,"_5":15007,"_28616":51568,"_3094":51625},[],"The Kubernetes cluster, nodes and persistent storage",{"_3706":111,"_31461":91,"_21806":51627,"_5":15007,"_28616":51568,"_3094":51628},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3706":112,"_31461":91,"_21806":51630,"_5":15007,"_28616":51568,"_3094":51631},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3706":113,"_31461":91,"_21806":51633,"_5":15007,"_28616":51568,"_3094":51634},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3706":114,"_31461":91,"_21806":51636,"_5":15007,"_28616":51568,"_3094":51637},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3706":115,"_31461":91,"_21806":51639,"_5":15007,"_28616":51568,"_3094":51640},[],"Optional observability and lab HSM components",{"_3706":116,"_31461":91,"_21806":51642,"_5":15007,"_28616":51568,"_3094":51643},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3706":117,"_31461":91,"_21806":51645,"_5":15007,"_28616":51568,"_3094":51646},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3706":118,"_31461":91,"_21806":51648,"_5":15007,"_28616":51572,"_3094":51649},[],"You need:",{"_3706":119,"_31461":91,"_21806":51651,"_5":15007,"_28616":51572,"_3094":51652},[],"an existing Kubernetes cluster",{"_3706":120,"_31461":91,"_21806":51654,"_5":15007,"_28616":51572,"_3094":51655},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3706":121,"_31461":91,"_21806":51657,"_5":15007,"_28616":51572,"_3094":51658},[],"`yq`",{"_3706":122,"_31461":91,"_21806":51660,"_5":15007,"_28616":51572,"_3094":24613},[],{"_3706":123,"_31461":91,"_21806":51662,"_5":15007,"_28616":51572,"_3094":51663},[],"`jq` only when using `--sample-data` or `--development`",{"_3706":124,"_31461":91,"_21806":51665,"_5":15007,"_28616":51572,"_3094":51666},[],"`ssh-keygen` only when using `--with-hsm`",{"_3706":125,"_31461":91,"_21806":51668,"_5":15007,"_28616":51572,"_3094":51669},[],"free external ports 80 and 443 on a single-node K3s host",{"_3706":126,"_31461":91,"_21806":51671,"_5":15007,"_28616":51572,"_3094":51672},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3706":127,"_31461":91,"_21806":51674,"_5":15007,"_28616":51572,"_3094":51675},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3706":128,"_31461":91,"_21806":51677,"_5":15007,"_28616":51575,"_3094":51678},[],"Run the script from a clone of the Helm repository:",{"_3706":129,"_31461":91,"_21806":51680,"_5":15007,"_28616":51575,"_3094":51681},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3706":130,"_31461":91,"_21806":51683,"_5":15007,"_28616":51579,"_3094":51684},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3706":131,"_31461":91,"_21806":51686,"_5":15007,"_28616":51579,"_3094":51687},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3706":132,"_31461":91,"_21806":51689,"_5":15007,"_28616":51579,"_3094":51690},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3706":133,"_31461":91,"_21806":51692,"_5":15007,"_28616":51579,"_3094":51693},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3706":134,"_31461":91,"_21806":51695,"_5":15007,"_28616":51583,"_3094":51696},[],"Option",{"_3706":135,"_31461":91,"_21806":51698,"_5":15007,"_28616":51583,"_3094":51699},[],"Default",{"_3706":136,"_31461":91,"_21806":51701,"_5":15007,"_28616":51583,"_3094":51702},[],"Purpose",{"_3706":137,"_31461":91,"_21806":51704,"_5":15007,"_28616":51583,"_3094":51705},[],"`-h`, `--help`",{"_3706":138,"_31461":91,"_21806":51707,"_5":15007,"_28616":51583,"_3094":51708},[],"—",{"_3706":139,"_31461":91,"_21806":51710,"_5":15007,"_28616":51583,"_3094":51711},[],"Show help",{"_3706":140,"_31461":91,"_21806":51713,"_5":15007,"_28616":51583,"_3094":51714},[],"`-c`, `--context`",{"_3706":141,"_31461":91,"_21806":51716,"_5":15007,"_28616":51583,"_3094":51717},[],"current context",{"_3706":142,"_31461":91,"_21806":51719,"_5":15007,"_28616":51583,"_3094":51720},[],"Select the kubeconfig context for kubectl and Helm",{"_3706":143,"_31461":91,"_21806":51722,"_5":15007,"_28616":51583,"_3094":51723},[],"`-n`, `--non-interactive`",{"_3706":144,"_31461":91,"_21806":51725,"_5":15007,"_28616":51583,"_3094":6849},[],{"_3706":145,"_31461":91,"_21806":51727,"_5":15007,"_28616":51583,"_3094":51728},[],"Skip prompts and generate dependency credentials",{"_3706":146,"_31461":91,"_21806":51730,"_5":15007,"_28616":51583,"_3094":51731},[],"`-ns`, `--namespace`",{"_3706":147,"_31461":91,"_21806":51733,"_5":15007,"_28616":51583,"_3094":51734},[],"`lamassu-dev`",{"_3706":148,"_31461":91,"_21806":51736,"_5":15007,"_28616":51583,"_3094":51737},[],"Namespace for the installation",{"_3706":149,"_31461":91,"_21806":51739,"_5":15007,"_28616":51583,"_3094":51740},[],"`-d`, `--domain`",{"_3706":150,"_31461":91,"_21806":51742,"_5":15007,"_28616":51583,"_3094":51743},[],"`dev.lamassu.io`",{"_3706":151,"_31461":91,"_21806":51745,"_5":15007,"_28616":51583,"_3094":51746},[],"Domain used by the UI, OIDC and certificate",{"_3706":152,"_31461":91,"_21806":51748,"_5":15007,"_28616":51583,"_3094":51749},[],"`-v`, `--version`",{"_3706":153,"_31461":91,"_21806":51751,"_5":15007,"_28616":51583,"_3094":15719},[],{"_3706":154,"_31461":91,"_21806":51753,"_5":15007,"_28616":51583,"_3094":51754},[],"Lamassu chart version",{"_3706":155,"_31461":91,"_21806":51756,"_5":15007,"_28616":51583,"_3094":51757},[],"`--https-port`",{"_3706":156,"_31461":91,"_21806":51759,"_5":15007,"_28616":51583,"_3094":51760},[],"`443`",{"_3706":157,"_31461":91,"_21806":51762,"_5":15007,"_28616":51583,"_3094":51763},[],"Gateway HTTPS listener port",{"_3706":158,"_31461":91,"_21806":51765,"_5":15007,"_28616":51583,"_3094":51766},[],"`--http-port`",{"_3706":159,"_31461":91,"_21806":51768,"_5":15007,"_28616":51583,"_3094":51769},[],"`80`",{"_3706":160,"_31461":91,"_21806":51771,"_5":15007,"_28616":51583,"_3094":51772},[],"Gateway HTTP listener port",{"_3706":161,"_31461":91,"_21806":51774,"_5":15007,"_28616":51583,"_3094":51775},[],"`--tls-crt`",{"_3706":162,"_31461":91,"_21806":51777,"_5":15007,"_28616":51583,"_3094":51708},[],{"_3706":163,"_31461":91,"_21806":51779,"_5":15007,"_28616":51583,"_3094":51780},[],"PEM certificate for downstream TLS",{"_3706":164,"_31461":91,"_21806":51782,"_5":15007,"_28616":51583,"_3094":51783},[],"`--tls-key`",{"_3706":165,"_31461":91,"_21806":51785,"_5":15007,"_28616":51583,"_3094":51708},[],{"_3706":166,"_31461":91,"_21806":51787,"_5":15007,"_28616":51583,"_3094":51788},[],"PEM private key for downstream TLS",{"_3706":167,"_31461":91,"_21806":51790,"_5":15007,"_28616":51583,"_3094":51791},[],"`-l`, `--local-chart-path`",{"_3706":168,"_31461":91,"_21806":51793,"_5":15007,"_28616":51583,"_3094":51794},[],"repository chart",{"_3706":169,"_31461":91,"_21806":51796,"_5":15007,"_28616":51583,"_3094":51797},[],"Use an unpacked local Lamassu chart",{"_3706":170,"_31461":91,"_21806":51799,"_5":15007,"_28616":51583,"_3094":51800},[],"`-ip`, `--gateway-ip`",{"_3706":171,"_31461":91,"_21806":51802,"_5":15007,"_28616":51583,"_3094":9158},[],{"_3706":172,"_31461":91,"_21806":51804,"_5":15007,"_28616":51583,"_3094":51805},[],"Override the address written to `gateway.addresses`",{"_3706":173,"_31461":91,"_21806":51807,"_5":15007,"_28616":51583,"_3094":51808},[],"`--otel`",{"_3706":174,"_31461":91,"_21806":51810,"_5":15007,"_28616":51583,"_3094":6849},[],{"_3706":175,"_31461":91,"_21806":51812,"_5":15007,"_28616":51583,"_3094":51813},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3706":176,"_31461":91,"_21806":51815,"_5":15007,"_28616":51583,"_3094":51816},[],"`--development`",{"_3706":177,"_31461":91,"_21806":51818,"_5":15007,"_28616":51583,"_3094":6849},[],{"_3706":178,"_31461":91,"_21806":51820,"_5":15007,"_28616":51583,"_3094":51821},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3706":179,"_31461":91,"_21806":51823,"_5":15007,"_28616":51583,"_3094":51824},[],"`--sample-data`",{"_3706":180,"_31461":91,"_21806":51826,"_5":15007,"_28616":51583,"_3094":6849},[],{"_3706":181,"_31461":91,"_21806":51828,"_5":15007,"_28616":51583,"_3094":51829},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3706":182,"_31461":91,"_21806":51831,"_5":15007,"_28616":51583,"_3094":51832},[],"`--with-hsm`",{"_3706":183,"_31461":91,"_21806":51834,"_5":15007,"_28616":51583,"_3094":6849},[],{"_3706":184,"_31461":91,"_21806":51836,"_5":15007,"_28616":51583,"_3094":51837},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3706":185,"_31461":91,"_21806":51839,"_5":15007,"_28616":51583,"_3094":51840},[],"`--softhsm-chart-path`",{"_3706":186,"_31461":91,"_21806":51842,"_5":15007,"_28616":51583,"_3094":51843},[],"`./charts/softhsm`",{"_3706":187,"_31461":91,"_21806":51845,"_5":15007,"_28616":51583,"_3094":51846},[],"Use a different local SoftHSM chart",{"_3706":188,"_31461":91,"_21806":51848,"_5":15007,"_28616":51583,"_3094":51849},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3706":189,"_31461":91,"_21806":51851,"_5":15007,"_28616":51587,"_3094":51852},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3706":190,"_31461":91,"_21806":51854,"_5":15007,"_28616":51587,"_3094":51855},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3706":191,"_31461":91,"_21806":51857,"_5":15007,"_28616":51587,"_3094":51858},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3706":192,"_31461":91,"_21806":51860,"_5":15007,"_28616":51587,"_3094":51861},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3706":193,"_31461":91,"_21806":51863,"_5":15007,"_28616":51587,"_3094":51864},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3706":194,"_31461":91,"_21806":51866,"_5":15007,"_28616":51587,"_3094":51867},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3706":195,"_31461":91,"_21806":51869,"_5":15007,"_28616":51591,"_3094":51870},[],"Fastlane:",{"_3706":196,"_31461":91,"_21806":51872,"_5":15007,"_28616":51591,"_3094":51873},[],"validates local tools and the selected cluster",{"_3706":197,"_31461":91,"_21806":51875,"_5":15007,"_28616":51591,"_3094":51876},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3706":198,"_31461":91,"_21806":51878,"_5":15007,"_28616":51591,"_3094":51879},[],"creates the namespace",{"_3706":199,"_31461":91,"_21806":51881,"_5":15007,"_28616":51591,"_3094":51882},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3706":200,"_31461":91,"_21806":51884,"_5":15007,"_28616":51591,"_3094":51885},[],"installs PostgreSQL and creates the required databases",{"_3706":201,"_31461":91,"_21806":51887,"_5":15007,"_28616":51591,"_3094":51888},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3706":202,"_31461":91,"_21806":51890,"_5":15007,"_28616":51591,"_3094":51891},[],"installs RabbitMQ",{"_3706":203,"_31461":91,"_21806":51893,"_5":15007,"_28616":51591,"_3094":51894},[],"optionally installs observability and lab HSM components",{"_3706":204,"_31461":91,"_21806":51896,"_5":15007,"_28616":51591,"_3094":51897},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3706":205,"_31461":91,"_21806":51899,"_5":15007,"_28616":51591,"_3094":51900},[],"optionally loads sample data",{"_3706":206,"_31461":91,"_21806":51902,"_5":15007,"_28616":51591,"_3094":51903},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3706":207,"_31461":91,"_21806":51905,"_5":15007,"_28616":51595,"_3094":51906},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3706":208,"_31461":91,"_21806":51908,"_5":15007,"_28616":51595,"_3094":51909},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3706":209,"_31461":91,"_21806":51911,"_5":15007,"_28616":51599,"_3094":51912},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3706":210,"_31461":91,"_21806":51914,"_5":15007,"_28616":51599,"_3094":51915},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3706":211,"_31461":91,"_21806":51917,"_5":15007,"_28616":51599,"_3094":51918},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3706":212,"_31461":91,"_21806":51920,"_5":15007,"_28616":51599,"_3094":51921},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3706":213,"_31461":91,"_21806":51923,"_5":15007,"_28616":51603,"_3094":51924},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3706":214,"_31461":214,"_5":15367,"_3094":51926,"_31799":51927,"_21806":51928,"_28616":214},"Install with Helm",[51312,51313,51419],[],{"_3706":215,"_31461":214,"_21806":51930,"_5":15007,"_28616":214,"_3094":51931},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3706":216,"_31461":214,"_5":31796,"_21806":51933,"_28616":51934,"_3094":51935},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3706":217,"_31461":214,"_5":31796,"_21806":51937,"_28616":51938,"_3094":51322},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3706":218,"_31461":214,"_5":31796,"_21806":51940,"_28616":51941,"_3094":51942},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3706":219,"_31461":214,"_5":31796,"_21806":51944,"_28616":51945,"_3094":51946},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3706":220,"_31461":214,"_5":31796,"_21806":51948,"_28616":51949,"_3094":51950},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3706":221,"_31461":214,"_5":31796,"_21806":51952,"_28616":51953,"_3094":51954},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3706":222,"_31461":214,"_5":31796,"_21806":51956,"_28616":51957,"_3094":51958},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3706":223,"_31461":214,"_5":31796,"_21806":51960,"_28616":51961,"_3094":51962},[],"/docs/deployment/self-hosted/helm#device-event-stream-sse","Device event stream (SSE)",{"_3706":224,"_31461":214,"_5":31796,"_21806":51964,"_28616":51965,"_3094":51966},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3706":225,"_31461":214,"_5":31796,"_21806":51968,"_28616":51969,"_3094":51970},[],"/docs/deployment/self-hosted/helm#experimental-dashboard-terminal-optional","Experimental dashboard terminal (optional)",{"_3706":226,"_31461":214,"_5":31796,"_21806":51972,"_28616":51973,"_3094":51974},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3706":227,"_31461":214,"_5":31796,"_21806":51976,"_28616":51977,"_3094":51978},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3706":228,"_31461":214,"_5":31796,"_21806":51980,"_28616":51981,"_3094":51982},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3706":229,"_31461":214,"_5":31796,"_21806":51984,"_28616":51985,"_3094":51986},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3706":230,"_31461":214,"_21806":51988,"_5":15007,"_28616":51934,"_3094":51989},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3706":231,"_31461":214,"_21806":51991,"_5":15007,"_28616":51938,"_3094":51992},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3706":232,"_31461":214,"_21806":51994,"_5":15007,"_28616":51938,"_3094":51995},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3706":233,"_31461":214,"_21806":51997,"_5":15007,"_28616":51938,"_3094":51998},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3706":234,"_31461":214,"_21806":52000,"_5":15007,"_28616":51938,"_3094":52001},[],"a reachable RabbitMQ broker and credentials",{"_3706":235,"_31461":214,"_21806":52003,"_5":15007,"_28616":51938,"_3094":52004},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3706":236,"_31461":214,"_21806":52006,"_5":15007,"_28616":51938,"_3094":52007},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3706":237,"_31461":214,"_21806":52009,"_5":15007,"_28616":51938,"_3094":52010},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3706":238,"_31461":214,"_21806":52012,"_5":15007,"_28616":51938,"_3094":52013},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3706":239,"_31461":214,"_21806":52015,"_5":15007,"_28616":51938,"_3094":52016},[],"a StorageClass and an external traffic design",{"_3706":240,"_31461":214,"_21806":52018,"_5":15007,"_28616":51938,"_3094":52019},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3706":241,"_31461":214,"_21806":52021,"_5":15007,"_28616":51938,"_3094":52022},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3706":242,"_31461":214,"_21806":52024,"_5":15007,"_28616":51938,"_3094":52025},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3706":243,"_31461":214,"_21806":52027,"_5":15007,"_28616":51941,"_3094":52028},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3706":244,"_31461":214,"_21806":52030,"_5":15007,"_28616":51941,"_3094":52031},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3706":245,"_31461":214,"_21806":52033,"_5":15007,"_28616":51941,"_3094":52034},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3706":246,"_31461":214,"_21806":52036,"_5":15007,"_28616":51945,"_3094":52037},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3706":247,"_31461":214,"_21806":52039,"_5":15007,"_28616":51945,"_3094":52040},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3706":248,"_31461":214,"_21806":52042,"_5":15007,"_28616":51945,"_3094":52043},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3706":249,"_31461":214,"_21806":52045,"_5":15007,"_28616":51945,"_3094":52046},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3706":250,"_31461":214,"_21806":52048,"_5":15007,"_28616":51949,"_3094":52049},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3706":251,"_31461":214,"_21806":52051,"_5":15007,"_28616":51949,"_3094":52052},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3706":252,"_31461":214,"_21806":52054,"_5":15007,"_28616":51949,"_3094":52055},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3706":253,"_31461":214,"_21806":52057,"_5":15007,"_28616":51949,"_3094":52058},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3706":254,"_31461":214,"_21806":52060,"_5":15007,"_28616":51949,"_3094":52061},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3706":255,"_31461":214,"_21806":52063,"_5":15007,"_28616":51949,"_3094":52064},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3706":256,"_31461":214,"_21806":52066,"_5":15007,"_28616":51949,"_3094":52067},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3706":257,"_31461":214,"_21806":52069,"_5":15007,"_28616":51949,"_3094":52070},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3706":258,"_31461":214,"_21806":52072,"_5":15007,"_28616":51953,"_3094":52073},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3706":259,"_31461":214,"_21806":52075,"_5":15007,"_28616":51957,"_3094":52076},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3706":260,"_31461":214,"_21806":52078,"_5":15007,"_28616":51957,"_3094":52079},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3706":261,"_31461":214,"_21806":52081,"_5":15007,"_28616":51957,"_3094":52082},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3706":262,"_31461":214,"_21806":52084,"_5":15007,"_28616":51957,"_3094":52085},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3706":263,"_31461":214,"_21806":52087,"_5":15007,"_28616":51957,"_3094":52088},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3706":264,"_31461":214,"_21806":52090,"_5":15007,"_28616":51957,"_3094":52091},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3706":265,"_31461":214,"_21806":52093,"_5":15007,"_28616":51957,"_3094":52094},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3706":266,"_31461":214,"_21806":52096,"_5":15007,"_28616":51961,"_3094":52097},[],"`services.deviceManager.sseEnabled` (default `true`) controls whether Device Manager serves its device-event stream over Server-Sent Events (SSE). With the default, the chart renders a dedicated gateway rule for the device-events endpoint with an 11-minute request timeout, because the Gateway's default request timeout is too short for these streams, which the service keeps open for up to about ten minutes. Device Manager calls that are not SSE requests keep the Gateway's default timeout.",{"_3706":267,"_31461":214,"_21806":52099,"_5":15007,"_28616":51961,"_3094":52100},[],"Set it to `false` to disable the stream: the chart then renders `sse_enabled: false` in the Device Manager configuration and omits the gateway rule, and SSE requests to the device-events endpoint fail. See Device events in the 3.8.0 to 4.0.0 upgrade guide.",{"_3706":268,"_31461":214,"_21806":52102,"_5":15007,"_28616":51965,"_3094":52103},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3706":269,"_31461":214,"_21806":52105,"_5":15007,"_28616":51965,"_3094":52106},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3706":270,"_31461":214,"_21806":52108,"_5":15007,"_28616":51965,"_3094":52109},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3706":271,"_31461":214,"_21806":52111,"_5":15007,"_28616":51965,"_3094":52112},[],"See Access control for the principal and policy model.",{"_3706":272,"_31461":214,"_21806":52114,"_5":15007,"_28616":51969,"_3094":52115},[],"The dashboard includes an experimental browser terminal for working with devices. It is disabled by default; enable it in the values file:",{"_3706":273,"_31461":214,"_21806":52117,"_5":15007,"_28616":51969,"_3094":52118},[],"Enabling the terminal requires external authorization: set `auth.externalAuthorization.enabled: true` and `auth.externalAuthorization.failOpen: false`. The chart refuses to render the release otherwise, because the terminal's WebSocket endpoint would then be exposed through the Gateway without external authorization.",{"_3706":274,"_31461":214,"_21806":52120,"_5":15007,"_28616":51969,"_3094":52121},[],"Only identities granted the preloaded \"Terminal Network\" policy can open terminal sessions. See Access control for how policies are assigned.",{"_3706":275,"_31461":214,"_21806":52123,"_5":15007,"_28616":51969,"_3094":52124},[],"Note that even with the terminal enabled, pods inside the cluster can still reach the UI service directly unless network policies restrict that access — the external authorization applies to traffic entering through the Gateway.",{"_3706":276,"_31461":214,"_21806":52126,"_5":15007,"_28616":51973,"_3094":52127},[],"To install a local checkout instead:",{"_3706":277,"_31461":214,"_21806":52129,"_5":15007,"_28616":51977,"_3094":52130},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3706":278,"_31461":214,"_21806":52132,"_5":15007,"_28616":51977,"_3094":52133},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3706":279,"_31461":214,"_21806":52135,"_5":15007,"_28616":51981,"_3094":52136},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3706":280,"_31461":214,"_21806":52138,"_5":15007,"_28616":51981,"_3094":52139},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3706":281,"_31461":214,"_21806":52141,"_5":15007,"_28616":51981,"_3094":52142},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3706":282,"_31461":214,"_21806":52144,"_5":15007,"_28616":51981,"_3094":52145},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3706":283,"_31461":214,"_21806":52147,"_5":15007,"_28616":51981,"_3094":52148},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3706":284,"_31461":214,"_21806":52150,"_5":15007,"_28616":51985,"_3094":52151},[],"Before going live, review:",{"_3706":285,"_31461":214,"_21806":52153,"_5":15007,"_28616":51985,"_3094":52154},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3706":286,"_31461":214,"_21806":52156,"_5":15007,"_28616":51985,"_3094":52157},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3706":287,"_31461":214,"_21806":52159,"_5":15007,"_28616":51985,"_3094":52160},[],"shared VA storage before increasing VA replicas",{"_3706":288,"_31461":214,"_21806":52162,"_5":15007,"_28616":51985,"_3094":52163},[],"managed OIDC roles and removal of evaluation credentials",{"_3706":289,"_31461":214,"_21806":52165,"_5":15007,"_28616":51985,"_3094":52166},[],"a trusted TLS issuer or externally managed certificate",{"_3706":290,"_31461":214,"_21806":52168,"_5":15007,"_28616":51985,"_3094":52169},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3706":291,"_31461":214,"_21806":52171,"_5":15007,"_28616":51985,"_3094":52172},[],"SMTP, observability and alert delivery",{"_3706":292,"_31461":214,"_21806":52174,"_5":15007,"_28616":51985,"_3094":52175},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3706":293,"_31461":214,"_21806":52177,"_5":15007,"_28616":51985,"_3094":52178},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3706":294,"_31461":294,"_5":15367,"_3094":52180,"_31799":52181,"_21806":52182,"_28616":294},"Expose the Gateway",[51312,51313,51419],[],{"_3706":295,"_31461":294,"_21806":52184,"_5":15007,"_28616":294,"_3094":52185},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3706":296,"_31461":294,"_5":31796,"_21806":52187,"_28616":52188,"_3094":52189},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3706":297,"_31461":294,"_5":31796,"_21806":52191,"_28616":52192,"_3094":52193},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3706":298,"_31461":294,"_5":31796,"_21806":52195,"_28616":52196,"_3094":52197},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3706":299,"_31461":294,"_5":31796,"_21806":52199,"_28616":52200,"_3094":52201},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3706":300,"_31461":294,"_5":31796,"_21806":52203,"_28616":52204,"_3094":52205},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3706":301,"_31461":294,"_5":31796,"_21806":52207,"_28616":52208,"_3094":52209},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3706":302,"_31461":294,"_5":31796,"_21806":52211,"_28616":52212,"_3094":52213},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3706":303,"_31461":294,"_5":31796,"_21806":52215,"_28616":52216,"_3094":52217},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3706":304,"_31461":294,"_5":31796,"_21806":52219,"_28616":52220,"_3094":52221},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3706":305,"_31461":294,"_5":31796,"_21806":52223,"_28616":52224,"_3094":52225},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3706":306,"_31461":294,"_5":31796,"_21806":52227,"_28616":52228,"_3094":52229},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3706":307,"_31461":294,"_21806":52231,"_5":15007,"_28616":52188,"_3094":52232},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3706":308,"_31461":294,"_21806":52234,"_5":15007,"_28616":52188,"_3094":52235},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3706":309,"_31461":294,"_21806":52237,"_5":15007,"_28616":52192,"_3094":52238},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3706":310,"_31461":294,"_21806":52240,"_5":15007,"_28616":52192,"_3094":52241},[],"Set it only when:",{"_3706":311,"_31461":294,"_21806":52243,"_5":15007,"_28616":52192,"_3094":52244},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3706":312,"_31461":294,"_21806":52246,"_5":15007,"_28616":52192,"_3094":52247},[],"that address is allocated to this Gateway",{"_3706":313,"_31461":294,"_21806":52249,"_5":15007,"_28616":52192,"_3094":52250},[],"the surrounding network already routes traffic for it to the cluster",{"_3706":314,"_31461":294,"_21806":52252,"_5":15007,"_28616":52192,"_3094":52253},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3706":315,"_31461":294,"_21806":52255,"_5":15007,"_28616":52192,"_3094":52256},[],"Keep these two settings separate:",{"_3706":316,"_31461":294,"_21806":52258,"_5":15007,"_28616":52192,"_3094":52259},[],"`gateway.addresses` requests an address for the Gateway.",{"_3706":317,"_31461":294,"_21806":52261,"_5":15007,"_28616":52192,"_3094":52262},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3706":318,"_31461":294,"_21806":52264,"_5":15007,"_28616":52192,"_3094":52265},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3706":319,"_31461":294,"_21806":52267,"_5":15007,"_28616":52196,"_3094":52268},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3706":320,"_31461":294,"_21806":52270,"_5":15007,"_28616":52196,"_3094":52271},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3706":321,"_31461":294,"_21806":52273,"_5":15007,"_28616":52200,"_3094":52274},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3706":322,"_31461":294,"_21806":52276,"_5":15007,"_28616":52200,"_3094":52277},[],"For the recommended design:",{"_3706":323,"_31461":294,"_21806":52279,"_5":15007,"_28616":52200,"_3094":52280},[],"Use only one externally exposed Lamassu Gateway.",{"_3706":324,"_31461":294,"_21806":52282,"_5":15007,"_28616":52200,"_3094":52283},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3706":325,"_31461":294,"_21806":52285,"_5":15007,"_28616":52200,"_3094":52286},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3706":326,"_31461":294,"_21806":52288,"_5":15007,"_28616":52200,"_3094":52289},[],"Point DNS at the VM's reachable address.",{"_3706":327,"_31461":294,"_21806":52291,"_5":15007,"_28616":52200,"_3094":52292},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3706":328,"_31461":294,"_21806":52294,"_5":15007,"_28616":52204,"_3094":52295},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3706":329,"_31461":294,"_21806":52297,"_5":15007,"_28616":52208,"_3094":52298},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3706":330,"_31461":294,"_21806":52300,"_5":15007,"_28616":52208,"_3094":52301},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3706":331,"_31461":294,"_21806":52303,"_5":15007,"_28616":52212,"_3094":52304},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3706":332,"_31461":294,"_21806":52306,"_5":15007,"_28616":52212,"_3094":52307},[],"Requirement",{"_3706":333,"_31461":294,"_21806":52309,"_5":15007,"_28616":52212,"_3094":52310},[],"Recommended design",{"_3706":334,"_31461":294,"_21806":52312,"_5":15007,"_28616":52212,"_3094":52313},[],"Consequence",{"_3706":335,"_31461":294,"_21806":52315,"_5":15007,"_28616":52212,"_3094":52316},[],"Several Lamassu URLs or services",{"_3706":336,"_31461":294,"_21806":52318,"_5":15007,"_28616":52212,"_3094":52319},[],"One Gateway with multiple routes",{"_3706":337,"_31461":294,"_21806":52321,"_5":15007,"_28616":52212,"_3094":52322},[],"One IP and one proxy fleet; this is the chart default",{"_3706":338,"_31461":294,"_21806":52324,"_5":15007,"_28616":52212,"_3094":52325},[],"Independent Gateways and separate external IPs",{"_3706":339,"_31461":294,"_21806":52327,"_5":15007,"_28616":52212,"_3094":52328},[],"One VIP per Gateway",{"_3706":340,"_31461":294,"_21806":52330,"_5":15007,"_28616":52212,"_3094":52331},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3706":341,"_31461":294,"_21806":52333,"_5":15007,"_28616":52212,"_3094":52334},[],"Independent Gateways on one node and one IP",{"_3706":342,"_31461":294,"_21806":52336,"_5":15007,"_28616":52212,"_3094":52337},[],"Use different external ports",{"_3706":343,"_31461":294,"_21806":52339,"_5":15007,"_28616":52212,"_3094":52340},[],"Clients must include non-standard ports",{"_3706":344,"_31461":294,"_21806":52342,"_5":15007,"_28616":52212,"_3094":52343},[],"Separate TLS/mTLS termination behind one IP",{"_3706":345,"_31461":294,"_21806":52345,"_5":15007,"_28616":52212,"_3094":52346},[],"Front-door SNI routing to internal Gateways",{"_3706":346,"_31461":294,"_21806":52348,"_5":15007,"_28616":52212,"_3094":52349},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3706":347,"_31461":294,"_21806":52351,"_5":15007,"_28616":52212,"_3094":52352},[],"Separate Gateway resources but shared proxy infrastructure",{"_3706":348,"_31461":294,"_21806":52354,"_5":15007,"_28616":52212,"_3094":52355},[],"Envoy merged-Gateway mode",{"_3706":349,"_31461":294,"_21806":52357,"_5":15007,"_28616":52212,"_3094":52358},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3706":350,"_31461":294,"_21806":52360,"_5":15007,"_28616":52212,"_3094":52361},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3706":351,"_31461":294,"_21806":52363,"_5":15007,"_28616":52212,"_3094":52364},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3706":352,"_31461":294,"_21806":52366,"_5":15007,"_28616":52212,"_3094":52367},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3706":353,"_31461":294,"_21806":52369,"_5":15007,"_28616":52212,"_3094":52370},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3706":354,"_31461":294,"_21806":52372,"_5":15007,"_28616":52216,"_3094":52373},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3706":355,"_31461":294,"_21806":52375,"_5":15007,"_28616":52220,"_3094":52376},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3706":356,"_31461":294,"_21806":52378,"_5":15007,"_28616":52220,"_3094":52379},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3706":357,"_31461":294,"_21806":52381,"_5":15007,"_28616":52220,"_3094":52382},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3706":358,"_31461":294,"_21806":52384,"_5":15007,"_28616":52220,"_3094":52385},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3706":359,"_31461":294,"_21806":52387,"_5":15007,"_28616":52220,"_3094":52388},[],"If none of those are possible, use different external ports or change the external network design.",{"_3706":360,"_31461":294,"_21806":52390,"_5":15007,"_28616":52224,"_3094":52391},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3706":361,"_31461":294,"_21806":52393,"_5":15007,"_28616":52224,"_3094":52394},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3706":362,"_31461":294,"_21806":52396,"_5":15007,"_28616":52228,"_3094":52397},[],"Check, in order:",{"_3706":363,"_31461":294,"_21806":52399,"_5":15007,"_28616":52228,"_3094":52400},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3706":364,"_31461":294,"_21806":52402,"_5":15007,"_28616":52228,"_3094":52403},[],"Its status contains the expected address.",{"_3706":365,"_31461":294,"_21806":52405,"_5":15007,"_28616":52228,"_3094":52406},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3706":366,"_31461":294,"_21806":52408,"_5":15007,"_28616":52228,"_3094":52409},[],"Port 443 reaches that address from the client network.",{"_3706":367,"_31461":294,"_21806":52411,"_5":15007,"_28616":52228,"_3094":52412},[],"DNS resolves to the externally reachable endpoint.",{"_3706":368,"_31461":294,"_21806":52414,"_5":15007,"_28616":52228,"_3094":52415},[],"The certificate contains the DNS name or IP used by the client.",{"_3706":369,"_31461":294,"_21806":52417,"_5":15007,"_28616":52228,"_3094":52418},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3706":370,"_31461":370,"_5":15367,"_3094":51419,"_31799":52420,"_21806":52421,"_28616":370},[51312,51313,51419],[],{"_3706":371,"_31461":370,"_21806":52423,"_5":15007,"_28616":370,"_3094":52424},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3706":372,"_31461":370,"_5":31796,"_21806":52426,"_28616":52427,"_3094":52428},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3706":373,"_31461":370,"_5":31796,"_21806":52430,"_28616":52431,"_3094":52432},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3706":374,"_31461":370,"_5":31796,"_21806":52434,"_28616":52435,"_3094":52436},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3706":375,"_31461":370,"_5":31796,"_21806":52438,"_28616":52439,"_3094":52440},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3706":376,"_31461":370,"_5":31796,"_21806":52442,"_28616":52443,"_3094":52444},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3706":377,"_31461":370,"_5":31796,"_21806":52446,"_28616":52447,"_3094":52448},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3706":378,"_31461":370,"_21806":52450,"_5":15007,"_28616":52427,"_3094":52451},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3706":379,"_31461":370,"_21806":52453,"_5":15007,"_28616":52431,"_3094":52454},[],"Workflow",{"_3706":380,"_31461":370,"_21806":52456,"_5":15007,"_28616":52431,"_3094":52457},[],"Use it for",{"_3706":381,"_31461":370,"_21806":52459,"_5":15007,"_28616":52431,"_3094":52460},[],"What it installs",{"_3706":382,"_31461":370,"_21806":52462,"_5":15007,"_28616":52431,"_3094":52463},[],"Helm",{"_3706":383,"_31461":370,"_21806":52465,"_5":15007,"_28616":52431,"_3094":52466},[],"Production and controlled environments",{"_3706":384,"_31461":370,"_21806":52468,"_5":15007,"_28616":52431,"_3094":52469},[],"Lamassu services and Gateway API resources",{"_3706":385,"_31461":370,"_21806":52471,"_5":15007,"_28616":52431,"_3094":51556},[],{"_3706":386,"_31461":370,"_21806":52473,"_5":15007,"_28616":52431,"_3094":52474},[],"Evaluation, demos, CI and small lab clusters",{"_3706":387,"_31461":370,"_21806":52476,"_5":15007,"_28616":52431,"_3094":52477},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3706":388,"_31461":370,"_21806":52479,"_5":15007,"_28616":52435,"_3094":52480},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3706":389,"_31461":370,"_21806":52482,"_5":15007,"_28616":52435,"_3094":52483},[],"Area",{"_3706":390,"_31461":370,"_21806":52485,"_5":15007,"_28616":52435,"_3094":52486},[],"The Lamassu chart provides",{"_3706":391,"_31461":370,"_21806":52488,"_5":15007,"_28616":52435,"_3094":52489},[],"You provide",{"_3706":392,"_31461":370,"_21806":52491,"_5":15007,"_28616":52435,"_3094":52492},[],"Lamassu applications",{"_3706":393,"_31461":370,"_21806":52494,"_5":15007,"_28616":52435,"_3094":52495},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3706":394,"_31461":370,"_21806":52497,"_5":15007,"_28616":52435,"_3094":52498},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3706":395,"_31461":370,"_21806":52500,"_5":15007,"_28616":52435,"_3094":52501},[],"PostgreSQL data",{"_3706":396,"_31461":370,"_21806":52503,"_5":15007,"_28616":52435,"_3094":52504},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3706":397,"_31461":370,"_21806":52506,"_5":15007,"_28616":52435,"_3094":52507},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3706":398,"_31461":370,"_21806":52509,"_5":15007,"_28616":52435,"_3094":52510},[],"Messaging",{"_3706":399,"_31461":370,"_21806":52512,"_5":15007,"_28616":52435,"_3094":52513},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3706":400,"_31461":370,"_21806":52515,"_5":15007,"_28616":52435,"_3094":52516},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3706":401,"_31461":370,"_21806":52518,"_5":15007,"_28616":52435,"_3094":52519},[],"Identity",{"_3706":402,"_31461":370,"_21806":52521,"_5":15007,"_28616":52435,"_3094":52522},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3706":403,"_31461":370,"_21806":52524,"_5":15007,"_28616":52435,"_3094":52525},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3706":404,"_31461":370,"_21806":52527,"_5":15007,"_28616":52435,"_3094":52528},[],"External routing",{"_3706":405,"_31461":370,"_21806":52530,"_5":15007,"_28616":52435,"_3094":52531},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3706":406,"_31461":370,"_21806":52533,"_5":15007,"_28616":52435,"_3094":52534},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3706":407,"_31461":370,"_21806":52536,"_5":15007,"_28616":52435,"_3094":52537},[],"TLS",{"_3706":408,"_31461":370,"_21806":52539,"_5":15007,"_28616":52435,"_3094":52540},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3706":409,"_31461":370,"_21806":52542,"_5":15007,"_28616":52435,"_3094":52543},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3706":410,"_31461":370,"_21806":52545,"_5":15007,"_28616":52435,"_3094":52546},[],"Persistent application data",{"_3706":411,"_31461":370,"_21806":52548,"_5":15007,"_28616":52435,"_3094":52549},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3706":412,"_31461":370,"_21806":52551,"_5":15007,"_28616":52435,"_3094":52552},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3706":413,"_31461":370,"_21806":52554,"_5":15007,"_28616":52435,"_3094":52555},[],"Optional integrations",{"_3706":414,"_31461":370,"_21806":52557,"_5":15007,"_28616":52435,"_3094":52558},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3706":415,"_31461":370,"_21806":52560,"_5":15007,"_28616":52435,"_3094":52561},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3706":416,"_31461":370,"_21806":52563,"_5":15007,"_28616":52435,"_3094":52564},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3706":417,"_31461":370,"_21806":52566,"_5":15007,"_28616":52435,"_3094":52567},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3706":418,"_31461":370,"_21806":52569,"_5":15007,"_28616":52439,"_3094":52570},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3706":419,"_31461":370,"_21806":52572,"_5":15007,"_28616":52439,"_3094":52573},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3706":420,"_31461":370,"_21806":52575,"_5":15007,"_28616":52443,"_3094":52576},[],"Kubernetes 1.24 or newer",{"_3706":421,"_31461":370,"_21806":52578,"_5":15007,"_28616":52443,"_3094":52579},[],"Helm 3.2 or newer",{"_3706":422,"_31461":370,"_21806":52581,"_5":15007,"_28616":52443,"_3094":52582},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3706":423,"_31461":370,"_21806":52584,"_5":15007,"_28616":52443,"_3094":52585},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3706":424,"_31461":370,"_21806":52587,"_5":15007,"_28616":52443,"_3094":52588},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3706":425,"_31461":370,"_21806":52590,"_5":15007,"_28616":52443,"_3094":52591},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3706":426,"_31461":370,"_21806":52593,"_5":15007,"_28616":52443,"_3094":52594},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3706":427,"_31461":370,"_21806":52596,"_5":15007,"_28616":52447,"_3094":52597},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3706":428,"_31461":370,"_21806":52599,"_5":15007,"_28616":52447,"_3094":52600},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3706":429,"_31461":370,"_21806":52602,"_5":15007,"_28616":52447,"_3094":52603},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3706":430,"_31461":370,"_21806":52605,"_5":15007,"_28616":52447,"_3094":52606},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3706":431,"_31461":431,"_5":15367,"_3094":52608,"_31799":52609,"_21806":52611,"_28616":431},"Deployment troubleshooting",[51312,51313,52610],"Operations",[],{"_3706":432,"_31461":431,"_21806":52613,"_5":15007,"_28616":431,"_3094":52614},[],"Diagnose access, service health and infrastructure dependencies.",{"_3706":433,"_31461":431,"_5":31796,"_21806":52616,"_28616":52617,"_3094":52618},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3706":434,"_31461":431,"_5":31796,"_21806":52620,"_28616":52621,"_3094":52622},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3706":435,"_31461":431,"_5":31796,"_21806":52624,"_28616":52625,"_3094":52626},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3706":436,"_31461":431,"_5":31796,"_21806":52628,"_28616":52629,"_3094":52630},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3706":437,"_31461":431,"_5":31796,"_21806":52632,"_28616":52633,"_3094":52634},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3706":438,"_31461":431,"_5":31796,"_21806":52636,"_28616":52637,"_3094":52638},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3706":439,"_31461":431,"_5":31796,"_21806":52640,"_28616":52641,"_3094":52642},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3706":440,"_31461":431,"_5":31796,"_21806":52644,"_28616":52645,"_3094":52646},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3706":441,"_31461":431,"_5":31796,"_21806":52648,"_28616":52649,"_3094":52650},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3706":442,"_31461":431,"_5":31796,"_21806":52652,"_28616":52653,"_3094":52654},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3706":443,"_31461":431,"_5":31796,"_21806":52656,"_28616":52657,"_3094":52658},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3706":444,"_31461":431,"_5":31796,"_21806":52660,"_28616":52661,"_3094":52662},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3706":445,"_31461":431,"_5":31796,"_21806":52664,"_28616":52665,"_3094":52666},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3706":446,"_31461":431,"_21806":52668,"_5":15007,"_28616":431,"_3094":52669},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3706":447,"_31461":431,"_21806":52671,"_5":15007,"_28616":52621,"_3094":52672},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3706":448,"_31461":431,"_21806":52674,"_5":15007,"_28616":52625,"_3094":52675},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3706":449,"_31461":431,"_21806":52677,"_5":15007,"_28616":52629,"_3094":52678},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3706":450,"_31461":431,"_21806":52680,"_5":15007,"_28616":52633,"_3094":52681},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3706":451,"_31461":431,"_21806":52683,"_5":15007,"_28616":52637,"_3094":52684},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3706":452,"_31461":431,"_21806":52686,"_5":15007,"_28616":52641,"_3094":52687},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3706":453,"_31461":431,"_21806":52689,"_5":15007,"_28616":52641,"_3094":52690},[],"Also run the chart's connectivity test:",{"_3706":454,"_31461":431,"_21806":52692,"_5":15007,"_28616":52641,"_3094":52693},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3706":455,"_31461":431,"_21806":52695,"_5":15007,"_28616":52641,"_3094":52696},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3706":456,"_31461":431,"_21806":52698,"_5":15007,"_28616":52645,"_3094":52699},[],"If you receive a 401:",{"_3706":457,"_31461":431,"_21806":52701,"_5":15007,"_28616":52645,"_3094":52702},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3706":458,"_31461":431,"_21806":52704,"_5":15007,"_28616":52645,"_3094":52705},[],"verify issuer, audience and expiration of the token;",{"_3706":459,"_31461":431,"_21806":52707,"_5":15007,"_28616":52645,"_3094":52708},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3706":460,"_31461":431,"_21806":52710,"_5":15007,"_28616":52645,"_3094":52711},[],"check that the provider's public and internal routes point to the same realm.",{"_3706":461,"_31461":431,"_21806":52713,"_5":15007,"_28616":52645,"_3094":52714},[],"If login succeeds but the APIs return 403:",{"_3706":462,"_31461":431,"_21806":52716,"_5":15007,"_28616":52645,"_3094":52717},[],"inspect the token's real claims;",{"_3706":463,"_31461":431,"_21806":52719,"_5":15007,"_28616":52645,"_3094":52720},[],"confirm they match an active principal;",{"_3706":464,"_31461":431,"_21806":52722,"_5":15007,"_28616":52645,"_3094":52723},[],"review the policies granted to that principal;",{"_3706":465,"_31461":431,"_21806":52725,"_5":15007,"_28616":52645,"_3094":52726},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3706":466,"_31461":431,"_21806":52728,"_5":15007,"_28616":52645,"_3094":52729},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3706":467,"_31461":431,"_21806":52731,"_5":15007,"_28616":52649,"_3094":52732},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3706":468,"_31461":431,"_21806":52734,"_5":15007,"_28616":52649,"_3094":52735},[],"Locate the authz pod and Service.",{"_3706":469,"_31461":431,"_21806":52737,"_5":15007,"_28616":52649,"_3094":52738},[],"Check /health, logs and its database connection.",{"_3706":470,"_31461":431,"_21806":52740,"_5":15007,"_28616":52649,"_3094":52741},[],"Verify the DNS and port configured in externalAuthorization.",{"_3706":471,"_31461":431,"_21806":52743,"_5":15007,"_28616":52649,"_3094":52744},[],"Check the check route is /v1/ext\\_authz/check.",{"_3706":472,"_31461":431,"_21806":52746,"_5":15007,"_28616":52649,"_3094":52747},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3706":473,"_31461":431,"_21806":52749,"_5":15007,"_28616":52653,"_3094":52750},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3706":474,"_31461":431,"_21806":52752,"_5":15007,"_28616":52657,"_3094":52753},[],"Review kubectl describe pod first. Common causes are:",{"_3706":475,"_31461":431,"_21806":52755,"_5":15007,"_28616":52657,"_3094":52756},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3706":476,"_31461":431,"_21806":52758,"_5":15007,"_28616":52657,"_3094":52759},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3706":477,"_31461":431,"_21806":52761,"_5":15007,"_28616":52657,"_3094":52762},[],"unbound persistent volume;",{"_3706":478,"_31461":431,"_21806":52764,"_5":15007,"_28616":52657,"_3094":52765},[],"inaccessible image or incorrect pull policy;",{"_3706":479,"_31461":431,"_21806":52767,"_5":15007,"_28616":52657,"_3094":52768},[],"invalid cryptographic engine configuration;",{"_3706":480,"_31461":431,"_21806":52770,"_5":15007,"_28616":52657,"_3094":52771},[],"CPU or memory limits set too low;",{"_3706":481,"_31461":431,"_21806":52773,"_5":15007,"_28616":52657,"_3094":52774},[],"an incomplete prior migration.",{"_3706":482,"_31461":431,"_21806":52776,"_5":15007,"_28616":52657,"_3094":52777},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3706":483,"_31461":431,"_21806":52779,"_5":15007,"_28616":52657,"_3094":52780},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3706":484,"_31461":431,"_21806":52782,"_5":15007,"_28616":52657,"_3094":52783},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3706":485,"_31461":431,"_21806":52785,"_5":15007,"_28616":52661,"_3094":52786},[],"Domain and audit events depend on the bus publisher:",{"_3706":486,"_31461":431,"_21806":52788,"_5":15007,"_28616":52661,"_3094":52789},[],"verify it is enabled in the emitting service;",{"_3706":487,"_31461":431,"_21806":52791,"_5":15007,"_28616":52661,"_3094":52792},[],"check AMQP connectivity and credentials;",{"_3706":488,"_31461":431,"_21806":52794,"_5":15007,"_28616":52661,"_3094":52795},[],"review exchange, routing key, queues and consumers;",{"_3706":489,"_31461":431,"_21806":52797,"_5":15007,"_28616":52661,"_3094":52798},[],"inspect dead-letter queues;",{"_3706":490,"_31461":431,"_21806":52800,"_5":15007,"_28616":52661,"_3094":52801},[],"alert on orphan durable queues and backlog growth.",{"_3706":491,"_31461":431,"_21806":52803,"_5":15007,"_28616":52661,"_3094":52804},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3706":492,"_31461":431,"_21806":52806,"_5":15007,"_28616":52661,"_3094":52807},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3706":493,"_31461":431,"_21806":52809,"_5":15007,"_28616":52661,"_3094":52810},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3706":494,"_31461":431,"_21806":52812,"_5":15007,"_28616":52661,"_3094":52813},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3706":495,"_31461":431,"_21806":52815,"_5":15007,"_28616":52661,"_3094":52816},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3706":496,"_31461":431,"_21806":52818,"_5":15007,"_28616":52661,"_3094":52819},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3706":497,"_31461":431,"_21806":52821,"_5":15007,"_28616":52661,"_3094":52822},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3706":498,"_31461":431,"_21806":52824,"_5":15007,"_28616":52665,"_3094":52825},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3706":499,"_31461":431,"_21806":52827,"_5":15007,"_28616":52665,"_3094":52828},[],"Before closing an incident, record:",{"_3706":500,"_31461":431,"_21806":52830,"_5":15007,"_28616":52665,"_3094":52831},[],"the confirmed cause;",{"_3706":501,"_31461":431,"_21806":52833,"_5":15007,"_28616":52665,"_3094":52834},[],"the time scope and affected resources;",{"_3706":502,"_31461":431,"_21806":52836,"_5":15007,"_28616":52665,"_3094":52837},[],"the commands or queries used;",{"_3706":503,"_31461":431,"_21806":52839,"_5":15007,"_28616":52665,"_3094":52840},[],"the applied change and how to revert it;",{"_3706":504,"_31461":431,"_21806":52842,"_5":15007,"_28616":52665,"_3094":52843},[],"validation from a consumer;",{"_3706":505,"_31461":431,"_21806":52845,"_5":15007,"_28616":52665,"_3094":52846},[],"the preventive action and its owner.",{"_3706":506,"_31461":506,"_5":15367,"_3094":52848,"_31799":52849,"_21806":52853,"_28616":506},"Data model",[51312,52850,52851,52852],"Platform","Administration","Access control",[],{"_3706":507,"_31461":506,"_21806":52855,"_5":15007,"_28616":506,"_3094":52856},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3706":508,"_31461":506,"_5":31796,"_21806":52858,"_28616":52859,"_3094":52860},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3706":509,"_31461":506,"_5":31796,"_21806":52862,"_28616":52863,"_3094":52864},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3706":510,"_31461":506,"_21806":52866,"_5":15007,"_28616":506,"_3094":52867},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3706":511,"_31461":506,"_21806":52869,"_5":15007,"_28616":52859,"_3094":52870},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3706":512,"_31461":506,"_21806":52872,"_5":15007,"_28616":52859,"_3094":52873},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3706":513,"_31461":506,"_21806":52875,"_5":15007,"_28616":52859,"_3094":52876},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3706":514,"_31461":506,"_21806":52878,"_5":15007,"_28616":52863,"_3094":52879},[],"Entity (`schema_name.entity_type`)",{"_3706":515,"_31461":506,"_21806":52881,"_5":15007,"_28616":52863,"_3094":52882},[],"Table (`table_name`)",{"_3706":516,"_31461":506,"_21806":52884,"_5":15007,"_28616":52863,"_3094":52885},[],"Key (`primary_key`)",{"_3706":517,"_31461":506,"_21806":52887,"_5":15007,"_28616":52863,"_3094":52888},[],"`alerts.event`",{"_3706":518,"_31461":506,"_21806":52890,"_5":15007,"_28616":52863,"_3094":52891},[],"`events`",{"_3706":519,"_31461":506,"_21806":52893,"_5":15007,"_28616":52863,"_3094":52894},[],"`event_type`",{"_3706":520,"_31461":506,"_21806":52896,"_5":15007,"_28616":52863,"_3094":52897},[],"`alerts.subscription`",{"_3706":521,"_31461":506,"_21806":52899,"_5":15007,"_28616":52863,"_3094":52900},[],"`subscriptions`",{"_3706":522,"_31461":506,"_21806":52902,"_5":15007,"_28616":52863,"_3094":52903},[],"`id`",{"_3706":523,"_31461":506,"_21806":52905,"_5":15007,"_28616":52863,"_3094":52906},[],"`ca.ca_certificate`",{"_3706":524,"_31461":506,"_21806":52908,"_5":15007,"_28616":52863,"_3094":52909},[],"`ca_certificates`",{"_3706":525,"_31461":506,"_21806":52911,"_5":15007,"_28616":52863,"_3094":52903},[],{"_3706":526,"_31461":506,"_21806":52913,"_5":15007,"_28616":52863,"_3094":52914},[],"`ca.certificate`",{"_3706":527,"_31461":506,"_21806":52916,"_5":15007,"_28616":52863,"_3094":52917},[],"`certificates`",{"_3706":528,"_31461":506,"_21806":52919,"_5":15007,"_28616":52863,"_3094":52920},[],"`serial_number`",{"_3706":529,"_31461":506,"_21806":52922,"_5":15007,"_28616":52863,"_3094":52923},[],"`ca.issuance_profile`",{"_3706":530,"_31461":506,"_21806":52925,"_5":15007,"_28616":52863,"_3094":52926},[],"`issuance_profiles`",{"_3706":531,"_31461":506,"_21806":52928,"_5":15007,"_28616":52863,"_3094":52903},[],{"_3706":532,"_31461":506,"_21806":52930,"_5":15007,"_28616":52863,"_3094":52931},[],"`devicemanager.device_group`",{"_3706":533,"_31461":506,"_21806":52933,"_5":15007,"_28616":52863,"_3094":52934},[],"`device_groups`",{"_3706":534,"_31461":506,"_21806":52936,"_5":15007,"_28616":52863,"_3094":52903},[],{"_3706":535,"_31461":506,"_21806":52938,"_5":15007,"_28616":52863,"_3094":52939},[],"`devicemanager.device`",{"_3706":536,"_31461":506,"_21806":52941,"_5":15007,"_28616":52863,"_3094":52942},[],"`devices`",{"_3706":537,"_31461":506,"_21806":52944,"_5":15007,"_28616":52863,"_3094":52903},[],{"_3706":538,"_31461":506,"_21806":52946,"_5":15007,"_28616":52863,"_3094":52947},[],"`dmsmanager.dms`",{"_3706":539,"_31461":506,"_21806":52949,"_5":15007,"_28616":52863,"_3094":52950},[],"`dms`",{"_3706":540,"_31461":506,"_21806":52952,"_5":15007,"_28616":52863,"_3094":52903},[],{"_3706":541,"_31461":506,"_21806":52954,"_5":15007,"_28616":52863,"_3094":52955},[],"`kms.kms_key`",{"_3706":542,"_31461":506,"_21806":52957,"_5":15007,"_28616":52863,"_3094":52958},[],"`kms_keys`",{"_3706":543,"_31461":506,"_21806":52960,"_5":15007,"_28616":52863,"_3094":52961},[],"`key_id`, `engine_id`",{"_3706":544,"_31461":506,"_21806":52963,"_5":15007,"_28616":52863,"_3094":52964},[],"`va.crl_settings`",{"_3706":545,"_31461":506,"_21806":52966,"_5":15007,"_28616":52863,"_3094":52967},[],"`crl_settings`",{"_3706":546,"_31461":506,"_21806":52969,"_5":15007,"_28616":52863,"_3094":52970},[],"`ca_id`",{"_3706":547,"_31461":506,"_21806":52972,"_5":15007,"_28616":52863,"_3094":52973},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3706":548,"_31461":506,"_21806":52975,"_5":15007,"_28616":52863,"_3094":52976},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3706":549,"_31461":506,"_21806":52978,"_5":15007,"_28616":52863,"_3094":52979},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3706":550,"_31461":550,"_5":15367,"_3094":52981,"_31799":52982,"_21806":52983,"_28616":550},"Access control overview",[51312,52850,52851,52852],[],{"_3706":551,"_31461":550,"_21806":52985,"_5":15007,"_28616":550,"_3094":52986},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3706":552,"_31461":550,"_5":31796,"_21806":52988,"_28616":52989,"_3094":52990},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3706":553,"_31461":550,"_5":31796,"_21806":52992,"_28616":52993,"_3094":52994},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3706":554,"_31461":550,"_5":31796,"_21806":52996,"_28616":52997,"_3094":52998},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3706":555,"_31461":550,"_5":31796,"_21806":53000,"_28616":53001,"_3094":53002},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3706":556,"_31461":550,"_5":31796,"_21806":53004,"_28616":53005,"_3094":53006},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3706":557,"_31461":550,"_5":31796,"_21806":53008,"_28616":53009,"_3094":53010},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3706":558,"_31461":550,"_5":31796,"_21806":53012,"_28616":53013,"_3094":53014},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3706":559,"_31461":550,"_5":31796,"_21806":53016,"_28616":53017,"_3094":53018},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3706":560,"_31461":550,"_5":31796,"_21806":53020,"_28616":53021,"_3094":53022},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3706":561,"_31461":550,"_5":31796,"_21806":53024,"_28616":53025,"_3094":53026},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3706":562,"_31461":550,"_5":31796,"_21806":53028,"_28616":53029,"_3094":53030},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3706":563,"_31461":550,"_5":31796,"_21806":53032,"_28616":53033,"_3094":53034},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3706":564,"_31461":550,"_5":31796,"_21806":53036,"_28616":53037,"_3094":53038},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3706":565,"_31461":550,"_5":31796,"_21806":53040,"_28616":53041,"_3094":53042},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3706":566,"_31461":550,"_5":31796,"_21806":53044,"_28616":53045,"_3094":53046},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3706":567,"_31461":550,"_5":31796,"_21806":53048,"_28616":53049,"_3094":51966},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3706":568,"_31461":550,"_5":31796,"_21806":53051,"_28616":53052,"_3094":53053},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3706":569,"_31461":550,"_5":31796,"_21806":53055,"_28616":53056,"_3094":53057},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3706":570,"_31461":550,"_5":31796,"_21806":53059,"_28616":53060,"_3094":53061},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3706":571,"_31461":550,"_5":31796,"_21806":53063,"_28616":53064,"_3094":53065},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3706":572,"_31461":550,"_5":31796,"_21806":53067,"_28616":53068,"_3094":53069},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3706":573,"_31461":550,"_5":31796,"_21806":53071,"_28616":53072,"_3094":53073},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3706":574,"_31461":550,"_5":31796,"_21806":53075,"_28616":53076,"_3094":53077},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3706":575,"_31461":550,"_5":31796,"_21806":53079,"_28616":53080,"_3094":53081},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3706":576,"_31461":550,"_5":31796,"_21806":53083,"_28616":53084,"_3094":53085},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3706":577,"_31461":550,"_5":31796,"_21806":53087,"_28616":53088,"_3094":53089},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3706":578,"_31461":550,"_5":31796,"_21806":53091,"_28616":53092,"_3094":53093},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3706":579,"_31461":550,"_5":31796,"_21806":53095,"_28616":53096,"_3094":53097},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3706":580,"_31461":550,"_5":31796,"_21806":53099,"_28616":53100,"_3094":53101},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3706":581,"_31461":550,"_5":31796,"_21806":53103,"_28616":53104,"_3094":53105},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3706":582,"_31461":550,"_5":31796,"_21806":53107,"_28616":53108,"_3094":53109},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3706":583,"_31461":550,"_21806":53111,"_5":15007,"_28616":550,"_3094":53112},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3706":584,"_31461":550,"_21806":53114,"_5":15007,"_28616":550,"_3094":53115},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3706":585,"_31461":550,"_21806":53117,"_5":15007,"_28616":550,"_3094":53118},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3706":586,"_31461":550,"_21806":53120,"_5":15007,"_28616":52989,"_3094":53121},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3706":587,"_31461":550,"_21806":53123,"_5":15007,"_28616":52989,"_3094":53124},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3706":588,"_31461":550,"_21806":53126,"_5":15007,"_28616":52989,"_3094":53127},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3706":589,"_31461":550,"_21806":53129,"_5":15007,"_28616":52989,"_3094":53130},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3706":590,"_31461":550,"_21806":53132,"_5":15007,"_28616":52989,"_3094":53133},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3706":591,"_31461":550,"_21806":53135,"_5":15007,"_28616":52989,"_3094":53136},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3706":592,"_31461":550,"_21806":53138,"_5":15007,"_28616":52993,"_3094":53139},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3706":593,"_31461":550,"_21806":53141,"_5":15007,"_28616":52993,"_3094":53142},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3706":594,"_31461":550,"_21806":53144,"_5":15007,"_28616":52997,"_3094":53145},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3706":595,"_31461":550,"_21806":53147,"_5":15007,"_28616":52997,"_3094":53148},[],"The decision is made **before forwarding the request to the service**:",{"_3706":596,"_31461":550,"_21806":53150,"_5":15007,"_28616":52997,"_3094":53151},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3706":597,"_31461":550,"_21806":53153,"_5":15007,"_28616":52997,"_3094":53154},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3706":598,"_31461":550,"_21806":53156,"_5":15007,"_28616":52997,"_3094":53157},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3706":599,"_31461":550,"_21806":53159,"_5":15007,"_28616":52997,"_3094":53160},[],"It separately loads the policies granted to each principal.",{"_3706":600,"_31461":550,"_21806":53162,"_5":15007,"_28616":52997,"_3094":53163},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3706":601,"_31461":550,"_21806":53165,"_5":15007,"_28616":52997,"_3094":53166},[],"`authz` looks for an HTTP rule granting that action.",{"_3706":602,"_31461":550,"_21806":53168,"_5":15007,"_28616":52997,"_3094":53169},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3706":603,"_31461":550,"_21806":53171,"_5":15007,"_28616":52997,"_3094":53172},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3706":604,"_31461":550,"_21806":53174,"_5":15007,"_28616":52997,"_3094":53175},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3706":605,"_31461":550,"_21806":53177,"_5":15007,"_28616":52997,"_3094":53178},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3706":606,"_31461":550,"_21806":53180,"_5":15007,"_28616":53001,"_3094":53181},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3706":607,"_31461":550,"_21806":53183,"_5":15007,"_28616":53001,"_3094":53184},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3706":608,"_31461":550,"_21806":53186,"_5":15007,"_28616":53001,"_3094":53187},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3706":609,"_31461":550,"_21806":53189,"_5":15007,"_28616":53001,"_3094":53190},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3706":610,"_31461":550,"_21806":53192,"_5":15007,"_28616":53001,"_3094":53193},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3706":611,"_31461":550,"_21806":53195,"_5":15007,"_28616":53001,"_3094":53196},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3706":612,"_31461":550,"_21806":53198,"_5":15007,"_28616":53001,"_3094":53199},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3706":613,"_31461":550,"_21806":53201,"_5":15007,"_28616":53001,"_3094":53202},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3706":614,"_31461":550,"_21806":53204,"_5":15007,"_28616":53001,"_3094":53205},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3706":615,"_31461":550,"_21806":53207,"_5":15007,"_28616":53001,"_3094":53208},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3706":616,"_31461":550,"_21806":53210,"_5":15007,"_28616":53005,"_3094":53211},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3706":617,"_31461":550,"_21806":53213,"_5":15007,"_28616":53005,"_3094":53214},[],"The decision is made with the domain operation context:",{"_3706":618,"_31461":550,"_21806":53216,"_5":15007,"_28616":53005,"_3094":53217},[],"The middleware extracts the credential and resolves the matching principals.",{"_3706":619,"_31461":550,"_21806":53219,"_5":15007,"_28616":53005,"_3094":53220},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3706":620,"_31461":550,"_21806":53222,"_5":15007,"_28616":53005,"_3094":53223},[],"`authz` gathers the entity rules of the granted policies.",{"_3706":621,"_31461":550,"_21806":53225,"_5":15007,"_28616":53005,"_3094":53226},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3706":622,"_31461":550,"_21806":53228,"_5":15007,"_28616":53005,"_3094":53229},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3706":623,"_31461":550,"_21806":53231,"_5":15007,"_28616":53005,"_3094":53232},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3706":624,"_31461":550,"_21806":53234,"_5":15007,"_28616":53005,"_3094":53235},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3706":625,"_31461":550,"_21806":53237,"_5":15007,"_28616":53005,"_3094":53238},[],"Actions fall into two groups:",{"_3706":626,"_31461":550,"_21806":53240,"_5":15007,"_28616":53005,"_3094":53241},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3706":627,"_31461":550,"_21806":53243,"_5":15007,"_28616":53005,"_3094":53244},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3706":628,"_31461":550,"_21806":53246,"_5":15007,"_28616":53005,"_3094":53247},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3706":629,"_31461":550,"_21806":53249,"_5":15007,"_28616":53009,"_3094":53250},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3706":630,"_31461":550,"_21806":53252,"_5":15007,"_28616":53009,"_3094":53253},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3706":631,"_31461":550,"_21806":53255,"_5":15007,"_28616":53009,"_3094":53256},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3706":632,"_31461":550,"_21806":53258,"_5":15007,"_28616":53013,"_3094":53259},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3706":633,"_31461":550,"_21806":53261,"_5":15007,"_28616":53013,"_3094":53262},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3706":634,"_31461":550,"_21806":53264,"_5":15007,"_28616":53013,"_3094":53265},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3706":635,"_31461":550,"_21806":53267,"_5":15007,"_28616":53013,"_3094":53268},[],"The implemented operators are:",{"_3706":636,"_31461":550,"_21806":53270,"_5":15007,"_28616":53013,"_3094":53271},[],"`equals`, for exact equality;",{"_3706":637,"_31461":550,"_21806":53273,"_5":15007,"_28616":53013,"_3094":53274},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3706":638,"_31461":550,"_21806":53276,"_5":15007,"_28616":53013,"_3094":53277},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3706":639,"_31461":550,"_21806":53279,"_5":15007,"_28616":53013,"_3094":53280},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3706":640,"_31461":550,"_21806":53282,"_5":15007,"_28616":53017,"_3094":53283},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3706":641,"_31461":550,"_21806":53285,"_5":15007,"_28616":53017,"_3094":53286},[],"The available modes are:",{"_3706":642,"_31461":550,"_21806":53288,"_5":15007,"_28616":53017,"_3094":53289},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3706":643,"_31461":550,"_21806":53291,"_5":15007,"_28616":53017,"_3094":53292},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3706":644,"_31461":550,"_21806":53294,"_5":15007,"_28616":53017,"_3094":53295},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3706":645,"_31461":550,"_21806":53297,"_5":15007,"_28616":53017,"_3094":53298},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3706":646,"_31461":550,"_21806":53300,"_5":15007,"_28616":53017,"_3094":53301},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3706":647,"_31461":550,"_21806":53303,"_5":15007,"_28616":53017,"_3094":53304},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3706":648,"_31461":550,"_21806":53306,"_5":15007,"_28616":53021,"_3094":53307},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3706":649,"_31461":550,"_21806":53309,"_5":15007,"_28616":53021,"_3094":53310},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3706":650,"_31461":550,"_21806":53312,"_5":15007,"_28616":53021,"_3094":53313},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3706":651,"_31461":550,"_21806":53315,"_5":15007,"_28616":53021,"_3094":53316},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3706":652,"_31461":550,"_21806":53318,"_5":15007,"_28616":53029,"_3094":53319},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3706":653,"_31461":550,"_21806":53321,"_5":15007,"_28616":53029,"_3094":53322},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3706":654,"_31461":550,"_21806":53324,"_5":15007,"_28616":53033,"_3094":53325},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3706":655,"_31461":550,"_21806":53327,"_5":15007,"_28616":53033,"_3094":53328},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3706":656,"_31461":550,"_21806":53330,"_5":15007,"_28616":53033,"_3094":53331},[],"The data model shows how the resources used in entity rules are connected.",{"_3706":657,"_31461":550,"_21806":53333,"_5":15007,"_28616":53033,"_3094":53334},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3706":658,"_31461":550,"_21806":53336,"_5":15007,"_28616":53033,"_3094":53337},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3706":659,"_31461":550,"_21806":53339,"_5":15007,"_28616":53037,"_3094":53340},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3706":660,"_31461":550,"_21806":53342,"_5":15007,"_28616":53037,"_3094":53343},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3706":661,"_31461":550,"_21806":53345,"_5":15007,"_28616":53037,"_3094":53346},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3706":662,"_31461":550,"_21806":53348,"_5":15007,"_28616":53041,"_3094":53349},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3706":663,"_31461":550,"_21806":53351,"_5":15007,"_28616":53041,"_3094":53352},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3706":664,"_31461":550,"_21806":53354,"_5":15007,"_28616":53041,"_3094":53355},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3706":665,"_31461":550,"_21806":53357,"_5":15007,"_28616":53041,"_3094":53358},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3706":666,"_31461":550,"_21806":53360,"_5":15007,"_28616":53041,"_3094":53361},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3706":667,"_31461":550,"_21806":53363,"_5":15007,"_28616":53041,"_3094":53364},[],"Note that:",{"_3706":668,"_31461":550,"_21806":53366,"_5":15007,"_28616":53041,"_3094":53367},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3706":669,"_31461":550,"_21806":53369,"_5":15007,"_28616":53041,"_3094":53370},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3706":670,"_31461":550,"_21806":53372,"_5":15007,"_28616":53041,"_3094":53373},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3706":671,"_31461":550,"_21806":53375,"_5":15007,"_28616":53045,"_3094":53376},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3706":672,"_31461":550,"_21806":53378,"_5":15007,"_28616":53045,"_3094":53379},[],"full and read-only access to certificates and authorities;",{"_3706":673,"_31461":550,"_21806":53381,"_5":15007,"_28616":53045,"_3094":53382},[],"full and read-only access to the KMS;",{"_3706":674,"_31461":550,"_21806":53384,"_5":15007,"_28616":53045,"_3094":53385},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3706":675,"_31461":550,"_21806":53387,"_5":15007,"_28616":53045,"_3094":53388},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3706":676,"_31461":550,"_21806":53390,"_5":15007,"_28616":53045,"_3094":53391},[],"console access;",{"_3706":677,"_31461":550,"_21806":53393,"_5":15007,"_28616":53045,"_3094":53394},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3706":678,"_31461":550,"_21806":53396,"_5":15007,"_28616":53045,"_3094":53397},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3706":679,"_31461":550,"_21806":53399,"_5":15007,"_28616":53045,"_3094":53400},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3706":680,"_31461":550,"_21806":53402,"_5":15007,"_28616":53045,"_3094":53403},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3706":681,"_31461":550,"_21806":53405,"_5":15007,"_28616":53045,"_3094":53406},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3706":682,"_31461":550,"_21806":53408,"_5":15007,"_28616":53049,"_3094":53409},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3706":683,"_31461":550,"_21806":53411,"_5":15007,"_28616":53049,"_3094":53412},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3706":684,"_31461":550,"_21806":53414,"_5":15007,"_28616":53049,"_3094":53415},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3706":685,"_31461":550,"_21806":53417,"_5":15007,"_28616":53052,"_3094":53418},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3706":686,"_31461":550,"_21806":53420,"_5":15007,"_28616":53056,"_3094":53421},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3706":687,"_31461":550,"_21806":53423,"_5":15007,"_28616":53056,"_3094":53424},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3706":688,"_31461":550,"_21806":53426,"_5":15007,"_28616":53060,"_3094":53427},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3706":689,"_31461":550,"_21806":53429,"_5":15007,"_28616":53064,"_3094":53430},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3706":690,"_31461":550,"_21806":53432,"_5":15007,"_28616":53068,"_3094":53433},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3706":691,"_31461":550,"_21806":53435,"_5":15007,"_28616":53072,"_3094":53436},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3706":692,"_31461":550,"_21806":53438,"_5":15007,"_28616":53072,"_3094":53439},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3706":693,"_31461":550,"_21806":53441,"_5":15007,"_28616":53076,"_3094":53442},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3706":694,"_31461":550,"_21806":53444,"_5":15007,"_28616":53076,"_3094":53445},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3706":695,"_31461":550,"_21806":53447,"_5":15007,"_28616":53076,"_3094":53448},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3706":696,"_31461":550,"_21806":53450,"_5":15007,"_28616":53076,"_3094":53451},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3706":697,"_31461":550,"_21806":53453,"_5":15007,"_28616":53076,"_3094":53454},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3706":698,"_31461":550,"_21806":53456,"_5":15007,"_28616":53076,"_3094":53457},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3706":699,"_31461":550,"_21806":53459,"_5":15007,"_28616":53076,"_3094":53460},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3706":700,"_31461":550,"_21806":53462,"_5":15007,"_28616":53076,"_3094":53463},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3706":701,"_31461":550,"_21806":53465,"_5":15007,"_28616":53080,"_3094":53466},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3706":702,"_31461":550,"_21806":53468,"_5":15007,"_28616":53080,"_3094":53469},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3706":703,"_31461":550,"_21806":53471,"_5":15007,"_28616":53080,"_3094":53472},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3706":704,"_31461":550,"_21806":53474,"_5":15007,"_28616":53084,"_3094":53475},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3706":705,"_31461":550,"_21806":53477,"_5":15007,"_28616":53084,"_3094":53478},[],"Use groups or stable roles for people and independent identities for automations.",{"_3706":706,"_31461":550,"_21806":53480,"_5":15007,"_28616":53084,"_3094":53481},[],"Keep at least two recovery administrators and test their access periodically.",{"_3706":707,"_31461":550,"_21806":53483,"_5":15007,"_28616":53084,"_3094":53484},[],"Review active principals, their matches and their grants after IdP changes.",{"_3706":708,"_31461":550,"_21806":53486,"_5":15007,"_28616":53084,"_3094":53487},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3706":709,"_31461":550,"_21806":53489,"_5":15007,"_28616":53084,"_3094":53490},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3706":710,"_31461":550,"_21806":53492,"_5":15007,"_28616":53084,"_3094":53493},[],"Always test one allowed and one denied operation for each role.",{"_3706":711,"_31461":550,"_21806":53495,"_5":15007,"_28616":53084,"_3094":53496},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3706":712,"_31461":550,"_21806":53498,"_5":15007,"_28616":53092,"_3094":53499},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3706":713,"_31461":550,"_21806":53501,"_5":15007,"_28616":53096,"_3094":53502},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3706":714,"_31461":550,"_21806":53504,"_5":15007,"_28616":53096,"_3094":53505},[],"that an active principal of the correct type exists;",{"_3706":715,"_31461":550,"_21806":53507,"_5":15007,"_28616":53096,"_3094":53508},[],"that the claim paths and values match the real token exactly;",{"_3706":716,"_31461":550,"_21806":53510,"_5":15007,"_28616":53096,"_3094":53511},[],"that all of the principal's conditions hold;",{"_3706":717,"_31461":550,"_21806":53513,"_5":15007,"_28616":53096,"_3094":53514},[],"that the principal has the expected policy granted;",{"_3706":718,"_31461":550,"_21806":53516,"_5":15007,"_28616":53096,"_3094":53517},[],"that the policy includes the action and the requested resource type or route;",{"_3706":719,"_31461":550,"_21806":53519,"_5":15007,"_28616":53096,"_3094":53520},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3706":720,"_31461":550,"_21806":53522,"_5":15007,"_28616":53096,"_3094":53523},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3706":721,"_31461":550,"_21806":53525,"_5":15007,"_28616":53096,"_3094":53526},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3706":722,"_31461":550,"_21806":53528,"_5":15007,"_28616":53100,"_3094":53529},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3706":723,"_31461":550,"_21806":53531,"_5":15007,"_28616":53104,"_3094":53532},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3706":724,"_31461":550,"_21806":53534,"_5":15007,"_28616":53108,"_3094":53535},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3706":725,"_31461":550,"_21806":53537,"_5":15007,"_28616":53108,"_3094":53538},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3706":726,"_31461":726,"_5":15367,"_3094":53540,"_31799":53541,"_21806":53542,"_28616":726},"Alerts and subscriptions",[51312,52850,52851],[],{"_3706":727,"_31461":726,"_21806":53544,"_5":15007,"_28616":726,"_3094":53545},[],"Send PKI events to people and external systems.",{"_3706":728,"_31461":726,"_5":31796,"_21806":53547,"_28616":53548,"_3094":53549},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3706":729,"_31461":726,"_5":31796,"_21806":53551,"_28616":53552,"_3094":53553},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3706":730,"_31461":726,"_5":31796,"_21806":53555,"_28616":53556,"_3094":53557},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3706":731,"_31461":726,"_5":31796,"_21806":53559,"_28616":53560,"_3094":53561},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3706":732,"_31461":726,"_5":31796,"_21806":53563,"_28616":53564,"_3094":53565},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3706":733,"_31461":726,"_5":31796,"_21806":53567,"_28616":53568,"_3094":53569},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3706":734,"_31461":726,"_5":31796,"_21806":53571,"_28616":53572,"_3094":53573},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3706":735,"_31461":726,"_5":31796,"_21806":53575,"_28616":53576,"_3094":53577},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3706":736,"_31461":726,"_5":31796,"_21806":53579,"_28616":53580,"_3094":53581},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3706":737,"_31461":726,"_5":31796,"_21806":53583,"_28616":53584,"_3094":53585},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3706":738,"_31461":726,"_5":31796,"_21806":53587,"_28616":53588,"_3094":53589},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3706":739,"_31461":726,"_21806":53591,"_5":15007,"_28616":726,"_3094":53592},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3706":740,"_31461":726,"_21806":53594,"_5":15007,"_28616":53548,"_3094":53595},[],"A service publishes a domain event.",{"_3706":741,"_31461":726,"_21806":53597,"_5":15007,"_28616":53548,"_3094":53598},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3706":742,"_31461":726,"_21806":53600,"_5":15007,"_28616":53548,"_3094":53601},[],"Each subscription's filter decides whether it should be notified.",{"_3706":743,"_31461":726,"_21806":53603,"_5":15007,"_28616":53548,"_3094":53604},[],"Lamassu delivers the event to the configured channel.",{"_3706":744,"_31461":726,"_21806":53606,"_5":15007,"_28616":53548,"_3094":53607},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3706":745,"_31461":726,"_21806":53609,"_5":15007,"_28616":53552,"_3094":53610},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3706":746,"_31461":726,"_21806":53612,"_5":15007,"_28616":53552,"_3094":53613},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3706":747,"_31461":726,"_21806":53615,"_5":15007,"_28616":53552,"_3094":53616},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3706":748,"_31461":726,"_21806":53618,"_5":15007,"_28616":53552,"_3094":53619},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3706":749,"_31461":726,"_21806":53621,"_5":15007,"_28616":53552,"_3094":53622},[],"`apikey_options` requires `header` and `key`.",{"_3706":750,"_31461":726,"_21806":53624,"_5":15007,"_28616":53552,"_3094":53625},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3706":751,"_31461":726,"_21806":53627,"_5":15007,"_28616":53552,"_3094":53628},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3706":752,"_31461":726,"_21806":53630,"_5":15007,"_28616":53552,"_3094":53631},[],"The alerts API reference documents the full `http_client` schema.",{"_3706":753,"_31461":726,"_21806":53633,"_5":15007,"_28616":53560,"_3094":53634},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3706":754,"_31461":726,"_21806":53636,"_5":15007,"_28616":53564,"_3094":53637},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3706":755,"_31461":726,"_21806":53639,"_5":15007,"_28616":53568,"_3094":53640},[],"Add a filter if you don't want to receive every instance of the event.",{"_3706":756,"_31461":726,"_21806":53642,"_5":15007,"_28616":53568,"_3094":53643},[],"**None** notifies all instances of the event.",{"_3706":757,"_31461":726,"_21806":53645,"_5":15007,"_28616":53568,"_3094":53646},[],"**JSON Path** evaluates one or more specific fields.",{"_3706":758,"_31461":726,"_21806":53648,"_5":15007,"_28616":53568,"_3094":53649},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3706":759,"_31461":726,"_21806":53651,"_5":15007,"_28616":53568,"_3094":53652},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3706":760,"_31461":726,"_21806":53654,"_5":15007,"_28616":53568,"_3094":53655},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3706":761,"_31461":726,"_21806":53657,"_5":15007,"_28616":53568,"_3094":53658},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3706":762,"_31461":726,"_21806":53660,"_5":15007,"_28616":53572,"_3094":53661},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3706":763,"_31461":726,"_21806":53663,"_5":15007,"_28616":53576,"_3094":53664},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3706":764,"_31461":726,"_21806":53666,"_5":15007,"_28616":53576,"_3094":53667},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3706":765,"_31461":726,"_21806":53669,"_5":15007,"_28616":53576,"_3094":53670},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3706":766,"_31461":726,"_21806":53672,"_5":15007,"_28616":53576,"_3094":53673},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3706":767,"_31461":726,"_21806":53675,"_5":15007,"_28616":53576,"_3094":53676},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3706":768,"_31461":726,"_21806":53678,"_5":15007,"_28616":53576,"_3094":53679},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3706":769,"_31461":726,"_21806":53681,"_5":15007,"_28616":53576,"_3094":53682},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3706":770,"_31461":726,"_21806":53684,"_5":15007,"_28616":53576,"_3094":53685},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3706":771,"_31461":726,"_21806":53687,"_5":15007,"_28616":53580,"_3094":53688},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3706":772,"_31461":726,"_21806":53690,"_5":15007,"_28616":53580,"_3094":53691},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3706":773,"_31461":726,"_21806":53693,"_5":15007,"_28616":53580,"_3094":53694},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3706":774,"_31461":726,"_21806":53696,"_5":15007,"_28616":53580,"_3094":53697},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3706":775,"_31461":726,"_21806":53699,"_5":15007,"_28616":53580,"_3094":53700},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3706":776,"_31461":726,"_21806":53702,"_5":15007,"_28616":53580,"_3094":53703},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3706":777,"_31461":726,"_21806":53705,"_5":15007,"_28616":53580,"_3094":53706},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3706":778,"_31461":726,"_21806":53708,"_5":15007,"_28616":53580,"_3094":53709},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3706":779,"_31461":726,"_21806":53711,"_5":15007,"_28616":53584,"_3094":53712},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3706":780,"_31461":726,"_21806":53714,"_5":15007,"_28616":53584,"_3094":53715},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3706":781,"_31461":726,"_21806":53717,"_5":15007,"_28616":53588,"_3094":53718},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3706":782,"_31461":726,"_21806":53720,"_5":15007,"_28616":53588,"_3094":53721},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3706":783,"_31461":726,"_21806":53723,"_5":15007,"_28616":53588,"_3094":53724},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3706":784,"_31461":726,"_21806":53726,"_5":15007,"_28616":53588,"_3094":53727},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3706":785,"_31461":726,"_21806":53729,"_5":15007,"_28616":53588,"_3094":53730},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3706":786,"_31461":726,"_21806":53732,"_5":15007,"_28616":53588,"_3094":53733},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3706":787,"_31461":726,"_21806":53735,"_5":15007,"_28616":53588,"_3094":53736},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3706":788,"_31461":726,"_21806":53738,"_5":15007,"_28616":53588,"_3094":53739},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3706":789,"_31461":726,"_21806":53741,"_5":15007,"_28616":53588,"_3094":53742},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3706":790,"_31461":726,"_21806":53744,"_5":15007,"_28616":53588,"_3094":53745},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3706":791,"_31461":791,"_5":15367,"_3094":53747,"_31799":53748,"_21806":53749,"_28616":791},"Audit logs",[51312,52850,52851],[],{"_3706":792,"_31461":791,"_21806":53751,"_5":15007,"_28616":791,"_3094":53752},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3706":793,"_31461":791,"_5":31796,"_21806":53754,"_28616":53755,"_3094":53756},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3706":794,"_31461":791,"_5":31796,"_21806":53758,"_28616":53759,"_3094":53760},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3706":795,"_31461":791,"_5":31796,"_21806":53762,"_28616":53763,"_3094":53764},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3706":796,"_31461":791,"_5":31796,"_21806":53766,"_28616":53767,"_3094":53768},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3706":797,"_31461":791,"_5":31796,"_21806":53770,"_28616":53771,"_3094":53772},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3706":798,"_31461":791,"_5":31796,"_21806":53774,"_28616":53775,"_3094":53776},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3706":799,"_31461":791,"_5":31796,"_21806":53778,"_28616":53779,"_3094":53780},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3706":800,"_31461":791,"_5":31796,"_21806":53782,"_28616":53783,"_3094":53784},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3706":801,"_31461":791,"_5":31796,"_21806":53786,"_28616":53787,"_3094":53788},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3706":802,"_31461":791,"_5":31796,"_21806":53790,"_28616":53791,"_3094":53792},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3706":803,"_31461":791,"_5":31796,"_21806":53794,"_28616":53795,"_3094":53796},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3706":804,"_31461":791,"_21806":53798,"_5":15007,"_28616":791,"_3094":53799},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3706":805,"_31461":791,"_21806":53801,"_5":15007,"_28616":53755,"_3094":53802},[],"The audit body includes:",{"_3706":806,"_31461":791,"_21806":53804,"_5":15007,"_28616":53755,"_3094":53805},[],"input: data received by the operation;",{"_3706":807,"_31461":791,"_21806":53807,"_5":15007,"_28616":53755,"_3094":53808},[],"has\\_error: whether the service returned an error;",{"_3706":808,"_31461":791,"_21806":53810,"_5":15007,"_28616":53755,"_3094":53811},[],"output: produced result or error message;",{"_3706":809,"_31461":791,"_21806":53813,"_5":15007,"_28616":53755,"_3094":53814},[],"principals: identifiers of the principals that matched the request.",{"_3706":810,"_31461":791,"_21806":53816,"_5":15007,"_28616":53755,"_3094":53817},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3706":811,"_31461":791,"_21806":53819,"_5":15007,"_28616":53755,"_3094":53820},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3706":812,"_31461":791,"_21806":53822,"_5":15007,"_28616":53759,"_3094":53823},[],"The backend applies auditing to mutations of:",{"_3706":813,"_31461":791,"_21806":53825,"_5":15007,"_28616":53759,"_3094":53826},[],"authorities, certificates and issuance profiles;",{"_3706":814,"_31461":791,"_21806":53828,"_5":15007,"_28616":53759,"_3094":53829},[],"keys and KMS engines;",{"_3706":815,"_31461":791,"_21806":53831,"_5":15007,"_28616":53759,"_3094":53832},[],"devices and identities;",{"_3706":816,"_31461":791,"_21806":53834,"_5":15007,"_28616":53759,"_3094":53835},[],"DMSs and enrollment operations;",{"_3706":817,"_31461":791,"_21806":53837,"_5":15007,"_28616":53759,"_3094":53838},[],"validation functions and CRL;",{"_3706":818,"_31461":791,"_21806":53840,"_5":15007,"_28616":53759,"_3094":53841},[],"principals, policies and authorization grants.",{"_3706":819,"_31461":791,"_21806":53843,"_5":15007,"_28616":53759,"_3094":53844},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3706":820,"_31461":791,"_21806":53846,"_5":15007,"_28616":53763,"_3094":53847},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3706":821,"_31461":791,"_21806":53849,"_5":15007,"_28616":53763,"_3094":53850},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3706":822,"_31461":791,"_21806":53852,"_5":15007,"_28616":53763,"_3094":53853},[],"Design the consumer to:",{"_3706":823,"_31461":791,"_21806":53855,"_5":15007,"_28616":53763,"_3094":53856},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3706":824,"_31461":791,"_21806":53858,"_5":15007,"_28616":53763,"_3094":53859},[],"keep the complete CloudEvent unmodified;",{"_3706":825,"_31461":791,"_21806":53861,"_5":15007,"_28616":53763,"_3094":53862},[],"record the ingestion time and detect duplicates by ID;",{"_3706":826,"_31461":791,"_21806":53864,"_5":15007,"_28616":53763,"_3094":53865},[],"encrypt in transit and at rest;",{"_3706":827,"_31461":791,"_21806":53867,"_5":15007,"_28616":53763,"_3094":53868},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3706":828,"_31461":791,"_21806":53870,"_5":15007,"_28616":53763,"_3094":53871},[],"apply an explicit retention and legal hold policy;",{"_3706":829,"_31461":791,"_21806":53873,"_5":15007,"_28616":53763,"_3094":53874},[],"alert if it stops consuming or the pending queue grows.",{"_3706":830,"_31461":791,"_21806":53876,"_5":15007,"_28616":53767,"_3094":53877},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3706":831,"_31461":791,"_21806":53879,"_5":15007,"_28616":53767,"_3094":53880},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3706":832,"_31461":791,"_21806":53882,"_5":15007,"_28616":53775,"_3094":53883},[],"Start from the reported time and normalize every source to UTC.",{"_3706":833,"_31461":791,"_21806":53885,"_5":15007,"_28616":53779,"_3094":53886},[],"Filter by event type, service source and resource identifier.",{"_3706":834,"_31461":791,"_21806":53888,"_5":15007,"_28616":53783,"_3094":53889},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3706":835,"_31461":791,"_21806":53891,"_5":15007,"_28616":53787,"_3094":53892},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3706":836,"_31461":791,"_21806":53894,"_5":15007,"_28616":53791,"_3094":53895},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3706":837,"_31461":791,"_21806":53897,"_5":15007,"_28616":53795,"_3094":53898},[],"Generate a controlled mutation in a test environment and check that:",{"_3706":838,"_31461":791,"_21806":53900,"_5":15007,"_28616":53795,"_3094":53901},[],"a successful audit event appears;",{"_3706":839,"_31461":791,"_21806":53903,"_5":15007,"_28616":53795,"_3094":53904},[],"the principal matches the identity used;",{"_3706":840,"_31461":791,"_21806":53906,"_5":15007,"_28616":53795,"_3094":53907},[],"the consumer persists it exactly once;",{"_3706":841,"_31461":791,"_21806":53909,"_5":15007,"_28616":53795,"_3094":53910},[],"it can be retrieved by resource, actor and period;",{"_3706":842,"_31461":791,"_21806":53912,"_5":15007,"_28616":53795,"_3094":53913},[],"a consumer outage raises an alert.",{"_3706":843,"_31461":791,"_21806":53915,"_5":15007,"_28616":53795,"_3094":53916},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3706":844,"_31461":844,"_5":15367,"_3094":53918,"_31799":53919,"_21806":53920,"_28616":844},"Platform architecture",[51312,52850],[],{"_3706":845,"_31461":844,"_21806":53922,"_5":15007,"_28616":844,"_3094":53923},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3706":846,"_31461":844,"_5":31796,"_21806":53925,"_28616":53926,"_3094":53927},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3706":847,"_31461":844,"_5":31796,"_21806":53929,"_28616":53930,"_3094":53931},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3706":848,"_31461":844,"_5":31796,"_21806":53933,"_28616":53934,"_3094":53935},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3706":849,"_31461":844,"_5":31796,"_21806":53937,"_28616":53938,"_3094":53939},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3706":850,"_31461":844,"_5":31796,"_21806":53941,"_28616":53942,"_3094":53943},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3706":851,"_31461":844,"_21806":53945,"_5":15007,"_28616":844,"_3094":53946},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3706":852,"_31461":844,"_21806":53948,"_5":15007,"_28616":844,"_3094":53949},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3706":853,"_31461":844,"_21806":53951,"_5":15007,"_28616":53926,"_3094":53952},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3706":854,"_31461":844,"_21806":53954,"_5":15007,"_28616":53930,"_3094":53955},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3706":855,"_31461":844,"_21806":53957,"_5":15007,"_28616":53934,"_3094":53958},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3706":856,"_31461":844,"_21806":53960,"_5":15007,"_28616":53938,"_3094":53961},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3706":857,"_31461":844,"_21806":53963,"_5":15007,"_28616":53942,"_3094":53964},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3706":858,"_31461":858,"_5":15367,"_3094":53966,"_31799":53967,"_21806":53968,"_28616":858},"How Lamassu works",[51312,52850],[],{"_3706":859,"_31461":858,"_21806":53970,"_5":15007,"_28616":858,"_3094":53971},[],"The mental model of trust, keys, certificates and devices.",{"_3706":860,"_31461":858,"_5":31796,"_21806":53973,"_28616":53974,"_3094":53975},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3706":861,"_31461":858,"_5":31796,"_21806":53977,"_28616":53978,"_3094":53979},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3706":862,"_31461":858,"_21806":53981,"_5":15007,"_28616":858,"_3094":53982},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3706":863,"_31461":858,"_21806":53984,"_5":15007,"_28616":53974,"_3094":53985},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3706":864,"_31461":858,"_21806":53987,"_5":15007,"_28616":53974,"_3094":53988},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3706":865,"_31461":858,"_21806":53990,"_5":15007,"_28616":53974,"_3094":53991},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3706":866,"_31461":858,"_21806":53993,"_5":15007,"_28616":53974,"_3094":53994},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3706":867,"_31461":858,"_21806":53996,"_5":15007,"_28616":53974,"_3094":53997},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3706":868,"_31461":858,"_21806":53999,"_5":15007,"_28616":53978,"_3094":54000},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3706":869,"_31461":858,"_21806":54002,"_5":15007,"_28616":53978,"_3094":54003},[],"A DMS relates that CA to an enrollment policy.",{"_3706":870,"_31461":858,"_21806":54005,"_5":15007,"_28616":53978,"_3094":54006},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3706":871,"_31461":858,"_21806":54008,"_5":15007,"_28616":53978,"_3094":54009},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3706":872,"_31461":858,"_21806":54011,"_5":15007,"_28616":53978,"_3094":54012},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3706":873,"_31461":858,"_21806":54014,"_5":15007,"_28616":53978,"_3094":54015},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3706":874,"_31461":858,"_21806":54017,"_5":15007,"_28616":53978,"_3094":54018},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3706":875,"_31461":875,"_5":15367,"_3094":54020,"_31799":54021,"_21806":54023,"_28616":875},"Devices and identities",[51312,52850,54022,54020],"IoT Fleets",[],{"_3706":876,"_31461":875,"_21806":54025,"_5":15007,"_28616":875,"_3094":54026},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3706":877,"_31461":875,"_5":31796,"_21806":54028,"_28616":54029,"_3094":54030},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3706":878,"_31461":875,"_5":31796,"_21806":54032,"_28616":54033,"_3094":54034},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3706":879,"_31461":875,"_5":31796,"_21806":54036,"_28616":54037,"_3094":54038},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3706":880,"_31461":875,"_5":31796,"_21806":54040,"_28616":54041,"_3094":54042},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3706":881,"_31461":875,"_5":31796,"_21806":54044,"_28616":54045,"_3094":54046},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3706":882,"_31461":875,"_5":31796,"_21806":54048,"_28616":54049,"_3094":54050},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3706":883,"_31461":875,"_5":31796,"_21806":54052,"_28616":54053,"_3094":54054},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3706":884,"_31461":875,"_5":31796,"_21806":54056,"_28616":54057,"_3094":54058},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3706":885,"_31461":875,"_5":31796,"_21806":54060,"_28616":54061,"_3094":54062},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3706":886,"_31461":875,"_5":31796,"_21806":54064,"_28616":54065,"_3094":54066},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3706":887,"_31461":875,"_5":31796,"_21806":54068,"_28616":54069,"_3094":54070},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3706":888,"_31461":875,"_21806":54072,"_5":15007,"_28616":875,"_3094":54073},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3706":889,"_31461":875,"_21806":54075,"_5":15007,"_28616":875,"_3094":54076},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3706":890,"_31461":875,"_21806":54078,"_5":15007,"_28616":54029,"_3094":54079},[],"Operational view",{"_3706":891,"_31461":875,"_21806":54081,"_5":15007,"_28616":54029,"_3094":54082},[],"Meaning",{"_3706":892,"_31461":875,"_21806":54084,"_5":15007,"_28616":54029,"_3094":54085},[],"**No Identity**",{"_3706":893,"_31461":875,"_21806":54087,"_5":15007,"_28616":54029,"_3094":54088},[],"A record exists without an associated identity.",{"_3706":894,"_31461":875,"_21806":54090,"_5":15007,"_28616":54029,"_3094":54091},[],"**Active**",{"_3706":895,"_31461":875,"_21806":54093,"_5":15007,"_28616":54029,"_3094":54094},[],"The slot is active; also check certificate dates, status and usages.",{"_3706":896,"_31461":875,"_21806":54096,"_5":15007,"_28616":54029,"_3094":54097},[],"**Renewal Pending**",{"_3706":897,"_31461":875,"_21806":54099,"_5":15007,"_28616":54029,"_3094":54100},[],"The identity is in the operational renewal window.",{"_3706":898,"_31461":875,"_21806":54102,"_5":15007,"_28616":54029,"_3094":54103},[],"**Expiring Soon**",{"_3706":899,"_31461":875,"_21806":54105,"_5":15007,"_28616":54029,"_3094":54106},[],"Expiration is approaching according to configured thresholds.",{"_3706":900,"_31461":875,"_21806":54108,"_5":15007,"_28616":54029,"_3094":54109},[],"**Expired**",{"_3706":901,"_31461":875,"_21806":54111,"_5":15007,"_28616":54029,"_3094":54112},[],"The identity has expired.",{"_3706":902,"_31461":875,"_21806":54114,"_5":15007,"_28616":54029,"_3094":54115},[],"**Revoked**",{"_3706":903,"_31461":875,"_21806":54117,"_5":15007,"_28616":54029,"_3094":54118},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3706":904,"_31461":875,"_21806":54120,"_5":15007,"_28616":54029,"_3094":54121},[],"**Decommissioned**",{"_3706":905,"_31461":875,"_21806":54123,"_5":15007,"_28616":54029,"_3094":54124},[],"The record is retired and ordinary updates do not restore operation.",{"_3706":906,"_31461":875,"_21806":54126,"_5":15007,"_28616":54029,"_3094":54127},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3706":907,"_31461":875,"_21806":54129,"_5":15007,"_28616":54033,"_3094":54130},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3706":908,"_31461":875,"_21806":54132,"_5":15007,"_28616":54033,"_3094":54133},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3706":909,"_31461":875,"_21806":54135,"_5":15007,"_28616":54033,"_3094":54136},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. In **Live** mode it follows new events and device changes (such as status or owner) automatically without reloading the page, and shows a **Connected** or **Disconnected** indicator. After an interruption it reconnects and recovers without gaps or duplicates, so **Live** shows the same content a page reload would. When live updates cannot be used — no permission, device not found, or live updates not enabled on the server — the timeline shows `Live updates unavailable: ...` with the reason, while history browsing (**Load more**) still works. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3706":910,"_31461":875,"_21806":54138,"_5":15007,"_28616":54033,"_3094":54139},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3706":911,"_31461":875,"_21806":54141,"_5":15007,"_28616":54037,"_3094":54142},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3706":912,"_31461":875,"_21806":54144,"_5":15007,"_28616":54041,"_3094":54145},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3706":913,"_31461":875,"_21806":54147,"_5":15007,"_28616":54045,"_3094":54148},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3706":914,"_31461":875,"_21806":54150,"_5":15007,"_28616":54049,"_3094":54151},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3706":915,"_31461":875,"_21806":54153,"_5":15007,"_28616":54053,"_3094":54154},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3706":916,"_31461":875,"_21806":54156,"_5":15007,"_28616":54053,"_3094":54157},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3706":917,"_31461":875,"_21806":54159,"_5":15007,"_28616":54057,"_3094":54160},[],"From **No Identity**, use **Assign Identity**:",{"_3706":918,"_31461":875,"_21806":54162,"_5":15007,"_28616":54057,"_3094":54163},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3706":919,"_31461":875,"_21806":54165,"_5":15007,"_28616":54057,"_3094":54166},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3706":920,"_31461":875,"_21806":54168,"_5":15007,"_28616":54057,"_3094":54169},[],"Confirm and read the serial, active version and history again.",{"_3706":921,"_31461":875,"_21806":54171,"_5":15007,"_28616":54057,"_3094":54172},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3706":922,"_31461":875,"_21806":54174,"_5":15007,"_28616":54057,"_3094":54175},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3706":923,"_31461":875,"_21806":54177,"_5":15007,"_28616":54061,"_3094":54178},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3706":924,"_31461":875,"_21806":54180,"_5":15007,"_28616":54061,"_3094":54181},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3706":925,"_31461":875,"_21806":54183,"_5":15007,"_28616":54061,"_3094":54184},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3706":926,"_31461":875,"_21806":54186,"_5":15007,"_28616":54065,"_3094":54187},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3706":927,"_31461":875,"_21806":54189,"_5":15007,"_28616":54065,"_3094":54190},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3706":928,"_31461":875,"_21806":54192,"_5":15007,"_28616":54065,"_3094":54193},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3706":929,"_31461":875,"_21806":54195,"_5":15007,"_28616":54065,"_3094":54196},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3706":930,"_31461":875,"_21806":54198,"_5":15007,"_28616":54069,"_3094":54199},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3706":931,"_31461":875,"_21806":54201,"_5":15007,"_28616":54069,"_3094":54202},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3706":932,"_31461":932,"_5":15367,"_3094":54204,"_31799":54205,"_21806":54207,"_28616":932},"Bootstrap identity and authentication",[51312,52850,54022,54020,54206],"Enrollment with PKI",[],{"_3706":933,"_31461":932,"_21806":54209,"_5":15007,"_28616":932,"_3094":54210},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3706":934,"_31461":932,"_5":31796,"_21806":54212,"_28616":54213,"_3094":54214},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3706":935,"_31461":932,"_5":31796,"_21806":54216,"_28616":54217,"_3094":54218},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3706":936,"_31461":932,"_5":31796,"_21806":54220,"_28616":54221,"_3094":54222},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3706":937,"_31461":932,"_5":31796,"_21806":54224,"_28616":54225,"_3094":54226},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3706":938,"_31461":932,"_5":31796,"_21806":54228,"_28616":54229,"_3094":54230},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3706":939,"_31461":932,"_21806":54232,"_5":15007,"_28616":932,"_3094":54233},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3706":940,"_31461":932,"_21806":54235,"_5":15007,"_28616":54213,"_3094":54236},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3706":941,"_31461":932,"_21806":54238,"_5":15007,"_28616":54213,"_3094":54239},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3706":942,"_31461":932,"_21806":54241,"_5":15007,"_28616":54217,"_3094":54242},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3706":943,"_31461":932,"_21806":54244,"_5":15007,"_28616":54217,"_3094":54245},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3706":944,"_31461":932,"_21806":54247,"_5":15007,"_28616":54217,"_3094":54248},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3706":945,"_31461":932,"_21806":54250,"_5":15007,"_28616":54221,"_3094":54251},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3706":946,"_31461":932,"_21806":54253,"_5":15007,"_28616":54221,"_3094":54254},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3706":947,"_31461":932,"_21806":54256,"_5":15007,"_28616":54225,"_3094":54257},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3706":948,"_31461":932,"_21806":54259,"_5":15007,"_28616":54225,"_3094":54260},[],"Example body:",{"_3706":949,"_31461":932,"_21806":54262,"_5":15007,"_28616":54225,"_3094":54263},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3706":950,"_31461":932,"_21806":54265,"_5":15007,"_28616":54225,"_3094":54266},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3706":951,"_31461":932,"_21806":54268,"_5":15007,"_28616":54225,"_3094":54269},[],"Continuation requires a successful HTTP response and JSON:",{"_3706":952,"_31461":932,"_21806":54271,"_5":15007,"_28616":54225,"_3094":54272},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3706":953,"_31461":932,"_21806":54274,"_5":15007,"_28616":54229,"_3094":54275},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3706":954,"_31461":932,"_21806":54277,"_5":15007,"_28616":54229,"_3094":54278},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3706":955,"_31461":932,"_21806":54280,"_5":15007,"_28616":54229,"_3094":54281},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3706":956,"_31461":932,"_21806":54283,"_5":15007,"_28616":54229,"_3094":54284},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3706":957,"_31461":957,"_5":15367,"_3094":54286,"_31799":54287,"_21806":54288,"_28616":957},"Configure and operate the DMS",[51312,52850,54022,54020,54206],[],{"_3706":958,"_31461":957,"_21806":54290,"_5":15007,"_28616":957,"_3094":54291},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3706":959,"_31461":957,"_5":31796,"_21806":54293,"_28616":54294,"_3094":51322},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3706":960,"_31461":957,"_5":31796,"_21806":54296,"_28616":54297,"_3094":54298},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3706":961,"_31461":957,"_5":31796,"_21806":54300,"_28616":54301,"_3094":54302},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3706":962,"_31461":957,"_5":31796,"_21806":54304,"_28616":54305,"_3094":54306},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3706":963,"_31461":957,"_5":31796,"_21806":54308,"_28616":54309,"_3094":54310},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3706":964,"_31461":957,"_5":31796,"_21806":54312,"_28616":54313,"_3094":54314},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3706":965,"_31461":957,"_5":31796,"_21806":54316,"_28616":54317,"_3094":54318},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3706":966,"_31461":957,"_5":31796,"_21806":54320,"_28616":54321,"_3094":54322},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3706":967,"_31461":957,"_5":31796,"_21806":54324,"_28616":54325,"_3094":54326},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3706":968,"_31461":957,"_5":31796,"_21806":54328,"_28616":54329,"_3094":54330},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3706":969,"_31461":957,"_5":31796,"_21806":54332,"_28616":54333,"_3094":54334},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3706":970,"_31461":957,"_5":31796,"_21806":54336,"_28616":54337,"_3094":54338},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3706":971,"_31461":957,"_5":31796,"_21806":54340,"_28616":54341,"_3094":54342},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3706":972,"_31461":957,"_5":31796,"_21806":54344,"_28616":54345,"_3094":54346},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3706":973,"_31461":957,"_5":31796,"_21806":54348,"_28616":54349,"_3094":54350},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3706":974,"_31461":957,"_5":31796,"_21806":54352,"_28616":54353,"_3094":54354},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3706":975,"_31461":957,"_5":31796,"_21806":54356,"_28616":54357,"_3094":54358},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3706":976,"_31461":957,"_5":31796,"_21806":54360,"_28616":54361,"_3094":54362},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3706":977,"_31461":957,"_21806":54364,"_5":15007,"_28616":957,"_3094":54365},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3706":978,"_31461":957,"_21806":54367,"_5":15007,"_28616":54294,"_3094":54368},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3706":979,"_31461":957,"_21806":54370,"_5":15007,"_28616":54294,"_3094":54371},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3706":980,"_31461":957,"_21806":54373,"_5":15007,"_28616":54301,"_3094":54374},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3706":981,"_31461":957,"_21806":54376,"_5":15007,"_28616":54305,"_3094":54377},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3706":982,"_31461":957,"_21806":54379,"_5":15007,"_28616":54309,"_3094":54380},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3706":983,"_31461":957,"_21806":54382,"_5":15007,"_28616":54313,"_3094":54383},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3706":984,"_31461":957,"_21806":54385,"_5":15007,"_28616":54317,"_3094":54386},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3706":985,"_31461":957,"_21806":54388,"_5":15007,"_28616":54325,"_3094":54389},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3706":986,"_31461":957,"_21806":54391,"_5":15007,"_28616":54325,"_3094":54392},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3706":987,"_31461":957,"_21806":54394,"_5":15007,"_28616":54329,"_3094":54395},[],"`settings.enrollment_settings` field",{"_3706":988,"_31461":957,"_21806":54397,"_5":15007,"_28616":54329,"_3094":54398},[],"Decision",{"_3706":989,"_31461":957,"_21806":54400,"_5":15007,"_28616":54329,"_3094":54401},[],"`protocol`",{"_3706":990,"_31461":957,"_21806":54403,"_5":15007,"_28616":54329,"_3094":54404},[],"`EST_RFC7030` for these operations.",{"_3706":991,"_31461":957,"_21806":54406,"_5":15007,"_28616":54329,"_3094":54407},[],"`enrollment_ca`",{"_3706":992,"_31461":957,"_21806":54409,"_5":15007,"_28616":54329,"_3094":54410},[],"ID of the signing CA.",{"_3706":993,"_31461":957,"_21806":54412,"_5":15007,"_28616":54329,"_3094":54413},[],"`verify_csr_signature`",{"_3706":994,"_31461":957,"_21806":54415,"_5":15007,"_28616":54329,"_3094":54416},[],"Keep `true` to verify CSR key possession.",{"_3706":995,"_31461":957,"_21806":54418,"_5":15007,"_28616":54329,"_3094":54419},[],"`enable_replaceable_enrollment`",{"_3706":996,"_31461":957,"_21806":54421,"_5":15007,"_28616":54329,"_3094":54422},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3706":997,"_31461":957,"_21806":54424,"_5":15007,"_28616":54329,"_3094":54425},[],"`est_rfc7030_settings.auth_mode`",{"_3706":998,"_31461":957,"_21806":54427,"_5":15007,"_28616":54329,"_3094":54428},[],"One of the four authentication modes.",{"_3706":999,"_31461":957,"_21806":54430,"_5":15007,"_28616":54329,"_3094":54431},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3706":1000,"_31461":957,"_21806":54433,"_5":15007,"_28616":54333,"_3094":54434},[],"The blocks are independent:",{"_3706":1001,"_31461":957,"_21806":54436,"_5":15007,"_28616":54333,"_3094":54437},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3706":1002,"_31461":957,"_21806":54439,"_5":15007,"_28616":54333,"_3094":54440},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3706":1003,"_31461":957,"_21806":54442,"_5":15007,"_28616":54333,"_3094":54443},[],"`auth_mode`",{"_3706":1004,"_31461":957,"_21806":54445,"_5":15007,"_28616":54333,"_3094":54446},[],"Control applied in the configured operation",{"_3706":1005,"_31461":957,"_21806":54448,"_5":15007,"_28616":54333,"_3094":54449},[],"`CLIENT_CERTIFICATE`",{"_3706":1006,"_31461":957,"_21806":54451,"_5":15007,"_28616":54333,"_3094":54452},[],"Presented certificate validation.",{"_3706":1007,"_31461":957,"_21806":54454,"_5":15007,"_28616":54333,"_3094":54455},[],"`EXTERNAL_WEBHOOK`",{"_3706":1008,"_31461":957,"_21806":54457,"_5":15007,"_28616":54333,"_3094":54458},[],"Configured webhook authorization.",{"_3706":1009,"_31461":957,"_21806":54460,"_5":15007,"_28616":54333,"_3094":54461},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3706":1010,"_31461":957,"_21806":54463,"_5":15007,"_28616":54333,"_3094":54464},[],"Certificate validation followed by webhook approval.",{"_3706":1011,"_31461":957,"_21806":54466,"_5":15007,"_28616":54333,"_3094":54467},[],"`NO_AUTH`",{"_3706":1012,"_31461":957,"_21806":54469,"_5":15007,"_28616":54333,"_3094":54470},[],"No DMS requester authentication.",{"_3706":1013,"_31461":957,"_21806":54472,"_5":15007,"_28616":54333,"_3094":54473},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3706":1014,"_31461":957,"_21806":54475,"_5":15007,"_28616":54333,"_3094":54476},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3706":1015,"_31461":957,"_21806":54478,"_5":15007,"_28616":54333,"_3094":54479},[],"The authentication editor offers an **Allow certificates without revocation information** switch (`allow_unverifiable_revocation`, off by default). When it is on, certificates — and intermediate CAs of the chain — that Lamassu does not manage and that list no OCSP or CRL endpoint are accepted; unreachable, stale or inconclusive revocation answers are always rejected. While the switch is on, the console shows an amber warning: **Revocation will not be verified** — a revoked certificate with no OCSP or CRL endpoint, and not managed by Lamassu, will be accepted, and this also applies to the intermediate CAs of the chain.",{"_3706":1016,"_31461":957,"_21806":54481,"_5":15007,"_28616":54333,"_3094":54482},[],"The same switch is offered in both the enrollment and re-enrollment authentication editors and is stored per block inside `est_rfc7030_settings.client_certificate_settings`; a DMS stored before this field existed loads with the switch off. The console also shows an amber warning alert whenever an authentication option is in its insecure state — **Allow expired certificates** on, **Allow expired renewal** on or **Verify CSR signature** off — and the No authentication note is presented as a warning alert too.",{"_3706":1017,"_31461":957,"_21806":54484,"_5":15007,"_28616":54333,"_3094":54485},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3706":1018,"_31461":957,"_21806":54487,"_5":15007,"_28616":54333,"_3094":54488},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3706":1019,"_31461":957,"_21806":54490,"_5":15007,"_28616":54333,"_3094":54491},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3706":1020,"_31461":957,"_21806":54493,"_5":15007,"_28616":54337,"_3094":54494},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3706":1021,"_31461":957,"_21806":54496,"_5":15007,"_28616":54337,"_3094":54497},[],"`external_webhook_settings` field",{"_3706":1022,"_31461":957,"_21806":54499,"_5":15007,"_28616":54337,"_3094":54398},[],{"_3706":1023,"_31461":957,"_21806":54501,"_5":15007,"_28616":54337,"_3094":54502},[],"`url`",{"_3706":1024,"_31461":957,"_21806":54504,"_5":15007,"_28616":54337,"_3094":54505},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3706":1025,"_31461":957,"_21806":54507,"_5":15007,"_28616":54337,"_3094":54508},[],"`method`",{"_3706":1026,"_31461":957,"_21806":54510,"_5":15007,"_28616":54337,"_3094":54511},[],"`POST` or `PUT`; `POST` by default.",{"_3706":1027,"_31461":957,"_21806":54513,"_5":15007,"_28616":54337,"_3094":54514},[],"`name`",{"_3706":1028,"_31461":957,"_21806":54516,"_5":15007,"_28616":54337,"_3094":54517},[],"Label used in service logs.",{"_3706":1029,"_31461":957,"_21806":54519,"_5":15007,"_28616":54337,"_3094":54520},[],"`config.auth_mode`",{"_3706":1030,"_31461":957,"_21806":54522,"_5":15007,"_28616":54337,"_3094":54523},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3706":1031,"_31461":957,"_21806":54525,"_5":15007,"_28616":54337,"_3094":54526},[],"`config.log_level`",{"_3706":1032,"_31461":957,"_21806":54528,"_5":15007,"_28616":54337,"_3094":54529},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3706":1033,"_31461":957,"_21806":54531,"_5":15007,"_28616":54337,"_3094":54532},[],"`config.apikey_options`",{"_3706":1034,"_31461":957,"_21806":54534,"_5":15007,"_28616":54337,"_3094":54535},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3706":1035,"_31461":957,"_21806":54537,"_5":15007,"_28616":54337,"_3094":54538},[],"`config.jwt_options`",{"_3706":1036,"_31461":957,"_21806":54540,"_5":15007,"_28616":54337,"_3094":54541},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3706":1037,"_31461":957,"_21806":54543,"_5":15007,"_28616":54337,"_3094":54544},[],"`config.mtls_options`",{"_3706":1038,"_31461":957,"_21806":54546,"_5":15007,"_28616":54337,"_3094":54547},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3706":1039,"_31461":957,"_21806":54549,"_5":15007,"_28616":54337,"_3094":54550},[],"`config.insecure_skip_verify`",{"_3706":1040,"_31461":957,"_21806":54552,"_5":15007,"_28616":54337,"_3094":54553},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3706":1041,"_31461":957,"_21806":54555,"_5":15007,"_28616":54337,"_3094":54556},[],"`config.call_timeout`",{"_3706":1042,"_31461":957,"_21806":54558,"_5":15007,"_28616":54337,"_3094":54559},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3706":1043,"_31461":957,"_21806":54561,"_5":15007,"_28616":54337,"_3094":54562},[],"Rules for that configuration:",{"_3706":1044,"_31461":957,"_21806":54564,"_5":15007,"_28616":54337,"_3094":54565},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3706":1045,"_31461":957,"_21806":54567,"_5":15007,"_28616":54337,"_3094":54568},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3706":1046,"_31461":957,"_21806":54570,"_5":15007,"_28616":54337,"_3094":54571},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3706":1047,"_31461":957,"_21806":54573,"_5":15007,"_28616":54337,"_3094":54574},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3706":1048,"_31461":957,"_21806":54576,"_5":15007,"_28616":54337,"_3094":54577},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3706":1049,"_31461":957,"_21806":54579,"_5":15007,"_28616":54337,"_3094":54580},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3706":1050,"_31461":957,"_21806":54582,"_5":15007,"_28616":54337,"_3094":54583},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3706":1051,"_31461":957,"_21806":54585,"_5":15007,"_28616":54337,"_3094":54586},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3706":1052,"_31461":957,"_21806":54588,"_5":15007,"_28616":54337,"_3094":54589},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3706":1053,"_31461":957,"_21806":54591,"_5":15007,"_28616":54341,"_3094":54592},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3706":1054,"_31461":957,"_21806":54594,"_5":15007,"_28616":54345,"_3094":54595},[],"`settings.reenrollment_settings` field",{"_3706":1055,"_31461":957,"_21806":54597,"_5":15007,"_28616":54345,"_3094":51702},[],{"_3706":1056,"_31461":957,"_21806":54599,"_5":15007,"_28616":54345,"_3094":54600},[],"`reenrollment_delta`",{"_3706":1057,"_31461":957,"_21806":54602,"_5":15007,"_28616":54345,"_3094":54603},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3706":1058,"_31461":957,"_21806":54605,"_5":15007,"_28616":54345,"_3094":54606},[],"`preventive_delta`",{"_3706":1059,"_31461":957,"_21806":54608,"_5":15007,"_28616":54345,"_3094":54609},[],"Preventive operational monitoring threshold.",{"_3706":1060,"_31461":957,"_21806":54611,"_5":15007,"_28616":54345,"_3094":54612},[],"`critical_delta`",{"_3706":1061,"_31461":957,"_21806":54614,"_5":15007,"_28616":54345,"_3094":54615},[],"Critical operational monitoring threshold.",{"_3706":1062,"_31461":957,"_21806":54617,"_5":15007,"_28616":54345,"_3094":54618},[],"`enable_expired_renewal`",{"_3706":1063,"_31461":957,"_21806":54620,"_5":15007,"_28616":54345,"_3094":54621},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3706":1064,"_31461":957,"_21806":54623,"_5":15007,"_28616":54345,"_3094":54624},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3706":1065,"_31461":957,"_21806":54626,"_5":15007,"_28616":54345,"_3094":54627},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3706":1066,"_31461":957,"_21806":54629,"_5":15007,"_28616":54345,"_3094":54630},[],"`revoke_on_reenrollment`",{"_3706":1067,"_31461":957,"_21806":54632,"_5":15007,"_28616":54345,"_3094":54633},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3706":1068,"_31461":957,"_21806":54635,"_5":15007,"_28616":54345,"_3094":54636},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3706":1069,"_31461":957,"_21806":54638,"_5":15007,"_28616":54349,"_3094":54639},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3706":1070,"_31461":957,"_21806":54641,"_5":15007,"_28616":54353,"_3094":51696},[],{"_3706":1071,"_31461":957,"_21806":54643,"_5":15007,"_28616":54353,"_3094":54644},[],"Published material",{"_3706":1072,"_31461":957,"_21806":54646,"_5":15007,"_28616":54353,"_3094":54647},[],"**Include Lamassu System CA**",{"_3706":1073,"_31461":957,"_21806":54649,"_5":15007,"_28616":54353,"_3094":54650},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3706":1074,"_31461":957,"_21806":54652,"_5":15007,"_28616":54353,"_3094":54653},[],"**Include Enrollment CA**",{"_3706":1075,"_31461":957,"_21806":54655,"_5":15007,"_28616":54353,"_3094":54656},[],"Selected issuing CA certificate.",{"_3706":1076,"_31461":957,"_21806":54658,"_5":15007,"_28616":54353,"_3094":54659},[],"**Managed CAs**",{"_3706":1077,"_31461":957,"_21806":54661,"_5":15007,"_28616":54353,"_3094":54662},[],"Explicitly selected CA certificates.",{"_3706":1078,"_31461":957,"_21806":54664,"_5":15007,"_28616":54353,"_3094":54665},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3706":1079,"_31461":957,"_21806":54667,"_5":15007,"_28616":54357,"_3094":54668},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3706":1080,"_31461":957,"_21806":54670,"_5":15007,"_28616":54357,"_3094":54671},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3706":1081,"_31461":957,"_21806":54673,"_5":15007,"_28616":54357,"_3094":54674},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3706":1082,"_31461":957,"_21806":54676,"_5":15007,"_28616":54361,"_3094":54677},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3706":1083,"_31461":1083,"_5":15367,"_3094":54679,"_31799":54680,"_21806":54681,"_28616":1083},"Integrate the EST client",[51312,52850,54022,54020,54206],[],{"_3706":1084,"_31461":1083,"_21806":54683,"_5":15007,"_28616":1083,"_3094":54684},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3706":1085,"_31461":1083,"_5":31796,"_21806":54686,"_28616":54687,"_3094":51322},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3706":1086,"_31461":1083,"_5":31796,"_21806":54689,"_28616":54690,"_3094":54691},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3706":1087,"_31461":1083,"_5":31796,"_21806":54693,"_28616":54694,"_3094":54695},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3706":1088,"_31461":1083,"_5":31796,"_21806":54697,"_28616":54698,"_3094":54699},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3706":1089,"_31461":1083,"_5":31796,"_21806":54701,"_28616":54702,"_3094":54703},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3706":1090,"_31461":1083,"_5":31796,"_21806":54705,"_28616":54706,"_3094":54707},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3706":1091,"_31461":1083,"_21806":54709,"_5":15007,"_28616":1083,"_3094":54710},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3706":1092,"_31461":1083,"_21806":54712,"_5":15007,"_28616":54687,"_3094":54713},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3706":1093,"_31461":1083,"_21806":54715,"_5":15007,"_28616":54687,"_3094":54716},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3706":1094,"_31461":1083,"_21806":54718,"_5":15007,"_28616":54687,"_3094":54719},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3706":1095,"_31461":1083,"_21806":54721,"_5":15007,"_28616":54690,"_3094":54722},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3706":1096,"_31461":1083,"_21806":54724,"_5":15007,"_28616":54690,"_3094":54725},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3706":1097,"_31461":1083,"_21806":54727,"_5":15007,"_28616":54694,"_3094":54728},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3706":1098,"_31461":1083,"_21806":54730,"_5":15007,"_28616":54694,"_3094":54731},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3706":1099,"_31461":1083,"_21806":54733,"_5":15007,"_28616":54698,"_3094":54734},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3706":1100,"_31461":1083,"_21806":54736,"_5":15007,"_28616":54698,"_3094":54737},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3706":1101,"_31461":1083,"_21806":54739,"_5":15007,"_28616":54702,"_3094":54740},[],"For a root that issues directly:",{"_3706":1102,"_31461":1083,"_21806":54742,"_5":15007,"_28616":54702,"_3094":54743},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3706":1103,"_31461":1083,"_21806":54745,"_5":15007,"_28616":54702,"_3094":54746},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3706":1104,"_31461":1083,"_21806":54748,"_5":15007,"_28616":54706,"_3094":54749},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3706":1105,"_31461":1105,"_5":15367,"_3094":54751,"_31799":54752,"_21806":54753,"_28616":1105},"EST reference",[51312,52850,54022,54020,54206],[],{"_3706":1106,"_31461":1105,"_21806":54755,"_5":15007,"_28616":1105,"_3094":54756},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3706":1107,"_31461":1105,"_5":31796,"_21806":54758,"_28616":54759,"_3094":54760},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3706":1108,"_31461":1105,"_5":31796,"_21806":54762,"_28616":54763,"_3094":23609},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3706":1109,"_31461":1105,"_5":31796,"_21806":54765,"_28616":54766,"_3094":27123},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3706":1110,"_31461":1105,"_5":31796,"_21806":54768,"_28616":54769,"_3094":27130},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3706":1111,"_31461":1105,"_5":31796,"_21806":54771,"_28616":54772,"_3094":26387},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3706":1112,"_31461":1105,"_5":31796,"_21806":54774,"_28616":54775,"_3094":54776},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3706":1113,"_31461":1105,"_5":31796,"_21806":54778,"_28616":54779,"_3094":54780},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3706":1114,"_31461":1105,"_5":31796,"_21806":54782,"_28616":54783,"_3094":54784},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3706":1115,"_31461":1105,"_21806":54786,"_5":15007,"_28616":1105,"_3094":54787},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3706":1116,"_31461":1105,"_21806":54789,"_5":15007,"_28616":54759,"_3094":54790},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3706":1117,"_31461":1105,"_21806":54792,"_5":15007,"_28616":54759,"_3094":54793},[],"Operation",{"_3706":1118,"_31461":1105,"_21806":54795,"_5":15007,"_28616":54759,"_3094":54796},[],"Method",{"_3706":1119,"_31461":1105,"_21806":54798,"_5":15007,"_28616":54759,"_3094":54799},[],"Authentication and condition",{"_3706":1120,"_31461":1105,"_21806":54801,"_5":15007,"_28616":54759,"_3094":54802},[],"`/cacerts`",{"_3706":1121,"_31461":1105,"_21806":54804,"_5":15007,"_28616":54759,"_3094":54805},[],"GET",{"_3706":1122,"_31461":1105,"_21806":54807,"_5":15007,"_28616":54759,"_3094":54808},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3706":1123,"_31461":1105,"_21806":54810,"_5":15007,"_28616":54759,"_3094":54811},[],"`/simpleenroll`",{"_3706":1124,"_31461":1105,"_21806":54813,"_5":15007,"_28616":54759,"_3094":54814},[],"POST",{"_3706":1125,"_31461":1105,"_21806":54816,"_5":15007,"_28616":54759,"_3094":54817},[],"Initial authentication and DMS registration/replacement policy.",{"_3706":1126,"_31461":1105,"_21806":54819,"_5":15007,"_28616":54759,"_3094":54820},[],"`/simplereenroll`",{"_3706":1127,"_31461":1105,"_21806":54822,"_5":15007,"_28616":54759,"_3094":54814},[],{"_3706":1128,"_31461":1105,"_21806":54824,"_5":15007,"_28616":54759,"_3094":54825},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3706":1129,"_31461":1105,"_21806":54827,"_5":15007,"_28616":54759,"_3094":54828},[],"`/serverkeygen`",{"_3706":1130,"_31461":1105,"_21806":54830,"_5":15007,"_28616":54759,"_3094":54814},[],{"_3706":1131,"_31461":1105,"_21806":54832,"_5":15007,"_28616":54759,"_3094":54833},[],"Initial authentication and admission; server generation enabled.",{"_3706":1132,"_31461":1105,"_21806":54835,"_5":15007,"_28616":54759,"_3094":54836},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3706":1133,"_31461":1105,"_21806":54838,"_5":15007,"_28616":54763,"_3094":54839},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3706":1134,"_31461":1105,"_21806":54841,"_5":15007,"_28616":54763,"_3094":54842},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3706":1135,"_31461":1105,"_21806":54844,"_5":15007,"_28616":54766,"_3094":54845},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3706":1136,"_31461":1105,"_21806":54847,"_5":15007,"_28616":54766,"_3094":54848},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3706":1137,"_31461":1105,"_21806":54850,"_5":15007,"_28616":54769,"_3094":54851},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3706":1138,"_31461":1105,"_21806":54853,"_5":15007,"_28616":54769,"_3094":54854},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3706":1139,"_31461":1105,"_21806":54856,"_5":15007,"_28616":54772,"_3094":54857},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3706":1140,"_31461":1105,"_21806":54859,"_5":15007,"_28616":54772,"_3094":54860},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3706":1141,"_31461":1105,"_21806":54862,"_5":15007,"_28616":54775,"_3094":54863},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3706":1142,"_31461":1105,"_21806":54865,"_5":15007,"_28616":54775,"_3094":54866},[],"Part",{"_3706":1143,"_31461":1105,"_21806":54868,"_5":15007,"_28616":54775,"_3094":54869},[],"Content after decoding its Base64",{"_3706":1144,"_31461":1105,"_21806":54871,"_5":15007,"_28616":54775,"_3094":54872},[],"`application/pkcs8`",{"_3706":1145,"_31461":1105,"_21806":54874,"_5":15007,"_28616":54775,"_3094":54875},[],"Unencrypted DER PKCS#8 private key.",{"_3706":1146,"_31461":1105,"_21806":54877,"_5":15007,"_28616":54775,"_3094":54878},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3706":1147,"_31461":1105,"_21806":54880,"_5":15007,"_28616":54775,"_3094":54881},[],"DER PKCS#7 containing the issued certificate.",{"_3706":1148,"_31461":1105,"_21806":54883,"_5":15007,"_28616":54775,"_3094":54884},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3706":1149,"_31461":1105,"_21806":54886,"_5":15007,"_28616":54779,"_3094":54887},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3706":1150,"_31461":1105,"_21806":54889,"_5":15007,"_28616":54779,"_3094":54890},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3706":1151,"_31461":1105,"_21806":54892,"_5":15007,"_28616":54779,"_3094":54893},[],"Convert and check the result:",{"_3706":1152,"_31461":1105,"_21806":54895,"_5":15007,"_28616":54779,"_3094":54896},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3706":1153,"_31461":1105,"_21806":54898,"_5":15007,"_28616":54783,"_3094":54899},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3706":1154,"_31461":1105,"_21806":54901,"_5":15007,"_28616":54783,"_3094":54902},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3706":1155,"_31461":1155,"_5":15367,"_3094":54206,"_31799":54904,"_21806":54905,"_28616":1155},[51312,52850,54022,54020,54206],[],{"_3706":1156,"_31461":1155,"_21806":54907,"_5":15007,"_28616":1155,"_3094":54908},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3706":1157,"_31461":1155,"_5":31796,"_21806":54910,"_28616":54911,"_3094":54912},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3706":1158,"_31461":1155,"_5":31796,"_21806":54914,"_28616":54915,"_3094":54916},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3706":1159,"_31461":1155,"_5":31796,"_21806":54918,"_28616":54919,"_3094":54920},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3706":1160,"_31461":1155,"_21806":54922,"_5":15007,"_28616":1155,"_3094":54923},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3706":1161,"_31461":1155,"_21806":54925,"_5":15007,"_28616":54911,"_3094":54926},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3706":1162,"_31461":1155,"_21806":54928,"_5":15007,"_28616":54911,"_3094":54929},[],"The integrator installs initial EST server trust and an admission credential.",{"_3706":1163,"_31461":1155,"_21806":54931,"_5":15007,"_28616":54911,"_3094":54932},[],"The client requests an identity for its `Device ID` through EST.",{"_3706":1164,"_31461":1155,"_21806":54934,"_5":15007,"_28616":54911,"_3094":54935},[],"Certificate, device binding and key/certificate installation are checked.",{"_3706":1165,"_31461":1155,"_21806":54937,"_5":15007,"_28616":54911,"_3094":54938},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3706":1166,"_31461":1155,"_21806":54940,"_5":15007,"_28616":54911,"_3094":54941},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3706":1167,"_31461":1155,"_21806":54943,"_5":15007,"_28616":54915,"_3094":54944},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3706":1168,"_31461":1155,"_21806":54946,"_5":15007,"_28616":54915,"_3094":54947},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3706":1169,"_31461":1155,"_21806":54949,"_5":15007,"_28616":54915,"_3094":54950},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3706":1170,"_31461":1155,"_21806":54952,"_5":15007,"_28616":54915,"_3094":54953},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3706":1171,"_31461":1155,"_21806":54955,"_5":15007,"_28616":54919,"_3094":54956},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3706":1172,"_31461":1155,"_21806":54958,"_5":15007,"_28616":54919,"_3094":54959},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3706":1173,"_31461":1155,"_21806":54961,"_5":15007,"_28616":54919,"_3094":54962},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3706":1174,"_31461":1155,"_21806":54964,"_5":15007,"_28616":54919,"_3094":54965},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3706":1175,"_31461":1155,"_21806":54967,"_5":15007,"_28616":54919,"_3094":54968},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3706":1176,"_31461":1176,"_5":15367,"_3094":54970,"_31799":54971,"_21806":54972,"_28616":1176},"Provisioning strategies",[51312,52850,54022,54020,54206],[],{"_3706":1177,"_31461":1176,"_21806":54974,"_5":15007,"_28616":1176,"_3094":54975},[],"Choose device registration, identity authorization and key generation.",{"_3706":1178,"_31461":1176,"_5":31796,"_21806":54977,"_28616":54978,"_3094":54979},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3706":1179,"_31461":1176,"_5":31796,"_21806":54981,"_28616":54982,"_3094":54983},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3706":1180,"_31461":1176,"_5":31796,"_21806":54985,"_28616":54986,"_3094":54987},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3706":1181,"_31461":1176,"_5":31796,"_21806":54989,"_28616":54990,"_3094":54991},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3706":1182,"_31461":1176,"_5":31796,"_21806":54993,"_28616":54994,"_3094":54995},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3706":1183,"_31461":1176,"_21806":54997,"_5":15007,"_28616":1176,"_3094":54998},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3706":1184,"_31461":1176,"_21806":55000,"_5":15007,"_28616":54978,"_3094":55001},[],"Path",{"_3706":1185,"_31461":1176,"_21806":55003,"_5":15007,"_28616":54978,"_3094":55004},[],"When the device exists",{"_3706":1186,"_31461":1176,"_21806":55006,"_5":15007,"_28616":54978,"_3094":55007},[],"What to check",{"_3706":1187,"_31461":1176,"_21806":55009,"_5":15007,"_28616":54978,"_3094":55010},[],"Manual assignment",{"_3706":1188,"_31461":1176,"_21806":55012,"_5":15007,"_28616":54978,"_3094":55013},[],"An operator creates it before associating a certificate.",{"_3706":1189,"_31461":1176,"_21806":55015,"_5":15007,"_28616":54978,"_3094":55016},[],"ID, owning DMS, certificate CN and bound serial.",{"_3706":1190,"_31461":1176,"_21806":55018,"_5":15007,"_28616":54978,"_3094":55019},[],"EST with `JITP`",{"_3706":1191,"_31461":1176,"_21806":55021,"_5":15007,"_28616":54978,"_3094":55022},[],"Created for an unknown CN during `/simpleenroll`.",{"_3706":1192,"_31461":1176,"_21806":55024,"_5":15007,"_28616":54978,"_3094":55025},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3706":1193,"_31461":1176,"_21806":55027,"_5":15007,"_28616":54978,"_3094":55028},[],"EST with `PRE_REGISTRATION`",{"_3706":1194,"_31461":1176,"_21806":55030,"_5":15007,"_28616":54978,"_3094":55031},[],"Must exist before `/simpleenroll`.",{"_3706":1195,"_31461":1176,"_21806":55033,"_5":15007,"_28616":54978,"_3094":55034},[],"Approved record, same DMS and replacement conditions for your version.",{"_3706":1196,"_31461":1176,"_21806":55036,"_5":15007,"_28616":54978,"_3094":55037},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3706":1197,"_31461":1176,"_21806":55039,"_5":15007,"_28616":54978,"_3094":55040},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3706":1198,"_31461":1176,"_21806":55042,"_5":15007,"_28616":54982,"_3094":55043},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3706":1199,"_31461":1176,"_21806":55045,"_5":15007,"_28616":54982,"_3094":55046},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3706":1200,"_31461":1176,"_21806":55048,"_5":15007,"_28616":54982,"_3094":55049},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3706":1201,"_31461":1176,"_21806":55051,"_5":15007,"_28616":54986,"_3094":55052},[],"Decide initial enrollment and re-enrollment separately:",{"_3706":1202,"_31461":1176,"_21806":55054,"_5":15007,"_28616":54986,"_3094":55055},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3706":1203,"_31461":1176,"_21806":55057,"_5":15007,"_28616":54986,"_3094":55058},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3706":1204,"_31461":1176,"_21806":55060,"_5":15007,"_28616":54986,"_3094":55061},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3706":1205,"_31461":1176,"_21806":55063,"_5":15007,"_28616":54986,"_3094":55064},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3706":1206,"_31461":1176,"_21806":55066,"_5":15007,"_28616":54986,"_3094":55067},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3706":1207,"_31461":1176,"_21806":55069,"_5":15007,"_28616":54990,"_3094":51696},[],{"_3706":1208,"_31461":1176,"_21806":55071,"_5":15007,"_28616":54990,"_3094":55072},[],"Material crossing EST",{"_3706":1209,"_31461":1176,"_21806":55074,"_5":15007,"_28616":54990,"_3094":55075},[],"Device-generated key",{"_3706":1210,"_31461":1176,"_21806":55077,"_5":15007,"_28616":54990,"_3094":55078},[],"Public CSR and certificate; the key stays on the client.",{"_3706":1211,"_31461":1176,"_21806":55080,"_5":15007,"_28616":54990,"_3094":55081},[],"Existing device key",{"_3706":1212,"_31461":1176,"_21806":55083,"_5":15007,"_28616":54990,"_3094":55084},[],"CSR signed with that key and a new certificate.",{"_3706":1213,"_31461":1176,"_21806":55086,"_5":15007,"_28616":54990,"_3094":54350},[],{"_3706":1214,"_31461":1176,"_21806":55088,"_5":15007,"_28616":54990,"_3094":55089},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3706":1215,"_31461":1176,"_21806":55091,"_5":15007,"_28616":54990,"_3094":55092},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3706":1216,"_31461":1176,"_21806":55094,"_5":15007,"_28616":54994,"_3094":55095},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3706":1217,"_31461":1217,"_5":15367,"_3094":55097,"_31799":55098,"_21806":55099,"_28616":1217},"Renewal and recovery",[51312,52850,54022,54020,54206],[],{"_3706":1218,"_31461":1217,"_21806":55101,"_5":15007,"_28616":1217,"_3094":55102},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3706":1219,"_31461":1217,"_5":31796,"_21806":55104,"_28616":55105,"_3094":55106},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3706":1220,"_31461":1217,"_5":31796,"_21806":55108,"_28616":55109,"_3094":55110},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3706":1221,"_31461":1217,"_5":31796,"_21806":55112,"_28616":55113,"_3094":55114},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3706":1222,"_31461":1217,"_5":31796,"_21806":55116,"_28616":55117,"_3094":55118},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3706":1223,"_31461":1217,"_5":31796,"_21806":55120,"_28616":55121,"_3094":55122},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3706":1224,"_31461":1217,"_21806":55124,"_5":15007,"_28616":1217,"_3094":55125},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3706":1225,"_31461":1217,"_21806":55127,"_5":15007,"_28616":55105,"_3094":55128},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3706":1226,"_31461":1217,"_21806":55130,"_5":15007,"_28616":55105,"_3094":55131},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3706":1227,"_31461":1217,"_21806":55133,"_5":15007,"_28616":55105,"_3094":55134},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3706":1228,"_31461":1217,"_21806":55136,"_5":15007,"_28616":55105,"_3094":55137},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3706":1229,"_31461":1217,"_21806":55139,"_5":15007,"_28616":55109,"_3094":55140},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3706":1230,"_31461":1217,"_21806":55142,"_5":15007,"_28616":55109,"_3094":55143},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3706":1231,"_31461":1217,"_21806":55145,"_5":15007,"_28616":55113,"_3094":55146},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3706":1232,"_31461":1217,"_21806":55148,"_5":15007,"_28616":55113,"_3094":55149},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3706":1233,"_31461":1217,"_21806":55151,"_5":15007,"_28616":55113,"_3094":55152},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3706":1234,"_31461":1217,"_21806":55154,"_5":15007,"_28616":55117,"_3094":55155},[],"Situation",{"_3706":1235,"_31461":1217,"_21806":55157,"_5":15007,"_28616":55117,"_3094":55158},[],"Procedure",{"_3706":1236,"_31461":1217,"_21806":55160,"_5":15007,"_28616":55117,"_3094":55161},[],"Valid certificate, outside the window",{"_3706":1237,"_31461":1217,"_21806":55163,"_5":15007,"_28616":55117,"_3094":55164},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3706":1238,"_31461":1217,"_21806":55166,"_5":15007,"_28616":55117,"_3094":55167},[],"Expired certificate, key available",{"_3706":1239,"_31461":1217,"_21806":55169,"_5":15007,"_28616":55117,"_3094":55170},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3706":1240,"_31461":1217,"_21806":55172,"_5":15007,"_28616":55117,"_3094":55173},[],"Renewal through webhook or `NO_AUTH`",{"_3706":1241,"_31461":1217,"_21806":55175,"_5":15007,"_28616":55117,"_3094":55176},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3706":1242,"_31461":1217,"_21806":55178,"_5":15007,"_28616":55117,"_3094":55179},[],"Lost or inaccessible key",{"_3706":1243,"_31461":1217,"_21806":55181,"_5":15007,"_28616":55117,"_3094":55182},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3706":1244,"_31461":1217,"_21806":55184,"_5":15007,"_28616":55117,"_3094":55185},[],"Current identity revoked",{"_3706":1245,"_31461":1217,"_21806":55187,"_5":15007,"_28616":55117,"_3094":55188},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3706":1246,"_31461":1217,"_21806":55190,"_5":15007,"_28616":55117,"_3094":55191},[],"Device without an identity",{"_3706":1247,"_31461":1217,"_21806":55193,"_5":15007,"_28616":55117,"_3094":55194},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3706":1248,"_31461":1217,"_21806":55196,"_5":15007,"_28616":55117,"_3094":55197},[],"Retired device",{"_3706":1249,"_31461":1217,"_21806":55199,"_5":15007,"_28616":55117,"_3094":55200},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3706":1250,"_31461":1217,"_21806":55202,"_5":15007,"_28616":55117,"_3094":55203},[],"Timeout, HTTP 500 or installation failure",{"_3706":1251,"_31461":1217,"_21806":55205,"_5":15007,"_28616":55117,"_3094":55206},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3706":1252,"_31461":1217,"_21806":55208,"_5":15007,"_28616":55121,"_3094":55209},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3706":1253,"_31461":1217,"_21806":55211,"_5":15007,"_28616":55121,"_3094":55212},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3706":1254,"_31461":1254,"_5":15367,"_3094":55214,"_31799":55215,"_21806":55216,"_28616":1254},"Enrollment troubleshooting",[51312,52850,54022,54020,54206],[],{"_3706":1255,"_31461":1254,"_21806":55218,"_5":15007,"_28616":1254,"_3094":55219},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3706":1256,"_31461":1254,"_5":31796,"_21806":55221,"_28616":55222,"_3094":55223},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3706":1257,"_31461":1254,"_5":31796,"_21806":55225,"_28616":55226,"_3094":55227},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3706":1258,"_31461":1254,"_5":31796,"_21806":55229,"_28616":55230,"_3094":54784},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3706":1259,"_31461":1254,"_5":31796,"_21806":55232,"_28616":55233,"_3094":55234},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3706":1260,"_31461":1254,"_21806":55236,"_5":15007,"_28616":1254,"_3094":55237},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3706":1261,"_31461":1254,"_21806":55239,"_5":15007,"_28616":55226,"_3094":55240},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3706":1262,"_31461":1254,"_21806":55242,"_5":15007,"_28616":55226,"_3094":55243},[],"Symptom or message",{"_3706":1263,"_31461":1254,"_21806":55245,"_5":15007,"_28616":55226,"_3094":55007},[],{"_3706":1264,"_31461":1254,"_21806":55247,"_5":15007,"_28616":55226,"_3094":55248},[],"curl rejects TLS, name or issuer",{"_3706":1265,"_31461":1254,"_21806":55250,"_5":15007,"_28616":55226,"_3094":55251},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3706":1266,"_31461":1254,"_21806":55253,"_5":15007,"_28616":55226,"_3094":55254},[],"404 or missing APS",{"_3706":1267,"_31461":1254,"_21806":55256,"_5":15007,"_28616":55226,"_3094":55257},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3706":1268,"_31461":1254,"_21806":55259,"_5":15007,"_28616":55226,"_3094":55260},[],"400, CSR or format error",{"_3706":1269,"_31461":1254,"_21806":55262,"_5":15007,"_28616":55226,"_3094":55263},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3706":1270,"_31461":1254,"_21806":55265,"_5":15007,"_28616":55226,"_3094":55266},[],"Missing credential or invalid certificate",{"_3706":1271,"_31461":1254,"_21806":55268,"_5":15007,"_28616":55226,"_3094":55269},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3706":1272,"_31461":1254,"_21806":55271,"_5":15007,"_28616":55226,"_3094":55272},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3706":1273,"_31461":1254,"_21806":55274,"_5":15007,"_28616":55226,"_3094":55275},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3706":1274,"_31461":1254,"_21806":55277,"_5":15007,"_28616":55226,"_3094":55278},[],"Webhook denies, times out or responds without authorization",{"_3706":1275,"_31461":1254,"_21806":55280,"_5":15007,"_28616":55226,"_3094":55281},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3706":1276,"_31461":1254,"_21806":55283,"_5":15007,"_28616":55226,"_3094":55284},[],"`unexpected status code: <n>: redirects are not followed`",{"_3706":1277,"_31461":1254,"_21806":55286,"_5":15007,"_28616":55226,"_3094":55287},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3706":1278,"_31461":1254,"_21806":55289,"_5":15007,"_28616":55226,"_3094":55290},[],"`webhook response exceeds 1048576 bytes`",{"_3706":1279,"_31461":1254,"_21806":55292,"_5":15007,"_28616":55226,"_3094":55293},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3706":1280,"_31461":1254,"_21806":55295,"_5":15007,"_28616":55226,"_3094":55296},[],"`webhook config must not reference files`",{"_3706":1281,"_31461":1254,"_21806":55298,"_5":15007,"_28616":55226,"_3094":55299},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3706":1282,"_31461":1254,"_21806":55301,"_5":15007,"_28616":55226,"_3094":55302},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3706":1283,"_31461":1254,"_21806":55304,"_5":15007,"_28616":55226,"_3094":55305},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3706":1284,"_31461":1254,"_21806":55307,"_5":15007,"_28616":55226,"_3094":55308},[],"`webhook mTLS certificate and key are invalid: …`",{"_3706":1285,"_31461":1254,"_21806":55310,"_5":15007,"_28616":55226,"_3094":55311},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3706":1286,"_31461":1254,"_21806":55313,"_5":15007,"_28616":55226,"_3094":55314},[],"400 `struct validation error` creating or updating a DMS",{"_3706":1287,"_31461":1254,"_21806":55316,"_5":15007,"_28616":55226,"_3094":55317},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3706":1288,"_31461":1254,"_21806":55319,"_5":15007,"_28616":55226,"_3094":55320},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3706":1289,"_31461":1254,"_21806":55322,"_5":15007,"_28616":55226,"_3094":55323},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3706":1290,"_31461":1254,"_21806":55325,"_5":15007,"_28616":55226,"_3094":55326},[],"`device not preregistered`",{"_3706":1291,"_31461":1254,"_21806":55328,"_5":15007,"_28616":55226,"_3094":55329},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3706":1292,"_31461":1254,"_21806":55331,"_5":15007,"_28616":55226,"_3094":55332},[],"`forbiddenNewEnrollment`",{"_3706":1293,"_31461":1254,"_21806":55334,"_5":15007,"_28616":55226,"_3094":55335},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3706":1294,"_31461":1254,"_21806":55337,"_5":15007,"_28616":55226,"_3094":55338},[],"Different owning DMS",{"_3706":1295,"_31461":1254,"_21806":55340,"_5":15007,"_28616":55226,"_3094":55341},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3706":1296,"_31461":1254,"_21806":55343,"_5":15007,"_28616":55226,"_3094":55344},[],"`invalid RawSubject bytes`",{"_3706":1297,"_31461":1254,"_21806":55346,"_5":15007,"_28616":55226,"_3094":55347},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3706":1298,"_31461":1254,"_21806":55349,"_5":15007,"_28616":55226,"_3094":55350},[],"`invalid reenroll window`",{"_3706":1299,"_31461":1254,"_21806":55352,"_5":15007,"_28616":55226,"_3094":55353},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3706":1300,"_31461":1254,"_21806":55355,"_5":15007,"_28616":55226,"_3094":55356},[],"Current certificate revoked",{"_3706":1301,"_31461":1254,"_21806":55358,"_5":15007,"_28616":55226,"_3094":55359},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3706":1302,"_31461":1254,"_21806":55361,"_5":15007,"_28616":55226,"_3094":55362},[],"CA, profile or signing error",{"_3706":1303,"_31461":1254,"_21806":55364,"_5":15007,"_28616":55226,"_3094":55365},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3706":1304,"_31461":1254,"_21806":55367,"_5":15007,"_28616":55226,"_3094":55368},[],"HTTP 200 without a device connection",{"_3706":1305,"_31461":1254,"_21806":55370,"_5":15007,"_28616":55226,"_3094":55371},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3706":1306,"_31461":1254,"_21806":55373,"_5":15007,"_28616":55226,"_3094":55374},[],"Timeout or error after issuance",{"_3706":1307,"_31461":1254,"_21806":55376,"_5":15007,"_28616":55226,"_3094":55377},[],"New certificates, current slot and previous identity's state before retrying.",{"_3706":1308,"_31461":1254,"_21806":55379,"_5":15007,"_28616":55230,"_3094":55380},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3706":1309,"_31461":1254,"_21806":55382,"_5":15007,"_28616":55230,"_3094":55383},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3706":1310,"_31461":1254,"_21806":55385,"_5":15007,"_28616":55233,"_3094":55386},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3706":1311,"_31461":1254,"_21806":55388,"_5":15007,"_28616":55233,"_3094":55389},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3706":1312,"_31461":1254,"_21806":55391,"_5":15007,"_28616":55233,"_3094":55392},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3706":1313,"_31461":1254,"_21806":55394,"_5":15007,"_28616":55233,"_3094":55395},[],"Make one request, save headers/body and query the device and certificates.",{"_3706":1314,"_31461":1254,"_21806":55397,"_5":15007,"_28616":55233,"_3094":55398},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3706":1315,"_31461":1254,"_21806":55400,"_5":15007,"_28616":55233,"_3094":55401},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3706":1316,"_31461":1254,"_21806":55403,"_5":15007,"_28616":55233,"_3094":55404},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3706":1317,"_31461":1317,"_5":15367,"_3094":55406,"_31799":55407,"_21806":55408,"_28616":1317},"Trust distribution and updates",[51312,52850,54022,54020,54206],[],{"_3706":1318,"_31461":1317,"_21806":55410,"_5":15007,"_28616":1317,"_3094":55411},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3706":1319,"_31461":1317,"_5":31796,"_21806":55413,"_28616":55414,"_3094":55415},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3706":1320,"_31461":1317,"_5":31796,"_21806":55417,"_28616":55418,"_3094":55419},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3706":1321,"_31461":1317,"_5":31796,"_21806":55421,"_28616":55422,"_3094":55423},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3706":1322,"_31461":1317,"_5":31796,"_21806":55425,"_28616":55426,"_3094":55427},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3706":1323,"_31461":1317,"_5":31796,"_21806":55429,"_28616":55430,"_3094":55431},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3706":1324,"_31461":1317,"_21806":55433,"_5":15007,"_28616":1317,"_3094":55434},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3706":1325,"_31461":1317,"_21806":55436,"_5":15007,"_28616":55414,"_3094":55437},[],"Relationship",{"_3706":1326,"_31461":1317,"_21806":55439,"_5":15007,"_28616":55414,"_3094":55440},[],"Material prepared by its owner",{"_3706":1327,"_31461":1317,"_21806":55442,"_5":15007,"_28616":55414,"_3094":55443},[],"Device → EST server",{"_3706":1328,"_31461":1317,"_21806":55445,"_5":15007,"_28616":55414,"_3094":55446},[],"Previously verified server root, chain or pin and TLS name.",{"_3706":1329,"_31461":1317,"_21806":55448,"_5":15007,"_28616":55414,"_3094":55449},[],"DMS → requester",{"_3706":1330,"_31461":1317,"_21806":55451,"_5":15007,"_28616":55414,"_3094":55452},[],"CAs and rules authorizing initial or renewal credentials.",{"_3706":1331,"_31461":1317,"_21806":55454,"_5":15007,"_28616":55414,"_3094":55455},[],"Consumer → device",{"_3706":1332,"_31461":1317,"_21806":55457,"_5":15007,"_28616":55414,"_3094":55458},[],"Operational identity roots, intermediates, validation and permissions.",{"_3706":1333,"_31461":1317,"_21806":55460,"_5":15007,"_28616":55414,"_3094":55461},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3706":1334,"_31461":1317,"_21806":55463,"_5":15007,"_28616":55418,"_3094":55464},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3706":1335,"_31461":1317,"_21806":55466,"_5":15007,"_28616":55418,"_3094":55467},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3706":1336,"_31461":1317,"_21806":55469,"_5":15007,"_28616":55422,"_3094":55470},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3706":1337,"_31461":1317,"_21806":55472,"_5":15007,"_28616":55422,"_3094":55473},[],"Select policy-approved roots as anchors.",{"_3706":1338,"_31461":1317,"_21806":55475,"_5":15007,"_28616":55422,"_3094":55476},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3706":1339,"_31461":1317,"_21806":55478,"_5":15007,"_28616":55422,"_3094":55479},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3706":1340,"_31461":1317,"_21806":55481,"_5":15007,"_28616":55422,"_3094":55482},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3706":1341,"_31461":1317,"_21806":55484,"_5":15007,"_28616":55422,"_3094":55485},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3706":1342,"_31461":1317,"_21806":55487,"_5":15007,"_28616":55426,"_3094":55488},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3706":1343,"_31461":1317,"_21806":55490,"_5":15007,"_28616":55426,"_3094":55491},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3706":1344,"_31461":1317,"_21806":55493,"_5":15007,"_28616":55426,"_3094":55494},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3706":1345,"_31461":1317,"_21806":55496,"_5":15007,"_28616":55430,"_3094":55497},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3706":1346,"_31461":1346,"_5":15367,"_3094":55499,"_31799":55500,"_21806":55502,"_28616":1346},"AWS IoT Core",[51312,52850,54022,54020,55501],"Integrations",[],{"_3706":1347,"_31461":1346,"_21806":55504,"_5":15007,"_28616":1346,"_3094":55505},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3706":1348,"_31461":1346,"_5":31796,"_21806":55507,"_28616":55508,"_3094":55509},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3706":1349,"_31461":1346,"_5":31796,"_21806":55511,"_28616":55512,"_3094":55513},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3706":1350,"_31461":1346,"_5":31796,"_21806":55515,"_28616":55516,"_3094":55517},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3706":1351,"_31461":1346,"_5":31796,"_21806":55519,"_28616":55520,"_3094":55521},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3706":1352,"_31461":1346,"_5":31796,"_21806":55523,"_28616":55524,"_3094":55525},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3706":1353,"_31461":1346,"_5":31796,"_21806":55527,"_28616":55528,"_3094":55529},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3706":1354,"_31461":1346,"_5":31796,"_21806":55531,"_28616":55532,"_3094":55533},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3706":1355,"_31461":1346,"_5":31796,"_21806":55535,"_28616":55536,"_3094":55537},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3706":1356,"_31461":1346,"_5":31796,"_21806":55539,"_28616":55540,"_3094":55541},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3706":1357,"_31461":1346,"_5":31796,"_21806":55543,"_28616":55544,"_3094":55545},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3706":1358,"_31461":1346,"_5":31796,"_21806":55547,"_28616":55548,"_3094":55549},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3706":1359,"_31461":1346,"_5":31796,"_21806":55551,"_28616":55552,"_3094":55553},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3706":1360,"_31461":1346,"_5":31796,"_21806":55555,"_28616":55556,"_3094":55557},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3706":1361,"_31461":1346,"_5":31796,"_21806":55559,"_28616":55560,"_3094":55561},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3706":1362,"_31461":1346,"_5":31796,"_21806":55563,"_28616":55564,"_3094":55565},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3706":1363,"_31461":1346,"_5":31796,"_21806":55567,"_28616":55568,"_3094":55569},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3706":1364,"_31461":1346,"_5":31796,"_21806":55571,"_28616":55572,"_3094":55573},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3706":1365,"_31461":1346,"_5":31796,"_21806":55575,"_28616":55576,"_3094":55577},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3706":1366,"_31461":1346,"_5":31796,"_21806":55579,"_28616":55580,"_3094":55581},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3706":1367,"_31461":1346,"_5":31796,"_21806":55583,"_28616":55584,"_3094":55585},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3706":1368,"_31461":1346,"_5":31796,"_21806":55587,"_28616":55588,"_3094":55589},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3706":1369,"_31461":1346,"_5":31796,"_21806":55591,"_28616":55592,"_3094":55593},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3706":1370,"_31461":1346,"_5":31796,"_21806":55595,"_28616":55596,"_3094":55597},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3706":1371,"_31461":1346,"_5":31796,"_21806":55599,"_28616":55600,"_3094":55601},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3706":1372,"_31461":1346,"_5":31796,"_21806":55603,"_28616":55604,"_3094":55605},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3706":1373,"_31461":1346,"_21806":55607,"_5":15007,"_28616":1346,"_3094":55608},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3706":1374,"_31461":1346,"_21806":55610,"_5":15007,"_28616":1346,"_3094":55611},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3706":1375,"_31461":1346,"_21806":55613,"_5":15007,"_28616":1346,"_3094":55614},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3706":1376,"_31461":1346,"_21806":55616,"_5":15007,"_28616":55508,"_3094":55617},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3706":1377,"_31461":1346,"_21806":55619,"_5":15007,"_28616":55508,"_3094":55620},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3706":1378,"_31461":1346,"_21806":55622,"_5":15007,"_28616":55508,"_3094":55623},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3706":1379,"_31461":1346,"_21806":55625,"_5":15007,"_28616":55508,"_3094":55626},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3706":1380,"_31461":1346,"_21806":55628,"_5":15007,"_28616":55512,"_3094":55629},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3706":1381,"_31461":1346,"_21806":55631,"_5":15007,"_28616":55516,"_3094":55632},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3706":1382,"_31461":1346,"_21806":55634,"_5":15007,"_28616":55516,"_3094":55635},[],"IAM action",{"_3706":1383,"_31461":1346,"_21806":55637,"_5":15007,"_28616":55516,"_3094":51702},[],{"_3706":1384,"_31461":1346,"_21806":55639,"_5":15007,"_28616":55516,"_3094":55640},[],"`iot:GetRegistrationCode`",{"_3706":1385,"_31461":1346,"_21806":55642,"_5":15007,"_28616":55516,"_3094":55643},[],"Obtain the verification code for CA registration in the Primary Account",{"_3706":1386,"_31461":1346,"_21806":55645,"_5":15007,"_28616":55516,"_3094":55646},[],"`iot:RegisterCACertificate`",{"_3706":1387,"_31461":1346,"_21806":55648,"_5":15007,"_28616":55516,"_3094":55649},[],"Register the CA in AWS IoT",{"_3706":1388,"_31461":1346,"_21806":55651,"_5":15007,"_28616":55516,"_3094":55652},[],"`iot:DescribeCACertificate`",{"_3706":1389,"_31461":1346,"_21806":55654,"_5":15007,"_28616":55516,"_3094":55655},[],"Check the CA registration status",{"_3706":1390,"_31461":1346,"_21806":55657,"_5":15007,"_28616":55516,"_3094":55658},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3706":1391,"_31461":1346,"_21806":55660,"_5":15007,"_28616":55516,"_3094":55661},[],"Create or update Things in IoT Core",{"_3706":1392,"_31461":1346,"_21806":55663,"_5":15007,"_28616":55516,"_3094":55664},[],"`iot:RegisterThing`",{"_3706":1393,"_31461":1346,"_21806":55666,"_5":15007,"_28616":55516,"_3094":55667},[],"Provision Things through a template",{"_3706":1394,"_31461":1346,"_21806":55669,"_5":15007,"_28616":55516,"_3094":55670},[],"`iot:RegisterCertificate`",{"_3706":1395,"_31461":1346,"_21806":55672,"_5":15007,"_28616":55516,"_3094":55673},[],"Register device certificates",{"_3706":1396,"_31461":1346,"_21806":55675,"_5":15007,"_28616":55516,"_3094":55676},[],"`iot:UpdateCertificate`",{"_3706":1397,"_31461":1346,"_21806":55678,"_5":15007,"_28616":55516,"_3094":55679},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3706":1398,"_31461":1346,"_21806":55681,"_5":15007,"_28616":55516,"_3094":55682},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3706":1399,"_31461":1346,"_21806":55684,"_5":15007,"_28616":55516,"_3094":55685},[],"Create and attach IoT policies",{"_3706":1400,"_31461":1346,"_21806":55687,"_5":15007,"_28616":55516,"_3094":55688},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3706":1401,"_31461":1346,"_21806":55690,"_5":15007,"_28616":55516,"_3094":55691},[],"Manage Thing groups",{"_3706":1402,"_31461":1346,"_21806":55693,"_5":15007,"_28616":55516,"_3094":55694},[],"`iot:CreateProvisioningTemplate`",{"_3706":1403,"_31461":1346,"_21806":55696,"_5":15007,"_28616":55516,"_3094":55697},[],"Create JITP templates",{"_3706":1404,"_31461":1346,"_21806":55699,"_5":15007,"_28616":55516,"_3094":55700},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3706":1405,"_31461":1346,"_21806":55702,"_5":15007,"_28616":55516,"_3094":55703},[],"Read and write the Device Shadow",{"_3706":1406,"_31461":1346,"_21806":55705,"_5":15007,"_28616":55516,"_3094":55706},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3706":1407,"_31461":1346,"_21806":55708,"_5":15007,"_28616":55520,"_3094":55709},[],"Parameter",{"_3706":1408,"_31461":1346,"_21806":55711,"_5":15007,"_28616":55520,"_3094":55712},[],"Type",{"_3706":1409,"_31461":1346,"_21806":55714,"_5":15007,"_28616":55520,"_3094":55715},[],"Required",{"_3706":1410,"_31461":1346,"_21806":55717,"_5":15007,"_28616":55520,"_3094":55718},[],"Description",{"_3706":1411,"_31461":1346,"_21806":55720,"_5":15007,"_28616":55520,"_3094":55721},[],"`connector_id`",{"_3706":1412,"_31461":1346,"_21806":55723,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1413,"_31461":1346,"_21806":55725,"_5":15007,"_28616":55520,"_3094":55726},[],"Yes",{"_3706":1414,"_31461":1346,"_21806":55728,"_5":15007,"_28616":55520,"_3094":55729},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3706":1415,"_31461":1346,"_21806":55731,"_5":15007,"_28616":55520,"_3094":55732},[],"`aws_config.region`",{"_3706":1416,"_31461":1346,"_21806":55734,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1417,"_31461":1346,"_21806":55736,"_5":15007,"_28616":55520,"_3094":55726},[],{"_3706":1418,"_31461":1346,"_21806":55738,"_5":15007,"_28616":55520,"_3094":55739},[],"AWS region where the connector operates.",{"_3706":1419,"_31461":1346,"_21806":55741,"_5":15007,"_28616":55520,"_3094":55742},[],"`aws_config.auth_method`",{"_3706":1420,"_31461":1346,"_21806":55744,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1421,"_31461":1346,"_21806":55746,"_5":15007,"_28616":55520,"_3094":55726},[],{"_3706":1422,"_31461":1346,"_21806":55748,"_5":15007,"_28616":55520,"_3094":55749},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3706":1423,"_31461":1346,"_21806":55751,"_5":15007,"_28616":55520,"_3094":55752},[],"`aws_config.access_key_id`",{"_3706":1424,"_31461":1346,"_21806":55754,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1425,"_31461":1346,"_21806":55756,"_5":15007,"_28616":55520,"_3094":55757},[],"Only with `auth_method=static`",{"_3706":1426,"_31461":1346,"_21806":55759,"_5":15007,"_28616":55520,"_3094":55760},[],"AWS access key.",{"_3706":1427,"_31461":1346,"_21806":55762,"_5":15007,"_28616":55520,"_3094":55763},[],"`aws_config.secret_access_key`",{"_3706":1428,"_31461":1346,"_21806":55765,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1429,"_31461":1346,"_21806":55767,"_5":15007,"_28616":55520,"_3094":55757},[],{"_3706":1430,"_31461":1346,"_21806":55769,"_5":15007,"_28616":55520,"_3094":55770},[],"AWS secret key.",{"_3706":1431,"_31461":1346,"_21806":55772,"_5":15007,"_28616":55520,"_3094":55773},[],"`aws_config.session_token`",{"_3706":1432,"_31461":1346,"_21806":55775,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1433,"_31461":1346,"_21806":55777,"_5":15007,"_28616":55520,"_3094":55778},[],"No",{"_3706":1434,"_31461":1346,"_21806":55780,"_5":15007,"_28616":55520,"_3094":55781},[],"Session token (with `auth_method=static`).",{"_3706":1435,"_31461":1346,"_21806":55783,"_5":15007,"_28616":55520,"_3094":55784},[],"`aws_config.role_arn`",{"_3706":1436,"_31461":1346,"_21806":55786,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1437,"_31461":1346,"_21806":55788,"_5":15007,"_28616":55520,"_3094":55789},[],"Only with `auth_method=role`",{"_3706":1438,"_31461":1346,"_21806":55791,"_5":15007,"_28616":55520,"_3094":55792},[],"ARN of the role to assume.",{"_3706":1439,"_31461":1346,"_21806":55794,"_5":15007,"_28616":55520,"_3094":55795},[],"`aws_config.endpoint_url`",{"_3706":1440,"_31461":1346,"_21806":55797,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1441,"_31461":1346,"_21806":55799,"_5":15007,"_28616":55520,"_3094":55778},[],{"_3706":1442,"_31461":1346,"_21806":55801,"_5":15007,"_28616":55520,"_3094":55802},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3706":1443,"_31461":1346,"_21806":55804,"_5":15007,"_28616":55520,"_3094":55805},[],"`subscriber_event_bus`",{"_3706":1444,"_31461":1346,"_21806":55807,"_5":15007,"_28616":55520,"_3094":18373},[],{"_3706":1445,"_31461":1346,"_21806":55809,"_5":15007,"_28616":55520,"_3094":55726},[],{"_3706":1446,"_31461":1346,"_21806":55811,"_5":15007,"_28616":55520,"_3094":55812},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3706":1447,"_31461":1346,"_21806":55814,"_5":15007,"_28616":55520,"_3094":55815},[],"`dms_manager_client`",{"_3706":1448,"_31461":1346,"_21806":55817,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1449,"_31461":1346,"_21806":55819,"_5":15007,"_28616":55520,"_3094":55726},[],{"_3706":1450,"_31461":1346,"_21806":55821,"_5":15007,"_28616":55520,"_3094":55822},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3706":1451,"_31461":1346,"_21806":55824,"_5":15007,"_28616":55520,"_3094":55825},[],"`device_manager_client`",{"_3706":1452,"_31461":1346,"_21806":55827,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1453,"_31461":1346,"_21806":55829,"_5":15007,"_28616":55520,"_3094":55726},[],{"_3706":1454,"_31461":1346,"_21806":55831,"_5":15007,"_28616":55520,"_3094":55832},[],"HTTP URL of Lamassu's Device Manager.",{"_3706":1455,"_31461":1346,"_21806":55834,"_5":15007,"_28616":55520,"_3094":55835},[],"`ca_client`",{"_3706":1456,"_31461":1346,"_21806":55837,"_5":15007,"_28616":55520,"_3094":26007},[],{"_3706":1457,"_31461":1346,"_21806":55839,"_5":15007,"_28616":55520,"_3094":55726},[],{"_3706":1458,"_31461":1346,"_21806":55841,"_5":15007,"_28616":55520,"_3094":55842},[],"HTTP URL of Lamassu's CA service.",{"_3706":1459,"_31461":1346,"_21806":55844,"_5":15007,"_28616":55524,"_3094":55845},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3706":1460,"_31461":1346,"_21806":55847,"_5":15007,"_28616":55524,"_3094":55848},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3706":1461,"_31461":1346,"_21806":55850,"_5":15007,"_28616":55524,"_3094":55851},[],"CloudEvent type",{"_3706":1462,"_31461":1346,"_21806":55853,"_5":15007,"_28616":55524,"_3094":55854},[],"Lamassu resource",{"_3706":1463,"_31461":1346,"_21806":55856,"_5":15007,"_28616":55524,"_3094":55857},[],"AWS Resource",{"_3706":1464,"_31461":1346,"_21806":55859,"_5":15007,"_28616":55524,"_3094":55860},[],"IAM actions",{"_3706":1465,"_31461":1346,"_21806":55862,"_5":15007,"_28616":55524,"_3094":55863},[],"AWS calls and effect",{"_3706":1466,"_31461":1346,"_21806":55865,"_5":15007,"_28616":55524,"_3094":55866},[],"Where in this page",{"_3706":1467,"_31461":1346,"_21806":55868,"_5":15007,"_28616":55524,"_3094":55869},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3706":1468,"_31461":1346,"_21806":55871,"_5":15007,"_28616":55524,"_3094":55872},[],"CA",{"_3706":1469,"_31461":1346,"_21806":55874,"_5":15007,"_28616":55524,"_3094":55875},[],"`IoTCore/CACertificate`",{"_3706":1470,"_31461":1346,"_21806":55877,"_5":15007,"_28616":55524,"_3094":55878},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3706":1471,"_31461":1346,"_21806":55880,"_5":15007,"_28616":55524,"_3094":55881},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3706":1472,"_31461":1346,"_21806":55883,"_5":15007,"_28616":55524,"_3094":55537},[],{"_3706":1473,"_31461":1346,"_21806":55885,"_5":15007,"_28616":55524,"_3094":55886},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3706":1474,"_31461":1346,"_21806":55888,"_5":15007,"_28616":55524,"_3094":55889},[],"DMS",{"_3706":1475,"_31461":1346,"_21806":55891,"_5":15007,"_28616":55524,"_3094":55892},[],"`IoTCore/ProvisioningTemplate`",{"_3706":1476,"_31461":1346,"_21806":55894,"_5":15007,"_28616":55524,"_3094":55895},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3706":1477,"_31461":1346,"_21806":55897,"_5":15007,"_28616":55524,"_3094":55898},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3706":1478,"_31461":1346,"_21806":55900,"_5":15007,"_28616":55524,"_3094":55565},[],{"_3706":1479,"_31461":1346,"_21806":55902,"_5":15007,"_28616":55524,"_3094":55903},[],"`EventBindDeviceIdentityKey`",{"_3706":1480,"_31461":1346,"_21806":55905,"_5":15007,"_28616":55524,"_3094":55906},[],"Device",{"_3706":1481,"_31461":1346,"_21806":55908,"_5":15007,"_28616":55524,"_3094":55909},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3706":1482,"_31461":1346,"_21806":55911,"_5":15007,"_28616":55524,"_3094":55912},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3706":1483,"_31461":1346,"_21806":55914,"_5":15007,"_28616":55524,"_3094":55915},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3706":1484,"_31461":1346,"_21806":55917,"_5":15007,"_28616":55524,"_3094":55573},[],{"_3706":1485,"_31461":1346,"_21806":55919,"_5":15007,"_28616":55524,"_3094":55920},[],"`EventUpdateCertificateStatusKey`",{"_3706":1486,"_31461":1346,"_21806":55922,"_5":15007,"_28616":55524,"_3094":55923},[],"Certificate",{"_3706":1487,"_31461":1346,"_21806":55925,"_5":15007,"_28616":55524,"_3094":55926},[],"`IoTCore/Certificate`",{"_3706":1488,"_31461":1346,"_21806":55928,"_5":15007,"_28616":55524,"_3094":55929},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3706":1489,"_31461":1346,"_21806":55931,"_5":15007,"_28616":55524,"_3094":55932},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3706":1490,"_31461":1346,"_21806":55934,"_5":15007,"_28616":55524,"_3094":55585},[],{"_3706":1491,"_31461":1346,"_21806":55936,"_5":15007,"_28616":55524,"_3094":55937},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3706":1492,"_31461":1346,"_21806":55939,"_5":15007,"_28616":55524,"_3094":55940},[],"Certificate / Device",{"_3706":1493,"_31461":1346,"_21806":55942,"_5":15007,"_28616":55524,"_3094":55943},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3706":1494,"_31461":1346,"_21806":55945,"_5":15007,"_28616":55524,"_3094":51708},[],{"_3706":1495,"_31461":1346,"_21806":55947,"_5":15007,"_28616":55524,"_3094":55948},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3706":1496,"_31461":1346,"_21806":55950,"_5":15007,"_28616":55524,"_3094":55593},[],{"_3706":1497,"_31461":1346,"_21806":55952,"_5":15007,"_28616":55528,"_3094":55953},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3706":1498,"_31461":1346,"_21806":55955,"_5":15007,"_28616":55532,"_3094":55956},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3706":1499,"_31461":1346,"_21806":55958,"_5":15007,"_28616":55532,"_3094":55959},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3706":1500,"_31461":1346,"_21806":55961,"_5":15007,"_28616":55536,"_3094":55962},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3706":1501,"_31461":1346,"_21806":55964,"_5":15007,"_28616":55536,"_3094":55965},[],"Transition",{"_3706":1502,"_31461":1346,"_21806":55967,"_5":15007,"_28616":55536,"_3094":55968},[],"AWS calls",{"_3706":1503,"_31461":1346,"_21806":55970,"_5":15007,"_28616":55536,"_3094":55971},[],"`NotRegistered` → `Requested`",{"_3706":1504,"_31461":1346,"_21806":55973,"_5":15007,"_28616":55536,"_3094":55974},[],"none (metadata write only)",{"_3706":1505,"_31461":1346,"_21806":55976,"_5":15007,"_28616":55536,"_3094":55977},[],"`Requested` → `Registering`",{"_3706":1506,"_31461":1346,"_21806":55979,"_5":15007,"_28616":55536,"_3094":55980},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3706":1507,"_31461":1346,"_21806":55982,"_5":15007,"_28616":55536,"_3094":55983},[],"`Registering` → `Succeeded`",{"_3706":1508,"_31461":1346,"_21806":55985,"_5":15007,"_28616":55536,"_3094":55986},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3706":1509,"_31461":1346,"_21806":55988,"_5":15007,"_28616":55536,"_3094":55989},[],"`Registering` → `Failed`",{"_3706":1510,"_31461":1346,"_21806":55991,"_5":15007,"_28616":55536,"_3094":55992},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3706":1511,"_31461":1346,"_21806":55994,"_5":15007,"_28616":55536,"_3094":55995},[],"`Failed` / `Succeeded` → `Requested`",{"_3706":1512,"_31461":1346,"_21806":55997,"_5":15007,"_28616":55536,"_3094":55998},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3706":1513,"_31461":1346,"_21806":56000,"_5":15007,"_28616":55540,"_3094":56001},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3706":1514,"_31461":1346,"_21806":56003,"_5":15007,"_28616":55540,"_3094":56004},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3706":1515,"_31461":1346,"_21806":56006,"_5":15007,"_28616":55540,"_3094":56007},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3706":1516,"_31461":1346,"_21806":56009,"_5":15007,"_28616":55540,"_3094":56010},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3706":1517,"_31461":1346,"_21806":56012,"_5":15007,"_28616":55540,"_3094":56013},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3706":1518,"_31461":1346,"_21806":56015,"_5":15007,"_28616":55540,"_3094":56016},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3706":1519,"_31461":1346,"_21806":56018,"_5":15007,"_28616":55544,"_3094":56019},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3706":1520,"_31461":1346,"_21806":56021,"_5":15007,"_28616":55548,"_3094":56022},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3706":1521,"_31461":1346,"_21806":56024,"_5":15007,"_28616":55548,"_3094":56025},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3706":1522,"_31461":1346,"_21806":56027,"_5":15007,"_28616":55552,"_3094":56028},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3706":1523,"_31461":1346,"_21806":56030,"_5":15007,"_28616":55556,"_3094":56031},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3706":1524,"_31461":1346,"_21806":56033,"_5":15007,"_28616":55556,"_3094":56034},[],"Creates or updates the IoT policies configured in the DMS.",{"_3706":1525,"_31461":1346,"_21806":56036,"_5":15007,"_28616":55556,"_3094":56037},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3706":1526,"_31461":1346,"_21806":56039,"_5":15007,"_28616":55556,"_3094":56040},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3706":1527,"_31461":1346,"_21806":56042,"_5":15007,"_28616":55556,"_3094":56043},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3706":1528,"_31461":1346,"_21806":56045,"_5":15007,"_28616":55556,"_3094":56046},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3706":1529,"_31461":1346,"_21806":56048,"_5":15007,"_28616":55556,"_3094":56049},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3706":1530,"_31461":1346,"_21806":56051,"_5":15007,"_28616":55560,"_3094":56052},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3706":1531,"_31461":1346,"_21806":56054,"_5":15007,"_28616":55560,"_3094":56055},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3706":1532,"_31461":1346,"_21806":56057,"_5":15007,"_28616":55560,"_3094":56058},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3706":1533,"_31461":1346,"_21806":56060,"_5":15007,"_28616":55560,"_3094":56061},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3706":1534,"_31461":1346,"_21806":56063,"_5":15007,"_28616":55560,"_3094":56064},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3706":1535,"_31461":1346,"_21806":56066,"_5":15007,"_28616":55564,"_3094":56067},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3706":1536,"_31461":1346,"_21806":56069,"_5":15007,"_28616":55564,"_3094":55965},[],{"_3706":1537,"_31461":1346,"_21806":56071,"_5":15007,"_28616":55564,"_3094":55968},[],{"_3706":1538,"_31461":1346,"_21806":56073,"_5":15007,"_28616":55564,"_3094":56074},[],"`Unconfigured` → `None` / `Auto`",{"_3706":1539,"_31461":1346,"_21806":56076,"_5":15007,"_28616":55564,"_3094":56077},[],"none (configuration only)",{"_3706":1540,"_31461":1346,"_21806":56079,"_5":15007,"_28616":55564,"_3094":56080},[],"`None` ↔ `Auto`",{"_3706":1541,"_31461":1346,"_21806":56082,"_5":15007,"_28616":55564,"_3094":56077},[],{"_3706":1542,"_31461":1346,"_21806":56084,"_5":15007,"_28616":55564,"_3094":56085},[],"Any → `Jitp`",{"_3706":1543,"_31461":1346,"_21806":56087,"_5":15007,"_28616":55564,"_3094":56088},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3706":1544,"_31461":1346,"_21806":56090,"_5":15007,"_28616":55564,"_3094":56091},[],"`Jitp` → `None` / `Auto`",{"_3706":1545,"_31461":1346,"_21806":56093,"_5":15007,"_28616":55564,"_3094":56094},[],"none (the template stays in the AWS account)",{"_3706":1546,"_31461":1346,"_21806":56096,"_5":15007,"_28616":55568,"_3094":56097},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3706":1547,"_31461":1346,"_21806":56099,"_5":15007,"_28616":55568,"_3094":56100},[],"The full flow from the device's perspective is:",{"_3706":1548,"_31461":1346,"_21806":56102,"_5":15007,"_28616":55568,"_3094":56103},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3706":1549,"_31461":1346,"_21806":56105,"_5":15007,"_28616":55572,"_3094":56106},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3706":1550,"_31461":1346,"_21806":56108,"_5":15007,"_28616":55572,"_3094":55965},[],{"_3706":1551,"_31461":1346,"_21806":56110,"_5":15007,"_28616":55572,"_3094":55968},[],{"_3706":1552,"_31461":1346,"_21806":56112,"_5":15007,"_28616":55572,"_3094":56113},[],"`Absent` → `Provisioned`",{"_3706":1553,"_31461":1346,"_21806":56115,"_5":15007,"_28616":55572,"_3094":56116},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3706":1554,"_31461":1346,"_21806":56118,"_5":15007,"_28616":55572,"_3094":56119},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3706":1555,"_31461":1346,"_21806":56121,"_5":15007,"_28616":55572,"_3094":56122},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3706":1556,"_31461":1346,"_21806":56124,"_5":15007,"_28616":55572,"_3094":56125},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3706":1557,"_31461":1346,"_21806":56127,"_5":15007,"_28616":55576,"_3094":56128},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3706":1558,"_31461":1346,"_21806":56130,"_5":15007,"_28616":55576,"_3094":56131},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3706":1559,"_31461":1346,"_21806":56133,"_5":15007,"_28616":55576,"_3094":56134},[],"For the JITP flow to work correctly:",{"_3706":1560,"_31461":1346,"_21806":56136,"_5":15007,"_28616":55576,"_3094":56137},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3706":1561,"_31461":1346,"_21806":56139,"_5":15007,"_28616":55576,"_3094":56140},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3706":1562,"_31461":1346,"_21806":56142,"_5":15007,"_28616":55576,"_3094":56143},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3706":1563,"_31461":1346,"_21806":56145,"_5":15007,"_28616":55576,"_3094":56146},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3706":1564,"_31461":1346,"_21806":56148,"_5":15007,"_28616":55580,"_3094":56149},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3706":1565,"_31461":1346,"_21806":56151,"_5":15007,"_28616":55580,"_3094":56152},[],"Status in Lamassu",{"_3706":1566,"_31461":1346,"_21806":56154,"_5":15007,"_28616":55580,"_3094":56155},[],"Revocation reason",{"_3706":1567,"_31461":1346,"_21806":56157,"_5":15007,"_28616":55580,"_3094":56158},[],"Status in AWS IoT Core",{"_3706":1568,"_31461":1346,"_21806":56160,"_5":15007,"_28616":55580,"_3094":56161},[],"`Active`",{"_3706":1569,"_31461":1346,"_21806":56163,"_5":15007,"_28616":55580,"_3094":56164},[],"None",{"_3706":1570,"_31461":1346,"_21806":56166,"_5":15007,"_28616":55580,"_3094":56167},[],"`ACTIVE`",{"_3706":1571,"_31461":1346,"_21806":56169,"_5":15007,"_28616":55580,"_3094":56170},[],"`Revoked`",{"_3706":1572,"_31461":1346,"_21806":56172,"_5":15007,"_28616":55580,"_3094":56173},[],"`certificateHold`",{"_3706":1573,"_31461":1346,"_21806":56175,"_5":15007,"_28616":55580,"_3094":56176},[],"`INACTIVE`",{"_3706":1574,"_31461":1346,"_21806":56178,"_5":15007,"_28616":55580,"_3094":56170},[],{"_3706":1575,"_31461":1346,"_21806":56180,"_5":15007,"_28616":55580,"_3094":56181},[],"Any other reason",{"_3706":1576,"_31461":1346,"_21806":56183,"_5":15007,"_28616":55580,"_3094":56184},[],"`REVOKED`",{"_3706":1577,"_31461":1346,"_21806":56186,"_5":15007,"_28616":55580,"_3094":56187},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3706":1578,"_31461":1346,"_21806":56189,"_5":15007,"_28616":55584,"_3094":56190},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3706":1579,"_31461":1346,"_21806":56192,"_5":15007,"_28616":55584,"_3094":55965},[],{"_3706":1580,"_31461":1346,"_21806":56194,"_5":15007,"_28616":55584,"_3094":55968},[],{"_3706":1581,"_31461":1346,"_21806":56196,"_5":15007,"_28616":55584,"_3094":56197},[],"`NotSynced` → `Active`",{"_3706":1582,"_31461":1346,"_21806":56199,"_5":15007,"_28616":55584,"_3094":55676},[],{"_3706":1583,"_31461":1346,"_21806":56201,"_5":15007,"_28616":55584,"_3094":56202},[],"`Active` → `Inactive`",{"_3706":1584,"_31461":1346,"_21806":56204,"_5":15007,"_28616":55584,"_3094":56205},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3706":1585,"_31461":1346,"_21806":56207,"_5":15007,"_28616":55584,"_3094":56208},[],"`Active` → `Revoked`",{"_3706":1586,"_31461":1346,"_21806":56210,"_5":15007,"_28616":55584,"_3094":56205},[],{"_3706":1587,"_31461":1346,"_21806":56212,"_5":15007,"_28616":55584,"_3094":56213},[],"`Inactive` / `Revoked` → `Active`",{"_3706":1588,"_31461":1346,"_21806":56215,"_5":15007,"_28616":55584,"_3094":55676},[],{"_3706":1589,"_31461":1346,"_21806":56217,"_5":15007,"_28616":55584,"_3094":56218},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3706":1590,"_31461":1346,"_21806":56220,"_5":15007,"_28616":55584,"_3094":56221},[],"none (these states are not synced to AWS)",{"_3706":1591,"_31461":1346,"_21806":56223,"_5":15007,"_28616":55588,"_3094":56224},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3706":1592,"_31461":1346,"_21806":56226,"_5":15007,"_28616":55588,"_3094":56227},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3706":1593,"_31461":1346,"_21806":56229,"_5":15007,"_28616":55588,"_3094":56230},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3706":1594,"_31461":1346,"_21806":56232,"_5":15007,"_28616":55592,"_3094":56233},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3706":1595,"_31461":1346,"_21806":56235,"_5":15007,"_28616":55592,"_3094":56236},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3706":1596,"_31461":1346,"_21806":56238,"_5":15007,"_28616":55596,"_3094":56239},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3706":1597,"_31461":1346,"_21806":56241,"_5":15007,"_28616":55596,"_3094":56242},[],"There are two action types:",{"_3706":1598,"_31461":1346,"_21806":56244,"_5":15007,"_28616":55596,"_3094":56245},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3706":1599,"_31461":1346,"_21806":56247,"_5":15007,"_28616":55596,"_3094":56248},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3706":1600,"_31461":1346,"_21806":56250,"_5":15007,"_28616":55596,"_3094":56251},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3706":1601,"_31461":1346,"_21806":56253,"_5":15007,"_28616":55600,"_3094":56254},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3706":1602,"_31461":1346,"_21806":56256,"_5":15007,"_28616":55600,"_3094":56257},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3706":1603,"_31461":1346,"_21806":56259,"_5":15007,"_28616":55600,"_3094":56260},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3706":1604,"_31461":1346,"_21806":56262,"_5":15007,"_28616":55604,"_3094":56263},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3706":1605,"_31461":1346,"_21806":56265,"_5":15007,"_28616":55604,"_3094":56266},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3706":1606,"_31461":1346,"_21806":56268,"_5":15007,"_28616":55604,"_3094":56269},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3706":1607,"_31461":1346,"_21806":56271,"_5":15007,"_28616":55604,"_3094":56272},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3706":1608,"_31461":1346,"_21806":56274,"_5":15007,"_28616":55604,"_3094":56275},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3706":1609,"_31461":1346,"_21806":56277,"_5":15007,"_28616":55604,"_3094":56278},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3706":1610,"_31461":1346,"_21806":56280,"_5":15007,"_28616":55604,"_3094":56281},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3706":1611,"_31461":1346,"_21806":56283,"_5":15007,"_28616":55604,"_3094":56284},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3706":1612,"_31461":1346,"_21806":56286,"_5":15007,"_28616":55604,"_3094":56287},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3706":1613,"_31461":1346,"_21806":56289,"_5":15007,"_28616":55604,"_3094":56290},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3706":1614,"_31461":1346,"_21806":56292,"_5":15007,"_28616":55604,"_3094":56293},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3706":1615,"_31461":1346,"_21806":56295,"_5":15007,"_28616":55604,"_3094":56296},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3706":1616,"_31461":1346,"_21806":56298,"_5":15007,"_28616":55604,"_3094":56299},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3706":1617,"_31461":1346,"_21806":56301,"_5":15007,"_28616":55604,"_3094":56302},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3706":1618,"_31461":1346,"_21806":56304,"_5":15007,"_28616":55604,"_3094":56305},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3706":1619,"_31461":1346,"_21806":56307,"_5":15007,"_28616":55604,"_3094":56308},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3706":1620,"_31461":1346,"_21806":56310,"_5":15007,"_28616":55604,"_3094":56311},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3706":1621,"_31461":1346,"_21806":56313,"_5":15007,"_28616":55604,"_3094":56314},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3706":1622,"_31461":1346,"_21806":56316,"_5":15007,"_28616":55604,"_3094":56317},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3706":1623,"_31461":1346,"_21806":56319,"_5":15007,"_28616":55604,"_3094":56320},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3706":1624,"_31461":1346,"_21806":56322,"_5":15007,"_28616":55604,"_3094":56323},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3706":1625,"_31461":1346,"_21806":56325,"_5":15007,"_28616":55604,"_3094":56326},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3706":1626,"_31461":1346,"_21806":56328,"_5":15007,"_28616":55604,"_3094":56329},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3706":1627,"_31461":1346,"_21806":56331,"_5":15007,"_28616":55604,"_3094":56332},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3706":1628,"_31461":1628,"_5":15367,"_3094":54022,"_31799":56334,"_21806":56335,"_28616":1628},[51312,52850,54022],[],{"_3706":1629,"_31461":1628,"_21806":56337,"_5":15007,"_28616":1628,"_3094":56338},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3706":1630,"_31461":1628,"_5":31796,"_21806":56340,"_28616":56341,"_3094":56342},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3706":1631,"_31461":1628,"_5":31796,"_21806":56344,"_28616":56345,"_3094":54020},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3706":1632,"_31461":1628,"_5":31796,"_21806":56347,"_28616":56348,"_3094":54206},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3706":1633,"_31461":1628,"_5":31796,"_21806":56350,"_28616":56351,"_3094":55501},[],"/docs/platform/iot-fleets/overview#integrations",{"_3706":1634,"_31461":1628,"_5":31796,"_21806":56353,"_28616":56354,"_3094":56355},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3706":1635,"_31461":1628,"_21806":56357,"_5":15007,"_28616":1628,"_3094":56358},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3706":1636,"_31461":1628,"_21806":56360,"_5":15007,"_28616":56341,"_3094":56361},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3706":1637,"_31461":1628,"_21806":56363,"_5":15007,"_28616":56341,"_3094":56364},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3706":1638,"_31461":1628,"_21806":56366,"_5":15007,"_28616":56345,"_3094":56367},[],"Resource",{"_3706":1639,"_31461":1628,"_21806":56369,"_5":15007,"_28616":56345,"_3094":56370},[],"What it represents",{"_3706":1640,"_31461":1628,"_21806":56372,"_5":15007,"_28616":56345,"_3094":56373},[],"**Device**",{"_3706":1641,"_31461":1628,"_21806":56375,"_5":15007,"_28616":56345,"_3094":56376},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3706":1642,"_31461":1628,"_21806":56378,"_5":15007,"_28616":56345,"_3094":56379},[],"**Identity**",{"_3706":1643,"_31461":1628,"_21806":56381,"_5":15007,"_28616":56345,"_3094":56382},[],"The device's association with its certificates: an active version and a history.",{"_3706":1644,"_31461":1628,"_21806":56384,"_5":15007,"_28616":56345,"_3094":56385},[],"**DMS**",{"_3706":1645,"_31461":1628,"_21806":56387,"_5":15007,"_28616":56345,"_3094":56388},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3706":1646,"_31461":1628,"_21806":56390,"_5":15007,"_28616":56345,"_3094":56391},[],"**Fleet**",{"_3706":1647,"_31461":1628,"_21806":56393,"_5":15007,"_28616":56345,"_3094":56394},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3706":1648,"_31461":1628,"_21806":56396,"_5":15007,"_28616":56345,"_3094":56397},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3706":1649,"_31461":1628,"_21806":56399,"_5":15007,"_28616":56345,"_3094":56400},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3706":1650,"_31461":1628,"_21806":56402,"_5":15007,"_28616":56348,"_3094":56403},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3706":1651,"_31461":1628,"_21806":56405,"_5":15007,"_28616":56348,"_3094":56406},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3706":1652,"_31461":1628,"_21806":56408,"_5":15007,"_28616":56348,"_3094":56409},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3706":1653,"_31461":1628,"_21806":56411,"_5":15007,"_28616":56348,"_3094":56412},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3706":1654,"_31461":1628,"_21806":56414,"_5":15007,"_28616":56348,"_3094":56415},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3706":1655,"_31461":1628,"_21806":56417,"_5":15007,"_28616":56348,"_3094":56418},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3706":1656,"_31461":1628,"_21806":56420,"_5":15007,"_28616":56348,"_3094":56421},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3706":1657,"_31461":1628,"_21806":56423,"_5":15007,"_28616":56348,"_3094":56424},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3706":1658,"_31461":1628,"_21806":56426,"_5":15007,"_28616":56351,"_3094":56427},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3706":1659,"_31461":1628,"_21806":56429,"_5":15007,"_28616":56351,"_3094":56430},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3706":1660,"_31461":1628,"_21806":56432,"_5":15007,"_28616":56354,"_3094":56433},[],"Participant",{"_3706":1661,"_31461":1628,"_21806":56435,"_5":15007,"_28616":56354,"_3094":56436},[],"Responsibility",{"_3706":1662,"_31461":1628,"_21806":56438,"_5":15007,"_28616":56354,"_3094":56439},[],"PKI administrator",{"_3706":1663,"_31461":1628,"_21806":56441,"_5":15007,"_28616":56354,"_3094":56442},[],"CA, issuance profile, chain and revocation publication.",{"_3706":1664,"_31461":1628,"_21806":56444,"_5":15007,"_28616":56354,"_3094":56445},[],"Provisioning administrator",{"_3706":1665,"_31461":1628,"_21806":56447,"_5":15007,"_28616":56354,"_3094":56448},[],"DMS, admission, authentication per operation and inventory.",{"_3706":1666,"_31461":1628,"_21806":56450,"_5":15007,"_28616":56354,"_3094":56451},[],"Device integrator",{"_3706":1667,"_31461":1628,"_21806":56453,"_5":15007,"_28616":56354,"_3094":56454},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3706":1668,"_31461":1628,"_21806":56456,"_5":15007,"_28616":56354,"_3094":56457},[],"Consumer integrator",{"_3706":1669,"_31461":1628,"_21806":56459,"_5":15007,"_28616":56354,"_3094":56460},[],"Trusted issuers, validation and device permissions in the destination.",{"_3706":1670,"_31461":1628,"_21806":56462,"_5":15007,"_28616":56354,"_3094":56463},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3706":1671,"_31461":1671,"_5":15367,"_3094":56465,"_31799":56466,"_21806":56468,"_28616":1671},"Enroll and connect your first device",[51312,52850,54022,56467],"Getting started",[],{"_3706":1672,"_31461":1671,"_21806":56470,"_5":15007,"_28616":1671,"_3094":56471},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3706":1673,"_31461":1671,"_5":31796,"_21806":56473,"_28616":56474,"_3094":51322},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3706":1674,"_31461":1671,"_5":31796,"_21806":56476,"_28616":56477,"_3094":56478},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3706":1675,"_31461":1671,"_5":31796,"_21806":56480,"_28616":56481,"_3094":56482},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3706":1676,"_31461":1671,"_5":31796,"_21806":56484,"_28616":56485,"_3094":56486},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3706":1677,"_31461":1671,"_5":31796,"_21806":56488,"_28616":56489,"_3094":56490},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3706":1678,"_31461":1671,"_5":31796,"_21806":56492,"_28616":56493,"_3094":56494},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3706":1679,"_31461":1671,"_5":31796,"_21806":56496,"_28616":56497,"_3094":56498},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3706":1680,"_31461":1671,"_5":31796,"_21806":56500,"_28616":56501,"_3094":56502},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3706":1681,"_31461":1671,"_21806":56504,"_5":15007,"_28616":1671,"_3094":56505},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3706":1682,"_31461":1671,"_21806":56507,"_5":15007,"_28616":56474,"_3094":56508},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3706":1683,"_31461":1671,"_21806":56510,"_5":15007,"_28616":56474,"_3094":56511},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3706":1684,"_31461":1671,"_21806":56513,"_5":15007,"_28616":56474,"_3094":56514},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3706":1685,"_31461":1671,"_21806":56516,"_5":15007,"_28616":56474,"_3094":56517},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3706":1686,"_31461":1671,"_21806":56519,"_5":15007,"_28616":56474,"_3094":56520},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3706":1687,"_31461":1671,"_21806":56522,"_5":15007,"_28616":56477,"_3094":56523},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3706":1688,"_31461":1671,"_21806":56525,"_5":15007,"_28616":56477,"_3094":56526},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3706":1689,"_31461":1671,"_21806":56528,"_5":15007,"_28616":56481,"_3094":56529},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3706":1690,"_31461":1671,"_21806":56531,"_5":15007,"_28616":56481,"_3094":56532},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3706":1691,"_31461":1671,"_21806":56534,"_5":15007,"_28616":56481,"_3094":56535},[],"Setting",{"_3706":1692,"_31461":1671,"_21806":56537,"_5":15007,"_28616":56481,"_3094":56538},[],"Evaluation value",{"_3706":1693,"_31461":1671,"_21806":56540,"_5":15007,"_28616":56481,"_3094":56541},[],"Enrollment CA",{"_3706":1694,"_31461":1671,"_21806":56543,"_5":15007,"_28616":56481,"_3094":56544},[],"Issuing root from `device-root.pem`.",{"_3706":1695,"_31461":1671,"_21806":56546,"_5":15007,"_28616":56481,"_3094":54342},[],{"_3706":1696,"_31461":1671,"_21806":56548,"_5":15007,"_28616":56481,"_3094":56549},[],"The 1-hour leaf profile you just prepared.",{"_3706":1697,"_31461":1671,"_21806":56551,"_5":15007,"_28616":56481,"_3094":56552},[],"Protocol / Registration Mode",{"_3706":1698,"_31461":1671,"_21806":56554,"_5":15007,"_28616":56481,"_3094":56555},[],"`EST_RFC7030` / `JITP`.",{"_3706":1699,"_31461":1671,"_21806":56557,"_5":15007,"_28616":56481,"_3094":56558},[],"Verify CSR Signature",{"_3706":1700,"_31461":1671,"_21806":56560,"_5":15007,"_28616":56481,"_3094":56561},[],"Enabled.",{"_3706":1701,"_31461":1671,"_21806":56563,"_5":15007,"_28616":56481,"_3094":56564},[],"Enable Replaceable Enrollment",{"_3706":1702,"_31461":1671,"_21806":56566,"_5":15007,"_28616":56481,"_3094":56567},[],"Disabled; the ID must be new.",{"_3706":1703,"_31461":1671,"_21806":56569,"_5":15007,"_28616":56481,"_3094":56570},[],"Initial authentication",{"_3706":1704,"_31461":1671,"_21806":56572,"_5":15007,"_28616":56481,"_3094":56573},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3706":1705,"_31461":1671,"_21806":56575,"_5":15007,"_28616":56481,"_3094":56576},[],"Renewal authentication",{"_3706":1706,"_31461":1671,"_21806":56578,"_5":15007,"_28616":56481,"_3094":56579},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3706":1707,"_31461":1671,"_21806":56581,"_5":15007,"_28616":56481,"_3094":56582},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3706":1708,"_31461":1671,"_21806":56584,"_5":15007,"_28616":56481,"_3094":56585},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3706":1709,"_31461":1671,"_21806":56587,"_5":15007,"_28616":56481,"_3094":56588},[],"Re-enrollment Delta",{"_3706":1710,"_31461":1671,"_21806":56590,"_5":15007,"_28616":56481,"_3094":56591},[],"1 hour.",{"_3706":1711,"_31461":1671,"_21806":56593,"_5":15007,"_28616":56481,"_3094":56594},[],"Preventive / Critical Delta",{"_3706":1712,"_31461":1671,"_21806":56596,"_5":15007,"_28616":56481,"_3094":56597},[],"30 minutes / 10 minutes.",{"_3706":1713,"_31461":1671,"_21806":56599,"_5":15007,"_28616":56481,"_3094":56600},[],"Revoke on Re-enrollment",{"_3706":1714,"_31461":1671,"_21806":56602,"_5":15007,"_28616":56481,"_3094":56603},[],"Disabled to test the successor before retiring the previous identity.",{"_3706":1715,"_31461":1671,"_21806":56605,"_5":15007,"_28616":56481,"_3094":54350},[],{"_3706":1716,"_31461":1671,"_21806":56607,"_5":15007,"_28616":56481,"_3094":56608},[],"Disabled; the operational key is generated in the client.",{"_3706":1717,"_31461":1671,"_21806":56610,"_5":15007,"_28616":56481,"_3094":56611},[],"CA Distribution",{"_3706":1718,"_31461":1671,"_21806":56613,"_5":15007,"_28616":56481,"_3094":56614},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3706":1719,"_31461":1671,"_21806":56616,"_5":15007,"_28616":56481,"_3094":56617},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3706":1720,"_31461":1671,"_21806":56619,"_5":15007,"_28616":56485,"_3094":56620},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3706":1721,"_31461":1671,"_21806":56622,"_5":15007,"_28616":56485,"_3094":56623},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3706":1722,"_31461":1671,"_21806":56625,"_5":15007,"_28616":56489,"_3094":56626},[],"Generate a new key and CSR with the selected identifier:",{"_3706":1723,"_31461":1671,"_21806":56628,"_5":15007,"_28616":56489,"_3094":56629},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3706":1724,"_31461":1671,"_21806":56631,"_5":15007,"_28616":56489,"_3094":56632},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3706":1725,"_31461":1671,"_21806":56634,"_5":15007,"_28616":56493,"_3094":56635},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3706":1726,"_31461":1671,"_21806":56637,"_5":15007,"_28616":56493,"_3094":56638},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3706":1727,"_31461":1671,"_21806":56640,"_5":15007,"_28616":56497,"_3094":56641},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3706":1728,"_31461":1671,"_21806":56643,"_5":15007,"_28616":56497,"_3094":56644},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3706":1729,"_31461":1671,"_21806":56646,"_5":15007,"_28616":56497,"_3094":56647},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3706":1730,"_31461":1671,"_21806":56649,"_5":15007,"_28616":56497,"_3094":56650},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3706":1731,"_31461":1671,"_21806":56652,"_5":15007,"_28616":56497,"_3094":56653},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3706":1732,"_31461":1671,"_21806":56655,"_5":15007,"_28616":56501,"_3094":56656},[],"Check",{"_3706":1733,"_31461":1671,"_21806":56658,"_5":15007,"_28616":56501,"_3094":56659},[],"Expected result",{"_3706":1734,"_31461":1671,"_21806":56661,"_5":15007,"_28616":56501,"_3094":56662},[],"Registration",{"_3706":1735,"_31461":1671,"_21806":56664,"_5":15007,"_28616":56501,"_3094":56665},[],"ID created automatically and correct DMS.",{"_3706":1736,"_31461":1671,"_21806":56667,"_5":15007,"_28616":56501,"_3094":55923},[],{"_3706":1737,"_31461":1671,"_21806":56669,"_5":15007,"_28616":56501,"_3094":56670},[],"CN, profile, serial and key verified.",{"_3706":1738,"_31461":1671,"_21806":56672,"_5":15007,"_28616":56501,"_3094":56673},[],"Inventory",{"_3706":1739,"_31461":1671,"_21806":56675,"_5":15007,"_28616":56501,"_3094":56676},[],"Received serial visible as the current identity and in history.",{"_3706":1740,"_31461":1671,"_21806":56678,"_5":15007,"_28616":56501,"_3094":56679},[],"Consumer",{"_3706":1741,"_31461":1671,"_21806":56681,"_5":15007,"_28616":56501,"_3094":56682},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3706":1742,"_31461":1671,"_21806":56684,"_5":15007,"_28616":56501,"_3094":56685},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3706":1743,"_31461":1671,"_21806":56687,"_5":15007,"_28616":56501,"_3094":56688},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3706":1744,"_31461":1744,"_5":15367,"_3094":54038,"_31799":56690,"_21806":56691,"_28616":1744},[51312,52850,54022,56467],[],{"_3706":1745,"_31461":1744,"_21806":56693,"_5":15007,"_28616":1744,"_3094":56694},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3706":1746,"_31461":1744,"_5":31796,"_21806":56696,"_28616":56697,"_3094":51322},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3706":1747,"_31461":1744,"_5":31796,"_21806":56699,"_28616":56700,"_3094":56701},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3706":1748,"_31461":1744,"_5":31796,"_21806":56703,"_28616":56704,"_3094":56705},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3706":1749,"_31461":1744,"_5":31796,"_21806":56707,"_28616":56708,"_3094":56709},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3706":1750,"_31461":1744,"_5":31796,"_21806":56711,"_28616":56712,"_3094":56713},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3706":1751,"_31461":1744,"_5":31796,"_21806":56715,"_28616":56716,"_3094":56717},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3706":1752,"_31461":1744,"_5":31796,"_21806":56719,"_28616":56720,"_3094":56659},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3706":1753,"_31461":1744,"_5":31796,"_21806":56722,"_28616":56723,"_3094":56724},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3706":1754,"_31461":1744,"_5":31796,"_21806":56726,"_28616":56727,"_3094":56728},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3706":1755,"_31461":1744,"_21806":56730,"_5":15007,"_28616":1744,"_3094":56731},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3706":1756,"_31461":1744,"_21806":56733,"_5":15007,"_28616":1744,"_3094":56734},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3706":1757,"_31461":1744,"_21806":56736,"_5":15007,"_28616":56697,"_3094":56737},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3706":1758,"_31461":1744,"_21806":56739,"_5":15007,"_28616":56697,"_3094":56740},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3706":1759,"_31461":1744,"_21806":56742,"_5":15007,"_28616":56697,"_3094":56743},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3706":1760,"_31461":1744,"_21806":56745,"_5":15007,"_28616":56697,"_3094":56746},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3706":1761,"_31461":1744,"_21806":56748,"_5":15007,"_28616":56700,"_3094":56749},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3706":1762,"_31461":1744,"_21806":56751,"_5":15007,"_28616":56700,"_3094":56752},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3706":1763,"_31461":1744,"_21806":56754,"_5":15007,"_28616":56700,"_3094":56755},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3706":1764,"_31461":1744,"_21806":56757,"_5":15007,"_28616":56700,"_3094":56758},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3706":1765,"_31461":1744,"_21806":56760,"_5":15007,"_28616":56700,"_3094":56761},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3706":1766,"_31461":1744,"_21806":56763,"_5":15007,"_28616":56700,"_3094":56764},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3706":1767,"_31461":1744,"_21806":56766,"_5":15007,"_28616":56700,"_3094":56767},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3706":1768,"_31461":1744,"_21806":56769,"_5":15007,"_28616":56700,"_3094":56770},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3706":1769,"_31461":1744,"_21806":56772,"_5":15007,"_28616":56704,"_3094":56773},[],"Open **Managed Devices** and the registration action. Complete:",{"_3706":1770,"_31461":1744,"_21806":56775,"_5":15007,"_28616":56704,"_3094":56776},[],"**Device ID**: `device-001`.",{"_3706":1771,"_31461":1744,"_21806":56778,"_5":15007,"_28616":56704,"_3094":56779},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3706":1772,"_31461":1744,"_21806":56781,"_5":15007,"_28616":56704,"_3094":56782},[],"**Icon** and **Tags**: optional classification.",{"_3706":1773,"_31461":1744,"_21806":56784,"_5":15007,"_28616":56704,"_3094":56785},[],"Confirm registration.",{"_3706":1774,"_31461":1744,"_21806":56787,"_5":15007,"_28616":56708,"_3094":56788},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3706":1775,"_31461":1744,"_21806":56790,"_5":15007,"_28616":56708,"_3094":56791},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3706":1776,"_31461":1744,"_21806":56793,"_5":15007,"_28616":56712,"_3094":56794},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3706":1777,"_31461":1744,"_21806":56796,"_5":15007,"_28616":56712,"_3094":56797},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3706":1778,"_31461":1744,"_21806":56799,"_5":15007,"_28616":56716,"_3094":56800},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3706":1779,"_31461":1744,"_21806":56802,"_5":15007,"_28616":56716,"_3094":56803},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3706":1780,"_31461":1744,"_21806":56805,"_5":15007,"_28616":56720,"_3094":56656},[],{"_3706":1781,"_31461":1744,"_21806":56807,"_5":15007,"_28616":56720,"_3094":56808},[],"Result",{"_3706":1782,"_31461":1744,"_21806":56810,"_5":15007,"_28616":56720,"_3094":55906},[],{"_3706":1783,"_31461":1744,"_21806":56812,"_5":15007,"_28616":56720,"_3094":56813},[],"`device-001` appears in inventory with the expected DMS.",{"_3706":1784,"_31461":1744,"_21806":56815,"_5":15007,"_28616":56720,"_3094":56816},[],"Current identity",{"_3706":1785,"_31461":1744,"_21806":56818,"_5":15007,"_28616":56720,"_3094":56819},[],"The associated certificate matches the one you verified in PKI.",{"_3706":1786,"_31461":1744,"_21806":56821,"_5":15007,"_28616":56720,"_3094":56822},[],"History",{"_3706":1787,"_31461":1744,"_21806":56824,"_5":15007,"_28616":56720,"_3094":56825},[],"The associated issuance appears with its serial number and dates.",{"_3706":1788,"_31461":1744,"_21806":56827,"_5":15007,"_28616":56720,"_3094":56828},[],"Key and certificate",{"_3706":1789,"_31461":1744,"_21806":56830,"_5":15007,"_28616":56720,"_3094":56831},[],"You have the verified pair ready to install on the device.",{"_3706":1790,"_31461":1744,"_21806":56833,"_5":15007,"_28616":56723,"_3094":56834},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3706":1791,"_31461":1744,"_21806":56836,"_5":15007,"_28616":56723,"_3094":56837},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3706":1792,"_31461":1744,"_21806":56839,"_5":15007,"_28616":56723,"_3094":56840},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3706":1793,"_31461":1744,"_21806":56842,"_5":15007,"_28616":56723,"_3094":56843},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3706":1794,"_31461":1744,"_21806":56845,"_5":15007,"_28616":56727,"_3094":56846},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3706":1795,"_31461":1744,"_21806":56848,"_5":15007,"_28616":56727,"_3094":56849},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3706":1796,"_31461":1744,"_21806":56851,"_5":15007,"_28616":56727,"_3094":56852},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3706":1797,"_31461":1797,"_5":15367,"_3094":56854,"_31799":56855,"_21806":56856,"_28616":1797},"Lamassu IoT Platform",[51312,52850],[],{"_3706":1798,"_31461":1797,"_21806":56858,"_5":15007,"_28616":1797,"_3094":56859},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3706":1799,"_31461":1797,"_5":31796,"_21806":56861,"_28616":56862,"_3094":56342},[],"/docs/platform/overview#start-here",{"_3706":1800,"_31461":1797,"_5":31796,"_21806":56864,"_28616":56865,"_3094":56866},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3706":1801,"_31461":1797,"_5":31796,"_21806":56868,"_28616":56869,"_3094":56870},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3706":1802,"_31461":1797,"_5":31796,"_21806":56872,"_28616":56873,"_3094":56874},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3706":1803,"_31461":1797,"_5":31796,"_21806":56876,"_28616":56877,"_3094":56878},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3706":1804,"_31461":1797,"_5":31796,"_21806":56880,"_28616":56881,"_3094":56882},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3706":1805,"_31461":1797,"_5":31796,"_21806":56884,"_28616":56885,"_3094":56886},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3706":1806,"_31461":1797,"_5":31796,"_21806":56888,"_28616":56889,"_3094":56890},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3706":1807,"_31461":1797,"_5":31796,"_21806":56892,"_28616":56893,"_3094":56894},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3706":1808,"_31461":1797,"_5":31796,"_21806":56896,"_28616":56897,"_3094":56898},[],"/docs/platform/overview#react-to-events","React to events",{"_3706":1809,"_31461":1797,"_5":31796,"_21806":56900,"_28616":56901,"_3094":56902},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3706":1810,"_31461":1797,"_21806":56904,"_5":15007,"_28616":1797,"_3094":56905},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3706":1811,"_31461":1797,"_21806":56907,"_5":15007,"_28616":56862,"_3094":56908},[],"Choose the result you need:",{"_3706":1812,"_31461":1797,"_21806":56910,"_5":15007,"_28616":56862,"_3094":56911},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3706":1813,"_31461":1797,"_21806":56913,"_5":15007,"_28616":56862,"_3094":56914},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3706":1814,"_31461":1797,"_21806":56916,"_5":15007,"_28616":56862,"_3094":56917},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3706":1815,"_31461":1797,"_21806":56919,"_5":15007,"_28616":56865,"_3094":56920},[],"Section",{"_3706":1816,"_31461":1797,"_21806":56922,"_5":15007,"_28616":56865,"_3094":56923},[],"What you manage",{"_3706":1817,"_31461":1797,"_21806":56925,"_5":15007,"_28616":56865,"_3094":56926},[],"Entry point",{"_3706":1818,"_31461":1797,"_21806":56928,"_5":15007,"_28616":56865,"_3094":56929},[],"**PKI**",{"_3706":1819,"_31461":1797,"_21806":56931,"_5":15007,"_28616":56865,"_3094":56932},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3706":1820,"_31461":1797,"_21806":56934,"_5":15007,"_28616":56865,"_3094":56935},[],"PKI overview",{"_3706":1821,"_31461":1797,"_21806":56937,"_5":15007,"_28616":56865,"_3094":56938},[],"**IoT Fleets**",{"_3706":1822,"_31461":1797,"_21806":56940,"_5":15007,"_28616":56865,"_3094":56941},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3706":1823,"_31461":1797,"_21806":56943,"_5":15007,"_28616":56865,"_3094":56944},[],"IoT Fleets overview",{"_3706":1824,"_31461":1797,"_21806":56946,"_5":15007,"_28616":56865,"_3094":56947},[],"**Administration**",{"_3706":1825,"_31461":1797,"_21806":56949,"_5":15007,"_28616":56865,"_3094":56950},[],"Operator permissions, audit and event subscriptions.",{"_3706":1826,"_31461":1797,"_21806":56952,"_5":15007,"_28616":56865,"_3094":52852},[],{"_3706":1827,"_31461":1797,"_21806":56954,"_5":15007,"_28616":56865,"_3094":56955},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3706":1828,"_31461":1797,"_21806":56957,"_5":15007,"_28616":56869,"_3094":56958},[],"An identity's journey connects four responsibilities:",{"_3706":1829,"_31461":1797,"_21806":56960,"_5":15007,"_28616":56869,"_3094":56961},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3706":1830,"_31461":1797,"_21806":56963,"_5":15007,"_28616":56869,"_3094":56964},[],"The provisioning administrator configures the DMS and initial trust.",{"_3706":1831,"_31461":1797,"_21806":56966,"_5":15007,"_28616":56869,"_3094":56967},[],"The device client requests a certificate and installs it with the matching key.",{"_3706":1832,"_31461":1797,"_21806":56969,"_5":15007,"_28616":56869,"_3094":56970},[],"The consumer validates the identity and applies its access permissions.",{"_3706":1833,"_31461":1797,"_21806":56972,"_5":15007,"_28616":56869,"_3094":56973},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3706":1834,"_31461":1797,"_21806":56975,"_5":15007,"_28616":56877,"_3094":56976},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3706":1835,"_31461":1797,"_21806":56978,"_5":15007,"_28616":56881,"_3094":56979},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3706":1836,"_31461":1797,"_21806":56981,"_5":15007,"_28616":56885,"_3094":56982},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3706":1837,"_31461":1797,"_21806":56984,"_5":15007,"_28616":56889,"_3094":56985},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3706":1838,"_31461":1797,"_21806":56987,"_5":15007,"_28616":56893,"_3094":56988},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3706":1839,"_31461":1797,"_21806":56990,"_5":15007,"_28616":56897,"_3094":56991},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3706":1840,"_31461":1797,"_21806":56993,"_5":15007,"_28616":56901,"_3094":56436},[],{"_3706":1841,"_31461":1797,"_21806":56995,"_5":15007,"_28616":56901,"_3094":56996},[],"What it prepares or checks",{"_3706":1842,"_31461":1797,"_21806":56998,"_5":15007,"_28616":56901,"_3094":56439},[],{"_3706":1843,"_31461":1797,"_21806":57000,"_5":15007,"_28616":56901,"_3094":57001},[],"Key custody, CA hierarchy, profiles and validation.",{"_3706":1844,"_31461":1797,"_21806":57003,"_5":15007,"_28616":56901,"_3094":57004},[],"Fleet administrator",{"_3706":1845,"_31461":1797,"_21806":57006,"_5":15007,"_28616":56901,"_3094":57007},[],"DMS, device admission, renewal policy and inventory.",{"_3706":1846,"_31461":1797,"_21806":57009,"_5":15007,"_28616":56901,"_3094":56451},[],{"_3706":1847,"_31461":1797,"_21806":57011,"_5":15007,"_28616":56901,"_3094":57012},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3706":1848,"_31461":1797,"_21806":57014,"_5":15007,"_28616":56901,"_3094":56457},[],{"_3706":1849,"_31461":1797,"_21806":57016,"_5":15007,"_28616":56901,"_3094":57017},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3706":1850,"_31461":1797,"_21806":57019,"_5":15007,"_28616":56901,"_3094":57020},[],"Infrastructure operator",{"_3706":1851,"_31461":1797,"_21806":57022,"_5":15007,"_28616":56901,"_3094":57023},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3706":1852,"_31461":1797,"_21806":57025,"_5":15007,"_28616":56901,"_3094":57026},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3706":1853,"_31461":1853,"_5":15367,"_3094":57028,"_31799":57029,"_21806":57032,"_28616":1853},"CA hierarchy and rotation",[51312,52850,57030,57031],"PKI","Keys, authorities and certificates",[],{"_3706":1854,"_31461":1853,"_21806":57034,"_5":15007,"_28616":1853,"_3094":57035},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3706":1855,"_31461":1853,"_5":31796,"_21806":57037,"_28616":57038,"_3094":57039},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3706":1856,"_31461":1853,"_5":31796,"_21806":57041,"_28616":57042,"_3094":57043},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3706":1857,"_31461":1853,"_5":31796,"_21806":57045,"_28616":57046,"_3094":57047},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3706":1858,"_31461":1853,"_5":31796,"_21806":57049,"_28616":57050,"_3094":57051},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3706":1859,"_31461":1853,"_5":31796,"_21806":57053,"_28616":57054,"_3094":57055},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3706":1860,"_31461":1853,"_5":31796,"_21806":57057,"_28616":57058,"_3094":57059},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3706":1861,"_31461":1853,"_5":31796,"_21806":57061,"_28616":57062,"_3094":57063},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3706":1862,"_31461":1853,"_5":31796,"_21806":57065,"_28616":57066,"_3094":57067},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3706":1863,"_31461":1853,"_5":31796,"_21806":57069,"_28616":57070,"_3094":57071},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3706":1864,"_31461":1853,"_5":31796,"_21806":57073,"_28616":57074,"_3094":57075},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3706":1865,"_31461":1853,"_5":31796,"_21806":57077,"_28616":57078,"_3094":57079},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3706":1866,"_31461":1853,"_5":31796,"_21806":57081,"_28616":57082,"_3094":57083},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3706":1867,"_31461":1853,"_21806":57085,"_5":15007,"_28616":1853,"_3094":57086},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3706":1868,"_31461":1853,"_21806":57088,"_5":15007,"_28616":1853,"_3094":57089},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3706":1869,"_31461":1853,"_21806":57091,"_5":15007,"_28616":57038,"_3094":57092},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3706":1870,"_31461":1853,"_21806":57094,"_5":15007,"_28616":57038,"_3094":57095},[],"environment, such as production and preproduction;",{"_3706":1871,"_31461":1853,"_21806":57097,"_5":15007,"_28616":57038,"_3094":57098},[],"owner or operating team;",{"_3706":1872,"_31461":1853,"_21806":57100,"_5":15007,"_28616":57038,"_3094":57101},[],"device family or manufacturing process;",{"_3706":1873,"_31461":1853,"_21806":57103,"_5":15007,"_28616":57038,"_3094":57104},[],"region or regulatory requirement;",{"_3706":1874,"_31461":1853,"_21806":57106,"_5":15007,"_28616":57038,"_3094":57107},[],"cryptographic engine or key policy;",{"_3706":1875,"_31461":1853,"_21806":57109,"_5":15007,"_28616":57038,"_3094":57110},[],"maintenance window and renewal cadence.",{"_3706":1876,"_31461":1853,"_21806":57112,"_5":15007,"_28616":57038,"_3094":57113},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3706":1877,"_31461":1853,"_21806":57115,"_5":15007,"_28616":57038,"_3094":57116},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3706":1878,"_31461":1853,"_21806":57118,"_5":15007,"_28616":57042,"_3094":57119},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3706":1879,"_31461":1853,"_21806":57121,"_5":15007,"_28616":57042,"_3094":57122},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3706":1880,"_31461":1853,"_21806":57124,"_5":15007,"_28616":57042,"_3094":57125},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3706":1881,"_31461":1853,"_21806":57127,"_5":15007,"_28616":57042,"_3094":57128},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3706":1882,"_31461":1853,"_21806":57130,"_5":15007,"_28616":57046,"_3094":57131},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3706":1883,"_31461":1853,"_21806":57133,"_5":15007,"_28616":57046,"_3094":57134},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3706":1884,"_31461":1853,"_21806":57136,"_5":15007,"_28616":57046,"_3094":57137},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3706":1885,"_31461":1853,"_21806":57139,"_5":15007,"_28616":57046,"_3094":57140},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3706":1886,"_31461":1853,"_21806":57142,"_5":15007,"_28616":57054,"_3094":57143},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3706":1887,"_31461":1853,"_21806":57145,"_5":15007,"_28616":57058,"_3094":57146},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3706":1888,"_31461":1853,"_21806":57148,"_5":15007,"_28616":57062,"_3094":57149},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3706":1889,"_31461":1853,"_21806":57151,"_5":15007,"_28616":57066,"_3094":57152},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3706":1890,"_31461":1853,"_21806":57154,"_5":15007,"_28616":57070,"_3094":57155},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3706":1891,"_31461":1853,"_21806":57157,"_5":15007,"_28616":57074,"_3094":57158},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3706":1892,"_31461":1853,"_21806":57160,"_5":15007,"_28616":57078,"_3094":57161},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3706":1893,"_31461":1853,"_21806":57163,"_5":15007,"_28616":57078,"_3094":57164},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3706":1894,"_31461":1853,"_21806":57166,"_5":15007,"_28616":57078,"_3094":57167},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3706":1895,"_31461":1853,"_21806":57169,"_5":15007,"_28616":57078,"_3094":57170},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3706":1896,"_31461":1853,"_21806":57172,"_5":15007,"_28616":57082,"_3094":57173},[],"The new chain ends in an anchor installed by the consumer.",{"_3706":1897,"_31461":1853,"_21806":57175,"_5":15007,"_28616":57082,"_3094":57176},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3706":1898,"_31461":1853,"_21806":57178,"_5":15007,"_28616":57082,"_3094":57179},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3706":1899,"_31461":1853,"_21806":57181,"_5":15007,"_28616":57082,"_3094":57182},[],"Re-enrollment accepts the old identity during the planned period.",{"_3706":1900,"_31461":1853,"_21806":57184,"_5":15007,"_28616":57082,"_3094":57185},[],"OCSP and CRL respond for the authorities that remain active.",{"_3706":1901,"_31461":1853,"_21806":57187,"_5":15007,"_28616":57082,"_3094":57188},[],"No DMS is left accidentally issuing from the old CA.",{"_3706":1902,"_31461":1853,"_21806":57190,"_5":15007,"_28616":57082,"_3094":57191},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3706":1903,"_31461":1903,"_5":15367,"_3094":57193,"_31799":57194,"_21806":57195,"_28616":1903},"Certification authorities",[51312,52850,57030,57031],[],{"_3706":1904,"_31461":1903,"_21806":57197,"_5":15007,"_28616":1903,"_3094":57198},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3706":1905,"_31461":1903,"_5":31796,"_21806":57200,"_28616":57201,"_3094":57202},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3706":1906,"_31461":1903,"_5":31796,"_21806":57204,"_28616":57205,"_3094":57206},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3706":1907,"_31461":1903,"_5":31796,"_21806":57208,"_28616":57209,"_3094":51322},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3706":1908,"_31461":1903,"_5":31796,"_21806":57211,"_28616":57212,"_3094":57213},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3706":1909,"_31461":1903,"_5":31796,"_21806":57215,"_28616":57216,"_3094":57217},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3706":1910,"_31461":1903,"_5":31796,"_21806":57219,"_28616":57220,"_3094":57221},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3706":1911,"_31461":1903,"_5":31796,"_21806":57223,"_28616":57224,"_3094":57225},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3706":1912,"_31461":1903,"_5":31796,"_21806":57227,"_28616":57228,"_3094":57229},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3706":1913,"_31461":1903,"_5":31796,"_21806":57231,"_28616":57232,"_3094":57233},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3706":1914,"_31461":1903,"_5":31796,"_21806":57235,"_28616":57236,"_3094":57237},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3706":1915,"_31461":1903,"_5":31796,"_21806":57239,"_28616":57240,"_3094":57241},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3706":1916,"_31461":1903,"_5":31796,"_21806":57243,"_28616":57244,"_3094":57245},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3706":1917,"_31461":1903,"_5":31796,"_21806":57247,"_28616":57248,"_3094":57249},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3706":1918,"_31461":1903,"_5":31796,"_21806":57251,"_28616":57252,"_3094":57253},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3706":1919,"_31461":1903,"_5":31796,"_21806":57255,"_28616":57256,"_3094":57257},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3706":1920,"_31461":1903,"_5":31796,"_21806":57259,"_28616":57260,"_3094":57261},[],"/docs/platform/pki/certificate-authorities#ca-states","CA states",{"_3706":1921,"_31461":1903,"_5":31796,"_21806":57263,"_28616":57264,"_3094":57265},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3706":1922,"_31461":1903,"_5":31796,"_21806":57267,"_28616":57268,"_3094":57269},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3706":1923,"_31461":1903,"_5":31796,"_21806":57271,"_28616":57272,"_3094":57273},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3706":1924,"_31461":1903,"_5":31796,"_21806":57275,"_28616":57276,"_3094":57277},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3706":1925,"_31461":1903,"_5":31796,"_21806":57279,"_28616":57280,"_3094":57281},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3706":1926,"_31461":1903,"_5":31796,"_21806":57283,"_28616":57284,"_3094":57285},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3706":1927,"_31461":1903,"_5":31796,"_21806":57287,"_28616":57288,"_3094":57289},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3706":1928,"_31461":1903,"_5":31796,"_21806":57291,"_28616":57292,"_3094":57293},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3706":1929,"_31461":1903,"_21806":57295,"_5":15007,"_28616":1903,"_3094":57296},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3706":1930,"_31461":1903,"_21806":57298,"_5":15007,"_28616":1903,"_3094":57299},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3706":1931,"_31461":1903,"_21806":57301,"_5":15007,"_28616":1903,"_3094":57302},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3706":1932,"_31461":1903,"_21806":57304,"_5":15007,"_28616":57201,"_3094":57305},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3706":1933,"_31461":1903,"_21806":57307,"_5":15007,"_28616":57201,"_3094":57308},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3706":1934,"_31461":1903,"_21806":57310,"_5":15007,"_28616":57201,"_3094":57311},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3706":1935,"_31461":1903,"_21806":57313,"_5":15007,"_28616":57201,"_3094":57314},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3706":1936,"_31461":1903,"_21806":57316,"_5":15007,"_28616":57201,"_3094":57317},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3706":1937,"_31461":1903,"_21806":57319,"_5":15007,"_28616":57209,"_3094":57320},[],"Decide whether the CA will be a root or an intermediate.",{"_3706":1938,"_31461":1903,"_21806":57322,"_5":15007,"_28616":57209,"_3094":57323},[],"Choose the engine that will keep the key.",{"_3706":1939,"_31461":1903,"_21806":57325,"_5":15007,"_28616":57209,"_3094":57326},[],"Define a validity longer than that of the certificates it will issue.",{"_3706":1940,"_31461":1903,"_21806":57328,"_5":15007,"_28616":57209,"_3094":57329},[],"For an intermediate CA, make sure the parent CA is active.",{"_3706":1941,"_31461":1903,"_21806":57331,"_5":15007,"_28616":57212,"_3094":57332},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3706":1942,"_31461":1903,"_21806":57334,"_5":15007,"_28616":57216,"_3094":57335},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3706":1943,"_31461":1903,"_21806":57337,"_5":15007,"_28616":57216,"_3094":57338},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3706":1944,"_31461":1903,"_21806":57340,"_5":15007,"_28616":57220,"_3094":57341},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3706":1945,"_31461":1903,"_21806":57343,"_5":15007,"_28616":57224,"_3094":57344},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3706":1946,"_31461":1903,"_21806":57346,"_5":15007,"_28616":57224,"_3094":57347},[],"`C`: two-letter ISO 3166-1 country code.",{"_3706":1947,"_31461":1903,"_21806":57349,"_5":15007,"_28616":57224,"_3094":57350},[],"`ST`: state or province.",{"_3706":1948,"_31461":1903,"_21806":57352,"_5":15007,"_28616":57224,"_3094":57353},[],"`L`: locality.",{"_3706":1949,"_31461":1903,"_21806":57355,"_5":15007,"_28616":57224,"_3094":57356},[],"`O`: organization.",{"_3706":1950,"_31461":1903,"_21806":57358,"_5":15007,"_28616":57224,"_3094":57359},[],"`OU`: organizational unit.",{"_3706":1951,"_31461":1903,"_21806":57361,"_5":15007,"_28616":57224,"_3094":57362},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3706":1952,"_31461":1903,"_21806":57364,"_5":15007,"_28616":57228,"_3094":57365},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3706":1953,"_31461":1903,"_21806":57367,"_5":15007,"_28616":57228,"_3094":57368},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3706":1954,"_31461":1903,"_21806":57370,"_5":15007,"_28616":57232,"_3094":57371},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3706":1955,"_31461":1903,"_21806":57373,"_5":15007,"_28616":57232,"_3094":57374},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3706":1956,"_31461":1903,"_21806":57376,"_5":15007,"_28616":57236,"_3094":57377},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3706":1957,"_31461":1903,"_21806":57379,"_5":15007,"_28616":57236,"_3094":57380},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3706":1958,"_31461":1903,"_21806":57382,"_5":15007,"_28616":57240,"_3094":57383},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3706":1959,"_31461":1903,"_21806":57385,"_5":15007,"_28616":57240,"_3094":57386},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3706":1960,"_31461":1903,"_21806":57388,"_5":15007,"_28616":57240,"_3094":57389},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3706":1961,"_31461":1903,"_21806":57391,"_5":15007,"_28616":57240,"_3094":57392},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3706":1962,"_31461":1903,"_21806":57394,"_5":15007,"_28616":57244,"_3094":57395},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3706":1963,"_31461":1903,"_21806":57397,"_5":15007,"_28616":57248,"_3094":57398},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3706":1964,"_31461":1903,"_21806":57400,"_5":15007,"_28616":57248,"_3094":57401},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3706":1965,"_31461":1903,"_21806":57403,"_5":15007,"_28616":57252,"_3094":57404},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3706":1966,"_31461":1903,"_21806":57406,"_5":15007,"_28616":57256,"_3094":57407},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3706":1967,"_31461":1903,"_21806":57409,"_5":15007,"_28616":57256,"_3094":57410},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3706":1968,"_31461":1903,"_21806":57412,"_5":15007,"_28616":57256,"_3094":57413},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3706":1969,"_31461":1903,"_21806":57415,"_5":15007,"_28616":57260,"_3094":57416},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3706":1970,"_31461":1903,"_21806":57418,"_5":15007,"_28616":57260,"_3094":57419},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3706":1971,"_31461":1903,"_21806":57421,"_5":15007,"_28616":57260,"_3094":57422},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3706":1972,"_31461":1903,"_21806":57424,"_5":15007,"_28616":57260,"_3094":57425},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3706":1973,"_31461":1903,"_21806":57427,"_5":15007,"_28616":57264,"_3094":57428},[],"Open a CA from the inventory to review:",{"_3706":1974,"_31461":1903,"_21806":57430,"_5":15007,"_28616":57264,"_3094":57431},[],"Status and validity period.",{"_3706":1975,"_31461":1903,"_21806":57433,"_5":15007,"_28616":57264,"_3094":57434},[],"Certificate and chain in PEM format.",{"_3706":1976,"_31461":1903,"_21806":57436,"_5":15007,"_28616":57264,"_3094":57437},[],"Number of active, expired and revoked certificates.",{"_3706":1977,"_31461":1903,"_21806":57439,"_5":15007,"_28616":57264,"_3094":57440},[],"Certificates issued in **Issued Certificates**.",{"_3706":1978,"_31461":1903,"_21806":57442,"_5":15007,"_28616":57264,"_3094":57443},[],"The CRL linked to the authority.",{"_3706":1979,"_31461":1903,"_21806":57445,"_5":15007,"_28616":57264,"_3094":57446},[],"Metadata and the associated cryptographic engine.",{"_3706":1980,"_31461":1903,"_21806":57448,"_5":15007,"_28616":57264,"_3094":57449},[],"You can filter the inventory by name, status and CA type.",{"_3706":1981,"_31461":1903,"_21806":57451,"_5":15007,"_28616":57268,"_3094":57452},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3706":1982,"_31461":1903,"_21806":57454,"_5":15007,"_28616":57268,"_3094":57455},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3706":1983,"_31461":1903,"_21806":57457,"_5":15007,"_28616":57268,"_3094":57458},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3706":1984,"_31461":1903,"_21806":57460,"_5":15007,"_28616":57268,"_3094":57461},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3706":1985,"_31461":1903,"_21806":57463,"_5":15007,"_28616":57268,"_3094":57464},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3706":1986,"_31461":1903,"_21806":57466,"_5":15007,"_28616":57268,"_3094":57467},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3706":1987,"_31461":1903,"_21806":57469,"_5":15007,"_28616":57272,"_3094":57470},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3706":1988,"_31461":1903,"_21806":57472,"_5":15007,"_28616":57276,"_3094":57473},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3706":1989,"_31461":1903,"_21806":57475,"_5":15007,"_28616":57280,"_3094":57476},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3706":1990,"_31461":1903,"_21806":57478,"_5":15007,"_28616":57284,"_3094":57479},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3706":1991,"_31461":1903,"_21806":57481,"_5":15007,"_28616":57288,"_3094":57482},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3706":1992,"_31461":1903,"_21806":57484,"_5":15007,"_28616":57292,"_3094":57485},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3706":1993,"_31461":1903,"_21806":57487,"_5":15007,"_28616":57292,"_3094":57488},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3706":1994,"_31461":1903,"_21806":57490,"_5":15007,"_28616":57292,"_3094":57491},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3706":1995,"_31461":1903,"_21806":57493,"_5":15007,"_28616":57292,"_3094":57494},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3706":1996,"_31461":1903,"_21806":57496,"_5":15007,"_28616":57292,"_3094":57497},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3706":1997,"_31461":1997,"_5":15367,"_3094":57499,"_31799":57500,"_21806":57501,"_28616":1997},"Certificate profiles",[51312,52850,57030,57031],[],{"_3706":1998,"_31461":1997,"_21806":57503,"_5":15007,"_28616":1997,"_3094":57504},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3706":1999,"_31461":1997,"_5":31796,"_21806":57506,"_28616":57507,"_3094":57508},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3706":2000,"_31461":1997,"_5":31796,"_21806":57510,"_28616":57511,"_3094":57512},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3706":2001,"_31461":1997,"_5":31796,"_21806":57514,"_28616":57515,"_3094":57516},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3706":2002,"_31461":1997,"_5":31796,"_21806":57518,"_28616":57519,"_3094":57520},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3706":2003,"_31461":1997,"_5":31796,"_21806":57522,"_28616":57523,"_3094":57524},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3706":2004,"_31461":1997,"_5":31796,"_21806":57526,"_28616":57527,"_3094":57528},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3706":2005,"_31461":1997,"_5":31796,"_21806":57530,"_28616":57531,"_3094":57532},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3706":2006,"_31461":1997,"_5":31796,"_21806":57534,"_28616":57535,"_3094":57536},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3706":2007,"_31461":1997,"_5":31796,"_21806":57538,"_28616":57539,"_3094":57540},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3706":2008,"_31461":1997,"_5":31796,"_21806":57542,"_28616":57543,"_3094":57544},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3706":2009,"_31461":1997,"_5":31796,"_21806":57546,"_28616":57547,"_3094":57548},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3706":2010,"_31461":1997,"_5":31796,"_21806":57550,"_28616":57551,"_3094":57552},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3706":2011,"_31461":1997,"_5":31796,"_21806":57554,"_28616":57555,"_3094":57556},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3706":2012,"_31461":1997,"_5":31796,"_21806":57558,"_28616":57559,"_3094":57560},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3706":2013,"_31461":1997,"_5":31796,"_21806":57562,"_28616":57563,"_3094":57564},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3706":2014,"_31461":1997,"_5":31796,"_21806":57566,"_28616":57567,"_3094":57568},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3706":2015,"_31461":1997,"_21806":57570,"_5":15007,"_28616":1997,"_3094":57571},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3706":2016,"_31461":1997,"_21806":57573,"_5":15007,"_28616":1997,"_3094":57574},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3706":2017,"_31461":1997,"_21806":57576,"_5":15007,"_28616":57511,"_3094":57577},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3706":2018,"_31461":1997,"_21806":57579,"_5":15007,"_28616":57511,"_3094":57580},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3706":2019,"_31461":1997,"_21806":57582,"_5":15007,"_28616":57515,"_3094":57583},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3706":2020,"_31461":1997,"_21806":57585,"_5":15007,"_28616":57519,"_3094":57586},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3706":2021,"_31461":1997,"_21806":57588,"_5":15007,"_28616":57519,"_3094":57589},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3706":2022,"_31461":1997,"_21806":57591,"_5":15007,"_28616":57519,"_3094":57592},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3706":2023,"_31461":1997,"_21806":57594,"_5":15007,"_28616":57523,"_3094":57595},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3706":2024,"_31461":1997,"_21806":57597,"_5":15007,"_28616":57527,"_3094":57598},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3706":2025,"_31461":1997,"_21806":57600,"_5":15007,"_28616":57527,"_3094":57601},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3706":2026,"_31461":1997,"_21806":57603,"_5":15007,"_28616":57531,"_3094":57604},[],"The cryptographic enforcement can:",{"_3706":2027,"_31461":1997,"_21806":57606,"_5":15007,"_28616":57531,"_3094":57607},[],"allow or block RSA keys;",{"_3706":2028,"_31461":1997,"_21806":57609,"_5":15007,"_28616":57531,"_3094":57610},[],"limit the supported RSA sizes;",{"_3706":2029,"_31461":1997,"_21806":57612,"_5":15007,"_28616":57531,"_3094":57613},[],"allow or block ECDSA keys;",{"_3706":2030,"_31461":1997,"_21806":57615,"_5":15007,"_28616":57531,"_3094":57616},[],"limit the supported ECDSA sizes or curves.",{"_3706":2031,"_31461":1997,"_21806":57618,"_5":15007,"_28616":57531,"_3094":57619},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3706":2032,"_31461":1997,"_21806":57621,"_5":15007,"_28616":57535,"_3094":57622},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3706":2033,"_31461":1997,"_21806":57624,"_5":15007,"_28616":57535,"_3094":54793},[],{"_3706":2034,"_31461":1997,"_21806":57626,"_5":15007,"_28616":57535,"_3094":57627},[],"First choice",{"_3706":2035,"_31461":1997,"_21806":57629,"_5":15007,"_28616":57535,"_3094":57630},[],"Second choice",{"_3706":2036,"_31461":1997,"_21806":57632,"_5":15007,"_28616":57535,"_3094":57633},[],"If neither is supplied",{"_3706":2037,"_31461":1997,"_21806":57635,"_5":15007,"_28616":57535,"_3094":57636},[],"Direct signing with a CA",{"_3706":2038,"_31461":1997,"_21806":57638,"_5":15007,"_28616":57535,"_3094":57639},[],"`issuance_profile` embedded in the request",{"_3706":2039,"_31461":1997,"_21806":57641,"_5":15007,"_28616":57535,"_3094":57642},[],"Request `issuance_profile_id`",{"_3706":2040,"_31461":1997,"_21806":57644,"_5":15007,"_28616":57535,"_3094":57645},[],"CA default profile (`profile_id`).",{"_3706":2041,"_31461":1997,"_21806":57647,"_5":15007,"_28616":57535,"_3094":57648},[],"Issuance through a DMS",{"_3706":2042,"_31461":1997,"_21806":57650,"_5":15007,"_28616":57535,"_3094":57651},[],"`settings.issuance_profile_id`",{"_3706":2043,"_31461":1997,"_21806":57653,"_5":15007,"_28616":57535,"_3094":57654},[],"`settings.issuance_profile` embedded in the DMS",{"_3706":2044,"_31461":1997,"_21806":57656,"_5":15007,"_28616":57535,"_3094":57657},[],"Enrollment CA default profile.",{"_3706":2045,"_31461":1997,"_21806":57659,"_5":15007,"_28616":57535,"_3094":57660},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3706":2046,"_31461":1997,"_21806":57662,"_5":15007,"_28616":57535,"_3094":57663},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3706":2047,"_31461":1997,"_21806":57665,"_5":15007,"_28616":57543,"_3094":57666},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3706":2048,"_31461":1997,"_21806":57668,"_5":15007,"_28616":57547,"_3094":57669},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3706":2049,"_31461":1997,"_21806":57671,"_5":15007,"_28616":57551,"_3094":57672},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3706":2050,"_31461":1997,"_21806":57674,"_5":15007,"_28616":57555,"_3094":57675},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3706":2051,"_31461":1997,"_21806":57677,"_5":15007,"_28616":57559,"_3094":57678},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3706":2052,"_31461":1997,"_21806":57680,"_5":15007,"_28616":57559,"_3094":57681},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3706":2053,"_31461":1997,"_21806":57683,"_5":15007,"_28616":57563,"_3094":57684},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3706":2054,"_31461":1997,"_21806":57686,"_5":15007,"_28616":57563,"_3094":57687},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3706":2055,"_31461":1997,"_21806":57689,"_5":15007,"_28616":57563,"_3094":57690},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3706":2056,"_31461":1997,"_21806":57692,"_5":15007,"_28616":57563,"_3094":57693},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3706":2057,"_31461":1997,"_21806":57695,"_5":15007,"_28616":57567,"_3094":57696},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3706":2058,"_31461":1997,"_21806":57698,"_5":15007,"_28616":57567,"_3094":57699},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3706":2059,"_31461":2059,"_5":15367,"_3094":57701,"_31799":57702,"_21806":57704,"_28616":2059},"Certificate validation",[51312,52850,57030,57703],"Validation",[],{"_3706":2060,"_31461":2059,"_21806":57706,"_5":15007,"_28616":2059,"_3094":57707},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3706":2061,"_31461":2059,"_5":31796,"_21806":57709,"_28616":57710,"_3094":57711},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3706":2062,"_31461":2059,"_5":31796,"_21806":57713,"_28616":57714,"_3094":57715},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3706":2063,"_31461":2059,"_5":31796,"_21806":57717,"_28616":57718,"_3094":57719},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3706":2064,"_31461":2059,"_21806":57721,"_5":15007,"_28616":2059,"_3094":57722},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3706":2065,"_31461":2059,"_21806":57724,"_5":15007,"_28616":57710,"_3094":57725},[],"Verify these criteria together:",{"_3706":2066,"_31461":2059,"_21806":57727,"_5":15007,"_28616":57710,"_3094":56656},[],{"_3706":2067,"_31461":2059,"_21806":57729,"_5":15007,"_28616":57710,"_3094":57730},[],"Required result",{"_3706":2068,"_31461":2059,"_21806":57732,"_5":15007,"_28616":57710,"_3094":57733},[],"Chain and signature",{"_3706":2069,"_31461":2059,"_21806":57735,"_5":15007,"_28616":57710,"_3094":57736},[],"Valid chain to a root deliberately installed in the consumer.",{"_3706":2070,"_31461":2059,"_21806":57738,"_5":15007,"_28616":57710,"_3094":57739},[],"Dates",{"_3706":2071,"_31461":2059,"_21806":57741,"_5":15007,"_28616":57710,"_3094":57742},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3706":2072,"_31461":2059,"_21806":57744,"_5":15007,"_28616":57710,"_3094":52519},[],{"_3706":2073,"_31461":2059,"_21806":57746,"_5":15007,"_28616":57710,"_3094":57747},[],"Name, SAN or identifier matches the expected peer.",{"_3706":2074,"_31461":2059,"_21806":57749,"_5":15007,"_28616":57710,"_3094":51702},[],{"_3706":2075,"_31461":2059,"_21806":57751,"_5":15007,"_28616":57710,"_3094":57752},[],"KU, EKU and constraints permit the specific operation.",{"_3706":2076,"_31461":2059,"_21806":57754,"_5":15007,"_28616":57710,"_3094":57755},[],"Revocation",{"_3706":2077,"_31461":2059,"_21806":57757,"_5":15007,"_28616":57710,"_3094":57758},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3706":2078,"_31461":2059,"_21806":57760,"_5":15007,"_28616":57710,"_3094":57761},[],"Authorization",{"_3706":2079,"_31461":2059,"_21806":57763,"_5":15007,"_28616":57710,"_3094":57764},[],"The application permits that identity to perform the action.",{"_3706":2080,"_31461":2059,"_21806":57766,"_5":15007,"_28616":57710,"_3094":57767},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3706":2081,"_31461":2059,"_21806":57769,"_5":15007,"_28616":57714,"_3094":57770},[],"Mechanism",{"_3706":2082,"_31461":2059,"_21806":57772,"_5":15007,"_28616":57714,"_3094":57773},[],"When to use it",{"_3706":2083,"_31461":2059,"_21806":57775,"_5":15007,"_28616":57714,"_3094":57776},[],"What you must maintain",{"_3706":2084,"_31461":2059,"_21806":57778,"_5":15007,"_28616":57714,"_3094":57779},[],"OCSP",{"_3706":2085,"_31461":2059,"_21806":57781,"_5":15007,"_28616":57714,"_3094":57782},[],"Status query for a specific certificate.",{"_3706":2086,"_31461":2059,"_21806":57784,"_5":15007,"_28616":57714,"_3094":57785},[],"Responder access, signature verification and cache/freshness policy.",{"_3706":2087,"_31461":2059,"_21806":57787,"_5":15007,"_28616":57714,"_3094":57788},[],"CRL",{"_3706":2088,"_31461":2059,"_21806":57790,"_5":15007,"_28616":57714,"_3094":57791},[],"Local checks for many certificates or offline operation.",{"_3706":2089,"_31461":2059,"_21806":57793,"_5":15007,"_28616":57714,"_3094":57794},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3706":2090,"_31461":2059,"_21806":57796,"_5":15007,"_28616":57714,"_3094":57797},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3706":2091,"_31461":2059,"_21806":57799,"_5":15007,"_28616":57714,"_3094":57800},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3706":2092,"_31461":2059,"_21806":57802,"_5":15007,"_28616":57718,"_3094":57803},[],"Accept a current, authorized certificate with a known chain.",{"_3706":2093,"_31461":2059,"_21806":57805,"_5":15007,"_28616":57718,"_3094":57806},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3706":2094,"_31461":2059,"_21806":57808,"_5":15007,"_28616":57718,"_3094":57809},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3706":2095,"_31461":2059,"_21806":57811,"_5":15007,"_28616":57718,"_3094":57812},[],"Check that a new connection with that identity is rejected.",{"_3706":2096,"_31461":2059,"_21806":57814,"_5":15007,"_28616":57718,"_3094":57815},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3706":2097,"_31461":2059,"_21806":57817,"_5":15007,"_28616":57718,"_3094":57818},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3706":2098,"_31461":2059,"_21806":57820,"_5":15007,"_28616":57718,"_3094":57821},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3706":2099,"_31461":2059,"_21806":57823,"_5":15007,"_28616":57718,"_3094":57824},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3706":2100,"_31461":2059,"_21806":57826,"_5":15007,"_28616":57718,"_3094":57827},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3706":2101,"_31461":2101,"_5":15367,"_3094":57829,"_31799":57830,"_21806":57831,"_28616":2101},"Certificates",[51312,52850,57030,57031],[],{"_3706":2102,"_31461":2101,"_21806":57833,"_5":15007,"_28616":2101,"_3094":57834},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3706":2103,"_31461":2101,"_5":31796,"_21806":57836,"_28616":57837,"_3094":57838},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3706":2104,"_31461":2101,"_5":31796,"_21806":57840,"_28616":57841,"_3094":57842},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3706":2105,"_31461":2101,"_5":31796,"_21806":57844,"_28616":57845,"_3094":57846},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3706":2106,"_31461":2101,"_5":31796,"_21806":57848,"_28616":57849,"_3094":57850},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3706":2107,"_31461":2101,"_5":31796,"_21806":57852,"_28616":57853,"_3094":57854},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3706":2108,"_31461":2101,"_5":31796,"_21806":57856,"_28616":57857,"_3094":57858},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3706":2109,"_31461":2101,"_5":31796,"_21806":57860,"_28616":57861,"_3094":57862},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3706":2110,"_31461":2101,"_5":31796,"_21806":57864,"_28616":57865,"_3094":57866},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3706":2111,"_31461":2101,"_5":31796,"_21806":57868,"_28616":57869,"_3094":57870},[],"/docs/platform/pki/certificates#continue","Continue",{"_3706":2112,"_31461":2101,"_21806":57872,"_5":15007,"_28616":2101,"_3094":57873},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3706":2113,"_31461":2101,"_21806":57875,"_5":15007,"_28616":57837,"_3094":57876},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3706":2114,"_31461":2101,"_21806":57878,"_5":15007,"_28616":57837,"_3094":57879},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3706":2115,"_31461":2101,"_21806":57881,"_5":15007,"_28616":57837,"_3094":57882},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3706":2116,"_31461":2101,"_21806":57884,"_5":15007,"_28616":57837,"_3094":57885},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3706":2117,"_31461":2101,"_21806":57887,"_5":15007,"_28616":57837,"_3094":57888},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3706":2118,"_31461":2101,"_21806":57890,"_5":15007,"_28616":57837,"_3094":57891},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3706":2119,"_31461":2101,"_21806":57893,"_5":15007,"_28616":57837,"_3094":57894},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3706":2120,"_31461":2101,"_21806":57896,"_5":15007,"_28616":57841,"_3094":57897},[],"Download the PEM and inspect it:",{"_3706":2121,"_31461":2101,"_21806":57899,"_5":15007,"_28616":57841,"_3094":57900},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3706":2122,"_31461":2101,"_21806":57902,"_5":15007,"_28616":57845,"_3094":57903},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3706":2123,"_31461":2101,"_21806":57905,"_5":15007,"_28616":57845,"_3094":57906},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3706":2124,"_31461":2101,"_21806":57908,"_5":15007,"_28616":57845,"_3094":57909},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3706":2125,"_31461":2101,"_21806":57911,"_5":15007,"_28616":57845,"_3094":57912},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3706":2126,"_31461":2101,"_21806":57914,"_5":15007,"_28616":57845,"_3094":57915},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3706":2127,"_31461":2101,"_21806":57917,"_5":15007,"_28616":57845,"_3094":57918},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3706":2128,"_31461":2101,"_21806":57920,"_5":15007,"_28616":57845,"_3094":57921},[],"For browser key generation, follow Issue your first certificate.",{"_3706":2129,"_31461":2101,"_21806":57923,"_5":15007,"_28616":57849,"_3094":57924},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3706":2130,"_31461":2101,"_21806":57926,"_5":15007,"_28616":57853,"_3094":57927},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3706":2131,"_31461":2101,"_21806":57929,"_5":15007,"_28616":57857,"_3094":57930},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3706":2132,"_31461":2101,"_21806":57932,"_5":15007,"_28616":57861,"_3094":57933},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3706":2133,"_31461":2101,"_21806":57935,"_5":15007,"_28616":57861,"_3094":57936},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3706":2134,"_31461":2101,"_21806":57938,"_5":15007,"_28616":57861,"_3094":57939},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3706":2135,"_31461":2101,"_21806":57941,"_5":15007,"_28616":57865,"_3094":57942},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3706":2136,"_31461":2101,"_21806":57944,"_5":15007,"_28616":57865,"_3094":57945},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3706":2137,"_31461":2101,"_21806":57947,"_5":15007,"_28616":57865,"_3094":57948},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3706":2138,"_31461":2101,"_21806":57950,"_5":15007,"_28616":57869,"_3094":57951},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3706":2139,"_31461":2101,"_21806":57953,"_5":15007,"_28616":57869,"_3094":57954},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3706":2140,"_31461":2140,"_5":15367,"_3094":57956,"_31799":57957,"_21806":57959,"_28616":2140},"Certificate lifecycle",[51312,52850,57030,57958],"Concepts",[],{"_3706":2141,"_31461":2140,"_21806":57961,"_5":15007,"_28616":2140,"_3094":57962},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3706":2142,"_31461":2140,"_5":31796,"_21806":57964,"_28616":57965,"_3094":57966},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3706":2143,"_31461":2140,"_5":31796,"_21806":57968,"_28616":57969,"_3094":57970},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3706":2144,"_31461":2140,"_5":31796,"_21806":57972,"_28616":57973,"_3094":57974},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3706":2145,"_31461":2140,"_5":31796,"_21806":57976,"_28616":57977,"_3094":57978},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3706":2146,"_31461":2140,"_5":31796,"_21806":57980,"_28616":57981,"_3094":57982},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3706":2147,"_31461":2140,"_5":31796,"_21806":57984,"_28616":57985,"_3094":57986},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3706":2148,"_31461":2140,"_5":31796,"_21806":57988,"_28616":57989,"_3094":57990},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3706":2149,"_31461":2140,"_5":31796,"_21806":57992,"_28616":57993,"_3094":57994},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3706":2150,"_31461":2140,"_5":31796,"_21806":57996,"_28616":57997,"_3094":57998},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3706":2151,"_31461":2140,"_5":31796,"_21806":58000,"_28616":58001,"_3094":58002},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3706":2152,"_31461":2140,"_21806":58004,"_5":15007,"_28616":2140,"_3094":58005},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3706":2153,"_31461":2140,"_21806":58007,"_5":15007,"_28616":57969,"_3094":58008},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3706":2154,"_31461":2140,"_21806":58010,"_5":15007,"_28616":57973,"_3094":58011},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3706":2155,"_31461":2140,"_21806":58013,"_5":15007,"_28616":57977,"_3094":58014},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3706":2156,"_31461":2140,"_21806":58016,"_5":15007,"_28616":57981,"_3094":58017},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3706":2157,"_31461":2140,"_21806":58019,"_5":15007,"_28616":57985,"_3094":58020},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3706":2158,"_31461":2140,"_21806":58022,"_5":15007,"_28616":57989,"_3094":58023},[],"Lamassu persists four X.509 states:",{"_3706":2159,"_31461":2140,"_21806":58025,"_5":15007,"_28616":57989,"_3094":58026},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3706":2160,"_31461":2140,"_21806":58028,"_5":15007,"_28616":57989,"_3094":58029},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3706":2161,"_31461":2140,"_21806":58031,"_5":15007,"_28616":57989,"_3094":58032},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3706":2162,"_31461":2140,"_21806":58034,"_5":15007,"_28616":57989,"_3094":58035},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3706":2163,"_31461":2140,"_21806":58037,"_5":15007,"_28616":57989,"_3094":58038},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3706":2164,"_31461":2140,"_21806":58040,"_5":15007,"_28616":57993,"_3094":58041},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3706":2165,"_31461":2140,"_21806":58043,"_5":15007,"_28616":57993,"_3094":58044},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3706":2166,"_31461":2140,"_21806":58046,"_5":15007,"_28616":57993,"_3094":58047},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3706":2167,"_31461":2140,"_21806":58049,"_5":15007,"_28616":57997,"_3094":58050},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3706":2168,"_31461":2140,"_21806":58052,"_5":15007,"_28616":57997,"_3094":58053},[],"Before confirming:",{"_3706":2169,"_31461":2140,"_21806":58055,"_5":15007,"_28616":57997,"_3094":58056},[],"Identify DMSs, devices and services that trust that chain.",{"_3706":2170,"_31461":2140,"_21806":58058,"_5":15007,"_28616":57997,"_3094":58059},[],"Distribute the new chain of trust.",{"_3706":2171,"_31461":2140,"_21806":58061,"_5":15007,"_28616":57997,"_3094":58062},[],"Reissue the necessary identities.",{"_3706":2172,"_31461":2140,"_21806":58064,"_5":15007,"_28616":57997,"_3094":58065},[],"Check OCSP and CRL from a real consumer.",{"_3706":2173,"_31461":2140,"_21806":58067,"_5":15007,"_28616":57997,"_3094":58068},[],"Revoke the old CA once no legitimate traffic remains.",{"_3706":2174,"_31461":2140,"_21806":58070,"_5":15007,"_28616":57997,"_3094":58071},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3706":2175,"_31461":2140,"_21806":58073,"_5":15007,"_28616":58001,"_3094":58074},[],"Certificates entering the preventive or critical renewal window.",{"_3706":2176,"_31461":2140,"_21806":58076,"_5":15007,"_28616":58001,"_3094":58077},[],"Repeated enrollment or re-enrollment failures.",{"_3706":2177,"_31461":2140,"_21806":58079,"_5":15007,"_28616":58001,"_3094":58080},[],"Status changes and revocation reasons.",{"_3706":2178,"_31461":2140,"_21806":58082,"_5":15007,"_28616":58001,"_3094":58083},[],"OCSP and CRL publication and validity.",{"_3706":2179,"_31461":2140,"_21806":58085,"_5":15007,"_28616":58001,"_3094":58086},[],"Dependencies still presenting a replaced certificate.",{"_3706":2180,"_31461":2140,"_21806":58088,"_5":15007,"_28616":58001,"_3094":58089},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3706":2181,"_31461":2181,"_5":15367,"_3094":58091,"_31799":58092,"_21806":58093,"_28616":2181},"Trust model",[51312,52850,57030,57958],[],{"_3706":2182,"_31461":2181,"_21806":58095,"_5":15007,"_28616":2181,"_3094":58096},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3706":2183,"_31461":2181,"_5":31796,"_21806":58098,"_28616":58099,"_3094":58100},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3706":2184,"_31461":2181,"_5":31796,"_21806":58102,"_28616":58103,"_3094":58104},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3706":2185,"_31461":2181,"_5":31796,"_21806":58106,"_28616":58107,"_3094":58108},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3706":2186,"_31461":2181,"_5":31796,"_21806":58110,"_28616":58111,"_3094":58112},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3706":2187,"_31461":2181,"_5":31796,"_21806":58114,"_28616":58115,"_3094":58116},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3706":2188,"_31461":2181,"_5":31796,"_21806":58118,"_28616":58119,"_3094":58120},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3706":2189,"_31461":2181,"_5":31796,"_21806":58122,"_28616":58123,"_3094":58124},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3706":2190,"_31461":2181,"_5":31796,"_21806":58126,"_28616":58127,"_3094":58128},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3706":2191,"_31461":2181,"_5":31796,"_21806":58130,"_28616":58131,"_3094":58132},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3706":2192,"_31461":2181,"_5":31796,"_21806":58134,"_28616":58135,"_3094":58136},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3706":2193,"_31461":2181,"_21806":58138,"_5":15007,"_28616":2181,"_3094":58139},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3706":2194,"_31461":2181,"_21806":58141,"_5":15007,"_28616":58103,"_3094":58142},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3706":2195,"_31461":2181,"_21806":58144,"_5":15007,"_28616":58107,"_3094":58145},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3706":2196,"_31461":2181,"_21806":58147,"_5":15007,"_28616":58111,"_3094":58148},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3706":2197,"_31461":2181,"_21806":58150,"_5":15007,"_28616":58115,"_3094":58151},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3706":2198,"_31461":2181,"_21806":58153,"_5":15007,"_28616":58119,"_3094":58154},[],"The device proves it can enroll according to the DMS policy.",{"_3706":2199,"_31461":2181,"_21806":58156,"_5":15007,"_28616":58119,"_3094":58157},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3706":2200,"_31461":2181,"_21806":58159,"_5":15007,"_28616":58119,"_3094":58160},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3706":2201,"_31461":2181,"_21806":58162,"_5":15007,"_28616":58119,"_3094":58163},[],"The device installs the certificate and the chain it needs.",{"_3706":2202,"_31461":2181,"_21806":58165,"_5":15007,"_28616":58119,"_3094":58166},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3706":2203,"_31461":2181,"_21806":58168,"_5":15007,"_28616":58119,"_3094":58169},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3706":2204,"_31461":2181,"_21806":58171,"_5":15007,"_28616":58123,"_3094":58172},[],"A DMS relates three sets that are worth designing separately:",{"_3706":2205,"_31461":2181,"_21806":58174,"_5":15007,"_28616":58123,"_3094":58175},[],"**Enrollment CA:** signs the new identities.",{"_3706":2206,"_31461":2181,"_21806":58177,"_5":15007,"_28616":58123,"_3094":58178},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3706":2207,"_31461":2181,"_21806":58180,"_5":15007,"_28616":58123,"_3094":58181},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3706":2208,"_31461":2181,"_21806":58183,"_5":15007,"_28616":58123,"_3094":58184},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3706":2209,"_31461":2181,"_21806":58186,"_5":15007,"_28616":58127,"_3094":58187},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3706":2210,"_31461":2181,"_21806":58189,"_5":15007,"_28616":58127,"_3094":58190},[],"that the current date is between `Not Before` and `Not After`;",{"_3706":2211,"_31461":2181,"_21806":58192,"_5":15007,"_28616":58127,"_3094":58193},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3706":2212,"_31461":2181,"_21806":58195,"_5":15007,"_28616":58127,"_3094":58196},[],"that names, SANs and subject match the expected identity;",{"_3706":2213,"_31461":2181,"_21806":58198,"_5":15007,"_28616":58127,"_3094":58199},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3706":2214,"_31461":2181,"_21806":58201,"_5":15007,"_28616":58127,"_3094":58202},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3706":2215,"_31461":2181,"_21806":58204,"_5":15007,"_28616":58127,"_3094":58205},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3706":2216,"_31461":2181,"_21806":58207,"_5":15007,"_28616":58131,"_3094":58208},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3706":2217,"_31461":2181,"_21806":58210,"_5":15007,"_28616":58135,"_3094":58211},[],"Keep the root out of daily operations, or with very restricted access.",{"_3706":2218,"_31461":2181,"_21806":58213,"_5":15007,"_28616":58135,"_3094":58214},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3706":2219,"_31461":2181,"_21806":58216,"_5":15007,"_28616":58135,"_3094":58217},[],"Assign explicit profiles to every use case.",{"_3706":2220,"_31461":2181,"_21806":58219,"_5":15007,"_28616":58135,"_3094":58220},[],"Distribute the new trust before starting a rotation.",{"_3706":2221,"_31461":2181,"_21806":58222,"_5":15007,"_28616":58135,"_3094":58223},[],"Keep enough overlap to renew a disconnected fleet.",{"_3706":2222,"_31461":2181,"_21806":58225,"_5":15007,"_28616":58135,"_3094":58226},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3706":2223,"_31461":2181,"_21806":58228,"_5":15007,"_28616":58135,"_3094":58229},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3706":2224,"_31461":2224,"_5":15367,"_3094":58231,"_31799":58232,"_21806":58233,"_28616":2224},"Revocation lists (CRL)",[51312,52850,57030,57703],[],{"_3706":2225,"_31461":2224,"_21806":58235,"_5":15007,"_28616":2224,"_3094":58236},[],"Generate and distribute signed lists to validate certificates offline.",{"_3706":2226,"_31461":2224,"_5":31796,"_21806":58238,"_28616":58239,"_3094":58240},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3706":2227,"_31461":2224,"_5":31796,"_21806":58242,"_28616":58243,"_3094":58244},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3706":2228,"_31461":2224,"_5":31796,"_21806":58246,"_28616":58247,"_3094":58248},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3706":2229,"_31461":2224,"_5":31796,"_21806":58250,"_28616":58251,"_3094":58252},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3706":2230,"_31461":2224,"_5":31796,"_21806":58254,"_28616":58255,"_3094":58256},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3706":2231,"_31461":2224,"_5":31796,"_21806":58258,"_28616":58259,"_3094":58260},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3706":2232,"_31461":2224,"_5":31796,"_21806":58262,"_28616":58263,"_3094":58264},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3706":2233,"_31461":2224,"_5":31796,"_21806":58266,"_28616":58267,"_3094":58268},[],"/docs/platform/pki/crl#references","References",{"_3706":2234,"_31461":2224,"_21806":58270,"_5":15007,"_28616":2224,"_3094":58271},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3706":2235,"_31461":2224,"_21806":58273,"_5":15007,"_28616":58239,"_3094":58274},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3706":2236,"_31461":2224,"_21806":58276,"_5":15007,"_28616":58239,"_3094":58277},[],"Field",{"_3706":2237,"_31461":2224,"_21806":58279,"_5":15007,"_28616":58239,"_3094":51702},[],{"_3706":2238,"_31461":2224,"_21806":58281,"_5":15007,"_28616":58239,"_3094":52970},[],{"_3706":2239,"_31461":2224,"_21806":58283,"_5":15007,"_28616":58239,"_3094":58284},[],"ID of the CA the settings belong to.",{"_3706":2240,"_31461":2224,"_21806":58286,"_5":15007,"_28616":58239,"_3094":58287},[],"`status`",{"_3706":2241,"_31461":2224,"_21806":58289,"_5":15007,"_28616":58239,"_3094":58290},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3706":2242,"_31461":2224,"_21806":58292,"_5":15007,"_28616":58239,"_3094":58293},[],"`legacy_ski`",{"_3706":2243,"_31461":2224,"_21806":58295,"_5":15007,"_28616":58239,"_3094":58296},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3706":2244,"_31461":2224,"_21806":58298,"_5":15007,"_28616":58239,"_3094":58299},[],"`latest_crl`",{"_3706":2245,"_31461":2224,"_21806":58301,"_5":15007,"_28616":58239,"_3094":58302},[],"Version, validity start and end of the last published list. Read-only.",{"_3706":2246,"_31461":2224,"_21806":58304,"_5":15007,"_28616":58239,"_3094":58305},[],"`crl_options` field",{"_3706":2247,"_31461":2224,"_21806":58307,"_5":15007,"_28616":58239,"_3094":51702},[],{"_3706":2248,"_31461":2224,"_21806":58309,"_5":15007,"_28616":58239,"_3094":58310},[],"Initial value",{"_3706":2249,"_31461":2224,"_21806":58312,"_5":15007,"_28616":58239,"_3094":58313},[],"`validity`",{"_3706":2250,"_31461":2224,"_21806":58315,"_5":15007,"_28616":58239,"_3094":58316},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3706":2251,"_31461":2224,"_21806":58318,"_5":15007,"_28616":58239,"_3094":58319},[],"7 days.",{"_3706":2252,"_31461":2224,"_21806":58321,"_5":15007,"_28616":58239,"_3094":58322},[],"`refresh_interval`",{"_3706":2253,"_31461":2224,"_21806":58324,"_5":15007,"_28616":58239,"_3094":58325},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3706":2254,"_31461":2224,"_21806":58327,"_5":15007,"_28616":58239,"_3094":58328},[],"6 days and 23 hours.",{"_3706":2255,"_31461":2224,"_21806":58330,"_5":15007,"_28616":58239,"_3094":58331},[],"`regenerate_on_revoke`",{"_3706":2256,"_31461":2224,"_21806":58333,"_5":15007,"_28616":58239,"_3094":58334},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3706":2257,"_31461":2224,"_21806":58336,"_5":15007,"_28616":58239,"_3094":58337},[],"`true`.",{"_3706":2258,"_31461":2224,"_21806":58339,"_5":15007,"_28616":58239,"_3094":58340},[],"`signer_serial_number`",{"_3706":2259,"_31461":2224,"_21806":58342,"_5":15007,"_28616":58239,"_3094":58343},[],"Serial number of the existing certificate that signs the CRL.",{"_3706":2260,"_31461":2224,"_21806":58345,"_5":15007,"_28616":58239,"_3094":58346},[],"Serial number of the CA’s current certificate.",{"_3706":2261,"_31461":2224,"_21806":58348,"_5":15007,"_28616":58239,"_3094":58349},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3706":2262,"_31461":2224,"_21806":58351,"_5":15007,"_28616":58239,"_3094":58352},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3706":2263,"_31461":2224,"_21806":58354,"_5":15007,"_28616":58239,"_3094":58355},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3706":2264,"_31461":2224,"_21806":58357,"_5":15007,"_28616":58239,"_3094":58358},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3706":2265,"_31461":2224,"_21806":58360,"_5":15007,"_28616":58239,"_3094":58361},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3706":2266,"_31461":2224,"_21806":58363,"_5":15007,"_28616":58239,"_3094":58364},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3706":2267,"_31461":2224,"_21806":58366,"_5":15007,"_28616":58239,"_3094":58367},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3706":2268,"_31461":2224,"_21806":58369,"_5":15007,"_28616":58239,"_3094":58370},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3706":2269,"_31461":2224,"_21806":58372,"_5":15007,"_28616":58239,"_3094":58373},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3706":2270,"_31461":2224,"_21806":58375,"_5":15007,"_28616":58239,"_3094":58376},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3706":2271,"_31461":2224,"_21806":58378,"_5":15007,"_28616":58239,"_3094":58379},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3706":2272,"_31461":2224,"_21806":58381,"_5":15007,"_28616":58243,"_3094":58382},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3706":2273,"_31461":2224,"_21806":58384,"_5":15007,"_28616":58243,"_3094":58385},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3706":2274,"_31461":2224,"_21806":58387,"_5":15007,"_28616":58243,"_3094":58388},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3706":2275,"_31461":2224,"_21806":58390,"_5":15007,"_28616":58243,"_3094":58391},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3706":2276,"_31461":2224,"_21806":58393,"_5":15007,"_28616":58247,"_3094":58394},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3706":2277,"_31461":2224,"_21806":58396,"_5":15007,"_28616":58247,"_3094":58397},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3706":2278,"_31461":2224,"_21806":58399,"_5":15007,"_28616":58247,"_3094":58400},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3706":2279,"_31461":2224,"_21806":58402,"_5":15007,"_28616":58247,"_3094":58403},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3706":2280,"_31461":2224,"_21806":58405,"_5":15007,"_28616":58247,"_3094":58406},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3706":2281,"_31461":2224,"_21806":58408,"_5":15007,"_28616":58247,"_3094":58409},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3706":2282,"_31461":2224,"_21806":58411,"_5":15007,"_28616":58247,"_3094":58412},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3706":2283,"_31461":2224,"_21806":58414,"_5":15007,"_28616":58247,"_3094":58415},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3706":2284,"_31461":2224,"_21806":58417,"_5":15007,"_28616":58247,"_3094":58418},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3706":2285,"_31461":2224,"_21806":58420,"_5":15007,"_28616":58251,"_3094":58421},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3706":2286,"_31461":2224,"_21806":58423,"_5":15007,"_28616":58251,"_3094":58424},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3706":2287,"_31461":2224,"_21806":58426,"_5":15007,"_28616":58255,"_3094":58427},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3706":2288,"_31461":2224,"_21806":58429,"_5":15007,"_28616":58255,"_3094":58430},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3706":2289,"_31461":2224,"_21806":58432,"_5":15007,"_28616":58255,"_3094":58433},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3706":2290,"_31461":2224,"_21806":58435,"_5":15007,"_28616":58255,"_3094":58436},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3706":2291,"_31461":2224,"_21806":58438,"_5":15007,"_28616":58255,"_3094":58439},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3706":2292,"_31461":2224,"_21806":58441,"_5":15007,"_28616":58259,"_3094":58442},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3706":2293,"_31461":2224,"_21806":58444,"_5":15007,"_28616":58259,"_3094":54796},[],{"_3706":2294,"_31461":2224,"_21806":58446,"_5":15007,"_28616":58259,"_3094":58447},[],"Relative path",{"_3706":2295,"_31461":2224,"_21806":58449,"_5":15007,"_28616":58259,"_3094":54793},[],{"_3706":2296,"_31461":2224,"_21806":58451,"_5":15007,"_28616":58259,"_3094":58452},[],"`GET`",{"_3706":2297,"_31461":2224,"_21806":58454,"_5":15007,"_28616":58259,"_3094":58455},[],"`/v1/crl-settings`",{"_3706":2298,"_31461":2224,"_21806":58457,"_5":15007,"_28616":58259,"_3094":58458},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3706":2299,"_31461":2224,"_21806":58460,"_5":15007,"_28616":58259,"_3094":58452},[],{"_3706":2300,"_31461":2224,"_21806":58462,"_5":15007,"_28616":58259,"_3094":58463},[],"`/v1/crl-settings/{ca-id}`",{"_3706":2301,"_31461":2224,"_21806":58465,"_5":15007,"_28616":58259,"_3094":58466},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3706":2302,"_31461":2224,"_21806":58468,"_5":15007,"_28616":58259,"_3094":58469},[],"`PUT`",{"_3706":2303,"_31461":2224,"_21806":58471,"_5":15007,"_28616":58259,"_3094":58463},[],{"_3706":2304,"_31461":2224,"_21806":58473,"_5":15007,"_28616":58259,"_3094":58474},[],"Replace the CRL configuration of a CA.",{"_3706":2305,"_31461":2224,"_21806":58476,"_5":15007,"_28616":58259,"_3094":58477},[],"`DELETE`",{"_3706":2306,"_31461":2224,"_21806":58479,"_5":15007,"_28616":58259,"_3094":58463},[],{"_3706":2307,"_31461":2224,"_21806":58481,"_5":15007,"_28616":58259,"_3094":58482},[],"Remove the archived CRL settings of a CA.",{"_3706":2308,"_31461":2224,"_21806":58484,"_5":15007,"_28616":58259,"_3094":58485},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3706":2309,"_31461":2224,"_21806":58487,"_5":15007,"_28616":58259,"_3094":58488},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3706":2310,"_31461":2224,"_21806":58490,"_5":15007,"_28616":58259,"_3094":58491},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3706":2311,"_31461":2224,"_21806":58493,"_5":15007,"_28616":58263,"_3094":58494},[],"Symptom",{"_3706":2312,"_31461":2224,"_21806":58496,"_5":15007,"_28616":58263,"_3094":58497},[],"Cause",{"_3706":2313,"_31461":2224,"_21806":58499,"_5":15007,"_28616":58263,"_3094":58500},[],"Action",{"_3706":2314,"_31461":2224,"_21806":58502,"_5":15007,"_28616":58263,"_3094":58503},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3706":2315,"_31461":2224,"_21806":58505,"_5":15007,"_28616":58263,"_3094":58506},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3706":2316,"_31461":2224,"_21806":58508,"_5":15007,"_28616":58263,"_3094":58509},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3706":2317,"_31461":2224,"_21806":58511,"_5":15007,"_28616":58263,"_3094":58512},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3706":2318,"_31461":2224,"_21806":58514,"_5":15007,"_28616":58263,"_3094":58515},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3706":2319,"_31461":2224,"_21806":58517,"_5":15007,"_28616":58263,"_3094":58518},[],"Delete the CA first; deleting it archives its settings.",{"_3706":2320,"_31461":2224,"_21806":58520,"_5":15007,"_28616":58263,"_3094":58521},[],"`PUT` returns 400.",{"_3706":2321,"_31461":2224,"_21806":58523,"_5":15007,"_28616":58263,"_3094":58524},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3706":2322,"_31461":2224,"_21806":58526,"_5":15007,"_28616":58263,"_3094":58527},[],"Set the serial number of a valid certificate of that CA.",{"_3706":2323,"_31461":2224,"_21806":58529,"_5":15007,"_28616":58263,"_3094":58530},[],"`PUT` returns 404.",{"_3706":2324,"_31461":2224,"_21806":58532,"_5":15007,"_28616":58263,"_3094":58533},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3706":2325,"_31461":2224,"_21806":58535,"_5":15007,"_28616":58263,"_3094":58536},[],"Check the CA ID and the signer serial number.",{"_3706":2326,"_31461":2224,"_21806":58538,"_5":15007,"_28616":58263,"_3094":58539},[],"`PUT` returns 400 from a 3.x client.",{"_3706":2327,"_31461":2224,"_21806":58541,"_5":15007,"_28616":58263,"_3094":58542},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3706":2328,"_31461":2224,"_21806":58544,"_5":15007,"_28616":58263,"_3094":58545},[],"Update the client to send the new field.",{"_3706":2329,"_31461":2224,"_21806":58547,"_5":15007,"_28616":58263,"_3094":58548},[],"The CRL does not change after revoking a certificate.",{"_3706":2330,"_31461":2224,"_21806":58550,"_5":15007,"_28616":58263,"_3094":58551},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3706":2331,"_31461":2224,"_21806":58553,"_5":15007,"_28616":58263,"_3094":58554},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3706":2332,"_31461":2224,"_21806":58556,"_5":15007,"_28616":58263,"_3094":58557},[],"A verifier rejects the CRL because of the issuer.",{"_3706":2333,"_31461":2224,"_21806":58559,"_5":15007,"_28616":58263,"_3094":58560},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3706":2334,"_31461":2224,"_21806":58562,"_5":15007,"_28616":58263,"_3094":58563},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3706":2335,"_31461":2224,"_21806":58565,"_5":15007,"_28616":58267,"_3094":58566},[],"RFC 5280: X.509 and CRL profile.",{"_3706":2336,"_31461":2224,"_21806":58568,"_5":15007,"_28616":58267,"_3094":58569},[],"OpenSSL: openssl-crl.",{"_3706":2337,"_31461":2224,"_21806":58571,"_5":15007,"_28616":58267,"_3094":58572},[],"OpenSSL: openssl-verify.",{"_3706":2338,"_31461":2224,"_21806":58574,"_5":15007,"_28616":58267,"_3094":58575},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3706":2339,"_31461":2224,"_21806":58577,"_5":15007,"_28616":58267,"_3094":58578},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3706":2340,"_31461":2340,"_5":15367,"_3094":58580,"_31799":58581,"_21806":58582,"_28616":2340},"Keys and cryptographic engines",[51312,52850,57030,57031],[],{"_3706":2341,"_31461":2340,"_21806":58584,"_5":15007,"_28616":2340,"_3094":58585},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3706":2342,"_31461":2340,"_5":31796,"_21806":58587,"_28616":58588,"_3094":58589},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3706":2343,"_31461":2340,"_5":31796,"_21806":58591,"_28616":58592,"_3094":58593},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3706":2344,"_31461":2340,"_5":31796,"_21806":58595,"_28616":58596,"_3094":58597},[],"/docs/platform/pki/key-management#file-system","File System",{"_3706":2345,"_31461":2340,"_5":31796,"_21806":58599,"_28616":58600,"_3094":58601},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3706":2346,"_31461":2340,"_5":31796,"_21806":58603,"_28616":58604,"_3094":58605},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3706":2347,"_31461":2340,"_5":31796,"_21806":58607,"_28616":58608,"_3094":58609},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3706":2348,"_31461":2340,"_5":31796,"_21806":58611,"_28616":58612,"_3094":58613},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3706":2349,"_31461":2340,"_5":31796,"_21806":58615,"_28616":58616,"_3094":58617},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3706":2350,"_31461":2340,"_5":31796,"_21806":58619,"_28616":58620,"_3094":58621},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3706":2351,"_31461":2340,"_5":31796,"_21806":58623,"_28616":58624,"_3094":58625},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3706":2352,"_31461":2340,"_5":31796,"_21806":58627,"_28616":58628,"_3094":58629},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3706":2353,"_31461":2340,"_5":31796,"_21806":58631,"_28616":58632,"_3094":58633},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3706":2354,"_31461":2340,"_5":31796,"_21806":58635,"_28616":58636,"_3094":58637},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3706":2355,"_31461":2340,"_5":31796,"_21806":58639,"_28616":58640,"_3094":58641},[],"/docs/platform/pki/key-management#view-details","View details",{"_3706":2356,"_31461":2340,"_5":31796,"_21806":58643,"_28616":58644,"_3094":58645},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3706":2357,"_31461":2340,"_5":31796,"_21806":58647,"_28616":58648,"_3094":58649},[],"/docs/platform/pki/key-management#sign","Sign",{"_3706":2358,"_31461":2340,"_5":31796,"_21806":58651,"_28616":58652,"_3094":58653},[],"/docs/platform/pki/key-management#verify","Verify",{"_3706":2359,"_31461":2340,"_5":31796,"_21806":58655,"_28616":58656,"_3094":58657},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3706":2360,"_31461":2340,"_5":31796,"_21806":58659,"_28616":58660,"_3094":58661},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3706":2361,"_31461":2340,"_5":31796,"_21806":58663,"_28616":58664,"_3094":58665},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3706":2362,"_31461":2340,"_21806":58667,"_5":15007,"_28616":2340,"_3094":58668},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3706":2363,"_31461":2340,"_21806":58670,"_5":15007,"_28616":2340,"_3094":58671},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3706":2364,"_31461":2340,"_21806":58673,"_5":15007,"_28616":58588,"_3094":58674},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3706":2365,"_31461":2340,"_21806":58676,"_5":15007,"_28616":58588,"_3094":58677},[],"In practice, it lets you:",{"_3706":2366,"_31461":2340,"_21806":58679,"_5":15007,"_28616":58588,"_3094":58680},[],"Generate new key pairs from Lamassu IoT.",{"_3706":2367,"_31461":2340,"_21806":58682,"_5":15007,"_28616":58588,"_3094":58683},[],"Import keys created externally.",{"_3706":2368,"_31461":2340,"_21806":58685,"_5":15007,"_28616":58588,"_3094":58686},[],"Delegate custody and cryptographic operations to external engines.",{"_3706":2369,"_31461":2340,"_21806":58688,"_5":15007,"_28616":58588,"_3094":58689},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3706":2370,"_31461":2340,"_21806":58691,"_5":15007,"_28616":58592,"_3094":58692},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3706":2371,"_31461":2340,"_21806":58694,"_5":15007,"_28616":58592,"_3094":58695},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3706":2372,"_31461":2340,"_21806":58697,"_5":15007,"_28616":58592,"_3094":58698},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3706":2373,"_31461":2340,"_21806":58700,"_5":15007,"_28616":58596,"_3094":58701},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3706":2374,"_31461":2340,"_21806":58703,"_5":15007,"_28616":58600,"_3094":58704},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3706":2375,"_31461":2340,"_21806":58706,"_5":15007,"_28616":58600,"_3094":58707},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3706":2376,"_31461":2340,"_21806":58709,"_5":15007,"_28616":58604,"_3094":58710},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3706":2377,"_31461":2340,"_21806":58712,"_5":15007,"_28616":58608,"_3094":58713},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3706":2378,"_31461":2340,"_21806":58715,"_5":15007,"_28616":58612,"_3094":58716},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3706":2379,"_31461":2340,"_21806":58718,"_5":15007,"_28616":58616,"_3094":58719},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3706":2380,"_31461":2340,"_21806":58721,"_5":15007,"_28616":58616,"_3094":58722},[],"Lamassu shows the enabled engines in the console.",{"_3706":2381,"_31461":2340,"_21806":58724,"_5":15007,"_28616":58616,"_3094":58725},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3706":2382,"_31461":2340,"_21806":58727,"_5":15007,"_28616":58616,"_3094":58728},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3706":2383,"_31461":2340,"_21806":58730,"_5":15007,"_28616":58620,"_3094":58731},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3706":2384,"_31461":2340,"_21806":58733,"_5":15007,"_28616":58620,"_3094":58734},[],"The table includes the following fields:",{"_3706":2385,"_31461":2340,"_21806":58736,"_5":15007,"_28616":58620,"_3094":58737},[],"**Name**: descriptive name of the key.",{"_3706":2386,"_31461":2340,"_21806":58739,"_5":15007,"_28616":58620,"_3094":58740},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3706":2387,"_31461":2340,"_21806":58742,"_5":15007,"_28616":58620,"_3094":58743},[],"**Strength**: visual indicator of cryptographic strength.",{"_3706":2388,"_31461":2340,"_21806":58745,"_5":15007,"_28616":58620,"_3094":58746},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3706":2389,"_31461":2340,"_21806":58748,"_5":15007,"_28616":58620,"_3094":58749},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3706":2390,"_31461":2340,"_21806":58751,"_5":15007,"_28616":58620,"_3094":58752},[],"**Aliases**: alternative names associated with the key.",{"_3706":2391,"_31461":2340,"_21806":58754,"_5":15007,"_28616":58620,"_3094":58755},[],"**Tags**: labels for classification and search.",{"_3706":2392,"_31461":2340,"_21806":58757,"_5":15007,"_28616":58620,"_3094":58758},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3706":2393,"_31461":2340,"_21806":58760,"_5":15007,"_28616":58620,"_3094":58761},[],"From this view you also reach the most common actions:",{"_3706":2394,"_31461":2340,"_21806":58763,"_5":15007,"_28616":58620,"_3094":58764},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3706":2395,"_31461":2340,"_21806":58766,"_5":15007,"_28616":58620,"_3094":58767},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3706":2396,"_31461":2340,"_21806":58769,"_5":15007,"_28616":58620,"_3094":58770},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3706":2397,"_31461":2340,"_21806":58772,"_5":15007,"_28616":58620,"_3094":58773},[],"**Delete Key** to remove the key from the system.",{"_3706":2398,"_31461":2340,"_21806":58775,"_5":15007,"_28616":58624,"_3094":58776},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3706":2399,"_31461":2340,"_21806":58778,"_5":15007,"_28616":58628,"_3094":58779},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3706":2400,"_31461":2340,"_21806":58781,"_5":15007,"_28616":58628,"_3094":58782},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3706":2401,"_31461":2340,"_21806":58784,"_5":15007,"_28616":58628,"_3094":58785},[],"**Key Name**: unique and descriptive name.",{"_3706":2402,"_31461":2340,"_21806":58787,"_5":15007,"_28616":58628,"_3094":58788},[],"**Crypto Engine**: engine that will keep the key.",{"_3706":2403,"_31461":2340,"_21806":58790,"_5":15007,"_28616":58628,"_3094":58791},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3706":2404,"_31461":2340,"_21806":58793,"_5":15007,"_28616":58628,"_3094":58794},[],"**Tags**: metadata to classify the key.",{"_3706":2405,"_31461":2340,"_21806":58796,"_5":15007,"_28616":58628,"_3094":58797},[],"**Metadata**: additional information for advanced uses.",{"_3706":2406,"_31461":2340,"_21806":58799,"_5":15007,"_28616":58632,"_3094":58800},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3706":2407,"_31461":2340,"_21806":58802,"_5":15007,"_28616":58632,"_3094":58803},[],"When you have an exportable private key and the destination engine supports import.",{"_3706":2408,"_31461":2340,"_21806":58805,"_5":15007,"_28616":58632,"_3094":58806},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3706":2409,"_31461":2340,"_21806":58808,"_5":15007,"_28616":58632,"_3094":58809},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3706":2410,"_31461":2340,"_21806":58811,"_5":15007,"_28616":58632,"_3094":58812},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3706":2411,"_31461":2340,"_21806":58814,"_5":15007,"_28616":58632,"_3094":58815},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3706":2412,"_31461":2340,"_21806":58817,"_5":15007,"_28616":58632,"_3094":58818},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3706":2413,"_31461":2340,"_21806":58820,"_5":15007,"_28616":58632,"_3094":58821},[],"**Tags**: labels for organization and search.",{"_3706":2414,"_31461":2340,"_21806":58823,"_5":15007,"_28616":58632,"_3094":58824},[],"**Metadata**: additional optional information.",{"_3706":2415,"_31461":2340,"_21806":58826,"_5":15007,"_28616":58632,"_3094":58827},[],"**Private Key (PEM)**: private key in PEM format.",{"_3706":2416,"_31461":2340,"_21806":58829,"_5":15007,"_28616":58632,"_3094":58830},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3706":2417,"_31461":2340,"_21806":58832,"_5":15007,"_28616":58636,"_3094":58833},[],"Each registered key has a detail view and several operational actions.",{"_3706":2418,"_31461":2340,"_21806":58835,"_5":15007,"_28616":58640,"_3094":58836},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3706":2419,"_31461":2340,"_21806":58838,"_5":15007,"_28616":58640,"_3094":58839},[],"The **Overview** tab shows, among others, these fields:",{"_3706":2420,"_31461":2340,"_21806":58841,"_5":15007,"_28616":58640,"_3094":58842},[],"**Key Name**: descriptive name.",{"_3706":2421,"_31461":2340,"_21806":58844,"_5":15007,"_28616":58640,"_3094":58845},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3706":2422,"_31461":2340,"_21806":58847,"_5":15007,"_28616":58640,"_3094":58848},[],"**Tags**: associated labels.",{"_3706":2423,"_31461":2340,"_21806":58850,"_5":15007,"_28616":58640,"_3094":58851},[],"**Aliases**: alternative names.",{"_3706":2424,"_31461":2340,"_21806":58853,"_5":15007,"_28616":58640,"_3094":58854},[],"**Crypto Engine**: engine where the key resides.",{"_3706":2425,"_31461":2340,"_21806":58856,"_5":15007,"_28616":58640,"_3094":58857},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3706":2426,"_31461":2340,"_21806":58859,"_5":15007,"_28616":58640,"_3094":58860},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3706":2427,"_31461":2340,"_21806":58862,"_5":15007,"_28616":58640,"_3094":58863},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3706":2428,"_31461":2340,"_21806":58865,"_5":15007,"_28616":58644,"_3094":58866},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3706":2429,"_31461":2340,"_21806":58868,"_5":15007,"_28616":58644,"_3094":58869},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3706":2430,"_31461":2340,"_21806":58871,"_5":15007,"_28616":58644,"_3094":58872},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3706":2431,"_31461":2340,"_21806":58874,"_5":15007,"_28616":58648,"_3094":58875},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3706":2432,"_31461":2340,"_21806":58877,"_5":15007,"_28616":58648,"_3094":58878},[],"Main fields:",{"_3706":2433,"_31461":2340,"_21806":58880,"_5":15007,"_28616":58648,"_3094":58881},[],"**Algorithm**: signing algorithm available for the key type.",{"_3706":2434,"_31461":2340,"_21806":58883,"_5":15007,"_28616":58648,"_3094":58884},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3706":2435,"_31461":2340,"_21806":58886,"_5":15007,"_28616":58648,"_3094":58887},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3706":2436,"_31461":2340,"_21806":58889,"_5":15007,"_28616":58648,"_3094":58890},[],"**Message**: content to sign.",{"_3706":2437,"_31461":2340,"_21806":58892,"_5":15007,"_28616":58648,"_3094":58893},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3706":2438,"_31461":2340,"_21806":58895,"_5":15007,"_28616":58652,"_3094":58896},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3706":2439,"_31461":2340,"_21806":58898,"_5":15007,"_28616":58652,"_3094":58878},[],{"_3706":2440,"_31461":2340,"_21806":58900,"_5":15007,"_28616":58652,"_3094":58901},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3706":2441,"_31461":2340,"_21806":58903,"_5":15007,"_28616":58652,"_3094":58904},[],"**Message Type**: `Raw` or `Digest`.",{"_3706":2442,"_31461":2340,"_21806":58906,"_5":15007,"_28616":58652,"_3094":58907},[],"**Payload Encoding**: encoding of the message.",{"_3706":2443,"_31461":2340,"_21806":58909,"_5":15007,"_28616":58652,"_3094":58910},[],"**Message**: original message or hash.",{"_3706":2444,"_31461":2340,"_21806":58912,"_5":15007,"_28616":58652,"_3094":58913},[],"**Signature**: signature to check.",{"_3706":2445,"_31461":2340,"_21806":58915,"_5":15007,"_28616":58652,"_3094":58916},[],"**Result**: indicator of the validation result.",{"_3706":2446,"_31461":2340,"_21806":58918,"_5":15007,"_28616":58656,"_3094":58919},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3706":2447,"_31461":2340,"_21806":58921,"_5":15007,"_28616":58656,"_3094":58922},[],"This flow is useful for:",{"_3706":2448,"_31461":2340,"_21806":58924,"_5":15007,"_28616":58656,"_3094":58925},[],"Requesting certificates from an external CA.",{"_3706":2449,"_31461":2340,"_21806":58927,"_5":15007,"_28616":58656,"_3094":58928},[],"Renewing an identity while keeping the same key.",{"_3706":2450,"_31461":2340,"_21806":58930,"_5":15007,"_28616":58656,"_3094":58931},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3706":2451,"_31461":2340,"_21806":58933,"_5":15007,"_28616":58656,"_3094":58934},[],"**Common Name (CN)**: main name of the identity.",{"_3706":2452,"_31461":2340,"_21806":58936,"_5":15007,"_28616":58656,"_3094":58937},[],"**Organization (O)**: organization or company.",{"_3706":2453,"_31461":2340,"_21806":58939,"_5":15007,"_28616":58656,"_3094":58940},[],"**Organizational Unit (OU)**: department or unit.",{"_3706":2454,"_31461":2340,"_21806":58942,"_5":15007,"_28616":58656,"_3094":58943},[],"**Country (C)**: two-letter country code.",{"_3706":2455,"_31461":2340,"_21806":58945,"_5":15007,"_28616":58656,"_3094":58946},[],"**State / Province (ST)**: state or province.",{"_3706":2456,"_31461":2340,"_21806":58948,"_5":15007,"_28616":58656,"_3094":58949},[],"**Locality (L)**: city or locality.",{"_3706":2457,"_31461":2340,"_21806":58951,"_5":15007,"_28616":58656,"_3094":58952},[],"**Email Address**: contact email.",{"_3706":2458,"_31461":2340,"_21806":58954,"_5":15007,"_28616":58656,"_3094":58955},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3706":2459,"_31461":2340,"_21806":58957,"_5":15007,"_28616":58656,"_3094":58958},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3706":2460,"_31461":2340,"_21806":58960,"_5":15007,"_28616":58660,"_3094":58961},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3706":2461,"_31461":2340,"_21806":58963,"_5":15007,"_28616":58660,"_3094":58964},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3706":2462,"_31461":2340,"_21806":58966,"_5":15007,"_28616":58664,"_3094":58967},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3706":2463,"_31461":2340,"_21806":58969,"_5":15007,"_28616":58664,"_3094":58970},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3706":2464,"_31461":2464,"_5":15367,"_3094":58972,"_31799":58973,"_21806":58974,"_28616":2464},"Online validation with OCSP",[51312,52850,57030,57703],[],{"_3706":2465,"_31461":2464,"_21806":58976,"_5":15007,"_28616":2464,"_3094":58977},[],"Query signed status and verify the responder’s response.",{"_3706":2466,"_31461":2464,"_5":31796,"_21806":58979,"_28616":58980,"_3094":58981},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3706":2467,"_31461":2464,"_5":31796,"_21806":58983,"_28616":58984,"_3094":58985},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3706":2468,"_31461":2464,"_5":31796,"_21806":58987,"_28616":58988,"_3094":58989},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3706":2469,"_31461":2464,"_5":31796,"_21806":58991,"_28616":58992,"_3094":58993},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3706":2470,"_31461":2464,"_5":31796,"_21806":58995,"_28616":58996,"_3094":58997},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3706":2471,"_31461":2464,"_5":31796,"_21806":58999,"_28616":59000,"_3094":58268},[],"/docs/platform/pki/ocsp#references",{"_3706":2472,"_31461":2464,"_21806":59002,"_5":15007,"_28616":2464,"_3094":59003},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3706":2473,"_31461":2464,"_21806":59005,"_5":15007,"_28616":58980,"_3094":59006},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3706":2474,"_31461":2464,"_21806":59008,"_5":15007,"_28616":58980,"_3094":59009},[],"Record status",{"_3706":2475,"_31461":2464,"_21806":59011,"_5":15007,"_28616":58980,"_3094":59012},[],"Signed response",{"_3706":2476,"_31461":2464,"_21806":59014,"_5":15007,"_28616":58980,"_3094":56167},[],{"_3706":2477,"_31461":2464,"_21806":59016,"_5":15007,"_28616":58980,"_3094":59017},[],"`Good`.",{"_3706":2478,"_31461":2464,"_21806":59019,"_5":15007,"_28616":58980,"_3094":56184},[],{"_3706":2479,"_31461":2464,"_21806":59021,"_5":15007,"_28616":58980,"_3094":59022},[],"`Revoked`, with revocation reason and timestamp.",{"_3706":2480,"_31461":2464,"_21806":59024,"_5":15007,"_28616":58980,"_3094":59025},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3706":2481,"_31461":2464,"_21806":59027,"_5":15007,"_28616":58980,"_3094":59028},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3706":2482,"_31461":2464,"_21806":59030,"_5":15007,"_28616":58980,"_3094":59031},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3706":2483,"_31461":2464,"_21806":59033,"_5":15007,"_28616":58980,"_3094":59034},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3706":2484,"_31461":2464,"_21806":59036,"_5":15007,"_28616":58980,"_3094":59037},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3706":2485,"_31461":2464,"_21806":59039,"_5":15007,"_28616":58984,"_3094":59040},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3706":2486,"_31461":2464,"_21806":59042,"_5":15007,"_28616":58984,"_3094":59043},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3706":2487,"_31461":2464,"_21806":59045,"_5":15007,"_28616":58988,"_3094":59046},[],"The service accepts:",{"_3706":2488,"_31461":2464,"_21806":59048,"_5":15007,"_28616":58988,"_3094":54796},[],{"_3706":2489,"_31461":2464,"_21806":59050,"_5":15007,"_28616":58988,"_3094":59051},[],"VA service path",{"_3706":2490,"_31461":2464,"_21806":59053,"_5":15007,"_28616":58988,"_3094":59054},[],"Format",{"_3706":2491,"_31461":2464,"_21806":59056,"_5":15007,"_28616":58988,"_3094":59057},[],"`POST`",{"_3706":2492,"_31461":2464,"_21806":59059,"_5":15007,"_28616":58988,"_3094":59060},[],"`/ocsp`",{"_3706":2493,"_31461":2464,"_21806":59062,"_5":15007,"_28616":58988,"_3094":59063},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3706":2494,"_31461":2464,"_21806":59065,"_5":15007,"_28616":58988,"_3094":58452},[],{"_3706":2495,"_31461":2464,"_21806":59067,"_5":15007,"_28616":58988,"_3094":59068},[],"`/ocsp/{ocsp_request}`",{"_3706":2496,"_31461":2464,"_21806":59070,"_5":15007,"_28616":58988,"_3094":59071},[],"DER request encoded using padded URL Base64.",{"_3706":2497,"_31461":2464,"_21806":59073,"_5":15007,"_28616":58988,"_3094":59074},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3706":2498,"_31461":2464,"_21806":59076,"_5":15007,"_28616":58992,"_3094":59077},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3706":2499,"_31461":2464,"_21806":59079,"_5":15007,"_28616":58992,"_3094":59080},[],"Generate the request:",{"_3706":2500,"_31461":2464,"_21806":59082,"_5":15007,"_28616":58992,"_3094":59083},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3706":2501,"_31461":2464,"_21806":59085,"_5":15007,"_28616":58992,"_3094":59086},[],"Replace the example URL with the inspected endpoint:",{"_3706":2502,"_31461":2464,"_21806":59088,"_5":15007,"_28616":58992,"_3094":59089},[],"Verify the returned DER:",{"_3706":2503,"_31461":2464,"_21806":59091,"_5":15007,"_28616":58992,"_3094":59092},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3706":2504,"_31461":2464,"_21806":59094,"_5":15007,"_28616":58996,"_3094":59095},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3706":2505,"_31461":2464,"_21806":59097,"_5":15007,"_28616":58996,"_3094":59098},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3706":2506,"_31461":2464,"_21806":59100,"_5":15007,"_28616":59000,"_3094":59101},[],"RFC 6960: OCSP.",{"_3706":2507,"_31461":2464,"_21806":59103,"_5":15007,"_28616":59000,"_3094":59104},[],"OpenSSL: openssl-ocsp.",{"_3706":2508,"_31461":2464,"_21806":59106,"_5":15007,"_28616":59000,"_3094":59107},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3706":2509,"_31461":2464,"_21806":59109,"_5":15007,"_28616":59000,"_3094":58578},[],{"_3706":2510,"_31461":2510,"_5":15367,"_3094":57030,"_31799":59111,"_21806":59112,"_28616":2510},[51312,52850,57030],[],{"_3706":2511,"_31461":2510,"_21806":59114,"_5":15007,"_28616":2510,"_3094":59115},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3706":2512,"_31461":2510,"_5":31796,"_21806":59117,"_28616":59118,"_3094":56342},[],"/docs/platform/pki/overview#start-here",{"_3706":2513,"_31461":2510,"_5":31796,"_21806":59120,"_28616":59121,"_3094":59122},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3706":2514,"_31461":2510,"_5":31796,"_21806":59124,"_28616":59125,"_3094":56874},[],"/docs/platform/pki/overview#core-capabilities",{"_3706":2515,"_31461":2510,"_5":31796,"_21806":59127,"_28616":59128,"_3094":56878},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3706":2516,"_31461":2510,"_5":31796,"_21806":59130,"_28616":59131,"_3094":56882},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3706":2517,"_31461":2510,"_5":31796,"_21806":59133,"_28616":59134,"_3094":56886},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3706":2518,"_31461":2510,"_5":31796,"_21806":59136,"_28616":59137,"_3094":56894},[],"/docs/platform/pki/overview#publish-validation-status",{"_3706":2519,"_31461":2510,"_5":31796,"_21806":59139,"_28616":59140,"_3094":59141},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3706":2520,"_31461":2510,"_5":31796,"_21806":59143,"_28616":59144,"_3094":57870},[],"/docs/platform/pki/overview#continue",{"_3706":2521,"_31461":2510,"_21806":59146,"_5":15007,"_28616":2510,"_3094":59147},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3706":2522,"_31461":2510,"_21806":59149,"_5":15007,"_28616":59118,"_3094":59150},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3706":2523,"_31461":2510,"_21806":59152,"_5":15007,"_28616":59118,"_3094":59153},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3706":2524,"_31461":2510,"_21806":59155,"_5":15007,"_28616":59121,"_3094":59156},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3706":2525,"_31461":2510,"_21806":59158,"_5":15007,"_28616":59121,"_3094":59159},[],"An available cryptographic engine to keep the authority's key.",{"_3706":2526,"_31461":2510,"_21806":59161,"_5":15007,"_28616":59121,"_3094":59162},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3706":2527,"_31461":2510,"_21806":59164,"_5":15007,"_28616":59121,"_3094":59165},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3706":2528,"_31461":2510,"_21806":59167,"_5":15007,"_28616":59121,"_3094":59168},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3706":2529,"_31461":2510,"_21806":59170,"_5":15007,"_28616":59128,"_3094":59171},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3706":2530,"_31461":2510,"_21806":59173,"_5":15007,"_28616":59131,"_3094":59174},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3706":2531,"_31461":2510,"_21806":59176,"_5":15007,"_28616":59134,"_3094":59177},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3706":2532,"_31461":2510,"_21806":59179,"_5":15007,"_28616":59137,"_3094":59180},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3706":2533,"_31461":2510,"_21806":59182,"_5":15007,"_28616":59140,"_3094":59183},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3706":2534,"_31461":2510,"_21806":59185,"_5":15007,"_28616":59140,"_3094":59186},[],"its subject and extensions identify the expected client;",{"_3706":2535,"_31461":2510,"_21806":59188,"_5":15007,"_28616":59140,"_3094":59189},[],"its public key matches the client's private key;",{"_3706":2536,"_31461":2510,"_21806":59191,"_5":15007,"_28616":59140,"_3094":59192},[],"its chain reaches a root trusted by the consumer;",{"_3706":2537,"_31461":2510,"_21806":59194,"_5":15007,"_28616":59140,"_3094":59195},[],"its dates and usages allow the operation;",{"_3706":2538,"_31461":2510,"_21806":59197,"_5":15007,"_28616":59140,"_3094":59198},[],"the consumer applies revocation checks and authorization.",{"_3706":2539,"_31461":2510,"_21806":59200,"_5":15007,"_28616":59140,"_3094":59201},[],"The issuance path includes the first independent checks.",{"_3706":2540,"_31461":2510,"_21806":59203,"_5":15007,"_28616":59144,"_3094":59204},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3706":2541,"_31461":2510,"_21806":59206,"_5":15007,"_28616":59144,"_3094":59207},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3706":2542,"_31461":2510,"_21806":59209,"_5":15007,"_28616":59144,"_3094":59210},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3706":2543,"_31461":2543,"_5":15367,"_3094":59212,"_31799":59213,"_21806":59214,"_28616":2543},"Create your first CA",[51312,52850,57030,56467],[],{"_3706":2544,"_31461":2543,"_21806":59216,"_5":15007,"_28616":2543,"_3094":59217},[],"Create an evaluation root and check its certificate before issuing.",{"_3706":2545,"_31461":2543,"_5":31796,"_21806":59219,"_28616":59220,"_3094":51322},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3706":2546,"_31461":2543,"_5":31796,"_21806":59222,"_28616":59223,"_3094":59224},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3706":2547,"_31461":2543,"_5":31796,"_21806":59226,"_28616":59227,"_3094":59228},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3706":2548,"_31461":2543,"_5":31796,"_21806":59230,"_28616":59231,"_3094":59232},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3706":2549,"_31461":2543,"_5":31796,"_21806":59234,"_28616":59235,"_3094":59236},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3706":2550,"_31461":2543,"_5":31796,"_21806":59238,"_28616":59239,"_3094":59240},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3706":2551,"_31461":2543,"_5":31796,"_21806":59242,"_28616":59243,"_3094":59244},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3706":2552,"_31461":2543,"_5":31796,"_21806":59246,"_28616":59247,"_3094":56724},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3706":2553,"_31461":2543,"_5":31796,"_21806":59249,"_28616":59250,"_3094":51346},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3706":2554,"_31461":2543,"_21806":59252,"_5":15007,"_28616":2543,"_3094":59253},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3706":2555,"_31461":2543,"_21806":59255,"_5":15007,"_28616":59220,"_3094":59256},[],"Console access and permission to create keys and authorities.",{"_3706":2556,"_31461":2543,"_21806":59258,"_5":15007,"_28616":59220,"_3094":59259},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3706":2557,"_31461":2543,"_21806":59261,"_5":15007,"_28616":59220,"_3094":59262},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3706":2558,"_31461":2543,"_21806":59264,"_5":15007,"_28616":59220,"_3094":59265},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3706":2559,"_31461":2543,"_21806":59267,"_5":15007,"_28616":59223,"_3094":59268},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3706":2560,"_31461":2543,"_21806":59270,"_5":15007,"_28616":59223,"_3094":59271},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3706":2561,"_31461":2543,"_21806":59273,"_5":15007,"_28616":59227,"_3094":59274},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3706":2562,"_31461":2543,"_21806":59276,"_5":15007,"_28616":59227,"_3094":59277},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3706":2563,"_31461":2543,"_21806":59279,"_5":15007,"_28616":59231,"_3094":59280},[],"Select **Root CA** and complete:",{"_3706":2564,"_31461":2543,"_21806":59282,"_5":15007,"_28616":59231,"_3094":59283},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3706":2565,"_31461":2543,"_21806":59285,"_5":15007,"_28616":59231,"_3094":59286},[],"**Subject**: organization and country details for your evaluation.",{"_3706":2566,"_31461":2543,"_21806":59288,"_5":15007,"_28616":59231,"_3094":59289},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3706":2567,"_31461":2543,"_21806":59291,"_5":15007,"_28616":59231,"_3094":59292},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3706":2568,"_31461":2543,"_21806":59294,"_5":15007,"_28616":59231,"_3094":59295},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3706":2569,"_31461":2543,"_21806":59297,"_5":15007,"_28616":59235,"_3094":59298},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3706":2570,"_31461":2543,"_21806":59300,"_5":15007,"_28616":59239,"_3094":59301},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3706":2571,"_31461":2543,"_21806":59303,"_5":15007,"_28616":59239,"_3094":59304},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3706":2572,"_31461":2543,"_21806":59306,"_5":15007,"_28616":59243,"_3094":59307},[],"Run from the directory where you saved `ca.pem`:",{"_3706":2573,"_31461":2543,"_21806":59309,"_5":15007,"_28616":59243,"_3094":59310},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3706":2574,"_31461":2543,"_21806":59312,"_5":15007,"_28616":59243,"_3094":59313},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3706":2575,"_31461":2543,"_21806":59315,"_5":15007,"_28616":59247,"_3094":59316},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3706":2576,"_31461":2543,"_21806":59318,"_5":15007,"_28616":59247,"_3094":59319},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3706":2577,"_31461":2543,"_21806":59321,"_5":15007,"_28616":59247,"_3094":59322},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3706":2578,"_31461":2543,"_21806":59324,"_5":15007,"_28616":59247,"_3094":59325},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3706":2579,"_31461":2543,"_21806":59327,"_5":15007,"_28616":59250,"_3094":59328},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3706":2580,"_31461":2580,"_5":15367,"_3094":59330,"_31799":59331,"_21806":59332,"_28616":2580},"Issue and verify a certificate",[51312,52850,57030,56467],[],{"_3706":2581,"_31461":2580,"_21806":59334,"_5":15007,"_28616":2580,"_3094":59335},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3706":2582,"_31461":2580,"_5":31796,"_21806":59337,"_28616":59338,"_3094":51322},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3706":2583,"_31461":2580,"_5":31796,"_21806":59340,"_28616":59341,"_3094":59342},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3706":2584,"_31461":2580,"_5":31796,"_21806":59344,"_28616":59345,"_3094":59346},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3706":2585,"_31461":2580,"_5":31796,"_21806":59348,"_28616":59349,"_3094":59350},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3706":2586,"_31461":2580,"_5":31796,"_21806":59352,"_28616":59353,"_3094":59354},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3706":2587,"_31461":2580,"_5":31796,"_21806":59356,"_28616":59357,"_3094":59358},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3706":2588,"_31461":2580,"_5":31796,"_21806":59360,"_28616":59361,"_3094":59362},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3706":2589,"_31461":2580,"_5":31796,"_21806":59364,"_28616":59365,"_3094":59366},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3706":2590,"_31461":2580,"_5":31796,"_21806":59368,"_28616":59369,"_3094":59370},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3706":2591,"_31461":2580,"_5":31796,"_21806":59372,"_28616":59373,"_3094":59374},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3706":2592,"_31461":2580,"_5":31796,"_21806":59376,"_28616":59377,"_3094":56724},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3706":2593,"_31461":2580,"_5":31796,"_21806":59379,"_28616":59380,"_3094":51346},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3706":2594,"_31461":2580,"_21806":59382,"_5":15007,"_28616":2580,"_3094":59383},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3706":2595,"_31461":2580,"_21806":59385,"_5":15007,"_28616":59338,"_3094":59386},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3706":2596,"_31461":2580,"_21806":59388,"_5":15007,"_28616":59338,"_3094":59389},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3706":2597,"_31461":2580,"_21806":59391,"_5":15007,"_28616":59338,"_3094":59392},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3706":2598,"_31461":2580,"_21806":59394,"_5":15007,"_28616":59338,"_3094":59395},[],"A client identifier: here we use `device-001`.",{"_3706":2599,"_31461":2580,"_21806":59397,"_5":15007,"_28616":59338,"_3094":59398},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3706":2600,"_31461":2580,"_21806":59400,"_5":15007,"_28616":59341,"_3094":59401},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3706":2601,"_31461":2580,"_21806":59403,"_5":15007,"_28616":59345,"_3094":59404},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3706":2602,"_31461":2580,"_21806":59406,"_5":15007,"_28616":59345,"_3094":59407},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3706":2603,"_31461":2580,"_21806":59409,"_5":15007,"_28616":59349,"_3094":59410},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3706":2604,"_31461":2580,"_21806":59412,"_5":15007,"_28616":59349,"_3094":59413},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3706":2605,"_31461":2580,"_21806":59415,"_5":15007,"_28616":59353,"_3094":59416},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3706":2606,"_31461":2580,"_21806":59418,"_5":15007,"_28616":59353,"_3094":59419},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3706":2607,"_31461":2580,"_21806":59421,"_5":15007,"_28616":59357,"_3094":59422},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3706":2608,"_31461":2580,"_21806":59424,"_5":15007,"_28616":59361,"_3094":59425},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3706":2609,"_31461":2580,"_21806":59427,"_5":15007,"_28616":59365,"_3094":59428},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3706":2610,"_31461":2580,"_21806":59430,"_5":15007,"_28616":59369,"_3094":59431},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3706":2611,"_31461":2580,"_21806":59433,"_5":15007,"_28616":59369,"_3094":59434},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3706":2612,"_31461":2580,"_21806":59436,"_5":15007,"_28616":59369,"_3094":59437},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3706":2613,"_31461":2580,"_21806":59439,"_5":15007,"_28616":59373,"_3094":59440},[],"In Bash, compare the two public-key digests:",{"_3706":2614,"_31461":2580,"_21806":59442,"_5":15007,"_28616":59373,"_3094":59443},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3706":2615,"_31461":2580,"_21806":59445,"_5":15007,"_28616":59373,"_3094":59446},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3706":2616,"_31461":2580,"_21806":59448,"_5":15007,"_28616":59377,"_3094":56808},[],{"_3706":2617,"_31461":2580,"_21806":59450,"_5":15007,"_28616":59377,"_3094":59451},[],"What to review",{"_3706":2618,"_31461":2580,"_21806":59453,"_5":15007,"_28616":59377,"_3094":59454},[],"The CA rejects issuance",{"_3706":2619,"_31461":2580,"_21806":59456,"_5":15007,"_28616":59377,"_3094":59457},[],"Permissions, CA state and key, algorithm and profile.",{"_3706":2620,"_31461":2580,"_21806":59459,"_5":15007,"_28616":59377,"_3094":59460},[],"Different subject or usages",{"_3706":2621,"_31461":2580,"_21806":59462,"_5":15007,"_28616":59377,"_3094":59463},[],"Applied profile and requested values.",{"_3706":2622,"_31461":2580,"_21806":59465,"_5":15007,"_28616":59377,"_3094":59466},[],"Issuer cannot be found",{"_3706":2623,"_31461":2580,"_21806":59468,"_5":15007,"_28616":59377,"_3094":59469},[],"Downloaded CA and required intermediate chain.",{"_3706":2624,"_31461":2580,"_21806":59471,"_5":15007,"_28616":59377,"_3094":59472},[],"Validity fails",{"_3706":2625,"_31461":2580,"_21806":59474,"_5":15007,"_28616":59377,"_3094":59475},[],"Certificate and CA dates, and the computer's clock.",{"_3706":2626,"_31461":2580,"_21806":59477,"_5":15007,"_28616":59377,"_3094":59478},[],"Public-key digests differ",{"_3706":2627,"_31461":2580,"_21806":59480,"_5":15007,"_28616":59377,"_3094":59481},[],"Certificate and key files from the same issuance.",{"_3706":2628,"_31461":2580,"_21806":59483,"_5":15007,"_28616":59377,"_3094":59484},[],"See PKI diagnostics to narrow an issuance failure.",{"_3706":2629,"_31461":2580,"_21806":59486,"_5":15007,"_28616":59380,"_3094":59487},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3706":2630,"_31461":2580,"_21806":59489,"_5":15007,"_28616":59380,"_3094":59490},[],"Manage certificates for inspection, status and revocation.",{"_3706":2631,"_31461":2580,"_21806":59492,"_5":15007,"_28616":59380,"_3094":59493},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3706":2632,"_31461":2580,"_21806":59495,"_5":15007,"_28616":59380,"_3094":59496},[],"Prepare EST for the device to request its next identities.",{"_3706":2633,"_31461":2580,"_21806":59498,"_5":15007,"_28616":59380,"_3094":59499},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3706":2634,"_31461":2634,"_5":15367,"_3094":59501,"_31799":59502,"_21806":59503,"_28616":2634},"PKI getting started",[51312,52850,57030,56467],[],{"_3706":2635,"_31461":2634,"_21806":59505,"_5":15007,"_28616":2634,"_3094":59506},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3706":2636,"_31461":2634,"_5":31796,"_21806":59508,"_28616":59509,"_3094":51322},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3706":2637,"_31461":2634,"_5":31796,"_21806":59511,"_28616":59512,"_3094":59513},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3706":2638,"_31461":2634,"_5":31796,"_21806":59515,"_28616":59516,"_3094":56659},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3706":2639,"_31461":2634,"_5":31796,"_21806":59518,"_28616":59519,"_3094":59520},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3706":2640,"_31461":2634,"_21806":59522,"_5":15007,"_28616":2634,"_3094":59523},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3706":2641,"_31461":2634,"_21806":59525,"_5":15007,"_28616":59509,"_3094":59526},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3706":2642,"_31461":2634,"_21806":59528,"_5":15007,"_28616":59509,"_3094":59529},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3706":2643,"_31461":2634,"_21806":59531,"_5":15007,"_28616":59509,"_3094":59532},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3706":2644,"_31461":2634,"_21806":59534,"_5":15007,"_28616":59509,"_3094":59535},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3706":2645,"_31461":2634,"_21806":59537,"_5":15007,"_28616":59509,"_3094":59538},[],"A working directory with restricted access for the downloaded key.",{"_3706":2646,"_31461":2634,"_21806":59540,"_5":15007,"_28616":59512,"_3094":59541},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3706":2647,"_31461":2634,"_21806":59543,"_5":15007,"_28616":59512,"_3094":59544},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3706":2648,"_31461":2634,"_21806":59546,"_5":15007,"_28616":59512,"_3094":59547},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3706":2649,"_31461":2634,"_21806":59549,"_5":15007,"_28616":59512,"_3094":59550},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3706":2650,"_31461":2634,"_21806":59552,"_5":15007,"_28616":59516,"_3094":59553},[],"File or resource",{"_3706":2651,"_31461":2634,"_21806":59555,"_5":15007,"_28616":59516,"_3094":56656},[],{"_3706":2652,"_31461":2634,"_21806":59557,"_5":15007,"_28616":59516,"_3094":59558},[],"Active root CA and `ca.pem`",{"_3706":2653,"_31461":2634,"_21806":59560,"_5":15007,"_28616":59516,"_3094":59561},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3706":2654,"_31461":2634,"_21806":59563,"_5":15007,"_28616":59516,"_3094":59564},[],"End-entity certificate and `device.crt`",{"_3706":2655,"_31461":2634,"_21806":59566,"_5":15007,"_28616":59516,"_3094":59567},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3706":2656,"_31461":2634,"_21806":59569,"_5":15007,"_28616":59516,"_3094":59570},[],"Private key `device.key`",{"_3706":2657,"_31461":2634,"_21806":59572,"_5":15007,"_28616":59516,"_3094":59573},[],"Its public key matches the one included in `device.crt`.",{"_3706":2658,"_31461":2634,"_21806":59575,"_5":15007,"_28616":59516,"_3094":59576},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3706":2659,"_31461":2634,"_21806":59578,"_5":15007,"_28616":59519,"_3094":59579},[],"To operate certificates, continue with Certificates and Validation.",{"_3706":2660,"_31461":2634,"_21806":59581,"_5":15007,"_28616":59519,"_3094":59582},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3706":2661,"_31461":2634,"_21806":59584,"_5":15007,"_28616":59519,"_3094":59585},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3706":2662,"_31461":2662,"_5":15367,"_3094":59587,"_31799":59588,"_21806":59589,"_28616":2662},"PKI troubleshooting",[51312,52850,57030,55605],[],{"_3706":2663,"_31461":2662,"_21806":59591,"_5":15007,"_28616":2662,"_3094":59592},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3706":2664,"_31461":2662,"_5":31796,"_21806":59594,"_28616":59595,"_3094":59596},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3706":2665,"_31461":2662,"_5":31796,"_21806":59598,"_28616":59599,"_3094":59600},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3706":2666,"_31461":2662,"_5":31796,"_21806":59602,"_28616":59603,"_3094":59604},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3706":2667,"_31461":2662,"_21806":59606,"_5":15007,"_28616":2662,"_3094":59607},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3706":2668,"_31461":2662,"_21806":59609,"_5":15007,"_28616":2662,"_3094":59610},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3706":2669,"_31461":2662,"_21806":59612,"_5":15007,"_28616":59595,"_3094":56656},[],{"_3706":2670,"_31461":2662,"_21806":59614,"_5":15007,"_28616":59595,"_3094":59615},[],"What to inspect",{"_3706":2671,"_31461":2662,"_21806":59617,"_5":15007,"_28616":59595,"_3094":51346},[],{"_3706":2672,"_31461":2662,"_21806":59619,"_5":15007,"_28616":59595,"_3094":55872},[],{"_3706":2673,"_31461":2662,"_21806":59621,"_5":15007,"_28616":59595,"_3094":59622},[],"Exists, is active and has usable dates.",{"_3706":2674,"_31461":2662,"_21806":59624,"_5":15007,"_28616":59595,"_3094":59625},[],"Authorities.",{"_3706":2675,"_31461":2662,"_21806":59627,"_5":15007,"_28616":59595,"_3094":59628},[],"Key",{"_3706":2676,"_31461":2662,"_21806":59630,"_5":15007,"_28616":59595,"_3094":59631},[],"The record has a usable private key and the engine can sign.",{"_3706":2677,"_31461":2662,"_21806":59633,"_5":15007,"_28616":59595,"_3094":59634},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3706":2678,"_31461":2662,"_21806":59636,"_5":15007,"_28616":59595,"_3094":59637},[],"CSR",{"_3706":2679,"_31461":2662,"_21806":59639,"_5":15007,"_28616":59595,"_3094":59640},[],"Correct PEM and verifiable signature.",{"_3706":2680,"_31461":2662,"_21806":59642,"_5":15007,"_28616":59595,"_3094":59643},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3706":2681,"_31461":2662,"_21806":59645,"_5":15007,"_28616":59595,"_3094":59646},[],"Profile",{"_3706":2682,"_31461":2662,"_21806":59648,"_5":15007,"_28616":59595,"_3094":59649},[],"Selected source, existing ID, allowed algorithm and size.",{"_3706":2683,"_31461":2662,"_21806":59651,"_5":15007,"_28616":59595,"_3094":59652},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3706":2684,"_31461":2662,"_21806":59654,"_5":15007,"_28616":59595,"_3094":56808},[],{"_3706":2685,"_31461":2662,"_21806":59656,"_5":15007,"_28616":59595,"_3094":59657},[],"Appropriate subject, SAN, usages and dates.",{"_3706":2686,"_31461":2662,"_21806":59659,"_5":15007,"_28616":59595,"_3094":59660},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3706":2687,"_31461":2662,"_21806":59662,"_5":15007,"_28616":59595,"_3094":59663},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3706":2688,"_31461":2662,"_21806":59665,"_5":15007,"_28616":59595,"_3094":59666},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3706":2689,"_31461":2662,"_21806":59668,"_5":15007,"_28616":59595,"_3094":59669},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3706":2690,"_31461":2662,"_21806":59671,"_5":15007,"_28616":59599,"_3094":59672},[],"Check each boundary independently:",{"_3706":2691,"_31461":2662,"_21806":59674,"_5":15007,"_28616":59599,"_3094":59675},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3706":2692,"_31461":2662,"_21806":59677,"_5":15007,"_28616":59599,"_3094":59678},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3706":2693,"_31461":2662,"_21806":59680,"_5":15007,"_28616":59599,"_3094":59681},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3706":2694,"_31461":2662,"_21806":59683,"_5":15007,"_28616":59599,"_3094":59684},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3706":2695,"_31461":2662,"_21806":59686,"_5":15007,"_28616":59599,"_3094":59687},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3706":2696,"_31461":2662,"_21806":59689,"_5":15007,"_28616":59599,"_3094":59690},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3706":2697,"_31461":2662,"_21806":59692,"_5":15007,"_28616":59603,"_3094":59693},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3706":2698,"_31461":2662,"_21806":59695,"_5":15007,"_28616":59603,"_3094":59696},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3706":2699,"_31461":2699,"_5":15367,"_3094":59698,"_31799":59699,"_21806":59700,"_28616":2699},"Security",[51312],[],{"_3706":2700,"_31461":2699,"_21806":59702,"_5":15007,"_28616":2699,"_3094":59703},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3706":2701,"_31461":2699,"_5":31796,"_21806":59705,"_28616":59706,"_3094":59707},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3706":2702,"_31461":2699,"_5":31796,"_21806":59709,"_28616":59710,"_3094":59711},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3706":2703,"_31461":2699,"_5":31796,"_21806":59713,"_28616":59714,"_3094":59715},[],"/docs/security#supported-versions","Supported versions",{"_3706":2704,"_31461":2699,"_5":31796,"_21806":59717,"_28616":59718,"_3094":59719},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3706":2705,"_31461":2699,"_21806":59721,"_5":15007,"_28616":2699,"_3094":59722},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3706":2706,"_31461":2699,"_21806":59724,"_5":15007,"_28616":59706,"_3094":59725},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3706":2707,"_31461":2699,"_21806":59727,"_5":15007,"_28616":59706,"_3094":59728},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3706":2708,"_31461":2699,"_21806":59730,"_5":15007,"_28616":59706,"_3094":15646},[],{"_3706":2709,"_31461":2699,"_21806":59732,"_5":15007,"_28616":59706,"_3094":15575},[],{"_3706":2710,"_31461":2699,"_21806":59734,"_5":15007,"_28616":59706,"_3094":15633},[],{"_3706":2711,"_31461":2699,"_21806":59736,"_5":15007,"_28616":59706,"_3094":59737},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3706":2712,"_31461":2699,"_21806":59739,"_5":15007,"_28616":59706,"_3094":59740},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3706":2713,"_31461":2699,"_21806":59742,"_5":15007,"_28616":59710,"_3094":59743},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3706":2714,"_31461":2699,"_21806":59745,"_5":15007,"_28616":59710,"_3094":59746},[],"Do not include in the report:",{"_3706":2715,"_31461":2699,"_21806":59748,"_5":15007,"_28616":59710,"_3094":59749},[],"Credentials, tokens, or private keys",{"_3706":2716,"_31461":2699,"_21806":59751,"_5":15007,"_28616":59710,"_3094":59752},[],"Customer data or customer-identifiable information",{"_3706":2717,"_31461":2699,"_21806":59754,"_5":15007,"_28616":59710,"_3094":59755},[],"Confidential architecture or internal infrastructure details",{"_3706":2718,"_31461":2699,"_21806":59757,"_5":15007,"_28616":59714,"_3094":59758},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3706":2719,"_31461":2699,"_21806":59760,"_5":15007,"_28616":59714,"_3094":59761},[],"For upgrade guidance, see Upgrades.",{"_3706":2720,"_31461":2699,"_21806":59763,"_5":15007,"_28616":59718,"_3094":59764},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3706":2721,"_31461":2699,"_21806":59766,"_5":15007,"_28616":59718,"_3094":59767},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3706":2722,"_31461":2699,"_21806":59769,"_5":15007,"_28616":59718,"_3094":59770},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3706":2723,"_31461":2699,"_21806":59772,"_5":15007,"_28616":59718,"_3094":59773},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3706":2724,"_31461":2699,"_21806":59775,"_5":15007,"_28616":59718,"_3094":59776},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3706":2725,"_31461":2725,"_5":15367,"_3094":59778,"_31799":59779,"_21806":59781,"_28616":2725},"3.8.0 to 4.0.0",[51312,59780],"Upgrades",[],{"_3706":2726,"_31461":2725,"_21806":59783,"_5":15007,"_28616":2725,"_3094":59784},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3706":2727,"_31461":2725,"_5":31796,"_21806":59786,"_28616":59787,"_3094":59788},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3706":2728,"_31461":2725,"_5":31796,"_21806":59790,"_28616":59791,"_3094":59792},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3706":2729,"_31461":2725,"_5":31796,"_21806":59794,"_28616":59795,"_3094":59796},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3706":2730,"_31461":2725,"_5":31796,"_21806":59798,"_28616":59799,"_3094":59800},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3706":2731,"_31461":2725,"_5":31796,"_21806":59802,"_28616":59803,"_3094":59804},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3706":2732,"_31461":2725,"_5":31796,"_21806":59806,"_28616":59807,"_3094":59808},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3706":2733,"_31461":2725,"_5":31796,"_21806":59810,"_28616":59811,"_3094":59812},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3706":2734,"_31461":2725,"_5":31796,"_21806":59814,"_28616":59815,"_3094":59816},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3706":2735,"_31461":2725,"_5":31796,"_21806":59818,"_28616":59819,"_3094":59820},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3706":2736,"_31461":2725,"_5":31796,"_21806":59822,"_28616":59823,"_3094":59824},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3706":2737,"_31461":2725,"_5":31796,"_21806":59826,"_28616":59827,"_3094":51950},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3706":2738,"_31461":2725,"_5":31796,"_21806":59829,"_28616":59830,"_3094":59831},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3706":2739,"_31461":2725,"_5":31796,"_21806":59833,"_28616":59834,"_3094":59835},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3706":2740,"_31461":2725,"_5":31796,"_21806":59837,"_28616":59838,"_3094":59839},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3706":2741,"_31461":2725,"_5":31796,"_21806":59841,"_28616":59842,"_3094":59843},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3706":2742,"_31461":2725,"_5":31796,"_21806":59845,"_28616":59846,"_3094":59847},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3706":2743,"_31461":2725,"_5":31796,"_21806":59849,"_28616":59850,"_3094":59851},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3706":2744,"_31461":2725,"_5":31796,"_21806":59853,"_28616":59854,"_3094":59855},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3706":2745,"_31461":2725,"_5":31796,"_21806":59857,"_28616":59858,"_3094":59859},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3706":2746,"_31461":2725,"_5":31796,"_21806":59861,"_28616":59862,"_3094":59863},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3706":2747,"_31461":2725,"_5":31796,"_21806":59865,"_28616":59866,"_3094":59867},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3706":2748,"_31461":2725,"_5":31796,"_21806":59869,"_28616":59870,"_3094":59871},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3706":2749,"_31461":2725,"_5":31796,"_21806":59873,"_28616":59874,"_3094":59875},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3706":2750,"_31461":2725,"_5":31796,"_21806":59877,"_28616":59878,"_3094":59879},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3706":2751,"_31461":2725,"_5":31796,"_21806":59881,"_28616":59882,"_3094":59883},[],"/docs/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3706":2752,"_31461":2725,"_5":31796,"_21806":59885,"_28616":59886,"_3094":59887},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3706":2753,"_31461":2725,"_5":31796,"_21806":59889,"_28616":59890,"_3094":59891},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3706":2754,"_31461":2725,"_5":31796,"_21806":59893,"_28616":59894,"_3094":59895},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3706":2755,"_31461":2725,"_5":31796,"_21806":59897,"_28616":59898,"_3094":59899},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3706":2756,"_31461":2725,"_5":31796,"_21806":59901,"_28616":59902,"_3094":59903},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3706":2757,"_31461":2725,"_5":31796,"_21806":59905,"_28616":59906,"_3094":59907},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3706":2758,"_31461":2725,"_5":31796,"_21806":59909,"_28616":59910,"_3094":59911},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3706":2759,"_31461":2725,"_5":31796,"_21806":59913,"_28616":59914,"_3094":59915},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3706":2760,"_31461":2725,"_5":31796,"_21806":59917,"_28616":59918,"_3094":59919},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3706":2761,"_31461":2725,"_5":31796,"_21806":59921,"_28616":59922,"_3094":59915},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3706":2762,"_31461":2725,"_5":31796,"_21806":59924,"_28616":59925,"_3094":59926},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3706":2763,"_31461":2725,"_5":31796,"_21806":59928,"_28616":59929,"_3094":59930},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3706":2764,"_31461":2725,"_5":31796,"_21806":59932,"_28616":59933,"_3094":59934},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3706":2765,"_31461":2725,"_5":31796,"_21806":59936,"_28616":59937,"_3094":59938},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3706":2766,"_31461":2725,"_5":31796,"_21806":59940,"_28616":59941,"_3094":59942},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3706":2767,"_31461":2725,"_5":31796,"_21806":59944,"_28616":59945,"_3094":59946},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3706":2768,"_31461":2725,"_5":31796,"_21806":59948,"_28616":59949,"_3094":59950},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3706":2769,"_31461":2725,"_5":31796,"_21806":59952,"_28616":59953,"_3094":59954},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3706":2770,"_31461":2725,"_5":31796,"_21806":59956,"_28616":59957,"_3094":59958},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3706":2771,"_31461":2725,"_5":31796,"_21806":59960,"_28616":59961,"_3094":55605},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3706":2772,"_31461":2725,"_5":31796,"_21806":59963,"_28616":59964,"_3094":59965},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3706":2773,"_31461":2725,"_5":31796,"_21806":59967,"_28616":59968,"_3094":59969},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3706":2774,"_31461":2725,"_21806":59971,"_5":15007,"_28616":2725,"_3094":59972},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3706":2775,"_31461":2725,"_21806":59974,"_5":15007,"_28616":2725,"_3094":59975},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3706":2776,"_31461":2725,"_21806":59977,"_5":15007,"_28616":2725,"_3094":59978},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3706":2777,"_31461":2725,"_21806":59980,"_5":15007,"_28616":2725,"_3094":59981},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3706":2778,"_31461":2725,"_21806":59983,"_5":15007,"_28616":2725,"_3094":59984},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3706":2779,"_31461":2725,"_21806":59986,"_5":15007,"_28616":2725,"_3094":59987},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3706":2780,"_31461":2725,"_21806":59989,"_5":15007,"_28616":2725,"_3094":59990},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3706":2781,"_31461":2725,"_21806":59992,"_5":15007,"_28616":59791,"_3094":59993},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3706":2782,"_31461":2725,"_21806":59995,"_5":15007,"_28616":59791,"_3094":59996},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3706":2783,"_31461":2725,"_21806":59998,"_5":15007,"_28616":59795,"_3094":59999},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3706":2784,"_31461":2725,"_21806":60001,"_5":15007,"_28616":59795,"_3094":60002},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3706":2785,"_31461":2725,"_21806":60004,"_5":15007,"_28616":59799,"_3094":60005},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own AMQP queue, which on AMQP the broker removes automatically when the instance stops (see Device events).",{"_3706":2786,"_31461":2725,"_21806":60007,"_5":15007,"_28616":59803,"_3094":60008},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3706":2787,"_31461":2725,"_21806":60010,"_5":15007,"_28616":59803,"_3094":60011},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3706":2788,"_31461":2725,"_21806":60013,"_5":15007,"_28616":59803,"_3094":60014},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3706":2789,"_31461":2725,"_21806":60016,"_5":15007,"_28616":59803,"_3094":60017},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3706":2790,"_31461":2725,"_21806":60019,"_5":15007,"_28616":59803,"_3094":60020},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3706":2791,"_31461":2725,"_21806":60022,"_5":15007,"_28616":59807,"_3094":60023},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3706":2792,"_31461":2725,"_21806":60025,"_5":15007,"_28616":59807,"_3094":60026},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3706":2793,"_31461":2725,"_21806":60028,"_5":15007,"_28616":59807,"_3094":60029},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3706":2794,"_31461":2725,"_21806":60031,"_5":15007,"_28616":59807,"_3094":60032},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3706":2795,"_31461":2725,"_21806":60034,"_5":15007,"_28616":59807,"_3094":60035},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3706":2796,"_31461":2725,"_21806":60037,"_5":15007,"_28616":59807,"_3094":60038},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3706":2797,"_31461":2725,"_21806":60040,"_5":15007,"_28616":59811,"_3094":60041},[],"Change",{"_3706":2798,"_31461":2725,"_21806":60043,"_5":15007,"_28616":59811,"_3094":60044},[],"Who is affected",{"_3706":2799,"_31461":2725,"_21806":60046,"_5":15007,"_28616":59811,"_3094":60047},[],"Severity",{"_3706":2800,"_31461":2725,"_21806":60049,"_5":15007,"_28616":59811,"_3094":58500},[],{"_3706":2801,"_31461":2725,"_21806":60051,"_5":15007,"_28616":59811,"_3094":59820},[],{"_3706":2802,"_31461":2725,"_21806":60053,"_5":15007,"_28616":59811,"_3094":60054},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3706":2803,"_31461":2725,"_21806":60056,"_5":15007,"_28616":59811,"_3094":60057},[],"High: KMS and VA start on empty volumes",{"_3706":2804,"_31461":2725,"_21806":60059,"_5":15007,"_28616":59811,"_3094":60060},[],"Copy the data into the new volumes",{"_3706":2805,"_31461":2725,"_21806":60062,"_5":15007,"_28616":59811,"_3094":59824},[],{"_3706":2806,"_31461":2725,"_21806":60064,"_5":15007,"_28616":59811,"_3094":60065},[],"Every Helm release",{"_3706":2807,"_31461":2725,"_21806":60067,"_5":15007,"_28616":59811,"_3094":60068},[],"High: `helm upgrade` fails",{"_3706":2808,"_31461":2725,"_21806":60070,"_5":15007,"_28616":59811,"_3094":60071},[],"Remove or rename legacy keys",{"_3706":2809,"_31461":2725,"_21806":60073,"_5":15007,"_28616":59811,"_3094":51950},[],{"_3706":2810,"_31461":2725,"_21806":60075,"_5":15007,"_28616":59811,"_3094":60065},[],{"_3706":2811,"_31461":2725,"_21806":60077,"_5":15007,"_28616":59811,"_3094":60078},[],"High: `helm upgrade` fails on inline credentials",{"_3706":2812,"_31461":2725,"_21806":60080,"_5":15007,"_28616":59811,"_3094":60081},[],"Create the Secrets first; see Step 2",{"_3706":2813,"_31461":2725,"_21806":60083,"_5":15007,"_28616":59811,"_3094":59831},[],{"_3706":2814,"_31461":2725,"_21806":60085,"_5":15007,"_28616":59811,"_3094":60086},[],"Every deployment",{"_3706":2815,"_31461":2725,"_21806":60088,"_5":15007,"_28616":59811,"_3094":60089},[],"High: without a bootstrap principal there is no administrator",{"_3706":2816,"_31461":2725,"_21806":60091,"_5":15007,"_28616":59811,"_3094":60092},[],"Configure `services.authz`",{"_3706":2817,"_31461":2725,"_21806":60094,"_5":15007,"_28616":59811,"_3094":59835},[],{"_3706":2818,"_31461":2725,"_21806":60096,"_5":15007,"_28616":59811,"_3094":60065},[],{"_3706":2819,"_31461":2725,"_21806":60098,"_5":15007,"_28616":59811,"_3094":60099},[],"High: `helm upgrade` fails on the old keys",{"_3706":2820,"_31461":2725,"_21806":60101,"_5":15007,"_28616":59811,"_3094":60102},[],"Move JWKS and roles into `services.authz`",{"_3706":2821,"_31461":2725,"_21806":60104,"_5":15007,"_28616":59811,"_3094":59855},[],{"_3706":2822,"_31461":2725,"_21806":60106,"_5":15007,"_28616":59811,"_3094":60107},[],"3.8.0 deployments with per-service databases",{"_3706":2823,"_31461":2725,"_21806":60109,"_5":15007,"_28616":59811,"_3094":60110},[],"High: services find no data, or a migration aborts",{"_3706":2824,"_31461":2725,"_21806":60112,"_5":15007,"_28616":59811,"_3094":60113},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3706":2825,"_31461":2725,"_21806":60115,"_5":15007,"_28616":59811,"_3094":59859},[],{"_3706":2826,"_31461":2725,"_21806":60117,"_5":15007,"_28616":59811,"_3094":60118},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3706":2827,"_31461":2725,"_21806":60120,"_5":15007,"_28616":59811,"_3094":60121},[],"High: the backend no longer starts with them",{"_3706":2828,"_31461":2725,"_21806":60123,"_5":15007,"_28616":59811,"_3094":60124},[],"Move to PostgreSQL before upgrading",{"_3706":2829,"_31461":2725,"_21806":60126,"_5":15007,"_28616":59811,"_3094":59907},[],{"_3706":2830,"_31461":2725,"_21806":60128,"_5":15007,"_28616":59811,"_3094":60129},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3706":2831,"_31461":2725,"_21806":60131,"_5":15007,"_28616":59811,"_3094":60132},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3706":2832,"_31461":2725,"_21806":60134,"_5":15007,"_28616":59811,"_3094":60135},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3706":2833,"_31461":2725,"_21806":60137,"_5":15007,"_28616":59811,"_3094":60138},[],"Webhooks with file references",{"_3706":2834,"_31461":2725,"_21806":60140,"_5":15007,"_28616":59811,"_3094":60141},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3706":2835,"_31461":2725,"_21806":60143,"_5":15007,"_28616":59811,"_3094":60144},[],"High: enrollments calling the webhook fail",{"_3706":2836,"_31461":2725,"_21806":60146,"_5":15007,"_28616":59811,"_3094":60147},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3706":2837,"_31461":2725,"_21806":60149,"_5":15007,"_28616":59811,"_3094":59839},[],{"_3706":2838,"_31461":2725,"_21806":60151,"_5":15007,"_28616":59811,"_3094":60152},[],"Releases with per-service identity overrides or mounted key material",{"_3706":2839,"_31461":2725,"_21806":60154,"_5":15007,"_28616":59811,"_3094":60155},[],"Medium: services cannot read their files",{"_3706":2840,"_31461":2725,"_21806":60157,"_5":15007,"_28616":59811,"_3094":60158},[],"Remove the overrides and fix volume ownership",{"_3706":2841,"_31461":2725,"_21806":60160,"_5":15007,"_28616":59811,"_3094":59843},[],{"_3706":2842,"_31461":2725,"_21806":60162,"_5":15007,"_28616":59811,"_3094":60163},[],"Releases that set `amqp.tls`",{"_3706":2843,"_31461":2725,"_21806":60165,"_5":15007,"_28616":59811,"_3094":60166},[],"Medium: clients connect to the wrong port",{"_3706":2844,"_31461":2725,"_21806":60168,"_5":15007,"_28616":59811,"_3094":60169},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3706":2845,"_31461":2725,"_21806":60171,"_5":15007,"_28616":59811,"_3094":59863},[],{"_3706":2846,"_31461":2725,"_21806":60173,"_5":15007,"_28616":59811,"_3094":60174},[],"Installations whose CA keys predate the KMS",{"_3706":2847,"_31461":2725,"_21806":60176,"_5":15007,"_28616":59811,"_3094":60177},[],"Medium: CA keys stay unmanaged",{"_3706":2848,"_31461":2725,"_21806":60179,"_5":15007,"_28616":59811,"_3094":60180},[],"Run the CA-to-KMS migration",{"_3706":2849,"_31461":2725,"_21806":60182,"_5":15007,"_28616":59811,"_3094":60183},[],"Receiver certificate verification",{"_3706":2850,"_31461":2725,"_21806":60185,"_5":15007,"_28616":59811,"_3094":60186},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3706":2851,"_31461":2725,"_21806":60188,"_5":15007,"_28616":59811,"_3094":60189},[],"Medium: credentials go to an unverified receiver",{"_3706":2852,"_31461":2725,"_21806":60191,"_5":15007,"_28616":59811,"_3094":60192},[],"Set `insecure_skip_verify` to `false`",{"_3706":2853,"_31461":2725,"_21806":60194,"_5":15007,"_28616":59811,"_3094":59879},[],{"_3706":2854,"_31461":2725,"_21806":60196,"_5":15007,"_28616":59811,"_3094":60197},[],"Scripts and consoles that edit DMSs through the API",{"_3706":2855,"_31461":2725,"_21806":60199,"_5":15007,"_28616":59811,"_3094":60200},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3706":2856,"_31461":2725,"_21806":60202,"_5":15007,"_28616":59811,"_3094":60203},[],"Read the DMS before editing and use the new field",{"_3706":2857,"_31461":2725,"_21806":60205,"_5":15007,"_28616":59811,"_3094":59883},[],{"_3706":2858,"_31461":2725,"_21806":60207,"_5":15007,"_28616":59811,"_3094":60208},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3706":2859,"_31461":2725,"_21806":60210,"_5":15007,"_28616":59811,"_3094":60211},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3706":2860,"_31461":2725,"_21806":60213,"_5":15007,"_28616":59811,"_3094":60214},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3706":2861,"_31461":2725,"_21806":60216,"_5":15007,"_28616":59811,"_3094":59903},[],{"_3706":2862,"_31461":2725,"_21806":60218,"_5":15007,"_28616":59811,"_3094":60219},[],"Clients that create or update CRL settings through the API",{"_3706":2863,"_31461":2725,"_21806":60221,"_5":15007,"_28616":59811,"_3094":60222},[],"Medium: requests with the old field return an error",{"_3706":2864,"_31461":2725,"_21806":60224,"_5":15007,"_28616":59811,"_3094":60225},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3706":2865,"_31461":2725,"_21806":60227,"_5":15007,"_28616":59811,"_3094":59911},[],{"_3706":2866,"_31461":2725,"_21806":60229,"_5":15007,"_28616":59811,"_3094":60230},[],"Alert subscriptions and consumers of the VA events",{"_3706":2867,"_31461":2725,"_21806":60232,"_5":15007,"_28616":59811,"_3094":60233},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3706":2868,"_31461":2725,"_21806":60235,"_5":15007,"_28616":59811,"_3094":60236},[],"Review conditions filtering on the old event payload or subject",{"_3706":2869,"_31461":2725,"_21806":60238,"_5":15007,"_28616":59811,"_3094":59915},[],{"_3706":2870,"_31461":2725,"_21806":60240,"_5":15007,"_28616":59811,"_3094":60241},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3706":2871,"_31461":2725,"_21806":60243,"_5":15007,"_28616":59811,"_3094":60244},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3706":2872,"_31461":2725,"_21806":60246,"_5":15007,"_28616":59811,"_3094":60247},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3706":2873,"_31461":2725,"_21806":60249,"_5":15007,"_28616":59811,"_3094":59899},[],{"_3706":2874,"_31461":2725,"_21806":60251,"_5":15007,"_28616":59811,"_3094":60252},[],"Consumers that read the device `events` field",{"_3706":2875,"_31461":2725,"_21806":60254,"_5":15007,"_28616":59811,"_3094":60255},[],"Medium: the field disappears",{"_3706":2876,"_31461":2725,"_21806":60257,"_5":15007,"_28616":59811,"_3094":60258},[],"Use the new event endpoints",{"_3706":2877,"_31461":2725,"_21806":60260,"_5":15007,"_28616":59811,"_3094":59926},[],{"_3706":2878,"_31461":2725,"_21806":60262,"_5":15007,"_28616":59811,"_3094":60263},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3706":2879,"_31461":2725,"_21806":60265,"_5":15007,"_28616":59811,"_3094":60266},[],"Medium: the VA migration aborts",{"_3706":2880,"_31461":2725,"_21806":60268,"_5":15007,"_28616":59811,"_3094":60269},[],"Fix the affected roles before upgrading",{"_3706":2881,"_31461":2725,"_21806":60271,"_5":15007,"_28616":59811,"_3094":59847},[],{"_3706":2882,"_31461":2725,"_21806":60273,"_5":15007,"_28616":59811,"_3094":60274},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3706":2883,"_31461":2725,"_21806":60276,"_5":15007,"_28616":59811,"_3094":60277},[],"Low to medium: validation errors or changed defaults",{"_3706":2884,"_31461":2725,"_21806":60279,"_5":15007,"_28616":59811,"_3094":60280},[],"Update the values file",{"_3706":2885,"_31461":2725,"_21806":60282,"_5":15007,"_28616":59811,"_3094":59891},[],{"_3706":2886,"_31461":2725,"_21806":60284,"_5":15007,"_28616":59811,"_3094":60285},[],"Clients that send the DMS ID in the update body",{"_3706":2887,"_31461":2725,"_21806":60287,"_5":15007,"_28616":59811,"_3094":60288},[],"Low: the ID in the URL wins",{"_3706":2888,"_31461":2725,"_21806":60290,"_5":15007,"_28616":59811,"_3094":60291},[],"Send the ID in the URL",{"_3706":2889,"_31461":2725,"_21806":60293,"_5":15007,"_28616":59811,"_3094":59919},[],{"_3706":2890,"_31461":2725,"_21806":60295,"_5":15007,"_28616":59811,"_3094":60296},[],"Clients that send an `id` when creating or importing CAs",{"_3706":2891,"_31461":2725,"_21806":60298,"_5":15007,"_28616":59811,"_3094":60299},[],"Low: the ID in the body is ignored, and the field is removed",{"_3706":2892,"_31461":2725,"_21806":60301,"_5":15007,"_28616":59811,"_3094":60302},[],"Let the backend assign the ID and use the returned one",{"_3706":2893,"_31461":2725,"_21806":60304,"_5":15007,"_28616":59811,"_3094":59915},[],{"_3706":2894,"_31461":2725,"_21806":60306,"_5":15007,"_28616":59811,"_3094":60307},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3706":2895,"_31461":2725,"_21806":60309,"_5":15007,"_28616":59811,"_3094":60310},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3706":2896,"_31461":2725,"_21806":60312,"_5":15007,"_28616":59811,"_3094":60313},[],"Use the KMS `sign` and `verify` operations",{"_3706":2897,"_31461":2725,"_21806":60315,"_5":15007,"_28616":59811,"_3094":59895},[],{"_3706":2898,"_31461":2725,"_21806":60317,"_5":15007,"_28616":59811,"_3094":60318},[],"Consumers that match on certificate `type`",{"_3706":2899,"_31461":2725,"_21806":60320,"_5":15007,"_28616":59811,"_3094":60321},[],"Low: two values are renamed",{"_3706":2900,"_31461":2725,"_21806":60323,"_5":15007,"_28616":59811,"_3094":60324},[],"Adapt consumers",{"_3706":2901,"_31461":2725,"_21806":60326,"_5":15007,"_28616":59811,"_3094":59887},[],{"_3706":2902,"_31461":2725,"_21806":60328,"_5":15007,"_28616":59811,"_3094":60329},[],"Any DMS",{"_3706":2903,"_31461":2725,"_21806":60331,"_5":15007,"_28616":59811,"_3094":60332},[],"Low: informational",{"_3706":2904,"_31461":2725,"_21806":60334,"_5":15007,"_28616":59811,"_3094":60335},[],"Read both blocks before editing",{"_3706":2905,"_31461":2725,"_21806":60337,"_5":15007,"_28616":59819,"_3094":60338},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3706":2906,"_31461":2725,"_21806":60340,"_5":15007,"_28616":59819,"_3094":60341},[],"Step 4 of the migration guide copies the data.",{"_3706":2907,"_31461":2725,"_21806":60343,"_5":15007,"_28616":59823,"_3094":60344},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3706":2908,"_31461":2725,"_21806":60346,"_5":15007,"_28616":59827,"_3094":60347},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3706":2909,"_31461":2725,"_21806":60349,"_5":15007,"_28616":59827,"_3094":60350},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3706":2910,"_31461":2725,"_21806":60352,"_5":15007,"_28616":59830,"_3094":60353},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3706":2911,"_31461":2725,"_21806":60355,"_5":15007,"_28616":59834,"_3094":60356},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3706":2912,"_31461":2725,"_21806":60358,"_5":15007,"_28616":59838,"_3094":60359},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3706":2913,"_31461":2725,"_21806":60361,"_5":15007,"_28616":59838,"_3094":60362},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3706":2914,"_31461":2725,"_21806":60364,"_5":15007,"_28616":59838,"_3094":60365},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3706":2915,"_31461":2725,"_21806":60367,"_5":15007,"_28616":59842,"_3094":60368},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3706":2916,"_31461":2725,"_21806":60370,"_5":15007,"_28616":59846,"_3094":60371},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3706":2917,"_31461":2725,"_21806":60373,"_5":15007,"_28616":59846,"_3094":60374},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3706":2918,"_31461":2725,"_21806":60376,"_5":15007,"_28616":59846,"_3094":60377},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3706":2919,"_31461":2725,"_21806":60379,"_5":15007,"_28616":59846,"_3094":60380},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3706":2920,"_31461":2725,"_21806":60382,"_5":15007,"_28616":59846,"_3094":60383},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3706":2921,"_31461":2725,"_21806":60385,"_5":15007,"_28616":59846,"_3094":60386},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3706":2922,"_31461":2725,"_21806":60388,"_5":15007,"_28616":59854,"_3094":60389},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3706":2923,"_31461":2725,"_21806":60391,"_5":15007,"_28616":59854,"_3094":60392},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3706":2924,"_31461":2725,"_21806":60394,"_5":15007,"_28616":59854,"_3094":60395},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3706":2925,"_31461":2725,"_21806":60397,"_5":15007,"_28616":59854,"_3094":60398},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3706":2926,"_31461":2725,"_21806":60400,"_5":15007,"_28616":59854,"_3094":60401},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3706":2927,"_31461":2725,"_21806":60403,"_5":15007,"_28616":59858,"_3094":60404},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3706":2928,"_31461":2725,"_21806":60406,"_5":15007,"_28616":59862,"_3094":60407},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3706":2929,"_31461":2725,"_21806":60409,"_5":15007,"_28616":59862,"_3094":60410},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3706":2930,"_31461":2725,"_21806":60412,"_5":15007,"_28616":59862,"_3094":60413},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3706":2931,"_31461":2725,"_21806":60415,"_5":15007,"_28616":59862,"_3094":60416},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3706":2932,"_31461":2725,"_21806":60418,"_5":15007,"_28616":59862,"_3094":60419},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3706":2933,"_31461":2725,"_21806":60421,"_5":15007,"_28616":59862,"_3094":60422},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3706":2934,"_31461":2725,"_21806":60424,"_5":15007,"_28616":59862,"_3094":60425},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3706":2935,"_31461":2725,"_21806":60427,"_5":15007,"_28616":59862,"_3094":60428},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3706":2936,"_31461":2725,"_21806":60430,"_5":15007,"_28616":59866,"_3094":60431},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3706":2937,"_31461":2725,"_21806":60433,"_5":15007,"_28616":59874,"_3094":60434},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3706":2938,"_31461":2725,"_21806":60436,"_5":15007,"_28616":59874,"_3094":60437},[],"Field in 3.8.0",{"_3706":2939,"_31461":2725,"_21806":60439,"_5":15007,"_28616":59874,"_3094":60440},[],"Field in 4.0.0",{"_3706":2940,"_31461":2725,"_21806":60442,"_5":15007,"_28616":59874,"_3094":60443},[],"`validate_server_cert`",{"_3706":2941,"_31461":2725,"_21806":60445,"_5":15007,"_28616":59874,"_3094":60446},[],"`insecure_skip_verify` (value negated)",{"_3706":2942,"_31461":2725,"_21806":60448,"_5":15007,"_28616":59874,"_3094":60449},[],"`oidc`",{"_3706":2943,"_31461":2725,"_21806":60451,"_5":15007,"_28616":59874,"_3094":60452},[],"`jwt_options`",{"_3706":2944,"_31461":2725,"_21806":60454,"_5":15007,"_28616":59874,"_3094":60455},[],"`apikey`",{"_3706":2945,"_31461":2725,"_21806":60457,"_5":15007,"_28616":59874,"_3094":60458},[],"`apikey_options`",{"_3706":2946,"_31461":2725,"_21806":60460,"_5":15007,"_28616":59874,"_3094":60461},[],"`mtls`",{"_3706":2947,"_31461":2725,"_21806":60463,"_5":15007,"_28616":59874,"_3094":60464},[],"`mtls_options`",{"_3706":2948,"_31461":2725,"_21806":60466,"_5":15007,"_28616":59874,"_3094":60467},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3706":2949,"_31461":2725,"_21806":60469,"_5":15007,"_28616":59874,"_3094":60470},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3706":2950,"_31461":2725,"_21806":60472,"_5":15007,"_28616":59874,"_3094":60473},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3706":2951,"_31461":2725,"_21806":60475,"_5":15007,"_28616":59878,"_3094":60476},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3706":2952,"_31461":2725,"_21806":60478,"_5":15007,"_28616":59878,"_3094":60479},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3706":2953,"_31461":2725,"_21806":60481,"_5":15007,"_28616":59878,"_3094":60482},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3706":2954,"_31461":2725,"_21806":60484,"_5":15007,"_28616":59882,"_3094":60485},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3706":2955,"_31461":2725,"_21806":60487,"_5":15007,"_28616":59882,"_3094":60488},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3706":2956,"_31461":2725,"_21806":60490,"_5":15007,"_28616":59886,"_3094":60491},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3706":2957,"_31461":2725,"_21806":60493,"_5":15007,"_28616":59890,"_3094":60494},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3706":2958,"_31461":2725,"_21806":60496,"_5":15007,"_28616":59894,"_3094":60497},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3706":2959,"_31461":2725,"_21806":60499,"_5":15007,"_28616":59898,"_3094":60500},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3706":2960,"_31461":2725,"_21806":60502,"_5":15007,"_28616":59898,"_3094":60503},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3706":2961,"_31461":2725,"_21806":60505,"_5":15007,"_28616":59898,"_3094":60506},[],"`POST /v1/devices/:id/events` creates an event.",{"_3706":2962,"_31461":2725,"_21806":60508,"_5":15007,"_28616":59898,"_3094":60509},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Delivery is best effort: events emitted while no client is connected are not replayed on the next connection. The server closes each stream after a maximum lifetime, 10 minutes by default and configurable with the Device Manager `sse_max_stream_duration` setting, and the client reconnects to keep receiving events. When an instance has reached its subscriber limit, set by the Device Manager `sse_max_subscribers` setting (default 1000 and shared by all streams of the instance), new streams receive a `503` response with a `Retry-After` header. Each stream also re-checks the reader's permission to read the device, and closes it when the permission is revoked or cannot be verified; reconnecting goes through the regular authorization checks again. In a Helm deployment, set `services.deviceManager.sseEnabled` to `false` to disable SSE (default `true`); see Device event stream (SSE).",{"_3706":2963,"_31461":2725,"_21806":60511,"_5":15007,"_28616":59898,"_3094":60512},[],"On AMQP, each Device Manager instance binds a subscriber queue named after its service ID, `device-manager-sse-<uuid>`. The queue is durable and auto-delete, with a one-hour expiration (`x-expires`), so the broker removes it when the instance stops or its connection dies and no cleanup policy is needed. Only on event-bus providers without ephemeral-subscriber support can a per-process durable queue linger after its instance stops; check those providers if you observe leftover queues.",{"_3706":2964,"_31461":2725,"_21806":60514,"_5":15007,"_28616":59902,"_3094":60515},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3706":2965,"_31461":2725,"_21806":60517,"_5":15007,"_28616":59906,"_3094":60518},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3706":2966,"_31461":2725,"_21806":60520,"_5":15007,"_28616":59906,"_3094":60521},[],"Route",{"_3706":2967,"_31461":2725,"_21806":60523,"_5":15007,"_28616":59906,"_3094":54793},[],{"_3706":2968,"_31461":2725,"_21806":60525,"_5":15007,"_28616":59906,"_3094":60526},[],"`GET /v1/crl-settings`",{"_3706":2969,"_31461":2725,"_21806":60528,"_5":15007,"_28616":59906,"_3094":60529},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3706":2970,"_31461":2725,"_21806":60531,"_5":15007,"_28616":59906,"_3094":60532},[],"`GET /v1/crl-settings/{ca-id}`",{"_3706":2971,"_31461":2725,"_21806":60534,"_5":15007,"_28616":59906,"_3094":60535},[],"Reads the settings of a CA.",{"_3706":2972,"_31461":2725,"_21806":60537,"_5":15007,"_28616":59906,"_3094":60538},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3706":2973,"_31461":2725,"_21806":60540,"_5":15007,"_28616":59906,"_3094":60541},[],"Replaces `crl_options`.",{"_3706":2974,"_31461":2725,"_21806":60543,"_5":15007,"_28616":59906,"_3094":60544},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3706":2975,"_31461":2725,"_21806":60546,"_5":15007,"_28616":59906,"_3094":60547},[],"Removes the archived settings of a CA.",{"_3706":2976,"_31461":2725,"_21806":60549,"_5":15007,"_28616":59906,"_3094":60550},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3706":2977,"_31461":2725,"_21806":60552,"_5":15007,"_28616":59906,"_3094":60553},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3706":2978,"_31461":2725,"_21806":60555,"_5":15007,"_28616":59906,"_3094":60556},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3706":2979,"_31461":2725,"_21806":60558,"_5":15007,"_28616":59906,"_3094":60559},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3706":2980,"_31461":2725,"_21806":60561,"_5":15007,"_28616":59906,"_3094":60562},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3706":2981,"_31461":2725,"_21806":60564,"_5":15007,"_28616":59906,"_3094":60565},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3706":2982,"_31461":2725,"_21806":60567,"_5":15007,"_28616":59906,"_3094":60568},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3706":2983,"_31461":2725,"_21806":60570,"_5":15007,"_28616":59906,"_3094":60571},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3706":2984,"_31461":2725,"_21806":60573,"_5":15007,"_28616":59906,"_3094":60574},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3706":2985,"_31461":2725,"_21806":60576,"_5":15007,"_28616":59906,"_3094":60577},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3706":2986,"_31461":2725,"_21806":60579,"_5":15007,"_28616":59906,"_3094":60580},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3706":2987,"_31461":2725,"_21806":60582,"_5":15007,"_28616":59910,"_3094":60583},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3706":2988,"_31461":2725,"_21806":60585,"_5":15007,"_28616":59914,"_3094":60586},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3706":2989,"_31461":2725,"_21806":60588,"_5":15007,"_28616":59918,"_3094":60589},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3706":2990,"_31461":2725,"_21806":60591,"_5":15007,"_28616":59922,"_3094":60592},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3706":2991,"_31461":2725,"_21806":60594,"_5":15007,"_28616":59922,"_3094":60595},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3706":2992,"_31461":2725,"_21806":60597,"_5":15007,"_28616":59925,"_3094":60598},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3706":2993,"_31461":2725,"_21806":60600,"_5":15007,"_28616":59929,"_3094":60601},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3706":2994,"_31461":2725,"_21806":60603,"_5":15007,"_28616":59933,"_3094":60604},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3706":2995,"_31461":2725,"_21806":60606,"_5":15007,"_28616":59933,"_3094":60607},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3706":2996,"_31461":2725,"_21806":60609,"_5":15007,"_28616":59933,"_3094":60610},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3706":2997,"_31461":2725,"_21806":60612,"_5":15007,"_28616":59933,"_3094":60613},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3706":2998,"_31461":2725,"_21806":60615,"_5":15007,"_28616":59933,"_3094":60616},[],"Record the names of your local-storage PVCs:",{"_3706":2999,"_31461":2725,"_21806":60618,"_5":15007,"_28616":59933,"_3094":60619},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3706":3000,"_31461":2725,"_21806":60621,"_5":15007,"_28616":59937,"_3094":60622},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3706":3001,"_31461":2725,"_21806":60624,"_5":15007,"_28616":59937,"_3094":60625},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3706":3002,"_31461":2725,"_21806":60627,"_5":15007,"_28616":59937,"_3094":60628},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3706":3003,"_31461":2725,"_21806":60630,"_5":15007,"_28616":59937,"_3094":60631},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3706":3004,"_31461":2725,"_21806":60633,"_5":15007,"_28616":59937,"_3094":60634},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3706":3005,"_31461":2725,"_21806":60636,"_5":15007,"_28616":59941,"_3094":60637},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3706":3006,"_31461":2725,"_21806":60639,"_5":15007,"_28616":59941,"_3094":60640},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3706":3007,"_31461":2725,"_21806":60642,"_5":15007,"_28616":59941,"_3094":60643},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3706":3008,"_31461":2725,"_21806":60645,"_5":15007,"_28616":59941,"_3094":60646},[],"Secret (`existingSecret`)",{"_3706":3009,"_31461":2725,"_21806":60648,"_5":15007,"_28616":59941,"_3094":60649},[],"Required data keys",{"_3706":3010,"_31461":2725,"_21806":60651,"_5":15007,"_28616":59941,"_3094":60652},[],"When",{"_3706":3011,"_31461":2725,"_21806":60654,"_5":15007,"_28616":59941,"_3094":60655},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3706":3012,"_31461":2725,"_21806":60657,"_5":15007,"_28616":59941,"_3094":60658},[],"`username`, `password`",{"_3706":3013,"_31461":2725,"_21806":60660,"_5":15007,"_28616":59941,"_3094":60661},[],"Always",{"_3706":3014,"_31461":2725,"_21806":60663,"_5":15007,"_28616":59941,"_3094":60664},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3706":3015,"_31461":2725,"_21806":60666,"_5":15007,"_28616":59941,"_3094":60658},[],{"_3706":3016,"_31461":2725,"_21806":60668,"_5":15007,"_28616":59941,"_3094":60661},[],{"_3706":3017,"_31461":2725,"_21806":60670,"_5":15007,"_28616":59941,"_3094":60671},[],"`services.alerts.smtp_server.existingSecret`",{"_3706":3018,"_31461":2725,"_21806":60673,"_5":15007,"_28616":59941,"_3094":60658},[],{"_3706":3019,"_31461":2725,"_21806":60675,"_5":15007,"_28616":59941,"_3094":60676},[],"Only when SMTP authentication is enabled",{"_3706":3020,"_31461":2725,"_21806":60678,"_5":15007,"_28616":59941,"_3094":60679},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3706":3021,"_31461":2725,"_21806":60681,"_5":15007,"_28616":59941,"_3094":60682},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3706":3022,"_31461":2725,"_21806":60684,"_5":15007,"_28616":59941,"_3094":60685},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3706":3023,"_31461":2725,"_21806":60687,"_5":15007,"_28616":59941,"_3094":60688},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3706":3024,"_31461":2725,"_21806":60690,"_5":15007,"_28616":59941,"_3094":60691},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3706":3025,"_31461":2725,"_21806":60693,"_5":15007,"_28616":59941,"_3094":60694},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3706":3026,"_31461":2725,"_21806":60696,"_5":15007,"_28616":59941,"_3094":60697},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3706":3027,"_31461":2725,"_21806":60699,"_5":15007,"_28616":59941,"_3094":60700},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3706":3028,"_31461":2725,"_21806":60702,"_5":15007,"_28616":59941,"_3094":60703},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3706":3029,"_31461":2725,"_21806":60705,"_5":15007,"_28616":59941,"_3094":60706},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3706":3030,"_31461":2725,"_21806":60708,"_5":15007,"_28616":59941,"_3094":60709},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3706":3031,"_31461":2725,"_21806":60711,"_5":15007,"_28616":59941,"_3094":60712},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3706":3032,"_31461":2725,"_21806":60714,"_5":15007,"_28616":59941,"_3094":60715},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3706":3033,"_31461":2725,"_21806":60717,"_5":15007,"_28616":59941,"_3094":60718},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3706":3034,"_31461":2725,"_21806":60720,"_5":15007,"_28616":59941,"_3094":60721},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3706":3035,"_31461":2725,"_21806":60723,"_5":15007,"_28616":59945,"_3094":60724},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3706":3036,"_31461":2725,"_21806":60726,"_5":15007,"_28616":59945,"_3094":60727},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3706":3037,"_31461":2725,"_21806":60729,"_5":15007,"_28616":59949,"_3094":60730},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3706":3038,"_31461":2725,"_21806":60732,"_5":15007,"_28616":59949,"_3094":60733},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3706":3039,"_31461":2725,"_21806":60735,"_5":15007,"_28616":59949,"_3094":60736},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3706":3040,"_31461":2725,"_21806":60738,"_5":15007,"_28616":59949,"_3094":60739},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3706":3041,"_31461":2725,"_21806":60741,"_5":15007,"_28616":59949,"_3094":60742},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3706":3042,"_31461":2725,"_21806":60744,"_5":15007,"_28616":59949,"_3094":60745},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3706":3043,"_31461":2725,"_21806":60747,"_5":15007,"_28616":59949,"_3094":60748},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3706":3044,"_31461":2725,"_21806":60750,"_5":15007,"_28616":59949,"_3094":60751},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3706":3045,"_31461":2725,"_21806":60753,"_5":15007,"_28616":59949,"_3094":60754},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3706":3046,"_31461":2725,"_21806":60756,"_5":15007,"_28616":59949,"_3094":60757},[],"**Remove the helper and restore the recorded replica counts:**",{"_3706":3047,"_31461":2725,"_21806":60759,"_5":15007,"_28616":59949,"_3094":60760},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3706":3048,"_31461":2725,"_21806":60762,"_5":15007,"_28616":59953,"_3094":60763},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3706":3049,"_31461":2725,"_21806":60765,"_5":15007,"_28616":59953,"_3094":60766},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3706":3050,"_31461":2725,"_21806":60768,"_5":15007,"_28616":59957,"_3094":60769},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3706":3051,"_31461":2725,"_21806":60771,"_5":15007,"_28616":59957,"_3094":60772},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3706":3052,"_31461":2725,"_21806":60774,"_5":15007,"_28616":59957,"_3094":60775},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3706":3053,"_31461":2725,"_21806":60777,"_5":15007,"_28616":59957,"_3094":60778},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3706":3054,"_31461":2725,"_21806":60780,"_5":15007,"_28616":59957,"_3094":60781},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3706":3055,"_31461":2725,"_21806":60783,"_5":15007,"_28616":59957,"_3094":60784},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3706":3056,"_31461":2725,"_21806":60786,"_5":15007,"_28616":59957,"_3094":60787},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3706":3057,"_31461":2725,"_21806":60789,"_5":15007,"_28616":59957,"_3094":60790},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3706":3058,"_31461":2725,"_21806":60792,"_5":15007,"_28616":59961,"_3094":60793},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3706":3059,"_31461":2725,"_21806":60795,"_5":15007,"_28616":59961,"_3094":60796},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3706":3060,"_31461":2725,"_21806":60798,"_5":15007,"_28616":59961,"_3094":60799},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3706":3061,"_31461":2725,"_21806":60801,"_5":15007,"_28616":59961,"_3094":60802},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3706":3062,"_31461":2725,"_21806":60804,"_5":15007,"_28616":59961,"_3094":60805},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3706":3063,"_31461":2725,"_21806":60807,"_5":15007,"_28616":59961,"_3094":60808},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3706":3064,"_31461":2725,"_21806":60810,"_5":15007,"_28616":59961,"_3094":60811},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3706":3065,"_31461":2725,"_21806":60813,"_5":15007,"_28616":59961,"_3094":60814},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3706":3066,"_31461":2725,"_21806":60816,"_5":15007,"_28616":59961,"_3094":60817},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3706":3067,"_31461":2725,"_21806":60819,"_5":15007,"_28616":59961,"_3094":60820},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3706":3068,"_31461":2725,"_21806":60822,"_5":15007,"_28616":59961,"_3094":60823},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3706":3069,"_31461":2725,"_21806":60825,"_5":15007,"_28616":59964,"_3094":60826},[],"After the upgrade, check in this order:",{"_3706":3070,"_31461":2725,"_21806":60828,"_5":15007,"_28616":59964,"_3094":60829},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3706":3071,"_31461":2725,"_21806":60831,"_5":15007,"_28616":59964,"_3094":60832},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3706":3072,"_31461":2725,"_21806":60834,"_5":15007,"_28616":59964,"_3094":60835},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3706":3073,"_31461":2725,"_21806":60837,"_5":15007,"_28616":59964,"_3094":60838},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3706":3074,"_31461":2725,"_21806":60840,"_5":15007,"_28616":59964,"_3094":60841},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3706":3075,"_31461":2725,"_21806":60843,"_5":15007,"_28616":59964,"_3094":60844},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3706":3076,"_31461":2725,"_21806":60846,"_5":15007,"_28616":59964,"_3094":60847},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3706":3077,"_31461":2725,"_21806":60849,"_5":15007,"_28616":59964,"_3094":60850},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3706":3078,"_31461":2725,"_21806":60852,"_5":15007,"_28616":59964,"_3094":60853},[],"**AMQP.** The backend connects to the broker with the expected TLS settings. On AMQP the SSE subscriber queues are auto-delete and disappear when their instance stops; on event-bus providers without ephemeral-subscriber support, check that leftover per-process SSE queues are not accumulating.",{"_3706":3079,"_31461":2725,"_21806":60855,"_5":15007,"_28616":59964,"_3094":60856},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3706":3080,"_31461":2725,"_21806":60858,"_5":15007,"_28616":59964,"_3094":60859},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3706":3081,"_31461":2725,"_21806":60861,"_5":15007,"_28616":59964,"_3094":60862},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3706":3082,"_31461":2725,"_21806":60864,"_5":15007,"_28616":59964,"_3094":60865},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3706":3083,"_31461":2725,"_21806":60867,"_5":15007,"_28616":59964,"_3094":60868},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3706":3084,"_31461":2725,"_21806":60870,"_5":15007,"_28616":59964,"_3094":60871},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3706":3085,"_31461":2725,"_21806":60873,"_5":15007,"_28616":59968,"_3094":60874},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3706":3086,"_31461":2725,"_21806":60876,"_5":15007,"_28616":59968,"_3094":60877},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3706":3087,"_31461":2725,"_21806":60879,"_5":15007,"_28616":59968,"_3094":60880},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3706":3088,"_31461":2725,"_21806":60882,"_5":15007,"_28616":59968,"_3094":60883},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3706":3089,"_31461":2725,"_21806":60885,"_5":15007,"_28616":59968,"_3094":60886},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60889":60890,"_60891":60892,"_60893":60894,"_60895":60896,"_18897":3129,"_73210":3129},"language","english","sortableProperties",[3094,31461,5,28616],"sortablePropertiesWithTypes",{"_3094":26007,"_31461":26007,"_5":26007,"_28616":26007},"sorts",{"_3094":60897,"_31461":63976,"_5":67054,"_28616":70132},{"_4864":60898,"_60899":60900,"_5":26007},{"_15088":3408,"_15467":6669,"_15486":3159,"_30445":20255,"_15473":4566,"_20710":5983,"_15109":7985,"_15116":7558,"_30382":7995,"_30795":7040,"_30827":5413,"_30421":4702,"_35863":5173,"_30524":7887,"_30882":5666,"_35870":15538,"_35873":7401,"_35876":14368,"_35879":6259,"_31284":6123,"_35884":10905,"_35886":7291,"_31319":13639,"_15482":4357,"_35890":5405,"_35893":7555,"_35895":6484,"_30866":5411,"_31304":6947,"_31332":5220,"_35900":21984,"_35902":3502,"_35904":3519,"_30535":3195,"_35907":7402,"_35909":3954,"_35911":3427,"_35913":3840,"_35915":6283,"_30458":4869,"_35918":3534,"_35920":14964,"_30452":3513,"_30903":14797,"_35924":24019,"_35926":6515,"_35929":4622,"_30498":4598,"_35933