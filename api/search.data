en Amazon EC2.",{"_3170":64324,"_28022":64322,"_5":28341,"_19417":106687,"_25514":106688,"_2665":106689},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3170":64325,"_28022":64322,"_5":28341,"_19417":106691,"_25514":106692,"_2665":106693},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3170":64326,"_28022":64322,"_5":28341,"_19417":106695,"_25514":106696,"_2665":106697},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3170":64327,"_28022":64322,"_5":28341,"_19417":106699,"_25514":106700,"_2665":106701},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3170":64328,"_28022":64322,"_5":28341,"_19417":106703,"_25514":106704,"_2665":106705},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3170":64329,"_28022":64322,"_5":28341,"_19417":106707,"_25514":106708,"_2665":106709},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3170":64330,"_28022":64322,"_5":28341,"_19417":106711,"_25514":106712,"_2665":106713},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3170":64331,"_28022":64322,"_19417":106715,"_5":13306,"_25514":64322,"_2665":106716},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3170":64332,"_28022":64322,"_19417":106718,"_5":13306,"_25514":106688,"_2665":106719},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3170":64333,"_28022":64322,"_19417":106721,"_5":13306,"_25514":106688,"_2665":106722},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3170":64334,"_28022":64322,"_19417":106724,"_5":13306,"_25514":106688,"_2665":106725},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3170":64335,"_28022":64322,"_19417":106727,"_5":13306,"_25514":106692,"_2665":106728},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3170":64336,"_28022":64322,"_19417":106730,"_5":13306,"_25514":106692,"_2665":106731},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3170":64337,"_28022":64322,"_19417":106733,"_5":13306,"_25514":106692,"_2665":106734},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3170":64338,"_28022":64322,"_19417":106736,"_5":13306,"_25514":106696,"_2665":106737},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3170":64339,"_28022":64322,"_19417":106739,"_5":13306,"_25514":106700,"_2665":106740},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3170":64340,"_28022":64322,"_19417":106742,"_5":13306,"_25514":106704,"_2665":106743},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3170":64341,"_28022":64322,"_19417":106745,"_5":13306,"_25514":106708,"_2665":106746},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3170":64342,"_28022":64322,"_19417":106748,"_5":13306,"_25514":106712,"_2665":106749},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3170":64343,"_28022":64343,"_5":13637,"_2665":106751,"_28344":106752,"_19417":106753,"_25514":64343},"Despliega Lamassu",[45406,106680],[],{"_3170":64344,"_28022":64343,"_19417":106755,"_5":13306,"_25514":64343,"_2665":106756},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3170":64345,"_28022":64343,"_5":28341,"_19417":106758,"_25514":106759,"_2665":106760},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3170":64346,"_28022":64343,"_5":28341,"_19417":106762,"_25514":106763,"_2665":106764},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3170":64347,"_28022":64343,"_5":28341,"_19417":106766,"_25514":106767,"_2665":106768},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3170":64348,"_28022":64343,"_19417":106770,"_5":13306,"_25514":64343,"_2665":106771},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3170":64349,"_28022":64343,"_19417":106773,"_5":13306,"_25514":106759,"_2665":106774},[],"Modelo",{"_3170":64350,"_28022":64343,"_19417":106776,"_5":13306,"_25514":106759,"_2665":106777},[],"Recomendado para",{"_3170":64351,"_28022":64343,"_19417":106779,"_5":13306,"_25514":106759,"_2665":106780},[],"Quién opera la infraestructura",{"_3170":64352,"_28022":64343,"_19417":106782,"_5":13306,"_25514":106759,"_2665":106783},[],"Punto de partida",{"_3170":64353,"_28022":64343,"_19417":106785,"_5":13306,"_25514":106759,"_2665":45513},[],{"_3170":64354,"_28022":64343,"_19417":106787,"_5":13306,"_25514":106759,"_2665":106788},[],"Producción, entornos regulados y despliegues personalizados",{"_3170":64355,"_28022":64343,"_19417":106790,"_5":13306,"_25514":106759,"_2665":106791},[],"Tu equipo",{"_3170":64356,"_28022":64343,"_19417":106793,"_5":13306,"_25514":106759,"_2665":106794},[],"Helm o Fastlane",{"_3170":64357,"_28022":64343,"_19417":106796,"_5":13306,"_25514":106759,"_2665":45525},[],{"_3170":64358,"_28022":64343,"_19417":106798,"_5":13306,"_25514":106759,"_2665":106799},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3170":64359,"_28022":64343,"_19417":106801,"_5":13306,"_25514":106759,"_2665":106791},[],{"_3170":64360,"_28022":64343,"_19417":106803,"_5":13306,"_25514":106759,"_2665":106804},[],"Imagen preconfigurada en EC2",{"_3170":64361,"_28022":64343,"_19417":106806,"_5":13306,"_25514":106759,"_2665":45536},[],{"_3170":64362,"_28022":64343,"_19417":106808,"_5":13306,"_25514":106759,"_2665":106809},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3170":64363,"_28022":64343,"_19417":106811,"_5":13306,"_25514":106759,"_2665":45542},[],{"_3170":64364,"_28022":64343,"_19417":106813,"_5":13306,"_25514":106759,"_2665":106814},[],"Suscripción gestionada",{"_3170":64365,"_28022":64343,"_19417":106816,"_5":13306,"_25514":106759,"_2665":106817},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3170":64366,"_28022":64343,"_19417":106819,"_5":13306,"_25514":106759,"_2665":106820},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3170":64367,"_28022":64343,"_19417":106822,"_5":13306,"_25514":106759,"_2665":106823},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3170":64368,"_28022":64343,"_19417":106825,"_5":13306,"_25514":106763,"_2665":106826},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3170":64369,"_28022":64343,"_19417":106828,"_5":13306,"_25514":106767,"_2665":106829},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3170":64370,"_28022":64370,"_5":13637,"_2665":106831,"_28344":106832,"_19417":106833,"_25514":64370},"Utiliza Lamassu como SaaS",[45406,106680,106681],[],{"_3170":64371,"_28022":64370,"_19417":106835,"_5":13306,"_25514":64370,"_2665":106836},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3170":64372,"_28022":64370,"_5":28341,"_19417":106838,"_25514":106839,"_2665":106840},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3170":64373,"_28022":64370,"_5":28341,"_19417":106842,"_25514":106843,"_2665":106844},[],"/docs/es/deployment/saas#planes","Planes",{"_3170":64374,"_28022":64370,"_5":28341,"_19417":106846,"_25514":106847,"_2665":106848},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3170":64375,"_28022":64370,"_19417":106850,"_5":13306,"_25514":64370,"_2665":106851},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3170":64376,"_28022":64370,"_19417":106853,"_5":13306,"_25514":106839,"_2665":106854},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3170":64377,"_28022":64370,"_19417":106856,"_5":13306,"_25514":106839,"_2665":106857},[],"Copias de seguridad automáticas.",{"_3170":64378,"_28022":64370,"_19417":106859,"_5":13306,"_25514":106839,"_2665":106860},[],"Actualizaciones de versión.",{"_3170":64379,"_28022":64370,"_19417":106862,"_5":13306,"_25514":106839,"_2665":106863},[],"Soporte técnico y SLA según el plan contratado.",{"_3170":64380,"_28022":64370,"_19417":106865,"_5":13306,"_25514":106843,"_2665":45597},[],{"_3170":64381,"_28022":64370,"_19417":106867,"_5":13306,"_25514":106843,"_2665":106868},[],"Dispositivos",{"_3170":64382,"_28022":64370,"_19417":106870,"_5":13306,"_25514":106843,"_2665":106871},[],"Soporte",{"_3170":64383,"_28022":64370,"_19417":106873,"_5":13306,"_25514":106843,"_2665":45606},[],{"_3170":64384,"_28022":64370,"_19417":106875,"_5":13306,"_25514":106843,"_2665":45609},[],{"_3170":64385,"_28022":64370,"_19417":106877,"_5":13306,"_25514":106843,"_2665":106878},[],"Hasta 1.000",{"_3170":64386,"_28022":64370,"_19417":106880,"_5":13306,"_25514":106843,"_2665":45615},[],{"_3170":64387,"_28022":64370,"_19417":106882,"_5":13306,"_25514":106843,"_2665":106883},[],"99,5 %",{"_3170":64388,"_28022":64370,"_19417":106885,"_5":13306,"_25514":106843,"_2665":45621},[],{"_3170":64389,"_28022":64370,"_19417":106887,"_5":13306,"_25514":106843,"_2665":106888},[],"Hasta 10.000",{"_3170":64390,"_28022":64370,"_19417":106890,"_5":13306,"_25514":106843,"_2665":106891},[],"Email y chat",{"_3170":64391,"_28022":64370,"_19417":106893,"_5":13306,"_25514":106843,"_2665":106894},[],"99,9 %",{"_3170":64392,"_28022":64370,"_19417":106896,"_5":13306,"_25514":106843,"_2665":45633},[],{"_3170":64393,"_28022":64370,"_19417":106898,"_5":13306,"_25514":106843,"_2665":106899},[],"Ilimitados",{"_3170":64394,"_28022":64370,"_19417":106901,"_5":13306,"_25514":106843,"_2665":106902},[],"Dedicado",{"_3170":64395,"_28022":64370,"_19417":106904,"_5":13306,"_25514":106843,"_2665":106905},[],"99,99 %",{"_3170":64396,"_28022":64370,"_19417":106907,"_5":13306,"_25514":106847,"_2665":106908},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3170":64397,"_28022":64370,"_19417":106910,"_5":13306,"_25514":106847,"_2665":106911},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3170":64398,"_28022":64398,"_5":13637,"_2665":45650,"_28344":106913,"_19417":106915,"_25514":64398},[45406,106680,106914],"Kubernetes autogestionado",[],{"_3170":64399,"_28022":64398,"_19417":106917,"_5":13306,"_25514":64398,"_2665":106918},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3170":64400,"_28022":64398,"_5":28341,"_19417":106920,"_25514":106921,"_2665":106922},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3170":64401,"_28022":64398,"_5":28341,"_19417":106924,"_25514":106925,"_2665":106926},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3170":64402,"_28022":64398,"_5":28341,"_19417":106928,"_25514":106929,"_2665":106930},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3170":64403,"_28022":64398,"_5":28341,"_19417":106932,"_25514":106933,"_2665":106934},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3170":64404,"_28022":64398,"_5":28341,"_19417":106936,"_25514":106937,"_2665":106938},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3170":64405,"_28022":64398,"_5":28341,"_19417":106940,"_25514":106941,"_2665":106942},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3170":64406,"_28022":64398,"_5":28341,"_19417":106944,"_25514":106945,"_2665":106946},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3170":64407,"_28022":64398,"_5":28341,"_19417":106948,"_25514":106949,"_2665":106950},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3170":64408,"_28022":64398,"_5":28341,"_19417":106952,"_25514":106953,"_2665":106954},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3170":64409,"_28022":64398,"_5":28341,"_19417":106956,"_25514":106957,"_2665":106958},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3170":64410,"_28022":64398,"_5":28341,"_19417":106960,"_25514":106961,"_2665":106962},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3170":64411,"_28022":64398,"_19417":106964,"_5":13306,"_25514":106921,"_2665":106965},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3170":64412,"_28022":64398,"_19417":106967,"_5":13306,"_25514":106921,"_2665":106968},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3170":64413,"_28022":64398,"_19417":106970,"_5":13306,"_25514":106925,"_2665":106971},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3170":64414,"_28022":64398,"_19417":106973,"_5":13306,"_25514":106925,"_2665":106974},[],"Fastlane instala o configura",{"_3170":64415,"_28022":64398,"_19417":106976,"_5":13306,"_25514":106925,"_2665":106977},[],"Tú sigues proporcionando",{"_3170":64416,"_28022":64398,"_19417":106979,"_5":13306,"_25514":106925,"_2665":106980},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3170":64417,"_28022":64398,"_19417":106982,"_5":13306,"_25514":106925,"_2665":106983},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3170":64418,"_28022":64398,"_19417":106985,"_5":13306,"_25514":106925,"_2665":106986},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3170":64419,"_28022":64398,"_19417":106988,"_5":13306,"_25514":106925,"_2665":106989},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3170":64420,"_28022":64398,"_19417":106991,"_5":13306,"_25514":106925,"_2665":106992},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3170":64421,"_28022":64398,"_19417":106994,"_5":13306,"_25514":106925,"_2665":106995},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3170":64422,"_28022":64398,"_19417":106997,"_5":13306,"_25514":106925,"_2665":106998},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3170":64423,"_28022":64398,"_19417":107000,"_5":13306,"_25514":106925,"_2665":107001},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3170":64424,"_28022":64398,"_19417":107003,"_5":13306,"_25514":106925,"_2665":107004},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3170":64425,"_28022":64398,"_19417":107006,"_5":13306,"_25514":106929,"_2665":107007},[],"Necesitas:",{"_3170":64426,"_28022":64398,"_19417":107009,"_5":13306,"_25514":106929,"_2665":107010},[],"un clúster Kubernetes existente",{"_3170":64427,"_28022":64398,"_19417":107012,"_5":13306,"_25514":106929,"_2665":107013},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3170":64428,"_28022":64398,"_19417":107015,"_5":13306,"_25514":106929,"_2665":45752},[],{"_3170":64429,"_28022":64398,"_19417":107017,"_5":13306,"_25514":106929,"_2665":21993},[],{"_3170":64430,"_28022":64398,"_19417":107019,"_5":13306,"_25514":106929,"_2665":107020},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3170":64431,"_28022":64398,"_19417":107022,"_5":13306,"_25514":106929,"_2665":107023},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3170":64432,"_28022":64398,"_19417":107025,"_5":13306,"_25514":106929,"_2665":107026},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3170":64433,"_28022":64398,"_19417":107028,"_5":13306,"_25514":106929,"_2665":107029},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3170":64434,"_28022":64398,"_19417":107031,"_5":13306,"_25514":106929,"_2665":107032},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3170":64435,"_28022":64398,"_19417":107034,"_5":13306,"_25514":106933,"_2665":107035},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3170":64436,"_28022":64398,"_19417":107037,"_5":13306,"_25514":106933,"_2665":107038},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3170":64437,"_28022":64398,"_19417":107040,"_5":13306,"_25514":106937,"_2665":107041},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3170":64438,"_28022":64398,"_19417":107043,"_5":13306,"_25514":106937,"_2665":107044},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3170":64439,"_28022":64398,"_19417":107046,"_5":13306,"_25514":106937,"_2665":107047},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3170":64440,"_28022":64398,"_19417":107049,"_5":13306,"_25514":106937,"_2665":107050},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3170":64441,"_28022":64398,"_19417":107052,"_5":13306,"_25514":106941,"_2665":107053},[],"Opción",{"_3170":64442,"_28022":64398,"_19417":107055,"_5":13306,"_25514":106941,"_2665":107056},[],"Valor predeterminado",{"_3170":64443,"_28022":64398,"_19417":107058,"_5":13306,"_25514":106941,"_2665":107059},[],"Propósito",{"_3170":64444,"_28022":64398,"_19417":107061,"_5":13306,"_25514":106941,"_2665":45799},[],{"_3170":64445,"_28022":64398,"_19417":107063,"_5":13306,"_25514":106941,"_2665":45802},[],{"_3170":64446,"_28022":64398,"_19417":107065,"_5":13306,"_25514":106941,"_2665":107066},[],"Muestra la ayuda",{"_3170":64447,"_28022":64398,"_19417":107068,"_5":13306,"_25514":106941,"_2665":45808},[],{"_3170":64448,"_28022":64398,"_19417":107070,"_5":13306,"_25514":106941,"_2665":107071},[],"contexto actual",{"_3170":64449,"_28022":64398,"_19417":107073,"_5":13306,"_25514":106941,"_2665":107074},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3170":64450,"_28022":64398,"_19417":107076,"_5":13306,"_25514":106941,"_2665":45817},[],{"_3170":64451,"_28022":64398,"_19417":107078,"_5":13306,"_25514":106941,"_2665":5961},[],{"_3170":64452,"_28022":64398,"_19417":107080,"_5":13306,"_25514":106941,"_2665":107081},[],"Omite prompts y genera credenciales para las dependencias",{"_3170":64453,"_28022":64398,"_19417":107083,"_5":13306,"_25514":106941,"_2665":45825},[],{"_3170":64454,"_28022":64398,"_19417":107085,"_5":13306,"_25514":106941,"_2665":45828},[],{"_3170":64455,"_28022":64398,"_19417":107087,"_5":13306,"_25514":106941,"_2665":107088},[],"Namespace de la instalación",{"_3170":64456,"_28022":64398,"_19417":107090,"_5":13306,"_25514":106941,"_2665":45834},[],{"_3170":64457,"_28022":64398,"_19417":107092,"_5":13306,"_25514":106941,"_2665":45837},[],{"_3170":64458,"_28022":64398,"_19417":107094,"_5":13306,"_25514":106941,"_2665":107095},[],"Dominio usado por la UI, OIDC y el certificado",{"_3170":64459,"_28022":64398,"_19417":107097,"_5":13306,"_25514":106941,"_2665":45843},[],{"_3170":64460,"_28022":64398,"_19417":107099,"_5":13306,"_25514":106941,"_2665":13931},[],{"_3170":64461,"_28022":64398,"_19417":107101,"_5":13306,"_25514":106941,"_2665":107102},[],"Versión del chart de Lamassu",{"_3170":64462,"_28022":64398,"_19417":107104,"_5":13306,"_25514":106941,"_2665":45851},[],{"_3170":64463,"_28022":64398,"_19417":107106,"_5":13306,"_25514":106941,"_2665":45854},[],{"_3170":64464,"_28022":64398,"_19417":107108,"_5":13306,"_25514":106941,"_2665":107109},[],"Puerto del listener HTTPS",{"_3170":64465,"_28022":64398,"_19417":107111,"_5":13306,"_25514":106941,"_2665":45860},[],{"_3170":64466,"_28022":64398,"_19417":107113,"_5":13306,"_25514":106941,"_2665":45863},[],{"_3170":64467,"_28022":64398,"_19417":107115,"_5":13306,"_25514":106941,"_2665":107116},[],"Puerto del listener HTTP",{"_3170":64468,"_28022":64398,"_19417":107118,"_5":13306,"_25514":106941,"_2665":45869},[],{"_3170":64469,"_28022":64398,"_19417":107120,"_5":13306,"_25514":106941,"_2665":45802},[],{"_3170":64470,"_28022":64398,"_19417":107122,"_5":13306,"_25514":106941,"_2665":107123},[],"Certificado PEM para TLS downstream",{"_3170":64471,"_28022":64398,"_19417":107125,"_5":13306,"_25514":106941,"_2665":45877},[],{"_3170":64472,"_28022":64398,"_19417":107127,"_5":13306,"_25514":106941,"_2665":45802},[],{"_3170":64473,"_28022":64398,"_19417":107129,"_5":13306,"_25514":106941,"_2665":107130},[],"Clave privada PEM para TLS downstream",{"_3170":64474,"_28022":64398,"_19417":107132,"_5":13306,"_25514":106941,"_2665":45885},[],{"_3170":64475,"_28022":64398,"_19417":107134,"_5":13306,"_25514":106941,"_2665":107135},[],"chart del repositorio",{"_3170":64476,"_28022":64398,"_19417":107137,"_5":13306,"_25514":106941,"_2665":107138},[],"Usa un chart local de Lamassu sin empaquetar",{"_3170":64477,"_28022":64398,"_19417":107140,"_5":13306,"_25514":106941,"_2665":45894},[],{"_3170":64478,"_28022":64398,"_19417":107142,"_5":13306,"_25514":106941,"_2665":107143},[],"detección automática",{"_3170":64479,"_28022":64398,"_19417":107145,"_5":13306,"_25514":106941,"_2665":107146},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3170":64480,"_28022":64398,"_19417":107148,"_5":13306,"_25514":106941,"_2665":45902},[],{"_3170":64481,"_28022":64398,"_19417":107150,"_5":13306,"_25514":106941,"_2665":5961},[],{"_3170":64482,"_28022":64398,"_19417":107152,"_5":13306,"_25514":106941,"_2665":107153},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3170":64483,"_28022":64398,"_19417":107155,"_5":13306,"_25514":106941,"_2665":45910},[],{"_3170":64484,"_28022":64398,"_19417":107157,"_5":13306,"_25514":106941,"_2665":5961},[],{"_3170":64485,"_28022":64398,"_19417":107159,"_5":13306,"_25514":106941,"_2665":107160},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3170":64486,"_28022":64398,"_19417":107162,"_5":13306,"_25514":106941,"_2665":45918},[],{"_3170":64487,"_28022":64398,"_19417":107164,"_5":13306,"_25514":106941,"_2665":5961},[],{"_3170":64488,"_28022":64398,"_19417":107166,"_5":13306,"_25514":106941,"_2665":107167},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3170":64489,"_28022":64398,"_19417":107169,"_5":13306,"_25514":106941,"_2665":45926},[],{"_3170":64490,"_28022":64398,"_19417":107171,"_5":13306,"_25514":106941,"_2665":5961},[],{"_3170":64491,"_28022":64398,"_19417":107173,"_5":13306,"_25514":106941,"_2665":107174},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3170":64492,"_28022":64398,"_19417":107176,"_5":13306,"_25514":106941,"_2665":45934},[],{"_3170":64493,"_28022":64398,"_19417":107178,"_5":13306,"_25514":106941,"_2665":45937},[],{"_3170":64494,"_28022":64398,"_19417":107180,"_5":13306,"_25514":106941,"_2665":107181},[],"Usa otro chart local de SoftHSM",{"_3170":64495,"_28022":64398,"_19417":107183,"_5":13306,"_25514":106941,"_2665":107184},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3170":64496,"_28022":64398,"_19417":107186,"_5":13306,"_25514":106945,"_2665":107187},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3170":64497,"_28022":64398,"_19417":107189,"_5":13306,"_25514":106945,"_2665":107190},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3170":64498,"_28022":64398,"_19417":107192,"_5":13306,"_25514":106945,"_2665":107193},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3170":64499,"_28022":64398,"_19417":107195,"_5":13306,"_25514":106945,"_2665":107196},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3170":64500,"_28022":64398,"_19417":107198,"_5":13306,"_25514":106945,"_2665":107199},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3170":64501,"_28022":64398,"_19417":107201,"_5":13306,"_25514":106945,"_2665":107202},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3170":64502,"_28022":64398,"_19417":107204,"_5":13306,"_25514":106949,"_2665":45964},[],{"_3170":64503,"_28022":64398,"_19417":107206,"_5":13306,"_25514":106949,"_2665":107207},[],"valida las herramientas locales y el clúster seleccionado",{"_3170":64504,"_28022":64398,"_19417":107209,"_5":13306,"_25514":106949,"_2665":107210},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3170":64505,"_28022":64398,"_19417":107212,"_5":13306,"_25514":106949,"_2665":107213},[],"crea el namespace",{"_3170":64506,"_28022":64398,"_19417":107215,"_5":13306,"_25514":106949,"_2665":107216},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3170":64507,"_28022":64398,"_19417":107218,"_5":13306,"_25514":106949,"_2665":107219},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3170":64508,"_28022":64398,"_19417":107221,"_5":13306,"_25514":106949,"_2665":107222},[],"instala RabbitMQ",{"_3170":64509,"_28022":64398,"_19417":107224,"_5":13306,"_25514":106949,"_2665":107225},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3170":64510,"_28022":64398,"_19417":107227,"_5":13306,"_25514":106949,"_2665":107228},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3170":64511,"_28022":64398,"_19417":107230,"_5":13306,"_25514":106949,"_2665":107231},[],"carga datos de ejemplo opcionalmente",{"_3170":64512,"_28022":64398,"_19417":107233,"_5":13306,"_25514":106949,"_2665":107234},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3170":64513,"_28022":64398,"_19417":107236,"_5":13306,"_25514":106953,"_2665":107237},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3170":64514,"_28022":64398,"_19417":107239,"_5":13306,"_25514":106953,"_2665":107240},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3170":64515,"_28022":64398,"_19417":107242,"_5":13306,"_25514":106957,"_2665":107243},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3170":64516,"_28022":64398,"_19417":107245,"_5":13306,"_25514":106957,"_2665":107246},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3170":64517,"_28022":64398,"_19417":107248,"_5":13306,"_25514":106957,"_2665":107249},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3170":64518,"_28022":64398,"_19417":107251,"_5":13306,"_25514":106961,"_2665":107252},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3170":64519,"_28022":64519,"_5":13637,"_2665":107254,"_28344":107255,"_19417":107256,"_25514":64519},"Instala con Helm",[45406,106680,106914],[],{"_3170":64520,"_28022":64519,"_19417":107258,"_5":13306,"_25514":64519,"_2665":107259},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3170":64521,"_28022":64519,"_5":28341,"_19417":107261,"_25514":107262,"_2665":107263},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3170":64522,"_28022":64519,"_5":28341,"_19417":107265,"_25514":107266,"_2665":106930},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3170":64523,"_28022":64519,"_5":28341,"_19417":107268,"_25514":107269,"_2665":107270},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3170":64524,"_28022":64519,"_5":28341,"_19417":107272,"_25514":107273,"_2665":107274},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3170":64525,"_28022":64519,"_5":28341,"_19417":107276,"_25514":107277,"_2665":107278},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3170":64526,"_28022":64519,"_5":28341,"_19417":107280,"_25514":107281,"_2665":107282},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3170":64527,"_28022":64519,"_5":28341,"_19417":107284,"_25514":107285,"_2665":107286},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3170":64528,"_28022":64519,"_5":28341,"_19417":107288,"_25514":107289,"_2665":107290},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3170":64529,"_28022":64519,"_5":28341,"_19417":107292,"_25514":107293,"_2665":107294},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3170":64530,"_28022":64519,"_19417":107296,"_5":13306,"_25514":107262,"_2665":107297},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3170":64531,"_28022":64519,"_19417":107299,"_5":13306,"_25514":107266,"_2665":107300},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3170":64532,"_28022":64519,"_19417":107302,"_5":13306,"_25514":107266,"_2665":107303},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3170":64533,"_28022":64519,"_19417":107305,"_5":13306,"_25514":107266,"_2665":107306},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3170":64534,"_28022":64519,"_19417":107308,"_5":13306,"_25514":107266,"_2665":107309},[],"un broker RabbitMQ accesible y sus credenciales",{"_3170":64535,"_28022":64519,"_19417":107311,"_5":13306,"_25514":107266,"_2665":107312},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3170":64536,"_28022":64519,"_19417":107314,"_5":13306,"_25514":107266,"_2665":107315},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3170":64537,"_28022":64519,"_19417":107317,"_5":13306,"_25514":107266,"_2665":107318},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3170":64538,"_28022":64519,"_19417":107320,"_5":13306,"_25514":107266,"_2665":107321},[],"una StorageClass y un diseño de tráfico externo",{"_3170":64539,"_28022":64519,"_19417":107323,"_5":13306,"_25514":107266,"_2665":107324},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3170":64540,"_28022":64519,"_19417":107326,"_5":13306,"_25514":107266,"_2665":107327},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3170":64541,"_28022":64519,"_19417":107329,"_5":13306,"_25514":107266,"_2665":107330},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3170":64542,"_28022":64519,"_19417":107332,"_5":13306,"_25514":107269,"_2665":107333},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3170":64543,"_28022":64519,"_19417":107335,"_5":13306,"_25514":107269,"_2665":107336},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3170":64544,"_28022":64519,"_19417":107338,"_5":13306,"_25514":107269,"_2665":107339},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3170":64545,"_28022":64519,"_19417":107341,"_5":13306,"_25514":107273,"_2665":107342},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3170":64546,"_28022":64519,"_19417":107344,"_5":13306,"_25514":107273,"_2665":107345},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3170":64547,"_28022":64519,"_19417":107347,"_5":13306,"_25514":107273,"_2665":107348},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3170":64548,"_28022":64519,"_19417":107350,"_5":13306,"_25514":107277,"_2665":107351},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3170":64549,"_28022":64519,"_19417":107353,"_5":13306,"_25514":107281,"_2665":107354},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3170":64550,"_28022":64519,"_19417":107356,"_5":13306,"_25514":107281,"_2665":107357},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3170":64551,"_28022":64519,"_19417":107359,"_5":13306,"_25514":107281,"_2665":107360},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3170":64552,"_28022":64519,"_19417":107362,"_5":13306,"_25514":107281,"_2665":107363},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3170":64553,"_28022":64519,"_19417":107365,"_5":13306,"_25514":107285,"_2665":107366},[],"Para instalar un checkout local:",{"_3170":64554,"_28022":64519,"_19417":107368,"_5":13306,"_25514":107289,"_2665":107369},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3170":64555,"_28022":64519,"_19417":107371,"_5":13306,"_25514":107289,"_2665":107372},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3170":64556,"_28022":64519,"_19417":107374,"_5":13306,"_25514":107293,"_2665":107375},[],"Antes de pasar a producción, revisa:",{"_3170":64557,"_28022":64519,"_19417":107377,"_5":13306,"_25514":107293,"_2665":107378},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3170":64558,"_28022":64519,"_19417":107380,"_5":13306,"_25514":107293,"_2665":107381},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3170":64559,"_28022":64519,"_19417":107383,"_5":13306,"_25514":107293,"_2665":107384},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3170":64560,"_28022":64519,"_19417":107386,"_5":13306,"_25514":107293,"_2665":107387},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3170":64561,"_28022":64519,"_19417":107389,"_5":13306,"_25514":107293,"_2665":107390},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3170":64562,"_28022":64519,"_19417":107392,"_5":13306,"_25514":107293,"_2665":107393},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3170":64563,"_28022":64519,"_19417":107395,"_5":13306,"_25514":107293,"_2665":107396},[],"SMTP, observabilidad y entrega de alertas",{"_3170":64564,"_28022":64519,"_19417":107398,"_5":13306,"_25514":107293,"_2665":107399},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3170":64565,"_28022":64519,"_19417":107401,"_5":13306,"_25514":107293,"_2665":107402},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3170":64566,"_28022":64566,"_5":13637,"_2665":107404,"_28344":107405,"_19417":107406,"_25514":64566},"Expón el Gateway",[45406,106680,106914],[],{"_3170":64567,"_28022":64566,"_19417":107408,"_5":13306,"_25514":64566,"_2665":107409},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3170":64568,"_28022":64566,"_5":28341,"_19417":107411,"_25514":107412,"_2665":107413},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3170":64569,"_28022":64566,"_5":28341,"_19417":107415,"_25514":107416,"_2665":107417},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3170":64570,"_28022":64566,"_5":28341,"_19417":107419,"_25514":107420,"_2665":107421},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3170":64571,"_28022":64566,"_5":28341,"_19417":107423,"_25514":107424,"_2665":46185},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3170":64572,"_28022":64566,"_5":28341,"_19417":107426,"_25514":107427,"_2665":107428},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3170":64573,"_28022":64566,"_5":28341,"_19417":107430,"_25514":107431,"_2665":107432},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3170":64574,"_28022":64566,"_5":28341,"_19417":107434,"_25514":107435,"_2665":107436},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3170":64575,"_28022":64566,"_5":28341,"_19417":107438,"_25514":107439,"_2665":107440},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3170":64576,"_28022":64566,"_5":28341,"_19417":107442,"_25514":107443,"_2665":107444},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3170":64577,"_28022":64566,"_5":28341,"_19417":107446,"_25514":107447,"_2665":107448},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3170":64578,"_28022":64566,"_19417":107450,"_5":13306,"_25514":107412,"_2665":107451},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3170":64579,"_28022":64566,"_19417":107453,"_5":13306,"_25514":107412,"_2665":107454},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3170":64580,"_28022":64566,"_19417":107456,"_5":13306,"_25514":107416,"_2665":107457},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3170":64581,"_28022":64566,"_19417":107459,"_5":13306,"_25514":107416,"_2665":107460},[],"Defínelo únicamente cuando:",{"_3170":64582,"_28022":64566,"_19417":107462,"_5":13306,"_25514":107416,"_2665":107463},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3170":64583,"_28022":64566,"_19417":107465,"_5":13306,"_25514":107416,"_2665":107466},[],"esa dirección está asignada a este Gateway",{"_3170":64584,"_28022":64566,"_19417":107468,"_5":13306,"_25514":107416,"_2665":107469},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3170":64585,"_28022":64566,"_19417":107471,"_5":13306,"_25514":107416,"_2665":107472},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3170":64586,"_28022":64566,"_19417":107474,"_5":13306,"_25514":107416,"_2665":107475},[],"No confundas estos valores:",{"_3170":64587,"_28022":64566,"_19417":107477,"_5":13306,"_25514":107416,"_2665":107478},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3170":64588,"_28022":64566,"_19417":107480,"_5":13306,"_25514":107416,"_2665":107481},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3170":64589,"_28022":64566,"_19417":107483,"_5":13306,"_25514":107416,"_2665":107484},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3170":64590,"_28022":64566,"_19417":107486,"_5":13306,"_25514":107420,"_2665":107487},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3170":64591,"_28022":64566,"_19417":107489,"_5":13306,"_25514":107420,"_2665":107490},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3170":64592,"_28022":64566,"_19417":107492,"_5":13306,"_25514":107424,"_2665":107493},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3170":64593,"_28022":64566,"_19417":107495,"_5":13306,"_25514":107424,"_2665":107496},[],"Para el diseño recomendado:",{"_3170":64594,"_28022":64566,"_19417":107498,"_5":13306,"_25514":107424,"_2665":107499},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3170":64595,"_28022":64566,"_19417":107501,"_5":13306,"_25514":107424,"_2665":107502},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3170":64596,"_28022":64566,"_19417":107504,"_5":13306,"_25514":107424,"_2665":107505},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3170":64597,"_28022":64566,"_19417":107507,"_5":13306,"_25514":107424,"_2665":107508},[],"Apunta DNS a la dirección accesible de la VM.",{"_3170":64598,"_28022":64566,"_19417":107510,"_5":13306,"_25514":107424,"_2665":107511},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3170":64599,"_28022":64566,"_19417":107513,"_5":13306,"_25514":107427,"_2665":107514},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3170":64600,"_28022":64566,"_19417":107516,"_5":13306,"_25514":107431,"_2665":107517},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3170":64601,"_28022":64566,"_19417":107519,"_5":13306,"_25514":107431,"_2665":107520},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3170":64602,"_28022":64566,"_19417":107522,"_5":13306,"_25514":107435,"_2665":107523},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3170":64603,"_28022":64566,"_19417":107525,"_5":13306,"_25514":107435,"_2665":107526},[],"Requisito",{"_3170":64604,"_28022":64566,"_19417":107528,"_5":13306,"_25514":107435,"_2665":107529},[],"Diseño recomendado",{"_3170":64605,"_28022":64566,"_19417":107531,"_5":13306,"_25514":107435,"_2665":107532},[],"Consecuencia",{"_3170":64606,"_28022":64566,"_19417":107534,"_5":13306,"_25514":107435,"_2665":107535},[],"Varias URL o servicios de Lamassu",{"_3170":64607,"_28022":64566,"_19417":107537,"_5":13306,"_25514":107435,"_2665":107538},[],"Un Gateway con varias rutas",{"_3170":64608,"_28022":64566,"_19417":107540,"_5":13306,"_25514":107435,"_2665":107541},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3170":64609,"_28022":64566,"_19417":107543,"_5":13306,"_25514":107435,"_2665":107544},[],"Gateways independientes e IP externas distintas",{"_3170":64610,"_28022":64566,"_19417":107546,"_5":13306,"_25514":107435,"_2665":107547},[],"Una VIP por Gateway",{"_3170":64611,"_28022":64566,"_19417":107549,"_5":13306,"_25514":107435,"_2665":107550},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3170":64612,"_28022":64566,"_19417":107552,"_5":13306,"_25514":107435,"_2665":107553},[],"Gateways independientes, un nodo y una IP",{"_3170":64613,"_28022":64566,"_19417":107555,"_5":13306,"_25514":107435,"_2665":107556},[],"Puertos externos diferentes",{"_3170":64614,"_28022":64566,"_19417":107558,"_5":13306,"_25514":107435,"_2665":107559},[],"Los clientes deben indicar puertos no estándar",{"_3170":64615,"_28022":64566,"_19417":107561,"_5":13306,"_25514":107435,"_2665":107562},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3170":64616,"_28022":64566,"_19417":107564,"_5":13306,"_25514":107435,"_2665":107565},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3170":64617,"_28022":64566,"_19417":107567,"_5":13306,"_25514":107435,"_2665":107568},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3170":64618,"_28022":64566,"_19417":107570,"_5":13306,"_25514":107435,"_2665":107571},[],"Recursos Gateway separados pero proxy compartido",{"_3170":64619,"_28022":64566,"_19417":107573,"_5":13306,"_25514":107435,"_2665":107574},[],"Modo merged Gateway de Envoy",{"_3170":64620,"_28022":64566,"_19417":107576,"_5":13306,"_25514":107435,"_2665":107577},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3170":64621,"_28022":64566,"_19417":107579,"_5":13306,"_25514":107435,"_2665":107580},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3170":64622,"_28022":64566,"_19417":107582,"_5":13306,"_25514":107435,"_2665":107583},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3170":64623,"_28022":64566,"_19417":107585,"_5":13306,"_25514":107435,"_2665":107586},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3170":64624,"_28022":64566,"_19417":107588,"_5":13306,"_25514":107435,"_2665":107589},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3170":64625,"_28022":64566,"_19417":107591,"_5":13306,"_25514":107439,"_2665":107592},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3170":64626,"_28022":64566,"_19417":107594,"_5":13306,"_25514":107439,"_2665":107595},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3170":64627,"_28022":64566,"_19417":107597,"_5":13306,"_25514":107439,"_2665":107598},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3170":64628,"_28022":64566,"_19417":107600,"_5":13306,"_25514":107439,"_2665":107601},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3170":64629,"_28022":64566,"_19417":107603,"_5":13306,"_25514":107439,"_2665":107604},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3170":64630,"_28022":64566,"_19417":107606,"_5":13306,"_25514":107443,"_2665":107607},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3170":64631,"_28022":64566,"_19417":107609,"_5":13306,"_25514":107443,"_2665":107610},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3170":64632,"_28022":64566,"_19417":107612,"_5":13306,"_25514":107447,"_2665":107613},[],"Comprueba, en orden:",{"_3170":64633,"_28022":64566,"_19417":107615,"_5":13306,"_25514":107447,"_2665":107616},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3170":64634,"_28022":64566,"_19417":107618,"_5":13306,"_25514":107447,"_2665":107619},[],"Su estado contiene la dirección esperada.",{"_3170":64635,"_28022":64566,"_19417":107621,"_5":13306,"_25514":107447,"_2665":107622},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3170":64636,"_28022":64566,"_19417":107624,"_5":13306,"_25514":107447,"_2665":107625},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3170":64637,"_28022":64566,"_19417":107627,"_5":13306,"_25514":107447,"_2665":107628},[],"DNS resuelve al endpoint accesible externamente.",{"_3170":64638,"_28022":64566,"_19417":107630,"_5":13306,"_25514":107447,"_2665":107631},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3170":64639,"_28022":64566,"_19417":107633,"_5":13306,"_25514":107447,"_2665":107634},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3170":64640,"_28022":64640,"_5":13637,"_2665":45513,"_28344":107636,"_19417":107637,"_25514":64640},[45406,106680,106914],[],{"_3170":64641,"_28022":64640,"_19417":107639,"_5":13306,"_25514":64640,"_2665":107640},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3170":64642,"_28022":64640,"_5":28341,"_19417":107642,"_25514":107643,"_2665":107644},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3170":64643,"_28022":64640,"_5":28341,"_19417":107646,"_25514":107647,"_2665":107648},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3170":64644,"_28022":64640,"_5":28341,"_19417":107650,"_25514":107651,"_2665":107652},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3170":64645,"_28022":64640,"_5":28341,"_19417":107654,"_25514":107655,"_2665":107656},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3170":64646,"_28022":64640,"_5":28341,"_19417":107658,"_25514":107659,"_2665":107660},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3170":64647,"_28022":64640,"_5":28341,"_19417":107662,"_25514":107663,"_2665":107664},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3170":64648,"_28022":64640,"_19417":107666,"_5":13306,"_25514":107643,"_2665":107667},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3170":64649,"_28022":64640,"_19417":107669,"_5":13306,"_25514":107647,"_2665":107670},[],"Flujo",{"_3170":64650,"_28022":64640,"_19417":107672,"_5":13306,"_25514":107647,"_2665":107673},[],"Úsalo para",{"_3170":64651,"_28022":64640,"_19417":107675,"_5":13306,"_25514":107647,"_2665":107676},[],"Qué instala",{"_3170":64652,"_28022":64640,"_19417":107678,"_5":13306,"_25514":107647,"_2665":46440},[],{"_3170":64653,"_28022":64640,"_19417":107680,"_5":13306,"_25514":107647,"_2665":107681},[],"Producción y entornos controlados",{"_3170":64654,"_28022":64640,"_19417":107683,"_5":13306,"_25514":107647,"_2665":107684},[],"Servicios de Lamassu y recursos de Gateway API",{"_3170":64655,"_28022":64640,"_19417":107686,"_5":13306,"_25514":107647,"_2665":45650},[],{"_3170":64656,"_28022":64640,"_19417":107688,"_5":13306,"_25514":107647,"_2665":107689},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3170":64657,"_28022":64640,"_19417":107691,"_5":13306,"_25514":107647,"_2665":107692},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3170":64658,"_28022":64640,"_19417":107694,"_5":13306,"_25514":107651,"_2665":107695},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3170":64659,"_28022":64640,"_19417":107697,"_5":13306,"_25514":107651,"_2665":107698},[],"Área",{"_3170":64660,"_28022":64640,"_19417":107700,"_5":13306,"_25514":107651,"_2665":107701},[],"El chart de Lamassu proporciona",{"_3170":64661,"_28022":64640,"_19417":107703,"_5":13306,"_25514":107651,"_2665":107704},[],"Tú proporcionas",{"_3170":64662,"_28022":64640,"_19417":107706,"_5":13306,"_25514":107651,"_2665":107707},[],"Aplicaciones Lamassu",{"_3170":64663,"_28022":64640,"_19417":107709,"_5":13306,"_25514":107651,"_2665":107710},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3170":64664,"_28022":64640,"_19417":107712,"_5":13306,"_25514":107651,"_2665":107713},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3170":64665,"_28022":64640,"_19417":107715,"_5":13306,"_25514":107651,"_2665":107716},[],"Datos PostgreSQL",{"_3170":64666,"_28022":64640,"_19417":107718,"_5":13306,"_25514":107651,"_2665":107719},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3170":64667,"_28022":64640,"_19417":107721,"_5":13306,"_25514":107651,"_2665":107722},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3170":64668,"_28022":64640,"_19417":107724,"_5":13306,"_25514":107651,"_2665":107725},[],"Mensajería",{"_3170":64669,"_28022":64640,"_19417":107727,"_5":13306,"_25514":107651,"_2665":107728},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_3170":64670,"_28022":64640,"_19417":107730,"_5":13306,"_25514":107651,"_2665":107731},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3170":64671,"_28022":64640,"_19417":107733,"_5":13306,"_25514":107651,"_2665":107734},[],"Identidad",{"_3170":64672,"_28022":64640,"_19417":107736,"_5":13306,"_25514":107651,"_2665":107737},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3170":64673,"_28022":64640,"_19417":107739,"_5":13306,"_25514":107651,"_2665":107740},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3170":64674,"_28022":64640,"_19417":107742,"_5":13306,"_25514":107651,"_2665":107743},[],"Enrutamiento externo",{"_3170":64675,"_28022":64640,"_19417":107745,"_5":13306,"_25514":107651,"_2665":107746},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3170":64676,"_28022":64640,"_19417":107748,"_5":13306,"_25514":107651,"_2665":107749},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3170":64677,"_28022":64640,"_19417":107751,"_5":13306,"_25514":107651,"_2665":46514},[],{"_3170":64678,"_28022":64640,"_19417":107753,"_5":13306,"_25514":107651,"_2665":107754},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3170":64679,"_28022":64640,"_19417":107756,"_5":13306,"_25514":107651,"_2665":107757},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3170":64680,"_28022":64640,"_19417":107759,"_5":13306,"_25514":107651,"_2665":107760},[],"Datos persistentes de la aplicación",{"_3170":64681,"_28022":64640,"_19417":107762,"_5":13306,"_25514":107651,"_2665":107763},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3170":64682,"_28022":64640,"_19417":107765,"_5":13306,"_25514":107651,"_2665":107766},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3170":64683,"_28022":64640,"_19417":107768,"_5":13306,"_25514":107651,"_2665":107769},[],"Integraciones opcionales",{"_3170":64684,"_28022":64640,"_19417":107771,"_5":13306,"_25514":107651,"_2665":107772},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3170":64685,"_28022":64640,"_19417":107774,"_5":13306,"_25514":107651,"_2665":107775},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3170":64686,"_28022":64640,"_19417":107777,"_5":13306,"_25514":107651,"_2665":107778},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3170":64687,"_28022":64640,"_19417":107780,"_5":13306,"_25514":107651,"_2665":107781},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3170":64688,"_28022":64640,"_19417":107783,"_5":13306,"_25514":107655,"_2665":107784},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3170":64689,"_28022":64640,"_19417":107786,"_5":13306,"_25514":107655,"_2665":107787},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3170":64690,"_28022":64640,"_19417":107789,"_5":13306,"_25514":107659,"_2665":107790},[],"Kubernetes 1.24 o posterior",{"_3170":64691,"_28022":64640,"_19417":107792,"_5":13306,"_25514":107659,"_2665":107793},[],"Helm 3.2 o posterior",{"_3170":64692,"_28022":64640,"_19417":107795,"_5":13306,"_25514":107659,"_2665":107796},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3170":64693,"_28022":64640,"_19417":107798,"_5":13306,"_25514":107659,"_2665":107799},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3170":64694,"_28022":64640,"_19417":107801,"_5":13306,"_25514":107659,"_2665":107802},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3170":64695,"_28022":64640,"_19417":107804,"_5":13306,"_25514":107659,"_2665":107805},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3170":64696,"_28022":64640,"_19417":107807,"_5":13306,"_25514":107659,"_2665":107808},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3170":64697,"_28022":64640,"_19417":107810,"_5":13306,"_25514":107663,"_2665":107811},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":64698,"_28022":64640,"_19417":107813,"_5":13306,"_25514":107663,"_2665":107814},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3170":64699,"_28022":64640,"_19417":107816,"_5":13306,"_25514":107663,"_2665":107817},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3170":64700,"_28022":64640,"_19417":107819,"_5":13306,"_25514":107663,"_2665":107820},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3170":64701,"_28022":64701,"_5":13637,"_2665":107822,"_28344":107823,"_19417":107825,"_25514":64701},"Resolución de problemas de despliegue",[45406,106680,107824],"Operación",[],{"_3170":64702,"_28022":64701,"_19417":107827,"_5":13306,"_25514":64701,"_2665":107828},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3170":64703,"_28022":64701,"_5":28341,"_19417":107830,"_25514":107831,"_2665":107832},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3170":64704,"_28022":64701,"_5":28341,"_19417":107834,"_25514":107835,"_2665":107836},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3170":64705,"_28022":64701,"_5":28341,"_19417":107838,"_25514":107839,"_2665":107840},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3170":64706,"_28022":64701,"_5":28341,"_19417":107842,"_25514":107843,"_2665":107844},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3170":64707,"_28022":64701,"_5":28341,"_19417":107846,"_25514":107847,"_2665":107848},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3170":64708,"_28022":64701,"_5":28341,"_19417":107850,"_25514":107851,"_2665":107852},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3170":64709,"_28022":64701,"_5":28341,"_19417":107854,"_25514":107855,"_2665":107856},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3170":64710,"_28022":64701,"_5":28341,"_19417":107858,"_25514":107859,"_2665":107860},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3170":64711,"_28022":64701,"_5":28341,"_19417":107862,"_25514":107863,"_2665":107864},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3170":64712,"_28022":64701,"_5":28341,"_19417":107866,"_25514":107867,"_2665":107868},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3170":64713,"_28022":64701,"_5":28341,"_19417":107870,"_25514":107871,"_2665":107872},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3170":64714,"_28022":64701,"_5":28341,"_19417":107874,"_25514":107875,"_2665":107876},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3170":64715,"_28022":64701,"_19417":107878,"_5":13306,"_25514":64701,"_2665":107879},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3170":64716,"_28022":64701,"_19417":107881,"_5":13306,"_25514":107835,"_2665":107882},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3170":64717,"_28022":64701,"_19417":107884,"_5":13306,"_25514":107839,"_2665":107885},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3170":64718,"_28022":64701,"_19417":107887,"_5":13306,"_25514":107843,"_2665":107888},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3170":64719,"_28022":64701,"_19417":107890,"_5":13306,"_25514":107847,"_2665":107891},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3170":64720,"_28022":64701,"_19417":107893,"_5":13306,"_25514":107851,"_2665":107894},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3170":64721,"_28022":64701,"_19417":107896,"_5":13306,"_25514":107855,"_2665":107897},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3170":64722,"_28022":64701,"_19417":107899,"_5":13306,"_25514":107855,"_2665":107900},[],"Ejecuta también la prueba de conectividad del chart:",{"_3170":64723,"_28022":64701,"_19417":107902,"_5":13306,"_25514":107855,"_2665":107903},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3170":64724,"_28022":64701,"_19417":107905,"_5":13306,"_25514":107855,"_2665":107906},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3170":64725,"_28022":64701,"_19417":107908,"_5":13306,"_25514":107859,"_2665":107909},[],"Si recibes un 401:",{"_3170":64726,"_28022":64701,"_19417":107911,"_5":13306,"_25514":107859,"_2665":107912},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3170":64727,"_28022":64701,"_19417":107914,"_5":13306,"_25514":107859,"_2665":107915},[],"verifica emisor, audiencia y expiración del token;",{"_3170":64728,"_28022":64701,"_19417":107917,"_5":13306,"_25514":107859,"_2665":107918},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3170":64729,"_28022":64701,"_19417":107920,"_5":13306,"_25514":107859,"_2665":107921},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3170":64730,"_28022":64701,"_19417":107923,"_5":13306,"_25514":107859,"_2665":107924},[],"Si el login termina pero las APIs devuelven 403:",{"_3170":64731,"_28022":64701,"_19417":107926,"_5":13306,"_25514":107859,"_2665":107927},[],"inspecciona los claims reales del token;",{"_3170":64732,"_28022":64701,"_19417":107929,"_5":13306,"_25514":107859,"_2665":107930},[],"confirma que coinciden con un principal activo;",{"_3170":64733,"_28022":64701,"_19417":107932,"_5":13306,"_25514":107859,"_2665":107933},[],"revisa las políticas concedidas al principal;",{"_3170":64734,"_28022":64701,"_19417":107935,"_5":13306,"_25514":107859,"_2665":107936},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3170":64735,"_28022":64701,"_19417":107938,"_5":13306,"_25514":107859,"_2665":107939},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3170":64736,"_28022":64701,"_19417":107941,"_5":13306,"_25514":107863,"_2665":107942},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3170":64737,"_28022":64701,"_19417":107944,"_5":13306,"_25514":107863,"_2665":107945},[],"Localiza el pod y Service de authz.",{"_3170":64738,"_28022":64701,"_19417":107947,"_5":13306,"_25514":107863,"_2665":107948},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3170":64739,"_28022":64701,"_19417":107950,"_5":13306,"_25514":107863,"_2665":107951},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3170":64740,"_28022":64701,"_19417":107953,"_5":13306,"_25514":107863,"_2665":107954},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3170":64741,"_28022":64701,"_19417":107956,"_5":13306,"_25514":107863,"_2665":107957},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3170":64742,"_28022":64701,"_19417":107959,"_5":13306,"_25514":107867,"_2665":107960},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3170":64743,"_28022":64701,"_19417":107962,"_5":13306,"_25514":107867,"_2665":107963},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3170":64744,"_28022":64701,"_19417":107965,"_5":13306,"_25514":107867,"_2665":107966},[],"volumen persistente sin enlazar;",{"_3170":64745,"_28022":64701,"_19417":107968,"_5":13306,"_25514":107867,"_2665":107969},[],"imagen inaccesible o política de pull incorrecta;",{"_3170":64746,"_28022":64701,"_19417":107971,"_5":13306,"_25514":107867,"_2665":107972},[],"configuración inválida del motor criptográfico;",{"_3170":64747,"_28022":64701,"_19417":107974,"_5":13306,"_25514":107867,"_2665":107975},[],"límites de CPU o memoria demasiado bajos;",{"_3170":64748,"_28022":64701,"_19417":107977,"_5":13306,"_25514":107867,"_2665":107978},[],"migración previa incompleta.",{"_3170":64749,"_28022":64701,"_19417":107980,"_5":13306,"_25514":107867,"_2665":107981},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3170":64750,"_28022":64701,"_19417":107983,"_5":13306,"_25514":107867,"_2665":107984},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3170":64751,"_28022":64701,"_19417":107986,"_5":13306,"_25514":107867,"_2665":107987},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3170":64752,"_28022":64701,"_19417":107989,"_5":13306,"_25514":107871,"_2665":107990},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3170":64753,"_28022":64701,"_19417":107992,"_5":13306,"_25514":107871,"_2665":107993},[],"verifica que esté habilitado en el servicio emisor;",{"_3170":64754,"_28022":64701,"_19417":107995,"_5":13306,"_25514":107871,"_2665":107996},[],"comprueba conectividad y credenciales AMQP;",{"_3170":64755,"_28022":64701,"_19417":107998,"_5":13306,"_25514":107871,"_2665":107999},[],"revisa exchange, routing key, colas y consumidores;",{"_3170":64756,"_28022":64701,"_19417":108001,"_5":13306,"_25514":107871,"_2665":108002},[],"inspecciona dead-letter queues;",{"_3170":64757,"_28022":64701,"_19417":108004,"_5":13306,"_25514":107871,"_2665":108005},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3170":64758,"_28022":64701,"_19417":108007,"_5":13306,"_25514":107871,"_2665":108008},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3170":64759,"_28022":64701,"_19417":108010,"_5":13306,"_25514":107875,"_2665":108011},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3170":64760,"_28022":64701,"_19417":108013,"_5":13306,"_25514":107875,"_2665":108014},[],"Antes de cerrar una incidencia, guarda:",{"_3170":64761,"_28022":64701,"_19417":108016,"_5":13306,"_25514":107875,"_2665":108017},[],"causa confirmada;",{"_3170":64762,"_28022":64701,"_19417":108019,"_5":13306,"_25514":107875,"_2665":108020},[],"alcance temporal y recursos afectados;",{"_3170":64763,"_28022":64701,"_19417":108022,"_5":13306,"_25514":107875,"_2665":108023},[],"comandos o consultas utilizados;",{"_3170":64764,"_28022":64701,"_19417":108025,"_5":13306,"_25514":107875,"_2665":108026},[],"cambio aplicado y forma de revertirlo;",{"_3170":64765,"_28022":64701,"_19417":108028,"_5":13306,"_25514":107875,"_2665":108029},[],"validación desde un consumidor;",{"_3170":64766,"_28022":64701,"_19417":108031,"_5":13306,"_25514":107875,"_2665":108032},[],"acción preventiva y propietario.",{"_3170":64767,"_28022":64767,"_5":13637,"_2665":108034,"_28344":108035,"_19417":108038,"_25514":64767},"Control de acceso",[45406,108036,108037],"Plataforma","Administración",[],{"_3170":64768,"_28022":64767,"_19417":108040,"_5":13306,"_25514":64767,"_2665":108041},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3170":64769,"_28022":64767,"_5":28341,"_19417":108043,"_25514":108044,"_2665":108045},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3170":64770,"_28022":64767,"_5":28341,"_19417":108047,"_25514":108048,"_2665":108049},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3170":64771,"_28022":64767,"_5":28341,"_19417":108051,"_25514":108052,"_2665":108053},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3170":64772,"_28022":64767,"_5":28341,"_19417":108055,"_25514":108056,"_2665":108057},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3170":64773,"_28022":64767,"_5":28341,"_19417":108059,"_25514":108060,"_2665":108061},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3170":64774,"_28022":64767,"_5":28341,"_19417":108063,"_25514":108064,"_2665":108065},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3170":64775,"_28022":64767,"_5":28341,"_19417":108067,"_25514":108068,"_2665":108069},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3170":64776,"_28022":64767,"_5":28341,"_19417":108071,"_25514":108072,"_2665":108073},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3170":64777,"_28022":64767,"_5":28341,"_19417":108075,"_25514":108076,"_2665":108077},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3170":64778,"_28022":64767,"_5":28341,"_19417":108079,"_25514":108080,"_2665":108081},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3170":64779,"_28022":64767,"_5":28341,"_19417":108083,"_25514":108084,"_2665":108085},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3170":64780,"_28022":64767,"_5":28341,"_19417":108087,"_25514":108088,"_2665":108089},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3170":64781,"_28022":64767,"_5":28341,"_19417":108091,"_25514":108092,"_2665":108093},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3170":64782,"_28022":64767,"_5":28341,"_19417":108095,"_25514":108096,"_2665":108097},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3170":64783,"_28022":64767,"_5":28341,"_19417":108099,"_25514":108100,"_2665":108101},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3170":64784,"_28022":64767,"_5":28341,"_19417":108103,"_25514":108104,"_2665":107282},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3170":64785,"_28022":64767,"_5":28341,"_19417":108106,"_25514":108107,"_2665":108108},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3170":64786,"_28022":64767,"_5":28341,"_19417":108110,"_25514":108111,"_2665":108112},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3170":64787,"_28022":64767,"_5":28341,"_19417":108114,"_25514":108115,"_2665":108116},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3170":64788,"_28022":64767,"_5":28341,"_19417":108118,"_25514":108119,"_2665":108120},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3170":64789,"_28022":64767,"_5":28341,"_19417":108122,"_25514":108123,"_2665":108124},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3170":64790,"_28022":64767,"_5":28341,"_19417":108126,"_25514":108127,"_2665":108128},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3170":64791,"_28022":64767,"_5":28341,"_19417":108130,"_25514":108131,"_2665":108132},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3170":64792,"_28022":64767,"_5":28341,"_19417":108134,"_25514":108135,"_2665":108136},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3170":64793,"_28022":64767,"_5":28341,"_19417":108138,"_25514":108139,"_2665":108140},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3170":64794,"_28022":64767,"_5":28341,"_19417":108142,"_25514":108143,"_2665":108144},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3170":64795,"_28022":64767,"_5":28341,"_19417":108146,"_25514":108147,"_2665":108148},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3170":64796,"_28022":64767,"_5":28341,"_19417":108150,"_25514":108151,"_2665":108152},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3170":64797,"_28022":64767,"_5":28341,"_19417":108154,"_25514":108155,"_2665":108156},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3170":64798,"_28022":64767,"_5":28341,"_19417":108158,"_25514":108159,"_2665":108160},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3170":64799,"_28022":64767,"_5":28341,"_19417":108162,"_25514":108163,"_2665":108164},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3170":64800,"_28022":64767,"_19417":108166,"_5":13306,"_25514":64767,"_2665":108167},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3170":64801,"_28022":64767,"_19417":108169,"_5":13306,"_25514":64767,"_2665":108170},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3170":64802,"_28022":64767,"_19417":108172,"_5":13306,"_25514":64767,"_2665":108173},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3170":64803,"_28022":64767,"_19417":108175,"_5":13306,"_25514":108044,"_2665":108176},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3170":64804,"_28022":64767,"_19417":108178,"_5":13306,"_25514":108044,"_2665":108179},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3170":64805,"_28022":64767,"_19417":108181,"_5":13306,"_25514":108044,"_2665":108182},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3170":64806,"_28022":64767,"_19417":108184,"_5":13306,"_25514":108044,"_2665":108185},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3170":64807,"_28022":64767,"_19417":108187,"_5":13306,"_25514":108044,"_2665":108188},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3170":64808,"_28022":64767,"_19417":108190,"_5":13306,"_25514":108044,"_2665":108191},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3170":64809,"_28022":64767,"_19417":108193,"_5":13306,"_25514":108048,"_2665":108194},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3170":64810,"_28022":64767,"_19417":108196,"_5":13306,"_25514":108048,"_2665":108197},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3170":64811,"_28022":64767,"_19417":108199,"_5":13306,"_25514":108052,"_2665":108200},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3170":64812,"_28022":64767,"_19417":108202,"_5":13306,"_25514":108052,"_2665":108203},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3170":64813,"_28022":64767,"_19417":108205,"_5":13306,"_25514":108052,"_2665":108206},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3170":64814,"_28022":64767,"_19417":108208,"_5":13306,"_25514":108052,"_2665":108209},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3170":64815,"_28022":64767,"_19417":108211,"_5":13306,"_25514":108052,"_2665":108212},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3170":64816,"_28022":64767,"_19417":108214,"_5":13306,"_25514":108052,"_2665":108215},[],"Carga por separado las políticas concedidas a cada principal.",{"_3170":64817,"_28022":64767,"_19417":108217,"_5":13306,"_25514":108052,"_2665":108218},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3170":64818,"_28022":64767,"_19417":108220,"_5":13306,"_25514":108052,"_2665":108221},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3170":64819,"_28022":64767,"_19417":108223,"_5":13306,"_25514":108052,"_2665":108224},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3170":64820,"_28022":64767,"_19417":108226,"_5":13306,"_25514":108052,"_2665":108227},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3170":64821,"_28022":64767,"_19417":108229,"_5":13306,"_25514":108052,"_2665":108230},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3170":64822,"_28022":64767,"_19417":108232,"_5":13306,"_25514":108052,"_2665":108233},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3170":64823,"_28022":64767,"_19417":108235,"_5":13306,"_25514":108056,"_2665":108236},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3170":64824,"_28022":64767,"_19417":108238,"_5":13306,"_25514":108056,"_2665":108239},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3170":64825,"_28022":64767,"_19417":108241,"_5":13306,"_25514":108056,"_2665":108242},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3170":64826,"_28022":64767,"_19417":108244,"_5":13306,"_25514":108056,"_2665":108245},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3170":64827,"_28022":64767,"_19417":108247,"_5":13306,"_25514":108056,"_2665":108248},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3170":64828,"_28022":64767,"_19417":108250,"_5":13306,"_25514":108056,"_2665":108251},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3170":64829,"_28022":64767,"_19417":108253,"_5":13306,"_25514":108056,"_2665":108254},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3170":64830,"_28022":64767,"_19417":108256,"_5":13306,"_25514":108056,"_2665":108257},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3170":64831,"_28022":64767,"_19417":108259,"_5":13306,"_25514":108060,"_2665":108260},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3170":64832,"_28022":64767,"_19417":108262,"_5":13306,"_25514":108060,"_2665":108263},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3170":64833,"_28022":64767,"_19417":108265,"_5":13306,"_25514":108060,"_2665":108266},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3170":64834,"_28022":64767,"_19417":108268,"_5":13306,"_25514":108060,"_2665":108269},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3170":64835,"_28022":64767,"_19417":108271,"_5":13306,"_25514":108060,"_2665":108272},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3170":64836,"_28022":64767,"_19417":108274,"_5":13306,"_25514":108060,"_2665":108275},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3170":64837,"_28022":64767,"_19417":108277,"_5":13306,"_25514":108060,"_2665":108278},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3170":64838,"_28022":64767,"_19417":108280,"_5":13306,"_25514":108060,"_2665":108281},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3170":64839,"_28022":64767,"_19417":108283,"_5":13306,"_25514":108060,"_2665":108284},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3170":64840,"_28022":64767,"_19417":108286,"_5":13306,"_25514":108060,"_2665":108287},[],"Las acciones se dividen en dos grupos:",{"_3170":64841,"_28022":64767,"_19417":108289,"_5":13306,"_25514":108060,"_2665":108290},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3170":64842,"_28022":64767,"_19417":108292,"_5":13306,"_25514":108060,"_2665":108293},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3170":64843,"_28022":64767,"_19417":108295,"_5":13306,"_25514":108060,"_2665":108296},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3170":64844,"_28022":64767,"_19417":108298,"_5":13306,"_25514":108064,"_2665":108299},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3170":64845,"_28022":64767,"_19417":108301,"_5":13306,"_25514":108064,"_2665":108302},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3170":64846,"_28022":64767,"_19417":108304,"_5":13306,"_25514":108064,"_2665":108305},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3170":64847,"_28022":64767,"_19417":108307,"_5":13306,"_25514":108068,"_2665":108308},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3170":64848,"_28022":64767,"_19417":108310,"_5":13306,"_25514":108068,"_2665":108311},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3170":64849,"_28022":64767,"_19417":108313,"_5":13306,"_25514":108068,"_2665":108314},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3170":64850,"_28022":64767,"_19417":108316,"_5":13306,"_25514":108068,"_2665":108317},[],"Los operadores implementados son:",{"_3170":64851,"_28022":64767,"_19417":108319,"_5":13306,"_25514":108068,"_2665":108320},[],"`equals`, para igualdad exacta;",{"_3170":64852,"_28022":64767,"_19417":108322,"_5":13306,"_25514":108068,"_2665":108323},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3170":64853,"_28022":64767,"_19417":108325,"_5":13306,"_25514":108068,"_2665":108326},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3170":64854,"_28022":64767,"_19417":108328,"_5":13306,"_25514":108068,"_2665":108329},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3170":64855,"_28022":64767,"_19417":108331,"_5":13306,"_25514":108072,"_2665":108332},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3170":64856,"_28022":64767,"_19417":108334,"_5":13306,"_25514":108072,"_2665":108335},[],"Los modos disponibles son:",{"_3170":64857,"_28022":64767,"_19417":108337,"_5":13306,"_25514":108072,"_2665":108338},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3170":64858,"_28022":64767,"_19417":108340,"_5":13306,"_25514":108072,"_2665":108341},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3170":64859,"_28022":64767,"_19417":108343,"_5":13306,"_25514":108072,"_2665":108344},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3170":64860,"_28022":64767,"_19417":108346,"_5":13306,"_25514":108072,"_2665":108347},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3170":64861,"_28022":64767,"_19417":108349,"_5":13306,"_25514":108072,"_2665":108350},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3170":64862,"_28022":64767,"_19417":108352,"_5":13306,"_25514":108072,"_2665":108353},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3170":64863,"_28022":64767,"_19417":108355,"_5":13306,"_25514":108076,"_2665":108356},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3170":64864,"_28022":64767,"_19417":108358,"_5":13306,"_25514":108076,"_2665":108359},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3170":64865,"_28022":64767,"_19417":108361,"_5":13306,"_25514":108076,"_2665":108362},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3170":64866,"_28022":64767,"_19417":108364,"_5":13306,"_25514":108076,"_2665":108365},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3170":64867,"_28022":64767,"_19417":108367,"_5":13306,"_25514":108084,"_2665":108368},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3170":64868,"_28022":64767,"_19417":108370,"_5":13306,"_25514":108084,"_2665":108371},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3170":64869,"_28022":64767,"_19417":108373,"_5":13306,"_25514":108088,"_2665":108374},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3170":64870,"_28022":64767,"_19417":108376,"_5":13306,"_25514":108088,"_2665":108377},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3170":64871,"_28022":64767,"_19417":108379,"_5":13306,"_25514":108092,"_2665":108380},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3170":64872,"_28022":64767,"_19417":108382,"_5":13306,"_25514":108092,"_2665":108383},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3170":64873,"_28022":64767,"_19417":108385,"_5":13306,"_25514":108092,"_2665":108386},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3170":64874,"_28022":64767,"_19417":108388,"_5":13306,"_25514":108096,"_2665":108389},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3170":64875,"_28022":64767,"_19417":108391,"_5":13306,"_25514":108096,"_2665":108392},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3170":64876,"_28022":64767,"_19417":108394,"_5":13306,"_25514":108096,"_2665":108395},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3170":64877,"_28022":64767,"_19417":108397,"_5":13306,"_25514":108096,"_2665":108398},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3170":64878,"_28022":64767,"_19417":108400,"_5":13306,"_25514":108096,"_2665":108401},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3170":64879,"_28022":64767,"_19417":108403,"_5":13306,"_25514":108096,"_2665":108404},[],"Ten en cuenta que:",{"_3170":64880,"_28022":64767,"_19417":108406,"_5":13306,"_25514":108096,"_2665":108407},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3170":64881,"_28022":64767,"_19417":108409,"_5":13306,"_25514":108096,"_2665":108410},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3170":64882,"_28022":64767,"_19417":108412,"_5":13306,"_25514":108096,"_2665":108413},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3170":64883,"_28022":64767,"_19417":108415,"_5":13306,"_25514":108100,"_2665":108416},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3170":64884,"_28022":64767,"_19417":108418,"_5":13306,"_25514":108100,"_2665":108419},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3170":64885,"_28022":64767,"_19417":108421,"_5":13306,"_25514":108100,"_2665":108422},[],"acceso completo y de solo lectura a KMS;",{"_3170":64886,"_28022":64767,"_19417":108424,"_5":13306,"_25514":108100,"_2665":108425},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3170":64887,"_28022":64767,"_19417":108427,"_5":13306,"_25514":108100,"_2665":108428},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3170":64888,"_28022":64767,"_19417":108430,"_5":13306,"_25514":108100,"_2665":108431},[],"acceso a la interfaz;",{"_3170":64889,"_28022":64767,"_19417":108433,"_5":13306,"_25514":108100,"_2665":108434},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3170":64890,"_28022":64767,"_19417":108436,"_5":13306,"_25514":108100,"_2665":108437},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3170":64891,"_28022":64767,"_19417":108439,"_5":13306,"_25514":108100,"_2665":108440},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3170":64892,"_28022":64767,"_19417":108442,"_5":13306,"_25514":108104,"_2665":108443},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3170":64893,"_28022":64767,"_19417":108445,"_5":13306,"_25514":108104,"_2665":108446},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3170":64894,"_28022":64767,"_19417":108448,"_5":13306,"_25514":108104,"_2665":108449},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3170":64895,"_28022":64767,"_19417":108451,"_5":13306,"_25514":108107,"_2665":108452},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3170":64896,"_28022":64767,"_19417":108454,"_5":13306,"_25514":108111,"_2665":108455},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3170":64897,"_28022":64767,"_19417":108457,"_5":13306,"_25514":108111,"_2665":108458},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3170":64898,"_28022":64767,"_19417":108460,"_5":13306,"_25514":108115,"_2665":108461},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3170":64899,"_28022":64767,"_19417":108463,"_5":13306,"_25514":108119,"_2665":108464},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3170":64900,"_28022":64767,"_19417":108466,"_5":13306,"_25514":108123,"_2665":108467},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3170":64901,"_28022":64767,"_19417":108469,"_5":13306,"_25514":108127,"_2665":108470},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3170":64902,"_28022":64767,"_19417":108472,"_5":13306,"_25514":108127,"_2665":108473},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3170":64903,"_28022":64767,"_19417":108475,"_5":13306,"_25514":108131,"_2665":108476},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3170":64904,"_28022":64767,"_19417":108478,"_5":13306,"_25514":108131,"_2665":108479},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3170":64905,"_28022":64767,"_19417":108481,"_5":13306,"_25514":108131,"_2665":108482},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3170":64906,"_28022":64767,"_19417":108484,"_5":13306,"_25514":108131,"_2665":108485},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3170":64907,"_28022":64767,"_19417":108487,"_5":13306,"_25514":108131,"_2665":108488},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3170":64908,"_28022":64767,"_19417":108490,"_5":13306,"_25514":108131,"_2665":108491},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3170":64909,"_28022":64767,"_19417":108493,"_5":13306,"_25514":108131,"_2665":108494},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3170":64910,"_28022":64767,"_19417":108496,"_5":13306,"_25514":108131,"_2665":108497},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3170":64911,"_28022":64767,"_19417":108499,"_5":13306,"_25514":108135,"_2665":108500},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3170":64912,"_28022":64767,"_19417":108502,"_5":13306,"_25514":108135,"_2665":108503},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3170":64913,"_28022":64767,"_19417":108505,"_5":13306,"_25514":108135,"_2665":108506},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3170":64914,"_28022":64767,"_19417":108508,"_5":13306,"_25514":108139,"_2665":108509},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3170":64915,"_28022":64767,"_19417":108511,"_5":13306,"_25514":108139,"_2665":108512},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3170":64916,"_28022":64767,"_19417":108514,"_5":13306,"_25514":108139,"_2665":108515},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3170":64917,"_28022":64767,"_19417":108517,"_5":13306,"_25514":108139,"_2665":108518},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3170":64918,"_28022":64767,"_19417":108520,"_5":13306,"_25514":108139,"_2665":108521},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3170":64919,"_28022":64767,"_19417":108523,"_5":13306,"_25514":108139,"_2665":108524},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3170":64920,"_28022":64767,"_19417":108526,"_5":13306,"_25514":108139,"_2665":108527},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3170":64921,"_28022":64767,"_19417":108529,"_5":13306,"_25514":108139,"_2665":108530},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3170":64922,"_28022":64767,"_19417":108532,"_5":13306,"_25514":108147,"_2665":108533},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3170":64923,"_28022":64767,"_19417":108535,"_5":13306,"_25514":108151,"_2665":108536},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3170":64924,"_28022":64767,"_19417":108538,"_5":13306,"_25514":108151,"_2665":108539},[],"que exista un principal activo del tipo correcto;",{"_3170":64925,"_28022":64767,"_19417":108541,"_5":13306,"_25514":108151,"_2665":108542},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3170":64926,"_28022":64767,"_19417":108544,"_5":13306,"_25514":108151,"_2665":108545},[],"que todas las condiciones del principal se cumplan;",{"_3170":64927,"_28022":64767,"_19417":108547,"_5":13306,"_25514":108151,"_2665":108548},[],"que el principal tenga concedida la política esperada;",{"_3170":64928,"_28022":64767,"_19417":108550,"_5":13306,"_25514":108151,"_2665":108551},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3170":64929,"_28022":64767,"_19417":108553,"_5":13306,"_25514":108151,"_2665":108554},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3170":64930,"_28022":64767,"_19417":108556,"_5":13306,"_25514":108151,"_2665":108557},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3170":64931,"_28022":64767,"_19417":108559,"_5":13306,"_25514":108155,"_2665":108560},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3170":64932,"_28022":64767,"_19417":108562,"_5":13306,"_25514":108159,"_2665":108563},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3170":64933,"_28022":64767,"_19417":108565,"_5":13306,"_25514":108163,"_2665":108566},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3170":64934,"_28022":64767,"_19417":108568,"_5":13306,"_25514":108163,"_2665":108569},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3170":64935,"_28022":64935,"_5":13637,"_2665":108571,"_28344":108572,"_19417":108573,"_25514":64935},"Alertas y suscripciones",[45406,108036,108037],[],{"_3170":64936,"_28022":64935,"_19417":108575,"_5":13306,"_25514":64935,"_2665":108576},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3170":64937,"_28022":64935,"_5":28341,"_19417":108578,"_25514":108579,"_2665":108580},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3170":64938,"_28022":64935,"_5":28341,"_19417":108582,"_25514":108583,"_2665":108584},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3170":64939,"_28022":64935,"_5":28341,"_19417":108586,"_25514":108587,"_2665":108588},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3170":64940,"_28022":64935,"_5":28341,"_19417":108590,"_25514":108591,"_2665":108592},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3170":64941,"_28022":64935,"_5":28341,"_19417":108594,"_25514":108595,"_2665":108596},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3170":64942,"_28022":64935,"_5":28341,"_19417":108598,"_25514":108599,"_2665":108600},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3170":64943,"_28022":64935,"_5":28341,"_19417":108602,"_25514":108603,"_2665":108604},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3170":64944,"_28022":64935,"_5":28341,"_19417":108606,"_25514":108607,"_2665":108608},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3170":64945,"_28022":64935,"_5":28341,"_19417":108610,"_25514":108611,"_2665":108612},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3170":64946,"_28022":64935,"_5":28341,"_19417":108614,"_25514":108615,"_2665":108616},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3170":64947,"_28022":64935,"_5":28341,"_19417":108618,"_25514":108619,"_2665":108620},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3170":64948,"_28022":64935,"_19417":108622,"_5":13306,"_25514":64935,"_2665":108623},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3170":64949,"_28022":64935,"_19417":108625,"_5":13306,"_25514":108579,"_2665":108626},[],"Un servicio publica un evento de dominio.",{"_3170":64950,"_28022":64935,"_19417":108628,"_5":13306,"_25514":108579,"_2665":108629},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3170":64951,"_28022":64935,"_19417":108631,"_5":13306,"_25514":108579,"_2665":108632},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3170":64952,"_28022":64935,"_19417":108634,"_5":13306,"_25514":108579,"_2665":108635},[],"Lamassu entrega el evento al canal configurado.",{"_3170":64953,"_28022":64935,"_19417":108637,"_5":13306,"_25514":108579,"_2665":108638},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3170":64954,"_28022":64935,"_19417":108640,"_5":13306,"_25514":108583,"_2665":108641},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3170":64955,"_28022":64935,"_19417":108643,"_5":13306,"_25514":108583,"_2665":108644},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3170":64956,"_28022":64935,"_19417":108646,"_5":13306,"_25514":108583,"_2665":108647},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3170":64957,"_28022":64935,"_19417":108649,"_5":13306,"_25514":108583,"_2665":108650},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3170":64958,"_28022":64935,"_19417":108652,"_5":13306,"_25514":108583,"_2665":108653},[],"`apikey_options` necesita `header` y `key`.",{"_3170":64959,"_28022":64935,"_19417":108655,"_5":13306,"_25514":108583,"_2665":108656},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3170":64960,"_28022":64935,"_19417":108658,"_5":13306,"_25514":108583,"_2665":108659},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3170":64961,"_28022":64935,"_19417":108661,"_5":13306,"_25514":108583,"_2665":108662},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3170":64962,"_28022":64935,"_19417":108664,"_5":13306,"_25514":108591,"_2665":108665},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3170":64963,"_28022":64935,"_19417":108667,"_5":13306,"_25514":108595,"_2665":108668},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3170":64964,"_28022":64935,"_19417":108670,"_5":13306,"_25514":108599,"_2665":108671},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3170":64965,"_28022":64935,"_19417":108673,"_5":13306,"_25514":108599,"_2665":108674},[],"**None** notifica todas las instancias del evento.",{"_3170":64966,"_28022":64935,"_19417":108676,"_5":13306,"_25514":108599,"_2665":108677},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3170":64967,"_28022":64935,"_19417":108679,"_5":13306,"_25514":108599,"_2665":108680},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3170":64968,"_28022":64935,"_19417":108682,"_5":13306,"_25514":108599,"_2665":108683},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3170":64969,"_28022":64935,"_19417":108685,"_5":13306,"_25514":108599,"_2665":108686},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3170":64970,"_28022":64935,"_19417":108688,"_5":13306,"_25514":108603,"_2665":108689},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3170":64971,"_28022":64935,"_19417":108691,"_5":13306,"_25514":108607,"_2665":108692},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3170":64972,"_28022":64935,"_19417":108694,"_5":13306,"_25514":108607,"_2665":108695},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3170":64973,"_28022":64935,"_19417":108697,"_5":13306,"_25514":108607,"_2665":108698},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3170":64974,"_28022":64935,"_19417":108700,"_5":13306,"_25514":108607,"_2665":108701},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3170":64975,"_28022":64935,"_19417":108703,"_5":13306,"_25514":108607,"_2665":108704},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3170":64976,"_28022":64935,"_19417":108706,"_5":13306,"_25514":108607,"_2665":108707},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3170":64977,"_28022":64935,"_19417":108709,"_5":13306,"_25514":108607,"_2665":108710},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3170":64978,"_28022":64935,"_19417":108712,"_5":13306,"_25514":108607,"_2665":108713},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3170":64979,"_28022":64935,"_19417":108715,"_5":13306,"_25514":108611,"_2665":108716},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3170":64980,"_28022":64935,"_19417":108718,"_5":13306,"_25514":108611,"_2665":108719},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3170":64981,"_28022":64935,"_19417":108721,"_5":13306,"_25514":108611,"_2665":108722},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3170":64982,"_28022":64935,"_19417":108724,"_5":13306,"_25514":108611,"_2665":108725},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3170":64983,"_28022":64935,"_19417":108727,"_5":13306,"_25514":108611,"_2665":108728},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3170":64984,"_28022":64935,"_19417":108730,"_5":13306,"_25514":108611,"_2665":108731},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3170":64985,"_28022":64935,"_19417":108733,"_5":13306,"_25514":108611,"_2665":108734},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3170":64986,"_28022":64935,"_19417":108736,"_5":13306,"_25514":108611,"_2665":108737},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3170":64987,"_28022":64935,"_19417":108739,"_5":13306,"_25514":108615,"_2665":108740},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3170":64988,"_28022":64935,"_19417":108742,"_5":13306,"_25514":108615,"_2665":108743},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3170":64989,"_28022":64935,"_19417":108745,"_5":13306,"_25514":108619,"_2665":108746},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3170":64990,"_28022":64935,"_19417":108748,"_5":13306,"_25514":108619,"_2665":108749},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3170":64991,"_28022":64935,"_19417":108751,"_5":13306,"_25514":108619,"_2665":108752},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3170":64992,"_28022":64935,"_19417":108754,"_5":13306,"_25514":108619,"_2665":108755},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3170":64993,"_28022":64935,"_19417":108757,"_5":13306,"_25514":108619,"_2665":108758},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3170":64994,"_28022":64935,"_19417":108760,"_5":13306,"_25514":108619,"_2665":108761},[],"**Validación:** `va.role.crl.create`.",{"_3170":64995,"_28022":64935,"_19417":108763,"_5":13306,"_25514":108619,"_2665":108764},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3170":64996,"_28022":64935,"_19417":108766,"_5":13306,"_25514":108619,"_2665":108767},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3170":64997,"_28022":64997,"_5":13637,"_2665":108769,"_28344":108770,"_19417":108771,"_25514":64997},"Registros de auditoría",[45406,108036,108037],[],{"_3170":64998,"_28022":64997,"_19417":108773,"_5":13306,"_25514":64997,"_2665":108774},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3170":64999,"_28022":64997,"_5":28341,"_19417":108776,"_25514":108777,"_2665":108778},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3170":65000,"_28022":64997,"_5":28341,"_19417":108780,"_25514":108781,"_2665":108782},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3170":65001,"_28022":64997,"_5":28341,"_19417":108784,"_25514":108785,"_2665":108786},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3170":65002,"_28022":64997,"_5":28341,"_19417":108788,"_25514":108789,"_2665":108790},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3170":65003,"_28022":64997,"_5":28341,"_19417":108792,"_25514":108793,"_2665":108794},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3170":65004,"_28022":64997,"_5":28341,"_19417":108796,"_25514":108797,"_2665":108798},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3170":65005,"_28022":64997,"_5":28341,"_19417":108800,"_25514":108801,"_2665":108802},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3170":65006,"_28022":64997,"_5":28341,"_19417":108804,"_25514":108805,"_2665":108806},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3170":65007,"_28022":64997,"_5":28341,"_19417":108808,"_25514":108809,"_2665":108810},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3170":65008,"_28022":64997,"_5":28341,"_19417":108812,"_25514":108813,"_2665":108814},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3170":65009,"_28022":64997,"_5":28341,"_19417":108816,"_25514":108817,"_2665":108818},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3170":65010,"_28022":64997,"_19417":108820,"_5":13306,"_25514":64997,"_2665":108821},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3170":65011,"_28022":64997,"_19417":108823,"_5":13306,"_25514":108777,"_2665":108824},[],"El cuerpo de auditoría incluye:",{"_3170":65012,"_28022":64997,"_19417":108826,"_5":13306,"_25514":108777,"_2665":108827},[],"input: datos recibidos por la operación;",{"_3170":65013,"_28022":64997,"_19417":108829,"_5":13306,"_25514":108777,"_2665":108830},[],"has\\_error: indica si el servicio devolvió un error;",{"_3170":65014,"_28022":64997,"_19417":108832,"_5":13306,"_25514":108777,"_2665":108833},[],"output: resultado producido o mensaje de error;",{"_3170":65015,"_28022":64997,"_19417":108835,"_5":13306,"_25514":108777,"_2665":108836},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3170":65016,"_28022":64997,"_19417":108838,"_5":13306,"_25514":108777,"_2665":108839},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3170":65017,"_28022":64997,"_19417":108841,"_5":13306,"_25514":108777,"_2665":108842},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3170":65018,"_28022":64997,"_19417":108844,"_5":13306,"_25514":108781,"_2665":108845},[],"El backend aplica auditoría a mutaciones de:",{"_3170":65019,"_28022":64997,"_19417":108847,"_5":13306,"_25514":108781,"_2665":108848},[],"autoridades, certificados y perfiles de emisión;",{"_3170":65020,"_28022":64997,"_19417":108850,"_5":13306,"_25514":108781,"_2665":108851},[],"claves y motores KMS;",{"_3170":65021,"_28022":64997,"_19417":108853,"_5":13306,"_25514":108781,"_2665":108854},[],"dispositivos e identidades;",{"_3170":65022,"_28022":64997,"_19417":108856,"_5":13306,"_25514":108781,"_2665":108857},[],"DMS y operaciones de enrolamiento;",{"_3170":65023,"_28022":64997,"_19417":108859,"_5":13306,"_25514":108781,"_2665":108860},[],"funciones de validación y CRL;",{"_3170":65024,"_28022":64997,"_19417":108862,"_5":13306,"_25514":108781,"_2665":108863},[],"principales, políticas y concesiones de autorización.",{"_3170":65025,"_28022":64997,"_19417":108865,"_5":13306,"_25514":108781,"_2665":108866},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3170":65026,"_28022":64997,"_19417":108868,"_5":13306,"_25514":108785,"_2665":108869},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3170":65027,"_28022":64997,"_19417":108871,"_5":13306,"_25514":108785,"_2665":108872},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3170":65028,"_28022":64997,"_19417":108874,"_5":13306,"_25514":108785,"_2665":108875},[],"Diseña el consumidor para:",{"_3170":65029,"_28022":64997,"_19417":108877,"_5":13306,"_25514":108785,"_2665":108878},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3170":65030,"_28022":64997,"_19417":108880,"_5":13306,"_25514":108785,"_2665":108881},[],"conservar el CloudEvent completo sin modificar;",{"_3170":65031,"_28022":64997,"_19417":108883,"_5":13306,"_25514":108785,"_2665":108884},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3170":65032,"_28022":64997,"_19417":108886,"_5":13306,"_25514":108785,"_2665":108887},[],"cifrar en tránsito y en reposo;",{"_3170":65033,"_28022":64997,"_19417":108889,"_5":13306,"_25514":108785,"_2665":108890},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3170":65034,"_28022":64997,"_19417":108892,"_5":13306,"_25514":108785,"_2665":108893},[],"aplicar una política explícita de retención y legal hold;",{"_3170":65035,"_28022":64997,"_19417":108895,"_5":13306,"_25514":108785,"_2665":108896},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3170":65036,"_28022":64997,"_19417":108898,"_5":13306,"_25514":108789,"_2665":108899},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3170":65037,"_28022":64997,"_19417":108901,"_5":13306,"_25514":108789,"_2665":108902},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3170":65038,"_28022":64997,"_19417":108904,"_5":13306,"_25514":108797,"_2665":108905},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3170":65039,"_28022":64997,"_19417":108907,"_5":13306,"_25514":108801,"_2665":108908},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3170":65040,"_28022":64997,"_19417":108910,"_5":13306,"_25514":108805,"_2665":108911},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3170":65041,"_28022":64997,"_19417":108913,"_5":13306,"_25514":108809,"_2665":108914},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3170":65042,"_28022":64997,"_19417":108916,"_5":13306,"_25514":108813,"_2665":108917},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3170":65043,"_28022":64997,"_19417":108919,"_5":13306,"_25514":108817,"_2665":108920},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3170":65044,"_28022":64997,"_19417":108922,"_5":13306,"_25514":108817,"_2665":108923},[],"aparece un evento de auditoría correcto;",{"_3170":65045,"_28022":64997,"_19417":108925,"_5":13306,"_25514":108817,"_2665":108926},[],"el principal coincide con la identidad utilizada;",{"_3170":65046,"_28022":64997,"_19417":108928,"_5":13306,"_25514":108817,"_2665":108929},[],"el consumidor lo persiste una sola vez;",{"_3170":65047,"_28022":64997,"_19417":108931,"_5":13306,"_25514":108817,"_2665":108932},[],"puede recuperarse por recurso, actor y periodo;",{"_3170":65048,"_28022":64997,"_19417":108934,"_5":13306,"_25514":108817,"_2665":108935},[],"una interrupción del consumidor produce una alerta.",{"_3170":65049,"_28022":64997,"_19417":108937,"_5":13306,"_25514":108817,"_2665":108938},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3170":65050,"_28022":65050,"_5":13637,"_2665":108940,"_28344":108941,"_19417":108942,"_25514":65050},"Arquitectura de la plataforma",[45406,108036],[],{"_3170":65051,"_28022":65050,"_19417":108944,"_5":13306,"_25514":65050,"_2665":108945},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3170":65052,"_28022":65050,"_5":28341,"_19417":108947,"_25514":108948,"_2665":108949},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3170":65053,"_28022":65050,"_5":28341,"_19417":108951,"_25514":108952,"_2665":108953},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3170":65054,"_28022":65050,"_5":28341,"_19417":108955,"_25514":108956,"_2665":108957},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3170":65055,"_28022":65050,"_5":28341,"_19417":108959,"_25514":108960,"_2665":108961},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3170":65056,"_28022":65050,"_5":28341,"_19417":108963,"_25514":108964,"_2665":108965},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3170":65057,"_28022":65050,"_19417":108967,"_5":13306,"_25514":65050,"_2665":108968},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3170":65058,"_28022":65050,"_19417":108970,"_5":13306,"_25514":65050,"_2665":108971},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3170":65059,"_28022":65050,"_19417":108973,"_5":13306,"_25514":108948,"_2665":108974},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3170":65060,"_28022":65050,"_19417":108976,"_5":13306,"_25514":108952,"_2665":108977},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3170":65061,"_28022":65050,"_19417":108979,"_5":13306,"_25514":108956,"_2665":108980},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3170":65062,"_28022":65050,"_19417":108982,"_5":13306,"_25514":108960,"_2665":108983},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3170":65063,"_28022":65050,"_19417":108985,"_5":13306,"_25514":108964,"_2665":108986},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3170":65064,"_28022":65064,"_5":13637,"_2665":108988,"_28344":108989,"_19417":108990,"_25514":65064},"Cómo funciona Lamassu",[45406,108036],[],{"_3170":65065,"_28022":65064,"_19417":108992,"_5":13306,"_25514":65064,"_2665":108993},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3170":65066,"_28022":65064,"_5":28341,"_19417":108995,"_25514":108996,"_2665":108997},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3170":65067,"_28022":65064,"_5":28341,"_19417":108999,"_25514":109000,"_2665":109001},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3170":65068,"_28022":65064,"_19417":109003,"_5":13306,"_25514":65064,"_2665":109004},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3170":65069,"_28022":65064,"_19417":109006,"_5":13306,"_25514":108996,"_2665":109007},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3170":65070,"_28022":65064,"_19417":109009,"_5":13306,"_25514":108996,"_2665":109010},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3170":65071,"_28022":65064,"_19417":109012,"_5":13306,"_25514":108996,"_2665":109013},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3170":65072,"_28022":65064,"_19417":109015,"_5":13306,"_25514":108996,"_2665":109016},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3170":65073,"_28022":65064,"_19417":109018,"_5":13306,"_25514":108996,"_2665":109019},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3170":65074,"_28022":65064,"_19417":109021,"_5":13306,"_25514":109000,"_2665":109022},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3170":65075,"_28022":65064,"_19417":109024,"_5":13306,"_25514":109000,"_2665":109025},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3170":65076,"_28022":65064,"_19417":109027,"_5":13306,"_25514":109000,"_2665":109028},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3170":65077,"_28022":65064,"_19417":109030,"_5":13306,"_25514":109000,"_2665":109031},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3170":65078,"_28022":65064,"_19417":109033,"_5":13306,"_25514":109000,"_2665":109034},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3170":65079,"_28022":65064,"_19417":109036,"_5":13306,"_25514":109000,"_2665":109037},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3170":65080,"_28022":65064,"_19417":109039,"_5":13306,"_25514":109000,"_2665":109040},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3170":65081,"_28022":65081,"_5":13637,"_2665":109042,"_28344":109043,"_19417":109044,"_25514":65081},"Dispositivos e identidades",[45406,108036,47807,109042],[],{"_3170":65082,"_28022":65081,"_19417":109046,"_5":13306,"_25514":65081,"_2665":109047},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3170":65083,"_28022":65081,"_5":28341,"_19417":109049,"_25514":109050,"_2665":109051},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3170":65084,"_28022":65081,"_5":28341,"_19417":109053,"_25514":109054,"_2665":109055},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3170":65085,"_28022":65081,"_5":28341,"_19417":109057,"_25514":109058,"_2665":109059},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3170":65086,"_28022":65081,"_5":28341,"_19417":109061,"_25514":109062,"_2665":109063},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3170":65087,"_28022":65081,"_5":28341,"_19417":109065,"_25514":109066,"_2665":109067},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3170":65088,"_28022":65081,"_5":28341,"_19417":109069,"_25514":109070,"_2665":109071},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3170":65089,"_28022":65081,"_5":28341,"_19417":109073,"_25514":109074,"_2665":109075},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3170":65090,"_28022":65081,"_5":28341,"_19417":109077,"_25514":109078,"_2665":109079},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3170":65091,"_28022":65081,"_5":28341,"_19417":109081,"_25514":109082,"_2665":109083},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3170":65092,"_28022":65081,"_5":28341,"_19417":109085,"_25514":109086,"_2665":109087},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3170":65093,"_28022":65081,"_5":28341,"_19417":109089,"_25514":109090,"_2665":109091},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3170":65094,"_28022":65081,"_19417":109093,"_5":13306,"_25514":65081,"_2665":109094},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3170":65095,"_28022":65081,"_19417":109096,"_5":13306,"_25514":65081,"_2665":109097},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3170":65096,"_28022":65081,"_19417":109099,"_5":13306,"_25514":109050,"_2665":109100},[],"Vista operativa",{"_3170":65097,"_28022":65081,"_19417":109102,"_5":13306,"_25514":109050,"_2665":109103},[],"Interpretación",{"_3170":65098,"_28022":65081,"_19417":109105,"_5":13306,"_25514":109050,"_2665":47870},[],{"_3170":65099,"_28022":65081,"_19417":109107,"_5":13306,"_25514":109050,"_2665":109108},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3170":65100,"_28022":65081,"_19417":109110,"_5":13306,"_25514":109050,"_2665":47876},[],{"_3170":65101,"_28022":65081,"_19417":109112,"_5":13306,"_25514":109050,"_2665":109113},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3170":65102,"_28022":65081,"_19417":109115,"_5":13306,"_25514":109050,"_2665":47882},[],{"_3170":65103,"_28022":65081,"_19417":109117,"_5":13306,"_25514":109050,"_2665":109118},[],"La identidad está en la ventana operativa de renovación.",{"_3170":65104,"_28022":65081,"_19417":109120,"_5":13306,"_25514":109050,"_2665":47888},[],{"_3170":65105,"_28022":65081,"_19417":109122,"_5":13306,"_25514":109050,"_2665":109123},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3170":65106,"_28022":65081,"_19417":109125,"_5":13306,"_25514":109050,"_2665":47894},[],{"_3170":65107,"_28022":65081,"_19417":109127,"_5":13306,"_25514":109050,"_2665":109128},[],"La identidad ha vencido.",{"_3170":65108,"_28022":65081,"_19417":109130,"_5":13306,"_25514":109050,"_2665":47900},[],{"_3170":65109,"_28022":65081,"_19417":109132,"_5":13306,"_25514":109050,"_2665":109133},[],"La identidad está marcada como revocada.",{"_3170":65110,"_28022":65081,"_19417":109135,"_5":13306,"_25514":109050,"_2665":47906},[],{"_3170":65111,"_28022":65081,"_19417":109137,"_5":13306,"_25514":109050,"_2665":109138},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3170":65112,"_28022":65081,"_19417":109140,"_5":13306,"_25514":109050,"_2665":109141},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3170":65113,"_28022":65081,"_19417":109143,"_5":13306,"_25514":109054,"_2665":109144},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3170":65114,"_28022":65081,"_19417":109146,"_5":13306,"_25514":109054,"_2665":109147},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3170":65115,"_28022":65081,"_19417":109149,"_5":13306,"_25514":109054,"_2665":109150},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3170":65116,"_28022":65081,"_19417":109152,"_5":13306,"_25514":109054,"_2665":109153},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3170":65117,"_28022":65081,"_19417":109155,"_5":13306,"_25514":109058,"_2665":109156},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3170":65118,"_28022":65081,"_19417":109158,"_5":13306,"_25514":109062,"_2665":109159},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3170":65119,"_28022":65081,"_19417":109161,"_5":13306,"_25514":109066,"_2665":109162},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3170":65120,"_28022":65081,"_19417":109164,"_5":13306,"_25514":109070,"_2665":109165},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3170":65121,"_28022":65081,"_19417":109167,"_5":13306,"_25514":109074,"_2665":109168},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3170":65122,"_28022":65081,"_19417":109170,"_5":13306,"_25514":109074,"_2665":109171},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3170":65123,"_28022":65081,"_19417":109173,"_5":13306,"_25514":109078,"_2665":109174},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3170":65124,"_28022":65081,"_19417":109176,"_5":13306,"_25514":109078,"_2665":109177},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3170":65125,"_28022":65081,"_19417":109179,"_5":13306,"_25514":109078,"_2665":109180},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3170":65126,"_28022":65081,"_19417":109182,"_5":13306,"_25514":109078,"_2665":109183},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3170":65127,"_28022":65081,"_19417":109185,"_5":13306,"_25514":109078,"_2665":109186},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3170":65128,"_28022":65081,"_19417":109188,"_5":13306,"_25514":109078,"_2665":109189},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3170":65129,"_28022":65081,"_19417":109191,"_5":13306,"_25514":109082,"_2665":109192},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3170":65130,"_28022":65081,"_19417":109194,"_5":13306,"_25514":109082,"_2665":109195},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3170":65131,"_28022":65081,"_19417":109197,"_5":13306,"_25514":109086,"_2665":109198},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3170":65132,"_28022":65081,"_19417":109200,"_5":13306,"_25514":109086,"_2665":109201},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3170":65133,"_28022":65081,"_19417":109203,"_5":13306,"_25514":109086,"_2665":109204},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3170":65134,"_28022":65081,"_19417":109206,"_5":13306,"_25514":109086,"_2665":109207},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3170":65135,"_28022":65081,"_19417":109209,"_5":13306,"_25514":109090,"_2665":109210},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":65136,"_28022":65081,"_19417":109212,"_5":13306,"_25514":109090,"_2665":109213},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":65137,"_28022":65137,"_5":13637,"_2665":109215,"_28344":109216,"_19417":109218,"_25514":65137},"Identidad inicial y autenticación",[45406,108036,47807,109042,109217],"Enrolamiento con PKI",[],{"_3170":65138,"_28022":65137,"_19417":109220,"_5":13306,"_25514":65137,"_2665":109221},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3170":65139,"_28022":65137,"_5":28341,"_19417":109223,"_25514":109224,"_2665":109225},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3170":65140,"_28022":65137,"_5":28341,"_19417":109227,"_25514":109228,"_2665":109229},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3170":65141,"_28022":65137,"_5":28341,"_19417":109231,"_25514":109232,"_2665":109233},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3170":65142,"_28022":65137,"_5":28341,"_19417":109235,"_25514":109236,"_2665":109237},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3170":65143,"_28022":65137,"_5":28341,"_19417":109239,"_25514":109240,"_2665":109241},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3170":65144,"_28022":65137,"_19417":109243,"_5":13306,"_25514":65137,"_2665":109244},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3170":65145,"_28022":65137,"_19417":109246,"_5":13306,"_25514":109224,"_2665":109247},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3170":65146,"_28022":65137,"_19417":109249,"_5":13306,"_25514":109224,"_2665":109250},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3170":65147,"_28022":65137,"_19417":109252,"_5":13306,"_25514":109228,"_2665":109253},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3170":65148,"_28022":65137,"_19417":109255,"_5":13306,"_25514":109228,"_2665":109256},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3170":65149,"_28022":65137,"_19417":109258,"_5":13306,"_25514":109228,"_2665":109259},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3170":65150,"_28022":65137,"_19417":109261,"_5":13306,"_25514":109232,"_2665":109262},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3170":65151,"_28022":65137,"_19417":109264,"_5":13306,"_25514":109232,"_2665":109265},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3170":65152,"_28022":65137,"_19417":109267,"_5":13306,"_25514":109236,"_2665":109268},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3170":65153,"_28022":65137,"_19417":109270,"_5":13306,"_25514":109236,"_2665":109271},[],"Ejemplo de cuerpo:",{"_3170":65154,"_28022":65137,"_19417":109273,"_5":13306,"_25514":109236,"_2665":109274},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3170":65155,"_28022":65137,"_19417":109276,"_5":13306,"_25514":109236,"_2665":109277},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3170":65156,"_28022":65137,"_19417":109279,"_5":13306,"_25514":109236,"_2665":109280},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3170":65157,"_28022":65137,"_19417":109282,"_5":13306,"_25514":109236,"_2665":109283},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3170":65158,"_28022":65137,"_19417":109285,"_5":13306,"_25514":109240,"_2665":109286},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3170":65159,"_28022":65137,"_19417":109288,"_5":13306,"_25514":109240,"_2665":109289},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3170":65160,"_28022":65160,"_5":13637,"_2665":109291,"_28344":109292,"_19417":109293,"_25514":65160},"Configura y opera el DMS",[45406,108036,47807,109042,109217],[],{"_3170":65161,"_28022":65160,"_19417":109295,"_5":13306,"_25514":65160,"_2665":109296},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3170":65162,"_28022":65160,"_5":28341,"_19417":109298,"_25514":109299,"_2665":106689},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3170":65163,"_28022":65160,"_5":28341,"_19417":109301,"_25514":109302,"_2665":109303},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3170":65164,"_28022":65160,"_5":28341,"_19417":109305,"_25514":109306,"_2665":109307},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3170":65165,"_28022":65160,"_5":28341,"_19417":109309,"_25514":109310,"_2665":109311},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3170":65166,"_28022":65160,"_5":28341,"_19417":109313,"_25514":109314,"_2665":109315},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3170":65167,"_28022":65160,"_5":28341,"_19417":109317,"_25514":109318,"_2665":109319},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3170":65168,"_28022":65160,"_5":28341,"_19417":109321,"_25514":109322,"_2665":109323},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3170":65169,"_28022":65160,"_5":28341,"_19417":109325,"_25514":109326,"_2665":109327},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3170":65170,"_28022":65160,"_5":28341,"_19417":109329,"_25514":109330,"_2665":48102},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3170":65171,"_28022":65160,"_5":28341,"_19417":109332,"_25514":109333,"_2665":48106},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3170":65172,"_28022":65160,"_5":28341,"_19417":109335,"_25514":109336,"_2665":109337},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3170":65173,"_28022":65160,"_5":28341,"_19417":109339,"_25514":109340,"_2665":109341},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3170":65174,"_28022":65160,"_5":28341,"_19417":109343,"_25514":109344,"_2665":109345},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3170":65175,"_28022":65160,"_5":28341,"_19417":109347,"_25514":109348,"_2665":109349},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3170":65176,"_28022":65160,"_5":28341,"_19417":109351,"_25514":109352,"_2665":48126},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3170":65177,"_28022":65160,"_5":28341,"_19417":109354,"_25514":109355,"_2665":109356},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3170":65178,"_28022":65160,"_5":28341,"_19417":109358,"_25514":109359,"_2665":109360},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3170":65179,"_28022":65160,"_5":28341,"_19417":109362,"_25514":109363,"_2665":109364},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3170":65180,"_28022":65160,"_19417":109366,"_5":13306,"_25514":65160,"_2665":109367},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3170":65181,"_28022":65160,"_19417":109369,"_5":13306,"_25514":109299,"_2665":109370},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3170":65182,"_28022":65160,"_19417":109372,"_5":13306,"_25514":109299,"_2665":109373},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3170":65183,"_28022":65160,"_19417":109375,"_5":13306,"_25514":109306,"_2665":109376},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3170":65184,"_28022":65160,"_19417":109378,"_5":13306,"_25514":109310,"_2665":109379},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3170":65185,"_28022":65160,"_19417":109381,"_5":13306,"_25514":109314,"_2665":109382},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3170":65186,"_28022":65160,"_19417":109384,"_5":13306,"_25514":109318,"_2665":109385},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3170":65187,"_28022":65160,"_19417":109387,"_5":13306,"_25514":109322,"_2665":109388},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3170":65188,"_28022":65160,"_19417":109390,"_5":13306,"_25514":109330,"_2665":109391},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3170":65189,"_28022":65160,"_19417":109393,"_5":13306,"_25514":109330,"_2665":109394},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3170":65190,"_28022":65160,"_19417":109396,"_5":13306,"_25514":109333,"_2665":109397},[],"Campo de `settings.enrollment_settings`",{"_3170":65191,"_28022":65160,"_19417":109399,"_5":13306,"_25514":109333,"_2665":109400},[],"Decisión",{"_3170":65192,"_28022":65160,"_19417":109402,"_5":13306,"_25514":109333,"_2665":48177},[],{"_3170":65193,"_28022":65160,"_19417":109404,"_5":13306,"_25514":109333,"_2665":109405},[],"`EST_RFC7030` para estas operaciones.",{"_3170":65194,"_28022":65160,"_19417":109407,"_5":13306,"_25514":109333,"_2665":48183},[],{"_3170":65195,"_28022":65160,"_19417":109409,"_5":13306,"_25514":109333,"_2665":109410},[],"ID de la CA que firmará.",{"_3170":65196,"_28022":65160,"_19417":109412,"_5":13306,"_25514":109333,"_2665":48189},[],{"_3170":65197,"_28022":65160,"_19417":109414,"_5":13306,"_25514":109333,"_2665":109415},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3170":65198,"_28022":65160,"_19417":109417,"_5":13306,"_25514":109333,"_2665":48195},[],{"_3170":65199,"_28022":65160,"_19417":109419,"_5":13306,"_25514":109333,"_2665":109420},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3170":65200,"_28022":65160,"_19417":109422,"_5":13306,"_25514":109333,"_2665":48201},[],{"_3170":65201,"_28022":65160,"_19417":109424,"_5":13306,"_25514":109333,"_2665":109425},[],"Uno de los cuatro modos de autenticación.",{"_3170":65202,"_28022":65160,"_19417":109427,"_5":13306,"_25514":109333,"_2665":109428},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3170":65203,"_28022":65160,"_19417":109430,"_5":13306,"_25514":109336,"_2665":109431},[],"Los bloques son independientes:",{"_3170":65204,"_28022":65160,"_19417":109433,"_5":13306,"_25514":109336,"_2665":109434},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3170":65205,"_28022":65160,"_19417":109436,"_5":13306,"_25514":109336,"_2665":109437},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3170":65206,"_28022":65160,"_19417":109439,"_5":13306,"_25514":109336,"_2665":48219},[],{"_3170":65207,"_28022":65160,"_19417":109441,"_5":13306,"_25514":109336,"_2665":109442},[],"Control aplicado en la operación configurada",{"_3170":65208,"_28022":65160,"_19417":109444,"_5":13306,"_25514":109336,"_2665":48225},[],{"_3170":65209,"_28022":65160,"_19417":109446,"_5":13306,"_25514":109336,"_2665":109447},[],"Validación del certificado presentado.",{"_3170":65210,"_28022":65160,"_19417":109449,"_5":13306,"_25514":109336,"_2665":48231},[],{"_3170":65211,"_28022":65160,"_19417":109451,"_5":13306,"_25514":109336,"_2665":109452},[],"Autorización del webhook configurado.",{"_3170":65212,"_28022":65160,"_19417":109454,"_5":13306,"_25514":109336,"_2665":48237},[],{"_3170":65213,"_28022":65160,"_19417":109456,"_5":13306,"_25514":109336,"_2665":109457},[],"Validación del certificado y, después, aprobación del webhook.",{"_3170":65214,"_28022":65160,"_19417":109459,"_5":13306,"_25514":109336,"_2665":48243},[],{"_3170":65215,"_28022":65160,"_19417":109461,"_5":13306,"_25514":109336,"_2665":109462},[],"Sin autenticación del solicitante por el DMS.",{"_3170":65216,"_28022":65160,"_19417":109464,"_5":13306,"_25514":109336,"_2665":109465},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3170":65217,"_28022":65160,"_19417":109467,"_5":13306,"_25514":109336,"_2665":109468},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3170":65218,"_28022":65160,"_19417":109470,"_5":13306,"_25514":109336,"_2665":109471},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3170":65219,"_28022":65160,"_19417":109473,"_5":13306,"_25514":109336,"_2665":109474},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3170":65220,"_28022":65160,"_19417":109476,"_5":13306,"_25514":109340,"_2665":109477},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3170":65221,"_28022":65160,"_19417":109479,"_5":13306,"_25514":109340,"_2665":109480},[],"Campo de `external_webhook_settings`",{"_3170":65222,"_28022":65160,"_19417":109482,"_5":13306,"_25514":109340,"_2665":109400},[],{"_3170":65223,"_28022":65160,"_19417":109484,"_5":13306,"_25514":109340,"_2665":48269},[],{"_3170":65224,"_28022":65160,"_19417":109486,"_5":13306,"_25514":109340,"_2665":109487},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3170":65225,"_28022":65160,"_19417":109489,"_5":13306,"_25514":109340,"_2665":48275},[],{"_3170":65226,"_28022":65160,"_19417":109491,"_5":13306,"_25514":109340,"_2665":109492},[],"`POST` o `PUT`; `POST` por defecto.",{"_3170":65227,"_28022":65160,"_19417":109494,"_5":13306,"_25514":109340,"_2665":48281},[],{"_3170":65228,"_28022":65160,"_19417":109496,"_5":13306,"_25514":109340,"_2665":109497},[],"Etiqueta usada en los logs del servicio.",{"_3170":65229,"_28022":65160,"_19417":109499,"_5":13306,"_25514":109340,"_2665":48287},[],{"_3170":65230,"_28022":65160,"_19417":109501,"_5":13306,"_25514":109340,"_2665":109502},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3170":65231,"_28022":65160,"_19417":109504,"_5":13306,"_25514":109340,"_2665":48293},[],{"_3170":65232,"_28022":65160,"_19417":109506,"_5":13306,"_25514":109340,"_2665":109507},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3170":65233,"_28022":65160,"_19417":109509,"_5":13306,"_25514":109340,"_2665":48299},[],{"_3170":65234,"_28022":65160,"_19417":109511,"_5":13306,"_25514":109340,"_2665":109512},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3170":65235,"_28022":65160,"_19417":109514,"_5":13306,"_25514":109340,"_2665":48305},[],{"_3170":65236,"_28022":65160,"_19417":109516,"_5":13306,"_25514":109340,"_2665":109517},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3170":65237,"_28022":65160,"_19417":109519,"_5":13306,"_25514":109340,"_2665":48311},[],{"_3170":65238,"_28022":65160,"_19417":109521,"_5":13306,"_25514":109340,"_2665":109522},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3170":65239,"_28022":65160,"_19417":109524,"_5":13306,"_25514":109340,"_2665":48317},[],{"_3170":65240,"_28022":65160,"_19417":109526,"_5":13306,"_25514":109340,"_2665":109527},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3170":65241,"_28022":65160,"_19417":109529,"_5":13306,"_25514":109340,"_2665":48323},[],{"_3170":65242,"_28022":65160,"_19417":109531,"_5":13306,"_25514":109340,"_2665":109532},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3170":65243,"_28022":65160,"_19417":109534,"_5":13306,"_25514":109340,"_2665":109535},[],"Reglas de esa configuración:",{"_3170":65244,"_28022":65160,"_19417":109537,"_5":13306,"_25514":109340,"_2665":109538},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3170":65245,"_28022":65160,"_19417":109540,"_5":13306,"_25514":109340,"_2665":109541},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3170":65246,"_28022":65160,"_19417":109543,"_5":13306,"_25514":109340,"_2665":109544},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3170":65247,"_28022":65160,"_19417":109546,"_5":13306,"_25514":109340,"_2665":109547},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3170":65248,"_28022":65160,"_19417":109549,"_5":13306,"_25514":109340,"_2665":109550},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3170":65249,"_28022":65160,"_19417":109552,"_5":13306,"_25514":109340,"_2665":109553},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3170":65250,"_28022":65160,"_19417":109555,"_5":13306,"_25514":109340,"_2665":109556},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3170":65251,"_28022":65160,"_19417":109558,"_5":13306,"_25514":109340,"_2665":109559},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3170":65252,"_28022":65160,"_19417":109561,"_5":13306,"_25514":109340,"_2665":109562},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3170":65253,"_28022":65160,"_19417":109564,"_5":13306,"_25514":109344,"_2665":109565},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3170":65254,"_28022":65160,"_19417":109567,"_5":13306,"_25514":109348,"_2665":109568},[],"Campo de `settings.reenrollment_settings`",{"_3170":65255,"_28022":65160,"_19417":109570,"_5":13306,"_25514":109348,"_2665":109571},[],"Función",{"_3170":65256,"_28022":65160,"_19417":109573,"_5":13306,"_25514":109348,"_2665":48367},[],{"_3170":65257,"_28022":65160,"_19417":109575,"_5":13306,"_25514":109348,"_2665":109576},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3170":65258,"_28022":65160,"_19417":109578,"_5":13306,"_25514":109348,"_2665":48373},[],{"_3170":65259,"_28022":65160,"_19417":109580,"_5":13306,"_25514":109348,"_2665":109581},[],"Umbral operativo preventivo de monitorización.",{"_3170":65260,"_28022":65160,"_19417":109583,"_5":13306,"_25514":109348,"_2665":48379},[],{"_3170":65261,"_28022":65160,"_19417":109585,"_5":13306,"_25514":109348,"_2665":109586},[],"Umbral operativo crítico de monitorización.",{"_3170":65262,"_28022":65160,"_19417":109588,"_5":13306,"_25514":109348,"_2665":48385},[],{"_3170":65263,"_28022":65160,"_19417":109590,"_5":13306,"_25514":109348,"_2665":109591},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3170":65264,"_28022":65160,"_19417":109593,"_5":13306,"_25514":109348,"_2665":48391},[],{"_3170":65265,"_28022":65160,"_19417":109595,"_5":13306,"_25514":109348,"_2665":109596},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3170":65266,"_28022":65160,"_19417":109598,"_5":13306,"_25514":109348,"_2665":48397},[],{"_3170":65267,"_28022":65160,"_19417":109600,"_5":13306,"_25514":109348,"_2665":109601},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3170":65268,"_28022":65160,"_19417":109603,"_5":13306,"_25514":109348,"_2665":109604},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3170":65269,"_28022":65160,"_19417":109606,"_5":13306,"_25514":109352,"_2665":109607},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3170":65270,"_28022":65160,"_19417":109609,"_5":13306,"_25514":109355,"_2665":107053},[],{"_3170":65271,"_28022":65160,"_19417":109611,"_5":13306,"_25514":109355,"_2665":109612},[],"Qué publica",{"_3170":65272,"_28022":65160,"_19417":109614,"_5":13306,"_25514":109355,"_2665":48414},[],{"_3170":65273,"_28022":65160,"_19417":109616,"_5":13306,"_25514":109355,"_2665":109617},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3170":65274,"_28022":65160,"_19417":109619,"_5":13306,"_25514":109355,"_2665":48420},[],{"_3170":65275,"_28022":65160,"_19417":109621,"_5":13306,"_25514":109355,"_2665":109622},[],"Certificado de la CA emisora seleccionada.",{"_3170":65276,"_28022":65160,"_19417":109624,"_5":13306,"_25514":109355,"_2665":48426},[],{"_3170":65277,"_28022":65160,"_19417":109626,"_5":13306,"_25514":109355,"_2665":109627},[],"Certificados de las CAs elegidas explícitamente.",{"_3170":65278,"_28022":65160,"_19417":109629,"_5":13306,"_25514":109355,"_2665":109630},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3170":65279,"_28022":65160,"_19417":109632,"_5":13306,"_25514":109359,"_2665":109633},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_3170":65280,"_28022":65160,"_19417":109635,"_5":13306,"_25514":109359,"_2665":109636},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3170":65281,"_28022":65160,"_19417":109638,"_5":13306,"_25514":109359,"_2665":109639},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3170":65282,"_28022":65160,"_19417":109641,"_5":13306,"_25514":109363,"_2665":109642},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3170":65283,"_28022":65283,"_5":13637,"_2665":109644,"_28344":109645,"_19417":109646,"_25514":65283},"Integra el cliente EST",[45406,108036,47807,109042,109217],[],{"_3170":65284,"_28022":65283,"_19417":109648,"_5":13306,"_25514":65283,"_2665":109649},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3170":65285,"_28022":65283,"_5":28341,"_19417":109651,"_25514":109652,"_2665":106689},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3170":65286,"_28022":65283,"_5":28341,"_19417":109654,"_25514":109655,"_2665":109656},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3170":65287,"_28022":65283,"_5":28341,"_19417":109658,"_25514":109659,"_2665":109660},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3170":65288,"_28022":65283,"_5":28341,"_19417":109662,"_25514":109663,"_2665":109664},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3170":65289,"_28022":65283,"_5":28341,"_19417":109666,"_25514":109667,"_2665":109668},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3170":65290,"_28022":65283,"_5":28341,"_19417":109670,"_25514":109671,"_2665":109672},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3170":65291,"_28022":65283,"_19417":109674,"_5":13306,"_25514":65283,"_2665":109675},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3170":65292,"_28022":65283,"_19417":109677,"_5":13306,"_25514":109652,"_2665":109678},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3170":65293,"_28022":65283,"_19417":109680,"_5":13306,"_25514":109652,"_2665":109681},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3170":65294,"_28022":65283,"_19417":109683,"_5":13306,"_25514":109652,"_2665":109684},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3170":65295,"_28022":65283,"_19417":109686,"_5":13306,"_25514":109655,"_2665":109687},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3170":65296,"_28022":65283,"_19417":109689,"_5":13306,"_25514":109655,"_2665":109690},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3170":65297,"_28022":65283,"_19417":109692,"_5":13306,"_25514":109659,"_2665":109693},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3170":65298,"_28022":65283,"_19417":109695,"_5":13306,"_25514":109659,"_2665":109696},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3170":65299,"_28022":65283,"_19417":109698,"_5":13306,"_25514":109663,"_2665":109699},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3170":65300,"_28022":65283,"_19417":109701,"_5":13306,"_25514":109663,"_2665":109702},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3170":65301,"_28022":65283,"_19417":109704,"_5":13306,"_25514":109667,"_2665":109705},[],"Para el caso de una raíz que emite directamente:",{"_3170":65302,"_28022":65283,"_19417":109707,"_5":13306,"_25514":109667,"_2665":109708},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3170":65303,"_28022":65283,"_19417":109710,"_5":13306,"_25514":109667,"_2665":109711},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3170":65304,"_28022":65283,"_19417":109713,"_5":13306,"_25514":109671,"_2665":109714},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3170":65305,"_28022":65305,"_5":13637,"_2665":109716,"_28344":109717,"_19417":109718,"_25514":65305},"Referencia EST",[45406,108036,47807,109042,109217],[],{"_3170":65306,"_28022":65305,"_19417":109720,"_5":13306,"_25514":65305,"_2665":109721},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3170":65307,"_28022":65305,"_5":28341,"_19417":109723,"_25514":109724,"_2665":109725},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3170":65308,"_28022":65305,"_5":28341,"_19417":109727,"_25514":109728,"_2665":21102},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3170":65309,"_28022":65305,"_5":28341,"_19417":109730,"_25514":109731,"_2665":24200},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3170":65310,"_28022":65305,"_5":28341,"_19417":109733,"_25514":109734,"_2665":24207},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3170":65311,"_28022":65305,"_5":28341,"_19417":109736,"_25514":109737,"_2665":23552},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3170":65312,"_28022":65305,"_5":28341,"_19417":109739,"_25514":109740,"_2665":109741},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3170":65313,"_28022":65305,"_5":28341,"_19417":109743,"_25514":109744,"_2665":109745},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3170":65314,"_28022":65305,"_5":28341,"_19417":109747,"_25514":109748,"_2665":109749},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3170":65315,"_28022":65305,"_19417":109751,"_5":13306,"_25514":65305,"_2665":109752},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3170":65316,"_28022":65305,"_19417":109754,"_5":13306,"_25514":109724,"_2665":109755},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3170":65317,"_28022":65305,"_19417":109757,"_5":13306,"_25514":109724,"_2665":107824},[],{"_3170":65318,"_28022":65305,"_19417":109759,"_5":13306,"_25514":109724,"_2665":109760},[],"Método",{"_3170":65319,"_28022":65305,"_19417":109762,"_5":13306,"_25514":109724,"_2665":109763},[],"Autenticación y condición",{"_3170":65320,"_28022":65305,"_19417":109765,"_5":13306,"_25514":109724,"_2665":48569},[],{"_3170":65321,"_28022":65305,"_19417":109767,"_5":13306,"_25514":109724,"_2665":48572},[],{"_3170":65322,"_28022":65305,"_19417":109769,"_5":13306,"_25514":109724,"_2665":109770},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3170":65323,"_28022":65305,"_19417":109772,"_5":13306,"_25514":109724,"_2665":48578},[],{"_3170":65324,"_28022":65305,"_19417":109774,"_5":13306,"_25514":109724,"_2665":48581},[],{"_3170":65325,"_28022":65305,"_19417":109776,"_5":13306,"_25514":109724,"_2665":109777},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3170":65326,"_28022":65305,"_19417":109779,"_5":13306,"_25514":109724,"_2665":48587},[],{"_3170":65327,"_28022":65305,"_19417":109781,"_5":13306,"_25514":109724,"_2665":48581},[],{"_3170":65328,"_28022":65305,"_19417":109783,"_5":13306,"_25514":109724,"_2665":109784},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3170":65329,"_28022":65305,"_19417":109786,"_5":13306,"_25514":109724,"_2665":48595},[],{"_3170":65330,"_28022":65305,"_19417":109788,"_5":13306,"_25514":109724,"_2665":48581},[],{"_3170":65331,"_28022":65305,"_19417":109790,"_5":13306,"_25514":109724,"_2665":109791},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3170":65332,"_28022":65305,"_19417":109793,"_5":13306,"_25514":109724,"_2665":109794},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3170":65333,"_28022":65305,"_19417":109796,"_5":13306,"_25514":109728,"_2665":109797},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3170":65334,"_28022":65305,"_19417":109799,"_5":13306,"_25514":109728,"_2665":109800},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3170":65335,"_28022":65305,"_19417":109802,"_5":13306,"_25514":109731,"_2665":109803},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3170":65336,"_28022":65305,"_19417":109805,"_5":13306,"_25514":109731,"_2665":109806},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3170":65337,"_28022":65305,"_19417":109808,"_5":13306,"_25514":109734,"_2665":109809},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3170":65338,"_28022":65305,"_19417":109811,"_5":13306,"_25514":109734,"_2665":109812},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3170":65339,"_28022":65305,"_19417":109814,"_5":13306,"_25514":109737,"_2665":109815},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3170":65340,"_28022":65305,"_19417":109817,"_5":13306,"_25514":109737,"_2665":109818},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3170":65341,"_28022":65305,"_19417":109820,"_5":13306,"_25514":109740,"_2665":109821},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3170":65342,"_28022":65305,"_19417":109823,"_5":13306,"_25514":109740,"_2665":109824},[],"Parte",{"_3170":65343,"_28022":65305,"_19417":109826,"_5":13306,"_25514":109740,"_2665":109827},[],"Contenido tras decodificar su Base64",{"_3170":65344,"_28022":65305,"_19417":109829,"_5":13306,"_25514":109740,"_2665":48639},[],{"_3170":65345,"_28022":65305,"_19417":109831,"_5":13306,"_25514":109740,"_2665":109832},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3170":65346,"_28022":65305,"_19417":109834,"_5":13306,"_25514":109740,"_2665":48645},[],{"_3170":65347,"_28022":65305,"_19417":109836,"_5":13306,"_25514":109740,"_2665":109837},[],"PKCS#7 DER con el certificado emitido.",{"_3170":65348,"_28022":65305,"_19417":109839,"_5":13306,"_25514":109740,"_2665":109840},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3170":65349,"_28022":65305,"_19417":109842,"_5":13306,"_25514":109744,"_2665":109843},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3170":65350,"_28022":65305,"_19417":109845,"_5":13306,"_25514":109744,"_2665":109846},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3170":65351,"_28022":65305,"_19417":109848,"_5":13306,"_25514":109744,"_2665":109849},[],"Convierte y comprueba el resultado:",{"_3170":65352,"_28022":65305,"_19417":109851,"_5":13306,"_25514":109744,"_2665":109852},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3170":65353,"_28022":65305,"_19417":109854,"_5":13306,"_25514":109748,"_2665":109855},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3170":65354,"_28022":65305,"_19417":109857,"_5":13306,"_25514":109748,"_2665":109858},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3170":65355,"_28022":65355,"_5":13637,"_2665":109217,"_28344":109860,"_19417":109861,"_25514":65355},[45406,108036,47807,109042,109217],[],{"_3170":65356,"_28022":65355,"_19417":109863,"_5":13306,"_25514":65355,"_2665":109864},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3170":65357,"_28022":65355,"_5":28341,"_19417":109866,"_25514":109867,"_2665":109868},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3170":65358,"_28022":65355,"_5":28341,"_19417":109870,"_25514":109871,"_2665":109872},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3170":65359,"_28022":65355,"_5":28341,"_19417":109874,"_25514":109875,"_2665":109876},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3170":65360,"_28022":65355,"_5":28341,"_19417":109878,"_25514":109879,"_2665":109880},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3170":65361,"_28022":65355,"_19417":109882,"_5":13306,"_25514":65355,"_2665":109883},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3170":65362,"_28022":65355,"_19417":109885,"_5":13306,"_25514":109867,"_2665":109886},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3170":65363,"_28022":65355,"_19417":109888,"_5":13306,"_25514":109867,"_2665":109889},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3170":65364,"_28022":65355,"_19417":109891,"_5":13306,"_25514":109867,"_2665":109892},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3170":65365,"_28022":65355,"_19417":109894,"_5":13306,"_25514":109867,"_2665":109895},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3170":65366,"_28022":65355,"_19417":109897,"_5":13306,"_25514":109867,"_2665":109898},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3170":65367,"_28022":65355,"_19417":109900,"_5":13306,"_25514":109867,"_2665":109901},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3170":65368,"_28022":65355,"_19417":109903,"_5":13306,"_25514":109871,"_2665":109904},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3170":65369,"_28022":65355,"_19417":109906,"_5":13306,"_25514":109871,"_2665":109907},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65370,"_28022":65355,"_19417":109909,"_5":13306,"_25514":109871,"_2665":109910},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3170":65371,"_28022":65355,"_19417":109912,"_5":13306,"_25514":109871,"_2665":109913},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3170":65372,"_28022":65355,"_19417":109915,"_5":13306,"_25514":109875,"_2665":109916},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":65373,"_28022":65355,"_19417":109918,"_5":13306,"_25514":109875,"_2665":109919},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3170":65374,"_28022":65355,"_19417":109921,"_5":13306,"_25514":109875,"_2665":109922},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3170":65375,"_28022":65355,"_19417":109924,"_5":13306,"_25514":109875,"_2665":109925},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3170":65376,"_28022":65355,"_19417":109927,"_5":13306,"_25514":109879,"_2665":109928},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3170":65377,"_28022":65355,"_19417":109930,"_5":13306,"_25514":109879,"_2665":109931},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3170":65378,"_28022":65378,"_5":13637,"_2665":109933,"_28344":109934,"_19417":109935,"_25514":65378},"Estrategias de aprovisionamiento",[45406,108036,47807,109042,109217],[],{"_3170":65379,"_28022":65378,"_19417":109937,"_5":13306,"_25514":65378,"_2665":109938},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3170":65380,"_28022":65378,"_5":28341,"_19417":109940,"_25514":109941,"_2665":109942},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3170":65381,"_28022":65378,"_5":28341,"_19417":109944,"_25514":109945,"_2665":109946},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3170":65382,"_28022":65378,"_5":28341,"_19417":109948,"_25514":109949,"_2665":109950},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3170":65383,"_28022":65378,"_5":28341,"_19417":109952,"_25514":109953,"_2665":109954},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3170":65384,"_28022":65378,"_5":28341,"_19417":109956,"_25514":109957,"_2665":109958},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3170":65385,"_28022":65378,"_19417":109960,"_5":13306,"_25514":65378,"_2665":109961},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3170":65386,"_28022":65378,"_19417":109963,"_5":13306,"_25514":109941,"_2665":109964},[],"Recorrido",{"_3170":65387,"_28022":65378,"_19417":109966,"_5":13306,"_25514":109941,"_2665":109967},[],"Cuándo existe el dispositivo",{"_3170":65388,"_28022":65378,"_19417":109969,"_5":13306,"_25514":109941,"_2665":109970},[],"Qué compruebas",{"_3170":65389,"_28022":65378,"_19417":109972,"_5":13306,"_25514":109941,"_2665":109973},[],"Asignación manual",{"_3170":65390,"_28022":65378,"_19417":109975,"_5":13306,"_25514":109941,"_2665":109976},[],"El operador lo crea antes de asociar un certificado.",{"_3170":65391,"_28022":65378,"_19417":109978,"_5":13306,"_25514":109941,"_2665":109979},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3170":65392,"_28022":65378,"_19417":109981,"_5":13306,"_25514":109941,"_2665":109982},[],"EST con `JITP`",{"_3170":65393,"_28022":65378,"_19417":109984,"_5":13306,"_25514":109941,"_2665":109985},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3170":65394,"_28022":65378,"_19417":109987,"_5":13306,"_25514":109941,"_2665":109988},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3170":65395,"_28022":65378,"_19417":109990,"_5":13306,"_25514":109941,"_2665":109991},[],"EST con `PRE_REGISTRATION`",{"_3170":65396,"_28022":65378,"_19417":109993,"_5":13306,"_25514":109941,"_2665":109994},[],"Debe existir antes de `/simpleenroll`.",{"_3170":65397,"_28022":65378,"_19417":109996,"_5":13306,"_25514":109941,"_2665":109997},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3170":65398,"_28022":65378,"_19417":109999,"_5":13306,"_25514":109941,"_2665":110000},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3170":65399,"_28022":65378,"_19417":110002,"_5":13306,"_25514":109941,"_2665":110003},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3170":65400,"_28022":65378,"_19417":110005,"_5":13306,"_25514":109945,"_2665":110006},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3170":65401,"_28022":65378,"_19417":110008,"_5":13306,"_25514":109945,"_2665":110009},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3170":65402,"_28022":65378,"_19417":110011,"_5":13306,"_25514":109945,"_2665":110012},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3170":65403,"_28022":65378,"_19417":110014,"_5":13306,"_25514":109949,"_2665":110015},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3170":65404,"_28022":65378,"_19417":110017,"_5":13306,"_25514":109949,"_2665":110018},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3170":65405,"_28022":65378,"_19417":110020,"_5":13306,"_25514":109949,"_2665":110021},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3170":65406,"_28022":65378,"_19417":110023,"_5":13306,"_25514":109949,"_2665":110024},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3170":65407,"_28022":65378,"_19417":110026,"_5":13306,"_25514":109949,"_2665":110027},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3170":65408,"_28022":65378,"_19417":110029,"_5":13306,"_25514":109949,"_2665":110030},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3170":65409,"_28022":65378,"_19417":110032,"_5":13306,"_25514":109953,"_2665":107053},[],{"_3170":65410,"_28022":65378,"_19417":110034,"_5":13306,"_25514":109953,"_2665":110035},[],"Material que atraviesa EST",{"_3170":65411,"_28022":65378,"_19417":110037,"_5":13306,"_25514":109953,"_2665":110038},[],"Clave generada por el dispositivo",{"_3170":65412,"_28022":65378,"_19417":110040,"_5":13306,"_25514":109953,"_2665":110041},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3170":65413,"_28022":65378,"_19417":110043,"_5":13306,"_25514":109953,"_2665":110044},[],"Clave ya disponible en el dispositivo",{"_3170":65414,"_28022":65378,"_19417":110046,"_5":13306,"_25514":109953,"_2665":110047},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3170":65415,"_28022":65378,"_19417":110049,"_5":13306,"_25514":109953,"_2665":48126},[],{"_3170":65416,"_28022":65378,"_19417":110051,"_5":13306,"_25514":109953,"_2665":110052},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3170":65417,"_28022":65378,"_19417":110054,"_5":13306,"_25514":109953,"_2665":110055},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3170":65418,"_28022":65378,"_19417":110057,"_5":13306,"_25514":109957,"_2665":110058},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3170":65419,"_28022":65419,"_5":13637,"_2665":110060,"_28344":110061,"_19417":110062,"_25514":65419},"Renovación y recuperación",[45406,108036,47807,109042,109217],[],{"_3170":65420,"_28022":65419,"_19417":110064,"_5":13306,"_25514":65419,"_2665":110065},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3170":65421,"_28022":65419,"_5":28341,"_19417":110067,"_25514":110068,"_2665":110069},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3170":65422,"_28022":65419,"_5":28341,"_19417":110071,"_25514":110072,"_2665":110073},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3170":65423,"_28022":65419,"_5":28341,"_19417":110075,"_25514":110076,"_2665":110077},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3170":65424,"_28022":65419,"_5":28341,"_19417":110079,"_25514":110080,"_2665":110081},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3170":65425,"_28022":65419,"_5":28341,"_19417":110083,"_25514":110084,"_2665":110085},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3170":65426,"_28022":65419,"_19417":110087,"_5":13306,"_25514":65419,"_2665":110088},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3170":65427,"_28022":65419,"_19417":110090,"_5":13306,"_25514":110068,"_2665":110091},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3170":65428,"_28022":65419,"_19417":110093,"_5":13306,"_25514":110068,"_2665":110094},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3170":65429,"_28022":65419,"_19417":110096,"_5":13306,"_25514":110068,"_2665":110097},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3170":65430,"_28022":65419,"_19417":110099,"_5":13306,"_25514":110068,"_2665":110100},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3170":65431,"_28022":65419,"_19417":110102,"_5":13306,"_25514":110072,"_2665":110103},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3170":65432,"_28022":65419,"_19417":110105,"_5":13306,"_25514":110072,"_2665":110106},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3170":65433,"_28022":65419,"_19417":110108,"_5":13306,"_25514":110076,"_2665":110109},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3170":65434,"_28022":65419,"_19417":110111,"_5":13306,"_25514":110076,"_2665":110112},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3170":65435,"_28022":65419,"_19417":110114,"_5":13306,"_25514":110076,"_2665":110115},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3170":65436,"_28022":65419,"_19417":110117,"_5":13306,"_25514":110080,"_2665":110118},[],"Situación",{"_3170":65437,"_28022":65419,"_19417":110120,"_5":13306,"_25514":110080,"_2665":110121},[],"Procedimiento",{"_3170":65438,"_28022":65419,"_19417":110123,"_5":13306,"_25514":110080,"_2665":110124},[],"Certificado vigente, fuera de ventana",{"_3170":65439,"_28022":65419,"_19417":110126,"_5":13306,"_25514":110080,"_2665":110127},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3170":65440,"_28022":65419,"_19417":110129,"_5":13306,"_25514":110080,"_2665":110130},[],"Certificado vencido, clave disponible",{"_3170":65441,"_28022":65419,"_19417":110132,"_5":13306,"_25514":110080,"_2665":110133},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3170":65442,"_28022":65419,"_19417":110135,"_5":13306,"_25514":110080,"_2665":110136},[],"Renovación por webhook o `NO_AUTH`",{"_3170":65443,"_28022":65419,"_19417":110138,"_5":13306,"_25514":110080,"_2665":110139},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3170":65444,"_28022":65419,"_19417":110141,"_5":13306,"_25514":110080,"_2665":110142},[],"Clave perdida o inaccesible",{"_3170":65445,"_28022":65419,"_19417":110144,"_5":13306,"_25514":110080,"_2665":110145},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3170":65446,"_28022":65419,"_19417":110147,"_5":13306,"_25514":110080,"_2665":110148},[],"Identidad actual revocada",{"_3170":65447,"_28022":65419,"_19417":110150,"_5":13306,"_25514":110080,"_2665":110151},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3170":65448,"_28022":65419,"_19417":110153,"_5":13306,"_25514":110080,"_2665":110154},[],"Dispositivo sin identidad",{"_3170":65449,"_28022":65419,"_19417":110156,"_5":13306,"_25514":110080,"_2665":110157},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3170":65450,"_28022":65419,"_19417":110159,"_5":13306,"_25514":110080,"_2665":110160},[],"Dispositivo retirado",{"_3170":65451,"_28022":65419,"_19417":110162,"_5":13306,"_25514":110080,"_2665":110163},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3170":65452,"_28022":65419,"_19417":110165,"_5":13306,"_25514":110080,"_2665":110166},[],"Timeout, HTTP 500 o fallo de instalación",{"_3170":65453,"_28022":65419,"_19417":110168,"_5":13306,"_25514":110080,"_2665":110169},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3170":65454,"_28022":65419,"_19417":110171,"_5":13306,"_25514":110084,"_2665":110172},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3170":65455,"_28022":65419,"_19417":110174,"_5":13306,"_25514":110084,"_2665":110175},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3170":65456,"_28022":65456,"_5":13637,"_2665":110177,"_28344":110178,"_19417":110179,"_25514":65456},"Diagnóstico de enrolamiento",[45406,108036,47807,109042,109217],[],{"_3170":65457,"_28022":65456,"_19417":110181,"_5":13306,"_25514":65456,"_2665":110182},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3170":65458,"_28022":65456,"_5":28341,"_19417":110184,"_25514":110185,"_2665":110186},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3170":65459,"_28022":65456,"_5":28341,"_19417":110188,"_25514":110189,"_2665":110190},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3170":65460,"_28022":65456,"_5":28341,"_19417":110192,"_25514":110193,"_2665":109749},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3170":65461,"_28022":65456,"_5":28341,"_19417":110195,"_25514":110196,"_2665":110197},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3170":65462,"_28022":65456,"_19417":110199,"_5":13306,"_25514":65456,"_2665":110200},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3170":65463,"_28022":65456,"_19417":110202,"_5":13306,"_25514":110189,"_2665":110203},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3170":65464,"_28022":65456,"_19417":110205,"_5":13306,"_25514":110189,"_2665":110206},[],"Síntoma o mensaje",{"_3170":65465,"_28022":65456,"_19417":110208,"_5":13306,"_25514":110189,"_2665":110209},[],"Qué revisar",{"_3170":65466,"_28022":65456,"_19417":110211,"_5":13306,"_25514":110189,"_2665":110212},[],"curl rechaza TLS, nombre o emisor",{"_3170":65467,"_28022":65456,"_19417":110214,"_5":13306,"_25514":110189,"_2665":110215},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3170":65468,"_28022":65456,"_19417":110217,"_5":13306,"_25514":110189,"_2665":110218},[],"404 o APS ausente",{"_3170":65469,"_28022":65456,"_19417":110220,"_5":13306,"_25514":110189,"_2665":110221},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3170":65470,"_28022":65456,"_19417":110223,"_5":13306,"_25514":110189,"_2665":110224},[],"400, error de CSR o formato",{"_3170":65471,"_28022":65456,"_19417":110226,"_5":13306,"_25514":110189,"_2665":110227},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3170":65472,"_28022":65456,"_19417":110229,"_5":13306,"_25514":110189,"_2665":110230},[],"Credencial ausente o certificado no válido",{"_3170":65473,"_28022":65456,"_19417":110232,"_5":13306,"_25514":110189,"_2665":110233},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3170":65474,"_28022":65456,"_19417":110235,"_5":13306,"_25514":110189,"_2665":110236},[],"Webhook deniega, expira o responde sin autorización",{"_3170":65475,"_28022":65456,"_19417":110238,"_5":13306,"_25514":110189,"_2665":110239},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3170":65476,"_28022":65456,"_19417":110241,"_5":13306,"_25514":110189,"_2665":49052},[],{"_3170":65477,"_28022":65456,"_19417":110243,"_5":13306,"_25514":110189,"_2665":110244},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3170":65478,"_28022":65456,"_19417":110246,"_5":13306,"_25514":110189,"_2665":49058},[],{"_3170":65479,"_28022":65456,"_19417":110248,"_5":13306,"_25514":110189,"_2665":110249},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3170":65480,"_28022":65456,"_19417":110251,"_5":13306,"_25514":110189,"_2665":49064},[],{"_3170":65481,"_28022":65456,"_19417":110253,"_5":13306,"_25514":110189,"_2665":110254},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3170":65482,"_28022":65456,"_19417":110256,"_5":13306,"_25514":110189,"_2665":49070},[],{"_3170":65483,"_28022":65456,"_19417":110258,"_5":13306,"_25514":110189,"_2665":110259},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3170":65484,"_28022":65456,"_19417":110261,"_5":13306,"_25514":110189,"_2665":49076},[],{"_3170":65485,"_28022":65456,"_19417":110263,"_5":13306,"_25514":110189,"_2665":110264},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3170":65486,"_28022":65456,"_19417":110266,"_5":13306,"_25514":110189,"_2665":110267},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3170":65487,"_28022":65456,"_19417":110269,"_5":13306,"_25514":110189,"_2665":110270},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3170":65488,"_28022":65456,"_19417":110272,"_5":13306,"_25514":110189,"_2665":110273},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3170":65489,"_28022":65456,"_19417":110275,"_5":13306,"_25514":110189,"_2665":110276},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3170":65490,"_28022":65456,"_19417":110278,"_5":13306,"_25514":110189,"_2665":49094},[],{"_3170":65491,"_28022":65456,"_19417":110280,"_5":13306,"_25514":110189,"_2665":110281},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3170":65492,"_28022":65456,"_19417":110283,"_5":13306,"_25514":110189,"_2665":49100},[],{"_3170":65493,"_28022":65456,"_19417":110285,"_5":13306,"_25514":110189,"_2665":110286},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3170":65494,"_28022":65456,"_19417":110288,"_5":13306,"_25514":110189,"_2665":110289},[],"DMS propietario distinto",{"_3170":65495,"_28022":65456,"_19417":110291,"_5":13306,"_25514":110189,"_2665":110292},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3170":65496,"_28022":65456,"_19417":110294,"_5":13306,"_25514":110189,"_2665":49112},[],{"_3170":65497,"_28022":65456,"_19417":110296,"_5":13306,"_25514":110189,"_2665":110297},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3170":65498,"_28022":65456,"_19417":110299,"_5":13306,"_25514":110189,"_2665":49118},[],{"_3170":65499,"_28022":65456,"_19417":110301,"_5":13306,"_25514":110189,"_2665":110302},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3170":65500,"_28022":65456,"_19417":110304,"_5":13306,"_25514":110189,"_2665":110305},[],"Certificado actual revocado",{"_3170":65501,"_28022":65456,"_19417":110307,"_5":13306,"_25514":110189,"_2665":110308},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3170":65502,"_28022":65456,"_19417":110310,"_5":13306,"_25514":110189,"_2665":110311},[],"Error de CA, perfil o firma",{"_3170":65503,"_28022":65456,"_19417":110313,"_5":13306,"_25514":110189,"_2665":110314},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3170":65504,"_28022":65456,"_19417":110316,"_5":13306,"_25514":110189,"_2665":110317},[],"HTTP 200 sin conexión del dispositivo",{"_3170":65505,"_28022":65456,"_19417":110319,"_5":13306,"_25514":110189,"_2665":110320},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3170":65506,"_28022":65456,"_19417":110322,"_5":13306,"_25514":110189,"_2665":110323},[],"Timeout o error después de emitir",{"_3170":65507,"_28022":65456,"_19417":110325,"_5":13306,"_25514":110189,"_2665":110326},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3170":65508,"_28022":65456,"_19417":110328,"_5":13306,"_25514":110193,"_2665":110329},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3170":65509,"_28022":65456,"_19417":110331,"_5":13306,"_25514":110193,"_2665":110332},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3170":65510,"_28022":65456,"_19417":110334,"_5":13306,"_25514":110196,"_2665":110335},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3170":65511,"_28022":65456,"_19417":110337,"_5":13306,"_25514":110196,"_2665":110338},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3170":65512,"_28022":65456,"_19417":110340,"_5":13306,"_25514":110196,"_2665":110341},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3170":65513,"_28022":65456,"_19417":110343,"_5":13306,"_25514":110196,"_2665":110344},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3170":65514,"_28022":65456,"_19417":110346,"_5":13306,"_25514":110196,"_2665":110347},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3170":65515,"_28022":65456,"_19417":110349,"_5":13306,"_25514":110196,"_2665":110350},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3170":65516,"_28022":65456,"_19417":110352,"_5":13306,"_25514":110196,"_2665":110353},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3170":65517,"_28022":65517,"_5":13637,"_2665":110355,"_28344":110356,"_19417":110357,"_25514":65517},"Distribución y actualización de confianza",[45406,108036,47807,109042,109217],[],{"_3170":65518,"_28022":65517,"_19417":110359,"_5":13306,"_25514":65517,"_2665":110360},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3170":65519,"_28022":65517,"_5":28341,"_19417":110362,"_25514":110363,"_2665":110364},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3170":65520,"_28022":65517,"_5":28341,"_19417":110366,"_25514":110367,"_2665":110368},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3170":65521,"_28022":65517,"_5":28341,"_19417":110370,"_25514":110371,"_2665":110372},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3170":65522,"_28022":65517,"_5":28341,"_19417":110374,"_25514":110375,"_2665":110376},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3170":65523,"_28022":65517,"_5":28341,"_19417":110378,"_25514":110379,"_2665":110380},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3170":65524,"_28022":65517,"_19417":110382,"_5":13306,"_25514":65517,"_2665":110383},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3170":65525,"_28022":65517,"_19417":110385,"_5":13306,"_25514":110363,"_2665":110386},[],"Relación",{"_3170":65526,"_28022":65517,"_19417":110388,"_5":13306,"_25514":110363,"_2665":110389},[],"Material que prepara el responsable",{"_3170":65527,"_28022":65517,"_19417":110391,"_5":13306,"_25514":110363,"_2665":110392},[],"Dispositivo → servidor EST",{"_3170":65528,"_28022":65517,"_19417":110394,"_5":13306,"_25514":110363,"_2665":110395},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3170":65529,"_28022":65517,"_19417":110397,"_5":13306,"_25514":110363,"_2665":110398},[],"DMS → solicitante",{"_3170":65530,"_28022":65517,"_19417":110400,"_5":13306,"_25514":110363,"_2665":110401},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3170":65531,"_28022":65517,"_19417":110403,"_5":13306,"_25514":110363,"_2665":110404},[],"Consumidor → dispositivo",{"_3170":65532,"_28022":65517,"_19417":110406,"_5":13306,"_25514":110363,"_2665":110407},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3170":65533,"_28022":65517,"_19417":110409,"_5":13306,"_25514":110363,"_2665":110410},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3170":65534,"_28022":65517,"_19417":110412,"_5":13306,"_25514":110367,"_2665":110413},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3170":65535,"_28022":65517,"_19417":110415,"_5":13306,"_25514":110367,"_2665":110416},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3170":65536,"_28022":65517,"_19417":110418,"_5":13306,"_25514":110371,"_2665":110419},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3170":65537,"_28022":65517,"_19417":110421,"_5":13306,"_25514":110371,"_2665":110422},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3170":65538,"_28022":65517,"_19417":110424,"_5":13306,"_25514":110371,"_2665":110425},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3170":65539,"_28022":65517,"_19417":110427,"_5":13306,"_25514":110371,"_2665":110428},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3170":65540,"_28022":65517,"_19417":110430,"_5":13306,"_25514":110371,"_2665":110431},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3170":65541,"_28022":65517,"_19417":110433,"_5":13306,"_25514":110371,"_2665":110434},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3170":65542,"_28022":65517,"_19417":110436,"_5":13306,"_25514":110375,"_2665":110437},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3170":65543,"_28022":65517,"_19417":110439,"_5":13306,"_25514":110375,"_2665":110440},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3170":65544,"_28022":65517,"_19417":110442,"_5":13306,"_25514":110375,"_2665":110443},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3170":65545,"_28022":65517,"_19417":110445,"_5":13306,"_25514":110379,"_2665":110446},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3170":65546,"_28022":65546,"_5":13637,"_2665":49267,"_28344":110448,"_19417":110450,"_25514":65546},[45406,108036,47807,109042,110449],"Integraciones",[],{"_3170":65547,"_28022":65546,"_19417":110452,"_5":13306,"_25514":65546,"_2665":110453},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3170":65548,"_28022":65546,"_5":28341,"_19417":110455,"_25514":110456,"_2665":110457},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3170":65549,"_28022":65546,"_5":28341,"_19417":110459,"_25514":110460,"_2665":110461},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3170":65550,"_28022":65546,"_5":28341,"_19417":110463,"_25514":110464,"_2665":110465},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3170":65551,"_28022":65546,"_5":28341,"_19417":110467,"_25514":110468,"_2665":110469},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3170":65552,"_28022":65546,"_5":28341,"_19417":110471,"_25514":110472,"_2665":110473},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3170":65553,"_28022":65546,"_5":28341,"_19417":110475,"_25514":110476,"_2665":110477},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3170":65554,"_28022":65546,"_5":28341,"_19417":110479,"_25514":110480,"_2665":49301},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3170":65555,"_28022":65546,"_5":28341,"_19417":110482,"_25514":110483,"_2665":49305},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3170":65556,"_28022":65546,"_5":28341,"_19417":110485,"_25514":110486,"_2665":110487},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3170":65557,"_28022":65546,"_5":28341,"_19417":110489,"_25514":110490,"_2665":110491},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3170":65558,"_28022":65546,"_5":28341,"_19417":110493,"_25514":110494,"_2665":110495},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3170":65559,"_28022":65546,"_5":28341,"_19417":110497,"_25514":110498,"_2665":110499},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3170":65560,"_28022":65546,"_5":28341,"_19417":110501,"_25514":110502,"_2665":110503},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3170":65561,"_28022":65546,"_5":28341,"_19417":110505,"_25514":110506,"_2665":110507},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3170":65562,"_28022":65546,"_5":28341,"_19417":110509,"_25514":110510,"_2665":110511},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3170":65563,"_28022":65546,"_5":28341,"_19417":110513,"_25514":110514,"_2665":110515},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3170":65564,"_28022":65546,"_5":28341,"_19417":110517,"_25514":110518,"_2665":110519},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3170":65565,"_28022":65546,"_5":28341,"_19417":110521,"_25514":110522,"_2665":110523},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3170":65566,"_28022":65546,"_5":28341,"_19417":110525,"_25514":110526,"_2665":110527},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3170":65567,"_28022":65546,"_5":28341,"_19417":110529,"_25514":110530,"_2665":110531},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3170":65568,"_28022":65546,"_19417":110533,"_5":13306,"_25514":65546,"_2665":110534},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3170":65569,"_28022":65546,"_19417":110536,"_5":13306,"_25514":65546,"_2665":110537},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3170":65570,"_28022":65546,"_19417":110539,"_5":13306,"_25514":65546,"_2665":110540},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3170":65571,"_28022":65546,"_19417":110542,"_5":13306,"_25514":110456,"_2665":110543},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3170":65572,"_28022":65546,"_19417":110545,"_5":13306,"_25514":110456,"_2665":110546},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3170":65573,"_28022":65546,"_19417":110548,"_5":13306,"_25514":110456,"_2665":110549},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3170":65574,"_28022":65546,"_19417":110551,"_5":13306,"_25514":110456,"_2665":110552},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3170":65575,"_28022":65546,"_19417":110554,"_5":13306,"_25514":110460,"_2665":110555},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3170":65576,"_28022":65546,"_19417":110557,"_5":13306,"_25514":110464,"_2665":110558},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3170":65577,"_28022":65546,"_19417":110560,"_5":13306,"_25514":110464,"_2665":110561},[],"Acción IAM",{"_3170":65578,"_28022":65546,"_19417":110563,"_5":13306,"_25514":110464,"_2665":107059},[],{"_3170":65579,"_28022":65546,"_19417":110565,"_5":13306,"_25514":110464,"_2665":49388},[],{"_3170":65580,"_28022":65546,"_19417":110567,"_5":13306,"_25514":110464,"_2665":110568},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3170":65581,"_28022":65546,"_19417":110570,"_5":13306,"_25514":110464,"_2665":49394},[],{"_3170":65582,"_28022":65546,"_19417":110572,"_5":13306,"_25514":110464,"_2665":110573},[],"Registrar la CA en AWS IoT",{"_3170":65583,"_28022":65546,"_19417":110575,"_5":13306,"_25514":110464,"_2665":49400},[],{"_3170":65584,"_28022":65546,"_19417":110577,"_5":13306,"_25514":110464,"_2665":110578},[],"Consultar el estado del registro de la CA",{"_3170":65585,"_28022":65546,"_19417":110580,"_5":13306,"_25514":110464,"_2665":49406},[],{"_3170":65586,"_28022":65546,"_19417":110582,"_5":13306,"_25514":110464,"_2665":110583},[],"Crear o actualizar Things en IoT Core",{"_3170":65587,"_28022":65546,"_19417":110585,"_5":13306,"_25514":110464,"_2665":49412},[],{"_3170":65588,"_28022":65546,"_19417":110587,"_5":13306,"_25514":110464,"_2665":110588},[],"Aprovisionar Things mediante plantilla",{"_3170":65589,"_28022":65546,"_19417":110590,"_5":13306,"_25514":110464,"_2665":49418},[],{"_3170":65590,"_28022":65546,"_19417":110592,"_5":13306,"_25514":110464,"_2665":110593},[],"Registrar certificados de dispositivo",{"_3170":65591,"_28022":65546,"_19417":110595,"_5":13306,"_25514":110464,"_2665":49424},[],{"_3170":65592,"_28022":65546,"_19417":110597,"_5":13306,"_25514":110464,"_2665":110598},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3170":65593,"_28022":65546,"_19417":110600,"_5":13306,"_25514":110464,"_2665":49430},[],{"_3170":65594,"_28022":65546,"_19417":110602,"_5":13306,"_25514":110464,"_2665":110603},[],"Crear y adjuntar políticas IoT",{"_3170":65595,"_28022":65546,"_19417":110605,"_5":13306,"_25514":110464,"_2665":49436},[],{"_3170":65596,"_28022":65546,"_19417":110607,"_5":13306,"_25514":110464,"_2665":110608},[],"Gestionar grupos de Things",{"_3170":65597,"_28022":65546,"_19417":110610,"_5":13306,"_25514":110464,"_2665":49442},[],{"_3170":65598,"_28022":65546,"_19417":110612,"_5":13306,"_25514":110464,"_2665":110613},[],"Crear plantillas JITP",{"_3170":65599,"_28022":65546,"_19417":110615,"_5":13306,"_25514":110464,"_2665":49448},[],{"_3170":65600,"_28022":65546,"_19417":110617,"_5":13306,"_25514":110464,"_2665":110618},[],"Leer y escribir el Device Shadow",{"_3170":65601,"_28022":65546,"_19417":110620,"_5":13306,"_25514":110464,"_2665":110621},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3170":65602,"_28022":65546,"_19417":110623,"_5":13306,"_25514":110468,"_2665":110624},[],"Parámetro",{"_3170":65603,"_28022":65546,"_19417":110626,"_5":13306,"_25514":110468,"_2665":110627},[],"Tipo",{"_3170":65604,"_28022":65546,"_19417":110629,"_5":13306,"_25514":110468,"_2665":110630},[],"Requerido",{"_3170":65605,"_28022":65546,"_19417":110632,"_5":13306,"_25514":110468,"_2665":110633},[],"Descripción",{"_3170":65606,"_28022":65546,"_19417":110635,"_5":13306,"_25514":110468,"_2665":49469},[],{"_3170":65607,"_28022":65546,"_19417":110637,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65608,"_28022":65546,"_19417":110639,"_5":13306,"_25514":110468,"_2665":110640},[],"Sí",{"_3170":65609,"_28022":65546,"_19417":110642,"_5":13306,"_25514":110468,"_2665":110643},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3170":65610,"_28022":65546,"_19417":110645,"_5":13306,"_25514":110468,"_2665":49480},[],{"_3170":65611,"_28022":65546,"_19417":110647,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65612,"_28022":65546,"_19417":110649,"_5":13306,"_25514":110468,"_2665":110640},[],{"_3170":65613,"_28022":65546,"_19417":110651,"_5":13306,"_25514":110468,"_2665":110652},[],"Región AWS donde opera el conector.",{"_3170":65614,"_28022":65546,"_19417":110654,"_5":13306,"_25514":110468,"_2665":49490},[],{"_3170":65615,"_28022":65546,"_19417":110656,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65616,"_28022":65546,"_19417":110658,"_5":13306,"_25514":110468,"_2665":110640},[],{"_3170":65617,"_28022":65546,"_19417":110660,"_5":13306,"_25514":110468,"_2665":110661},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3170":65618,"_28022":65546,"_19417":110663,"_5":13306,"_25514":110468,"_2665":49500},[],{"_3170":65619,"_28022":65546,"_19417":110665,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65620,"_28022":65546,"_19417":110667,"_5":13306,"_25514":110468,"_2665":110668},[],"Solo con `auth_method=static`",{"_3170":65621,"_28022":65546,"_19417":110670,"_5":13306,"_25514":110468,"_2665":110671},[],"Clave de acceso AWS.",{"_3170":65622,"_28022":65546,"_19417":110673,"_5":13306,"_25514":110468,"_2665":49511},[],{"_3170":65623,"_28022":65546,"_19417":110675,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65624,"_28022":65546,"_19417":110677,"_5":13306,"_25514":110468,"_2665":110668},[],{"_3170":65625,"_28022":65546,"_19417":110679,"_5":13306,"_25514":110468,"_2665":110680},[],"Clave secreta AWS.",{"_3170":65626,"_28022":65546,"_19417":110682,"_5":13306,"_25514":110468,"_2665":49521},[],{"_3170":65627,"_28022":65546,"_19417":110684,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65628,"_28022":65546,"_19417":110686,"_5":13306,"_25514":110468,"_2665":49526},[],{"_3170":65629,"_28022":65546,"_19417":110688,"_5":13306,"_25514":110468,"_2665":110689},[],"Token de sesión (con `auth_method=static`).",{"_3170":65630,"_28022":65546,"_19417":110691,"_5":13306,"_25514":110468,"_2665":49532},[],{"_3170":65631,"_28022":65546,"_19417":110693,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65632,"_28022":65546,"_19417":110695,"_5":13306,"_25514":110468,"_2665":110696},[],"Solo con `auth_method=role`",{"_3170":65633,"_28022":65546,"_19417":110698,"_5":13306,"_25514":110468,"_2665":110699},[],"ARN del rol a asumir.",{"_3170":65634,"_28022":65546,"_19417":110701,"_5":13306,"_25514":110468,"_2665":49543},[],{"_3170":65635,"_28022":65546,"_19417":110703,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65636,"_28022":65546,"_19417":110705,"_5":13306,"_25514":110468,"_2665":49526},[],{"_3170":65637,"_28022":65546,"_19417":110707,"_5":13306,"_25514":110468,"_2665":110708},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3170":65638,"_28022":65546,"_19417":110710,"_5":13306,"_25514":110468,"_2665":49553},[],{"_3170":65639,"_28022":65546,"_19417":110712,"_5":13306,"_25514":110468,"_2665":16351},[],{"_3170":65640,"_28022":65546,"_19417":110714,"_5":13306,"_25514":110468,"_2665":110640},[],{"_3170":65641,"_28022":65546,"_19417":110716,"_5":13306,"_25514":110468,"_2665":110717},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3170":65642,"_28022":65546,"_19417":110719,"_5":13306,"_25514":110468,"_2665":49563},[],{"_3170":65643,"_28022":65546,"_19417":110721,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65644,"_28022":65546,"_19417":110723,"_5":13306,"_25514":110468,"_2665":110640},[],{"_3170":65645,"_28022":65546,"_19417":110725,"_5":13306,"_25514":110468,"_2665":110726},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3170":65646,"_28022":65546,"_19417":110728,"_5":13306,"_25514":110468,"_2665":49573},[],{"_3170":65647,"_28022":65546,"_19417":110730,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65648,"_28022":65546,"_19417":110732,"_5":13306,"_25514":110468,"_2665":110640},[],{"_3170":65649,"_28022":65546,"_19417":110734,"_5":13306,"_25514":110468,"_2665":110735},[],"URL HTTP del Device Manager de Lamassu.",{"_3170":65650,"_28022":65546,"_19417":110737,"_5":13306,"_25514":110468,"_2665":49583},[],{"_3170":65651,"_28022":65546,"_19417":110739,"_5":13306,"_25514":110468,"_2665":23219},[],{"_3170":65652,"_28022":65546,"_19417":110741,"_5":13306,"_25514":110468,"_2665":110640},[],{"_3170":65653,"_28022":65546,"_19417":110743,"_5":13306,"_25514":110468,"_2665":110744},[],"URL HTTP del servicio de CA de Lamassu.",{"_3170":65654,"_28022":65546,"_19417":110746,"_5":13306,"_25514":110472,"_2665":110747},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3170":65655,"_28022":65546,"_19417":110749,"_5":13306,"_25514":110476,"_2665":110750},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3170":65656,"_28022":65546,"_19417":110752,"_5":13306,"_25514":110476,"_2665":110753},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3170":65657,"_28022":65546,"_19417":110755,"_5":13306,"_25514":110480,"_2665":110756},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3170":65658,"_28022":65546,"_19417":110758,"_5":13306,"_25514":110480,"_2665":110759},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3170":65659,"_28022":65546,"_19417":110761,"_5":13306,"_25514":110480,"_2665":110762},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3170":65660,"_28022":65546,"_19417":110764,"_5":13306,"_25514":110480,"_2665":110765},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3170":65661,"_28022":65546,"_19417":110767,"_5":13306,"_25514":110480,"_2665":110768},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3170":65662,"_28022":65546,"_19417":110770,"_5":13306,"_25514":110480,"_2665":110771},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3170":65663,"_28022":65546,"_19417":110773,"_5":13306,"_25514":110483,"_2665":110774},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3170":65664,"_28022":65546,"_19417":110776,"_5":13306,"_25514":110486,"_2665":110777},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3170":65665,"_28022":65546,"_19417":110779,"_5":13306,"_25514":110486,"_2665":110780},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3170":65666,"_28022":65546,"_19417":110782,"_5":13306,"_25514":110490,"_2665":110783},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3170":65667,"_28022":65546,"_19417":110785,"_5":13306,"_25514":110494,"_2665":110786},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3170":65668,"_28022":65546,"_19417":110788,"_5":13306,"_25514":110494,"_2665":110789},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3170":65669,"_28022":65546,"_19417":110791,"_5":13306,"_25514":110494,"_2665":110792},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3170":65670,"_28022":65546,"_19417":110794,"_5":13306,"_25514":110494,"_2665":110795},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3170":65671,"_28022":65546,"_19417":110797,"_5":13306,"_25514":110494,"_2665":110798},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3170":65672,"_28022":65546,"_19417":110800,"_5":13306,"_25514":110494,"_2665":110801},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3170":65673,"_28022":65546,"_19417":110803,"_5":13306,"_25514":110498,"_2665":110804},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3170":65674,"_28022":65546,"_19417":110806,"_5":13306,"_25514":110498,"_2665":110807},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3170":65675,"_28022":65546,"_19417":110809,"_5":13306,"_25514":110498,"_2665":110810},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3170":65676,"_28022":65546,"_19417":110812,"_5":13306,"_25514":110502,"_2665":110813},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3170":65677,"_28022":65546,"_19417":110815,"_5":13306,"_25514":110502,"_2665":110816},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3170":65678,"_28022":65546,"_19417":110818,"_5":13306,"_25514":110502,"_2665":110819},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3170":65679,"_28022":65546,"_19417":110821,"_5":13306,"_25514":110506,"_2665":110822},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3170":65680,"_28022":65546,"_19417":110824,"_5":13306,"_25514":110506,"_2665":110825},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3170":65681,"_28022":65546,"_19417":110827,"_5":13306,"_25514":110506,"_2665":110828},[],"Para que el flujo JITP funcione correctamente:",{"_3170":65682,"_28022":65546,"_19417":110830,"_5":13306,"_25514":110506,"_2665":110831},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3170":65683,"_28022":65546,"_19417":110833,"_5":13306,"_25514":110506,"_2665":110834},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3170":65684,"_28022":65546,"_19417":110836,"_5":13306,"_25514":110506,"_2665":110837},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3170":65685,"_28022":65546,"_19417":110839,"_5":13306,"_25514":110506,"_2665":110840},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3170":65686,"_28022":65546,"_19417":110842,"_5":13306,"_25514":110510,"_2665":110843},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3170":65687,"_28022":65546,"_19417":110845,"_5":13306,"_25514":110510,"_2665":110846},[],"Estado en Lamassu",{"_3170":65688,"_28022":65546,"_19417":110848,"_5":13306,"_25514":110510,"_2665":110849},[],"Razón de revocación",{"_3170":65689,"_28022":65546,"_19417":110851,"_5":13306,"_25514":110510,"_2665":110852},[],"Estado en AWS IoT Core",{"_3170":65690,"_28022":65546,"_19417":110854,"_5":13306,"_25514":110510,"_2665":49704},[],{"_3170":65691,"_28022":65546,"_19417":110856,"_5":13306,"_25514":110510,"_2665":110857},[],"Ninguna",{"_3170":65692,"_28022":65546,"_19417":110859,"_5":13306,"_25514":110510,"_2665":49710},[],{"_3170":65693,"_28022":65546,"_19417":110861,"_5":13306,"_25514":110510,"_2665":49713},[],{"_3170":65694,"_28022":65546,"_19417":110863,"_5":13306,"_25514":110510,"_2665":49716},[],{"_3170":65695,"_28022":65546,"_19417":110865,"_5":13306,"_25514":110510,"_2665":49719},[],{"_3170":65696,"_28022":65546,"_19417":110867,"_5":13306,"_25514":110510,"_2665":49713},[],{"_3170":65697,"_28022":65546,"_19417":110869,"_5":13306,"_25514":110510,"_2665":110870},[],"Cualquier otra razón",{"_3170":65698,"_28022":65546,"_19417":110872,"_5":13306,"_25514":110510,"_2665":49727},[],{"_3170":65699,"_28022":65546,"_19417":110874,"_5":13306,"_25514":110510,"_2665":110875},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3170":65700,"_28022":65546,"_19417":110877,"_5":13306,"_25514":110514,"_2665":110878},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3170":65701,"_28022":65546,"_19417":110880,"_5":13306,"_25514":110514,"_2665":110881},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3170":65702,"_28022":65546,"_19417":110883,"_5":13306,"_25514":110514,"_2665":110884},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3170":65703,"_28022":65546,"_19417":110886,"_5":13306,"_25514":110518,"_2665":110887},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3170":65704,"_28022":65546,"_19417":110889,"_5":13306,"_25514":110518,"_2665":110890},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3170":65705,"_28022":65546,"_19417":110892,"_5":13306,"_25514":110522,"_2665":110893},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3170":65706,"_28022":65546,"_19417":110895,"_5":13306,"_25514":110522,"_2665":110896},[],"Existen dos tipos de acciones:",{"_3170":65707,"_28022":65546,"_19417":110898,"_5":13306,"_25514":110522,"_2665":110899},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3170":65708,"_28022":65546,"_19417":110901,"_5":13306,"_25514":110522,"_2665":110902},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3170":65709,"_28022":65546,"_19417":110904,"_5":13306,"_25514":110522,"_2665":110905},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3170":65710,"_28022":65546,"_19417":110907,"_5":13306,"_25514":110526,"_2665":110908},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3170":65711,"_28022":65546,"_19417":110910,"_5":13306,"_25514":110526,"_2665":110911},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3170":65712,"_28022":65546,"_19417":110913,"_5":13306,"_25514":110526,"_2665":110914},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3170":65713,"_28022":65546,"_19417":110916,"_5":13306,"_25514":110530,"_2665":110917},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3170":65714,"_28022":65546,"_19417":110919,"_5":13306,"_25514":110530,"_2665":110920},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3170":65715,"_28022":65546,"_19417":110922,"_5":13306,"_25514":110530,"_2665":110923},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3170":65716,"_28022":65546,"_19417":110925,"_5":13306,"_25514":110530,"_2665":110926},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3170":65717,"_28022":65546,"_19417":110928,"_5":13306,"_25514":110530,"_2665":110929},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3170":65718,"_28022":65546,"_19417":110931,"_5":13306,"_25514":110530,"_2665":110932},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3170":65719,"_28022":65546,"_19417":110934,"_5":13306,"_25514":110530,"_2665":110935},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3170":65720,"_28022":65546,"_19417":110937,"_5":13306,"_25514":110530,"_2665":110938},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3170":65721,"_28022":65546,"_19417":110940,"_5":13306,"_25514":110530,"_2665":110941},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3170":65722,"_28022":65546,"_19417":110943,"_5":13306,"_25514":110530,"_2665":110944},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3170":65723,"_28022":65546,"_19417":110946,"_5":13306,"_25514":110530,"_2665":110947},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3170":65724,"_28022":65546,"_19417":110949,"_5":13306,"_25514":110530,"_2665":110950},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3170":65725,"_28022":65546,"_19417":110952,"_5":13306,"_25514":110530,"_2665":110953},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3170":65726,"_28022":65546,"_19417":110955,"_5":13306,"_25514":110530,"_2665":110956},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3170":65727,"_28022":65546,"_19417":110958,"_5":13306,"_25514":110530,"_2665":110959},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3170":65728,"_28022":65546,"_19417":110961,"_5":13306,"_25514":110530,"_2665":110962},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3170":65729,"_28022":65546,"_19417":110964,"_5":13306,"_25514":110530,"_2665":110965},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3170":65730,"_28022":65546,"_19417":110967,"_5":13306,"_25514":110530,"_2665":110968},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3170":65731,"_28022":65546,"_19417":110970,"_5":13306,"_25514":110530,"_2665":110971},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65732,"_28022":65546,"_19417":110973,"_5":13306,"_25514":110530,"_2665":110974},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3170":65733,"_28022":65546,"_19417":110976,"_5":13306,"_25514":110530,"_2665":110977},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3170":65734,"_28022":65734,"_5":13637,"_2665":47807,"_28344":110979,"_19417":110980,"_25514":65734},[45406,108036,47807],[],{"_3170":65735,"_28022":65734,"_19417":110982,"_5":13306,"_25514":65734,"_2665":110983},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3170":65736,"_28022":65734,"_5":28341,"_19417":110985,"_25514":110986,"_2665":110987},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3170":65737,"_28022":65734,"_5":28341,"_19417":110989,"_25514":110990,"_2665":109042},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3170":65738,"_28022":65734,"_5":28341,"_19417":110992,"_25514":110993,"_2665":109217},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3170":65739,"_28022":65734,"_5":28341,"_19417":110995,"_25514":110996,"_2665":110449},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3170":65740,"_28022":65734,"_5":28341,"_19417":110998,"_25514":110999,"_2665":111000},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3170":65741,"_28022":65734,"_19417":111002,"_5":13306,"_25514":65734,"_2665":111003},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3170":65742,"_28022":65734,"_19417":111005,"_5":13306,"_25514":110986,"_2665":111006},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3170":65743,"_28022":65734,"_19417":111008,"_5":13306,"_25514":110986,"_2665":111009},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3170":65744,"_28022":65734,"_19417":111011,"_5":13306,"_25514":110990,"_2665":111012},[],"Recurso",{"_3170":65745,"_28022":65734,"_19417":111014,"_5":13306,"_25514":110990,"_2665":111015},[],"Qué representa",{"_3170":65746,"_28022":65734,"_19417":111017,"_5":13306,"_25514":110990,"_2665":111018},[],"**Dispositivo**",{"_3170":65747,"_28022":65734,"_19417":111020,"_5":13306,"_25514":110990,"_2665":111021},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3170":65748,"_28022":65734,"_19417":111023,"_5":13306,"_25514":110990,"_2665":111024},[],"**Identidad**",{"_3170":65749,"_28022":65734,"_19417":111026,"_5":13306,"_25514":110990,"_2665":111027},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3170":65750,"_28022":65734,"_19417":111029,"_5":13306,"_25514":110990,"_2665":49885},[],{"_3170":65751,"_28022":65734,"_19417":111031,"_5":13306,"_25514":110990,"_2665":111032},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3170":65752,"_28022":65734,"_19417":111034,"_5":13306,"_25514":110990,"_2665":111035},[],"**Flota**",{"_3170":65753,"_28022":65734,"_19417":111037,"_5":13306,"_25514":110990,"_2665":111038},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3170":65754,"_28022":65734,"_19417":111040,"_5":13306,"_25514":110990,"_2665":111041},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3170":65755,"_28022":65734,"_19417":111043,"_5":13306,"_25514":110990,"_2665":111044},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3170":65756,"_28022":65734,"_19417":111046,"_5":13306,"_25514":110993,"_2665":111047},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3170":65757,"_28022":65734,"_19417":111049,"_5":13306,"_25514":110993,"_2665":111050},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3170":65758,"_28022":65734,"_19417":111052,"_5":13306,"_25514":110993,"_2665":111053},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3170":65759,"_28022":65734,"_19417":111055,"_5":13306,"_25514":110993,"_2665":111056},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3170":65760,"_28022":65734,"_19417":111058,"_5":13306,"_25514":110993,"_2665":111059},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3170":65761,"_28022":65734,"_19417":111061,"_5":13306,"_25514":110993,"_2665":111062},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3170":65762,"_28022":65734,"_19417":111064,"_5":13306,"_25514":110993,"_2665":111065},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3170":65763,"_28022":65734,"_19417":111067,"_5":13306,"_25514":110993,"_2665":111068},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3170":65764,"_28022":65734,"_19417":111070,"_5":13306,"_25514":110996,"_2665":111071},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3170":65765,"_28022":65734,"_19417":111073,"_5":13306,"_25514":110996,"_2665":111074},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3170":65766,"_28022":65734,"_19417":111076,"_5":13306,"_25514":110999,"_2665":111077},[],"Participante",{"_3170":65767,"_28022":65734,"_19417":111079,"_5":13306,"_25514":110999,"_2665":111080},[],"Responsabilidad",{"_3170":65768,"_28022":65734,"_19417":111082,"_5":13306,"_25514":110999,"_2665":111083},[],"Administrador PKI",{"_3170":65769,"_28022":65734,"_19417":111085,"_5":13306,"_25514":110999,"_2665":111086},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3170":65770,"_28022":65734,"_19417":111088,"_5":13306,"_25514":110999,"_2665":111089},[],"Administrador del aprovisionamiento",{"_3170":65771,"_28022":65734,"_19417":111091,"_5":13306,"_25514":110999,"_2665":111092},[],"DMS, admisión, autenticación por operación e inventario.",{"_3170":65772,"_28022":65734,"_19417":111094,"_5":13306,"_25514":110999,"_2665":111095},[],"Integrador del dispositivo",{"_3170":65773,"_28022":65734,"_19417":111097,"_5":13306,"_25514":110999,"_2665":111098},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3170":65774,"_28022":65734,"_19417":111100,"_5":13306,"_25514":110999,"_2665":111101},[],"Integrador del consumidor",{"_3170":65775,"_28022":65734,"_19417":111103,"_5":13306,"_25514":110999,"_2665":111104},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3170":65776,"_28022":65734,"_19417":111106,"_5":13306,"_25514":110999,"_2665":111107},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3170":65777,"_28022":65777,"_5":13637,"_2665":111109,"_28344":111110,"_19417":111112,"_25514":65777},"Enrola y conecta tu primer dispositivo",[45406,108036,47807,111111],"Primeros pasos",[],{"_3170":65778,"_28022":65777,"_19417":111114,"_5":13306,"_25514":65777,"_2665":111115},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3170":65779,"_28022":65777,"_5":28341,"_19417":111117,"_25514":111118,"_2665":106689},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3170":65780,"_28022":65777,"_5":28341,"_19417":111120,"_25514":111121,"_2665":111122},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3170":65781,"_28022":65777,"_5":28341,"_19417":111124,"_25514":111125,"_2665":111126},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3170":65782,"_28022":65777,"_5":28341,"_19417":111128,"_25514":111129,"_2665":111130},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3170":65783,"_28022":65777,"_5":28341,"_19417":111132,"_25514":111133,"_2665":111134},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3170":65784,"_28022":65777,"_5":28341,"_19417":111136,"_25514":111137,"_2665":111138},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3170":65785,"_28022":65777,"_5":28341,"_19417":111140,"_25514":111141,"_2665":111142},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3170":65786,"_28022":65777,"_5":28341,"_19417":111144,"_25514":111145,"_2665":111146},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3170":65787,"_28022":65777,"_19417":111148,"_5":13306,"_25514":65777,"_2665":111149},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3170":65788,"_28022":65777,"_19417":111151,"_5":13306,"_25514":111118,"_2665":111152},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3170":65789,"_28022":65777,"_19417":111154,"_5":13306,"_25514":111118,"_2665":111155},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3170":65790,"_28022":65777,"_19417":111157,"_5":13306,"_25514":111118,"_2665":111158},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3170":65791,"_28022":65777,"_19417":111160,"_5":13306,"_25514":111118,"_2665":111161},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3170":65792,"_28022":65777,"_19417":111163,"_5":13306,"_25514":111118,"_2665":111164},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3170":65793,"_28022":65777,"_19417":111166,"_5":13306,"_25514":111121,"_2665":111167},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3170":65794,"_28022":65777,"_19417":111169,"_5":13306,"_25514":111121,"_2665":111170},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3170":65795,"_28022":65777,"_19417":111172,"_5":13306,"_25514":111125,"_2665":111173},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3170":65796,"_28022":65777,"_19417":111175,"_5":13306,"_25514":111125,"_2665":111176},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3170":65797,"_28022":65777,"_19417":111178,"_5":13306,"_25514":111125,"_2665":111179},[],"Ajuste",{"_3170":65798,"_28022":65777,"_19417":111181,"_5":13306,"_25514":111125,"_2665":111182},[],"Valor de evaluación",{"_3170":65799,"_28022":65777,"_19417":111184,"_5":13306,"_25514":111125,"_2665":50041},[],{"_3170":65800,"_28022":65777,"_19417":111186,"_5":13306,"_25514":111125,"_2665":111187},[],"Raíz emisora de `device-root.pem`.",{"_3170":65801,"_28022":65777,"_19417":111189,"_5":13306,"_25514":111125,"_2665":109345},[],{"_3170":65802,"_28022":65777,"_19417":111191,"_5":13306,"_25514":111125,"_2665":111192},[],"Perfil final de 1 hora que acabas de preparar.",{"_3170":65803,"_28022":65777,"_19417":111194,"_5":13306,"_25514":111125,"_2665":50052},[],{"_3170":65804,"_28022":65777,"_19417":111196,"_5":13306,"_25514":111125,"_2665":50055},[],{"_3170":65805,"_28022":65777,"_19417":111198,"_5":13306,"_25514":111125,"_2665":50058},[],{"_3170":65806,"_28022":65777,"_19417":111200,"_5":13306,"_25514":111125,"_2665":111201},[],"Habilitado.",{"_3170":65807,"_28022":65777,"_19417":111203,"_5":13306,"_25514":111125,"_2665":50064},[],{"_3170":65808,"_28022":65777,"_19417":111205,"_5":13306,"_25514":111125,"_2665":111206},[],"Deshabilitado; el ID debe ser nuevo.",{"_3170":65809,"_28022":65777,"_19417":111208,"_5":13306,"_25514":111125,"_2665":111209},[],"Autenticación inicial",{"_3170":65810,"_28022":65777,"_19417":111211,"_5":13306,"_25514":111125,"_2665":111212},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3170":65811,"_28022":65777,"_19417":111214,"_5":13306,"_25514":111125,"_2665":111215},[],"Autenticación de renovación",{"_3170":65812,"_28022":65777,"_19417":111217,"_5":13306,"_25514":111125,"_2665":111218},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3170":65813,"_28022":65777,"_19417":111220,"_5":13306,"_25514":111125,"_2665":50082},[],{"_3170":65814,"_28022":65777,"_19417":111222,"_5":13306,"_25514":111125,"_2665":111223},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3170":65815,"_28022":65777,"_19417":111225,"_5":13306,"_25514":111125,"_2665":50088},[],{"_3170":65816,"_28022":65777,"_19417":111227,"_5":13306,"_25514":111125,"_2665":111228},[],"1 hora.",{"_3170":65817,"_28022":65777,"_19417":111230,"_5":13306,"_25514":111125,"_2665":50094},[],{"_3170":65818,"_28022":65777,"_19417":111232,"_5":13306,"_25514":111125,"_2665":111233},[],"30 minutos / 10 minutos.",{"_3170":65819,"_28022":65777,"_19417":111235,"_5":13306,"_25514":111125,"_2665":50100},[],{"_3170":65820,"_28022":65777,"_19417":111237,"_5":13306,"_25514":111125,"_2665":111238},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3170":65821,"_28022":65777,"_19417":111240,"_5":13306,"_25514":111125,"_2665":48126},[],{"_3170":65822,"_28022":65777,"_19417":111242,"_5":13306,"_25514":111125,"_2665":111243},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3170":65823,"_28022":65777,"_19417":111245,"_5":13306,"_25514":111125,"_2665":50111},[],{"_3170":65824,"_28022":65777,"_19417":111247,"_5":13306,"_25514":111125,"_2665":111248},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3170":65825,"_28022":65777,"_19417":111250,"_5":13306,"_25514":111125,"_2665":111251},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3170":65826,"_28022":65777,"_19417":111253,"_5":13306,"_25514":111129,"_2665":111254},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3170":65827,"_28022":65777,"_19417":111256,"_5":13306,"_25514":111129,"_2665":111257},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3170":65828,"_28022":65777,"_19417":111259,"_5":13306,"_25514":111133,"_2665":111260},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3170":65829,"_28022":65777,"_19417":111262,"_5":13306,"_25514":111133,"_2665":111263},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3170":65830,"_28022":65777,"_19417":111265,"_5":13306,"_25514":111133,"_2665":111266},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3170":65831,"_28022":65777,"_19417":111268,"_5":13306,"_25514":111137,"_2665":111269},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3170":65832,"_28022":65777,"_19417":111271,"_5":13306,"_25514":111137,"_2665":111272},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3170":65833,"_28022":65777,"_19417":111274,"_5":13306,"_25514":111141,"_2665":111275},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3170":65834,"_28022":65777,"_19417":111277,"_5":13306,"_25514":111141,"_2665":111278},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3170":65835,"_28022":65777,"_19417":111280,"_5":13306,"_25514":111141,"_2665":111281},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3170":65836,"_28022":65777,"_19417":111283,"_5":13306,"_25514":111141,"_2665":111284},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3170":65837,"_28022":65777,"_19417":111286,"_5":13306,"_25514":111141,"_2665":111287},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3170":65838,"_28022":65777,"_19417":111289,"_5":13306,"_25514":111145,"_2665":111290},[],"Comprobación",{"_3170":65839,"_28022":65777,"_19417":111292,"_5":13306,"_25514":111145,"_2665":111293},[],"Resultado esperado",{"_3170":65840,"_28022":65777,"_19417":111295,"_5":13306,"_25514":111145,"_2665":111296},[],"Registro",{"_3170":65841,"_28022":65777,"_19417":111298,"_5":13306,"_25514":111145,"_2665":111299},[],"ID creado automáticamente y DMS correcto.",{"_3170":65842,"_28022":65777,"_19417":111301,"_5":13306,"_25514":111145,"_2665":111302},[],"Certificado",{"_3170":65843,"_28022":65777,"_19417":111304,"_5":13306,"_25514":111145,"_2665":111305},[],"CN, perfil, serie y clave verificados.",{"_3170":65844,"_28022":65777,"_19417":111307,"_5":13306,"_25514":111145,"_2665":111308},[],"Inventario",{"_3170":65845,"_28022":65777,"_19417":111310,"_5":13306,"_25514":111145,"_2665":111311},[],"Serie recibida visible como identidad actual y en el historial.",{"_3170":65846,"_28022":65777,"_19417":111313,"_5":13306,"_25514":111145,"_2665":111314},[],"Consumidor",{"_3170":65847,"_28022":65777,"_19417":111316,"_5":13306,"_25514":111145,"_2665":111317},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3170":65848,"_28022":65777,"_19417":111319,"_5":13306,"_25514":111145,"_2665":111320},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3170":65849,"_28022":65777,"_19417":111322,"_5":13306,"_25514":111145,"_2665":111323},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3170":65850,"_28022":65850,"_5":13637,"_2665":109059,"_28344":111325,"_19417":111326,"_25514":65850},[45406,108036,47807,111111],[],{"_3170":65851,"_28022":65850,"_19417":111328,"_5":13306,"_25514":65850,"_2665":111329},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3170":65852,"_28022":65850,"_5":28341,"_19417":111331,"_25514":111332,"_2665":106689},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3170":65853,"_28022":65850,"_5":28341,"_19417":111334,"_25514":111335,"_2665":111336},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3170":65854,"_28022":65850,"_5":28341,"_19417":111338,"_25514":111339,"_2665":111340},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3170":65855,"_28022":65850,"_5":28341,"_19417":111342,"_25514":111343,"_2665":111344},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3170":65856,"_28022":65850,"_5":28341,"_19417":111346,"_25514":111347,"_2665":111348},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3170":65857,"_28022":65850,"_5":28341,"_19417":111350,"_25514":111351,"_2665":111352},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3170":65858,"_28022":65850,"_5":28341,"_19417":111354,"_25514":111355,"_2665":111293},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3170":65859,"_28022":65850,"_5":28341,"_19417":111357,"_25514":111358,"_2665":111359},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3170":65860,"_28022":65850,"_5":28341,"_19417":111361,"_25514":111362,"_2665":111363},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3170":65861,"_28022":65850,"_19417":111365,"_5":13306,"_25514":65850,"_2665":111366},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3170":65862,"_28022":65850,"_19417":111368,"_5":13306,"_25514":65850,"_2665":111369},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3170":65863,"_28022":65850,"_19417":111371,"_5":13306,"_25514":111332,"_2665":111372},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3170":65864,"_28022":65850,"_19417":111374,"_5":13306,"_25514":111332,"_2665":111375},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3170":65865,"_28022":65850,"_19417":111377,"_5":13306,"_25514":111332,"_2665":111378},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3170":65866,"_28022":65850,"_19417":111380,"_5":13306,"_25514":111332,"_2665":111381},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3170":65867,"_28022":65850,"_19417":111383,"_5":13306,"_25514":111335,"_2665":111384},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3170":65868,"_28022":65850,"_19417":111386,"_5":13306,"_25514":111335,"_2665":111387},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3170":65869,"_28022":65850,"_19417":111389,"_5":13306,"_25514":111335,"_2665":111390},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3170":65870,"_28022":65850,"_19417":111392,"_5":13306,"_25514":111335,"_2665":111393},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3170":65871,"_28022":65850,"_19417":111395,"_5":13306,"_25514":111335,"_2665":111396},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3170":65872,"_28022":65850,"_19417":111398,"_5":13306,"_25514":111335,"_2665":111399},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3170":65873,"_28022":65850,"_19417":111401,"_5":13306,"_25514":111335,"_2665":111402},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3170":65874,"_28022":65850,"_19417":111404,"_5":13306,"_25514":111335,"_2665":111405},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3170":65875,"_28022":65850,"_19417":111407,"_5":13306,"_25514":111339,"_2665":111408},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3170":65876,"_28022":65850,"_19417":111410,"_5":13306,"_25514":111339,"_2665":50277},[],{"_3170":65877,"_28022":65850,"_19417":111412,"_5":13306,"_25514":111339,"_2665":111413},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3170":65878,"_28022":65850,"_19417":111415,"_5":13306,"_25514":111339,"_2665":111416},[],"**Icon** y **Tags**: clasificación opcional.",{"_3170":65879,"_28022":65850,"_19417":111418,"_5":13306,"_25514":111339,"_2665":111419},[],"Confirma el registro.",{"_3170":65880,"_28022":65850,"_19417":111421,"_5":13306,"_25514":111343,"_2665":111422},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3170":65881,"_28022":65850,"_19417":111424,"_5":13306,"_25514":111343,"_2665":111425},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3170":65882,"_28022":65850,"_19417":111427,"_5":13306,"_25514":111347,"_2665":111428},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3170":65883,"_28022":65850,"_19417":111430,"_5":13306,"_25514":111347,"_2665":111431},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3170":65884,"_28022":65850,"_19417":111433,"_5":13306,"_25514":111351,"_2665":111434},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3170":65885,"_28022":65850,"_19417":111436,"_5":13306,"_25514":111351,"_2665":111437},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3170":65886,"_28022":65850,"_19417":111439,"_5":13306,"_25514":111355,"_2665":111290},[],{"_3170":65887,"_28022":65850,"_19417":111441,"_5":13306,"_25514":111355,"_2665":111442},[],"Resultado",{"_3170":65888,"_28022":65850,"_19417":111444,"_5":13306,"_25514":111355,"_2665":111445},[],"Dispositivo",{"_3170":65889,"_28022":65850,"_19417":111447,"_5":13306,"_25514":111355,"_2665":111448},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3170":65890,"_28022":65850,"_19417":111450,"_5":13306,"_25514":111355,"_2665":111451},[],"Identidad actual",{"_3170":65891,"_28022":65850,"_19417":111453,"_5":13306,"_25514":111355,"_2665":111454},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3170":65892,"_28022":65850,"_19417":111456,"_5":13306,"_25514":111355,"_2665":111457},[],"Historial",{"_3170":65893,"_28022":65850,"_19417":111459,"_5":13306,"_25514":111355,"_2665":111460},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3170":65894,"_28022":65850,"_19417":111462,"_5":13306,"_25514":111355,"_2665":111463},[],"Clave y certificado",{"_3170":65895,"_28022":65850,"_19417":111465,"_5":13306,"_25514":111355,"_2665":111466},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3170":65896,"_28022":65850,"_19417":111468,"_5":13306,"_25514":111358,"_2665":111469},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3170":65897,"_28022":65850,"_19417":111471,"_5":13306,"_25514":111358,"_2665":111472},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3170":65898,"_28022":65850,"_19417":111474,"_5":13306,"_25514":111358,"_2665":111475},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3170":65899,"_28022":65850,"_19417":111477,"_5":13306,"_25514":111358,"_2665":111478},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3170":65900,"_28022":65850,"_19417":111480,"_5":13306,"_25514":111362,"_2665":111481},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3170":65901,"_28022":65850,"_19417":111483,"_5":13306,"_25514":111362,"_2665":111484},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3170":65902,"_28022":65850,"_19417":111486,"_5":13306,"_25514":111362,"_2665":111487},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3170":65903,"_28022":65903,"_5":13637,"_2665":111489,"_28344":111490,"_19417":111491,"_25514":65903},"Plataforma Lamassu IoT",[45406,108036],[],{"_3170":65904,"_28022":65903,"_19417":111493,"_5":13306,"_25514":65903,"_2665":111494},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3170":65905,"_28022":65903,"_5":28341,"_19417":111496,"_25514":111497,"_2665":110987},[],"/docs/es/platform/overview#empieza-aquí",{"_3170":65906,"_28022":65903,"_5":28341,"_19417":111499,"_25514":111500,"_2665":111501},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3170":65907,"_28022":65903,"_5":28341,"_19417":111503,"_25514":111504,"_2665":111505},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3170":65908,"_28022":65903,"_5":28341,"_19417":111507,"_25514":111508,"_2665":111509},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3170":65909,"_28022":65903,"_5":28341,"_19417":111511,"_25514":111512,"_2665":111513},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3170":65910,"_28022":65903,"_5":28341,"_19417":111515,"_25514":111516,"_2665":111517},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3170":65911,"_28022":65903,"_5":28341,"_19417":111519,"_25514":111520,"_2665":111521},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3170":65912,"_28022":65903,"_5":28341,"_19417":111523,"_25514":111524,"_2665":111525},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3170":65913,"_28022":65903,"_5":28341,"_19417":111527,"_25514":111528,"_2665":111529},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3170":65914,"_28022":65903,"_5":28341,"_19417":111531,"_25514":111532,"_2665":111533},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3170":65915,"_28022":65903,"_5":28341,"_19417":111535,"_25514":111536,"_2665":111537},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3170":65916,"_28022":65903,"_19417":111539,"_5":13306,"_25514":65903,"_2665":111540},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3170":65917,"_28022":65903,"_19417":111542,"_5":13306,"_25514":111497,"_2665":111543},[],"Elige el resultado que necesitas obtener:",{"_3170":65918,"_28022":65903,"_19417":111545,"_5":13306,"_25514":111497,"_2665":111546},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":65919,"_28022":65903,"_19417":111548,"_5":13306,"_25514":111497,"_2665":111549},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3170":65920,"_28022":65903,"_19417":111551,"_5":13306,"_25514":111497,"_2665":111552},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3170":65921,"_28022":65903,"_19417":111554,"_5":13306,"_25514":111500,"_2665":111555},[],"Bloque",{"_3170":65922,"_28022":65903,"_19417":111557,"_5":13306,"_25514":111500,"_2665":111558},[],"Qué gestionas",{"_3170":65923,"_28022":65903,"_19417":111560,"_5":13306,"_25514":111500,"_2665":111561},[],"Punto de entrada",{"_3170":65924,"_28022":65903,"_19417":111563,"_5":13306,"_25514":111500,"_2665":50431},[],{"_3170":65925,"_28022":65903,"_19417":111565,"_5":13306,"_25514":111500,"_2665":111566},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3170":65926,"_28022":65903,"_19417":111568,"_5":13306,"_25514":111500,"_2665":111569},[],"Visión general de PKI",{"_3170":65927,"_28022":65903,"_19417":111571,"_5":13306,"_25514":111500,"_2665":50440},[],{"_3170":65928,"_28022":65903,"_19417":111573,"_5":13306,"_25514":111500,"_2665":111574},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3170":65929,"_28022":65903,"_19417":111576,"_5":13306,"_25514":111500,"_2665":111577},[],"Visión general de IoT Fleets",{"_3170":65930,"_28022":65903,"_19417":111579,"_5":13306,"_25514":111500,"_2665":111580},[],"**Administración**",{"_3170":65931,"_28022":65903,"_19417":111582,"_5":13306,"_25514":111500,"_2665":111583},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3170":65932,"_28022":65903,"_19417":111585,"_5":13306,"_25514":111500,"_2665":108034},[],{"_3170":65933,"_28022":65903,"_19417":111587,"_5":13306,"_25514":111500,"_2665":111588},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3170":65934,"_28022":65903,"_19417":111590,"_5":13306,"_25514":111504,"_2665":111591},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3170":65935,"_28022":65903,"_19417":111593,"_5":13306,"_25514":111504,"_2665":111594},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3170":65936,"_28022":65903,"_19417":111596,"_5":13306,"_25514":111504,"_2665":111597},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3170":65937,"_28022":65903,"_19417":111599,"_5":13306,"_25514":111504,"_2665":111600},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3170":65938,"_28022":65903,"_19417":111602,"_5":13306,"_25514":111504,"_2665":111603},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3170":65939,"_28022":65903,"_19417":111605,"_5":13306,"_25514":111504,"_2665":111606},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3170":65940,"_28022":65903,"_19417":111608,"_5":13306,"_25514":111512,"_2665":111609},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3170":65941,"_28022":65903,"_19417":111611,"_5":13306,"_25514":111516,"_2665":111612},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3170":65942,"_28022":65903,"_19417":111614,"_5":13306,"_25514":111520,"_2665":111615},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3170":65943,"_28022":65903,"_19417":111617,"_5":13306,"_25514":111524,"_2665":111618},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3170":65944,"_28022":65903,"_19417":111620,"_5":13306,"_25514":111528,"_2665":111621},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3170":65945,"_28022":65903,"_19417":111623,"_5":13306,"_25514":111532,"_2665":111624},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3170":65946,"_28022":65903,"_19417":111626,"_5":13306,"_25514":111536,"_2665":111080},[],{"_3170":65947,"_28022":65903,"_19417":111628,"_5":13306,"_25514":111536,"_2665":111629},[],"Qué prepara o comprueba",{"_3170":65948,"_28022":65903,"_19417":111631,"_5":13306,"_25514":111536,"_2665":111083},[],{"_3170":65949,"_28022":65903,"_19417":111633,"_5":13306,"_25514":111536,"_2665":111634},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3170":65950,"_28022":65903,"_19417":111636,"_5":13306,"_25514":111536,"_2665":111637},[],"Administrador de la flota",{"_3170":65951,"_28022":65903,"_19417":111639,"_5":13306,"_25514":111536,"_2665":111640},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3170":65952,"_28022":65903,"_19417":111642,"_5":13306,"_25514":111536,"_2665":111095},[],{"_3170":65953,"_28022":65903,"_19417":111644,"_5":13306,"_25514":111536,"_2665":111645},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3170":65954,"_28022":65903,"_19417":111647,"_5":13306,"_25514":111536,"_2665":111101},[],{"_3170":65955,"_28022":65903,"_19417":111649,"_5":13306,"_25514":111536,"_2665":111650},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3170":65956,"_28022":65903,"_19417":111652,"_5":13306,"_25514":111536,"_2665":111653},[],"Operador de infraestructura",{"_3170":65957,"_28022":65903,"_19417":111655,"_5":13306,"_25514":111536,"_2665":111656},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3170":65958,"_28022":65903,"_19417":111658,"_5":13306,"_25514":111536,"_2665":111659},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3170":65959,"_28022":65959,"_5":13637,"_2665":111661,"_28344":111662,"_19417":111664,"_25514":65959},"Jerarquía y rotación de CAs",[45406,108036,50532,111663],"Claves, autoridades y certificados",[],{"_3170":65960,"_28022":65959,"_19417":111666,"_5":13306,"_25514":65959,"_2665":111667},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3170":65961,"_28022":65959,"_5":28341,"_19417":111669,"_25514":111670,"_2665":111671},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3170":65962,"_28022":65959,"_5":28341,"_19417":111673,"_25514":111674,"_2665":111675},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3170":65963,"_28022":65959,"_5":28341,"_19417":111677,"_25514":111678,"_2665":111679},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3170":65964,"_28022":65959,"_5":28341,"_19417":111681,"_25514":111682,"_2665":111683},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3170":65965,"_28022":65959,"_5":28341,"_19417":111685,"_25514":111686,"_2665":111687},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3170":65966,"_28022":65959,"_5":28341,"_19417":111689,"_25514":111690,"_2665":111691},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3170":65967,"_28022":65959,"_5":28341,"_19417":111693,"_25514":111694,"_2665":111695},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3170":65968,"_28022":65959,"_5":28341,"_19417":111697,"_25514":111698,"_2665":111699},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3170":65969,"_28022":65959,"_5":28341,"_19417":111701,"_25514":111702,"_2665":111703},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3170":65970,"_28022":65959,"_5":28341,"_19417":111705,"_25514":111706,"_2665":111707},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3170":65971,"_28022":65959,"_5":28341,"_19417":111709,"_25514":111710,"_2665":111711},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3170":65972,"_28022":65959,"_5":28341,"_19417":111713,"_25514":111714,"_2665":111715},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3170":65973,"_28022":65959,"_19417":111717,"_5":13306,"_25514":65959,"_2665":111718},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3170":65974,"_28022":65959,"_19417":111720,"_5":13306,"_25514":65959,"_2665":111721},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3170":65975,"_28022":65959,"_19417":111723,"_5":13306,"_25514":111670,"_2665":111724},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3170":65976,"_28022":65959,"_19417":111726,"_5":13306,"_25514":111670,"_2665":111727},[],"entorno, como producción y preproducción;",{"_3170":65977,"_28022":65959,"_19417":111729,"_5":13306,"_25514":111670,"_2665":111730},[],"propietario o equipo operador;",{"_3170":65978,"_28022":65959,"_19417":111732,"_5":13306,"_25514":111670,"_2665":111733},[],"familia de dispositivos o proceso de fabricación;",{"_3170":65979,"_28022":65959,"_19417":111735,"_5":13306,"_25514":111670,"_2665":111736},[],"región o requisito regulatorio;",{"_3170":65980,"_28022":65959,"_19417":111738,"_5":13306,"_25514":111670,"_2665":111739},[],"motor criptográfico o política de clave;",{"_3170":65981,"_28022":65959,"_19417":111741,"_5":13306,"_25514":111670,"_2665":111742},[],"ventana de mantenimiento y ritmo de renovación.",{"_3170":65982,"_28022":65959,"_19417":111744,"_5":13306,"_25514":111670,"_2665":111745},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3170":65983,"_28022":65959,"_19417":111747,"_5":13306,"_25514":111670,"_2665":111748},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3170":65984,"_28022":65959,"_19417":111750,"_5":13306,"_25514":111674,"_2665":111751},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3170":65985,"_28022":65959,"_19417":111753,"_5":13306,"_25514":111674,"_2665":111754},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3170":65986,"_28022":65959,"_19417":111756,"_5":13306,"_25514":111674,"_2665":111757},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3170":65987,"_28022":65959,"_19417":111759,"_5":13306,"_25514":111678,"_2665":111760},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3170":65988,"_28022":65959,"_19417":111762,"_5":13306,"_25514":111678,"_2665":111763},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3170":65989,"_28022":65959,"_19417":111765,"_5":13306,"_25514":111678,"_2665":111766},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3170":65990,"_28022":65959,"_19417":111768,"_5":13306,"_25514":111678,"_2665":111769},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3170":65991,"_28022":65959,"_19417":111771,"_5":13306,"_25514":111686,"_2665":111772},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3170":65992,"_28022":65959,"_19417":111774,"_5":13306,"_25514":111690,"_2665":111775},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3170":65993,"_28022":65959,"_19417":111777,"_5":13306,"_25514":111694,"_2665":111778},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3170":65994,"_28022":65959,"_19417":111780,"_5":13306,"_25514":111698,"_2665":111781},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3170":65995,"_28022":65959,"_19417":111783,"_5":13306,"_25514":111702,"_2665":111784},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3170":65996,"_28022":65959,"_19417":111786,"_5":13306,"_25514":111706,"_2665":111787},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3170":65997,"_28022":65959,"_19417":111789,"_5":13306,"_25514":111710,"_2665":111790},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3170":65998,"_28022":65959,"_19417":111792,"_5":13306,"_25514":111710,"_2665":111793},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3170":65999,"_28022":65959,"_19417":111795,"_5":13306,"_25514":111710,"_2665":111796},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3170":66000,"_28022":65959,"_19417":111798,"_5":13306,"_25514":111710,"_2665":111799},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3170":66001,"_28022":65959,"_19417":111801,"_5":13306,"_25514":111714,"_2665":111802},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3170":66002,"_28022":65959,"_19417":111804,"_5":13306,"_25514":111714,"_2665":111805},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3170":66003,"_28022":65959,"_19417":111807,"_5":13306,"_25514":111714,"_2665":111808},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3170":66004,"_28022":65959,"_19417":111810,"_5":13306,"_25514":111714,"_2665":111811},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3170":66005,"_28022":65959,"_19417":111813,"_5":13306,"_25514":111714,"_2665":111814},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3170":66006,"_28022":65959,"_19417":111816,"_5":13306,"_25514":111714,"_2665":111817},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3170":66007,"_28022":65959,"_19417":111819,"_5":13306,"_25514":111714,"_2665":111820},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3170":66008,"_28022":66008,"_5":13637,"_2665":111822,"_28344":111823,"_19417":111824,"_25514":66008},"Autoridades de certificación",[45406,108036,50532,111663],[],{"_3170":66009,"_28022":66008,"_19417":111826,"_5":13306,"_25514":66008,"_2665":111827},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3170":66010,"_28022":66008,"_5":28341,"_19417":111829,"_25514":111830,"_2665":111831},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3170":66011,"_28022":66008,"_5":28341,"_19417":111833,"_25514":111834,"_2665":111835},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3170":66012,"_28022":66008,"_5":28341,"_19417":111837,"_25514":111838,"_2665":106689},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3170":66013,"_28022":66008,"_5":28341,"_19417":111840,"_25514":111841,"_2665":111842},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3170":66014,"_28022":66008,"_5":28341,"_19417":111844,"_25514":111845,"_2665":111846},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3170":66015,"_28022":66008,"_5":28341,"_19417":111848,"_25514":111849,"_2665":111850},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3170":66016,"_28022":66008,"_5":28341,"_19417":111852,"_25514":111853,"_2665":111854},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3170":66017,"_28022":66008,"_5":28341,"_19417":111856,"_25514":111857,"_2665":111858},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3170":66018,"_28022":66008,"_5":28341,"_19417":111860,"_25514":111861,"_2665":111862},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3170":66019,"_28022":66008,"_5":28341,"_19417":111864,"_25514":111865,"_2665":111866},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3170":66020,"_28022":66008,"_5":28341,"_19417":111868,"_25514":111869,"_2665":111870},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3170":66021,"_28022":66008,"_5":28341,"_19417":111872,"_25514":111873,"_2665":111874},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3170":66022,"_28022":66008,"_5":28341,"_19417":111876,"_25514":111877,"_2665":111878},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3170":66023,"_28022":66008,"_5":28341,"_19417":111880,"_25514":111881,"_2665":111882},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3170":66024,"_28022":66008,"_5":28341,"_19417":111884,"_25514":111885,"_2665":111886},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3170":66025,"_28022":66008,"_5":28341,"_19417":111888,"_25514":111889,"_2665":111890},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3170":66026,"_28022":66008,"_5":28341,"_19417":111892,"_25514":111893,"_2665":111894},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3170":66027,"_28022":66008,"_5":28341,"_19417":111896,"_25514":111897,"_2665":111898},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3170":66028,"_28022":66008,"_5":28341,"_19417":111900,"_25514":111901,"_2665":111902},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3170":66029,"_28022":66008,"_5":28341,"_19417":111904,"_25514":111905,"_2665":111906},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3170":66030,"_28022":66008,"_5":28341,"_19417":111908,"_25514":111909,"_2665":111910},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3170":66031,"_28022":66008,"_5":28341,"_19417":111912,"_25514":111913,"_2665":111914},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3170":66032,"_28022":66008,"_19417":111916,"_5":13306,"_25514":66008,"_2665":111917},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3170":66033,"_28022":66008,"_19417":111919,"_5":13306,"_25514":66008,"_2665":111920},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3170":66034,"_28022":66008,"_19417":111922,"_5":13306,"_25514":66008,"_2665":111923},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3170":66035,"_28022":66008,"_19417":111925,"_5":13306,"_25514":111830,"_2665":111926},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3170":66036,"_28022":66008,"_19417":111928,"_5":13306,"_25514":111830,"_2665":111929},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3170":66037,"_28022":66008,"_19417":111931,"_5":13306,"_25514":111830,"_2665":111932},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3170":66038,"_28022":66008,"_19417":111934,"_5":13306,"_25514":111830,"_2665":111935},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3170":66039,"_28022":66008,"_19417":111937,"_5":13306,"_25514":111830,"_2665":111938},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3170":66040,"_28022":66008,"_19417":111940,"_5":13306,"_25514":111838,"_2665":111941},[],"Decide si la CA será raíz o intermedia.",{"_3170":66041,"_28022":66008,"_19417":111943,"_5":13306,"_25514":111838,"_2665":111944},[],"Elige el motor que custodiará la clave.",{"_3170":66042,"_28022":66008,"_19417":111946,"_5":13306,"_25514":111838,"_2665":111947},[],"Define una validez superior a la de los certificados que emitirá.",{"_3170":66043,"_28022":66008,"_19417":111949,"_5":13306,"_25514":111838,"_2665":111950},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3170":66044,"_28022":66008,"_19417":111952,"_5":13306,"_25514":111841,"_2665":111953},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3170":66045,"_28022":66008,"_19417":111955,"_5":13306,"_25514":111845,"_2665":111956},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3170":66046,"_28022":66008,"_19417":111958,"_5":13306,"_25514":111845,"_2665":111959},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3170":66047,"_28022":66008,"_19417":111961,"_5":13306,"_25514":111849,"_2665":111962},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3170":66048,"_28022":66008,"_19417":111964,"_5":13306,"_25514":111853,"_2665":111965},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3170":66049,"_28022":66008,"_19417":111967,"_5":13306,"_25514":111853,"_2665":111968},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3170":66050,"_28022":66008,"_19417":111970,"_5":13306,"_25514":111853,"_2665":111971},[],"`ST`: estado o provincia.",{"_3170":66051,"_28022":66008,"_19417":111973,"_5":13306,"_25514":111853,"_2665":111974},[],"`L`: localidad.",{"_3170":66052,"_28022":66008,"_19417":111976,"_5":13306,"_25514":111853,"_2665":111977},[],"`O`: organización.",{"_3170":66053,"_28022":66008,"_19417":111979,"_5":13306,"_25514":111853,"_2665":111980},[],"`OU`: unidad organizativa.",{"_3170":66054,"_28022":66008,"_19417":111982,"_5":13306,"_25514":111853,"_2665":111983},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3170":66055,"_28022":66008,"_19417":111985,"_5":13306,"_25514":111857,"_2665":111986},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3170":66056,"_28022":66008,"_19417":111988,"_5":13306,"_25514":111857,"_2665":111989},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3170":66057,"_28022":66008,"_19417":111991,"_5":13306,"_25514":111861,"_2665":111992},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3170":66058,"_28022":66008,"_19417":111994,"_5":13306,"_25514":111861,"_2665":111995},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3170":66059,"_28022":66008,"_19417":111997,"_5":13306,"_25514":111865,"_2665":111998},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3170":66060,"_28022":66008,"_19417":112000,"_5":13306,"_25514":111865,"_2665":112001},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3170":66061,"_28022":66008,"_19417":112003,"_5":13306,"_25514":111869,"_2665":112004},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3170":66062,"_28022":66008,"_19417":112006,"_5":13306,"_25514":111873,"_2665":112007},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3170":66063,"_28022":66008,"_19417":112009,"_5":13306,"_25514":111877,"_2665":112010},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3170":66064,"_28022":66008,"_19417":112012,"_5":13306,"_25514":111881,"_2665":112013},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3170":66065,"_28022":66008,"_19417":112015,"_5":13306,"_25514":111885,"_2665":112016},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3170":66066,"_28022":66008,"_19417":112018,"_5":13306,"_25514":111885,"_2665":112019},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3170":66067,"_28022":66008,"_19417":112021,"_5":13306,"_25514":111889,"_2665":112022},[],"Abre una CA desde el inventario para consultar:",{"_3170":66068,"_28022":66008,"_19417":112024,"_5":13306,"_25514":111889,"_2665":112025},[],"Estado y periodo de validez.",{"_3170":66069,"_28022":66008,"_19417":112027,"_5":13306,"_25514":111889,"_2665":112028},[],"Certificado y cadena en formato PEM.",{"_3170":66070,"_28022":66008,"_19417":112030,"_5":13306,"_25514":111889,"_2665":112031},[],"Número de certificados activos, expirados y revocados.",{"_3170":66071,"_28022":66008,"_19417":112033,"_5":13306,"_25514":111889,"_2665":112034},[],"Certificados emitidos en **Issued Certificates**.",{"_3170":66072,"_28022":66008,"_19417":112036,"_5":13306,"_25514":111889,"_2665":112037},[],"CRL vinculada a la autoridad.",{"_3170":66073,"_28022":66008,"_19417":112039,"_5":13306,"_25514":111889,"_2665":112040},[],"Metadatos y motor criptográfico asociado.",{"_3170":66074,"_28022":66008,"_19417":112042,"_5":13306,"_25514":111889,"_2665":112043},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3170":66075,"_28022":66008,"_19417":112045,"_5":13306,"_25514":111893,"_2665":112046},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3170":66076,"_28022":66008,"_19417":112048,"_5":13306,"_25514":111893,"_2665":112049},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3170":66077,"_28022":66008,"_19417":112051,"_5":13306,"_25514":111893,"_2665":112052},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3170":66078,"_28022":66008,"_19417":112054,"_5":13306,"_25514":111893,"_2665":112055},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3170":66079,"_28022":66008,"_19417":112057,"_5":13306,"_25514":111897,"_2665":112058},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3170":66080,"_28022":66008,"_19417":112060,"_5":13306,"_25514":111901,"_2665":112061},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3170":66081,"_28022":66008,"_19417":112063,"_5":13306,"_25514":111905,"_2665":112064},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3170":66082,"_28022":66008,"_19417":112066,"_5":13306,"_25514":111909,"_2665":112067},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3170":66083,"_28022":66008,"_19417":112069,"_5":13306,"_25514":111913,"_2665":112070},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3170":66084,"_28022":66008,"_19417":112072,"_5":13306,"_25514":111913,"_2665":112073},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3170":66085,"_28022":66085,"_5":13637,"_2665":112075,"_28344":112076,"_19417":112077,"_25514":66085},"Perfiles de certificado",[45406,108036,50532,111663],[],{"_3170":66086,"_28022":66085,"_19417":112079,"_5":13306,"_25514":66085,"_2665":112080},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3170":66087,"_28022":66085,"_5":28341,"_19417":112082,"_25514":112083,"_2665":112084},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3170":66088,"_28022":66085,"_5":28341,"_19417":112086,"_25514":112087,"_2665":112088},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3170":66089,"_28022":66085,"_5":28341,"_19417":112090,"_25514":112091,"_2665":112092},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3170":66090,"_28022":66085,"_5":28341,"_19417":112094,"_25514":112095,"_2665":112096},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3170":66091,"_28022":66085,"_5":28341,"_19417":112098,"_25514":112099,"_2665":112100},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3170":66092,"_28022":66085,"_5":28341,"_19417":112102,"_25514":112103,"_2665":112104},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3170":66093,"_28022":66085,"_5":28341,"_19417":112106,"_25514":112107,"_2665":112108},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3170":66094,"_28022":66085,"_5":28341,"_19417":112110,"_25514":112111,"_2665":112112},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3170":66095,"_28022":66085,"_5":28341,"_19417":112114,"_25514":112115,"_2665":112116},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3170":66096,"_28022":66085,"_5":28341,"_19417":112118,"_25514":112119,"_2665":112120},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3170":66097,"_28022":66085,"_5":28341,"_19417":112122,"_25514":112123,"_2665":112124},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3170":66098,"_28022":66085,"_5":28341,"_19417":112126,"_25514":112127,"_2665":112128},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3170":66099,"_28022":66085,"_5":28341,"_19417":112130,"_25514":112131,"_2665":112132},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3170":66100,"_28022":66085,"_5":28341,"_19417":112134,"_25514":112135,"_2665":112136},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3170":66101,"_28022":66085,"_5":28341,"_19417":112138,"_25514":112139,"_2665":112140},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3170":66102,"_28022":66085,"_5":28341,"_19417":112142,"_25514":112143,"_2665":112144},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3170":66103,"_28022":66085,"_19417":112146,"_5":13306,"_25514":66085,"_2665":112147},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3170":66104,"_28022":66085,"_19417":112149,"_5":13306,"_25514":66085,"_2665":112150},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3170":66105,"_28022":66085,"_19417":112152,"_5":13306,"_25514":112087,"_2665":112153},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3170":66106,"_28022":66085,"_19417":112155,"_5":13306,"_25514":112087,"_2665":112156},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3170":66107,"_28022":66085,"_19417":112158,"_5":13306,"_25514":112091,"_2665":112159},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3170":66108,"_28022":66085,"_19417":112161,"_5":13306,"_25514":112095,"_2665":112162},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3170":66109,"_28022":66085,"_19417":112164,"_5":13306,"_25514":112095,"_2665":112165},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3170":66110,"_28022":66085,"_19417":112167,"_5":13306,"_25514":112095,"_2665":112168},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3170":66111,"_28022":66085,"_19417":112170,"_5":13306,"_25514":112099,"_2665":112171},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3170":66112,"_28022":66085,"_19417":112173,"_5":13306,"_25514":112103,"_2665":112174},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3170":66113,"_28022":66085,"_19417":112176,"_5":13306,"_25514":112103,"_2665":112177},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3170":66114,"_28022":66085,"_19417":112179,"_5":13306,"_25514":112107,"_2665":112180},[],"La aplicación criptográfica puede:",{"_3170":66115,"_28022":66085,"_19417":112182,"_5":13306,"_25514":112107,"_2665":112183},[],"permitir o bloquear claves RSA;",{"_3170":66116,"_28022":66085,"_19417":112185,"_5":13306,"_25514":112107,"_2665":112186},[],"limitar los tamaños RSA admitidos;",{"_3170":66117,"_28022":66085,"_19417":112188,"_5":13306,"_25514":112107,"_2665":112189},[],"permitir o bloquear claves ECDSA;",{"_3170":66118,"_28022":66085,"_19417":112191,"_5":13306,"_25514":112107,"_2665":112192},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3170":66119,"_28022":66085,"_19417":112194,"_5":13306,"_25514":112107,"_2665":112195},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3170":66120,"_28022":66085,"_19417":112197,"_5":13306,"_25514":112111,"_2665":112198},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3170":66121,"_28022":66085,"_19417":112200,"_5":13306,"_25514":112111,"_2665":107824},[],{"_3170":66122,"_28022":66085,"_19417":112202,"_5":13306,"_25514":112111,"_2665":112203},[],"Primera opción",{"_3170":66123,"_28022":66085,"_19417":112205,"_5":13306,"_25514":112111,"_2665":112206},[],"Segunda opción",{"_3170":66124,"_28022":66085,"_19417":112208,"_5":13306,"_25514":112111,"_2665":112209},[],"Si no hay ninguna",{"_3170":66125,"_28022":66085,"_19417":112211,"_5":13306,"_25514":112111,"_2665":112212},[],"Firma directa con una CA",{"_3170":66126,"_28022":66085,"_19417":112214,"_5":13306,"_25514":112111,"_2665":112215},[],"`issuance_profile` incluido en la solicitud",{"_3170":66127,"_28022":66085,"_19417":112217,"_5":13306,"_25514":112111,"_2665":112218},[],"`issuance_profile_id` de la solicitud",{"_3170":66128,"_28022":66085,"_19417":112220,"_5":13306,"_25514":112111,"_2665":112221},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3170":66129,"_28022":66085,"_19417":112223,"_5":13306,"_25514":112111,"_2665":112224},[],"Emisión mediante DMS",{"_3170":66130,"_28022":66085,"_19417":112226,"_5":13306,"_25514":112111,"_2665":51097},[],{"_3170":66131,"_28022":66085,"_19417":112228,"_5":13306,"_25514":112111,"_2665":112229},[],"`settings.issuance_profile` incluido en el DMS",{"_3170":66132,"_28022":66085,"_19417":112231,"_5":13306,"_25514":112111,"_2665":112232},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3170":66133,"_28022":66085,"_19417":112234,"_5":13306,"_25514":112111,"_2665":112235},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3170":66134,"_28022":66085,"_19417":112237,"_5":13306,"_25514":112111,"_2665":112238},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3170":66135,"_28022":66085,"_19417":112240,"_5":13306,"_25514":112119,"_2665":112241},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3170":66136,"_28022":66085,"_19417":112243,"_5":13306,"_25514":112123,"_2665":112244},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3170":66137,"_28022":66085,"_19417":112246,"_5":13306,"_25514":112127,"_2665":112247},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3170":66138,"_28022":66085,"_19417":112249,"_5":13306,"_25514":112131,"_2665":112250},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3170":66139,"_28022":66085,"_19417":112252,"_5":13306,"_25514":112135,"_2665":112253},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3170":66140,"_28022":66085,"_19417":112255,"_5":13306,"_25514":112135,"_2665":112256},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3170":66141,"_28022":66085,"_19417":112258,"_5":13306,"_25514":112139,"_2665":112259},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3170":66142,"_28022":66085,"_19417":112261,"_5":13306,"_25514":112139,"_2665":112262},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3170":66143,"_28022":66085,"_19417":112264,"_5":13306,"_25514":112139,"_2665":112265},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3170":66144,"_28022":66085,"_19417":112267,"_5":13306,"_25514":112139,"_2665":112268},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3170":66145,"_28022":66085,"_19417":112270,"_5":13306,"_25514":112143,"_2665":112271},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3170":66146,"_28022":66085,"_19417":112273,"_5":13306,"_25514":112143,"_2665":112274},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3170":66147,"_28022":66147,"_5":13637,"_2665":112276,"_28344":112277,"_19417":112279,"_25514":66147},"Validación de certificados",[45406,108036,50532,112278],"Validación",[],{"_3170":66148,"_28022":66147,"_19417":112281,"_5":13306,"_25514":66147,"_2665":112282},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3170":66149,"_28022":66147,"_5":28341,"_19417":112284,"_25514":112285,"_2665":112286},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3170":66150,"_28022":66147,"_5":28341,"_19417":112288,"_25514":112289,"_2665":112290},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3170":66151,"_28022":66147,"_5":28341,"_19417":112292,"_25514":112293,"_2665":112294},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3170":66152,"_28022":66147,"_19417":112296,"_5":13306,"_25514":66147,"_2665":112297},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3170":66153,"_28022":66147,"_19417":112299,"_5":13306,"_25514":112285,"_2665":112300},[],"Verifica estos criterios juntos:",{"_3170":66154,"_28022":66147,"_19417":112302,"_5":13306,"_25514":112285,"_2665":111290},[],{"_3170":66155,"_28022":66147,"_19417":112304,"_5":13306,"_25514":112285,"_2665":112305},[],"Resultado necesario",{"_3170":66156,"_28022":66147,"_19417":112307,"_5":13306,"_25514":112285,"_2665":112308},[],"Cadena y firma",{"_3170":66157,"_28022":66147,"_19417":112310,"_5":13306,"_25514":112285,"_2665":112311},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3170":66158,"_28022":66147,"_19417":112313,"_5":13306,"_25514":112285,"_2665":112314},[],"Fechas",{"_3170":66159,"_28022":66147,"_19417":112316,"_5":13306,"_25514":112285,"_2665":112317},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3170":66160,"_28022":66147,"_19417":112319,"_5":13306,"_25514":112285,"_2665":107734},[],{"_3170":66161,"_28022":66147,"_19417":112321,"_5":13306,"_25514":112285,"_2665":112322},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3170":66162,"_28022":66147,"_19417":112324,"_5":13306,"_25514":112285,"_2665":112325},[],"Uso",{"_3170":66163,"_28022":66147,"_19417":112327,"_5":13306,"_25514":112285,"_2665":112328},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3170":66164,"_28022":66147,"_19417":112330,"_5":13306,"_25514":112285,"_2665":112331},[],"Revocación",{"_3170":66165,"_28022":66147,"_19417":112333,"_5":13306,"_25514":112285,"_2665":112334},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3170":66166,"_28022":66147,"_19417":112336,"_5":13306,"_25514":112285,"_2665":112337},[],"Autorización",{"_3170":66167,"_28022":66147,"_19417":112339,"_5":13306,"_25514":112285,"_2665":112340},[],"La aplicación permite la acción a esa identidad.",{"_3170":66168,"_28022":66147,"_19417":112342,"_5":13306,"_25514":112285,"_2665":112343},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3170":66169,"_28022":66147,"_19417":112345,"_5":13306,"_25514":112289,"_2665":112346},[],"Mecanismo",{"_3170":66170,"_28022":66147,"_19417":112348,"_5":13306,"_25514":112289,"_2665":112349},[],"Cuándo utilizarlo",{"_3170":66171,"_28022":66147,"_19417":112351,"_5":13306,"_25514":112289,"_2665":112352},[],"Qué debes mantener",{"_3170":66172,"_28022":66147,"_19417":112354,"_5":13306,"_25514":112289,"_2665":51225},[],{"_3170":66173,"_28022":66147,"_19417":112356,"_5":13306,"_25514":112289,"_2665":112357},[],"Consulta del estado de un certificado concreto.",{"_3170":66174,"_28022":66147,"_19417":112359,"_5":13306,"_25514":112289,"_2665":112360},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3170":66175,"_28022":66147,"_19417":112362,"_5":13306,"_25514":112289,"_2665":51234},[],{"_3170":66176,"_28022":66147,"_19417":112364,"_5":13306,"_25514":112289,"_2665":112365},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3170":66177,"_28022":66147,"_19417":112367,"_5":13306,"_25514":112289,"_2665":112368},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3170":66178,"_28022":66147,"_19417":112370,"_5":13306,"_25514":112289,"_2665":112371},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3170":66179,"_28022":66147,"_19417":112373,"_5":13306,"_25514":112289,"_2665":112374},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3170":66180,"_28022":66147,"_19417":112376,"_5":13306,"_25514":112293,"_2665":112377},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3170":66181,"_28022":66147,"_19417":112379,"_5":13306,"_25514":112293,"_2665":112380},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3170":66182,"_28022":66147,"_19417":112382,"_5":13306,"_25514":112293,"_2665":112383},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3170":66183,"_28022":66147,"_19417":112385,"_5":13306,"_25514":112293,"_2665":112386},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3170":66184,"_28022":66147,"_19417":112388,"_5":13306,"_25514":112293,"_2665":112389},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3170":66185,"_28022":66147,"_19417":112391,"_5":13306,"_25514":112293,"_2665":112392},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3170":66186,"_28022":66147,"_19417":112394,"_5":13306,"_25514":112293,"_2665":112395},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3170":66187,"_28022":66147,"_19417":112397,"_5":13306,"_25514":112293,"_2665":112398},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":66188,"_28022":66147,"_19417":112400,"_5":13306,"_25514":112293,"_2665":112401},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3170":66189,"_28022":66189,"_5":13637,"_2665":112403,"_28344":112404,"_19417":112405,"_25514":66189},"Certificados",[45406,108036,50532,111663],[],{"_3170":66190,"_28022":66189,"_19417":112407,"_5":13306,"_25514":66189,"_2665":112408},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3170":66191,"_28022":66189,"_5":28341,"_19417":112410,"_25514":112411,"_2665":112412},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3170":66192,"_28022":66189,"_5":28341,"_19417":112414,"_25514":112415,"_2665":112416},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3170":66193,"_28022":66189,"_5":28341,"_19417":112418,"_25514":112419,"_2665":112420},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3170":66194,"_28022":66189,"_5":28341,"_19417":112422,"_25514":112423,"_2665":112424},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3170":66195,"_28022":66189,"_5":28341,"_19417":112426,"_25514":112427,"_2665":112428},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3170":66196,"_28022":66189,"_5":28341,"_19417":112430,"_25514":112431,"_2665":112432},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3170":66197,"_28022":66189,"_5":28341,"_19417":112434,"_25514":112435,"_2665":112436},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3170":66198,"_28022":66189,"_5":28341,"_19417":112438,"_25514":112439,"_2665":112440},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3170":66199,"_28022":66189,"_5":28341,"_19417":112442,"_25514":112443,"_2665":112444},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3170":66200,"_28022":66189,"_19417":112446,"_5":13306,"_25514":66189,"_2665":112447},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3170":66201,"_28022":66189,"_19417":112449,"_5":13306,"_25514":112411,"_2665":112450},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3170":66202,"_28022":66189,"_19417":112452,"_5":13306,"_25514":112411,"_2665":112453},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3170":66203,"_28022":66189,"_19417":112455,"_5":13306,"_25514":112415,"_2665":112456},[],"Descarga el PEM e inspecciónalo:",{"_3170":66204,"_28022":66189,"_19417":112458,"_5":13306,"_25514":112415,"_2665":112459},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3170":66205,"_28022":66189,"_19417":112461,"_5":13306,"_25514":112419,"_2665":112462},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3170":66206,"_28022":66189,"_19417":112464,"_5":13306,"_25514":112419,"_2665":112465},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3170":66207,"_28022":66189,"_19417":112467,"_5":13306,"_25514":112419,"_2665":112468},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3170":66208,"_28022":66189,"_19417":112470,"_5":13306,"_25514":112419,"_2665":112471},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3170":66209,"_28022":66189,"_19417":112473,"_5":13306,"_25514":112419,"_2665":112474},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3170":66210,"_28022":66189,"_19417":112476,"_5":13306,"_25514":112419,"_2665":112477},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3170":66211,"_28022":66189,"_19417":112479,"_5":13306,"_25514":112419,"_2665":112480},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3170":66212,"_28022":66189,"_19417":112482,"_5":13306,"_25514":112423,"_2665":112483},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3170":66213,"_28022":66189,"_19417":112485,"_5":13306,"_25514":112427,"_2665":112486},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3170":66214,"_28022":66189,"_19417":112488,"_5":13306,"_25514":112431,"_2665":112489},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3170":66215,"_28022":66189,"_19417":112491,"_5":13306,"_25514":112435,"_2665":112492},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3170":66216,"_28022":66189,"_19417":112494,"_5":13306,"_25514":112435,"_2665":112495},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3170":66217,"_28022":66189,"_19417":112497,"_5":13306,"_25514":112435,"_2665":112498},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3170":66218,"_28022":66189,"_19417":112500,"_5":13306,"_25514":112439,"_2665":112501},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3170":66219,"_28022":66189,"_19417":112503,"_5":13306,"_25514":112439,"_2665":112504},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3170":66220,"_28022":66189,"_19417":112506,"_5":13306,"_25514":112439,"_2665":112507},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3170":66221,"_28022":66189,"_19417":112509,"_5":13306,"_25514":112443,"_2665":112510},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":66222,"_28022":66189,"_19417":112512,"_5":13306,"_25514":112443,"_2665":112513},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3170":66223,"_28022":66223,"_5":13637,"_2665":112515,"_28344":112516,"_19417":112518,"_25514":66223},"Ciclo de vida de un certificado",[45406,108036,50532,112517],"Conceptos",[],{"_3170":66224,"_28022":66223,"_19417":112520,"_5":13306,"_25514":66223,"_2665":112521},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3170":66225,"_28022":66223,"_5":28341,"_19417":112523,"_25514":112524,"_2665":112525},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3170":66226,"_28022":66223,"_5":28341,"_19417":112527,"_25514":112528,"_2665":112529},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3170":66227,"_28022":66223,"_5":28341,"_19417":112531,"_25514":112532,"_2665":112533},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3170":66228,"_28022":66223,"_5":28341,"_19417":112535,"_25514":112536,"_2665":112537},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3170":66229,"_28022":66223,"_5":28341,"_19417":112539,"_25514":112540,"_2665":112541},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3170":66230,"_28022":66223,"_5":28341,"_19417":112543,"_25514":112544,"_2665":112545},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3170":66231,"_28022":66223,"_5":28341,"_19417":112547,"_25514":112548,"_2665":112549},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_3170":66232,"_28022":66223,"_5":28341,"_19417":112551,"_25514":112552,"_2665":112553},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3170":66233,"_28022":66223,"_5":28341,"_19417":112555,"_25514":112556,"_2665":112557},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3170":66234,"_28022":66223,"_5":28341,"_19417":112559,"_25514":112560,"_2665":112561},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3170":66235,"_28022":66223,"_19417":112563,"_5":13306,"_25514":66223,"_2665":112564},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3170":66236,"_28022":66223,"_19417":112566,"_5":13306,"_25514":112528,"_2665":112567},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3170":66237,"_28022":66223,"_19417":112569,"_5":13306,"_25514":112532,"_2665":112570},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3170":66238,"_28022":66223,"_19417":112572,"_5":13306,"_25514":112536,"_2665":112573},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3170":66239,"_28022":66223,"_19417":112575,"_5":13306,"_25514":112540,"_2665":112576},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3170":66240,"_28022":66223,"_19417":112578,"_5":13306,"_25514":112544,"_2665":112579},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3170":66241,"_28022":66223,"_19417":112581,"_5":13306,"_25514":112548,"_2665":112582},[],"Lamassu persiste cuatro estados X.509:",{"_3170":66242,"_28022":66223,"_19417":112584,"_5":13306,"_25514":112548,"_2665":112585},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3170":66243,"_28022":66223,"_19417":112587,"_5":13306,"_25514":112548,"_2665":112588},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3170":66244,"_28022":66223,"_19417":112590,"_5":13306,"_25514":112548,"_2665":112591},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3170":66245,"_28022":66223,"_19417":112593,"_5":13306,"_25514":112548,"_2665":112594},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3170":66246,"_28022":66223,"_19417":112596,"_5":13306,"_25514":112548,"_2665":112597},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3170":66247,"_28022":66223,"_19417":112599,"_5":13306,"_25514":112552,"_2665":112600},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3170":66248,"_28022":66223,"_19417":112602,"_5":13306,"_25514":112552,"_2665":112603},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3170":66249,"_28022":66223,"_19417":112605,"_5":13306,"_25514":112552,"_2665":112606},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3170":66250,"_28022":66223,"_19417":112608,"_5":13306,"_25514":112556,"_2665":112609},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3170":66251,"_28022":66223,"_19417":112611,"_5":13306,"_25514":112556,"_2665":112612},[],"Antes de confirmar:",{"_3170":66252,"_28022":66223,"_19417":112614,"_5":13306,"_25514":112556,"_2665":112615},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3170":66253,"_28022":66223,"_19417":112617,"_5":13306,"_25514":112556,"_2665":112618},[],"Distribuye la nueva cadena de confianza.",{"_3170":66254,"_28022":66223,"_19417":112620,"_5":13306,"_25514":112556,"_2665":112621},[],"Reemite las identidades necesarias.",{"_3170":66255,"_28022":66223,"_19417":112623,"_5":13306,"_25514":112556,"_2665":112624},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3170":66256,"_28022":66223,"_19417":112626,"_5":13306,"_25514":112556,"_2665":112627},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3170":66257,"_28022":66223,"_19417":112629,"_5":13306,"_25514":112556,"_2665":112630},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3170":66258,"_28022":66223,"_19417":112632,"_5":13306,"_25514":112560,"_2665":112633},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3170":66259,"_28022":66223,"_19417":112635,"_5":13306,"_25514":112560,"_2665":112636},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3170":66260,"_28022":66223,"_19417":112638,"_5":13306,"_25514":112560,"_2665":112639},[],"Cambios de estado y razones de revocación.",{"_3170":66261,"_28022":66223,"_19417":112641,"_5":13306,"_25514":112560,"_2665":112642},[],"Publicación y vigencia de OCSP y CRLs.",{"_3170":66262,"_28022":66223,"_19417":112644,"_5":13306,"_25514":112560,"_2665":112645},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3170":66263,"_28022":66223,"_19417":112647,"_5":13306,"_25514":112560,"_2665":112648},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3170":66264,"_28022":66264,"_5":13637,"_2665":112650,"_28344":112651,"_19417":112652,"_25514":66264},"Modelo de confianza",[45406,108036,50532,112517],[],{"_3170":66265,"_28022":66264,"_19417":112654,"_5":13306,"_25514":66264,"_2665":112655},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3170":66266,"_28022":66264,"_5":28341,"_19417":112657,"_25514":112658,"_2665":112659},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3170":66267,"_28022":66264,"_5":28341,"_19417":112661,"_25514":112662,"_2665":112663},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3170":66268,"_28022":66264,"_5":28341,"_19417":112665,"_25514":112666,"_2665":112667},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3170":66269,"_28022":66264,"_5":28341,"_19417":112669,"_25514":112670,"_2665":112671},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3170":66270,"_28022":66264,"_5":28341,"_19417":112673,"_25514":112674,"_2665":112675},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3170":66271,"_28022":66264,"_5":28341,"_19417":112677,"_25514":112678,"_2665":112679},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3170":66272,"_28022":66264,"_5":28341,"_19417":112681,"_25514":112682,"_2665":112683},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3170":66273,"_28022":66264,"_5":28341,"_19417":112685,"_25514":112686,"_2665":112687},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3170":66274,"_28022":66264,"_5":28341,"_19417":112689,"_25514":112690,"_2665":112691},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3170":66275,"_28022":66264,"_5":28341,"_19417":112693,"_25514":112694,"_2665":112695},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3170":66276,"_28022":66264,"_19417":112697,"_5":13306,"_25514":66264,"_2665":112698},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3170":66277,"_28022":66264,"_19417":112700,"_5":13306,"_25514":112662,"_2665":112701},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3170":66278,"_28022":66264,"_19417":112703,"_5":13306,"_25514":112666,"_2665":112704},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3170":66279,"_28022":66264,"_19417":112706,"_5":13306,"_25514":112670,"_2665":112707},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3170":66280,"_28022":66264,"_19417":112709,"_5":13306,"_25514":112674,"_2665":112710},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3170":66281,"_28022":66264,"_19417":112712,"_5":13306,"_25514":112678,"_2665":112713},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3170":66282,"_28022":66264,"_19417":112715,"_5":13306,"_25514":112678,"_2665":112716},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3170":66283,"_28022":66264,"_19417":112718,"_5":13306,"_25514":112678,"_2665":112719},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3170":66284,"_28022":66264,"_19417":112721,"_5":13306,"_25514":112678,"_2665":112722},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3170":66285,"_28022":66264,"_19417":112724,"_5":13306,"_25514":112678,"_2665":112725},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3170":66286,"_28022":66264,"_19417":112727,"_5":13306,"_25514":112678,"_2665":112728},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3170":66287,"_28022":66264,"_19417":112730,"_5":13306,"_25514":112682,"_2665":112731},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3170":66288,"_28022":66264,"_19417":112733,"_5":13306,"_25514":112682,"_2665":112734},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3170":66289,"_28022":66264,"_19417":112736,"_5":13306,"_25514":112682,"_2665":112737},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3170":66290,"_28022":66264,"_19417":112739,"_5":13306,"_25514":112682,"_2665":112740},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3170":66291,"_28022":66264,"_19417":112742,"_5":13306,"_25514":112682,"_2665":112743},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3170":66292,"_28022":66264,"_19417":112745,"_5":13306,"_25514":112686,"_2665":112746},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3170":66293,"_28022":66264,"_19417":112748,"_5":13306,"_25514":112686,"_2665":112749},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3170":66294,"_28022":66264,"_19417":112751,"_5":13306,"_25514":112686,"_2665":112752},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3170":66295,"_28022":66264,"_19417":112754,"_5":13306,"_25514":112686,"_2665":112755},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3170":66296,"_28022":66264,"_19417":112757,"_5":13306,"_25514":112686,"_2665":112758},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3170":66297,"_28022":66264,"_19417":112760,"_5":13306,"_25514":112686,"_2665":112761},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3170":66298,"_28022":66264,"_19417":112763,"_5":13306,"_25514":112686,"_2665":112764},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3170":66299,"_28022":66264,"_19417":112766,"_5":13306,"_25514":112690,"_2665":112767},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3170":66300,"_28022":66264,"_19417":112769,"_5":13306,"_25514":112694,"_2665":112770},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3170":66301,"_28022":66264,"_19417":112772,"_5":13306,"_25514":112694,"_2665":112773},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3170":66302,"_28022":66264,"_19417":112775,"_5":13306,"_25514":112694,"_2665":112776},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3170":66303,"_28022":66264,"_19417":112778,"_5":13306,"_25514":112694,"_2665":112779},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3170":66304,"_28022":66264,"_19417":112781,"_5":13306,"_25514":112694,"_2665":112782},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3170":66305,"_28022":66264,"_19417":112784,"_5":13306,"_25514":112694,"_2665":112785},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3170":66306,"_28022":66264,"_19417":112787,"_5":13306,"_25514":112694,"_2665":112788},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3170":66307,"_28022":66307,"_5":13637,"_2665":112790,"_28344":112791,"_19417":112792,"_25514":66307},"Listas de revocación (CRL)",[45406,108036,50532,112278],[],{"_3170":66308,"_28022":66307,"_19417":112794,"_5":13306,"_25514":66307,"_2665":112795},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3170":66309,"_28022":66307,"_5":28341,"_19417":112797,"_25514":112798,"_2665":112799},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3170":66310,"_28022":66307,"_5":28341,"_19417":112801,"_25514":112802,"_2665":112803},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3170":66311,"_28022":66307,"_5":28341,"_19417":112805,"_25514":112806,"_2665":112807},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3170":66312,"_28022":66307,"_5":28341,"_19417":112809,"_25514":112810,"_2665":112811},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3170":66313,"_28022":66307,"_5":28341,"_19417":112813,"_25514":112814,"_2665":112815},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3170":66314,"_28022":66307,"_5":28341,"_19417":112817,"_25514":112818,"_2665":112819},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3170":66315,"_28022":66307,"_5":28341,"_19417":112821,"_25514":112822,"_2665":112823},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3170":66316,"_28022":66307,"_19417":112825,"_5":13306,"_25514":66307,"_2665":112826},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3170":66317,"_28022":66307,"_19417":112828,"_5":13306,"_25514":112798,"_2665":112829},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3170":66318,"_28022":66307,"_19417":112831,"_5":13306,"_25514":112798,"_2665":112832},[],"Campo de `crl_options`",{"_3170":66319,"_28022":66307,"_19417":112834,"_5":13306,"_25514":112798,"_2665":109571},[],{"_3170":66320,"_28022":66307,"_19417":112836,"_5":13306,"_25514":112798,"_2665":112837},[],"Valor inicial del backend",{"_3170":66321,"_28022":66307,"_19417":112839,"_5":13306,"_25514":112798,"_2665":51712},[],{"_3170":66322,"_28022":66307,"_19417":112841,"_5":13306,"_25514":112798,"_2665":112842},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3170":66323,"_28022":66307,"_19417":112844,"_5":13306,"_25514":112798,"_2665":112845},[],"7 días.",{"_3170":66324,"_28022":66307,"_19417":112847,"_5":13306,"_25514":112798,"_2665":51721},[],{"_3170":66325,"_28022":66307,"_19417":112849,"_5":13306,"_25514":112798,"_2665":112850},[],"Plazo desde la publicación que activa la renovación programada.",{"_3170":66326,"_28022":66307,"_19417":112852,"_5":13306,"_25514":112798,"_2665":112853},[],"6 días y 23 horas.",{"_3170":66327,"_28022":66307,"_19417":112855,"_5":13306,"_25514":112798,"_2665":51730},[],{"_3170":66328,"_28022":66307,"_19417":112857,"_5":13306,"_25514":112798,"_2665":112858},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3170":66329,"_28022":66307,"_19417":112860,"_5":13306,"_25514":112798,"_2665":51736},[],{"_3170":66330,"_28022":66307,"_19417":112862,"_5":13306,"_25514":112798,"_2665":51739},[],{"_3170":66331,"_28022":66307,"_19417":112864,"_5":13306,"_25514":112798,"_2665":112865},[],"Campo de configuración inicializado con el SKI de la CA.",{"_3170":66332,"_28022":66307,"_19417":112867,"_5":13306,"_25514":112798,"_2665":112868},[],"SKI de la CA.",{"_3170":66333,"_28022":66307,"_19417":112870,"_5":13306,"_25514":112798,"_2665":112871},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_3170":66334,"_28022":66307,"_19417":112873,"_5":13306,"_25514":112798,"_2665":112874},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3170":66335,"_28022":66307,"_19417":112876,"_5":13306,"_25514":112802,"_2665":112877},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_3170":66336,"_28022":66307,"_19417":112879,"_5":13306,"_25514":112802,"_2665":112880},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3170":66337,"_28022":66307,"_19417":112882,"_5":13306,"_25514":112802,"_2665":112883},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3170":66338,"_28022":66307,"_19417":112885,"_5":13306,"_25514":112806,"_2665":112886},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3170":66339,"_28022":66307,"_19417":112888,"_5":13306,"_25514":112806,"_2665":112889},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3170":66340,"_28022":66307,"_19417":112891,"_5":13306,"_25514":112810,"_2665":112892},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3170":66341,"_28022":66307,"_19417":112894,"_5":13306,"_25514":112810,"_2665":112895},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3170":66342,"_28022":66307,"_19417":112897,"_5":13306,"_25514":112810,"_2665":112898},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3170":66343,"_28022":66307,"_19417":112900,"_5":13306,"_25514":112810,"_2665":112901},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3170":66344,"_28022":66307,"_19417":112903,"_5":13306,"_25514":112810,"_2665":112904},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3170":66345,"_28022":66307,"_19417":112906,"_5":13306,"_25514":112814,"_2665":112907},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3170":66346,"_28022":66307,"_19417":112909,"_5":13306,"_25514":112814,"_2665":109760},[],{"_3170":66347,"_28022":66307,"_19417":112911,"_5":13306,"_25514":112814,"_2665":112912},[],"Path relativo",{"_3170":66348,"_28022":66307,"_19417":112914,"_5":13306,"_25514":112814,"_2665":107824},[],{"_3170":66349,"_28022":66307,"_19417":112916,"_5":13306,"_25514":112814,"_2665":51794},[],{"_3170":66350,"_28022":66307,"_19417":112918,"_5":13306,"_25514":112814,"_2665":51797},[],{"_3170":66351,"_28022":66307,"_19417":112920,"_5":13306,"_25514":112814,"_2665":112921},[],"Consultar `crl_options` y `latest_crl`.",{"_3170":66352,"_28022":66307,"_19417":112923,"_5":13306,"_25514":112814,"_2665":51803},[],{"_3170":66353,"_28022":66307,"_19417":112925,"_5":13306,"_25514":112814,"_2665":51797},[],{"_3170":66354,"_28022":66307,"_19417":112927,"_5":13306,"_25514":112814,"_2665":112928},[],"Sustituir la configuración de CRL.",{"_3170":66355,"_28022":66307,"_19417":112930,"_5":13306,"_25514":112814,"_2665":112931},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3170":66356,"_28022":66307,"_19417":112933,"_5":13306,"_25514":112814,"_2665":112934},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3170":66357,"_28022":66307,"_19417":112936,"_5":13306,"_25514":112818,"_2665":112937},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3170":66358,"_28022":66307,"_19417":112939,"_5":13306,"_25514":112822,"_2665":112940},[],"RFC 5280: perfil X.509 y CRL.",{"_3170":66359,"_28022":66307,"_19417":112942,"_5":13306,"_25514":112822,"_2665":51823},[],{"_3170":66360,"_28022":66307,"_19417":112944,"_5":13306,"_25514":112822,"_2665":51826},[],{"_3170":66361,"_28022":66307,"_19417":112946,"_5":13306,"_25514":112822,"_2665":112947},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3170":66362,"_28022":66307,"_19417":112949,"_5":13306,"_25514":112822,"_2665":112950},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3170":66363,"_28022":66363,"_5":13637,"_2665":112952,"_28344":112953,"_19417":112954,"_25514":66363},"Claves y motores criptográficos",[45406,108036,50532,111663],[],{"_3170":66364,"_28022":66363,"_19417":112956,"_5":13306,"_25514":66363,"_2665":112957},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3170":66365,"_28022":66363,"_5":28341,"_19417":112959,"_25514":112960,"_2665":112961},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3170":66366,"_28022":66363,"_5":28341,"_19417":112963,"_25514":112964,"_2665":112965},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3170":66367,"_28022":66363,"_5":28341,"_19417":112967,"_25514":112968,"_2665":51851},[],"/docs/es/platform/pki/key-management#file-system",{"_3170":66368,"_28022":66363,"_5":28341,"_19417":112970,"_25514":112971,"_2665":51855},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3170":66369,"_28022":66363,"_5":28341,"_19417":112973,"_25514":112974,"_2665":51859},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3170":66370,"_28022":66363,"_5":28341,"_19417":112976,"_25514":112977,"_2665":51863},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3170":66371,"_28022":66363,"_5":28341,"_19417":112979,"_25514":112980,"_2665":51867},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3170":66372,"_28022":66363,"_5":28341,"_19417":112982,"_25514":112983,"_2665":51871},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3170":66373,"_28022":66363,"_5":28341,"_19417":112985,"_25514":112986,"_2665":112987},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3170":66374,"_28022":66363,"_5":28341,"_19417":112989,"_25514":112990,"_2665":112991},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3170":66375,"_28022":66363,"_5":28341,"_19417":112993,"_25514":112994,"_2665":112995},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3170":66376,"_28022":66363,"_5":28341,"_19417":112997,"_25514":112998,"_2665":112999},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3170":66377,"_28022":66363,"_5":28341,"_19417":113001,"_25514":113002,"_2665":113003},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3170":66378,"_28022":66363,"_5":28341,"_19417":113005,"_25514":113006,"_2665":113007},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3170":66379,"_28022":66363,"_5":28341,"_19417":113009,"_25514":113010,"_2665":113011},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3170":66380,"_28022":66363,"_5":28341,"_19417":113013,"_25514":113014,"_2665":51903},[],"/docs/es/platform/pki/key-management#sign",{"_3170":66381,"_28022":66363,"_5":28341,"_19417":113016,"_25514":113017,"_2665":51907},[],"/docs/es/platform/pki/key-management#verify",{"_3170":66382,"_28022":66363,"_5":28341,"_19417":113019,"_25514":113020,"_2665":113021},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3170":66383,"_28022":66363,"_5":28341,"_19417":113023,"_25514":113024,"_2665":113025},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3170":66384,"_28022":66363,"_5":28341,"_19417":113027,"_25514":113028,"_2665":113029},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3170":66385,"_28022":66363,"_19417":113031,"_5":13306,"_25514":66363,"_2665":113032},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3170":66386,"_28022":66363,"_19417":113034,"_5":13306,"_25514":66363,"_2665":113035},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3170":66387,"_28022":66363,"_19417":113037,"_5":13306,"_25514":112960,"_2665":113038},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3170":66388,"_28022":66363,"_19417":113040,"_5":13306,"_25514":112960,"_2665":113041},[],"En la práctica, permite:",{"_3170":66389,"_28022":66363,"_19417":113043,"_5":13306,"_25514":112960,"_2665":113044},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3170":66390,"_28022":66363,"_19417":113046,"_5":13306,"_25514":112960,"_2665":113047},[],"Importar claves creadas externamente.",{"_3170":66391,"_28022":66363,"_19417":113049,"_5":13306,"_25514":112960,"_2665":113050},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3170":66392,"_28022":66363,"_19417":113052,"_5":13306,"_25514":112960,"_2665":113053},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3170":66393,"_28022":66363,"_19417":113055,"_5":13306,"_25514":112964,"_2665":113056},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3170":66394,"_28022":66363,"_19417":113058,"_5":13306,"_25514":112964,"_2665":113059},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3170":66395,"_28022":66363,"_19417":113061,"_5":13306,"_25514":112964,"_2665":113062},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3170":66396,"_28022":66363,"_19417":113064,"_5":13306,"_25514":112968,"_2665":113065},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3170":66397,"_28022":66363,"_19417":113067,"_5":13306,"_25514":112971,"_2665":113068},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3170":66398,"_28022":66363,"_19417":113070,"_5":13306,"_25514":112971,"_2665":113071},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3170":66399,"_28022":66363,"_19417":113073,"_5":13306,"_25514":112974,"_2665":113074},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3170":66400,"_28022":66363,"_19417":113076,"_5":13306,"_25514":112977,"_2665":113077},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3170":66401,"_28022":66363,"_19417":113079,"_5":13306,"_25514":112980,"_2665":113080},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3170":66402,"_28022":66363,"_19417":113082,"_5":13306,"_25514":112983,"_2665":113083},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3170":66403,"_28022":66363,"_19417":113085,"_5":13306,"_25514":112983,"_2665":113086},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3170":66404,"_28022":66363,"_19417":113088,"_5":13306,"_25514":112983,"_2665":113089},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3170":66405,"_28022":66363,"_19417":113091,"_5":13306,"_25514":112983,"_2665":113092},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3170":66406,"_28022":66363,"_19417":113094,"_5":13306,"_25514":112986,"_2665":113095},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3170":66407,"_28022":66363,"_19417":113097,"_5":13306,"_25514":112986,"_2665":113098},[],"La tabla incluye los siguientes campos:",{"_3170":66408,"_28022":66363,"_19417":113100,"_5":13306,"_25514":112986,"_2665":113101},[],"**Name**: nombre descriptivo de la clave.",{"_3170":66409,"_28022":66363,"_19417":113103,"_5":13306,"_25514":112986,"_2665":113104},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3170":66410,"_28022":66363,"_19417":113106,"_5":13306,"_25514":112986,"_2665":113107},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3170":66411,"_28022":66363,"_19417":113109,"_5":13306,"_25514":112986,"_2665":113110},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3170":66412,"_28022":66363,"_19417":113112,"_5":13306,"_25514":112986,"_2665":113113},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3170":66413,"_28022":66363,"_19417":113115,"_5":13306,"_25514":112986,"_2665":113116},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3170":66414,"_28022":66363,"_19417":113118,"_5":13306,"_25514":112986,"_2665":113119},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3170":66415,"_28022":66363,"_19417":113121,"_5":13306,"_25514":112986,"_2665":113122},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3170":66416,"_28022":66363,"_19417":113124,"_5":13306,"_25514":112986,"_2665":113125},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3170":66417,"_28022":66363,"_19417":113127,"_5":13306,"_25514":112986,"_2665":113128},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3170":66418,"_28022":66363,"_19417":113130,"_5":13306,"_25514":112986,"_2665":113131},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3170":66419,"_28022":66363,"_19417":113133,"_5":13306,"_25514":112986,"_2665":113134},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3170":66420,"_28022":66363,"_19417":113136,"_5":13306,"_25514":112986,"_2665":113137},[],"**Delete Key** para eliminar la clave del sistema.",{"_3170":66421,"_28022":66363,"_19417":113139,"_5":13306,"_25514":112990,"_2665":113140},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3170":66422,"_28022":66363,"_19417":113142,"_5":13306,"_25514":112994,"_2665":113143},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3170":66423,"_28022":66363,"_19417":113145,"_5":13306,"_25514":112994,"_2665":113146},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3170":66424,"_28022":66363,"_19417":113148,"_5":13306,"_25514":112994,"_2665":113149},[],"**Key Name**: nombre único y descriptivo.",{"_3170":66425,"_28022":66363,"_19417":113151,"_5":13306,"_25514":112994,"_2665":113152},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3170":66426,"_28022":66363,"_19417":113154,"_5":13306,"_25514":112994,"_2665":113155},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3170":66427,"_28022":66363,"_19417":113157,"_5":13306,"_25514":112994,"_2665":113158},[],"**Tags**: metadatos para clasificar la clave.",{"_3170":66428,"_28022":66363,"_19417":113160,"_5":13306,"_25514":112994,"_2665":113161},[],"**Metadata**: información adicional para usos avanzados.",{"_3170":66429,"_28022":66363,"_19417":113163,"_5":13306,"_25514":112998,"_2665":113164},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3170":66430,"_28022":66363,"_19417":113166,"_5":13306,"_25514":112998,"_2665":113167},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3170":66431,"_28022":66363,"_19417":113169,"_5":13306,"_25514":112998,"_2665":113170},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3170":66432,"_28022":66363,"_19417":113172,"_5":13306,"_25514":112998,"_2665":113173},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3170":66433,"_28022":66363,"_19417":113175,"_5":13306,"_25514":112998,"_2665":113176},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3170":66434,"_28022":66363,"_19417":113178,"_5":13306,"_25514":112998,"_2665":113179},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3170":66435,"_28022":66363,"_19417":113181,"_5":13306,"_25514":112998,"_2665":113182},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3170":66436,"_28022":66363,"_19417":113184,"_5":13306,"_25514":112998,"_2665":113185},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3170":66437,"_28022":66363,"_19417":113187,"_5":13306,"_25514":112998,"_2665":113188},[],"**Metadata**: información adicional opcional.",{"_3170":66438,"_28022":66363,"_19417":113190,"_5":13306,"_25514":112998,"_2665":113191},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3170":66439,"_28022":66363,"_19417":113193,"_5":13306,"_25514":112998,"_2665":113194},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3170":66440,"_28022":66363,"_19417":113196,"_5":13306,"_25514":113002,"_2665":113197},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3170":66441,"_28022":66363,"_19417":113199,"_5":13306,"_25514":113006,"_2665":113200},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3170":66442,"_28022":66363,"_19417":113202,"_5":13306,"_25514":113006,"_2665":113203},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3170":66443,"_28022":66363,"_19417":113205,"_5":13306,"_25514":113006,"_2665":113206},[],"**Key Name**: nombre descriptivo.",{"_3170":66444,"_28022":66363,"_19417":113208,"_5":13306,"_25514":113006,"_2665":113209},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3170":66445,"_28022":66363,"_19417":113211,"_5":13306,"_25514":113006,"_2665":113212},[],"**Tags**: etiquetas asociadas.",{"_3170":66446,"_28022":66363,"_19417":113214,"_5":13306,"_25514":113006,"_2665":113215},[],"**Aliases**: nombres alternativos.",{"_3170":66447,"_28022":66363,"_19417":113217,"_5":13306,"_25514":113006,"_2665":113218},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3170":66448,"_28022":66363,"_19417":113220,"_5":13306,"_25514":113006,"_2665":113221},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3170":66449,"_28022":66363,"_19417":113223,"_5":13306,"_25514":113006,"_2665":113224},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3170":66450,"_28022":66363,"_19417":113226,"_5":13306,"_25514":113006,"_2665":113227},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3170":66451,"_28022":66363,"_19417":113229,"_5":13306,"_25514":113010,"_2665":113230},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3170":66452,"_28022":66363,"_19417":113232,"_5":13306,"_25514":113010,"_2665":113233},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3170":66453,"_28022":66363,"_19417":113235,"_5":13306,"_25514":113010,"_2665":113236},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3170":66454,"_28022":66363,"_19417":113238,"_5":13306,"_25514":113014,"_2665":113239},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3170":66455,"_28022":66363,"_19417":113241,"_5":13306,"_25514":113014,"_2665":113242},[],"Campos principales:",{"_3170":66456,"_28022":66363,"_19417":113244,"_5":13306,"_25514":113014,"_2665":113245},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3170":66457,"_28022":66363,"_19417":113247,"_5":13306,"_25514":113014,"_2665":113248},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3170":66458,"_28022":66363,"_19417":113250,"_5":13306,"_25514":113014,"_2665":113251},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3170":66459,"_28022":66363,"_19417":113253,"_5":13306,"_25514":113014,"_2665":113254},[],"**Message**: contenido que se va a firmar.",{"_3170":66460,"_28022":66363,"_19417":113256,"_5":13306,"_25514":113014,"_2665":113257},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3170":66461,"_28022":66363,"_19417":113259,"_5":13306,"_25514":113017,"_2665":113260},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3170":66462,"_28022":66363,"_19417":113262,"_5":13306,"_25514":113017,"_2665":113242},[],{"_3170":66463,"_28022":66363,"_19417":113264,"_5":13306,"_25514":113017,"_2665":113265},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3170":66464,"_28022":66363,"_19417":113267,"_5":13306,"_25514":113017,"_2665":113268},[],"**Message Type**: `Raw` o `Digest`.",{"_3170":66465,"_28022":66363,"_19417":113270,"_5":13306,"_25514":113017,"_2665":113271},[],"**Payload Encoding**: codificación del mensaje.",{"_3170":66466,"_28022":66363,"_19417":113273,"_5":13306,"_25514":113017,"_2665":113274},[],"**Message**: mensaje original o hash.",{"_3170":66467,"_28022":66363,"_19417":113276,"_5":13306,"_25514":113017,"_2665":113277},[],"**Signature**: firma que se desea comprobar.",{"_3170":66468,"_28022":66363,"_19417":113279,"_5":13306,"_25514":113017,"_2665":113280},[],"**Result**: indicador del resultado de la validación.",{"_3170":66469,"_28022":66363,"_19417":113282,"_5":13306,"_25514":113020,"_2665":113283},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3170":66470,"_28022":66363,"_19417":113285,"_5":13306,"_25514":113020,"_2665":113286},[],"Este flujo es útil para:",{"_3170":66471,"_28022":66363,"_19417":113288,"_5":13306,"_25514":113020,"_2665":113289},[],"Solicitar certificados a una CA externa.",{"_3170":66472,"_28022":66363,"_19417":113291,"_5":13306,"_25514":113020,"_2665":113292},[],"Renovar una identidad manteniendo la misma clave.",{"_3170":66473,"_28022":66363,"_19417":113294,"_5":13306,"_25514":113020,"_2665":113295},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3170":66474,"_28022":66363,"_19417":113297,"_5":13306,"_25514":113020,"_2665":113298},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3170":66475,"_28022":66363,"_19417":113300,"_5":13306,"_25514":113020,"_2665":113301},[],"**Organization (O)**: organización o empresa.",{"_3170":66476,"_28022":66363,"_19417":113303,"_5":13306,"_25514":113020,"_2665":113304},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3170":66477,"_28022":66363,"_19417":113306,"_5":13306,"_25514":113020,"_2665":113307},[],"**Country (C)**: código de país de dos letras.",{"_3170":66478,"_28022":66363,"_19417":113309,"_5":13306,"_25514":113020,"_2665":113310},[],"**State / Province (ST)**: estado o provincia.",{"_3170":66479,"_28022":66363,"_19417":113312,"_5":13306,"_25514":113020,"_2665":113313},[],"**Locality (L)**: ciudad o localidad.",{"_3170":66480,"_28022":66363,"_19417":113315,"_5":13306,"_25514":113020,"_2665":113316},[],"**Email Address**: correo de contacto.",{"_3170":66481,"_28022":66363,"_19417":113318,"_5":13306,"_25514":113020,"_2665":113319},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3170":66482,"_28022":66363,"_19417":113321,"_5":13306,"_25514":113020,"_2665":113322},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3170":66483,"_28022":66363,"_19417":113324,"_5":13306,"_25514":113024,"_2665":113325},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3170":66484,"_28022":66363,"_19417":113327,"_5":13306,"_25514":113024,"_2665":52218},[],{"_3170":66485,"_28022":66363,"_19417":113329,"_5":13306,"_25514":113028,"_2665":113330},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3170":66486,"_28022":66486,"_5":13637,"_2665":113332,"_28344":113333,"_19417":113334,"_25514":66486},"Validación online con OCSP",[45406,108036,50532,112278],[],{"_3170":66487,"_28022":66486,"_19417":113336,"_5":13306,"_25514":66486,"_2665":113337},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3170":66488,"_28022":66486,"_5":28341,"_19417":113339,"_25514":113340,"_2665":113341},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3170":66489,"_28022":66486,"_5":28341,"_19417":113343,"_25514":113344,"_2665":113345},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3170":66490,"_28022":66486,"_5":28341,"_19417":113347,"_25514":113348,"_2665":113349},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3170":66491,"_28022":66486,"_5":28341,"_19417":113351,"_25514":113352,"_2665":113353},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3170":66492,"_28022":66486,"_5":28341,"_19417":113355,"_25514":113356,"_2665":113357},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3170":66493,"_28022":66486,"_5":28341,"_19417":113359,"_25514":113360,"_2665":112823},[],"/docs/es/platform/pki/ocsp#referencias",{"_3170":66494,"_28022":66486,"_19417":113362,"_5":13306,"_25514":66486,"_2665":113363},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3170":66495,"_28022":66486,"_19417":113365,"_5":13306,"_25514":113340,"_2665":113366},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3170":66496,"_28022":66486,"_19417":113368,"_5":13306,"_25514":113340,"_2665":113369},[],"Estado del registro",{"_3170":66497,"_28022":66486,"_19417":113371,"_5":13306,"_25514":113340,"_2665":113372},[],"Respuesta firmada",{"_3170":66498,"_28022":66486,"_19417":113374,"_5":13306,"_25514":113340,"_2665":49710},[],{"_3170":66499,"_28022":66486,"_19417":113376,"_5":13306,"_25514":113340,"_2665":52268},[],{"_3170":66500,"_28022":66486,"_19417":113378,"_5":13306,"_25514":113340,"_2665":49727},[],{"_3170":66501,"_28022":66486,"_19417":113380,"_5":13306,"_25514":113340,"_2665":113381},[],"`Revoked`, con razón y fecha de revocación.",{"_3170":66502,"_28022":66486,"_19417":113383,"_5":13306,"_25514":113340,"_2665":113384},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3170":66503,"_28022":66486,"_19417":113386,"_5":13306,"_25514":113340,"_2665":113387},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3170":66504,"_28022":66486,"_19417":113389,"_5":13306,"_25514":113340,"_2665":113390},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3170":66505,"_28022":66486,"_19417":113392,"_5":13306,"_25514":113340,"_2665":113393},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3170":66506,"_28022":66486,"_19417":113395,"_5":13306,"_25514":113340,"_2665":113396},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3170":66507,"_28022":66486,"_19417":113398,"_5":13306,"_25514":113344,"_2665":113399},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3170":66508,"_28022":66486,"_19417":113401,"_5":13306,"_25514":113344,"_2665":113402},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3170":66509,"_28022":66486,"_19417":113404,"_5":13306,"_25514":113348,"_2665":113405},[],"El servicio acepta:",{"_3170":66510,"_28022":66486,"_19417":113407,"_5":13306,"_25514":113348,"_2665":109760},[],{"_3170":66511,"_28022":66486,"_19417":113409,"_5":13306,"_25514":113348,"_2665":113410},[],"Ruta del servicio VA",{"_3170":66512,"_28022":66486,"_19417":113412,"_5":13306,"_25514":113348,"_2665":113413},[],"Formato",{"_3170":66513,"_28022":66486,"_19417":113415,"_5":13306,"_25514":113348,"_2665":52308},[],{"_3170":66514,"_28022":66486,"_19417":113417,"_5":13306,"_25514":113348,"_2665":52311},[],{"_3170":66515,"_28022":66486,"_19417":113419,"_5":13306,"_25514":113348,"_2665":113420},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3170":66516,"_28022":66486,"_19417":113422,"_5":13306,"_25514":113348,"_2665":51794},[],{"_3170":66517,"_28022":66486,"_19417":113424,"_5":13306,"_25514":113348,"_2665":52319},[],{"_3170":66518,"_28022":66486,"_19417":113426,"_5":13306,"_25514":113348,"_2665":113427},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3170":66519,"_28022":66486,"_19417":113429,"_5":13306,"_25514":113348,"_2665":113430},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3170":66520,"_28022":66486,"_19417":113432,"_5":13306,"_25514":113352,"_2665":113433},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3170":66521,"_28022":66486,"_19417":113435,"_5":13306,"_25514":113352,"_2665":113436},[],"Genera la solicitud:",{"_3170":66522,"_28022":66486,"_19417":113438,"_5":13306,"_25514":113352,"_2665":113439},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3170":66523,"_28022":66486,"_19417":113441,"_5":13306,"_25514":113352,"_2665":113442},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3170":66524,"_28022":66486,"_19417":113444,"_5":13306,"_25514":113352,"_2665":113445},[],"Verifica el DER recibido:",{"_3170":66525,"_28022":66486,"_19417":113447,"_5":13306,"_25514":113352,"_2665":113448},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3170":66526,"_28022":66486,"_19417":113450,"_5":13306,"_25514":113356,"_2665":113451},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3170":66527,"_28022":66486,"_19417":113453,"_5":13306,"_25514":113356,"_2665":113454},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3170":66528,"_28022":66486,"_19417":113456,"_5":13306,"_25514":113360,"_2665":52352},[],{"_3170":66529,"_28022":66486,"_19417":113458,"_5":13306,"_25514":113360,"_2665":52355},[],{"_3170":66530,"_28022":66486,"_19417":113460,"_5":13306,"_25514":113360,"_2665":113461},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3170":66531,"_28022":66486,"_19417":113463,"_5":13306,"_25514":113360,"_2665":112950},[],{"_3170":66532,"_28022":66532,"_5":13637,"_2665":50532,"_28344":113465,"_19417":113466,"_25514":66532},[45406,108036,50532],[],{"_3170":66533,"_28022":66532,"_19417":113468,"_5":13306,"_25514":66532,"_2665":113469},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3170":66534,"_28022":66532,"_5":28341,"_19417":113471,"_25514":113472,"_2665":110987},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3170":66535,"_28022":66532,"_5":28341,"_19417":113474,"_25514":113475,"_2665":113476},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3170":66536,"_28022":66532,"_5":28341,"_19417":113478,"_25514":113479,"_2665":111509},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3170":66537,"_28022":66532,"_5":28341,"_19417":113481,"_25514":113482,"_2665":111513},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3170":66538,"_28022":66532,"_5":28341,"_19417":113484,"_25514":113485,"_2665":111517},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3170":66539,"_28022":66532,"_5":28341,"_19417":113487,"_25514":113488,"_2665":111521},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3170":66540,"_28022":66532,"_5":28341,"_19417":113490,"_25514":113491,"_2665":111529},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3170":66541,"_28022":66532,"_5":28341,"_19417":113493,"_25514":113494,"_2665":113495},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3170":66542,"_28022":66532,"_5":28341,"_19417":113497,"_25514":113498,"_2665":112444},[],"/docs/es/platform/pki/overview#continúa",{"_3170":66543,"_28022":66532,"_19417":113500,"_5":13306,"_25514":66532,"_2665":113501},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3170":66544,"_28022":66532,"_19417":113503,"_5":13306,"_25514":113472,"_2665":113504},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3170":66545,"_28022":66532,"_19417":113506,"_5":13306,"_25514":113472,"_2665":113507},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3170":66546,"_28022":66532,"_19417":113509,"_5":13306,"_25514":113475,"_2665":113510},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3170":66547,"_28022":66532,"_19417":113512,"_5":13306,"_25514":113475,"_2665":113513},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3170":66548,"_28022":66532,"_19417":113515,"_5":13306,"_25514":113475,"_2665":113516},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3170":66549,"_28022":66532,"_19417":113518,"_5":13306,"_25514":113475,"_2665":113519},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3170":66550,"_28022":66532,"_19417":113521,"_5":13306,"_25514":113475,"_2665":113522},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3170":66551,"_28022":66532,"_19417":113524,"_5":13306,"_25514":113482,"_2665":113525},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3170":66552,"_28022":66532,"_19417":113527,"_5":13306,"_25514":113485,"_2665":113528},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3170":66553,"_28022":66532,"_19417":113530,"_5":13306,"_25514":113488,"_2665":113531},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3170":66554,"_28022":66532,"_19417":113533,"_5":13306,"_25514":113491,"_2665":113534},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3170":66555,"_28022":66532,"_19417":113536,"_5":13306,"_25514":113494,"_2665":113537},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3170":66556,"_28022":66532,"_19417":113539,"_5":13306,"_25514":113494,"_2665":113540},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3170":66557,"_28022":66532,"_19417":113542,"_5":13306,"_25514":113494,"_2665":113543},[],"su clave pública corresponda a la clave privada del cliente;",{"_3170":66558,"_28022":66532,"_19417":113545,"_5":13306,"_25514":113494,"_2665":113546},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3170":66559,"_28022":66532,"_19417":113548,"_5":13306,"_25514":113494,"_2665":113549},[],"sus fechas y usos permitan la operación;",{"_3170":66560,"_28022":66532,"_19417":113551,"_5":13306,"_25514":113494,"_2665":113552},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3170":66561,"_28022":66532,"_19417":113554,"_5":13306,"_25514":113494,"_2665":113555},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3170":66562,"_28022":66532,"_19417":113557,"_5":13306,"_25514":113498,"_2665":113558},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3170":66563,"_28022":66532,"_19417":113560,"_5":13306,"_25514":113498,"_2665":113561},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3170":66564,"_28022":66532,"_19417":113563,"_5":13306,"_25514":113498,"_2665":113564},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3170":66565,"_28022":66565,"_5":13637,"_2665":113566,"_28344":113567,"_19417":113568,"_25514":66565},"Crea tu primera CA",[45406,108036,50532,111111],[],{"_3170":66566,"_28022":66565,"_19417":113570,"_5":13306,"_25514":66565,"_2665":113571},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3170":66567,"_28022":66565,"_5":28341,"_19417":113573,"_25514":113574,"_2665":106689},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3170":66568,"_28022":66565,"_5":28341,"_19417":113576,"_25514":113577,"_2665":113578},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3170":66569,"_28022":66565,"_5":28341,"_19417":113580,"_25514":113581,"_2665":113582},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3170":66570,"_28022":66565,"_5":28341,"_19417":113584,"_25514":113585,"_2665":113586},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3170":66571,"_28022":66565,"_5":28341,"_19417":113588,"_25514":113589,"_2665":113590},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3170":66572,"_28022":66565,"_5":28341,"_19417":113592,"_25514":113593,"_2665":113594},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3170":66573,"_28022":66565,"_5":28341,"_19417":113596,"_25514":113597,"_2665":113598},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3170":66574,"_28022":66565,"_5":28341,"_19417":113600,"_25514":113601,"_2665":111359},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3170":66575,"_28022":66565,"_5":28341,"_19417":113603,"_25514":113604,"_2665":106713},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3170":66576,"_28022":66565,"_19417":113606,"_5":13306,"_25514":66565,"_2665":113607},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3170":66577,"_28022":66565,"_19417":113609,"_5":13306,"_25514":113574,"_2665":113610},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3170":66578,"_28022":66565,"_19417":113612,"_5":13306,"_25514":113574,"_2665":113613},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3170":66579,"_28022":66565,"_19417":113615,"_5":13306,"_25514":113574,"_2665":113616},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3170":66580,"_28022":66565,"_19417":113618,"_5":13306,"_25514":113574,"_2665":113619},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3170":66581,"_28022":66565,"_19417":113621,"_5":13306,"_25514":113577,"_2665":113622},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3170":66582,"_28022":66565,"_19417":113624,"_5":13306,"_25514":113577,"_2665":113625},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3170":66583,"_28022":66565,"_19417":113627,"_5":13306,"_25514":113581,"_2665":113628},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3170":66584,"_28022":66565,"_19417":113630,"_5":13306,"_25514":113581,"_2665":113631},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3170":66585,"_28022":66565,"_19417":113633,"_5":13306,"_25514":113585,"_2665":113634},[],"Selecciona **Root CA** y completa:",{"_3170":66586,"_28022":66565,"_19417":113636,"_5":13306,"_25514":113585,"_2665":52534},[],{"_3170":66587,"_28022":66565,"_19417":113638,"_5":13306,"_25514":113585,"_2665":113639},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3170":66588,"_28022":66565,"_19417":113641,"_5":13306,"_25514":113585,"_2665":113642},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3170":66589,"_28022":66565,"_19417":113644,"_5":13306,"_25514":113585,"_2665":113645},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3170":66590,"_28022":66565,"_19417":113647,"_5":13306,"_25514":113585,"_2665":113648},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3170":66591,"_28022":66565,"_19417":113650,"_5":13306,"_25514":113589,"_2665":113651},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3170":66592,"_28022":66565,"_19417":113653,"_5":13306,"_25514":113593,"_2665":113654},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3170":66593,"_28022":66565,"_19417":113656,"_5":13306,"_25514":113593,"_2665":113657},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3170":66594,"_28022":66565,"_19417":113659,"_5":13306,"_25514":113597,"_2665":113660},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3170":66595,"_28022":66565,"_19417":113662,"_5":13306,"_25514":113597,"_2665":113663},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3170":66596,"_28022":66565,"_19417":113665,"_5":13306,"_25514":113597,"_2665":113666},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3170":66597,"_28022":66565,"_19417":113668,"_5":13306,"_25514":113601,"_2665":113669},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3170":66598,"_28022":66565,"_19417":113671,"_5":13306,"_25514":113601,"_2665":113672},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3170":66599,"_28022":66565,"_19417":113674,"_5":13306,"_25514":113601,"_2665":113675},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3170":66600,"_28022":66565,"_19417":113677,"_5":13306,"_25514":113601,"_2665":113678},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3170":66601,"_28022":66565,"_19417":113680,"_5":13306,"_25514":113604,"_2665":113681},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3170":66602,"_28022":66602,"_5":13637,"_2665":113683,"_28344":113684,"_19417":113685,"_25514":66602},"Emite y verifica un certificado",[45406,108036,50532,111111],[],{"_3170":66603,"_28022":66602,"_19417":113687,"_5":13306,"_25514":66602,"_2665":113688},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3170":66604,"_28022":66602,"_5":28341,"_19417":113690,"_25514":113691,"_2665":106689},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3170":66605,"_28022":66602,"_5":28341,"_19417":113693,"_25514":113694,"_2665":113695},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3170":66606,"_28022":66602,"_5":28341,"_19417":113697,"_25514":113698,"_2665":113699},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3170":66607,"_28022":66602,"_5":28341,"_19417":113701,"_25514":113702,"_2665":113703},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3170":66608,"_28022":66602,"_5":28341,"_19417":113705,"_25514":113706,"_2665":113707},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3170":66609,"_28022":66602,"_5":28341,"_19417":113709,"_25514":113710,"_2665":113711},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3170":66610,"_28022":66602,"_5":28341,"_19417":113713,"_25514":113714,"_2665":113715},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3170":66611,"_28022":66602,"_5":28341,"_19417":113717,"_25514":113718,"_2665":113719},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3170":66612,"_28022":66602,"_5":28341,"_19417":113721,"_25514":113722,"_2665":113723},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3170":66613,"_28022":66602,"_5":28341,"_19417":113725,"_25514":113726,"_2665":113727},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3170":66614,"_28022":66602,"_5":28341,"_19417":113729,"_25514":113730,"_2665":111359},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3170":66615,"_28022":66602,"_5":28341,"_19417":113732,"_25514":113733,"_2665":106713},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3170":66616,"_28022":66602,"_19417":113735,"_5":13306,"_25514":66602,"_2665":113736},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3170":66617,"_28022":66602,"_19417":113738,"_5":13306,"_25514":113691,"_2665":113739},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3170":66618,"_28022":66602,"_19417":113741,"_5":13306,"_25514":113691,"_2665":113742},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3170":66619,"_28022":66602,"_19417":113744,"_5":13306,"_25514":113691,"_2665":113745},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3170":66620,"_28022":66602,"_19417":113747,"_5":13306,"_25514":113691,"_2665":113748},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3170":66621,"_28022":66602,"_19417":113750,"_5":13306,"_25514":113691,"_2665":113751},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3170":66622,"_28022":66602,"_19417":113753,"_5":13306,"_25514":113694,"_2665":113754},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3170":66623,"_28022":66602,"_19417":113756,"_5":13306,"_25514":113698,"_2665":113757},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3170":66624,"_28022":66602,"_19417":113759,"_5":13306,"_25514":113698,"_2665":113760},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3170":66625,"_28022":66602,"_19417":113762,"_5":13306,"_25514":113702,"_2665":113763},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3170":66626,"_28022":66602,"_19417":113765,"_5":13306,"_25514":113702,"_2665":113766},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3170":66627,"_28022":66602,"_19417":113768,"_5":13306,"_25514":113706,"_2665":113769},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3170":66628,"_28022":66602,"_19417":113771,"_5":13306,"_25514":113706,"_2665":113772},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3170":66629,"_28022":66602,"_19417":113774,"_5":13306,"_25514":113710,"_2665":113775},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3170":66630,"_28022":66602,"_19417":113777,"_5":13306,"_25514":113714,"_2665":113778},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3170":66631,"_28022":66602,"_19417":113780,"_5":13306,"_25514":113718,"_2665":113781},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3170":66632,"_28022":66602,"_19417":113783,"_5":13306,"_25514":113722,"_2665":113784},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3170":66633,"_28022":66602,"_19417":113786,"_5":13306,"_25514":113722,"_2665":113787},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3170":66634,"_28022":66602,"_19417":113789,"_5":13306,"_25514":113722,"_2665":113790},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3170":66635,"_28022":66602,"_19417":113792,"_5":13306,"_25514":113726,"_2665":113793},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3170":66636,"_28022":66602,"_19417":113795,"_5":13306,"_25514":113726,"_2665":113796},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3170":66637,"_28022":66602,"_19417":113798,"_5":13306,"_25514":113726,"_2665":113799},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3170":66638,"_28022":66602,"_19417":113801,"_5":13306,"_25514":113730,"_2665":111442},[],{"_3170":66639,"_28022":66602,"_19417":113803,"_5":13306,"_25514":113730,"_2665":110209},[],{"_3170":66640,"_28022":66602,"_19417":113805,"_5":13306,"_25514":113730,"_2665":113806},[],"La CA rechaza la emisión",{"_3170":66641,"_28022":66602,"_19417":113808,"_5":13306,"_25514":113730,"_2665":113809},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3170":66642,"_28022":66602,"_19417":113811,"_5":13306,"_25514":113730,"_2665":113812},[],"Sujeto o usos diferentes",{"_3170":66643,"_28022":66602,"_19417":113814,"_5":13306,"_25514":113730,"_2665":113815},[],"Perfil aplicado y valores solicitados.",{"_3170":66644,"_28022":66602,"_19417":113817,"_5":13306,"_25514":113730,"_2665":113818},[],"No se encuentra el emisor",{"_3170":66645,"_28022":66602,"_19417":113820,"_5":13306,"_25514":113730,"_2665":113821},[],"CA descargada y cadena intermedia necesaria.",{"_3170":66646,"_28022":66602,"_19417":113823,"_5":13306,"_25514":113730,"_2665":113824},[],"Falla la vigencia",{"_3170":66647,"_28022":66602,"_19417":113826,"_5":13306,"_25514":113730,"_2665":113827},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3170":66648,"_28022":66602,"_19417":113829,"_5":13306,"_25514":113730,"_2665":113830},[],"Los resúmenes de clave difieren",{"_3170":66649,"_28022":66602,"_19417":113832,"_5":13306,"_25514":113730,"_2665":113833},[],"Archivos de certificado y clave de la misma emisión.",{"_3170":66650,"_28022":66602,"_19417":113835,"_5":13306,"_25514":113730,"_2665":113836},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3170":66651,"_28022":66602,"_19417":113838,"_5":13306,"_25514":113733,"_2665":113839},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3170":66652,"_28022":66602,"_19417":113841,"_5":13306,"_25514":113733,"_2665":113842},[],"Gestionar certificados para inspección, estado y revocación.",{"_3170":66653,"_28022":66602,"_19417":113844,"_5":13306,"_25514":113733,"_2665":113845},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3170":66654,"_28022":66602,"_19417":113847,"_5":13306,"_25514":113733,"_2665":113848},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3170":66655,"_28022":66602,"_19417":113850,"_5":13306,"_25514":113733,"_2665":113851},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3170":66656,"_28022":66656,"_5":13637,"_2665":113853,"_28344":113854,"_19417":113855,"_25514":66656},"Primeros pasos de PKI",[45406,108036,50532,111111],[],{"_3170":66657,"_28022":66656,"_19417":113857,"_5":13306,"_25514":66656,"_2665":113858},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3170":66658,"_28022":66656,"_5":28341,"_19417":113860,"_25514":113861,"_2665":106689},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3170":66659,"_28022":66656,"_5":28341,"_19417":113863,"_25514":113864,"_2665":113865},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3170":66660,"_28022":66656,"_5":28341,"_19417":113867,"_25514":113868,"_2665":111293},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3170":66661,"_28022":66656,"_5":28341,"_19417":113870,"_25514":113871,"_2665":113872},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3170":66662,"_28022":66656,"_19417":113874,"_5":13306,"_25514":66656,"_2665":113875},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3170":66663,"_28022":66656,"_19417":113877,"_5":13306,"_25514":113861,"_2665":113878},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3170":66664,"_28022":66656,"_19417":113880,"_5":13306,"_25514":113861,"_2665":113881},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3170":66665,"_28022":66656,"_19417":113883,"_5":13306,"_25514":113861,"_2665":113884},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3170":66666,"_28022":66656,"_19417":113886,"_5":13306,"_25514":113861,"_2665":113887},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3170":66667,"_28022":66656,"_19417":113889,"_5":13306,"_25514":113861,"_2665":113890},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3170":66668,"_28022":66656,"_19417":113892,"_5":13306,"_25514":113864,"_2665":113893},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3170":66669,"_28022":66656,"_19417":113895,"_5":13306,"_25514":113864,"_2665":113896},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3170":66670,"_28022":66656,"_19417":113898,"_5":13306,"_25514":113864,"_2665":113899},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3170":66671,"_28022":66656,"_19417":113901,"_5":13306,"_25514":113864,"_2665":113902},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3170":66672,"_28022":66656,"_19417":113904,"_5":13306,"_25514":113868,"_2665":113905},[],"Archivo o recurso",{"_3170":66673,"_28022":66656,"_19417":113907,"_5":13306,"_25514":113868,"_2665":111290},[],{"_3170":66674,"_28022":66656,"_19417":113909,"_5":13306,"_25514":113868,"_2665":113910},[],"CA raíz activa y `ca.pem`",{"_3170":66675,"_28022":66656,"_19417":113912,"_5":13306,"_25514":113868,"_2665":113913},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3170":66676,"_28022":66656,"_19417":113915,"_5":13306,"_25514":113868,"_2665":113916},[],"Certificado final y `device.crt`",{"_3170":66677,"_28022":66656,"_19417":113918,"_5":13306,"_25514":113868,"_2665":113919},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3170":66678,"_28022":66656,"_19417":113921,"_5":13306,"_25514":113868,"_2665":113922},[],"Clave privada `device.key`",{"_3170":66679,"_28022":66656,"_19417":113924,"_5":13306,"_25514":113868,"_2665":113925},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3170":66680,"_28022":66656,"_19417":113927,"_5":13306,"_25514":113868,"_2665":113928},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3170":66681,"_28022":66656,"_19417":113930,"_5":13306,"_25514":113871,"_2665":113931},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3170":66682,"_28022":66656,"_19417":113933,"_5":13306,"_25514":113871,"_2665":113934},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3170":66683,"_28022":66656,"_19417":113936,"_5":13306,"_25514":113871,"_2665":113937},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3170":66684,"_28022":66684,"_5":13637,"_2665":113939,"_28344":113940,"_19417":113942,"_25514":66684},"Resolución de problemas PKI",[45406,108036,50532,113941],"Resolución de problemas",[],{"_3170":66685,"_28022":66684,"_19417":113944,"_5":13306,"_25514":66684,"_2665":113945},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3170":66686,"_28022":66684,"_5":28341,"_19417":113947,"_25514":113948,"_2665":113949},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3170":66687,"_28022":66684,"_5":28341,"_19417":113951,"_25514":113952,"_2665":113953},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3170":66688,"_28022":66684,"_5":28341,"_19417":113955,"_25514":113956,"_2665":113957},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3170":66689,"_28022":66684,"_19417":113959,"_5":13306,"_25514":66684,"_2665":113960},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3170":66690,"_28022":66684,"_19417":113962,"_5":13306,"_25514":66684,"_2665":113963},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3170":66691,"_28022":66684,"_19417":113965,"_5":13306,"_25514":113948,"_2665":111290},[],{"_3170":66692,"_28022":66684,"_19417":113967,"_5":13306,"_25514":113948,"_2665":110209},[],{"_3170":66693,"_28022":66684,"_19417":113969,"_5":13306,"_25514":113948,"_2665":106713},[],{"_3170":66694,"_28022":66684,"_19417":113971,"_5":13306,"_25514":113948,"_2665":52871},[],{"_3170":66695,"_28022":66684,"_19417":113973,"_5":13306,"_25514":113948,"_2665":113974},[],"Existe, está activa y sus fechas son utilizables.",{"_3170":66696,"_28022":66684,"_19417":113976,"_5":13306,"_25514":113948,"_2665":113977},[],"Autoridades.",{"_3170":66697,"_28022":66684,"_19417":113979,"_5":13306,"_25514":113948,"_2665":113980},[],"Clave",{"_3170":66698,"_28022":66684,"_19417":113982,"_5":13306,"_25514":113948,"_2665":113983},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3170":66699,"_28022":66684,"_19417":113985,"_5":13306,"_25514":113948,"_2665":113986},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3170":66700,"_28022":66684,"_19417":113988,"_5":13306,"_25514":113948,"_2665":52889},[],{"_3170":66701,"_28022":66684,"_19417":113990,"_5":13306,"_25514":113948,"_2665":113991},[],"PEM correcto y firma verificable.",{"_3170":66702,"_28022":66684,"_19417":113993,"_5":13306,"_25514":113948,"_2665":52895},[],{"_3170":66703,"_28022":66684,"_19417":113995,"_5":13306,"_25514":113948,"_2665":113996},[],"Perfil",{"_3170":66704,"_28022":66684,"_19417":113998,"_5":13306,"_25514":113948,"_2665":113999},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3170":66705,"_28022":66684,"_19417":114001,"_5":13306,"_25514":113948,"_2665":114002},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3170":66706,"_28022":66684,"_19417":114004,"_5":13306,"_25514":113948,"_2665":111442},[],{"_3170":66707,"_28022":66684,"_19417":114006,"_5":13306,"_25514":113948,"_2665":114007},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3170":66708,"_28022":66684,"_19417":114009,"_5":13306,"_25514":113948,"_2665":114010},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3170":66709,"_28022":66684,"_19417":114012,"_5":13306,"_25514":113948,"_2665":114013},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3170":66710,"_28022":66684,"_19417":114015,"_5":13306,"_25514":113948,"_2665":114016},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3170":66711,"_28022":66684,"_19417":114018,"_5":13306,"_25514":113952,"_2665":114019},[],"Revisa cada frontera por separado:",{"_3170":66712,"_28022":66684,"_19417":114021,"_5":13306,"_25514":113952,"_2665":114022},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3170":66713,"_28022":66684,"_19417":114024,"_5":13306,"_25514":113952,"_2665":114025},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3170":66714,"_28022":66684,"_19417":114027,"_5":13306,"_25514":113952,"_2665":114028},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3170":66715,"_28022":66684,"_19417":114030,"_5":13306,"_25514":113952,"_2665":114031},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3170":66716,"_28022":66684,"_19417":114033,"_5":13306,"_25514":113952,"_2665":114034},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3170":66717,"_28022":66684,"_19417":114036,"_5":13306,"_25514":113952,"_2665":114037},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3170":66718,"_28022":66684,"_19417":114039,"_5":13306,"_25514":113956,"_2665":114040},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3170":66719,"_28022":66684,"_19417":114042,"_5":13306,"_25514":113956,"_2665":114043},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3170":66720,"_28022":66720,"_5":13637,"_2665":114045,"_28344":114046,"_19417":114048,"_25514":66720},"3.8.0 a 4.0.0",[45406,114047],"Actualizaciones",[],{"_3170":66721,"_28022":66720,"_19417":114050,"_5":13306,"_25514":66720,"_2665":114051},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3170":66722,"_28022":66720,"_5":28341,"_19417":114053,"_25514":114054,"_2665":114055},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3170":66723,"_28022":66720,"_5":28341,"_19417":114057,"_25514":114058,"_2665":114059},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3170":66724,"_28022":66720,"_5":28341,"_19417":114061,"_25514":114062,"_2665":114063},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3170":66725,"_28022":66720,"_5":28341,"_19417":114065,"_25514":114066,"_2665":114067},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3170":66726,"_28022":66720,"_5":28341,"_19417":114069,"_25514":114070,"_2665":114071},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3170":66727,"_28022":66720,"_5":28341,"_19417":114073,"_25514":114074,"_2665":114075},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3170":66728,"_28022":66720,"_5":28341,"_19417":114077,"_25514":114078,"_2665":52981},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3170":66729,"_28022":66720,"_5":28341,"_19417":114080,"_25514":114081,"_2665":114082},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3170":66730,"_28022":66720,"_5":28341,"_19417":114084,"_25514":114085,"_2665":114086},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3170":66731,"_28022":66720,"_5":28341,"_19417":114088,"_25514":114089,"_2665":114090},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3170":66732,"_28022":66720,"_5":28341,"_19417":114092,"_25514":114093,"_2665":114094},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3170":66733,"_28022":66720,"_5":28341,"_19417":114096,"_25514":114097,"_2665":114098},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3170":66734,"_28022":66720,"_5":28341,"_19417":114100,"_25514":114101,"_2665":114102},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3170":66735,"_28022":66720,"_5":28341,"_19417":114104,"_25514":114105,"_2665":114106},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3170":66736,"_28022":66720,"_5":28341,"_19417":114108,"_25514":114109,"_2665":114110},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3170":66737,"_28022":66720,"_5":28341,"_19417":114112,"_25514":114113,"_2665":114114},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3170":66738,"_28022":66720,"_5":28341,"_19417":114116,"_25514":114117,"_2665":114118},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3170":66739,"_28022":66720,"_5":28341,"_19417":114120,"_25514":114121,"_2665":114122},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3170":66740,"_28022":66720,"_5":28341,"_19417":114124,"_25514":114125,"_2665":114126},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3170":66741,"_28022":66720,"_5":28341,"_19417":114128,"_25514":114129,"_2665":114130},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3170":66742,"_28022":66720,"_5":28341,"_19417":114132,"_25514":114133,"_2665":114134},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3170":66743,"_28022":66720,"_5":28341,"_19417":114136,"_25514":114137,"_2665":114138},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3170":66744,"_28022":66720,"_5":28341,"_19417":114140,"_25514":114141,"_2665":114142},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3170":66745,"_28022":66720,"_5":28341,"_19417":114144,"_25514":114145,"_2665":114146},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3170":66746,"_28022":66720,"_5":28341,"_19417":114148,"_25514":114149,"_2665":114150},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3170":66747,"_28022":66720,"_5":28341,"_19417":114152,"_25514":114153,"_2665":114154},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3170":66748,"_28022":66720,"_5":28341,"_19417":114156,"_25514":114157,"_2665":114158},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3170":66749,"_28022":66720,"_5":28341,"_19417":114160,"_25514":114161,"_2665":114162},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3170":66750,"_28022":66720,"_5":28341,"_19417":114164,"_25514":114165,"_2665":114166},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3170":66751,"_28022":66720,"_5":28341,"_19417":114168,"_25514":114169,"_2665":114170},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3170":66752,"_28022":66720,"_5":28341,"_19417":114172,"_25514":114173,"_2665":114174},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3170":66753,"_28022":66720,"_5":28341,"_19417":114176,"_25514":114177,"_2665":114178},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3170":66754,"_28022":66720,"_5":28341,"_19417":114180,"_25514":114181,"_2665":114182},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3170":66755,"_28022":66720,"_5":28341,"_19417":114184,"_25514":114185,"_2665":110531},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3170":66756,"_28022":66720,"_5":28341,"_19417":114187,"_25514":114188,"_2665":114189},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3170":66757,"_28022":66720,"_5":28341,"_19417":114191,"_25514":114192,"_2665":114193},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3170":66758,"_28022":66720,"_19417":114195,"_5":13306,"_25514":66720,"_2665":114196},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3170":66759,"_28022":66720,"_19417":114198,"_5":13306,"_25514":66720,"_2665":114199},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3170":66760,"_28022":66720,"_19417":114201,"_5":13306,"_25514":66720,"_2665":114202},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3170":66761,"_28022":66720,"_19417":114204,"_5":13306,"_25514":66720,"_2665":114205},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3170":66762,"_28022":66720,"_19417":114207,"_5":13306,"_25514":66720,"_2665":114208},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3170":66763,"_28022":66720,"_19417":114210,"_5":13306,"_25514":66720,"_2665":114211},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3170":66764,"_28022":66720,"_19417":114213,"_5":13306,"_25514":66720,"_2665":114214},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3170":66765,"_28022":66720,"_19417":114216,"_5":13306,"_25514":114058,"_2665":114217},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3170":66766,"_28022":66720,"_19417":114219,"_5":13306,"_25514":114058,"_2665":114220},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3170":66767,"_28022":66720,"_19417":114222,"_5":13306,"_25514":114062,"_2665":114223},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3170":66768,"_28022":66720,"_19417":114225,"_5":13306,"_25514":114062,"_2665":114226},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3170":66769,"_28022":66720,"_19417":114228,"_5":13306,"_25514":114066,"_2665":114229},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3170":66770,"_28022":66720,"_19417":114231,"_5":13306,"_25514":114070,"_2665":114232},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3170":66771,"_28022":66720,"_19417":114234,"_5":13306,"_25514":114070,"_2665":114235},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3170":66772,"_28022":66720,"_19417":114237,"_5":13306,"_25514":114070,"_2665":114238},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3170":66773,"_28022":66720,"_19417":114240,"_5":13306,"_25514":114070,"_2665":114241},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3170":66774,"_28022":66720,"_19417":114243,"_5":13306,"_25514":114070,"_2665":114244},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3170":66775,"_28022":66720,"_19417":114246,"_5":13306,"_25514":114074,"_2665":114247},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3170":66776,"_28022":66720,"_19417":114249,"_5":13306,"_25514":114074,"_2665":114250},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3170":66777,"_28022":66720,"_19417":114252,"_5":13306,"_25514":114074,"_2665":114253},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3170":66778,"_28022":66720,"_19417":114255,"_5":13306,"_25514":114074,"_2665":114256},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3170":66779,"_28022":66720,"_19417":114258,"_5":13306,"_25514":114074,"_2665":114259},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3170":66780,"_28022":66720,"_19417":114261,"_5":13306,"_25514":114078,"_2665":114262},[],"Cambio",{"_3170":66781,"_28022":66720,"_19417":114264,"_5":13306,"_25514":114078,"_2665":114265},[],"A quién afecta",{"_3170":66782,"_28022":66720,"_19417":114267,"_5":13306,"_25514":114078,"_2665":114268},[],"Gravedad",{"_3170":66783,"_28022":66720,"_19417":114270,"_5":13306,"_25514":114078,"_2665":114271},[],"Acción",{"_3170":66784,"_28022":66720,"_19417":114273,"_5":13306,"_25514":114078,"_2665":114086},[],{"_3170":66785,"_28022":66720,"_19417":114275,"_5":13306,"_25514":114078,"_2665":114276},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3170":66786,"_28022":66720,"_19417":114278,"_5":13306,"_25514":114078,"_2665":114279},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3170":66787,"_28022":66720,"_19417":114281,"_5":13306,"_25514":114078,"_2665":114282},[],"Copiar los datos a los volúmenes nuevos",{"_3170":66788,"_28022":66720,"_19417":114284,"_5":13306,"_25514":114078,"_2665":114090},[],{"_3170":66789,"_28022":66720,"_19417":114286,"_5":13306,"_25514":114078,"_2665":114287},[],"Todas las releases de Helm",{"_3170":66790,"_28022":66720,"_19417":114289,"_5":13306,"_25514":114078,"_2665":114290},[],"Alta: `helm upgrade` falla",{"_3170":66791,"_28022":66720,"_19417":114292,"_5":13306,"_25514":114078,"_2665":114293},[],"Eliminar o renombrar las claves heredadas",{"_3170":66792,"_28022":66720,"_19417":114295,"_5":13306,"_25514":114078,"_2665":114094},[],{"_3170":66793,"_28022":66720,"_19417":114297,"_5":13306,"_25514":114078,"_2665":114298},[],"Todos los despliegues",{"_3170":66794,"_28022":66720,"_19417":114300,"_5":13306,"_25514":114078,"_2665":114301},[],"Alta: sin principal de bootstrap no hay administrador",{"_3170":66795,"_28022":66720,"_19417":114303,"_5":13306,"_25514":114078,"_2665":114304},[],"Configurar `services.authz`",{"_3170":66796,"_28022":66720,"_19417":114306,"_5":13306,"_25514":114078,"_2665":114098},[],{"_3170":66797,"_28022":66720,"_19417":114308,"_5":13306,"_25514":114078,"_2665":114287},[],{"_3170":66798,"_28022":66720,"_19417":114310,"_5":13306,"_25514":114078,"_2665":114311},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3170":66799,"_28022":66720,"_19417":114313,"_5":13306,"_25514":114078,"_2665":114314},[],"Mover JWKS y roles a `services.authz`",{"_3170":66800,"_28022":66720,"_19417":114316,"_5":13306,"_25514":114078,"_2665":114118},[],{"_3170":66801,"_28022":66720,"_19417":114318,"_5":13306,"_25514":114078,"_2665":114319},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3170":66802,"_28022":66720,"_19417":114321,"_5":13306,"_25514":114078,"_2665":114322},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3170":66803,"_28022":66720,"_19417":114324,"_5":13306,"_25514":114078,"_2665":114325},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3170":66804,"_28022":66720,"_19417":114327,"_5":13306,"_25514":114078,"_2665":114122},[],{"_3170":66805,"_28022":66720,"_19417":114329,"_5":13306,"_25514":114078,"_2665":114330},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3170":66806,"_28022":66720,"_19417":114332,"_5":13306,"_25514":114078,"_2665":114333},[],"Alta: el backend ya no arranca con ellos",{"_3170":66807,"_28022":66720,"_19417":114335,"_5":13306,"_25514":114078,"_2665":114336},[],"Pasar a PostgreSQL antes de actualizar",{"_3170":66808,"_28022":66720,"_19417":114338,"_5":13306,"_25514":114078,"_2665":114339},[],"Webhooks con referencias a archivos",{"_3170":66809,"_28022":66720,"_19417":114341,"_5":13306,"_25514":114078,"_2665":114342},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3170":66810,"_28022":66720,"_19417":114344,"_5":13306,"_25514":114078,"_2665":114345},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3170":66811,"_28022":66720,"_19417":114347,"_5":13306,"_25514":114078,"_2665":114348},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3170":66812,"_28022":66720,"_19417":114350,"_5":13306,"_25514":114078,"_2665":114102},[],{"_3170":66813,"_28022":66720,"_19417":114352,"_5":13306,"_25514":114078,"_2665":114353},[],"Releases con identidades por servicio o material de claves montado",{"_3170":66814,"_28022":66720,"_19417":114355,"_5":13306,"_25514":114078,"_2665":114356},[],"Media: los servicios no pueden leer sus archivos",{"_3170":66815,"_28022":66720,"_19417":114358,"_5":13306,"_25514":114078,"_2665":114359},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3170":66816,"_28022":66720,"_19417":114361,"_5":13306,"_25514":114078,"_2665":114106},[],{"_3170":66817,"_28022":66720,"_19417":114363,"_5":13306,"_25514":114078,"_2665":114364},[],"Releases que definen `amqp.tls`",{"_3170":66818,"_28022":66720,"_19417":114366,"_5":13306,"_25514":114078,"_2665":114367},[],"Media: los clientes se conectan al puerto equivocado",{"_3170":66819,"_28022":66720,"_19417":114369,"_5":13306,"_25514":114078,"_2665":114370},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3170":66820,"_28022":66720,"_19417":114372,"_5":13306,"_25514":114078,"_2665":114126},[],{"_3170":66821,"_28022":66720,"_19417":114374,"_5":13306,"_25514":114078,"_2665":114375},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3170":66822,"_28022":66720,"_19417":114377,"_5":13306,"_25514":114078,"_2665":114378},[],"Media: las claves de CA quedan sin gestionar",{"_3170":66823,"_28022":66720,"_19417":114380,"_5":13306,"_25514":114078,"_2665":114381},[],"Ejecutar la migración de CA a KMS",{"_3170":66824,"_28022":66720,"_19417":114383,"_5":13306,"_25514":114078,"_2665":114384},[],"Verificación del certificado del receptor",{"_3170":66825,"_28022":66720,"_19417":114386,"_5":13306,"_25514":114078,"_2665":114387},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3170":66826,"_28022":66720,"_19417":114389,"_5":13306,"_25514":114078,"_2665":114390},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3170":66827,"_28022":66720,"_19417":114392,"_5":13306,"_25514":114078,"_2665":114393},[],"Poner `insecure_skip_verify` a `false`",{"_3170":66828,"_28022":66720,"_19417":114395,"_5":13306,"_25514":114078,"_2665":114138},[],{"_3170":66829,"_28022":66720,"_19417":114397,"_5":13306,"_25514":114078,"_2665":114398},[],"Scripts y consolas que editan DMS por API",{"_3170":66830,"_28022":66720,"_19417":114400,"_5":13306,"_25514":114078,"_2665":114401},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3170":66831,"_28022":66720,"_19417":114403,"_5":13306,"_25514":114078,"_2665":114404},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3170":66832,"_28022":66720,"_19417":114406,"_5":13306,"_25514":114078,"_2665":114154},[],{"_3170":66833,"_28022":66720,"_19417":114408,"_5":13306,"_25514":114078,"_2665":114409},[],"Consumidores que leen el campo `events` del dispositivo",{"_3170":66834,"_28022":66720,"_19417":114411,"_5":13306,"_25514":114078,"_2665":114412},[],"Media: el campo desaparece",{"_3170":66835,"_28022":66720,"_19417":114414,"_5":13306,"_25514":114078,"_2665":114415},[],"Usar los nuevos endpoints de eventos",{"_3170":66836,"_28022":66720,"_19417":114417,"_5":13306,"_25514":114078,"_2665":114110},[],{"_3170":66837,"_28022":66720,"_19417":114419,"_5":13306,"_25514":114078,"_2665":114420},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3170":66838,"_28022":66720,"_19417":114422,"_5":13306,"_25514":114078,"_2665":114423},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3170":66839,"_28022":66720,"_19417":114425,"_5":13306,"_25514":114078,"_2665":114426},[],"Actualizar el archivo de values",{"_3170":66840,"_28022":66720,"_19417":114428,"_5":13306,"_25514":114078,"_2665":114146},[],{"_3170":66841,"_28022":66720,"_19417":114430,"_5":13306,"_25514":114078,"_2665":114431},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3170":66842,"_28022":66720,"_19417":114433,"_5":13306,"_25514":114078,"_2665":114434},[],"Baja: prevalece el ID de la URL",{"_3170":66843,"_28022":66720,"_19417":114436,"_5":13306,"_25514":114078,"_2665":114437},[],"Enviar el ID en la URL",{"_3170":66844,"_28022":66720,"_19417":114439,"_5":13306,"_25514":114078,"_2665":114150},[],{"_3170":66845,"_28022":66720,"_19417":114441,"_5":13306,"_25514":114078,"_2665":114442},[],"Consumidores que comparan el `type` del certificado",{"_3170":66846,"_28022":66720,"_19417":114444,"_5":13306,"_25514":114078,"_2665":114445},[],"Baja: dos valores cambian de nombre",{"_3170":66847,"_28022":66720,"_19417":114447,"_5":13306,"_25514":114078,"_2665":114448},[],"Adaptar los consumidores",{"_3170":66848,"_28022":66720,"_19417":114450,"_5":13306,"_25514":114078,"_2665":114142},[],{"_3170":66849,"_28022":66720,"_19417":114452,"_5":13306,"_25514":114078,"_2665":114453},[],"Cualquier DMS",{"_3170":66850,"_28022":66720,"_19417":114455,"_5":13306,"_25514":114078,"_2665":114456},[],"Baja: solo informativo",{"_3170":66851,"_28022":66720,"_19417":114458,"_5":13306,"_25514":114078,"_2665":114459},[],"Revisar ambos bloques antes de editar",{"_3170":66852,"_28022":66720,"_19417":114461,"_5":13306,"_25514":114085,"_2665":114462},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3170":66853,"_28022":66720,"_19417":114464,"_5":13306,"_25514":114085,"_2665":114465},[],"El paso 4 de la guía de migración copia los datos.",{"_3170":66854,"_28022":66720,"_19417":114467,"_5":13306,"_25514":114089,"_2665":114468},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3170":66855,"_28022":66720,"_19417":114470,"_5":13306,"_25514":114093,"_2665":114471},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3170":66856,"_28022":66720,"_19417":114473,"_5":13306,"_25514":114097,"_2665":114474},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3170":66857,"_28022":66720,"_19417":114476,"_5":13306,"_25514":114101,"_2665":114477},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3170":66858,"_28022":66720,"_19417":114479,"_5":13306,"_25514":114101,"_2665":114480},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3170":66859,"_28022":66720,"_19417":114482,"_5":13306,"_25514":114105,"_2665":114483},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3170":66860,"_28022":66720,"_19417":114485,"_5":13306,"_25514":114109,"_2665":114486},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3170":66861,"_28022":66720,"_19417":114488,"_5":13306,"_25514":114109,"_2665":114489},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3170":66862,"_28022":66720,"_19417":114491,"_5":13306,"_25514":114109,"_2665":114492},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3170":66863,"_28022":66720,"_19417":114494,"_5":13306,"_25514":114109,"_2665":114495},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3170":66864,"_28022":66720,"_19417":114497,"_5":13306,"_25514":114109,"_2665":114498},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3170":66865,"_28022":66720,"_19417":114500,"_5":13306,"_25514":114109,"_2665":114501},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3170":66866,"_28022":66720,"_19417":114503,"_5":13306,"_25514":114117,"_2665":114504},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3170":66867,"_28022":66720,"_19417":114506,"_5":13306,"_25514":114117,"_2665":114507},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3170":66868,"_28022":66720,"_19417":114509,"_5":13306,"_25514":114117,"_2665":114510},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3170":66869,"_28022":66720,"_19417":114512,"_5":13306,"_25514":114117,"_2665":114513},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3170":66870,"_28022":66720,"_19417":114515,"_5":13306,"_25514":114117,"_2665":114516},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3170":66871,"_28022":66720,"_19417":114518,"_5":13306,"_25514":114121,"_2665":114519},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3170":66872,"_28022":66720,"_19417":114521,"_5":13306,"_25514":114125,"_2665":114522},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3170":66873,"_28022":66720,"_19417":114524,"_5":13306,"_25514":114125,"_2665":114525},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3170":66874,"_28022":66720,"_19417":114527,"_5":13306,"_25514":114125,"_2665":114528},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3170":66875,"_28022":66720,"_19417":114530,"_5":13306,"_25514":114125,"_2665":114531},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3170":66876,"_28022":66720,"_19417":114533,"_5":13306,"_25514":114125,"_2665":114534},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3170":66877,"_28022":66720,"_19417":114536,"_5":13306,"_25514":114125,"_2665":114537},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3170":66878,"_28022":66720,"_19417":114539,"_5":13306,"_25514":114133,"_2665":114540},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3170":66879,"_28022":66720,"_19417":114542,"_5":13306,"_25514":114133,"_2665":114543},[],"Campo en 3.8.0",{"_3170":66880,"_28022":66720,"_19417":114545,"_5":13306,"_25514":114133,"_2665":114546},[],"Campo en 4.0.0",{"_3170":66881,"_28022":66720,"_19417":114548,"_5":13306,"_25514":114133,"_2665":53452},[],{"_3170":66882,"_28022":66720,"_19417":114550,"_5":13306,"_25514":114133,"_2665":114551},[],"`insecure_skip_verify` (con el valor negado)",{"_3170":66883,"_28022":66720,"_19417":114553,"_5":13306,"_25514":114133,"_2665":53458},[],{"_3170":66884,"_28022":66720,"_19417":114555,"_5":13306,"_25514":114133,"_2665":53461},[],{"_3170":66885,"_28022":66720,"_19417":114557,"_5":13306,"_25514":114133,"_2665":53464},[],{"_3170":66886,"_28022":66720,"_19417":114559,"_5":13306,"_25514":114133,"_2665":53467},[],{"_3170":66887,"_28022":66720,"_19417":114561,"_5":13306,"_25514":114133,"_2665":53470},[],{"_3170":66888,"_28022":66720,"_19417":114563,"_5":13306,"_25514":114133,"_2665":53473},[],{"_3170":66889,"_28022":66720,"_19417":114565,"_5":13306,"_25514":114133,"_2665":114566},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3170":66890,"_28022":66720,"_19417":114568,"_5":13306,"_25514":114133,"_2665":114569},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3170":66891,"_28022":66720,"_19417":114571,"_5":13306,"_25514":114133,"_2665":114572},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3170":66892,"_28022":66720,"_19417":114574,"_5":13306,"_25514":114137,"_2665":114575},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3170":66893,"_28022":66720,"_19417":114577,"_5":13306,"_25514":114137,"_2665":114578},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3170":66894,"_28022":66720,"_19417":114580,"_5":13306,"_25514":114137,"_2665":114581},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3170":66895,"_28022":66720,"_19417":114583,"_5":13306,"_25514":114141,"_2665":114584},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3170":66896,"_28022":66720,"_19417":114586,"_5":13306,"_25514":114145,"_2665":114587},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3170":66897,"_28022":66720,"_19417":114589,"_5":13306,"_25514":114149,"_2665":114590},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3170":66898,"_28022":66720,"_19417":114592,"_5":13306,"_25514":114153,"_2665":114593},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3170":66899,"_28022":66720,"_19417":114595,"_5":13306,"_25514":114153,"_2665":114596},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3170":66900,"_28022":66720,"_19417":114598,"_5":13306,"_25514":114153,"_2665":114599},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3170":66901,"_28022":66720,"_19417":114601,"_5":13306,"_25514":114153,"_2665":114602},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3170":66902,"_28022":66720,"_19417":114604,"_5":13306,"_25514":114157,"_2665":114605},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3170":66903,"_28022":66720,"_19417":114607,"_5":13306,"_25514":114161,"_2665":114608},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3170":66904,"_28022":66720,"_19417":114610,"_5":13306,"_25514":114161,"_2665":114611},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3170":66905,"_28022":66720,"_19417":114613,"_5":13306,"_25514":114161,"_2665":114614},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3170":66906,"_28022":66720,"_19417":114616,"_5":13306,"_25514":114161,"_2665":114617},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3170":66907,"_28022":66720,"_19417":114619,"_5":13306,"_25514":114161,"_2665":114620},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3170":66908,"_28022":66720,"_19417":114622,"_5":13306,"_25514":114165,"_2665":114623},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3170":66909,"_28022":66720,"_19417":114625,"_5":13306,"_25514":114165,"_2665":114626},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3170":66910,"_28022":66720,"_19417":114628,"_5":13306,"_25514":114165,"_2665":114629},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3170":66911,"_28022":66720,"_19417":114631,"_5":13306,"_25514":114165,"_2665":114632},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3170":66912,"_28022":66720,"_19417":114634,"_5":13306,"_25514":114165,"_2665":114635},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3170":66913,"_28022":66720,"_19417":114637,"_5":13306,"_25514":114165,"_2665":114638},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3170":66914,"_28022":66720,"_19417":114640,"_5":13306,"_25514":114165,"_2665":114641},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3170":66915,"_28022":66720,"_19417":114643,"_5":13306,"_25514":114165,"_2665":114644},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3170":66916,"_28022":66720,"_19417":114646,"_5":13306,"_25514":114165,"_2665":114647},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3170":66917,"_28022":66720,"_19417":114649,"_5":13306,"_25514":114165,"_2665":114650},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3170":66918,"_28022":66720,"_19417":114652,"_5":13306,"_25514":114165,"_2665":114653},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3170":66919,"_28022":66720,"_19417":114655,"_5":13306,"_25514":114165,"_2665":114656},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3170":66920,"_28022":66720,"_19417":114658,"_5":13306,"_25514":114169,"_2665":114659},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3170":66921,"_28022":66720,"_19417":114661,"_5":13306,"_25514":114169,"_2665":114662},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3170":66922,"_28022":66720,"_19417":114664,"_5":13306,"_25514":114173,"_2665":114665},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3170":66923,"_28022":66720,"_19417":114667,"_5":13306,"_25514":114173,"_2665":114668},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3170":66924,"_28022":66720,"_19417":114670,"_5":13306,"_25514":114173,"_2665":114671},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3170":66925,"_28022":66720,"_19417":114673,"_5":13306,"_25514":114173,"_2665":114674},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3170":66926,"_28022":66720,"_19417":114676,"_5":13306,"_25514":114173,"_2665":114677},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3170":66927,"_28022":66720,"_19417":114679,"_5":13306,"_25514":114173,"_2665":114680},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3170":66928,"_28022":66720,"_19417":114682,"_5":13306,"_25514":114173,"_2665":114683},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3170":66929,"_28022":66720,"_19417":114685,"_5":13306,"_25514":114173,"_2665":114686},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3170":66930,"_28022":66720,"_19417":114688,"_5":13306,"_25514":114173,"_2665":114689},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3170":66931,"_28022":66720,"_19417":114691,"_5":13306,"_25514":114173,"_2665":114692},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3170":66932,"_28022":66720,"_19417":114694,"_5":13306,"_25514":114173,"_2665":114695},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3170":66933,"_28022":66720,"_19417":114697,"_5":13306,"_25514":114177,"_2665":114698},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3170":66934,"_28022":66720,"_19417":114700,"_5":13306,"_25514":114177,"_2665":114701},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3170":66935,"_28022":66720,"_19417":114703,"_5":13306,"_25514":114181,"_2665":114704},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3170":66936,"_28022":66720,"_19417":114706,"_5":13306,"_25514":114181,"_2665":114707},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3170":66937,"_28022":66720,"_19417":114709,"_5":13306,"_25514":114181,"_2665":114710},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3170":66938,"_28022":66720,"_19417":114712,"_5":13306,"_25514":114181,"_2665":114713},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3170":66939,"_28022":66720,"_19417":114715,"_5":13306,"_25514":114181,"_2665":114716},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3170":66940,"_28022":66720,"_19417":114718,"_5":13306,"_25514":114185,"_2665":114719},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3170":66941,"_28022":66720,"_19417":114721,"_5":13306,"_25514":114185,"_2665":114722},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3170":66942,"_28022":66720,"_19417":114724,"_5":13306,"_25514":114185,"_2665":114725},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3170":66943,"_28022":66720,"_19417":114727,"_5":13306,"_25514":114185,"_2665":114728},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3170":66944,"_28022":66720,"_19417":114730,"_5":13306,"_25514":114185,"_2665":114731},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3170":66945,"_28022":66720,"_19417":114733,"_5":13306,"_25514":114185,"_2665":114734},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3170":66946,"_28022":66720,"_19417":114736,"_5":13306,"_25514":114185,"_2665":114737},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3170":66947,"_28022":66720,"_19417":114739,"_5":13306,"_25514":114188,"_2665":114740},[],"Tras la actualización, comprueba en este orden:",{"_3170":66948,"_28022":66720,"_19417":114742,"_5":13306,"_25514":114188,"_2665":114743},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3170":66949,"_28022":66720,"_19417":114745,"_5":13306,"_25514":114188,"_2665":114746},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3170":66950,"_28022":66720,"_19417":114748,"_5":13306,"_25514":114188,"_2665":114749},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3170":66951,"_28022":66720,"_19417":114751,"_5":13306,"_25514":114188,"_2665":114752},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3170":66952,"_28022":66720,"_19417":114754,"_5":13306,"_25514":114188,"_2665":114755},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3170":66953,"_28022":66720,"_19417":114757,"_5":13306,"_25514":114188,"_2665":114758},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3170":66954,"_28022":66720,"_19417":114760,"_5":13306,"_25514":114188,"_2665":114761},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3170":66955,"_28022":66720,"_19417":114763,"_5":13306,"_25514":114188,"_2665":114764},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3170":66956,"_28022":66720,"_19417":114766,"_5":13306,"_25514":114188,"_2665":114767},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3170":66957,"_28022":66720,"_19417":114769,"_5":13306,"_25514":114188,"_2665":114770},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3170":66958,"_28022":66720,"_19417":114772,"_5":13306,"_25514":114188,"_2665":114773},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3170":66959,"_28022":66720,"_19417":114775,"_5":13306,"_25514":114188,"_2665":114776},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3170":66960,"_28022":66720,"_19417":114778,"_5":13306,"_25514":114188,"_2665":114779},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3170":66961,"_28022":66720,"_19417":114781,"_5":13306,"_25514":114188,"_2665":114782},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3170":66962,"_28022":66720,"_19417":114784,"_5":13306,"_25514":114192,"_2665":114785},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3170":66963,"_28022":66720,"_19417":114787,"_5":13306,"_25514":114192,"_2665":114788},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3170":66964,"_28022":66720,"_19417":114790,"_5":13306,"_25514":114192,"_2665":114791},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3170":66965,"_28022":66720,"_19417":114793,"_5":13306,"_25514":114192,"_2665":114794},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3170":66966,"_28022":66720,"_19417":114796,"_5":13306,"_25514":114192,"_2665":114797},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_53710":114799,"_53712":114800,"_53714":114801,"_53716":114802,"_16910":2687,"_64315":2687},"spanish",[2665,28022,5,25514],{"_2665":23219,"_28022":23219,"_5":23219,"_25514":23219},{"_2665":114803,"_28022":117451,"_5":120099,"_25514":122747},{"_4261":114804,"_53720":114805,"_5":23219},{"_13361":3389,"_13736":6357,"_13755":5439,"_11980":6616,"_13742":9994,"_18428":6005,"_13382":5482,"_13389":10458,"_27066":6413,"_27457":2847,"_27478":5343,"_27084":5685,"_32116":2776,"_27489":23869,"_27518":2714,"_32123":3280,"_32126":3838,"_32129":4378,"_32132":5679,"_27864":3039,"_32137":5646,"_32139":5328,"_27894":2985,"_13751":3414,"_32143":14624,"_32146":3903,"_32148":4373,"_27507":2875,"_27859":7647,"_27907":5562,"_32153":5619,"_32155":9828,"_32157":6448,"_32159":3307,"_32161":5098,"_32163":3715,"_32165":4264,"_32167":5996,"_32169":4345,"_27136":3464,"_32172":2997,"_32174":6372,"_27130":19545,"_32177":14600,"_32179":8294,"_32181":6522,"_32184":5908,"_27176":15516,"_32188":7027,"_27057":2946,"_32191":3369,