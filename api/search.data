:16,"_27660":15,"_19192":44943,"_5":13195,"_26170":15,"_2648":44944},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3150":17,"_27660":15,"_5":27979,"_19192":44946,"_26170":44947,"_2648":44948},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3150":18,"_27660":15,"_5":27979,"_19192":44950,"_26170":44951,"_2648":44952},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3150":19,"_27660":15,"_5":27979,"_19192":44954,"_26170":44955,"_2648":44956},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3150":20,"_27660":15,"_5":27979,"_19192":44958,"_26170":44959,"_2648":44960},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3150":21,"_27660":15,"_5":27979,"_19192":44962,"_26170":44963,"_2648":44964},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3150":22,"_27660":15,"_5":27979,"_19192":44966,"_26170":44967,"_2648":44968},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3150":23,"_27660":15,"_5":27979,"_19192":44970,"_26170":44971,"_2648":44972},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3150":24,"_27660":15,"_19192":44974,"_5":13195,"_26170":15,"_2648":44975},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3150":25,"_27660":15,"_19192":44977,"_5":13195,"_26170":44947,"_2648":44978},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3150":26,"_27660":15,"_19192":44980,"_5":13195,"_26170":44947,"_2648":44981},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3150":27,"_27660":15,"_19192":44983,"_5":13195,"_26170":44947,"_2648":44984},[],"A security group allowing the necessary endpoints.",{"_3150":28,"_27660":15,"_19192":44986,"_5":13195,"_26170":44951,"_2648":44987},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3150":29,"_27660":15,"_19192":44989,"_5":13195,"_26170":44951,"_2648":44990},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3150":30,"_27660":15,"_19192":44992,"_5":13195,"_26170":44951,"_2648":44993},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3150":31,"_27660":15,"_19192":44995,"_5":13195,"_26170":44955,"_2648":44996},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3150":32,"_27660":15,"_19192":44998,"_5":13195,"_26170":44959,"_2648":44999},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3150":33,"_27660":15,"_19192":45001,"_5":13195,"_26170":44963,"_2648":45002},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3150":34,"_27660":15,"_19192":45004,"_5":13195,"_26170":44967,"_2648":45005},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3150":35,"_27660":15,"_19192":45007,"_5":13195,"_26170":44971,"_2648":45008},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3150":36,"_27660":36,"_5":13521,"_2648":45010,"_27982":45011,"_19192":45012,"_26170":36},"Deploy Lamassu",[44938,44939],[],{"_3150":37,"_27660":36,"_19192":45014,"_5":13195,"_26170":36,"_2648":45015},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3150":38,"_27660":36,"_5":27979,"_19192":45017,"_26170":45018,"_2648":45019},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3150":39,"_27660":36,"_5":27979,"_19192":45021,"_26170":45022,"_2648":45023},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3150":40,"_27660":36,"_5":27979,"_19192":45025,"_26170":45026,"_2648":45027},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3150":41,"_27660":36,"_19192":45029,"_5":13195,"_26170":36,"_2648":45030},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3150":42,"_27660":36,"_19192":45032,"_5":13195,"_26170":45018,"_2648":45033},[],"Model",{"_3150":43,"_27660":36,"_19192":45035,"_5":13195,"_26170":45018,"_2648":45036},[],"Recommended for",{"_3150":44,"_27660":36,"_19192":45038,"_5":13195,"_26170":45018,"_2648":45039},[],"Who operates the infrastructure",{"_3150":45,"_27660":36,"_19192":45041,"_5":13195,"_26170":45018,"_2648":45042},[],"Starting point",{"_3150":46,"_27660":36,"_19192":45044,"_5":13195,"_26170":45018,"_2648":45045},[],"Kubernetes self-managed",{"_3150":47,"_27660":36,"_19192":45047,"_5":13195,"_26170":45018,"_2648":45048},[],"Production, regulated environments and custom deployments",{"_3150":48,"_27660":36,"_19192":45050,"_5":13195,"_26170":45018,"_2648":45051},[],"Your team",{"_3150":49,"_27660":36,"_19192":45053,"_5":13195,"_26170":45018,"_2648":45054},[],"Helm or Fastlane",{"_3150":50,"_27660":36,"_19192":45056,"_5":13195,"_26170":45018,"_2648":45057},[],"AWS Marketplace",{"_3150":51,"_27660":36,"_19192":45059,"_5":13195,"_26170":45018,"_2648":45060},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3150":52,"_27660":36,"_19192":45062,"_5":13195,"_26170":45018,"_2648":45051},[],{"_3150":53,"_27660":36,"_19192":45064,"_5":13195,"_26170":45018,"_2648":45065},[],"Preconfigured image on EC2",{"_3150":54,"_27660":36,"_19192":45067,"_5":13195,"_26170":45018,"_2648":45068},[],"SaaS",{"_3150":55,"_27660":36,"_19192":45070,"_5":13195,"_26170":45018,"_2648":45071},[],"Teams that want to use the platform without operating it",{"_3150":56,"_27660":36,"_19192":45073,"_5":13195,"_26170":45018,"_2648":45074},[],"Lamassu",{"_3150":57,"_27660":36,"_19192":45076,"_5":13195,"_26170":45018,"_2648":45077},[],"Managed subscription",{"_3150":58,"_27660":36,"_19192":45079,"_5":13195,"_26170":45018,"_2648":45080},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3150":59,"_27660":36,"_19192":45082,"_5":13195,"_26170":45018,"_2648":45083},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3150":60,"_27660":36,"_19192":45085,"_5":13195,"_26170":45018,"_2648":45086},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3150":61,"_27660":36,"_19192":45088,"_5":13195,"_26170":45022,"_2648":45089},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3150":62,"_27660":36,"_19192":45091,"_5":13195,"_26170":45026,"_2648":45092},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3150":63,"_27660":63,"_5":13521,"_2648":45094,"_27982":45095,"_19192":45096,"_26170":63},"Use Lamassu as SaaS",[44938,44939,44940],[],{"_3150":64,"_27660":63,"_19192":45098,"_5":13195,"_26170":63,"_2648":45099},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3150":65,"_27660":63,"_5":27979,"_19192":45101,"_26170":45102,"_2648":45103},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3150":66,"_27660":63,"_5":27979,"_19192":45105,"_26170":45106,"_2648":45107},[],"/docs/deployment/saas#plans","Plans",{"_3150":67,"_27660":63,"_5":27979,"_19192":45109,"_26170":45110,"_2648":45111},[],"/docs/deployment/saas#request-access","Request access",{"_3150":68,"_27660":63,"_19192":45113,"_5":13195,"_26170":63,"_2648":45114},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3150":69,"_27660":63,"_19192":45116,"_5":13195,"_26170":45102,"_2648":45117},[],"Platform availability and maintenance.",{"_3150":70,"_27660":63,"_19192":45119,"_5":13195,"_26170":45102,"_2648":45120},[],"Automatic backups.",{"_3150":71,"_27660":63,"_19192":45122,"_5":13195,"_26170":45102,"_2648":45123},[],"Version upgrades.",{"_3150":72,"_27660":63,"_19192":45125,"_5":13195,"_26170":45102,"_2648":45126},[],"Technical support and SLA according to your plan.",{"_3150":73,"_27660":63,"_19192":45128,"_5":13195,"_26170":45106,"_2648":45129},[],"Plan",{"_3150":74,"_27660":63,"_19192":45131,"_5":13195,"_26170":45106,"_2648":45132},[],"Devices",{"_3150":75,"_27660":63,"_19192":45134,"_5":13195,"_26170":45106,"_2648":45135},[],"Support",{"_3150":76,"_27660":63,"_19192":45137,"_5":13195,"_26170":45106,"_2648":45138},[],"SLA",{"_3150":77,"_27660":63,"_19192":45140,"_5":13195,"_26170":45106,"_2648":45141},[],"Starter",{"_3150":78,"_27660":63,"_19192":45143,"_5":13195,"_26170":45106,"_2648":45144},[],"Up to 1,000",{"_3150":79,"_27660":63,"_19192":45146,"_5":13195,"_26170":45106,"_2648":45147},[],"Email",{"_3150":80,"_27660":63,"_19192":45149,"_5":13195,"_26170":45106,"_2648":45150},[],"99.5 %",{"_3150":81,"_27660":63,"_19192":45152,"_5":13195,"_26170":45106,"_2648":45153},[],"Professional",{"_3150":82,"_27660":63,"_19192":45155,"_5":13195,"_26170":45106,"_2648":45156},[],"Up to 10,000",{"_3150":83,"_27660":63,"_19192":45158,"_5":13195,"_26170":45106,"_2648":45159},[],"Email and chat",{"_3150":84,"_27660":63,"_19192":45161,"_5":13195,"_26170":45106,"_2648":45162},[],"99.9 %",{"_3150":85,"_27660":63,"_19192":45164,"_5":13195,"_26170":45106,"_2648":45165},[],"Enterprise",{"_3150":86,"_27660":63,"_19192":45167,"_5":13195,"_26170":45106,"_2648":45168},[],"Unlimited",{"_3150":87,"_27660":63,"_19192":45170,"_5":13195,"_26170":45106,"_2648":45171},[],"Dedicated",{"_3150":88,"_27660":63,"_19192":45173,"_5":13195,"_26170":45106,"_2648":45174},[],"99.99 %",{"_3150":89,"_27660":63,"_19192":45176,"_5":13195,"_26170":45110,"_2648":45177},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3150":90,"_27660":63,"_19192":45179,"_5":13195,"_26170":45110,"_2648":45180},[],"When you receive your instance's credentials, continue with Get started.",{"_3150":91,"_27660":91,"_5":13521,"_2648":45182,"_27982":45183,"_19192":45184,"_26170":91},"Fastlane",[44938,44939,45045],[],{"_3150":92,"_27660":91,"_19192":45186,"_5":13195,"_26170":91,"_2648":45187},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3150":93,"_27660":91,"_5":27979,"_19192":45189,"_26170":45190,"_2648":45191},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3150":94,"_27660":91,"_5":27979,"_19192":45193,"_26170":45194,"_2648":45195},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3150":95,"_27660":91,"_5":27979,"_19192":45197,"_26170":45198,"_2648":44948},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3150":96,"_27660":91,"_5":27979,"_19192":45200,"_26170":45201,"_2648":45202},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3150":97,"_27660":91,"_5":27979,"_19192":45204,"_26170":45205,"_2648":45206},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3150":98,"_27660":91,"_5":27979,"_19192":45208,"_26170":45209,"_2648":45210},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3150":99,"_27660":91,"_5":27979,"_19192":45212,"_26170":45213,"_2648":45214},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3150":100,"_27660":91,"_5":27979,"_19192":45216,"_26170":45217,"_2648":45218},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3150":101,"_27660":91,"_5":27979,"_19192":45220,"_26170":45221,"_2648":45222},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3150":102,"_27660":91,"_5":27979,"_19192":45224,"_26170":45225,"_2648":45226},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3150":103,"_27660":91,"_5":27979,"_19192":45228,"_26170":45229,"_2648":45230},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3150":104,"_27660":91,"_19192":45232,"_5":13195,"_26170":45190,"_2648":45233},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3150":105,"_27660":91,"_19192":45235,"_5":13195,"_26170":45190,"_2648":45236},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3150":106,"_27660":91,"_19192":45238,"_5":13195,"_26170":45194,"_2648":45239},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3150":107,"_27660":91,"_19192":45241,"_5":13195,"_26170":45194,"_2648":45242},[],"Fastlane installs or configures",{"_3150":108,"_27660":91,"_19192":45244,"_5":13195,"_26170":45194,"_2648":45245},[],"You still provide",{"_3150":109,"_27660":91,"_19192":45247,"_5":13195,"_26170":45194,"_2648":45248},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3150":110,"_27660":91,"_19192":45250,"_5":13195,"_26170":45194,"_2648":45251},[],"The Kubernetes cluster, nodes and persistent storage",{"_3150":111,"_27660":91,"_19192":45253,"_5":13195,"_26170":45194,"_2648":45254},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3150":112,"_27660":91,"_19192":45256,"_5":13195,"_26170":45194,"_2648":45257},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3150":113,"_27660":91,"_19192":45259,"_5":13195,"_26170":45194,"_2648":45260},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3150":114,"_27660":91,"_19192":45262,"_5":13195,"_26170":45194,"_2648":45263},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3150":115,"_27660":91,"_19192":45265,"_5":13195,"_26170":45194,"_2648":45266},[],"Optional observability and lab HSM components",{"_3150":116,"_27660":91,"_19192":45268,"_5":13195,"_26170":45194,"_2648":45269},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3150":117,"_27660":91,"_19192":45271,"_5":13195,"_26170":45194,"_2648":45272},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3150":118,"_27660":91,"_19192":45274,"_5":13195,"_26170":45198,"_2648":45275},[],"You need:",{"_3150":119,"_27660":91,"_19192":45277,"_5":13195,"_26170":45198,"_2648":45278},[],"an existing Kubernetes cluster",{"_3150":120,"_27660":91,"_19192":45280,"_5":13195,"_26170":45198,"_2648":45281},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3150":121,"_27660":91,"_19192":45283,"_5":13195,"_26170":45198,"_2648":45284},[],"`yq`",{"_3150":122,"_27660":91,"_19192":45286,"_5":13195,"_26170":45198,"_2648":21734},[],{"_3150":123,"_27660":91,"_19192":45288,"_5":13195,"_26170":45198,"_2648":45289},[],"`jq` only when using `--sample-data` or `--development`",{"_3150":124,"_27660":91,"_19192":45291,"_5":13195,"_26170":45198,"_2648":45292},[],"`ssh-keygen` only when using `--with-hsm`",{"_3150":125,"_27660":91,"_19192":45294,"_5":13195,"_26170":45198,"_2648":45295},[],"free external ports 80 and 443 on a single-node K3s host",{"_3150":126,"_27660":91,"_19192":45297,"_5":13195,"_26170":45198,"_2648":45298},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3150":127,"_27660":91,"_19192":45300,"_5":13195,"_26170":45198,"_2648":45301},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3150":128,"_27660":91,"_19192":45303,"_5":13195,"_26170":45201,"_2648":45304},[],"Run the script from a clone of the Helm repository:",{"_3150":129,"_27660":91,"_19192":45306,"_5":13195,"_26170":45201,"_2648":45307},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3150":130,"_27660":91,"_19192":45309,"_5":13195,"_26170":45205,"_2648":45310},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3150":131,"_27660":91,"_19192":45312,"_5":13195,"_26170":45205,"_2648":45313},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3150":132,"_27660":91,"_19192":45315,"_5":13195,"_26170":45205,"_2648":45316},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3150":133,"_27660":91,"_19192":45318,"_5":13195,"_26170":45205,"_2648":45319},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3150":134,"_27660":91,"_19192":45321,"_5":13195,"_26170":45209,"_2648":45322},[],"Option",{"_3150":135,"_27660":91,"_19192":45324,"_5":13195,"_26170":45209,"_2648":45325},[],"Default",{"_3150":136,"_27660":91,"_19192":45327,"_5":13195,"_26170":45209,"_2648":45328},[],"Purpose",{"_3150":137,"_27660":91,"_19192":45330,"_5":13195,"_26170":45209,"_2648":45331},[],"`-h`, `--help`",{"_3150":138,"_27660":91,"_19192":45333,"_5":13195,"_26170":45209,"_2648":45334},[],"—",{"_3150":139,"_27660":91,"_19192":45336,"_5":13195,"_26170":45209,"_2648":45337},[],"Show help",{"_3150":140,"_27660":91,"_19192":45339,"_5":13195,"_26170":45209,"_2648":45340},[],"`-c`, `--context`",{"_3150":141,"_27660":91,"_19192":45342,"_5":13195,"_26170":45209,"_2648":45343},[],"current context",{"_3150":142,"_27660":91,"_19192":45345,"_5":13195,"_26170":45209,"_2648":45346},[],"Select the kubeconfig context for kubectl and Helm",{"_3150":143,"_27660":91,"_19192":45348,"_5":13195,"_26170":45209,"_2648":45349},[],"`-n`, `--non-interactive`",{"_3150":144,"_27660":91,"_19192":45351,"_5":13195,"_26170":45209,"_2648":5899},[],{"_3150":145,"_27660":91,"_19192":45353,"_5":13195,"_26170":45209,"_2648":45354},[],"Skip prompts and generate dependency credentials",{"_3150":146,"_27660":91,"_19192":45356,"_5":13195,"_26170":45209,"_2648":45357},[],"`-ns`, `--namespace`",{"_3150":147,"_27660":91,"_19192":45359,"_5":13195,"_26170":45209,"_2648":45360},[],"`lamassu-dev`",{"_3150":148,"_27660":91,"_19192":45362,"_5":13195,"_26170":45209,"_2648":45363},[],"Namespace for the installation",{"_3150":149,"_27660":91,"_19192":45365,"_5":13195,"_26170":45209,"_2648":45366},[],"`-d`, `--domain`",{"_3150":150,"_27660":91,"_19192":45368,"_5":13195,"_26170":45209,"_2648":45369},[],"`dev.lamassu.io`",{"_3150":151,"_27660":91,"_19192":45371,"_5":13195,"_26170":45209,"_2648":45372},[],"Domain used by the UI, OIDC and certificate",{"_3150":152,"_27660":91,"_19192":45374,"_5":13195,"_26170":45209,"_2648":45375},[],"`-v`, `--version`",{"_3150":153,"_27660":91,"_19192":45377,"_5":13195,"_26170":45209,"_2648":13797},[],{"_3150":154,"_27660":91,"_19192":45379,"_5":13195,"_26170":45209,"_2648":45380},[],"Lamassu chart version",{"_3150":155,"_27660":91,"_19192":45382,"_5":13195,"_26170":45209,"_2648":45383},[],"`--https-port`",{"_3150":156,"_27660":91,"_19192":45385,"_5":13195,"_26170":45209,"_2648":45386},[],"`443`",{"_3150":157,"_27660":91,"_19192":45388,"_5":13195,"_26170":45209,"_2648":45389},[],"Gateway HTTPS listener port",{"_3150":158,"_27660":91,"_19192":45391,"_5":13195,"_26170":45209,"_2648":45392},[],"`--http-port`",{"_3150":159,"_27660":91,"_19192":45394,"_5":13195,"_26170":45209,"_2648":45395},[],"`80`",{"_3150":160,"_27660":91,"_19192":45397,"_5":13195,"_26170":45209,"_2648":45398},[],"Gateway HTTP listener port",{"_3150":161,"_27660":91,"_19192":45400,"_5":13195,"_26170":45209,"_2648":45401},[],"`--tls-crt`",{"_3150":162,"_27660":91,"_19192":45403,"_5":13195,"_26170":45209,"_2648":45334},[],{"_3150":163,"_27660":91,"_19192":45405,"_5":13195,"_26170":45209,"_2648":45406},[],"PEM certificate for downstream TLS",{"_3150":164,"_27660":91,"_19192":45408,"_5":13195,"_26170":45209,"_2648":45409},[],"`--tls-key`",{"_3150":165,"_27660":91,"_19192":45411,"_5":13195,"_26170":45209,"_2648":45334},[],{"_3150":166,"_27660":91,"_19192":45413,"_5":13195,"_26170":45209,"_2648":45414},[],"PEM private key for downstream TLS",{"_3150":167,"_27660":91,"_19192":45416,"_5":13195,"_26170":45209,"_2648":45417},[],"`-l`, `--local-chart-path`",{"_3150":168,"_27660":91,"_19192":45419,"_5":13195,"_26170":45209,"_2648":45420},[],"repository chart",{"_3150":169,"_27660":91,"_19192":45422,"_5":13195,"_26170":45209,"_2648":45423},[],"Use an unpacked local Lamassu chart",{"_3150":170,"_27660":91,"_19192":45425,"_5":13195,"_26170":45209,"_2648":45426},[],"`-ip`, `--gateway-ip`",{"_3150":171,"_27660":91,"_19192":45428,"_5":13195,"_26170":45209,"_2648":7951},[],{"_3150":172,"_27660":91,"_19192":45430,"_5":13195,"_26170":45209,"_2648":45431},[],"Override the address written to `gateway.addresses`",{"_3150":173,"_27660":91,"_19192":45433,"_5":13195,"_26170":45209,"_2648":45434},[],"`--otel`",{"_3150":174,"_27660":91,"_19192":45436,"_5":13195,"_26170":45209,"_2648":5899},[],{"_3150":175,"_27660":91,"_19192":45438,"_5":13195,"_26170":45209,"_2648":45439},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3150":176,"_27660":91,"_19192":45441,"_5":13195,"_26170":45209,"_2648":45442},[],"`--development`",{"_3150":177,"_27660":91,"_19192":45444,"_5":13195,"_26170":45209,"_2648":5899},[],{"_3150":178,"_27660":91,"_19192":45446,"_5":13195,"_26170":45209,"_2648":45447},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3150":179,"_27660":91,"_19192":45449,"_5":13195,"_26170":45209,"_2648":45450},[],"`--sample-data`",{"_3150":180,"_27660":91,"_19192":45452,"_5":13195,"_26170":45209,"_2648":5899},[],{"_3150":181,"_27660":91,"_19192":45454,"_5":13195,"_26170":45209,"_2648":45455},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3150":182,"_27660":91,"_19192":45457,"_5":13195,"_26170":45209,"_2648":45458},[],"`--with-hsm`",{"_3150":183,"_27660":91,"_19192":45460,"_5":13195,"_26170":45209,"_2648":5899},[],{"_3150":184,"_27660":91,"_19192":45462,"_5":13195,"_26170":45209,"_2648":45463},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3150":185,"_27660":91,"_19192":45465,"_5":13195,"_26170":45209,"_2648":45466},[],"`--softhsm-chart-path`",{"_3150":186,"_27660":91,"_19192":45468,"_5":13195,"_26170":45209,"_2648":45469},[],"`./charts/softhsm`",{"_3150":187,"_27660":91,"_19192":45471,"_5":13195,"_26170":45209,"_2648":45472},[],"Use a different local SoftHSM chart",{"_3150":188,"_27660":91,"_19192":45474,"_5":13195,"_26170":45209,"_2648":45475},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3150":189,"_27660":91,"_19192":45477,"_5":13195,"_26170":45213,"_2648":45478},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3150":190,"_27660":91,"_19192":45480,"_5":13195,"_26170":45213,"_2648":45481},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3150":191,"_27660":91,"_19192":45483,"_5":13195,"_26170":45213,"_2648":45484},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3150":192,"_27660":91,"_19192":45486,"_5":13195,"_26170":45213,"_2648":45487},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3150":193,"_27660":91,"_19192":45489,"_5":13195,"_26170":45213,"_2648":45490},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3150":194,"_27660":91,"_19192":45492,"_5":13195,"_26170":45213,"_2648":45493},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3150":195,"_27660":91,"_19192":45495,"_5":13195,"_26170":45217,"_2648":45496},[],"Fastlane:",{"_3150":196,"_27660":91,"_19192":45498,"_5":13195,"_26170":45217,"_2648":45499},[],"validates local tools and the selected cluster",{"_3150":197,"_27660":91,"_19192":45501,"_5":13195,"_26170":45217,"_2648":45502},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3150":198,"_27660":91,"_19192":45504,"_5":13195,"_26170":45217,"_2648":45505},[],"creates the namespace",{"_3150":199,"_27660":91,"_19192":45507,"_5":13195,"_26170":45217,"_2648":45508},[],"installs PostgreSQL and creates the required databases",{"_3150":200,"_27660":91,"_19192":45510,"_5":13195,"_26170":45217,"_2648":45511},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3150":201,"_27660":91,"_19192":45513,"_5":13195,"_26170":45217,"_2648":45514},[],"installs RabbitMQ",{"_3150":202,"_27660":91,"_19192":45516,"_5":13195,"_26170":45217,"_2648":45517},[],"optionally installs observability and lab HSM components",{"_3150":203,"_27660":91,"_19192":45519,"_5":13195,"_26170":45217,"_2648":45520},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3150":204,"_27660":91,"_19192":45522,"_5":13195,"_26170":45217,"_2648":45523},[],"optionally loads sample data",{"_3150":205,"_27660":91,"_19192":45525,"_5":13195,"_26170":45217,"_2648":45526},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3150":206,"_27660":91,"_19192":45528,"_5":13195,"_26170":45221,"_2648":45529},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3150":207,"_27660":91,"_19192":45531,"_5":13195,"_26170":45221,"_2648":45532},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3150":208,"_27660":91,"_19192":45534,"_5":13195,"_26170":45225,"_2648":45535},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3150":209,"_27660":91,"_19192":45537,"_5":13195,"_26170":45225,"_2648":45538},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3150":210,"_27660":91,"_19192":45540,"_5":13195,"_26170":45225,"_2648":45541},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3150":211,"_27660":91,"_19192":45543,"_5":13195,"_26170":45229,"_2648":45544},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3150":212,"_27660":212,"_5":13521,"_2648":45546,"_27982":45547,"_19192":45548,"_26170":212},"Install with Helm",[44938,44939,45045],[],{"_3150":213,"_27660":212,"_19192":45550,"_5":13195,"_26170":212,"_2648":45551},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3150":214,"_27660":212,"_5":27979,"_19192":45553,"_26170":45554,"_2648":45555},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3150":215,"_27660":212,"_5":27979,"_19192":45557,"_26170":45558,"_2648":44948},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3150":216,"_27660":212,"_5":27979,"_19192":45560,"_26170":45561,"_2648":45562},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3150":217,"_27660":212,"_5":27979,"_19192":45564,"_26170":45565,"_2648":45566},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3150":218,"_27660":212,"_5":27979,"_19192":45568,"_26170":45569,"_2648":45570},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3150":219,"_27660":212,"_5":27979,"_19192":45572,"_26170":45573,"_2648":45574},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3150":220,"_27660":212,"_5":27979,"_19192":45576,"_26170":45577,"_2648":45578},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3150":221,"_27660":212,"_5":27979,"_19192":45580,"_26170":45581,"_2648":45582},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3150":222,"_27660":212,"_5":27979,"_19192":45584,"_26170":45585,"_2648":45586},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3150":223,"_27660":212,"_19192":45588,"_5":13195,"_26170":45554,"_2648":45589},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3150":224,"_27660":212,"_19192":45591,"_5":13195,"_26170":45558,"_2648":45592},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3150":225,"_27660":212,"_19192":45594,"_5":13195,"_26170":45558,"_2648":45595},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3150":226,"_27660":212,"_19192":45597,"_5":13195,"_26170":45558,"_2648":45598},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3150":227,"_27660":212,"_19192":45600,"_5":13195,"_26170":45558,"_2648":45601},[],"a reachable RabbitMQ broker and credentials",{"_3150":228,"_27660":212,"_19192":45603,"_5":13195,"_26170":45558,"_2648":45604},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3150":229,"_27660":212,"_19192":45606,"_5":13195,"_26170":45558,"_2648":45607},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3150":230,"_27660":212,"_19192":45609,"_5":13195,"_26170":45558,"_2648":45610},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3150":231,"_27660":212,"_19192":45612,"_5":13195,"_26170":45558,"_2648":45613},[],"a StorageClass and an external traffic design",{"_3150":232,"_27660":212,"_19192":45615,"_5":13195,"_26170":45558,"_2648":45616},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3150":233,"_27660":212,"_19192":45618,"_5":13195,"_26170":45558,"_2648":45619},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3150":234,"_27660":212,"_19192":45621,"_5":13195,"_26170":45558,"_2648":45622},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3150":235,"_27660":212,"_19192":45624,"_5":13195,"_26170":45561,"_2648":45625},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3150":236,"_27660":212,"_19192":45627,"_5":13195,"_26170":45561,"_2648":45628},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3150":237,"_27660":212,"_19192":45630,"_5":13195,"_26170":45561,"_2648":45631},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_3150":238,"_27660":212,"_19192":45633,"_5":13195,"_26170":45565,"_2648":45634},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3150":239,"_27660":212,"_19192":45636,"_5":13195,"_26170":45565,"_2648":45637},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3150":240,"_27660":212,"_19192":45639,"_5":13195,"_26170":45565,"_2648":45640},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3150":241,"_27660":212,"_19192":45642,"_5":13195,"_26170":45569,"_2648":45643},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_3150":242,"_27660":212,"_19192":45645,"_5":13195,"_26170":45573,"_2648":45646},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3150":243,"_27660":212,"_19192":45648,"_5":13195,"_26170":45573,"_2648":45649},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3150":244,"_27660":212,"_19192":45651,"_5":13195,"_26170":45573,"_2648":45652},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3150":245,"_27660":212,"_19192":45654,"_5":13195,"_26170":45573,"_2648":45655},[],"See Access control for the principal and policy model.",{"_3150":246,"_27660":212,"_19192":45657,"_5":13195,"_26170":45577,"_2648":45658},[],"To install a local checkout instead:",{"_3150":247,"_27660":212,"_19192":45660,"_5":13195,"_26170":45581,"_2648":45661},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3150":248,"_27660":212,"_19192":45663,"_5":13195,"_26170":45581,"_2648":45664},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3150":249,"_27660":212,"_19192":45666,"_5":13195,"_26170":45585,"_2648":45667},[],"Before going live, review:",{"_3150":250,"_27660":212,"_19192":45669,"_5":13195,"_26170":45585,"_2648":45670},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3150":251,"_27660":212,"_19192":45672,"_5":13195,"_26170":45585,"_2648":45673},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3150":252,"_27660":212,"_19192":45675,"_5":13195,"_26170":45585,"_2648":45676},[],"shared VA storage before increasing VA replicas",{"_3150":253,"_27660":212,"_19192":45678,"_5":13195,"_26170":45585,"_2648":45679},[],"managed OIDC roles and removal of evaluation credentials",{"_3150":254,"_27660":212,"_19192":45681,"_5":13195,"_26170":45585,"_2648":45682},[],"a trusted TLS issuer or externally managed certificate",{"_3150":255,"_27660":212,"_19192":45684,"_5":13195,"_26170":45585,"_2648":45685},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3150":256,"_27660":212,"_19192":45687,"_5":13195,"_26170":45585,"_2648":45688},[],"SMTP, observability and alert delivery",{"_3150":257,"_27660":212,"_19192":45690,"_5":13195,"_26170":45585,"_2648":45691},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3150":258,"_27660":212,"_19192":45693,"_5":13195,"_26170":45585,"_2648":45694},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3150":259,"_27660":259,"_5":13521,"_2648":45696,"_27982":45697,"_19192":45698,"_26170":259},"Expose the Gateway",[44938,44939,45045],[],{"_3150":260,"_27660":259,"_19192":45700,"_5":13195,"_26170":259,"_2648":45701},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3150":261,"_27660":259,"_5":27979,"_19192":45703,"_26170":45704,"_2648":45705},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3150":262,"_27660":259,"_5":27979,"_19192":45707,"_26170":45708,"_2648":45709},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3150":263,"_27660":259,"_5":27979,"_19192":45711,"_26170":45712,"_2648":45713},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3150":264,"_27660":259,"_5":27979,"_19192":45715,"_26170":45716,"_2648":45717},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3150":265,"_27660":259,"_5":27979,"_19192":45719,"_26170":45720,"_2648":45721},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3150":266,"_27660":259,"_5":27979,"_19192":45723,"_26170":45724,"_2648":45725},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3150":267,"_27660":259,"_5":27979,"_19192":45727,"_26170":45728,"_2648":45729},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3150":268,"_27660":259,"_5":27979,"_19192":45731,"_26170":45732,"_2648":45733},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3150":269,"_27660":259,"_5":27979,"_19192":45735,"_26170":45736,"_2648":45737},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3150":270,"_27660":259,"_19192":45739,"_5":13195,"_26170":45704,"_2648":45740},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3150":271,"_27660":259,"_19192":45742,"_5":13195,"_26170":45704,"_2648":45743},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3150":272,"_27660":259,"_19192":45745,"_5":13195,"_26170":45708,"_2648":45746},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3150":273,"_27660":259,"_19192":45748,"_5":13195,"_26170":45708,"_2648":45749},[],"Set it only when:",{"_3150":274,"_27660":259,"_19192":45751,"_5":13195,"_26170":45708,"_2648":45752},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3150":275,"_27660":259,"_19192":45754,"_5":13195,"_26170":45708,"_2648":45755},[],"that address is allocated to this Gateway",{"_3150":276,"_27660":259,"_19192":45757,"_5":13195,"_26170":45708,"_2648":45758},[],"the surrounding network already routes traffic for it to the cluster",{"_3150":277,"_27660":259,"_19192":45760,"_5":13195,"_26170":45708,"_2648":45761},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3150":278,"_27660":259,"_19192":45763,"_5":13195,"_26170":45708,"_2648":45764},[],"Keep these two settings separate:",{"_3150":279,"_27660":259,"_19192":45766,"_5":13195,"_26170":45708,"_2648":45767},[],"`gateway.addresses` requests an address for the Gateway.",{"_3150":280,"_27660":259,"_19192":45769,"_5":13195,"_26170":45708,"_2648":45770},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3150":281,"_27660":259,"_19192":45772,"_5":13195,"_26170":45708,"_2648":45773},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3150":282,"_27660":259,"_19192":45775,"_5":13195,"_26170":45712,"_2648":45776},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3150":283,"_27660":259,"_19192":45778,"_5":13195,"_26170":45712,"_2648":45779},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3150":284,"_27660":259,"_19192":45781,"_5":13195,"_26170":45716,"_2648":45782},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3150":285,"_27660":259,"_19192":45784,"_5":13195,"_26170":45716,"_2648":45785},[],"For the recommended design:",{"_3150":286,"_27660":259,"_19192":45787,"_5":13195,"_26170":45716,"_2648":45788},[],"Use only one externally exposed Lamassu Gateway.",{"_3150":287,"_27660":259,"_19192":45790,"_5":13195,"_26170":45716,"_2648":45791},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3150":288,"_27660":259,"_19192":45793,"_5":13195,"_26170":45716,"_2648":45794},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3150":289,"_27660":259,"_19192":45796,"_5":13195,"_26170":45716,"_2648":45797},[],"Point DNS at the VM's reachable address.",{"_3150":290,"_27660":259,"_19192":45799,"_5":13195,"_26170":45716,"_2648":45800},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3150":291,"_27660":259,"_19192":45802,"_5":13195,"_26170":45720,"_2648":45803},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3150":292,"_27660":259,"_19192":45805,"_5":13195,"_26170":45724,"_2648":45806},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3150":293,"_27660":259,"_19192":45808,"_5":13195,"_26170":45724,"_2648":45809},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3150":294,"_27660":259,"_19192":45811,"_5":13195,"_26170":45728,"_2648":45812},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3150":295,"_27660":259,"_19192":45814,"_5":13195,"_26170":45728,"_2648":45815},[],"Requirement",{"_3150":296,"_27660":259,"_19192":45817,"_5":13195,"_26170":45728,"_2648":45818},[],"Recommended design",{"_3150":297,"_27660":259,"_19192":45820,"_5":13195,"_26170":45728,"_2648":45821},[],"Consequence",{"_3150":298,"_27660":259,"_19192":45823,"_5":13195,"_26170":45728,"_2648":45824},[],"Several Lamassu URLs or services",{"_3150":299,"_27660":259,"_19192":45826,"_5":13195,"_26170":45728,"_2648":45827},[],"One Gateway with multiple routes",{"_3150":300,"_27660":259,"_19192":45829,"_5":13195,"_26170":45728,"_2648":45830},[],"One IP and one proxy fleet; this is the chart default",{"_3150":301,"_27660":259,"_19192":45832,"_5":13195,"_26170":45728,"_2648":45833},[],"Independent Gateways and separate external IPs",{"_3150":302,"_27660":259,"_19192":45835,"_5":13195,"_26170":45728,"_2648":45836},[],"One VIP per Gateway",{"_3150":303,"_27660":259,"_19192":45838,"_5":13195,"_26170":45728,"_2648":45839},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3150":304,"_27660":259,"_19192":45841,"_5":13195,"_26170":45728,"_2648":45842},[],"Independent Gateways on one node and one IP",{"_3150":305,"_27660":259,"_19192":45844,"_5":13195,"_26170":45728,"_2648":45845},[],"Use different external ports",{"_3150":306,"_27660":259,"_19192":45847,"_5":13195,"_26170":45728,"_2648":45848},[],"Clients must include non-standard ports",{"_3150":307,"_27660":259,"_19192":45850,"_5":13195,"_26170":45728,"_2648":45851},[],"Separate TLS/mTLS termination behind one IP",{"_3150":308,"_27660":259,"_19192":45853,"_5":13195,"_26170":45728,"_2648":45854},[],"Front-door SNI routing to internal Gateways",{"_3150":309,"_27660":259,"_19192":45856,"_5":13195,"_26170":45728,"_2648":45857},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3150":310,"_27660":259,"_19192":45859,"_5":13195,"_26170":45728,"_2648":45860},[],"Separate Gateway resources but shared proxy infrastructure",{"_3150":311,"_27660":259,"_19192":45862,"_5":13195,"_26170":45728,"_2648":45863},[],"Envoy merged-Gateway mode",{"_3150":312,"_27660":259,"_19192":45865,"_5":13195,"_26170":45728,"_2648":45866},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3150":313,"_27660":259,"_19192":45868,"_5":13195,"_26170":45728,"_2648":45869},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3150":314,"_27660":259,"_19192":45871,"_5":13195,"_26170":45728,"_2648":45872},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3150":315,"_27660":259,"_19192":45874,"_5":13195,"_26170":45728,"_2648":45875},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3150":316,"_27660":259,"_19192":45877,"_5":13195,"_26170":45728,"_2648":45878},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3150":317,"_27660":259,"_19192":45880,"_5":13195,"_26170":45732,"_2648":45881},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3150":318,"_27660":259,"_19192":45883,"_5":13195,"_26170":45732,"_2648":45884},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3150":319,"_27660":259,"_19192":45886,"_5":13195,"_26170":45732,"_2648":45887},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3150":320,"_27660":259,"_19192":45889,"_5":13195,"_26170":45732,"_2648":45890},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3150":321,"_27660":259,"_19192":45892,"_5":13195,"_26170":45732,"_2648":45893},[],"If none of those are possible, use different external ports or change the external network design.",{"_3150":322,"_27660":259,"_19192":45895,"_5":13195,"_26170":45736,"_2648":45896},[],"Check, in order:",{"_3150":323,"_27660":259,"_19192":45898,"_5":13195,"_26170":45736,"_2648":45899},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3150":324,"_27660":259,"_19192":45901,"_5":13195,"_26170":45736,"_2648":45902},[],"Its status contains the expected address.",{"_3150":325,"_27660":259,"_19192":45904,"_5":13195,"_26170":45736,"_2648":45905},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3150":326,"_27660":259,"_19192":45907,"_5":13195,"_26170":45736,"_2648":45908},[],"Port 443 reaches that address from the client network.",{"_3150":327,"_27660":259,"_19192":45910,"_5":13195,"_26170":45736,"_2648":45911},[],"DNS resolves to the externally reachable endpoint.",{"_3150":328,"_27660":259,"_19192":45913,"_5":13195,"_26170":45736,"_2648":45914},[],"The certificate contains the DNS name or IP used by the client.",{"_3150":329,"_27660":259,"_19192":45916,"_5":13195,"_26170":45736,"_2648":45917},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3150":330,"_27660":330,"_5":13521,"_2648":45045,"_27982":45919,"_19192":45920,"_26170":330},[44938,44939,45045],[],{"_3150":331,"_27660":330,"_19192":45922,"_5":13195,"_26170":330,"_2648":45923},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3150":332,"_27660":330,"_5":27979,"_19192":45925,"_26170":45926,"_2648":45927},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3150":333,"_27660":330,"_5":27979,"_19192":45929,"_26170":45930,"_2648":45931},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3150":334,"_27660":330,"_5":27979,"_19192":45933,"_26170":45934,"_2648":45935},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3150":335,"_27660":330,"_5":27979,"_19192":45937,"_26170":45938,"_2648":45939},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3150":336,"_27660":330,"_5":27979,"_19192":45941,"_26170":45942,"_2648":45943},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3150":337,"_27660":330,"_5":27979,"_19192":45945,"_26170":45946,"_2648":45947},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3150":338,"_27660":330,"_19192":45949,"_5":13195,"_26170":45926,"_2648":45950},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3150":339,"_27660":330,"_19192":45952,"_5":13195,"_26170":45930,"_2648":45953},[],"Workflow",{"_3150":340,"_27660":330,"_19192":45955,"_5":13195,"_26170":45930,"_2648":45956},[],"Use it for",{"_3150":341,"_27660":330,"_19192":45958,"_5":13195,"_26170":45930,"_2648":45959},[],"What it installs",{"_3150":342,"_27660":330,"_19192":45961,"_5":13195,"_26170":45930,"_2648":45962},[],"Helm",{"_3150":343,"_27660":330,"_19192":45964,"_5":13195,"_26170":45930,"_2648":45965},[],"Production and controlled environments",{"_3150":344,"_27660":330,"_19192":45967,"_5":13195,"_26170":45930,"_2648":45968},[],"Lamassu services and Gateway API resources",{"_3150":345,"_27660":330,"_19192":45970,"_5":13195,"_26170":45930,"_2648":45182},[],{"_3150":346,"_27660":330,"_19192":45972,"_5":13195,"_26170":45930,"_2648":45973},[],"Evaluation, demos, CI and small lab clusters",{"_3150":347,"_27660":330,"_19192":45975,"_5":13195,"_26170":45930,"_2648":45976},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3150":348,"_27660":330,"_19192":45978,"_5":13195,"_26170":45934,"_2648":45979},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3150":349,"_27660":330,"_19192":45981,"_5":13195,"_26170":45934,"_2648":45982},[],"Area",{"_3150":350,"_27660":330,"_19192":45984,"_5":13195,"_26170":45934,"_2648":45985},[],"The Lamassu chart provides",{"_3150":351,"_27660":330,"_19192":45987,"_5":13195,"_26170":45934,"_2648":45988},[],"You provide",{"_3150":352,"_27660":330,"_19192":45990,"_5":13195,"_26170":45934,"_2648":45991},[],"Lamassu applications",{"_3150":353,"_27660":330,"_19192":45993,"_5":13195,"_26170":45934,"_2648":45994},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3150":354,"_27660":330,"_19192":45996,"_5":13195,"_26170":45934,"_2648":45997},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3150":355,"_27660":330,"_19192":45999,"_5":13195,"_26170":45934,"_2648":46000},[],"PostgreSQL data",{"_3150":356,"_27660":330,"_19192":46002,"_5":13195,"_26170":45934,"_2648":46003},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3150":357,"_27660":330,"_19192":46005,"_5":13195,"_26170":45934,"_2648":46006},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3150":358,"_27660":330,"_19192":46008,"_5":13195,"_26170":45934,"_2648":46009},[],"Messaging",{"_3150":359,"_27660":330,"_19192":46011,"_5":13195,"_26170":45934,"_2648":46012},[],"RabbitMQ connection configuration for the Lamassu services",{"_3150":360,"_27660":330,"_19192":46014,"_5":13195,"_26170":45934,"_2648":46015},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3150":361,"_27660":330,"_19192":46017,"_5":13195,"_26170":45934,"_2648":46018},[],"Identity",{"_3150":362,"_27660":330,"_19192":46020,"_5":13195,"_26170":45934,"_2648":46021},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3150":363,"_27660":330,"_19192":46023,"_5":13195,"_26170":45934,"_2648":46024},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3150":364,"_27660":330,"_19192":46026,"_5":13195,"_26170":45934,"_2648":46027},[],"External routing",{"_3150":365,"_27660":330,"_19192":46029,"_5":13195,"_26170":45934,"_2648":46030},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3150":366,"_27660":330,"_19192":46032,"_5":13195,"_26170":45934,"_2648":46033},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3150":367,"_27660":330,"_19192":46035,"_5":13195,"_26170":45934,"_2648":46036},[],"TLS",{"_3150":368,"_27660":330,"_19192":46038,"_5":13195,"_26170":45934,"_2648":46039},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_3150":369,"_27660":330,"_19192":46041,"_5":13195,"_26170":45934,"_2648":46042},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3150":370,"_27660":330,"_19192":46044,"_5":13195,"_26170":45934,"_2648":46045},[],"Persistent application data",{"_3150":371,"_27660":330,"_19192":46047,"_5":13195,"_26170":45934,"_2648":46048},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3150":372,"_27660":330,"_19192":46050,"_5":13195,"_26170":45934,"_2648":46051},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3150":373,"_27660":330,"_19192":46053,"_5":13195,"_26170":45934,"_2648":46054},[],"Optional integrations",{"_3150":374,"_27660":330,"_19192":46056,"_5":13195,"_26170":45934,"_2648":46057},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3150":375,"_27660":330,"_19192":46059,"_5":13195,"_26170":45934,"_2648":46060},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3150":376,"_27660":330,"_19192":46062,"_5":13195,"_26170":45934,"_2648":46063},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3150":377,"_27660":330,"_19192":46065,"_5":13195,"_26170":45934,"_2648":46066},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3150":378,"_27660":330,"_19192":46068,"_5":13195,"_26170":45938,"_2648":46069},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3150":379,"_27660":330,"_19192":46071,"_5":13195,"_26170":45938,"_2648":46072},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3150":380,"_27660":330,"_19192":46074,"_5":13195,"_26170":45942,"_2648":46075},[],"Kubernetes 1.24 or newer",{"_3150":381,"_27660":330,"_19192":46077,"_5":13195,"_26170":45942,"_2648":46078},[],"Helm 3.2 or newer",{"_3150":382,"_27660":330,"_19192":46080,"_5":13195,"_26170":45942,"_2648":46081},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3150":383,"_27660":330,"_19192":46083,"_5":13195,"_26170":45942,"_2648":46084},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_3150":384,"_27660":330,"_19192":46086,"_5":13195,"_26170":45942,"_2648":46087},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3150":385,"_27660":330,"_19192":46089,"_5":13195,"_26170":45942,"_2648":46090},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3150":386,"_27660":330,"_19192":46092,"_5":13195,"_26170":45942,"_2648":46093},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3150":387,"_27660":330,"_19192":46095,"_5":13195,"_26170":45946,"_2648":46096},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":388,"_27660":330,"_19192":46098,"_5":13195,"_26170":45946,"_2648":46099},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3150":389,"_27660":330,"_19192":46101,"_5":13195,"_26170":45946,"_2648":46102},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3150":390,"_27660":330,"_19192":46104,"_5":13195,"_26170":45946,"_2648":46105},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3150":391,"_27660":391,"_5":13521,"_2648":46107,"_27982":46108,"_19192":46110,"_26170":391},"Deployment troubleshooting",[44938,44939,46109],"Operations",[],{"_3150":392,"_27660":391,"_19192":46112,"_5":13195,"_26170":391,"_2648":46113},[],"Diagnose access, service health and infrastructure dependencies.",{"_3150":393,"_27660":391,"_5":27979,"_19192":46115,"_26170":46116,"_2648":46117},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3150":394,"_27660":391,"_5":27979,"_19192":46119,"_26170":46120,"_2648":46121},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3150":395,"_27660":391,"_5":27979,"_19192":46123,"_26170":46124,"_2648":46125},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3150":396,"_27660":391,"_5":27979,"_19192":46127,"_26170":46128,"_2648":46129},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3150":397,"_27660":391,"_5":27979,"_19192":46131,"_26170":46132,"_2648":46133},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3150":398,"_27660":391,"_5":27979,"_19192":46135,"_26170":46136,"_2648":46137},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3150":399,"_27660":391,"_5":27979,"_19192":46139,"_26170":46140,"_2648":46141},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3150":400,"_27660":391,"_5":27979,"_19192":46143,"_26170":46144,"_2648":46145},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3150":401,"_27660":391,"_5":27979,"_19192":46147,"_26170":46148,"_2648":46149},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3150":402,"_27660":391,"_5":27979,"_19192":46151,"_26170":46152,"_2648":46153},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3150":403,"_27660":391,"_5":27979,"_19192":46155,"_26170":46156,"_2648":46157},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3150":404,"_27660":391,"_5":27979,"_19192":46159,"_26170":46160,"_2648":46161},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3150":405,"_27660":391,"_19192":46163,"_5":13195,"_26170":391,"_2648":46164},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3150":406,"_27660":391,"_19192":46166,"_5":13195,"_26170":46120,"_2648":46167},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3150":407,"_27660":391,"_19192":46169,"_5":13195,"_26170":46124,"_2648":46170},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3150":408,"_27660":391,"_19192":46172,"_5":13195,"_26170":46128,"_2648":46173},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3150":409,"_27660":391,"_19192":46175,"_5":13195,"_26170":46132,"_2648":46176},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3150":410,"_27660":391,"_19192":46178,"_5":13195,"_26170":46136,"_2648":46179},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3150":411,"_27660":391,"_19192":46181,"_5":13195,"_26170":46140,"_2648":46182},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3150":412,"_27660":391,"_19192":46184,"_5":13195,"_26170":46140,"_2648":46185},[],"Also run the chart's connectivity test:",{"_3150":413,"_27660":391,"_19192":46187,"_5":13195,"_26170":46140,"_2648":46188},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3150":414,"_27660":391,"_19192":46190,"_5":13195,"_26170":46140,"_2648":46191},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3150":415,"_27660":391,"_19192":46193,"_5":13195,"_26170":46144,"_2648":46194},[],"If you receive a 401:",{"_3150":416,"_27660":391,"_19192":46196,"_5":13195,"_26170":46144,"_2648":46197},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3150":417,"_27660":391,"_19192":46199,"_5":13195,"_26170":46144,"_2648":46200},[],"verify issuer, audience and expiration of the token;",{"_3150":418,"_27660":391,"_19192":46202,"_5":13195,"_26170":46144,"_2648":46203},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3150":419,"_27660":391,"_19192":46205,"_5":13195,"_26170":46144,"_2648":46206},[],"check that the provider's public and internal routes point to the same realm.",{"_3150":420,"_27660":391,"_19192":46208,"_5":13195,"_26170":46144,"_2648":46209},[],"If login succeeds but the APIs return 403:",{"_3150":421,"_27660":391,"_19192":46211,"_5":13195,"_26170":46144,"_2648":46212},[],"inspect the token's real claims;",{"_3150":422,"_27660":391,"_19192":46214,"_5":13195,"_26170":46144,"_2648":46215},[],"confirm they match an active principal;",{"_3150":423,"_27660":391,"_19192":46217,"_5":13195,"_26170":46144,"_2648":46218},[],"review the policies granted to that principal;",{"_3150":424,"_27660":391,"_19192":46220,"_5":13195,"_26170":46144,"_2648":46221},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3150":425,"_27660":391,"_19192":46223,"_5":13195,"_26170":46144,"_2648":46224},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3150":426,"_27660":391,"_19192":46226,"_5":13195,"_26170":46148,"_2648":46227},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3150":427,"_27660":391,"_19192":46229,"_5":13195,"_26170":46148,"_2648":46230},[],"Locate the authz pod and Service.",{"_3150":428,"_27660":391,"_19192":46232,"_5":13195,"_26170":46148,"_2648":46233},[],"Check /health, logs and its database connection.",{"_3150":429,"_27660":391,"_19192":46235,"_5":13195,"_26170":46148,"_2648":46236},[],"Verify the DNS and port configured in externalAuthorization.",{"_3150":430,"_27660":391,"_19192":46238,"_5":13195,"_26170":46148,"_2648":46239},[],"Check the check route is /v1/ext\\_authz/check.",{"_3150":431,"_27660":391,"_19192":46241,"_5":13195,"_26170":46148,"_2648":46242},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3150":432,"_27660":391,"_19192":46244,"_5":13195,"_26170":46152,"_2648":46245},[],"Review kubectl describe pod first. Common causes are:",{"_3150":433,"_27660":391,"_19192":46247,"_5":13195,"_26170":46152,"_2648":46248},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3150":434,"_27660":391,"_19192":46250,"_5":13195,"_26170":46152,"_2648":46251},[],"unbound persistent volume;",{"_3150":435,"_27660":391,"_19192":46253,"_5":13195,"_26170":46152,"_2648":46254},[],"inaccessible image or incorrect pull policy;",{"_3150":436,"_27660":391,"_19192":46256,"_5":13195,"_26170":46152,"_2648":46257},[],"invalid cryptographic engine configuration;",{"_3150":437,"_27660":391,"_19192":46259,"_5":13195,"_26170":46152,"_2648":46260},[],"CPU or memory limits set too low;",{"_3150":438,"_27660":391,"_19192":46262,"_5":13195,"_26170":46152,"_2648":46263},[],"an incomplete prior migration.",{"_3150":439,"_27660":391,"_19192":46265,"_5":13195,"_26170":46152,"_2648":46266},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3150":440,"_27660":391,"_19192":46268,"_5":13195,"_26170":46152,"_2648":46269},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3150":441,"_27660":391,"_19192":46271,"_5":13195,"_26170":46156,"_2648":46272},[],"Domain and audit events depend on the bus publisher:",{"_3150":442,"_27660":391,"_19192":46274,"_5":13195,"_26170":46156,"_2648":46275},[],"verify it is enabled in the emitting service;",{"_3150":443,"_27660":391,"_19192":46277,"_5":13195,"_26170":46156,"_2648":46278},[],"check AMQP connectivity and credentials;",{"_3150":444,"_27660":391,"_19192":46280,"_5":13195,"_26170":46156,"_2648":46281},[],"review exchange, routing key, queues and consumers;",{"_3150":445,"_27660":391,"_19192":46283,"_5":13195,"_26170":46156,"_2648":46284},[],"inspect dead-letter queues;",{"_3150":446,"_27660":391,"_19192":46286,"_5":13195,"_26170":46156,"_2648":46287},[],"alert on orphan durable queues and backlog growth.",{"_3150":447,"_27660":391,"_19192":46289,"_5":13195,"_26170":46156,"_2648":46290},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3150":448,"_27660":391,"_19192":46292,"_5":13195,"_26170":46160,"_2648":46293},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_3150":449,"_27660":391,"_19192":46295,"_5":13195,"_26170":46160,"_2648":46296},[],"Before closing an incident, record:",{"_3150":450,"_27660":391,"_19192":46298,"_5":13195,"_26170":46160,"_2648":46299},[],"the confirmed cause;",{"_3150":451,"_27660":391,"_19192":46301,"_5":13195,"_26170":46160,"_2648":46302},[],"the time scope and affected resources;",{"_3150":452,"_27660":391,"_19192":46304,"_5":13195,"_26170":46160,"_2648":46305},[],"the commands or queries used;",{"_3150":453,"_27660":391,"_19192":46307,"_5":13195,"_26170":46160,"_2648":46308},[],"the applied change and how to revert it;",{"_3150":454,"_27660":391,"_19192":46310,"_5":13195,"_26170":46160,"_2648":46311},[],"validation from a consumer;",{"_3150":455,"_27660":391,"_19192":46313,"_5":13195,"_26170":46160,"_2648":46314},[],"the preventive action and its owner.",{"_3150":456,"_27660":456,"_5":13521,"_2648":46316,"_27982":46317,"_19192":46320,"_26170":456},"Access control",[44938,46318,46319],"Platform","Administration",[],{"_3150":457,"_27660":456,"_19192":46322,"_5":13195,"_26170":456,"_2648":46323},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3150":458,"_27660":456,"_5":27979,"_19192":46325,"_26170":46326,"_2648":46327},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3150":459,"_27660":456,"_5":27979,"_19192":46329,"_26170":46330,"_2648":46331},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3150":460,"_27660":456,"_5":27979,"_19192":46333,"_26170":46334,"_2648":46335},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3150":461,"_27660":456,"_5":27979,"_19192":46337,"_26170":46338,"_2648":46339},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3150":462,"_27660":456,"_5":27979,"_19192":46341,"_26170":46342,"_2648":46343},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3150":463,"_27660":456,"_5":27979,"_19192":46345,"_26170":46346,"_2648":46347},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3150":464,"_27660":456,"_5":27979,"_19192":46349,"_26170":46350,"_2648":46351},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3150":465,"_27660":456,"_5":27979,"_19192":46353,"_26170":46354,"_2648":46355},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3150":466,"_27660":456,"_5":27979,"_19192":46357,"_26170":46358,"_2648":46359},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3150":467,"_27660":456,"_5":27979,"_19192":46361,"_26170":46362,"_2648":46363},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3150":468,"_27660":456,"_5":27979,"_19192":46365,"_26170":46366,"_2648":46367},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3150":469,"_27660":456,"_5":27979,"_19192":46369,"_26170":46370,"_2648":46371},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3150":470,"_27660":456,"_5":27979,"_19192":46373,"_26170":46374,"_2648":46375},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3150":471,"_27660":456,"_5":27979,"_19192":46377,"_26170":46378,"_2648":46379},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3150":472,"_27660":456,"_5":27979,"_19192":46381,"_26170":46382,"_2648":46383},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3150":473,"_27660":456,"_5":27979,"_19192":46385,"_26170":46386,"_2648":45574},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3150":474,"_27660":456,"_5":27979,"_19192":46388,"_26170":46389,"_2648":46390},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3150":475,"_27660":456,"_5":27979,"_19192":46392,"_26170":46393,"_2648":46394},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3150":476,"_27660":456,"_5":27979,"_19192":46396,"_26170":46397,"_2648":46398},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3150":477,"_27660":456,"_5":27979,"_19192":46400,"_26170":46401,"_2648":46402},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3150":478,"_27660":456,"_5":27979,"_19192":46404,"_26170":46405,"_2648":46406},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3150":479,"_27660":456,"_5":27979,"_19192":46408,"_26170":46409,"_2648":46410},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3150":480,"_27660":456,"_5":27979,"_19192":46412,"_26170":46413,"_2648":46414},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3150":481,"_27660":456,"_5":27979,"_19192":46416,"_26170":46417,"_2648":46418},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3150":482,"_27660":456,"_5":27979,"_19192":46420,"_26170":46421,"_2648":46422},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3150":483,"_27660":456,"_5":27979,"_19192":46424,"_26170":46425,"_2648":46426},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3150":484,"_27660":456,"_5":27979,"_19192":46428,"_26170":46429,"_2648":46430},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3150":485,"_27660":456,"_5":27979,"_19192":46432,"_26170":46433,"_2648":46434},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3150":486,"_27660":456,"_5":27979,"_19192":46436,"_26170":46437,"_2648":46438},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3150":487,"_27660":456,"_5":27979,"_19192":46440,"_26170":46441,"_2648":46442},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3150":488,"_27660":456,"_5":27979,"_19192":46444,"_26170":46445,"_2648":46446},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3150":489,"_27660":456,"_19192":46448,"_5":13195,"_26170":456,"_2648":46449},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3150":490,"_27660":456,"_19192":46451,"_5":13195,"_26170":456,"_2648":46452},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3150":491,"_27660":456,"_19192":46454,"_5":13195,"_26170":456,"_2648":46455},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3150":492,"_27660":456,"_19192":46457,"_5":13195,"_26170":46326,"_2648":46458},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3150":493,"_27660":456,"_19192":46460,"_5":13195,"_26170":46326,"_2648":46461},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3150":494,"_27660":456,"_19192":46463,"_5":13195,"_26170":46326,"_2648":46464},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3150":495,"_27660":456,"_19192":46466,"_5":13195,"_26170":46326,"_2648":46467},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3150":496,"_27660":456,"_19192":46469,"_5":13195,"_26170":46326,"_2648":46470},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3150":497,"_27660":456,"_19192":46472,"_5":13195,"_26170":46326,"_2648":46473},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3150":498,"_27660":456,"_19192":46475,"_5":13195,"_26170":46330,"_2648":46476},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3150":499,"_27660":456,"_19192":46478,"_5":13195,"_26170":46330,"_2648":46479},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3150":500,"_27660":456,"_19192":46481,"_5":13195,"_26170":46334,"_2648":46482},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3150":501,"_27660":456,"_19192":46484,"_5":13195,"_26170":46334,"_2648":46485},[],"The decision is made **before forwarding the request to the service**:",{"_3150":502,"_27660":456,"_19192":46487,"_5":13195,"_26170":46334,"_2648":46488},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3150":503,"_27660":456,"_19192":46490,"_5":13195,"_26170":46334,"_2648":46491},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3150":504,"_27660":456,"_19192":46493,"_5":13195,"_26170":46334,"_2648":46494},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3150":505,"_27660":456,"_19192":46496,"_5":13195,"_26170":46334,"_2648":46497},[],"It separately loads the policies granted to each principal.",{"_3150":506,"_27660":456,"_19192":46499,"_5":13195,"_26170":46334,"_2648":46500},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3150":507,"_27660":456,"_19192":46502,"_5":13195,"_26170":46334,"_2648":46503},[],"`authz` looks for an HTTP rule granting that action.",{"_3150":508,"_27660":456,"_19192":46505,"_5":13195,"_26170":46334,"_2648":46506},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3150":509,"_27660":456,"_19192":46508,"_5":13195,"_26170":46334,"_2648":46509},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3150":510,"_27660":456,"_19192":46511,"_5":13195,"_26170":46334,"_2648":46512},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3150":511,"_27660":456,"_19192":46514,"_5":13195,"_26170":46334,"_2648":46515},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3150":512,"_27660":456,"_19192":46517,"_5":13195,"_26170":46338,"_2648":46518},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3150":513,"_27660":456,"_19192":46520,"_5":13195,"_26170":46338,"_2648":46521},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3150":514,"_27660":456,"_19192":46523,"_5":13195,"_26170":46338,"_2648":46524},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3150":515,"_27660":456,"_19192":46526,"_5":13195,"_26170":46338,"_2648":46527},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3150":516,"_27660":456,"_19192":46529,"_5":13195,"_26170":46338,"_2648":46530},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3150":517,"_27660":456,"_19192":46532,"_5":13195,"_26170":46338,"_2648":46533},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3150":518,"_27660":456,"_19192":46535,"_5":13195,"_26170":46338,"_2648":46536},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3150":519,"_27660":456,"_19192":46538,"_5":13195,"_26170":46338,"_2648":46539},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3150":520,"_27660":456,"_19192":46541,"_5":13195,"_26170":46342,"_2648":46542},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3150":521,"_27660":456,"_19192":46544,"_5":13195,"_26170":46342,"_2648":46545},[],"The decision is made with the domain operation context:",{"_3150":522,"_27660":456,"_19192":46547,"_5":13195,"_26170":46342,"_2648":46548},[],"The middleware extracts the credential and resolves the matching principals.",{"_3150":523,"_27660":456,"_19192":46550,"_5":13195,"_26170":46342,"_2648":46551},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3150":524,"_27660":456,"_19192":46553,"_5":13195,"_26170":46342,"_2648":46554},[],"`authz` gathers the entity rules of the granted policies.",{"_3150":525,"_27660":456,"_19192":46556,"_5":13195,"_26170":46342,"_2648":46557},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3150":526,"_27660":456,"_19192":46559,"_5":13195,"_26170":46342,"_2648":46560},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3150":527,"_27660":456,"_19192":46562,"_5":13195,"_26170":46342,"_2648":46563},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3150":528,"_27660":456,"_19192":46565,"_5":13195,"_26170":46342,"_2648":46566},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3150":529,"_27660":456,"_19192":46568,"_5":13195,"_26170":46342,"_2648":46569},[],"Actions fall into two groups:",{"_3150":530,"_27660":456,"_19192":46571,"_5":13195,"_26170":46342,"_2648":46572},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3150":531,"_27660":456,"_19192":46574,"_5":13195,"_26170":46342,"_2648":46575},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3150":532,"_27660":456,"_19192":46577,"_5":13195,"_26170":46342,"_2648":46578},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3150":533,"_27660":456,"_19192":46580,"_5":13195,"_26170":46346,"_2648":46581},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3150":534,"_27660":456,"_19192":46583,"_5":13195,"_26170":46346,"_2648":46584},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3150":535,"_27660":456,"_19192":46586,"_5":13195,"_26170":46346,"_2648":46587},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3150":536,"_27660":456,"_19192":46589,"_5":13195,"_26170":46350,"_2648":46590},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3150":537,"_27660":456,"_19192":46592,"_5":13195,"_26170":46350,"_2648":46593},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3150":538,"_27660":456,"_19192":46595,"_5":13195,"_26170":46350,"_2648":46596},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3150":539,"_27660":456,"_19192":46598,"_5":13195,"_26170":46350,"_2648":46599},[],"The implemented operators are:",{"_3150":540,"_27660":456,"_19192":46601,"_5":13195,"_26170":46350,"_2648":46602},[],"`equals`, for exact equality;",{"_3150":541,"_27660":456,"_19192":46604,"_5":13195,"_26170":46350,"_2648":46605},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3150":542,"_27660":456,"_19192":46607,"_5":13195,"_26170":46350,"_2648":46608},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3150":543,"_27660":456,"_19192":46610,"_5":13195,"_26170":46350,"_2648":46611},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3150":544,"_27660":456,"_19192":46613,"_5":13195,"_26170":46354,"_2648":46614},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3150":545,"_27660":456,"_19192":46616,"_5":13195,"_26170":46354,"_2648":46617},[],"The available modes are:",{"_3150":546,"_27660":456,"_19192":46619,"_5":13195,"_26170":46354,"_2648":46620},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3150":547,"_27660":456,"_19192":46622,"_5":13195,"_26170":46354,"_2648":46623},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3150":548,"_27660":456,"_19192":46625,"_5":13195,"_26170":46354,"_2648":46626},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3150":549,"_27660":456,"_19192":46628,"_5":13195,"_26170":46354,"_2648":46629},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3150":550,"_27660":456,"_19192":46631,"_5":13195,"_26170":46354,"_2648":46632},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3150":551,"_27660":456,"_19192":46634,"_5":13195,"_26170":46354,"_2648":46635},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3150":552,"_27660":456,"_19192":46637,"_5":13195,"_26170":46358,"_2648":46638},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3150":553,"_27660":456,"_19192":46640,"_5":13195,"_26170":46358,"_2648":46641},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3150":554,"_27660":456,"_19192":46643,"_5":13195,"_26170":46358,"_2648":46644},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3150":555,"_27660":456,"_19192":46646,"_5":13195,"_26170":46358,"_2648":46647},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3150":556,"_27660":456,"_19192":46649,"_5":13195,"_26170":46366,"_2648":46650},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3150":557,"_27660":456,"_19192":46652,"_5":13195,"_26170":46366,"_2648":46653},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3150":558,"_27660":456,"_19192":46655,"_5":13195,"_26170":46370,"_2648":46656},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3150":559,"_27660":456,"_19192":46658,"_5":13195,"_26170":46370,"_2648":46659},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3150":560,"_27660":456,"_19192":46661,"_5":13195,"_26170":46374,"_2648":46662},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3150":561,"_27660":456,"_19192":46664,"_5":13195,"_26170":46374,"_2648":46665},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3150":562,"_27660":456,"_19192":46667,"_5":13195,"_26170":46374,"_2648":46668},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3150":563,"_27660":456,"_19192":46670,"_5":13195,"_26170":46378,"_2648":46671},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3150":564,"_27660":456,"_19192":46673,"_5":13195,"_26170":46378,"_2648":46674},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3150":565,"_27660":456,"_19192":46676,"_5":13195,"_26170":46378,"_2648":46677},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3150":566,"_27660":456,"_19192":46679,"_5":13195,"_26170":46378,"_2648":46680},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3150":567,"_27660":456,"_19192":46682,"_5":13195,"_26170":46378,"_2648":46683},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3150":568,"_27660":456,"_19192":46685,"_5":13195,"_26170":46378,"_2648":46686},[],"Note that:",{"_3150":569,"_27660":456,"_19192":46688,"_5":13195,"_26170":46378,"_2648":46689},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3150":570,"_27660":456,"_19192":46691,"_5":13195,"_26170":46378,"_2648":46692},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3150":571,"_27660":456,"_19192":46694,"_5":13195,"_26170":46378,"_2648":46695},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3150":572,"_27660":456,"_19192":46697,"_5":13195,"_26170":46382,"_2648":46698},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3150":573,"_27660":456,"_19192":46700,"_5":13195,"_26170":46382,"_2648":46701},[],"full and read-only access to certificates and authorities;",{"_3150":574,"_27660":456,"_19192":46703,"_5":13195,"_26170":46382,"_2648":46704},[],"full and read-only access to the KMS;",{"_3150":575,"_27660":456,"_19192":46706,"_5":13195,"_26170":46382,"_2648":46707},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3150":576,"_27660":456,"_19192":46709,"_5":13195,"_26170":46382,"_2648":46710},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3150":577,"_27660":456,"_19192":46712,"_5":13195,"_26170":46382,"_2648":46713},[],"console access;",{"_3150":578,"_27660":456,"_19192":46715,"_5":13195,"_26170":46382,"_2648":46716},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3150":579,"_27660":456,"_19192":46718,"_5":13195,"_26170":46382,"_2648":46719},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3150":580,"_27660":456,"_19192":46721,"_5":13195,"_26170":46382,"_2648":46722},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3150":581,"_27660":456,"_19192":46724,"_5":13195,"_26170":46386,"_2648":46725},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3150":582,"_27660":456,"_19192":46727,"_5":13195,"_26170":46386,"_2648":46728},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3150":583,"_27660":456,"_19192":46730,"_5":13195,"_26170":46386,"_2648":46731},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3150":584,"_27660":456,"_19192":46733,"_5":13195,"_26170":46389,"_2648":46734},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3150":585,"_27660":456,"_19192":46736,"_5":13195,"_26170":46393,"_2648":46737},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3150":586,"_27660":456,"_19192":46739,"_5":13195,"_26170":46393,"_2648":46740},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3150":587,"_27660":456,"_19192":46742,"_5":13195,"_26170":46397,"_2648":46743},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3150":588,"_27660":456,"_19192":46745,"_5":13195,"_26170":46401,"_2648":46746},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3150":589,"_27660":456,"_19192":46748,"_5":13195,"_26170":46405,"_2648":46749},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3150":590,"_27660":456,"_19192":46751,"_5":13195,"_26170":46409,"_2648":46752},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3150":591,"_27660":456,"_19192":46754,"_5":13195,"_26170":46409,"_2648":46755},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3150":592,"_27660":456,"_19192":46757,"_5":13195,"_26170":46413,"_2648":46758},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3150":593,"_27660":456,"_19192":46760,"_5":13195,"_26170":46413,"_2648":46761},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3150":594,"_27660":456,"_19192":46763,"_5":13195,"_26170":46413,"_2648":46764},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3150":595,"_27660":456,"_19192":46766,"_5":13195,"_26170":46413,"_2648":46767},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3150":596,"_27660":456,"_19192":46769,"_5":13195,"_26170":46413,"_2648":46770},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3150":597,"_27660":456,"_19192":46772,"_5":13195,"_26170":46413,"_2648":46773},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3150":598,"_27660":456,"_19192":46775,"_5":13195,"_26170":46413,"_2648":46776},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3150":599,"_27660":456,"_19192":46778,"_5":13195,"_26170":46413,"_2648":46779},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3150":600,"_27660":456,"_19192":46781,"_5":13195,"_26170":46417,"_2648":46782},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3150":601,"_27660":456,"_19192":46784,"_5":13195,"_26170":46417,"_2648":46785},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3150":602,"_27660":456,"_19192":46787,"_5":13195,"_26170":46417,"_2648":46788},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3150":603,"_27660":456,"_19192":46790,"_5":13195,"_26170":46421,"_2648":46791},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3150":604,"_27660":456,"_19192":46793,"_5":13195,"_26170":46421,"_2648":46794},[],"Use groups or stable roles for people and independent identities for automations.",{"_3150":605,"_27660":456,"_19192":46796,"_5":13195,"_26170":46421,"_2648":46797},[],"Keep at least two recovery administrators and test their access periodically.",{"_3150":606,"_27660":456,"_19192":46799,"_5":13195,"_26170":46421,"_2648":46800},[],"Review active principals, their matches and their grants after IdP changes.",{"_3150":607,"_27660":456,"_19192":46802,"_5":13195,"_26170":46421,"_2648":46803},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3150":608,"_27660":456,"_19192":46805,"_5":13195,"_26170":46421,"_2648":46806},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3150":609,"_27660":456,"_19192":46808,"_5":13195,"_26170":46421,"_2648":46809},[],"Always test one allowed and one denied operation for each role.",{"_3150":610,"_27660":456,"_19192":46811,"_5":13195,"_26170":46421,"_2648":46812},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3150":611,"_27660":456,"_19192":46814,"_5":13195,"_26170":46429,"_2648":46815},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3150":612,"_27660":456,"_19192":46817,"_5":13195,"_26170":46433,"_2648":46818},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3150":613,"_27660":456,"_19192":46820,"_5":13195,"_26170":46433,"_2648":46821},[],"that an active principal of the correct type exists;",{"_3150":614,"_27660":456,"_19192":46823,"_5":13195,"_26170":46433,"_2648":46824},[],"that the claim paths and values match the real token exactly;",{"_3150":615,"_27660":456,"_19192":46826,"_5":13195,"_26170":46433,"_2648":46827},[],"that all of the principal's conditions hold;",{"_3150":616,"_27660":456,"_19192":46829,"_5":13195,"_26170":46433,"_2648":46830},[],"that the principal has the expected policy granted;",{"_3150":617,"_27660":456,"_19192":46832,"_5":13195,"_26170":46433,"_2648":46833},[],"that the policy includes the action and the requested resource type or route;",{"_3150":618,"_27660":456,"_19192":46835,"_5":13195,"_26170":46433,"_2648":46836},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3150":619,"_27660":456,"_19192":46838,"_5":13195,"_26170":46433,"_2648":46839},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_3150":620,"_27660":456,"_19192":46841,"_5":13195,"_26170":46437,"_2648":46842},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3150":621,"_27660":456,"_19192":46844,"_5":13195,"_26170":46441,"_2648":46845},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3150":622,"_27660":456,"_19192":46847,"_5":13195,"_26170":46445,"_2648":46848},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3150":623,"_27660":456,"_19192":46850,"_5":13195,"_26170":46445,"_2648":46851},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3150":624,"_27660":624,"_5":13521,"_2648":46853,"_27982":46854,"_19192":46855,"_26170":624},"Alerts and subscriptions",[44938,46318,46319],[],{"_3150":625,"_27660":624,"_19192":46857,"_5":13195,"_26170":624,"_2648":46858},[],"Send PKI events to people and external systems.",{"_3150":626,"_27660":624,"_5":27979,"_19192":46860,"_26170":46861,"_2648":46862},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3150":627,"_27660":624,"_5":27979,"_19192":46864,"_26170":46865,"_2648":46866},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3150":628,"_27660":624,"_5":27979,"_19192":46868,"_26170":46869,"_2648":46870},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3150":629,"_27660":624,"_5":27979,"_19192":46872,"_26170":46873,"_2648":46874},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3150":630,"_27660":624,"_5":27979,"_19192":46876,"_26170":46877,"_2648":46878},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3150":631,"_27660":624,"_5":27979,"_19192":46880,"_26170":46881,"_2648":46882},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3150":632,"_27660":624,"_5":27979,"_19192":46884,"_26170":46885,"_2648":46886},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3150":633,"_27660":624,"_5":27979,"_19192":46888,"_26170":46889,"_2648":46890},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3150":634,"_27660":624,"_5":27979,"_19192":46892,"_26170":46893,"_2648":46894},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3150":635,"_27660":624,"_5":27979,"_19192":46896,"_26170":46897,"_2648":46898},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3150":636,"_27660":624,"_19192":46900,"_5":13195,"_26170":624,"_2648":46901},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3150":637,"_27660":624,"_19192":46903,"_5":13195,"_26170":46861,"_2648":46904},[],"A service publishes a domain event.",{"_3150":638,"_27660":624,"_19192":46906,"_5":13195,"_26170":46861,"_2648":46907},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3150":639,"_27660":624,"_19192":46909,"_5":13195,"_26170":46861,"_2648":46910},[],"Each subscription's filter decides whether it should be notified.",{"_3150":640,"_27660":624,"_19192":46912,"_5":13195,"_26170":46861,"_2648":46913},[],"Lamassu delivers the event to the configured channel.",{"_3150":641,"_27660":624,"_19192":46915,"_5":13195,"_26170":46861,"_2648":46916},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3150":642,"_27660":624,"_19192":46918,"_5":13195,"_26170":46865,"_2648":46919},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3150":643,"_27660":624,"_19192":46921,"_5":13195,"_26170":46865,"_2648":46922},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3150":644,"_27660":624,"_19192":46924,"_5":13195,"_26170":46865,"_2648":46925},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3150":645,"_27660":624,"_19192":46927,"_5":13195,"_26170":46865,"_2648":46928},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3150":646,"_27660":624,"_19192":46930,"_5":13195,"_26170":46865,"_2648":46931},[],"`apikey_options` requires `header` and `key`.",{"_3150":647,"_27660":624,"_19192":46933,"_5":13195,"_26170":46865,"_2648":46934},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3150":648,"_27660":624,"_19192":46936,"_5":13195,"_26170":46865,"_2648":46937},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3150":649,"_27660":624,"_19192":46939,"_5":13195,"_26170":46865,"_2648":46940},[],"The alerts API reference documents the full `http_client` schema.",{"_3150":650,"_27660":624,"_19192":46942,"_5":13195,"_26170":46873,"_2648":46943},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3150":651,"_27660":624,"_19192":46945,"_5":13195,"_26170":46877,"_2648":46946},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3150":652,"_27660":624,"_19192":46948,"_5":13195,"_26170":46881,"_2648":46949},[],"Add a filter if you don't want to receive every instance of the event.",{"_3150":653,"_27660":624,"_19192":46951,"_5":13195,"_26170":46881,"_2648":46952},[],"**None** notifies all instances of the event.",{"_3150":654,"_27660":624,"_19192":46954,"_5":13195,"_26170":46881,"_2648":46955},[],"**JSON Path** evaluates one or more specific fields.",{"_3150":655,"_27660":624,"_19192":46957,"_5":13195,"_26170":46881,"_2648":46958},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3150":656,"_27660":624,"_19192":46960,"_5":13195,"_26170":46881,"_2648":46961},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3150":657,"_27660":624,"_19192":46963,"_5":13195,"_26170":46881,"_2648":46964},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3150":658,"_27660":624,"_19192":46966,"_5":13195,"_26170":46885,"_2648":46967},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3150":659,"_27660":624,"_19192":46969,"_5":13195,"_26170":46889,"_2648":46970},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3150":660,"_27660":624,"_19192":46972,"_5":13195,"_26170":46889,"_2648":46973},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3150":661,"_27660":624,"_19192":46975,"_5":13195,"_26170":46889,"_2648":46976},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3150":662,"_27660":624,"_19192":46978,"_5":13195,"_26170":46889,"_2648":46979},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3150":663,"_27660":624,"_19192":46981,"_5":13195,"_26170":46889,"_2648":46982},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3150":664,"_27660":624,"_19192":46984,"_5":13195,"_26170":46889,"_2648":46985},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3150":665,"_27660":624,"_19192":46987,"_5":13195,"_26170":46889,"_2648":46988},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3150":666,"_27660":624,"_19192":46990,"_5":13195,"_26170":46889,"_2648":46991},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3150":667,"_27660":624,"_19192":46993,"_5":13195,"_26170":46893,"_2648":46994},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3150":668,"_27660":624,"_19192":46996,"_5":13195,"_26170":46897,"_2648":46997},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3150":669,"_27660":624,"_19192":46999,"_5":13195,"_26170":46897,"_2648":47000},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3150":670,"_27660":624,"_19192":47002,"_5":13195,"_26170":46897,"_2648":47003},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3150":671,"_27660":624,"_19192":47005,"_5":13195,"_26170":46897,"_2648":47006},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3150":672,"_27660":624,"_19192":47008,"_5":13195,"_26170":46897,"_2648":47009},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3150":673,"_27660":624,"_19192":47011,"_5":13195,"_26170":46897,"_2648":47012},[],"**Validation:** `va.role.crl.create`.",{"_3150":674,"_27660":624,"_19192":47014,"_5":13195,"_26170":46897,"_2648":47015},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3150":675,"_27660":624,"_19192":47017,"_5":13195,"_26170":46897,"_2648":47018},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3150":676,"_27660":676,"_5":13521,"_2648":47020,"_27982":47021,"_19192":47022,"_26170":676},"Audit logs",[44938,46318,46319],[],{"_3150":677,"_27660":676,"_19192":47024,"_5":13195,"_26170":676,"_2648":47025},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3150":678,"_27660":676,"_5":27979,"_19192":47027,"_26170":47028,"_2648":47029},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3150":679,"_27660":676,"_5":27979,"_19192":47031,"_26170":47032,"_2648":47033},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3150":680,"_27660":676,"_5":27979,"_19192":47035,"_26170":47036,"_2648":47037},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3150":681,"_27660":676,"_5":27979,"_19192":47039,"_26170":47040,"_2648":47041},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3150":682,"_27660":676,"_5":27979,"_19192":47043,"_26170":47044,"_2648":47045},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3150":683,"_27660":676,"_5":27979,"_19192":47047,"_26170":47048,"_2648":47049},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3150":684,"_27660":676,"_5":27979,"_19192":47051,"_26170":47052,"_2648":47053},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3150":685,"_27660":676,"_5":27979,"_19192":47055,"_26170":47056,"_2648":47057},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3150":686,"_27660":676,"_5":27979,"_19192":47059,"_26170":47060,"_2648":47061},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3150":687,"_27660":676,"_5":27979,"_19192":47063,"_26170":47064,"_2648":47065},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3150":688,"_27660":676,"_5":27979,"_19192":47067,"_26170":47068,"_2648":47069},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3150":689,"_27660":676,"_19192":47071,"_5":13195,"_26170":676,"_2648":47072},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3150":690,"_27660":676,"_19192":47074,"_5":13195,"_26170":47028,"_2648":47075},[],"The audit body includes:",{"_3150":691,"_27660":676,"_19192":47077,"_5":13195,"_26170":47028,"_2648":47078},[],"input: data received by the operation;",{"_3150":692,"_27660":676,"_19192":47080,"_5":13195,"_26170":47028,"_2648":47081},[],"has\\_error: whether the service returned an error;",{"_3150":693,"_27660":676,"_19192":47083,"_5":13195,"_26170":47028,"_2648":47084},[],"output: produced result or error message;",{"_3150":694,"_27660":676,"_19192":47086,"_5":13195,"_26170":47028,"_2648":47087},[],"principals: identifiers of the principals that matched the request.",{"_3150":695,"_27660":676,"_19192":47089,"_5":13195,"_26170":47028,"_2648":47090},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3150":696,"_27660":676,"_19192":47092,"_5":13195,"_26170":47028,"_2648":47093},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3150":697,"_27660":676,"_19192":47095,"_5":13195,"_26170":47032,"_2648":47096},[],"The backend applies auditing to mutations of:",{"_3150":698,"_27660":676,"_19192":47098,"_5":13195,"_26170":47032,"_2648":47099},[],"authorities, certificates and issuance profiles;",{"_3150":699,"_27660":676,"_19192":47101,"_5":13195,"_26170":47032,"_2648":47102},[],"keys and KMS engines;",{"_3150":700,"_27660":676,"_19192":47104,"_5":13195,"_26170":47032,"_2648":47105},[],"devices and identities;",{"_3150":701,"_27660":676,"_19192":47107,"_5":13195,"_26170":47032,"_2648":47108},[],"DMSs and enrollment operations;",{"_3150":702,"_27660":676,"_19192":47110,"_5":13195,"_26170":47032,"_2648":47111},[],"validation functions and CRL;",{"_3150":703,"_27660":676,"_19192":47113,"_5":13195,"_26170":47032,"_2648":47114},[],"principals, policies and authorization grants.",{"_3150":704,"_27660":676,"_19192":47116,"_5":13195,"_26170":47032,"_2648":47117},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3150":705,"_27660":676,"_19192":47119,"_5":13195,"_26170":47036,"_2648":47120},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3150":706,"_27660":676,"_19192":47122,"_5":13195,"_26170":47036,"_2648":47123},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3150":707,"_27660":676,"_19192":47125,"_5":13195,"_26170":47036,"_2648":47126},[],"Design the consumer to:",{"_3150":708,"_27660":676,"_19192":47128,"_5":13195,"_26170":47036,"_2648":47129},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3150":709,"_27660":676,"_19192":47131,"_5":13195,"_26170":47036,"_2648":47132},[],"keep the complete CloudEvent unmodified;",{"_3150":710,"_27660":676,"_19192":47134,"_5":13195,"_26170":47036,"_2648":47135},[],"record the ingestion time and detect duplicates by ID;",{"_3150":711,"_27660":676,"_19192":47137,"_5":13195,"_26170":47036,"_2648":47138},[],"encrypt in transit and at rest;",{"_3150":712,"_27660":676,"_19192":47140,"_5":13195,"_26170":47036,"_2648":47141},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3150":713,"_27660":676,"_19192":47143,"_5":13195,"_26170":47036,"_2648":47144},[],"apply an explicit retention and legal hold policy;",{"_3150":714,"_27660":676,"_19192":47146,"_5":13195,"_26170":47036,"_2648":47147},[],"alert if it stops consuming or the pending queue grows.",{"_3150":715,"_27660":676,"_19192":47149,"_5":13195,"_26170":47040,"_2648":47150},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3150":716,"_27660":676,"_19192":47152,"_5":13195,"_26170":47040,"_2648":47153},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3150":717,"_27660":676,"_19192":47155,"_5":13195,"_26170":47048,"_2648":47156},[],"Start from the reported time and normalize every source to UTC.",{"_3150":718,"_27660":676,"_19192":47158,"_5":13195,"_26170":47052,"_2648":47159},[],"Filter by event type, service source and resource identifier.",{"_3150":719,"_27660":676,"_19192":47161,"_5":13195,"_26170":47056,"_2648":47162},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3150":720,"_27660":676,"_19192":47164,"_5":13195,"_26170":47060,"_2648":47165},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3150":721,"_27660":676,"_19192":47167,"_5":13195,"_26170":47064,"_2648":47168},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3150":722,"_27660":676,"_19192":47170,"_5":13195,"_26170":47068,"_2648":47171},[],"Generate a controlled mutation in a test environment and check that:",{"_3150":723,"_27660":676,"_19192":47173,"_5":13195,"_26170":47068,"_2648":47174},[],"a successful audit event appears;",{"_3150":724,"_27660":676,"_19192":47176,"_5":13195,"_26170":47068,"_2648":47177},[],"the principal matches the identity used;",{"_3150":725,"_27660":676,"_19192":47179,"_5":13195,"_26170":47068,"_2648":47180},[],"the consumer persists it exactly once;",{"_3150":726,"_27660":676,"_19192":47182,"_5":13195,"_26170":47068,"_2648":47183},[],"it can be retrieved by resource, actor and period;",{"_3150":727,"_27660":676,"_19192":47185,"_5":13195,"_26170":47068,"_2648":47186},[],"a consumer outage raises an alert.",{"_3150":728,"_27660":676,"_19192":47188,"_5":13195,"_26170":47068,"_2648":47189},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3150":729,"_27660":729,"_5":13521,"_2648":47191,"_27982":47192,"_19192":47193,"_26170":729},"Platform architecture",[44938,46318],[],{"_3150":730,"_27660":729,"_19192":47195,"_5":13195,"_26170":729,"_2648":47196},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3150":731,"_27660":729,"_5":27979,"_19192":47198,"_26170":47199,"_2648":47200},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3150":732,"_27660":729,"_5":27979,"_19192":47202,"_26170":47203,"_2648":47204},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3150":733,"_27660":729,"_5":27979,"_19192":47206,"_26170":47207,"_2648":47208},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3150":734,"_27660":729,"_5":27979,"_19192":47210,"_26170":47211,"_2648":47212},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3150":735,"_27660":729,"_5":27979,"_19192":47214,"_26170":47215,"_2648":47216},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3150":736,"_27660":729,"_19192":47218,"_5":13195,"_26170":729,"_2648":47219},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3150":737,"_27660":729,"_19192":47221,"_5":13195,"_26170":729,"_2648":47222},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3150":738,"_27660":729,"_19192":47224,"_5":13195,"_26170":47199,"_2648":47225},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3150":739,"_27660":729,"_19192":47227,"_5":13195,"_26170":47203,"_2648":47228},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3150":740,"_27660":729,"_19192":47230,"_5":13195,"_26170":47207,"_2648":47231},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3150":741,"_27660":729,"_19192":47233,"_5":13195,"_26170":47211,"_2648":47234},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3150":742,"_27660":729,"_19192":47236,"_5":13195,"_26170":47215,"_2648":47237},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3150":743,"_27660":743,"_5":13521,"_2648":47239,"_27982":47240,"_19192":47241,"_26170":743},"How Lamassu works",[44938,46318],[],{"_3150":744,"_27660":743,"_19192":47243,"_5":13195,"_26170":743,"_2648":47244},[],"The mental model of trust, keys, certificates and devices.",{"_3150":745,"_27660":743,"_5":27979,"_19192":47246,"_26170":47247,"_2648":47248},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3150":746,"_27660":743,"_5":27979,"_19192":47250,"_26170":47251,"_2648":47252},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3150":747,"_27660":743,"_19192":47254,"_5":13195,"_26170":743,"_2648":47255},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3150":748,"_27660":743,"_19192":47257,"_5":13195,"_26170":47247,"_2648":47258},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3150":749,"_27660":743,"_19192":47260,"_5":13195,"_26170":47247,"_2648":47261},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3150":750,"_27660":743,"_19192":47263,"_5":13195,"_26170":47247,"_2648":47264},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3150":751,"_27660":743,"_19192":47266,"_5":13195,"_26170":47247,"_2648":47267},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3150":752,"_27660":743,"_19192":47269,"_5":13195,"_26170":47247,"_2648":47270},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3150":753,"_27660":743,"_19192":47272,"_5":13195,"_26170":47251,"_2648":47273},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3150":754,"_27660":743,"_19192":47275,"_5":13195,"_26170":47251,"_2648":47276},[],"A DMS relates that CA to an enrollment policy.",{"_3150":755,"_27660":743,"_19192":47278,"_5":13195,"_26170":47251,"_2648":47279},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3150":756,"_27660":743,"_19192":47281,"_5":13195,"_26170":47251,"_2648":47282},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3150":757,"_27660":743,"_19192":47284,"_5":13195,"_26170":47251,"_2648":47285},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3150":758,"_27660":743,"_19192":47287,"_5":13195,"_26170":47251,"_2648":47288},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3150":759,"_27660":743,"_19192":47290,"_5":13195,"_26170":47251,"_2648":47291},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3150":760,"_27660":760,"_5":13521,"_2648":47293,"_27982":47294,"_19192":47296,"_26170":760},"Devices and identities",[44938,46318,47295,47293],"IoT Fleets",[],{"_3150":761,"_27660":760,"_19192":47298,"_5":13195,"_26170":760,"_2648":47299},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3150":762,"_27660":760,"_5":27979,"_19192":47301,"_26170":47302,"_2648":47303},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3150":763,"_27660":760,"_5":27979,"_19192":47305,"_26170":47306,"_2648":47307},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3150":764,"_27660":760,"_5":27979,"_19192":47309,"_26170":47310,"_2648":47311},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3150":765,"_27660":760,"_5":27979,"_19192":47313,"_26170":47314,"_2648":47315},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3150":766,"_27660":760,"_5":27979,"_19192":47317,"_26170":47318,"_2648":47319},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3150":767,"_27660":760,"_5":27979,"_19192":47321,"_26170":47322,"_2648":47323},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3150":768,"_27660":760,"_5":27979,"_19192":47325,"_26170":47326,"_2648":47327},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3150":769,"_27660":760,"_5":27979,"_19192":47329,"_26170":47330,"_2648":47331},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3150":770,"_27660":760,"_5":27979,"_19192":47333,"_26170":47334,"_2648":47335},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3150":771,"_27660":760,"_5":27979,"_19192":47337,"_26170":47338,"_2648":47339},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3150":772,"_27660":760,"_5":27979,"_19192":47341,"_26170":47342,"_2648":47343},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3150":773,"_27660":760,"_19192":47345,"_5":13195,"_26170":760,"_2648":47346},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3150":774,"_27660":760,"_19192":47348,"_5":13195,"_26170":760,"_2648":47349},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3150":775,"_27660":760,"_19192":47351,"_5":13195,"_26170":47302,"_2648":47352},[],"Operational view",{"_3150":776,"_27660":760,"_19192":47354,"_5":13195,"_26170":47302,"_2648":47355},[],"Meaning",{"_3150":777,"_27660":760,"_19192":47357,"_5":13195,"_26170":47302,"_2648":47358},[],"**No Identity**",{"_3150":778,"_27660":760,"_19192":47360,"_5":13195,"_26170":47302,"_2648":47361},[],"A record exists without an associated identity.",{"_3150":779,"_27660":760,"_19192":47363,"_5":13195,"_26170":47302,"_2648":47364},[],"**Active**",{"_3150":780,"_27660":760,"_19192":47366,"_5":13195,"_26170":47302,"_2648":47367},[],"The slot is active; also check certificate dates, status and usages.",{"_3150":781,"_27660":760,"_19192":47369,"_5":13195,"_26170":47302,"_2648":47370},[],"**Renewal Pending**",{"_3150":782,"_27660":760,"_19192":47372,"_5":13195,"_26170":47302,"_2648":47373},[],"The identity is in the operational renewal window.",{"_3150":783,"_27660":760,"_19192":47375,"_5":13195,"_26170":47302,"_2648":47376},[],"**Expiring Soon**",{"_3150":784,"_27660":760,"_19192":47378,"_5":13195,"_26170":47302,"_2648":47379},[],"Expiration is approaching according to configured thresholds.",{"_3150":785,"_27660":760,"_19192":47381,"_5":13195,"_26170":47302,"_2648":47382},[],"**Expired**",{"_3150":786,"_27660":760,"_19192":47384,"_5":13195,"_26170":47302,"_2648":47385},[],"The identity has expired.",{"_3150":787,"_27660":760,"_19192":47387,"_5":13195,"_26170":47302,"_2648":47388},[],"**Revoked**",{"_3150":788,"_27660":760,"_19192":47390,"_5":13195,"_26170":47302,"_2648":47391},[],"The identity is marked revoked.",{"_3150":789,"_27660":760,"_19192":47393,"_5":13195,"_26170":47302,"_2648":47394},[],"**Decommissioned**",{"_3150":790,"_27660":760,"_19192":47396,"_5":13195,"_26170":47302,"_2648":47397},[],"The record is retired and ordinary updates do not restore operation.",{"_3150":791,"_27660":760,"_19192":47399,"_5":13195,"_26170":47302,"_2648":47400},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3150":792,"_27660":760,"_19192":47402,"_5":13195,"_26170":47306,"_2648":47403},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3150":793,"_27660":760,"_19192":47405,"_5":13195,"_26170":47306,"_2648":47406},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3150":794,"_27660":760,"_19192":47408,"_5":13195,"_26170":47306,"_2648":47409},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3150":795,"_27660":760,"_19192":47411,"_5":13195,"_26170":47306,"_2648":47412},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3150":796,"_27660":760,"_19192":47414,"_5":13195,"_26170":47310,"_2648":47415},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3150":797,"_27660":760,"_19192":47417,"_5":13195,"_26170":47314,"_2648":47418},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3150":798,"_27660":760,"_19192":47420,"_5":13195,"_26170":47318,"_2648":47421},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3150":799,"_27660":760,"_19192":47423,"_5":13195,"_26170":47322,"_2648":47424},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3150":800,"_27660":760,"_19192":47426,"_5":13195,"_26170":47326,"_2648":47427},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3150":801,"_27660":760,"_19192":47429,"_5":13195,"_26170":47326,"_2648":47430},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3150":802,"_27660":760,"_19192":47432,"_5":13195,"_26170":47330,"_2648":47433},[],"From **No Identity**, use **Assign Identity**:",{"_3150":803,"_27660":760,"_19192":47435,"_5":13195,"_26170":47330,"_2648":47436},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3150":804,"_27660":760,"_19192":47438,"_5":13195,"_26170":47330,"_2648":47439},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3150":805,"_27660":760,"_19192":47441,"_5":13195,"_26170":47330,"_2648":47442},[],"Confirm and read the serial, active version and history again.",{"_3150":806,"_27660":760,"_19192":47444,"_5":13195,"_26170":47330,"_2648":47445},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3150":807,"_27660":760,"_19192":47447,"_5":13195,"_26170":47330,"_2648":47448},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3150":808,"_27660":760,"_19192":47450,"_5":13195,"_26170":47334,"_2648":47451},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3150":809,"_27660":760,"_19192":47453,"_5":13195,"_26170":47334,"_2648":47454},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3150":810,"_27660":760,"_19192":47456,"_5":13195,"_26170":47338,"_2648":47457},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3150":811,"_27660":760,"_19192":47459,"_5":13195,"_26170":47338,"_2648":47460},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3150":812,"_27660":760,"_19192":47462,"_5":13195,"_26170":47338,"_2648":47463},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3150":813,"_27660":760,"_19192":47465,"_5":13195,"_26170":47338,"_2648":47466},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3150":814,"_27660":760,"_19192":47468,"_5":13195,"_26170":47342,"_2648":47469},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":815,"_27660":760,"_19192":47471,"_5":13195,"_26170":47342,"_2648":47472},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":816,"_27660":816,"_5":13521,"_2648":47474,"_27982":47475,"_19192":47477,"_26170":816},"Bootstrap identity and authentication",[44938,46318,47295,47293,47476],"Enrollment with PKI",[],{"_3150":817,"_27660":816,"_19192":47479,"_5":13195,"_26170":816,"_2648":47480},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3150":818,"_27660":816,"_5":27979,"_19192":47482,"_26170":47483,"_2648":47484},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3150":819,"_27660":816,"_5":27979,"_19192":47486,"_26170":47487,"_2648":47488},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3150":820,"_27660":816,"_5":27979,"_19192":47490,"_26170":47491,"_2648":47492},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3150":821,"_27660":816,"_5":27979,"_19192":47494,"_26170":47495,"_2648":47496},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3150":822,"_27660":816,"_5":27979,"_19192":47498,"_26170":47499,"_2648":47500},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3150":823,"_27660":816,"_19192":47502,"_5":13195,"_26170":816,"_2648":47503},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3150":824,"_27660":816,"_19192":47505,"_5":13195,"_26170":47483,"_2648":47506},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3150":825,"_27660":816,"_19192":47508,"_5":13195,"_26170":47483,"_2648":47509},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3150":826,"_27660":816,"_19192":47511,"_5":13195,"_26170":47487,"_2648":47512},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3150":827,"_27660":816,"_19192":47514,"_5":13195,"_26170":47487,"_2648":47515},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3150":828,"_27660":816,"_19192":47517,"_5":13195,"_26170":47487,"_2648":47518},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3150":829,"_27660":816,"_19192":47520,"_5":13195,"_26170":47491,"_2648":47521},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3150":830,"_27660":816,"_19192":47523,"_5":13195,"_26170":47491,"_2648":47524},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3150":831,"_27660":816,"_19192":47526,"_5":13195,"_26170":47495,"_2648":47527},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3150":832,"_27660":816,"_19192":47529,"_5":13195,"_26170":47495,"_2648":47530},[],"Example body:",{"_3150":833,"_27660":816,"_19192":47532,"_5":13195,"_26170":47495,"_2648":47533},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3150":834,"_27660":816,"_19192":47535,"_5":13195,"_26170":47495,"_2648":47536},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3150":835,"_27660":816,"_19192":47538,"_5":13195,"_26170":47495,"_2648":47539},[],"Continuation requires a successful HTTP response and JSON:",{"_3150":836,"_27660":816,"_19192":47541,"_5":13195,"_26170":47495,"_2648":47542},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3150":837,"_27660":816,"_19192":47544,"_5":13195,"_26170":47499,"_2648":47545},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3150":838,"_27660":816,"_19192":47547,"_5":13195,"_26170":47499,"_2648":47548},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3150":839,"_27660":839,"_5":13521,"_2648":47550,"_27982":47551,"_19192":47552,"_26170":839},"Configure and operate the DMS",[44938,46318,47295,47293,47476],[],{"_3150":840,"_27660":839,"_19192":47554,"_5":13195,"_26170":839,"_2648":47555},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3150":841,"_27660":839,"_5":27979,"_19192":47557,"_26170":47558,"_2648":44948},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3150":842,"_27660":839,"_5":27979,"_19192":47560,"_26170":47561,"_2648":47562},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3150":843,"_27660":839,"_5":27979,"_19192":47564,"_26170":47565,"_2648":47566},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3150":844,"_27660":839,"_5":27979,"_19192":47568,"_26170":47569,"_2648":47570},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3150":845,"_27660":839,"_5":27979,"_19192":47572,"_26170":47573,"_2648":47574},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3150":846,"_27660":839,"_5":27979,"_19192":47576,"_26170":47577,"_2648":47578},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3150":847,"_27660":839,"_5":27979,"_19192":47580,"_26170":47581,"_2648":47582},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3150":848,"_27660":839,"_5":27979,"_19192":47584,"_26170":47585,"_2648":47586},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3150":849,"_27660":839,"_5":27979,"_19192":47588,"_26170":47589,"_2648":47590},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3150":850,"_27660":839,"_5":27979,"_19192":47592,"_26170":47593,"_2648":47594},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3150":851,"_27660":839,"_5":27979,"_19192":47596,"_26170":47597,"_2648":47598},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3150":852,"_27660":839,"_5":27979,"_19192":47600,"_26170":47601,"_2648":47602},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3150":853,"_27660":839,"_5":27979,"_19192":47604,"_26170":47605,"_2648":47606},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3150":854,"_27660":839,"_5":27979,"_19192":47608,"_26170":47609,"_2648":47610},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3150":855,"_27660":839,"_5":27979,"_19192":47612,"_26170":47613,"_2648":47614},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3150":856,"_27660":839,"_5":27979,"_19192":47616,"_26170":47617,"_2648":47618},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3150":857,"_27660":839,"_5":27979,"_19192":47620,"_26170":47621,"_2648":47622},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3150":858,"_27660":839,"_5":27979,"_19192":47624,"_26170":47625,"_2648":47626},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3150":859,"_27660":839,"_19192":47628,"_5":13195,"_26170":839,"_2648":47629},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3150":860,"_27660":839,"_19192":47631,"_5":13195,"_26170":47558,"_2648":47632},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3150":861,"_27660":839,"_19192":47634,"_5":13195,"_26170":47558,"_2648":47635},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3150":862,"_27660":839,"_19192":47637,"_5":13195,"_26170":47565,"_2648":47638},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3150":863,"_27660":839,"_19192":47640,"_5":13195,"_26170":47569,"_2648":47641},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3150":864,"_27660":839,"_19192":47643,"_5":13195,"_26170":47573,"_2648":47644},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3150":865,"_27660":839,"_19192":47646,"_5":13195,"_26170":47577,"_2648":47647},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3150":866,"_27660":839,"_19192":47649,"_5":13195,"_26170":47581,"_2648":47650},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3150":867,"_27660":839,"_19192":47652,"_5":13195,"_26170":47589,"_2648":47653},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3150":868,"_27660":839,"_19192":47655,"_5":13195,"_26170":47589,"_2648":47656},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3150":869,"_27660":839,"_19192":47658,"_5":13195,"_26170":47593,"_2648":47659},[],"`settings.enrollment_settings` field",{"_3150":870,"_27660":839,"_19192":47661,"_5":13195,"_26170":47593,"_2648":47662},[],"Decision",{"_3150":871,"_27660":839,"_19192":47664,"_5":13195,"_26170":47593,"_2648":47665},[],"`protocol`",{"_3150":872,"_27660":839,"_19192":47667,"_5":13195,"_26170":47593,"_2648":47668},[],"`EST_RFC7030` for these operations.",{"_3150":873,"_27660":839,"_19192":47670,"_5":13195,"_26170":47593,"_2648":47671},[],"`enrollment_ca`",{"_3150":874,"_27660":839,"_19192":47673,"_5":13195,"_26170":47593,"_2648":47674},[],"ID of the signing CA.",{"_3150":875,"_27660":839,"_19192":47676,"_5":13195,"_26170":47593,"_2648":47677},[],"`verify_csr_signature`",{"_3150":876,"_27660":839,"_19192":47679,"_5":13195,"_26170":47593,"_2648":47680},[],"Keep `true` to verify CSR key possession.",{"_3150":877,"_27660":839,"_19192":47682,"_5":13195,"_26170":47593,"_2648":47683},[],"`enable_replaceable_enrollment`",{"_3150":878,"_27660":839,"_19192":47685,"_5":13195,"_26170":47593,"_2648":47686},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3150":879,"_27660":839,"_19192":47688,"_5":13195,"_26170":47593,"_2648":47689},[],"`est_rfc7030_settings.auth_mode`",{"_3150":880,"_27660":839,"_19192":47691,"_5":13195,"_26170":47593,"_2648":47692},[],"One of the four authentication modes.",{"_3150":881,"_27660":839,"_19192":47694,"_5":13195,"_26170":47593,"_2648":47695},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3150":882,"_27660":839,"_19192":47697,"_5":13195,"_26170":47597,"_2648":47698},[],"The blocks are independent:",{"_3150":883,"_27660":839,"_19192":47700,"_5":13195,"_26170":47597,"_2648":47701},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3150":884,"_27660":839,"_19192":47703,"_5":13195,"_26170":47597,"_2648":47704},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3150":885,"_27660":839,"_19192":47706,"_5":13195,"_26170":47597,"_2648":47707},[],"`auth_mode`",{"_3150":886,"_27660":839,"_19192":47709,"_5":13195,"_26170":47597,"_2648":47710},[],"Control applied in the configured operation",{"_3150":887,"_27660":839,"_19192":47712,"_5":13195,"_26170":47597,"_2648":47713},[],"`CLIENT_CERTIFICATE`",{"_3150":888,"_27660":839,"_19192":47715,"_5":13195,"_26170":47597,"_2648":47716},[],"Presented certificate validation.",{"_3150":889,"_27660":839,"_19192":47718,"_5":13195,"_26170":47597,"_2648":47719},[],"`EXTERNAL_WEBHOOK`",{"_3150":890,"_27660":839,"_19192":47721,"_5":13195,"_26170":47597,"_2648":47722},[],"Configured webhook authorization.",{"_3150":891,"_27660":839,"_19192":47724,"_5":13195,"_26170":47597,"_2648":47725},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3150":892,"_27660":839,"_19192":47727,"_5":13195,"_26170":47597,"_2648":47728},[],"Certificate validation followed by webhook approval.",{"_3150":893,"_27660":839,"_19192":47730,"_5":13195,"_26170":47597,"_2648":47731},[],"`NO_AUTH`",{"_3150":894,"_27660":839,"_19192":47733,"_5":13195,"_26170":47597,"_2648":47734},[],"No DMS requester authentication.",{"_3150":895,"_27660":839,"_19192":47736,"_5":13195,"_26170":47597,"_2648":47737},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3150":896,"_27660":839,"_19192":47739,"_5":13195,"_26170":47597,"_2648":47740},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3150":897,"_27660":839,"_19192":47742,"_5":13195,"_26170":47597,"_2648":47743},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3150":898,"_27660":839,"_19192":47745,"_5":13195,"_26170":47597,"_2648":47746},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3150":899,"_27660":839,"_19192":47748,"_5":13195,"_26170":47601,"_2648":47749},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3150":900,"_27660":839,"_19192":47751,"_5":13195,"_26170":47601,"_2648":47752},[],"`external_webhook_settings` field",{"_3150":901,"_27660":839,"_19192":47754,"_5":13195,"_26170":47601,"_2648":47662},[],{"_3150":902,"_27660":839,"_19192":47756,"_5":13195,"_26170":47601,"_2648":47757},[],"`url`",{"_3150":903,"_27660":839,"_19192":47759,"_5":13195,"_26170":47601,"_2648":47760},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3150":904,"_27660":839,"_19192":47762,"_5":13195,"_26170":47601,"_2648":47763},[],"`method`",{"_3150":905,"_27660":839,"_19192":47765,"_5":13195,"_26170":47601,"_2648":47766},[],"`POST` or `PUT`; `POST` by default.",{"_3150":906,"_27660":839,"_19192":47768,"_5":13195,"_26170":47601,"_2648":47769},[],"`name`",{"_3150":907,"_27660":839,"_19192":47771,"_5":13195,"_26170":47601,"_2648":47772},[],"Label used in service logs.",{"_3150":908,"_27660":839,"_19192":47774,"_5":13195,"_26170":47601,"_2648":47775},[],"`config.auth_mode`",{"_3150":909,"_27660":839,"_19192":47777,"_5":13195,"_26170":47601,"_2648":47778},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3150":910,"_27660":839,"_19192":47780,"_5":13195,"_26170":47601,"_2648":47781},[],"`config.apikey_options`",{"_3150":911,"_27660":839,"_19192":47783,"_5":13195,"_26170":47601,"_2648":47784},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3150":912,"_27660":839,"_19192":47786,"_5":13195,"_26170":47601,"_2648":47787},[],"`config.jwt_options`",{"_3150":913,"_27660":839,"_19192":47789,"_5":13195,"_26170":47601,"_2648":47790},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3150":914,"_27660":839,"_19192":47792,"_5":13195,"_26170":47601,"_2648":47793},[],"`config.mtls_options`",{"_3150":915,"_27660":839,"_19192":47795,"_5":13195,"_26170":47601,"_2648":47796},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3150":916,"_27660":839,"_19192":47798,"_5":13195,"_26170":47601,"_2648":47799},[],"`config.insecure_skip_verify`",{"_3150":917,"_27660":839,"_19192":47801,"_5":13195,"_26170":47601,"_2648":47802},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3150":918,"_27660":839,"_19192":47804,"_5":13195,"_26170":47601,"_2648":47805},[],"`config.call_timeout`",{"_3150":919,"_27660":839,"_19192":47807,"_5":13195,"_26170":47601,"_2648":47808},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3150":920,"_27660":839,"_19192":47810,"_5":13195,"_26170":47601,"_2648":47811},[],"Rules for that configuration:",{"_3150":921,"_27660":839,"_19192":47813,"_5":13195,"_26170":47601,"_2648":47814},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3150":922,"_27660":839,"_19192":47816,"_5":13195,"_26170":47601,"_2648":47817},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3150":923,"_27660":839,"_19192":47819,"_5":13195,"_26170":47601,"_2648":47820},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3150":924,"_27660":839,"_19192":47822,"_5":13195,"_26170":47601,"_2648":47823},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3150":925,"_27660":839,"_19192":47825,"_5":13195,"_26170":47601,"_2648":47826},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3150":926,"_27660":839,"_19192":47828,"_5":13195,"_26170":47601,"_2648":47829},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3150":927,"_27660":839,"_19192":47831,"_5":13195,"_26170":47601,"_2648":47832},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_3150":928,"_27660":839,"_19192":47834,"_5":13195,"_26170":47601,"_2648":47835},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3150":929,"_27660":839,"_19192":47837,"_5":13195,"_26170":47601,"_2648":47838},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3150":930,"_27660":839,"_19192":47840,"_5":13195,"_26170":47605,"_2648":47841},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3150":931,"_27660":839,"_19192":47843,"_5":13195,"_26170":47609,"_2648":47844},[],"`settings.reenrollment_settings` field",{"_3150":932,"_27660":839,"_19192":47846,"_5":13195,"_26170":47609,"_2648":45328},[],{"_3150":933,"_27660":839,"_19192":47848,"_5":13195,"_26170":47609,"_2648":47849},[],"`reenrollment_delta`",{"_3150":934,"_27660":839,"_19192":47851,"_5":13195,"_26170":47609,"_2648":47852},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3150":935,"_27660":839,"_19192":47854,"_5":13195,"_26170":47609,"_2648":47855},[],"`preventive_delta`",{"_3150":936,"_27660":839,"_19192":47857,"_5":13195,"_26170":47609,"_2648":47858},[],"Preventive operational monitoring threshold.",{"_3150":937,"_27660":839,"_19192":47860,"_5":13195,"_26170":47609,"_2648":47861},[],"`critical_delta`",{"_3150":938,"_27660":839,"_19192":47863,"_5":13195,"_26170":47609,"_2648":47864},[],"Critical operational monitoring threshold.",{"_3150":939,"_27660":839,"_19192":47866,"_5":13195,"_26170":47609,"_2648":47867},[],"`enable_expired_renewal`",{"_3150":940,"_27660":839,"_19192":47869,"_5":13195,"_26170":47609,"_2648":47870},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3150":941,"_27660":839,"_19192":47872,"_5":13195,"_26170":47609,"_2648":47873},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3150":942,"_27660":839,"_19192":47875,"_5":13195,"_26170":47609,"_2648":47876},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_3150":943,"_27660":839,"_19192":47878,"_5":13195,"_26170":47609,"_2648":47879},[],"`revoke_on_reenrollment`",{"_3150":944,"_27660":839,"_19192":47881,"_5":13195,"_26170":47609,"_2648":47882},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3150":945,"_27660":839,"_19192":47884,"_5":13195,"_26170":47609,"_2648":47885},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3150":946,"_27660":839,"_19192":47887,"_5":13195,"_26170":47613,"_2648":47888},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3150":947,"_27660":839,"_19192":47890,"_5":13195,"_26170":47617,"_2648":45322},[],{"_3150":948,"_27660":839,"_19192":47892,"_5":13195,"_26170":47617,"_2648":47893},[],"Published material",{"_3150":949,"_27660":839,"_19192":47895,"_5":13195,"_26170":47617,"_2648":47896},[],"**Include Lamassu System CA**",{"_3150":950,"_27660":839,"_19192":47898,"_5":13195,"_26170":47617,"_2648":47899},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3150":951,"_27660":839,"_19192":47901,"_5":13195,"_26170":47617,"_2648":47902},[],"**Include Enrollment CA**",{"_3150":952,"_27660":839,"_19192":47904,"_5":13195,"_26170":47617,"_2648":47905},[],"Selected issuing CA certificate.",{"_3150":953,"_27660":839,"_19192":47907,"_5":13195,"_26170":47617,"_2648":47908},[],"**Managed CAs**",{"_3150":954,"_27660":839,"_19192":47910,"_5":13195,"_26170":47617,"_2648":47911},[],"Explicitly selected CA certificates.",{"_3150":955,"_27660":839,"_19192":47913,"_5":13195,"_26170":47617,"_2648":47914},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3150":956,"_27660":839,"_19192":47916,"_5":13195,"_26170":47621,"_2648":47917},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_3150":957,"_27660":839,"_19192":47919,"_5":13195,"_26170":47621,"_2648":47920},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3150":958,"_27660":839,"_19192":47922,"_5":13195,"_26170":47621,"_2648":47923},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3150":959,"_27660":839,"_19192":47925,"_5":13195,"_26170":47625,"_2648":47926},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3150":960,"_27660":960,"_5":13521,"_2648":47928,"_27982":47929,"_19192":47930,"_26170":960},"Integrate the EST client",[44938,46318,47295,47293,47476],[],{"_3150":961,"_27660":960,"_19192":47932,"_5":13195,"_26170":960,"_2648":47933},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3150":962,"_27660":960,"_5":27979,"_19192":47935,"_26170":47936,"_2648":44948},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3150":963,"_27660":960,"_5":27979,"_19192":47938,"_26170":47939,"_2648":47940},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3150":964,"_27660":960,"_5":27979,"_19192":47942,"_26170":47943,"_2648":47944},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3150":965,"_27660":960,"_5":27979,"_19192":47946,"_26170":47947,"_2648":47948},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3150":966,"_27660":960,"_5":27979,"_19192":47950,"_26170":47951,"_2648":47952},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3150":967,"_27660":960,"_5":27979,"_19192":47954,"_26170":47955,"_2648":47956},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3150":968,"_27660":960,"_19192":47958,"_5":13195,"_26170":960,"_2648":47959},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3150":969,"_27660":960,"_19192":47961,"_5":13195,"_26170":47936,"_2648":47962},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3150":970,"_27660":960,"_19192":47964,"_5":13195,"_26170":47936,"_2648":47965},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3150":971,"_27660":960,"_19192":47967,"_5":13195,"_26170":47936,"_2648":47968},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3150":972,"_27660":960,"_19192":47970,"_5":13195,"_26170":47939,"_2648":47971},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3150":973,"_27660":960,"_19192":47973,"_5":13195,"_26170":47939,"_2648":47974},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3150":974,"_27660":960,"_19192":47976,"_5":13195,"_26170":47943,"_2648":47977},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3150":975,"_27660":960,"_19192":47979,"_5":13195,"_26170":47943,"_2648":47980},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3150":976,"_27660":960,"_19192":47982,"_5":13195,"_26170":47947,"_2648":47983},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3150":977,"_27660":960,"_19192":47985,"_5":13195,"_26170":47947,"_2648":47986},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3150":978,"_27660":960,"_19192":47988,"_5":13195,"_26170":47951,"_2648":47989},[],"For a root that issues directly:",{"_3150":979,"_27660":960,"_19192":47991,"_5":13195,"_26170":47951,"_2648":47992},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3150":980,"_27660":960,"_19192":47994,"_5":13195,"_26170":47951,"_2648":47995},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3150":981,"_27660":960,"_19192":47997,"_5":13195,"_26170":47955,"_2648":47998},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3150":982,"_27660":982,"_5":13521,"_2648":48000,"_27982":48001,"_19192":48002,"_26170":982},"EST reference",[44938,46318,47295,47293,47476],[],{"_3150":983,"_27660":982,"_19192":48004,"_5":13195,"_26170":982,"_2648":48005},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3150":984,"_27660":982,"_5":27979,"_19192":48007,"_26170":48008,"_2648":48009},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3150":985,"_27660":982,"_5":27979,"_19192":48011,"_26170":48012,"_2648":20858},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3150":986,"_27660":982,"_5":27979,"_19192":48014,"_26170":48015,"_2648":23913},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3150":987,"_27660":982,"_5":27979,"_19192":48017,"_26170":48018,"_2648":23920},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3150":988,"_27660":982,"_5":27979,"_19192":48020,"_26170":48021,"_2648":23266},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3150":989,"_27660":982,"_5":27979,"_19192":48023,"_26170":48024,"_2648":48025},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3150":990,"_27660":982,"_5":27979,"_19192":48027,"_26170":48028,"_2648":48029},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3150":991,"_27660":982,"_5":27979,"_19192":48031,"_26170":48032,"_2648":48033},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3150":992,"_27660":982,"_19192":48035,"_5":13195,"_26170":982,"_2648":48036},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3150":993,"_27660":982,"_19192":48038,"_5":13195,"_26170":48008,"_2648":48039},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3150":994,"_27660":982,"_19192":48041,"_5":13195,"_26170":48008,"_2648":48042},[],"Operation",{"_3150":995,"_27660":982,"_19192":48044,"_5":13195,"_26170":48008,"_2648":48045},[],"Method",{"_3150":996,"_27660":982,"_19192":48047,"_5":13195,"_26170":48008,"_2648":48048},[],"Authentication and condition",{"_3150":997,"_27660":982,"_19192":48050,"_5":13195,"_26170":48008,"_2648":48051},[],"`/cacerts`",{"_3150":998,"_27660":982,"_19192":48053,"_5":13195,"_26170":48008,"_2648":48054},[],"GET",{"_3150":999,"_27660":982,"_19192":48056,"_5":13195,"_26170":48008,"_2648":48057},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3150":1000,"_27660":982,"_19192":48059,"_5":13195,"_26170":48008,"_2648":48060},[],"`/simpleenroll`",{"_3150":1001,"_27660":982,"_19192":48062,"_5":13195,"_26170":48008,"_2648":48063},[],"POST",{"_3150":1002,"_27660":982,"_19192":48065,"_5":13195,"_26170":48008,"_2648":48066},[],"Initial authentication and DMS registration/replacement policy.",{"_3150":1003,"_27660":982,"_19192":48068,"_5":13195,"_26170":48008,"_2648":48069},[],"`/simplereenroll`",{"_3150":1004,"_27660":982,"_19192":48071,"_5":13195,"_26170":48008,"_2648":48063},[],{"_3150":1005,"_27660":982,"_19192":48073,"_5":13195,"_26170":48008,"_2648":48074},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3150":1006,"_27660":982,"_19192":48076,"_5":13195,"_26170":48008,"_2648":48077},[],"`/serverkeygen`",{"_3150":1007,"_27660":982,"_19192":48079,"_5":13195,"_26170":48008,"_2648":48063},[],{"_3150":1008,"_27660":982,"_19192":48081,"_5":13195,"_26170":48008,"_2648":48082},[],"Initial authentication and admission; server generation enabled.",{"_3150":1009,"_27660":982,"_19192":48084,"_5":13195,"_26170":48008,"_2648":48085},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3150":1010,"_27660":982,"_19192":48087,"_5":13195,"_26170":48012,"_2648":48088},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3150":1011,"_27660":982,"_19192":48090,"_5":13195,"_26170":48012,"_2648":48091},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3150":1012,"_27660":982,"_19192":48093,"_5":13195,"_26170":48015,"_2648":48094},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3150":1013,"_27660":982,"_19192":48096,"_5":13195,"_26170":48015,"_2648":48097},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3150":1014,"_27660":982,"_19192":48099,"_5":13195,"_26170":48018,"_2648":48100},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3150":1015,"_27660":982,"_19192":48102,"_5":13195,"_26170":48018,"_2648":48103},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3150":1016,"_27660":982,"_19192":48105,"_5":13195,"_26170":48021,"_2648":48106},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3150":1017,"_27660":982,"_19192":48108,"_5":13195,"_26170":48021,"_2648":48109},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3150":1018,"_27660":982,"_19192":48111,"_5":13195,"_26170":48024,"_2648":48112},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3150":1019,"_27660":982,"_19192":48114,"_5":13195,"_26170":48024,"_2648":48115},[],"Part",{"_3150":1020,"_27660":982,"_19192":48117,"_5":13195,"_26170":48024,"_2648":48118},[],"Content after decoding its Base64",{"_3150":1021,"_27660":982,"_19192":48120,"_5":13195,"_26170":48024,"_2648":48121},[],"`application/pkcs8`",{"_3150":1022,"_27660":982,"_19192":48123,"_5":13195,"_26170":48024,"_2648":48124},[],"Unencrypted DER PKCS#8 private key.",{"_3150":1023,"_27660":982,"_19192":48126,"_5":13195,"_26170":48024,"_2648":48127},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3150":1024,"_27660":982,"_19192":48129,"_5":13195,"_26170":48024,"_2648":48130},[],"DER PKCS#7 containing the issued certificate.",{"_3150":1025,"_27660":982,"_19192":48132,"_5":13195,"_26170":48024,"_2648":48133},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3150":1026,"_27660":982,"_19192":48135,"_5":13195,"_26170":48028,"_2648":48136},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3150":1027,"_27660":982,"_19192":48138,"_5":13195,"_26170":48028,"_2648":48139},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3150":1028,"_27660":982,"_19192":48141,"_5":13195,"_26170":48028,"_2648":48142},[],"Convert and check the result:",{"_3150":1029,"_27660":982,"_19192":48144,"_5":13195,"_26170":48028,"_2648":48145},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3150":1030,"_27660":982,"_19192":48147,"_5":13195,"_26170":48032,"_2648":48148},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3150":1031,"_27660":982,"_19192":48150,"_5":13195,"_26170":48032,"_2648":48151},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3150":1032,"_27660":1032,"_5":13521,"_2648":47476,"_27982":48153,"_19192":48154,"_26170":1032},[44938,46318,47295,47293,47476],[],{"_3150":1033,"_27660":1032,"_19192":48156,"_5":13195,"_26170":1032,"_2648":48157},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3150":1034,"_27660":1032,"_5":27979,"_19192":48159,"_26170":48160,"_2648":48161},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3150":1035,"_27660":1032,"_5":27979,"_19192":48163,"_26170":48164,"_2648":48165},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3150":1036,"_27660":1032,"_5":27979,"_19192":48167,"_26170":48168,"_2648":48169},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3150":1037,"_27660":1032,"_5":27979,"_19192":48171,"_26170":48172,"_2648":48173},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3150":1038,"_27660":1032,"_19192":48175,"_5":13195,"_26170":1032,"_2648":48176},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3150":1039,"_27660":1032,"_19192":48178,"_5":13195,"_26170":48160,"_2648":48179},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3150":1040,"_27660":1032,"_19192":48181,"_5":13195,"_26170":48160,"_2648":48182},[],"The integrator installs initial EST server trust and an admission credential.",{"_3150":1041,"_27660":1032,"_19192":48184,"_5":13195,"_26170":48160,"_2648":48185},[],"The client requests an identity for its `Device ID` through EST.",{"_3150":1042,"_27660":1032,"_19192":48187,"_5":13195,"_26170":48160,"_2648":48188},[],"Certificate, device binding and key/certificate installation are checked.",{"_3150":1043,"_27660":1032,"_19192":48190,"_5":13195,"_26170":48160,"_2648":48191},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3150":1044,"_27660":1032,"_19192":48193,"_5":13195,"_26170":48160,"_2648":48194},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3150":1045,"_27660":1032,"_19192":48196,"_5":13195,"_26170":48164,"_2648":48197},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3150":1046,"_27660":1032,"_19192":48199,"_5":13195,"_26170":48164,"_2648":48200},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1047,"_27660":1032,"_19192":48202,"_5":13195,"_26170":48164,"_2648":48203},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3150":1048,"_27660":1032,"_19192":48205,"_5":13195,"_26170":48164,"_2648":48206},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3150":1049,"_27660":1032,"_19192":48208,"_5":13195,"_26170":48168,"_2648":48209},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":1050,"_27660":1032,"_19192":48211,"_5":13195,"_26170":48168,"_2648":48212},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3150":1051,"_27660":1032,"_19192":48214,"_5":13195,"_26170":48168,"_2648":48215},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3150":1052,"_27660":1032,"_19192":48217,"_5":13195,"_26170":48168,"_2648":48218},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3150":1053,"_27660":1032,"_19192":48220,"_5":13195,"_26170":48172,"_2648":48221},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3150":1054,"_27660":1032,"_19192":48223,"_5":13195,"_26170":48172,"_2648":48224},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3150":1055,"_27660":1055,"_5":13521,"_2648":48226,"_27982":48227,"_19192":48228,"_26170":1055},"Provisioning strategies",[44938,46318,47295,47293,47476],[],{"_3150":1056,"_27660":1055,"_19192":48230,"_5":13195,"_26170":1055,"_2648":48231},[],"Choose device registration, identity authorization and key generation.",{"_3150":1057,"_27660":1055,"_5":27979,"_19192":48233,"_26170":48234,"_2648":48235},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3150":1058,"_27660":1055,"_5":27979,"_19192":48237,"_26170":48238,"_2648":48239},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3150":1059,"_27660":1055,"_5":27979,"_19192":48241,"_26170":48242,"_2648":48243},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3150":1060,"_27660":1055,"_5":27979,"_19192":48245,"_26170":48246,"_2648":48247},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3150":1061,"_27660":1055,"_5":27979,"_19192":48249,"_26170":48250,"_2648":48251},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3150":1062,"_27660":1055,"_19192":48253,"_5":13195,"_26170":1055,"_2648":48254},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3150":1063,"_27660":1055,"_19192":48256,"_5":13195,"_26170":48234,"_2648":48257},[],"Path",{"_3150":1064,"_27660":1055,"_19192":48259,"_5":13195,"_26170":48234,"_2648":48260},[],"When the device exists",{"_3150":1065,"_27660":1055,"_19192":48262,"_5":13195,"_26170":48234,"_2648":48263},[],"What to check",{"_3150":1066,"_27660":1055,"_19192":48265,"_5":13195,"_26170":48234,"_2648":48266},[],"Manual assignment",{"_3150":1067,"_27660":1055,"_19192":48268,"_5":13195,"_26170":48234,"_2648":48269},[],"An operator creates it before associating a certificate.",{"_3150":1068,"_27660":1055,"_19192":48271,"_5":13195,"_26170":48234,"_2648":48272},[],"ID, owning DMS, certificate CN and bound serial.",{"_3150":1069,"_27660":1055,"_19192":48274,"_5":13195,"_26170":48234,"_2648":48275},[],"EST with `JITP`",{"_3150":1070,"_27660":1055,"_19192":48277,"_5":13195,"_26170":48234,"_2648":48278},[],"Created for an unknown CN during `/simpleenroll`.",{"_3150":1071,"_27660":1055,"_19192":48280,"_5":13195,"_26170":48234,"_2648":48281},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3150":1072,"_27660":1055,"_19192":48283,"_5":13195,"_26170":48234,"_2648":48284},[],"EST with `PRE_REGISTRATION`",{"_3150":1073,"_27660":1055,"_19192":48286,"_5":13195,"_26170":48234,"_2648":48287},[],"Must exist before `/simpleenroll`.",{"_3150":1074,"_27660":1055,"_19192":48289,"_5":13195,"_26170":48234,"_2648":48290},[],"Approved record, same DMS and replacement conditions for your version.",{"_3150":1075,"_27660":1055,"_19192":48292,"_5":13195,"_26170":48234,"_2648":48293},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3150":1076,"_27660":1055,"_19192":48295,"_5":13195,"_26170":48234,"_2648":48296},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3150":1077,"_27660":1055,"_19192":48298,"_5":13195,"_26170":48238,"_2648":48299},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3150":1078,"_27660":1055,"_19192":48301,"_5":13195,"_26170":48238,"_2648":48302},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3150":1079,"_27660":1055,"_19192":48304,"_5":13195,"_26170":48238,"_2648":48305},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3150":1080,"_27660":1055,"_19192":48307,"_5":13195,"_26170":48242,"_2648":48308},[],"Decide initial enrollment and re-enrollment separately:",{"_3150":1081,"_27660":1055,"_19192":48310,"_5":13195,"_26170":48242,"_2648":48311},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3150":1082,"_27660":1055,"_19192":48313,"_5":13195,"_26170":48242,"_2648":48314},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3150":1083,"_27660":1055,"_19192":48316,"_5":13195,"_26170":48242,"_2648":48317},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3150":1084,"_27660":1055,"_19192":48319,"_5":13195,"_26170":48242,"_2648":48320},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3150":1085,"_27660":1055,"_19192":48322,"_5":13195,"_26170":48242,"_2648":48323},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3150":1086,"_27660":1055,"_19192":48325,"_5":13195,"_26170":48246,"_2648":45322},[],{"_3150":1087,"_27660":1055,"_19192":48327,"_5":13195,"_26170":48246,"_2648":48328},[],"Material crossing EST",{"_3150":1088,"_27660":1055,"_19192":48330,"_5":13195,"_26170":48246,"_2648":48331},[],"Device-generated key",{"_3150":1089,"_27660":1055,"_19192":48333,"_5":13195,"_26170":48246,"_2648":48334},[],"Public CSR and certificate; the key stays on the client.",{"_3150":1090,"_27660":1055,"_19192":48336,"_5":13195,"_26170":48246,"_2648":48337},[],"Existing device key",{"_3150":1091,"_27660":1055,"_19192":48339,"_5":13195,"_26170":48246,"_2648":48340},[],"CSR signed with that key and a new certificate.",{"_3150":1092,"_27660":1055,"_19192":48342,"_5":13195,"_26170":48246,"_2648":47614},[],{"_3150":1093,"_27660":1055,"_19192":48344,"_5":13195,"_26170":48246,"_2648":48345},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3150":1094,"_27660":1055,"_19192":48347,"_5":13195,"_26170":48246,"_2648":48348},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3150":1095,"_27660":1055,"_19192":48350,"_5":13195,"_26170":48250,"_2648":48351},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3150":1096,"_27660":1096,"_5":13521,"_2648":48353,"_27982":48354,"_19192":48355,"_26170":1096},"Renewal and recovery",[44938,46318,47295,47293,47476],[],{"_3150":1097,"_27660":1096,"_19192":48357,"_5":13195,"_26170":1096,"_2648":48358},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3150":1098,"_27660":1096,"_5":27979,"_19192":48360,"_26170":48361,"_2648":48362},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3150":1099,"_27660":1096,"_5":27979,"_19192":48364,"_26170":48365,"_2648":48366},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3150":1100,"_27660":1096,"_5":27979,"_19192":48368,"_26170":48369,"_2648":48370},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3150":1101,"_27660":1096,"_5":27979,"_19192":48372,"_26170":48373,"_2648":48374},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3150":1102,"_27660":1096,"_5":27979,"_19192":48376,"_26170":48377,"_2648":48378},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3150":1103,"_27660":1096,"_19192":48380,"_5":13195,"_26170":1096,"_2648":48381},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3150":1104,"_27660":1096,"_19192":48383,"_5":13195,"_26170":48361,"_2648":48384},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3150":1105,"_27660":1096,"_19192":48386,"_5":13195,"_26170":48361,"_2648":48387},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3150":1106,"_27660":1096,"_19192":48389,"_5":13195,"_26170":48361,"_2648":48390},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3150":1107,"_27660":1096,"_19192":48392,"_5":13195,"_26170":48361,"_2648":48393},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3150":1108,"_27660":1096,"_19192":48395,"_5":13195,"_26170":48365,"_2648":48396},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3150":1109,"_27660":1096,"_19192":48398,"_5":13195,"_26170":48365,"_2648":48399},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3150":1110,"_27660":1096,"_19192":48401,"_5":13195,"_26170":48369,"_2648":48402},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3150":1111,"_27660":1096,"_19192":48404,"_5":13195,"_26170":48369,"_2648":48405},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3150":1112,"_27660":1096,"_19192":48407,"_5":13195,"_26170":48369,"_2648":48408},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3150":1113,"_27660":1096,"_19192":48410,"_5":13195,"_26170":48373,"_2648":48411},[],"Situation",{"_3150":1114,"_27660":1096,"_19192":48413,"_5":13195,"_26170":48373,"_2648":48414},[],"Procedure",{"_3150":1115,"_27660":1096,"_19192":48416,"_5":13195,"_26170":48373,"_2648":48417},[],"Valid certificate, outside the window",{"_3150":1116,"_27660":1096,"_19192":48419,"_5":13195,"_26170":48373,"_2648":48420},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3150":1117,"_27660":1096,"_19192":48422,"_5":13195,"_26170":48373,"_2648":48423},[],"Expired certificate, key available",{"_3150":1118,"_27660":1096,"_19192":48425,"_5":13195,"_26170":48373,"_2648":48426},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3150":1119,"_27660":1096,"_19192":48428,"_5":13195,"_26170":48373,"_2648":48429},[],"Renewal through webhook or `NO_AUTH`",{"_3150":1120,"_27660":1096,"_19192":48431,"_5":13195,"_26170":48373,"_2648":48432},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3150":1121,"_27660":1096,"_19192":48434,"_5":13195,"_26170":48373,"_2648":48435},[],"Lost or inaccessible key",{"_3150":1122,"_27660":1096,"_19192":48437,"_5":13195,"_26170":48373,"_2648":48438},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3150":1123,"_27660":1096,"_19192":48440,"_5":13195,"_26170":48373,"_2648":48441},[],"Current identity revoked",{"_3150":1124,"_27660":1096,"_19192":48443,"_5":13195,"_26170":48373,"_2648":48444},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3150":1125,"_27660":1096,"_19192":48446,"_5":13195,"_26170":48373,"_2648":48447},[],"Device without an identity",{"_3150":1126,"_27660":1096,"_19192":48449,"_5":13195,"_26170":48373,"_2648":48450},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3150":1127,"_27660":1096,"_19192":48452,"_5":13195,"_26170":48373,"_2648":48453},[],"Retired device",{"_3150":1128,"_27660":1096,"_19192":48455,"_5":13195,"_26170":48373,"_2648":48456},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3150":1129,"_27660":1096,"_19192":48458,"_5":13195,"_26170":48373,"_2648":48459},[],"Timeout, HTTP 500 or installation failure",{"_3150":1130,"_27660":1096,"_19192":48461,"_5":13195,"_26170":48373,"_2648":48462},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3150":1131,"_27660":1096,"_19192":48464,"_5":13195,"_26170":48377,"_2648":48465},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3150":1132,"_27660":1096,"_19192":48467,"_5":13195,"_26170":48377,"_2648":48468},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3150":1133,"_27660":1133,"_5":13521,"_2648":48470,"_27982":48471,"_19192":48472,"_26170":1133},"Enrollment troubleshooting",[44938,46318,47295,47293,47476],[],{"_3150":1134,"_27660":1133,"_19192":48474,"_5":13195,"_26170":1133,"_2648":48475},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3150":1135,"_27660":1133,"_5":27979,"_19192":48477,"_26170":48478,"_2648":48479},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3150":1136,"_27660":1133,"_5":27979,"_19192":48481,"_26170":48482,"_2648":48483},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3150":1137,"_27660":1133,"_5":27979,"_19192":48485,"_26170":48486,"_2648":48033},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3150":1138,"_27660":1133,"_5":27979,"_19192":48488,"_26170":48489,"_2648":48490},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3150":1139,"_27660":1133,"_19192":48492,"_5":13195,"_26170":1133,"_2648":48493},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3150":1140,"_27660":1133,"_19192":48495,"_5":13195,"_26170":48482,"_2648":48496},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3150":1141,"_27660":1133,"_19192":48498,"_5":13195,"_26170":48482,"_2648":48499},[],"Symptom or message",{"_3150":1142,"_27660":1133,"_19192":48501,"_5":13195,"_26170":48482,"_2648":48263},[],{"_3150":1143,"_27660":1133,"_19192":48503,"_5":13195,"_26170":48482,"_2648":48504},[],"curl rejects TLS, name or issuer",{"_3150":1144,"_27660":1133,"_19192":48506,"_5":13195,"_26170":48482,"_2648":48507},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3150":1145,"_27660":1133,"_19192":48509,"_5":13195,"_26170":48482,"_2648":48510},[],"404 or missing APS",{"_3150":1146,"_27660":1133,"_19192":48512,"_5":13195,"_26170":48482,"_2648":48513},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3150":1147,"_27660":1133,"_19192":48515,"_5":13195,"_26170":48482,"_2648":48516},[],"400, CSR or format error",{"_3150":1148,"_27660":1133,"_19192":48518,"_5":13195,"_26170":48482,"_2648":48519},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3150":1149,"_27660":1133,"_19192":48521,"_5":13195,"_26170":48482,"_2648":48522},[],"Missing credential or invalid certificate",{"_3150":1150,"_27660":1133,"_19192":48524,"_5":13195,"_26170":48482,"_2648":48525},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3150":1151,"_27660":1133,"_19192":48527,"_5":13195,"_26170":48482,"_2648":48528},[],"Webhook denies, times out or responds without authorization",{"_3150":1152,"_27660":1133,"_19192":48530,"_5":13195,"_26170":48482,"_2648":48531},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3150":1153,"_27660":1133,"_19192":48533,"_5":13195,"_26170":48482,"_2648":48534},[],"`unexpected status code: <n>: redirects are not followed`",{"_3150":1154,"_27660":1133,"_19192":48536,"_5":13195,"_26170":48482,"_2648":48537},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3150":1155,"_27660":1133,"_19192":48539,"_5":13195,"_26170":48482,"_2648":48540},[],"`webhook response exceeds 1048576 bytes`",{"_3150":1156,"_27660":1133,"_19192":48542,"_5":13195,"_26170":48482,"_2648":48543},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3150":1157,"_27660":1133,"_19192":48545,"_5":13195,"_26170":48482,"_2648":48546},[],"`webhook config must not reference files`",{"_3150":1158,"_27660":1133,"_19192":48548,"_5":13195,"_26170":48482,"_2648":48549},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3150":1159,"_27660":1133,"_19192":48551,"_5":13195,"_26170":48482,"_2648":48552},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3150":1160,"_27660":1133,"_19192":48554,"_5":13195,"_26170":48482,"_2648":48555},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3150":1161,"_27660":1133,"_19192":48557,"_5":13195,"_26170":48482,"_2648":48558},[],"`webhook mTLS certificate and key are invalid: …`",{"_3150":1162,"_27660":1133,"_19192":48560,"_5":13195,"_26170":48482,"_2648":48561},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3150":1163,"_27660":1133,"_19192":48563,"_5":13195,"_26170":48482,"_2648":48564},[],"400 `struct validation error` creating or updating a DMS",{"_3150":1164,"_27660":1133,"_19192":48566,"_5":13195,"_26170":48482,"_2648":48567},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3150":1165,"_27660":1133,"_19192":48569,"_5":13195,"_26170":48482,"_2648":48570},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3150":1166,"_27660":1133,"_19192":48572,"_5":13195,"_26170":48482,"_2648":48573},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3150":1167,"_27660":1133,"_19192":48575,"_5":13195,"_26170":48482,"_2648":48576},[],"`device not preregistered`",{"_3150":1168,"_27660":1133,"_19192":48578,"_5":13195,"_26170":48482,"_2648":48579},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3150":1169,"_27660":1133,"_19192":48581,"_5":13195,"_26170":48482,"_2648":48582},[],"`forbiddenNewEnrollment`",{"_3150":1170,"_27660":1133,"_19192":48584,"_5":13195,"_26170":48482,"_2648":48585},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3150":1171,"_27660":1133,"_19192":48587,"_5":13195,"_26170":48482,"_2648":48588},[],"Different owning DMS",{"_3150":1172,"_27660":1133,"_19192":48590,"_5":13195,"_26170":48482,"_2648":48591},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3150":1173,"_27660":1133,"_19192":48593,"_5":13195,"_26170":48482,"_2648":48594},[],"`invalid RawSubject bytes`",{"_3150":1174,"_27660":1133,"_19192":48596,"_5":13195,"_26170":48482,"_2648":48597},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3150":1175,"_27660":1133,"_19192":48599,"_5":13195,"_26170":48482,"_2648":48600},[],"`invalid reenroll window`",{"_3150":1176,"_27660":1133,"_19192":48602,"_5":13195,"_26170":48482,"_2648":48603},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3150":1177,"_27660":1133,"_19192":48605,"_5":13195,"_26170":48482,"_2648":48606},[],"Current certificate revoked",{"_3150":1178,"_27660":1133,"_19192":48608,"_5":13195,"_26170":48482,"_2648":48609},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3150":1179,"_27660":1133,"_19192":48611,"_5":13195,"_26170":48482,"_2648":48612},[],"CA, profile or signing error",{"_3150":1180,"_27660":1133,"_19192":48614,"_5":13195,"_26170":48482,"_2648":48615},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3150":1181,"_27660":1133,"_19192":48617,"_5":13195,"_26170":48482,"_2648":48618},[],"HTTP 200 without a device connection",{"_3150":1182,"_27660":1133,"_19192":48620,"_5":13195,"_26170":48482,"_2648":48621},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3150":1183,"_27660":1133,"_19192":48623,"_5":13195,"_26170":48482,"_2648":48624},[],"Timeout or error after issuance",{"_3150":1184,"_27660":1133,"_19192":48626,"_5":13195,"_26170":48482,"_2648":48627},[],"New certificates, current slot and previous identity's state before retrying.",{"_3150":1185,"_27660":1133,"_19192":48629,"_5":13195,"_26170":48486,"_2648":48630},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3150":1186,"_27660":1133,"_19192":48632,"_5":13195,"_26170":48486,"_2648":48633},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3150":1187,"_27660":1133,"_19192":48635,"_5":13195,"_26170":48489,"_2648":48636},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3150":1188,"_27660":1133,"_19192":48638,"_5":13195,"_26170":48489,"_2648":48639},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3150":1189,"_27660":1133,"_19192":48641,"_5":13195,"_26170":48489,"_2648":48642},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3150":1190,"_27660":1133,"_19192":48644,"_5":13195,"_26170":48489,"_2648":48645},[],"Make one request, save headers/body and query the device and certificates.",{"_3150":1191,"_27660":1133,"_19192":48647,"_5":13195,"_26170":48489,"_2648":48648},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3150":1192,"_27660":1133,"_19192":48650,"_5":13195,"_26170":48489,"_2648":48651},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3150":1193,"_27660":1133,"_19192":48653,"_5":13195,"_26170":48489,"_2648":48654},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3150":1194,"_27660":1194,"_5":13521,"_2648":48656,"_27982":48657,"_19192":48658,"_26170":1194},"Trust distribution and updates",[44938,46318,47295,47293,47476],[],{"_3150":1195,"_27660":1194,"_19192":48660,"_5":13195,"_26170":1194,"_2648":48661},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3150":1196,"_27660":1194,"_5":27979,"_19192":48663,"_26170":48664,"_2648":48665},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3150":1197,"_27660":1194,"_5":27979,"_19192":48667,"_26170":48668,"_2648":48669},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3150":1198,"_27660":1194,"_5":27979,"_19192":48671,"_26170":48672,"_2648":48673},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3150":1199,"_27660":1194,"_5":27979,"_19192":48675,"_26170":48676,"_2648":48677},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3150":1200,"_27660":1194,"_5":27979,"_19192":48679,"_26170":48680,"_2648":48681},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3150":1201,"_27660":1194,"_19192":48683,"_5":13195,"_26170":1194,"_2648":48684},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3150":1202,"_27660":1194,"_19192":48686,"_5":13195,"_26170":48664,"_2648":48687},[],"Relationship",{"_3150":1203,"_27660":1194,"_19192":48689,"_5":13195,"_26170":48664,"_2648":48690},[],"Material prepared by its owner",{"_3150":1204,"_27660":1194,"_19192":48692,"_5":13195,"_26170":48664,"_2648":48693},[],"Device → EST server",{"_3150":1205,"_27660":1194,"_19192":48695,"_5":13195,"_26170":48664,"_2648":48696},[],"Previously verified server root, chain or pin and TLS name.",{"_3150":1206,"_27660":1194,"_19192":48698,"_5":13195,"_26170":48664,"_2648":48699},[],"DMS → requester",{"_3150":1207,"_27660":1194,"_19192":48701,"_5":13195,"_26170":48664,"_2648":48702},[],"CAs and rules authorizing initial or renewal credentials.",{"_3150":1208,"_27660":1194,"_19192":48704,"_5":13195,"_26170":48664,"_2648":48705},[],"Consumer → device",{"_3150":1209,"_27660":1194,"_19192":48707,"_5":13195,"_26170":48664,"_2648":48708},[],"Operational identity roots, intermediates, validation and permissions.",{"_3150":1210,"_27660":1194,"_19192":48710,"_5":13195,"_26170":48664,"_2648":48711},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3150":1211,"_27660":1194,"_19192":48713,"_5":13195,"_26170":48668,"_2648":48714},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3150":1212,"_27660":1194,"_19192":48716,"_5":13195,"_26170":48668,"_2648":48717},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3150":1213,"_27660":1194,"_19192":48719,"_5":13195,"_26170":48672,"_2648":48720},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3150":1214,"_27660":1194,"_19192":48722,"_5":13195,"_26170":48672,"_2648":48723},[],"Select policy-approved roots as anchors.",{"_3150":1215,"_27660":1194,"_19192":48725,"_5":13195,"_26170":48672,"_2648":48726},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3150":1216,"_27660":1194,"_19192":48728,"_5":13195,"_26170":48672,"_2648":48729},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3150":1217,"_27660":1194,"_19192":48731,"_5":13195,"_26170":48672,"_2648":48732},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3150":1218,"_27660":1194,"_19192":48734,"_5":13195,"_26170":48672,"_2648":48735},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3150":1219,"_27660":1194,"_19192":48737,"_5":13195,"_26170":48676,"_2648":48738},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3150":1220,"_27660":1194,"_19192":48740,"_5":13195,"_26170":48676,"_2648":48741},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3150":1221,"_27660":1194,"_19192":48743,"_5":13195,"_26170":48676,"_2648":48744},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3150":1222,"_27660":1194,"_19192":48746,"_5":13195,"_26170":48680,"_2648":48747},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3150":1223,"_27660":1223,"_5":13521,"_2648":48749,"_27982":48750,"_19192":48752,"_26170":1223},"AWS IoT Core",[44938,46318,47295,47293,48751],"Integrations",[],{"_3150":1224,"_27660":1223,"_19192":48754,"_5":13195,"_26170":1223,"_2648":48755},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3150":1225,"_27660":1223,"_5":27979,"_19192":48757,"_26170":48758,"_2648":48759},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3150":1226,"_27660":1223,"_5":27979,"_19192":48761,"_26170":48762,"_2648":48763},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3150":1227,"_27660":1223,"_5":27979,"_19192":48765,"_26170":48766,"_2648":48767},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3150":1228,"_27660":1223,"_5":27979,"_19192":48769,"_26170":48770,"_2648":48771},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3150":1229,"_27660":1223,"_5":27979,"_19192":48773,"_26170":48774,"_2648":48775},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3150":1230,"_27660":1223,"_5":27979,"_19192":48777,"_26170":48778,"_2648":48779},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3150":1231,"_27660":1223,"_5":27979,"_19192":48781,"_26170":48782,"_2648":48783},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3150":1232,"_27660":1223,"_5":27979,"_19192":48785,"_26170":48786,"_2648":48787},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3150":1233,"_27660":1223,"_5":27979,"_19192":48789,"_26170":48790,"_2648":48791},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3150":1234,"_27660":1223,"_5":27979,"_19192":48793,"_26170":48794,"_2648":48795},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3150":1235,"_27660":1223,"_5":27979,"_19192":48797,"_26170":48798,"_2648":48799},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3150":1236,"_27660":1223,"_5":27979,"_19192":48801,"_26170":48802,"_2648":48803},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3150":1237,"_27660":1223,"_5":27979,"_19192":48805,"_26170":48806,"_2648":48807},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3150":1238,"_27660":1223,"_5":27979,"_19192":48809,"_26170":48810,"_2648":48811},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3150":1239,"_27660":1223,"_5":27979,"_19192":48813,"_26170":48814,"_2648":48815},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3150":1240,"_27660":1223,"_5":27979,"_19192":48817,"_26170":48818,"_2648":48819},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3150":1241,"_27660":1223,"_5":27979,"_19192":48821,"_26170":48822,"_2648":48823},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3150":1242,"_27660":1223,"_5":27979,"_19192":48825,"_26170":48826,"_2648":48827},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3150":1243,"_27660":1223,"_5":27979,"_19192":48829,"_26170":48830,"_2648":48831},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3150":1244,"_27660":1223,"_5":27979,"_19192":48833,"_26170":48834,"_2648":48835},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3150":1245,"_27660":1223,"_19192":48837,"_5":13195,"_26170":1223,"_2648":48838},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3150":1246,"_27660":1223,"_19192":48840,"_5":13195,"_26170":1223,"_2648":48841},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3150":1247,"_27660":1223,"_19192":48843,"_5":13195,"_26170":1223,"_2648":48844},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3150":1248,"_27660":1223,"_19192":48846,"_5":13195,"_26170":48758,"_2648":48847},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3150":1249,"_27660":1223,"_19192":48849,"_5":13195,"_26170":48758,"_2648":48850},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3150":1250,"_27660":1223,"_19192":48852,"_5":13195,"_26170":48758,"_2648":48853},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3150":1251,"_27660":1223,"_19192":48855,"_5":13195,"_26170":48758,"_2648":48856},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3150":1252,"_27660":1223,"_19192":48858,"_5":13195,"_26170":48762,"_2648":48859},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3150":1253,"_27660":1223,"_19192":48861,"_5":13195,"_26170":48766,"_2648":48862},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3150":1254,"_27660":1223,"_19192":48864,"_5":13195,"_26170":48766,"_2648":48865},[],"IAM action",{"_3150":1255,"_27660":1223,"_19192":48867,"_5":13195,"_26170":48766,"_2648":45328},[],{"_3150":1256,"_27660":1223,"_19192":48869,"_5":13195,"_26170":48766,"_2648":48870},[],"`iot:GetRegistrationCode`",{"_3150":1257,"_27660":1223,"_19192":48872,"_5":13195,"_26170":48766,"_2648":48873},[],"Obtain the verification code for CA registration in the Primary Account",{"_3150":1258,"_27660":1223,"_19192":48875,"_5":13195,"_26170":48766,"_2648":48876},[],"`iot:RegisterCACertificate`",{"_3150":1259,"_27660":1223,"_19192":48878,"_5":13195,"_26170":48766,"_2648":48879},[],"Register the CA in AWS IoT",{"_3150":1260,"_27660":1223,"_19192":48881,"_5":13195,"_26170":48766,"_2648":48882},[],"`iot:DescribeCACertificate`",{"_3150":1261,"_27660":1223,"_19192":48884,"_5":13195,"_26170":48766,"_2648":48885},[],"Check the CA registration status",{"_3150":1262,"_27660":1223,"_19192":48887,"_5":13195,"_26170":48766,"_2648":48888},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3150":1263,"_27660":1223,"_19192":48890,"_5":13195,"_26170":48766,"_2648":48891},[],"Create or update Things in IoT Core",{"_3150":1264,"_27660":1223,"_19192":48893,"_5":13195,"_26170":48766,"_2648":48894},[],"`iot:RegisterThing`",{"_3150":1265,"_27660":1223,"_19192":48896,"_5":13195,"_26170":48766,"_2648":48897},[],"Provision Things through a template",{"_3150":1266,"_27660":1223,"_19192":48899,"_5":13195,"_26170":48766,"_2648":48900},[],"`iot:RegisterCertificate`",{"_3150":1267,"_27660":1223,"_19192":48902,"_5":13195,"_26170":48766,"_2648":48903},[],"Register device certificates",{"_3150":1268,"_27660":1223,"_19192":48905,"_5":13195,"_26170":48766,"_2648":48906},[],"`iot:UpdateCertificate`",{"_3150":1269,"_27660":1223,"_19192":48908,"_5":13195,"_26170":48766,"_2648":48909},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3150":1270,"_27660":1223,"_19192":48911,"_5":13195,"_26170":48766,"_2648":48912},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3150":1271,"_27660":1223,"_19192":48914,"_5":13195,"_26170":48766,"_2648":48915},[],"Create and attach IoT policies",{"_3150":1272,"_27660":1223,"_19192":48917,"_5":13195,"_26170":48766,"_2648":48918},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3150":1273,"_27660":1223,"_19192":48920,"_5":13195,"_26170":48766,"_2648":48921},[],"Manage Thing groups",{"_3150":1274,"_27660":1223,"_19192":48923,"_5":13195,"_26170":48766,"_2648":48924},[],"`iot:CreateProvisioningTemplate`",{"_3150":1275,"_27660":1223,"_19192":48926,"_5":13195,"_26170":48766,"_2648":48927},[],"Create JITP templates",{"_3150":1276,"_27660":1223,"_19192":48929,"_5":13195,"_26170":48766,"_2648":48930},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3150":1277,"_27660":1223,"_19192":48932,"_5":13195,"_26170":48766,"_2648":48933},[],"Read and write the Device Shadow",{"_3150":1278,"_27660":1223,"_19192":48935,"_5":13195,"_26170":48766,"_2648":48936},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3150":1279,"_27660":1223,"_19192":48938,"_5":13195,"_26170":48770,"_2648":48939},[],"Parameter",{"_3150":1280,"_27660":1223,"_19192":48941,"_5":13195,"_26170":48770,"_2648":48942},[],"Type",{"_3150":1281,"_27660":1223,"_19192":48944,"_5":13195,"_26170":48770,"_2648":48945},[],"Required",{"_3150":1282,"_27660":1223,"_19192":48947,"_5":13195,"_26170":48770,"_2648":48948},[],"Description",{"_3150":1283,"_27660":1223,"_19192":48950,"_5":13195,"_26170":48770,"_2648":48951},[],"`connector_id`",{"_3150":1284,"_27660":1223,"_19192":48953,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1285,"_27660":1223,"_19192":48955,"_5":13195,"_26170":48770,"_2648":48956},[],"Yes",{"_3150":1286,"_27660":1223,"_19192":48958,"_5":13195,"_26170":48770,"_2648":48959},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3150":1287,"_27660":1223,"_19192":48961,"_5":13195,"_26170":48770,"_2648":48962},[],"`aws_config.region`",{"_3150":1288,"_27660":1223,"_19192":48964,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1289,"_27660":1223,"_19192":48966,"_5":13195,"_26170":48770,"_2648":48956},[],{"_3150":1290,"_27660":1223,"_19192":48968,"_5":13195,"_26170":48770,"_2648":48969},[],"AWS region where the connector operates.",{"_3150":1291,"_27660":1223,"_19192":48971,"_5":13195,"_26170":48770,"_2648":48972},[],"`aws_config.auth_method`",{"_3150":1292,"_27660":1223,"_19192":48974,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1293,"_27660":1223,"_19192":48976,"_5":13195,"_26170":48770,"_2648":48956},[],{"_3150":1294,"_27660":1223,"_19192":48978,"_5":13195,"_26170":48770,"_2648":48979},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3150":1295,"_27660":1223,"_19192":48981,"_5":13195,"_26170":48770,"_2648":48982},[],"`aws_config.access_key_id`",{"_3150":1296,"_27660":1223,"_19192":48984,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1297,"_27660":1223,"_19192":48986,"_5":13195,"_26170":48770,"_2648":48987},[],"Only with `auth_method=static`",{"_3150":1298,"_27660":1223,"_19192":48989,"_5":13195,"_26170":48770,"_2648":48990},[],"AWS access key.",{"_3150":1299,"_27660":1223,"_19192":48992,"_5":13195,"_26170":48770,"_2648":48993},[],"`aws_config.secret_access_key`",{"_3150":1300,"_27660":1223,"_19192":48995,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1301,"_27660":1223,"_19192":48997,"_5":13195,"_26170":48770,"_2648":48987},[],{"_3150":1302,"_27660":1223,"_19192":48999,"_5":13195,"_26170":48770,"_2648":49000},[],"AWS secret key.",{"_3150":1303,"_27660":1223,"_19192":49002,"_5":13195,"_26170":48770,"_2648":49003},[],"`aws_config.session_token`",{"_3150":1304,"_27660":1223,"_19192":49005,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1305,"_27660":1223,"_19192":49007,"_5":13195,"_26170":48770,"_2648":49008},[],"No",{"_3150":1306,"_27660":1223,"_19192":49010,"_5":13195,"_26170":48770,"_2648":49011},[],"Session token (with `auth_method=static`).",{"_3150":1307,"_27660":1223,"_19192":49013,"_5":13195,"_26170":48770,"_2648":49014},[],"`aws_config.role_arn`",{"_3150":1308,"_27660":1223,"_19192":49016,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1309,"_27660":1223,"_19192":49018,"_5":13195,"_26170":48770,"_2648":49019},[],"Only with `auth_method=role`",{"_3150":1310,"_27660":1223,"_19192":49021,"_5":13195,"_26170":48770,"_2648":49022},[],"ARN of the role to assume.",{"_3150":1311,"_27660":1223,"_19192":49024,"_5":13195,"_26170":48770,"_2648":49025},[],"`aws_config.endpoint_url`",{"_3150":1312,"_27660":1223,"_19192":49027,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1313,"_27660":1223,"_19192":49029,"_5":13195,"_26170":48770,"_2648":49008},[],{"_3150":1314,"_27660":1223,"_19192":49031,"_5":13195,"_26170":48770,"_2648":49032},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3150":1315,"_27660":1223,"_19192":49034,"_5":13195,"_26170":48770,"_2648":49035},[],"`subscriber_event_bus`",{"_3150":1316,"_27660":1223,"_19192":49037,"_5":13195,"_26170":48770,"_2648":16174},[],{"_3150":1317,"_27660":1223,"_19192":49039,"_5":13195,"_26170":48770,"_2648":48956},[],{"_3150":1318,"_27660":1223,"_19192":49041,"_5":13195,"_26170":48770,"_2648":49042},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3150":1319,"_27660":1223,"_19192":49044,"_5":13195,"_26170":48770,"_2648":49045},[],"`dms_manager_client`",{"_3150":1320,"_27660":1223,"_19192":49047,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1321,"_27660":1223,"_19192":49049,"_5":13195,"_26170":48770,"_2648":48956},[],{"_3150":1322,"_27660":1223,"_19192":49051,"_5":13195,"_26170":48770,"_2648":49052},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3150":1323,"_27660":1223,"_19192":49054,"_5":13195,"_26170":48770,"_2648":49055},[],"`device_manager_client`",{"_3150":1324,"_27660":1223,"_19192":49057,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1325,"_27660":1223,"_19192":49059,"_5":13195,"_26170":48770,"_2648":48956},[],{"_3150":1326,"_27660":1223,"_19192":49061,"_5":13195,"_26170":48770,"_2648":49062},[],"HTTP URL of Lamassu's Device Manager.",{"_3150":1327,"_27660":1223,"_19192":49064,"_5":13195,"_26170":48770,"_2648":49065},[],"`ca_client`",{"_3150":1328,"_27660":1223,"_19192":49067,"_5":13195,"_26170":48770,"_2648":22952},[],{"_3150":1329,"_27660":1223,"_19192":49069,"_5":13195,"_26170":48770,"_2648":48956},[],{"_3150":1330,"_27660":1223,"_19192":49071,"_5":13195,"_26170":48770,"_2648":49072},[],"HTTP URL of Lamassu's CA service.",{"_3150":1331,"_27660":1223,"_19192":49074,"_5":13195,"_26170":48774,"_2648":49075},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3150":1332,"_27660":1223,"_19192":49077,"_5":13195,"_26170":48778,"_2648":49078},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3150":1333,"_27660":1223,"_19192":49080,"_5":13195,"_26170":48778,"_2648":49081},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3150":1334,"_27660":1223,"_19192":49083,"_5":13195,"_26170":48782,"_2648":49084},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3150":1335,"_27660":1223,"_19192":49086,"_5":13195,"_26170":48782,"_2648":49087},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3150":1336,"_27660":1223,"_19192":49089,"_5":13195,"_26170":48782,"_2648":49090},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3150":1337,"_27660":1223,"_19192":49092,"_5":13195,"_26170":48782,"_2648":49093},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3150":1338,"_27660":1223,"_19192":49095,"_5":13195,"_26170":48782,"_2648":49096},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3150":1339,"_27660":1223,"_19192":49098,"_5":13195,"_26170":48782,"_2648":49099},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3150":1340,"_27660":1223,"_19192":49101,"_5":13195,"_26170":48786,"_2648":49102},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3150":1341,"_27660":1223,"_19192":49104,"_5":13195,"_26170":48790,"_2648":49105},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3150":1342,"_27660":1223,"_19192":49107,"_5":13195,"_26170":48790,"_2648":49108},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3150":1343,"_27660":1223,"_19192":49110,"_5":13195,"_26170":48794,"_2648":49111},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3150":1344,"_27660":1223,"_19192":49113,"_5":13195,"_26170":48798,"_2648":49114},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3150":1345,"_27660":1223,"_19192":49116,"_5":13195,"_26170":48798,"_2648":49117},[],"Creates or updates the IoT policies configured in the DMS.",{"_3150":1346,"_27660":1223,"_19192":49119,"_5":13195,"_26170":48798,"_2648":49120},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3150":1347,"_27660":1223,"_19192":49122,"_5":13195,"_26170":48798,"_2648":49123},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3150":1348,"_27660":1223,"_19192":49125,"_5":13195,"_26170":48798,"_2648":49126},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3150":1349,"_27660":1223,"_19192":49128,"_5":13195,"_26170":48798,"_2648":49129},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3150":1350,"_27660":1223,"_19192":49131,"_5":13195,"_26170":48798,"_2648":49132},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3150":1351,"_27660":1223,"_19192":49134,"_5":13195,"_26170":48802,"_2648":49135},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3150":1352,"_27660":1223,"_19192":49137,"_5":13195,"_26170":48802,"_2648":49138},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3150":1353,"_27660":1223,"_19192":49140,"_5":13195,"_26170":48802,"_2648":49141},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3150":1354,"_27660":1223,"_19192":49143,"_5":13195,"_26170":48806,"_2648":49144},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3150":1355,"_27660":1223,"_19192":49146,"_5":13195,"_26170":48806,"_2648":49147},[],"The full flow from the device's perspective is:",{"_3150":1356,"_27660":1223,"_19192":49149,"_5":13195,"_26170":48806,"_2648":49150},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3150":1357,"_27660":1223,"_19192":49152,"_5":13195,"_26170":48810,"_2648":49153},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3150":1358,"_27660":1223,"_19192":49155,"_5":13195,"_26170":48810,"_2648":49156},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3150":1359,"_27660":1223,"_19192":49158,"_5":13195,"_26170":48810,"_2648":49159},[],"For the JITP flow to work correctly:",{"_3150":1360,"_27660":1223,"_19192":49161,"_5":13195,"_26170":48810,"_2648":49162},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3150":1361,"_27660":1223,"_19192":49164,"_5":13195,"_26170":48810,"_2648":49165},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3150":1362,"_27660":1223,"_19192":49167,"_5":13195,"_26170":48810,"_2648":49168},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3150":1363,"_27660":1223,"_19192":49170,"_5":13195,"_26170":48810,"_2648":49171},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3150":1364,"_27660":1223,"_19192":49173,"_5":13195,"_26170":48814,"_2648":49174},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3150":1365,"_27660":1223,"_19192":49176,"_5":13195,"_26170":48814,"_2648":49177},[],"Status in Lamassu",{"_3150":1366,"_27660":1223,"_19192":49179,"_5":13195,"_26170":48814,"_2648":49180},[],"Revocation reason",{"_3150":1367,"_27660":1223,"_19192":49182,"_5":13195,"_26170":48814,"_2648":49183},[],"Status in AWS IoT Core",{"_3150":1368,"_27660":1223,"_19192":49185,"_5":13195,"_26170":48814,"_2648":49186},[],"`Active`",{"_3150":1369,"_27660":1223,"_19192":49188,"_5":13195,"_26170":48814,"_2648":49189},[],"None",{"_3150":1370,"_27660":1223,"_19192":49191,"_5":13195,"_26170":48814,"_2648":49192},[],"`ACTIVE`",{"_3150":1371,"_27660":1223,"_19192":49194,"_5":13195,"_26170":48814,"_2648":49195},[],"`Revoked`",{"_3150":1372,"_27660":1223,"_19192":49197,"_5":13195,"_26170":48814,"_2648":49198},[],"`certificateHold`",{"_3150":1373,"_27660":1223,"_19192":49200,"_5":13195,"_26170":48814,"_2648":49201},[],"`INACTIVE`",{"_3150":1374,"_27660":1223,"_19192":49203,"_5":13195,"_26170":48814,"_2648":49195},[],{"_3150":1375,"_27660":1223,"_19192":49205,"_5":13195,"_26170":48814,"_2648":49206},[],"Any other reason",{"_3150":1376,"_27660":1223,"_19192":49208,"_5":13195,"_26170":48814,"_2648":49209},[],"`REVOKED`",{"_3150":1377,"_27660":1223,"_19192":49211,"_5":13195,"_26170":48814,"_2648":49212},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3150":1378,"_27660":1223,"_19192":49214,"_5":13195,"_26170":48818,"_2648":49215},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3150":1379,"_27660":1223,"_19192":49217,"_5":13195,"_26170":48818,"_2648":49218},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3150":1380,"_27660":1223,"_19192":49220,"_5":13195,"_26170":48818,"_2648":49221},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3150":1381,"_27660":1223,"_19192":49223,"_5":13195,"_26170":48822,"_2648":49224},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3150":1382,"_27660":1223,"_19192":49226,"_5":13195,"_26170":48822,"_2648":49227},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3150":1383,"_27660":1223,"_19192":49229,"_5":13195,"_26170":48826,"_2648":49230},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3150":1384,"_27660":1223,"_19192":49232,"_5":13195,"_26170":48826,"_2648":49233},[],"There are two action types:",{"_3150":1385,"_27660":1223,"_19192":49235,"_5":13195,"_26170":48826,"_2648":49236},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3150":1386,"_27660":1223,"_19192":49238,"_5":13195,"_26170":48826,"_2648":49239},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3150":1387,"_27660":1223,"_19192":49241,"_5":13195,"_26170":48826,"_2648":49242},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3150":1388,"_27660":1223,"_19192":49244,"_5":13195,"_26170":48830,"_2648":49245},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3150":1389,"_27660":1223,"_19192":49247,"_5":13195,"_26170":48830,"_2648":49248},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3150":1390,"_27660":1223,"_19192":49250,"_5":13195,"_26170":48830,"_2648":49251},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3150":1391,"_27660":1223,"_19192":49253,"_5":13195,"_26170":48834,"_2648":49254},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3150":1392,"_27660":1223,"_19192":49256,"_5":13195,"_26170":48834,"_2648":49257},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3150":1393,"_27660":1223,"_19192":49259,"_5":13195,"_26170":48834,"_2648":49260},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3150":1394,"_27660":1223,"_19192":49262,"_5":13195,"_26170":48834,"_2648":49263},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3150":1395,"_27660":1223,"_19192":49265,"_5":13195,"_26170":48834,"_2648":49266},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3150":1396,"_27660":1223,"_19192":49268,"_5":13195,"_26170":48834,"_2648":49269},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3150":1397,"_27660":1223,"_19192":49271,"_5":13195,"_26170":48834,"_2648":49272},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3150":1398,"_27660":1223,"_19192":49274,"_5":13195,"_26170":48834,"_2648":49275},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3150":1399,"_27660":1223,"_19192":49277,"_5":13195,"_26170":48834,"_2648":49278},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3150":1400,"_27660":1223,"_19192":49280,"_5":13195,"_26170":48834,"_2648":49281},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3150":1401,"_27660":1223,"_19192":49283,"_5":13195,"_26170":48834,"_2648":49284},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3150":1402,"_27660":1223,"_19192":49286,"_5":13195,"_26170":48834,"_2648":49287},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3150":1403,"_27660":1223,"_19192":49289,"_5":13195,"_26170":48834,"_2648":49290},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3150":1404,"_27660":1223,"_19192":49292,"_5":13195,"_26170":48834,"_2648":49293},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3150":1405,"_27660":1223,"_19192":49295,"_5":13195,"_26170":48834,"_2648":49296},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3150":1406,"_27660":1223,"_19192":49298,"_5":13195,"_26170":48834,"_2648":49299},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3150":1407,"_27660":1223,"_19192":49301,"_5":13195,"_26170":48834,"_2648":49302},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3150":1408,"_27660":1223,"_19192":49304,"_5":13195,"_26170":48834,"_2648":49305},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3150":1409,"_27660":1223,"_19192":49307,"_5":13195,"_26170":48834,"_2648":49308},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1410,"_27660":1223,"_19192":49310,"_5":13195,"_26170":48834,"_2648":49311},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3150":1411,"_27660":1223,"_19192":49313,"_5":13195,"_26170":48834,"_2648":49314},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3150":1412,"_27660":1412,"_5":13521,"_2648":47295,"_27982":49316,"_19192":49317,"_26170":1412},[44938,46318,47295],[],{"_3150":1413,"_27660":1412,"_19192":49319,"_5":13195,"_26170":1412,"_2648":49320},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3150":1414,"_27660":1412,"_5":27979,"_19192":49322,"_26170":49323,"_2648":49324},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3150":1415,"_27660":1412,"_5":27979,"_19192":49326,"_26170":49327,"_2648":47293},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3150":1416,"_27660":1412,"_5":27979,"_19192":49329,"_26170":49330,"_2648":47476},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3150":1417,"_27660":1412,"_5":27979,"_19192":49332,"_26170":49333,"_2648":48751},[],"/docs/platform/iot-fleets/overview#integrations",{"_3150":1418,"_27660":1412,"_5":27979,"_19192":49335,"_26170":49336,"_2648":49337},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3150":1419,"_27660":1412,"_19192":49339,"_5":13195,"_26170":1412,"_2648":49340},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3150":1420,"_27660":1412,"_19192":49342,"_5":13195,"_26170":49323,"_2648":49343},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3150":1421,"_27660":1412,"_19192":49345,"_5":13195,"_26170":49323,"_2648":49346},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3150":1422,"_27660":1412,"_19192":49348,"_5":13195,"_26170":49327,"_2648":49349},[],"Resource",{"_3150":1423,"_27660":1412,"_19192":49351,"_5":13195,"_26170":49327,"_2648":49352},[],"What it represents",{"_3150":1424,"_27660":1412,"_19192":49354,"_5":13195,"_26170":49327,"_2648":49355},[],"**Device**",{"_3150":1425,"_27660":1412,"_19192":49357,"_5":13195,"_26170":49327,"_2648":49358},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3150":1426,"_27660":1412,"_19192":49360,"_5":13195,"_26170":49327,"_2648":49361},[],"**Identity**",{"_3150":1427,"_27660":1412,"_19192":49363,"_5":13195,"_26170":49327,"_2648":49364},[],"The device's association with its certificates: an active version and a history.",{"_3150":1428,"_27660":1412,"_19192":49366,"_5":13195,"_26170":49327,"_2648":49367},[],"**DMS**",{"_3150":1429,"_27660":1412,"_19192":49369,"_5":13195,"_26170":49327,"_2648":49370},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3150":1430,"_27660":1412,"_19192":49372,"_5":13195,"_26170":49327,"_2648":49373},[],"**Fleet**",{"_3150":1431,"_27660":1412,"_19192":49375,"_5":13195,"_26170":49327,"_2648":49376},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3150":1432,"_27660":1412,"_19192":49378,"_5":13195,"_26170":49327,"_2648":49379},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3150":1433,"_27660":1412,"_19192":49381,"_5":13195,"_26170":49327,"_2648":49382},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3150":1434,"_27660":1412,"_19192":49384,"_5":13195,"_26170":49330,"_2648":49385},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3150":1435,"_27660":1412,"_19192":49387,"_5":13195,"_26170":49330,"_2648":49388},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3150":1436,"_27660":1412,"_19192":49390,"_5":13195,"_26170":49330,"_2648":49391},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3150":1437,"_27660":1412,"_19192":49393,"_5":13195,"_26170":49330,"_2648":49394},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3150":1438,"_27660":1412,"_19192":49396,"_5":13195,"_26170":49330,"_2648":49397},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3150":1439,"_27660":1412,"_19192":49399,"_5":13195,"_26170":49330,"_2648":49400},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3150":1440,"_27660":1412,"_19192":49402,"_5":13195,"_26170":49330,"_2648":49403},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3150":1441,"_27660":1412,"_19192":49405,"_5":13195,"_26170":49330,"_2648":49406},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3150":1442,"_27660":1412,"_19192":49408,"_5":13195,"_26170":49333,"_2648":49409},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3150":1443,"_27660":1412,"_19192":49411,"_5":13195,"_26170":49333,"_2648":49412},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3150":1444,"_27660":1412,"_19192":49414,"_5":13195,"_26170":49336,"_2648":49415},[],"Participant",{"_3150":1445,"_27660":1412,"_19192":49417,"_5":13195,"_26170":49336,"_2648":49418},[],"Responsibility",{"_3150":1446,"_27660":1412,"_19192":49420,"_5":13195,"_26170":49336,"_2648":49421},[],"PKI administrator",{"_3150":1447,"_27660":1412,"_19192":49423,"_5":13195,"_26170":49336,"_2648":49424},[],"CA, issuance profile, chain and revocation publication.",{"_3150":1448,"_27660":1412,"_19192":49426,"_5":13195,"_26170":49336,"_2648":49427},[],"Provisioning administrator",{"_3150":1449,"_27660":1412,"_19192":49429,"_5":13195,"_26170":49336,"_2648":49430},[],"DMS, admission, authentication per operation and inventory.",{"_3150":1450,"_27660":1412,"_19192":49432,"_5":13195,"_26170":49336,"_2648":49433},[],"Device integrator",{"_3150":1451,"_27660":1412,"_19192":49435,"_5":13195,"_26170":49336,"_2648":49436},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3150":1452,"_27660":1412,"_19192":49438,"_5":13195,"_26170":49336,"_2648":49439},[],"Consumer integrator",{"_3150":1453,"_27660":1412,"_19192":49441,"_5":13195,"_26170":49336,"_2648":49442},[],"Trusted issuers, validation and device permissions in the destination.",{"_3150":1454,"_27660":1412,"_19192":49444,"_5":13195,"_26170":49336,"_2648":49445},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3150":1455,"_27660":1455,"_5":13521,"_2648":49447,"_27982":49448,"_19192":49450,"_26170":1455},"Enroll and connect your first device",[44938,46318,47295,49449],"Getting started",[],{"_3150":1456,"_27660":1455,"_19192":49452,"_5":13195,"_26170":1455,"_2648":49453},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3150":1457,"_27660":1455,"_5":27979,"_19192":49455,"_26170":49456,"_2648":44948},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3150":1458,"_27660":1455,"_5":27979,"_19192":49458,"_26170":49459,"_2648":49460},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3150":1459,"_27660":1455,"_5":27979,"_19192":49462,"_26170":49463,"_2648":49464},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3150":1460,"_27660":1455,"_5":27979,"_19192":49466,"_26170":49467,"_2648":49468},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3150":1461,"_27660":1455,"_5":27979,"_19192":49470,"_26170":49471,"_2648":49472},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3150":1462,"_27660":1455,"_5":27979,"_19192":49474,"_26170":49475,"_2648":49476},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3150":1463,"_27660":1455,"_5":27979,"_19192":49478,"_26170":49479,"_2648":49480},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3150":1464,"_27660":1455,"_5":27979,"_19192":49482,"_26170":49483,"_2648":49484},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3150":1465,"_27660":1455,"_19192":49486,"_5":13195,"_26170":1455,"_2648":49487},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3150":1466,"_27660":1455,"_19192":49489,"_5":13195,"_26170":49456,"_2648":49490},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3150":1467,"_27660":1455,"_19192":49492,"_5":13195,"_26170":49456,"_2648":49493},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3150":1468,"_27660":1455,"_19192":49495,"_5":13195,"_26170":49456,"_2648":49496},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3150":1469,"_27660":1455,"_19192":49498,"_5":13195,"_26170":49456,"_2648":49499},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3150":1470,"_27660":1455,"_19192":49501,"_5":13195,"_26170":49456,"_2648":49502},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3150":1471,"_27660":1455,"_19192":49504,"_5":13195,"_26170":49459,"_2648":49505},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3150":1472,"_27660":1455,"_19192":49507,"_5":13195,"_26170":49459,"_2648":49508},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3150":1473,"_27660":1455,"_19192":49510,"_5":13195,"_26170":49463,"_2648":49511},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3150":1474,"_27660":1455,"_19192":49513,"_5":13195,"_26170":49463,"_2648":49514},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3150":1475,"_27660":1455,"_19192":49516,"_5":13195,"_26170":49463,"_2648":49517},[],"Setting",{"_3150":1476,"_27660":1455,"_19192":49519,"_5":13195,"_26170":49463,"_2648":49520},[],"Evaluation value",{"_3150":1477,"_27660":1455,"_19192":49522,"_5":13195,"_26170":49463,"_2648":49523},[],"Enrollment CA",{"_3150":1478,"_27660":1455,"_19192":49525,"_5":13195,"_26170":49463,"_2648":49526},[],"Issuing root from `device-root.pem`.",{"_3150":1479,"_27660":1455,"_19192":49528,"_5":13195,"_26170":49463,"_2648":47606},[],{"_3150":1480,"_27660":1455,"_19192":49530,"_5":13195,"_26170":49463,"_2648":49531},[],"The 1-hour leaf profile you just prepared.",{"_3150":1481,"_27660":1455,"_19192":49533,"_5":13195,"_26170":49463,"_2648":49534},[],"Protocol / Registration Mode",{"_3150":1482,"_27660":1455,"_19192":49536,"_5":13195,"_26170":49463,"_2648":49537},[],"`EST_RFC7030` / `JITP`.",{"_3150":1483,"_27660":1455,"_19192":49539,"_5":13195,"_26170":49463,"_2648":49540},[],"Verify CSR Signature",{"_3150":1484,"_27660":1455,"_19192":49542,"_5":13195,"_26170":49463,"_2648":49543},[],"Enabled.",{"_3150":1485,"_27660":1455,"_19192":49545,"_5":13195,"_26170":49463,"_2648":49546},[],"Enable Replaceable Enrollment",{"_3150":1486,"_27660":1455,"_19192":49548,"_5":13195,"_26170":49463,"_2648":49549},[],"Disabled; the ID must be new.",{"_3150":1487,"_27660":1455,"_19192":49551,"_5":13195,"_26170":49463,"_2648":49552},[],"Initial authentication",{"_3150":1488,"_27660":1455,"_19192":49554,"_5":13195,"_26170":49463,"_2648":49555},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3150":1489,"_27660":1455,"_19192":49557,"_5":13195,"_26170":49463,"_2648":49558},[],"Renewal authentication",{"_3150":1490,"_27660":1455,"_19192":49560,"_5":13195,"_26170":49463,"_2648":49561},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3150":1491,"_27660":1455,"_19192":49563,"_5":13195,"_26170":49463,"_2648":49564},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3150":1492,"_27660":1455,"_19192":49566,"_5":13195,"_26170":49463,"_2648":49567},[],"Empty list for this direct issuance / disabled.",{"_3150":1493,"_27660":1455,"_19192":49569,"_5":13195,"_26170":49463,"_2648":49570},[],"Re-enrollment Delta",{"_3150":1494,"_27660":1455,"_19192":49572,"_5":13195,"_26170":49463,"_2648":49573},[],"1 hour.",{"_3150":1495,"_27660":1455,"_19192":49575,"_5":13195,"_26170":49463,"_2648":49576},[],"Preventive / Critical Delta",{"_3150":1496,"_27660":1455,"_19192":49578,"_5":13195,"_26170":49463,"_2648":49579},[],"30 minutes / 10 minutes.",{"_3150":1497,"_27660":1455,"_19192":49581,"_5":13195,"_26170":49463,"_2648":49582},[],"Revoke on Re-enrollment",{"_3150":1498,"_27660":1455,"_19192":49584,"_5":13195,"_26170":49463,"_2648":49585},[],"Disabled to test the successor before retiring the previous identity.",{"_3150":1499,"_27660":1455,"_19192":49587,"_5":13195,"_26170":49463,"_2648":47614},[],{"_3150":1500,"_27660":1455,"_19192":49589,"_5":13195,"_26170":49463,"_2648":49590},[],"Disabled; the operational key is generated in the client.",{"_3150":1501,"_27660":1455,"_19192":49592,"_5":13195,"_26170":49463,"_2648":49593},[],"CA Distribution",{"_3150":1502,"_27660":1455,"_19192":49595,"_5":13195,"_26170":49463,"_2648":49596},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3150":1503,"_27660":1455,"_19192":49598,"_5":13195,"_26170":49463,"_2648":49599},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_3150":1504,"_27660":1455,"_19192":49601,"_5":13195,"_26170":49467,"_2648":49602},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3150":1505,"_27660":1455,"_19192":49604,"_5":13195,"_26170":49467,"_2648":49605},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3150":1506,"_27660":1455,"_19192":49607,"_5":13195,"_26170":49471,"_2648":49608},[],"Generate a new key and CSR with the selected identifier:",{"_3150":1507,"_27660":1455,"_19192":49610,"_5":13195,"_26170":49471,"_2648":49611},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3150":1508,"_27660":1455,"_19192":49613,"_5":13195,"_26170":49471,"_2648":49614},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3150":1509,"_27660":1455,"_19192":49616,"_5":13195,"_26170":49475,"_2648":49617},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3150":1510,"_27660":1455,"_19192":49619,"_5":13195,"_26170":49475,"_2648":49620},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3150":1511,"_27660":1455,"_19192":49622,"_5":13195,"_26170":49479,"_2648":49623},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3150":1512,"_27660":1455,"_19192":49625,"_5":13195,"_26170":49479,"_2648":49626},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3150":1513,"_27660":1455,"_19192":49628,"_5":13195,"_26170":49479,"_2648":49629},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3150":1514,"_27660":1455,"_19192":49631,"_5":13195,"_26170":49479,"_2648":49632},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3150":1515,"_27660":1455,"_19192":49634,"_5":13195,"_26170":49479,"_2648":49635},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3150":1516,"_27660":1455,"_19192":49637,"_5":13195,"_26170":49483,"_2648":49638},[],"Check",{"_3150":1517,"_27660":1455,"_19192":49640,"_5":13195,"_26170":49483,"_2648":49641},[],"Expected result",{"_3150":1518,"_27660":1455,"_19192":49643,"_5":13195,"_26170":49483,"_2648":49644},[],"Registration",{"_3150":1519,"_27660":1455,"_19192":49646,"_5":13195,"_26170":49483,"_2648":49647},[],"ID created automatically and correct DMS.",{"_3150":1520,"_27660":1455,"_19192":49649,"_5":13195,"_26170":49483,"_2648":49650},[],"Certificate",{"_3150":1521,"_27660":1455,"_19192":49652,"_5":13195,"_26170":49483,"_2648":49653},[],"CN, profile, serial and key verified.",{"_3150":1522,"_27660":1455,"_19192":49655,"_5":13195,"_26170":49483,"_2648":49656},[],"Inventory",{"_3150":1523,"_27660":1455,"_19192":49658,"_5":13195,"_26170":49483,"_2648":49659},[],"Received serial visible as the current identity and in history.",{"_3150":1524,"_27660":1455,"_19192":49661,"_5":13195,"_26170":49483,"_2648":49662},[],"Consumer",{"_3150":1525,"_27660":1455,"_19192":49664,"_5":13195,"_26170":49483,"_2648":49665},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3150":1526,"_27660":1455,"_19192":49667,"_5":13195,"_26170":49483,"_2648":49668},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3150":1527,"_27660":1455,"_19192":49670,"_5":13195,"_26170":49483,"_2648":49671},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3150":1528,"_27660":1528,"_5":13521,"_2648":47311,"_27982":49673,"_19192":49674,"_26170":1528},[44938,46318,47295,49449],[],{"_3150":1529,"_27660":1528,"_19192":49676,"_5":13195,"_26170":1528,"_2648":49677},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3150":1530,"_27660":1528,"_5":27979,"_19192":49679,"_26170":49680,"_2648":44948},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3150":1531,"_27660":1528,"_5":27979,"_19192":49682,"_26170":49683,"_2648":49684},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3150":1532,"_27660":1528,"_5":27979,"_19192":49686,"_26170":49687,"_2648":49688},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3150":1533,"_27660":1528,"_5":27979,"_19192":49690,"_26170":49691,"_2648":49692},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3150":1534,"_27660":1528,"_5":27979,"_19192":49694,"_26170":49695,"_2648":49696},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3150":1535,"_27660":1528,"_5":27979,"_19192":49698,"_26170":49699,"_2648":49700},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3150":1536,"_27660":1528,"_5":27979,"_19192":49702,"_26170":49703,"_2648":49641},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3150":1537,"_27660":1528,"_5":27979,"_19192":49705,"_26170":49706,"_2648":49707},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3150":1538,"_27660":1528,"_5":27979,"_19192":49709,"_26170":49710,"_2648":49711},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3150":1539,"_27660":1528,"_19192":49713,"_5":13195,"_26170":1528,"_2648":49714},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3150":1540,"_27660":1528,"_19192":49716,"_5":13195,"_26170":1528,"_2648":49717},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3150":1541,"_27660":1528,"_19192":49719,"_5":13195,"_26170":49680,"_2648":49720},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3150":1542,"_27660":1528,"_19192":49722,"_5":13195,"_26170":49680,"_2648":49723},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3150":1543,"_27660":1528,"_19192":49725,"_5":13195,"_26170":49680,"_2648":49726},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3150":1544,"_27660":1528,"_19192":49728,"_5":13195,"_26170":49680,"_2648":49729},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3150":1545,"_27660":1528,"_19192":49731,"_5":13195,"_26170":49683,"_2648":49732},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3150":1546,"_27660":1528,"_19192":49734,"_5":13195,"_26170":49683,"_2648":49735},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3150":1547,"_27660":1528,"_19192":49737,"_5":13195,"_26170":49683,"_2648":49738},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3150":1548,"_27660":1528,"_19192":49740,"_5":13195,"_26170":49683,"_2648":49741},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3150":1549,"_27660":1528,"_19192":49743,"_5":13195,"_26170":49683,"_2648":49744},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_3150":1550,"_27660":1528,"_19192":49746,"_5":13195,"_26170":49683,"_2648":49747},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3150":1551,"_27660":1528,"_19192":49749,"_5":13195,"_26170":49683,"_2648":49750},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3150":1552,"_27660":1528,"_19192":49752,"_5":13195,"_26170":49683,"_2648":49753},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3150":1553,"_27660":1528,"_19192":49755,"_5":13195,"_26170":49687,"_2648":49756},[],"Open **Managed Devices** and the registration action. Complete:",{"_3150":1554,"_27660":1528,"_19192":49758,"_5":13195,"_26170":49687,"_2648":49759},[],"**Device ID**: `device-001`.",{"_3150":1555,"_27660":1528,"_19192":49761,"_5":13195,"_26170":49687,"_2648":49762},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3150":1556,"_27660":1528,"_19192":49764,"_5":13195,"_26170":49687,"_2648":49765},[],"**Icon** and **Tags**: optional classification.",{"_3150":1557,"_27660":1528,"_19192":49767,"_5":13195,"_26170":49687,"_2648":49768},[],"Confirm registration.",{"_3150":1558,"_27660":1528,"_19192":49770,"_5":13195,"_26170":49691,"_2648":49771},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3150":1559,"_27660":1528,"_19192":49773,"_5":13195,"_26170":49691,"_2648":49774},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3150":1560,"_27660":1528,"_19192":49776,"_5":13195,"_26170":49695,"_2648":49777},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3150":1561,"_27660":1528,"_19192":49779,"_5":13195,"_26170":49695,"_2648":49780},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3150":1562,"_27660":1528,"_19192":49782,"_5":13195,"_26170":49699,"_2648":49783},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3150":1563,"_27660":1528,"_19192":49785,"_5":13195,"_26170":49699,"_2648":49786},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3150":1564,"_27660":1528,"_19192":49788,"_5":13195,"_26170":49703,"_2648":49638},[],{"_3150":1565,"_27660":1528,"_19192":49790,"_5":13195,"_26170":49703,"_2648":49791},[],"Result",{"_3150":1566,"_27660":1528,"_19192":49793,"_5":13195,"_26170":49703,"_2648":49794},[],"Device",{"_3150":1567,"_27660":1528,"_19192":49796,"_5":13195,"_26170":49703,"_2648":49797},[],"`device-001` appears in inventory with the expected DMS.",{"_3150":1568,"_27660":1528,"_19192":49799,"_5":13195,"_26170":49703,"_2648":49800},[],"Current identity",{"_3150":1569,"_27660":1528,"_19192":49802,"_5":13195,"_26170":49703,"_2648":49803},[],"The associated certificate matches the one you verified in PKI.",{"_3150":1570,"_27660":1528,"_19192":49805,"_5":13195,"_26170":49703,"_2648":49806},[],"History",{"_3150":1571,"_27660":1528,"_19192":49808,"_5":13195,"_26170":49703,"_2648":49809},[],"The associated issuance appears with its serial number and dates.",{"_3150":1572,"_27660":1528,"_19192":49811,"_5":13195,"_26170":49703,"_2648":49812},[],"Key and certificate",{"_3150":1573,"_27660":1528,"_19192":49814,"_5":13195,"_26170":49703,"_2648":49815},[],"You have the verified pair ready to install on the device.",{"_3150":1574,"_27660":1528,"_19192":49817,"_5":13195,"_26170":49706,"_2648":49818},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3150":1575,"_27660":1528,"_19192":49820,"_5":13195,"_26170":49706,"_2648":49821},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3150":1576,"_27660":1528,"_19192":49823,"_5":13195,"_26170":49706,"_2648":49824},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3150":1577,"_27660":1528,"_19192":49826,"_5":13195,"_26170":49706,"_2648":49827},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3150":1578,"_27660":1528,"_19192":49829,"_5":13195,"_26170":49710,"_2648":49830},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3150":1579,"_27660":1528,"_19192":49832,"_5":13195,"_26170":49710,"_2648":49833},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3150":1580,"_27660":1528,"_19192":49835,"_5":13195,"_26170":49710,"_2648":49836},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3150":1581,"_27660":1581,"_5":13521,"_2648":49838,"_27982":49839,"_19192":49840,"_26170":1581},"Lamassu IoT Platform",[44938,46318],[],{"_3150":1582,"_27660":1581,"_19192":49842,"_5":13195,"_26170":1581,"_2648":49843},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3150":1583,"_27660":1581,"_5":27979,"_19192":49845,"_26170":49846,"_2648":49324},[],"/docs/platform/overview#start-here",{"_3150":1584,"_27660":1581,"_5":27979,"_19192":49848,"_26170":49849,"_2648":49850},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3150":1585,"_27660":1581,"_5":27979,"_19192":49852,"_26170":49853,"_2648":49854},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3150":1586,"_27660":1581,"_5":27979,"_19192":49856,"_26170":49857,"_2648":49858},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3150":1587,"_27660":1581,"_5":27979,"_19192":49860,"_26170":49861,"_2648":49862},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3150":1588,"_27660":1581,"_5":27979,"_19192":49864,"_26170":49865,"_2648":49866},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3150":1589,"_27660":1581,"_5":27979,"_19192":49868,"_26170":49869,"_2648":49870},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3150":1590,"_27660":1581,"_5":27979,"_19192":49872,"_26170":49873,"_2648":49874},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3150":1591,"_27660":1581,"_5":27979,"_19192":49876,"_26170":49877,"_2648":49878},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3150":1592,"_27660":1581,"_5":27979,"_19192":49880,"_26170":49881,"_2648":49882},[],"/docs/platform/overview#react-to-events","React to events",{"_3150":1593,"_27660":1581,"_5":27979,"_19192":49884,"_26170":49885,"_2648":49886},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3150":1594,"_27660":1581,"_19192":49888,"_5":13195,"_26170":1581,"_2648":49889},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3150":1595,"_27660":1581,"_19192":49891,"_5":13195,"_26170":49846,"_2648":49892},[],"Choose the result you need:",{"_3150":1596,"_27660":1581,"_19192":49894,"_5":13195,"_26170":49846,"_2648":49895},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":1597,"_27660":1581,"_19192":49897,"_5":13195,"_26170":49846,"_2648":49898},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3150":1598,"_27660":1581,"_19192":49900,"_5":13195,"_26170":49846,"_2648":49901},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3150":1599,"_27660":1581,"_19192":49903,"_5":13195,"_26170":49849,"_2648":49904},[],"Section",{"_3150":1600,"_27660":1581,"_19192":49906,"_5":13195,"_26170":49849,"_2648":49907},[],"What you manage",{"_3150":1601,"_27660":1581,"_19192":49909,"_5":13195,"_26170":49849,"_2648":49910},[],"Entry point",{"_3150":1602,"_27660":1581,"_19192":49912,"_5":13195,"_26170":49849,"_2648":49913},[],"**PKI**",{"_3150":1603,"_27660":1581,"_19192":49915,"_5":13195,"_26170":49849,"_2648":49916},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3150":1604,"_27660":1581,"_19192":49918,"_5":13195,"_26170":49849,"_2648":49919},[],"PKI overview",{"_3150":1605,"_27660":1581,"_19192":49921,"_5":13195,"_26170":49849,"_2648":49922},[],"**IoT Fleets**",{"_3150":1606,"_27660":1581,"_19192":49924,"_5":13195,"_26170":49849,"_2648":49925},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3150":1607,"_27660":1581,"_19192":49927,"_5":13195,"_26170":49849,"_2648":49928},[],"IoT Fleets overview",{"_3150":1608,"_27660":1581,"_19192":49930,"_5":13195,"_26170":49849,"_2648":49931},[],"**Administration**",{"_3150":1609,"_27660":1581,"_19192":49933,"_5":13195,"_26170":49849,"_2648":49934},[],"Operator permissions, audit and event subscriptions.",{"_3150":1610,"_27660":1581,"_19192":49936,"_5":13195,"_26170":49849,"_2648":46316},[],{"_3150":1611,"_27660":1581,"_19192":49938,"_5":13195,"_26170":49849,"_2648":49939},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3150":1612,"_27660":1581,"_19192":49941,"_5":13195,"_26170":49853,"_2648":49942},[],"An identity's journey connects four responsibilities:",{"_3150":1613,"_27660":1581,"_19192":49944,"_5":13195,"_26170":49853,"_2648":49945},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3150":1614,"_27660":1581,"_19192":49947,"_5":13195,"_26170":49853,"_2648":49948},[],"The provisioning administrator configures the DMS and initial trust.",{"_3150":1615,"_27660":1581,"_19192":49950,"_5":13195,"_26170":49853,"_2648":49951},[],"The device client requests a certificate and installs it with the matching key.",{"_3150":1616,"_27660":1581,"_19192":49953,"_5":13195,"_26170":49853,"_2648":49954},[],"The consumer validates the identity and applies its access permissions.",{"_3150":1617,"_27660":1581,"_19192":49956,"_5":13195,"_26170":49853,"_2648":49957},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3150":1618,"_27660":1581,"_19192":49959,"_5":13195,"_26170":49861,"_2648":49960},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3150":1619,"_27660":1581,"_19192":49962,"_5":13195,"_26170":49865,"_2648":49963},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3150":1620,"_27660":1581,"_19192":49965,"_5":13195,"_26170":49869,"_2648":49966},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3150":1621,"_27660":1581,"_19192":49968,"_5":13195,"_26170":49873,"_2648":49969},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3150":1622,"_27660":1581,"_19192":49971,"_5":13195,"_26170":49877,"_2648":49972},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3150":1623,"_27660":1581,"_19192":49974,"_5":13195,"_26170":49881,"_2648":49975},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3150":1624,"_27660":1581,"_19192":49977,"_5":13195,"_26170":49885,"_2648":49418},[],{"_3150":1625,"_27660":1581,"_19192":49979,"_5":13195,"_26170":49885,"_2648":49980},[],"What it prepares or checks",{"_3150":1626,"_27660":1581,"_19192":49982,"_5":13195,"_26170":49885,"_2648":49421},[],{"_3150":1627,"_27660":1581,"_19192":49984,"_5":13195,"_26170":49885,"_2648":49985},[],"Key custody, CA hierarchy, profiles and validation.",{"_3150":1628,"_27660":1581,"_19192":49987,"_5":13195,"_26170":49885,"_2648":49988},[],"Fleet administrator",{"_3150":1629,"_27660":1581,"_19192":49990,"_5":13195,"_26170":49885,"_2648":49991},[],"DMS, device admission, renewal policy and inventory.",{"_3150":1630,"_27660":1581,"_19192":49993,"_5":13195,"_26170":49885,"_2648":49433},[],{"_3150":1631,"_27660":1581,"_19192":49995,"_5":13195,"_26170":49885,"_2648":49996},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3150":1632,"_27660":1581,"_19192":49998,"_5":13195,"_26170":49885,"_2648":49439},[],{"_3150":1633,"_27660":1581,"_19192":50000,"_5":13195,"_26170":49885,"_2648":50001},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3150":1634,"_27660":1581,"_19192":50003,"_5":13195,"_26170":49885,"_2648":50004},[],"Infrastructure operator",{"_3150":1635,"_27660":1581,"_19192":50006,"_5":13195,"_26170":49885,"_2648":50007},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3150":1636,"_27660":1581,"_19192":50009,"_5":13195,"_26170":49885,"_2648":50010},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3150":1637,"_27660":1637,"_5":13521,"_2648":50012,"_27982":50013,"_19192":50016,"_26170":1637},"CA hierarchy and rotation",[44938,46318,50014,50015],"PKI","Keys, authorities and certificates",[],{"_3150":1638,"_27660":1637,"_19192":50018,"_5":13195,"_26170":1637,"_2648":50019},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3150":1639,"_27660":1637,"_5":27979,"_19192":50021,"_26170":50022,"_2648":50023},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3150":1640,"_27660":1637,"_5":27979,"_19192":50025,"_26170":50026,"_2648":50027},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3150":1641,"_27660":1637,"_5":27979,"_19192":50029,"_26170":50030,"_2648":50031},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3150":1642,"_27660":1637,"_5":27979,"_19192":50033,"_26170":50034,"_2648":50035},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3150":1643,"_27660":1637,"_5":27979,"_19192":50037,"_26170":50038,"_2648":50039},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3150":1644,"_27660":1637,"_5":27979,"_19192":50041,"_26170":50042,"_2648":50043},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3150":1645,"_27660":1637,"_5":27979,"_19192":50045,"_26170":50046,"_2648":50047},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3150":1646,"_27660":1637,"_5":27979,"_19192":50049,"_26170":50050,"_2648":50051},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3150":1647,"_27660":1637,"_5":27979,"_19192":50053,"_26170":50054,"_2648":50055},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3150":1648,"_27660":1637,"_5":27979,"_19192":50057,"_26170":50058,"_2648":50059},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3150":1649,"_27660":1637,"_5":27979,"_19192":50061,"_26170":50062,"_2648":50063},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3150":1650,"_27660":1637,"_5":27979,"_19192":50065,"_26170":50066,"_2648":50067},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3150":1651,"_27660":1637,"_19192":50069,"_5":13195,"_26170":1637,"_2648":50070},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3150":1652,"_27660":1637,"_19192":50072,"_5":13195,"_26170":1637,"_2648":50073},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3150":1653,"_27660":1637,"_19192":50075,"_5":13195,"_26170":50022,"_2648":50076},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3150":1654,"_27660":1637,"_19192":50078,"_5":13195,"_26170":50022,"_2648":50079},[],"environment, such as production and preproduction;",{"_3150":1655,"_27660":1637,"_19192":50081,"_5":13195,"_26170":50022,"_2648":50082},[],"owner or operating team;",{"_3150":1656,"_27660":1637,"_19192":50084,"_5":13195,"_26170":50022,"_2648":50085},[],"device family or manufacturing process;",{"_3150":1657,"_27660":1637,"_19192":50087,"_5":13195,"_26170":50022,"_2648":50088},[],"region or regulatory requirement;",{"_3150":1658,"_27660":1637,"_19192":50090,"_5":13195,"_26170":50022,"_2648":50091},[],"cryptographic engine or key policy;",{"_3150":1659,"_27660":1637,"_19192":50093,"_5":13195,"_26170":50022,"_2648":50094},[],"maintenance window and renewal cadence.",{"_3150":1660,"_27660":1637,"_19192":50096,"_5":13195,"_26170":50022,"_2648":50097},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3150":1661,"_27660":1637,"_19192":50099,"_5":13195,"_26170":50022,"_2648":50100},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3150":1662,"_27660":1637,"_19192":50102,"_5":13195,"_26170":50026,"_2648":50103},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3150":1663,"_27660":1637,"_19192":50105,"_5":13195,"_26170":50026,"_2648":50106},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3150":1664,"_27660":1637,"_19192":50108,"_5":13195,"_26170":50026,"_2648":50109},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3150":1665,"_27660":1637,"_19192":50111,"_5":13195,"_26170":50030,"_2648":50112},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3150":1666,"_27660":1637,"_19192":50114,"_5":13195,"_26170":50030,"_2648":50115},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3150":1667,"_27660":1637,"_19192":50117,"_5":13195,"_26170":50030,"_2648":50118},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3150":1668,"_27660":1637,"_19192":50120,"_5":13195,"_26170":50030,"_2648":50121},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3150":1669,"_27660":1637,"_19192":50123,"_5":13195,"_26170":50038,"_2648":50124},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3150":1670,"_27660":1637,"_19192":50126,"_5":13195,"_26170":50042,"_2648":50127},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3150":1671,"_27660":1637,"_19192":50129,"_5":13195,"_26170":50046,"_2648":50130},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3150":1672,"_27660":1637,"_19192":50132,"_5":13195,"_26170":50050,"_2648":50133},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_3150":1673,"_27660":1637,"_19192":50135,"_5":13195,"_26170":50054,"_2648":50136},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3150":1674,"_27660":1637,"_19192":50138,"_5":13195,"_26170":50058,"_2648":50139},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_3150":1675,"_27660":1637,"_19192":50141,"_5":13195,"_26170":50062,"_2648":50142},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3150":1676,"_27660":1637,"_19192":50144,"_5":13195,"_26170":50062,"_2648":50145},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3150":1677,"_27660":1637,"_19192":50147,"_5":13195,"_26170":50062,"_2648":50148},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3150":1678,"_27660":1637,"_19192":50150,"_5":13195,"_26170":50062,"_2648":50151},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3150":1679,"_27660":1637,"_19192":50153,"_5":13195,"_26170":50066,"_2648":50154},[],"The new chain ends in an anchor installed by the consumer.",{"_3150":1680,"_27660":1637,"_19192":50156,"_5":13195,"_26170":50066,"_2648":50157},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3150":1681,"_27660":1637,"_19192":50159,"_5":13195,"_26170":50066,"_2648":50160},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3150":1682,"_27660":1637,"_19192":50162,"_5":13195,"_26170":50066,"_2648":50163},[],"Re-enrollment accepts the old identity during the planned period.",{"_3150":1683,"_27660":1637,"_19192":50165,"_5":13195,"_26170":50066,"_2648":50166},[],"OCSP and CRL respond for the authorities that remain active.",{"_3150":1684,"_27660":1637,"_19192":50168,"_5":13195,"_26170":50066,"_2648":50169},[],"No DMS is left accidentally issuing from the old CA.",{"_3150":1685,"_27660":1637,"_19192":50171,"_5":13195,"_26170":50066,"_2648":50172},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3150":1686,"_27660":1686,"_5":13521,"_2648":50174,"_27982":50175,"_19192":50176,"_26170":1686},"Certification authorities",[44938,46318,50014,50015],[],{"_3150":1687,"_27660":1686,"_19192":50178,"_5":13195,"_26170":1686,"_2648":50179},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3150":1688,"_27660":1686,"_5":27979,"_19192":50181,"_26170":50182,"_2648":50183},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3150":1689,"_27660":1686,"_5":27979,"_19192":50185,"_26170":50186,"_2648":50187},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3150":1690,"_27660":1686,"_5":27979,"_19192":50189,"_26170":50190,"_2648":44948},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3150":1691,"_27660":1686,"_5":27979,"_19192":50192,"_26170":50193,"_2648":50194},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3150":1692,"_27660":1686,"_5":27979,"_19192":50196,"_26170":50197,"_2648":50198},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3150":1693,"_27660":1686,"_5":27979,"_19192":50200,"_26170":50201,"_2648":50202},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3150":1694,"_27660":1686,"_5":27979,"_19192":50204,"_26170":50205,"_2648":50206},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3150":1695,"_27660":1686,"_5":27979,"_19192":50208,"_26170":50209,"_2648":50210},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3150":1696,"_27660":1686,"_5":27979,"_19192":50212,"_26170":50213,"_2648":50214},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3150":1697,"_27660":1686,"_5":27979,"_19192":50216,"_26170":50217,"_2648":50218},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3150":1698,"_27660":1686,"_5":27979,"_19192":50220,"_26170":50221,"_2648":50222},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3150":1699,"_27660":1686,"_5":27979,"_19192":50224,"_26170":50225,"_2648":50226},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3150":1700,"_27660":1686,"_5":27979,"_19192":50228,"_26170":50229,"_2648":50230},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3150":1701,"_27660":1686,"_5":27979,"_19192":50232,"_26170":50233,"_2648":50234},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3150":1702,"_27660":1686,"_5":27979,"_19192":50236,"_26170":50237,"_2648":50238},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3150":1703,"_27660":1686,"_5":27979,"_19192":50240,"_26170":50241,"_2648":50242},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3150":1704,"_27660":1686,"_5":27979,"_19192":50244,"_26170":50245,"_2648":50246},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3150":1705,"_27660":1686,"_5":27979,"_19192":50248,"_26170":50249,"_2648":50250},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3150":1706,"_27660":1686,"_5":27979,"_19192":50252,"_26170":50253,"_2648":50254},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3150":1707,"_27660":1686,"_5":27979,"_19192":50256,"_26170":50257,"_2648":50258},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3150":1708,"_27660":1686,"_5":27979,"_19192":50260,"_26170":50261,"_2648":50262},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3150":1709,"_27660":1686,"_5":27979,"_19192":50264,"_26170":50265,"_2648":50266},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3150":1710,"_27660":1686,"_19192":50268,"_5":13195,"_26170":1686,"_2648":50269},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3150":1711,"_27660":1686,"_19192":50271,"_5":13195,"_26170":1686,"_2648":50272},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3150":1712,"_27660":1686,"_19192":50274,"_5":13195,"_26170":1686,"_2648":50275},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3150":1713,"_27660":1686,"_19192":50277,"_5":13195,"_26170":50182,"_2648":50278},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3150":1714,"_27660":1686,"_19192":50280,"_5":13195,"_26170":50182,"_2648":50281},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3150":1715,"_27660":1686,"_19192":50283,"_5":13195,"_26170":50182,"_2648":50284},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3150":1716,"_27660":1686,"_19192":50286,"_5":13195,"_26170":50182,"_2648":50287},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3150":1717,"_27660":1686,"_19192":50289,"_5":13195,"_26170":50182,"_2648":50290},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3150":1718,"_27660":1686,"_19192":50292,"_5":13195,"_26170":50190,"_2648":50293},[],"Decide whether the CA will be a root or an intermediate.",{"_3150":1719,"_27660":1686,"_19192":50295,"_5":13195,"_26170":50190,"_2648":50296},[],"Choose the engine that will keep the key.",{"_3150":1720,"_27660":1686,"_19192":50298,"_5":13195,"_26170":50190,"_2648":50299},[],"Define a validity longer than that of the certificates it will issue.",{"_3150":1721,"_27660":1686,"_19192":50301,"_5":13195,"_26170":50190,"_2648":50302},[],"For an intermediate CA, make sure the parent CA is active.",{"_3150":1722,"_27660":1686,"_19192":50304,"_5":13195,"_26170":50193,"_2648":50305},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3150":1723,"_27660":1686,"_19192":50307,"_5":13195,"_26170":50197,"_2648":50308},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3150":1724,"_27660":1686,"_19192":50310,"_5":13195,"_26170":50197,"_2648":50311},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3150":1725,"_27660":1686,"_19192":50313,"_5":13195,"_26170":50201,"_2648":50314},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3150":1726,"_27660":1686,"_19192":50316,"_5":13195,"_26170":50205,"_2648":50317},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3150":1727,"_27660":1686,"_19192":50319,"_5":13195,"_26170":50205,"_2648":50320},[],"`C`: two-letter ISO 3166-1 country code.",{"_3150":1728,"_27660":1686,"_19192":50322,"_5":13195,"_26170":50205,"_2648":50323},[],"`ST`: state or province.",{"_3150":1729,"_27660":1686,"_19192":50325,"_5":13195,"_26170":50205,"_2648":50326},[],"`L`: locality.",{"_3150":1730,"_27660":1686,"_19192":50328,"_5":13195,"_26170":50205,"_2648":50329},[],"`O`: organization.",{"_3150":1731,"_27660":1686,"_19192":50331,"_5":13195,"_26170":50205,"_2648":50332},[],"`OU`: organizational unit.",{"_3150":1732,"_27660":1686,"_19192":50334,"_5":13195,"_26170":50205,"_2648":50335},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3150":1733,"_27660":1686,"_19192":50337,"_5":13195,"_26170":50209,"_2648":50338},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3150":1734,"_27660":1686,"_19192":50340,"_5":13195,"_26170":50209,"_2648":50341},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3150":1735,"_27660":1686,"_19192":50343,"_5":13195,"_26170":50213,"_2648":50344},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3150":1736,"_27660":1686,"_19192":50346,"_5":13195,"_26170":50213,"_2648":50347},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3150":1737,"_27660":1686,"_19192":50349,"_5":13195,"_26170":50217,"_2648":50350},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3150":1738,"_27660":1686,"_19192":50352,"_5":13195,"_26170":50217,"_2648":50353},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3150":1739,"_27660":1686,"_19192":50355,"_5":13195,"_26170":50221,"_2648":50356},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3150":1740,"_27660":1686,"_19192":50358,"_5":13195,"_26170":50225,"_2648":50359},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3150":1741,"_27660":1686,"_19192":50361,"_5":13195,"_26170":50229,"_2648":50362},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3150":1742,"_27660":1686,"_19192":50364,"_5":13195,"_26170":50233,"_2648":50365},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3150":1743,"_27660":1686,"_19192":50367,"_5":13195,"_26170":50237,"_2648":50368},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3150":1744,"_27660":1686,"_19192":50370,"_5":13195,"_26170":50237,"_2648":50371},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3150":1745,"_27660":1686,"_19192":50373,"_5":13195,"_26170":50241,"_2648":50374},[],"Open a CA from the inventory to review:",{"_3150":1746,"_27660":1686,"_19192":50376,"_5":13195,"_26170":50241,"_2648":50377},[],"Status and validity period.",{"_3150":1747,"_27660":1686,"_19192":50379,"_5":13195,"_26170":50241,"_2648":50380},[],"Certificate and chain in PEM format.",{"_3150":1748,"_27660":1686,"_19192":50382,"_5":13195,"_26170":50241,"_2648":50383},[],"Number of active, expired and revoked certificates.",{"_3150":1749,"_27660":1686,"_19192":50385,"_5":13195,"_26170":50241,"_2648":50386},[],"Certificates issued in **Issued Certificates**.",{"_3150":1750,"_27660":1686,"_19192":50388,"_5":13195,"_26170":50241,"_2648":50389},[],"The CRL linked to the authority.",{"_3150":1751,"_27660":1686,"_19192":50391,"_5":13195,"_26170":50241,"_2648":50392},[],"Metadata and the associated cryptographic engine.",{"_3150":1752,"_27660":1686,"_19192":50394,"_5":13195,"_26170":50241,"_2648":50395},[],"You can filter the inventory by name, status and CA type.",{"_3150":1753,"_27660":1686,"_19192":50397,"_5":13195,"_26170":50245,"_2648":50398},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3150":1754,"_27660":1686,"_19192":50400,"_5":13195,"_26170":50245,"_2648":50401},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3150":1755,"_27660":1686,"_19192":50403,"_5":13195,"_26170":50245,"_2648":50404},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3150":1756,"_27660":1686,"_19192":50406,"_5":13195,"_26170":50245,"_2648":50407},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3150":1757,"_27660":1686,"_19192":50409,"_5":13195,"_26170":50249,"_2648":50410},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3150":1758,"_27660":1686,"_19192":50412,"_5":13195,"_26170":50253,"_2648":50413},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3150":1759,"_27660":1686,"_19192":50415,"_5":13195,"_26170":50257,"_2648":50416},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3150":1760,"_27660":1686,"_19192":50418,"_5":13195,"_26170":50261,"_2648":50419},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3150":1761,"_27660":1686,"_19192":50421,"_5":13195,"_26170":50265,"_2648":50422},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3150":1762,"_27660":1686,"_19192":50424,"_5":13195,"_26170":50265,"_2648":50425},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_3150":1763,"_27660":1763,"_5":13521,"_2648":50427,"_27982":50428,"_19192":50429,"_26170":1763},"Certificate profiles",[44938,46318,50014,50015],[],{"_3150":1764,"_27660":1763,"_19192":50431,"_5":13195,"_26170":1763,"_2648":50432},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3150":1765,"_27660":1763,"_5":27979,"_19192":50434,"_26170":50435,"_2648":50436},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3150":1766,"_27660":1763,"_5":27979,"_19192":50438,"_26170":50439,"_2648":50440},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3150":1767,"_27660":1763,"_5":27979,"_19192":50442,"_26170":50443,"_2648":50444},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3150":1768,"_27660":1763,"_5":27979,"_19192":50446,"_26170":50447,"_2648":50448},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3150":1769,"_27660":1763,"_5":27979,"_19192":50450,"_26170":50451,"_2648":50452},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3150":1770,"_27660":1763,"_5":27979,"_19192":50454,"_26170":50455,"_2648":50456},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3150":1771,"_27660":1763,"_5":27979,"_19192":50458,"_26170":50459,"_2648":50460},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3150":1772,"_27660":1763,"_5":27979,"_19192":50462,"_26170":50463,"_2648":50464},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3150":1773,"_27660":1763,"_5":27979,"_19192":50466,"_26170":50467,"_2648":50468},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3150":1774,"_27660":1763,"_5":27979,"_19192":50470,"_26170":50471,"_2648":50472},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3150":1775,"_27660":1763,"_5":27979,"_19192":50474,"_26170":50475,"_2648":50476},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3150":1776,"_27660":1763,"_5":27979,"_19192":50478,"_26170":50479,"_2648":50480},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3150":1777,"_27660":1763,"_5":27979,"_19192":50482,"_26170":50483,"_2648":50484},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3150":1778,"_27660":1763,"_5":27979,"_19192":50486,"_26170":50487,"_2648":50488},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3150":1779,"_27660":1763,"_5":27979,"_19192":50490,"_26170":50491,"_2648":50492},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3150":1780,"_27660":1763,"_5":27979,"_19192":50494,"_26170":50495,"_2648":50496},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3150":1781,"_27660":1763,"_19192":50498,"_5":13195,"_26170":1763,"_2648":50499},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3150":1782,"_27660":1763,"_19192":50501,"_5":13195,"_26170":1763,"_2648":50502},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3150":1783,"_27660":1763,"_19192":50504,"_5":13195,"_26170":50439,"_2648":50505},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3150":1784,"_27660":1763,"_19192":50507,"_5":13195,"_26170":50439,"_2648":50508},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3150":1785,"_27660":1763,"_19192":50510,"_5":13195,"_26170":50443,"_2648":50511},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3150":1786,"_27660":1763,"_19192":50513,"_5":13195,"_26170":50447,"_2648":50514},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3150":1787,"_27660":1763,"_19192":50516,"_5":13195,"_26170":50447,"_2648":50517},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3150":1788,"_27660":1763,"_19192":50519,"_5":13195,"_26170":50447,"_2648":50520},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3150":1789,"_27660":1763,"_19192":50522,"_5":13195,"_26170":50451,"_2648":50523},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3150":1790,"_27660":1763,"_19192":50525,"_5":13195,"_26170":50455,"_2648":50526},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3150":1791,"_27660":1763,"_19192":50528,"_5":13195,"_26170":50455,"_2648":50529},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3150":1792,"_27660":1763,"_19192":50531,"_5":13195,"_26170":50459,"_2648":50532},[],"The cryptographic enforcement can:",{"_3150":1793,"_27660":1763,"_19192":50534,"_5":13195,"_26170":50459,"_2648":50535},[],"allow or block RSA keys;",{"_3150":1794,"_27660":1763,"_19192":50537,"_5":13195,"_26170":50459,"_2648":50538},[],"limit the supported RSA sizes;",{"_3150":1795,"_27660":1763,"_19192":50540,"_5":13195,"_26170":50459,"_2648":50541},[],"allow or block ECDSA keys;",{"_3150":1796,"_27660":1763,"_19192":50543,"_5":13195,"_26170":50459,"_2648":50544},[],"limit the supported ECDSA sizes or curves.",{"_3150":1797,"_27660":1763,"_19192":50546,"_5":13195,"_26170":50459,"_2648":50547},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3150":1798,"_27660":1763,"_19192":50549,"_5":13195,"_26170":50463,"_2648":50550},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3150":1799,"_27660":1763,"_19192":50552,"_5":13195,"_26170":50463,"_2648":48042},[],{"_3150":1800,"_27660":1763,"_19192":50554,"_5":13195,"_26170":50463,"_2648":50555},[],"First choice",{"_3150":1801,"_27660":1763,"_19192":50557,"_5":13195,"_26170":50463,"_2648":50558},[],"Second choice",{"_3150":1802,"_27660":1763,"_19192":50560,"_5":13195,"_26170":50463,"_2648":50561},[],"If neither is supplied",{"_3150":1803,"_27660":1763,"_19192":50563,"_5":13195,"_26170":50463,"_2648":50564},[],"Direct signing with a CA",{"_3150":1804,"_27660":1763,"_19192":50566,"_5":13195,"_26170":50463,"_2648":50567},[],"`issuance_profile` embedded in the request",{"_3150":1805,"_27660":1763,"_19192":50569,"_5":13195,"_26170":50463,"_2648":50570},[],"Request `issuance_profile_id`",{"_3150":1806,"_27660":1763,"_19192":50572,"_5":13195,"_26170":50463,"_2648":50573},[],"CA default profile (`profile_id`).",{"_3150":1807,"_27660":1763,"_19192":50575,"_5":13195,"_26170":50463,"_2648":50576},[],"Issuance through a DMS",{"_3150":1808,"_27660":1763,"_19192":50578,"_5":13195,"_26170":50463,"_2648":50579},[],"`settings.issuance_profile_id`",{"_3150":1809,"_27660":1763,"_19192":50581,"_5":13195,"_26170":50463,"_2648":50582},[],"`settings.issuance_profile` embedded in the DMS",{"_3150":1810,"_27660":1763,"_19192":50584,"_5":13195,"_26170":50463,"_2648":50585},[],"Enrollment CA default profile.",{"_3150":1811,"_27660":1763,"_19192":50587,"_5":13195,"_26170":50463,"_2648":50588},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3150":1812,"_27660":1763,"_19192":50590,"_5":13195,"_26170":50463,"_2648":50591},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3150":1813,"_27660":1763,"_19192":50593,"_5":13195,"_26170":50471,"_2648":50594},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3150":1814,"_27660":1763,"_19192":50596,"_5":13195,"_26170":50475,"_2648":50597},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3150":1815,"_27660":1763,"_19192":50599,"_5":13195,"_26170":50479,"_2648":50600},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3150":1816,"_27660":1763,"_19192":50602,"_5":13195,"_26170":50483,"_2648":50603},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3150":1817,"_27660":1763,"_19192":50605,"_5":13195,"_26170":50487,"_2648":50606},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3150":1818,"_27660":1763,"_19192":50608,"_5":13195,"_26170":50487,"_2648":50609},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3150":1819,"_27660":1763,"_19192":50611,"_5":13195,"_26170":50491,"_2648":50612},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3150":1820,"_27660":1763,"_19192":50614,"_5":13195,"_26170":50491,"_2648":50615},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3150":1821,"_27660":1763,"_19192":50617,"_5":13195,"_26170":50491,"_2648":50618},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3150":1822,"_27660":1763,"_19192":50620,"_5":13195,"_26170":50491,"_2648":50621},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3150":1823,"_27660":1763,"_19192":50623,"_5":13195,"_26170":50495,"_2648":50624},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3150":1824,"_27660":1763,"_19192":50626,"_5":13195,"_26170":50495,"_2648":50627},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3150":1825,"_27660":1825,"_5":13521,"_2648":50629,"_27982":50630,"_19192":50632,"_26170":1825},"Certificate validation",[44938,46318,50014,50631],"Validation",[],{"_3150":1826,"_27660":1825,"_19192":50634,"_5":13195,"_26170":1825,"_2648":50635},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3150":1827,"_27660":1825,"_5":27979,"_19192":50637,"_26170":50638,"_2648":50639},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3150":1828,"_27660":1825,"_5":27979,"_19192":50641,"_26170":50642,"_2648":50643},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3150":1829,"_27660":1825,"_5":27979,"_19192":50645,"_26170":50646,"_2648":50647},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3150":1830,"_27660":1825,"_19192":50649,"_5":13195,"_26170":1825,"_2648":50650},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3150":1831,"_27660":1825,"_19192":50652,"_5":13195,"_26170":50638,"_2648":50653},[],"Verify these criteria together:",{"_3150":1832,"_27660":1825,"_19192":50655,"_5":13195,"_26170":50638,"_2648":49638},[],{"_3150":1833,"_27660":1825,"_19192":50657,"_5":13195,"_26170":50638,"_2648":50658},[],"Required result",{"_3150":1834,"_27660":1825,"_19192":50660,"_5":13195,"_26170":50638,"_2648":50661},[],"Chain and signature",{"_3150":1835,"_27660":1825,"_19192":50663,"_5":13195,"_26170":50638,"_2648":50664},[],"Valid chain to a root deliberately installed in the consumer.",{"_3150":1836,"_27660":1825,"_19192":50666,"_5":13195,"_26170":50638,"_2648":50667},[],"Dates",{"_3150":1837,"_27660":1825,"_19192":50669,"_5":13195,"_26170":50638,"_2648":50670},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3150":1838,"_27660":1825,"_19192":50672,"_5":13195,"_26170":50638,"_2648":46018},[],{"_3150":1839,"_27660":1825,"_19192":50674,"_5":13195,"_26170":50638,"_2648":50675},[],"Name, SAN or identifier matches the expected peer.",{"_3150":1840,"_27660":1825,"_19192":50677,"_5":13195,"_26170":50638,"_2648":45328},[],{"_3150":1841,"_27660":1825,"_19192":50679,"_5":13195,"_26170":50638,"_2648":50680},[],"KU, EKU and constraints permit the specific operation.",{"_3150":1842,"_27660":1825,"_19192":50682,"_5":13195,"_26170":50638,"_2648":50683},[],"Revocation",{"_3150":1843,"_27660":1825,"_19192":50685,"_5":13195,"_26170":50638,"_2648":50686},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3150":1844,"_27660":1825,"_19192":50688,"_5":13195,"_26170":50638,"_2648":50689},[],"Authorization",{"_3150":1845,"_27660":1825,"_19192":50691,"_5":13195,"_26170":50638,"_2648":50692},[],"The application permits that identity to perform the action.",{"_3150":1846,"_27660":1825,"_19192":50694,"_5":13195,"_26170":50638,"_2648":50695},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3150":1847,"_27660":1825,"_19192":50697,"_5":13195,"_26170":50642,"_2648":50698},[],"Mechanism",{"_3150":1848,"_27660":1825,"_19192":50700,"_5":13195,"_26170":50642,"_2648":50701},[],"When to use it",{"_3150":1849,"_27660":1825,"_19192":50703,"_5":13195,"_26170":50642,"_2648":50704},[],"What you must maintain",{"_3150":1850,"_27660":1825,"_19192":50706,"_5":13195,"_26170":50642,"_2648":50707},[],"OCSP",{"_3150":1851,"_27660":1825,"_19192":50709,"_5":13195,"_26170":50642,"_2648":50710},[],"Status query for a specific certificate.",{"_3150":1852,"_27660":1825,"_19192":50712,"_5":13195,"_26170":50642,"_2648":50713},[],"Responder access, signature verification and cache/freshness policy.",{"_3150":1853,"_27660":1825,"_19192":50715,"_5":13195,"_26170":50642,"_2648":50716},[],"CRL",{"_3150":1854,"_27660":1825,"_19192":50718,"_5":13195,"_26170":50642,"_2648":50719},[],"Local checks for many certificates or offline operation.",{"_3150":1855,"_27660":1825,"_19192":50721,"_5":13195,"_26170":50642,"_2648":50722},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3150":1856,"_27660":1825,"_19192":50724,"_5":13195,"_26170":50642,"_2648":50725},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3150":1857,"_27660":1825,"_19192":50727,"_5":13195,"_26170":50642,"_2648":50728},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3150":1858,"_27660":1825,"_19192":50730,"_5":13195,"_26170":50646,"_2648":50731},[],"Accept a current, authorized certificate with a known chain.",{"_3150":1859,"_27660":1825,"_19192":50733,"_5":13195,"_26170":50646,"_2648":50734},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3150":1860,"_27660":1825,"_19192":50736,"_5":13195,"_26170":50646,"_2648":50737},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3150":1861,"_27660":1825,"_19192":50739,"_5":13195,"_26170":50646,"_2648":50740},[],"Check that a new connection with that identity is rejected.",{"_3150":1862,"_27660":1825,"_19192":50742,"_5":13195,"_26170":50646,"_2648":50743},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3150":1863,"_27660":1825,"_19192":50745,"_5":13195,"_26170":50646,"_2648":50746},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3150":1864,"_27660":1825,"_19192":50748,"_5":13195,"_26170":50646,"_2648":50749},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3150":1865,"_27660":1825,"_19192":50751,"_5":13195,"_26170":50646,"_2648":50752},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":1866,"_27660":1825,"_19192":50754,"_5":13195,"_26170":50646,"_2648":50755},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3150":1867,"_27660":1867,"_5":13521,"_2648":50757,"_27982":50758,"_19192":50759,"_26170":1867},"Certificates",[44938,46318,50014,50015],[],{"_3150":1868,"_27660":1867,"_19192":50761,"_5":13195,"_26170":1867,"_2648":50762},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3150":1869,"_27660":1867,"_5":27979,"_19192":50764,"_26170":50765,"_2648":50766},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3150":1870,"_27660":1867,"_5":27979,"_19192":50768,"_26170":50769,"_2648":50770},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3150":1871,"_27660":1867,"_5":27979,"_19192":50772,"_26170":50773,"_2648":50774},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3150":1872,"_27660":1867,"_5":27979,"_19192":50776,"_26170":50777,"_2648":50778},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3150":1873,"_27660":1867,"_5":27979,"_19192":50780,"_26170":50781,"_2648":50782},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3150":1874,"_27660":1867,"_5":27979,"_19192":50784,"_26170":50785,"_2648":50786},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3150":1875,"_27660":1867,"_5":27979,"_19192":50788,"_26170":50789,"_2648":50790},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3150":1876,"_27660":1867,"_5":27979,"_19192":50792,"_26170":50793,"_2648":50794},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3150":1877,"_27660":1867,"_5":27979,"_19192":50796,"_26170":50797,"_2648":50798},[],"/docs/platform/pki/certificates#continue","Continue",{"_3150":1878,"_27660":1867,"_19192":50800,"_5":13195,"_26170":1867,"_2648":50801},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3150":1879,"_27660":1867,"_19192":50803,"_5":13195,"_26170":50765,"_2648":50804},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3150":1880,"_27660":1867,"_19192":50806,"_5":13195,"_26170":50765,"_2648":50807},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3150":1881,"_27660":1867,"_19192":50809,"_5":13195,"_26170":50769,"_2648":50810},[],"Download the PEM and inspect it:",{"_3150":1882,"_27660":1867,"_19192":50812,"_5":13195,"_26170":50769,"_2648":50813},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3150":1883,"_27660":1867,"_19192":50815,"_5":13195,"_26170":50773,"_2648":50816},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3150":1884,"_27660":1867,"_19192":50818,"_5":13195,"_26170":50773,"_2648":50819},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3150":1885,"_27660":1867,"_19192":50821,"_5":13195,"_26170":50773,"_2648":50822},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3150":1886,"_27660":1867,"_19192":50824,"_5":13195,"_26170":50773,"_2648":50825},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3150":1887,"_27660":1867,"_19192":50827,"_5":13195,"_26170":50773,"_2648":50828},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3150":1888,"_27660":1867,"_19192":50830,"_5":13195,"_26170":50773,"_2648":50831},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3150":1889,"_27660":1867,"_19192":50833,"_5":13195,"_26170":50773,"_2648":50834},[],"For browser key generation, follow Issue your first certificate.",{"_3150":1890,"_27660":1867,"_19192":50836,"_5":13195,"_26170":50777,"_2648":50837},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3150":1891,"_27660":1867,"_19192":50839,"_5":13195,"_26170":50781,"_2648":50840},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3150":1892,"_27660":1867,"_19192":50842,"_5":13195,"_26170":50785,"_2648":50843},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3150":1893,"_27660":1867,"_19192":50845,"_5":13195,"_26170":50789,"_2648":50846},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3150":1894,"_27660":1867,"_19192":50848,"_5":13195,"_26170":50789,"_2648":50849},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3150":1895,"_27660":1867,"_19192":50851,"_5":13195,"_26170":50789,"_2648":50852},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3150":1896,"_27660":1867,"_19192":50854,"_5":13195,"_26170":50793,"_2648":50855},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3150":1897,"_27660":1867,"_19192":50857,"_5":13195,"_26170":50793,"_2648":50858},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3150":1898,"_27660":1867,"_19192":50860,"_5":13195,"_26170":50793,"_2648":50861},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3150":1899,"_27660":1867,"_19192":50863,"_5":13195,"_26170":50797,"_2648":50864},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":1900,"_27660":1867,"_19192":50866,"_5":13195,"_26170":50797,"_2648":50867},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3150":1901,"_27660":1901,"_5":13521,"_2648":50869,"_27982":50870,"_19192":50872,"_26170":1901},"Certificate lifecycle",[44938,46318,50014,50871],"Concepts",[],{"_3150":1902,"_27660":1901,"_19192":50874,"_5":13195,"_26170":1901,"_2648":50875},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3150":1903,"_27660":1901,"_5":27979,"_19192":50877,"_26170":50878,"_2648":50879},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3150":1904,"_27660":1901,"_5":27979,"_19192":50881,"_26170":50882,"_2648":50883},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3150":1905,"_27660":1901,"_5":27979,"_19192":50885,"_26170":50886,"_2648":50887},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3150":1906,"_27660":1901,"_5":27979,"_19192":50889,"_26170":50890,"_2648":50891},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3150":1907,"_27660":1901,"_5":27979,"_19192":50893,"_26170":50894,"_2648":50895},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3150":1908,"_27660":1901,"_5":27979,"_19192":50897,"_26170":50898,"_2648":50899},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3150":1909,"_27660":1901,"_5":27979,"_19192":50901,"_26170":50902,"_2648":50903},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3150":1910,"_27660":1901,"_5":27979,"_19192":50905,"_26170":50906,"_2648":50907},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3150":1911,"_27660":1901,"_5":27979,"_19192":50909,"_26170":50910,"_2648":50911},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3150":1912,"_27660":1901,"_5":27979,"_19192":50913,"_26170":50914,"_2648":50915},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3150":1913,"_27660":1901,"_19192":50917,"_5":13195,"_26170":1901,"_2648":50918},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3150":1914,"_27660":1901,"_19192":50920,"_5":13195,"_26170":50882,"_2648":50921},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3150":1915,"_27660":1901,"_19192":50923,"_5":13195,"_26170":50886,"_2648":50924},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3150":1916,"_27660":1901,"_19192":50926,"_5":13195,"_26170":50890,"_2648":50927},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3150":1917,"_27660":1901,"_19192":50929,"_5":13195,"_26170":50894,"_2648":50930},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3150":1918,"_27660":1901,"_19192":50932,"_5":13195,"_26170":50898,"_2648":50933},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3150":1919,"_27660":1901,"_19192":50935,"_5":13195,"_26170":50902,"_2648":50936},[],"Lamassu persists four X.509 states:",{"_3150":1920,"_27660":1901,"_19192":50938,"_5":13195,"_26170":50902,"_2648":50939},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3150":1921,"_27660":1901,"_19192":50941,"_5":13195,"_26170":50902,"_2648":50942},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3150":1922,"_27660":1901,"_19192":50944,"_5":13195,"_26170":50902,"_2648":50945},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3150":1923,"_27660":1901,"_19192":50947,"_5":13195,"_26170":50902,"_2648":50948},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3150":1924,"_27660":1901,"_19192":50950,"_5":13195,"_26170":50902,"_2648":50951},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3150":1925,"_27660":1901,"_19192":50953,"_5":13195,"_26170":50906,"_2648":50954},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3150":1926,"_27660":1901,"_19192":50956,"_5":13195,"_26170":50906,"_2648":50957},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3150":1927,"_27660":1901,"_19192":50959,"_5":13195,"_26170":50906,"_2648":50960},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3150":1928,"_27660":1901,"_19192":50962,"_5":13195,"_26170":50910,"_2648":50963},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3150":1929,"_27660":1901,"_19192":50965,"_5":13195,"_26170":50910,"_2648":50966},[],"Before confirming:",{"_3150":1930,"_27660":1901,"_19192":50968,"_5":13195,"_26170":50910,"_2648":50969},[],"Identify DMSs, devices and services that trust that chain.",{"_3150":1931,"_27660":1901,"_19192":50971,"_5":13195,"_26170":50910,"_2648":50972},[],"Distribute the new chain of trust.",{"_3150":1932,"_27660":1901,"_19192":50974,"_5":13195,"_26170":50910,"_2648":50975},[],"Reissue the necessary identities.",{"_3150":1933,"_27660":1901,"_19192":50977,"_5":13195,"_26170":50910,"_2648":50978},[],"Check OCSP and CRL from a real consumer.",{"_3150":1934,"_27660":1901,"_19192":50980,"_5":13195,"_26170":50910,"_2648":50981},[],"Revoke the old CA once no legitimate traffic remains.",{"_3150":1935,"_27660":1901,"_19192":50983,"_5":13195,"_26170":50910,"_2648":50984},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3150":1936,"_27660":1901,"_19192":50986,"_5":13195,"_26170":50914,"_2648":50987},[],"Certificates entering the preventive or critical renewal window.",{"_3150":1937,"_27660":1901,"_19192":50989,"_5":13195,"_26170":50914,"_2648":50990},[],"Repeated enrollment or re-enrollment failures.",{"_3150":1938,"_27660":1901,"_19192":50992,"_5":13195,"_26170":50914,"_2648":50993},[],"Status changes and revocation reasons.",{"_3150":1939,"_27660":1901,"_19192":50995,"_5":13195,"_26170":50914,"_2648":50996},[],"OCSP and CRL publication and validity.",{"_3150":1940,"_27660":1901,"_19192":50998,"_5":13195,"_26170":50914,"_2648":50999},[],"Dependencies still presenting a replaced certificate.",{"_3150":1941,"_27660":1901,"_19192":51001,"_5":13195,"_26170":50914,"_2648":51002},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3150":1942,"_27660":1942,"_5":13521,"_2648":51004,"_27982":51005,"_19192":51006,"_26170":1942},"Trust model",[44938,46318,50014,50871],[],{"_3150":1943,"_27660":1942,"_19192":51008,"_5":13195,"_26170":1942,"_2648":51009},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3150":1944,"_27660":1942,"_5":27979,"_19192":51011,"_26170":51012,"_2648":51013},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3150":1945,"_27660":1942,"_5":27979,"_19192":51015,"_26170":51016,"_2648":51017},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3150":1946,"_27660":1942,"_5":27979,"_19192":51019,"_26170":51020,"_2648":51021},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3150":1947,"_27660":1942,"_5":27979,"_19192":51023,"_26170":51024,"_2648":51025},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3150":1948,"_27660":1942,"_5":27979,"_19192":51027,"_26170":51028,"_2648":51029},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3150":1949,"_27660":1942,"_5":27979,"_19192":51031,"_26170":51032,"_2648":51033},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3150":1950,"_27660":1942,"_5":27979,"_19192":51035,"_26170":51036,"_2648":51037},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3150":1951,"_27660":1942,"_5":27979,"_19192":51039,"_26170":51040,"_2648":51041},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3150":1952,"_27660":1942,"_5":27979,"_19192":51043,"_26170":51044,"_2648":51045},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3150":1953,"_27660":1942,"_5":27979,"_19192":51047,"_26170":51048,"_2648":51049},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3150":1954,"_27660":1942,"_19192":51051,"_5":13195,"_26170":1942,"_2648":51052},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3150":1955,"_27660":1942,"_19192":51054,"_5":13195,"_26170":51016,"_2648":51055},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3150":1956,"_27660":1942,"_19192":51057,"_5":13195,"_26170":51020,"_2648":51058},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3150":1957,"_27660":1942,"_19192":51060,"_5":13195,"_26170":51024,"_2648":51061},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3150":1958,"_27660":1942,"_19192":51063,"_5":13195,"_26170":51028,"_2648":51064},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3150":1959,"_27660":1942,"_19192":51066,"_5":13195,"_26170":51032,"_2648":51067},[],"The device proves it can enroll according to the DMS policy.",{"_3150":1960,"_27660":1942,"_19192":51069,"_5":13195,"_26170":51032,"_2648":51070},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3150":1961,"_27660":1942,"_19192":51072,"_5":13195,"_26170":51032,"_2648":51073},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3150":1962,"_27660":1942,"_19192":51075,"_5":13195,"_26170":51032,"_2648":51076},[],"The device installs the certificate and the chain it needs.",{"_3150":1963,"_27660":1942,"_19192":51078,"_5":13195,"_26170":51032,"_2648":51079},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3150":1964,"_27660":1942,"_19192":51081,"_5":13195,"_26170":51032,"_2648":51082},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3150":1965,"_27660":1942,"_19192":51084,"_5":13195,"_26170":51036,"_2648":51085},[],"A DMS relates three sets that are worth designing separately:",{"_3150":1966,"_27660":1942,"_19192":51087,"_5":13195,"_26170":51036,"_2648":51088},[],"**Enrollment CA:** signs the new identities.",{"_3150":1967,"_27660":1942,"_19192":51090,"_5":13195,"_26170":51036,"_2648":51091},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_3150":1968,"_27660":1942,"_19192":51093,"_5":13195,"_26170":51036,"_2648":51094},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3150":1969,"_27660":1942,"_19192":51096,"_5":13195,"_26170":51036,"_2648":51097},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3150":1970,"_27660":1942,"_19192":51099,"_5":13195,"_26170":51040,"_2648":51100},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3150":1971,"_27660":1942,"_19192":51102,"_5":13195,"_26170":51040,"_2648":51103},[],"that the current date is between `Not Before` and `Not After`;",{"_3150":1972,"_27660":1942,"_19192":51105,"_5":13195,"_26170":51040,"_2648":51106},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3150":1973,"_27660":1942,"_19192":51108,"_5":13195,"_26170":51040,"_2648":51109},[],"that names, SANs and subject match the expected identity;",{"_3150":1974,"_27660":1942,"_19192":51111,"_5":13195,"_26170":51040,"_2648":51112},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3150":1975,"_27660":1942,"_19192":51114,"_5":13195,"_26170":51040,"_2648":51115},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3150":1976,"_27660":1942,"_19192":51117,"_5":13195,"_26170":51040,"_2648":51118},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3150":1977,"_27660":1942,"_19192":51120,"_5":13195,"_26170":51044,"_2648":51121},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3150":1978,"_27660":1942,"_19192":51123,"_5":13195,"_26170":51048,"_2648":51124},[],"Keep the root out of daily operations, or with very restricted access.",{"_3150":1979,"_27660":1942,"_19192":51126,"_5":13195,"_26170":51048,"_2648":51127},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3150":1980,"_27660":1942,"_19192":51129,"_5":13195,"_26170":51048,"_2648":51130},[],"Assign explicit profiles to every use case.",{"_3150":1981,"_27660":1942,"_19192":51132,"_5":13195,"_26170":51048,"_2648":51133},[],"Distribute the new trust before starting a rotation.",{"_3150":1982,"_27660":1942,"_19192":51135,"_5":13195,"_26170":51048,"_2648":51136},[],"Keep enough overlap to renew a disconnected fleet.",{"_3150":1983,"_27660":1942,"_19192":51138,"_5":13195,"_26170":51048,"_2648":51139},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3150":1984,"_27660":1942,"_19192":51141,"_5":13195,"_26170":51048,"_2648":51142},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3150":1985,"_27660":1985,"_5":13521,"_2648":51144,"_27982":51145,"_19192":51146,"_26170":1985},"Revocation lists (CRL)",[44938,46318,50014,50631],[],{"_3150":1986,"_27660":1985,"_19192":51148,"_5":13195,"_26170":1985,"_2648":51149},[],"Generate and distribute signed lists to validate certificates offline.",{"_3150":1987,"_27660":1985,"_5":27979,"_19192":51151,"_26170":51152,"_2648":51153},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3150":1988,"_27660":1985,"_5":27979,"_19192":51155,"_26170":51156,"_2648":51157},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3150":1989,"_27660":1985,"_5":27979,"_19192":51159,"_26170":51160,"_2648":51161},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3150":1990,"_27660":1985,"_5":27979,"_19192":51163,"_26170":51164,"_2648":51165},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3150":1991,"_27660":1985,"_5":27979,"_19192":51167,"_26170":51168,"_2648":51169},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3150":1992,"_27660":1985,"_5":27979,"_19192":51171,"_26170":51172,"_2648":51173},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3150":1993,"_27660":1985,"_5":27979,"_19192":51175,"_26170":51176,"_2648":51177},[],"/docs/platform/pki/crl#references","References",{"_3150":1994,"_27660":1985,"_19192":51179,"_5":13195,"_26170":1985,"_2648":51180},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3150":1995,"_27660":1985,"_19192":51182,"_5":13195,"_26170":51152,"_2648":51183},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3150":1996,"_27660":1985,"_19192":51185,"_5":13195,"_26170":51152,"_2648":51186},[],"`crl_options` field",{"_3150":1997,"_27660":1985,"_19192":51188,"_5":13195,"_26170":51152,"_2648":45328},[],{"_3150":1998,"_27660":1985,"_19192":51190,"_5":13195,"_26170":51152,"_2648":51191},[],"Backend initial value",{"_3150":1999,"_27660":1985,"_19192":51193,"_5":13195,"_26170":51152,"_2648":51194},[],"`validity`",{"_3150":2000,"_27660":1985,"_19192":51196,"_5":13195,"_26170":51152,"_2648":51197},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3150":2001,"_27660":1985,"_19192":51199,"_5":13195,"_26170":51152,"_2648":51200},[],"7 days.",{"_3150":2002,"_27660":1985,"_19192":51202,"_5":13195,"_26170":51152,"_2648":51203},[],"`refresh_interval`",{"_3150":2003,"_27660":1985,"_19192":51205,"_5":13195,"_26170":51152,"_2648":51206},[],"Time since publication that triggers scheduled renewal.",{"_3150":2004,"_27660":1985,"_19192":51208,"_5":13195,"_26170":51152,"_2648":51209},[],"6 days and 23 hours.",{"_3150":2005,"_27660":1985,"_19192":51211,"_5":13195,"_26170":51152,"_2648":51212},[],"`regenerate_on_revoke`",{"_3150":2006,"_27660":1985,"_19192":51214,"_5":13195,"_26170":51152,"_2648":51215},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3150":2007,"_27660":1985,"_19192":51217,"_5":13195,"_26170":51152,"_2648":51218},[],"`true`.",{"_3150":2008,"_27660":1985,"_19192":51220,"_5":13195,"_26170":51152,"_2648":51221},[],"`subject_key_id_signer`",{"_3150":2009,"_27660":1985,"_19192":51223,"_5":13195,"_26170":51152,"_2648":51224},[],"Configuration field initialized with the CA’s SKI.",{"_3150":2010,"_27660":1985,"_19192":51226,"_5":13195,"_26170":51152,"_2648":51227},[],"CA SKI.",{"_3150":2011,"_27660":1985,"_19192":51229,"_5":13195,"_26170":51152,"_2648":51230},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_3150":2012,"_27660":1985,"_19192":51232,"_5":13195,"_26170":51152,"_2648":51233},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3150":2013,"_27660":1985,"_19192":51235,"_5":13195,"_26170":51156,"_2648":51236},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_3150":2014,"_27660":1985,"_19192":51238,"_5":13195,"_26170":51156,"_2648":51239},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3150":2015,"_27660":1985,"_19192":51241,"_5":13195,"_26170":51156,"_2648":51242},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3150":2016,"_27660":1985,"_19192":51244,"_5":13195,"_26170":51160,"_2648":51245},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3150":2017,"_27660":1985,"_19192":51247,"_5":13195,"_26170":51160,"_2648":51248},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3150":2018,"_27660":1985,"_19192":51250,"_5":13195,"_26170":51164,"_2648":51251},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3150":2019,"_27660":1985,"_19192":51253,"_5":13195,"_26170":51164,"_2648":51254},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3150":2020,"_27660":1985,"_19192":51256,"_5":13195,"_26170":51164,"_2648":51257},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3150":2021,"_27660":1985,"_19192":51259,"_5":13195,"_26170":51164,"_2648":51260},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3150":2022,"_27660":1985,"_19192":51262,"_5":13195,"_26170":51164,"_2648":51263},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3150":2023,"_27660":1985,"_19192":51265,"_5":13195,"_26170":51168,"_2648":51266},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3150":2024,"_27660":1985,"_19192":51268,"_5":13195,"_26170":51168,"_2648":48045},[],{"_3150":2025,"_27660":1985,"_19192":51270,"_5":13195,"_26170":51168,"_2648":51271},[],"Relative path",{"_3150":2026,"_27660":1985,"_19192":51273,"_5":13195,"_26170":51168,"_2648":48042},[],{"_3150":2027,"_27660":1985,"_19192":51275,"_5":13195,"_26170":51168,"_2648":51276},[],"`GET`",{"_3150":2028,"_27660":1985,"_19192":51278,"_5":13195,"_26170":51168,"_2648":51279},[],"`/v1/roles/{ca-ski}`",{"_3150":2029,"_27660":1985,"_19192":51281,"_5":13195,"_26170":51168,"_2648":51282},[],"Read `crl_options` and `latest_crl`.",{"_3150":2030,"_27660":1985,"_19192":51284,"_5":13195,"_26170":51168,"_2648":51285},[],"`PUT`",{"_3150":2031,"_27660":1985,"_19192":51287,"_5":13195,"_26170":51168,"_2648":51279},[],{"_3150":2032,"_27660":1985,"_19192":51289,"_5":13195,"_26170":51168,"_2648":51290},[],"Replace CRL configuration.",{"_3150":2033,"_27660":1985,"_19192":51292,"_5":13195,"_26170":51168,"_2648":51293},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3150":2034,"_27660":1985,"_19192":51295,"_5":13195,"_26170":51168,"_2648":51296},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3150":2035,"_27660":1985,"_19192":51298,"_5":13195,"_26170":51172,"_2648":51299},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3150":2036,"_27660":1985,"_19192":51301,"_5":13195,"_26170":51176,"_2648":51302},[],"RFC 5280: X.509 and CRL profile.",{"_3150":2037,"_27660":1985,"_19192":51304,"_5":13195,"_26170":51176,"_2648":51305},[],"OpenSSL: openssl-crl.",{"_3150":2038,"_27660":1985,"_19192":51307,"_5":13195,"_26170":51176,"_2648":51308},[],"OpenSSL: openssl-verify.",{"_3150":2039,"_27660":1985,"_19192":51310,"_5":13195,"_26170":51176,"_2648":51311},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3150":2040,"_27660":1985,"_19192":51313,"_5":13195,"_26170":51176,"_2648":51314},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3150":2041,"_27660":2041,"_5":13521,"_2648":51316,"_27982":51317,"_19192":51318,"_26170":2041},"Keys and cryptographic engines",[44938,46318,50014,50015],[],{"_3150":2042,"_27660":2041,"_19192":51320,"_5":13195,"_26170":2041,"_2648":51321},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3150":2043,"_27660":2041,"_5":27979,"_19192":51323,"_26170":51324,"_2648":51325},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3150":2044,"_27660":2041,"_5":27979,"_19192":51327,"_26170":51328,"_2648":51329},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3150":2045,"_27660":2041,"_5":27979,"_19192":51331,"_26170":51332,"_2648":51333},[],"/docs/platform/pki/key-management#file-system","File System",{"_3150":2046,"_27660":2041,"_5":27979,"_19192":51335,"_26170":51336,"_2648":51337},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3150":2047,"_27660":2041,"_5":27979,"_19192":51339,"_26170":51340,"_2648":51341},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3150":2048,"_27660":2041,"_5":27979,"_19192":51343,"_26170":51344,"_2648":51345},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3150":2049,"_27660":2041,"_5":27979,"_19192":51347,"_26170":51348,"_2648":51349},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3150":2050,"_27660":2041,"_5":27979,"_19192":51351,"_26170":51352,"_2648":51353},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3150":2051,"_27660":2041,"_5":27979,"_19192":51355,"_26170":51356,"_2648":51357},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3150":2052,"_27660":2041,"_5":27979,"_19192":51359,"_26170":51360,"_2648":51361},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3150":2053,"_27660":2041,"_5":27979,"_19192":51363,"_26170":51364,"_2648":51365},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3150":2054,"_27660":2041,"_5":27979,"_19192":51367,"_26170":51368,"_2648":51369},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3150":2055,"_27660":2041,"_5":27979,"_19192":51371,"_26170":51372,"_2648":51373},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3150":2056,"_27660":2041,"_5":27979,"_19192":51375,"_26170":51376,"_2648":51377},[],"/docs/platform/pki/key-management#view-details","View details",{"_3150":2057,"_27660":2041,"_5":27979,"_19192":51379,"_26170":51380,"_2648":51381},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3150":2058,"_27660":2041,"_5":27979,"_19192":51383,"_26170":51384,"_2648":51385},[],"/docs/platform/pki/key-management#sign","Sign",{"_3150":2059,"_27660":2041,"_5":27979,"_19192":51387,"_26170":51388,"_2648":51389},[],"/docs/platform/pki/key-management#verify","Verify",{"_3150":2060,"_27660":2041,"_5":27979,"_19192":51391,"_26170":51392,"_2648":51393},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3150":2061,"_27660":2041,"_5":27979,"_19192":51395,"_26170":51396,"_2648":51397},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3150":2062,"_27660":2041,"_5":27979,"_19192":51399,"_26170":51400,"_2648":51401},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3150":2063,"_27660":2041,"_19192":51403,"_5":13195,"_26170":2041,"_2648":51404},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3150":2064,"_27660":2041,"_19192":51406,"_5":13195,"_26170":2041,"_2648":51407},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3150":2065,"_27660":2041,"_19192":51409,"_5":13195,"_26170":51324,"_2648":51410},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3150":2066,"_27660":2041,"_19192":51412,"_5":13195,"_26170":51324,"_2648":51413},[],"In practice, it lets you:",{"_3150":2067,"_27660":2041,"_19192":51415,"_5":13195,"_26170":51324,"_2648":51416},[],"Generate new key pairs from Lamassu IoT.",{"_3150":2068,"_27660":2041,"_19192":51418,"_5":13195,"_26170":51324,"_2648":51419},[],"Import keys created externally.",{"_3150":2069,"_27660":2041,"_19192":51421,"_5":13195,"_26170":51324,"_2648":51422},[],"Delegate custody and cryptographic operations to external engines.",{"_3150":2070,"_27660":2041,"_19192":51424,"_5":13195,"_26170":51324,"_2648":51425},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3150":2071,"_27660":2041,"_19192":51427,"_5":13195,"_26170":51328,"_2648":51428},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3150":2072,"_27660":2041,"_19192":51430,"_5":13195,"_26170":51328,"_2648":51431},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3150":2073,"_27660":2041,"_19192":51433,"_5":13195,"_26170":51328,"_2648":51434},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3150":2074,"_27660":2041,"_19192":51436,"_5":13195,"_26170":51332,"_2648":51437},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3150":2075,"_27660":2041,"_19192":51439,"_5":13195,"_26170":51336,"_2648":51440},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3150":2076,"_27660":2041,"_19192":51442,"_5":13195,"_26170":51340,"_2648":51443},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3150":2077,"_27660":2041,"_19192":51445,"_5":13195,"_26170":51344,"_2648":51446},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3150":2078,"_27660":2041,"_19192":51448,"_5":13195,"_26170":51348,"_2648":51449},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3150":2079,"_27660":2041,"_19192":51451,"_5":13195,"_26170":51352,"_2648":51452},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3150":2080,"_27660":2041,"_19192":51454,"_5":13195,"_26170":51352,"_2648":51455},[],"Lamassu shows the enabled engines in the console.",{"_3150":2081,"_27660":2041,"_19192":51457,"_5":13195,"_26170":51352,"_2648":51458},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3150":2082,"_27660":2041,"_19192":51460,"_5":13195,"_26170":51352,"_2648":51461},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3150":2083,"_27660":2041,"_19192":51463,"_5":13195,"_26170":51356,"_2648":51464},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3150":2084,"_27660":2041,"_19192":51466,"_5":13195,"_26170":51356,"_2648":51467},[],"The table includes the following fields:",{"_3150":2085,"_27660":2041,"_19192":51469,"_5":13195,"_26170":51356,"_2648":51470},[],"**Name**: descriptive name of the key.",{"_3150":2086,"_27660":2041,"_19192":51472,"_5":13195,"_26170":51356,"_2648":51473},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3150":2087,"_27660":2041,"_19192":51475,"_5":13195,"_26170":51356,"_2648":51476},[],"**Strength**: visual indicator of cryptographic strength.",{"_3150":2088,"_27660":2041,"_19192":51478,"_5":13195,"_26170":51356,"_2648":51479},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3150":2089,"_27660":2041,"_19192":51481,"_5":13195,"_26170":51356,"_2648":51482},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3150":2090,"_27660":2041,"_19192":51484,"_5":13195,"_26170":51356,"_2648":51485},[],"**Aliases**: alternative names associated with the key.",{"_3150":2091,"_27660":2041,"_19192":51487,"_5":13195,"_26170":51356,"_2648":51488},[],"**Tags**: labels for classification and search.",{"_3150":2092,"_27660":2041,"_19192":51490,"_5":13195,"_26170":51356,"_2648":51491},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3150":2093,"_27660":2041,"_19192":51493,"_5":13195,"_26170":51356,"_2648":51494},[],"From this view you also reach the most common actions:",{"_3150":2094,"_27660":2041,"_19192":51496,"_5":13195,"_26170":51356,"_2648":51497},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3150":2095,"_27660":2041,"_19192":51499,"_5":13195,"_26170":51356,"_2648":51500},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3150":2096,"_27660":2041,"_19192":51502,"_5":13195,"_26170":51356,"_2648":51503},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3150":2097,"_27660":2041,"_19192":51505,"_5":13195,"_26170":51356,"_2648":51506},[],"**Delete Key** to remove the key from the system.",{"_3150":2098,"_27660":2041,"_19192":51508,"_5":13195,"_26170":51360,"_2648":51509},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3150":2099,"_27660":2041,"_19192":51511,"_5":13195,"_26170":51364,"_2648":51512},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3150":2100,"_27660":2041,"_19192":51514,"_5":13195,"_26170":51364,"_2648":51515},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3150":2101,"_27660":2041,"_19192":51517,"_5":13195,"_26170":51364,"_2648":51518},[],"**Key Name**: unique and descriptive name.",{"_3150":2102,"_27660":2041,"_19192":51520,"_5":13195,"_26170":51364,"_2648":51521},[],"**Crypto Engine**: engine that will keep the key.",{"_3150":2103,"_27660":2041,"_19192":51523,"_5":13195,"_26170":51364,"_2648":51524},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3150":2104,"_27660":2041,"_19192":51526,"_5":13195,"_26170":51364,"_2648":51527},[],"**Tags**: metadata to classify the key.",{"_3150":2105,"_27660":2041,"_19192":51529,"_5":13195,"_26170":51364,"_2648":51530},[],"**Metadata**: additional information for advanced uses.",{"_3150":2106,"_27660":2041,"_19192":51532,"_5":13195,"_26170":51368,"_2648":51533},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3150":2107,"_27660":2041,"_19192":51535,"_5":13195,"_26170":51368,"_2648":51536},[],"When you have an exportable private key and the destination engine supports import.",{"_3150":2108,"_27660":2041,"_19192":51538,"_5":13195,"_26170":51368,"_2648":51539},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3150":2109,"_27660":2041,"_19192":51541,"_5":13195,"_26170":51368,"_2648":51542},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3150":2110,"_27660":2041,"_19192":51544,"_5":13195,"_26170":51368,"_2648":51545},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3150":2111,"_27660":2041,"_19192":51547,"_5":13195,"_26170":51368,"_2648":51548},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3150":2112,"_27660":2041,"_19192":51550,"_5":13195,"_26170":51368,"_2648":51551},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3150":2113,"_27660":2041,"_19192":51553,"_5":13195,"_26170":51368,"_2648":51554},[],"**Tags**: labels for organization and search.",{"_3150":2114,"_27660":2041,"_19192":51556,"_5":13195,"_26170":51368,"_2648":51557},[],"**Metadata**: additional optional information.",{"_3150":2115,"_27660":2041,"_19192":51559,"_5":13195,"_26170":51368,"_2648":51560},[],"**Private Key (PEM)**: private key in PEM format.",{"_3150":2116,"_27660":2041,"_19192":51562,"_5":13195,"_26170":51368,"_2648":51563},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3150":2117,"_27660":2041,"_19192":51565,"_5":13195,"_26170":51372,"_2648":51566},[],"Each registered key has a detail view and several operational actions.",{"_3150":2118,"_27660":2041,"_19192":51568,"_5":13195,"_26170":51376,"_2648":51569},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3150":2119,"_27660":2041,"_19192":51571,"_5":13195,"_26170":51376,"_2648":51572},[],"The **Overview** tab shows, among others, these fields:",{"_3150":2120,"_27660":2041,"_19192":51574,"_5":13195,"_26170":51376,"_2648":51575},[],"**Key Name**: descriptive name.",{"_3150":2121,"_27660":2041,"_19192":51577,"_5":13195,"_26170":51376,"_2648":51578},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3150":2122,"_27660":2041,"_19192":51580,"_5":13195,"_26170":51376,"_2648":51581},[],"**Tags**: associated labels.",{"_3150":2123,"_27660":2041,"_19192":51583,"_5":13195,"_26170":51376,"_2648":51584},[],"**Aliases**: alternative names.",{"_3150":2124,"_27660":2041,"_19192":51586,"_5":13195,"_26170":51376,"_2648":51587},[],"**Crypto Engine**: engine where the key resides.",{"_3150":2125,"_27660":2041,"_19192":51589,"_5":13195,"_26170":51376,"_2648":51590},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3150":2126,"_27660":2041,"_19192":51592,"_5":13195,"_26170":51376,"_2648":51593},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3150":2127,"_27660":2041,"_19192":51595,"_5":13195,"_26170":51376,"_2648":51596},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3150":2128,"_27660":2041,"_19192":51598,"_5":13195,"_26170":51380,"_2648":51599},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3150":2129,"_27660":2041,"_19192":51601,"_5":13195,"_26170":51380,"_2648":51602},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3150":2130,"_27660":2041,"_19192":51604,"_5":13195,"_26170":51380,"_2648":51605},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3150":2131,"_27660":2041,"_19192":51607,"_5":13195,"_26170":51384,"_2648":51608},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3150":2132,"_27660":2041,"_19192":51610,"_5":13195,"_26170":51384,"_2648":51611},[],"Main fields:",{"_3150":2133,"_27660":2041,"_19192":51613,"_5":13195,"_26170":51384,"_2648":51614},[],"**Algorithm**: signing algorithm available for the key type.",{"_3150":2134,"_27660":2041,"_19192":51616,"_5":13195,"_26170":51384,"_2648":51617},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3150":2135,"_27660":2041,"_19192":51619,"_5":13195,"_26170":51384,"_2648":51620},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3150":2136,"_27660":2041,"_19192":51622,"_5":13195,"_26170":51384,"_2648":51623},[],"**Message**: content to sign.",{"_3150":2137,"_27660":2041,"_19192":51625,"_5":13195,"_26170":51384,"_2648":51626},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3150":2138,"_27660":2041,"_19192":51628,"_5":13195,"_26170":51388,"_2648":51629},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3150":2139,"_27660":2041,"_19192":51631,"_5":13195,"_26170":51388,"_2648":51611},[],{"_3150":2140,"_27660":2041,"_19192":51633,"_5":13195,"_26170":51388,"_2648":51634},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3150":2141,"_27660":2041,"_19192":51636,"_5":13195,"_26170":51388,"_2648":51637},[],"**Message Type**: `Raw` or `Digest`.",{"_3150":2142,"_27660":2041,"_19192":51639,"_5":13195,"_26170":51388,"_2648":51640},[],"**Payload Encoding**: encoding of the message.",{"_3150":2143,"_27660":2041,"_19192":51642,"_5":13195,"_26170":51388,"_2648":51643},[],"**Message**: original message or hash.",{"_3150":2144,"_27660":2041,"_19192":51645,"_5":13195,"_26170":51388,"_2648":51646},[],"**Signature**: signature to check.",{"_3150":2145,"_27660":2041,"_19192":51648,"_5":13195,"_26170":51388,"_2648":51649},[],"**Result**: indicator of the validation result.",{"_3150":2146,"_27660":2041,"_19192":51651,"_5":13195,"_26170":51392,"_2648":51652},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3150":2147,"_27660":2041,"_19192":51654,"_5":13195,"_26170":51392,"_2648":51655},[],"This flow is useful for:",{"_3150":2148,"_27660":2041,"_19192":51657,"_5":13195,"_26170":51392,"_2648":51658},[],"Requesting certificates from an external CA.",{"_3150":2149,"_27660":2041,"_19192":51660,"_5":13195,"_26170":51392,"_2648":51661},[],"Renewing an identity while keeping the same key.",{"_3150":2150,"_27660":2041,"_19192":51663,"_5":13195,"_26170":51392,"_2648":51664},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3150":2151,"_27660":2041,"_19192":51666,"_5":13195,"_26170":51392,"_2648":51667},[],"**Common Name (CN)**: main name of the identity.",{"_3150":2152,"_27660":2041,"_19192":51669,"_5":13195,"_26170":51392,"_2648":51670},[],"**Organization (O)**: organization or company.",{"_3150":2153,"_27660":2041,"_19192":51672,"_5":13195,"_26170":51392,"_2648":51673},[],"**Organizational Unit (OU)**: department or unit.",{"_3150":2154,"_27660":2041,"_19192":51675,"_5":13195,"_26170":51392,"_2648":51676},[],"**Country (C)**: two-letter country code.",{"_3150":2155,"_27660":2041,"_19192":51678,"_5":13195,"_26170":51392,"_2648":51679},[],"**State / Province (ST)**: state or province.",{"_3150":2156,"_27660":2041,"_19192":51681,"_5":13195,"_26170":51392,"_2648":51682},[],"**Locality (L)**: city or locality.",{"_3150":2157,"_27660":2041,"_19192":51684,"_5":13195,"_26170":51392,"_2648":51685},[],"**Email Address**: contact email.",{"_3150":2158,"_27660":2041,"_19192":51687,"_5":13195,"_26170":51392,"_2648":51688},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3150":2159,"_27660":2041,"_19192":51690,"_5":13195,"_26170":51392,"_2648":51691},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3150":2160,"_27660":2041,"_19192":51693,"_5":13195,"_26170":51396,"_2648":51694},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3150":2161,"_27660":2041,"_19192":51696,"_5":13195,"_26170":51396,"_2648":51697},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3150":2162,"_27660":2041,"_19192":51699,"_5":13195,"_26170":51400,"_2648":51700},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3150":2163,"_27660":2163,"_5":13521,"_2648":51702,"_27982":51703,"_19192":51704,"_26170":2163},"Online validation with OCSP",[44938,46318,50014,50631],[],{"_3150":2164,"_27660":2163,"_19192":51706,"_5":13195,"_26170":2163,"_2648":51707},[],"Query signed status and verify the responder’s response.",{"_3150":2165,"_27660":2163,"_5":27979,"_19192":51709,"_26170":51710,"_2648":51711},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3150":2166,"_27660":2163,"_5":27979,"_19192":51713,"_26170":51714,"_2648":51715},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3150":2167,"_27660":2163,"_5":27979,"_19192":51717,"_26170":51718,"_2648":51719},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3150":2168,"_27660":2163,"_5":27979,"_19192":51721,"_26170":51722,"_2648":51723},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3150":2169,"_27660":2163,"_5":27979,"_19192":51725,"_26170":51726,"_2648":51727},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3150":2170,"_27660":2163,"_5":27979,"_19192":51729,"_26170":51730,"_2648":51177},[],"/docs/platform/pki/ocsp#references",{"_3150":2171,"_27660":2163,"_19192":51732,"_5":13195,"_26170":2163,"_2648":51733},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3150":2172,"_27660":2163,"_19192":51735,"_5":13195,"_26170":51710,"_2648":51736},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3150":2173,"_27660":2163,"_19192":51738,"_5":13195,"_26170":51710,"_2648":51739},[],"Record status",{"_3150":2174,"_27660":2163,"_19192":51741,"_5":13195,"_26170":51710,"_2648":51742},[],"Signed response",{"_3150":2175,"_27660":2163,"_19192":51744,"_5":13195,"_26170":51710,"_2648":49192},[],{"_3150":2176,"_27660":2163,"_19192":51746,"_5":13195,"_26170":51710,"_2648":51747},[],"`Good`.",{"_3150":2177,"_27660":2163,"_19192":51749,"_5":13195,"_26170":51710,"_2648":49209},[],{"_3150":2178,"_27660":2163,"_19192":51751,"_5":13195,"_26170":51710,"_2648":51752},[],"`Revoked`, with revocation reason and timestamp.",{"_3150":2179,"_27660":2163,"_19192":51754,"_5":13195,"_26170":51710,"_2648":51755},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3150":2180,"_27660":2163,"_19192":51757,"_5":13195,"_26170":51710,"_2648":51758},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3150":2181,"_27660":2163,"_19192":51760,"_5":13195,"_26170":51710,"_2648":51761},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3150":2182,"_27660":2163,"_19192":51763,"_5":13195,"_26170":51710,"_2648":51764},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3150":2183,"_27660":2163,"_19192":51766,"_5":13195,"_26170":51710,"_2648":51767},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3150":2184,"_27660":2163,"_19192":51769,"_5":13195,"_26170":51714,"_2648":51770},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3150":2185,"_27660":2163,"_19192":51772,"_5":13195,"_26170":51714,"_2648":51773},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3150":2186,"_27660":2163,"_19192":51775,"_5":13195,"_26170":51718,"_2648":51776},[],"The service accepts:",{"_3150":2187,"_27660":2163,"_19192":51778,"_5":13195,"_26170":51718,"_2648":48045},[],{"_3150":2188,"_27660":2163,"_19192":51780,"_5":13195,"_26170":51718,"_2648":51781},[],"VA service path",{"_3150":2189,"_27660":2163,"_19192":51783,"_5":13195,"_26170":51718,"_2648":51784},[],"Format",{"_3150":2190,"_27660":2163,"_19192":51786,"_5":13195,"_26170":51718,"_2648":51787},[],"`POST`",{"_3150":2191,"_27660":2163,"_19192":51789,"_5":13195,"_26170":51718,"_2648":51790},[],"`/ocsp`",{"_3150":2192,"_27660":2163,"_19192":51792,"_5":13195,"_26170":51718,"_2648":51793},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3150":2193,"_27660":2163,"_19192":51795,"_5":13195,"_26170":51718,"_2648":51276},[],{"_3150":2194,"_27660":2163,"_19192":51797,"_5":13195,"_26170":51718,"_2648":51798},[],"`/ocsp/{ocsp_request}`",{"_3150":2195,"_27660":2163,"_19192":51800,"_5":13195,"_26170":51718,"_2648":51801},[],"DER request encoded using padded URL Base64.",{"_3150":2196,"_27660":2163,"_19192":51803,"_5":13195,"_26170":51718,"_2648":51804},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3150":2197,"_27660":2163,"_19192":51806,"_5":13195,"_26170":51722,"_2648":51807},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3150":2198,"_27660":2163,"_19192":51809,"_5":13195,"_26170":51722,"_2648":51810},[],"Generate the request:",{"_3150":2199,"_27660":2163,"_19192":51812,"_5":13195,"_26170":51722,"_2648":51813},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3150":2200,"_27660":2163,"_19192":51815,"_5":13195,"_26170":51722,"_2648":51816},[],"Replace the example URL with the inspected endpoint:",{"_3150":2201,"_27660":2163,"_19192":51818,"_5":13195,"_26170":51722,"_2648":51819},[],"Verify the returned DER:",{"_3150":2202,"_27660":2163,"_19192":51821,"_5":13195,"_26170":51722,"_2648":51822},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3150":2203,"_27660":2163,"_19192":51824,"_5":13195,"_26170":51726,"_2648":51825},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3150":2204,"_27660":2163,"_19192":51827,"_5":13195,"_26170":51726,"_2648":51828},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3150":2205,"_27660":2163,"_19192":51830,"_5":13195,"_26170":51730,"_2648":51831},[],"RFC 6960: OCSP.",{"_3150":2206,"_27660":2163,"_19192":51833,"_5":13195,"_26170":51730,"_2648":51834},[],"OpenSSL: openssl-ocsp.",{"_3150":2207,"_27660":2163,"_19192":51836,"_5":13195,"_26170":51730,"_2648":51837},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3150":2208,"_27660":2163,"_19192":51839,"_5":13195,"_26170":51730,"_2648":51314},[],{"_3150":2209,"_27660":2209,"_5":13521,"_2648":50014,"_27982":51841,"_19192":51842,"_26170":2209},[44938,46318,50014],[],{"_3150":2210,"_27660":2209,"_19192":51844,"_5":13195,"_26170":2209,"_2648":51845},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3150":2211,"_27660":2209,"_5":27979,"_19192":51847,"_26170":51848,"_2648":49324},[],"/docs/platform/pki/overview#start-here",{"_3150":2212,"_27660":2209,"_5":27979,"_19192":51850,"_26170":51851,"_2648":51852},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3150":2213,"_27660":2209,"_5":27979,"_19192":51854,"_26170":51855,"_2648":49858},[],"/docs/platform/pki/overview#core-capabilities",{"_3150":2214,"_27660":2209,"_5":27979,"_19192":51857,"_26170":51858,"_2648":49862},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3150":2215,"_27660":2209,"_5":27979,"_19192":51860,"_26170":51861,"_2648":49866},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3150":2216,"_27660":2209,"_5":27979,"_19192":51863,"_26170":51864,"_2648":49870},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3150":2217,"_27660":2209,"_5":27979,"_19192":51866,"_26170":51867,"_2648":49878},[],"/docs/platform/pki/overview#publish-validation-status",{"_3150":2218,"_27660":2209,"_5":27979,"_19192":51869,"_26170":51870,"_2648":51871},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3150":2219,"_27660":2209,"_5":27979,"_19192":51873,"_26170":51874,"_2648":50798},[],"/docs/platform/pki/overview#continue",{"_3150":2220,"_27660":2209,"_19192":51876,"_5":13195,"_26170":2209,"_2648":51877},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3150":2221,"_27660":2209,"_19192":51879,"_5":13195,"_26170":51848,"_2648":51880},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3150":2222,"_27660":2209,"_19192":51882,"_5":13195,"_26170":51848,"_2648":51883},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3150":2223,"_27660":2209,"_19192":51885,"_5":13195,"_26170":51851,"_2648":51886},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3150":2224,"_27660":2209,"_19192":51888,"_5":13195,"_26170":51851,"_2648":51889},[],"An available cryptographic engine to keep the authority's key.",{"_3150":2225,"_27660":2209,"_19192":51891,"_5":13195,"_26170":51851,"_2648":51892},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3150":2226,"_27660":2209,"_19192":51894,"_5":13195,"_26170":51851,"_2648":51895},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3150":2227,"_27660":2209,"_19192":51897,"_5":13195,"_26170":51851,"_2648":51898},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3150":2228,"_27660":2209,"_19192":51900,"_5":13195,"_26170":51858,"_2648":51901},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3150":2229,"_27660":2209,"_19192":51903,"_5":13195,"_26170":51861,"_2648":51904},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3150":2230,"_27660":2209,"_19192":51906,"_5":13195,"_26170":51864,"_2648":51907},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3150":2231,"_27660":2209,"_19192":51909,"_5":13195,"_26170":51867,"_2648":51910},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3150":2232,"_27660":2209,"_19192":51912,"_5":13195,"_26170":51870,"_2648":51913},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3150":2233,"_27660":2209,"_19192":51915,"_5":13195,"_26170":51870,"_2648":51916},[],"its subject and extensions identify the expected client;",{"_3150":2234,"_27660":2209,"_19192":51918,"_5":13195,"_26170":51870,"_2648":51919},[],"its public key matches the client's private key;",{"_3150":2235,"_27660":2209,"_19192":51921,"_5":13195,"_26170":51870,"_2648":51922},[],"its chain reaches a root trusted by the consumer;",{"_3150":2236,"_27660":2209,"_19192":51924,"_5":13195,"_26170":51870,"_2648":51925},[],"its dates and usages allow the operation;",{"_3150":2237,"_27660":2209,"_19192":51927,"_5":13195,"_26170":51870,"_2648":51928},[],"the consumer applies revocation checks and authorization.",{"_3150":2238,"_27660":2209,"_19192":51930,"_5":13195,"_26170":51870,"_2648":51931},[],"The issuance path includes the first independent checks.",{"_3150":2239,"_27660":2209,"_19192":51933,"_5":13195,"_26170":51874,"_2648":51934},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3150":2240,"_27660":2209,"_19192":51936,"_5":13195,"_26170":51874,"_2648":51937},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3150":2241,"_27660":2209,"_19192":51939,"_5":13195,"_26170":51874,"_2648":51940},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3150":2242,"_27660":2242,"_5":13521,"_2648":51942,"_27982":51943,"_19192":51944,"_26170":2242},"Create your first CA",[44938,46318,50014,49449],[],{"_3150":2243,"_27660":2242,"_19192":51946,"_5":13195,"_26170":2242,"_2648":51947},[],"Create an evaluation root and check its certificate before issuing.",{"_3150":2244,"_27660":2242,"_5":27979,"_19192":51949,"_26170":51950,"_2648":44948},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3150":2245,"_27660":2242,"_5":27979,"_19192":51952,"_26170":51953,"_2648":51954},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_3150":2246,"_27660":2242,"_5":27979,"_19192":51956,"_26170":51957,"_2648":51958},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_3150":2247,"_27660":2242,"_5":27979,"_19192":51960,"_26170":51961,"_2648":51962},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_3150":2248,"_27660":2242,"_5":27979,"_19192":51964,"_26170":51965,"_2648":51966},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_3150":2249,"_27660":2242,"_5":27979,"_19192":51968,"_26170":51969,"_2648":51970},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_3150":2250,"_27660":2242,"_5":27979,"_19192":51972,"_26170":51973,"_2648":51974},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3150":2251,"_27660":2242,"_5":27979,"_19192":51976,"_26170":51977,"_2648":49707},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3150":2252,"_27660":2242,"_5":27979,"_19192":51979,"_26170":51980,"_2648":44972},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3150":2253,"_27660":2242,"_19192":51982,"_5":13195,"_26170":2242,"_2648":51983},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3150":2254,"_27660":2242,"_19192":51985,"_5":13195,"_26170":51950,"_2648":51986},[],"Console access and permission to create keys and authorities.",{"_3150":2255,"_27660":2242,"_19192":51988,"_5":13195,"_26170":51950,"_2648":51989},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3150":2256,"_27660":2242,"_19192":51991,"_5":13195,"_26170":51950,"_2648":51992},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3150":2257,"_27660":2242,"_19192":51994,"_5":13195,"_26170":51950,"_2648":51995},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3150":2258,"_27660":2242,"_19192":51997,"_5":13195,"_26170":51953,"_2648":51998},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3150":2259,"_27660":2242,"_19192":52000,"_5":13195,"_26170":51953,"_2648":52001},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3150":2260,"_27660":2242,"_19192":52003,"_5":13195,"_26170":51957,"_2648":52004},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3150":2261,"_27660":2242,"_19192":52006,"_5":13195,"_26170":51957,"_2648":52007},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3150":2262,"_27660":2242,"_19192":52009,"_5":13195,"_26170":51961,"_2648":52010},[],"Select **Root CA** and complete:",{"_3150":2263,"_27660":2242,"_19192":52012,"_5":13195,"_26170":51961,"_2648":52013},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3150":2264,"_27660":2242,"_19192":52015,"_5":13195,"_26170":51961,"_2648":52016},[],"**Subject**: organization and country details for your evaluation.",{"_3150":2265,"_27660":2242,"_19192":52018,"_5":13195,"_26170":51961,"_2648":52019},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3150":2266,"_27660":2242,"_19192":52021,"_5":13195,"_26170":51961,"_2648":52022},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3150":2267,"_27660":2242,"_19192":52024,"_5":13195,"_26170":51961,"_2648":52025},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3150":2268,"_27660":2242,"_19192":52027,"_5":13195,"_26170":51965,"_2648":52028},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3150":2269,"_27660":2242,"_19192":52030,"_5":13195,"_26170":51969,"_2648":52031},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3150":2270,"_27660":2242,"_19192":52033,"_5":13195,"_26170":51969,"_2648":52034},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3150":2271,"_27660":2242,"_19192":52036,"_5":13195,"_26170":51973,"_2648":52037},[],"Run from the directory where you saved `ca.pem`:",{"_3150":2272,"_27660":2242,"_19192":52039,"_5":13195,"_26170":51973,"_2648":52040},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3150":2273,"_27660":2242,"_19192":52042,"_5":13195,"_26170":51973,"_2648":52043},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3150":2274,"_27660":2242,"_19192":52045,"_5":13195,"_26170":51977,"_2648":52046},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3150":2275,"_27660":2242,"_19192":52048,"_5":13195,"_26170":51977,"_2648":52049},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3150":2276,"_27660":2242,"_19192":52051,"_5":13195,"_26170":51977,"_2648":52052},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3150":2277,"_27660":2242,"_19192":52054,"_5":13195,"_26170":51977,"_2648":52055},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3150":2278,"_27660":2242,"_19192":52057,"_5":13195,"_26170":51980,"_2648":52058},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3150":2279,"_27660":2279,"_5":13521,"_2648":52060,"_27982":52061,"_19192":52062,"_26170":2279},"Issue and verify a certificate",[44938,46318,50014,49449],[],{"_3150":2280,"_27660":2279,"_19192":52064,"_5":13195,"_26170":2279,"_2648":52065},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3150":2281,"_27660":2279,"_5":27979,"_19192":52067,"_26170":52068,"_2648":44948},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3150":2282,"_27660":2279,"_5":27979,"_19192":52070,"_26170":52071,"_2648":52072},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3150":2283,"_27660":2279,"_5":27979,"_19192":52074,"_26170":52075,"_2648":52076},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3150":2284,"_27660":2279,"_5":27979,"_19192":52078,"_26170":52079,"_2648":52080},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3150":2285,"_27660":2279,"_5":27979,"_19192":52082,"_26170":52083,"_2648":52084},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3150":2286,"_27660":2279,"_5":27979,"_19192":52086,"_26170":52087,"_2648":52088},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3150":2287,"_27660":2279,"_5":27979,"_19192":52090,"_26170":52091,"_2648":51970},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_3150":2288,"_27660":2279,"_5":27979,"_19192":52093,"_26170":52094,"_2648":52095},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3150":2289,"_27660":2279,"_5":27979,"_19192":52097,"_26170":52098,"_2648":52099},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3150":2290,"_27660":2279,"_5":27979,"_19192":52101,"_26170":52102,"_2648":52103},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3150":2291,"_27660":2279,"_5":27979,"_19192":52105,"_26170":52106,"_2648":49707},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3150":2292,"_27660":2279,"_5":27979,"_19192":52108,"_26170":52109,"_2648":44972},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3150":2293,"_27660":2279,"_19192":52111,"_5":13195,"_26170":2279,"_2648":52112},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3150":2294,"_27660":2279,"_19192":52114,"_5":13195,"_26170":52068,"_2648":52115},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3150":2295,"_27660":2279,"_19192":52117,"_5":13195,"_26170":52068,"_2648":52118},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3150":2296,"_27660":2279,"_19192":52120,"_5":13195,"_26170":52068,"_2648":52121},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3150":2297,"_27660":2279,"_19192":52123,"_5":13195,"_26170":52068,"_2648":52124},[],"A client identifier: here we use `device-001`.",{"_3150":2298,"_27660":2279,"_19192":52126,"_5":13195,"_26170":52068,"_2648":52127},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3150":2299,"_27660":2279,"_19192":52129,"_5":13195,"_26170":52071,"_2648":52130},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3150":2300,"_27660":2279,"_19192":52132,"_5":13195,"_26170":52075,"_2648":52133},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3150":2301,"_27660":2279,"_19192":52135,"_5":13195,"_26170":52075,"_2648":52136},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3150":2302,"_27660":2279,"_19192":52138,"_5":13195,"_26170":52079,"_2648":52139},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3150":2303,"_27660":2279,"_19192":52141,"_5":13195,"_26170":52079,"_2648":52142},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3150":2304,"_27660":2279,"_19192":52144,"_5":13195,"_26170":52083,"_2648":52145},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3150":2305,"_27660":2279,"_19192":52147,"_5":13195,"_26170":52083,"_2648":52148},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3150":2306,"_27660":2279,"_19192":52150,"_5":13195,"_26170":52087,"_2648":52151},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3150":2307,"_27660":2279,"_19192":52153,"_5":13195,"_26170":52091,"_2648":52154},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3150":2308,"_27660":2279,"_19192":52156,"_5":13195,"_26170":52094,"_2648":52157},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3150":2309,"_27660":2279,"_19192":52159,"_5":13195,"_26170":52098,"_2648":52160},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3150":2310,"_27660":2279,"_19192":52162,"_5":13195,"_26170":52098,"_2648":52163},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3150":2311,"_27660":2279,"_19192":52165,"_5":13195,"_26170":52098,"_2648":52166},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3150":2312,"_27660":2279,"_19192":52168,"_5":13195,"_26170":52102,"_2648":52169},[],"In Bash, compare the two public-key digests:",{"_3150":2313,"_27660":2279,"_19192":52171,"_5":13195,"_26170":52102,"_2648":52172},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3150":2314,"_27660":2279,"_19192":52174,"_5":13195,"_26170":52102,"_2648":52175},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3150":2315,"_27660":2279,"_19192":52177,"_5":13195,"_26170":52106,"_2648":49791},[],{"_3150":2316,"_27660":2279,"_19192":52179,"_5":13195,"_26170":52106,"_2648":52180},[],"What to review",{"_3150":2317,"_27660":2279,"_19192":52182,"_5":13195,"_26170":52106,"_2648":52183},[],"The CA rejects issuance",{"_3150":2318,"_27660":2279,"_19192":52185,"_5":13195,"_26170":52106,"_2648":52186},[],"Permissions, CA state and key, algorithm and profile.",{"_3150":2319,"_27660":2279,"_19192":52188,"_5":13195,"_26170":52106,"_2648":52189},[],"Different subject or usages",{"_3150":2320,"_27660":2279,"_19192":52191,"_5":13195,"_26170":52106,"_2648":52192},[],"Applied profile and requested values.",{"_3150":2321,"_27660":2279,"_19192":52194,"_5":13195,"_26170":52106,"_2648":52195},[],"Issuer cannot be found",{"_3150":2322,"_27660":2279,"_19192":52197,"_5":13195,"_26170":52106,"_2648":52198},[],"Downloaded CA and required intermediate chain.",{"_3150":2323,"_27660":2279,"_19192":52200,"_5":13195,"_26170":52106,"_2648":52201},[],"Validity fails",{"_3150":2324,"_27660":2279,"_19192":52203,"_5":13195,"_26170":52106,"_2648":52204},[],"Certificate and CA dates, and the computer's clock.",{"_3150":2325,"_27660":2279,"_19192":52206,"_5":13195,"_26170":52106,"_2648":52207},[],"Public-key digests differ",{"_3150":2326,"_27660":2279,"_19192":52209,"_5":13195,"_26170":52106,"_2648":52210},[],"Certificate and key files from the same issuance.",{"_3150":2327,"_27660":2279,"_19192":52212,"_5":13195,"_26170":52106,"_2648":52213},[],"See PKI diagnostics to narrow an issuance failure.",{"_3150":2328,"_27660":2279,"_19192":52215,"_5":13195,"_26170":52109,"_2648":52216},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3150":2329,"_27660":2279,"_19192":52218,"_5":13195,"_26170":52109,"_2648":52219},[],"Manage certificates for inspection, status and revocation.",{"_3150":2330,"_27660":2279,"_19192":52221,"_5":13195,"_26170":52109,"_2648":52222},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3150":2331,"_27660":2279,"_19192":52224,"_5":13195,"_26170":52109,"_2648":52225},[],"Prepare EST for the device to request its next identities.",{"_3150":2332,"_27660":2279,"_19192":52227,"_5":13195,"_26170":52109,"_2648":52228},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3150":2333,"_27660":2333,"_5":13521,"_2648":52230,"_27982":52231,"_19192":52232,"_26170":2333},"PKI getting started",[44938,46318,50014,49449],[],{"_3150":2334,"_27660":2333,"_19192":52234,"_5":13195,"_26170":2333,"_2648":52235},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3150":2335,"_27660":2333,"_5":27979,"_19192":52237,"_26170":52238,"_2648":44948},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3150":2336,"_27660":2333,"_5":27979,"_19192":52240,"_26170":52241,"_2648":52242},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3150":2337,"_27660":2333,"_5":27979,"_19192":52244,"_26170":52245,"_2648":49641},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3150":2338,"_27660":2333,"_5":27979,"_19192":52247,"_26170":52248,"_2648":52249},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3150":2339,"_27660":2333,"_19192":52251,"_5":13195,"_26170":2333,"_2648":52252},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3150":2340,"_27660":2333,"_19192":52254,"_5":13195,"_26170":52238,"_2648":52255},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3150":2341,"_27660":2333,"_19192":52257,"_5":13195,"_26170":52238,"_2648":52258},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3150":2342,"_27660":2333,"_19192":52260,"_5":13195,"_26170":52238,"_2648":52261},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3150":2343,"_27660":2333,"_19192":52263,"_5":13195,"_26170":52238,"_2648":52264},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3150":2344,"_27660":2333,"_19192":52266,"_5":13195,"_26170":52238,"_2648":52267},[],"A working directory with restricted access for the downloaded key.",{"_3150":2345,"_27660":2333,"_19192":52269,"_5":13195,"_26170":52241,"_2648":52270},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3150":2346,"_27660":2333,"_19192":52272,"_5":13195,"_26170":52241,"_2648":52273},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3150":2347,"_27660":2333,"_19192":52275,"_5":13195,"_26170":52241,"_2648":52276},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3150":2348,"_27660":2333,"_19192":52278,"_5":13195,"_26170":52241,"_2648":52279},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3150":2349,"_27660":2333,"_19192":52281,"_5":13195,"_26170":52245,"_2648":52282},[],"File or resource",{"_3150":2350,"_27660":2333,"_19192":52284,"_5":13195,"_26170":52245,"_2648":49638},[],{"_3150":2351,"_27660":2333,"_19192":52286,"_5":13195,"_26170":52245,"_2648":52287},[],"Active root CA and `ca.pem`",{"_3150":2352,"_27660":2333,"_19192":52289,"_5":13195,"_26170":52245,"_2648":52290},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3150":2353,"_27660":2333,"_19192":52292,"_5":13195,"_26170":52245,"_2648":52293},[],"End-entity certificate and `device.crt`",{"_3150":2354,"_27660":2333,"_19192":52295,"_5":13195,"_26170":52245,"_2648":52296},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3150":2355,"_27660":2333,"_19192":52298,"_5":13195,"_26170":52245,"_2648":52299},[],"Private key `device.key`",{"_3150":2356,"_27660":2333,"_19192":52301,"_5":13195,"_26170":52245,"_2648":52302},[],"Its public key matches the one included in `device.crt`.",{"_3150":2357,"_27660":2333,"_19192":52304,"_5":13195,"_26170":52245,"_2648":52305},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3150":2358,"_27660":2333,"_19192":52307,"_5":13195,"_26170":52248,"_2648":52308},[],"To operate certificates, continue with Certificates and Validation.",{"_3150":2359,"_27660":2333,"_19192":52310,"_5":13195,"_26170":52248,"_2648":52311},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3150":2360,"_27660":2333,"_19192":52313,"_5":13195,"_26170":52248,"_2648":52314},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3150":2361,"_27660":2361,"_5":13521,"_2648":52316,"_27982":52317,"_19192":52318,"_26170":2361},"PKI troubleshooting",[44938,46318,50014,48835],[],{"_3150":2362,"_27660":2361,"_19192":52320,"_5":13195,"_26170":2361,"_2648":52321},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3150":2363,"_27660":2361,"_5":27979,"_19192":52323,"_26170":52324,"_2648":52325},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3150":2364,"_27660":2361,"_5":27979,"_19192":52327,"_26170":52328,"_2648":52329},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3150":2365,"_27660":2361,"_5":27979,"_19192":52331,"_26170":52332,"_2648":52333},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3150":2366,"_27660":2361,"_19192":52335,"_5":13195,"_26170":2361,"_2648":52336},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3150":2367,"_27660":2361,"_19192":52338,"_5":13195,"_26170":2361,"_2648":52339},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3150":2368,"_27660":2361,"_19192":52341,"_5":13195,"_26170":52324,"_2648":49638},[],{"_3150":2369,"_27660":2361,"_19192":52343,"_5":13195,"_26170":52324,"_2648":52344},[],"What to inspect",{"_3150":2370,"_27660":2361,"_19192":52346,"_5":13195,"_26170":52324,"_2648":44972},[],{"_3150":2371,"_27660":2361,"_19192":52348,"_5":13195,"_26170":52324,"_2648":52349},[],"CA",{"_3150":2372,"_27660":2361,"_19192":52351,"_5":13195,"_26170":52324,"_2648":52352},[],"Exists, is active and has usable dates.",{"_3150":2373,"_27660":2361,"_19192":52354,"_5":13195,"_26170":52324,"_2648":52355},[],"Authorities.",{"_3150":2374,"_27660":2361,"_19192":52357,"_5":13195,"_26170":52324,"_2648":52358},[],"Key",{"_3150":2375,"_27660":2361,"_19192":52360,"_5":13195,"_26170":52324,"_2648":52361},[],"The record has a usable private key and the engine can sign.",{"_3150":2376,"_27660":2361,"_19192":52363,"_5":13195,"_26170":52324,"_2648":52364},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3150":2377,"_27660":2361,"_19192":52366,"_5":13195,"_26170":52324,"_2648":52367},[],"CSR",{"_3150":2378,"_27660":2361,"_19192":52369,"_5":13195,"_26170":52324,"_2648":52370},[],"Correct PEM and verifiable signature.",{"_3150":2379,"_27660":2361,"_19192":52372,"_5":13195,"_26170":52324,"_2648":52373},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3150":2380,"_27660":2361,"_19192":52375,"_5":13195,"_26170":52324,"_2648":52376},[],"Profile",{"_3150":2381,"_27660":2361,"_19192":52378,"_5":13195,"_26170":52324,"_2648":52379},[],"Selected source, existing ID, allowed algorithm and size.",{"_3150":2382,"_27660":2361,"_19192":52381,"_5":13195,"_26170":52324,"_2648":52382},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3150":2383,"_27660":2361,"_19192":52384,"_5":13195,"_26170":52324,"_2648":49791},[],{"_3150":2384,"_27660":2361,"_19192":52386,"_5":13195,"_26170":52324,"_2648":52387},[],"Appropriate subject, SAN, usages and dates.",{"_3150":2385,"_27660":2361,"_19192":52389,"_5":13195,"_26170":52324,"_2648":52390},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3150":2386,"_27660":2361,"_19192":52392,"_5":13195,"_26170":52324,"_2648":52393},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3150":2387,"_27660":2361,"_19192":52395,"_5":13195,"_26170":52324,"_2648":52396},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3150":2388,"_27660":2361,"_19192":52398,"_5":13195,"_26170":52328,"_2648":52399},[],"Check each boundary independently:",{"_3150":2389,"_27660":2361,"_19192":52401,"_5":13195,"_26170":52328,"_2648":52402},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3150":2390,"_27660":2361,"_19192":52404,"_5":13195,"_26170":52328,"_2648":52405},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3150":2391,"_27660":2361,"_19192":52407,"_5":13195,"_26170":52328,"_2648":52408},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3150":2392,"_27660":2361,"_19192":52410,"_5":13195,"_26170":52328,"_2648":52411},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3150":2393,"_27660":2361,"_19192":52413,"_5":13195,"_26170":52328,"_2648":52414},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3150":2394,"_27660":2361,"_19192":52416,"_5":13195,"_26170":52328,"_2648":52417},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3150":2395,"_27660":2361,"_19192":52419,"_5":13195,"_26170":52332,"_2648":52420},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3150":2396,"_27660":2361,"_19192":52422,"_5":13195,"_26170":52332,"_2648":52423},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3150":2397,"_27660":2397,"_5":13521,"_2648":52425,"_27982":52426,"_19192":52428,"_26170":2397},"3.8.0 to 4.0.0",[44938,52427],"Upgrades",[],{"_3150":2398,"_27660":2397,"_19192":52430,"_5":13195,"_26170":2397,"_2648":52431},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3150":2399,"_27660":2397,"_5":27979,"_19192":52433,"_26170":52434,"_2648":52435},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3150":2400,"_27660":2397,"_5":27979,"_19192":52437,"_26170":52438,"_2648":52439},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3150":2401,"_27660":2397,"_5":27979,"_19192":52441,"_26170":52442,"_2648":52443},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3150":2402,"_27660":2397,"_5":27979,"_19192":52445,"_26170":52446,"_2648":52447},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3150":2403,"_27660":2397,"_5":27979,"_19192":52449,"_26170":52450,"_2648":52451},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3150":2404,"_27660":2397,"_5":27979,"_19192":52453,"_26170":52454,"_2648":52455},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3150":2405,"_27660":2397,"_5":27979,"_19192":52457,"_26170":52458,"_2648":52459},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3150":2406,"_27660":2397,"_5":27979,"_19192":52461,"_26170":52462,"_2648":52463},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3150":2407,"_27660":2397,"_5":27979,"_19192":52465,"_26170":52466,"_2648":52467},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3150":2408,"_27660":2397,"_5":27979,"_19192":52469,"_26170":52470,"_2648":52471},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3150":2409,"_27660":2397,"_5":27979,"_19192":52473,"_26170":52474,"_2648":52475},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3150":2410,"_27660":2397,"_5":27979,"_19192":52477,"_26170":52478,"_2648":52479},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3150":2411,"_27660":2397,"_5":27979,"_19192":52481,"_26170":52482,"_2648":52483},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3150":2412,"_27660":2397,"_5":27979,"_19192":52485,"_26170":52486,"_2648":52487},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3150":2413,"_27660":2397,"_5":27979,"_19192":52489,"_26170":52490,"_2648":52491},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3150":2414,"_27660":2397,"_5":27979,"_19192":52493,"_26170":52494,"_2648":52495},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3150":2415,"_27660":2397,"_5":27979,"_19192":52497,"_26170":52498,"_2648":52499},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3150":2416,"_27660":2397,"_5":27979,"_19192":52501,"_26170":52502,"_2648":52503},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3150":2417,"_27660":2397,"_5":27979,"_19192":52505,"_26170":52506,"_2648":52507},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3150":2418,"_27660":2397,"_5":27979,"_19192":52509,"_26170":52510,"_2648":52511},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3150":2419,"_27660":2397,"_5":27979,"_19192":52513,"_26170":52514,"_2648":52515},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3150":2420,"_27660":2397,"_5":27979,"_19192":52517,"_26170":52518,"_2648":52519},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3150":2421,"_27660":2397,"_5":27979,"_19192":52521,"_26170":52522,"_2648":52523},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3150":2422,"_27660":2397,"_5":27979,"_19192":52525,"_26170":52526,"_2648":52527},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3150":2423,"_27660":2397,"_5":27979,"_19192":52529,"_26170":52530,"_2648":52531},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3150":2424,"_27660":2397,"_5":27979,"_19192":52533,"_26170":52534,"_2648":52535},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3150":2425,"_27660":2397,"_5":27979,"_19192":52537,"_26170":52538,"_2648":52539},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3150":2426,"_27660":2397,"_5":27979,"_19192":52541,"_26170":52542,"_2648":52543},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3150":2427,"_27660":2397,"_5":27979,"_19192":52545,"_26170":52546,"_2648":52547},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3150":2428,"_27660":2397,"_5":27979,"_19192":52549,"_26170":52550,"_2648":52551},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3150":2429,"_27660":2397,"_5":27979,"_19192":52553,"_26170":52554,"_2648":52555},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3150":2430,"_27660":2397,"_5":27979,"_19192":52557,"_26170":52558,"_2648":52559},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3150":2431,"_27660":2397,"_5":27979,"_19192":52561,"_26170":52562,"_2648":52563},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3150":2432,"_27660":2397,"_5":27979,"_19192":52565,"_26170":52566,"_2648":48835},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3150":2433,"_27660":2397,"_5":27979,"_19192":52568,"_26170":52569,"_2648":52570},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3150":2434,"_27660":2397,"_5":27979,"_19192":52572,"_26170":52573,"_2648":52574},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3150":2435,"_27660":2397,"_19192":52576,"_5":13195,"_26170":2397,"_2648":52577},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3150":2436,"_27660":2397,"_19192":52579,"_5":13195,"_26170":2397,"_2648":52580},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3150":2437,"_27660":2397,"_19192":52582,"_5":13195,"_26170":2397,"_2648":52583},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3150":2438,"_27660":2397,"_19192":52585,"_5":13195,"_26170":2397,"_2648":52586},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3150":2439,"_27660":2397,"_19192":52588,"_5":13195,"_26170":2397,"_2648":52589},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3150":2440,"_27660":2397,"_19192":52591,"_5":13195,"_26170":2397,"_2648":52592},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3150":2441,"_27660":2397,"_19192":52594,"_5":13195,"_26170":2397,"_2648":52595},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3150":2442,"_27660":2397,"_19192":52597,"_5":13195,"_26170":52438,"_2648":52598},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3150":2443,"_27660":2397,"_19192":52600,"_5":13195,"_26170":52438,"_2648":52601},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3150":2444,"_27660":2397,"_19192":52603,"_5":13195,"_26170":52442,"_2648":52604},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3150":2445,"_27660":2397,"_19192":52606,"_5":13195,"_26170":52442,"_2648":52607},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3150":2446,"_27660":2397,"_19192":52609,"_5":13195,"_26170":52446,"_2648":52610},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3150":2447,"_27660":2397,"_19192":52612,"_5":13195,"_26170":52450,"_2648":52613},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3150":2448,"_27660":2397,"_19192":52615,"_5":13195,"_26170":52450,"_2648":52616},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3150":2449,"_27660":2397,"_19192":52618,"_5":13195,"_26170":52450,"_2648":52619},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3150":2450,"_27660":2397,"_19192":52621,"_5":13195,"_26170":52450,"_2648":52622},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3150":2451,"_27660":2397,"_19192":52624,"_5":13195,"_26170":52450,"_2648":52625},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3150":2452,"_27660":2397,"_19192":52627,"_5":13195,"_26170":52454,"_2648":52628},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3150":2453,"_27660":2397,"_19192":52630,"_5":13195,"_26170":52454,"_2648":52631},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3150":2454,"_27660":2397,"_19192":52633,"_5":13195,"_26170":52454,"_2648":52634},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3150":2455,"_27660":2397,"_19192":52636,"_5":13195,"_26170":52454,"_2648":52637},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3150":2456,"_27660":2397,"_19192":52639,"_5":13195,"_26170":52454,"_2648":52640},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3150":2457,"_27660":2397,"_19192":52642,"_5":13195,"_26170":52458,"_2648":52643},[],"Change",{"_3150":2458,"_27660":2397,"_19192":52645,"_5":13195,"_26170":52458,"_2648":52646},[],"Who is affected",{"_3150":2459,"_27660":2397,"_19192":52648,"_5":13195,"_26170":52458,"_2648":52649},[],"Severity",{"_3150":2460,"_27660":2397,"_19192":52651,"_5":13195,"_26170":52458,"_2648":52652},[],"Action",{"_3150":2461,"_27660":2397,"_19192":52654,"_5":13195,"_26170":52458,"_2648":52467},[],{"_3150":2462,"_27660":2397,"_19192":52656,"_5":13195,"_26170":52458,"_2648":52657},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3150":2463,"_27660":2397,"_19192":52659,"_5":13195,"_26170":52458,"_2648":52660},[],"High: KMS and VA start on empty volumes",{"_3150":2464,"_27660":2397,"_19192":52662,"_5":13195,"_26170":52458,"_2648":52663},[],"Copy the data into the new volumes",{"_3150":2465,"_27660":2397,"_19192":52665,"_5":13195,"_26170":52458,"_2648":52471},[],{"_3150":2466,"_27660":2397,"_19192":52667,"_5":13195,"_26170":52458,"_2648":52668},[],"Every Helm release",{"_3150":2467,"_27660":2397,"_19192":52670,"_5":13195,"_26170":52458,"_2648":52671},[],"High: `helm upgrade` fails",{"_3150":2468,"_27660":2397,"_19192":52673,"_5":13195,"_26170":52458,"_2648":52674},[],"Remove or rename legacy keys",{"_3150":2469,"_27660":2397,"_19192":52676,"_5":13195,"_26170":52458,"_2648":52475},[],{"_3150":2470,"_27660":2397,"_19192":52678,"_5":13195,"_26170":52458,"_2648":52679},[],"Every deployment",{"_3150":2471,"_27660":2397,"_19192":52681,"_5":13195,"_26170":52458,"_2648":52682},[],"High: without a bootstrap principal there is no administrator",{"_3150":2472,"_27660":2397,"_19192":52684,"_5":13195,"_26170":52458,"_2648":52685},[],"Configure `services.authz`",{"_3150":2473,"_27660":2397,"_19192":52687,"_5":13195,"_26170":52458,"_2648":52479},[],{"_3150":2474,"_27660":2397,"_19192":52689,"_5":13195,"_26170":52458,"_2648":52668},[],{"_3150":2475,"_27660":2397,"_19192":52691,"_5":13195,"_26170":52458,"_2648":52692},[],"High: `helm upgrade` fails on the old keys",{"_3150":2476,"_27660":2397,"_19192":52694,"_5":13195,"_26170":52458,"_2648":52695},[],"Move JWKS and roles into `services.authz`",{"_3150":2477,"_27660":2397,"_19192":52697,"_5":13195,"_26170":52458,"_2648":52499},[],{"_3150":2478,"_27660":2397,"_19192":52699,"_5":13195,"_26170":52458,"_2648":52700},[],"3.8.0 deployments with per-service databases",{"_3150":2479,"_27660":2397,"_19192":52702,"_5":13195,"_26170":52458,"_2648":52703},[],"High: services find no data, or a migration aborts",{"_3150":2480,"_27660":2397,"_19192":52705,"_5":13195,"_26170":52458,"_2648":52706},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3150":2481,"_27660":2397,"_19192":52708,"_5":13195,"_26170":52458,"_2648":52503},[],{"_3150":2482,"_27660":2397,"_19192":52710,"_5":13195,"_26170":52458,"_2648":52711},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3150":2483,"_27660":2397,"_19192":52713,"_5":13195,"_26170":52458,"_2648":52714},[],"High: the backend no longer starts with them",{"_3150":2484,"_27660":2397,"_19192":52716,"_5":13195,"_26170":52458,"_2648":52717},[],"Move to PostgreSQL before upgrading",{"_3150":2485,"_27660":2397,"_19192":52719,"_5":13195,"_26170":52458,"_2648":52720},[],"Webhooks with file references",{"_3150":2486,"_27660":2397,"_19192":52722,"_5":13195,"_26170":52458,"_2648":52723},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3150":2487,"_27660":2397,"_19192":52725,"_5":13195,"_26170":52458,"_2648":52726},[],"High: enrollments calling the webhook fail",{"_3150":2488,"_27660":2397,"_19192":52728,"_5":13195,"_26170":52458,"_2648":52729},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3150":2489,"_27660":2397,"_19192":52731,"_5":13195,"_26170":52458,"_2648":52483},[],{"_3150":2490,"_27660":2397,"_19192":52733,"_5":13195,"_26170":52458,"_2648":52734},[],"Releases with per-service identity overrides or mounted key material",{"_3150":2491,"_27660":2397,"_19192":52736,"_5":13195,"_26170":52458,"_2648":52737},[],"Medium: services cannot read their files",{"_3150":2492,"_27660":2397,"_19192":52739,"_5":13195,"_26170":52458,"_2648":52740},[],"Remove the overrides and fix volume ownership",{"_3150":2493,"_27660":2397,"_19192":52742,"_5":13195,"_26170":52458,"_2648":52487},[],{"_3150":2494,"_27660":2397,"_19192":52744,"_5":13195,"_26170":52458,"_2648":52745},[],"Releases that set `amqp.tls`",{"_3150":2495,"_27660":2397,"_19192":52747,"_5":13195,"_26170":52458,"_2648":52748},[],"Medium: clients connect to the wrong port",{"_3150":2496,"_27660":2397,"_19192":52750,"_5":13195,"_26170":52458,"_2648":52751},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3150":2497,"_27660":2397,"_19192":52753,"_5":13195,"_26170":52458,"_2648":52507},[],{"_3150":2498,"_27660":2397,"_19192":52755,"_5":13195,"_26170":52458,"_2648":52756},[],"Installations whose CA keys predate the KMS",{"_3150":2499,"_27660":2397,"_19192":52758,"_5":13195,"_26170":52458,"_2648":52759},[],"Medium: CA keys stay unmanaged",{"_3150":2500,"_27660":2397,"_19192":52761,"_5":13195,"_26170":52458,"_2648":52762},[],"Run the CA-to-KMS migration",{"_3150":2501,"_27660":2397,"_19192":52764,"_5":13195,"_26170":52458,"_2648":52765},[],"Receiver certificate verification",{"_3150":2502,"_27660":2397,"_19192":52767,"_5":13195,"_26170":52458,"_2648":52768},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3150":2503,"_27660":2397,"_19192":52770,"_5":13195,"_26170":52458,"_2648":52771},[],"Medium: credentials go to an unverified receiver",{"_3150":2504,"_27660":2397,"_19192":52773,"_5":13195,"_26170":52458,"_2648":52774},[],"Set `insecure_skip_verify` to `false`",{"_3150":2505,"_27660":2397,"_19192":52776,"_5":13195,"_26170":52458,"_2648":52519},[],{"_3150":2506,"_27660":2397,"_19192":52778,"_5":13195,"_26170":52458,"_2648":52779},[],"Scripts and consoles that edit DMSs through the API",{"_3150":2507,"_27660":2397,"_19192":52781,"_5":13195,"_26170":52458,"_2648":52782},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3150":2508,"_27660":2397,"_19192":52784,"_5":13195,"_26170":52458,"_2648":52785},[],"Read the DMS before editing and use the new field",{"_3150":2509,"_27660":2397,"_19192":52787,"_5":13195,"_26170":52458,"_2648":52535},[],{"_3150":2510,"_27660":2397,"_19192":52789,"_5":13195,"_26170":52458,"_2648":52790},[],"Consumers that read the device `events` field",{"_3150":2511,"_27660":2397,"_19192":52792,"_5":13195,"_26170":52458,"_2648":52793},[],"Medium: the field disappears",{"_3150":2512,"_27660":2397,"_19192":52795,"_5":13195,"_26170":52458,"_2648":52796},[],"Use the new event endpoints",{"_3150":2513,"_27660":2397,"_19192":52798,"_5":13195,"_26170":52458,"_2648":52491},[],{"_3150":2514,"_27660":2397,"_19192":52800,"_5":13195,"_26170":52458,"_2648":52801},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3150":2515,"_27660":2397,"_19192":52803,"_5":13195,"_26170":52458,"_2648":52804},[],"Low to medium: validation errors or changed defaults",{"_3150":2516,"_27660":2397,"_19192":52806,"_5":13195,"_26170":52458,"_2648":52807},[],"Update the values file",{"_3150":2517,"_27660":2397,"_19192":52809,"_5":13195,"_26170":52458,"_2648":52527},[],{"_3150":2518,"_27660":2397,"_19192":52811,"_5":13195,"_26170":52458,"_2648":52812},[],"Clients that send the DMS ID in the update body",{"_3150":2519,"_27660":2397,"_19192":52814,"_5":13195,"_26170":52458,"_2648":52815},[],"Low: the ID in the URL wins",{"_3150":2520,"_27660":2397,"_19192":52817,"_5":13195,"_26170":52458,"_2648":52818},[],"Send the ID in the URL",{"_3150":2521,"_27660":2397,"_19192":52820,"_5":13195,"_26170":52458,"_2648":52531},[],{"_3150":2522,"_27660":2397,"_19192":52822,"_5":13195,"_26170":52458,"_2648":52823},[],"Consumers that match on certificate `type`",{"_3150":2523,"_27660":2397,"_19192":52825,"_5":13195,"_26170":52458,"_2648":52826},[],"Low: two values are renamed",{"_3150":2524,"_27660":2397,"_19192":52828,"_5":13195,"_26170":52458,"_2648":52829},[],"Adapt consumers",{"_3150":2525,"_27660":2397,"_19192":52831,"_5":13195,"_26170":52458,"_2648":52523},[],{"_3150":2526,"_27660":2397,"_19192":52833,"_5":13195,"_26170":52458,"_2648":52834},[],"Any DMS",{"_3150":2527,"_27660":2397,"_19192":52836,"_5":13195,"_26170":52458,"_2648":52837},[],"Low: informational",{"_3150":2528,"_27660":2397,"_19192":52839,"_5":13195,"_26170":52458,"_2648":52840},[],"Read both blocks before editing",{"_3150":2529,"_27660":2397,"_19192":52842,"_5":13195,"_26170":52466,"_2648":52843},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3150":2530,"_27660":2397,"_19192":52845,"_5":13195,"_26170":52466,"_2648":52846},[],"Step 4 of the migration guide copies the data.",{"_3150":2531,"_27660":2397,"_19192":52848,"_5":13195,"_26170":52470,"_2648":52849},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3150":2532,"_27660":2397,"_19192":52851,"_5":13195,"_26170":52474,"_2648":52852},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3150":2533,"_27660":2397,"_19192":52854,"_5":13195,"_26170":52478,"_2648":52855},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3150":2534,"_27660":2397,"_19192":52857,"_5":13195,"_26170":52482,"_2648":52858},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3150":2535,"_27660":2397,"_19192":52860,"_5":13195,"_26170":52482,"_2648":52861},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3150":2536,"_27660":2397,"_19192":52863,"_5":13195,"_26170":52486,"_2648":52864},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3150":2537,"_27660":2397,"_19192":52866,"_5":13195,"_26170":52490,"_2648":52867},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3150":2538,"_27660":2397,"_19192":52869,"_5":13195,"_26170":52490,"_2648":52870},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3150":2539,"_27660":2397,"_19192":52872,"_5":13195,"_26170":52490,"_2648":52873},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3150":2540,"_27660":2397,"_19192":52875,"_5":13195,"_26170":52490,"_2648":52876},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3150":2541,"_27660":2397,"_19192":52878,"_5":13195,"_26170":52490,"_2648":52879},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3150":2542,"_27660":2397,"_19192":52881,"_5":13195,"_26170":52490,"_2648":52882},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3150":2543,"_27660":2397,"_19192":52884,"_5":13195,"_26170":52498,"_2648":52885},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3150":2544,"_27660":2397,"_19192":52887,"_5":13195,"_26170":52498,"_2648":52888},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3150":2545,"_27660":2397,"_19192":52890,"_5":13195,"_26170":52498,"_2648":52891},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3150":2546,"_27660":2397,"_19192":52893,"_5":13195,"_26170":52498,"_2648":52894},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3150":2547,"_27660":2397,"_19192":52896,"_5":13195,"_26170":52498,"_2648":52897},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3150":2548,"_27660":2397,"_19192":52899,"_5":13195,"_26170":52502,"_2648":52900},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3150":2549,"_27660":2397,"_19192":52902,"_5":13195,"_26170":52506,"_2648":52903},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3150":2550,"_27660":2397,"_19192":52905,"_5":13195,"_26170":52506,"_2648":52906},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3150":2551,"_27660":2397,"_19192":52908,"_5":13195,"_26170":52506,"_2648":52909},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3150":2552,"_27660":2397,"_19192":52911,"_5":13195,"_26170":52506,"_2648":52912},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3150":2553,"_27660":2397,"_19192":52914,"_5":13195,"_26170":52506,"_2648":52915},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3150":2554,"_27660":2397,"_19192":52917,"_5":13195,"_26170":52506,"_2648":52918},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3150":2555,"_27660":2397,"_19192":52920,"_5":13195,"_26170":52514,"_2648":52921},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3150":2556,"_27660":2397,"_19192":52923,"_5":13195,"_26170":52514,"_2648":52924},[],"Field in 3.8.0",{"_3150":2557,"_27660":2397,"_19192":52926,"_5":13195,"_26170":52514,"_2648":52927},[],"Field in 4.0.0",{"_3150":2558,"_27660":2397,"_19192":52929,"_5":13195,"_26170":52514,"_2648":52930},[],"`validate_server_cert`",{"_3150":2559,"_27660":2397,"_19192":52932,"_5":13195,"_26170":52514,"_2648":52933},[],"`insecure_skip_verify` (value negated)",{"_3150":2560,"_27660":2397,"_19192":52935,"_5":13195,"_26170":52514,"_2648":52936},[],"`oidc`",{"_3150":2561,"_27660":2397,"_19192":52938,"_5":13195,"_26170":52514,"_2648":52939},[],"`jwt_options`",{"_3150":2562,"_27660":2397,"_19192":52941,"_5":13195,"_26170":52514,"_2648":52942},[],"`apikey`",{"_3150":2563,"_27660":2397,"_19192":52944,"_5":13195,"_26170":52514,"_2648":52945},[],"`apikey_options`",{"_3150":2564,"_27660":2397,"_19192":52947,"_5":13195,"_26170":52514,"_2648":52948},[],"`mtls`",{"_3150":2565,"_27660":2397,"_19192":52950,"_5":13195,"_26170":52514,"_2648":52951},[],"`mtls_options`",{"_3150":2566,"_27660":2397,"_19192":52953,"_5":13195,"_26170":52514,"_2648":52954},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3150":2567,"_27660":2397,"_19192":52956,"_5":13195,"_26170":52514,"_2648":52957},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3150":2568,"_27660":2397,"_19192":52959,"_5":13195,"_26170":52514,"_2648":52960},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3150":2569,"_27660":2397,"_19192":52962,"_5":13195,"_26170":52518,"_2648":52963},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3150":2570,"_27660":2397,"_19192":52965,"_5":13195,"_26170":52518,"_2648":52966},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3150":2571,"_27660":2397,"_19192":52968,"_5":13195,"_26170":52518,"_2648":52969},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3150":2572,"_27660":2397,"_19192":52971,"_5":13195,"_26170":52522,"_2648":52972},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. If the console version does not expose independent settings, edit them through the DMS API.",{"_3150":2573,"_27660":2397,"_19192":52974,"_5":13195,"_26170":52526,"_2648":52975},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3150":2574,"_27660":2397,"_19192":52977,"_5":13195,"_26170":52530,"_2648":52978},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3150":2575,"_27660":2397,"_19192":52980,"_5":13195,"_26170":52534,"_2648":52981},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3150":2576,"_27660":2397,"_19192":52983,"_5":13195,"_26170":52534,"_2648":52984},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3150":2577,"_27660":2397,"_19192":52986,"_5":13195,"_26170":52534,"_2648":52987},[],"`POST /v1/devices/:id/events` creates an event.",{"_3150":2578,"_27660":2397,"_19192":52989,"_5":13195,"_26170":52534,"_2648":52990},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3150":2579,"_27660":2397,"_19192":52992,"_5":13195,"_26170":52538,"_2648":52993},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3150":2580,"_27660":2397,"_19192":52995,"_5":13195,"_26170":52542,"_2648":52996},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3150":2581,"_27660":2397,"_19192":52998,"_5":13195,"_26170":52542,"_2648":52999},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3150":2582,"_27660":2397,"_19192":53001,"_5":13195,"_26170":52542,"_2648":53002},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3150":2583,"_27660":2397,"_19192":53004,"_5":13195,"_26170":52542,"_2648":53005},[],"Record the names of your local-storage PVCs:",{"_3150":2584,"_27660":2397,"_19192":53007,"_5":13195,"_26170":52542,"_2648":53008},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3150":2585,"_27660":2397,"_19192":53010,"_5":13195,"_26170":52546,"_2648":53011},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3150":2586,"_27660":2397,"_19192":53013,"_5":13195,"_26170":52546,"_2648":53014},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3150":2587,"_27660":2397,"_19192":53016,"_5":13195,"_26170":52546,"_2648":53017},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3150":2588,"_27660":2397,"_19192":53019,"_5":13195,"_26170":52546,"_2648":53020},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3150":2589,"_27660":2397,"_19192":53022,"_5":13195,"_26170":52546,"_2648":53023},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3150":2590,"_27660":2397,"_19192":53025,"_5":13195,"_26170":52546,"_2648":53026},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3150":2591,"_27660":2397,"_19192":53028,"_5":13195,"_26170":52546,"_2648":53029},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3150":2592,"_27660":2397,"_19192":53031,"_5":13195,"_26170":52546,"_2648":53032},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3150":2593,"_27660":2397,"_19192":53034,"_5":13195,"_26170":52546,"_2648":53035},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3150":2594,"_27660":2397,"_19192":53037,"_5":13195,"_26170":52546,"_2648":53038},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3150":2595,"_27660":2397,"_19192":53040,"_5":13195,"_26170":52546,"_2648":53041},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3150":2596,"_27660":2397,"_19192":53043,"_5":13195,"_26170":52546,"_2648":53044},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3150":2597,"_27660":2397,"_19192":53046,"_5":13195,"_26170":52550,"_2648":53047},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3150":2598,"_27660":2397,"_19192":53049,"_5":13195,"_26170":52550,"_2648":53050},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3150":2599,"_27660":2397,"_19192":53052,"_5":13195,"_26170":52554,"_2648":53053},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3150":2600,"_27660":2397,"_19192":53055,"_5":13195,"_26170":52554,"_2648":53056},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3150":2601,"_27660":2397,"_19192":53058,"_5":13195,"_26170":52554,"_2648":53059},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3150":2602,"_27660":2397,"_19192":53061,"_5":13195,"_26170":52554,"_2648":53062},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3150":2603,"_27660":2397,"_19192":53064,"_5":13195,"_26170":52554,"_2648":53065},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3150":2604,"_27660":2397,"_19192":53067,"_5":13195,"_26170":52554,"_2648":53068},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3150":2605,"_27660":2397,"_19192":53070,"_5":13195,"_26170":52554,"_2648":53071},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3150":2606,"_27660":2397,"_19192":53073,"_5":13195,"_26170":52554,"_2648":53074},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3150":2607,"_27660":2397,"_19192":53076,"_5":13195,"_26170":52554,"_2648":53077},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3150":2608,"_27660":2397,"_19192":53079,"_5":13195,"_26170":52554,"_2648":53080},[],"**Remove the helper and restore the recorded replica counts:**",{"_3150":2609,"_27660":2397,"_19192":53082,"_5":13195,"_26170":52554,"_2648":53083},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3150":2610,"_27660":2397,"_19192":53085,"_5":13195,"_26170":52558,"_2648":53086},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3150":2611,"_27660":2397,"_19192":53088,"_5":13195,"_26170":52558,"_2648":53089},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3150":2612,"_27660":2397,"_19192":53091,"_5":13195,"_26170":52562,"_2648":53092},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3150":2613,"_27660":2397,"_19192":53094,"_5":13195,"_26170":52562,"_2648":53095},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3150":2614,"_27660":2397,"_19192":53097,"_5":13195,"_26170":52562,"_2648":53098},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3150":2615,"_27660":2397,"_19192":53100,"_5":13195,"_26170":52562,"_2648":53101},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3150":2616,"_27660":2397,"_19192":53103,"_5":13195,"_26170":52562,"_2648":53104},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3150":2617,"_27660":2397,"_19192":53106,"_5":13195,"_26170":52566,"_2648":53107},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3150":2618,"_27660":2397,"_19192":53109,"_5":13195,"_26170":52566,"_2648":53110},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3150":2619,"_27660":2397,"_19192":53112,"_5":13195,"_26170":52566,"_2648":53113},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3150":2620,"_27660":2397,"_19192":53115,"_5":13195,"_26170":52566,"_2648":53116},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3150":2621,"_27660":2397,"_19192":53118,"_5":13195,"_26170":52566,"_2648":53119},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3150":2622,"_27660":2397,"_19192":53121,"_5":13195,"_26170":52566,"_2648":53122},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3150":2623,"_27660":2397,"_19192":53124,"_5":13195,"_26170":52566,"_2648":53125},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3150":2624,"_27660":2397,"_19192":53127,"_5":13195,"_26170":52569,"_2648":53128},[],"After the upgrade, check in this order:",{"_3150":2625,"_27660":2397,"_19192":53130,"_5":13195,"_26170":52569,"_2648":53131},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3150":2626,"_27660":2397,"_19192":53133,"_5":13195,"_26170":52569,"_2648":53134},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3150":2627,"_27660":2397,"_19192":53136,"_5":13195,"_26170":52569,"_2648":53137},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3150":2628,"_27660":2397,"_19192":53139,"_5":13195,"_26170":52569,"_2648":53140},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3150":2629,"_27660":2397,"_19192":53142,"_5":13195,"_26170":52569,"_2648":53143},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3150":2630,"_27660":2397,"_19192":53145,"_5":13195,"_26170":52569,"_2648":53146},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3150":2631,"_27660":2397,"_19192":53148,"_5":13195,"_26170":52569,"_2648":53149},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3150":2632,"_27660":2397,"_19192":53151,"_5":13195,"_26170":52569,"_2648":53152},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3150":2633,"_27660":2397,"_19192":53154,"_5":13195,"_26170":52569,"_2648":53155},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3150":2634,"_27660":2397,"_19192":53157,"_5":13195,"_26170":52569,"_2648":53158},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3150":2635,"_27660":2397,"_19192":53160,"_5":13195,"_26170":52569,"_2648":53161},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3150":2636,"_27660":2397,"_19192":53163,"_5":13195,"_26170":52569,"_2648":53164},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3150":2637,"_27660":2397,"_19192":53166,"_5":13195,"_26170":52569,"_2648":53167},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3150":2638,"_27660":2397,"_19192":53169,"_5":13195,"_26170":52569,"_2648":53170},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3150":2639,"_27660":2397,"_19192":53172,"_5":13195,"_26170":52573,"_2648":53173},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3150":2640,"_27660":2397,"_19192":53175,"_5":13195,"_26170":52573,"_2648":53176},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3150":2641,"_27660":2397,"_19192":53178,"_5":13195,"_26170":52573,"_2648":53179},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3150":2642,"_27660":2397,"_19192":53181,"_5":13195,"_26170":52573,"_2648":53182},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3150":2643,"_27660":2397,"_19192":53184,"_5":13195,"_26170":52573,"_2648":53185},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_53188":53189,"_53190":53191,"_53192":53193,"_53194":53195,"_16733":2670,"_63725":2670},"language","english","sortableProperties",[2648,27660,5,26170],"sortablePropertiesWithTypes",{"_2648":22952,"_27660":22952,"_5":22952,"_26170":22952},"sorts",{"_2648":53196,"_27660":55829,"_5":58461,"_26170":61093},{"_4214":53197,"_53198":53199,"_5":22952},{"_13250":4656,"_13620":6929,"_13627":5547,"_11891":3238,"_26296":6773,"_18221":3105,"_13271":4686,"_13278":3024,"_26723":5590,"_27110":6553,"_27131":6607,"_26741":5264,"_31734":3769,"_27142":7583,"_27171":3261,"_31741":5358,"_31744":7232,"_31747":5989,"_31750":2923,"_27519":5438,"_31755":4171,"_31757":3589,"_27549":4424,"_27509":2914,"_31761":5014,"_31764":5075,"_31766":4341,"_27160":12835,"_27514":15123,"_27573":11115,"_31771":11253,"_31773":3370,"_31775":7305,"_31777":2745,"_31779":19304,"_31781":5395,"_31783":5986,"_31785":3339,"_31787":3405,"_26794":11149,"_31790":5862,"_31792":10673,"_26788":3034,"_31795":4270,"_31797":3712,"_31799":2826,"_31802":11218,"_26829":3122,"_31806":2756,"_26714":5589,"_31809":3816,"_26746":3649,"_31812":6921,"_31814":3020,"_31817":4593,"_27544":5393,"_31820":4001,"_31822":5442,"_31825":5425,"_31827":3868,"_31829":2787,"_31831":2731,"_31833":5439,"_18224":8025,"_31836":2945,"_31838":5890,"_26768":13858,"_27154":23326,"_31842":6295,"_31844":3431,"_31846":8056,"_31848":21068,"_31850":2932,"_31852":6506,"_31854":17227,"_27640":4537,"_27187":2955,"_31858":6842,"_31860":15778,"_26757":4521,"_31863":12729,"_318