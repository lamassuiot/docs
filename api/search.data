463,"_41626":129466,"_41628":129469,"_41630":129472,"_41632":129475,"_41634":129478,"_41636":129481,"_41638":129484,"_41640":129487,"_41642":129490,"_41645":129493,"_41647":129496,"_41649":129499},{"_3624":72676,"_31165":72676,"_5":15217,"_3076":120222,"_31503":120223,"_21590":120226,"_28357":72676},"Despliega desde AWS Marketplace",[50900,120224,120225],"Despliegue","Otros modelos",[],{"_3624":72677,"_31165":72676,"_21590":120228,"_5":14857,"_28357":72676,"_3076":120229},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3624":72678,"_31165":72676,"_5":31500,"_21590":120231,"_28357":120232,"_3076":120233},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3624":72679,"_31165":72676,"_5":31500,"_21590":120235,"_28357":120236,"_3076":120237},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3624":72680,"_31165":72676,"_5":31500,"_21590":120239,"_28357":120240,"_3076":120241},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3624":72681,"_31165":72676,"_5":31500,"_21590":120243,"_28357":120244,"_3076":120245},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3624":72682,"_31165":72676,"_5":31500,"_21590":120247,"_28357":120248,"_3076":120249},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3624":72683,"_31165":72676,"_5":31500,"_21590":120251,"_28357":120252,"_3076":120253},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3624":72684,"_31165":72676,"_5":31500,"_21590":120255,"_28357":120256,"_3076":120257},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3624":72685,"_31165":72676,"_21590":120259,"_5":14857,"_28357":72676,"_3076":120260},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3624":72686,"_31165":72676,"_21590":120262,"_5":14857,"_28357":120232,"_3076":120263},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3624":72687,"_31165":72676,"_21590":120265,"_5":14857,"_28357":120232,"_3076":120266},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3624":72688,"_31165":72676,"_21590":120268,"_5":14857,"_28357":120232,"_3076":120269},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3624":72689,"_31165":72676,"_21590":120271,"_5":14857,"_28357":120236,"_3076":120272},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3624":72690,"_31165":72676,"_21590":120274,"_5":14857,"_28357":120236,"_3076":120275},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3624":72691,"_31165":72676,"_21590":120277,"_5":14857,"_28357":120236,"_3076":120278},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3624":72692,"_31165":72676,"_21590":120280,"_5":14857,"_28357":120240,"_3076":120281},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3624":72693,"_31165":72676,"_21590":120283,"_5":14857,"_28357":120244,"_3076":120284},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3624":72694,"_31165":72676,"_21590":120286,"_5":14857,"_28357":120248,"_3076":120287},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3624":72695,"_31165":72676,"_21590":120289,"_5":14857,"_28357":120252,"_3076":120290},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3624":72696,"_31165":72676,"_21590":120292,"_5":14857,"_28357":120256,"_3076":120293},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3624":72697,"_31165":72697,"_5":15217,"_3076":120295,"_31503":120296,"_21590":120297,"_28357":72697},"Despliega Lamassu",[50900,120224],[],{"_3624":72698,"_31165":72697,"_21590":120299,"_5":14857,"_28357":72697,"_3076":120300},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3624":72699,"_31165":72697,"_5":31500,"_21590":120302,"_28357":120303,"_3076":120304},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3624":72700,"_31165":72697,"_5":31500,"_21590":120306,"_28357":120307,"_3076":120308},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3624":72701,"_31165":72697,"_5":31500,"_21590":120310,"_28357":120311,"_3076":120312},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3624":72702,"_31165":72697,"_21590":120314,"_5":14857,"_28357":72697,"_3076":120315},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3624":72703,"_31165":72697,"_21590":120317,"_5":14857,"_28357":120303,"_3076":120318},[],"Modelo",{"_3624":72704,"_31165":72697,"_21590":120320,"_5":14857,"_28357":120303,"_3076":120321},[],"Recomendado para",{"_3624":72705,"_31165":72697,"_21590":120323,"_5":14857,"_28357":120303,"_3076":120324},[],"Quién opera la infraestructura",{"_3624":72706,"_31165":72697,"_21590":120326,"_5":14857,"_28357":120303,"_3076":120327},[],"Punto de partida",{"_3624":72707,"_31165":72697,"_21590":120329,"_5":14857,"_28357":120303,"_3076":51007},[],{"_3624":72708,"_31165":72697,"_21590":120331,"_5":14857,"_28357":120303,"_3076":120332},[],"Producción, entornos regulados y despliegues personalizados",{"_3624":72709,"_31165":72697,"_21590":120334,"_5":14857,"_28357":120303,"_3076":120335},[],"Tu equipo",{"_3624":72710,"_31165":72697,"_21590":120337,"_5":14857,"_28357":120303,"_3076":120338},[],"Helm o Fastlane",{"_3624":72711,"_31165":72697,"_21590":120340,"_5":14857,"_28357":120303,"_3076":51019},[],{"_3624":72712,"_31165":72697,"_21590":120342,"_5":14857,"_28357":120303,"_3076":120343},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3624":72713,"_31165":72697,"_21590":120345,"_5":14857,"_28357":120303,"_3076":120335},[],{"_3624":72714,"_31165":72697,"_21590":120347,"_5":14857,"_28357":120303,"_3076":120348},[],"Imagen preconfigurada en EC2",{"_3624":72715,"_31165":72697,"_21590":120350,"_5":14857,"_28357":120303,"_3076":51030},[],{"_3624":72716,"_31165":72697,"_21590":120352,"_5":14857,"_28357":120303,"_3076":120353},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3624":72717,"_31165":72697,"_21590":120355,"_5":14857,"_28357":120303,"_3076":51036},[],{"_3624":72718,"_31165":72697,"_21590":120357,"_5":14857,"_28357":120303,"_3076":120358},[],"Suscripción gestionada",{"_3624":72719,"_31165":72697,"_21590":120360,"_5":14857,"_28357":120303,"_3076":120361},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3624":72720,"_31165":72697,"_21590":120363,"_5":14857,"_28357":120303,"_3076":120364},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3624":72721,"_31165":72697,"_21590":120366,"_5":14857,"_28357":120303,"_3076":120367},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3624":72722,"_31165":72697,"_21590":120369,"_5":14857,"_28357":120307,"_3076":120370},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3624":72723,"_31165":72697,"_21590":120372,"_5":14857,"_28357":120311,"_3076":120373},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3624":72724,"_31165":72724,"_5":15217,"_3076":120375,"_31503":120376,"_21590":120377,"_28357":72724},"Utiliza Lamassu como SaaS",[50900,120224,120225],[],{"_3624":72725,"_31165":72724,"_21590":120379,"_5":14857,"_28357":72724,"_3076":120380},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3624":72726,"_31165":72724,"_5":31500,"_21590":120382,"_28357":120383,"_3076":120384},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3624":72727,"_31165":72724,"_5":31500,"_21590":120386,"_28357":120387,"_3076":120388},[],"/docs/es/deployment/saas#planes","Planes",{"_3624":72728,"_31165":72724,"_5":31500,"_21590":120390,"_28357":120391,"_3076":120392},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3624":72729,"_31165":72724,"_21590":120394,"_5":14857,"_28357":72724,"_3076":120395},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3624":72730,"_31165":72724,"_21590":120397,"_5":14857,"_28357":120383,"_3076":120398},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3624":72731,"_31165":72724,"_21590":120400,"_5":14857,"_28357":120383,"_3076":120401},[],"Copias de seguridad automáticas.",{"_3624":72732,"_31165":72724,"_21590":120403,"_5":14857,"_28357":120383,"_3076":120404},[],"Actualizaciones de versión.",{"_3624":72733,"_31165":72724,"_21590":120406,"_5":14857,"_28357":120383,"_3076":120407},[],"Soporte técnico y SLA según el plan contratado.",{"_3624":72734,"_31165":72724,"_21590":120409,"_5":14857,"_28357":120387,"_3076":51091},[],{"_3624":72735,"_31165":72724,"_21590":120411,"_5":14857,"_28357":120387,"_3076":120412},[],"Dispositivos",{"_3624":72736,"_31165":72724,"_21590":120414,"_5":14857,"_28357":120387,"_3076":120415},[],"Soporte",{"_3624":72737,"_31165":72724,"_21590":120417,"_5":14857,"_28357":120387,"_3076":51100},[],{"_3624":72738,"_31165":72724,"_21590":120419,"_5":14857,"_28357":120387,"_3076":51103},[],{"_3624":72739,"_31165":72724,"_21590":120421,"_5":14857,"_28357":120387,"_3076":120422},[],"Hasta 1.000",{"_3624":72740,"_31165":72724,"_21590":120424,"_5":14857,"_28357":120387,"_3076":51109},[],{"_3624":72741,"_31165":72724,"_21590":120426,"_5":14857,"_28357":120387,"_3076":120427},[],"99,5 %",{"_3624":72742,"_31165":72724,"_21590":120429,"_5":14857,"_28357":120387,"_3076":51115},[],{"_3624":72743,"_31165":72724,"_21590":120431,"_5":14857,"_28357":120387,"_3076":120432},[],"Hasta 10.000",{"_3624":72744,"_31165":72724,"_21590":120434,"_5":14857,"_28357":120387,"_3076":120435},[],"Email y chat",{"_3624":72745,"_31165":72724,"_21590":120437,"_5":14857,"_28357":120387,"_3076":120438},[],"99,9 %",{"_3624":72746,"_31165":72724,"_21590":120440,"_5":14857,"_28357":120387,"_3076":51127},[],{"_3624":72747,"_31165":72724,"_21590":120442,"_5":14857,"_28357":120387,"_3076":120443},[],"Ilimitados",{"_3624":72748,"_31165":72724,"_21590":120445,"_5":14857,"_28357":120387,"_3076":120446},[],"Dedicado",{"_3624":72749,"_31165":72724,"_21590":120448,"_5":14857,"_28357":120387,"_3076":120449},[],"99,99 %",{"_3624":72750,"_31165":72724,"_21590":120451,"_5":14857,"_28357":120391,"_3076":120452},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3624":72751,"_31165":72724,"_21590":120454,"_5":14857,"_28357":120391,"_3076":120455},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3624":72752,"_31165":72752,"_5":15217,"_3076":51144,"_31503":120457,"_21590":120459,"_28357":72752},[50900,120224,120458],"Kubernetes autogestionado",[],{"_3624":72753,"_31165":72752,"_21590":120461,"_5":14857,"_28357":72752,"_3076":120462},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3624":72754,"_31165":72752,"_5":31500,"_21590":120464,"_28357":120465,"_3076":120466},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3624":72755,"_31165":72752,"_5":31500,"_21590":120468,"_28357":120469,"_3076":120470},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3624":72756,"_31165":72752,"_5":31500,"_21590":120472,"_28357":120473,"_3076":120474},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3624":72757,"_31165":72752,"_5":31500,"_21590":120476,"_28357":120477,"_3076":120478},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3624":72758,"_31165":72752,"_5":31500,"_21590":120480,"_28357":120481,"_3076":120482},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3624":72759,"_31165":72752,"_5":31500,"_21590":120484,"_28357":120485,"_3076":120486},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3624":72760,"_31165":72752,"_5":31500,"_21590":120488,"_28357":120489,"_3076":120490},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3624":72761,"_31165":72752,"_5":31500,"_21590":120492,"_28357":120493,"_3076":120494},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3624":72762,"_31165":72752,"_5":31500,"_21590":120496,"_28357":120497,"_3076":120498},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3624":72763,"_31165":72752,"_5":31500,"_21590":120500,"_28357":120501,"_3076":120502},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3624":72764,"_31165":72752,"_5":31500,"_21590":120504,"_28357":120505,"_3076":120506},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3624":72765,"_31165":72752,"_21590":120508,"_5":14857,"_28357":120465,"_3076":120509},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3624":72766,"_31165":72752,"_21590":120511,"_5":14857,"_28357":120465,"_3076":120512},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3624":72767,"_31165":72752,"_21590":120514,"_5":14857,"_28357":120469,"_3076":120515},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3624":72768,"_31165":72752,"_21590":120517,"_5":14857,"_28357":120469,"_3076":120518},[],"Fastlane instala o configura",{"_3624":72769,"_31165":72752,"_21590":120520,"_5":14857,"_28357":120469,"_3076":120521},[],"Tú sigues proporcionando",{"_3624":72770,"_31165":72752,"_21590":120523,"_5":14857,"_28357":120469,"_3076":120524},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3624":72771,"_31165":72752,"_21590":120526,"_5":14857,"_28357":120469,"_3076":120527},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3624":72772,"_31165":72752,"_21590":120529,"_5":14857,"_28357":120469,"_3076":120530},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3624":72773,"_31165":72752,"_21590":120532,"_5":14857,"_28357":120469,"_3076":120533},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3624":72774,"_31165":72752,"_21590":120535,"_5":14857,"_28357":120469,"_3076":120536},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3624":72775,"_31165":72752,"_21590":120538,"_5":14857,"_28357":120469,"_3076":120539},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3624":72776,"_31165":72752,"_21590":120541,"_5":14857,"_28357":120469,"_3076":120542},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3624":72777,"_31165":72752,"_21590":120544,"_5":14857,"_28357":120469,"_3076":120545},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3624":72778,"_31165":72752,"_21590":120547,"_5":14857,"_28357":120469,"_3076":120548},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3624":72779,"_31165":72752,"_21590":120550,"_5":14857,"_28357":120473,"_3076":120551},[],"Necesitas:",{"_3624":72780,"_31165":72752,"_21590":120553,"_5":14857,"_28357":120473,"_3076":120554},[],"un clúster Kubernetes existente",{"_3624":72781,"_31165":72752,"_21590":120556,"_5":14857,"_28357":120473,"_3076":120557},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3624":72782,"_31165":72752,"_21590":120559,"_5":14857,"_28357":120473,"_3076":51246},[],{"_3624":72783,"_31165":72752,"_21590":120561,"_5":14857,"_28357":120473,"_3076":24402},[],{"_3624":72784,"_31165":72752,"_21590":120563,"_5":14857,"_28357":120473,"_3076":120564},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3624":72785,"_31165":72752,"_21590":120566,"_5":14857,"_28357":120473,"_3076":120567},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3624":72786,"_31165":72752,"_21590":120569,"_5":14857,"_28357":120473,"_3076":120570},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3624":72787,"_31165":72752,"_21590":120572,"_5":14857,"_28357":120473,"_3076":120573},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3624":72788,"_31165":72752,"_21590":120575,"_5":14857,"_28357":120473,"_3076":120576},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3624":72789,"_31165":72752,"_21590":120578,"_5":14857,"_28357":120477,"_3076":120579},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3624":72790,"_31165":72752,"_21590":120581,"_5":14857,"_28357":120477,"_3076":120582},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3624":72791,"_31165":72752,"_21590":120584,"_5":14857,"_28357":120481,"_3076":120585},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3624":72792,"_31165":72752,"_21590":120587,"_5":14857,"_28357":120481,"_3076":120588},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3624":72793,"_31165":72752,"_21590":120590,"_5":14857,"_28357":120481,"_3076":120591},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3624":72794,"_31165":72752,"_21590":120593,"_5":14857,"_28357":120481,"_3076":120594},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3624":72795,"_31165":72752,"_21590":120596,"_5":14857,"_28357":120485,"_3076":120597},[],"Opción",{"_3624":72796,"_31165":72752,"_21590":120599,"_5":14857,"_28357":120485,"_3076":120600},[],"Valor predeterminado",{"_3624":72797,"_31165":72752,"_21590":120602,"_5":14857,"_28357":120485,"_3076":120603},[],"Propósito",{"_3624":72798,"_31165":72752,"_21590":120605,"_5":14857,"_28357":120485,"_3076":51293},[],{"_3624":72799,"_31165":72752,"_21590":120607,"_5":14857,"_28357":120485,"_3076":51296},[],{"_3624":72800,"_31165":72752,"_21590":120609,"_5":14857,"_28357":120485,"_3076":120610},[],"Muestra la ayuda",{"_3624":72801,"_31165":72752,"_21590":120612,"_5":14857,"_28357":120485,"_3076":51302},[],{"_3624":72802,"_31165":72752,"_21590":120614,"_5":14857,"_28357":120485,"_3076":120615},[],"contexto actual",{"_3624":72803,"_31165":72752,"_21590":120617,"_5":14857,"_28357":120485,"_3076":120618},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3624":72804,"_31165":72752,"_21590":120620,"_5":14857,"_28357":120485,"_3076":51311},[],{"_3624":72805,"_31165":72752,"_21590":120622,"_5":14857,"_28357":120485,"_3076":6790},[],{"_3624":72806,"_31165":72752,"_21590":120624,"_5":14857,"_28357":120485,"_3076":120625},[],"Omite prompts y genera credenciales para las dependencias",{"_3624":72807,"_31165":72752,"_21590":120627,"_5":14857,"_28357":120485,"_3076":51319},[],{"_3624":72808,"_31165":72752,"_21590":120629,"_5":14857,"_28357":120485,"_3076":51322},[],{"_3624":72809,"_31165":72752,"_21590":120631,"_5":14857,"_28357":120485,"_3076":120632},[],"Namespace de la instalación",{"_3624":72810,"_31165":72752,"_21590":120634,"_5":14857,"_28357":120485,"_3076":51328},[],{"_3624":72811,"_31165":72752,"_21590":120636,"_5":14857,"_28357":120485,"_3076":51331},[],{"_3624":72812,"_31165":72752,"_21590":120638,"_5":14857,"_28357":120485,"_3076":120639},[],"Dominio usado por la UI, OIDC y el certificado",{"_3624":72813,"_31165":72752,"_21590":120641,"_5":14857,"_28357":120485,"_3076":51337},[],{"_3624":72814,"_31165":72752,"_21590":120643,"_5":14857,"_28357":120485,"_3076":15569},[],{"_3624":72815,"_31165":72752,"_21590":120645,"_5":14857,"_28357":120485,"_3076":120646},[],"Versión del chart de Lamassu",{"_3624":72816,"_31165":72752,"_21590":120648,"_5":14857,"_28357":120485,"_3076":51345},[],{"_3624":72817,"_31165":72752,"_21590":120650,"_5":14857,"_28357":120485,"_3076":51348},[],{"_3624":72818,"_31165":72752,"_21590":120652,"_5":14857,"_28357":120485,"_3076":120653},[],"Puerto del listener HTTPS",{"_3624":72819,"_31165":72752,"_21590":120655,"_5":14857,"_28357":120485,"_3076":51354},[],{"_3624":72820,"_31165":72752,"_21590":120657,"_5":14857,"_28357":120485,"_3076":51357},[],{"_3624":72821,"_31165":72752,"_21590":120659,"_5":14857,"_28357":120485,"_3076":120660},[],"Puerto del listener HTTP",{"_3624":72822,"_31165":72752,"_21590":120662,"_5":14857,"_28357":120485,"_3076":51363},[],{"_3624":72823,"_31165":72752,"_21590":120664,"_5":14857,"_28357":120485,"_3076":51296},[],{"_3624":72824,"_31165":72752,"_21590":120666,"_5":14857,"_28357":120485,"_3076":120667},[],"Certificado PEM para TLS downstream",{"_3624":72825,"_31165":72752,"_21590":120669,"_5":14857,"_28357":120485,"_3076":51371},[],{"_3624":72826,"_31165":72752,"_21590":120671,"_5":14857,"_28357":120485,"_3076":51296},[],{"_3624":72827,"_31165":72752,"_21590":120673,"_5":14857,"_28357":120485,"_3076":120674},[],"Clave privada PEM para TLS downstream",{"_3624":72828,"_31165":72752,"_21590":120676,"_5":14857,"_28357":120485,"_3076":51379},[],{"_3624":72829,"_31165":72752,"_21590":120678,"_5":14857,"_28357":120485,"_3076":120679},[],"chart del repositorio",{"_3624":72830,"_31165":72752,"_21590":120681,"_5":14857,"_28357":120485,"_3076":120682},[],"Usa un chart local de Lamassu sin empaquetar",{"_3624":72831,"_31165":72752,"_21590":120684,"_5":14857,"_28357":120485,"_3076":51388},[],{"_3624":72832,"_31165":72752,"_21590":120686,"_5":14857,"_28357":120485,"_3076":120687},[],"detección automática",{"_3624":72833,"_31165":72752,"_21590":120689,"_5":14857,"_28357":120485,"_3076":120690},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3624":72834,"_31165":72752,"_21590":120692,"_5":14857,"_28357":120485,"_3076":51396},[],{"_3624":72835,"_31165":72752,"_21590":120694,"_5":14857,"_28357":120485,"_3076":6790},[],{"_3624":72836,"_31165":72752,"_21590":120696,"_5":14857,"_28357":120485,"_3076":120697},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3624":72837,"_31165":72752,"_21590":120699,"_5":14857,"_28357":120485,"_3076":51404},[],{"_3624":72838,"_31165":72752,"_21590":120701,"_5":14857,"_28357":120485,"_3076":6790},[],{"_3624":72839,"_31165":72752,"_21590":120703,"_5":14857,"_28357":120485,"_3076":120704},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3624":72840,"_31165":72752,"_21590":120706,"_5":14857,"_28357":120485,"_3076":51412},[],{"_3624":72841,"_31165":72752,"_21590":120708,"_5":14857,"_28357":120485,"_3076":6790},[],{"_3624":72842,"_31165":72752,"_21590":120710,"_5":14857,"_28357":120485,"_3076":120711},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3624":72843,"_31165":72752,"_21590":120713,"_5":14857,"_28357":120485,"_3076":51420},[],{"_3624":72844,"_31165":72752,"_21590":120715,"_5":14857,"_28357":120485,"_3076":6790},[],{"_3624":72845,"_31165":72752,"_21590":120717,"_5":14857,"_28357":120485,"_3076":120718},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3624":72846,"_31165":72752,"_21590":120720,"_5":14857,"_28357":120485,"_3076":51428},[],{"_3624":72847,"_31165":72752,"_21590":120722,"_5":14857,"_28357":120485,"_3076":51431},[],{"_3624":72848,"_31165":72752,"_21590":120724,"_5":14857,"_28357":120485,"_3076":120725},[],"Usa otro chart local de SoftHSM",{"_3624":72849,"_31165":72752,"_21590":120727,"_5":14857,"_28357":120485,"_3076":120728},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3624":72850,"_31165":72752,"_21590":120730,"_5":14857,"_28357":120489,"_3076":120731},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3624":72851,"_31165":72752,"_21590":120733,"_5":14857,"_28357":120489,"_3076":120734},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3624":72852,"_31165":72752,"_21590":120736,"_5":14857,"_28357":120489,"_3076":120737},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3624":72853,"_31165":72752,"_21590":120739,"_5":14857,"_28357":120489,"_3076":120740},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3624":72854,"_31165":72752,"_21590":120742,"_5":14857,"_28357":120489,"_3076":120743},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3624":72855,"_31165":72752,"_21590":120745,"_5":14857,"_28357":120489,"_3076":120746},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3624":72856,"_31165":72752,"_21590":120748,"_5":14857,"_28357":120493,"_3076":51458},[],{"_3624":72857,"_31165":72752,"_21590":120750,"_5":14857,"_28357":120493,"_3076":120751},[],"valida las herramientas locales y el clúster seleccionado",{"_3624":72858,"_31165":72752,"_21590":120753,"_5":14857,"_28357":120493,"_3076":120754},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3624":72859,"_31165":72752,"_21590":120756,"_5":14857,"_28357":120493,"_3076":120757},[],"crea el namespace",{"_3624":72860,"_31165":72752,"_21590":120759,"_5":14857,"_28357":120493,"_3076":120760},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3624":72861,"_31165":72752,"_21590":120762,"_5":14857,"_28357":120493,"_3076":120763},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3624":72862,"_31165":72752,"_21590":120765,"_5":14857,"_28357":120493,"_3076":120766},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3624":72863,"_31165":72752,"_21590":120768,"_5":14857,"_28357":120493,"_3076":120769},[],"instala RabbitMQ",{"_3624":72864,"_31165":72752,"_21590":120771,"_5":14857,"_28357":120493,"_3076":120772},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3624":72865,"_31165":72752,"_21590":120774,"_5":14857,"_28357":120493,"_3076":120775},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3624":72866,"_31165":72752,"_21590":120777,"_5":14857,"_28357":120493,"_3076":120778},[],"carga datos de ejemplo opcionalmente",{"_3624":72867,"_31165":72752,"_21590":120780,"_5":14857,"_28357":120493,"_3076":120781},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3624":72868,"_31165":72752,"_21590":120783,"_5":14857,"_28357":120497,"_3076":120784},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3624":72869,"_31165":72752,"_21590":120786,"_5":14857,"_28357":120497,"_3076":120787},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3624":72870,"_31165":72752,"_21590":120789,"_5":14857,"_28357":120501,"_3076":120790},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3624":72871,"_31165":72752,"_21590":120792,"_5":14857,"_28357":120501,"_3076":120793},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3624":72872,"_31165":72752,"_21590":120795,"_5":14857,"_28357":120501,"_3076":120796},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3624":72873,"_31165":72752,"_21590":120798,"_5":14857,"_28357":120501,"_3076":120799},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3624":72874,"_31165":72752,"_21590":120801,"_5":14857,"_28357":120505,"_3076":120802},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3624":72875,"_31165":72875,"_5":15217,"_3076":120804,"_31503":120805,"_21590":120806,"_28357":72875},"Instala con Helm",[50900,120224,120458],[],{"_3624":72876,"_31165":72875,"_21590":120808,"_5":14857,"_28357":72875,"_3076":120809},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3624":72877,"_31165":72875,"_5":31500,"_21590":120811,"_28357":120812,"_3076":120813},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3624":72878,"_31165":72875,"_5":31500,"_21590":120815,"_28357":120816,"_3076":120474},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3624":72879,"_31165":72875,"_5":31500,"_21590":120818,"_28357":120819,"_3076":120820},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3624":72880,"_31165":72875,"_5":31500,"_21590":120822,"_28357":120823,"_3076":120824},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3624":72881,"_31165":72875,"_5":31500,"_21590":120826,"_28357":120827,"_3076":120828},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3624":72882,"_31165":72875,"_5":31500,"_21590":120830,"_28357":120831,"_3076":120832},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3624":72883,"_31165":72875,"_5":31500,"_21590":120834,"_28357":120835,"_3076":120836},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3624":72884,"_31165":72875,"_5":31500,"_21590":120838,"_28357":120839,"_3076":120840},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3624":72885,"_31165":72875,"_5":31500,"_21590":120842,"_28357":120843,"_3076":120844},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3624":72886,"_31165":72875,"_5":31500,"_21590":120846,"_28357":120847,"_3076":120848},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3624":72887,"_31165":72875,"_5":31500,"_21590":120850,"_28357":120851,"_3076":120852},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3624":72888,"_31165":72875,"_5":31500,"_21590":120854,"_28357":120855,"_3076":120856},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3624":72889,"_31165":72875,"_21590":120858,"_5":14857,"_28357":120812,"_3076":120859},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3624":72890,"_31165":72875,"_21590":120861,"_5":14857,"_28357":120816,"_3076":120862},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3624":72891,"_31165":72875,"_21590":120864,"_5":14857,"_28357":120816,"_3076":120865},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3624":72892,"_31165":72875,"_21590":120867,"_5":14857,"_28357":120816,"_3076":120868},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3624":72893,"_31165":72875,"_21590":120870,"_5":14857,"_28357":120816,"_3076":120871},[],"un broker RabbitMQ accesible y sus credenciales",{"_3624":72894,"_31165":72875,"_21590":120873,"_5":14857,"_28357":120816,"_3076":120874},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3624":72895,"_31165":72875,"_21590":120876,"_5":14857,"_28357":120816,"_3076":120877},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3624":72896,"_31165":72875,"_21590":120879,"_5":14857,"_28357":120816,"_3076":120880},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3624":72897,"_31165":72875,"_21590":120882,"_5":14857,"_28357":120816,"_3076":120883},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3624":72898,"_31165":72875,"_21590":120885,"_5":14857,"_28357":120816,"_3076":120886},[],"una StorageClass y un diseño de tráfico externo",{"_3624":72899,"_31165":72875,"_21590":120888,"_5":14857,"_28357":120816,"_3076":120889},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3624":72900,"_31165":72875,"_21590":120891,"_5":14857,"_28357":120816,"_3076":120892},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3624":72901,"_31165":72875,"_21590":120894,"_5":14857,"_28357":120816,"_3076":120895},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3624":72902,"_31165":72875,"_21590":120897,"_5":14857,"_28357":120819,"_3076":120898},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3624":72903,"_31165":72875,"_21590":120900,"_5":14857,"_28357":120819,"_3076":120901},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3624":72904,"_31165":72875,"_21590":120903,"_5":14857,"_28357":120819,"_3076":120904},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3624":72905,"_31165":72875,"_21590":120906,"_5":14857,"_28357":120823,"_3076":120907},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3624":72906,"_31165":72875,"_21590":120909,"_5":14857,"_28357":120823,"_3076":120910},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3624":72907,"_31165":72875,"_21590":120912,"_5":14857,"_28357":120823,"_3076":120913},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3624":72908,"_31165":72875,"_21590":120915,"_5":14857,"_28357":120823,"_3076":120916},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3624":72909,"_31165":72875,"_21590":120918,"_5":14857,"_28357":120827,"_3076":120919},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3624":72910,"_31165":72875,"_21590":120921,"_5":14857,"_28357":120827,"_3076":120922},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3624":72911,"_31165":72875,"_21590":120924,"_5":14857,"_28357":120827,"_3076":120925},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3624":72912,"_31165":72875,"_21590":120927,"_5":14857,"_28357":120827,"_3076":120928},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3624":72913,"_31165":72875,"_21590":120930,"_5":14857,"_28357":120827,"_3076":120931},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3624":72914,"_31165":72875,"_21590":120933,"_5":14857,"_28357":120827,"_3076":120934},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3624":72915,"_31165":72875,"_21590":120936,"_5":14857,"_28357":120827,"_3076":120937},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3624":72916,"_31165":72875,"_21590":120939,"_5":14857,"_28357":120827,"_3076":120940},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3624":72917,"_31165":72875,"_21590":120942,"_5":14857,"_28357":120831,"_3076":120943},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3624":72918,"_31165":72875,"_21590":120945,"_5":14857,"_28357":120835,"_3076":120946},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3624":72919,"_31165":72875,"_21590":120948,"_5":14857,"_28357":120835,"_3076":120949},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3624":72920,"_31165":72875,"_21590":120951,"_5":14857,"_28357":120835,"_3076":120952},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3624":72921,"_31165":72875,"_21590":120954,"_5":14857,"_28357":120835,"_3076":120955},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3624":72922,"_31165":72875,"_21590":120957,"_5":14857,"_28357":120835,"_3076":120958},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3624":72923,"_31165":72875,"_21590":120960,"_5":14857,"_28357":120835,"_3076":120961},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3624":72924,"_31165":72875,"_21590":120963,"_5":14857,"_28357":120835,"_3076":120964},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3624":72925,"_31165":72875,"_21590":120966,"_5":14857,"_28357":120839,"_3076":120967},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3624":72926,"_31165":72875,"_21590":120969,"_5":14857,"_28357":120839,"_3076":120970},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3624":72927,"_31165":72875,"_21590":120972,"_5":14857,"_28357":120839,"_3076":120973},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3624":72928,"_31165":72875,"_21590":120975,"_5":14857,"_28357":120839,"_3076":120976},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3624":72929,"_31165":72875,"_21590":120978,"_5":14857,"_28357":120843,"_3076":120979},[],"Para instalar un checkout local:",{"_3624":72930,"_31165":72875,"_21590":120981,"_5":14857,"_28357":120847,"_3076":120982},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3624":72931,"_31165":72875,"_21590":120984,"_5":14857,"_28357":120847,"_3076":120985},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3624":72932,"_31165":72875,"_21590":120987,"_5":14857,"_28357":120851,"_3076":120988},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3624":72933,"_31165":72875,"_21590":120990,"_5":14857,"_28357":120851,"_3076":120991},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3624":72934,"_31165":72875,"_21590":120993,"_5":14857,"_28357":120851,"_3076":120994},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3624":72935,"_31165":72875,"_21590":120996,"_5":14857,"_28357":120851,"_3076":120997},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3624":72936,"_31165":72875,"_21590":120999,"_5":14857,"_28357":120851,"_3076":121000},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3624":72937,"_31165":72875,"_21590":121002,"_5":14857,"_28357":120855,"_3076":121003},[],"Antes de pasar a producción, revisa:",{"_3624":72938,"_31165":72875,"_21590":121005,"_5":14857,"_28357":120855,"_3076":121006},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3624":72939,"_31165":72875,"_21590":121008,"_5":14857,"_28357":120855,"_3076":121009},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3624":72940,"_31165":72875,"_21590":121011,"_5":14857,"_28357":120855,"_3076":121012},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3624":72941,"_31165":72875,"_21590":121014,"_5":14857,"_28357":120855,"_3076":121015},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3624":72942,"_31165":72875,"_21590":121017,"_5":14857,"_28357":120855,"_3076":121018},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3624":72943,"_31165":72875,"_21590":121020,"_5":14857,"_28357":120855,"_3076":121021},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3624":72944,"_31165":72875,"_21590":121023,"_5":14857,"_28357":120855,"_3076":121024},[],"SMTP, observabilidad y entrega de alertas",{"_3624":72945,"_31165":72875,"_21590":121026,"_5":14857,"_28357":120855,"_3076":121027},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3624":72946,"_31165":72875,"_21590":121029,"_5":14857,"_28357":120855,"_3076":121030},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3624":72947,"_31165":72947,"_5":15217,"_3076":121032,"_31503":121033,"_21590":121034,"_28357":72947},"Expón el Gateway",[50900,120224,120458],[],{"_3624":72948,"_31165":72947,"_21590":121036,"_5":14857,"_28357":72947,"_3076":121037},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3624":72949,"_31165":72947,"_5":31500,"_21590":121039,"_28357":121040,"_3076":121041},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3624":72950,"_31165":72947,"_5":31500,"_21590":121043,"_28357":121044,"_3076":121045},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3624":72951,"_31165":72947,"_5":31500,"_21590":121047,"_28357":121048,"_3076":121049},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3624":72952,"_31165":72947,"_5":31500,"_21590":121051,"_28357":121052,"_3076":51763},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3624":72953,"_31165":72947,"_5":31500,"_21590":121054,"_28357":121055,"_3076":121056},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3624":72954,"_31165":72947,"_5":31500,"_21590":121058,"_28357":121059,"_3076":121060},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3624":72955,"_31165":72947,"_5":31500,"_21590":121062,"_28357":121063,"_3076":121064},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3624":72956,"_31165":72947,"_5":31500,"_21590":121066,"_28357":121067,"_3076":121068},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3624":72957,"_31165":72947,"_5":31500,"_21590":121070,"_28357":121071,"_3076":121072},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3624":72958,"_31165":72947,"_5":31500,"_21590":121074,"_28357":121075,"_3076":121076},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3624":72959,"_31165":72947,"_5":31500,"_21590":121078,"_28357":121079,"_3076":121080},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3624":72960,"_31165":72947,"_21590":121082,"_5":14857,"_28357":121040,"_3076":121083},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3624":72961,"_31165":72947,"_21590":121085,"_5":14857,"_28357":121040,"_3076":121086},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3624":72962,"_31165":72947,"_21590":121088,"_5":14857,"_28357":121044,"_3076":121089},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3624":72963,"_31165":72947,"_21590":121091,"_5":14857,"_28357":121044,"_3076":121092},[],"Defínelo únicamente cuando:",{"_3624":72964,"_31165":72947,"_21590":121094,"_5":14857,"_28357":121044,"_3076":121095},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3624":72965,"_31165":72947,"_21590":121097,"_5":14857,"_28357":121044,"_3076":121098},[],"esa dirección está asignada a este Gateway",{"_3624":72966,"_31165":72947,"_21590":121100,"_5":14857,"_28357":121044,"_3076":121101},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3624":72967,"_31165":72947,"_21590":121103,"_5":14857,"_28357":121044,"_3076":121104},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3624":72968,"_31165":72947,"_21590":121106,"_5":14857,"_28357":121044,"_3076":121107},[],"No confundas estos valores:",{"_3624":72969,"_31165":72947,"_21590":121109,"_5":14857,"_28357":121044,"_3076":121110},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3624":72970,"_31165":72947,"_21590":121112,"_5":14857,"_28357":121044,"_3076":121113},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3624":72971,"_31165":72947,"_21590":121115,"_5":14857,"_28357":121044,"_3076":121116},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3624":72972,"_31165":72947,"_21590":121118,"_5":14857,"_28357":121048,"_3076":121119},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3624":72973,"_31165":72947,"_21590":121121,"_5":14857,"_28357":121048,"_3076":121122},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3624":72974,"_31165":72947,"_21590":121124,"_5":14857,"_28357":121052,"_3076":121125},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3624":72975,"_31165":72947,"_21590":121127,"_5":14857,"_28357":121052,"_3076":121128},[],"Para el diseño recomendado:",{"_3624":72976,"_31165":72947,"_21590":121130,"_5":14857,"_28357":121052,"_3076":121131},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3624":72977,"_31165":72947,"_21590":121133,"_5":14857,"_28357":121052,"_3076":121134},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3624":72978,"_31165":72947,"_21590":121136,"_5":14857,"_28357":121052,"_3076":121137},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3624":72979,"_31165":72947,"_21590":121139,"_5":14857,"_28357":121052,"_3076":121140},[],"Apunta DNS a la dirección accesible de la VM.",{"_3624":72980,"_31165":72947,"_21590":121142,"_5":14857,"_28357":121052,"_3076":121143},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3624":72981,"_31165":72947,"_21590":121145,"_5":14857,"_28357":121055,"_3076":121146},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3624":72982,"_31165":72947,"_21590":121148,"_5":14857,"_28357":121059,"_3076":121149},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3624":72983,"_31165":72947,"_21590":121151,"_5":14857,"_28357":121059,"_3076":121152},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3624":72984,"_31165":72947,"_21590":121154,"_5":14857,"_28357":121063,"_3076":121155},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3624":72985,"_31165":72947,"_21590":121157,"_5":14857,"_28357":121063,"_3076":121158},[],"Requisito",{"_3624":72986,"_31165":72947,"_21590":121160,"_5":14857,"_28357":121063,"_3076":121161},[],"Diseño recomendado",{"_3624":72987,"_31165":72947,"_21590":121163,"_5":14857,"_28357":121063,"_3076":121164},[],"Consecuencia",{"_3624":72988,"_31165":72947,"_21590":121166,"_5":14857,"_28357":121063,"_3076":121167},[],"Varias URL o servicios de Lamassu",{"_3624":72989,"_31165":72947,"_21590":121169,"_5":14857,"_28357":121063,"_3076":121170},[],"Un Gateway con varias rutas",{"_3624":72990,"_31165":72947,"_21590":121172,"_5":14857,"_28357":121063,"_3076":121173},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3624":72991,"_31165":72947,"_21590":121175,"_5":14857,"_28357":121063,"_3076":121176},[],"Gateways independientes e IP externas distintas",{"_3624":72992,"_31165":72947,"_21590":121178,"_5":14857,"_28357":121063,"_3076":121179},[],"Una VIP por Gateway",{"_3624":72993,"_31165":72947,"_21590":121181,"_5":14857,"_28357":121063,"_3076":121182},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3624":72994,"_31165":72947,"_21590":121184,"_5":14857,"_28357":121063,"_3076":121185},[],"Gateways independientes, un nodo y una IP",{"_3624":72995,"_31165":72947,"_21590":121187,"_5":14857,"_28357":121063,"_3076":121188},[],"Puertos externos diferentes",{"_3624":72996,"_31165":72947,"_21590":121190,"_5":14857,"_28357":121063,"_3076":121191},[],"Los clientes deben indicar puertos no estándar",{"_3624":72997,"_31165":72947,"_21590":121193,"_5":14857,"_28357":121063,"_3076":121194},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3624":72998,"_31165":72947,"_21590":121196,"_5":14857,"_28357":121063,"_3076":121197},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3624":72999,"_31165":72947,"_21590":121199,"_5":14857,"_28357":121063,"_3076":121200},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3624":73000,"_31165":72947,"_21590":121202,"_5":14857,"_28357":121063,"_3076":121203},[],"Recursos Gateway separados pero proxy compartido",{"_3624":73001,"_31165":72947,"_21590":121205,"_5":14857,"_28357":121063,"_3076":121206},[],"Modo merged Gateway de Envoy",{"_3624":73002,"_31165":72947,"_21590":121208,"_5":14857,"_28357":121063,"_3076":121209},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3624":73003,"_31165":72947,"_21590":121211,"_5":14857,"_28357":121063,"_3076":121212},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3624":73004,"_31165":72947,"_21590":121214,"_5":14857,"_28357":121063,"_3076":121215},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3624":73005,"_31165":72947,"_21590":121217,"_5":14857,"_28357":121063,"_3076":121218},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3624":73006,"_31165":72947,"_21590":121220,"_5":14857,"_28357":121063,"_3076":121221},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3624":73007,"_31165":72947,"_21590":121223,"_5":14857,"_28357":121067,"_3076":121224},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3624":73008,"_31165":72947,"_21590":121226,"_5":14857,"_28357":121071,"_3076":121227},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3624":73009,"_31165":72947,"_21590":121229,"_5":14857,"_28357":121071,"_3076":121230},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3624":73010,"_31165":72947,"_21590":121232,"_5":14857,"_28357":121071,"_3076":121233},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3624":73011,"_31165":72947,"_21590":121235,"_5":14857,"_28357":121071,"_3076":121236},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3624":73012,"_31165":72947,"_21590":121238,"_5":14857,"_28357":121071,"_3076":121239},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3624":73013,"_31165":72947,"_21590":121241,"_5":14857,"_28357":121075,"_3076":121242},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3624":73014,"_31165":72947,"_21590":121244,"_5":14857,"_28357":121075,"_3076":121245},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3624":73015,"_31165":72947,"_21590":121247,"_5":14857,"_28357":121079,"_3076":121248},[],"Comprueba, en orden:",{"_3624":73016,"_31165":72947,"_21590":121250,"_5":14857,"_28357":121079,"_3076":121251},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3624":73017,"_31165":72947,"_21590":121253,"_5":14857,"_28357":121079,"_3076":121254},[],"Su estado contiene la dirección esperada.",{"_3624":73018,"_31165":72947,"_21590":121256,"_5":14857,"_28357":121079,"_3076":121257},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3624":73019,"_31165":72947,"_21590":121259,"_5":14857,"_28357":121079,"_3076":121260},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3624":73020,"_31165":72947,"_21590":121262,"_5":14857,"_28357":121079,"_3076":121263},[],"DNS resuelve al endpoint accesible externamente.",{"_3624":73021,"_31165":72947,"_21590":121265,"_5":14857,"_28357":121079,"_3076":121266},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3624":73022,"_31165":72947,"_21590":121268,"_5":14857,"_28357":121079,"_3076":121269},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3624":73023,"_31165":73023,"_5":15217,"_3076":51007,"_31503":121271,"_21590":121272,"_28357":73023},[50900,120224,120458],[],{"_3624":73024,"_31165":73023,"_21590":121274,"_5":14857,"_28357":73023,"_3076":121275},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3624":73025,"_31165":73023,"_5":31500,"_21590":121277,"_28357":121278,"_3076":121279},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3624":73026,"_31165":73023,"_5":31500,"_21590":121281,"_28357":121282,"_3076":121283},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3624":73027,"_31165":73023,"_5":31500,"_21590":121285,"_28357":121286,"_3076":121287},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3624":73028,"_31165":73023,"_5":31500,"_21590":121289,"_28357":121290,"_3076":121291},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3624":73029,"_31165":73023,"_5":31500,"_21590":121293,"_28357":121294,"_3076":121295},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3624":73030,"_31165":73023,"_5":31500,"_21590":121297,"_28357":121298,"_3076":121299},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3624":73031,"_31165":73023,"_21590":121301,"_5":14857,"_28357":121278,"_3076":121302},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3624":73032,"_31165":73023,"_21590":121304,"_5":14857,"_28357":121282,"_3076":121305},[],"Flujo",{"_3624":73033,"_31165":73023,"_21590":121307,"_5":14857,"_28357":121282,"_3076":121308},[],"Úsalo para",{"_3624":73034,"_31165":73023,"_21590":121310,"_5":14857,"_28357":121282,"_3076":121311},[],"Qué instala",{"_3624":73035,"_31165":73023,"_21590":121313,"_5":14857,"_28357":121282,"_3076":52025},[],{"_3624":73036,"_31165":73023,"_21590":121315,"_5":14857,"_28357":121282,"_3076":121316},[],"Producción y entornos controlados",{"_3624":73037,"_31165":73023,"_21590":121318,"_5":14857,"_28357":121282,"_3076":121319},[],"Servicios de Lamassu y recursos de Gateway API",{"_3624":73038,"_31165":73023,"_21590":121321,"_5":14857,"_28357":121282,"_3076":51144},[],{"_3624":73039,"_31165":73023,"_21590":121323,"_5":14857,"_28357":121282,"_3076":121324},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3624":73040,"_31165":73023,"_21590":121326,"_5":14857,"_28357":121282,"_3076":121327},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3624":73041,"_31165":73023,"_21590":121329,"_5":14857,"_28357":121286,"_3076":121330},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3624":73042,"_31165":73023,"_21590":121332,"_5":14857,"_28357":121286,"_3076":121333},[],"Área",{"_3624":73043,"_31165":73023,"_21590":121335,"_5":14857,"_28357":121286,"_3076":121336},[],"El chart de Lamassu proporciona",{"_3624":73044,"_31165":73023,"_21590":121338,"_5":14857,"_28357":121286,"_3076":121339},[],"Tú proporcionas",{"_3624":73045,"_31165":73023,"_21590":121341,"_5":14857,"_28357":121286,"_3076":121342},[],"Aplicaciones Lamassu",{"_3624":73046,"_31165":73023,"_21590":121344,"_5":14857,"_28357":121286,"_3076":121345},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3624":73047,"_31165":73023,"_21590":121347,"_5":14857,"_28357":121286,"_3076":121348},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3624":73048,"_31165":73023,"_21590":121350,"_5":14857,"_28357":121286,"_3076":121351},[],"Datos PostgreSQL",{"_3624":73049,"_31165":73023,"_21590":121353,"_5":14857,"_28357":121286,"_3076":121354},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3624":73050,"_31165":73023,"_21590":121356,"_5":14857,"_28357":121286,"_3076":121357},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3624":73051,"_31165":73023,"_21590":121359,"_5":14857,"_28357":121286,"_3076":121360},[],"Mensajería",{"_3624":73052,"_31165":73023,"_21590":121362,"_5":14857,"_28357":121286,"_3076":121363},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3624":73053,"_31165":73023,"_21590":121365,"_5":14857,"_28357":121286,"_3076":121366},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3624":73054,"_31165":73023,"_21590":121368,"_5":14857,"_28357":121286,"_3076":121369},[],"Identidad",{"_3624":73055,"_31165":73023,"_21590":121371,"_5":14857,"_28357":121286,"_3076":121372},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3624":73056,"_31165":73023,"_21590":121374,"_5":14857,"_28357":121286,"_3076":121375},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3624":73057,"_31165":73023,"_21590":121377,"_5":14857,"_28357":121286,"_3076":121378},[],"Enrutamiento externo",{"_3624":73058,"_31165":73023,"_21590":121380,"_5":14857,"_28357":121286,"_3076":121381},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3624":73059,"_31165":73023,"_21590":121383,"_5":14857,"_28357":121286,"_3076":121384},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3624":73060,"_31165":73023,"_21590":121386,"_5":14857,"_28357":121286,"_3076":52099},[],{"_3624":73061,"_31165":73023,"_21590":121388,"_5":14857,"_28357":121286,"_3076":121389},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3624":73062,"_31165":73023,"_21590":121391,"_5":14857,"_28357":121286,"_3076":121392},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3624":73063,"_31165":73023,"_21590":121394,"_5":14857,"_28357":121286,"_3076":121395},[],"Datos persistentes de la aplicación",{"_3624":73064,"_31165":73023,"_21590":121397,"_5":14857,"_28357":121286,"_3076":121398},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3624":73065,"_31165":73023,"_21590":121400,"_5":14857,"_28357":121286,"_3076":121401},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3624":73066,"_31165":73023,"_21590":121403,"_5":14857,"_28357":121286,"_3076":121404},[],"Integraciones opcionales",{"_3624":73067,"_31165":73023,"_21590":121406,"_5":14857,"_28357":121286,"_3076":121407},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3624":73068,"_31165":73023,"_21590":121409,"_5":14857,"_28357":121286,"_3076":121410},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3624":73069,"_31165":73023,"_21590":121412,"_5":14857,"_28357":121286,"_3076":121413},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3624":73070,"_31165":73023,"_21590":121415,"_5":14857,"_28357":121286,"_3076":121416},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3624":73071,"_31165":73023,"_21590":121418,"_5":14857,"_28357":121290,"_3076":121419},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3624":73072,"_31165":73023,"_21590":121421,"_5":14857,"_28357":121290,"_3076":121422},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3624":73073,"_31165":73023,"_21590":121424,"_5":14857,"_28357":121294,"_3076":121425},[],"Kubernetes 1.24 o posterior",{"_3624":73074,"_31165":73023,"_21590":121427,"_5":14857,"_28357":121294,"_3076":121428},[],"Helm 3.2 o posterior",{"_3624":73075,"_31165":73023,"_21590":121430,"_5":14857,"_28357":121294,"_3076":121431},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3624":73076,"_31165":73023,"_21590":121433,"_5":14857,"_28357":121294,"_3076":121434},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3624":73077,"_31165":73023,"_21590":121436,"_5":14857,"_28357":121294,"_3076":121437},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3624":73078,"_31165":73023,"_21590":121439,"_5":14857,"_28357":121294,"_3076":121440},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3624":73079,"_31165":73023,"_21590":121442,"_5":14857,"_28357":121294,"_3076":121443},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3624":73080,"_31165":73023,"_21590":121445,"_5":14857,"_28357":121298,"_3076":121446},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3624":73081,"_31165":73023,"_21590":121448,"_5":14857,"_28357":121298,"_3076":121449},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3624":73082,"_31165":73023,"_21590":121451,"_5":14857,"_28357":121298,"_3076":121452},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3624":73083,"_31165":73023,"_21590":121454,"_5":14857,"_28357":121298,"_3076":121455},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3624":73084,"_31165":73084,"_5":15217,"_3076":121457,"_31503":121458,"_21590":121460,"_28357":73084},"Resolución de problemas de despliegue",[50900,120224,121459],"Operación",[],{"_3624":73085,"_31165":73084,"_21590":121462,"_5":14857,"_28357":73084,"_3076":121463},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3624":73086,"_31165":73084,"_5":31500,"_21590":121465,"_28357":121466,"_3076":121467},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3624":73087,"_31165":73084,"_5":31500,"_21590":121469,"_28357":121470,"_3076":121471},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3624":73088,"_31165":73084,"_5":31500,"_21590":121473,"_28357":121474,"_3076":121475},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3624":73089,"_31165":73084,"_5":31500,"_21590":121477,"_28357":121478,"_3076":121479},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3624":73090,"_31165":73084,"_5":31500,"_21590":121481,"_28357":121482,"_3076":121483},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3624":73091,"_31165":73084,"_5":31500,"_21590":121485,"_28357":121486,"_3076":121487},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3624":73092,"_31165":73084,"_5":31500,"_21590":121489,"_28357":121490,"_3076":121491},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3624":73093,"_31165":73084,"_5":31500,"_21590":121493,"_28357":121494,"_3076":121495},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3624":73094,"_31165":73084,"_5":31500,"_21590":121497,"_28357":121498,"_3076":121499},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3624":73095,"_31165":73084,"_5":31500,"_21590":121501,"_28357":121502,"_3076":121503},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3624":73096,"_31165":73084,"_5":31500,"_21590":121505,"_28357":121506,"_3076":121507},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3624":73097,"_31165":73084,"_5":31500,"_21590":121509,"_28357":121510,"_3076":121511},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3624":73098,"_31165":73084,"_5":31500,"_21590":121513,"_28357":121514,"_3076":121515},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3624":73099,"_31165":73084,"_21590":121517,"_5":14857,"_28357":73084,"_3076":121518},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3624":73100,"_31165":73084,"_21590":121520,"_5":14857,"_28357":121470,"_3076":121521},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3624":73101,"_31165":73084,"_21590":121523,"_5":14857,"_28357":121474,"_3076":121524},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3624":73102,"_31165":73084,"_21590":121526,"_5":14857,"_28357":121478,"_3076":121527},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3624":73103,"_31165":73084,"_21590":121529,"_5":14857,"_28357":121482,"_3076":121530},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3624":73104,"_31165":73084,"_21590":121532,"_5":14857,"_28357":121486,"_3076":121533},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3624":73105,"_31165":73084,"_21590":121535,"_5":14857,"_28357":121490,"_3076":121536},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3624":73106,"_31165":73084,"_21590":121538,"_5":14857,"_28357":121490,"_3076":121539},[],"Ejecuta también la prueba de conectividad del chart:",{"_3624":73107,"_31165":73084,"_21590":121541,"_5":14857,"_28357":121490,"_3076":121542},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3624":73108,"_31165":73084,"_21590":121544,"_5":14857,"_28357":121490,"_3076":121545},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3624":73109,"_31165":73084,"_21590":121547,"_5":14857,"_28357":121494,"_3076":121548},[],"Si recibes un 401:",{"_3624":73110,"_31165":73084,"_21590":121550,"_5":14857,"_28357":121494,"_3076":121551},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3624":73111,"_31165":73084,"_21590":121553,"_5":14857,"_28357":121494,"_3076":121554},[],"verifica emisor, audiencia y expiración del token;",{"_3624":73112,"_31165":73084,"_21590":121556,"_5":14857,"_28357":121494,"_3076":121557},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3624":73113,"_31165":73084,"_21590":121559,"_5":14857,"_28357":121494,"_3076":121560},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3624":73114,"_31165":73084,"_21590":121562,"_5":14857,"_28357":121494,"_3076":121563},[],"Si el login termina pero las APIs devuelven 403:",{"_3624":73115,"_31165":73084,"_21590":121565,"_5":14857,"_28357":121494,"_3076":121566},[],"inspecciona los claims reales del token;",{"_3624":73116,"_31165":73084,"_21590":121568,"_5":14857,"_28357":121494,"_3076":121569},[],"confirma que coinciden con un principal activo;",{"_3624":73117,"_31165":73084,"_21590":121571,"_5":14857,"_28357":121494,"_3076":121572},[],"revisa las políticas concedidas al principal;",{"_3624":73118,"_31165":73084,"_21590":121574,"_5":14857,"_28357":121494,"_3076":121575},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3624":73119,"_31165":73084,"_21590":121577,"_5":14857,"_28357":121494,"_3076":121578},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3624":73120,"_31165":73084,"_21590":121580,"_5":14857,"_28357":121498,"_3076":121581},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3624":73121,"_31165":73084,"_21590":121583,"_5":14857,"_28357":121498,"_3076":121584},[],"Localiza el pod y Service de authz.",{"_3624":73122,"_31165":73084,"_21590":121586,"_5":14857,"_28357":121498,"_3076":121587},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3624":73123,"_31165":73084,"_21590":121589,"_5":14857,"_28357":121498,"_3076":121590},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3624":73124,"_31165":73084,"_21590":121592,"_5":14857,"_28357":121498,"_3076":121593},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3624":73125,"_31165":73084,"_21590":121595,"_5":14857,"_28357":121498,"_3076":121596},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3624":73126,"_31165":73084,"_21590":121598,"_5":14857,"_28357":121502,"_3076":121599},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3624":73127,"_31165":73084,"_21590":121601,"_5":14857,"_28357":121506,"_3076":121602},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3624":73128,"_31165":73084,"_21590":121604,"_5":14857,"_28357":121506,"_3076":121605},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3624":73129,"_31165":73084,"_21590":121607,"_5":14857,"_28357":121506,"_3076":121608},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3624":73130,"_31165":73084,"_21590":121610,"_5":14857,"_28357":121506,"_3076":121611},[],"volumen persistente sin enlazar;",{"_3624":73131,"_31165":73084,"_21590":121613,"_5":14857,"_28357":121506,"_3076":121614},[],"imagen inaccesible o política de pull incorrecta;",{"_3624":73132,"_31165":73084,"_21590":121616,"_5":14857,"_28357":121506,"_3076":121617},[],"configuración inválida del motor criptográfico;",{"_3624":73133,"_31165":73084,"_21590":121619,"_5":14857,"_28357":121506,"_3076":121620},[],"límites de CPU o memoria demasiado bajos;",{"_3624":73134,"_31165":73084,"_21590":121622,"_5":14857,"_28357":121506,"_3076":121623},[],"migración previa incompleta.",{"_3624":73135,"_31165":73084,"_21590":121625,"_5":14857,"_28357":121506,"_3076":121626},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3624":73136,"_31165":73084,"_21590":121628,"_5":14857,"_28357":121506,"_3076":121629},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3624":73137,"_31165":73084,"_21590":121631,"_5":14857,"_28357":121506,"_3076":121632},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3624":73138,"_31165":73084,"_21590":121634,"_5":14857,"_28357":121510,"_3076":121635},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3624":73139,"_31165":73084,"_21590":121637,"_5":14857,"_28357":121510,"_3076":121638},[],"verifica que esté habilitado en el servicio emisor;",{"_3624":73140,"_31165":73084,"_21590":121640,"_5":14857,"_28357":121510,"_3076":121641},[],"comprueba conectividad y credenciales AMQP;",{"_3624":73141,"_31165":73084,"_21590":121643,"_5":14857,"_28357":121510,"_3076":121644},[],"revisa exchange, routing key, colas y consumidores;",{"_3624":73142,"_31165":73084,"_21590":121646,"_5":14857,"_28357":121510,"_3076":121647},[],"inspecciona dead-letter queues;",{"_3624":73143,"_31165":73084,"_21590":121649,"_5":14857,"_28357":121510,"_3076":121650},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3624":73144,"_31165":73084,"_21590":121652,"_5":14857,"_28357":121510,"_3076":121653},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3624":73145,"_31165":73084,"_21590":121655,"_5":14857,"_28357":121510,"_3076":121656},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3624":73146,"_31165":73084,"_21590":121658,"_5":14857,"_28357":121510,"_3076":121659},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3624":73147,"_31165":73084,"_21590":121661,"_5":14857,"_28357":121510,"_3076":121662},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3624":73148,"_31165":73084,"_21590":121664,"_5":14857,"_28357":121510,"_3076":121665},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3624":73149,"_31165":73084,"_21590":121667,"_5":14857,"_28357":121510,"_3076":121668},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3624":73150,"_31165":73084,"_21590":121670,"_5":14857,"_28357":121510,"_3076":121671},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3624":73151,"_31165":73084,"_21590":121673,"_5":14857,"_28357":121514,"_3076":121674},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3624":73152,"_31165":73084,"_21590":121676,"_5":14857,"_28357":121514,"_3076":121677},[],"Antes de cerrar una incidencia, guarda:",{"_3624":73153,"_31165":73084,"_21590":121679,"_5":14857,"_28357":121514,"_3076":121680},[],"causa confirmada;",{"_3624":73154,"_31165":73084,"_21590":121682,"_5":14857,"_28357":121514,"_3076":121683},[],"alcance temporal y recursos afectados;",{"_3624":73155,"_31165":73084,"_21590":121685,"_5":14857,"_28357":121514,"_3076":121686},[],"comandos o consultas utilizados;",{"_3624":73156,"_31165":73084,"_21590":121688,"_5":14857,"_28357":121514,"_3076":121689},[],"cambio aplicado y forma de revertirlo;",{"_3624":73157,"_31165":73084,"_21590":121691,"_5":14857,"_28357":121514,"_3076":121692},[],"validación desde un consumidor;",{"_3624":73158,"_31165":73084,"_21590":121694,"_5":14857,"_28357":121514,"_3076":121695},[],"acción preventiva y propietario.",{"_3624":73159,"_31165":73159,"_5":15217,"_3076":121697,"_31503":121698,"_21590":121702,"_28357":73159},"Modelo de datos",[50900,121699,121700,121701],"Plataforma","Administración","Control de acceso",[],{"_3624":73160,"_31165":73159,"_21590":121704,"_5":14857,"_28357":73159,"_3076":121705},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3624":73161,"_31165":73159,"_5":31500,"_21590":121707,"_28357":121708,"_3076":121709},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3624":73162,"_31165":73159,"_5":31500,"_21590":121711,"_28357":121712,"_3076":121713},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3624":73163,"_31165":73159,"_21590":121715,"_5":14857,"_28357":73159,"_3076":121716},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3624":73164,"_31165":73159,"_21590":121718,"_5":14857,"_28357":121708,"_3076":121719},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3624":73165,"_31165":73159,"_21590":121721,"_5":14857,"_28357":121708,"_3076":121722},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3624":73166,"_31165":73159,"_21590":121724,"_5":14857,"_28357":121708,"_3076":121725},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3624":73167,"_31165":73159,"_21590":121727,"_5":14857,"_28357":121712,"_3076":121728},[],"Entidad (`schema_name.entity_type`)",{"_3624":73168,"_31165":73159,"_21590":121730,"_5":14857,"_28357":121712,"_3076":121731},[],"Tabla (`table_name`)",{"_3624":73169,"_31165":73159,"_21590":121733,"_5":14857,"_28357":121712,"_3076":121734},[],"Clave (`primary_key`)",{"_3624":73170,"_31165":73159,"_21590":121736,"_5":14857,"_28357":121712,"_3076":52450},[],{"_3624":73171,"_31165":73159,"_21590":121738,"_5":14857,"_28357":121712,"_3076":52453},[],{"_3624":73172,"_31165":73159,"_21590":121740,"_5":14857,"_28357":121712,"_3076":52456},[],{"_3624":73173,"_31165":73159,"_21590":121742,"_5":14857,"_28357":121712,"_3076":52459},[],{"_3624":73174,"_31165":73159,"_21590":121744,"_5":14857,"_28357":121712,"_3076":52462},[],{"_3624":73175,"_31165":73159,"_21590":121746,"_5":14857,"_28357":121712,"_3076":52465},[],{"_3624":73176,"_31165":73159,"_21590":121748,"_5":14857,"_28357":121712,"_3076":52468},[],{"_3624":73177,"_31165":73159,"_21590":121750,"_5":14857,"_28357":121712,"_3076":52471},[],{"_3624":73178,"_31165":73159,"_21590":121752,"_5":14857,"_28357":121712,"_3076":52465},[],{"_3624":73179,"_31165":73159,"_21590":121754,"_5":14857,"_28357":121712,"_3076":52476},[],{"_3624":73180,"_31165":73159,"_21590":121756,"_5":14857,"_28357":121712,"_3076":52479},[],{"_3624":73181,"_31165":73159,"_21590":121758,"_5":14857,"_28357":121712,"_3076":52482},[],{"_3624":73182,"_31165":73159,"_21590":121760,"_5":14857,"_28357":121712,"_3076":52485},[],{"_3624":73183,"_31165":73159,"_21590":121762,"_5":14857,"_28357":121712,"_3076":52488},[],{"_3624":73184,"_31165":73159,"_21590":121764,"_5":14857,"_28357":121712,"_3076":52465},[],{"_3624":73185,"_31165":73159,"_21590":121766,"_5":14857,"_28357":121712,"_3076":52493},[],{"_3624":73186,"_31165":73159,"_21590":121768,"_5":14857,"_28357":121712,"_3076":52496},[],{"_3624":73187,"_31165":73159,"_21590":121770,"_5":14857,"_28357":121712,"_3076":52465},[],{"_3624":73188,"_31165":73159,"_21590":121772,"_5":14857,"_28357":121712,"_3076":52501},[],{"_3624":73189,"_31165":73159,"_21590":121774,"_5":14857,"_28357":121712,"_3076":52504},[],{"_3624":73190,"_31165":73159,"_21590":121776,"_5":14857,"_28357":121712,"_3076":52465},[],{"_3624":73191,"_31165":73159,"_21590":121778,"_5":14857,"_28357":121712,"_3076":52509},[],{"_3624":73192,"_31165":73159,"_21590":121780,"_5":14857,"_28357":121712,"_3076":52512},[],{"_3624":73193,"_31165":73159,"_21590":121782,"_5":14857,"_28357":121712,"_3076":52465},[],{"_3624":73194,"_31165":73159,"_21590":121784,"_5":14857,"_28357":121712,"_3076":52517},[],{"_3624":73195,"_31165":73159,"_21590":121786,"_5":14857,"_28357":121712,"_3076":52520},[],{"_3624":73196,"_31165":73159,"_21590":121788,"_5":14857,"_28357":121712,"_3076":52523},[],{"_3624":73197,"_31165":73159,"_21590":121790,"_5":14857,"_28357":121712,"_3076":52526},[],{"_3624":73198,"_31165":73159,"_21590":121792,"_5":14857,"_28357":121712,"_3076":52529},[],{"_3624":73199,"_31165":73159,"_21590":121794,"_5":14857,"_28357":121712,"_3076":52532},[],{"_3624":73200,"_31165":73159,"_21590":121796,"_5":14857,"_28357":121712,"_3076":121797},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3624":73201,"_31165":73159,"_21590":121799,"_5":14857,"_28357":121712,"_3076":121800},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3624":73202,"_31165":73159,"_21590":121802,"_5":14857,"_28357":121712,"_3076":121803},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3624":73203,"_31165":73203,"_5":15217,"_3076":121805,"_31503":121806,"_21590":121807,"_28357":73203},"Visión general del control de acceso",[50900,121699,121700,121701],[],{"_3624":73204,"_31165":73203,"_21590":121809,"_5":14857,"_28357":73203,"_3076":121810},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3624":73205,"_31165":73203,"_5":31500,"_21590":121812,"_28357":121813,"_3076":121814},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3624":73206,"_31165":73203,"_5":31500,"_21590":121816,"_28357":121817,"_3076":121818},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3624":73207,"_31165":73203,"_5":31500,"_21590":121820,"_28357":121821,"_3076":121822},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3624":73208,"_31165":73203,"_5":31500,"_21590":121824,"_28357":121825,"_3076":121826},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3624":73209,"_31165":73203,"_5":31500,"_21590":121828,"_28357":121829,"_3076":121830},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3624":73210,"_31165":73203,"_5":31500,"_21590":121832,"_28357":121833,"_3076":121834},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3624":73211,"_31165":73203,"_5":31500,"_21590":121836,"_28357":121837,"_3076":121838},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3624":73212,"_31165":73203,"_5":31500,"_21590":121840,"_28357":121841,"_3076":121842},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3624":73213,"_31165":73203,"_5":31500,"_21590":121844,"_28357":121845,"_3076":121846},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3624":73214,"_31165":73203,"_5":31500,"_21590":121848,"_28357":121849,"_3076":121850},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3624":73215,"_31165":73203,"_5":31500,"_21590":121852,"_28357":121853,"_3076":121854},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3624":73216,"_31165":73203,"_5":31500,"_21590":121856,"_28357":121857,"_3076":121858},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3624":73217,"_31165":73203,"_5":31500,"_21590":121860,"_28357":121861,"_3076":121862},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3624":73218,"_31165":73203,"_5":31500,"_21590":121864,"_28357":121865,"_3076":121866},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3624":73219,"_31165":73203,"_5":31500,"_21590":121868,"_28357":121869,"_3076":121870},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3624":73220,"_31165":73203,"_5":31500,"_21590":121872,"_28357":121873,"_3076":120840},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3624":73221,"_31165":73203,"_5":31500,"_21590":121875,"_28357":121876,"_3076":121877},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3624":73222,"_31165":73203,"_5":31500,"_21590":121879,"_28357":121880,"_3076":121881},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3624":73223,"_31165":73203,"_5":31500,"_21590":121883,"_28357":121884,"_3076":121885},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3624":73224,"_31165":73203,"_5":31500,"_21590":121887,"_28357":121888,"_3076":121889},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3624":73225,"_31165":73203,"_5":31500,"_21590":121891,"_28357":121892,"_3076":121893},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3624":73226,"_31165":73203,"_5":31500,"_21590":121895,"_28357":121896,"_3076":121897},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3624":73227,"_31165":73203,"_5":31500,"_21590":121899,"_28357":121900,"_3076":121901},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3624":73228,"_31165":73203,"_5":31500,"_21590":121903,"_28357":121904,"_3076":121905},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3624":73229,"_31165":73203,"_5":31500,"_21590":121907,"_28357":121908,"_3076":121909},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3624":73230,"_31165":73203,"_5":31500,"_21590":121911,"_28357":121912,"_3076":121913},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3624":73231,"_31165":73203,"_5":31500,"_21590":121915,"_28357":121916,"_3076":121917},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3624":73232,"_31165":73203,"_5":31500,"_21590":121919,"_28357":121920,"_3076":121921},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3624":73233,"_31165":73203,"_5":31500,"_21590":121923,"_28357":121924,"_3076":121925},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3624":73234,"_31165":73203,"_5":31500,"_21590":121927,"_28357":121928,"_3076":121929},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3624":73235,"_31165":73203,"_5":31500,"_21590":121931,"_28357":121932,"_3076":121933},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3624":73236,"_31165":73203,"_21590":121935,"_5":14857,"_28357":73203,"_3076":121936},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3624":73237,"_31165":73203,"_21590":121938,"_5":14857,"_28357":73203,"_3076":121939},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3624":73238,"_31165":73203,"_21590":121941,"_5":14857,"_28357":73203,"_3076":121942},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3624":73239,"_31165":73203,"_21590":121944,"_5":14857,"_28357":121813,"_3076":121945},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3624":73240,"_31165":73203,"_21590":121947,"_5":14857,"_28357":121813,"_3076":121948},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3624":73241,"_31165":73203,"_21590":121950,"_5":14857,"_28357":121813,"_3076":121951},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3624":73242,"_31165":73203,"_21590":121953,"_5":14857,"_28357":121813,"_3076":121954},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3624":73243,"_31165":73203,"_21590":121956,"_5":14857,"_28357":121813,"_3076":121957},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3624":73244,"_31165":73203,"_21590":121959,"_5":14857,"_28357":121813,"_3076":121960},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3624":73245,"_31165":73203,"_21590":121962,"_5":14857,"_28357":121817,"_3076":121963},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3624":73246,"_31165":73203,"_21590":121965,"_5":14857,"_28357":121817,"_3076":121966},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3624":73247,"_31165":73203,"_21590":121968,"_5":14857,"_28357":121821,"_3076":121969},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3624":73248,"_31165":73203,"_21590":121971,"_5":14857,"_28357":121821,"_3076":121972},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3624":73249,"_31165":73203,"_21590":121974,"_5":14857,"_28357":121821,"_3076":121975},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3624":73250,"_31165":73203,"_21590":121977,"_5":14857,"_28357":121821,"_3076":121978},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3624":73251,"_31165":73203,"_21590":121980,"_5":14857,"_28357":121821,"_3076":121981},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3624":73252,"_31165":73203,"_21590":121983,"_5":14857,"_28357":121821,"_3076":121984},[],"Carga por separado las políticas concedidas a cada principal.",{"_3624":73253,"_31165":73203,"_21590":121986,"_5":14857,"_28357":121821,"_3076":121987},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3624":73254,"_31165":73203,"_21590":121989,"_5":14857,"_28357":121821,"_3076":121990},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3624":73255,"_31165":73203,"_21590":121992,"_5":14857,"_28357":121821,"_3076":121993},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3624":73256,"_31165":73203,"_21590":121995,"_5":14857,"_28357":121821,"_3076":121996},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3624":73257,"_31165":73203,"_21590":121998,"_5":14857,"_28357":121821,"_3076":121999},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3624":73258,"_31165":73203,"_21590":122001,"_5":14857,"_28357":121821,"_3076":122002},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3624":73259,"_31165":73203,"_21590":122004,"_5":14857,"_28357":121825,"_3076":122005},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3624":73260,"_31165":73203,"_21590":122007,"_5":14857,"_28357":121825,"_3076":122008},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3624":73261,"_31165":73203,"_21590":122010,"_5":14857,"_28357":121825,"_3076":122011},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3624":73262,"_31165":73203,"_21590":122013,"_5":14857,"_28357":121825,"_3076":122014},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3624":73263,"_31165":73203,"_21590":122016,"_5":14857,"_28357":121825,"_3076":122017},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3624":73264,"_31165":73203,"_21590":122019,"_5":14857,"_28357":121825,"_3076":122020},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3624":73265,"_31165":73203,"_21590":122022,"_5":14857,"_28357":121825,"_3076":122023},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3624":73266,"_31165":73203,"_21590":122025,"_5":14857,"_28357":121825,"_3076":122026},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3624":73267,"_31165":73203,"_21590":122028,"_5":14857,"_28357":121825,"_3076":122029},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3624":73268,"_31165":73203,"_21590":122031,"_5":14857,"_28357":121825,"_3076":122032},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3624":73269,"_31165":73203,"_21590":122034,"_5":14857,"_28357":121829,"_3076":122035},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3624":73270,"_31165":73203,"_21590":122037,"_5":14857,"_28357":121829,"_3076":122038},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3624":73271,"_31165":73203,"_21590":122040,"_5":14857,"_28357":121829,"_3076":122041},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3624":73272,"_31165":73203,"_21590":122043,"_5":14857,"_28357":121829,"_3076":122044},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3624":73273,"_31165":73203,"_21590":122046,"_5":14857,"_28357":121829,"_3076":122047},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3624":73274,"_31165":73203,"_21590":122049,"_5":14857,"_28357":121829,"_3076":122050},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3624":73275,"_31165":73203,"_21590":122052,"_5":14857,"_28357":121829,"_3076":122053},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3624":73276,"_31165":73203,"_21590":122055,"_5":14857,"_28357":121829,"_3076":122056},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3624":73277,"_31165":73203,"_21590":122058,"_5":14857,"_28357":121829,"_3076":122059},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3624":73278,"_31165":73203,"_21590":122061,"_5":14857,"_28357":121829,"_3076":122062},[],"Las acciones se dividen en dos grupos:",{"_3624":73279,"_31165":73203,"_21590":122064,"_5":14857,"_28357":121829,"_3076":122065},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3624":73280,"_31165":73203,"_21590":122067,"_5":14857,"_28357":121829,"_3076":122068},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3624":73281,"_31165":73203,"_21590":122070,"_5":14857,"_28357":121829,"_3076":122071},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3624":73282,"_31165":73203,"_21590":122073,"_5":14857,"_28357":121833,"_3076":122074},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3624":73283,"_31165":73203,"_21590":122076,"_5":14857,"_28357":121833,"_3076":122077},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3624":73284,"_31165":73203,"_21590":122079,"_5":14857,"_28357":121833,"_3076":122080},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3624":73285,"_31165":73203,"_21590":122082,"_5":14857,"_28357":121837,"_3076":122083},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3624":73286,"_31165":73203,"_21590":122085,"_5":14857,"_28357":121837,"_3076":122086},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3624":73287,"_31165":73203,"_21590":122088,"_5":14857,"_28357":121837,"_3076":122089},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3624":73288,"_31165":73203,"_21590":122091,"_5":14857,"_28357":121837,"_3076":122092},[],"Los operadores implementados son:",{"_3624":73289,"_31165":73203,"_21590":122094,"_5":14857,"_28357":121837,"_3076":122095},[],"`equals`, para igualdad exacta;",{"_3624":73290,"_31165":73203,"_21590":122097,"_5":14857,"_28357":121837,"_3076":122098},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3624":73291,"_31165":73203,"_21590":122100,"_5":14857,"_28357":121837,"_3076":122101},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3624":73292,"_31165":73203,"_21590":122103,"_5":14857,"_28357":121837,"_3076":122104},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3624":73293,"_31165":73203,"_21590":122106,"_5":14857,"_28357":121841,"_3076":122107},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3624":73294,"_31165":73203,"_21590":122109,"_5":14857,"_28357":121841,"_3076":122110},[],"Los modos disponibles son:",{"_3624":73295,"_31165":73203,"_21590":122112,"_5":14857,"_28357":121841,"_3076":122113},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3624":73296,"_31165":73203,"_21590":122115,"_5":14857,"_28357":121841,"_3076":122116},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3624":73297,"_31165":73203,"_21590":122118,"_5":14857,"_28357":121841,"_3076":122119},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3624":73298,"_31165":73203,"_21590":122121,"_5":14857,"_28357":121841,"_3076":122122},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3624":73299,"_31165":73203,"_21590":122124,"_5":14857,"_28357":121841,"_3076":122125},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3624":73300,"_31165":73203,"_21590":122127,"_5":14857,"_28357":121841,"_3076":122128},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3624":73301,"_31165":73203,"_21590":122130,"_5":14857,"_28357":121845,"_3076":122131},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3624":73302,"_31165":73203,"_21590":122133,"_5":14857,"_28357":121845,"_3076":122134},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3624":73303,"_31165":73203,"_21590":122136,"_5":14857,"_28357":121845,"_3076":122137},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3624":73304,"_31165":73203,"_21590":122139,"_5":14857,"_28357":121845,"_3076":122140},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3624":73305,"_31165":73203,"_21590":122142,"_5":14857,"_28357":121853,"_3076":122143},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3624":73306,"_31165":73203,"_21590":122145,"_5":14857,"_28357":121853,"_3076":122146},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3624":73307,"_31165":73203,"_21590":122148,"_5":14857,"_28357":121857,"_3076":122149},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3624":73308,"_31165":73203,"_21590":122151,"_5":14857,"_28357":121857,"_3076":122152},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3624":73309,"_31165":73203,"_21590":122154,"_5":14857,"_28357":121857,"_3076":122155},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3624":73310,"_31165":73203,"_21590":122157,"_5":14857,"_28357":121857,"_3076":122158},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3624":73311,"_31165":73203,"_21590":122160,"_5":14857,"_28357":121857,"_3076":122161},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3624":73312,"_31165":73203,"_21590":122163,"_5":14857,"_28357":121861,"_3076":122164},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3624":73313,"_31165":73203,"_21590":122166,"_5":14857,"_28357":121861,"_3076":122167},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3624":73314,"_31165":73203,"_21590":122169,"_5":14857,"_28357":121861,"_3076":122170},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3624":73315,"_31165":73203,"_21590":122172,"_5":14857,"_28357":121865,"_3076":122173},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3624":73316,"_31165":73203,"_21590":122175,"_5":14857,"_28357":121865,"_3076":122176},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3624":73317,"_31165":73203,"_21590":122178,"_5":14857,"_28357":121865,"_3076":122179},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3624":73318,"_31165":73203,"_21590":122181,"_5":14857,"_28357":121865,"_3076":122182},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3624":73319,"_31165":73203,"_21590":122184,"_5":14857,"_28357":121865,"_3076":122185},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3624":73320,"_31165":73203,"_21590":122187,"_5":14857,"_28357":121865,"_3076":122188},[],"Ten en cuenta que:",{"_3624":73321,"_31165":73203,"_21590":122190,"_5":14857,"_28357":121865,"_3076":122191},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3624":73322,"_31165":73203,"_21590":122193,"_5":14857,"_28357":121865,"_3076":122194},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3624":73323,"_31165":73203,"_21590":122196,"_5":14857,"_28357":121865,"_3076":122197},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3624":73324,"_31165":73203,"_21590":122199,"_5":14857,"_28357":121869,"_3076":122200},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3624":73325,"_31165":73203,"_21590":122202,"_5":14857,"_28357":121869,"_3076":122203},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3624":73326,"_31165":73203,"_21590":122205,"_5":14857,"_28357":121869,"_3076":122206},[],"acceso completo y de solo lectura a KMS;",{"_3624":73327,"_31165":73203,"_21590":122208,"_5":14857,"_28357":121869,"_3076":122209},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3624":73328,"_31165":73203,"_21590":122211,"_5":14857,"_28357":121869,"_3076":122212},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3624":73329,"_31165":73203,"_21590":122214,"_5":14857,"_28357":121869,"_3076":122215},[],"acceso a la interfaz;",{"_3624":73330,"_31165":73203,"_21590":122217,"_5":14857,"_28357":121869,"_3076":122218},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3624":73331,"_31165":73203,"_21590":122220,"_5":14857,"_28357":121869,"_3076":122221},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3624":73332,"_31165":73203,"_21590":122223,"_5":14857,"_28357":121869,"_3076":122224},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3624":73333,"_31165":73203,"_21590":122226,"_5":14857,"_28357":121869,"_3076":122227},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3624":73334,"_31165":73203,"_21590":122229,"_5":14857,"_28357":121869,"_3076":122230},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3624":73335,"_31165":73203,"_21590":122232,"_5":14857,"_28357":121873,"_3076":122233},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3624":73336,"_31165":73203,"_21590":122235,"_5":14857,"_28357":121873,"_3076":122236},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3624":73337,"_31165":73203,"_21590":122238,"_5":14857,"_28357":121873,"_3076":122239},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3624":73338,"_31165":73203,"_21590":122241,"_5":14857,"_28357":121876,"_3076":122242},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3624":73339,"_31165":73203,"_21590":122244,"_5":14857,"_28357":121880,"_3076":122245},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3624":73340,"_31165":73203,"_21590":122247,"_5":14857,"_28357":121880,"_3076":122248},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3624":73341,"_31165":73203,"_21590":122250,"_5":14857,"_28357":121884,"_3076":122251},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3624":73342,"_31165":73203,"_21590":122253,"_5":14857,"_28357":121888,"_3076":122254},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3624":73343,"_31165":73203,"_21590":122256,"_5":14857,"_28357":121892,"_3076":122257},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3624":73344,"_31165":73203,"_21590":122259,"_5":14857,"_28357":121896,"_3076":122260},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3624":73345,"_31165":73203,"_21590":122262,"_5":14857,"_28357":121896,"_3076":122263},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3624":73346,"_31165":73203,"_21590":122265,"_5":14857,"_28357":121900,"_3076":122266},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3624":73347,"_31165":73203,"_21590":122268,"_5":14857,"_28357":121900,"_3076":122269},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3624":73348,"_31165":73203,"_21590":122271,"_5":14857,"_28357":121900,"_3076":122272},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3624":73349,"_31165":73203,"_21590":122274,"_5":14857,"_28357":121900,"_3076":122275},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3624":73350,"_31165":73203,"_21590":122277,"_5":14857,"_28357":121900,"_3076":122278},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3624":73351,"_31165":73203,"_21590":122280,"_5":14857,"_28357":121900,"_3076":122281},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3624":73352,"_31165":73203,"_21590":122283,"_5":14857,"_28357":121900,"_3076":122284},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3624":73353,"_31165":73203,"_21590":122286,"_5":14857,"_28357":121900,"_3076":122287},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3624":73354,"_31165":73203,"_21590":122289,"_5":14857,"_28357":121904,"_3076":122290},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3624":73355,"_31165":73203,"_21590":122292,"_5":14857,"_28357":121904,"_3076":122293},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3624":73356,"_31165":73203,"_21590":122295,"_5":14857,"_28357":121904,"_3076":122296},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3624":73357,"_31165":73203,"_21590":122298,"_5":14857,"_28357":121908,"_3076":122299},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3624":73358,"_31165":73203,"_21590":122301,"_5":14857,"_28357":121908,"_3076":122302},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3624":73359,"_31165":73203,"_21590":122304,"_5":14857,"_28357":121908,"_3076":122305},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3624":73360,"_31165":73203,"_21590":122307,"_5":14857,"_28357":121908,"_3076":122308},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3624":73361,"_31165":73203,"_21590":122310,"_5":14857,"_28357":121908,"_3076":122311},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3624":73362,"_31165":73203,"_21590":122313,"_5":14857,"_28357":121908,"_3076":122314},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3624":73363,"_31165":73203,"_21590":122316,"_5":14857,"_28357":121908,"_3076":122317},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3624":73364,"_31165":73203,"_21590":122319,"_5":14857,"_28357":121908,"_3076":122320},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3624":73365,"_31165":73203,"_21590":122322,"_5":14857,"_28357":121916,"_3076":122323},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3624":73366,"_31165":73203,"_21590":122325,"_5":14857,"_28357":121920,"_3076":122326},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3624":73367,"_31165":73203,"_21590":122328,"_5":14857,"_28357":121920,"_3076":122329},[],"que exista un principal activo del tipo correcto;",{"_3624":73368,"_31165":73203,"_21590":122331,"_5":14857,"_28357":121920,"_3076":122332},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3624":73369,"_31165":73203,"_21590":122334,"_5":14857,"_28357":121920,"_3076":122335},[],"que todas las condiciones del principal se cumplan;",{"_3624":73370,"_31165":73203,"_21590":122337,"_5":14857,"_28357":121920,"_3076":122338},[],"que el principal tenga concedida la política esperada;",{"_3624":73371,"_31165":73203,"_21590":122340,"_5":14857,"_28357":121920,"_3076":122341},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3624":73372,"_31165":73203,"_21590":122343,"_5":14857,"_28357":121920,"_3076":122344},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3624":73373,"_31165":73203,"_21590":122346,"_5":14857,"_28357":121920,"_3076":122347},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3624":73374,"_31165":73203,"_21590":122349,"_5":14857,"_28357":121920,"_3076":122350},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3624":73375,"_31165":73203,"_21590":122352,"_5":14857,"_28357":121924,"_3076":122353},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3624":73376,"_31165":73203,"_21590":122355,"_5":14857,"_28357":121928,"_3076":122356},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3624":73377,"_31165":73203,"_21590":122358,"_5":14857,"_28357":121932,"_3076":122359},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3624":73378,"_31165":73203,"_21590":122361,"_5":14857,"_28357":121932,"_3076":122362},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3624":73379,"_31165":73379,"_5":15217,"_3076":122364,"_31503":122365,"_21590":122366,"_28357":73379},"Alertas y suscripciones",[50900,121699,121700],[],{"_3624":73380,"_31165":73379,"_21590":122368,"_5":14857,"_28357":73379,"_3076":122369},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3624":73381,"_31165":73379,"_5":31500,"_21590":122371,"_28357":122372,"_3076":122373},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3624":73382,"_31165":73379,"_5":31500,"_21590":122375,"_28357":122376,"_3076":122377},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3624":73383,"_31165":73379,"_5":31500,"_21590":122379,"_28357":122380,"_3076":122381},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3624":73384,"_31165":73379,"_5":31500,"_21590":122383,"_28357":122384,"_3076":122385},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3624":73385,"_31165":73379,"_5":31500,"_21590":122387,"_28357":122388,"_3076":122389},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3624":73386,"_31165":73379,"_5":31500,"_21590":122391,"_28357":122392,"_3076":122393},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3624":73387,"_31165":73379,"_5":31500,"_21590":122395,"_28357":122396,"_3076":122397},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3624":73388,"_31165":73379,"_5":31500,"_21590":122399,"_28357":122400,"_3076":122401},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3624":73389,"_31165":73379,"_5":31500,"_21590":122403,"_28357":122404,"_3076":122405},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3624":73390,"_31165":73379,"_5":31500,"_21590":122407,"_28357":122408,"_3076":122409},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3624":73391,"_31165":73379,"_5":31500,"_21590":122411,"_28357":122412,"_3076":122413},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3624":73392,"_31165":73379,"_21590":122415,"_5":14857,"_28357":73379,"_3076":122416},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3624":73393,"_31165":73379,"_21590":122418,"_5":14857,"_28357":122372,"_3076":122419},[],"Un servicio publica un evento de dominio.",{"_3624":73394,"_31165":73379,"_21590":122421,"_5":14857,"_28357":122372,"_3076":122422},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3624":73395,"_31165":73379,"_21590":122424,"_5":14857,"_28357":122372,"_3076":122425},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3624":73396,"_31165":73379,"_21590":122427,"_5":14857,"_28357":122372,"_3076":122428},[],"Lamassu entrega el evento al canal configurado.",{"_3624":73397,"_31165":73379,"_21590":122430,"_5":14857,"_28357":122372,"_3076":122431},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3624":73398,"_31165":73379,"_21590":122433,"_5":14857,"_28357":122376,"_3076":122434},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3624":73399,"_31165":73379,"_21590":122436,"_5":14857,"_28357":122376,"_3076":122437},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3624":73400,"_31165":73379,"_21590":122439,"_5":14857,"_28357":122376,"_3076":122440},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3624":73401,"_31165":73379,"_21590":122442,"_5":14857,"_28357":122376,"_3076":122443},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3624":73402,"_31165":73379,"_21590":122445,"_5":14857,"_28357":122376,"_3076":122446},[],"`apikey_options` necesita `header` y `key`.",{"_3624":73403,"_31165":73379,"_21590":122448,"_5":14857,"_28357":122376,"_3076":122449},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3624":73404,"_31165":73379,"_21590":122451,"_5":14857,"_28357":122376,"_3076":122452},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3624":73405,"_31165":73379,"_21590":122454,"_5":14857,"_28357":122376,"_3076":122455},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3624":73406,"_31165":73379,"_21590":122457,"_5":14857,"_28357":122384,"_3076":122458},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3624":73407,"_31165":73379,"_21590":122460,"_5":14857,"_28357":122388,"_3076":122461},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3624":73408,"_31165":73379,"_21590":122463,"_5":14857,"_28357":122392,"_3076":122464},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3624":73409,"_31165":73379,"_21590":122466,"_5":14857,"_28357":122392,"_3076":122467},[],"**None** notifica todas las instancias del evento.",{"_3624":73410,"_31165":73379,"_21590":122469,"_5":14857,"_28357":122392,"_3076":122470},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3624":73411,"_31165":73379,"_21590":122472,"_5":14857,"_28357":122392,"_3076":122473},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3624":73412,"_31165":73379,"_21590":122475,"_5":14857,"_28357":122392,"_3076":122476},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3624":73413,"_31165":73379,"_21590":122478,"_5":14857,"_28357":122392,"_3076":122479},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3624":73414,"_31165":73379,"_21590":122481,"_5":14857,"_28357":122392,"_3076":122482},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3624":73415,"_31165":73379,"_21590":122484,"_5":14857,"_28357":122396,"_3076":122485},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3624":73416,"_31165":73379,"_21590":122487,"_5":14857,"_28357":122400,"_3076":122488},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3624":73417,"_31165":73379,"_21590":122490,"_5":14857,"_28357":122400,"_3076":122491},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3624":73418,"_31165":73379,"_21590":122493,"_5":14857,"_28357":122400,"_3076":122494},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3624":73419,"_31165":73379,"_21590":122496,"_5":14857,"_28357":122400,"_3076":122497},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3624":73420,"_31165":73379,"_21590":122499,"_5":14857,"_28357":122400,"_3076":122500},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3624":73421,"_31165":73379,"_21590":122502,"_5":14857,"_28357":122400,"_3076":122503},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3624":73422,"_31165":73379,"_21590":122505,"_5":14857,"_28357":122400,"_3076":122506},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3624":73423,"_31165":73379,"_21590":122508,"_5":14857,"_28357":122400,"_3076":122509},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3624":73424,"_31165":73379,"_21590":122511,"_5":14857,"_28357":122404,"_3076":122512},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3624":73425,"_31165":73379,"_21590":122514,"_5":14857,"_28357":122404,"_3076":122515},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3624":73426,"_31165":73379,"_21590":122517,"_5":14857,"_28357":122404,"_3076":122518},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3624":73427,"_31165":73379,"_21590":122520,"_5":14857,"_28357":122404,"_3076":122521},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3624":73428,"_31165":73379,"_21590":122523,"_5":14857,"_28357":122404,"_3076":122524},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3624":73429,"_31165":73379,"_21590":122526,"_5":14857,"_28357":122404,"_3076":122527},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3624":73430,"_31165":73379,"_21590":122529,"_5":14857,"_28357":122404,"_3076":122530},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3624":73431,"_31165":73379,"_21590":122532,"_5":14857,"_28357":122404,"_3076":122533},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3624":73432,"_31165":73379,"_21590":122535,"_5":14857,"_28357":122408,"_3076":122536},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3624":73433,"_31165":73379,"_21590":122538,"_5":14857,"_28357":122408,"_3076":122539},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3624":73434,"_31165":73379,"_21590":122541,"_5":14857,"_28357":122412,"_3076":122542},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3624":73435,"_31165":73379,"_21590":122544,"_5":14857,"_28357":122412,"_3076":122545},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3624":73436,"_31165":73379,"_21590":122547,"_5":14857,"_28357":122412,"_3076":122548},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3624":73437,"_31165":73379,"_21590":122550,"_5":14857,"_28357":122412,"_3076":122551},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3624":73438,"_31165":73379,"_21590":122553,"_5":14857,"_28357":122412,"_3076":122554},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3624":73439,"_31165":73379,"_21590":122556,"_5":14857,"_28357":122412,"_3076":122557},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3624":73440,"_31165":73379,"_21590":122559,"_5":14857,"_28357":122412,"_3076":122560},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3624":73441,"_31165":73379,"_21590":122562,"_5":14857,"_28357":122412,"_3076":122563},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3624":73442,"_31165":73379,"_21590":122565,"_5":14857,"_28357":122412,"_3076":122566},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3624":73443,"_31165":73379,"_21590":122568,"_5":14857,"_28357":122412,"_3076":122569},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3624":73444,"_31165":73444,"_5":15217,"_3076":122571,"_31503":122572,"_21590":122573,"_28357":73444},"Registros de auditoría",[50900,121699,121700],[],{"_3624":73445,"_31165":73444,"_21590":122575,"_5":14857,"_28357":73444,"_3076":122576},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3624":73446,"_31165":73444,"_5":31500,"_21590":122578,"_28357":122579,"_3076":122580},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3624":73447,"_31165":73444,"_5":31500,"_21590":122582,"_28357":122583,"_3076":122584},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3624":73448,"_31165":73444,"_5":31500,"_21590":122586,"_28357":122587,"_3076":122588},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3624":73449,"_31165":73444,"_5":31500,"_21590":122590,"_28357":122591,"_3076":122592},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3624":73450,"_31165":73444,"_5":31500,"_21590":122594,"_28357":122595,"_3076":122596},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3624":73451,"_31165":73444,"_5":31500,"_21590":122598,"_28357":122599,"_3076":122600},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3624":73452,"_31165":73444,"_5":31500,"_21590":122602,"_28357":122603,"_3076":122604},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3624":73453,"_31165":73444,"_5":31500,"_21590":122606,"_28357":122607,"_3076":122608},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3624":73454,"_31165":73444,"_5":31500,"_21590":122610,"_28357":122611,"_3076":122612},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3624":73455,"_31165":73444,"_5":31500,"_21590":122614,"_28357":122615,"_3076":122616},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3624":73456,"_31165":73444,"_5":31500,"_21590":122618,"_28357":122619,"_3076":122620},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3624":73457,"_31165":73444,"_21590":122622,"_5":14857,"_28357":73444,"_3076":122623},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3624":73458,"_31165":73444,"_21590":122625,"_5":14857,"_28357":122579,"_3076":122626},[],"El cuerpo de auditoría incluye:",{"_3624":73459,"_31165":73444,"_21590":122628,"_5":14857,"_28357":122579,"_3076":122629},[],"input: datos recibidos por la operación;",{"_3624":73460,"_31165":73444,"_21590":122631,"_5":14857,"_28357":122579,"_3076":122632},[],"has\\_error: indica si el servicio devolvió un error;",{"_3624":73461,"_31165":73444,"_21590":122634,"_5":14857,"_28357":122579,"_3076":122635},[],"output: resultado producido o mensaje de error;",{"_3624":73462,"_31165":73444,"_21590":122637,"_5":14857,"_28357":122579,"_3076":122638},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3624":73463,"_31165":73444,"_21590":122640,"_5":14857,"_28357":122579,"_3076":122641},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3624":73464,"_31165":73444,"_21590":122643,"_5":14857,"_28357":122579,"_3076":122644},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3624":73465,"_31165":73444,"_21590":122646,"_5":14857,"_28357":122583,"_3076":122647},[],"El backend aplica auditoría a mutaciones de:",{"_3624":73466,"_31165":73444,"_21590":122649,"_5":14857,"_28357":122583,"_3076":122650},[],"autoridades, certificados y perfiles de emisión;",{"_3624":73467,"_31165":73444,"_21590":122652,"_5":14857,"_28357":122583,"_3076":122653},[],"claves y motores KMS;",{"_3624":73468,"_31165":73444,"_21590":122655,"_5":14857,"_28357":122583,"_3076":122656},[],"dispositivos e identidades;",{"_3624":73469,"_31165":73444,"_21590":122658,"_5":14857,"_28357":122583,"_3076":122659},[],"DMS y operaciones de enrolamiento;",{"_3624":73470,"_31165":73444,"_21590":122661,"_5":14857,"_28357":122583,"_3076":122662},[],"funciones de validación y CRL;",{"_3624":73471,"_31165":73444,"_21590":122664,"_5":14857,"_28357":122583,"_3076":122665},[],"principales, políticas y concesiones de autorización.",{"_3624":73472,"_31165":73444,"_21590":122667,"_5":14857,"_28357":122583,"_3076":122668},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3624":73473,"_31165":73444,"_21590":122670,"_5":14857,"_28357":122587,"_3076":122671},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3624":73474,"_31165":73444,"_21590":122673,"_5":14857,"_28357":122587,"_3076":122674},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3624":73475,"_31165":73444,"_21590":122676,"_5":14857,"_28357":122587,"_3076":122677},[],"Diseña el consumidor para:",{"_3624":73476,"_31165":73444,"_21590":122679,"_5":14857,"_28357":122587,"_3076":122680},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3624":73477,"_31165":73444,"_21590":122682,"_5":14857,"_28357":122587,"_3076":122683},[],"conservar el CloudEvent completo sin modificar;",{"_3624":73478,"_31165":73444,"_21590":122685,"_5":14857,"_28357":122587,"_3076":122686},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3624":73479,"_31165":73444,"_21590":122688,"_5":14857,"_28357":122587,"_3076":122689},[],"cifrar en tránsito y en reposo;",{"_3624":73480,"_31165":73444,"_21590":122691,"_5":14857,"_28357":122587,"_3076":122692},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3624":73481,"_31165":73444,"_21590":122694,"_5":14857,"_28357":122587,"_3076":122695},[],"aplicar una política explícita de retención y legal hold;",{"_3624":73482,"_31165":73444,"_21590":122697,"_5":14857,"_28357":122587,"_3076":122698},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3624":73483,"_31165":73444,"_21590":122700,"_5":14857,"_28357":122591,"_3076":122701},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3624":73484,"_31165":73444,"_21590":122703,"_5":14857,"_28357":122591,"_3076":122704},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3624":73485,"_31165":73444,"_21590":122706,"_5":14857,"_28357":122599,"_3076":122707},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3624":73486,"_31165":73444,"_21590":122709,"_5":14857,"_28357":122603,"_3076":122710},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3624":73487,"_31165":73444,"_21590":122712,"_5":14857,"_28357":122607,"_3076":122713},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3624":73488,"_31165":73444,"_21590":122715,"_5":14857,"_28357":122611,"_3076":122716},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3624":73489,"_31165":73444,"_21590":122718,"_5":14857,"_28357":122615,"_3076":122719},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3624":73490,"_31165":73444,"_21590":122721,"_5":14857,"_28357":122619,"_3076":122722},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3624":73491,"_31165":73444,"_21590":122724,"_5":14857,"_28357":122619,"_3076":122725},[],"aparece un evento de auditoría correcto;",{"_3624":73492,"_31165":73444,"_21590":122727,"_5":14857,"_28357":122619,"_3076":122728},[],"el principal coincide con la identidad utilizada;",{"_3624":73493,"_31165":73444,"_21590":122730,"_5":14857,"_28357":122619,"_3076":122731},[],"el consumidor lo persiste una sola vez;",{"_3624":73494,"_31165":73444,"_21590":122733,"_5":14857,"_28357":122619,"_3076":122734},[],"puede recuperarse por recurso, actor y periodo;",{"_3624":73495,"_31165":73444,"_21590":122736,"_5":14857,"_28357":122619,"_3076":122737},[],"una interrupción del consumidor produce una alerta.",{"_3624":73496,"_31165":73444,"_21590":122739,"_5":14857,"_28357":122619,"_3076":122740},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3624":73497,"_31165":73497,"_5":15217,"_3076":122742,"_31503":122743,"_21590":122744,"_28357":73497},"Arquitectura de la plataforma",[50900,121699],[],{"_3624":73498,"_31165":73497,"_21590":122746,"_5":14857,"_28357":73497,"_3076":122747},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3624":73499,"_31165":73497,"_5":31500,"_21590":122749,"_28357":122750,"_3076":122751},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3624":73500,"_31165":73497,"_5":31500,"_21590":122753,"_28357":122754,"_3076":122755},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3624":73501,"_31165":73497,"_5":31500,"_21590":122757,"_28357":122758,"_3076":122759},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3624":73502,"_31165":73497,"_5":31500,"_21590":122761,"_28357":122762,"_3076":122763},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3624":73503,"_31165":73497,"_5":31500,"_21590":122765,"_28357":122766,"_3076":122767},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3624":73504,"_31165":73497,"_21590":122769,"_5":14857,"_28357":73497,"_3076":122770},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3624":73505,"_31165":73497,"_21590":122772,"_5":14857,"_28357":73497,"_3076":122773},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3624":73506,"_31165":73497,"_21590":122775,"_5":14857,"_28357":122750,"_3076":122776},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3624":73507,"_31165":73497,"_21590":122778,"_5":14857,"_28357":122754,"_3076":122779},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3624":73508,"_31165":73497,"_21590":122781,"_5":14857,"_28357":122758,"_3076":122782},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3624":73509,"_31165":73497,"_21590":122784,"_5":14857,"_28357":122762,"_3076":122785},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3624":73510,"_31165":73497,"_21590":122787,"_5":14857,"_28357":122766,"_3076":122788},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3624":73511,"_31165":73511,"_5":15217,"_3076":122790,"_31503":122791,"_21590":122792,"_28357":73511},"Cómo funciona Lamassu",[50900,121699],[],{"_3624":73512,"_31165":73511,"_21590":122794,"_5":14857,"_28357":73511,"_3076":122795},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3624":73513,"_31165":73511,"_5":31500,"_21590":122797,"_28357":122798,"_3076":122799},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3624":73514,"_31165":73511,"_5":31500,"_21590":122801,"_28357":122802,"_3076":122803},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3624":73515,"_31165":73511,"_21590":122805,"_5":14857,"_28357":73511,"_3076":122806},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3624":73516,"_31165":73511,"_21590":122808,"_5":14857,"_28357":122798,"_3076":122809},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3624":73517,"_31165":73511,"_21590":122811,"_5":14857,"_28357":122798,"_3076":122812},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3624":73518,"_31165":73511,"_21590":122814,"_5":14857,"_28357":122798,"_3076":122815},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3624":73519,"_31165":73511,"_21590":122817,"_5":14857,"_28357":122798,"_3076":122818},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3624":73520,"_31165":73511,"_21590":122820,"_5":14857,"_28357":122798,"_3076":122821},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3624":73521,"_31165":73511,"_21590":122823,"_5":14857,"_28357":122802,"_3076":122824},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3624":73522,"_31165":73511,"_21590":122826,"_5":14857,"_28357":122802,"_3076":122827},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3624":73523,"_31165":73511,"_21590":122829,"_5":14857,"_28357":122802,"_3076":122830},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3624":73524,"_31165":73511,"_21590":122832,"_5":14857,"_28357":122802,"_3076":122833},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3624":73525,"_31165":73511,"_21590":122835,"_5":14857,"_28357":122802,"_3076":122836},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3624":73526,"_31165":73511,"_21590":122838,"_5":14857,"_28357":122802,"_3076":122839},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3624":73527,"_31165":73511,"_21590":122841,"_5":14857,"_28357":122802,"_3076":122842},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3624":73528,"_31165":73528,"_5":15217,"_3076":122844,"_31503":122845,"_21590":122846,"_28357":73528},"Dispositivos e identidades",[50900,121699,53584,122844],[],{"_3624":73529,"_31165":73528,"_21590":122848,"_5":14857,"_28357":73528,"_3076":122849},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3624":73530,"_31165":73528,"_5":31500,"_21590":122851,"_28357":122852,"_3076":122853},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3624":73531,"_31165":73528,"_5":31500,"_21590":122855,"_28357":122856,"_3076":122857},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3624":73532,"_31165":73528,"_5":31500,"_21590":122859,"_28357":122860,"_3076":122861},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3624":73533,"_31165":73528,"_5":31500,"_21590":122863,"_28357":122864,"_3076":122865},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3624":73534,"_31165":73528,"_5":31500,"_21590":122867,"_28357":122868,"_3076":122869},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3624":73535,"_31165":73528,"_5":31500,"_21590":122871,"_28357":122872,"_3076":122873},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3624":73536,"_31165":73528,"_5":31500,"_21590":122875,"_28357":122876,"_3076":122877},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3624":73537,"_31165":73528,"_5":31500,"_21590":122879,"_28357":122880,"_3076":122881},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3624":73538,"_31165":73528,"_5":31500,"_21590":122883,"_28357":122884,"_3076":122885},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3624":73539,"_31165":73528,"_5":31500,"_21590":122887,"_28357":122888,"_3076":122889},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3624":73540,"_31165":73528,"_5":31500,"_21590":122891,"_28357":122892,"_3076":122893},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3624":73541,"_31165":73528,"_21590":122895,"_5":14857,"_28357":73528,"_3076":122896},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3624":73542,"_31165":73528,"_21590":122898,"_5":14857,"_28357":73528,"_3076":122899},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3624":73543,"_31165":73528,"_21590":122901,"_5":14857,"_28357":122852,"_3076":122902},[],"Vista operativa",{"_3624":73544,"_31165":73528,"_21590":122904,"_5":14857,"_28357":122852,"_3076":122905},[],"Interpretación",{"_3624":73545,"_31165":73528,"_21590":122907,"_5":14857,"_28357":122852,"_3076":53647},[],{"_3624":73546,"_31165":73528,"_21590":122909,"_5":14857,"_28357":122852,"_3076":122910},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3624":73547,"_31165":73528,"_21590":122912,"_5":14857,"_28357":122852,"_3076":53653},[],{"_3624":73548,"_31165":73528,"_21590":122914,"_5":14857,"_28357":122852,"_3076":122915},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3624":73549,"_31165":73528,"_21590":122917,"_5":14857,"_28357":122852,"_3076":53659},[],{"_3624":73550,"_31165":73528,"_21590":122919,"_5":14857,"_28357":122852,"_3076":122920},[],"La identidad está en la ventana operativa de renovación.",{"_3624":73551,"_31165":73528,"_21590":122922,"_5":14857,"_28357":122852,"_3076":53665},[],{"_3624":73552,"_31165":73528,"_21590":122924,"_5":14857,"_28357":122852,"_3076":122925},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3624":73553,"_31165":73528,"_21590":122927,"_5":14857,"_28357":122852,"_3076":53671},[],{"_3624":73554,"_31165":73528,"_21590":122929,"_5":14857,"_28357":122852,"_3076":122930},[],"La identidad ha vencido.",{"_3624":73555,"_31165":73528,"_21590":122932,"_5":14857,"_28357":122852,"_3076":53677},[],{"_3624":73556,"_31165":73528,"_21590":122934,"_5":14857,"_28357":122852,"_3076":122935},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3624":73557,"_31165":73528,"_21590":122937,"_5":14857,"_28357":122852,"_3076":53683},[],{"_3624":73558,"_31165":73528,"_21590":122939,"_5":14857,"_28357":122852,"_3076":122940},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3624":73559,"_31165":73528,"_21590":122942,"_5":14857,"_28357":122852,"_3076":122943},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3624":73560,"_31165":73528,"_21590":122945,"_5":14857,"_28357":122856,"_3076":122946},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3624":73561,"_31165":73528,"_21590":122948,"_5":14857,"_28357":122856,"_3076":122949},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3624":73562,"_31165":73528,"_21590":122951,"_5":14857,"_28357":122856,"_3076":122952},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3624":73563,"_31165":73528,"_21590":122954,"_5":14857,"_28357":122856,"_3076":122955},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3624":73564,"_31165":73528,"_21590":122957,"_5":14857,"_28357":122860,"_3076":122958},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3624":73565,"_31165":73528,"_21590":122960,"_5":14857,"_28357":122864,"_3076":122961},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3624":73566,"_31165":73528,"_21590":122963,"_5":14857,"_28357":122868,"_3076":122964},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3624":73567,"_31165":73528,"_21590":122966,"_5":14857,"_28357":122872,"_3076":122967},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3624":73568,"_31165":73528,"_21590":122969,"_5":14857,"_28357":122876,"_3076":122970},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3624":73569,"_31165":73528,"_21590":122972,"_5":14857,"_28357":122876,"_3076":122973},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3624":73570,"_31165":73528,"_21590":122975,"_5":14857,"_28357":122880,"_3076":122976},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3624":73571,"_31165":73528,"_21590":122978,"_5":14857,"_28357":122880,"_3076":122979},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3624":73572,"_31165":73528,"_21590":122981,"_5":14857,"_28357":122880,"_3076":122982},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3624":73573,"_31165":73528,"_21590":122984,"_5":14857,"_28357":122880,"_3076":122985},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3624":73574,"_31165":73528,"_21590":122987,"_5":14857,"_28357":122880,"_3076":122988},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3624":73575,"_31165":73528,"_21590":122990,"_5":14857,"_28357":122880,"_3076":122991},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3624":73576,"_31165":73528,"_21590":122993,"_5":14857,"_28357":122884,"_3076":122994},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3624":73577,"_31165":73528,"_21590":122996,"_5":14857,"_28357":122884,"_3076":122997},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3624":73578,"_31165":73528,"_21590":122999,"_5":14857,"_28357":122884,"_3076":123000},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3624":73579,"_31165":73528,"_21590":123002,"_5":14857,"_28357":122888,"_3076":123003},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3624":73580,"_31165":73528,"_21590":123005,"_5":14857,"_28357":122888,"_3076":123006},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3624":73581,"_31165":73528,"_21590":123008,"_5":14857,"_28357":122888,"_3076":123009},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3624":73582,"_31165":73528,"_21590":123011,"_5":14857,"_28357":122888,"_3076":123012},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3624":73583,"_31165":73528,"_21590":123014,"_5":14857,"_28357":122892,"_3076":123015},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3624":73584,"_31165":73528,"_21590":123017,"_5":14857,"_28357":122892,"_3076":123018},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3624":73585,"_31165":73585,"_5":15217,"_3076":123020,"_31503":123021,"_21590":123023,"_28357":73585},"Identidad inicial y autenticación",[50900,121699,53584,122844,123022],"Enrolamiento con PKI",[],{"_3624":73586,"_31165":73585,"_21590":123025,"_5":14857,"_28357":73585,"_3076":123026},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3624":73587,"_31165":73585,"_5":31500,"_21590":123028,"_28357":123029,"_3076":123030},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3624":73588,"_31165":73585,"_5":31500,"_21590":123032,"_28357":123033,"_3076":123034},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3624":73589,"_31165":73585,"_5":31500,"_21590":123036,"_28357":123037,"_3076":123038},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3624":73590,"_31165":73585,"_5":31500,"_21590":123040,"_28357":123041,"_3076":123042},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3624":73591,"_31165":73585,"_5":31500,"_21590":123044,"_28357":123045,"_3076":123046},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3624":73592,"_31165":73585,"_21590":123048,"_5":14857,"_28357":73585,"_3076":123049},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3624":73593,"_31165":73585,"_21590":123051,"_5":14857,"_28357":123029,"_3076":123052},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3624":73594,"_31165":73585,"_21590":123054,"_5":14857,"_28357":123029,"_3076":123055},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3624":73595,"_31165":73585,"_21590":123057,"_5":14857,"_28357":123033,"_3076":123058},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3624":73596,"_31165":73585,"_21590":123060,"_5":14857,"_28357":123033,"_3076":123061},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3624":73597,"_31165":73585,"_21590":123063,"_5":14857,"_28357":123033,"_3076":123064},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3624":73598,"_31165":73585,"_21590":123066,"_5":14857,"_28357":123037,"_3076":123067},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3624":73599,"_31165":73585,"_21590":123069,"_5":14857,"_28357":123037,"_3076":123070},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3624":73600,"_31165":73585,"_21590":123072,"_5":14857,"_28357":123041,"_3076":123073},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3624":73601,"_31165":73585,"_21590":123075,"_5":14857,"_28357":123041,"_3076":123076},[],"Ejemplo de cuerpo:",{"_3624":73602,"_31165":73585,"_21590":123078,"_5":14857,"_28357":123041,"_3076":123079},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3624":73603,"_31165":73585,"_21590":123081,"_5":14857,"_28357":123041,"_3076":123082},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3624":73604,"_31165":73585,"_21590":123084,"_5":14857,"_28357":123041,"_3076":123085},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3624":73605,"_31165":73585,"_21590":123087,"_5":14857,"_28357":123041,"_3076":123088},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3624":73606,"_31165":73585,"_21590":123090,"_5":14857,"_28357":123045,"_3076":123091},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3624":73607,"_31165":73585,"_21590":123093,"_5":14857,"_28357":123045,"_3076":123094},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3624":73608,"_31165":73585,"_21590":123096,"_5":14857,"_28357":123045,"_3076":123097},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3624":73609,"_31165":73585,"_21590":123099,"_5":14857,"_28357":123045,"_3076":123100},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3624":73610,"_31165":73610,"_5":15217,"_3076":123102,"_31503":123103,"_21590":123104,"_28357":73610},"Configura y opera el DMS",[50900,121699,53584,122844,123022],[],{"_3624":73611,"_31165":73610,"_21590":123106,"_5":14857,"_28357":73610,"_3076":123107},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3624":73612,"_31165":73610,"_5":31500,"_21590":123109,"_28357":123110,"_3076":120233},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3624":73613,"_31165":73610,"_5":31500,"_21590":123112,"_28357":123113,"_3076":123114},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3624":73614,"_31165":73610,"_5":31500,"_21590":123116,"_28357":123117,"_3076":123118},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3624":73615,"_31165":73610,"_5":31500,"_21590":123120,"_28357":123121,"_3076":123122},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3624":73616,"_31165":73610,"_5":31500,"_21590":123124,"_28357":123125,"_3076":123126},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3624":73617,"_31165":73610,"_5":31500,"_21590":123128,"_28357":123129,"_3076":123130},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3624":73618,"_31165":73610,"_5":31500,"_21590":123132,"_28357":123133,"_3076":123134},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3624":73619,"_31165":73610,"_5":31500,"_21590":123136,"_28357":123137,"_3076":123138},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3624":73620,"_31165":73610,"_5":31500,"_21590":123140,"_28357":123141,"_3076":53888},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3624":73621,"_31165":73610,"_5":31500,"_21590":123143,"_28357":123144,"_3076":53892},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3624":73622,"_31165":73610,"_5":31500,"_21590":123146,"_28357":123147,"_3076":123148},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3624":73623,"_31165":73610,"_5":31500,"_21590":123150,"_28357":123151,"_3076":123152},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3624":73624,"_31165":73610,"_5":31500,"_21590":123154,"_28357":123155,"_3076":123156},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3624":73625,"_31165":73610,"_5":31500,"_21590":123158,"_28357":123159,"_3076":123160},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3624":73626,"_31165":73610,"_5":31500,"_21590":123162,"_28357":123163,"_3076":53912},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3624":73627,"_31165":73610,"_5":31500,"_21590":123165,"_28357":123166,"_3076":123167},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3624":73628,"_31165":73610,"_5":31500,"_21590":123169,"_28357":123170,"_3076":123171},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3624":73629,"_31165":73610,"_5":31500,"_21590":123173,"_28357":123174,"_3076":123175},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3624":73630,"_31165":73610,"_21590":123177,"_5":14857,"_28357":73610,"_3076":123178},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3624":73631,"_31165":73610,"_21590":123180,"_5":14857,"_28357":123110,"_3076":123181},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3624":73632,"_31165":73610,"_21590":123183,"_5":14857,"_28357":123110,"_3076":123184},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3624":73633,"_31165":73610,"_21590":123186,"_5":14857,"_28357":123117,"_3076":123187},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3624":73634,"_31165":73610,"_21590":123189,"_5":14857,"_28357":123121,"_3076":123190},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3624":73635,"_31165":73610,"_21590":123192,"_5":14857,"_28357":123125,"_3076":123193},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3624":73636,"_31165":73610,"_21590":123195,"_5":14857,"_28357":123129,"_3076":123196},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3624":73637,"_31165":73610,"_21590":123198,"_5":14857,"_28357":123133,"_3076":123199},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3624":73638,"_31165":73610,"_21590":123201,"_5":14857,"_28357":123141,"_3076":123202},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3624":73639,"_31165":73610,"_21590":123204,"_5":14857,"_28357":123141,"_3076":123205},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3624":73640,"_31165":73610,"_21590":123207,"_5":14857,"_28357":123144,"_3076":123208},[],"Campo de `settings.enrollment_settings`",{"_3624":73641,"_31165":73610,"_21590":123210,"_5":14857,"_28357":123144,"_3076":123211},[],"Decisión",{"_3624":73642,"_31165":73610,"_21590":123213,"_5":14857,"_28357":123144,"_3076":53963},[],{"_3624":73643,"_31165":73610,"_21590":123215,"_5":14857,"_28357":123144,"_3076":123216},[],"`EST_RFC7030` para estas operaciones.",{"_3624":73644,"_31165":73610,"_21590":123218,"_5":14857,"_28357":123144,"_3076":53969},[],{"_3624":73645,"_31165":73610,"_21590":123220,"_5":14857,"_28357":123144,"_3076":123221},[],"ID de la CA que firmará.",{"_3624":73646,"_31165":73610,"_21590":123223,"_5":14857,"_28357":123144,"_3076":53975},[],{"_3624":73647,"_31165":73610,"_21590":123225,"_5":14857,"_28357":123144,"_3076":123226},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3624":73648,"_31165":73610,"_21590":123228,"_5":14857,"_28357":123144,"_3076":53981},[],{"_3624":73649,"_31165":73610,"_21590":123230,"_5":14857,"_28357":123144,"_3076":123231},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3624":73650,"_31165":73610,"_21590":123233,"_5":14857,"_28357":123144,"_3076":53987},[],{"_3624":73651,"_31165":73610,"_21590":123235,"_5":14857,"_28357":123144,"_3076":123236},[],"Uno de los cuatro modos de autenticación.",{"_3624":73652,"_31165":73610,"_21590":123238,"_5":14857,"_28357":123144,"_3076":123239},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3624":73653,"_31165":73610,"_21590":123241,"_5":14857,"_28357":123147,"_3076":123242},[],"Los bloques son independientes:",{"_3624":73654,"_31165":73610,"_21590":123244,"_5":14857,"_28357":123147,"_3076":123245},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3624":73655,"_31165":73610,"_21590":123247,"_5":14857,"_28357":123147,"_3076":123248},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3624":73656,"_31165":73610,"_21590":123250,"_5":14857,"_28357":123147,"_3076":54005},[],{"_3624":73657,"_31165":73610,"_21590":123252,"_5":14857,"_28357":123147,"_3076":123253},[],"Control aplicado en la operación configurada",{"_3624":73658,"_31165":73610,"_21590":123255,"_5":14857,"_28357":123147,"_3076":54011},[],{"_3624":73659,"_31165":73610,"_21590":123257,"_5":14857,"_28357":123147,"_3076":123258},[],"Validación del certificado presentado.",{"_3624":73660,"_31165":73610,"_21590":123260,"_5":14857,"_28357":123147,"_3076":54017},[],{"_3624":73661,"_31165":73610,"_21590":123262,"_5":14857,"_28357":123147,"_3076":123263},[],"Autorización del webhook configurado.",{"_3624":73662,"_31165":73610,"_21590":123265,"_5":14857,"_28357":123147,"_3076":54023},[],{"_3624":73663,"_31165":73610,"_21590":123267,"_5":14857,"_28357":123147,"_3076":123268},[],"Validación del certificado y, después, aprobación del webhook.",{"_3624":73664,"_31165":73610,"_21590":123270,"_5":14857,"_28357":123147,"_3076":54029},[],{"_3624":73665,"_31165":73610,"_21590":123272,"_5":14857,"_28357":123147,"_3076":123273},[],"Sin autenticación del solicitante por el DMS.",{"_3624":73666,"_31165":73610,"_21590":123275,"_5":14857,"_28357":123147,"_3076":123276},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3624":73667,"_31165":73610,"_21590":123278,"_5":14857,"_28357":123147,"_3076":123279},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3624":73668,"_31165":73610,"_21590":123281,"_5":14857,"_28357":123147,"_3076":123282},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3624":73669,"_31165":73610,"_21590":123284,"_5":14857,"_28357":123147,"_3076":123285},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3624":73670,"_31165":73610,"_21590":123287,"_5":14857,"_28357":123147,"_3076":123288},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3624":73671,"_31165":73610,"_21590":123290,"_5":14857,"_28357":123151,"_3076":123291},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3624":73672,"_31165":73610,"_21590":123293,"_5":14857,"_28357":123151,"_3076":123294},[],"Campo de `external_webhook_settings`",{"_3624":73673,"_31165":73610,"_21590":123296,"_5":14857,"_28357":123151,"_3076":123211},[],{"_3624":73674,"_31165":73610,"_21590":123298,"_5":14857,"_28357":123151,"_3076":54058},[],{"_3624":73675,"_31165":73610,"_21590":123300,"_5":14857,"_28357":123151,"_3076":123301},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3624":73676,"_31165":73610,"_21590":123303,"_5":14857,"_28357":123151,"_3076":54064},[],{"_3624":73677,"_31165":73610,"_21590":123305,"_5":14857,"_28357":123151,"_3076":123306},[],"`POST` o `PUT`; `POST` por defecto.",{"_3624":73678,"_31165":73610,"_21590":123308,"_5":14857,"_28357":123151,"_3076":54070},[],{"_3624":73679,"_31165":73610,"_21590":123310,"_5":14857,"_28357":123151,"_3076":123311},[],"Etiqueta usada en los logs del servicio.",{"_3624":73680,"_31165":73610,"_21590":123313,"_5":14857,"_28357":123151,"_3076":54076},[],{"_3624":73681,"_31165":73610,"_21590":123315,"_5":14857,"_28357":123151,"_3076":123316},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3624":73682,"_31165":73610,"_21590":123318,"_5":14857,"_28357":123151,"_3076":54082},[],{"_3624":73683,"_31165":73610,"_21590":123320,"_5":14857,"_28357":123151,"_3076":123321},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3624":73684,"_31165":73610,"_21590":123323,"_5":14857,"_28357":123151,"_3076":54088},[],{"_3624":73685,"_31165":73610,"_21590":123325,"_5":14857,"_28357":123151,"_3076":123326},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3624":73686,"_31165":73610,"_21590":123328,"_5":14857,"_28357":123151,"_3076":54094},[],{"_3624":73687,"_31165":73610,"_21590":123330,"_5":14857,"_28357":123151,"_3076":123331},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3624":73688,"_31165":73610,"_21590":123333,"_5":14857,"_28357":123151,"_3076":54100},[],{"_3624":73689,"_31165":73610,"_21590":123335,"_5":14857,"_28357":123151,"_3076":123336},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3624":73690,"_31165":73610,"_21590":123338,"_5":14857,"_28357":123151,"_3076":54106},[],{"_3624":73691,"_31165":73610,"_21590":123340,"_5":14857,"_28357":123151,"_3076":123341},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3624":73692,"_31165":73610,"_21590":123343,"_5":14857,"_28357":123151,"_3076":54112},[],{"_3624":73693,"_31165":73610,"_21590":123345,"_5":14857,"_28357":123151,"_3076":123346},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3624":73694,"_31165":73610,"_21590":123348,"_5":14857,"_28357":123151,"_3076":123349},[],"Reglas de esa configuración:",{"_3624":73695,"_31165":73610,"_21590":123351,"_5":14857,"_28357":123151,"_3076":123352},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3624":73696,"_31165":73610,"_21590":123354,"_5":14857,"_28357":123151,"_3076":123355},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3624":73697,"_31165":73610,"_21590":123357,"_5":14857,"_28357":123151,"_3076":123358},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3624":73698,"_31165":73610,"_21590":123360,"_5":14857,"_28357":123151,"_3076":123361},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3624":73699,"_31165":73610,"_21590":123363,"_5":14857,"_28357":123151,"_3076":123364},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3624":73700,"_31165":73610,"_21590":123366,"_5":14857,"_28357":123151,"_3076":123367},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3624":73701,"_31165":73610,"_21590":123369,"_5":14857,"_28357":123151,"_3076":123370},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3624":73702,"_31165":73610,"_21590":123372,"_5":14857,"_28357":123151,"_3076":123373},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3624":73703,"_31165":73610,"_21590":123375,"_5":14857,"_28357":123151,"_3076":123376},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3624":73704,"_31165":73610,"_21590":123378,"_5":14857,"_28357":123155,"_3076":123379},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3624":73705,"_31165":73610,"_21590":123381,"_5":14857,"_28357":123159,"_3076":123382},[],"Campo de `settings.reenrollment_settings`",{"_3624":73706,"_31165":73610,"_21590":123384,"_5":14857,"_28357":123159,"_3076":123385},[],"Función",{"_3624":73707,"_31165":73610,"_21590":123387,"_5":14857,"_28357":123159,"_3076":54156},[],{"_3624":73708,"_31165":73610,"_21590":123389,"_5":14857,"_28357":123159,"_3076":123390},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3624":73709,"_31165":73610,"_21590":123392,"_5":14857,"_28357":123159,"_3076":54162},[],{"_3624":73710,"_31165":73610,"_21590":123394,"_5":14857,"_28357":123159,"_3076":123395},[],"Umbral operativo preventivo de monitorización.",{"_3624":73711,"_31165":73610,"_21590":123397,"_5":14857,"_28357":123159,"_3076":54168},[],{"_3624":73712,"_31165":73610,"_21590":123399,"_5":14857,"_28357":123159,"_3076":123400},[],"Umbral operativo crítico de monitorización.",{"_3624":73713,"_31165":73610,"_21590":123402,"_5":14857,"_28357":123159,"_3076":54174},[],{"_3624":73714,"_31165":73610,"_21590":123404,"_5":14857,"_28357":123159,"_3076":123405},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3624":73715,"_31165":73610,"_21590":123407,"_5":14857,"_28357":123159,"_3076":54180},[],{"_3624":73716,"_31165":73610,"_21590":123409,"_5":14857,"_28357":123159,"_3076":123410},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3624":73717,"_31165":73610,"_21590":123412,"_5":14857,"_28357":123159,"_3076":54186},[],{"_3624":73718,"_31165":73610,"_21590":123414,"_5":14857,"_28357":123159,"_3076":123415},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3624":73719,"_31165":73610,"_21590":123417,"_5":14857,"_28357":123159,"_3076":123418},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3624":73720,"_31165":73610,"_21590":123420,"_5":14857,"_28357":123163,"_3076":123421},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3624":73721,"_31165":73610,"_21590":123423,"_5":14857,"_28357":123166,"_3076":120597},[],{"_3624":73722,"_31165":73610,"_21590":123425,"_5":14857,"_28357":123166,"_3076":123426},[],"Qué publica",{"_3624":73723,"_31165":73610,"_21590":123428,"_5":14857,"_28357":123166,"_3076":54203},[],{"_3624":73724,"_31165":73610,"_21590":123430,"_5":14857,"_28357":123166,"_3076":123431},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3624":73725,"_31165":73610,"_21590":123433,"_5":14857,"_28357":123166,"_3076":54209},[],{"_3624":73726,"_31165":73610,"_21590":123435,"_5":14857,"_28357":123166,"_3076":123436},[],"Certificado de la CA emisora seleccionada.",{"_3624":73727,"_31165":73610,"_21590":123438,"_5":14857,"_28357":123166,"_3076":54215},[],{"_3624":73728,"_31165":73610,"_21590":123440,"_5":14857,"_28357":123166,"_3076":123441},[],"Certificados de las CAs elegidas explícitamente.",{"_3624":73729,"_31165":73610,"_21590":123443,"_5":14857,"_28357":123166,"_3076":123444},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3624":73730,"_31165":73610,"_21590":123446,"_5":14857,"_28357":123170,"_3076":123447},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3624":73731,"_31165":73610,"_21590":123449,"_5":14857,"_28357":123170,"_3076":123450},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3624":73732,"_31165":73610,"_21590":123452,"_5":14857,"_28357":123170,"_3076":123453},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3624":73733,"_31165":73610,"_21590":123455,"_5":14857,"_28357":123174,"_3076":123456},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3624":73734,"_31165":73734,"_5":15217,"_3076":123458,"_31503":123459,"_21590":123460,"_28357":73734},"Integra el cliente EST",[50900,121699,53584,122844,123022],[],{"_3624":73735,"_31165":73734,"_21590":123462,"_5":14857,"_28357":73734,"_3076":123463},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3624":73736,"_31165":73734,"_5":31500,"_21590":123465,"_28357":123466,"_3076":120233},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3624":73737,"_31165":73734,"_5":31500,"_21590":123468,"_28357":123469,"_3076":123470},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3624":73738,"_31165":73734,"_5":31500,"_21590":123472,"_28357":123473,"_3076":123474},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3624":73739,"_31165":73734,"_5":31500,"_21590":123476,"_28357":123477,"_3076":123478},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3624":73740,"_31165":73734,"_5":31500,"_21590":123480,"_28357":123481,"_3076":123482},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3624":73741,"_31165":73734,"_5":31500,"_21590":123484,"_28357":123485,"_3076":123486},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3624":73742,"_31165":73734,"_21590":123488,"_5":14857,"_28357":73734,"_3076":123489},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3624":73743,"_31165":73734,"_21590":123491,"_5":14857,"_28357":123466,"_3076":123492},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3624":73744,"_31165":73734,"_21590":123494,"_5":14857,"_28357":123466,"_3076":123495},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3624":73745,"_31165":73734,"_21590":123497,"_5":14857,"_28357":123466,"_3076":123498},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3624":73746,"_31165":73734,"_21590":123500,"_5":14857,"_28357":123469,"_3076":123501},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3624":73747,"_31165":73734,"_21590":123503,"_5":14857,"_28357":123469,"_3076":123504},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3624":73748,"_31165":73734,"_21590":123506,"_5":14857,"_28357":123473,"_3076":123507},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3624":73749,"_31165":73734,"_21590":123509,"_5":14857,"_28357":123473,"_3076":123510},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3624":73750,"_31165":73734,"_21590":123512,"_5":14857,"_28357":123477,"_3076":123513},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3624":73751,"_31165":73734,"_21590":123515,"_5":14857,"_28357":123477,"_3076":123516},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3624":73752,"_31165":73734,"_21590":123518,"_5":14857,"_28357":123481,"_3076":123519},[],"Para el caso de una raíz que emite directamente:",{"_3624":73753,"_31165":73734,"_21590":123521,"_5":14857,"_28357":123481,"_3076":123522},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3624":73754,"_31165":73734,"_21590":123524,"_5":14857,"_28357":123481,"_3076":123525},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3624":73755,"_31165":73734,"_21590":123527,"_5":14857,"_28357":123485,"_3076":123528},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3624":73756,"_31165":73756,"_5":15217,"_3076":123530,"_31503":123531,"_21590":123532,"_28357":73756},"Referencia EST",[50900,121699,53584,122844,123022],[],{"_3624":73757,"_31165":73756,"_21590":123534,"_5":14857,"_28357":73756,"_3076":123535},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3624":73758,"_31165":73756,"_5":31500,"_21590":123537,"_28357":123538,"_3076":123539},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3624":73759,"_31165":73756,"_5":31500,"_21590":123541,"_28357":123542,"_3076":23392},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3624":73760,"_31165":73756,"_5":31500,"_21590":123544,"_28357":123545,"_3076":26907},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3624":73761,"_31165":73756,"_5":31500,"_21590":123547,"_28357":123548,"_3076":26914},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3624":73762,"_31165":73756,"_5":31500,"_21590":123550,"_28357":123551,"_3076":26176},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3624":73763,"_31165":73756,"_5":31500,"_21590":123553,"_28357":123554,"_3076":123555},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3624":73764,"_31165":73756,"_5":31500,"_21590":123557,"_28357":123558,"_3076":123559},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3624":73765,"_31165":73756,"_5":31500,"_21590":123561,"_28357":123562,"_3076":123563},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3624":73766,"_31165":73756,"_21590":123565,"_5":14857,"_28357":73756,"_3076":123566},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3624":73767,"_31165":73756,"_21590":123568,"_5":14857,"_28357":123538,"_3076":123569},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3624":73768,"_31165":73756,"_21590":123571,"_5":14857,"_28357":123538,"_3076":121459},[],{"_3624":73769,"_31165":73756,"_21590":123573,"_5":14857,"_28357":123538,"_3076":123574},[],"Método",{"_3624":73770,"_31165":73756,"_21590":123576,"_5":14857,"_28357":123538,"_3076":123577},[],"Autenticación y condición",{"_3624":73771,"_31165":73756,"_21590":123579,"_5":14857,"_28357":123538,"_3076":54358},[],{"_3624":73772,"_31165":73756,"_21590":123581,"_5":14857,"_28357":123538,"_3076":54361},[],{"_3624":73773,"_31165":73756,"_21590":123583,"_5":14857,"_28357":123538,"_3076":123584},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3624":73774,"_31165":73756,"_21590":123586,"_5":14857,"_28357":123538,"_3076":54367},[],{"_3624":73775,"_31165":73756,"_21590":123588,"_5":14857,"_28357":123538,"_3076":54370},[],{"_3624":73776,"_31165":73756,"_21590":123590,"_5":14857,"_28357":123538,"_3076":123591},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3624":73777,"_31165":73756,"_21590":123593,"_5":14857,"_28357":123538,"_3076":54376},[],{"_3624":73778,"_31165":73756,"_21590":123595,"_5":14857,"_28357":123538,"_3076":54370},[],{"_3624":73779,"_31165":73756,"_21590":123597,"_5":14857,"_28357":123538,"_3076":123598},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3624":73780,"_31165":73756,"_21590":123600,"_5":14857,"_28357":123538,"_3076":54384},[],{"_3624":73781,"_31165":73756,"_21590":123602,"_5":14857,"_28357":123538,"_3076":54370},[],{"_3624":73782,"_31165":73756,"_21590":123604,"_5":14857,"_28357":123538,"_3076":123605},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3624":73783,"_31165":73756,"_21590":123607,"_5":14857,"_28357":123538,"_3076":123608},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3624":73784,"_31165":73756,"_21590":123610,"_5":14857,"_28357":123542,"_3076":123611},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3624":73785,"_31165":73756,"_21590":123613,"_5":14857,"_28357":123542,"_3076":123614},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3624":73786,"_31165":73756,"_21590":123616,"_5":14857,"_28357":123545,"_3076":123617},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3624":73787,"_31165":73756,"_21590":123619,"_5":14857,"_28357":123545,"_3076":123620},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3624":73788,"_31165":73756,"_21590":123622,"_5":14857,"_28357":123548,"_3076":123623},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3624":73789,"_31165":73756,"_21590":123625,"_5":14857,"_28357":123548,"_3076":123626},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3624":73790,"_31165":73756,"_21590":123628,"_5":14857,"_28357":123551,"_3076":123629},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3624":73791,"_31165":73756,"_21590":123631,"_5":14857,"_28357":123551,"_3076":123632},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3624":73792,"_31165":73756,"_21590":123634,"_5":14857,"_28357":123554,"_3076":123635},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3624":73793,"_31165":73756,"_21590":123637,"_5":14857,"_28357":123554,"_3076":123638},[],"Parte",{"_3624":73794,"_31165":73756,"_21590":123640,"_5":14857,"_28357":123554,"_3076":123641},[],"Contenido tras decodificar su Base64",{"_3624":73795,"_31165":73756,"_21590":123643,"_5":14857,"_28357":123554,"_3076":54428},[],{"_3624":73796,"_31165":73756,"_21590":123645,"_5":14857,"_28357":123554,"_3076":123646},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3624":73797,"_31165":73756,"_21590":123648,"_5":14857,"_28357":123554,"_3076":54434},[],{"_3624":73798,"_31165":73756,"_21590":123650,"_5":14857,"_28357":123554,"_3076":123651},[],"PKCS#7 DER con el certificado emitido.",{"_3624":73799,"_31165":73756,"_21590":123653,"_5":14857,"_28357":123554,"_3076":123654},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3624":73800,"_31165":73756,"_21590":123656,"_5":14857,"_28357":123558,"_3076":123657},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3624":73801,"_31165":73756,"_21590":123659,"_5":14857,"_28357":123558,"_3076":123660},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3624":73802,"_31165":73756,"_21590":123662,"_5":14857,"_28357":123558,"_3076":123663},[],"Convierte y comprueba el resultado:",{"_3624":73803,"_31165":73756,"_21590":123665,"_5":14857,"_28357":123558,"_3076":123666},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3624":73804,"_31165":73756,"_21590":123668,"_5":14857,"_28357":123562,"_3076":123669},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3624":73805,"_31165":73756,"_21590":123671,"_5":14857,"_28357":123562,"_3076":123672},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3624":73806,"_31165":73806,"_5":15217,"_3076":123022,"_31503":123674,"_21590":123675,"_28357":73806},[50900,121699,53584,122844,123022],[],{"_3624":73807,"_31165":73806,"_21590":123677,"_5":14857,"_28357":73806,"_3076":123678},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3624":73808,"_31165":73806,"_5":31500,"_21590":123680,"_28357":123681,"_3076":123682},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3624":73809,"_31165":73806,"_5":31500,"_21590":123684,"_28357":123685,"_3076":123686},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3624":73810,"_31165":73806,"_5":31500,"_21590":123688,"_28357":123689,"_3076":123690},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3624":73811,"_31165":73806,"_21590":123692,"_5":14857,"_28357":73806,"_3076":123693},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3624":73812,"_31165":73806,"_21590":123695,"_5":14857,"_28357":123681,"_3076":123696},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3624":73813,"_31165":73806,"_21590":123698,"_5":14857,"_28357":123681,"_3076":123699},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3624":73814,"_31165":73806,"_21590":123701,"_5":14857,"_28357":123681,"_3076":123702},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3624":73815,"_31165":73806,"_21590":123704,"_5":14857,"_28357":123681,"_3076":123705},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3624":73816,"_31165":73806,"_21590":123707,"_5":14857,"_28357":123681,"_3076":123708},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3624":73817,"_31165":73806,"_21590":123710,"_5":14857,"_28357":123681,"_3076":123711},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3624":73818,"_31165":73806,"_21590":123713,"_5":14857,"_28357":123685,"_3076":123714},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3624":73819,"_31165":73806,"_21590":123716,"_5":14857,"_28357":123685,"_3076":123717},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":73820,"_31165":73806,"_21590":123719,"_5":14857,"_28357":123685,"_3076":123720},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3624":73821,"_31165":73806,"_21590":123722,"_5":14857,"_28357":123685,"_3076":123723},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3624":73822,"_31165":73806,"_21590":123725,"_5":14857,"_28357":123689,"_3076":123726},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3624":73823,"_31165":73806,"_21590":123728,"_5":14857,"_28357":123689,"_3076":123729},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3624":73824,"_31165":73806,"_21590":123731,"_5":14857,"_28357":123689,"_3076":123732},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3624":73825,"_31165":73806,"_21590":123734,"_5":14857,"_28357":123689,"_3076":123735},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3624":73826,"_31165":73806,"_21590":123737,"_5":14857,"_28357":123689,"_3076":123738},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3624":73827,"_31165":73827,"_5":15217,"_3076":123740,"_31503":123741,"_21590":123742,"_28357":73827},"Estrategias de aprovisionamiento",[50900,121699,53584,122844,123022],[],{"_3624":73828,"_31165":73827,"_21590":123744,"_5":14857,"_28357":73827,"_3076":123745},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3624":73829,"_31165":73827,"_5":31500,"_21590":123747,"_28357":123748,"_3076":123749},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3624":73830,"_31165":73827,"_5":31500,"_21590":123751,"_28357":123752,"_3076":123753},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3624":73831,"_31165":73827,"_5":31500,"_21590":123755,"_28357":123756,"_3076":123757},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3624":73832,"_31165":73827,"_5":31500,"_21590":123759,"_28357":123760,"_3076":123761},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3624":73833,"_31165":73827,"_5":31500,"_21590":123763,"_28357":123764,"_3076":123765},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3624":73834,"_31165":73827,"_21590":123767,"_5":14857,"_28357":73827,"_3076":123768},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3624":73835,"_31165":73827,"_21590":123770,"_5":14857,"_28357":123748,"_3076":123771},[],"Recorrido",{"_3624":73836,"_31165":73827,"_21590":123773,"_5":14857,"_28357":123748,"_3076":123774},[],"Cuándo existe el dispositivo",{"_3624":73837,"_31165":73827,"_21590":123776,"_5":14857,"_28357":123748,"_3076":123777},[],"Qué compruebas",{"_3624":73838,"_31165":73827,"_21590":123779,"_5":14857,"_28357":123748,"_3076":123780},[],"Asignación manual",{"_3624":73839,"_31165":73827,"_21590":123782,"_5":14857,"_28357":123748,"_3076":123783},[],"El operador lo crea antes de asociar un certificado.",{"_3624":73840,"_31165":73827,"_21590":123785,"_5":14857,"_28357":123748,"_3076":123786},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3624":73841,"_31165":73827,"_21590":123788,"_5":14857,"_28357":123748,"_3076":123789},[],"EST con `JITP`",{"_3624":73842,"_31165":73827,"_21590":123791,"_5":14857,"_28357":123748,"_3076":123792},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3624":73843,"_31165":73827,"_21590":123794,"_5":14857,"_28357":123748,"_3076":123795},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3624":73844,"_31165":73827,"_21590":123797,"_5":14857,"_28357":123748,"_3076":123798},[],"EST con `PRE_REGISTRATION`",{"_3624":73845,"_31165":73827,"_21590":123800,"_5":14857,"_28357":123748,"_3076":123801},[],"Debe existir antes de `/simpleenroll`.",{"_3624":73846,"_31165":73827,"_21590":123803,"_5":14857,"_28357":123748,"_3076":123804},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3624":73847,"_31165":73827,"_21590":123806,"_5":14857,"_28357":123748,"_3076":123807},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3624":73848,"_31165":73827,"_21590":123809,"_5":14857,"_28357":123748,"_3076":123810},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3624":73849,"_31165":73827,"_21590":123812,"_5":14857,"_28357":123752,"_3076":123813},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3624":73850,"_31165":73827,"_21590":123815,"_5":14857,"_28357":123752,"_3076":123816},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3624":73851,"_31165":73827,"_21590":123818,"_5":14857,"_28357":123752,"_3076":123819},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3624":73852,"_31165":73827,"_21590":123821,"_5":14857,"_28357":123756,"_3076":123822},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3624":73853,"_31165":73827,"_21590":123824,"_5":14857,"_28357":123756,"_3076":123825},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3624":73854,"_31165":73827,"_21590":123827,"_5":14857,"_28357":123756,"_3076":123828},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3624":73855,"_31165":73827,"_21590":123830,"_5":14857,"_28357":123756,"_3076":123831},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3624":73856,"_31165":73827,"_21590":123833,"_5":14857,"_28357":123756,"_3076":123834},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3624":73857,"_31165":73827,"_21590":123836,"_5":14857,"_28357":123756,"_3076":123837},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3624":73858,"_31165":73827,"_21590":123839,"_5":14857,"_28357":123760,"_3076":120597},[],{"_3624":73859,"_31165":73827,"_21590":123841,"_5":14857,"_28357":123760,"_3076":123842},[],"Material que atraviesa EST",{"_3624":73860,"_31165":73827,"_21590":123844,"_5":14857,"_28357":123760,"_3076":123845},[],"Clave generada por el dispositivo",{"_3624":73861,"_31165":73827,"_21590":123847,"_5":14857,"_28357":123760,"_3076":123848},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3624":73862,"_31165":73827,"_21590":123850,"_5":14857,"_28357":123760,"_3076":123851},[],"Clave ya disponible en el dispositivo",{"_3624":73863,"_31165":73827,"_21590":123853,"_5":14857,"_28357":123760,"_3076":123854},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3624":73864,"_31165":73827,"_21590":123856,"_5":14857,"_28357":123760,"_3076":53912},[],{"_3624":73865,"_31165":73827,"_21590":123858,"_5":14857,"_28357":123760,"_3076":123859},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3624":73866,"_31165":73827,"_21590":123861,"_5":14857,"_28357":123760,"_3076":123862},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3624":73867,"_31165":73827,"_21590":123864,"_5":14857,"_28357":123764,"_3076":123865},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3624":73868,"_31165":73868,"_5":15217,"_3076":123867,"_31503":123868,"_21590":123869,"_28357":73868},"Renovación y recuperación",[50900,121699,53584,122844,123022],[],{"_3624":73869,"_31165":73868,"_21590":123871,"_5":14857,"_28357":73868,"_3076":123872},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3624":73870,"_31165":73868,"_5":31500,"_21590":123874,"_28357":123875,"_3076":123876},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3624":73871,"_31165":73868,"_5":31500,"_21590":123878,"_28357":123879,"_3076":123880},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3624":73872,"_31165":73868,"_5":31500,"_21590":123882,"_28357":123883,"_3076":123884},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3624":73873,"_31165":73868,"_5":31500,"_21590":123886,"_28357":123887,"_3076":123888},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3624":73874,"_31165":73868,"_5":31500,"_21590":123890,"_28357":123891,"_3076":123892},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3624":73875,"_31165":73868,"_21590":123894,"_5":14857,"_28357":73868,"_3076":123895},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3624":73876,"_31165":73868,"_21590":123897,"_5":14857,"_28357":123875,"_3076":123898},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3624":73877,"_31165":73868,"_21590":123900,"_5":14857,"_28357":123875,"_3076":123901},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3624":73878,"_31165":73868,"_21590":123903,"_5":14857,"_28357":123875,"_3076":123904},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3624":73879,"_31165":73868,"_21590":123906,"_5":14857,"_28357":123875,"_3076":123907},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3624":73880,"_31165":73868,"_21590":123909,"_5":14857,"_28357":123879,"_3076":123910},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3624":73881,"_31165":73868,"_21590":123912,"_5":14857,"_28357":123879,"_3076":123913},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3624":73882,"_31165":73868,"_21590":123915,"_5":14857,"_28357":123883,"_3076":123916},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3624":73883,"_31165":73868,"_21590":123918,"_5":14857,"_28357":123883,"_3076":123919},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3624":73884,"_31165":73868,"_21590":123921,"_5":14857,"_28357":123883,"_3076":123922},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3624":73885,"_31165":73868,"_21590":123924,"_5":14857,"_28357":123887,"_3076":123925},[],"Situación",{"_3624":73886,"_31165":73868,"_21590":123927,"_5":14857,"_28357":123887,"_3076":123928},[],"Procedimiento",{"_3624":73887,"_31165":73868,"_21590":123930,"_5":14857,"_28357":123887,"_3076":123931},[],"Certificado vigente, fuera de ventana",{"_3624":73888,"_31165":73868,"_21590":123933,"_5":14857,"_28357":123887,"_3076":123934},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3624":73889,"_31165":73868,"_21590":123936,"_5":14857,"_28357":123887,"_3076":123937},[],"Certificado vencido, clave disponible",{"_3624":73890,"_31165":73868,"_21590":123939,"_5":14857,"_28357":123887,"_3076":123940},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3624":73891,"_31165":73868,"_21590":123942,"_5":14857,"_28357":123887,"_3076":123943},[],"Renovación por webhook o `NO_AUTH`",{"_3624":73892,"_31165":73868,"_21590":123945,"_5":14857,"_28357":123887,"_3076":123946},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3624":73893,"_31165":73868,"_21590":123948,"_5":14857,"_28357":123887,"_3076":123949},[],"Clave perdida o inaccesible",{"_3624":73894,"_31165":73868,"_21590":123951,"_5":14857,"_28357":123887,"_3076":123952},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3624":73895,"_31165":73868,"_21590":123954,"_5":14857,"_28357":123887,"_3076":123955},[],"Identidad actual revocada",{"_3624":73896,"_31165":73868,"_21590":123957,"_5":14857,"_28357":123887,"_3076":123958},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3624":73897,"_31165":73868,"_21590":123960,"_5":14857,"_28357":123887,"_3076":123961},[],"Dispositivo sin identidad",{"_3624":73898,"_31165":73868,"_21590":123963,"_5":14857,"_28357":123887,"_3076":123964},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3624":73899,"_31165":73868,"_21590":123966,"_5":14857,"_28357":123887,"_3076":123967},[],"Dispositivo retirado",{"_3624":73900,"_31165":73868,"_21590":123969,"_5":14857,"_28357":123887,"_3076":123970},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3624":73901,"_31165":73868,"_21590":123972,"_5":14857,"_28357":123887,"_3076":123973},[],"Timeout, HTTP 500 o fallo de instalación",{"_3624":73902,"_31165":73868,"_21590":123975,"_5":14857,"_28357":123887,"_3076":123976},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3624":73903,"_31165":73868,"_21590":123978,"_5":14857,"_28357":123891,"_3076":123979},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3624":73904,"_31165":73868,"_21590":123981,"_5":14857,"_28357":123891,"_3076":123982},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3624":73905,"_31165":73905,"_5":15217,"_3076":123984,"_31503":123985,"_21590":123986,"_28357":73905},"Diagnóstico de enrolamiento",[50900,121699,53584,122844,123022],[],{"_3624":73906,"_31165":73905,"_21590":123988,"_5":14857,"_28357":73905,"_3076":123989},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3624":73907,"_31165":73905,"_5":31500,"_21590":123991,"_28357":123992,"_3076":123993},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3624":73908,"_31165":73905,"_5":31500,"_21590":123995,"_28357":123996,"_3076":123997},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3624":73909,"_31165":73905,"_5":31500,"_21590":123999,"_28357":124000,"_3076":123563},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3624":73910,"_31165":73905,"_5":31500,"_21590":124002,"_28357":124003,"_3076":124004},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3624":73911,"_31165":73905,"_21590":124006,"_5":14857,"_28357":73905,"_3076":124007},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3624":73912,"_31165":73905,"_21590":124009,"_5":14857,"_28357":123996,"_3076":124010},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3624":73913,"_31165":73905,"_21590":124012,"_5":14857,"_28357":123996,"_3076":124013},[],"Síntoma o mensaje",{"_3624":73914,"_31165":73905,"_21590":124015,"_5":14857,"_28357":123996,"_3076":124016},[],"Qué revisar",{"_3624":73915,"_31165":73905,"_21590":124018,"_5":14857,"_28357":123996,"_3076":124019},[],"curl rechaza TLS, nombre o emisor",{"_3624":73916,"_31165":73905,"_21590":124021,"_5":14857,"_28357":123996,"_3076":124022},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3624":73917,"_31165":73905,"_21590":124024,"_5":14857,"_28357":123996,"_3076":124025},[],"404 o APS ausente",{"_3624":73918,"_31165":73905,"_21590":124027,"_5":14857,"_28357":123996,"_3076":124028},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3624":73919,"_31165":73905,"_21590":124030,"_5":14857,"_28357":123996,"_3076":124031},[],"400, error de CSR o formato",{"_3624":73920,"_31165":73905,"_21590":124033,"_5":14857,"_28357":123996,"_3076":124034},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3624":73921,"_31165":73905,"_21590":124036,"_5":14857,"_28357":123996,"_3076":124037},[],"Credencial ausente o certificado no válido",{"_3624":73922,"_31165":73905,"_21590":124039,"_5":14857,"_28357":123996,"_3076":124040},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3624":73923,"_31165":73905,"_21590":124042,"_5":14857,"_28357":123996,"_3076":124043},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3624":73924,"_31165":73905,"_21590":124045,"_5":14857,"_28357":123996,"_3076":124046},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3624":73925,"_31165":73905,"_21590":124048,"_5":14857,"_28357":123996,"_3076":124049},[],"Webhook deniega, expira o responde sin autorización",{"_3624":73926,"_31165":73905,"_21590":124051,"_5":14857,"_28357":123996,"_3076":124052},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3624":73927,"_31165":73905,"_21590":124054,"_5":14857,"_28357":123996,"_3076":54840},[],{"_3624":73928,"_31165":73905,"_21590":124056,"_5":14857,"_28357":123996,"_3076":124057},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3624":73929,"_31165":73905,"_21590":124059,"_5":14857,"_28357":123996,"_3076":54846},[],{"_3624":73930,"_31165":73905,"_21590":124061,"_5":14857,"_28357":123996,"_3076":124062},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3624":73931,"_31165":73905,"_21590":124064,"_5":14857,"_28357":123996,"_3076":54852},[],{"_3624":73932,"_31165":73905,"_21590":124066,"_5":14857,"_28357":123996,"_3076":124067},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3624":73933,"_31165":73905,"_21590":124069,"_5":14857,"_28357":123996,"_3076":54858},[],{"_3624":73934,"_31165":73905,"_21590":124071,"_5":14857,"_28357":123996,"_3076":124072},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3624":73935,"_31165":73905,"_21590":124074,"_5":14857,"_28357":123996,"_3076":54864},[],{"_3624":73936,"_31165":73905,"_21590":124076,"_5":14857,"_28357":123996,"_3076":124077},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3624":73937,"_31165":73905,"_21590":124079,"_5":14857,"_28357":123996,"_3076":124080},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3624":73938,"_31165":73905,"_21590":124082,"_5":14857,"_28357":123996,"_3076":124083},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3624":73939,"_31165":73905,"_21590":124085,"_5":14857,"_28357":123996,"_3076":124086},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3624":73940,"_31165":73905,"_21590":124088,"_5":14857,"_28357":123996,"_3076":124089},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3624":73941,"_31165":73905,"_21590":124091,"_5":14857,"_28357":123996,"_3076":54882},[],{"_3624":73942,"_31165":73905,"_21590":124093,"_5":14857,"_28357":123996,"_3076":124094},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3624":73943,"_31165":73905,"_21590":124096,"_5":14857,"_28357":123996,"_3076":54888},[],{"_3624":73944,"_31165":73905,"_21590":124098,"_5":14857,"_28357":123996,"_3076":124099},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3624":73945,"_31165":73905,"_21590":124101,"_5":14857,"_28357":123996,"_3076":124102},[],"DMS propietario distinto",{"_3624":73946,"_31165":73905,"_21590":124104,"_5":14857,"_28357":123996,"_3076":124105},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3624":73947,"_31165":73905,"_21590":124107,"_5":14857,"_28357":123996,"_3076":54900},[],{"_3624":73948,"_31165":73905,"_21590":124109,"_5":14857,"_28357":123996,"_3076":124110},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3624":73949,"_31165":73905,"_21590":124112,"_5":14857,"_28357":123996,"_3076":54906},[],{"_3624":73950,"_31165":73905,"_21590":124114,"_5":14857,"_28357":123996,"_3076":124115},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3624":73951,"_31165":73905,"_21590":124117,"_5":14857,"_28357":123996,"_3076":124118},[],"Certificado actual revocado",{"_3624":73952,"_31165":73905,"_21590":124120,"_5":14857,"_28357":123996,"_3076":124121},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3624":73953,"_31165":73905,"_21590":124123,"_5":14857,"_28357":123996,"_3076":124124},[],"Error de CA, perfil o firma",{"_3624":73954,"_31165":73905,"_21590":124126,"_5":14857,"_28357":123996,"_3076":124127},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3624":73955,"_31165":73905,"_21590":124129,"_5":14857,"_28357":123996,"_3076":124130},[],"HTTP 200 sin conexión del dispositivo",{"_3624":73956,"_31165":73905,"_21590":124132,"_5":14857,"_28357":123996,"_3076":124133},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3624":73957,"_31165":73905,"_21590":124135,"_5":14857,"_28357":123996,"_3076":124136},[],"Timeout o error después de emitir",{"_3624":73958,"_31165":73905,"_21590":124138,"_5":14857,"_28357":123996,"_3076":124139},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3624":73959,"_31165":73905,"_21590":124141,"_5":14857,"_28357":124000,"_3076":124142},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3624":73960,"_31165":73905,"_21590":124144,"_5":14857,"_28357":124000,"_3076":124145},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3624":73961,"_31165":73905,"_21590":124147,"_5":14857,"_28357":124003,"_3076":124148},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3624":73962,"_31165":73905,"_21590":124150,"_5":14857,"_28357":124003,"_3076":124151},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3624":73963,"_31165":73905,"_21590":124153,"_5":14857,"_28357":124003,"_3076":124154},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3624":73964,"_31165":73905,"_21590":124156,"_5":14857,"_28357":124003,"_3076":124157},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3624":73965,"_31165":73905,"_21590":124159,"_5":14857,"_28357":124003,"_3076":124160},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3624":73966,"_31165":73905,"_21590":124162,"_5":14857,"_28357":124003,"_3076":124163},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3624":73967,"_31165":73905,"_21590":124165,"_5":14857,"_28357":124003,"_3076":124166},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3624":73968,"_31165":73968,"_5":15217,"_3076":124168,"_31503":124169,"_21590":124170,"_28357":73968},"Distribución y actualización de confianza",[50900,121699,53584,122844,123022],[],{"_3624":73969,"_31165":73968,"_21590":124172,"_5":14857,"_28357":73968,"_3076":124173},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3624":73970,"_31165":73968,"_5":31500,"_21590":124175,"_28357":124176,"_3076":124177},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3624":73971,"_31165":73968,"_5":31500,"_21590":124179,"_28357":124180,"_3076":124181},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3624":73972,"_31165":73968,"_5":31500,"_21590":124183,"_28357":124184,"_3076":124185},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3624":73973,"_31165":73968,"_5":31500,"_21590":124187,"_28357":124188,"_3076":124189},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3624":73974,"_31165":73968,"_5":31500,"_21590":124191,"_28357":124192,"_3076":124193},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3624":73975,"_31165":73968,"_21590":124195,"_5":14857,"_28357":73968,"_3076":124196},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3624":73976,"_31165":73968,"_21590":124198,"_5":14857,"_28357":124176,"_3076":124199},[],"Relación",{"_3624":73977,"_31165":73968,"_21590":124201,"_5":14857,"_28357":124176,"_3076":124202},[],"Material que prepara el responsable",{"_3624":73978,"_31165":73968,"_21590":124204,"_5":14857,"_28357":124176,"_3076":124205},[],"Dispositivo → servidor EST",{"_3624":73979,"_31165":73968,"_21590":124207,"_5":14857,"_28357":124176,"_3076":124208},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3624":73980,"_31165":73968,"_21590":124210,"_5":14857,"_28357":124176,"_3076":124211},[],"DMS → solicitante",{"_3624":73981,"_31165":73968,"_21590":124213,"_5":14857,"_28357":124176,"_3076":124214},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3624":73982,"_31165":73968,"_21590":124216,"_5":14857,"_28357":124176,"_3076":124217},[],"Consumidor → dispositivo",{"_3624":73983,"_31165":73968,"_21590":124219,"_5":14857,"_28357":124176,"_3076":124220},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3624":73984,"_31165":73968,"_21590":124222,"_5":14857,"_28357":124176,"_3076":124223},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3624":73985,"_31165":73968,"_21590":124225,"_5":14857,"_28357":124180,"_3076":124226},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3624":73986,"_31165":73968,"_21590":124228,"_5":14857,"_28357":124180,"_3076":124229},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3624":73987,"_31165":73968,"_21590":124231,"_5":14857,"_28357":124184,"_3076":124232},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3624":73988,"_31165":73968,"_21590":124234,"_5":14857,"_28357":124184,"_3076":124235},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3624":73989,"_31165":73968,"_21590":124237,"_5":14857,"_28357":124184,"_3076":124238},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3624":73990,"_31165":73968,"_21590":124240,"_5":14857,"_28357":124184,"_3076":124241},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3624":73991,"_31165":73968,"_21590":124243,"_5":14857,"_28357":124184,"_3076":124244},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3624":73992,"_31165":73968,"_21590":124246,"_5":14857,"_28357":124184,"_3076":124247},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3624":73993,"_31165":73968,"_21590":124249,"_5":14857,"_28357":124188,"_3076":124250},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3624":73994,"_31165":73968,"_21590":124252,"_5":14857,"_28357":124188,"_3076":124253},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3624":73995,"_31165":73968,"_21590":124255,"_5":14857,"_28357":124188,"_3076":124256},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3624":73996,"_31165":73968,"_21590":124258,"_5":14857,"_28357":124192,"_3076":124259},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3624":73997,"_31165":73997,"_5":15217,"_3076":55055,"_31503":124261,"_21590":124263,"_28357":73997},[50900,121699,53584,122844,124262],"Integraciones",[],{"_3624":73998,"_31165":73997,"_21590":124265,"_5":14857,"_28357":73997,"_3076":124266},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3624":73999,"_31165":73997,"_5":31500,"_21590":124268,"_28357":124269,"_3076":124270},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3624":74000,"_31165":73997,"_5":31500,"_21590":124272,"_28357":124273,"_3076":124274},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3624":74001,"_31165":73997,"_5":31500,"_21590":124276,"_28357":124277,"_3076":124278},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3624":74002,"_31165":73997,"_5":31500,"_21590":124280,"_28357":124281,"_3076":124282},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3624":74003,"_31165":73997,"_5":31500,"_21590":124284,"_28357":124285,"_3076":124286},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3624":74004,"_31165":73997,"_5":31500,"_21590":124288,"_28357":124289,"_3076":124290},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3624":74005,"_31165":73997,"_5":31500,"_21590":124292,"_28357":124293,"_3076":124294},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3624":74006,"_31165":73997,"_5":31500,"_21590":124296,"_28357":124297,"_3076":124298},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3624":74007,"_31165":73997,"_5":31500,"_21590":124300,"_28357":124301,"_3076":55097},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3624":74008,"_31165":73997,"_5":31500,"_21590":124303,"_28357":124304,"_3076":55101},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3624":74009,"_31165":73997,"_5":31500,"_21590":124306,"_28357":124307,"_3076":124308},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3624":74010,"_31165":73997,"_5":31500,"_21590":124310,"_28357":124311,"_3076":124312},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3624":74011,"_31165":73997,"_5":31500,"_21590":124314,"_28357":124315,"_3076":124316},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3624":74012,"_31165":73997,"_5":31500,"_21590":124318,"_28357":124319,"_3076":124320},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3624":74013,"_31165":73997,"_5":31500,"_21590":124322,"_28357":124323,"_3076":124324},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3624":74014,"_31165":73997,"_5":31500,"_21590":124326,"_28357":124327,"_3076":124328},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3624":74015,"_31165":73997,"_5":31500,"_21590":124330,"_28357":124331,"_3076":124332},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3624":74016,"_31165":73997,"_5":31500,"_21590":124334,"_28357":124335,"_3076":124336},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3624":74017,"_31165":73997,"_5":31500,"_21590":124338,"_28357":124339,"_3076":124340},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3624":74018,"_31165":73997,"_5":31500,"_21590":124342,"_28357":124343,"_3076":124344},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3624":74019,"_31165":73997,"_5":31500,"_21590":124346,"_28357":124347,"_3076":124348},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3624":74020,"_31165":73997,"_5":31500,"_21590":124350,"_28357":124351,"_3076":124352},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3624":74021,"_31165":73997,"_5":31500,"_21590":124354,"_28357":124355,"_3076":124356},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3624":74022,"_31165":73997,"_5":31500,"_21590":124358,"_28357":124359,"_3076":124360},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3624":74023,"_31165":73997,"_5":31500,"_21590":124362,"_28357":124363,"_3076":124364},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3624":74024,"_31165":73997,"_21590":124366,"_5":14857,"_28357":73997,"_3076":124367},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3624":74025,"_31165":73997,"_21590":124369,"_5":14857,"_28357":73997,"_3076":124370},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3624":74026,"_31165":73997,"_21590":124372,"_5":14857,"_28357":73997,"_3076":124373},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3624":74027,"_31165":73997,"_21590":124375,"_5":14857,"_28357":124269,"_3076":124376},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3624":74028,"_31165":73997,"_21590":124378,"_5":14857,"_28357":124269,"_3076":124379},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3624":74029,"_31165":73997,"_21590":124381,"_5":14857,"_28357":124269,"_3076":124382},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3624":74030,"_31165":73997,"_21590":124384,"_5":14857,"_28357":124269,"_3076":124385},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3624":74031,"_31165":73997,"_21590":124387,"_5":14857,"_28357":124273,"_3076":124388},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3624":74032,"_31165":73997,"_21590":124390,"_5":14857,"_28357":124277,"_3076":124391},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3624":74033,"_31165":73997,"_21590":124393,"_5":14857,"_28357":124277,"_3076":124394},[],"Acción IAM",{"_3624":74034,"_31165":73997,"_21590":124396,"_5":14857,"_28357":124277,"_3076":120603},[],{"_3624":74035,"_31165":73997,"_21590":124398,"_5":14857,"_28357":124277,"_3076":55196},[],{"_3624":74036,"_31165":73997,"_21590":124400,"_5":14857,"_28357":124277,"_3076":124401},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3624":74037,"_31165":73997,"_21590":124403,"_5":14857,"_28357":124277,"_3076":55202},[],{"_3624":74038,"_31165":73997,"_21590":124405,"_5":14857,"_28357":124277,"_3076":124406},[],"Registrar la CA en AWS IoT",{"_3624":74039,"_31165":73997,"_21590":124408,"_5":14857,"_28357":124277,"_3076":55208},[],{"_3624":74040,"_31165":73997,"_21590":124410,"_5":14857,"_28357":124277,"_3076":124411},[],"Consultar el estado del registro de la CA",{"_3624":74041,"_31165":73997,"_21590":124413,"_5":14857,"_28357":124277,"_3076":55214},[],{"_3624":74042,"_31165":73997,"_21590":124415,"_5":14857,"_28357":124277,"_3076":124416},[],"Crear o actualizar Things en IoT Core",{"_3624":74043,"_31165":73997,"_21590":124418,"_5":14857,"_28357":124277,"_3076":55220},[],{"_3624":74044,"_31165":73997,"_21590":124420,"_5":14857,"_28357":124277,"_3076":124421},[],"Aprovisionar Things mediante plantilla",{"_3624":74045,"_31165":73997,"_21590":124423,"_5":14857,"_28357":124277,"_3076":55226},[],{"_3624":74046,"_31165":73997,"_21590":124425,"_5":14857,"_28357":124277,"_3076":124426},[],"Registrar certificados de dispositivo",{"_3624":74047,"_31165":73997,"_21590":124428,"_5":14857,"_28357":124277,"_3076":55232},[],{"_3624":74048,"_31165":73997,"_21590":124430,"_5":14857,"_28357":124277,"_3076":124431},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3624":74049,"_31165":73997,"_21590":124433,"_5":14857,"_28357":124277,"_3076":55238},[],{"_3624":74050,"_31165":73997,"_21590":124435,"_5":14857,"_28357":124277,"_3076":124436},[],"Crear y adjuntar políticas IoT",{"_3624":74051,"_31165":73997,"_21590":124438,"_5":14857,"_28357":124277,"_3076":55244},[],{"_3624":74052,"_31165":73997,"_21590":124440,"_5":14857,"_28357":124277,"_3076":124441},[],"Gestionar grupos de Things",{"_3624":74053,"_31165":73997,"_21590":124443,"_5":14857,"_28357":124277,"_3076":55250},[],{"_3624":74054,"_31165":73997,"_21590":124445,"_5":14857,"_28357":124277,"_3076":124446},[],"Crear plantillas JITP",{"_3624":74055,"_31165":73997,"_21590":124448,"_5":14857,"_28357":124277,"_3076":55256},[],{"_3624":74056,"_31165":73997,"_21590":124450,"_5":14857,"_28357":124277,"_3076":124451},[],"Leer y escribir el Device Shadow",{"_3624":74057,"_31165":73997,"_21590":124453,"_5":14857,"_28357":124277,"_3076":124454},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3624":74058,"_31165":73997,"_21590":124456,"_5":14857,"_28357":124281,"_3076":124457},[],"Parámetro",{"_3624":74059,"_31165":73997,"_21590":124459,"_5":14857,"_28357":124281,"_3076":124460},[],"Tipo",{"_3624":74060,"_31165":73997,"_21590":124462,"_5":14857,"_28357":124281,"_3076":124463},[],"Requerido",{"_3624":74061,"_31165":73997,"_21590":124465,"_5":14857,"_28357":124281,"_3076":124466},[],"Descripción",{"_3624":74062,"_31165":73997,"_21590":124468,"_5":14857,"_28357":124281,"_3076":55277},[],{"_3624":74063,"_31165":73997,"_21590":124470,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74064,"_31165":73997,"_21590":124472,"_5":14857,"_28357":124281,"_3076":124473},[],"Sí",{"_3624":74065,"_31165":73997,"_21590":124475,"_5":14857,"_28357":124281,"_3076":124476},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3624":74066,"_31165":73997,"_21590":124478,"_5":14857,"_28357":124281,"_3076":55288},[],{"_3624":74067,"_31165":73997,"_21590":124480,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74068,"_31165":73997,"_21590":124482,"_5":14857,"_28357":124281,"_3076":124473},[],{"_3624":74069,"_31165":73997,"_21590":124484,"_5":14857,"_28357":124281,"_3076":124485},[],"Región AWS donde opera el conector.",{"_3624":74070,"_31165":73997,"_21590":124487,"_5":14857,"_28357":124281,"_3076":55298},[],{"_3624":74071,"_31165":73997,"_21590":124489,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74072,"_31165":73997,"_21590":124491,"_5":14857,"_28357":124281,"_3076":124473},[],{"_3624":74073,"_31165":73997,"_21590":124493,"_5":14857,"_28357":124281,"_3076":124494},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3624":74074,"_31165":73997,"_21590":124496,"_5":14857,"_28357":124281,"_3076":55308},[],{"_3624":74075,"_31165":73997,"_21590":124498,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74076,"_31165":73997,"_21590":124500,"_5":14857,"_28357":124281,"_3076":124501},[],"Solo con `auth_method=static`",{"_3624":74077,"_31165":73997,"_21590":124503,"_5":14857,"_28357":124281,"_3076":124504},[],"Clave de acceso AWS.",{"_3624":74078,"_31165":73997,"_21590":124506,"_5":14857,"_28357":124281,"_3076":55319},[],{"_3624":74079,"_31165":73997,"_21590":124508,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74080,"_31165":73997,"_21590":124510,"_5":14857,"_28357":124281,"_3076":124501},[],{"_3624":74081,"_31165":73997,"_21590":124512,"_5":14857,"_28357":124281,"_3076":124513},[],"Clave secreta AWS.",{"_3624":74082,"_31165":73997,"_21590":124515,"_5":14857,"_28357":124281,"_3076":55329},[],{"_3624":74083,"_31165":73997,"_21590":124517,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74084,"_31165":73997,"_21590":124519,"_5":14857,"_28357":124281,"_3076":55334},[],{"_3624":74085,"_31165":73997,"_21590":124521,"_5":14857,"_28357":124281,"_3076":124522},[],"Token de sesión (con `auth_method=static`).",{"_3624":74086,"_31165":73997,"_21590":124524,"_5":14857,"_28357":124281,"_3076":55340},[],{"_3624":74087,"_31165":73997,"_21590":124526,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74088,"_31165":73997,"_21590":124528,"_5":14857,"_28357":124281,"_3076":124529},[],"Solo con `auth_method=role`",{"_3624":74089,"_31165":73997,"_21590":124531,"_5":14857,"_28357":124281,"_3076":124532},[],"ARN del rol a asumir.",{"_3624":74090,"_31165":73997,"_21590":124534,"_5":14857,"_28357":124281,"_3076":55351},[],{"_3624":74091,"_31165":73997,"_21590":124536,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74092,"_31165":73997,"_21590":124538,"_5":14857,"_28357":124281,"_3076":55334},[],{"_3624":74093,"_31165":73997,"_21590":124540,"_5":14857,"_28357":124281,"_3076":124541},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3624":74094,"_31165":73997,"_21590":124543,"_5":14857,"_28357":124281,"_3076":55361},[],{"_3624":74095,"_31165":73997,"_21590":124545,"_5":14857,"_28357":124281,"_3076":92827},[],{"_3624":74096,"_31165":73997,"_21590":124547,"_5":14857,"_28357":124281,"_3076":124473},[],{"_3624":74097,"_31165":73997,"_21590":124549,"_5":14857,"_28357":124281,"_3076":124550},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3624":74098,"_31165":73997,"_21590":124552,"_5":14857,"_28357":124281,"_3076":55371},[],{"_3624":74099,"_31165":73997,"_21590":124554,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74100,"_31165":73997,"_21590":124556,"_5":14857,"_28357":124281,"_3076":124473},[],{"_3624":74101,"_31165":73997,"_21590":124558,"_5":14857,"_28357":124281,"_3076":124559},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3624":74102,"_31165":73997,"_21590":124561,"_5":14857,"_28357":124281,"_3076":55381},[],{"_3624":74103,"_31165":73997,"_21590":124563,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74104,"_31165":73997,"_21590":124565,"_5":14857,"_28357":124281,"_3076":124473},[],{"_3624":74105,"_31165":73997,"_21590":124567,"_5":14857,"_28357":124281,"_3076":124568},[],"URL HTTP del Device Manager de Lamassu.",{"_3624":74106,"_31165":73997,"_21590":124570,"_5":14857,"_28357":124281,"_3076":55391},[],{"_3624":74107,"_31165":73997,"_21590":124572,"_5":14857,"_28357":124281,"_3076":25776},[],{"_3624":74108,"_31165":73997,"_21590":124574,"_5":14857,"_28357":124281,"_3076":124473},[],{"_3624":74109,"_31165":73997,"_21590":124576,"_5":14857,"_28357":124281,"_3076":124577},[],"URL HTTP del servicio de CA de Lamassu.",{"_3624":74110,"_31165":73997,"_21590":124579,"_5":14857,"_28357":124285,"_3076":124580},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3624":74111,"_31165":73997,"_21590":124582,"_5":14857,"_28357":124285,"_3076":124583},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3624":74112,"_31165":73997,"_21590":124585,"_5":14857,"_28357":124285,"_3076":124586},[],"Tipo de CloudEvent",{"_3624":74113,"_31165":73997,"_21590":124588,"_5":14857,"_28357":124285,"_3076":124589},[],"Recurso en Lamassu",{"_3624":74114,"_31165":73997,"_21590":124591,"_5":14857,"_28357":124285,"_3076":124592},[],"Recurso AWS",{"_3624":74115,"_31165":73997,"_21590":124594,"_5":14857,"_28357":124285,"_3076":124595},[],"Acciones IAM",{"_3624":74116,"_31165":73997,"_21590":124597,"_5":14857,"_28357":124285,"_3076":124598},[],"Llamadas AWS y efecto",{"_3624":74117,"_31165":73997,"_21590":124600,"_5":14857,"_28357":124285,"_3076":124601},[],"Dónde en esta página",{"_3624":74118,"_31165":73997,"_21590":124603,"_5":14857,"_28357":124285,"_3076":55425},[],{"_3624":74119,"_31165":73997,"_21590":124605,"_5":14857,"_28357":124285,"_3076":55428},[],{"_3624":74120,"_31165":73997,"_21590":124607,"_5":14857,"_28357":124285,"_3076":55431},[],{"_3624":74121,"_31165":73997,"_21590":124609,"_5":14857,"_28357":124285,"_3076":55434},[],{"_3624":74122,"_31165":73997,"_21590":124611,"_5":14857,"_28357":124285,"_3076":124612},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3624":74123,"_31165":73997,"_21590":124614,"_5":14857,"_28357":124285,"_3076":124298},[],{"_3624":74124,"_31165":73997,"_21590":124616,"_5":14857,"_28357":124285,"_3076":55442},[],{"_3624":74125,"_31165":73997,"_21590":124618,"_5":14857,"_28357":124285,"_3076":55445},[],{"_3624":74126,"_31165":73997,"_21590":124620,"_5":14857,"_28357":124285,"_3076":55448},[],{"_3624":74127,"_31165":73997,"_21590":124622,"_5":14857,"_28357":124285,"_3076":55451},[],{"_3624":74128,"_31165":73997,"_21590":124624,"_5":14857,"_28357":124285,"_3076":124625},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3624":74129,"_31165":73997,"_21590":124627,"_5":14857,"_28357":124285,"_3076":124324},[],{"_3624":74130,"_31165":73997,"_21590":124629,"_5":14857,"_28357":124285,"_3076":55459},[],{"_3624":74131,"_31165":73997,"_21590":124631,"_5":14857,"_28357":124285,"_3076":124632},[],"Dispositivo",{"_3624":74132,"_31165":73997,"_21590":124634,"_5":14857,"_28357":124285,"_3076":55465},[],{"_3624":74133,"_31165":73997,"_21590":124636,"_5":14857,"_28357":124285,"_3076":55468},[],{"_3624":74134,"_31165":73997,"_21590":124638,"_5":14857,"_28357":124285,"_3076":124639},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3624":74135,"_31165":73997,"_21590":124641,"_5":14857,"_28357":124285,"_3076":124332},[],{"_3624":74136,"_31165":73997,"_21590":124643,"_5":14857,"_28357":124285,"_3076":55476},[],{"_3624":74137,"_31165":73997,"_21590":124645,"_5":14857,"_28357":124285,"_3076":124646},[],"Certificado",{"_3624":74138,"_31165":73997,"_21590":124648,"_5":14857,"_28357":124285,"_3076":55482},[],{"_3624":74139,"_31165":73997,"_21590":124650,"_5":14857,"_28357":124285,"_3076":124651},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3624":74140,"_31165":73997,"_21590":124653,"_5":14857,"_28357":124285,"_3076":124654},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3624":74141,"_31165":73997,"_21590":124656,"_5":14857,"_28357":124285,"_3076":124344},[],{"_3624":74142,"_31165":73997,"_21590":124658,"_5":14857,"_28357":124285,"_3076":55493},[],{"_3624":74143,"_31165":73997,"_21590":124660,"_5":14857,"_28357":124285,"_3076":124661},[],"Certificado / Dispositivo",{"_3624":74144,"_31165":73997,"_21590":124663,"_5":14857,"_28357":124285,"_3076":55499},[],{"_3624":74145,"_31165":73997,"_21590":124665,"_5":14857,"_28357":124285,"_3076":51296},[],{"_3624":74146,"_31165":73997,"_21590":124667,"_5":14857,"_28357":124285,"_3076":124668},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3624":74147,"_31165":73997,"_21590":124670,"_5":14857,"_28357":124285,"_3076":124352},[],{"_3624":74148,"_31165":73997,"_21590":124672,"_5":14857,"_28357":124289,"_3076":124673},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3624":74149,"_31165":73997,"_21590":124675,"_5":14857,"_28357":124293,"_3076":124676},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3624":74150,"_31165":73997,"_21590":124678,"_5":14857,"_28357":124293,"_3076":124679},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3624":74151,"_31165":73997,"_21590":124681,"_5":14857,"_28357":124297,"_3076":124682},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3624":74152,"_31165":73997,"_21590":124684,"_5":14857,"_28357":124297,"_3076":124685},[],"Transición",{"_3624":74153,"_31165":73997,"_21590":124687,"_5":14857,"_28357":124297,"_3076":124688},[],"Llamadas AWS",{"_3624":74154,"_31165":73997,"_21590":124690,"_5":14857,"_28357":124297,"_3076":124691},[],"`NoRegistrada` → `Solicitada`",{"_3624":74155,"_31165":73997,"_21590":124693,"_5":14857,"_28357":124297,"_3076":124694},[],"ninguna (solo escritura de metadatos)",{"_3624":74156,"_31165":73997,"_21590":124696,"_5":14857,"_28357":124297,"_3076":124697},[],"`Solicitada` → `Registrando`",{"_3624":74157,"_31165":73997,"_21590":124699,"_5":14857,"_28357":124297,"_3076":124700},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3624":74158,"_31165":73997,"_21590":124702,"_5":14857,"_28357":124297,"_3076":124703},[],"`Registrando` → `Completada`",{"_3624":74159,"_31165":73997,"_21590":124705,"_5":14857,"_28357":124297,"_3076":124706},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3624":74160,"_31165":73997,"_21590":124708,"_5":14857,"_28357":124297,"_3076":124709},[],"`Registrando` → `Fallida`",{"_3624":74161,"_31165":73997,"_21590":124711,"_5":14857,"_28357":124297,"_3076":124712},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3624":74162,"_31165":73997,"_21590":124714,"_5":14857,"_28357":124297,"_3076":124715},[],"`Fallida` / `Completada` → `Solicitada`",{"_3624":74163,"_31165":73997,"_21590":124717,"_5":14857,"_28357":124297,"_3076":124718},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3624":74164,"_31165":73997,"_21590":124720,"_5":14857,"_28357":124301,"_3076":124721},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3624":74165,"_31165":73997,"_21590":124723,"_5":14857,"_28357":124301,"_3076":124724},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3624":74166,"_31165":73997,"_21590":124726,"_5":14857,"_28357":124301,"_3076":124727},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3624":74167,"_31165":73997,"_21590":124729,"_5":14857,"_28357":124301,"_3076":124730},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3624":74168,"_31165":73997,"_21590":124732,"_5":14857,"_28357":124301,"_3076":124733},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3624":74169,"_31165":73997,"_21590":124735,"_5":14857,"_28357":124301,"_3076":124736},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3624":74170,"_31165":73997,"_21590":124738,"_5":14857,"_28357":124304,"_3076":124739},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3624":74171,"_31165":73997,"_21590":124741,"_5":14857,"_28357":124307,"_3076":124742},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3624":74172,"_31165":73997,"_21590":124744,"_5":14857,"_28357":124307,"_3076":124745},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3624":74173,"_31165":73997,"_21590":124747,"_5":14857,"_28357":124311,"_3076":124748},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3624":74174,"_31165":73997,"_21590":124750,"_5":14857,"_28357":124315,"_3076":124751},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3624":74175,"_31165":73997,"_21590":124753,"_5":14857,"_28357":124315,"_3076":124754},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3624":74176,"_31165":73997,"_21590":124756,"_5":14857,"_28357":124315,"_3076":124757},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3624":74177,"_31165":73997,"_21590":124759,"_5":14857,"_28357":124315,"_3076":124760},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3624":74178,"_31165":73997,"_21590":124762,"_5":14857,"_28357":124315,"_3076":124763},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3624":74179,"_31165":73997,"_21590":124765,"_5":14857,"_28357":124315,"_3076":124766},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3624":74180,"_31165":73997,"_21590":124768,"_5":14857,"_28357":124319,"_3076":124769},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3624":74181,"_31165":73997,"_21590":124771,"_5":14857,"_28357":124319,"_3076":124772},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3624":74182,"_31165":73997,"_21590":124774,"_5":14857,"_28357":124319,"_3076":124775},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3624":74183,"_31165":73997,"_21590":124777,"_5":14857,"_28357":124319,"_3076":124778},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3624":74184,"_31165":73997,"_21590":124780,"_5":14857,"_28357":124319,"_3076":124781},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3624":74185,"_31165":73997,"_21590":124783,"_5":14857,"_28357":124323,"_3076":124784},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3624":74186,"_31165":73997,"_21590":124786,"_5":14857,"_28357":124323,"_3076":124685},[],{"_3624":74187,"_31165":73997,"_21590":124788,"_5":14857,"_28357":124323,"_3076":124688},[],{"_3624":74188,"_31165":73997,"_21590":124790,"_5":14857,"_28357":124323,"_3076":124791},[],"`SinConfigurar` → `None` / `Auto`",{"_3624":74189,"_31165":73997,"_21590":124793,"_5":14857,"_28357":124323,"_3076":124794},[],"ninguna (solo configuración)",{"_3624":74190,"_31165":73997,"_21590":124796,"_5":14857,"_28357":124323,"_3076":55636},[],{"_3624":74191,"_31165":73997,"_21590":124798,"_5":14857,"_28357":124323,"_3076":124794},[],{"_3624":74192,"_31165":73997,"_21590":124800,"_5":14857,"_28357":124323,"_3076":124801},[],"Cualquiera → `Jitp`",{"_3624":74193,"_31165":73997,"_21590":124803,"_5":14857,"_28357":124323,"_3076":124804},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3624":74194,"_31165":73997,"_21590":124806,"_5":14857,"_28357":124323,"_3076":55647},[],{"_3624":74195,"_31165":73997,"_21590":124808,"_5":14857,"_28357":124323,"_3076":124809},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3624":74196,"_31165":73997,"_21590":124811,"_5":14857,"_28357":124327,"_3076":124812},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3624":74197,"_31165":73997,"_21590":124814,"_5":14857,"_28357":124327,"_3076":124815},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3624":74198,"_31165":73997,"_21590":124817,"_5":14857,"_28357":124327,"_3076":124818},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3624":74199,"_31165":73997,"_21590":124820,"_5":14857,"_28357":124331,"_3076":124821},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3624":74200,"_31165":73997,"_21590":124823,"_5":14857,"_28357":124331,"_3076":124685},[],{"_3624":74201,"_31165":73997,"_21590":124825,"_5":14857,"_28357":124331,"_3076":124688},[],{"_3624":74202,"_31165":73997,"_21590":124827,"_5":14857,"_28357":124331,"_3076":124828},[],"`Ausente` → `Aprovisionado`",{"_3624":74203,"_31165":73997,"_21590":124830,"_5":14857,"_28357":124331,"_3076":124831},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3624":74204,"_31165":73997,"_21590":124833,"_5":14857,"_28357":124331,"_3076":124834},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3624":74205,"_31165":73997,"_21590":124836,"_5":14857,"_28357":124331,"_3076":124837},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3624":74206,"_31165":73997,"_21590":124839,"_5":14857,"_28357":124331,"_3076":124840},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3624":74207,"_31165":73997,"_21590":124842,"_5":14857,"_28357":124335,"_3076":124843},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3624":74208,"_31165":73997,"_21590":124845,"_5":14857,"_28357":124335,"_3076":124846},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3624":74209,"_31165":73997,"_21590":124848,"_5":14857,"_28357":124335,"_3076":124849},[],"Para que el flujo JITP funcione correctamente:",{"_3624":74210,"_31165":73997,"_21590":124851,"_5":14857,"_28357":124335,"_3076":124852},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3624":74211,"_31165":73997,"_21590":124854,"_5":14857,"_28357":124335,"_3076":124855},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3624":74212,"_31165":73997,"_21590":124857,"_5":14857,"_28357":124335,"_3076":124858},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3624":74213,"_31165":73997,"_21590":124860,"_5":14857,"_28357":124335,"_3076":124861},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3624":74214,"_31165":73997,"_21590":124863,"_5":14857,"_28357":124339,"_3076":124864},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3624":74215,"_31165":73997,"_21590":124866,"_5":14857,"_28357":124339,"_3076":124867},[],"Estado en Lamassu",{"_3624":74216,"_31165":73997,"_21590":124869,"_5":14857,"_28357":124339,"_3076":124870},[],"Razón de revocación",{"_3624":74217,"_31165":73997,"_21590":124872,"_5":14857,"_28357":124339,"_3076":124873},[],"Estado en AWS IoT Core",{"_3624":74218,"_31165":73997,"_21590":124875,"_5":14857,"_28357":124339,"_3076":55717},[],{"_3624":74219,"_31165":73997,"_21590":124877,"_5":14857,"_28357":124339,"_3076":124878},[],"Ninguna",{"_3624":74220,"_31165":73997,"_21590":124880,"_5":14857,"_28357":124339,"_3076":55723},[],{"_3624":74221,"_31165":73997,"_21590":124882,"_5":14857,"_28357":124339,"_3076":55726},[],{"_3624":74222,"_31165":73997,"_21590":124884,"_5":14857,"_28357":124339,"_3076":55729},[],{"_3624":74223,"_31165":73997,"_21590":124886,"_5":14857,"_28357":124339,"_3076":55732},[],{"_3624":74224,"_31165":73997,"_21590":124888,"_5":14857,"_28357":124339,"_3076":55726},[],{"_3624":74225,"_31165":73997,"_21590":124890,"_5":14857,"_28357":124339,"_3076":124891},[],"Cualquier otra razón",{"_3624":74226,"_31165":73997,"_21590":124893,"_5":14857,"_28357":124339,"_3076":55740},[],{"_3624":74227,"_31165":73997,"_21590":124895,"_5":14857,"_28357":124339,"_3076":124896},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3624":74228,"_31165":73997,"_21590":124898,"_5":14857,"_28357":124343,"_3076":124899},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3624":74229,"_31165":73997,"_21590":124901,"_5":14857,"_28357":124343,"_3076":124685},[],{"_3624":74230,"_31165":73997,"_21590":124903,"_5":14857,"_28357":124343,"_3076":124688},[],{"_3624":74231,"_31165":73997,"_21590":124905,"_5":14857,"_28357":124343,"_3076":124906},[],"`NoSincronizado` → `Active`",{"_3624":74232,"_31165":73997,"_21590":124908,"_5":14857,"_28357":124343,"_3076":55232},[],{"_3624":74233,"_31165":73997,"_21590":124910,"_5":14857,"_28357":124343,"_3076":55758},[],{"_3624":74234,"_31165":73997,"_21590":124912,"_5":14857,"_28357":124343,"_3076":124913},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3624":74235,"_31165":73997,"_21590":124915,"_5":14857,"_28357":124343,"_3076":55764},[],{"_3624":74236,"_31165":73997,"_21590":124917,"_5":14857,"_28357":124343,"_3076":124913},[],{"_3624":74237,"_31165":73997,"_21590":124919,"_5":14857,"_28357":124343,"_3076":55769},[],{"_3624":74238,"_31165":73997,"_21590":124921,"_5":14857,"_28357":124343,"_3076":55232},[],{"_3624":74239,"_31165":73997,"_21590":124923,"_5":14857,"_28357":124343,"_3076":55774},[],{"_3624":74240,"_31165":73997,"_21590":124925,"_5":14857,"_28357":124343,"_3076":124926},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3624":74241,"_31165":73997,"_21590":124928,"_5":14857,"_28357":124347,"_3076":124929},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3624":74242,"_31165":73997,"_21590":124931,"_5":14857,"_28357":124347,"_3076":124932},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3624":74243,"_31165":73997,"_21590":124934,"_5":14857,"_28357":124347,"_3076":124935},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3624":74244,"_31165":73997,"_21590":124937,"_5":14857,"_28357":124351,"_3076":124938},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3624":74245,"_31165":73997,"_21590":124940,"_5":14857,"_28357":124351,"_3076":124941},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3624":74246,"_31165":73997,"_21590":124943,"_5":14857,"_28357":124355,"_3076":124944},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3624":74247,"_31165":73997,"_21590":124946,"_5":14857,"_28357":124355,"_3076":124947},[],"Existen dos tipos de acciones:",{"_3624":74248,"_31165":73997,"_21590":124949,"_5":14857,"_28357":124355,"_3076":124950},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3624":74249,"_31165":73997,"_21590":124952,"_5":14857,"_28357":124355,"_3076":124953},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3624":74250,"_31165":73997,"_21590":124955,"_5":14857,"_28357":124355,"_3076":124956},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3624":74251,"_31165":73997,"_21590":124958,"_5":14857,"_28357":124359,"_3076":124959},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3624":74252,"_31165":73997,"_21590":124961,"_5":14857,"_28357":124359,"_3076":124962},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3624":74253,"_31165":73997,"_21590":124964,"_5":14857,"_28357":124359,"_3076":124965},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3624":74254,"_31165":73997,"_21590":124967,"_5":14857,"_28357":124363,"_3076":124968},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3624":74255,"_31165":73997,"_21590":124970,"_5":14857,"_28357":124363,"_3076":124971},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3624":74256,"_31165":73997,"_21590":124973,"_5":14857,"_28357":124363,"_3076":124974},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3624":74257,"_31165":73997,"_21590":124976,"_5":14857,"_28357":124363,"_3076":124977},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3624":74258,"_31165":73997,"_21590":124979,"_5":14857,"_28357":124363,"_3076":124980},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3624":74259,"_31165":73997,"_21590":124982,"_5":14857,"_28357":124363,"_3076":124983},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3624":74260,"_31165":73997,"_21590":124985,"_5":14857,"_28357":124363,"_3076":124986},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3624":74261,"_31165":73997,"_21590":124988,"_5":14857,"_28357":124363,"_3076":124989},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3624":74262,"_31165":73997,"_21590":124991,"_5":14857,"_28357":124363,"_3076":124992},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3624":74263,"_31165":73997,"_21590":124994,"_5":14857,"_28357":124363,"_3076":124995},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3624":74264,"_31165":73997,"_21590":124997,"_5":14857,"_28357":124363,"_3076":124998},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3624":74265,"_31165":73997,"_21590":125000,"_5":14857,"_28357":124363,"_3076":125001},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3624":74266,"_31165":73997,"_21590":125003,"_5":14857,"_28357":124363,"_3076":125004},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3624":74267,"_31165":73997,"_21590":125006,"_5":14857,"_28357":124363,"_3076":125007},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3624":74268,"_31165":73997,"_21590":125009,"_5":14857,"_28357":124363,"_3076":125010},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3624":74269,"_31165":73997,"_21590":125012,"_5":14857,"_28357":124363,"_3076":125013},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3624":74270,"_31165":73997,"_21590":125015,"_5":14857,"_28357":124363,"_3076":125016},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3624":74271,"_31165":73997,"_21590":125018,"_5":14857,"_28357":124363,"_3076":125019},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3624":74272,"_31165":73997,"_21590":125021,"_5":14857,"_28357":124363,"_3076":125022},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3624":74273,"_31165":73997,"_21590":125024,"_5":14857,"_28357":124363,"_3076":125025},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3624":74274,"_31165":73997,"_21590":125027,"_5":14857,"_28357":124363,"_3076":125028},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3624":74275,"_31165":73997,"_21590":125030,"_5":14857,"_28357":124363,"_3076":125031},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":74276,"_31165":73997,"_21590":125033,"_5":14857,"_28357":124363,"_3076":125034},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3624":74277,"_31165":73997,"_21590":125036,"_5":14857,"_28357":124363,"_3076":125037},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3624":74278,"_31165":74278,"_5":15217,"_3076":53584,"_31503":125039,"_21590":125040,"_28357":74278},[50900,121699,53584],[],{"_3624":74279,"_31165":74278,"_21590":125042,"_5":14857,"_28357":74278,"_3076":125043},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3624":74280,"_31165":74278,"_5":31500,"_21590":125045,"_28357":125046,"_3076":125047},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3624":74281,"_31165":74278,"_5":31500,"_21590":125049,"_28357":125050,"_3076":122844},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3624":74282,"_31165":74278,"_5":31500,"_21590":125052,"_28357":125053,"_3076":123022},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3624":74283,"_31165":74278,"_5":31500,"_21590":125055,"_28357":125056,"_3076":124262},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3624":74284,"_31165":74278,"_5":31500,"_21590":125058,"_28357":125059,"_3076":125060},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3624":74285,"_31165":74278,"_21590":125062,"_5":14857,"_28357":74278,"_3076":125063},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3624":74286,"_31165":74278,"_21590":125065,"_5":14857,"_28357":125046,"_3076":125066},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3624":74287,"_31165":74278,"_21590":125068,"_5":14857,"_28357":125046,"_3076":125069},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3624":74288,"_31165":74278,"_21590":125071,"_5":14857,"_28357":125050,"_3076":125072},[],"Recurso",{"_3624":74289,"_31165":74278,"_21590":125074,"_5":14857,"_28357":125050,"_3076":125075},[],"Qué representa",{"_3624":74290,"_31165":74278,"_21590":125077,"_5":14857,"_28357":125050,"_3076":125078},[],"**Dispositivo**",{"_3624":74291,"_31165":74278,"_21590":125080,"_5":14857,"_28357":125050,"_3076":125081},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3624":74292,"_31165":74278,"_21590":125083,"_5":14857,"_28357":125050,"_3076":125084},[],"**Identidad**",{"_3624":74293,"_31165":74278,"_21590":125086,"_5":14857,"_28357":125050,"_3076":125087},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3624":74294,"_31165":74278,"_21590":125089,"_5":14857,"_28357":125050,"_3076":55941},[],{"_3624":74295,"_31165":74278,"_21590":125091,"_5":14857,"_28357":125050,"_3076":125092},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3624":74296,"_31165":74278,"_21590":125094,"_5":14857,"_28357":125050,"_3076":125095},[],"**Flota**",{"_3624":74297,"_31165":74278,"_21590":125097,"_5":14857,"_28357":125050,"_3076":125098},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3624":74298,"_31165":74278,"_21590":125100,"_5":14857,"_28357":125050,"_3076":125101},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3624":74299,"_31165":74278,"_21590":125103,"_5":14857,"_28357":125050,"_3076":125104},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3624":74300,"_31165":74278,"_21590":125106,"_5":14857,"_28357":125053,"_3076":125107},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3624":74301,"_31165":74278,"_21590":125109,"_5":14857,"_28357":125053,"_3076":125110},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3624":74302,"_31165":74278,"_21590":125112,"_5":14857,"_28357":125053,"_3076":125113},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3624":74303,"_31165":74278,"_21590":125115,"_5":14857,"_28357":125053,"_3076":125116},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3624":74304,"_31165":74278,"_21590":125118,"_5":14857,"_28357":125053,"_3076":125119},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3624":74305,"_31165":74278,"_21590":125121,"_5":14857,"_28357":125053,"_3076":125122},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3624":74306,"_31165":74278,"_21590":125124,"_5":14857,"_28357":125053,"_3076":125125},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3624":74307,"_31165":74278,"_21590":125127,"_5":14857,"_28357":125053,"_3076":125128},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3624":74308,"_31165":74278,"_21590":125130,"_5":14857,"_28357":125056,"_3076":125131},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3624":74309,"_31165":74278,"_21590":125133,"_5":14857,"_28357":125056,"_3076":125134},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3624":74310,"_31165":74278,"_21590":125136,"_5":14857,"_28357":125059,"_3076":125137},[],"Participante",{"_3624":74311,"_31165":74278,"_21590":125139,"_5":14857,"_28357":125059,"_3076":125140},[],"Responsabilidad",{"_3624":74312,"_31165":74278,"_21590":125142,"_5":14857,"_28357":125059,"_3076":125143},[],"Administrador PKI",{"_3624":74313,"_31165":74278,"_21590":125145,"_5":14857,"_28357":125059,"_3076":125146},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3624":74314,"_31165":74278,"_21590":125148,"_5":14857,"_28357":125059,"_3076":125149},[],"Administrador del aprovisionamiento",{"_3624":74315,"_31165":74278,"_21590":125151,"_5":14857,"_28357":125059,"_3076":125152},[],"DMS, admisión, autenticación por operación e inventario.",{"_3624":74316,"_31165":74278,"_21590":125154,"_5":14857,"_28357":125059,"_3076":125155},[],"Integrador del dispositivo",{"_3624":74317,"_31165":74278,"_21590":125157,"_5":14857,"_28357":125059,"_3076":125158},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3624":74318,"_31165":74278,"_21590":125160,"_5":14857,"_28357":125059,"_3076":125161},[],"Integrador del consumidor",{"_3624":74319,"_31165":74278,"_21590":125163,"_5":14857,"_28357":125059,"_3076":125164},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3624":74320,"_31165":74278,"_21590":125166,"_5":14857,"_28357":125059,"_3076":125167},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3624":74321,"_31165":74321,"_5":15217,"_3076":125169,"_31503":125170,"_21590":125172,"_28357":74321},"Enrola y conecta tu primer dispositivo",[50900,121699,53584,125171],"Primeros pasos",[],{"_3624":74322,"_31165":74321,"_21590":125174,"_5":14857,"_28357":74321,"_3076":125175},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3624":74323,"_31165":74321,"_5":31500,"_21590":125177,"_28357":125178,"_3076":120233},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3624":74324,"_31165":74321,"_5":31500,"_21590":125180,"_28357":125181,"_3076":125182},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3624":74325,"_31165":74321,"_5":31500,"_21590":125184,"_28357":125185,"_3076":125186},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3624":74326,"_31165":74321,"_5":31500,"_21590":125188,"_28357":125189,"_3076":125190},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3624":74327,"_31165":74321,"_5":31500,"_21590":125192,"_28357":125193,"_3076":125194},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3624":74328,"_31165":74321,"_5":31500,"_21590":125196,"_28357":125197,"_3076":125198},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3624":74329,"_31165":74321,"_5":31500,"_21590":125200,"_28357":125201,"_3076":125202},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3624":74330,"_31165":74321,"_5":31500,"_21590":125204,"_28357":125205,"_3076":125206},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3624":74331,"_31165":74321,"_21590":125208,"_5":14857,"_28357":74321,"_3076":125209},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3624":74332,"_31165":74321,"_21590":125211,"_5":14857,"_28357":125178,"_3076":125212},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3624":74333,"_31165":74321,"_21590":125214,"_5":14857,"_28357":125178,"_3076":125215},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3624":74334,"_31165":74321,"_21590":125217,"_5":14857,"_28357":125178,"_3076":125218},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3624":74335,"_31165":74321,"_21590":125220,"_5":14857,"_28357":125178,"_3076":125221},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3624":74336,"_31165":74321,"_21590":125223,"_5":14857,"_28357":125178,"_3076":125224},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3624":74337,"_31165":74321,"_21590":125226,"_5":14857,"_28357":125181,"_3076":125227},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3624":74338,"_31165":74321,"_21590":125229,"_5":14857,"_28357":125181,"_3076":125230},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3624":74339,"_31165":74321,"_21590":125232,"_5":14857,"_28357":125185,"_3076":125233},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3624":74340,"_31165":74321,"_21590":125235,"_5":14857,"_28357":125185,"_3076":125236},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3624":74341,"_31165":74321,"_21590":125238,"_5":14857,"_28357":125185,"_3076":125239},[],"Ajuste",{"_3624":74342,"_31165":74321,"_21590":125241,"_5":14857,"_28357":125185,"_3076":125242},[],"Valor de evaluación",{"_3624":74343,"_31165":74321,"_21590":125244,"_5":14857,"_28357":125185,"_3076":56097},[],{"_3624":74344,"_31165":74321,"_21590":125246,"_5":14857,"_28357":125185,"_3076":125247},[],"Raíz emisora de `device-root.pem`.",{"_3624":74345,"_31165":74321,"_21590":125249,"_5":14857,"_28357":125185,"_3076":123156},[],{"_3624":74346,"_31165":74321,"_21590":125251,"_5":14857,"_28357":125185,"_3076":125252},[],"Perfil final de 1 hora que acabas de preparar.",{"_3624":74347,"_31165":74321,"_21590":125254,"_5":14857,"_28357":125185,"_3076":56108},[],{"_3624":74348,"_31165":74321,"_21590":125256,"_5":14857,"_28357":125185,"_3076":56111},[],{"_3624":74349,"_31165":74321,"_21590":125258,"_5":14857,"_28357":125185,"_3076":56114},[],{"_3624":74350,"_31165":74321,"_21590":125260,"_5":14857,"_28357":125185,"_3076":125261},[],"Habilitado.",{"_3624":74351,"_31165":74321,"_21590":125263,"_5":14857,"_28357":125185,"_3076":56120},[],{"_3624":74352,"_31165":74321,"_21590":125265,"_5":14857,"_28357":125185,"_3076":125266},[],"Deshabilitado; el ID debe ser nuevo.",{"_3624":74353,"_31165":74321,"_21590":125268,"_5":14857,"_28357":125185,"_3076":125269},[],"Autenticación inicial",{"_3624":74354,"_31165":74321,"_21590":125271,"_5":14857,"_28357":125185,"_3076":125272},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3624":74355,"_31165":74321,"_21590":125274,"_5":14857,"_28357":125185,"_3076":125275},[],"Autenticación de renovación",{"_3624":74356,"_31165":74321,"_21590":125277,"_5":14857,"_28357":125185,"_3076":125278},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3624":74357,"_31165":74321,"_21590":125280,"_5":14857,"_28357":125185,"_3076":56138},[],{"_3624":74358,"_31165":74321,"_21590":125282,"_5":14857,"_28357":125185,"_3076":125283},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3624":74359,"_31165":74321,"_21590":125285,"_5":14857,"_28357":125185,"_3076":56144},[],{"_3624":74360,"_31165":74321,"_21590":125287,"_5":14857,"_28357":125185,"_3076":125288},[],"1 hora.",{"_3624":74361,"_31165":74321,"_21590":125290,"_5":14857,"_28357":125185,"_3076":56150},[],{"_3624":74362,"_31165":74321,"_21590":125292,"_5":14857,"_28357":125185,"_3076":125293},[],"30 minutos / 10 minutos.",{"_3624":74363,"_31165":74321,"_21590":125295,"_5":14857,"_28357":125185,"_3076":56156},[],{"_3624":74364,"_31165":74321,"_21590":125297,"_5":14857,"_28357":125185,"_3076":125298},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3624":74365,"_31165":74321,"_21590":125300,"_5":14857,"_28357":125185,"_3076":53912},[],{"_3624":74366,"_31165":74321,"_21590":125302,"_5":14857,"_28357":125185,"_3076":125303},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3624":74367,"_31165":74321,"_21590":125305,"_5":14857,"_28357":125185,"_3076":56167},[],{"_3624":74368,"_31165":74321,"_21590":125307,"_5":14857,"_28357":125185,"_3076":125308},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3624":74369,"_31165":74321,"_21590":125310,"_5":14857,"_28357":125185,"_3076":125311},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3624":74370,"_31165":74321,"_21590":125313,"_5":14857,"_28357":125189,"_3076":125314},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3624":74371,"_31165":74321,"_21590":125316,"_5":14857,"_28357":125189,"_3076":125317},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3624":74372,"_31165":74321,"_21590":125319,"_5":14857,"_28357":125193,"_3076":125320},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3624":74373,"_31165":74321,"_21590":125322,"_5":14857,"_28357":125193,"_3076":125323},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3624":74374,"_31165":74321,"_21590":125325,"_5":14857,"_28357":125193,"_3076":125326},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3624":74375,"_31165":74321,"_21590":125328,"_5":14857,"_28357":125197,"_3076":125329},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3624":74376,"_31165":74321,"_21590":125331,"_5":14857,"_28357":125197,"_3076":125332},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3624":74377,"_31165":74321,"_21590":125334,"_5":14857,"_28357":125201,"_3076":125335},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3624":74378,"_31165":74321,"_21590":125337,"_5":14857,"_28357":125201,"_3076":125338},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3624":74379,"_31165":74321,"_21590":125340,"_5":14857,"_28357":125201,"_3076":125341},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3624":74380,"_31165":74321,"_21590":125343,"_5":14857,"_28357":125201,"_3076":125344},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3624":74381,"_31165":74321,"_21590":125346,"_5":14857,"_28357":125201,"_3076":125347},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3624":74382,"_31165":74321,"_21590":125349,"_5":14857,"_28357":125205,"_3076":125350},[],"Comprobación",{"_3624":74383,"_31165":74321,"_21590":125352,"_5":14857,"_28357":125205,"_3076":125353},[],"Resultado esperado",{"_3624":74384,"_31165":74321,"_21590":125355,"_5":14857,"_28357":125205,"_3076":125356},[],"Registro",{"_3624":74385,"_31165":74321,"_21590":125358,"_5":14857,"_28357":125205,"_3076":125359},[],"ID creado automáticamente y DMS correcto.",{"_3624":74386,"_31165":74321,"_21590":125361,"_5":14857,"_28357":125205,"_3076":124646},[],{"_3624":74387,"_31165":74321,"_21590":125363,"_5":14857,"_28357":125205,"_3076":125364},[],"CN, perfil, serie y clave verificados.",{"_3624":74388,"_31165":74321,"_21590":125366,"_5":14857,"_28357":125205,"_3076":125367},[],"Inventario",{"_3624":74389,"_31165":74321,"_21590":125369,"_5":14857,"_28357":125205,"_3076":125370},[],"Serie recibida visible como identidad actual y en el historial.",{"_3624":74390,"_31165":74321,"_21590":125372,"_5":14857,"_28357":125205,"_3076":125373},[],"Consumidor",{"_3624":74391,"_31165":74321,"_21590":125375,"_5":14857,"_28357":125205,"_3076":125376},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3624":74392,"_31165":74321,"_21590":125378,"_5":14857,"_28357":125205,"_3076":125379},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3624":74393,"_31165":74321,"_21590":125381,"_5":14857,"_28357":125205,"_3076":125382},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3624":74394,"_31165":74394,"_5":15217,"_3076":122861,"_31503":125384,"_21590":125385,"_28357":74394},[50900,121699,53584,125171],[],{"_3624":74395,"_31165":74394,"_21590":125387,"_5":14857,"_28357":74394,"_3076":125388},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3624":74396,"_31165":74394,"_5":31500,"_21590":125390,"_28357":125391,"_3076":120233},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3624":74397,"_31165":74394,"_5":31500,"_21590":125393,"_28357":125394,"_3076":125395},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3624":74398,"_31165":74394,"_5":31500,"_21590":125397,"_28357":125398,"_3076":125399},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3624":74399,"_31165":74394,"_5":31500,"_21590":125401,"_28357":125402,"_3076":125403},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3624":74400,"_31165":74394,"_5":31500,"_21590":125405,"_28357":125406,"_3076":125407},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3624":74401,"_31165":74394,"_5":31500,"_21590":125409,"_28357":125410,"_3076":125411},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3624":74402,"_31165":74394,"_5":31500,"_21590":125413,"_28357":125414,"_3076":125353},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3624":74403,"_31165":74394,"_5":31500,"_21590":125416,"_28357":125417,"_3076":125418},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3624":74404,"_31165":74394,"_5":31500,"_21590":125420,"_28357":125421,"_3076":125422},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3624":74405,"_31165":74394,"_21590":125424,"_5":14857,"_28357":74394,"_3076":125425},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3624":74406,"_31165":74394,"_21590":125427,"_5":14857,"_28357":74394,"_3076":125428},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3624":74407,"_31165":74394,"_21590":125430,"_5":14857,"_28357":125391,"_3076":125431},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3624":74408,"_31165":74394,"_21590":125433,"_5":14857,"_28357":125391,"_3076":125434},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3624":74409,"_31165":74394,"_21590":125436,"_5":14857,"_28357":125391,"_3076":125437},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3624":74410,"_31165":74394,"_21590":125439,"_5":14857,"_28357":125391,"_3076":125440},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3624":74411,"_31165":74394,"_21590":125442,"_5":14857,"_28357":125394,"_3076":125443},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3624":74412,"_31165":74394,"_21590":125445,"_5":14857,"_28357":125394,"_3076":125446},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3624":74413,"_31165":74394,"_21590":125448,"_5":14857,"_28357":125394,"_3076":125449},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3624":74414,"_31165":74394,"_21590":125451,"_5":14857,"_28357":125394,"_3076":125452},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3624":74415,"_31165":74394,"_21590":125454,"_5":14857,"_28357":125394,"_3076":125455},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3624":74416,"_31165":74394,"_21590":125457,"_5":14857,"_28357":125394,"_3076":125458},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3624":74417,"_31165":74394,"_21590":125460,"_5":14857,"_28357":125394,"_3076":125461},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3624":74418,"_31165":74394,"_21590":125463,"_5":14857,"_28357":125394,"_3076":125464},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3624":74419,"_31165":74394,"_21590":125466,"_5":14857,"_28357":125398,"_3076":125467},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3624":74420,"_31165":74394,"_21590":125469,"_5":14857,"_28357":125398,"_3076":56332},[],{"_3624":74421,"_31165":74394,"_21590":125471,"_5":14857,"_28357":125398,"_3076":125472},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3624":74422,"_31165":74394,"_21590":125474,"_5":14857,"_28357":125398,"_3076":125475},[],"**Icon** y **Tags**: clasificación opcional.",{"_3624":74423,"_31165":74394,"_21590":125477,"_5":14857,"_28357":125398,"_3076":125478},[],"Confirma el registro.",{"_3624":74424,"_31165":74394,"_21590":125480,"_5":14857,"_28357":125402,"_3076":125481},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3624":74425,"_31165":74394,"_21590":125483,"_5":14857,"_28357":125402,"_3076":125484},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3624":74426,"_31165":74394,"_21590":125486,"_5":14857,"_28357":125406,"_3076":125487},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3624":74427,"_31165":74394,"_21590":125489,"_5":14857,"_28357":125406,"_3076":125490},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3624":74428,"_31165":74394,"_21590":125492,"_5":14857,"_28357":125410,"_3076":125493},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3624":74429,"_31165":74394,"_21590":125495,"_5":14857,"_28357":125410,"_3076":125496},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3624":74430,"_31165":74394,"_21590":125498,"_5":14857,"_28357":125414,"_3076":125350},[],{"_3624":74431,"_31165":74394,"_21590":125500,"_5":14857,"_28357":125414,"_3076":125501},[],"Resultado",{"_3624":74432,"_31165":74394,"_21590":125503,"_5":14857,"_28357":125414,"_3076":124632},[],{"_3624":74433,"_31165":74394,"_21590":125505,"_5":14857,"_28357":125414,"_3076":125506},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3624":74434,"_31165":74394,"_21590":125508,"_5":14857,"_28357":125414,"_3076":125509},[],"Identidad actual",{"_3624":74435,"_31165":74394,"_21590":125511,"_5":14857,"_28357":125414,"_3076":125512},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3624":74436,"_31165":74394,"_21590":125514,"_5":14857,"_28357":125414,"_3076":125515},[],"Historial",{"_3624":74437,"_31165":74394,"_21590":125517,"_5":14857,"_28357":125414,"_3076":125518},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3624":74438,"_31165":74394,"_21590":125520,"_5":14857,"_28357":125414,"_3076":125521},[],"Clave y certificado",{"_3624":74439,"_31165":74394,"_21590":125523,"_5":14857,"_28357":125414,"_3076":125524},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3624":74440,"_31165":74394,"_21590":125526,"_5":14857,"_28357":125417,"_3076":125527},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3624":74441,"_31165":74394,"_21590":125529,"_5":14857,"_28357":125417,"_3076":125530},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3624":74442,"_31165":74394,"_21590":125532,"_5":14857,"_28357":125417,"_3076":125533},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3624":74443,"_31165":74394,"_21590":125535,"_5":14857,"_28357":125417,"_3076":125536},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3624":74444,"_31165":74394,"_21590":125538,"_5":14857,"_28357":125421,"_3076":125539},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3624":74445,"_31165":74394,"_21590":125541,"_5":14857,"_28357":125421,"_3076":125542},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3624":74446,"_31165":74394,"_21590":125544,"_5":14857,"_28357":125421,"_3076":125545},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3624":74447,"_31165":74447,"_5":15217,"_3076":125547,"_31503":125548,"_21590":125549,"_28357":74447},"Plataforma Lamassu IoT",[50900,121699],[],{"_3624":74448,"_31165":74447,"_21590":125551,"_5":14857,"_28357":74447,"_3076":125552},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3624":74449,"_31165":74447,"_5":31500,"_21590":125554,"_28357":125555,"_3076":125047},[],"/docs/es/platform/overview#empieza-aquí",{"_3624":74450,"_31165":74447,"_5":31500,"_21590":125557,"_28357":125558,"_3076":125559},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3624":74451,"_31165":74447,"_5":31500,"_21590":125561,"_28357":125562,"_3076":125563},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3624":74452,"_31165":74447,"_5":31500,"_21590":125565,"_28357":125566,"_3076":125567},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3624":74453,"_31165":74447,"_5":31500,"_21590":125569,"_28357":125570,"_3076":125571},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3624":74454,"_31165":74447,"_5":31500,"_21590":125573,"_28357":125574,"_3076":125575},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3624":74455,"_31165":74447,"_5":31500,"_21590":125577,"_28357":125578,"_3076":125579},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3624":74456,"_31165":74447,"_5":31500,"_21590":125581,"_28357":125582,"_3076":125583},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3624":74457,"_31165":74447,"_5":31500,"_21590":125585,"_28357":125586,"_3076":125587},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3624":74458,"_31165":74447,"_5":31500,"_21590":125589,"_28357":125590,"_3076":125591},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3624":74459,"_31165":74447,"_5":31500,"_21590":125593,"_28357":125594,"_3076":125595},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3624":74460,"_31165":74447,"_21590":125597,"_5":14857,"_28357":74447,"_3076":125598},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3624":74461,"_31165":74447,"_21590":125600,"_5":14857,"_28357":125555,"_3076":125601},[],"Elige el resultado que necesitas obtener:",{"_3624":74462,"_31165":74447,"_21590":125603,"_5":14857,"_28357":125555,"_3076":125604},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3624":74463,"_31165":74447,"_21590":125606,"_5":14857,"_28357":125555,"_3076":125607},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3624":74464,"_31165":74447,"_21590":125609,"_5":14857,"_28357":125555,"_3076":125610},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3624":74465,"_31165":74447,"_21590":125612,"_5":14857,"_28357":125558,"_3076":125613},[],"Bloque",{"_3624":74466,"_31165":74447,"_21590":125615,"_5":14857,"_28357":125558,"_3076":125616},[],"Qué gestionas",{"_3624":74467,"_31165":74447,"_21590":125618,"_5":14857,"_28357":125558,"_3076":125619},[],"Punto de entrada",{"_3624":74468,"_31165":74447,"_21590":125621,"_5":14857,"_28357":125558,"_3076":56485},[],{"_3624":74469,"_31165":74447,"_21590":125623,"_5":14857,"_28357":125558,"_3076":125624},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3624":74470,"_31165":74447,"_21590":125626,"_5":14857,"_28357":125558,"_3076":125627},[],"Visión general de PKI",{"_3624":74471,"_31165":74447,"_21590":125629,"_5":14857,"_28357":125558,"_3076":56494},[],{"_3624":74472,"_31165":74447,"_21590":125631,"_5":14857,"_28357":125558,"_3076":125632},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3624":74473,"_31165":74447,"_21590":125634,"_5":14857,"_28357":125558,"_3076":125635},[],"Visión general de IoT Fleets",{"_3624":74474,"_31165":74447,"_21590":125637,"_5":14857,"_28357":125558,"_3076":125638},[],"**Administración**",{"_3624":74475,"_31165":74447,"_21590":125640,"_5":14857,"_28357":125558,"_3076":125641},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3624":74476,"_31165":74447,"_21590":125643,"_5":14857,"_28357":125558,"_3076":121701},[],{"_3624":74477,"_31165":74447,"_21590":125645,"_5":14857,"_28357":125558,"_3076":125646},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3624":74478,"_31165":74447,"_21590":125648,"_5":14857,"_28357":125562,"_3076":125649},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3624":74479,"_31165":74447,"_21590":125651,"_5":14857,"_28357":125562,"_3076":125652},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3624":74480,"_31165":74447,"_21590":125654,"_5":14857,"_28357":125562,"_3076":125655},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3624":74481,"_31165":74447,"_21590":125657,"_5":14857,"_28357":125562,"_3076":125658},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3624":74482,"_31165":74447,"_21590":125660,"_5":14857,"_28357":125562,"_3076":125661},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3624":74483,"_31165":74447,"_21590":125663,"_5":14857,"_28357":125562,"_3076":125664},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3624":74484,"_31165":74447,"_21590":125666,"_5":14857,"_28357":125570,"_3076":125667},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3624":74485,"_31165":74447,"_21590":125669,"_5":14857,"_28357":125574,"_3076":125670},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3624":74486,"_31165":74447,"_21590":125672,"_5":14857,"_28357":125578,"_3076":125673},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3624":74487,"_31165":74447,"_21590":125675,"_5":14857,"_28357":125582,"_3076":125676},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3624":74488,"_31165":74447,"_21590":125678,"_5":14857,"_28357":125586,"_3076":125679},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3624":74489,"_31165":74447,"_21590":125681,"_5":14857,"_28357":125590,"_3076":125682},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3624":74490,"_31165":74447,"_21590":125684,"_5":14857,"_28357":125594,"_3076":125140},[],{"_3624":74491,"_31165":74447,"_21590":125686,"_5":14857,"_28357":125594,"_3076":125687},[],"Qué prepara o comprueba",{"_3624":74492,"_31165":74447,"_21590":125689,"_5":14857,"_28357":125594,"_3076":125143},[],{"_3624":74493,"_31165":74447,"_21590":125691,"_5":14857,"_28357":125594,"_3076":125692},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3624":74494,"_31165":74447,"_21590":125694,"_5":14857,"_28357":125594,"_3076":125695},[],"Administrador de la flota",{"_3624":74495,"_31165":74447,"_21590":125697,"_5":14857,"_28357":125594,"_3076":125698},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3624":74496,"_31165":74447,"_21590":125700,"_5":14857,"_28357":125594,"_3076":125155},[],{"_3624":74497,"_31165":74447,"_21590":125702,"_5":14857,"_28357":125594,"_3076":125703},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3624":74498,"_31165":74447,"_21590":125705,"_5":14857,"_28357":125594,"_3076":125161},[],{"_3624":74499,"_31165":74447,"_21590":125707,"_5":14857,"_28357":125594,"_3076":125708},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3624":74500,"_31165":74447,"_21590":125710,"_5":14857,"_28357":125594,"_3076":125711},[],"Operador de infraestructura",{"_3624":74501,"_31165":74447,"_21590":125713,"_5":14857,"_28357":125594,"_3076":125714},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3624":74502,"_31165":74447,"_21590":125716,"_5":14857,"_28357":125594,"_3076":125717},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3624":74503,"_31165":74503,"_5":15217,"_3076":125719,"_31503":125720,"_21590":125722,"_28357":74503},"Jerarquía y rotación de CAs",[50900,121699,56586,125721],"Claves, autoridades y certificados",[],{"_3624":74504,"_31165":74503,"_21590":125724,"_5":14857,"_28357":74503,"_3076":125725},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3624":74505,"_31165":74503,"_5":31500,"_21590":125727,"_28357":125728,"_3076":125729},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3624":74506,"_31165":74503,"_5":31500,"_21590":125731,"_28357":125732,"_3076":125733},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3624":74507,"_31165":74503,"_5":31500,"_21590":125735,"_28357":125736,"_3076":125737},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3624":74508,"_31165":74503,"_5":31500,"_21590":125739,"_28357":125740,"_3076":125741},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3624":74509,"_31165":74503,"_5":31500,"_21590":125743,"_28357":125744,"_3076":125745},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3624":74510,"_31165":74503,"_5":31500,"_21590":125747,"_28357":125748,"_3076":125749},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3624":74511,"_31165":74503,"_5":31500,"_21590":125751,"_28357":125752,"_3076":125753},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3624":74512,"_31165":74503,"_5":31500,"_21590":125755,"_28357":125756,"_3076":125757},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3624":74513,"_31165":74503,"_5":31500,"_21590":125759,"_28357":125760,"_3076":125761},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3624":74514,"_31165":74503,"_5":31500,"_21590":125763,"_28357":125764,"_3076":125765},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3624":74515,"_31165":74503,"_5":31500,"_21590":125767,"_28357":125768,"_3076":125769},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3624":74516,"_31165":74503,"_5":31500,"_21590":125771,"_28357":125772,"_3076":125773},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3624":74517,"_31165":74503,"_21590":125775,"_5":14857,"_28357":74503,"_3076":125776},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3624":74518,"_31165":74503,"_21590":125778,"_5":14857,"_28357":74503,"_3076":125779},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3624":74519,"_31165":74503,"_21590":125781,"_5":14857,"_28357":125728,"_3076":125782},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3624":74520,"_31165":74503,"_21590":125784,"_5":14857,"_28357":125728,"_3076":125785},[],"entorno, como producción y preproducción;",{"_3624":74521,"_31165":74503,"_21590":125787,"_5":14857,"_28357":125728,"_3076":125788},[],"propietario o equipo operador;",{"_3624":74522,"_31165":74503,"_21590":125790,"_5":14857,"_28357":125728,"_3076":125791},[],"familia de dispositivos o proceso de fabricación;",{"_3624":74523,"_31165":74503,"_21590":125793,"_5":14857,"_28357":125728,"_3076":125794},[],"región o requisito regulatorio;",{"_3624":74524,"_31165":74503,"_21590":125796,"_5":14857,"_28357":125728,"_3076":125797},[],"motor criptográfico o política de clave;",{"_3624":74525,"_31165":74503,"_21590":125799,"_5":14857,"_28357":125728,"_3076":125800},[],"ventana de mantenimiento y ritmo de renovación.",{"_3624":74526,"_31165":74503,"_21590":125802,"_5":14857,"_28357":125728,"_3076":125803},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3624":74527,"_31165":74503,"_21590":125805,"_5":14857,"_28357":125728,"_3076":125806},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3624":74528,"_31165":74503,"_21590":125808,"_5":14857,"_28357":125732,"_3076":125809},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3624":74529,"_31165":74503,"_21590":125811,"_5":14857,"_28357":125732,"_3076":125812},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3624":74530,"_31165":74503,"_21590":125814,"_5":14857,"_28357":125732,"_3076":125815},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3624":74531,"_31165":74503,"_21590":125817,"_5":14857,"_28357":125732,"_3076":125818},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3624":74532,"_31165":74503,"_21590":125820,"_5":14857,"_28357":125736,"_3076":125821},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3624":74533,"_31165":74503,"_21590":125823,"_5":14857,"_28357":125736,"_3076":125824},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3624":74534,"_31165":74503,"_21590":125826,"_5":14857,"_28357":125736,"_3076":125827},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3624":74535,"_31165":74503,"_21590":125829,"_5":14857,"_28357":125736,"_3076":125830},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3624":74536,"_31165":74503,"_21590":125832,"_5":14857,"_28357":125744,"_3076":125833},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3624":74537,"_31165":74503,"_21590":125835,"_5":14857,"_28357":125748,"_3076":125836},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3624":74538,"_31165":74503,"_21590":125838,"_5":14857,"_28357":125752,"_3076":125839},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3624":74539,"_31165":74503,"_21590":125841,"_5":14857,"_28357":125756,"_3076":125842},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3624":74540,"_31165":74503,"_21590":125844,"_5":14857,"_28357":125760,"_3076":125845},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3624":74541,"_31165":74503,"_21590":125847,"_5":14857,"_28357":125764,"_3076":125848},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3624":74542,"_31165":74503,"_21590":125850,"_5":14857,"_28357":125768,"_3076":125851},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3624":74543,"_31165":74503,"_21590":125853,"_5":14857,"_28357":125768,"_3076":125854},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3624":74544,"_31165":74503,"_21590":125856,"_5":14857,"_28357":125768,"_3076":125857},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3624":74545,"_31165":74503,"_21590":125859,"_5":14857,"_28357":125768,"_3076":125860},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3624":74546,"_31165":74503,"_21590":125862,"_5":14857,"_28357":125772,"_3076":125863},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3624":74547,"_31165":74503,"_21590":125865,"_5":14857,"_28357":125772,"_3076":125866},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3624":74548,"_31165":74503,"_21590":125868,"_5":14857,"_28357":125772,"_3076":125869},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3624":74549,"_31165":74503,"_21590":125871,"_5":14857,"_28357":125772,"_3076":125872},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3624":74550,"_31165":74503,"_21590":125874,"_5":14857,"_28357":125772,"_3076":125875},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3624":74551,"_31165":74503,"_21590":125877,"_5":14857,"_28357":125772,"_3076":125878},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3624":74552,"_31165":74503,"_21590":125880,"_5":14857,"_28357":125772,"_3076":125881},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3624":74553,"_31165":74553,"_5":15217,"_3076":125883,"_31503":125884,"_21590":125885,"_28357":74553},"Autoridades de certificación",[50900,121699,56586,125721],[],{"_3624":74554,"_31165":74553,"_21590":125887,"_5":14857,"_28357":74553,"_3076":125888},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3624":74555,"_31165":74553,"_5":31500,"_21590":125890,"_28357":125891,"_3076":125892},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3624":74556,"_31165":74553,"_5":31500,"_21590":125894,"_28357":125895,"_3076":125896},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3624":74557,"_31165":74553,"_5":31500,"_21590":125898,"_28357":125899,"_3076":120233},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3624":74558,"_31165":74553,"_5":31500,"_21590":125901,"_28357":125902,"_3076":125903},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3624":74559,"_31165":74553,"_5":31500,"_21590":125905,"_28357":125906,"_3076":125907},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3624":74560,"_31165":74553,"_5":31500,"_21590":125909,"_28357":125910,"_3076":125911},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3624":74561,"_31165":74553,"_5":31500,"_21590":125913,"_28357":125914,"_3076":125915},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3624":74562,"_31165":74553,"_5":31500,"_21590":125917,"_28357":125918,"_3076":125919},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3624":74563,"_31165":74553,"_5":31500,"_21590":125921,"_28357":125922,"_3076":125923},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3624":74564,"_31165":74553,"_5":31500,"_21590":125925,"_28357":125926,"_3076":125927},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3624":74565,"_31165":74553,"_5":31500,"_21590":125929,"_28357":125930,"_3076":125931},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3624":74566,"_31165":74553,"_5":31500,"_21590":125933,"_28357":125934,"_3076":125935},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3624":74567,"_31165":74553,"_5":31500,"_21590":125937,"_28357":125938,"_3076":125939},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3624":74568,"_31165":74553,"_5":31500,"_21590":125941,"_28357":125942,"_3076":125943},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3624":74569,"_31165":74553,"_5":31500,"_21590":125945,"_28357":125946,"_3076":125947},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3624":74570,"_31165":74553,"_5":31500,"_21590":125949,"_28357":125950,"_3076":125951},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3624":74571,"_31165":74553,"_5":31500,"_21590":125953,"_28357":125954,"_3076":125955},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3624":74572,"_31165":74553,"_5":31500,"_21590":125957,"_28357":125958,"_3076":125959},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3624":74573,"_31165":74553,"_5":31500,"_21590":125961,"_28357":125962,"_3076":125963},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3624":74574,"_31165":74553,"_5":31500,"_21590":125965,"_28357":125966,"_3076":125967},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3624":74575,"_31165":74553,"_5":31500,"_21590":125969,"_28357":125970,"_3076":125971},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3624":74576,"_31165":74553,"_5":31500,"_21590":125973,"_28357":125974,"_3076":125975},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3624":74577,"_31165":74553,"_5":31500,"_21590":125977,"_28357":125978,"_3076":125979},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3624":74578,"_31165":74553,"_21590":125981,"_5":14857,"_28357":74553,"_3076":125982},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3624":74579,"_31165":74553,"_21590":125984,"_5":14857,"_28357":74553,"_3076":125985},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3624":74580,"_31165":74553,"_21590":125987,"_5":14857,"_28357":74553,"_3076":125988},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3624":74581,"_31165":74553,"_21590":125990,"_5":14857,"_28357":125891,"_3076":125991},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3624":74582,"_31165":74553,"_21590":125993,"_5":14857,"_28357":125891,"_3076":125994},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3624":74583,"_31165":74553,"_21590":125996,"_5":14857,"_28357":125891,"_3076":125997},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3624":74584,"_31165":74553,"_21590":125999,"_5":14857,"_28357":125891,"_3076":126000},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3624":74585,"_31165":74553,"_21590":126002,"_5":14857,"_28357":125891,"_3076":126003},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3624":74586,"_31165":74553,"_21590":126005,"_5":14857,"_28357":125899,"_3076":126006},[],"Decide si la CA será raíz o intermedia.",{"_3624":74587,"_31165":74553,"_21590":126008,"_5":14857,"_28357":125899,"_3076":126009},[],"Elige el motor que custodiará la clave.",{"_3624":74588,"_31165":74553,"_21590":126011,"_5":14857,"_28357":125899,"_3076":126012},[],"Define una validez superior a la de los certificados que emitirá.",{"_3624":74589,"_31165":74553,"_21590":126014,"_5":14857,"_28357":125899,"_3076":126015},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3624":74590,"_31165":74553,"_21590":126017,"_5":14857,"_28357":125902,"_3076":126018},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3624":74591,"_31165":74553,"_21590":126020,"_5":14857,"_28357":125906,"_3076":126021},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3624":74592,"_31165":74553,"_21590":126023,"_5":14857,"_28357":125906,"_3076":126024},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3624":74593,"_31165":74553,"_21590":126026,"_5":14857,"_28357":125910,"_3076":126027},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3624":74594,"_31165":74553,"_21590":126029,"_5":14857,"_28357":125914,"_3076":126030},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3624":74595,"_31165":74553,"_21590":126032,"_5":14857,"_28357":125914,"_3076":126033},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3624":74596,"_31165":74553,"_21590":126035,"_5":14857,"_28357":125914,"_3076":126036},[],"`ST`: estado o provincia.",{"_3624":74597,"_31165":74553,"_21590":126038,"_5":14857,"_28357":125914,"_3076":126039},[],"`L`: localidad.",{"_3624":74598,"_31165":74553,"_21590":126041,"_5":14857,"_28357":125914,"_3076":126042},[],"`O`: organización.",{"_3624":74599,"_31165":74553,"_21590":126044,"_5":14857,"_28357":125914,"_3076":126045},[],"`OU`: unidad organizativa.",{"_3624":74600,"_31165":74553,"_21590":126047,"_5":14857,"_28357":125914,"_3076":126048},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3624":74601,"_31165":74553,"_21590":126050,"_5":14857,"_28357":125918,"_3076":126051},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3624":74602,"_31165":74553,"_21590":126053,"_5":14857,"_28357":125918,"_3076":126054},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3624":74603,"_31165":74553,"_21590":126056,"_5":14857,"_28357":125922,"_3076":126057},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3624":74604,"_31165":74553,"_21590":126059,"_5":14857,"_28357":125922,"_3076":126060},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3624":74605,"_31165":74553,"_21590":126062,"_5":14857,"_28357":125926,"_3076":126063},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3624":74606,"_31165":74553,"_21590":126065,"_5":14857,"_28357":125926,"_3076":126066},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3624":74607,"_31165":74553,"_21590":126068,"_5":14857,"_28357":125930,"_3076":126069},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3624":74608,"_31165":74553,"_21590":126071,"_5":14857,"_28357":125930,"_3076":126072},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3624":74609,"_31165":74553,"_21590":126074,"_5":14857,"_28357":125930,"_3076":126075},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3624":74610,"_31165":74553,"_21590":126077,"_5":14857,"_28357":125934,"_3076":126078},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3624":74611,"_31165":74553,"_21590":126080,"_5":14857,"_28357":125938,"_3076":126081},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3624":74612,"_31165":74553,"_21590":126083,"_5":14857,"_28357":125938,"_3076":126084},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3624":74613,"_31165":74553,"_21590":126086,"_5":14857,"_28357":125942,"_3076":126087},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3624":74614,"_31165":74553,"_21590":126089,"_5":14857,"_28357":125946,"_3076":126090},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3624":74615,"_31165":74553,"_21590":126092,"_5":14857,"_28357":125946,"_3076":126093},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3624":74616,"_31165":74553,"_21590":126095,"_5":14857,"_28357":125946,"_3076":126096},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3624":74617,"_31165":74553,"_21590":126098,"_5":14857,"_28357":125950,"_3076":126099},[],"Abre una CA desde el inventario para consultar:",{"_3624":74618,"_31165":74553,"_21590":126101,"_5":14857,"_28357":125950,"_3076":126102},[],"Estado y periodo de validez.",{"_3624":74619,"_31165":74553,"_21590":126104,"_5":14857,"_28357":125950,"_3076":126105},[],"Certificado y cadena en formato PEM.",{"_3624":74620,"_31165":74553,"_21590":126107,"_5":14857,"_28357":125950,"_3076":126108},[],"Número de certificados activos, expirados y revocados.",{"_3624":74621,"_31165":74553,"_21590":126110,"_5":14857,"_28357":125950,"_3076":126111},[],"Certificados emitidos en **Issued Certificates**.",{"_3624":74622,"_31165":74553,"_21590":126113,"_5":14857,"_28357":125950,"_3076":126114},[],"CRL vinculada a la autoridad.",{"_3624":74623,"_31165":74553,"_21590":126116,"_5":14857,"_28357":125950,"_3076":126117},[],"Metadatos y motor criptográfico asociado.",{"_3624":74624,"_31165":74553,"_21590":126119,"_5":14857,"_28357":125950,"_3076":126120},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3624":74625,"_31165":74553,"_21590":126122,"_5":14857,"_28357":125954,"_3076":126123},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3624":74626,"_31165":74553,"_21590":126125,"_5":14857,"_28357":125954,"_3076":126126},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3624":74627,"_31165":74553,"_21590":126128,"_5":14857,"_28357":125954,"_3076":126129},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3624":74628,"_31165":74553,"_21590":126131,"_5":14857,"_28357":125954,"_3076":126132},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3624":74629,"_31165":74553,"_21590":126134,"_5":14857,"_28357":125954,"_3076":126135},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3624":74630,"_31165":74553,"_21590":126137,"_5":14857,"_28357":125954,"_3076":126138},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3624":74631,"_31165":74553,"_21590":126140,"_5":14857,"_28357":125958,"_3076":126141},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3624":74632,"_31165":74553,"_21590":126143,"_5":14857,"_28357":125962,"_3076":126144},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3624":74633,"_31165":74553,"_21590":126146,"_5":14857,"_28357":125966,"_3076":126147},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3624":74634,"_31165":74553,"_21590":126149,"_5":14857,"_28357":125970,"_3076":126150},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3624":74635,"_31165":74553,"_21590":126152,"_5":14857,"_28357":125974,"_3076":126153},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3624":74636,"_31165":74553,"_21590":126155,"_5":14857,"_28357":125978,"_3076":126156},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3624":74637,"_31165":74553,"_21590":126158,"_5":14857,"_28357":125978,"_3076":126159},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3624":74638,"_31165":74553,"_21590":126161,"_5":14857,"_28357":125978,"_3076":126162},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3624":74639,"_31165":74553,"_21590":126164,"_5":14857,"_28357":125978,"_3076":126165},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3624":74640,"_31165":74640,"_5":15217,"_3076":126167,"_31503":126168,"_21590":126169,"_28357":74640},"Perfiles de certificado",[50900,121699,56586,125721],[],{"_3624":74641,"_31165":74640,"_21590":126171,"_5":14857,"_28357":74640,"_3076":126172},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3624":74642,"_31165":74640,"_5":31500,"_21590":126174,"_28357":126175,"_3076":126176},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3624":74643,"_31165":74640,"_5":31500,"_21590":126178,"_28357":126179,"_3076":126180},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3624":74644,"_31165":74640,"_5":31500,"_21590":126182,"_28357":126183,"_3076":126184},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3624":74645,"_31165":74640,"_5":31500,"_21590":126186,"_28357":126187,"_3076":126188},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3624":74646,"_31165":74640,"_5":31500,"_21590":126190,"_28357":126191,"_3076":126192},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3624":74647,"_31165":74640,"_5":31500,"_21590":126194,"_28357":126195,"_3076":126196},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3624":74648,"_31165":74640,"_5":31500,"_21590":126198,"_28357":126199,"_3076":126200},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3624":74649,"_31165":74640,"_5":31500,"_21590":126202,"_28357":126203,"_3076":126204},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3624":74650,"_31165":74640,"_5":31500,"_21590":126206,"_28357":126207,"_3076":126208},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3624":74651,"_31165":74640,"_5":31500,"_21590":126210,"_28357":126211,"_3076":126212},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3624":74652,"_31165":74640,"_5":31500,"_21590":126214,"_28357":126215,"_3076":126216},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3624":74653,"_31165":74640,"_5":31500,"_21590":126218,"_28357":126219,"_3076":126220},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3624":74654,"_31165":74640,"_5":31500,"_21590":126222,"_28357":126223,"_3076":126224},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3624":74655,"_31165":74640,"_5":31500,"_21590":126226,"_28357":126227,"_3076":126228},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3624":74656,"_31165":74640,"_5":31500,"_21590":126230,"_28357":126231,"_3076":126232},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3624":74657,"_31165":74640,"_5":31500,"_21590":126234,"_28357":126235,"_3076":126236},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3624":74658,"_31165":74640,"_21590":126238,"_5":14857,"_28357":74640,"_3076":126239},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3624":74659,"_31165":74640,"_21590":126241,"_5":14857,"_28357":74640,"_3076":126242},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3624":74660,"_31165":74640,"_21590":126244,"_5":14857,"_28357":126179,"_3076":126245},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3624":74661,"_31165":74640,"_21590":126247,"_5":14857,"_28357":126179,"_3076":126248},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3624":74662,"_31165":74640,"_21590":126250,"_5":14857,"_28357":126183,"_3076":126251},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3624":74663,"_31165":74640,"_21590":126253,"_5":14857,"_28357":126187,"_3076":126254},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3624":74664,"_31165":74640,"_21590":126256,"_5":14857,"_28357":126187,"_3076":126257},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3624":74665,"_31165":74640,"_21590":126259,"_5":14857,"_28357":126187,"_3076":126260},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3624":74666,"_31165":74640,"_21590":126262,"_5":14857,"_28357":126191,"_3076":126263},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3624":74667,"_31165":74640,"_21590":126265,"_5":14857,"_28357":126195,"_3076":126266},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3624":74668,"_31165":74640,"_21590":126268,"_5":14857,"_28357":126195,"_3076":126269},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3624":74669,"_31165":74640,"_21590":126271,"_5":14857,"_28357":126199,"_3076":126272},[],"La aplicación criptográfica puede:",{"_3624":74670,"_31165":74640,"_21590":126274,"_5":14857,"_28357":126199,"_3076":126275},[],"permitir o bloquear claves RSA;",{"_3624":74671,"_31165":74640,"_21590":126277,"_5":14857,"_28357":126199,"_3076":126278},[],"limitar los tamaños RSA admitidos;",{"_3624":74672,"_31165":74640,"_21590":126280,"_5":14857,"_28357":126199,"_3076":126281},[],"permitir o bloquear claves ECDSA;",{"_3624":74673,"_31165":74640,"_21590":126283,"_5":14857,"_28357":126199,"_3076":126284},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3624":74674,"_31165":74640,"_21590":126286,"_5":14857,"_28357":126199,"_3076":126287},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3624":74675,"_31165":74640,"_21590":126289,"_5":14857,"_28357":126203,"_3076":126290},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3624":74676,"_31165":74640,"_21590":126292,"_5":14857,"_28357":126203,"_3076":121459},[],{"_3624":74677,"_31165":74640,"_21590":126294,"_5":14857,"_28357":126203,"_3076":126295},[],"Primera opción",{"_3624":74678,"_31165":74640,"_21590":126297,"_5":14857,"_28357":126203,"_3076":126298},[],"Segunda opción",{"_3624":74679,"_31165":74640,"_21590":126300,"_5":14857,"_28357":126203,"_3076":126301},[],"Si no hay ninguna",{"_3624":74680,"_31165":74640,"_21590":126303,"_5":14857,"_28357":126203,"_3076":126304},[],"Firma directa con una CA",{"_3624":74681,"_31165":74640,"_21590":126306,"_5":14857,"_28357":126203,"_3076":126307},[],"`issuance_profile` incluido en la solicitud",{"_3624":74682,"_31165":74640,"_21590":126309,"_5":14857,"_28357":126203,"_3076":126310},[],"`issuance_profile_id` de la solicitud",{"_3624":74683,"_31165":74640,"_21590":126312,"_5":14857,"_28357":126203,"_3076":126313},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3624":74684,"_31165":74640,"_21590":126315,"_5":14857,"_28357":126203,"_3076":126316},[],"Emisión mediante DMS",{"_3624":74685,"_31165":74640,"_21590":126318,"_5":14857,"_28357":126203,"_3076":57185},[],{"_3624":74686,"_31165":74640,"_21590":126320,"_5":14857,"_28357":126203,"_3076":126321},[],"`settings.issuance_profile` incluido en el DMS",{"_3624":74687,"_31165":74640,"_21590":126323,"_5":14857,"_28357":126203,"_3076":126324},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3624":74688,"_31165":74640,"_21590":126326,"_5":14857,"_28357":126203,"_3076":126327},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3624":74689,"_31165":74640,"_21590":126329,"_5":14857,"_28357":126203,"_3076":126330},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3624":74690,"_31165":74640,"_21590":126332,"_5":14857,"_28357":126211,"_3076":126333},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3624":74691,"_31165":74640,"_21590":126335,"_5":14857,"_28357":126215,"_3076":126336},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3624":74692,"_31165":74640,"_21590":126338,"_5":14857,"_28357":126219,"_3076":126339},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3624":74693,"_31165":74640,"_21590":126341,"_5":14857,"_28357":126223,"_3076":126342},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3624":74694,"_31165":74640,"_21590":126344,"_5":14857,"_28357":126227,"_3076":126345},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3624":74695,"_31165":74640,"_21590":126347,"_5":14857,"_28357":126227,"_3076":126348},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3624":74696,"_31165":74640,"_21590":126350,"_5":14857,"_28357":126231,"_3076":126351},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3624":74697,"_31165":74640,"_21590":126353,"_5":14857,"_28357":126231,"_3076":126354},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3624":74698,"_31165":74640,"_21590":126356,"_5":14857,"_28357":126231,"_3076":126357},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3624":74699,"_31165":74640,"_21590":126359,"_5":14857,"_28357":126231,"_3076":126360},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3624":74700,"_31165":74640,"_21590":126362,"_5":14857,"_28357":126235,"_3076":126363},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3624":74701,"_31165":74640,"_21590":126365,"_5":14857,"_28357":126235,"_3076":126366},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3624":74702,"_31165":74702,"_5":15217,"_3076":126368,"_31503":126369,"_21590":126371,"_28357":74702},"Validación de certificados",[50900,121699,56586,126370],"Validación",[],{"_3624":74703,"_31165":74702,"_21590":126373,"_5":14857,"_28357":74702,"_3076":126374},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3624":74704,"_31165":74702,"_5":31500,"_21590":126376,"_28357":126377,"_3076":126378},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3624":74705,"_31165":74702,"_5":31500,"_21590":126380,"_28357":126381,"_3076":126382},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3624":74706,"_31165":74702,"_5":31500,"_21590":126384,"_28357":126385,"_3076":126386},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3624":74707,"_31165":74702,"_21590":126388,"_5":14857,"_28357":74702,"_3076":126389},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3624":74708,"_31165":74702,"_21590":126391,"_5":14857,"_28357":126377,"_3076":126392},[],"Verifica estos criterios juntos:",{"_3624":74709,"_31165":74702,"_21590":126394,"_5":14857,"_28357":126377,"_3076":125350},[],{"_3624":74710,"_31165":74702,"_21590":126396,"_5":14857,"_28357":126377,"_3076":126397},[],"Resultado necesario",{"_3624":74711,"_31165":74702,"_21590":126399,"_5":14857,"_28357":126377,"_3076":126400},[],"Cadena y firma",{"_3624":74712,"_31165":74702,"_21590":126402,"_5":14857,"_28357":126377,"_3076":126403},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3624":74713,"_31165":74702,"_21590":126405,"_5":14857,"_28357":126377,"_3076":126406},[],"Fechas",{"_3624":74714,"_31165":74702,"_21590":126408,"_5":14857,"_28357":126377,"_3076":126409},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3624":74715,"_31165":74702,"_21590":126411,"_5":14857,"_28357":126377,"_3076":121369},[],{"_3624":74716,"_31165":74702,"_21590":126413,"_5":14857,"_28357":126377,"_3076":126414},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3624":74717,"_31165":74702,"_21590":126416,"_5":14857,"_28357":126377,"_3076":126417},[],"Uso",{"_3624":74718,"_31165":74702,"_21590":126419,"_5":14857,"_28357":126377,"_3076":126420},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3624":74719,"_31165":74702,"_21590":126422,"_5":14857,"_28357":126377,"_3076":126423},[],"Revocación",{"_3624":74720,"_31165":74702,"_21590":126425,"_5":14857,"_28357":126377,"_3076":126426},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3624":74721,"_31165":74702,"_21590":126428,"_5":14857,"_28357":126377,"_3076":126429},[],"Autorización",{"_3624":74722,"_31165":74702,"_21590":126431,"_5":14857,"_28357":126377,"_3076":126432},[],"La aplicación permite la acción a esa identidad.",{"_3624":74723,"_31165":74702,"_21590":126434,"_5":14857,"_28357":126377,"_3076":126435},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3624":74724,"_31165":74702,"_21590":126437,"_5":14857,"_28357":126381,"_3076":126438},[],"Mecanismo",{"_3624":74725,"_31165":74702,"_21590":126440,"_5":14857,"_28357":126381,"_3076":126441},[],"Cuándo utilizarlo",{"_3624":74726,"_31165":74702,"_21590":126443,"_5":14857,"_28357":126381,"_3076":126444},[],"Qué debes mantener",{"_3624":74727,"_31165":74702,"_21590":126446,"_5":14857,"_28357":126381,"_3076":57313},[],{"_3624":74728,"_31165":74702,"_21590":126448,"_5":14857,"_28357":126381,"_3076":126449},[],"Consulta del estado de un certificado concreto.",{"_3624":74729,"_31165":74702,"_21590":126451,"_5":14857,"_28357":126381,"_3076":126452},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3624":74730,"_31165":74702,"_21590":126454,"_5":14857,"_28357":126381,"_3076":57322},[],{"_3624":74731,"_31165":74702,"_21590":126456,"_5":14857,"_28357":126381,"_3076":126457},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3624":74732,"_31165":74702,"_21590":126459,"_5":14857,"_28357":126381,"_3076":126460},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3624":74733,"_31165":74702,"_21590":126462,"_5":14857,"_28357":126381,"_3076":126463},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3624":74734,"_31165":74702,"_21590":126465,"_5":14857,"_28357":126381,"_3076":126466},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3624":74735,"_31165":74702,"_21590":126468,"_5":14857,"_28357":126385,"_3076":126469},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3624":74736,"_31165":74702,"_21590":126471,"_5":14857,"_28357":126385,"_3076":126472},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3624":74737,"_31165":74702,"_21590":126474,"_5":14857,"_28357":126385,"_3076":126475},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3624":74738,"_31165":74702,"_21590":126477,"_5":14857,"_28357":126385,"_3076":126478},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3624":74739,"_31165":74702,"_21590":126480,"_5":14857,"_28357":126385,"_3076":126481},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3624":74740,"_31165":74702,"_21590":126483,"_5":14857,"_28357":126385,"_3076":126484},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3624":74741,"_31165":74702,"_21590":126486,"_5":14857,"_28357":126385,"_3076":126487},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3624":74742,"_31165":74702,"_21590":126489,"_5":14857,"_28357":126385,"_3076":126490},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":74743,"_31165":74702,"_21590":126492,"_5":14857,"_28357":126385,"_3076":126493},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3624":74744,"_31165":74744,"_5":15217,"_3076":126495,"_31503":126496,"_21590":126497,"_28357":74744},"Certificados",[50900,121699,56586,125721],[],{"_3624":74745,"_31165":74744,"_21590":126499,"_5":14857,"_28357":74744,"_3076":126500},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3624":74746,"_31165":74744,"_5":31500,"_21590":126502,"_28357":126503,"_3076":126504},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3624":74747,"_31165":74744,"_5":31500,"_21590":126506,"_28357":126507,"_3076":126508},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3624":74748,"_31165":74744,"_5":31500,"_21590":126510,"_28357":126511,"_3076":126512},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3624":74749,"_31165":74744,"_5":31500,"_21590":126514,"_28357":126515,"_3076":126516},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3624":74750,"_31165":74744,"_5":31500,"_21590":126518,"_28357":126519,"_3076":126520},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3624":74751,"_31165":74744,"_5":31500,"_21590":126522,"_28357":126523,"_3076":126524},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3624":74752,"_31165":74744,"_5":31500,"_21590":126526,"_28357":126527,"_3076":126528},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3624":74753,"_31165":74744,"_5":31500,"_21590":126530,"_28357":126531,"_3076":126532},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3624":74754,"_31165":74744,"_5":31500,"_21590":126534,"_28357":126535,"_3076":126536},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3624":74755,"_31165":74744,"_21590":126538,"_5":14857,"_28357":74744,"_3076":126539},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3624":74756,"_31165":74744,"_21590":126541,"_5":14857,"_28357":126503,"_3076":126542},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3624":74757,"_31165":74744,"_21590":126544,"_5":14857,"_28357":126503,"_3076":126545},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3624":74758,"_31165":74744,"_21590":126547,"_5":14857,"_28357":126503,"_3076":126548},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3624":74759,"_31165":74744,"_21590":126550,"_5":14857,"_28357":126503,"_3076":126551},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3624":74760,"_31165":74744,"_21590":126553,"_5":14857,"_28357":126503,"_3076":126554},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3624":74761,"_31165":74744,"_21590":126556,"_5":14857,"_28357":126503,"_3076":126557},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3624":74762,"_31165":74744,"_21590":126559,"_5":14857,"_28357":126503,"_3076":126560},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3624":74763,"_31165":74744,"_21590":126562,"_5":14857,"_28357":126507,"_3076":126563},[],"Descarga el PEM e inspecciónalo:",{"_3624":74764,"_31165":74744,"_21590":126565,"_5":14857,"_28357":126507,"_3076":126566},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3624":74765,"_31165":74744,"_21590":126568,"_5":14857,"_28357":126511,"_3076":126569},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3624":74766,"_31165":74744,"_21590":126571,"_5":14857,"_28357":126511,"_3076":126572},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3624":74767,"_31165":74744,"_21590":126574,"_5":14857,"_28357":126511,"_3076":126575},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3624":74768,"_31165":74744,"_21590":126577,"_5":14857,"_28357":126511,"_3076":126578},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3624":74769,"_31165":74744,"_21590":126580,"_5":14857,"_28357":126511,"_3076":126581},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3624":74770,"_31165":74744,"_21590":126583,"_5":14857,"_28357":126511,"_3076":126584},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3624":74771,"_31165":74744,"_21590":126586,"_5":14857,"_28357":126511,"_3076":126587},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3624":74772,"_31165":74744,"_21590":126589,"_5":14857,"_28357":126515,"_3076":126590},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3624":74773,"_31165":74744,"_21590":126592,"_5":14857,"_28357":126519,"_3076":126593},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3624":74774,"_31165":74744,"_21590":126595,"_5":14857,"_28357":126523,"_3076":126596},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3624":74775,"_31165":74744,"_21590":126598,"_5":14857,"_28357":126527,"_3076":126599},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3624":74776,"_31165":74744,"_21590":126601,"_5":14857,"_28357":126527,"_3076":126602},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3624":74777,"_31165":74744,"_21590":126604,"_5":14857,"_28357":126527,"_3076":126605},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3624":74778,"_31165":74744,"_21590":126607,"_5":14857,"_28357":126531,"_3076":126608},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3624":74779,"_31165":74744,"_21590":126610,"_5":14857,"_28357":126531,"_3076":126611},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3624":74780,"_31165":74744,"_21590":126613,"_5":14857,"_28357":126531,"_3076":126614},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3624":74781,"_31165":74744,"_21590":126616,"_5":14857,"_28357":126535,"_3076":126617},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":74782,"_31165":74744,"_21590":126619,"_5":14857,"_28357":126535,"_3076":126620},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3624":74783,"_31165":74783,"_5":15217,"_3076":126622,"_31503":126623,"_21590":126625,"_28357":74783},"Ciclo de vida de un certificado",[50900,121699,56586,126624],"Conceptos",[],{"_3624":74784,"_31165":74783,"_21590":126627,"_5":14857,"_28357":74783,"_3076":126628},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3624":74785,"_31165":74783,"_5":31500,"_21590":126630,"_28357":126631,"_3076":126632},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3624":74786,"_31165":74783,"_5":31500,"_21590":126634,"_28357":126635,"_3076":126636},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3624":74787,"_31165":74783,"_5":31500,"_21590":126638,"_28357":126639,"_3076":126640},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3624":74788,"_31165":74783,"_5":31500,"_21590":126642,"_28357":126643,"_3076":126644},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3624":74789,"_31165":74783,"_5":31500,"_21590":126646,"_28357":126647,"_3076":126648},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3624":74790,"_31165":74783,"_5":31500,"_21590":126650,"_28357":126651,"_3076":126652},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3624":74791,"_31165":74783,"_5":31500,"_21590":126654,"_28357":126655,"_3076":124344},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3624":74792,"_31165":74783,"_5":31500,"_21590":126657,"_28357":126658,"_3076":126659},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3624":74793,"_31165":74783,"_5":31500,"_21590":126661,"_28357":126662,"_3076":126663},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3624":74794,"_31165":74783,"_5":31500,"_21590":126665,"_28357":126666,"_3076":126667},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3624":74795,"_31165":74783,"_21590":126669,"_5":14857,"_28357":74783,"_3076":126670},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3624":74796,"_31165":74783,"_21590":126672,"_5":14857,"_28357":126635,"_3076":126673},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3624":74797,"_31165":74783,"_21590":126675,"_5":14857,"_28357":126639,"_3076":126676},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3624":74798,"_31165":74783,"_21590":126678,"_5":14857,"_28357":126643,"_3076":126679},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3624":74799,"_31165":74783,"_21590":126681,"_5":14857,"_28357":126647,"_3076":126682},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3624":74800,"_31165":74783,"_21590":126684,"_5":14857,"_28357":126651,"_3076":126685},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3624":74801,"_31165":74783,"_21590":126687,"_5":14857,"_28357":126655,"_3076":126688},[],"Lamassu persiste cuatro estados X.509:",{"_3624":74802,"_31165":74783,"_21590":126690,"_5":14857,"_28357":126655,"_3076":126691},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3624":74803,"_31165":74783,"_21590":126693,"_5":14857,"_28357":126655,"_3076":126694},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3624":74804,"_31165":74783,"_21590":126696,"_5":14857,"_28357":126655,"_3076":126697},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3624":74805,"_31165":74783,"_21590":126699,"_5":14857,"_28357":126655,"_3076":126700},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3624":74806,"_31165":74783,"_21590":126702,"_5":14857,"_28357":126655,"_3076":126703},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3624":74807,"_31165":74783,"_21590":126705,"_5":14857,"_28357":126658,"_3076":126706},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3624":74808,"_31165":74783,"_21590":126708,"_5":14857,"_28357":126658,"_3076":126709},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3624":74809,"_31165":74783,"_21590":126711,"_5":14857,"_28357":126658,"_3076":126712},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3624":74810,"_31165":74783,"_21590":126714,"_5":14857,"_28357":126662,"_3076":126715},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3624":74811,"_31165":74783,"_21590":126717,"_5":14857,"_28357":126662,"_3076":126718},[],"Antes de confirmar:",{"_3624":74812,"_31165":74783,"_21590":126720,"_5":14857,"_28357":126662,"_3076":126721},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3624":74813,"_31165":74783,"_21590":126723,"_5":14857,"_28357":126662,"_3076":126724},[],"Distribuye la nueva cadena de confianza.",{"_3624":74814,"_31165":74783,"_21590":126726,"_5":14857,"_28357":126662,"_3076":126727},[],"Reemite las identidades necesarias.",{"_3624":74815,"_31165":74783,"_21590":126729,"_5":14857,"_28357":126662,"_3076":126730},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3624":74816,"_31165":74783,"_21590":126732,"_5":14857,"_28357":126662,"_3076":126733},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3624":74817,"_31165":74783,"_21590":126735,"_5":14857,"_28357":126662,"_3076":126736},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3624":74818,"_31165":74783,"_21590":126738,"_5":14857,"_28357":126666,"_3076":126739},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3624":74819,"_31165":74783,"_21590":126741,"_5":14857,"_28357":126666,"_3076":126742},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3624":74820,"_31165":74783,"_21590":126744,"_5":14857,"_28357":126666,"_3076":126745},[],"Cambios de estado y razones de revocación.",{"_3624":74821,"_31165":74783,"_21590":126747,"_5":14857,"_28357":126666,"_3076":126748},[],"Publicación y vigencia de OCSP y CRLs.",{"_3624":74822,"_31165":74783,"_21590":126750,"_5":14857,"_28357":126666,"_3076":126751},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3624":74823,"_31165":74783,"_21590":126753,"_5":14857,"_28357":126666,"_3076":126754},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3624":74824,"_31165":74824,"_5":15217,"_3076":126756,"_31503":126757,"_21590":126758,"_28357":74824},"Modelo de confianza",[50900,121699,56586,126624],[],{"_3624":74825,"_31165":74824,"_21590":126760,"_5":14857,"_28357":74824,"_3076":126761},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3624":74826,"_31165":74824,"_5":31500,"_21590":126763,"_28357":126764,"_3076":126765},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3624":74827,"_31165":74824,"_5":31500,"_21590":126767,"_28357":126768,"_3076":126769},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3624":74828,"_31165":74824,"_5":31500,"_21590":126771,"_28357":126772,"_3076":126773},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3624":74829,"_31165":74824,"_5":31500,"_21590":126775,"_28357":126776,"_3076":126777},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3624":74830,"_31165":74824,"_5":31500,"_21590":126779,"_28357":126780,"_3076":126781},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3624":74831,"_31165":74824,"_5":31500,"_21590":126783,"_28357":126784,"_3076":126785},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3624":74832,"_31165":74824,"_5":31500,"_21590":126787,"_28357":126788,"_3076":126789},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3624":74833,"_31165":74824,"_5":31500,"_21590":126791,"_28357":126792,"_3076":126793},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3624":74834,"_31165":74824,"_5":31500,"_21590":126795,"_28357":126796,"_3076":126797},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3624":74835,"_31165":74824,"_5":31500,"_21590":126799,"_28357":126800,"_3076":126801},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3624":74836,"_31165":74824,"_21590":126803,"_5":14857,"_28357":74824,"_3076":126804},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3624":74837,"_31165":74824,"_21590":126806,"_5":14857,"_28357":126768,"_3076":126807},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3624":74838,"_31165":74824,"_21590":126809,"_5":14857,"_28357":126772,"_3076":126810},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3624":74839,"_31165":74824,"_21590":126812,"_5":14857,"_28357":126776,"_3076":126813},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3624":74840,"_31165":74824,"_21590":126815,"_5":14857,"_28357":126780,"_3076":126816},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3624":74841,"_31165":74824,"_21590":126818,"_5":14857,"_28357":126784,"_3076":126819},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3624":74842,"_31165":74824,"_21590":126821,"_5":14857,"_28357":126784,"_3076":126822},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3624":74843,"_31165":74824,"_21590":126824,"_5":14857,"_28357":126784,"_3076":126825},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3624":74844,"_31165":74824,"_21590":126827,"_5":14857,"_28357":126784,"_3076":126828},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3624":74845,"_31165":74824,"_21590":126830,"_5":14857,"_28357":126784,"_3076":126831},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3624":74846,"_31165":74824,"_21590":126833,"_5":14857,"_28357":126784,"_3076":126834},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3624":74847,"_31165":74824,"_21590":126836,"_5":14857,"_28357":126788,"_3076":126837},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3624":74848,"_31165":74824,"_21590":126839,"_5":14857,"_28357":126788,"_3076":126840},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3624":74849,"_31165":74824,"_21590":126842,"_5":14857,"_28357":126788,"_3076":126843},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3624":74850,"_31165":74824,"_21590":126845,"_5":14857,"_28357":126788,"_3076":126846},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3624":74851,"_31165":74824,"_21590":126848,"_5":14857,"_28357":126788,"_3076":126849},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3624":74852,"_31165":74824,"_21590":126851,"_5":14857,"_28357":126792,"_3076":126852},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3624":74853,"_31165":74824,"_21590":126854,"_5":14857,"_28357":126792,"_3076":126855},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3624":74854,"_31165":74824,"_21590":126857,"_5":14857,"_28357":126792,"_3076":126858},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3624":74855,"_31165":74824,"_21590":126860,"_5":14857,"_28357":126792,"_3076":126861},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3624":74856,"_31165":74824,"_21590":126863,"_5":14857,"_28357":126792,"_3076":126864},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3624":74857,"_31165":74824,"_21590":126866,"_5":14857,"_28357":126792,"_3076":126867},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3624":74858,"_31165":74824,"_21590":126869,"_5":14857,"_28357":126792,"_3076":126870},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3624":74859,"_31165":74824,"_21590":126872,"_5":14857,"_28357":126796,"_3076":126873},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3624":74860,"_31165":74824,"_21590":126875,"_5":14857,"_28357":126800,"_3076":126876},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3624":74861,"_31165":74824,"_21590":126878,"_5":14857,"_28357":126800,"_3076":126879},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3624":74862,"_31165":74824,"_21590":126881,"_5":14857,"_28357":126800,"_3076":126882},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3624":74863,"_31165":74824,"_21590":126884,"_5":14857,"_28357":126800,"_3076":126885},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3624":74864,"_31165":74824,"_21590":126887,"_5":14857,"_28357":126800,"_3076":126888},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3624":74865,"_31165":74824,"_21590":126890,"_5":14857,"_28357":126800,"_3076":126891},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3624":74866,"_31165":74824,"_21590":126893,"_5":14857,"_28357":126800,"_3076":126894},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3624":74867,"_31165":74867,"_5":15217,"_3076":126896,"_31503":126897,"_21590":126898,"_28357":74867},"Listas de revocación (CRL)",[50900,121699,56586,126370],[],{"_3624":74868,"_31165":74867,"_21590":126900,"_5":14857,"_28357":74867,"_3076":126901},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3624":74869,"_31165":74867,"_5":31500,"_21590":126903,"_28357":126904,"_3076":126905},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3624":74870,"_31165":74867,"_5":31500,"_21590":126907,"_28357":126908,"_3076":126909},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3624":74871,"_31165":74867,"_5":31500,"_21590":126911,"_28357":126912,"_3076":126913},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3624":74872,"_31165":74867,"_5":31500,"_21590":126915,"_28357":126916,"_3076":126917},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3624":74873,"_31165":74867,"_5":31500,"_21590":126919,"_28357":126920,"_3076":126921},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3624":74874,"_31165":74867,"_5":31500,"_21590":126923,"_28357":126924,"_3076":126925},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3624":74875,"_31165":74867,"_5":31500,"_21590":126927,"_28357":126928,"_3076":126929},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3624":74876,"_31165":74867,"_5":31500,"_21590":126931,"_28357":126932,"_3076":126933},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3624":74877,"_31165":74867,"_21590":126935,"_5":14857,"_28357":74867,"_3076":126936},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3624":74878,"_31165":74867,"_21590":126938,"_5":14857,"_28357":126904,"_3076":126939},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3624":74879,"_31165":74867,"_21590":126941,"_5":14857,"_28357":126904,"_3076":126942},[],"Campo",{"_3624":74880,"_31165":74867,"_21590":126944,"_5":14857,"_28357":126904,"_3076":123385},[],{"_3624":74881,"_31165":74867,"_21590":126946,"_5":14857,"_28357":126904,"_3076":52532},[],{"_3624":74882,"_31165":74867,"_21590":126948,"_5":14857,"_28357":126904,"_3076":126949},[],"ID de la CA a la que pertenecen los ajustes.",{"_3624":74883,"_31165":74867,"_21590":126951,"_5":14857,"_28357":126904,"_3076":57821},[],{"_3624":74884,"_31165":74867,"_21590":126953,"_5":14857,"_28357":126904,"_3076":126954},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3624":74885,"_31165":74867,"_21590":126956,"_5":14857,"_28357":126904,"_3076":57827},[],{"_3624":74886,"_31165":74867,"_21590":126958,"_5":14857,"_28357":126904,"_3076":126959},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3624":74887,"_31165":74867,"_21590":126961,"_5":14857,"_28357":126904,"_3076":57833},[],{"_3624":74888,"_31165":74867,"_21590":126963,"_5":14857,"_28357":126904,"_3076":126964},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3624":74889,"_31165":74867,"_21590":126966,"_5":14857,"_28357":126904,"_3076":126967},[],"Campo de `crl_options`",{"_3624":74890,"_31165":74867,"_21590":126969,"_5":14857,"_28357":126904,"_3076":123385},[],{"_3624":74891,"_31165":74867,"_21590":126971,"_5":14857,"_28357":126904,"_3076":126972},[],"Valor inicial",{"_3624":74892,"_31165":74867,"_21590":126974,"_5":14857,"_28357":126904,"_3076":57847},[],{"_3624":74893,"_31165":74867,"_21590":126976,"_5":14857,"_28357":126904,"_3076":126977},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3624":74894,"_31165":74867,"_21590":126979,"_5":14857,"_28357":126904,"_3076":126980},[],"7 días.",{"_3624":74895,"_31165":74867,"_21590":126982,"_5":14857,"_28357":126904,"_3076":57856},[],{"_3624":74896,"_31165":74867,"_21590":126984,"_5":14857,"_28357":126904,"_3076":126985},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3624":74897,"_31165":74867,"_21590":126987,"_5":14857,"_28357":126904,"_3076":126988},[],"6 días y 23 horas.",{"_3624":74898,"_31165":74867,"_21590":126990,"_5":14857,"_28357":126904,"_3076":57865},[],{"_3624":74899,"_31165":74867,"_21590":126992,"_5":14857,"_28357":126904,"_3076":126993},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3624":74900,"_31165":74867,"_21590":126995,"_5":14857,"_28357":126904,"_3076":57871},[],{"_3624":74901,"_31165":74867,"_21590":126997,"_5":14857,"_28357":126904,"_3076":57874},[],{"_3624":74902,"_31165":74867,"_21590":126999,"_5":14857,"_28357":126904,"_3076":127000},[],"Número de serie del certificado existente que firma la CRL.",{"_3624":74903,"_31165":74867,"_21590":127002,"_5":14857,"_28357":126904,"_3076":127003},[],"Número de serie del certificado actual de la CA.",{"_3624":74904,"_31165":74867,"_21590":127005,"_5":14857,"_28357":126904,"_3076":127006},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3624":74905,"_31165":74867,"_21590":127008,"_5":14857,"_28357":126904,"_3076":127009},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3624":74906,"_31165":74867,"_21590":127011,"_5":14857,"_28357":126904,"_3076":127012},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3624":74907,"_31165":74867,"_21590":127014,"_5":14857,"_28357":126904,"_3076":127015},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3624":74908,"_31165":74867,"_21590":127017,"_5":14857,"_28357":126904,"_3076":127018},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3624":74909,"_31165":74867,"_21590":127020,"_5":14857,"_28357":126904,"_3076":127021},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3624":74910,"_31165":74867,"_21590":127023,"_5":14857,"_28357":126904,"_3076":127024},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3624":74911,"_31165":74867,"_21590":127026,"_5":14857,"_28357":126904,"_3076":127027},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3624":74912,"_31165":74867,"_21590":127029,"_5":14857,"_28357":126904,"_3076":127030},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3624":74913,"_31165":74867,"_21590":127032,"_5":14857,"_28357":126904,"_3076":127033},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3624":74914,"_31165":74867,"_21590":127035,"_5":14857,"_28357":126904,"_3076":127036},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3624":74915,"_31165":74867,"_21590":127038,"_5":14857,"_28357":126908,"_3076":127039},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3624":74916,"_31165":74867,"_21590":127041,"_5":14857,"_28357":126908,"_3076":127042},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3624":74917,"_31165":74867,"_21590":127044,"_5":14857,"_28357":126908,"_3076":127045},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3624":74918,"_31165":74867,"_21590":127047,"_5":14857,"_28357":126908,"_3076":127048},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3624":74919,"_31165":74867,"_21590":127050,"_5":14857,"_28357":126912,"_3076":127051},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3624":74920,"_31165":74867,"_21590":127053,"_5":14857,"_28357":126912,"_3076":127054},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3624":74921,"_31165":74867,"_21590":127056,"_5":14857,"_28357":126912,"_3076":127057},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3624":74922,"_31165":74867,"_21590":127059,"_5":14857,"_28357":126912,"_3076":127060},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3624":74923,"_31165":74867,"_21590":127062,"_5":14857,"_28357":126912,"_3076":127063},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3624":74924,"_31165":74867,"_21590":127065,"_5":14857,"_28357":126912,"_3076":127066},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3624":74925,"_31165":74867,"_21590":127068,"_5":14857,"_28357":126912,"_3076":127069},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3624":74926,"_31165":74867,"_21590":127071,"_5":14857,"_28357":126912,"_3076":127072},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3624":74927,"_31165":74867,"_21590":127074,"_5":14857,"_28357":126912,"_3076":127075},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3624":74928,"_31165":74867,"_21590":127077,"_5":14857,"_28357":126916,"_3076":127078},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3624":74929,"_31165":74867,"_21590":127080,"_5":14857,"_28357":126916,"_3076":127081},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3624":74930,"_31165":74867,"_21590":127083,"_5":14857,"_28357":126920,"_3076":127084},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3624":74931,"_31165":74867,"_21590":127086,"_5":14857,"_28357":126920,"_3076":127087},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3624":74932,"_31165":74867,"_21590":127089,"_5":14857,"_28357":126920,"_3076":127090},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3624":74933,"_31165":74867,"_21590":127092,"_5":14857,"_28357":126920,"_3076":127093},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3624":74934,"_31165":74867,"_21590":127095,"_5":14857,"_28357":126920,"_3076":127096},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3624":74935,"_31165":74867,"_21590":127098,"_5":14857,"_28357":126924,"_3076":127099},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3624":74936,"_31165":74867,"_21590":127101,"_5":14857,"_28357":126924,"_3076":123574},[],{"_3624":74937,"_31165":74867,"_21590":127103,"_5":14857,"_28357":126924,"_3076":127104},[],"Path relativo",{"_3624":74938,"_31165":74867,"_21590":127106,"_5":14857,"_28357":126924,"_3076":121459},[],{"_3624":74939,"_31165":74867,"_21590":127108,"_5":14857,"_28357":126924,"_3076":57986},[],{"_3624":74940,"_31165":74867,"_21590":127110,"_5":14857,"_28357":126924,"_3076":57989},[],{"_3624":74941,"_31165":74867,"_21590":127112,"_5":14857,"_28357":126924,"_3076":127113},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3624":74942,"_31165":74867,"_21590":127115,"_5":14857,"_28357":126924,"_3076":57986},[],{"_3624":74943,"_31165":74867,"_21590":127117,"_5":14857,"_28357":126924,"_3076":57997},[],{"_3624":74944,"_31165":74867,"_21590":127119,"_5":14857,"_28357":126924,"_3076":127120},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3624":74945,"_31165":74867,"_21590":127122,"_5":14857,"_28357":126924,"_3076":58003},[],{"_3624":74946,"_31165":74867,"_21590":127124,"_5":14857,"_28357":126924,"_3076":57997},[],{"_3624":74947,"_31165":74867,"_21590":127126,"_5":14857,"_28357":126924,"_3076":127127},[],"Sustituir la configuración de CRL de una CA.",{"_3624":74948,"_31165":74867,"_21590":127129,"_5":14857,"_28357":126924,"_3076":58011},[],{"_3624":74949,"_31165":74867,"_21590":127131,"_5":14857,"_28357":126924,"_3076":57997},[],{"_3624":74950,"_31165":74867,"_21590":127133,"_5":14857,"_28357":126924,"_3076":127134},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3624":74951,"_31165":74867,"_21590":127136,"_5":14857,"_28357":126924,"_3076":127137},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3624":74952,"_31165":74867,"_21590":127139,"_5":14857,"_28357":126924,"_3076":127140},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3624":74953,"_31165":74867,"_21590":127142,"_5":14857,"_28357":126924,"_3076":127143},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3624":74954,"_31165":74867,"_21590":127145,"_5":14857,"_28357":126928,"_3076":127146},[],"Síntoma",{"_3624":74955,"_31165":74867,"_21590":127148,"_5":14857,"_28357":126928,"_3076":127149},[],"Causa",{"_3624":74956,"_31165":74867,"_21590":127151,"_5":14857,"_28357":126928,"_3076":127152},[],"Acción",{"_3624":74957,"_31165":74867,"_21590":127154,"_5":14857,"_28357":126928,"_3076":127155},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3624":74958,"_31165":74867,"_21590":127157,"_5":14857,"_28357":126928,"_3076":127158},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3624":74959,"_31165":74867,"_21590":127160,"_5":14857,"_28357":126928,"_3076":127161},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3624":74960,"_31165":74867,"_21590":127163,"_5":14857,"_28357":126928,"_3076":127164},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3624":74961,"_31165":74867,"_21590":127166,"_5":14857,"_28357":126928,"_3076":127167},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3624":74962,"_31165":74867,"_21590":127169,"_5":14857,"_28357":126928,"_3076":127170},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3624":74963,"_31165":74867,"_21590":127172,"_5":14857,"_28357":126928,"_3076":127173},[],"`PUT` devuelve 400.",{"_3624":74964,"_31165":74867,"_21590":127175,"_5":14857,"_28357":126928,"_3076":127176},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3624":74965,"_31165":74867,"_21590":127178,"_5":14857,"_28357":126928,"_3076":127179},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3624":74966,"_31165":74867,"_21590":127181,"_5":14857,"_28357":126928,"_3076":127182},[],"`PUT` devuelve 404.",{"_3624":74967,"_31165":74867,"_21590":127184,"_5":14857,"_28357":126928,"_3076":127185},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3624":74968,"_31165":74867,"_21590":127187,"_5":14857,"_28357":126928,"_3076":127188},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3624":74969,"_31165":74867,"_21590":127190,"_5":14857,"_28357":126928,"_3076":127191},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3624":74970,"_31165":74867,"_21590":127193,"_5":14857,"_28357":126928,"_3076":127194},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3624":74971,"_31165":74867,"_21590":127196,"_5":14857,"_28357":126928,"_3076":127197},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3624":74972,"_31165":74867,"_21590":127199,"_5":14857,"_28357":126928,"_3076":127200},[],"La CRL no cambia tras revocar un certificado.",{"_3624":74973,"_31165":74867,"_21590":127202,"_5":14857,"_28357":126928,"_3076":127203},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3624":74974,"_31165":74867,"_21590":127205,"_5":14857,"_28357":126928,"_3076":127206},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3624":74975,"_31165":74867,"_21590":127208,"_5":14857,"_28357":126928,"_3076":127209},[],"Un verificador rechaza la CRL por el emisor.",{"_3624":74976,"_31165":74867,"_21590":127211,"_5":14857,"_28357":126928,"_3076":127212},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3624":74977,"_31165":74867,"_21590":127214,"_5":14857,"_28357":126928,"_3076":127215},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3624":74978,"_31165":74867,"_21590":127217,"_5":14857,"_28357":126932,"_3076":127218},[],"RFC 5280: perfil X.509 y CRL.",{"_3624":74979,"_31165":74867,"_21590":127220,"_5":14857,"_28357":126932,"_3076":58103},[],{"_3624":74980,"_31165":74867,"_21590":127222,"_5":14857,"_28357":126932,"_3076":58106},[],{"_3624":74981,"_31165":74867,"_21590":127224,"_5":14857,"_28357":126932,"_3076":127225},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3624":74982,"_31165":74867,"_21590":127227,"_5":14857,"_28357":126932,"_3076":127228},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3624":74983,"_31165":74983,"_5":15217,"_3076":127230,"_31503":127231,"_21590":127232,"_28357":74983},"Claves y motores criptográficos",[50900,121699,56586,125721],[],{"_3624":74984,"_31165":74983,"_21590":127234,"_5":14857,"_28357":74983,"_3076":127235},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3624":74985,"_31165":74983,"_5":31500,"_21590":127237,"_28357":127238,"_3076":127239},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3624":74986,"_31165":74983,"_5":31500,"_21590":127241,"_28357":127242,"_3076":127243},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3624":74987,"_31165":74983,"_5":31500,"_21590":127245,"_28357":127246,"_3076":58131},[],"/docs/es/platform/pki/key-management#file-system",{"_3624":74988,"_31165":74983,"_5":31500,"_21590":127248,"_28357":127249,"_3076":58135},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3624":74989,"_31165":74983,"_5":31500,"_21590":127251,"_28357":127252,"_3076":58139},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3624":74990,"_31165":74983,"_5":31500,"_21590":127254,"_28357":127255,"_3076":58143},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3624":74991,"_31165":74983,"_5":31500,"_21590":127257,"_28357":127258,"_3076":58147},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3624":74992,"_31165":74983,"_5":31500,"_21590":127260,"_28357":127261,"_3076":58151},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3624":74993,"_31165":74983,"_5":31500,"_21590":127263,"_28357":127264,"_3076":127265},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3624":74994,"_31165":74983,"_5":31500,"_21590":127267,"_28357":127268,"_3076":127269},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3624":74995,"_31165":74983,"_5":31500,"_21590":127271,"_28357":127272,"_3076":127273},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3624":74996,"_31165":74983,"_5":31500,"_21590":127275,"_28357":127276,"_3076":127277},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3624":74997,"_31165":74983,"_5":31500,"_21590":127279,"_28357":127280,"_3076":127281},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3624":74998,"_31165":74983,"_5":31500,"_21590":127283,"_28357":127284,"_3076":127285},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3624":74999,"_31165":74983,"_5":31500,"_21590":127287,"_28357":127288,"_3076":127289},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3624":75000,"_31165":74983,"_5":31500,"_21590":127291,"_28357":127292,"_3076":58183},[],"/docs/es/platform/pki/key-management#sign",{"_3624":75001,"_31165":74983,"_5":31500,"_21590":127294,"_28357":127295,"_3076":58187},[],"/docs/es/platform/pki/key-management#verify",{"_3624":75002,"_31165":74983,"_5":31500,"_21590":127297,"_28357":127298,"_3076":127299},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3624":75003,"_31165":74983,"_5":31500,"_21590":127301,"_28357":127302,"_3076":127303},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3624":75004,"_31165":74983,"_5":31500,"_21590":127305,"_28357":127306,"_3076":127307},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3624":75005,"_31165":74983,"_21590":127309,"_5":14857,"_28357":74983,"_3076":127310},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3624":75006,"_31165":74983,"_21590":127312,"_5":14857,"_28357":74983,"_3076":127313},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3624":75007,"_31165":74983,"_21590":127315,"_5":14857,"_28357":127238,"_3076":127316},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3624":75008,"_31165":74983,"_21590":127318,"_5":14857,"_28357":127238,"_3076":127319},[],"En la práctica, permite:",{"_3624":75009,"_31165":74983,"_21590":127321,"_5":14857,"_28357":127238,"_3076":127322},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3624":75010,"_31165":74983,"_21590":127324,"_5":14857,"_28357":127238,"_3076":127325},[],"Importar claves creadas externamente.",{"_3624":75011,"_31165":74983,"_21590":127327,"_5":14857,"_28357":127238,"_3076":127328},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3624":75012,"_31165":74983,"_21590":127330,"_5":14857,"_28357":127238,"_3076":127331},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3624":75013,"_31165":74983,"_21590":127333,"_5":14857,"_28357":127242,"_3076":127334},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3624":75014,"_31165":74983,"_21590":127336,"_5":14857,"_28357":127242,"_3076":127337},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3624":75015,"_31165":74983,"_21590":127339,"_5":14857,"_28357":127242,"_3076":127340},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3624":75016,"_31165":74983,"_21590":127342,"_5":14857,"_28357":127246,"_3076":127343},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3624":75017,"_31165":74983,"_21590":127345,"_5":14857,"_28357":127249,"_3076":127346},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3624":75018,"_31165":74983,"_21590":127348,"_5":14857,"_28357":127249,"_3076":127349},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3624":75019,"_31165":74983,"_21590":127351,"_5":14857,"_28357":127252,"_3076":127352},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3624":75020,"_31165":74983,"_21590":127354,"_5":14857,"_28357":127255,"_3076":127355},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3624":75021,"_31165":74983,"_21590":127357,"_5":14857,"_28357":127258,"_3076":127358},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3624":75022,"_31165":74983,"_21590":127360,"_5":14857,"_28357":127261,"_3076":127361},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3624":75023,"_31165":74983,"_21590":127363,"_5":14857,"_28357":127261,"_3076":127364},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3624":75024,"_31165":74983,"_21590":127366,"_5":14857,"_28357":127261,"_3076":127367},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3624":75025,"_31165":74983,"_21590":127369,"_5":14857,"_28357":127261,"_3076":127370},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3624":75026,"_31165":74983,"_21590":127372,"_5":14857,"_28357":127264,"_3076":127373},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3624":75027,"_31165":74983,"_21590":127375,"_5":14857,"_28357":127264,"_3076":127376},[],"La tabla incluye los siguientes campos:",{"_3624":75028,"_31165":74983,"_21590":127378,"_5":14857,"_28357":127264,"_3076":127379},[],"**Name**: nombre descriptivo de la clave.",{"_3624":75029,"_31165":74983,"_21590":127381,"_5":14857,"_28357":127264,"_3076":127382},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3624":75030,"_31165":74983,"_21590":127384,"_5":14857,"_28357":127264,"_3076":127385},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3624":75031,"_31165":74983,"_21590":127387,"_5":14857,"_28357":127264,"_3076":127388},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3624":75032,"_31165":74983,"_21590":127390,"_5":14857,"_28357":127264,"_3076":127391},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3624":75033,"_31165":74983,"_21590":127393,"_5":14857,"_28357":127264,"_3076":127394},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3624":75034,"_31165":74983,"_21590":127396,"_5":14857,"_28357":127264,"_3076":127397},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3624":75035,"_31165":74983,"_21590":127399,"_5":14857,"_28357":127264,"_3076":127400},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3624":75036,"_31165":74983,"_21590":127402,"_5":14857,"_28357":127264,"_3076":127403},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3624":75037,"_31165":74983,"_21590":127405,"_5":14857,"_28357":127264,"_3076":127406},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3624":75038,"_31165":74983,"_21590":127408,"_5":14857,"_28357":127264,"_3076":127409},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3624":75039,"_31165":74983,"_21590":127411,"_5":14857,"_28357":127264,"_3076":127412},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3624":75040,"_31165":74983,"_21590":127414,"_5":14857,"_28357":127264,"_3076":127415},[],"**Delete Key** para eliminar la clave del sistema.",{"_3624":75041,"_31165":74983,"_21590":127417,"_5":14857,"_28357":127268,"_3076":127418},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3624":75042,"_31165":74983,"_21590":127420,"_5":14857,"_28357":127272,"_3076":127421},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3624":75043,"_31165":74983,"_21590":127423,"_5":14857,"_28357":127272,"_3076":127424},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3624":75044,"_31165":74983,"_21590":127426,"_5":14857,"_28357":127272,"_3076":127427},[],"**Key Name**: nombre único y descriptivo.",{"_3624":75045,"_31165":74983,"_21590":127429,"_5":14857,"_28357":127272,"_3076":127430},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3624":75046,"_31165":74983,"_21590":127432,"_5":14857,"_28357":127272,"_3076":127433},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3624":75047,"_31165":74983,"_21590":127435,"_5":14857,"_28357":127272,"_3076":127436},[],"**Tags**: metadatos para clasificar la clave.",{"_3624":75048,"_31165":74983,"_21590":127438,"_5":14857,"_28357":127272,"_3076":127439},[],"**Metadata**: información adicional para usos avanzados.",{"_3624":75049,"_31165":74983,"_21590":127441,"_5":14857,"_28357":127276,"_3076":127442},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3624":75050,"_31165":74983,"_21590":127444,"_5":14857,"_28357":127276,"_3076":127445},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3624":75051,"_31165":74983,"_21590":127447,"_5":14857,"_28357":127276,"_3076":127448},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3624":75052,"_31165":74983,"_21590":127450,"_5":14857,"_28357":127276,"_3076":127451},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3624":75053,"_31165":74983,"_21590":127453,"_5":14857,"_28357":127276,"_3076":127454},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3624":75054,"_31165":74983,"_21590":127456,"_5":14857,"_28357":127276,"_3076":127457},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3624":75055,"_31165":74983,"_21590":127459,"_5":14857,"_28357":127276,"_3076":127460},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3624":75056,"_31165":74983,"_21590":127462,"_5":14857,"_28357":127276,"_3076":127463},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3624":75057,"_31165":74983,"_21590":127465,"_5":14857,"_28357":127276,"_3076":127466},[],"**Metadata**: información adicional opcional.",{"_3624":75058,"_31165":74983,"_21590":127468,"_5":14857,"_28357":127276,"_3076":127469},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3624":75059,"_31165":74983,"_21590":127471,"_5":14857,"_28357":127276,"_3076":127472},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3624":75060,"_31165":74983,"_21590":127474,"_5":14857,"_28357":127280,"_3076":127475},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3624":75061,"_31165":74983,"_21590":127477,"_5":14857,"_28357":127284,"_3076":127478},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3624":75062,"_31165":74983,"_21590":127480,"_5":14857,"_28357":127284,"_3076":127481},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3624":75063,"_31165":74983,"_21590":127483,"_5":14857,"_28357":127284,"_3076":127484},[],"**Key Name**: nombre descriptivo.",{"_3624":75064,"_31165":74983,"_21590":127486,"_5":14857,"_28357":127284,"_3076":127487},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3624":75065,"_31165":74983,"_21590":127489,"_5":14857,"_28357":127284,"_3076":127490},[],"**Tags**: etiquetas asociadas.",{"_3624":75066,"_31165":74983,"_21590":127492,"_5":14857,"_28357":127284,"_3076":127493},[],"**Aliases**: nombres alternativos.",{"_3624":75067,"_31165":74983,"_21590":127495,"_5":14857,"_28357":127284,"_3076":127496},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3624":75068,"_31165":74983,"_21590":127498,"_5":14857,"_28357":127284,"_3076":127499},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3624":75069,"_31165":74983,"_21590":127501,"_5":14857,"_28357":127284,"_3076":127502},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3624":75070,"_31165":74983,"_21590":127504,"_5":14857,"_28357":127284,"_3076":127505},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3624":75071,"_31165":74983,"_21590":127507,"_5":14857,"_28357":127288,"_3076":127508},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3624":75072,"_31165":74983,"_21590":127510,"_5":14857,"_28357":127288,"_3076":127511},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3624":75073,"_31165":74983,"_21590":127513,"_5":14857,"_28357":127288,"_3076":127514},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3624":75074,"_31165":74983,"_21590":127516,"_5":14857,"_28357":127292,"_3076":127517},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3624":75075,"_31165":74983,"_21590":127519,"_5":14857,"_28357":127292,"_3076":127520},[],"Campos principales:",{"_3624":75076,"_31165":74983,"_21590":127522,"_5":14857,"_28357":127292,"_3076":127523},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3624":75077,"_31165":74983,"_21590":127525,"_5":14857,"_28357":127292,"_3076":127526},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3624":75078,"_31165":74983,"_21590":127528,"_5":14857,"_28357":127292,"_3076":127529},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3624":75079,"_31165":74983,"_21590":127531,"_5":14857,"_28357":127292,"_3076":127532},[],"**Message**: contenido que se va a firmar.",{"_3624":75080,"_31165":74983,"_21590":127534,"_5":14857,"_28357":127292,"_3076":127535},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3624":75081,"_31165":74983,"_21590":127537,"_5":14857,"_28357":127295,"_3076":127538},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3624":75082,"_31165":74983,"_21590":127540,"_5":14857,"_28357":127295,"_3076":127520},[],{"_3624":75083,"_31165":74983,"_21590":127542,"_5":14857,"_28357":127295,"_3076":127543},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3624":75084,"_31165":74983,"_21590":127545,"_5":14857,"_28357":127295,"_3076":127546},[],"**Message Type**: `Raw` o `Digest`.",{"_3624":75085,"_31165":74983,"_21590":127548,"_5":14857,"_28357":127295,"_3076":127549},[],"**Payload Encoding**: codificación del mensaje.",{"_3624":75086,"_31165":74983,"_21590":127551,"_5":14857,"_28357":127295,"_3076":127552},[],"**Message**: mensaje original o hash.",{"_3624":75087,"_31165":74983,"_21590":127554,"_5":14857,"_28357":127295,"_3076":127555},[],"**Signature**: firma que se desea comprobar.",{"_3624":75088,"_31165":74983,"_21590":127557,"_5":14857,"_28357":127295,"_3076":127558},[],"**Result**: indicador del resultado de la validación.",{"_3624":75089,"_31165":74983,"_21590":127560,"_5":14857,"_28357":127298,"_3076":127561},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3624":75090,"_31165":74983,"_21590":127563,"_5":14857,"_28357":127298,"_3076":127564},[],"Este flujo es útil para:",{"_3624":75091,"_31165":74983,"_21590":127566,"_5":14857,"_28357":127298,"_3076":127567},[],"Solicitar certificados a una CA externa.",{"_3624":75092,"_31165":74983,"_21590":127569,"_5":14857,"_28357":127298,"_3076":127570},[],"Renovar una identidad manteniendo la misma clave.",{"_3624":75093,"_31165":74983,"_21590":127572,"_5":14857,"_28357":127298,"_3076":127573},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3624":75094,"_31165":74983,"_21590":127575,"_5":14857,"_28357":127298,"_3076":127576},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3624":75095,"_31165":74983,"_21590":127578,"_5":14857,"_28357":127298,"_3076":127579},[],"**Organization (O)**: organización o empresa.",{"_3624":75096,"_31165":74983,"_21590":127581,"_5":14857,"_28357":127298,"_3076":127582},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3624":75097,"_31165":74983,"_21590":127584,"_5":14857,"_28357":127298,"_3076":127585},[],"**Country (C)**: código de país de dos letras.",{"_3624":75098,"_31165":74983,"_21590":127587,"_5":14857,"_28357":127298,"_3076":127588},[],"**State / Province (ST)**: estado o provincia.",{"_3624":75099,"_31165":74983,"_21590":127590,"_5":14857,"_28357":127298,"_3076":127591},[],"**Locality (L)**: ciudad o localidad.",{"_3624":75100,"_31165":74983,"_21590":127593,"_5":14857,"_28357":127298,"_3076":127594},[],"**Email Address**: correo de contacto.",{"_3624":75101,"_31165":74983,"_21590":127596,"_5":14857,"_28357":127298,"_3076":127597},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3624":75102,"_31165":74983,"_21590":127599,"_5":14857,"_28357":127298,"_3076":127600},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3624":75103,"_31165":74983,"_21590":127602,"_5":14857,"_28357":127302,"_3076":127603},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3624":75104,"_31165":74983,"_21590":127605,"_5":14857,"_28357":127302,"_3076":127606},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3624":75105,"_31165":74983,"_21590":127608,"_5":14857,"_28357":127306,"_3076":127609},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3624":75106,"_31165":74983,"_21590":127611,"_5":14857,"_28357":127306,"_3076":127612},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3624":75107,"_31165":75107,"_5":15217,"_3076":127614,"_31503":127615,"_21590":127616,"_28357":75107},"Validación online con OCSP",[50900,121699,56586,126370],[],{"_3624":75108,"_31165":75107,"_21590":127618,"_5":14857,"_28357":75107,"_3076":127619},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3624":75109,"_31165":75107,"_5":31500,"_21590":127621,"_28357":127622,"_3076":127623},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3624":75110,"_31165":75107,"_5":31500,"_21590":127625,"_28357":127626,"_3076":127627},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3624":75111,"_31165":75107,"_5":31500,"_21590":127629,"_28357":127630,"_3076":127631},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3624":75112,"_31165":75107,"_5":31500,"_21590":127633,"_28357":127634,"_3076":127635},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3624":75113,"_31165":75107,"_5":31500,"_21590":127637,"_28357":127638,"_3076":127639},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3624":75114,"_31165":75107,"_5":31500,"_21590":127641,"_28357":127642,"_3076":126933},[],"/docs/es/platform/pki/ocsp#referencias",{"_3624":75115,"_31165":75107,"_21590":127644,"_5":14857,"_28357":75107,"_3076":127645},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3624":75116,"_31165":75107,"_21590":127647,"_5":14857,"_28357":127622,"_3076":127648},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3624":75117,"_31165":75107,"_21590":127650,"_5":14857,"_28357":127622,"_3076":127651},[],"Estado del registro",{"_3624":75118,"_31165":75107,"_21590":127653,"_5":14857,"_28357":127622,"_3076":127654},[],"Respuesta firmada",{"_3624":75119,"_31165":75107,"_21590":127656,"_5":14857,"_28357":127622,"_3076":55723},[],{"_3624":75120,"_31165":75107,"_21590":127658,"_5":14857,"_28357":127622,"_3076":58551},[],{"_3624":75121,"_31165":75107,"_21590":127660,"_5":14857,"_28357":127622,"_3076":55740},[],{"_3624":75122,"_31165":75107,"_21590":127662,"_5":14857,"_28357":127622,"_3076":127663},[],"`Revoked`, con razón y fecha de revocación.",{"_3624":75123,"_31165":75107,"_21590":127665,"_5":14857,"_28357":127622,"_3076":127666},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3624":75124,"_31165":75107,"_21590":127668,"_5":14857,"_28357":127622,"_3076":127669},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3624":75125,"_31165":75107,"_21590":127671,"_5":14857,"_28357":127622,"_3076":127672},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3624":75126,"_31165":75107,"_21590":127674,"_5":14857,"_28357":127622,"_3076":127675},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3624":75127,"_31165":75107,"_21590":127677,"_5":14857,"_28357":127622,"_3076":127678},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3624":75128,"_31165":75107,"_21590":127680,"_5":14857,"_28357":127626,"_3076":127681},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3624":75129,"_31165":75107,"_21590":127683,"_5":14857,"_28357":127626,"_3076":127684},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3624":75130,"_31165":75107,"_21590":127686,"_5":14857,"_28357":127630,"_3076":127687},[],"El servicio acepta:",{"_3624":75131,"_31165":75107,"_21590":127689,"_5":14857,"_28357":127630,"_3076":123574},[],{"_3624":75132,"_31165":75107,"_21590":127691,"_5":14857,"_28357":127630,"_3076":127692},[],"Ruta del servicio VA",{"_3624":75133,"_31165":75107,"_21590":127694,"_5":14857,"_28357":127630,"_3076":127695},[],"Formato",{"_3624":75134,"_31165":75107,"_21590":127697,"_5":14857,"_28357":127630,"_3076":58591},[],{"_3624":75135,"_31165":75107,"_21590":127699,"_5":14857,"_28357":127630,"_3076":58594},[],{"_3624":75136,"_31165":75107,"_21590":127701,"_5":14857,"_28357":127630,"_3076":127702},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3624":75137,"_31165":75107,"_21590":127704,"_5":14857,"_28357":127630,"_3076":57986},[],{"_3624":75138,"_31165":75107,"_21590":127706,"_5":14857,"_28357":127630,"_3076":58602},[],{"_3624":75139,"_31165":75107,"_21590":127708,"_5":14857,"_28357":127630,"_3076":127709},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3624":75140,"_31165":75107,"_21590":127711,"_5":14857,"_28357":127630,"_3076":127712},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3624":75141,"_31165":75107,"_21590":127714,"_5":14857,"_28357":127634,"_3076":127715},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3624":75142,"_31165":75107,"_21590":127717,"_5":14857,"_28357":127634,"_3076":127718},[],"Genera la solicitud:",{"_3624":75143,"_31165":75107,"_21590":127720,"_5":14857,"_28357":127634,"_3076":127721},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3624":75144,"_31165":75107,"_21590":127723,"_5":14857,"_28357":127634,"_3076":127724},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3624":75145,"_31165":75107,"_21590":127726,"_5":14857,"_28357":127634,"_3076":127727},[],"Verifica el DER recibido:",{"_3624":75146,"_31165":75107,"_21590":127729,"_5":14857,"_28357":127634,"_3076":127730},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3624":75147,"_31165":75107,"_21590":127732,"_5":14857,"_28357":127638,"_3076":127733},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3624":75148,"_31165":75107,"_21590":127735,"_5":14857,"_28357":127638,"_3076":127736},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3624":75149,"_31165":75107,"_21590":127738,"_5":14857,"_28357":127642,"_3076":58635},[],{"_3624":75150,"_31165":75107,"_21590":127740,"_5":14857,"_28357":127642,"_3076":58638},[],{"_3624":75151,"_31165":75107,"_21590":127742,"_5":14857,"_28357":127642,"_3076":127743},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3624":75152,"_31165":75107,"_21590":127745,"_5":14857,"_28357":127642,"_3076":127228},[],{"_3624":75153,"_31165":75153,"_5":15217,"_3076":56586,"_31503":127747,"_21590":127748,"_28357":75153},[50900,121699,56586],[],{"_3624":75154,"_31165":75153,"_21590":127750,"_5":14857,"_28357":75153,"_3076":127751},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3624":75155,"_31165":75153,"_5":31500,"_21590":127753,"_28357":127754,"_3076":125047},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3624":75156,"_31165":75153,"_5":31500,"_21590":127756,"_28357":127757,"_3076":127758},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3624":75157,"_31165":75153,"_5":31500,"_21590":127760,"_28357":127761,"_3076":125567},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3624":75158,"_31165":75153,"_5":31500,"_21590":127763,"_28357":127764,"_3076":125571},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3624":75159,"_31165":75153,"_5":31500,"_21590":127766,"_28357":127767,"_3076":125575},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3624":75160,"_31165":75153,"_5":31500,"_21590":127769,"_28357":127770,"_3076":125579},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3624":75161,"_31165":75153,"_5":31500,"_21590":127772,"_28357":127773,"_3076":125587},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3624":75162,"_31165":75153,"_5":31500,"_21590":127775,"_28357":127776,"_3076":127777},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3624":75163,"_31165":75153,"_5":31500,"_21590":127779,"_28357":127780,"_3076":126536},[],"/docs/es/platform/pki/overview#continúa",{"_3624":75164,"_31165":75153,"_21590":127782,"_5":14857,"_28357":75153,"_3076":127783},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3624":75165,"_31165":75153,"_21590":127785,"_5":14857,"_28357":127754,"_3076":127786},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3624":75166,"_31165":75153,"_21590":127788,"_5":14857,"_28357":127754,"_3076":127789},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3624":75167,"_31165":75153,"_21590":127791,"_5":14857,"_28357":127757,"_3076":127792},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3624":75168,"_31165":75153,"_21590":127794,"_5":14857,"_28357":127757,"_3076":127795},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3624":75169,"_31165":75153,"_21590":127797,"_5":14857,"_28357":127757,"_3076":127798},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3624":75170,"_31165":75153,"_21590":127800,"_5":14857,"_28357":127757,"_3076":127801},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3624":75171,"_31165":75153,"_21590":127803,"_5":14857,"_28357":127757,"_3076":127804},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3624":75172,"_31165":75153,"_21590":127806,"_5":14857,"_28357":127764,"_3076":127807},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3624":75173,"_31165":75153,"_21590":127809,"_5":14857,"_28357":127767,"_3076":127810},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3624":75174,"_31165":75153,"_21590":127812,"_5":14857,"_28357":127770,"_3076":127813},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3624":75175,"_31165":75153,"_21590":127815,"_5":14857,"_28357":127773,"_3076":127816},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3624":75176,"_31165":75153,"_21590":127818,"_5":14857,"_28357":127776,"_3076":127819},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3624":75177,"_31165":75153,"_21590":127821,"_5":14857,"_28357":127776,"_3076":127822},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3624":75178,"_31165":75153,"_21590":127824,"_5":14857,"_28357":127776,"_3076":127825},[],"su clave pública corresponda a la clave privada del cliente;",{"_3624":75179,"_31165":75153,"_21590":127827,"_5":14857,"_28357":127776,"_3076":127828},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3624":75180,"_31165":75153,"_21590":127830,"_5":14857,"_28357":127776,"_3076":127831},[],"sus fechas y usos permitan la operación;",{"_3624":75181,"_31165":75153,"_21590":127833,"_5":14857,"_28357":127776,"_3076":127834},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3624":75182,"_31165":75153,"_21590":127836,"_5":14857,"_28357":127776,"_3076":127837},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3624":75183,"_31165":75153,"_21590":127839,"_5":14857,"_28357":127780,"_3076":127840},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3624":75184,"_31165":75153,"_21590":127842,"_5":14857,"_28357":127780,"_3076":127843},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3624":75185,"_31165":75153,"_21590":127845,"_5":14857,"_28357":127780,"_3076":127846},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3624":75186,"_31165":75186,"_5":15217,"_3076":127848,"_31503":127849,"_21590":127850,"_28357":75186},"Crea tu primera CA",[50900,121699,56586,125171],[],{"_3624":75187,"_31165":75186,"_21590":127852,"_5":14857,"_28357":75186,"_3076":127853},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3624":75188,"_31165":75186,"_5":31500,"_21590":127855,"_28357":127856,"_3076":120233},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3624":75189,"_31165":75186,"_5":31500,"_21590":127858,"_28357":127859,"_3076":127860},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3624":75190,"_31165":75186,"_5":31500,"_21590":127862,"_28357":127863,"_3076":127864},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3624":75191,"_31165":75186,"_5":31500,"_21590":127866,"_28357":127867,"_3076":127868},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3624":75192,"_31165":75186,"_5":31500,"_21590":127870,"_28357":127871,"_3076":127872},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3624":75193,"_31165":75186,"_5":31500,"_21590":127874,"_28357":127875,"_3076":127876},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3624":75194,"_31165":75186,"_5":31500,"_21590":127878,"_28357":127879,"_3076":127880},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3624":75195,"_31165":75186,"_5":31500,"_21590":127882,"_28357":127883,"_3076":125418},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3624":75196,"_31165":75186,"_5":31500,"_21590":127885,"_28357":127886,"_3076":120257},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3624":75197,"_31165":75186,"_21590":127888,"_5":14857,"_28357":75186,"_3076":127889},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3624":75198,"_31165":75186,"_21590":127891,"_5":14857,"_28357":127856,"_3076":127892},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3624":75199,"_31165":75186,"_21590":127894,"_5":14857,"_28357":127856,"_3076":127895},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3624":75200,"_31165":75186,"_21590":127897,"_5":14857,"_28357":127856,"_3076":127898},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3624":75201,"_31165":75186,"_21590":127900,"_5":14857,"_28357":127856,"_3076":127901},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3624":75202,"_31165":75186,"_21590":127903,"_5":14857,"_28357":127859,"_3076":127904},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3624":75203,"_31165":75186,"_21590":127906,"_5":14857,"_28357":127859,"_3076":127907},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3624":75204,"_31165":75186,"_21590":127909,"_5":14857,"_28357":127863,"_3076":127910},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3624":75205,"_31165":75186,"_21590":127912,"_5":14857,"_28357":127863,"_3076":127913},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3624":75206,"_31165":75186,"_21590":127915,"_5":14857,"_28357":127867,"_3076":127916},[],"Selecciona **Root CA** y completa:",{"_3624":75207,"_31165":75186,"_21590":127918,"_5":14857,"_28357":127867,"_3076":58817},[],{"_3624":75208,"_31165":75186,"_21590":127920,"_5":14857,"_28357":127867,"_3076":127921},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3624":75209,"_31165":75186,"_21590":127923,"_5":14857,"_28357":127867,"_3076":127924},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3624":75210,"_31165":75186,"_21590":127926,"_5":14857,"_28357":127867,"_3076":127927},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3624":75211,"_31165":75186,"_21590":127929,"_5":14857,"_28357":127867,"_3076":127930},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3624":75212,"_31165":75186,"_21590":127932,"_5":14857,"_28357":127871,"_3076":127933},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3624":75213,"_31165":75186,"_21590":127935,"_5":14857,"_28357":127875,"_3076":127936},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3624":75214,"_31165":75186,"_21590":127938,"_5":14857,"_28357":127875,"_3076":127939},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3624":75215,"_31165":75186,"_21590":127941,"_5":14857,"_28357":127879,"_3076":127942},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3624":75216,"_31165":75186,"_21590":127944,"_5":14857,"_28357":127879,"_3076":127945},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3624":75217,"_31165":75186,"_21590":127947,"_5":14857,"_28357":127879,"_3076":127948},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3624":75218,"_31165":75186,"_21590":127950,"_5":14857,"_28357":127883,"_3076":127951},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3624":75219,"_31165":75186,"_21590":127953,"_5":14857,"_28357":127883,"_3076":127954},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3624":75220,"_31165":75186,"_21590":127956,"_5":14857,"_28357":127883,"_3076":127957},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3624":75221,"_31165":75186,"_21590":127959,"_5":14857,"_28357":127883,"_3076":127960},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3624":75222,"_31165":75186,"_21590":127962,"_5":14857,"_28357":127886,"_3076":127963},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3624":75223,"_31165":75223,"_5":15217,"_3076":127965,"_31503":127966,"_21590":127967,"_28357":75223},"Emite y verifica un certificado",[50900,121699,56586,125171],[],{"_3624":75224,"_31165":75223,"_21590":127969,"_5":14857,"_28357":75223,"_3076":127970},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3624":75225,"_31165":75223,"_5":31500,"_21590":127972,"_28357":127973,"_3076":120233},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3624":75226,"_31165":75223,"_5":31500,"_21590":127975,"_28357":127976,"_3076":127977},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3624":75227,"_31165":75223,"_5":31500,"_21590":127979,"_28357":127980,"_3076":127981},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3624":75228,"_31165":75223,"_5":31500,"_21590":127983,"_28357":127984,"_3076":127985},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3624":75229,"_31165":75223,"_5":31500,"_21590":127987,"_28357":127988,"_3076":127989},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3624":75230,"_31165":75223,"_5":31500,"_21590":127991,"_28357":127992,"_3076":127993},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3624":75231,"_31165":75223,"_5":31500,"_21590":127995,"_28357":127996,"_3076":127997},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3624":75232,"_31165":75223,"_5":31500,"_21590":127999,"_28357":128000,"_3076":128001},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3624":75233,"_31165":75223,"_5":31500,"_21590":128003,"_28357":128004,"_3076":128005},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3624":75234,"_31165":75223,"_5":31500,"_21590":128007,"_28357":128008,"_3076":128009},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3624":75235,"_31165":75223,"_5":31500,"_21590":128011,"_28357":128012,"_3076":125418},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3624":75236,"_31165":75223,"_5":31500,"_21590":128014,"_28357":128015,"_3076":120257},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3624":75237,"_31165":75223,"_21590":128017,"_5":14857,"_28357":75223,"_3076":128018},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3624":75238,"_31165":75223,"_21590":128020,"_5":14857,"_28357":127973,"_3076":128021},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3624":75239,"_31165":75223,"_21590":128023,"_5":14857,"_28357":127973,"_3076":128024},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3624":75240,"_31165":75223,"_21590":128026,"_5":14857,"_28357":127973,"_3076":128027},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3624":75241,"_31165":75223,"_21590":128029,"_5":14857,"_28357":127973,"_3076":128030},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3624":75242,"_31165":75223,"_21590":128032,"_5":14857,"_28357":127973,"_3076":128033},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3624":75243,"_31165":75223,"_21590":128035,"_5":14857,"_28357":127976,"_3076":128036},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3624":75244,"_31165":75223,"_21590":128038,"_5":14857,"_28357":127980,"_3076":128039},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3624":75245,"_31165":75223,"_21590":128041,"_5":14857,"_28357":127980,"_3076":128042},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3624":75246,"_31165":75223,"_21590":128044,"_5":14857,"_28357":127984,"_3076":128045},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3624":75247,"_31165":75223,"_21590":128047,"_5":14857,"_28357":127984,"_3076":128048},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3624":75248,"_31165":75223,"_21590":128050,"_5":14857,"_28357":127988,"_3076":128051},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3624":75249,"_31165":75223,"_21590":128053,"_5":14857,"_28357":127988,"_3076":128054},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3624":75250,"_31165":75223,"_21590":128056,"_5":14857,"_28357":127992,"_3076":128057},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3624":75251,"_31165":75223,"_21590":128059,"_5":14857,"_28357":127996,"_3076":128060},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3624":75252,"_31165":75223,"_21590":128062,"_5":14857,"_28357":128000,"_3076":128063},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3624":75253,"_31165":75223,"_21590":128065,"_5":14857,"_28357":128004,"_3076":128066},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3624":75254,"_31165":75223,"_21590":128068,"_5":14857,"_28357":128004,"_3076":128069},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3624":75255,"_31165":75223,"_21590":128071,"_5":14857,"_28357":128004,"_3076":128072},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3624":75256,"_31165":75223,"_21590":128074,"_5":14857,"_28357":128008,"_3076":128075},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3624":75257,"_31165":75223,"_21590":128077,"_5":14857,"_28357":128008,"_3076":128078},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3624":75258,"_31165":75223,"_21590":128080,"_5":14857,"_28357":128008,"_3076":128081},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3624":75259,"_31165":75223,"_21590":128083,"_5":14857,"_28357":128012,"_3076":125501},[],{"_3624":75260,"_31165":75223,"_21590":128085,"_5":14857,"_28357":128012,"_3076":124016},[],{"_3624":75261,"_31165":75223,"_21590":128087,"_5":14857,"_28357":128012,"_3076":128088},[],"La CA rechaza la emisión",{"_3624":75262,"_31165":75223,"_21590":128090,"_5":14857,"_28357":128012,"_3076":128091},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3624":75263,"_31165":75223,"_21590":128093,"_5":14857,"_28357":128012,"_3076":128094},[],"Sujeto o usos diferentes",{"_3624":75264,"_31165":75223,"_21590":128096,"_5":14857,"_28357":128012,"_3076":128097},[],"Perfil aplicado y valores solicitados.",{"_3624":75265,"_31165":75223,"_21590":128099,"_5":14857,"_28357":128012,"_3076":128100},[],"No se encuentra el emisor",{"_3624":75266,"_31165":75223,"_21590":128102,"_5":14857,"_28357":128012,"_3076":128103},[],"CA descargada y cadena intermedia necesaria.",{"_3624":75267,"_31165":75223,"_21590":128105,"_5":14857,"_28357":128012,"_3076":128106},[],"Falla la vigencia",{"_3624":75268,"_31165":75223,"_21590":128108,"_5":14857,"_28357":128012,"_3076":128109},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3624":75269,"_31165":75223,"_21590":128111,"_5":14857,"_28357":128012,"_3076":128112},[],"Los resúmenes de clave difieren",{"_3624":75270,"_31165":75223,"_21590":128114,"_5":14857,"_28357":128012,"_3076":128115},[],"Archivos de certificado y clave de la misma emisión.",{"_3624":75271,"_31165":75223,"_21590":128117,"_5":14857,"_28357":128012,"_3076":128118},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3624":75272,"_31165":75223,"_21590":128120,"_5":14857,"_28357":128015,"_3076":128121},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3624":75273,"_31165":75223,"_21590":128123,"_5":14857,"_28357":128015,"_3076":128124},[],"Gestionar certificados para inspección, estado y revocación.",{"_3624":75274,"_31165":75223,"_21590":128126,"_5":14857,"_28357":128015,"_3076":128127},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3624":75275,"_31165":75223,"_21590":128129,"_5":14857,"_28357":128015,"_3076":128130},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3624":75276,"_31165":75223,"_21590":128132,"_5":14857,"_28357":128015,"_3076":128133},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3624":75277,"_31165":75277,"_5":15217,"_3076":128135,"_31503":128136,"_21590":128137,"_28357":75277},"Primeros pasos de PKI",[50900,121699,56586,125171],[],{"_3624":75278,"_31165":75277,"_21590":128139,"_5":14857,"_28357":75277,"_3076":128140},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3624":75279,"_31165":75277,"_5":31500,"_21590":128142,"_28357":128143,"_3076":120233},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3624":75280,"_31165":75277,"_5":31500,"_21590":128145,"_28357":128146,"_3076":128147},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3624":75281,"_31165":75277,"_5":31500,"_21590":128149,"_28357":128150,"_3076":125353},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3624":75282,"_31165":75277,"_5":31500,"_21590":128152,"_28357":128153,"_3076":128154},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3624":75283,"_31165":75277,"_21590":128156,"_5":14857,"_28357":75277,"_3076":128157},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3624":75284,"_31165":75277,"_21590":128159,"_5":14857,"_28357":128143,"_3076":128160},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3624":75285,"_31165":75277,"_21590":128162,"_5":14857,"_28357":128143,"_3076":128163},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3624":75286,"_31165":75277,"_21590":128165,"_5":14857,"_28357":128143,"_3076":128166},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3624":75287,"_31165":75277,"_21590":128168,"_5":14857,"_28357":128143,"_3076":128169},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3624":75288,"_31165":75277,"_21590":128171,"_5":14857,"_28357":128143,"_3076":128172},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3624":75289,"_31165":75277,"_21590":128174,"_5":14857,"_28357":128146,"_3076":128175},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3624":75290,"_31165":75277,"_21590":128177,"_5":14857,"_28357":128146,"_3076":128178},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3624":75291,"_31165":75277,"_21590":128180,"_5":14857,"_28357":128146,"_3076":128181},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3624":75292,"_31165":75277,"_21590":128183,"_5":14857,"_28357":128146,"_3076":128184},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3624":75293,"_31165":75277,"_21590":128186,"_5":14857,"_28357":128150,"_3076":128187},[],"Archivo o recurso",{"_3624":75294,"_31165":75277,"_21590":128189,"_5":14857,"_28357":128150,"_3076":125350},[],{"_3624":75295,"_31165":75277,"_21590":128191,"_5":14857,"_28357":128150,"_3076":128192},[],"CA raíz activa y `ca.pem`",{"_3624":75296,"_31165":75277,"_21590":128194,"_5":14857,"_28357":128150,"_3076":128195},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3624":75297,"_31165":75277,"_21590":128197,"_5":14857,"_28357":128150,"_3076":128198},[],"Certificado final y `device.crt`",{"_3624":75298,"_31165":75277,"_21590":128200,"_5":14857,"_28357":128150,"_3076":128201},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3624":75299,"_31165":75277,"_21590":128203,"_5":14857,"_28357":128150,"_3076":128204},[],"Clave privada `device.key`",{"_3624":75300,"_31165":75277,"_21590":128206,"_5":14857,"_28357":128150,"_3076":128207},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3624":75301,"_31165":75277,"_21590":128209,"_5":14857,"_28357":128150,"_3076":128210},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3624":75302,"_31165":75277,"_21590":128212,"_5":14857,"_28357":128153,"_3076":128213},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3624":75303,"_31165":75277,"_21590":128215,"_5":14857,"_28357":128153,"_3076":128216},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3624":75304,"_31165":75277,"_21590":128218,"_5":14857,"_28357":128153,"_3076":128219},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3624":75305,"_31165":75305,"_5":15217,"_3076":128221,"_31503":128222,"_21590":128224,"_28357":75305},"Resolución de problemas PKI",[50900,121699,56586,128223],"Resolución de problemas",[],{"_3624":75306,"_31165":75305,"_21590":128226,"_5":14857,"_28357":75305,"_3076":128227},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3624":75307,"_31165":75305,"_5":31500,"_21590":128229,"_28357":128230,"_3076":128231},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3624":75308,"_31165":75305,"_5":31500,"_21590":128233,"_28357":128234,"_3076":128235},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3624":75309,"_31165":75305,"_5":31500,"_21590":128237,"_28357":128238,"_3076":128239},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3624":75310,"_31165":75305,"_21590":128241,"_5":14857,"_28357":75305,"_3076":128242},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3624":75311,"_31165":75305,"_21590":128244,"_5":14857,"_28357":75305,"_3076":128245},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3624":75312,"_31165":75305,"_21590":128247,"_5":14857,"_28357":128230,"_3076":125350},[],{"_3624":75313,"_31165":75305,"_21590":128249,"_5":14857,"_28357":128230,"_3076":124016},[],{"_3624":75314,"_31165":75305,"_21590":128251,"_5":14857,"_28357":128230,"_3076":120257},[],{"_3624":75315,"_31165":75305,"_21590":128253,"_5":14857,"_28357":128230,"_3076":55428},[],{"_3624":75316,"_31165":75305,"_21590":128255,"_5":14857,"_28357":128230,"_3076":128256},[],"Existe, está activa y sus fechas son utilizables.",{"_3624":75317,"_31165":75305,"_21590":128258,"_5":14857,"_28357":128230,"_3076":128259},[],"Autoridades.",{"_3624":75318,"_31165":75305,"_21590":128261,"_5":14857,"_28357":128230,"_3076":128262},[],"Clave",{"_3624":75319,"_31165":75305,"_21590":128264,"_5":14857,"_28357":128230,"_3076":128265},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3624":75320,"_31165":75305,"_21590":128267,"_5":14857,"_28357":128230,"_3076":128268},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3624":75321,"_31165":75305,"_21590":128270,"_5":14857,"_28357":128230,"_3076":59171},[],{"_3624":75322,"_31165":75305,"_21590":128272,"_5":14857,"_28357":128230,"_3076":128273},[],"PEM correcto y firma verificable.",{"_3624":75323,"_31165":75305,"_21590":128275,"_5":14857,"_28357":128230,"_3076":59177},[],{"_3624":75324,"_31165":75305,"_21590":128277,"_5":14857,"_28357":128230,"_3076":128278},[],"Perfil",{"_3624":75325,"_31165":75305,"_21590":128280,"_5":14857,"_28357":128230,"_3076":128281},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3624":75326,"_31165":75305,"_21590":128283,"_5":14857,"_28357":128230,"_3076":128284},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3624":75327,"_31165":75305,"_21590":128286,"_5":14857,"_28357":128230,"_3076":125501},[],{"_3624":75328,"_31165":75305,"_21590":128288,"_5":14857,"_28357":128230,"_3076":128289},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3624":75329,"_31165":75305,"_21590":128291,"_5":14857,"_28357":128230,"_3076":128292},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3624":75330,"_31165":75305,"_21590":128294,"_5":14857,"_28357":128230,"_3076":128295},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3624":75331,"_31165":75305,"_21590":128297,"_5":14857,"_28357":128230,"_3076":128298},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3624":75332,"_31165":75305,"_21590":128300,"_5":14857,"_28357":128230,"_3076":128301},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3624":75333,"_31165":75305,"_21590":128303,"_5":14857,"_28357":128234,"_3076":128304},[],"Revisa cada frontera por separado:",{"_3624":75334,"_31165":75305,"_21590":128306,"_5":14857,"_28357":128234,"_3076":128307},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3624":75335,"_31165":75305,"_21590":128309,"_5":14857,"_28357":128234,"_3076":128310},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3624":75336,"_31165":75305,"_21590":128312,"_5":14857,"_28357":128234,"_3076":128313},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3624":75337,"_31165":75305,"_21590":128315,"_5":14857,"_28357":128234,"_3076":128316},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3624":75338,"_31165":75305,"_21590":128318,"_5":14857,"_28357":128234,"_3076":128319},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3624":75339,"_31165":75305,"_21590":128321,"_5":14857,"_28357":128234,"_3076":128322},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3624":75340,"_31165":75305,"_21590":128324,"_5":14857,"_28357":128238,"_3076":128325},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3624":75341,"_31165":75305,"_21590":128327,"_5":14857,"_28357":128238,"_3076":128328},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3624":75342,"_31165":75342,"_5":15217,"_3076":128330,"_31503":128331,"_21590":128332,"_28357":75342},"Seguridad",[50900],[],{"_3624":75343,"_31165":75342,"_21590":128334,"_5":14857,"_28357":75342,"_3076":128335},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3624":75344,"_31165":75342,"_5":31500,"_21590":128337,"_28357":128338,"_3076":128339},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3624":75345,"_31165":75342,"_5":31500,"_21590":128341,"_28357":128342,"_3076":128343},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3624":75346,"_31165":75342,"_5":31500,"_21590":128345,"_28357":128346,"_3076":128347},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3624":75347,"_31165":75342,"_5":31500,"_21590":128349,"_28357":128350,"_3076":128351},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3624":75348,"_31165":75342,"_21590":128353,"_5":14857,"_28357":75342,"_3076":128354},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3624":75349,"_31165":75342,"_21590":128356,"_5":14857,"_28357":128338,"_3076":128357},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3624":75350,"_31165":75342,"_21590":128359,"_5":14857,"_28357":128338,"_3076":128360},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3624":75351,"_31165":75342,"_21590":128362,"_5":14857,"_28357":128338,"_3076":15496},[],{"_3624":75352,"_31165":75342,"_21590":128364,"_5":14857,"_28357":128338,"_3076":15425},[],{"_3624":75353,"_31165":75342,"_21590":128366,"_5":14857,"_28357":128338,"_3076":15483},[],{"_3624":75354,"_31165":75342,"_21590":128368,"_5":14857,"_28357":128338,"_3076":128369},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3624":75355,"_31165":75342,"_21590":128371,"_5":14857,"_28357":128338,"_3076":128372},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3624":75356,"_31165":75342,"_21590":128374,"_5":14857,"_28357":128342,"_3076":128375},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3624":75357,"_31165":75342,"_21590":128377,"_5":14857,"_28357":128342,"_3076":128378},[],"No incluyas en el reporte:",{"_3624":75358,"_31165":75342,"_21590":128380,"_5":14857,"_28357":128342,"_3076":128381},[],"Credenciales, tokens o claves privadas",{"_3624":75359,"_31165":75342,"_21590":128383,"_5":14857,"_28357":128342,"_3076":128384},[],"Datos de clientes o información identificable de clientes",{"_3624":75360,"_31165":75342,"_21590":128386,"_5":14857,"_28357":128342,"_3076":128387},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3624":75361,"_31165":75342,"_21590":128389,"_5":14857,"_28357":128346,"_3076":128390},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3624":75362,"_31165":75342,"_21590":128392,"_5":14857,"_28357":128346,"_3076":128393},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3624":75363,"_31165":75342,"_21590":128395,"_5":14857,"_28357":128350,"_3076":128396},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3624":75364,"_31165":75342,"_21590":128398,"_5":14857,"_28357":128350,"_3076":128399},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3624":75365,"_31165":75342,"_21590":128401,"_5":14857,"_28357":128350,"_3076":128402},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3624":75366,"_31165":75342,"_21590":128404,"_5":14857,"_28357":128350,"_3076":128405},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3624":75367,"_31165":75342,"_21590":128407,"_5":14857,"_28357":128350,"_3076":128408},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3624":75368,"_31165":75368,"_5":15217,"_3076":128410,"_31503":128411,"_21590":128413,"_28357":75368},"3.8.0 a 4.0.0",[50900,128412],"Actualizaciones",[],{"_3624":75369,"_31165":75368,"_21590":128415,"_5":14857,"_28357":75368,"_3076":128416},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3624":75370,"_31165":75368,"_5":31500,"_21590":128418,"_28357":128419,"_3076":128420},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3624":75371,"_31165":75368,"_5":31500,"_21590":128422,"_28357":128423,"_3076":128424},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3624":75372,"_31165":75368,"_5":31500,"_21590":128426,"_28357":128427,"_3076":128428},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3624":75373,"_31165":75368,"_5":31500,"_21590":128430,"_28357":128431,"_3076":128432},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3624":75374,"_31165":75368,"_5":31500,"_21590":128434,"_28357":128435,"_3076":128436},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3624":75375,"_31165":75368,"_5":31500,"_21590":128438,"_28357":128439,"_3076":128440},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3624":75376,"_31165":75368,"_5":31500,"_21590":128442,"_28357":128443,"_3076":59346},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3624":75377,"_31165":75368,"_5":31500,"_21590":128445,"_28357":128446,"_3076":128447},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3624":75378,"_31165":75368,"_5":31500,"_21590":128449,"_28357":128450,"_3076":128451},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3624":75379,"_31165":75368,"_5":31500,"_21590":128453,"_28357":128454,"_3076":128455},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3624":75380,"_31165":75368,"_5":31500,"_21590":128457,"_28357":128458,"_3076":120828},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3624":75381,"_31165":75368,"_5":31500,"_21590":128460,"_28357":128461,"_3076":128462},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3624":75382,"_31165":75368,"_5":31500,"_21590":128464,"_28357":128465,"_3076":128466},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3624":75383,"_31165":75368,"_5":31500,"_21590":128468,"_28357":128469,"_3076":128470},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3624":75384,"_31165":75368,"_5":31500,"_21590":128472,"_28357":128473,"_3076":128474},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3624":75385,"_31165":75368,"_5":31500,"_21590":128476,"_28357":128477,"_3076":128478},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3624":75386,"_31165":75368,"_5":31500,"_21590":128480,"_28357":128481,"_3076":128482},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3624":75387,"_31165":75368,"_5":31500,"_21590":128484,"_28357":128485,"_3076":128486},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3624":75388,"_31165":75368,"_5":31500,"_21590":128488,"_28357":128489,"_3076":128490},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3624":75389,"_31165":75368,"_5":31500,"_21590":128492,"_28357":128493,"_3076":128494},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3624":75390,"_31165":75368,"_5":31500,"_21590":128496,"_28357":128497,"_3076":128498},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3624":75391,"_31165":75368,"_5":31500,"_21590":128500,"_28357":128501,"_3076":128502},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3624":75392,"_31165":75368,"_5":31500,"_21590":128504,"_28357":128505,"_3076":128506},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3624":75393,"_31165":75368,"_5":31500,"_21590":128508,"_28357":128509,"_3076":128510},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3624":75394,"_31165":75368,"_5":31500,"_21590":128512,"_28357":128513,"_3076":128514},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3624":75395,"_31165":75368,"_5":31500,"_21590":128516,"_28357":128517,"_3076":128518},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3624":75396,"_31165":75368,"_5":31500,"_21590":128520,"_28357":128521,"_3076":128522},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3624":75397,"_31165":75368,"_5":31500,"_21590":128524,"_28357":128525,"_3076":128526},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3624":75398,"_31165":75368,"_5":31500,"_21590":128528,"_28357":128529,"_3076":128530},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3624":75399,"_31165":75368,"_5":31500,"_21590":128532,"_28357":128533,"_3076":128534},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3624":75400,"_31165":75368,"_5":31500,"_21590":128536,"_28357":128537,"_3076":128538},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3624":75401,"_31165":75368,"_5":31500,"_21590":128540,"_28357":128541,"_3076":128542},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3624":75402,"_31165":75368,"_5":31500,"_21590":128544,"_28357":128545,"_3076":128546},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3624":75403,"_31165":75368,"_5":31500,"_21590":128548,"_28357":128549,"_3076":128550},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3624":75404,"_31165":75368,"_5":31500,"_21590":128552,"_28357":128553,"_3076":128554},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3624":75405,"_31165":75368,"_5":31500,"_21590":128556,"_28357":128557,"_3076":128558},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3624":75406,"_31165":75368,"_5":31500,"_21590":128560,"_28357":128561,"_3076":128562},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3624":75407,"_31165":75368,"_5":31500,"_21590":128564,"_28357":128565,"_3076":128566},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3624":75408,"_31165":75368,"_5":31500,"_21590":128568,"_28357":128569,"_3076":128570},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3624":75409,"_31165":75368,"_5":31500,"_21590":128572,"_28357":128573,"_3076":128574},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3624":75410,"_31165":75368,"_5":31500,"_21590":128576,"_28357":128577,"_3076":128578},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3624":75411,"_31165":75368,"_5":31500,"_21590":128580,"_28357":128581,"_3076":128582},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3624":75412,"_31165":75368,"_5":31500,"_21590":128584,"_28357":128585,"_3076":128586},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3624":75413,"_31165":75368,"_5":31500,"_21590":128588,"_28357":128589,"_3076":128590},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3624":75414,"_31165":75368,"_5":31500,"_21590":128592,"_28357":128593,"_3076":124364},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3624":75415,"_31165":75368,"_5":31500,"_21590":128595,"_28357":128596,"_3076":128597},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3624":75416,"_31165":75368,"_5":31500,"_21590":128599,"_28357":128600,"_3076":128601},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3624":75417,"_31165":75368,"_21590":128603,"_5":14857,"_28357":75368,"_3076":128604},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3624":75418,"_31165":75368,"_21590":128606,"_5":14857,"_28357":75368,"_3076":128607},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3624":75419,"_31165":75368,"_21590":128609,"_5":14857,"_28357":75368,"_3076":128610},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3624":75420,"_31165":75368,"_21590":128612,"_5":14857,"_28357":75368,"_3076":128613},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3624":75421,"_31165":75368,"_21590":128615,"_5":14857,"_28357":75368,"_3076":128616},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3624":75422,"_31165":75368,"_21590":128618,"_5":14857,"_28357":75368,"_3076":128619},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3624":75423,"_31165":75368,"_21590":128621,"_5":14857,"_28357":75368,"_3076":128622},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3624":75424,"_31165":75368,"_21590":128624,"_5":14857,"_28357":128423,"_3076":128625},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3624":75425,"_31165":75368,"_21590":128627,"_5":14857,"_28357":128423,"_3076":128628},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3624":75426,"_31165":75368,"_21590":128630,"_5":14857,"_28357":128427,"_3076":128631},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3624":75427,"_31165":75368,"_21590":128633,"_5":14857,"_28357":128427,"_3076":128634},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3624":75428,"_31165":75368,"_21590":128636,"_5":14857,"_28357":128431,"_3076":128637},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3624":75429,"_31165":75368,"_21590":128639,"_5":14857,"_28357":128435,"_3076":128640},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3624":75430,"_31165":75368,"_21590":128642,"_5":14857,"_28357":128435,"_3076":128643},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3624":75431,"_31165":75368,"_21590":128645,"_5":14857,"_28357":128435,"_3076":128646},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3624":75432,"_31165":75368,"_21590":128648,"_5":14857,"_28357":128435,"_3076":128649},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3624":75433,"_31165":75368,"_21590":128651,"_5":14857,"_28357":128435,"_3076":128652},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3624":75434,"_31165":75368,"_21590":128654,"_5":14857,"_28357":128439,"_3076":128655},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3624":75435,"_31165":75368,"_21590":128657,"_5":14857,"_28357":128439,"_3076":128658},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3624":75436,"_31165":75368,"_21590":128660,"_5":14857,"_28357":128439,"_3076":128661},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3624":75437,"_31165":75368,"_21590":128663,"_5":14857,"_28357":128439,"_3076":128664},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3624":75438,"_31165":75368,"_21590":128666,"_5":14857,"_28357":128439,"_3076":128667},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3624":75439,"_31165":75368,"_21590":128669,"_5":14857,"_28357":128439,"_3076":128670},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3624":75440,"_31165":75368,"_21590":128672,"_5":14857,"_28357":128443,"_3076":128673},[],"Cambio",{"_3624":75441,"_31165":75368,"_21590":128675,"_5":14857,"_28357":128443,"_3076":128676},[],"A quién afecta",{"_3624":75442,"_31165":75368,"_21590":128678,"_5":14857,"_28357":128443,"_3076":128679},[],"Gravedad",{"_3624":75443,"_31165":75368,"_21590":128681,"_5":14857,"_28357":128443,"_3076":127152},[],{"_3624":75444,"_31165":75368,"_21590":128683,"_5":14857,"_28357":128443,"_3076":128451},[],{"_3624":75445,"_31165":75368,"_21590":128685,"_5":14857,"_28357":128443,"_3076":128686},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3624":75446,"_31165":75368,"_21590":128688,"_5":14857,"_28357":128443,"_3076":128689},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3624":75447,"_31165":75368,"_21590":128691,"_5":14857,"_28357":128443,"_3076":128692},[],"Copiar los datos a los volúmenes nuevos",{"_3624":75448,"_31165":75368,"_21590":128694,"_5":14857,"_28357":128443,"_3076":128455},[],{"_3624":75449,"_31165":75368,"_21590":128696,"_5":14857,"_28357":128443,"_3076":128697},[],"Todas las releases de Helm",{"_3624":75450,"_31165":75368,"_21590":128699,"_5":14857,"_28357":128443,"_3076":128700},[],"Alta: `helm upgrade` falla",{"_3624":75451,"_31165":75368,"_21590":128702,"_5":14857,"_28357":128443,"_3076":128703},[],"Eliminar o renombrar las claves heredadas",{"_3624":75452,"_31165":75368,"_21590":128705,"_5":14857,"_28357":128443,"_3076":120828},[],{"_3624":75453,"_31165":75368,"_21590":128707,"_5":14857,"_28357":128443,"_3076":128697},[],{"_3624":75454,"_31165":75368,"_21590":128709,"_5":14857,"_28357":128443,"_3076":128710},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3624":75455,"_31165":75368,"_21590":128712,"_5":14857,"_28357":128443,"_3076":128713},[],"Crear primero los Secrets; consulta el paso 2",{"_3624":75456,"_31165":75368,"_21590":128715,"_5":14857,"_28357":128443,"_3076":128462},[],{"_3624":75457,"_31165":75368,"_21590":128717,"_5":14857,"_28357":128443,"_3076":128718},[],"Todos los despliegues",{"_3624":75458,"_31165":75368,"_21590":128720,"_5":14857,"_28357":128443,"_3076":128721},[],"Alta: sin principal de bootstrap no hay administrador",{"_3624":75459,"_31165":75368,"_21590":128723,"_5":14857,"_28357":128443,"_3076":128724},[],"Configurar `services.authz`",{"_3624":75460,"_31165":75368,"_21590":128726,"_5":14857,"_28357":128443,"_3076":128466},[],{"_3624":75461,"_31165":75368,"_21590":128728,"_5":14857,"_28357":128443,"_3076":128697},[],{"_3624":75462,"_31165":75368,"_21590":128730,"_5":14857,"_28357":128443,"_3076":128731},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3624":75463,"_31165":75368,"_21590":128733,"_5":14857,"_28357":128443,"_3076":128734},[],"Mover JWKS y roles a `services.authz`",{"_3624":75464,"_31165":75368,"_21590":128736,"_5":14857,"_28357":128443,"_3076":128486},[],{"_3624":75465,"_31165":75368,"_21590":128738,"_5":14857,"_28357":128443,"_3076":128739},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3624":75466,"_31165":75368,"_21590":128741,"_5":14857,"_28357":128443,"_3076":128742},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3624":75467,"_31165":75368,"_21590":128744,"_5":14857,"_28357":128443,"_3076":128745},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3624":75468,"_31165":75368,"_21590":128747,"_5":14857,"_28357":128443,"_3076":128490},[],{"_3624":75469,"_31165":75368,"_21590":128749,"_5":14857,"_28357":128443,"_3076":128750},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3624":75470,"_31165":75368,"_21590":128752,"_5":14857,"_28357":128443,"_3076":128753},[],"Alta: el backend ya no arranca con ellos",{"_3624":75471,"_31165":75368,"_21590":128755,"_5":14857,"_28357":128443,"_3076":128756},[],"Pasar a PostgreSQL antes de actualizar",{"_3624":75472,"_31165":75368,"_21590":128758,"_5":14857,"_28357":128443,"_3076":128538},[],{"_3624":75473,"_31165":75368,"_21590":128760,"_5":14857,"_28357":128443,"_3076":128761},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3624":75474,"_31165":75368,"_21590":128763,"_5":14857,"_28357":128443,"_3076":128764},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3624":75475,"_31165":75368,"_21590":128766,"_5":14857,"_28357":128443,"_3076":128767},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3624":75476,"_31165":75368,"_21590":128769,"_5":14857,"_28357":128443,"_3076":128770},[],"Webhooks con referencias a archivos",{"_3624":75477,"_31165":75368,"_21590":128772,"_5":14857,"_28357":128443,"_3076":128773},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3624":75478,"_31165":75368,"_21590":128775,"_5":14857,"_28357":128443,"_3076":128776},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3624":75479,"_31165":75368,"_21590":128778,"_5":14857,"_28357":128443,"_3076":128779},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3624":75480,"_31165":75368,"_21590":128781,"_5":14857,"_28357":128443,"_3076":128470},[],{"_3624":75481,"_31165":75368,"_21590":128783,"_5":14857,"_28357":128443,"_3076":128784},[],"Releases con identidades por servicio o material de claves montado",{"_3624":75482,"_31165":75368,"_21590":128786,"_5":14857,"_28357":128443,"_3076":128787},[],"Media: los servicios no pueden leer sus archivos",{"_3624":75483,"_31165":75368,"_21590":128789,"_5":14857,"_28357":128443,"_3076":128790},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3624":75484,"_31165":75368,"_21590":128792,"_5":14857,"_28357":128443,"_3076":128474},[],{"_3624":75485,"_31165":75368,"_21590":128794,"_5":14857,"_28357":128443,"_3076":128795},[],"Releases que definen `amqp.tls`",{"_3624":75486,"_31165":75368,"_21590":128797,"_5":14857,"_28357":128443,"_3076":128798},[],"Media: los clientes se conectan al puerto equivocado",{"_3624":75487,"_31165":75368,"_21590":128800,"_5":14857,"_28357":128443,"_3076":128801},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3624":75488,"_31165":75368,"_21590":128803,"_5":14857,"_28357":128443,"_3076":128494},[],{"_3624":75489,"_31165":75368,"_21590":128805,"_5":14857,"_28357":128443,"_3076":128806},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3624":75490,"_31165":75368,"_21590":128808,"_5":14857,"_28357":128443,"_3076":128809},[],"Media: las claves de CA quedan sin gestionar",{"_3624":75491,"_31165":75368,"_21590":128811,"_5":14857,"_28357":128443,"_3076":128812},[],"Ejecutar la migración de CA a KMS",{"_3624":75492,"_31165":75368,"_21590":128814,"_5":14857,"_28357":128443,"_3076":128815},[],"Verificación del certificado del receptor",{"_3624":75493,"_31165":75368,"_21590":128817,"_5":14857,"_28357":128443,"_3076":128818},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3624":75494,"_31165":75368,"_21590":128820,"_5":14857,"_28357":128443,"_3076":128821},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3624":75495,"_31165":75368,"_21590":128823,"_5":14857,"_28357":128443,"_3076":128824},[],"Poner `insecure_skip_verify` a `false`",{"_3624":75496,"_31165":75368,"_21590":128826,"_5":14857,"_28357":128443,"_3076":128510},[],{"_3624":75497,"_31165":75368,"_21590":128828,"_5":14857,"_28357":128443,"_3076":128829},[],"Scripts y consolas que editan DMS por API",{"_3624":75498,"_31165":75368,"_21590":128831,"_5":14857,"_28357":128443,"_3076":128832},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3624":75499,"_31165":75368,"_21590":128834,"_5":14857,"_28357":128443,"_3076":128835},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3624":75500,"_31165":75368,"_21590":128837,"_5":14857,"_28357":128443,"_3076":128514},[],{"_3624":75501,"_31165":75368,"_21590":128839,"_5":14857,"_28357":128443,"_3076":128840},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3624":75502,"_31165":75368,"_21590":128842,"_5":14857,"_28357":128443,"_3076":128843},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3624":75503,"_31165":75368,"_21590":128845,"_5":14857,"_28357":128443,"_3076":128846},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3624":75504,"_31165":75368,"_21590":128848,"_5":14857,"_28357":128443,"_3076":128534},[],{"_3624":75505,"_31165":75368,"_21590":128850,"_5":14857,"_28357":128443,"_3076":128851},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3624":75506,"_31165":75368,"_21590":128853,"_5":14857,"_28357":128443,"_3076":128854},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3624":75507,"_31165":75368,"_21590":128856,"_5":14857,"_28357":128443,"_3076":128857},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3624":75508,"_31165":75368,"_21590":128859,"_5":14857,"_28357":128443,"_3076":128542},[],{"_3624":75509,"_31165":75368,"_21590":128861,"_5":14857,"_28357":128443,"_3076":128862},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3624":75510,"_31165":75368,"_21590":128864,"_5":14857,"_28357":128443,"_3076":128865},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3624":75511,"_31165":75368,"_21590":128867,"_5":14857,"_28357":128443,"_3076":128868},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3624":75512,"_31165":75368,"_21590":128870,"_5":14857,"_28357":128443,"_3076":128546},[],{"_3624":75513,"_31165":75368,"_21590":128872,"_5":14857,"_28357":128443,"_3076":128873},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3624":75514,"_31165":75368,"_21590":128875,"_5":14857,"_28357":128443,"_3076":128876},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3624":75515,"_31165":75368,"_21590":128878,"_5":14857,"_28357":128443,"_3076":128879},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3624":75516,"_31165":75368,"_21590":128881,"_5":14857,"_28357":128443,"_3076":128530},[],{"_3624":75517,"_31165":75368,"_21590":128883,"_5":14857,"_28357":128443,"_3076":128884},[],"Consumidores que leen el campo `events` del dispositivo",{"_3624":75518,"_31165":75368,"_21590":128886,"_5":14857,"_28357":128443,"_3076":128887},[],"Media: el campo desaparece",{"_3624":75519,"_31165":75368,"_21590":128889,"_5":14857,"_28357":128443,"_3076":128890},[],"Usar los nuevos endpoints de eventos",{"_3624":75520,"_31165":75368,"_21590":128892,"_5":14857,"_28357":128443,"_3076":128558},[],{"_3624":75521,"_31165":75368,"_21590":128894,"_5":14857,"_28357":128443,"_3076":128895},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3624":75522,"_31165":75368,"_21590":128897,"_5":14857,"_28357":128443,"_3076":128898},[],"Media: la migración de la VA aborta",{"_3624":75523,"_31165":75368,"_21590":128900,"_5":14857,"_28357":128443,"_3076":128901},[],"Corregir los roles afectados antes de actualizar",{"_3624":75524,"_31165":75368,"_21590":128903,"_5":14857,"_28357":128443,"_3076":128478},[],{"_3624":75525,"_31165":75368,"_21590":128905,"_5":14857,"_28357":128443,"_3076":128906},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3624":75526,"_31165":75368,"_21590":128908,"_5":14857,"_28357":128443,"_3076":128909},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3624":75527,"_31165":75368,"_21590":128911,"_5":14857,"_28357":128443,"_3076":128912},[],"Actualizar el archivo de values",{"_3624":75528,"_31165":75368,"_21590":128914,"_5":14857,"_28357":128443,"_3076":128522},[],{"_3624":75529,"_31165":75368,"_21590":128916,"_5":14857,"_28357":128443,"_3076":128917},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3624":75530,"_31165":75368,"_21590":128919,"_5":14857,"_28357":128443,"_3076":128920},[],"Baja: prevalece el ID de la URL",{"_3624":75531,"_31165":75368,"_21590":128922,"_5":14857,"_28357":128443,"_3076":128923},[],"Enviar el ID en la URL",{"_3624":75532,"_31165":75368,"_21590":128925,"_5":14857,"_28357":128443,"_3076":128550},[],{"_3624":75533,"_31165":75368,"_21590":128927,"_5":14857,"_28357":128443,"_3076":128928},[],"Clientes que envían un `id` al crear o importar CAs",{"_3624":75534,"_31165":75368,"_21590":128930,"_5":14857,"_28357":128443,"_3076":128931},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3624":75535,"_31165":75368,"_21590":128933,"_5":14857,"_28357":128443,"_3076":128934},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3624":75536,"_31165":75368,"_21590":128936,"_5":14857,"_28357":128443,"_3076":128554},[],{"_3624":75537,"_31165":75368,"_21590":128938,"_5":14857,"_28357":128443,"_3076":128939},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3624":75538,"_31165":75368,"_21590":128941,"_5":14857,"_28357":128443,"_3076":128942},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3624":75539,"_31165":75368,"_21590":128944,"_5":14857,"_28357":128443,"_3076":128945},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3624":75540,"_31165":75368,"_21590":128947,"_5":14857,"_28357":128443,"_3076":128526},[],{"_3624":75541,"_31165":75368,"_21590":128949,"_5":14857,"_28357":128443,"_3076":128950},[],"Consumidores que comparan el `type` del certificado",{"_3624":75542,"_31165":75368,"_21590":128952,"_5":14857,"_28357":128443,"_3076":128953},[],"Baja: dos valores cambian de nombre",{"_3624":75543,"_31165":75368,"_21590":128955,"_5":14857,"_28357":128443,"_3076":128956},[],"Adaptar los consumidores",{"_3624":75544,"_31165":75368,"_21590":128958,"_5":14857,"_28357":128443,"_3076":128518},[],{"_3624":75545,"_31165":75368,"_21590":128960,"_5":14857,"_28357":128443,"_3076":128961},[],"Cualquier DMS",{"_3624":75546,"_31165":75368,"_21590":128963,"_5":14857,"_28357":128443,"_3076":128964},[],"Baja: solo informativo",{"_3624":75547,"_31165":75368,"_21590":128966,"_5":14857,"_28357":128443,"_3076":128967},[],"Revisar ambos bloques antes de editar",{"_3624":75548,"_31165":75368,"_21590":128969,"_5":14857,"_28357":128450,"_3076":128970},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3624":75549,"_31165":75368,"_21590":128972,"_5":14857,"_28357":128450,"_3076":128973},[],"El paso 4 de la guía de migración copia los datos.",{"_3624":75550,"_31165":75368,"_21590":128975,"_5":14857,"_28357":128454,"_3076":128976},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3624":75551,"_31165":75368,"_21590":128978,"_5":14857,"_28357":128458,"_3076":128979},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3624":75552,"_31165":75368,"_21590":128981,"_5":14857,"_28357":128458,"_3076":128982},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3624":75553,"_31165":75368,"_21590":128984,"_5":14857,"_28357":128461,"_3076":128985},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3624":75554,"_31165":75368,"_21590":128987,"_5":14857,"_28357":128465,"_3076":128988},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3624":75555,"_31165":75368,"_21590":128990,"_5":14857,"_28357":128469,"_3076":128991},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3624":75556,"_31165":75368,"_21590":128993,"_5":14857,"_28357":128469,"_3076":128994},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3624":75557,"_31165":75368,"_21590":128996,"_5":14857,"_28357":128469,"_3076":128997},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3624":75558,"_31165":75368,"_21590":128999,"_5":14857,"_28357":128473,"_3076":129000},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3624":75559,"_31165":75368,"_21590":129002,"_5":14857,"_28357":128477,"_3076":129003},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3624":75560,"_31165":75368,"_21590":129005,"_5":14857,"_28357":128477,"_3076":129006},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3624":75561,"_31165":75368,"_21590":129008,"_5":14857,"_28357":128477,"_3076":129009},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3624":75562,"_31165":75368,"_21590":129011,"_5":14857,"_28357":128477,"_3076":129012},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3624":75563,"_31165":75368,"_21590":129014,"_5":14857,"_28357":128477,"_3076":129015},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3624":75564,"_31165":75368,"_21590":129017,"_5":14857,"_28357":128477,"_3076":129018},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3624":75565,"_31165":75368,"_21590":129020,"_5":14857,"_28357":128485,"_3076":129021},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3624":75566,"_31165":75368,"_21590":129023,"_5":14857,"_28357":128485,"_3076":129024},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3624":75567,"_31165":75368,"_21590":129026,"_5":14857,"_28357":128485,"_3076":129027},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3624":75568,"_31165":75368,"_21590":129029,"_5":14857,"_28357":128485,"_3076":129030},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3624":75569,"_31165":75368,"_21590":129032,"_5":14857,"_28357":128485,"_3076":129033},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3624":75570,"_31165":75368,"_21590":129035,"_5":14857,"_28357":128489,"_3076":129036},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3624":75571,"_31165":75368,"_21590":129038,"_5":14857,"_28357":128493,"_3076":129039},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3624":75572,"_31165":75368,"_21590":129041,"_5":14857,"_28357":128493,"_3076":129042},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3624":75573,"_31165":75368,"_21590":129044,"_5":14857,"_28357":128493,"_3076":129045},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3624":75574,"_31165":75368,"_21590":129047,"_5":14857,"_28357":128493,"_3076":129048},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3624":75575,"_31165":75368,"_21590":129050,"_5":14857,"_28357":128493,"_3076":129051},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3624":75576,"_31165":75368,"_21590":129053,"_5":14857,"_28357":128493,"_3076":129054},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3624":75577,"_31165":75368,"_21590":129056,"_5":14857,"_28357":128493,"_3076":129057},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3624":75578,"_31165":75368,"_21590":129059,"_5":14857,"_28357":128493,"_3076":129060},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3624":75579,"_31165":75368,"_21590":129062,"_5":14857,"_28357":128497,"_3076":129063},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3624":75580,"_31165":75368,"_21590":129065,"_5":14857,"_28357":128505,"_3076":129066},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3624":75581,"_31165":75368,"_21590":129068,"_5":14857,"_28357":128505,"_3076":129069},[],"Campo en 3.8.0",{"_3624":75582,"_31165":75368,"_21590":129071,"_5":14857,"_28357":128505,"_3076":129072},[],"Campo en 4.0.0",{"_3624":75583,"_31165":75368,"_21590":129074,"_5":14857,"_28357":128505,"_3076":59977},[],{"_3624":75584,"_31165":75368,"_21590":129076,"_5":14857,"_28357":128505,"_3076":129077},[],"`insecure_skip_verify` (con el valor negado)",{"_3624":75585,"_31165":75368,"_21590":129079,"_5":14857,"_28357":128505,"_3076":59983},[],{"_3624":75586,"_31165":75368,"_21590":129081,"_5":14857,"_28357":128505,"_3076":59986},[],{"_3624":75587,"_31165":75368,"_21590":129083,"_5":14857,"_28357":128505,"_3076":59989},[],{"_3624":75588,"_31165":75368,"_21590":129085,"_5":14857,"_28357":128505,"_3076":59992},[],{"_3624":75589,"_31165":75368,"_21590":129087,"_5":14857,"_28357":128505,"_3076":59995},[],{"_3624":75590,"_31165":75368,"_21590":129089,"_5":14857,"_28357":128505,"_3076":59998},[],{"_3624":75591,"_31165":75368,"_21590":129091,"_5":14857,"_28357":128505,"_3076":129092},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3624":75592,"_31165":75368,"_21590":129094,"_5":14857,"_28357":128505,"_3076":129095},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3624":75593,"_31165":75368,"_21590":129097,"_5":14857,"_28357":128505,"_3076":129098},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3624":75594,"_31165":75368,"_21590":129100,"_5":14857,"_28357":128509,"_3076":129101},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3624":75595,"_31165":75368,"_21590":129103,"_5":14857,"_28357":128509,"_3076":129104},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3624":75596,"_31165":75368,"_21590":129106,"_5":14857,"_28357":128509,"_3076":129107},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3624":75597,"_31165":75368,"_21590":129109,"_5":14857,"_28357":128513,"_3076":129110},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3624":75598,"_31165":75368,"_21590":129112,"_5":14857,"_28357":128513,"_3076":129113},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3624":75599,"_31165":75368,"_21590":129115,"_5":14857,"_28357":128517,"_3076":129116},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3624":75600,"_31165":75368,"_21590":129118,"_5":14857,"_28357":128521,"_3076":129119},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3624":75601,"_31165":75368,"_21590":129121,"_5":14857,"_28357":128525,"_3076":129122},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3624":75602,"_31165":75368,"_21590":129124,"_5":14857,"_28357":128529,"_3076":129125},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3624":75603,"_31165":75368,"_21590":129127,"_5":14857,"_28357":128529,"_3076":129128},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3624":75604,"_31165":75368,"_21590":129130,"_5":14857,"_28357":128529,"_3076":129131},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3624":75605,"_31165":75368,"_21590":129133,"_5":14857,"_28357":128529,"_3076":129134},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3624":75606,"_31165":75368,"_21590":129136,"_5":14857,"_28357":128533,"_3076":129137},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3624":75607,"_31165":75368,"_21590":129139,"_5":14857,"_28357":128537,"_3076":129140},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3624":75608,"_31165":75368,"_21590":129142,"_5":14857,"_28357":128537,"_3076":129143},[],"Ruta",{"_3624":75609,"_31165":75368,"_21590":129145,"_5":14857,"_28357":128537,"_3076":121459},[],{"_3624":75610,"_31165":75368,"_21590":129147,"_5":14857,"_28357":128537,"_3076":60057},[],{"_3624":75611,"_31165":75368,"_21590":129149,"_5":14857,"_28357":128537,"_3076":129150},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3624":75612,"_31165":75368,"_21590":129152,"_5":14857,"_28357":128537,"_3076":60063},[],{"_3624":75613,"_31165":75368,"_21590":129154,"_5":14857,"_28357":128537,"_3076":129155},[],"Lee los ajustes de una CA.",{"_3624":75614,"_31165":75368,"_21590":129157,"_5":14857,"_28357":128537,"_3076":60069},[],{"_3624":75615,"_31165":75368,"_21590":129159,"_5":14857,"_28357":128537,"_3076":129160},[],"Sustituye los `crl_options`.",{"_3624":75616,"_31165":75368,"_21590":129162,"_5":14857,"_28357":128537,"_3076":60075},[],{"_3624":75617,"_31165":75368,"_21590":129164,"_5":14857,"_28357":128537,"_3076":129165},[],"Elimina los ajustes archivados de una CA.",{"_3624":75618,"_31165":75368,"_21590":129167,"_5":14857,"_28357":128537,"_3076":129168},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3624":75619,"_31165":75368,"_21590":129170,"_5":14857,"_28357":128537,"_3076":129171},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3624":75620,"_31165":75368,"_21590":129173,"_5":14857,"_28357":128537,"_3076":129174},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3624":75621,"_31165":75368,"_21590":129176,"_5":14857,"_28357":128537,"_3076":129177},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3624":75622,"_31165":75368,"_21590":129179,"_5":14857,"_28357":128537,"_3076":129180},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3624":75623,"_31165":75368,"_21590":129182,"_5":14857,"_28357":128537,"_3076":129183},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3624":75624,"_31165":75368,"_21590":129185,"_5":14857,"_28357":128537,"_3076":129186},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3624":75625,"_31165":75368,"_21590":129188,"_5":14857,"_28357":128537,"_3076":129189},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3624":75626,"_31165":75368,"_21590":129191,"_5":14857,"_28357":128537,"_3076":129192},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3624":75627,"_31165":75368,"_21590":129194,"_5":14857,"_28357":128537,"_3076":129195},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3624":75628,"_31165":75368,"_21590":129197,"_5":14857,"_28357":128537,"_3076":129198},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3624":75629,"_31165":75368,"_21590":129200,"_5":14857,"_28357":128541,"_3076":129201},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3624":75630,"_31165":75368,"_21590":129203,"_5":14857,"_28357":128545,"_3076":129204},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3624":75631,"_31165":75368,"_21590":129206,"_5":14857,"_28357":128549,"_3076":129207},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3624":75632,"_31165":75368,"_21590":129209,"_5":14857,"_28357":128553,"_3076":129210},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3624":75633,"_31165":75368,"_21590":129212,"_5":14857,"_28357":128553,"_3076":129213},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3624":75634,"_31165":75368,"_21590":129215,"_5":14857,"_28357":128557,"_3076":129216},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3624":75635,"_31165":75368,"_21590":129218,"_5":14857,"_28357":128561,"_3076":129219},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3624":75636,"_31165":75368,"_21590":129221,"_5":14857,"_28357":128565,"_3076":129222},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3624":75637,"_31165":75368,"_21590":129224,"_5":14857,"_28357":128565,"_3076":129225},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3624":75638,"_31165":75368,"_21590":129227,"_5":14857,"_28357":128565,"_3076":129228},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3624":75639,"_31165":75368,"_21590":129230,"_5":14857,"_28357":128565,"_3076":129231},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3624":75640,"_31165":75368,"_21590":129233,"_5":14857,"_28357":128565,"_3076":129234},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3624":75641,"_31165":75368,"_21590":129236,"_5":14857,"_28357":128565,"_3076":129237},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3624":75642,"_31165":75368,"_21590":129239,"_5":14857,"_28357":128569,"_3076":129240},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3624":75643,"_31165":75368,"_21590":129242,"_5":14857,"_28357":128569,"_3076":129243},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3624":75644,"_31165":75368,"_21590":129245,"_5":14857,"_28357":128569,"_3076":129246},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3624":75645,"_31165":75368,"_21590":129248,"_5":14857,"_28357":128569,"_3076":129249},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3624":75646,"_31165":75368,"_21590":129251,"_5":14857,"_28357":128569,"_3076":129252},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3624":75647,"_31165":75368,"_21590":129254,"_5":14857,"_28357":128573,"_3076":129255},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3624":75648,"_31165":75368,"_21590":129257,"_5":14857,"_28357":128573,"_3076":129258},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3624":75649,"_31165":75368,"_21590":129260,"_5":14857,"_28357":128573,"_3076":129261},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3624":75650,"_31165":75368,"_21590":129263,"_5":14857,"_28357":128573,"_3076":60177},[],{"_3624":75651,"_31165":75368,"_21590":129265,"_5":14857,"_28357":128573,"_3076":129266},[],"Claves de datos obligatorias",{"_3624":75652,"_31165":75368,"_21590":129268,"_5":14857,"_28357":128573,"_3076":129269},[],"Cuándo",{"_3624":75653,"_31165":75368,"_21590":129271,"_5":14857,"_28357":128573,"_3076":129272},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3624":75654,"_31165":75368,"_21590":129274,"_5":14857,"_28357":128573,"_3076":60189},[],{"_3624":75655,"_31165":75368,"_21590":129276,"_5":14857,"_28357":128573,"_3076":129277},[],"Siempre",{"_3624":75656,"_31165":75368,"_21590":129279,"_5":14857,"_28357":128573,"_3076":129280},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3624":75657,"_31165":75368,"_21590":129282,"_5":14857,"_28357":128573,"_3076":60189},[],{"_3624":75658,"_31165":75368,"_21590":129284,"_5":14857,"_28357":128573,"_3076":129277},[],{"_3624":75659,"_31165":75368,"_21590":129286,"_5":14857,"_28357":128573,"_3076":60202},[],{"_3624":75660,"_31165":75368,"_21590":129288,"_5":14857,"_28357":128573,"_3076":60189},[],{"_3624":75661,"_31165":75368,"_21590":129290,"_5":14857,"_28357":128573,"_3076":129291},[],"Solo cuando hay autenticación SMTP",{"_3624":75662,"_31165":75368,"_21590":129293,"_5":14857,"_28357":128573,"_3076":129294},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3624":75663,"_31165":75368,"_21590":129296,"_5":14857,"_28357":128573,"_3076":129297},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3624":75664,"_31165":75368,"_21590":129299,"_5":14857,"_28357":128573,"_3076":129300},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3624":75665,"_31165":75368,"_21590":129302,"_5":14857,"_28357":128573,"_3076":129303},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3624":75666,"_31165":75368,"_21590":129305,"_5":14857,"_28357":128573,"_3076":129306},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3624":75667,"_31165":75368,"_21590":129308,"_5":14857,"_28357":128573,"_3076":129309},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3624":75668,"_31165":75368,"_21590":129311,"_5":14857,"_28357":128573,"_3076":129312},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3624":75669,"_31165":75368,"_21590":129314,"_5":14857,"_28357":128573,"_3076":129315},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3624":75670,"_31165":75368,"_21590":129317,"_5":14857,"_28357":128573,"_3076":129318},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3624":75671,"_31165":75368,"_21590":129320,"_5":14857,"_28357":128573,"_3076":129321},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3624":75672,"_31165":75368,"_21590":129323,"_5":14857,"_28357":128573,"_3076":129324},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3624":75673,"_31165":75368,"_21590":129326,"_5":14857,"_28357":128573,"_3076":129327},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3624":75674,"_31165":75368,"_21590":129329,"_5":14857,"_28357":128573,"_3076":129330},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3624":75675,"_31165":75368,"_21590":129332,"_5":14857,"_28357":128573,"_3076":129333},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3624":75676,"_31165":75368,"_21590":129335,"_5":14857,"_28357":128573,"_3076":129336},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3624":75677,"_31165":75368,"_21590":129338,"_5":14857,"_28357":128577,"_3076":129339},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3624":75678,"_31165":75368,"_21590":129341,"_5":14857,"_28357":128577,"_3076":129342},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3624":75679,"_31165":75368,"_21590":129344,"_5":14857,"_28357":128581,"_3076":129345},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3624":75680,"_31165":75368,"_21590":129347,"_5":14857,"_28357":128581,"_3076":129348},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3624":75681,"_31165":75368,"_21590":129350,"_5":14857,"_28357":128581,"_3076":129351},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3624":75682,"_31165":75368,"_21590":129353,"_5":14857,"_28357":128581,"_3076":129354},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3624":75683,"_31165":75368,"_21590":129356,"_5":14857,"_28357":128581,"_3076":129357},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3624":75684,"_31165":75368,"_21590":129359,"_5":14857,"_28357":128581,"_3076":129360},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3624":75685,"_31165":75368,"_21590":129362,"_5":14857,"_28357":128581,"_3076":129363},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3624":75686,"_31165":75368,"_21590":129365,"_5":14857,"_28357":128581,"_3076":129366},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3624":75687,"_31165":75368,"_21590":129368,"_5":14857,"_28357":128581,"_3076":129369},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3624":75688,"_31165":75368,"_21590":129371,"_5":14857,"_28357":128581,"_3076":129372},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3624":75689,"_31165":75368,"_21590":129374,"_5":14857,"_28357":128581,"_3076":129375},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3624":75690,"_31165":75368,"_21590":129377,"_5":14857,"_28357":128585,"_3076":129378},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3624":75691,"_31165":75368,"_21590":129380,"_5":14857,"_28357":128585,"_3076":129381},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3624":75692,"_31165":75368,"_21590":129383,"_5":14857,"_28357":128589,"_3076":129384},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3624":75693,"_31165":75368,"_21590":129386,"_5":14857,"_28357":128589,"_3076":129387},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3624":75694,"_31165":75368,"_21590":129389,"_5":14857,"_28357":128589,"_3076":129390},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3624":75695,"_31165":75368,"_21590":129392,"_5":14857,"_28357":128589,"_3076":129393},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3624":75696,"_31165":75368,"_21590":129395,"_5":14857,"_28357":128589,"_3076":129396},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3624":75697,"_31165":75368,"_21590":129398,"_5":14857,"_28357":128589,"_3076":129399},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3624":75698,"_31165":75368,"_21590":129401,"_5":14857,"_28357":128589,"_3076":129402},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3624":75699,"_31165":75368,"_21590":129404,"_5":14857,"_28357":128589,"_3076":129405},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3624":75700,"_31165":75368,"_21590":129407,"_5":14857,"_28357":128593,"_3076":129408},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3624":75701,"_31165":75368,"_21590":129410,"_5":14857,"_28357":128593,"_3076":129411},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3624":75702,"_31165":75368,"_21590":129413,"_5":14857,"_28357":128593,"_3076":129414},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3624":75703,"_31165":75368,"_21590":129416,"_5":14857,"_28357":128593,"_3076":129417},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3624":75704,"_31165":75368,"_21590":129419,"_5":14857,"_28357":128593,"_3076":129420},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3624":75705,"_31165":75368,"_21590":129422,"_5":14857,"_28357":128593,"_3076":129423},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3624":75706,"_31165":75368,"_21590":129425,"_5":14857,"_28357":128593,"_3076":129426},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3624":75707,"_31165":75368,"_21590":129428,"_5":14857,"_28357":128593,"_3076":129429},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3624":75708,"_31165":75368,"_21590":129431,"_5":14857,"_28357":128593,"_3076":129432},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3624":75709,"_31165":75368,"_21590":129434,"_5":14857,"_28357":128593,"_3076":129435},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3624":75710,"_31165":75368,"_21590":129437,"_5":14857,"_28357":128593,"_3076":129438},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3624":75711,"_31165":75368,"_21590":129440,"_5":14857,"_28357":128596,"_3076":129441},[],"Tras la actualización, comprueba en este orden:",{"_3624":75712,"_31165":75368,"_21590":129443,"_5":14857,"_28357":128596,"_3076":129444},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3624":75713,"_31165":75368,"_21590":129446,"_5":14857,"_28357":128596,"_3076":129447},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3624":75714,"_31165":75368,"_21590":129449,"_5":14857,"_28357":128596,"_3076":129450},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3624":75715,"_31165":75368,"_21590":129452,"_5":14857,"_28357":128596,"_3076":129453},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3624":75716,"_31165":75368,"_21590":129455,"_5":14857,"_28357":128596,"_3076":129456},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3624":75717,"_31165":75368,"_21590":129458,"_5":14857,"_28357":128596,"_3076":129459},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3624":75718,"_31165":75368,"_21590":129461,"_5":14857,"_28357":128596,"_3076":129462},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3624":75719,"_31165":75368,"_21590":129464,"_5":14857,"_28357":128596,"_3076":129465},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3624":75720,"_31165":75368,"_21590":129467,"_5":14857,"_28357":128596,"_3076":129468},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3624":75721,"_31165":75368,"_21590":129470,"_5":14857,"_28357":128596,"_3076":129471},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3624":75722,"_31165":75368,"_21590":129473,"_5":14857,"_28357":128596,"_3076":129474},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3624":75723,"_31165":75368,"_21590":129476,"_5":14857,"_28357":128596,"_3076":129477},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3624":75724,"_31165":75368,"_21590":129479,"_5":14857,"_28357":128596,"_3076":129480},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3624":75725,"_31165":75368,"_21590":129482,"_5":14857,"_28357":128596,"_3076":129483},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3624":75726,"_31165":75368,"_21590":129485,"_5":14857,"_28357":128596,"_3076":129486},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3624":75727,"_31165":75368,"_21590":129488,"_5":14857,"_28357":128600,"_3076":129489},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3624":75728,"_31165":75368,"_21590":129491,"_5":14857,"_28357":128600,"_3076":129492},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3624":75729,"_31165":75368,"_21590":129494,"_5":14857,"_28357":128600,"_3076":129495},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3624":75730,"_31165":75368,"_21590":129497,"_5":14857,"_28357":128600,"_3076":129498},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3624":75731,"_31165":75368,"_21590":129500,"_5":14857,"_28357":128600,"_3076":129501},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60420":129503,"_60422":129504,"_60424":129505,"_60426":129506,"_18727":3111,"_72669":3111},"spanish",[3076,31165,5,28357],{"_3076":25776,"_31165":25776,"_5":25776,"_28357":25776},{"_3076":129507,"_31165":132566,"_5":135625,"_28357":138684},{"_4825":129508,"_60430":129509,"_5":25776},{"_14938":3388,"_15317":6343,"_15336":4664,"_30165":7963,"_15323":4213,"_20502":6725,"_14959":3494,"_14966":7925,"_30107":12141,"_30515":6220,"_30542":7277,"_30141":4568,"_35538":5174,"_30244":20988,"_30586":10209,"_35545":5449,"_35548":4214,"_35551":5829,"_35554":5642,"_30988":12406,"_35559":19792,"_35561":3965,"_