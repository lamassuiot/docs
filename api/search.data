80,"_41686":129683,"_41688":129686,"_41690":129689,"_41692":129691,"_41694":129694,"_41696":129697,"_41698":129699,"_41700":129701,"_41702":129703,"_41704":129705,"_41706":129708,"_41708":129711,"_41710":129714,"_41712":129717,"_41714":129720,"_41716":129723,"_41718":129726,"_41720":129729,"_41722":129732,"_41724":129735,"_41726":129738,"_41728":129741,"_41730":129744,"_41732":129747,"_41734":129750,"_41736":129753,"_41738":129756,"_41740":129759,"_41742":129762,"_41744":129765,"_41746":129768,"_41749":129771,"_41751":129774,"_41753":129777,"_41755":129780,"_41757":129783,"_41759":129786,"_41761":129789,"_41763":129792,"_41765":129795,"_41767":129798,"_41769":129801,"_41771":129804,"_41773":129807,"_41775":129810,"_41778":129813,"_41780":129816,"_41782":129819,"_41784":129822,"_41786":129825,"_41788":129828,"_41790":129831,"_41792":129834,"_41794":129837,"_41796":129840,"_41798":129843,"_41800":129846,"_41802":129849,"_41804":129852,"_41806":129855,"_41808":129858,"_41810":129861,"_41812":129864,"_41814":129867,"_41816":129870,"_41818":129873,"_41820":129876,"_41822":129879,"_41824":129882,"_41826":129885,"_41828":129888,"_41830":129891,"_41832":129894,"_41834":129897,"_41836":129900,"_41838":129903,"_41840":129906,"_41843":129909,"_41845":129912,"_41847":129915},{"_3699":72849,"_31384":72849,"_5":15283,"_3075":120666,"_31709":120667,"_21647":120670,"_28559":72849},"Despliega desde AWS Marketplace",[51094,120668,120669],"Despliegue","Otros modelos",[],{"_3699":72850,"_31384":72849,"_21647":120672,"_5":14929,"_28559":72849,"_3075":120673},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3699":72851,"_31384":72849,"_5":31706,"_21647":120675,"_28559":120676,"_3075":120677},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3699":72852,"_31384":72849,"_5":31706,"_21647":120679,"_28559":120680,"_3075":120681},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3699":72853,"_31384":72849,"_5":31706,"_21647":120683,"_28559":120684,"_3075":120685},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3699":72854,"_31384":72849,"_5":31706,"_21647":120687,"_28559":120688,"_3075":120689},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3699":72855,"_31384":72849,"_5":31706,"_21647":120691,"_28559":120692,"_3075":120693},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3699":72856,"_31384":72849,"_5":31706,"_21647":120695,"_28559":120696,"_3075":120697},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3699":72857,"_31384":72849,"_5":31706,"_21647":120699,"_28559":120700,"_3075":120701},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3699":72858,"_31384":72849,"_21647":120703,"_5":14929,"_28559":72849,"_3075":120704},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3699":72859,"_31384":72849,"_21647":120706,"_5":14929,"_28559":120676,"_3075":120707},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3699":72860,"_31384":72849,"_21647":120709,"_5":14929,"_28559":120676,"_3075":120710},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3699":72861,"_31384":72849,"_21647":120712,"_5":14929,"_28559":120676,"_3075":120713},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3699":72862,"_31384":72849,"_21647":120715,"_5":14929,"_28559":120680,"_3075":120716},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3699":72863,"_31384":72849,"_21647":120718,"_5":14929,"_28559":120680,"_3075":120719},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3699":72864,"_31384":72849,"_21647":120721,"_5":14929,"_28559":120680,"_3075":120722},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3699":72865,"_31384":72849,"_21647":120724,"_5":14929,"_28559":120684,"_3075":120725},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3699":72866,"_31384":72849,"_21647":120727,"_5":14929,"_28559":120688,"_3075":120728},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3699":72867,"_31384":72849,"_21647":120730,"_5":14929,"_28559":120692,"_3075":120731},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3699":72868,"_31384":72849,"_21647":120733,"_5":14929,"_28559":120696,"_3075":120734},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3699":72869,"_31384":72849,"_21647":120736,"_5":14929,"_28559":120700,"_3075":120737},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3699":72870,"_31384":72870,"_5":15283,"_3075":120739,"_31709":120740,"_21647":120741,"_28559":72870},"Despliega Lamassu",[51094,120668],[],{"_3699":72871,"_31384":72870,"_21647":120743,"_5":14929,"_28559":72870,"_3075":120744},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3699":72872,"_31384":72870,"_5":31706,"_21647":120746,"_28559":120747,"_3075":120748},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3699":72873,"_31384":72870,"_5":31706,"_21647":120750,"_28559":120751,"_3075":120752},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3699":72874,"_31384":72870,"_5":31706,"_21647":120754,"_28559":120755,"_3075":120756},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3699":72875,"_31384":72870,"_21647":120758,"_5":14929,"_28559":72870,"_3075":120759},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3699":72876,"_31384":72870,"_21647":120761,"_5":14929,"_28559":120747,"_3075":120762},[],"Modelo",{"_3699":72877,"_31384":72870,"_21647":120764,"_5":14929,"_28559":120747,"_3075":120765},[],"Recomendado para",{"_3699":72878,"_31384":72870,"_21647":120767,"_5":14929,"_28559":120747,"_3075":120768},[],"Quién opera la infraestructura",{"_3699":72879,"_31384":72870,"_21647":120770,"_5":14929,"_28559":120747,"_3075":120771},[],"Punto de partida",{"_3699":72880,"_31384":72870,"_21647":120773,"_5":14929,"_28559":120747,"_3075":51201},[],{"_3699":72881,"_31384":72870,"_21647":120775,"_5":14929,"_28559":120747,"_3075":120776},[],"Producción, entornos regulados y despliegues personalizados",{"_3699":72882,"_31384":72870,"_21647":120778,"_5":14929,"_28559":120747,"_3075":120779},[],"Tu equipo",{"_3699":72883,"_31384":72870,"_21647":120781,"_5":14929,"_28559":120747,"_3075":120782},[],"Helm o Fastlane",{"_3699":72884,"_31384":72870,"_21647":120784,"_5":14929,"_28559":120747,"_3075":51213},[],{"_3699":72885,"_31384":72870,"_21647":120786,"_5":14929,"_28559":120747,"_3075":120787},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3699":72886,"_31384":72870,"_21647":120789,"_5":14929,"_28559":120747,"_3075":120779},[],{"_3699":72887,"_31384":72870,"_21647":120791,"_5":14929,"_28559":120747,"_3075":120792},[],"Imagen preconfigurada en EC2",{"_3699":72888,"_31384":72870,"_21647":120794,"_5":14929,"_28559":120747,"_3075":51224},[],{"_3699":72889,"_31384":72870,"_21647":120796,"_5":14929,"_28559":120747,"_3075":120797},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3699":72890,"_31384":72870,"_21647":120799,"_5":14929,"_28559":120747,"_3075":51230},[],{"_3699":72891,"_31384":72870,"_21647":120801,"_5":14929,"_28559":120747,"_3075":120802},[],"Suscripción gestionada",{"_3699":72892,"_31384":72870,"_21647":120804,"_5":14929,"_28559":120747,"_3075":120805},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3699":72893,"_31384":72870,"_21647":120807,"_5":14929,"_28559":120747,"_3075":120808},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3699":72894,"_31384":72870,"_21647":120810,"_5":14929,"_28559":120747,"_3075":120811},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3699":72895,"_31384":72870,"_21647":120813,"_5":14929,"_28559":120751,"_3075":120814},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3699":72896,"_31384":72870,"_21647":120816,"_5":14929,"_28559":120755,"_3075":120817},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3699":72897,"_31384":72897,"_5":15283,"_3075":120819,"_31709":120820,"_21647":120821,"_28559":72897},"Utiliza Lamassu como SaaS",[51094,120668,120669],[],{"_3699":72898,"_31384":72897,"_21647":120823,"_5":14929,"_28559":72897,"_3075":120824},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3699":72899,"_31384":72897,"_5":31706,"_21647":120826,"_28559":120827,"_3075":120828},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3699":72900,"_31384":72897,"_5":31706,"_21647":120830,"_28559":120831,"_3075":120832},[],"/docs/es/deployment/saas#planes","Planes",{"_3699":72901,"_31384":72897,"_5":31706,"_21647":120834,"_28559":120835,"_3075":120836},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3699":72902,"_31384":72897,"_21647":120838,"_5":14929,"_28559":72897,"_3075":120839},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3699":72903,"_31384":72897,"_21647":120841,"_5":14929,"_28559":120827,"_3075":120842},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3699":72904,"_31384":72897,"_21647":120844,"_5":14929,"_28559":120827,"_3075":120845},[],"Copias de seguridad automáticas.",{"_3699":72905,"_31384":72897,"_21647":120847,"_5":14929,"_28559":120827,"_3075":120848},[],"Actualizaciones de versión.",{"_3699":72906,"_31384":72897,"_21647":120850,"_5":14929,"_28559":120827,"_3075":120851},[],"Soporte técnico y SLA según el plan contratado.",{"_3699":72907,"_31384":72897,"_21647":120853,"_5":14929,"_28559":120831,"_3075":51285},[],{"_3699":72908,"_31384":72897,"_21647":120855,"_5":14929,"_28559":120831,"_3075":120856},[],"Dispositivos",{"_3699":72909,"_31384":72897,"_21647":120858,"_5":14929,"_28559":120831,"_3075":120859},[],"Soporte",{"_3699":72910,"_31384":72897,"_21647":120861,"_5":14929,"_28559":120831,"_3075":51294},[],{"_3699":72911,"_31384":72897,"_21647":120863,"_5":14929,"_28559":120831,"_3075":51297},[],{"_3699":72912,"_31384":72897,"_21647":120865,"_5":14929,"_28559":120831,"_3075":120866},[],"Hasta 1.000",{"_3699":72913,"_31384":72897,"_21647":120868,"_5":14929,"_28559":120831,"_3075":51303},[],{"_3699":72914,"_31384":72897,"_21647":120870,"_5":14929,"_28559":120831,"_3075":120871},[],"99,5 %",{"_3699":72915,"_31384":72897,"_21647":120873,"_5":14929,"_28559":120831,"_3075":51309},[],{"_3699":72916,"_31384":72897,"_21647":120875,"_5":14929,"_28559":120831,"_3075":120876},[],"Hasta 10.000",{"_3699":72917,"_31384":72897,"_21647":120878,"_5":14929,"_28559":120831,"_3075":120879},[],"Email y chat",{"_3699":72918,"_31384":72897,"_21647":120881,"_5":14929,"_28559":120831,"_3075":120882},[],"99,9 %",{"_3699":72919,"_31384":72897,"_21647":120884,"_5":14929,"_28559":120831,"_3075":51321},[],{"_3699":72920,"_31384":72897,"_21647":120886,"_5":14929,"_28559":120831,"_3075":120887},[],"Ilimitados",{"_3699":72921,"_31384":72897,"_21647":120889,"_5":14929,"_28559":120831,"_3075":120890},[],"Dedicado",{"_3699":72922,"_31384":72897,"_21647":120892,"_5":14929,"_28559":120831,"_3075":120893},[],"99,99 %",{"_3699":72923,"_31384":72897,"_21647":120895,"_5":14929,"_28559":120835,"_3075":120896},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3699":72924,"_31384":72897,"_21647":120898,"_5":14929,"_28559":120835,"_3075":120899},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3699":72925,"_31384":72925,"_5":15283,"_3075":51338,"_31709":120901,"_21647":120903,"_28559":72925},[51094,120668,120902],"Kubernetes autogestionado",[],{"_3699":72926,"_31384":72925,"_21647":120905,"_5":14929,"_28559":72925,"_3075":120906},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3699":72927,"_31384":72925,"_5":31706,"_21647":120908,"_28559":120909,"_3075":120910},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3699":72928,"_31384":72925,"_5":31706,"_21647":120912,"_28559":120913,"_3075":120914},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3699":72929,"_31384":72925,"_5":31706,"_21647":120916,"_28559":120917,"_3075":120918},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3699":72930,"_31384":72925,"_5":31706,"_21647":120920,"_28559":120921,"_3075":120922},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3699":72931,"_31384":72925,"_5":31706,"_21647":120924,"_28559":120925,"_3075":120926},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3699":72932,"_31384":72925,"_5":31706,"_21647":120928,"_28559":120929,"_3075":120930},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3699":72933,"_31384":72925,"_5":31706,"_21647":120932,"_28559":120933,"_3075":120934},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3699":72934,"_31384":72925,"_5":31706,"_21647":120936,"_28559":120937,"_3075":120938},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3699":72935,"_31384":72925,"_5":31706,"_21647":120940,"_28559":120941,"_3075":120942},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3699":72936,"_31384":72925,"_5":31706,"_21647":120944,"_28559":120945,"_3075":120946},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3699":72937,"_31384":72925,"_5":31706,"_21647":120948,"_28559":120949,"_3075":120950},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3699":72938,"_31384":72925,"_21647":120952,"_5":14929,"_28559":120909,"_3075":120953},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3699":72939,"_31384":72925,"_21647":120955,"_5":14929,"_28559":120909,"_3075":120956},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3699":72940,"_31384":72925,"_21647":120958,"_5":14929,"_28559":120913,"_3075":120959},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3699":72941,"_31384":72925,"_21647":120961,"_5":14929,"_28559":120913,"_3075":120962},[],"Fastlane instala o configura",{"_3699":72942,"_31384":72925,"_21647":120964,"_5":14929,"_28559":120913,"_3075":120965},[],"Tú sigues proporcionando",{"_3699":72943,"_31384":72925,"_21647":120967,"_5":14929,"_28559":120913,"_3075":120968},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3699":72944,"_31384":72925,"_21647":120970,"_5":14929,"_28559":120913,"_3075":120971},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3699":72945,"_31384":72925,"_21647":120973,"_5":14929,"_28559":120913,"_3075":120974},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3699":72946,"_31384":72925,"_21647":120976,"_5":14929,"_28559":120913,"_3075":120977},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3699":72947,"_31384":72925,"_21647":120979,"_5":14929,"_28559":120913,"_3075":120980},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3699":72948,"_31384":72925,"_21647":120982,"_5":14929,"_28559":120913,"_3075":120983},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3699":72949,"_31384":72925,"_21647":120985,"_5":14929,"_28559":120913,"_3075":120986},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3699":72950,"_31384":72925,"_21647":120988,"_5":14929,"_28559":120913,"_3075":120989},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3699":72951,"_31384":72925,"_21647":120991,"_5":14929,"_28559":120913,"_3075":120992},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3699":72952,"_31384":72925,"_21647":120994,"_5":14929,"_28559":120917,"_3075":120995},[],"Necesitas:",{"_3699":72953,"_31384":72925,"_21647":120997,"_5":14929,"_28559":120917,"_3075":120998},[],"un clúster Kubernetes existente",{"_3699":72954,"_31384":72925,"_21647":121000,"_5":14929,"_28559":120917,"_3075":121001},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3699":72955,"_31384":72925,"_21647":121003,"_5":14929,"_28559":120917,"_3075":51440},[],{"_3699":72956,"_31384":72925,"_21647":121005,"_5":14929,"_28559":120917,"_3075":24470},[],{"_3699":72957,"_31384":72925,"_21647":121007,"_5":14929,"_28559":120917,"_3075":121008},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3699":72958,"_31384":72925,"_21647":121010,"_5":14929,"_28559":120917,"_3075":121011},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3699":72959,"_31384":72925,"_21647":121013,"_5":14929,"_28559":120917,"_3075":121014},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3699":72960,"_31384":72925,"_21647":121016,"_5":14929,"_28559":120917,"_3075":121017},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3699":72961,"_31384":72925,"_21647":121019,"_5":14929,"_28559":120917,"_3075":121020},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3699":72962,"_31384":72925,"_21647":121022,"_5":14929,"_28559":120921,"_3075":121023},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3699":72963,"_31384":72925,"_21647":121025,"_5":14929,"_28559":120921,"_3075":121026},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3699":72964,"_31384":72925,"_21647":121028,"_5":14929,"_28559":120925,"_3075":121029},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3699":72965,"_31384":72925,"_21647":121031,"_5":14929,"_28559":120925,"_3075":121032},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3699":72966,"_31384":72925,"_21647":121034,"_5":14929,"_28559":120925,"_3075":121035},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3699":72967,"_31384":72925,"_21647":121037,"_5":14929,"_28559":120925,"_3075":121038},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3699":72968,"_31384":72925,"_21647":121040,"_5":14929,"_28559":120929,"_3075":121041},[],"Opción",{"_3699":72969,"_31384":72925,"_21647":121043,"_5":14929,"_28559":120929,"_3075":121044},[],"Valor predeterminado",{"_3699":72970,"_31384":72925,"_21647":121046,"_5":14929,"_28559":120929,"_3075":121047},[],"Propósito",{"_3699":72971,"_31384":72925,"_21647":121049,"_5":14929,"_28559":120929,"_3075":51487},[],{"_3699":72972,"_31384":72925,"_21647":121051,"_5":14929,"_28559":120929,"_3075":51490},[],{"_3699":72973,"_31384":72925,"_21647":121053,"_5":14929,"_28559":120929,"_3075":121054},[],"Muestra la ayuda",{"_3699":72974,"_31384":72925,"_21647":121056,"_5":14929,"_28559":120929,"_3075":51496},[],{"_3699":72975,"_31384":72925,"_21647":121058,"_5":14929,"_28559":120929,"_3075":121059},[],"contexto actual",{"_3699":72976,"_31384":72925,"_21647":121061,"_5":14929,"_28559":120929,"_3075":121062},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3699":72977,"_31384":72925,"_21647":121064,"_5":14929,"_28559":120929,"_3075":51505},[],{"_3699":72978,"_31384":72925,"_21647":121066,"_5":14929,"_28559":120929,"_3075":6825},[],{"_3699":72979,"_31384":72925,"_21647":121068,"_5":14929,"_28559":120929,"_3075":121069},[],"Omite prompts y genera credenciales para las dependencias",{"_3699":72980,"_31384":72925,"_21647":121071,"_5":14929,"_28559":120929,"_3075":51513},[],{"_3699":72981,"_31384":72925,"_21647":121073,"_5":14929,"_28559":120929,"_3075":51516},[],{"_3699":72982,"_31384":72925,"_21647":121075,"_5":14929,"_28559":120929,"_3075":121076},[],"Namespace de la instalación",{"_3699":72983,"_31384":72925,"_21647":121078,"_5":14929,"_28559":120929,"_3075":51522},[],{"_3699":72984,"_31384":72925,"_21647":121080,"_5":14929,"_28559":120929,"_3075":51525},[],{"_3699":72985,"_31384":72925,"_21647":121082,"_5":14929,"_28559":120929,"_3075":121083},[],"Dominio usado por la UI, OIDC y el certificado",{"_3699":72986,"_31384":72925,"_21647":121085,"_5":14929,"_28559":120929,"_3075":51531},[],{"_3699":72987,"_31384":72925,"_21647":121087,"_5":14929,"_28559":120929,"_3075":15617},[],{"_3699":72988,"_31384":72925,"_21647":121089,"_5":14929,"_28559":120929,"_3075":121090},[],"Versión del chart de Lamassu",{"_3699":72989,"_31384":72925,"_21647":121092,"_5":14929,"_28559":120929,"_3075":51539},[],{"_3699":72990,"_31384":72925,"_21647":121094,"_5":14929,"_28559":120929,"_3075":51542},[],{"_3699":72991,"_31384":72925,"_21647":121096,"_5":14929,"_28559":120929,"_3075":121097},[],"Puerto del listener HTTPS",{"_3699":72992,"_31384":72925,"_21647":121099,"_5":14929,"_28559":120929,"_3075":51548},[],{"_3699":72993,"_31384":72925,"_21647":121101,"_5":14929,"_28559":120929,"_3075":51551},[],{"_3699":72994,"_31384":72925,"_21647":121103,"_5":14929,"_28559":120929,"_3075":121104},[],"Puerto del listener HTTP",{"_3699":72995,"_31384":72925,"_21647":121106,"_5":14929,"_28559":120929,"_3075":51557},[],{"_3699":72996,"_31384":72925,"_21647":121108,"_5":14929,"_28559":120929,"_3075":51490},[],{"_3699":72997,"_31384":72925,"_21647":121110,"_5":14929,"_28559":120929,"_3075":121111},[],"Certificado PEM para TLS downstream",{"_3699":72998,"_31384":72925,"_21647":121113,"_5":14929,"_28559":120929,"_3075":51565},[],{"_3699":72999,"_31384":72925,"_21647":121115,"_5":14929,"_28559":120929,"_3075":51490},[],{"_3699":73000,"_31384":72925,"_21647":121117,"_5":14929,"_28559":120929,"_3075":121118},[],"Clave privada PEM para TLS downstream",{"_3699":73001,"_31384":72925,"_21647":121120,"_5":14929,"_28559":120929,"_3075":51573},[],{"_3699":73002,"_31384":72925,"_21647":121122,"_5":14929,"_28559":120929,"_3075":121123},[],"chart del repositorio",{"_3699":73003,"_31384":72925,"_21647":121125,"_5":14929,"_28559":120929,"_3075":121126},[],"Usa un chart local de Lamassu sin empaquetar",{"_3699":73004,"_31384":72925,"_21647":121128,"_5":14929,"_28559":120929,"_3075":51582},[],{"_3699":73005,"_31384":72925,"_21647":121130,"_5":14929,"_28559":120929,"_3075":121131},[],"detección automática",{"_3699":73006,"_31384":72925,"_21647":121133,"_5":14929,"_28559":120929,"_3075":121134},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3699":73007,"_31384":72925,"_21647":121136,"_5":14929,"_28559":120929,"_3075":51590},[],{"_3699":73008,"_31384":72925,"_21647":121138,"_5":14929,"_28559":120929,"_3075":6825},[],{"_3699":73009,"_31384":72925,"_21647":121140,"_5":14929,"_28559":120929,"_3075":121141},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3699":73010,"_31384":72925,"_21647":121143,"_5":14929,"_28559":120929,"_3075":51598},[],{"_3699":73011,"_31384":72925,"_21647":121145,"_5":14929,"_28559":120929,"_3075":6825},[],{"_3699":73012,"_31384":72925,"_21647":121147,"_5":14929,"_28559":120929,"_3075":121148},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3699":73013,"_31384":72925,"_21647":121150,"_5":14929,"_28559":120929,"_3075":51606},[],{"_3699":73014,"_31384":72925,"_21647":121152,"_5":14929,"_28559":120929,"_3075":6825},[],{"_3699":73015,"_31384":72925,"_21647":121154,"_5":14929,"_28559":120929,"_3075":121155},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3699":73016,"_31384":72925,"_21647":121157,"_5":14929,"_28559":120929,"_3075":51614},[],{"_3699":73017,"_31384":72925,"_21647":121159,"_5":14929,"_28559":120929,"_3075":6825},[],{"_3699":73018,"_31384":72925,"_21647":121161,"_5":14929,"_28559":120929,"_3075":121162},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3699":73019,"_31384":72925,"_21647":121164,"_5":14929,"_28559":120929,"_3075":51622},[],{"_3699":73020,"_31384":72925,"_21647":121166,"_5":14929,"_28559":120929,"_3075":51625},[],{"_3699":73021,"_31384":72925,"_21647":121168,"_5":14929,"_28559":120929,"_3075":121169},[],"Usa otro chart local de SoftHSM",{"_3699":73022,"_31384":72925,"_21647":121171,"_5":14929,"_28559":120929,"_3075":121172},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3699":73023,"_31384":72925,"_21647":121174,"_5":14929,"_28559":120933,"_3075":121175},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3699":73024,"_31384":72925,"_21647":121177,"_5":14929,"_28559":120933,"_3075":121178},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3699":73025,"_31384":72925,"_21647":121180,"_5":14929,"_28559":120933,"_3075":121181},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3699":73026,"_31384":72925,"_21647":121183,"_5":14929,"_28559":120933,"_3075":121184},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3699":73027,"_31384":72925,"_21647":121186,"_5":14929,"_28559":120933,"_3075":121187},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3699":73028,"_31384":72925,"_21647":121189,"_5":14929,"_28559":120933,"_3075":121190},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3699":73029,"_31384":72925,"_21647":121192,"_5":14929,"_28559":120937,"_3075":51652},[],{"_3699":73030,"_31384":72925,"_21647":121194,"_5":14929,"_28559":120937,"_3075":121195},[],"valida las herramientas locales y el clúster seleccionado",{"_3699":73031,"_31384":72925,"_21647":121197,"_5":14929,"_28559":120937,"_3075":121198},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3699":73032,"_31384":72925,"_21647":121200,"_5":14929,"_28559":120937,"_3075":121201},[],"crea el namespace",{"_3699":73033,"_31384":72925,"_21647":121203,"_5":14929,"_28559":120937,"_3075":121204},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3699":73034,"_31384":72925,"_21647":121206,"_5":14929,"_28559":120937,"_3075":121207},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3699":73035,"_31384":72925,"_21647":121209,"_5":14929,"_28559":120937,"_3075":121210},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3699":73036,"_31384":72925,"_21647":121212,"_5":14929,"_28559":120937,"_3075":121213},[],"instala RabbitMQ",{"_3699":73037,"_31384":72925,"_21647":121215,"_5":14929,"_28559":120937,"_3075":121216},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3699":73038,"_31384":72925,"_21647":121218,"_5":14929,"_28559":120937,"_3075":121219},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3699":73039,"_31384":72925,"_21647":121221,"_5":14929,"_28559":120937,"_3075":121222},[],"carga datos de ejemplo opcionalmente",{"_3699":73040,"_31384":72925,"_21647":121224,"_5":14929,"_28559":120937,"_3075":121225},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3699":73041,"_31384":72925,"_21647":121227,"_5":14929,"_28559":120941,"_3075":121228},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3699":73042,"_31384":72925,"_21647":121230,"_5":14929,"_28559":120941,"_3075":121231},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3699":73043,"_31384":72925,"_21647":121233,"_5":14929,"_28559":120945,"_3075":121234},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3699":73044,"_31384":72925,"_21647":121236,"_5":14929,"_28559":120945,"_3075":121237},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3699":73045,"_31384":72925,"_21647":121239,"_5":14929,"_28559":120945,"_3075":121240},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3699":73046,"_31384":72925,"_21647":121242,"_5":14929,"_28559":120945,"_3075":121243},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3699":73047,"_31384":72925,"_21647":121245,"_5":14929,"_28559":120949,"_3075":121246},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3699":73048,"_31384":73048,"_5":15283,"_3075":121248,"_31709":121249,"_21647":121250,"_28559":73048},"Instala con Helm",[51094,120668,120902],[],{"_3699":73049,"_31384":73048,"_21647":121252,"_5":14929,"_28559":73048,"_3075":121253},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3699":73050,"_31384":73048,"_5":31706,"_21647":121255,"_28559":121256,"_3075":121257},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3699":73051,"_31384":73048,"_5":31706,"_21647":121259,"_28559":121260,"_3075":120918},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3699":73052,"_31384":73048,"_5":31706,"_21647":121262,"_28559":121263,"_3075":121264},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3699":73053,"_31384":73048,"_5":31706,"_21647":121266,"_28559":121267,"_3075":121268},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3699":73054,"_31384":73048,"_5":31706,"_21647":121270,"_28559":121271,"_3075":121272},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3699":73055,"_31384":73048,"_5":31706,"_21647":121274,"_28559":121275,"_3075":121276},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3699":73056,"_31384":73048,"_5":31706,"_21647":121278,"_28559":121279,"_3075":121280},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3699":73057,"_31384":73048,"_5":31706,"_21647":121282,"_28559":121283,"_3075":121284},[],"/docs/es/deployment/self-hosted/helm#flujo-de-eventos-de-dispositivo-sse","Flujo de eventos de dispositivo (SSE)",{"_3699":73058,"_31384":73048,"_5":31706,"_21647":121286,"_28559":121287,"_3075":121288},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3699":73059,"_31384":73048,"_5":31706,"_21647":121290,"_28559":121291,"_3075":121292},[],"/docs/es/deployment/self-hosted/helm#terminal-experimental-del-dashboard-opcional","Terminal experimental del dashboard (opcional)",{"_3699":73060,"_31384":73048,"_5":31706,"_21647":121294,"_28559":121295,"_3075":121296},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3699":73061,"_31384":73048,"_5":31706,"_21647":121298,"_28559":121299,"_3075":121300},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3699":73062,"_31384":73048,"_5":31706,"_21647":121302,"_28559":121303,"_3075":121304},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3699":73063,"_31384":73048,"_5":31706,"_21647":121306,"_28559":121307,"_3075":121308},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3699":73064,"_31384":73048,"_21647":121310,"_5":14929,"_28559":121256,"_3075":121311},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3699":73065,"_31384":73048,"_21647":121313,"_5":14929,"_28559":121260,"_3075":121314},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3699":73066,"_31384":73048,"_21647":121316,"_5":14929,"_28559":121260,"_3075":121317},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3699":73067,"_31384":73048,"_21647":121319,"_5":14929,"_28559":121260,"_3075":121320},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3699":73068,"_31384":73048,"_21647":121322,"_5":14929,"_28559":121260,"_3075":121323},[],"un broker RabbitMQ accesible y sus credenciales",{"_3699":73069,"_31384":73048,"_21647":121325,"_5":14929,"_28559":121260,"_3075":121326},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3699":73070,"_31384":73048,"_21647":121328,"_5":14929,"_28559":121260,"_3075":121329},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3699":73071,"_31384":73048,"_21647":121331,"_5":14929,"_28559":121260,"_3075":121332},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3699":73072,"_31384":73048,"_21647":121334,"_5":14929,"_28559":121260,"_3075":121335},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3699":73073,"_31384":73048,"_21647":121337,"_5":14929,"_28559":121260,"_3075":121338},[],"una StorageClass y un diseño de tráfico externo",{"_3699":73074,"_31384":73048,"_21647":121340,"_5":14929,"_28559":121260,"_3075":121341},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3699":73075,"_31384":73048,"_21647":121343,"_5":14929,"_28559":121260,"_3075":121344},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3699":73076,"_31384":73048,"_21647":121346,"_5":14929,"_28559":121260,"_3075":121347},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3699":73077,"_31384":73048,"_21647":121349,"_5":14929,"_28559":121263,"_3075":121350},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3699":73078,"_31384":73048,"_21647":121352,"_5":14929,"_28559":121263,"_3075":121353},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3699":73079,"_31384":73048,"_21647":121355,"_5":14929,"_28559":121263,"_3075":121356},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3699":73080,"_31384":73048,"_21647":121358,"_5":14929,"_28559":121267,"_3075":121359},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3699":73081,"_31384":73048,"_21647":121361,"_5":14929,"_28559":121267,"_3075":121362},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3699":73082,"_31384":73048,"_21647":121364,"_5":14929,"_28559":121267,"_3075":121365},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3699":73083,"_31384":73048,"_21647":121367,"_5":14929,"_28559":121267,"_3075":121368},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3699":73084,"_31384":73048,"_21647":121370,"_5":14929,"_28559":121267,"_3075":121371},[],"El chart ejecuta las cargas con `65532:65532`, el perfil seccomp `RuntimeDefault` y sin capabilities. Crea una ServiceAccount dedicada y no monta su token por defecto. Asegura que los volúmenes montados sean accesibles para esa identidad.",{"_3699":73085,"_31384":73048,"_21647":121373,"_5":14929,"_28559":121271,"_3075":121374},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3699":73086,"_31384":73048,"_21647":121376,"_5":14929,"_28559":121271,"_3075":121377},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3699":73087,"_31384":73048,"_21647":121379,"_5":14929,"_28559":121271,"_3075":121380},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3699":73088,"_31384":73048,"_21647":121382,"_5":14929,"_28559":121271,"_3075":121383},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3699":73089,"_31384":73048,"_21647":121385,"_5":14929,"_28559":121271,"_3075":121386},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3699":73090,"_31384":73048,"_21647":121388,"_5":14929,"_28559":121271,"_3075":121389},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3699":73091,"_31384":73048,"_21647":121391,"_5":14929,"_28559":121271,"_3075":121392},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3699":73092,"_31384":73048,"_21647":121394,"_5":14929,"_28559":121271,"_3075":121395},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3699":73093,"_31384":73048,"_21647":121397,"_5":14929,"_28559":121275,"_3075":121398},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3699":73094,"_31384":73048,"_21647":121400,"_5":14929,"_28559":121279,"_3075":121401},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3699":73095,"_31384":73048,"_21647":121403,"_5":14929,"_28559":121279,"_3075":121404},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3699":73096,"_31384":73048,"_21647":121406,"_5":14929,"_28559":121279,"_3075":121407},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3699":73097,"_31384":73048,"_21647":121409,"_5":14929,"_28559":121279,"_3075":121410},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3699":73098,"_31384":73048,"_21647":121412,"_5":14929,"_28559":121279,"_3075":121413},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3699":73099,"_31384":73048,"_21647":121415,"_5":14929,"_28559":121279,"_3075":121416},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3699":73100,"_31384":73048,"_21647":121418,"_5":14929,"_28559":121279,"_3075":121419},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3699":73101,"_31384":73048,"_21647":121421,"_5":14929,"_28559":121283,"_3075":121422},[],"`services.deviceManager.sseEnabled` (por defecto `true`) controla si Device Manager sirve su flujo de eventos de dispositivo mediante Server-Sent Events (SSE). Con el valor por defecto, el chart renderiza una regla de gateway dedicada para el endpoint de eventos de dispositivo con un timeout de petición de 11 minutos, porque el timeout de petición por defecto del Gateway es demasiado corto para estos flujos, que el servicio mantiene abiertos hasta unos diez minutos. Las llamadas a Device Manager que no son peticiones SSE conservan el timeout por defecto del Gateway.",{"_3699":73102,"_31384":73048,"_21647":121424,"_5":14929,"_28559":121283,"_3075":121425},[],"Defínelo como `false` para deshabilitar el flujo: el chart renderiza entonces `sse_enabled: false` en la configuración de Device Manager y omite la regla de gateway, y las peticiones SSE al endpoint de eventos de dispositivo fallan. Consulta Eventos de dispositivo en la guía de actualización de 3.8.0 a 4.0.0.",{"_3699":73103,"_31384":73048,"_21647":121427,"_5":14929,"_28559":121287,"_3075":121428},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3699":73104,"_31384":73048,"_21647":121430,"_5":14929,"_28559":121287,"_3075":121431},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3699":73105,"_31384":73048,"_21647":121433,"_5":14929,"_28559":121287,"_3075":121434},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3699":73106,"_31384":73048,"_21647":121436,"_5":14929,"_28559":121287,"_3075":121437},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3699":73107,"_31384":73048,"_21647":121439,"_5":14929,"_28559":121291,"_3075":121440},[],"El dashboard incluye un terminal experimental en el navegador para trabajar con los dispositivos. Está deshabilitado por defecto; actívalo en el archivo de valores:",{"_3699":73108,"_31384":73048,"_21647":121442,"_5":14929,"_28559":121291,"_3075":121443},[],"Para habilitar el terminal se requiere la autorización externa: define `auth.externalAuthorization.enabled: true` y `auth.externalAuthorization.failOpen: false`. Si no, el chart se niega a renderizar el release, porque el endpoint WebSocket del terminal quedaría expuesto a través del Gateway sin autorización externa.",{"_3699":73109,"_31384":73048,"_21647":121445,"_5":14929,"_28559":121291,"_3075":121446},[],"Solo las identidades que tengan concedida la política precargada \"Terminal Network\" pueden abrir sesiones de terminal. Consulta Control de acceso para saber cómo se asignan las políticas.",{"_3699":73110,"_31384":73048,"_21647":121448,"_5":14929,"_28559":121291,"_3075":121449},[],"Ten en cuenta que, incluso con el terminal habilitado, los pods dentro del clúster pueden seguir llegando directamente al servicio de la UI salvo que las network policies restrinjan ese acceso: la autorización externa se aplica al tráfico que entra por el Gateway.",{"_3699":73111,"_31384":73048,"_21647":121451,"_5":14929,"_28559":121295,"_3075":121452},[],"Para instalar un checkout local:",{"_3699":73112,"_31384":73048,"_21647":121454,"_5":14929,"_28559":121299,"_3075":121455},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3699":73113,"_31384":73048,"_21647":121457,"_5":14929,"_28559":121299,"_3075":121458},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3699":73114,"_31384":73048,"_21647":121460,"_5":14929,"_28559":121303,"_3075":121461},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3699":73115,"_31384":73048,"_21647":121463,"_5":14929,"_28559":121303,"_3075":121464},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3699":73116,"_31384":73048,"_21647":121466,"_5":14929,"_28559":121303,"_3075":121467},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3699":73117,"_31384":73048,"_21647":121469,"_5":14929,"_28559":121303,"_3075":121470},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3699":73118,"_31384":73048,"_21647":121472,"_5":14929,"_28559":121303,"_3075":121473},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3699":73119,"_31384":73048,"_21647":121475,"_5":14929,"_28559":121307,"_3075":121476},[],"Antes de pasar a producción, revisa:",{"_3699":73120,"_31384":73048,"_21647":121478,"_5":14929,"_28559":121307,"_3075":121479},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3699":73121,"_31384":73048,"_21647":121481,"_5":14929,"_28559":121307,"_3075":121482},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3699":73122,"_31384":73048,"_21647":121484,"_5":14929,"_28559":121307,"_3075":121485},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3699":73123,"_31384":73048,"_21647":121487,"_5":14929,"_28559":121307,"_3075":121488},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3699":73124,"_31384":73048,"_21647":121490,"_5":14929,"_28559":121307,"_3075":121491},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3699":73125,"_31384":73048,"_21647":121493,"_5":14929,"_28559":121307,"_3075":121494},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3699":73126,"_31384":73048,"_21647":121496,"_5":14929,"_28559":121307,"_3075":121497},[],"SMTP, observabilidad y entrega de alertas",{"_3699":73127,"_31384":73048,"_21647":121499,"_5":14929,"_28559":121307,"_3075":121500},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3699":73128,"_31384":73048,"_21647":121502,"_5":14929,"_28559":121307,"_3075":121503},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3699":73129,"_31384":73129,"_5":15283,"_3075":121505,"_31709":121506,"_21647":121507,"_28559":73129},"Expón el Gateway",[51094,120668,120902],[],{"_3699":73130,"_31384":73129,"_21647":121509,"_5":14929,"_28559":73129,"_3075":121510},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3699":73131,"_31384":73129,"_5":31706,"_21647":121512,"_28559":121513,"_3075":121514},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3699":73132,"_31384":73129,"_5":31706,"_21647":121516,"_28559":121517,"_3075":121518},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3699":73133,"_31384":73129,"_5":31706,"_21647":121520,"_28559":121521,"_3075":121522},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3699":73134,"_31384":73129,"_5":31706,"_21647":121524,"_28559":121525,"_3075":51986},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3699":73135,"_31384":73129,"_5":31706,"_21647":121527,"_28559":121528,"_3075":121529},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3699":73136,"_31384":73129,"_5":31706,"_21647":121531,"_28559":121532,"_3075":121533},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3699":73137,"_31384":73129,"_5":31706,"_21647":121535,"_28559":121536,"_3075":121537},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3699":73138,"_31384":73129,"_5":31706,"_21647":121539,"_28559":121540,"_3075":121541},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3699":73139,"_31384":73129,"_5":31706,"_21647":121543,"_28559":121544,"_3075":121545},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3699":73140,"_31384":73129,"_5":31706,"_21647":121547,"_28559":121548,"_3075":121549},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3699":73141,"_31384":73129,"_5":31706,"_21647":121551,"_28559":121552,"_3075":121553},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3699":73142,"_31384":73129,"_21647":121555,"_5":14929,"_28559":121513,"_3075":121556},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3699":73143,"_31384":73129,"_21647":121558,"_5":14929,"_28559":121513,"_3075":121559},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3699":73144,"_31384":73129,"_21647":121561,"_5":14929,"_28559":121517,"_3075":121562},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3699":73145,"_31384":73129,"_21647":121564,"_5":14929,"_28559":121517,"_3075":121565},[],"Defínelo únicamente cuando:",{"_3699":73146,"_31384":73129,"_21647":121567,"_5":14929,"_28559":121517,"_3075":121568},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3699":73147,"_31384":73129,"_21647":121570,"_5":14929,"_28559":121517,"_3075":121571},[],"esa dirección está asignada a este Gateway",{"_3699":73148,"_31384":73129,"_21647":121573,"_5":14929,"_28559":121517,"_3075":121574},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3699":73149,"_31384":73129,"_21647":121576,"_5":14929,"_28559":121517,"_3075":121577},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3699":73150,"_31384":73129,"_21647":121579,"_5":14929,"_28559":121517,"_3075":121580},[],"No confundas estos valores:",{"_3699":73151,"_31384":73129,"_21647":121582,"_5":14929,"_28559":121517,"_3075":121583},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3699":73152,"_31384":73129,"_21647":121585,"_5":14929,"_28559":121517,"_3075":121586},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3699":73153,"_31384":73129,"_21647":121588,"_5":14929,"_28559":121517,"_3075":121589},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3699":73154,"_31384":73129,"_21647":121591,"_5":14929,"_28559":121521,"_3075":121592},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3699":73155,"_31384":73129,"_21647":121594,"_5":14929,"_28559":121521,"_3075":121595},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3699":73156,"_31384":73129,"_21647":121597,"_5":14929,"_28559":121525,"_3075":121598},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3699":73157,"_31384":73129,"_21647":121600,"_5":14929,"_28559":121525,"_3075":121601},[],"Para el diseño recomendado:",{"_3699":73158,"_31384":73129,"_21647":121603,"_5":14929,"_28559":121525,"_3075":121604},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3699":73159,"_31384":73129,"_21647":121606,"_5":14929,"_28559":121525,"_3075":121607},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3699":73160,"_31384":73129,"_21647":121609,"_5":14929,"_28559":121525,"_3075":121610},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3699":73161,"_31384":73129,"_21647":121612,"_5":14929,"_28559":121525,"_3075":121613},[],"Apunta DNS a la dirección accesible de la VM.",{"_3699":73162,"_31384":73129,"_21647":121615,"_5":14929,"_28559":121525,"_3075":121616},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3699":73163,"_31384":73129,"_21647":121618,"_5":14929,"_28559":121528,"_3075":121619},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3699":73164,"_31384":73129,"_21647":121621,"_5":14929,"_28559":121532,"_3075":121622},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3699":73165,"_31384":73129,"_21647":121624,"_5":14929,"_28559":121532,"_3075":121625},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3699":73166,"_31384":73129,"_21647":121627,"_5":14929,"_28559":121536,"_3075":121628},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3699":73167,"_31384":73129,"_21647":121630,"_5":14929,"_28559":121536,"_3075":121631},[],"Requisito",{"_3699":73168,"_31384":73129,"_21647":121633,"_5":14929,"_28559":121536,"_3075":121634},[],"Diseño recomendado",{"_3699":73169,"_31384":73129,"_21647":121636,"_5":14929,"_28559":121536,"_3075":121637},[],"Consecuencia",{"_3699":73170,"_31384":73129,"_21647":121639,"_5":14929,"_28559":121536,"_3075":121640},[],"Varias URL o servicios de Lamassu",{"_3699":73171,"_31384":73129,"_21647":121642,"_5":14929,"_28559":121536,"_3075":121643},[],"Un Gateway con varias rutas",{"_3699":73172,"_31384":73129,"_21647":121645,"_5":14929,"_28559":121536,"_3075":121646},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3699":73173,"_31384":73129,"_21647":121648,"_5":14929,"_28559":121536,"_3075":121649},[],"Gateways independientes e IP externas distintas",{"_3699":73174,"_31384":73129,"_21647":121651,"_5":14929,"_28559":121536,"_3075":121652},[],"Una VIP por Gateway",{"_3699":73175,"_31384":73129,"_21647":121654,"_5":14929,"_28559":121536,"_3075":121655},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3699":73176,"_31384":73129,"_21647":121657,"_5":14929,"_28559":121536,"_3075":121658},[],"Gateways independientes, un nodo y una IP",{"_3699":73177,"_31384":73129,"_21647":121660,"_5":14929,"_28559":121536,"_3075":121661},[],"Puertos externos diferentes",{"_3699":73178,"_31384":73129,"_21647":121663,"_5":14929,"_28559":121536,"_3075":121664},[],"Los clientes deben indicar puertos no estándar",{"_3699":73179,"_31384":73129,"_21647":121666,"_5":14929,"_28559":121536,"_3075":121667},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3699":73180,"_31384":73129,"_21647":121669,"_5":14929,"_28559":121536,"_3075":121670},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3699":73181,"_31384":73129,"_21647":121672,"_5":14929,"_28559":121536,"_3075":121673},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3699":73182,"_31384":73129,"_21647":121675,"_5":14929,"_28559":121536,"_3075":121676},[],"Recursos Gateway separados pero proxy compartido",{"_3699":73183,"_31384":73129,"_21647":121678,"_5":14929,"_28559":121536,"_3075":121679},[],"Modo merged Gateway de Envoy",{"_3699":73184,"_31384":73129,"_21647":121681,"_5":14929,"_28559":121536,"_3075":121682},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3699":73185,"_31384":73129,"_21647":121684,"_5":14929,"_28559":121536,"_3075":121685},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3699":73186,"_31384":73129,"_21647":121687,"_5":14929,"_28559":121536,"_3075":121688},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3699":73187,"_31384":73129,"_21647":121690,"_5":14929,"_28559":121536,"_3075":121691},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3699":73188,"_31384":73129,"_21647":121693,"_5":14929,"_28559":121536,"_3075":121694},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3699":73189,"_31384":73129,"_21647":121696,"_5":14929,"_28559":121540,"_3075":121697},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3699":73190,"_31384":73129,"_21647":121699,"_5":14929,"_28559":121544,"_3075":121700},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3699":73191,"_31384":73129,"_21647":121702,"_5":14929,"_28559":121544,"_3075":121703},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3699":73192,"_31384":73129,"_21647":121705,"_5":14929,"_28559":121544,"_3075":121706},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3699":73193,"_31384":73129,"_21647":121708,"_5":14929,"_28559":121544,"_3075":121709},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3699":73194,"_31384":73129,"_21647":121711,"_5":14929,"_28559":121544,"_3075":121712},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3699":73195,"_31384":73129,"_21647":121714,"_5":14929,"_28559":121548,"_3075":121715},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3699":73196,"_31384":73129,"_21647":121717,"_5":14929,"_28559":121548,"_3075":121718},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3699":73197,"_31384":73129,"_21647":121720,"_5":14929,"_28559":121552,"_3075":121721},[],"Comprueba, en orden:",{"_3699":73198,"_31384":73129,"_21647":121723,"_5":14929,"_28559":121552,"_3075":121724},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3699":73199,"_31384":73129,"_21647":121726,"_5":14929,"_28559":121552,"_3075":121727},[],"Su estado contiene la dirección esperada.",{"_3699":73200,"_31384":73129,"_21647":121729,"_5":14929,"_28559":121552,"_3075":121730},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3699":73201,"_31384":73129,"_21647":121732,"_5":14929,"_28559":121552,"_3075":121733},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3699":73202,"_31384":73129,"_21647":121735,"_5":14929,"_28559":121552,"_3075":121736},[],"DNS resuelve al endpoint accesible externamente.",{"_3699":73203,"_31384":73129,"_21647":121738,"_5":14929,"_28559":121552,"_3075":121739},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3699":73204,"_31384":73129,"_21647":121741,"_5":14929,"_28559":121552,"_3075":121742},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3699":73205,"_31384":73205,"_5":15283,"_3075":51201,"_31709":121744,"_21647":121745,"_28559":73205},[51094,120668,120902],[],{"_3699":73206,"_31384":73205,"_21647":121747,"_5":14929,"_28559":73205,"_3075":121748},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3699":73207,"_31384":73205,"_5":31706,"_21647":121750,"_28559":121751,"_3075":121752},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3699":73208,"_31384":73205,"_5":31706,"_21647":121754,"_28559":121755,"_3075":121756},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3699":73209,"_31384":73205,"_5":31706,"_21647":121758,"_28559":121759,"_3075":121760},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3699":73210,"_31384":73205,"_5":31706,"_21647":121762,"_28559":121763,"_3075":121764},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3699":73211,"_31384":73205,"_5":31706,"_21647":121766,"_28559":121767,"_3075":121768},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3699":73212,"_31384":73205,"_5":31706,"_21647":121770,"_28559":121771,"_3075":121772},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3699":73213,"_31384":73205,"_21647":121774,"_5":14929,"_28559":121751,"_3075":121775},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3699":73214,"_31384":73205,"_21647":121777,"_5":14929,"_28559":121755,"_3075":121778},[],"Flujo",{"_3699":73215,"_31384":73205,"_21647":121780,"_5":14929,"_28559":121755,"_3075":121781},[],"Úsalo para",{"_3699":73216,"_31384":73205,"_21647":121783,"_5":14929,"_28559":121755,"_3075":121784},[],"Qué instala",{"_3699":73217,"_31384":73205,"_21647":121786,"_5":14929,"_28559":121755,"_3075":52248},[],{"_3699":73218,"_31384":73205,"_21647":121788,"_5":14929,"_28559":121755,"_3075":121789},[],"Producción y entornos controlados",{"_3699":73219,"_31384":73205,"_21647":121791,"_5":14929,"_28559":121755,"_3075":121792},[],"Servicios de Lamassu y recursos de Gateway API",{"_3699":73220,"_31384":73205,"_21647":121794,"_5":14929,"_28559":121755,"_3075":51338},[],{"_3699":73221,"_31384":73205,"_21647":121796,"_5":14929,"_28559":121755,"_3075":121797},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3699":73222,"_31384":73205,"_21647":121799,"_5":14929,"_28559":121755,"_3075":121800},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3699":73223,"_31384":73205,"_21647":121802,"_5":14929,"_28559":121759,"_3075":121803},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3699":73224,"_31384":73205,"_21647":121805,"_5":14929,"_28559":121759,"_3075":121806},[],"Área",{"_3699":73225,"_31384":73205,"_21647":121808,"_5":14929,"_28559":121759,"_3075":121809},[],"El chart de Lamassu proporciona",{"_3699":73226,"_31384":73205,"_21647":121811,"_5":14929,"_28559":121759,"_3075":121812},[],"Tú proporcionas",{"_3699":73227,"_31384":73205,"_21647":121814,"_5":14929,"_28559":121759,"_3075":121815},[],"Aplicaciones Lamassu",{"_3699":73228,"_31384":73205,"_21647":121817,"_5":14929,"_28559":121759,"_3075":121818},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3699":73229,"_31384":73205,"_21647":121820,"_5":14929,"_28559":121759,"_3075":121821},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3699":73230,"_31384":73205,"_21647":121823,"_5":14929,"_28559":121759,"_3075":121824},[],"Datos PostgreSQL",{"_3699":73231,"_31384":73205,"_21647":121826,"_5":14929,"_28559":121759,"_3075":121827},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3699":73232,"_31384":73205,"_21647":121829,"_5":14929,"_28559":121759,"_3075":121830},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3699":73233,"_31384":73205,"_21647":121832,"_5":14929,"_28559":121759,"_3075":121833},[],"Mensajería",{"_3699":73234,"_31384":73205,"_21647":121835,"_5":14929,"_28559":121759,"_3075":121836},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3699":73235,"_31384":73205,"_21647":121838,"_5":14929,"_28559":121759,"_3075":121839},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3699":73236,"_31384":73205,"_21647":121841,"_5":14929,"_28559":121759,"_3075":121842},[],"Identidad",{"_3699":73237,"_31384":73205,"_21647":121844,"_5":14929,"_28559":121759,"_3075":121845},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3699":73238,"_31384":73205,"_21647":121847,"_5":14929,"_28559":121759,"_3075":121848},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3699":73239,"_31384":73205,"_21647":121850,"_5":14929,"_28559":121759,"_3075":121851},[],"Enrutamiento externo",{"_3699":73240,"_31384":73205,"_21647":121853,"_5":14929,"_28559":121759,"_3075":121854},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3699":73241,"_31384":73205,"_21647":121856,"_5":14929,"_28559":121759,"_3075":121857},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3699":73242,"_31384":73205,"_21647":121859,"_5":14929,"_28559":121759,"_3075":52322},[],{"_3699":73243,"_31384":73205,"_21647":121861,"_5":14929,"_28559":121759,"_3075":121862},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3699":73244,"_31384":73205,"_21647":121864,"_5":14929,"_28559":121759,"_3075":121865},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3699":73245,"_31384":73205,"_21647":121867,"_5":14929,"_28559":121759,"_3075":121868},[],"Datos persistentes de la aplicación",{"_3699":73246,"_31384":73205,"_21647":121870,"_5":14929,"_28559":121759,"_3075":121871},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3699":73247,"_31384":73205,"_21647":121873,"_5":14929,"_28559":121759,"_3075":121874},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3699":73248,"_31384":73205,"_21647":121876,"_5":14929,"_28559":121759,"_3075":121877},[],"Integraciones opcionales",{"_3699":73249,"_31384":73205,"_21647":121879,"_5":14929,"_28559":121759,"_3075":121880},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3699":73250,"_31384":73205,"_21647":121882,"_5":14929,"_28559":121759,"_3075":121883},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3699":73251,"_31384":73205,"_21647":121885,"_5":14929,"_28559":121759,"_3075":121886},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3699":73252,"_31384":73205,"_21647":121888,"_5":14929,"_28559":121759,"_3075":121889},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3699":73253,"_31384":73205,"_21647":121891,"_5":14929,"_28559":121763,"_3075":121892},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3699":73254,"_31384":73205,"_21647":121894,"_5":14929,"_28559":121763,"_3075":121895},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3699":73255,"_31384":73205,"_21647":121897,"_5":14929,"_28559":121767,"_3075":121898},[],"Kubernetes 1.24 o posterior",{"_3699":73256,"_31384":73205,"_21647":121900,"_5":14929,"_28559":121767,"_3075":121901},[],"Helm 3.2 o posterior",{"_3699":73257,"_31384":73205,"_21647":121903,"_5":14929,"_28559":121767,"_3075":121904},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3699":73258,"_31384":73205,"_21647":121906,"_5":14929,"_28559":121767,"_3075":121907},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3699":73259,"_31384":73205,"_21647":121909,"_5":14929,"_28559":121767,"_3075":121910},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3699":73260,"_31384":73205,"_21647":121912,"_5":14929,"_28559":121767,"_3075":121913},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3699":73261,"_31384":73205,"_21647":121915,"_5":14929,"_28559":121767,"_3075":121916},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3699":73262,"_31384":73205,"_21647":121918,"_5":14929,"_28559":121771,"_3075":121919},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3699":73263,"_31384":73205,"_21647":121921,"_5":14929,"_28559":121771,"_3075":121922},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3699":73264,"_31384":73205,"_21647":121924,"_5":14929,"_28559":121771,"_3075":121925},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3699":73265,"_31384":73205,"_21647":121927,"_5":14929,"_28559":121771,"_3075":121928},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3699":73266,"_31384":73266,"_5":15283,"_3075":121930,"_31709":121931,"_21647":121933,"_28559":73266},"Resolución de problemas de despliegue",[51094,120668,121932],"Operación",[],{"_3699":73267,"_31384":73266,"_21647":121935,"_5":14929,"_28559":73266,"_3075":121936},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3699":73268,"_31384":73266,"_5":31706,"_21647":121938,"_28559":121939,"_3075":121940},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3699":73269,"_31384":73266,"_5":31706,"_21647":121942,"_28559":121943,"_3075":121944},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3699":73270,"_31384":73266,"_5":31706,"_21647":121946,"_28559":121947,"_3075":121948},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3699":73271,"_31384":73266,"_5":31706,"_21647":121950,"_28559":121951,"_3075":121952},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3699":73272,"_31384":73266,"_5":31706,"_21647":121954,"_28559":121955,"_3075":121956},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3699":73273,"_31384":73266,"_5":31706,"_21647":121958,"_28559":121959,"_3075":121960},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3699":73274,"_31384":73266,"_5":31706,"_21647":121962,"_28559":121963,"_3075":121964},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3699":73275,"_31384":73266,"_5":31706,"_21647":121966,"_28559":121967,"_3075":121968},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3699":73276,"_31384":73266,"_5":31706,"_21647":121970,"_28559":121971,"_3075":121972},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3699":73277,"_31384":73266,"_5":31706,"_21647":121974,"_28559":121975,"_3075":121976},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3699":73278,"_31384":73266,"_5":31706,"_21647":121978,"_28559":121979,"_3075":121980},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3699":73279,"_31384":73266,"_5":31706,"_21647":121982,"_28559":121983,"_3075":121984},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3699":73280,"_31384":73266,"_5":31706,"_21647":121986,"_28559":121987,"_3075":121988},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3699":73281,"_31384":73266,"_21647":121990,"_5":14929,"_28559":73266,"_3075":121991},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3699":73282,"_31384":73266,"_21647":121993,"_5":14929,"_28559":121943,"_3075":121994},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3699":73283,"_31384":73266,"_21647":121996,"_5":14929,"_28559":121947,"_3075":121997},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3699":73284,"_31384":73266,"_21647":121999,"_5":14929,"_28559":121951,"_3075":122000},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3699":73285,"_31384":73266,"_21647":122002,"_5":14929,"_28559":121955,"_3075":122003},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3699":73286,"_31384":73266,"_21647":122005,"_5":14929,"_28559":121959,"_3075":122006},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3699":73287,"_31384":73266,"_21647":122008,"_5":14929,"_28559":121963,"_3075":122009},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3699":73288,"_31384":73266,"_21647":122011,"_5":14929,"_28559":121963,"_3075":122012},[],"Ejecuta también la prueba de conectividad del chart:",{"_3699":73289,"_31384":73266,"_21647":122014,"_5":14929,"_28559":121963,"_3075":122015},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3699":73290,"_31384":73266,"_21647":122017,"_5":14929,"_28559":121963,"_3075":122018},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3699":73291,"_31384":73266,"_21647":122020,"_5":14929,"_28559":121967,"_3075":122021},[],"Si recibes un 401:",{"_3699":73292,"_31384":73266,"_21647":122023,"_5":14929,"_28559":121967,"_3075":122024},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3699":73293,"_31384":73266,"_21647":122026,"_5":14929,"_28559":121967,"_3075":122027},[],"verifica emisor, audiencia y expiración del token;",{"_3699":73294,"_31384":73266,"_21647":122029,"_5":14929,"_28559":121967,"_3075":122030},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3699":73295,"_31384":73266,"_21647":122032,"_5":14929,"_28559":121967,"_3075":122033},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3699":73296,"_31384":73266,"_21647":122035,"_5":14929,"_28559":121967,"_3075":122036},[],"Si el login termina pero las APIs devuelven 403:",{"_3699":73297,"_31384":73266,"_21647":122038,"_5":14929,"_28559":121967,"_3075":122039},[],"inspecciona los claims reales del token;",{"_3699":73298,"_31384":73266,"_21647":122041,"_5":14929,"_28559":121967,"_3075":122042},[],"confirma que coinciden con un principal activo;",{"_3699":73299,"_31384":73266,"_21647":122044,"_5":14929,"_28559":121967,"_3075":122045},[],"revisa las políticas concedidas al principal;",{"_3699":73300,"_31384":73266,"_21647":122047,"_5":14929,"_28559":121967,"_3075":122048},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3699":73301,"_31384":73266,"_21647":122050,"_5":14929,"_28559":121967,"_3075":122051},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3699":73302,"_31384":73266,"_21647":122053,"_5":14929,"_28559":121971,"_3075":122054},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3699":73303,"_31384":73266,"_21647":122056,"_5":14929,"_28559":121971,"_3075":122057},[],"Localiza el pod y Service de authz.",{"_3699":73304,"_31384":73266,"_21647":122059,"_5":14929,"_28559":121971,"_3075":122060},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3699":73305,"_31384":73266,"_21647":122062,"_5":14929,"_28559":121971,"_3075":122063},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3699":73306,"_31384":73266,"_21647":122065,"_5":14929,"_28559":121971,"_3075":122066},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3699":73307,"_31384":73266,"_21647":122068,"_5":14929,"_28559":121971,"_3075":122069},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3699":73308,"_31384":73266,"_21647":122071,"_5":14929,"_28559":121975,"_3075":122072},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3699":73309,"_31384":73266,"_21647":122074,"_5":14929,"_28559":121979,"_3075":122075},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3699":73310,"_31384":73266,"_21647":122077,"_5":14929,"_28559":121979,"_3075":122078},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3699":73311,"_31384":73266,"_21647":122080,"_5":14929,"_28559":121979,"_3075":122081},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3699":73312,"_31384":73266,"_21647":122083,"_5":14929,"_28559":121979,"_3075":122084},[],"volumen persistente sin enlazar;",{"_3699":73313,"_31384":73266,"_21647":122086,"_5":14929,"_28559":121979,"_3075":122087},[],"imagen inaccesible o política de pull incorrecta;",{"_3699":73314,"_31384":73266,"_21647":122089,"_5":14929,"_28559":121979,"_3075":122090},[],"configuración inválida del motor criptográfico;",{"_3699":73315,"_31384":73266,"_21647":122092,"_5":14929,"_28559":121979,"_3075":122093},[],"límites de CPU o memoria demasiado bajos;",{"_3699":73316,"_31384":73266,"_21647":122095,"_5":14929,"_28559":121979,"_3075":122096},[],"migración previa incompleta.",{"_3699":73317,"_31384":73266,"_21647":122098,"_5":14929,"_28559":121979,"_3075":122099},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3699":73318,"_31384":73266,"_21647":122101,"_5":14929,"_28559":121979,"_3075":122102},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3699":73319,"_31384":73266,"_21647":122104,"_5":14929,"_28559":121979,"_3075":122105},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3699":73320,"_31384":73266,"_21647":122107,"_5":14929,"_28559":121983,"_3075":122108},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3699":73321,"_31384":73266,"_21647":122110,"_5":14929,"_28559":121983,"_3075":122111},[],"verifica que esté habilitado en el servicio emisor;",{"_3699":73322,"_31384":73266,"_21647":122113,"_5":14929,"_28559":121983,"_3075":122114},[],"comprueba conectividad y credenciales AMQP;",{"_3699":73323,"_31384":73266,"_21647":122116,"_5":14929,"_28559":121983,"_3075":122117},[],"revisa exchange, routing key, colas y consumidores;",{"_3699":73324,"_31384":73266,"_21647":122119,"_5":14929,"_28559":121983,"_3075":122120},[],"inspecciona dead-letter queues;",{"_3699":73325,"_31384":73266,"_21647":122122,"_5":14929,"_28559":121983,"_3075":122123},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3699":73326,"_31384":73266,"_21647":122125,"_5":14929,"_28559":121983,"_3075":122126},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3699":73327,"_31384":73266,"_21647":122128,"_5":14929,"_28559":121983,"_3075":122129},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3699":73328,"_31384":73266,"_21647":122131,"_5":14929,"_28559":121983,"_3075":122132},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3699":73329,"_31384":73266,"_21647":122134,"_5":14929,"_28559":121983,"_3075":122135},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3699":73330,"_31384":73266,"_21647":122137,"_5":14929,"_28559":121983,"_3075":122138},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3699":73331,"_31384":73266,"_21647":122140,"_5":14929,"_28559":121983,"_3075":122141},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3699":73332,"_31384":73266,"_21647":122143,"_5":14929,"_28559":121983,"_3075":122144},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3699":73333,"_31384":73266,"_21647":122146,"_5":14929,"_28559":121987,"_3075":122147},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3699":73334,"_31384":73266,"_21647":122149,"_5":14929,"_28559":121987,"_3075":122150},[],"Antes de cerrar una incidencia, guarda:",{"_3699":73335,"_31384":73266,"_21647":122152,"_5":14929,"_28559":121987,"_3075":122153},[],"causa confirmada;",{"_3699":73336,"_31384":73266,"_21647":122155,"_5":14929,"_28559":121987,"_3075":122156},[],"alcance temporal y recursos afectados;",{"_3699":73337,"_31384":73266,"_21647":122158,"_5":14929,"_28559":121987,"_3075":122159},[],"comandos o consultas utilizados;",{"_3699":73338,"_31384":73266,"_21647":122161,"_5":14929,"_28559":121987,"_3075":122162},[],"cambio aplicado y forma de revertirlo;",{"_3699":73339,"_31384":73266,"_21647":122164,"_5":14929,"_28559":121987,"_3075":122165},[],"validación desde un consumidor;",{"_3699":73340,"_31384":73266,"_21647":122167,"_5":14929,"_28559":121987,"_3075":122168},[],"acción preventiva y propietario.",{"_3699":73341,"_31384":73341,"_5":15283,"_3075":122170,"_31709":122171,"_21647":122175,"_28559":73341},"Modelo de datos",[51094,122172,122173,122174],"Plataforma","Administración","Control de acceso",[],{"_3699":73342,"_31384":73341,"_21647":122177,"_5":14929,"_28559":73341,"_3075":122178},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3699":73343,"_31384":73341,"_5":31706,"_21647":122180,"_28559":122181,"_3075":122182},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3699":73344,"_31384":73341,"_5":31706,"_21647":122184,"_28559":122185,"_3075":122186},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3699":73345,"_31384":73341,"_21647":122188,"_5":14929,"_28559":73341,"_3075":122189},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3699":73346,"_31384":73341,"_21647":122191,"_5":14929,"_28559":122181,"_3075":122192},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3699":73347,"_31384":73341,"_21647":122194,"_5":14929,"_28559":122181,"_3075":122195},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3699":73348,"_31384":73341,"_21647":122197,"_5":14929,"_28559":122181,"_3075":122198},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3699":73349,"_31384":73341,"_21647":122200,"_5":14929,"_28559":122185,"_3075":122201},[],"Entidad (`schema_name.entity_type`)",{"_3699":73350,"_31384":73341,"_21647":122203,"_5":14929,"_28559":122185,"_3075":122204},[],"Tabla (`table_name`)",{"_3699":73351,"_31384":73341,"_21647":122206,"_5":14929,"_28559":122185,"_3075":122207},[],"Clave (`primary_key`)",{"_3699":73352,"_31384":73341,"_21647":122209,"_5":14929,"_28559":122185,"_3075":52673},[],{"_3699":73353,"_31384":73341,"_21647":122211,"_5":14929,"_28559":122185,"_3075":52676},[],{"_3699":73354,"_31384":73341,"_21647":122213,"_5":14929,"_28559":122185,"_3075":52679},[],{"_3699":73355,"_31384":73341,"_21647":122215,"_5":14929,"_28559":122185,"_3075":52682},[],{"_3699":73356,"_31384":73341,"_21647":122217,"_5":14929,"_28559":122185,"_3075":52685},[],{"_3699":73357,"_31384":73341,"_21647":122219,"_5":14929,"_28559":122185,"_3075":52688},[],{"_3699":73358,"_31384":73341,"_21647":122221,"_5":14929,"_28559":122185,"_3075":52691},[],{"_3699":73359,"_31384":73341,"_21647":122223,"_5":14929,"_28559":122185,"_3075":52694},[],{"_3699":73360,"_31384":73341,"_21647":122225,"_5":14929,"_28559":122185,"_3075":52688},[],{"_3699":73361,"_31384":73341,"_21647":122227,"_5":14929,"_28559":122185,"_3075":52699},[],{"_3699":73362,"_31384":73341,"_21647":122229,"_5":14929,"_28559":122185,"_3075":52702},[],{"_3699":73363,"_31384":73341,"_21647":122231,"_5":14929,"_28559":122185,"_3075":52705},[],{"_3699":73364,"_31384":73341,"_21647":122233,"_5":14929,"_28559":122185,"_3075":52708},[],{"_3699":73365,"_31384":73341,"_21647":122235,"_5":14929,"_28559":122185,"_3075":52711},[],{"_3699":73366,"_31384":73341,"_21647":122237,"_5":14929,"_28559":122185,"_3075":52688},[],{"_3699":73367,"_31384":73341,"_21647":122239,"_5":14929,"_28559":122185,"_3075":52716},[],{"_3699":73368,"_31384":73341,"_21647":122241,"_5":14929,"_28559":122185,"_3075":52719},[],{"_3699":73369,"_31384":73341,"_21647":122243,"_5":14929,"_28559":122185,"_3075":52688},[],{"_3699":73370,"_31384":73341,"_21647":122245,"_5":14929,"_28559":122185,"_3075":52724},[],{"_3699":73371,"_31384":73341,"_21647":122247,"_5":14929,"_28559":122185,"_3075":52727},[],{"_3699":73372,"_31384":73341,"_21647":122249,"_5":14929,"_28559":122185,"_3075":52688},[],{"_3699":73373,"_31384":73341,"_21647":122251,"_5":14929,"_28559":122185,"_3075":52732},[],{"_3699":73374,"_31384":73341,"_21647":122253,"_5":14929,"_28559":122185,"_3075":52735},[],{"_3699":73375,"_31384":73341,"_21647":122255,"_5":14929,"_28559":122185,"_3075":52688},[],{"_3699":73376,"_31384":73341,"_21647":122257,"_5":14929,"_28559":122185,"_3075":52740},[],{"_3699":73377,"_31384":73341,"_21647":122259,"_5":14929,"_28559":122185,"_3075":52743},[],{"_3699":73378,"_31384":73341,"_21647":122261,"_5":14929,"_28559":122185,"_3075":52746},[],{"_3699":73379,"_31384":73341,"_21647":122263,"_5":14929,"_28559":122185,"_3075":52749},[],{"_3699":73380,"_31384":73341,"_21647":122265,"_5":14929,"_28559":122185,"_3075":52752},[],{"_3699":73381,"_31384":73341,"_21647":122267,"_5":14929,"_28559":122185,"_3075":52755},[],{"_3699":73382,"_31384":73341,"_21647":122269,"_5":14929,"_28559":122185,"_3075":122270},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3699":73383,"_31384":73341,"_21647":122272,"_5":14929,"_28559":122185,"_3075":122273},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3699":73384,"_31384":73341,"_21647":122275,"_5":14929,"_28559":122185,"_3075":122276},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3699":73385,"_31384":73385,"_5":15283,"_3075":122278,"_31709":122279,"_21647":122280,"_28559":73385},"Visión general del control de acceso",[51094,122172,122173,122174],[],{"_3699":73386,"_31384":73385,"_21647":122282,"_5":14929,"_28559":73385,"_3075":122283},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3699":73387,"_31384":73385,"_5":31706,"_21647":122285,"_28559":122286,"_3075":122287},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3699":73388,"_31384":73385,"_5":31706,"_21647":122289,"_28559":122290,"_3075":122291},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3699":73389,"_31384":73385,"_5":31706,"_21647":122293,"_28559":122294,"_3075":122295},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3699":73390,"_31384":73385,"_5":31706,"_21647":122297,"_28559":122298,"_3075":122299},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3699":73391,"_31384":73385,"_5":31706,"_21647":122301,"_28559":122302,"_3075":122303},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3699":73392,"_31384":73385,"_5":31706,"_21647":122305,"_28559":122306,"_3075":122307},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3699":73393,"_31384":73385,"_5":31706,"_21647":122309,"_28559":122310,"_3075":122311},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3699":73394,"_31384":73385,"_5":31706,"_21647":122313,"_28559":122314,"_3075":122315},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3699":73395,"_31384":73385,"_5":31706,"_21647":122317,"_28559":122318,"_3075":122319},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3699":73396,"_31384":73385,"_5":31706,"_21647":122321,"_28559":122322,"_3075":122323},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3699":73397,"_31384":73385,"_5":31706,"_21647":122325,"_28559":122326,"_3075":122327},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3699":73398,"_31384":73385,"_5":31706,"_21647":122329,"_28559":122330,"_3075":122331},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3699":73399,"_31384":73385,"_5":31706,"_21647":122333,"_28559":122334,"_3075":122335},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3699":73400,"_31384":73385,"_5":31706,"_21647":122337,"_28559":122338,"_3075":122339},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3699":73401,"_31384":73385,"_5":31706,"_21647":122341,"_28559":122342,"_3075":122343},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3699":73402,"_31384":73385,"_5":31706,"_21647":122345,"_28559":122346,"_3075":121288},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3699":73403,"_31384":73385,"_5":31706,"_21647":122348,"_28559":122349,"_3075":122350},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3699":73404,"_31384":73385,"_5":31706,"_21647":122352,"_28559":122353,"_3075":122354},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3699":73405,"_31384":73385,"_5":31706,"_21647":122356,"_28559":122357,"_3075":122358},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3699":73406,"_31384":73385,"_5":31706,"_21647":122360,"_28559":122361,"_3075":122362},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3699":73407,"_31384":73385,"_5":31706,"_21647":122364,"_28559":122365,"_3075":122366},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3699":73408,"_31384":73385,"_5":31706,"_21647":122368,"_28559":122369,"_3075":122370},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3699":73409,"_31384":73385,"_5":31706,"_21647":122372,"_28559":122373,"_3075":122374},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3699":73410,"_31384":73385,"_5":31706,"_21647":122376,"_28559":122377,"_3075":122378},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3699":73411,"_31384":73385,"_5":31706,"_21647":122380,"_28559":122381,"_3075":122382},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3699":73412,"_31384":73385,"_5":31706,"_21647":122384,"_28559":122385,"_3075":122386},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3699":73413,"_31384":73385,"_5":31706,"_21647":122388,"_28559":122389,"_3075":122390},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3699":73414,"_31384":73385,"_5":31706,"_21647":122392,"_28559":122393,"_3075":122394},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3699":73415,"_31384":73385,"_5":31706,"_21647":122396,"_28559":122397,"_3075":122398},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3699":73416,"_31384":73385,"_5":31706,"_21647":122400,"_28559":122401,"_3075":122402},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3699":73417,"_31384":73385,"_5":31706,"_21647":122404,"_28559":122405,"_3075":122406},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3699":73418,"_31384":73385,"_21647":122408,"_5":14929,"_28559":73385,"_3075":122409},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3699":73419,"_31384":73385,"_21647":122411,"_5":14929,"_28559":73385,"_3075":122412},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3699":73420,"_31384":73385,"_21647":122414,"_5":14929,"_28559":73385,"_3075":122415},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3699":73421,"_31384":73385,"_21647":122417,"_5":14929,"_28559":122286,"_3075":122418},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3699":73422,"_31384":73385,"_21647":122420,"_5":14929,"_28559":122286,"_3075":122421},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3699":73423,"_31384":73385,"_21647":122423,"_5":14929,"_28559":122286,"_3075":122424},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3699":73424,"_31384":73385,"_21647":122426,"_5":14929,"_28559":122286,"_3075":122427},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3699":73425,"_31384":73385,"_21647":122429,"_5":14929,"_28559":122286,"_3075":122430},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3699":73426,"_31384":73385,"_21647":122432,"_5":14929,"_28559":122286,"_3075":122433},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3699":73427,"_31384":73385,"_21647":122435,"_5":14929,"_28559":122290,"_3075":122436},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3699":73428,"_31384":73385,"_21647":122438,"_5":14929,"_28559":122290,"_3075":122439},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3699":73429,"_31384":73385,"_21647":122441,"_5":14929,"_28559":122294,"_3075":122442},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3699":73430,"_31384":73385,"_21647":122444,"_5":14929,"_28559":122294,"_3075":122445},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3699":73431,"_31384":73385,"_21647":122447,"_5":14929,"_28559":122294,"_3075":122448},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3699":73432,"_31384":73385,"_21647":122450,"_5":14929,"_28559":122294,"_3075":122451},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3699":73433,"_31384":73385,"_21647":122453,"_5":14929,"_28559":122294,"_3075":122454},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3699":73434,"_31384":73385,"_21647":122456,"_5":14929,"_28559":122294,"_3075":122457},[],"Carga por separado las políticas concedidas a cada principal.",{"_3699":73435,"_31384":73385,"_21647":122459,"_5":14929,"_28559":122294,"_3075":122460},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3699":73436,"_31384":73385,"_21647":122462,"_5":14929,"_28559":122294,"_3075":122463},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3699":73437,"_31384":73385,"_21647":122465,"_5":14929,"_28559":122294,"_3075":122466},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3699":73438,"_31384":73385,"_21647":122468,"_5":14929,"_28559":122294,"_3075":122469},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3699":73439,"_31384":73385,"_21647":122471,"_5":14929,"_28559":122294,"_3075":122472},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3699":73440,"_31384":73385,"_21647":122474,"_5":14929,"_28559":122294,"_3075":122475},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3699":73441,"_31384":73385,"_21647":122477,"_5":14929,"_28559":122298,"_3075":122478},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3699":73442,"_31384":73385,"_21647":122480,"_5":14929,"_28559":122298,"_3075":122481},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3699":73443,"_31384":73385,"_21647":122483,"_5":14929,"_28559":122298,"_3075":122484},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3699":73444,"_31384":73385,"_21647":122486,"_5":14929,"_28559":122298,"_3075":122487},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3699":73445,"_31384":73385,"_21647":122489,"_5":14929,"_28559":122298,"_3075":122490},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3699":73446,"_31384":73385,"_21647":122492,"_5":14929,"_28559":122298,"_3075":122493},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3699":73447,"_31384":73385,"_21647":122495,"_5":14929,"_28559":122298,"_3075":122496},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3699":73448,"_31384":73385,"_21647":122498,"_5":14929,"_28559":122298,"_3075":122499},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3699":73449,"_31384":73385,"_21647":122501,"_5":14929,"_28559":122298,"_3075":122502},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3699":73450,"_31384":73385,"_21647":122504,"_5":14929,"_28559":122298,"_3075":122505},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3699":73451,"_31384":73385,"_21647":122507,"_5":14929,"_28559":122302,"_3075":122508},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3699":73452,"_31384":73385,"_21647":122510,"_5":14929,"_28559":122302,"_3075":122511},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3699":73453,"_31384":73385,"_21647":122513,"_5":14929,"_28559":122302,"_3075":122514},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3699":73454,"_31384":73385,"_21647":122516,"_5":14929,"_28559":122302,"_3075":122517},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3699":73455,"_31384":73385,"_21647":122519,"_5":14929,"_28559":122302,"_3075":122520},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3699":73456,"_31384":73385,"_21647":122522,"_5":14929,"_28559":122302,"_3075":122523},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3699":73457,"_31384":73385,"_21647":122525,"_5":14929,"_28559":122302,"_3075":122526},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3699":73458,"_31384":73385,"_21647":122528,"_5":14929,"_28559":122302,"_3075":122529},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3699":73459,"_31384":73385,"_21647":122531,"_5":14929,"_28559":122302,"_3075":122532},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3699":73460,"_31384":73385,"_21647":122534,"_5":14929,"_28559":122302,"_3075":122535},[],"Las acciones se dividen en dos grupos:",{"_3699":73461,"_31384":73385,"_21647":122537,"_5":14929,"_28559":122302,"_3075":122538},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3699":73462,"_31384":73385,"_21647":122540,"_5":14929,"_28559":122302,"_3075":122541},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3699":73463,"_31384":73385,"_21647":122543,"_5":14929,"_28559":122302,"_3075":122544},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3699":73464,"_31384":73385,"_21647":122546,"_5":14929,"_28559":122306,"_3075":122547},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3699":73465,"_31384":73385,"_21647":122549,"_5":14929,"_28559":122306,"_3075":122550},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3699":73466,"_31384":73385,"_21647":122552,"_5":14929,"_28559":122306,"_3075":122553},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3699":73467,"_31384":73385,"_21647":122555,"_5":14929,"_28559":122310,"_3075":122556},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3699":73468,"_31384":73385,"_21647":122558,"_5":14929,"_28559":122310,"_3075":122559},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3699":73469,"_31384":73385,"_21647":122561,"_5":14929,"_28559":122310,"_3075":122562},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3699":73470,"_31384":73385,"_21647":122564,"_5":14929,"_28559":122310,"_3075":122565},[],"Los operadores implementados son:",{"_3699":73471,"_31384":73385,"_21647":122567,"_5":14929,"_28559":122310,"_3075":122568},[],"`equals`, para igualdad exacta;",{"_3699":73472,"_31384":73385,"_21647":122570,"_5":14929,"_28559":122310,"_3075":122571},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3699":73473,"_31384":73385,"_21647":122573,"_5":14929,"_28559":122310,"_3075":122574},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3699":73474,"_31384":73385,"_21647":122576,"_5":14929,"_28559":122310,"_3075":122577},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3699":73475,"_31384":73385,"_21647":122579,"_5":14929,"_28559":122314,"_3075":122580},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3699":73476,"_31384":73385,"_21647":122582,"_5":14929,"_28559":122314,"_3075":122583},[],"Los modos disponibles son:",{"_3699":73477,"_31384":73385,"_21647":122585,"_5":14929,"_28559":122314,"_3075":122586},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3699":73478,"_31384":73385,"_21647":122588,"_5":14929,"_28559":122314,"_3075":122589},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3699":73479,"_31384":73385,"_21647":122591,"_5":14929,"_28559":122314,"_3075":122592},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3699":73480,"_31384":73385,"_21647":122594,"_5":14929,"_28559":122314,"_3075":122595},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3699":73481,"_31384":73385,"_21647":122597,"_5":14929,"_28559":122314,"_3075":122598},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3699":73482,"_31384":73385,"_21647":122600,"_5":14929,"_28559":122314,"_3075":122601},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3699":73483,"_31384":73385,"_21647":122603,"_5":14929,"_28559":122318,"_3075":122604},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3699":73484,"_31384":73385,"_21647":122606,"_5":14929,"_28559":122318,"_3075":122607},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3699":73485,"_31384":73385,"_21647":122609,"_5":14929,"_28559":122318,"_3075":122610},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3699":73486,"_31384":73385,"_21647":122612,"_5":14929,"_28559":122318,"_3075":122613},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3699":73487,"_31384":73385,"_21647":122615,"_5":14929,"_28559":122326,"_3075":122616},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3699":73488,"_31384":73385,"_21647":122618,"_5":14929,"_28559":122326,"_3075":122619},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3699":73489,"_31384":73385,"_21647":122621,"_5":14929,"_28559":122330,"_3075":122622},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3699":73490,"_31384":73385,"_21647":122624,"_5":14929,"_28559":122330,"_3075":122625},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3699":73491,"_31384":73385,"_21647":122627,"_5":14929,"_28559":122330,"_3075":122628},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3699":73492,"_31384":73385,"_21647":122630,"_5":14929,"_28559":122330,"_3075":122631},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3699":73493,"_31384":73385,"_21647":122633,"_5":14929,"_28559":122330,"_3075":122634},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3699":73494,"_31384":73385,"_21647":122636,"_5":14929,"_28559":122334,"_3075":122637},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3699":73495,"_31384":73385,"_21647":122639,"_5":14929,"_28559":122334,"_3075":122640},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3699":73496,"_31384":73385,"_21647":122642,"_5":14929,"_28559":122334,"_3075":122643},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3699":73497,"_31384":73385,"_21647":122645,"_5":14929,"_28559":122338,"_3075":122646},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3699":73498,"_31384":73385,"_21647":122648,"_5":14929,"_28559":122338,"_3075":122649},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3699":73499,"_31384":73385,"_21647":122651,"_5":14929,"_28559":122338,"_3075":122652},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3699":73500,"_31384":73385,"_21647":122654,"_5":14929,"_28559":122338,"_3075":122655},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3699":73501,"_31384":73385,"_21647":122657,"_5":14929,"_28559":122338,"_3075":122658},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3699":73502,"_31384":73385,"_21647":122660,"_5":14929,"_28559":122338,"_3075":122661},[],"Ten en cuenta que:",{"_3699":73503,"_31384":73385,"_21647":122663,"_5":14929,"_28559":122338,"_3075":122664},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3699":73504,"_31384":73385,"_21647":122666,"_5":14929,"_28559":122338,"_3075":122667},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3699":73505,"_31384":73385,"_21647":122669,"_5":14929,"_28559":122338,"_3075":122670},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3699":73506,"_31384":73385,"_21647":122672,"_5":14929,"_28559":122342,"_3075":122673},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3699":73507,"_31384":73385,"_21647":122675,"_5":14929,"_28559":122342,"_3075":122676},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3699":73508,"_31384":73385,"_21647":122678,"_5":14929,"_28559":122342,"_3075":122679},[],"acceso completo y de solo lectura a KMS;",{"_3699":73509,"_31384":73385,"_21647":122681,"_5":14929,"_28559":122342,"_3075":122682},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3699":73510,"_31384":73385,"_21647":122684,"_5":14929,"_28559":122342,"_3075":122685},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3699":73511,"_31384":73385,"_21647":122687,"_5":14929,"_28559":122342,"_3075":122688},[],"acceso a la interfaz;",{"_3699":73512,"_31384":73385,"_21647":122690,"_5":14929,"_28559":122342,"_3075":122691},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3699":73513,"_31384":73385,"_21647":122693,"_5":14929,"_28559":122342,"_3075":122694},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3699":73514,"_31384":73385,"_21647":122696,"_5":14929,"_28559":122342,"_3075":122697},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3699":73515,"_31384":73385,"_21647":122699,"_5":14929,"_28559":122342,"_3075":122700},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3699":73516,"_31384":73385,"_21647":122702,"_5":14929,"_28559":122342,"_3075":122703},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3699":73517,"_31384":73385,"_21647":122705,"_5":14929,"_28559":122346,"_3075":122706},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3699":73518,"_31384":73385,"_21647":122708,"_5":14929,"_28559":122346,"_3075":122709},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3699":73519,"_31384":73385,"_21647":122711,"_5":14929,"_28559":122346,"_3075":122712},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3699":73520,"_31384":73385,"_21647":122714,"_5":14929,"_28559":122349,"_3075":122715},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3699":73521,"_31384":73385,"_21647":122717,"_5":14929,"_28559":122353,"_3075":122718},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3699":73522,"_31384":73385,"_21647":122720,"_5":14929,"_28559":122353,"_3075":122721},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3699":73523,"_31384":73385,"_21647":122723,"_5":14929,"_28559":122357,"_3075":122724},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3699":73524,"_31384":73385,"_21647":122726,"_5":14929,"_28559":122361,"_3075":122727},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3699":73525,"_31384":73385,"_21647":122729,"_5":14929,"_28559":122365,"_3075":122730},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3699":73526,"_31384":73385,"_21647":122732,"_5":14929,"_28559":122369,"_3075":122733},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3699":73527,"_31384":73385,"_21647":122735,"_5":14929,"_28559":122369,"_3075":122736},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3699":73528,"_31384":73385,"_21647":122738,"_5":14929,"_28559":122373,"_3075":122739},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3699":73529,"_31384":73385,"_21647":122741,"_5":14929,"_28559":122373,"_3075":122742},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3699":73530,"_31384":73385,"_21647":122744,"_5":14929,"_28559":122373,"_3075":122745},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3699":73531,"_31384":73385,"_21647":122747,"_5":14929,"_28559":122373,"_3075":122748},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3699":73532,"_31384":73385,"_21647":122750,"_5":14929,"_28559":122373,"_3075":122751},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3699":73533,"_31384":73385,"_21647":122753,"_5":14929,"_28559":122373,"_3075":122754},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3699":73534,"_31384":73385,"_21647":122756,"_5":14929,"_28559":122373,"_3075":122757},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3699":73535,"_31384":73385,"_21647":122759,"_5":14929,"_28559":122373,"_3075":122760},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3699":73536,"_31384":73385,"_21647":122762,"_5":14929,"_28559":122377,"_3075":122763},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3699":73537,"_31384":73385,"_21647":122765,"_5":14929,"_28559":122377,"_3075":122766},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3699":73538,"_31384":73385,"_21647":122768,"_5":14929,"_28559":122377,"_3075":122769},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3699":73539,"_31384":73385,"_21647":122771,"_5":14929,"_28559":122381,"_3075":122772},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3699":73540,"_31384":73385,"_21647":122774,"_5":14929,"_28559":122381,"_3075":122775},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3699":73541,"_31384":73385,"_21647":122777,"_5":14929,"_28559":122381,"_3075":122778},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3699":73542,"_31384":73385,"_21647":122780,"_5":14929,"_28559":122381,"_3075":122781},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3699":73543,"_31384":73385,"_21647":122783,"_5":14929,"_28559":122381,"_3075":122784},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3699":73544,"_31384":73385,"_21647":122786,"_5":14929,"_28559":122381,"_3075":122787},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3699":73545,"_31384":73385,"_21647":122789,"_5":14929,"_28559":122381,"_3075":122790},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3699":73546,"_31384":73385,"_21647":122792,"_5":14929,"_28559":122381,"_3075":122793},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3699":73547,"_31384":73385,"_21647":122795,"_5":14929,"_28559":122389,"_3075":122796},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3699":73548,"_31384":73385,"_21647":122798,"_5":14929,"_28559":122393,"_3075":122799},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3699":73549,"_31384":73385,"_21647":122801,"_5":14929,"_28559":122393,"_3075":122802},[],"que exista un principal activo del tipo correcto;",{"_3699":73550,"_31384":73385,"_21647":122804,"_5":14929,"_28559":122393,"_3075":122805},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3699":73551,"_31384":73385,"_21647":122807,"_5":14929,"_28559":122393,"_3075":122808},[],"que todas las condiciones del principal se cumplan;",{"_3699":73552,"_31384":73385,"_21647":122810,"_5":14929,"_28559":122393,"_3075":122811},[],"que el principal tenga concedida la política esperada;",{"_3699":73553,"_31384":73385,"_21647":122813,"_5":14929,"_28559":122393,"_3075":122814},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3699":73554,"_31384":73385,"_21647":122816,"_5":14929,"_28559":122393,"_3075":122817},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3699":73555,"_31384":73385,"_21647":122819,"_5":14929,"_28559":122393,"_3075":122820},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3699":73556,"_31384":73385,"_21647":122822,"_5":14929,"_28559":122393,"_3075":122823},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3699":73557,"_31384":73385,"_21647":122825,"_5":14929,"_28559":122397,"_3075":122826},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3699":73558,"_31384":73385,"_21647":122828,"_5":14929,"_28559":122401,"_3075":122829},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3699":73559,"_31384":73385,"_21647":122831,"_5":14929,"_28559":122405,"_3075":122832},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3699":73560,"_31384":73385,"_21647":122834,"_5":14929,"_28559":122405,"_3075":122835},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3699":73561,"_31384":73561,"_5":15283,"_3075":122837,"_31709":122838,"_21647":122839,"_28559":73561},"Alertas y suscripciones",[51094,122172,122173],[],{"_3699":73562,"_31384":73561,"_21647":122841,"_5":14929,"_28559":73561,"_3075":122842},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3699":73563,"_31384":73561,"_5":31706,"_21647":122844,"_28559":122845,"_3075":122846},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3699":73564,"_31384":73561,"_5":31706,"_21647":122848,"_28559":122849,"_3075":122850},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3699":73565,"_31384":73561,"_5":31706,"_21647":122852,"_28559":122853,"_3075":122854},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3699":73566,"_31384":73561,"_5":31706,"_21647":122856,"_28559":122857,"_3075":122858},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3699":73567,"_31384":73561,"_5":31706,"_21647":122860,"_28559":122861,"_3075":122862},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3699":73568,"_31384":73561,"_5":31706,"_21647":122864,"_28559":122865,"_3075":122866},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3699":73569,"_31384":73561,"_5":31706,"_21647":122868,"_28559":122869,"_3075":122870},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3699":73570,"_31384":73561,"_5":31706,"_21647":122872,"_28559":122873,"_3075":122874},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3699":73571,"_31384":73561,"_5":31706,"_21647":122876,"_28559":122877,"_3075":122878},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3699":73572,"_31384":73561,"_5":31706,"_21647":122880,"_28559":122881,"_3075":122882},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3699":73573,"_31384":73561,"_5":31706,"_21647":122884,"_28559":122885,"_3075":122886},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3699":73574,"_31384":73561,"_21647":122888,"_5":14929,"_28559":73561,"_3075":122889},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3699":73575,"_31384":73561,"_21647":122891,"_5":14929,"_28559":122845,"_3075":122892},[],"Un servicio publica un evento de dominio.",{"_3699":73576,"_31384":73561,"_21647":122894,"_5":14929,"_28559":122845,"_3075":122895},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3699":73577,"_31384":73561,"_21647":122897,"_5":14929,"_28559":122845,"_3075":122898},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3699":73578,"_31384":73561,"_21647":122900,"_5":14929,"_28559":122845,"_3075":122901},[],"Lamassu entrega el evento al canal configurado.",{"_3699":73579,"_31384":73561,"_21647":122903,"_5":14929,"_28559":122845,"_3075":122904},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3699":73580,"_31384":73561,"_21647":122906,"_5":14929,"_28559":122849,"_3075":122907},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3699":73581,"_31384":73561,"_21647":122909,"_5":14929,"_28559":122849,"_3075":122910},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3699":73582,"_31384":73561,"_21647":122912,"_5":14929,"_28559":122849,"_3075":122913},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3699":73583,"_31384":73561,"_21647":122915,"_5":14929,"_28559":122849,"_3075":122916},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3699":73584,"_31384":73561,"_21647":122918,"_5":14929,"_28559":122849,"_3075":122919},[],"`apikey_options` necesita `header` y `key`.",{"_3699":73585,"_31384":73561,"_21647":122921,"_5":14929,"_28559":122849,"_3075":122922},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3699":73586,"_31384":73561,"_21647":122924,"_5":14929,"_28559":122849,"_3075":122925},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3699":73587,"_31384":73561,"_21647":122927,"_5":14929,"_28559":122849,"_3075":122928},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3699":73588,"_31384":73561,"_21647":122930,"_5":14929,"_28559":122857,"_3075":122931},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3699":73589,"_31384":73561,"_21647":122933,"_5":14929,"_28559":122861,"_3075":122934},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3699":73590,"_31384":73561,"_21647":122936,"_5":14929,"_28559":122865,"_3075":122937},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3699":73591,"_31384":73561,"_21647":122939,"_5":14929,"_28559":122865,"_3075":122940},[],"**None** notifica todas las instancias del evento.",{"_3699":73592,"_31384":73561,"_21647":122942,"_5":14929,"_28559":122865,"_3075":122943},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3699":73593,"_31384":73561,"_21647":122945,"_5":14929,"_28559":122865,"_3075":122946},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3699":73594,"_31384":73561,"_21647":122948,"_5":14929,"_28559":122865,"_3075":122949},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3699":73595,"_31384":73561,"_21647":122951,"_5":14929,"_28559":122865,"_3075":122952},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3699":73596,"_31384":73561,"_21647":122954,"_5":14929,"_28559":122865,"_3075":122955},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3699":73597,"_31384":73561,"_21647":122957,"_5":14929,"_28559":122869,"_3075":122958},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3699":73598,"_31384":73561,"_21647":122960,"_5":14929,"_28559":122873,"_3075":122961},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3699":73599,"_31384":73561,"_21647":122963,"_5":14929,"_28559":122873,"_3075":122964},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3699":73600,"_31384":73561,"_21647":122966,"_5":14929,"_28559":122873,"_3075":122967},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3699":73601,"_31384":73561,"_21647":122969,"_5":14929,"_28559":122873,"_3075":122970},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3699":73602,"_31384":73561,"_21647":122972,"_5":14929,"_28559":122873,"_3075":122973},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3699":73603,"_31384":73561,"_21647":122975,"_5":14929,"_28559":122873,"_3075":122976},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3699":73604,"_31384":73561,"_21647":122978,"_5":14929,"_28559":122873,"_3075":122979},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3699":73605,"_31384":73561,"_21647":122981,"_5":14929,"_28559":122873,"_3075":122982},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3699":73606,"_31384":73561,"_21647":122984,"_5":14929,"_28559":122877,"_3075":122985},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3699":73607,"_31384":73561,"_21647":122987,"_5":14929,"_28559":122877,"_3075":122988},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3699":73608,"_31384":73561,"_21647":122990,"_5":14929,"_28559":122877,"_3075":122991},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3699":73609,"_31384":73561,"_21647":122993,"_5":14929,"_28559":122877,"_3075":122994},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3699":73610,"_31384":73561,"_21647":122996,"_5":14929,"_28559":122877,"_3075":122997},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3699":73611,"_31384":73561,"_21647":122999,"_5":14929,"_28559":122877,"_3075":123000},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3699":73612,"_31384":73561,"_21647":123002,"_5":14929,"_28559":122877,"_3075":123003},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3699":73613,"_31384":73561,"_21647":123005,"_5":14929,"_28559":122877,"_3075":123006},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3699":73614,"_31384":73561,"_21647":123008,"_5":14929,"_28559":122881,"_3075":123009},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3699":73615,"_31384":73561,"_21647":123011,"_5":14929,"_28559":122881,"_3075":123012},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3699":73616,"_31384":73561,"_21647":123014,"_5":14929,"_28559":122885,"_3075":123015},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3699":73617,"_31384":73561,"_21647":123017,"_5":14929,"_28559":122885,"_3075":123018},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3699":73618,"_31384":73561,"_21647":123020,"_5":14929,"_28559":122885,"_3075":123021},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3699":73619,"_31384":73561,"_21647":123023,"_5":14929,"_28559":122885,"_3075":123024},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3699":73620,"_31384":73561,"_21647":123026,"_5":14929,"_28559":122885,"_3075":123027},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3699":73621,"_31384":73561,"_21647":123029,"_5":14929,"_28559":122885,"_3075":123030},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3699":73622,"_31384":73561,"_21647":123032,"_5":14929,"_28559":122885,"_3075":123033},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3699":73623,"_31384":73561,"_21647":123035,"_5":14929,"_28559":122885,"_3075":123036},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3699":73624,"_31384":73561,"_21647":123038,"_5":14929,"_28559":122885,"_3075":123039},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3699":73625,"_31384":73561,"_21647":123041,"_5":14929,"_28559":122885,"_3075":123042},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3699":73626,"_31384":73626,"_5":15283,"_3075":123044,"_31709":123045,"_21647":123046,"_28559":73626},"Registros de auditoría",[51094,122172,122173],[],{"_3699":73627,"_31384":73626,"_21647":123048,"_5":14929,"_28559":73626,"_3075":123049},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3699":73628,"_31384":73626,"_5":31706,"_21647":123051,"_28559":123052,"_3075":123053},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3699":73629,"_31384":73626,"_5":31706,"_21647":123055,"_28559":123056,"_3075":123057},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3699":73630,"_31384":73626,"_5":31706,"_21647":123059,"_28559":123060,"_3075":123061},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3699":73631,"_31384":73626,"_5":31706,"_21647":123063,"_28559":123064,"_3075":123065},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3699":73632,"_31384":73626,"_5":31706,"_21647":123067,"_28559":123068,"_3075":123069},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3699":73633,"_31384":73626,"_5":31706,"_21647":123071,"_28559":123072,"_3075":123073},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3699":73634,"_31384":73626,"_5":31706,"_21647":123075,"_28559":123076,"_3075":123077},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3699":73635,"_31384":73626,"_5":31706,"_21647":123079,"_28559":123080,"_3075":123081},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3699":73636,"_31384":73626,"_5":31706,"_21647":123083,"_28559":123084,"_3075":123085},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3699":73637,"_31384":73626,"_5":31706,"_21647":123087,"_28559":123088,"_3075":123089},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3699":73638,"_31384":73626,"_5":31706,"_21647":123091,"_28559":123092,"_3075":123093},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3699":73639,"_31384":73626,"_21647":123095,"_5":14929,"_28559":73626,"_3075":123096},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3699":73640,"_31384":73626,"_21647":123098,"_5":14929,"_28559":123052,"_3075":123099},[],"El cuerpo de auditoría incluye:",{"_3699":73641,"_31384":73626,"_21647":123101,"_5":14929,"_28559":123052,"_3075":123102},[],"input: datos recibidos por la operación;",{"_3699":73642,"_31384":73626,"_21647":123104,"_5":14929,"_28559":123052,"_3075":123105},[],"has\\_error: indica si el servicio devolvió un error;",{"_3699":73643,"_31384":73626,"_21647":123107,"_5":14929,"_28559":123052,"_3075":123108},[],"output: resultado producido o mensaje de error;",{"_3699":73644,"_31384":73626,"_21647":123110,"_5":14929,"_28559":123052,"_3075":123111},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3699":73645,"_31384":73626,"_21647":123113,"_5":14929,"_28559":123052,"_3075":123114},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3699":73646,"_31384":73626,"_21647":123116,"_5":14929,"_28559":123052,"_3075":123117},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3699":73647,"_31384":73626,"_21647":123119,"_5":14929,"_28559":123056,"_3075":123120},[],"El backend aplica auditoría a mutaciones de:",{"_3699":73648,"_31384":73626,"_21647":123122,"_5":14929,"_28559":123056,"_3075":123123},[],"autoridades, certificados y perfiles de emisión;",{"_3699":73649,"_31384":73626,"_21647":123125,"_5":14929,"_28559":123056,"_3075":123126},[],"claves y motores KMS;",{"_3699":73650,"_31384":73626,"_21647":123128,"_5":14929,"_28559":123056,"_3075":123129},[],"dispositivos e identidades;",{"_3699":73651,"_31384":73626,"_21647":123131,"_5":14929,"_28559":123056,"_3075":123132},[],"DMS y operaciones de enrolamiento;",{"_3699":73652,"_31384":73626,"_21647":123134,"_5":14929,"_28559":123056,"_3075":123135},[],"funciones de validación y CRL;",{"_3699":73653,"_31384":73626,"_21647":123137,"_5":14929,"_28559":123056,"_3075":123138},[],"principales, políticas y concesiones de autorización.",{"_3699":73654,"_31384":73626,"_21647":123140,"_5":14929,"_28559":123056,"_3075":123141},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3699":73655,"_31384":73626,"_21647":123143,"_5":14929,"_28559":123060,"_3075":123144},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3699":73656,"_31384":73626,"_21647":123146,"_5":14929,"_28559":123060,"_3075":123147},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3699":73657,"_31384":73626,"_21647":123149,"_5":14929,"_28559":123060,"_3075":123150},[],"Diseña el consumidor para:",{"_3699":73658,"_31384":73626,"_21647":123152,"_5":14929,"_28559":123060,"_3075":123153},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3699":73659,"_31384":73626,"_21647":123155,"_5":14929,"_28559":123060,"_3075":123156},[],"conservar el CloudEvent completo sin modificar;",{"_3699":73660,"_31384":73626,"_21647":123158,"_5":14929,"_28559":123060,"_3075":123159},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3699":73661,"_31384":73626,"_21647":123161,"_5":14929,"_28559":123060,"_3075":123162},[],"cifrar en tránsito y en reposo;",{"_3699":73662,"_31384":73626,"_21647":123164,"_5":14929,"_28559":123060,"_3075":123165},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3699":73663,"_31384":73626,"_21647":123167,"_5":14929,"_28559":123060,"_3075":123168},[],"aplicar una política explícita de retención y legal hold;",{"_3699":73664,"_31384":73626,"_21647":123170,"_5":14929,"_28559":123060,"_3075":123171},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3699":73665,"_31384":73626,"_21647":123173,"_5":14929,"_28559":123064,"_3075":123174},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3699":73666,"_31384":73626,"_21647":123176,"_5":14929,"_28559":123064,"_3075":123177},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3699":73667,"_31384":73626,"_21647":123179,"_5":14929,"_28559":123072,"_3075":123180},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3699":73668,"_31384":73626,"_21647":123182,"_5":14929,"_28559":123076,"_3075":123183},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3699":73669,"_31384":73626,"_21647":123185,"_5":14929,"_28559":123080,"_3075":123186},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3699":73670,"_31384":73626,"_21647":123188,"_5":14929,"_28559":123084,"_3075":123189},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3699":73671,"_31384":73626,"_21647":123191,"_5":14929,"_28559":123088,"_3075":123192},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3699":73672,"_31384":73626,"_21647":123194,"_5":14929,"_28559":123092,"_3075":123195},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3699":73673,"_31384":73626,"_21647":123197,"_5":14929,"_28559":123092,"_3075":123198},[],"aparece un evento de auditoría correcto;",{"_3699":73674,"_31384":73626,"_21647":123200,"_5":14929,"_28559":123092,"_3075":123201},[],"el principal coincide con la identidad utilizada;",{"_3699":73675,"_31384":73626,"_21647":123203,"_5":14929,"_28559":123092,"_3075":123204},[],"el consumidor lo persiste una sola vez;",{"_3699":73676,"_31384":73626,"_21647":123206,"_5":14929,"_28559":123092,"_3075":123207},[],"puede recuperarse por recurso, actor y periodo;",{"_3699":73677,"_31384":73626,"_21647":123209,"_5":14929,"_28559":123092,"_3075":123210},[],"una interrupción del consumidor produce una alerta.",{"_3699":73678,"_31384":73626,"_21647":123212,"_5":14929,"_28559":123092,"_3075":123213},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3699":73679,"_31384":73679,"_5":15283,"_3075":123215,"_31709":123216,"_21647":123217,"_28559":73679},"Arquitectura de la plataforma",[51094,122172],[],{"_3699":73680,"_31384":73679,"_21647":123219,"_5":14929,"_28559":73679,"_3075":123220},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3699":73681,"_31384":73679,"_5":31706,"_21647":123222,"_28559":123223,"_3075":123224},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3699":73682,"_31384":73679,"_5":31706,"_21647":123226,"_28559":123227,"_3075":123228},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3699":73683,"_31384":73679,"_5":31706,"_21647":123230,"_28559":123231,"_3075":123232},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3699":73684,"_31384":73679,"_5":31706,"_21647":123234,"_28559":123235,"_3075":123236},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3699":73685,"_31384":73679,"_5":31706,"_21647":123238,"_28559":123239,"_3075":123240},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3699":73686,"_31384":73679,"_21647":123242,"_5":14929,"_28559":73679,"_3075":123243},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3699":73687,"_31384":73679,"_21647":123245,"_5":14929,"_28559":73679,"_3075":123246},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3699":73688,"_31384":73679,"_21647":123248,"_5":14929,"_28559":123223,"_3075":123249},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3699":73689,"_31384":73679,"_21647":123251,"_5":14929,"_28559":123227,"_3075":123252},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3699":73690,"_31384":73679,"_21647":123254,"_5":14929,"_28559":123231,"_3075":123255},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3699":73691,"_31384":73679,"_21647":123257,"_5":14929,"_28559":123235,"_3075":123258},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3699":73692,"_31384":73679,"_21647":123260,"_5":14929,"_28559":123239,"_3075":123261},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3699":73693,"_31384":73693,"_5":15283,"_3075":123263,"_31709":123264,"_21647":123265,"_28559":73693},"Cómo funciona Lamassu",[51094,122172],[],{"_3699":73694,"_31384":73693,"_21647":123267,"_5":14929,"_28559":73693,"_3075":123268},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3699":73695,"_31384":73693,"_5":31706,"_21647":123270,"_28559":123271,"_3075":123272},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3699":73696,"_31384":73693,"_5":31706,"_21647":123274,"_28559":123275,"_3075":123276},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3699":73697,"_31384":73693,"_21647":123278,"_5":14929,"_28559":73693,"_3075":123279},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3699":73698,"_31384":73693,"_21647":123281,"_5":14929,"_28559":123271,"_3075":123282},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3699":73699,"_31384":73693,"_21647":123284,"_5":14929,"_28559":123271,"_3075":123285},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3699":73700,"_31384":73693,"_21647":123287,"_5":14929,"_28559":123271,"_3075":123288},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3699":73701,"_31384":73693,"_21647":123290,"_5":14929,"_28559":123271,"_3075":123291},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3699":73702,"_31384":73693,"_21647":123293,"_5":14929,"_28559":123271,"_3075":123294},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3699":73703,"_31384":73693,"_21647":123296,"_5":14929,"_28559":123275,"_3075":123297},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3699":73704,"_31384":73693,"_21647":123299,"_5":14929,"_28559":123275,"_3075":123300},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3699":73705,"_31384":73693,"_21647":123302,"_5":14929,"_28559":123275,"_3075":123303},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3699":73706,"_31384":73693,"_21647":123305,"_5":14929,"_28559":123275,"_3075":123306},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3699":73707,"_31384":73693,"_21647":123308,"_5":14929,"_28559":123275,"_3075":123309},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3699":73708,"_31384":73693,"_21647":123311,"_5":14929,"_28559":123275,"_3075":123312},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3699":73709,"_31384":73693,"_21647":123314,"_5":14929,"_28559":123275,"_3075":123315},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3699":73710,"_31384":73710,"_5":15283,"_3075":123317,"_31709":123318,"_21647":123319,"_28559":73710},"Dispositivos e identidades",[51094,122172,53807,123317],[],{"_3699":73711,"_31384":73710,"_21647":123321,"_5":14929,"_28559":73710,"_3075":123322},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3699":73712,"_31384":73710,"_5":31706,"_21647":123324,"_28559":123325,"_3075":123326},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3699":73713,"_31384":73710,"_5":31706,"_21647":123328,"_28559":123329,"_3075":123330},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3699":73714,"_31384":73710,"_5":31706,"_21647":123332,"_28559":123333,"_3075":123334},[],"/docs/es/platform/iot-fleets/device-management#api-de-eventos-y-flujo-en-vivo","API de eventos y flujo en vivo",{"_3699":73715,"_31384":73710,"_5":31706,"_21647":123336,"_28559":123337,"_3075":123338},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3699":73716,"_31384":73710,"_5":31706,"_21647":123340,"_28559":123341,"_3075":123342},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3699":73717,"_31384":73710,"_5":31706,"_21647":123344,"_28559":123345,"_3075":123346},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3699":73718,"_31384":73710,"_5":31706,"_21647":123348,"_28559":123349,"_3075":123350},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3699":73719,"_31384":73710,"_5":31706,"_21647":123352,"_28559":123353,"_3075":123354},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3699":73720,"_31384":73710,"_5":31706,"_21647":123356,"_28559":123357,"_3075":123358},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3699":73721,"_31384":73710,"_5":31706,"_21647":123360,"_28559":123361,"_3075":123362},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3699":73722,"_31384":73710,"_5":31706,"_21647":123364,"_28559":123365,"_3075":123366},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3699":73723,"_31384":73710,"_5":31706,"_21647":123368,"_28559":123369,"_3075":123370},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3699":73724,"_31384":73710,"_21647":123372,"_5":14929,"_28559":73710,"_3075":123373},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3699":73725,"_31384":73710,"_21647":123375,"_5":14929,"_28559":73710,"_3075":123376},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3699":73726,"_31384":73710,"_21647":123378,"_5":14929,"_28559":123325,"_3075":123379},[],"Vista operativa",{"_3699":73727,"_31384":73710,"_21647":123381,"_5":14929,"_28559":123325,"_3075":123382},[],"Interpretación",{"_3699":73728,"_31384":73710,"_21647":123384,"_5":14929,"_28559":123325,"_3075":53874},[],{"_3699":73729,"_31384":73710,"_21647":123386,"_5":14929,"_28559":123325,"_3075":123387},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3699":73730,"_31384":73710,"_21647":123389,"_5":14929,"_28559":123325,"_3075":53880},[],{"_3699":73731,"_31384":73710,"_21647":123391,"_5":14929,"_28559":123325,"_3075":123392},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3699":73732,"_31384":73710,"_21647":123394,"_5":14929,"_28559":123325,"_3075":53886},[],{"_3699":73733,"_31384":73710,"_21647":123396,"_5":14929,"_28559":123325,"_3075":123397},[],"La identidad está en la ventana operativa de renovación.",{"_3699":73734,"_31384":73710,"_21647":123399,"_5":14929,"_28559":123325,"_3075":53892},[],{"_3699":73735,"_31384":73710,"_21647":123401,"_5":14929,"_28559":123325,"_3075":123402},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3699":73736,"_31384":73710,"_21647":123404,"_5":14929,"_28559":123325,"_3075":53898},[],{"_3699":73737,"_31384":73710,"_21647":123406,"_5":14929,"_28559":123325,"_3075":123407},[],"La identidad ha vencido.",{"_3699":73738,"_31384":73710,"_21647":123409,"_5":14929,"_28559":123325,"_3075":53904},[],{"_3699":73739,"_31384":73710,"_21647":123411,"_5":14929,"_28559":123325,"_3075":123412},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3699":73740,"_31384":73710,"_21647":123414,"_5":14929,"_28559":123325,"_3075":53910},[],{"_3699":73741,"_31384":73710,"_21647":123416,"_5":14929,"_28559":123325,"_3075":123417},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3699":73742,"_31384":73710,"_21647":123419,"_5":14929,"_28559":123325,"_3075":123420},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3699":73743,"_31384":73710,"_21647":123422,"_5":14929,"_28559":123329,"_3075":123423},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3699":73744,"_31384":73710,"_21647":123425,"_5":14929,"_28559":123329,"_3075":123426},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3699":73745,"_31384":73710,"_21647":123428,"_5":14929,"_28559":123329,"_3075":123429},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. En el modo **Live**, sigue automáticamente los eventos nuevos y los cambios del dispositivo (como el estado o el propietario) sin recargar la página, y muestra un indicador **Connected** o **Disconnected**. Tras una interrupción se reconecta y recupera sin huecos ni duplicados, de modo que **Live** muestra el mismo contenido que una recarga de la página. Cuando las actualizaciones en vivo no pueden usarse — falta de permisos, dispositivo no encontrado o actualizaciones en vivo no habilitadas en el servidor —, la línea de tiempo muestra `Live updates unavailable: ...` con el motivo, y la navegación por el historial (**Load more**) sigue funcionando. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3699":73746,"_31384":73710,"_21647":123431,"_5":14929,"_28559":123329,"_3075":123432},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3699":73747,"_31384":73710,"_21647":123434,"_5":14929,"_28559":123333,"_3075":123435},[],"`GET /v1/devices/:id/events` consulta los eventos de un dispositivo y `POST /v1/devices/:id/events` crea uno.",{"_3699":73748,"_31384":73710,"_21647":123437,"_5":14929,"_28559":123333,"_3075":123438},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. La entrega es de tipo best effort: los eventos emitidos mientras no hay ningún cliente conectado no se reenvían en la siguiente conexión. El servidor cierra cada stream tras un tiempo de vida máximo, 10 minutos por omisión y configurable con la opción `sse_max_stream_duration` de Device Manager, y el cliente se reconecta para seguir recibiendo eventos. Cuando una instancia alcanza su límite de suscriptores, configurado con la opción `sse_max_subscribers` de Device Manager (1000 por omisión y compartido por todos los streams de la instancia), los nuevos streams reciben una respuesta `503` con una cabecera `Retry-After`. Cada stream vuelve a comprobar el permiso de lectura del dispositivo mientras está activo, y lo cierra cuando el permiso se revoca o no se puede verificar; la reconexión vuelve a pasar por las comprobaciones de autorización habituales. En un despliegue con Helm, define `services.deviceManager.sseEnabled` como `false` para deshabilitar SSE (por defecto `true`); consulta Flujo de eventos de dispositivo (SSE).",{"_3699":73749,"_31384":73710,"_21647":123440,"_5":14929,"_28559":123333,"_3075":123441},[],"En AMQP, cada instancia de Device Manager enlaza una cola de suscriptores con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. La cola es duradera y auto-delete, con una expiración de una hora (`x-expires`), de modo que el broker la elimina cuando la instancia se detiene o su conexión muere, y no hace falta ninguna política de limpieza. Solo en proveedores de event bus sin soporte de suscriptores efímeros puede quedar una cola duradera por proceso tras detenerse su instancia; revisa esos proveedores si observas colas residuales.",{"_3699":73750,"_31384":73710,"_21647":123443,"_5":14929,"_28559":123337,"_3075":123444},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3699":73751,"_31384":73710,"_21647":123446,"_5":14929,"_28559":123341,"_3075":123447},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3699":73752,"_31384":73710,"_21647":123449,"_5":14929,"_28559":123345,"_3075":123450},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3699":73753,"_31384":73710,"_21647":123452,"_5":14929,"_28559":123349,"_3075":123453},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3699":73754,"_31384":73710,"_21647":123455,"_5":14929,"_28559":123353,"_3075":123456},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3699":73755,"_31384":73710,"_21647":123458,"_5":14929,"_28559":123353,"_3075":123459},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3699":73756,"_31384":73710,"_21647":123461,"_5":14929,"_28559":123357,"_3075":123462},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3699":73757,"_31384":73710,"_21647":123464,"_5":14929,"_28559":123357,"_3075":123465},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3699":73758,"_31384":73710,"_21647":123467,"_5":14929,"_28559":123357,"_3075":123468},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3699":73759,"_31384":73710,"_21647":123470,"_5":14929,"_28559":123357,"_3075":123471},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3699":73760,"_31384":73710,"_21647":123473,"_5":14929,"_28559":123357,"_3075":123474},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3699":73761,"_31384":73710,"_21647":123476,"_5":14929,"_28559":123357,"_3075":123477},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3699":73762,"_31384":73710,"_21647":123479,"_5":14929,"_28559":123361,"_3075":123480},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3699":73763,"_31384":73710,"_21647":123482,"_5":14929,"_28559":123361,"_3075":123483},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3699":73764,"_31384":73710,"_21647":123485,"_5":14929,"_28559":123361,"_3075":123486},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3699":73765,"_31384":73710,"_21647":123488,"_5":14929,"_28559":123365,"_3075":123489},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3699":73766,"_31384":73710,"_21647":123491,"_5":14929,"_28559":123365,"_3075":123492},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3699":73767,"_31384":73710,"_21647":123494,"_5":14929,"_28559":123365,"_3075":123495},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3699":73768,"_31384":73710,"_21647":123497,"_5":14929,"_28559":123365,"_3075":123498},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3699":73769,"_31384":73710,"_21647":123500,"_5":14929,"_28559":123369,"_3075":123501},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3699":73770,"_31384":73710,"_21647":123503,"_5":14929,"_28559":123369,"_3075":123504},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/est/configuration\" />",{"_3699":73771,"_31384":73771,"_5":15283,"_3075":123506,"_31709":123507,"_21647":123509,"_28559":73771},"Configura y opera el DMS",[51094,122172,53807,123317,123508],"Enrolamiento con PKI",[],{"_3699":73772,"_31384":73771,"_21647":123511,"_5":14929,"_28559":73771,"_3075":123512},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3699":73773,"_31384":73771,"_5":31706,"_21647":123514,"_28559":123515,"_3075":120677},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3699":73774,"_31384":73771,"_5":31706,"_21647":123517,"_28559":123518,"_3075":123519},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3699":73775,"_31384":73771,"_5":31706,"_21647":123521,"_28559":123522,"_3075":123523},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3699":73776,"_31384":73771,"_5":31706,"_21647":123525,"_28559":123526,"_3075":123527},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3699":73777,"_31384":73771,"_5":31706,"_21647":123529,"_28559":123530,"_3075":123531},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3699":73778,"_31384":73771,"_5":31706,"_21647":123533,"_28559":123534,"_3075":123535},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3699":73779,"_31384":73771,"_5":31706,"_21647":123537,"_28559":123538,"_3075":123539},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3699":73780,"_31384":73771,"_5":31706,"_21647":123541,"_28559":123542,"_3075":123543},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-del-protocolo","Configuración del protocolo",{"_3699":73781,"_31384":73771,"_5":31706,"_21647":123545,"_28559":123546,"_3075":123547},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3699":73782,"_31384":73771,"_5":31706,"_21647":123549,"_28559":123550,"_3075":123551},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3699":73783,"_31384":73771,"_21647":123553,"_5":14929,"_28559":73771,"_3075":123554},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3699":73784,"_31384":73771,"_21647":123556,"_5":14929,"_28559":123515,"_3075":123557},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3699":73785,"_31384":73771,"_21647":123559,"_5":14929,"_28559":123515,"_3075":123560},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3699":73786,"_31384":73771,"_21647":123562,"_5":14929,"_28559":123522,"_3075":123563},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3699":73787,"_31384":73771,"_21647":123565,"_5":14929,"_28559":123526,"_3075":123566},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3699":73788,"_31384":73771,"_21647":123568,"_5":14929,"_28559":123530,"_3075":123569},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3699":73789,"_31384":73771,"_21647":123571,"_5":14929,"_28559":123534,"_3075":123572},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3699":73790,"_31384":73771,"_21647":123574,"_5":14929,"_28559":123538,"_3075":123575},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3699":73791,"_31384":73771,"_21647":123577,"_5":14929,"_28559":123542,"_3075":123578},[],"Consulta Configuración de EST en el DMS para definir registro, autenticación, emisión, renovación, generación de claves y distribución de confianza.",{"_3699":73792,"_31384":73771,"_21647":123580,"_5":14929,"_28559":123546,"_3075":123581},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3699":73793,"_31384":73771,"_21647":123583,"_5":14929,"_28559":123546,"_3075":123584},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3699":73794,"_31384":73771,"_21647":123586,"_5":14929,"_28559":123546,"_3075":123587},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3699":73795,"_31384":73771,"_21647":123589,"_5":14929,"_28559":123550,"_3075":123590},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3699":73796,"_31384":73796,"_5":15283,"_3075":123508,"_31709":123592,"_21647":123593,"_28559":73796},[51094,122172,53807,123317,123508],[],{"_3699":73797,"_31384":73796,"_21647":123595,"_5":14929,"_28559":73796,"_3075":123596},[],"Prepara la admisión, la política de registro y la emisión de certificados para los dispositivos.",{"_3699":73798,"_31384":73796,"_5":31706,"_21647":123598,"_28559":123599,"_3075":123600},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3699":73799,"_31384":73796,"_5":31706,"_21647":123602,"_28559":123603,"_3075":123604},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3699":73800,"_31384":73796,"_5":31706,"_21647":123606,"_28559":123607,"_3075":123608},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3699":73801,"_31384":73796,"_21647":123610,"_5":14929,"_28559":73796,"_3075":123611},[],"El enrolamiento con PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3699":73802,"_31384":73796,"_21647":123613,"_5":14929,"_28559":123599,"_3075":123614},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3699":73803,"_31384":73796,"_21647":123616,"_5":14929,"_28559":123599,"_3075":123617},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3699":73804,"_31384":73796,"_21647":123619,"_5":14929,"_28559":123599,"_3075":123620},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3699":73805,"_31384":73796,"_21647":123622,"_5":14929,"_28559":123599,"_3075":123623},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3699":73806,"_31384":73796,"_21647":123625,"_5":14929,"_28559":123599,"_3075":123626},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3699":73807,"_31384":73796,"_21647":123628,"_5":14929,"_28559":123599,"_3075":123629},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3699":73808,"_31384":73796,"_21647":123631,"_5":14929,"_28559":123603,"_3075":123632},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3699":73809,"_31384":73796,"_21647":123634,"_5":14929,"_28559":123603,"_3075":123635},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3699":73810,"_31384":73796,"_21647":123637,"_5":14929,"_28559":123607,"_3075":123638},[],"Consulta EST (RFC 7030) para preparar la autenticación y la confianza inicial, integrar el cliente y mantener la identidad.",{"_3699":73811,"_31384":73796,"_21647":123640,"_5":14929,"_28559":123607,"_3075":123641},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3699":73812,"_31384":73812,"_5":15283,"_3075":123643,"_31709":123644,"_21647":123645,"_28559":73812},"Estrategias de aprovisionamiento",[51094,122172,53807,123317,123508],[],{"_3699":73813,"_31384":73812,"_21647":123647,"_5":14929,"_28559":73812,"_3075":123648},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3699":73814,"_31384":73812,"_5":31706,"_21647":123650,"_28559":123651,"_3075":123652},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3699":73815,"_31384":73812,"_5":31706,"_21647":123654,"_28559":123655,"_3075":123656},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3699":73816,"_31384":73812,"_5":31706,"_21647":123658,"_28559":123659,"_3075":123660},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3699":73817,"_31384":73812,"_5":31706,"_21647":123662,"_28559":123663,"_3075":123664},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3699":73818,"_31384":73812,"_5":31706,"_21647":123666,"_28559":123667,"_3075":123668},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3699":73819,"_31384":73812,"_21647":123670,"_5":14929,"_28559":73812,"_3075":123671},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3699":73820,"_31384":73812,"_21647":123673,"_5":14929,"_28559":123651,"_3075":123674},[],"Recorrido",{"_3699":73821,"_31384":73812,"_21647":123676,"_5":14929,"_28559":123651,"_3075":123677},[],"Cuándo existe el dispositivo",{"_3699":73822,"_31384":73812,"_21647":123679,"_5":14929,"_28559":123651,"_3075":123680},[],"Qué compruebas",{"_3699":73823,"_31384":73812,"_21647":123682,"_5":14929,"_28559":123651,"_3075":123683},[],"Asignación manual",{"_3699":73824,"_31384":73812,"_21647":123685,"_5":14929,"_28559":123651,"_3075":123686},[],"El operador lo crea antes de asociar un certificado.",{"_3699":73825,"_31384":73812,"_21647":123688,"_5":14929,"_28559":123651,"_3075":123689},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3699":73826,"_31384":73812,"_21647":123691,"_5":14929,"_28559":123651,"_3075":123692},[],"EST con `JITP`",{"_3699":73827,"_31384":73812,"_21647":123694,"_5":14929,"_28559":123651,"_3075":123695},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3699":73828,"_31384":73812,"_21647":123697,"_5":14929,"_28559":123651,"_3075":123698},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3699":73829,"_31384":73812,"_21647":123700,"_5":14929,"_28559":123651,"_3075":123701},[],"EST con `PRE_REGISTRATION`",{"_3699":73830,"_31384":73812,"_21647":123703,"_5":14929,"_28559":123651,"_3075":123704},[],"Debe existir antes de `/simpleenroll`.",{"_3699":73831,"_31384":73812,"_21647":123706,"_5":14929,"_28559":123651,"_3075":123707},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3699":73832,"_31384":73812,"_21647":123709,"_5":14929,"_28559":123651,"_3075":123710},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3699":73833,"_31384":73812,"_21647":123712,"_5":14929,"_28559":123651,"_3075":123713},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3699":73834,"_31384":73812,"_21647":123715,"_5":14929,"_28559":123655,"_3075":123716},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3699":73835,"_31384":73812,"_21647":123718,"_5":14929,"_28559":123655,"_3075":123719},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3699":73836,"_31384":73812,"_21647":123721,"_5":14929,"_28559":123655,"_3075":123722},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3699":73837,"_31384":73812,"_21647":123724,"_5":14929,"_28559":123659,"_3075":123725},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3699":73838,"_31384":73812,"_21647":123727,"_5":14929,"_28559":123659,"_3075":123728},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3699":73839,"_31384":73812,"_21647":123730,"_5":14929,"_28559":123659,"_3075":123731},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3699":73840,"_31384":73812,"_21647":123733,"_5":14929,"_28559":123659,"_3075":123734},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3699":73841,"_31384":73812,"_21647":123736,"_5":14929,"_28559":123659,"_3075":123737},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3699":73842,"_31384":73812,"_21647":123739,"_5":14929,"_28559":123659,"_3075":123740},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3699":73843,"_31384":73812,"_21647":123742,"_5":14929,"_28559":123663,"_3075":121041},[],{"_3699":73844,"_31384":73812,"_21647":123744,"_5":14929,"_28559":123663,"_3075":123745},[],"Material que atraviesa EST",{"_3699":73845,"_31384":73812,"_21647":123747,"_5":14929,"_28559":123663,"_3075":123748},[],"Clave generada por el dispositivo",{"_3699":73846,"_31384":73812,"_21647":123750,"_5":14929,"_28559":123663,"_3075":123751},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3699":73847,"_31384":73812,"_21647":123753,"_5":14929,"_28559":123663,"_3075":123754},[],"Clave ya disponible en el dispositivo",{"_3699":73848,"_31384":73812,"_21647":123756,"_5":14929,"_28559":123663,"_3075":123757},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3699":73849,"_31384":73812,"_21647":123759,"_5":14929,"_28559":123663,"_3075":54256},[],{"_3699":73850,"_31384":73812,"_21647":123761,"_5":14929,"_28559":123663,"_3075":123762},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3699":73851,"_31384":73812,"_21647":123764,"_5":14929,"_28559":123663,"_3075":123765},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3699":73852,"_31384":73812,"_21647":123767,"_5":14929,"_28559":123667,"_3075":123768},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3699":73853,"_31384":73853,"_5":15283,"_3075":123770,"_31709":123771,"_21647":123772,"_28559":73853},"Autenticación y confianza",[51094,122172,53807,54269],[],{"_3699":73854,"_31384":73853,"_21647":123774,"_5":14929,"_28559":73853,"_3075":123775},[],"Prepara las credenciales, la autenticación y la distribución de confianza para EST.",{"_3699":73855,"_31384":73853,"_5":31706,"_21647":123777,"_28559":123778,"_3075":123779},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3699":73856,"_31384":73853,"_5":31706,"_21647":123781,"_28559":123782,"_3075":123783},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3699":73857,"_31384":73853,"_5":31706,"_21647":123785,"_28559":123786,"_3075":123787},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#modos-por-operación","Modos por operación",{"_3699":73858,"_31384":73853,"_5":31706,"_21647":123789,"_28559":123790,"_3075":123791},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3699":73859,"_31384":73853,"_5":31706,"_21647":123793,"_28559":123794,"_3075":123795},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3699":73860,"_31384":73853,"_21647":123797,"_5":14929,"_28559":73853,"_3075":123798},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3699":73861,"_31384":73853,"_21647":123800,"_5":14929,"_28559":123778,"_3075":123801},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3699":73862,"_31384":73853,"_21647":123803,"_5":14929,"_28559":123778,"_3075":123804},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3699":73863,"_31384":73853,"_21647":123806,"_5":14929,"_28559":123782,"_3075":123807},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3699":73864,"_31384":73853,"_21647":123809,"_5":14929,"_28559":123782,"_3075":123810},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3699":73865,"_31384":73853,"_21647":123812,"_5":14929,"_28559":123782,"_3075":123813},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3699":73866,"_31384":73853,"_21647":123815,"_5":14929,"_28559":123786,"_3075":123816},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3699":73867,"_31384":73853,"_21647":123818,"_5":14929,"_28559":123786,"_3075":123819},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3699":73868,"_31384":73853,"_21647":123821,"_5":14929,"_28559":123790,"_3075":123822},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook (por defecto se verifica) y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3699":73869,"_31384":73853,"_21647":123824,"_5":14929,"_28559":123790,"_3075":123825},[],"Ejemplo de cuerpo:",{"_3699":73870,"_31384":73853,"_21647":123827,"_5":14929,"_28559":123790,"_3075":123828},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3699":73871,"_31384":73853,"_21647":123830,"_5":14929,"_28559":123790,"_3075":123831},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3699":73872,"_31384":73853,"_21647":123833,"_5":14929,"_28559":123790,"_3075":123834},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3699":73873,"_31384":73853,"_21647":123836,"_5":14929,"_28559":123790,"_3075":123837},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3699":73874,"_31384":73853,"_21647":123839,"_5":14929,"_28559":123794,"_3075":123840},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3699":73875,"_31384":73853,"_21647":123842,"_5":14929,"_28559":123794,"_3075":123843},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca (`thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas) y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3699":73876,"_31384":73853,"_21647":123845,"_5":14929,"_28559":123794,"_3075":123846},[],"Los puntos de distribución CRL descargados se almacenan en caché en memoria en el DMS Manager, indexados por su URL, de modo que las operaciones de enrolamiento y reenrolamiento simultáneas comparten una única descarga. Una lista en caché se reutiliza como máximo durante `crl_cache.max_ttl` (1 hora por defecto) y nunca más allá de su propio `nextUpdate` — o, si la lista no lo tiene, unas 24 horas tras `thisUpdate` conforme a la regla de frescura anterior. Leer una lista en caché no alarga su vida, y su firma se verifica frente al emisor del certificado en cada uso. Una lista caducada, mayor que `crl_cache.max_size_mb` (256 MB por defecto) o cuya descarga falló no se guarda en caché; la siguiente operación la descarga de nuevo. La caché es una configuración del servicio DMS Manager compartida por todos los DMS, no una opción por DMS, y afecta solo a los puntos de distribución CRL — las respuestas OCSP nunca se guardan en caché. Ambos ajustes son claves de la sección `crl_cache` del fichero de configuración del DMS Manager (`max_ttl` como duración, por ejemplo `10m`, y `max_size_mb` como entero); un valor sin definir o `0` usa el valor por defecto, y un valor negativo detiene el servicio al arrancar. La caché no se puede desactivar: para acortar la ventana en la que una revocación recién publicada sigue sin verse, reduce `max_ttl`. El Helm chart de Lamassu no expone `crl_cache` como valor, así que un despliegue con Helm funciona con los valores por defecto salvo que modifiques la configuración renderizada del DMS Manager. Los certificados gestionados por Lamassu no pasan por esta ruta: se comprueban con su estado almacenado y nunca llegan a la vía CRL.",{"_3699":73877,"_31384":73853,"_21647":123848,"_5":14929,"_28559":123794,"_3075":123849},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). Una revocación publicada en una CRL externa recién emitida puede tardar además hasta la ventana de caché — `crl_cache.max_ttl`, 1 hora por defecto — en volverse visible, además del propio ritmo de publicación de los responders. La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3699":73878,"_31384":73853,"_21647":123851,"_5":14929,"_28559":123794,"_3075":123852},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3699":73879,"_31384":73879,"_5":15283,"_3075":123854,"_31709":123855,"_21647":123856,"_28559":73879},"EST en Lamassu",[51094,122172,53807,54269],[],{"_3699":73880,"_31384":73879,"_21647":123858,"_5":14929,"_28559":73879,"_3075":123859},[],"Configura las operaciones EST, la autenticación y la distribución de confianza.",{"_3699":73881,"_31384":73879,"_5":31706,"_21647":123861,"_28559":123862,"_3075":123863},[],"/docs/es/platform/iot-fleets/est/configuration#referencia-de-endpoints","Referencia de endpoints",{"_3699":73882,"_31384":73879,"_5":31706,"_21647":123865,"_28559":123866,"_3075":123867},[],"/docs/es/platform/iot-fleets/est/configuration#autenticación-por-operación","Autenticación por operación",{"_3699":73883,"_31384":73879,"_5":31706,"_21647":123869,"_28559":123870,"_3075":123871},[],"/docs/es/platform/iot-fleets/est/configuration#certificado-de-cliente","Certificado de cliente",{"_3699":73884,"_31384":73879,"_5":31706,"_21647":123873,"_28559":123874,"_3075":123875},[],"/docs/es/platform/iot-fleets/est/configuration#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3699":73885,"_31384":73879,"_5":31706,"_21647":123877,"_28559":123878,"_3075":120677},[],"/docs/es/platform/iot-fleets/est/configuration#antes-de-empezar",{"_3699":73886,"_31384":73879,"_5":31706,"_21647":123880,"_28559":123881,"_3075":54380},[],"/docs/es/platform/iot-fleets/est/configuration#cacerts",{"_3699":73887,"_31384":73879,"_5":31706,"_21647":123883,"_28559":123884,"_3075":123885},[],"/docs/es/platform/iot-fleets/est/configuration#distribución-de-confianza","Configuración",{"_3699":73888,"_31384":73879,"_5":31706,"_21647":123887,"_28559":123888,"_3075":123889},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-cacerts","Petición y respuesta",{"_3699":73889,"_31384":73879,"_5":31706,"_21647":123891,"_28559":123892,"_3075":123893},[],"/docs/es/platform/iot-fleets/est/configuration#descarga-e-inspecciona-cacerts","Ejemplo",{"_3699":73890,"_31384":73879,"_5":31706,"_21647":123895,"_28559":123896,"_3075":54396},[],"/docs/es/platform/iot-fleets/est/configuration#simpleenroll",{"_3699":73891,"_31384":73879,"_5":31706,"_21647":123898,"_28559":123899,"_3075":123885},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-enrollment",{"_3699":73892,"_31384":73879,"_5":31706,"_21647":123901,"_28559":123902,"_3075":123889},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-simpleenroll",{"_3699":73893,"_31384":73879,"_5":31706,"_21647":123904,"_28559":123905,"_3075":123893},[],"/docs/es/platform/iot-fleets/est/configuration#ejemplo-de-enrolamiento-inicial",{"_3699":73894,"_31384":73879,"_5":31706,"_21647":123907,"_28559":123908,"_3075":54409},[],"/docs/es/platform/iot-fleets/est/configuration#simplereenroll",{"_3699":73895,"_31384":73879,"_5":31706,"_21647":123910,"_28559":123911,"_3075":123885},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-re-enrollment",{"_3699":73896,"_31384":73879,"_5":31706,"_21647":123913,"_28559":123914,"_3075":123889},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-simplereenroll",{"_3699":73897,"_31384":73879,"_5":31706,"_21647":123916,"_28559":123917,"_3075":123893},[],"/docs/es/platform/iot-fleets/est/configuration#ejemplo-de-renovación",{"_3699":73898,"_31384":73879,"_5":31706,"_21647":123919,"_28559":123920,"_3075":123921},[],"/docs/es/platform/iot-fleets/est/configuration#recupera-según-el-estado","Recupera según el estado",{"_3699":73899,"_31384":73879,"_5":31706,"_21647":123923,"_28559":123924,"_3075":54426},[],"/docs/es/platform/iot-fleets/est/configuration#serverkeygen",{"_3699":73900,"_31384":73879,"_5":31706,"_21647":123926,"_28559":123927,"_3075":123885},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-serverkeygen",{"_3699":73901,"_31384":73879,"_5":31706,"_21647":123929,"_28559":123930,"_3075":123889},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-serverkeygen",{"_3699":73902,"_31384":73879,"_5":31706,"_21647":123932,"_28559":123933,"_3075":123893},[],"/docs/es/platform/iot-fleets/est/configuration#solicitud-y-extracción",{"_3699":73903,"_31384":73879,"_21647":123935,"_5":14929,"_28559":73879,"_3075":123936},[],"Cada DMS expone en Lamassu las operaciones EST que sus dispositivos usan para obtener y renovar su identidad. Esta página describe las rutas, cómo se autentica cada operación, los ajustes del DMS que gobiernan cada endpoint y ejemplos de petición con curl y OpenSSL. Para crear y administrar el DMS, consulta la guía del DMS; para preparar las credenciales y la confianza inicial del dispositivo, Autenticación y confianza.",{"_3699":73904,"_31384":73879,"_21647":123938,"_5":14929,"_28559":123862,"_3075":123939},[],"Cada DMS publica sus operaciones en `/.well-known/est/{APS}/{operation}`, donde `APS` es el ID del DMS, no su nombre visible. La configuración del Gateway determina el host y la ruta públicos. El router también admite rutas sin el segmento `APS`, pero el controlador lo requiere, así que no las utilices.",{"_3699":73905,"_31384":73879,"_21647":123941,"_5":14929,"_28559":123862,"_3075":121932},[],{"_3699":73906,"_31384":73879,"_21647":123943,"_5":14929,"_28559":123862,"_3075":123944},[],"Método",{"_3699":73907,"_31384":73879,"_21647":123946,"_5":14929,"_28559":123862,"_3075":123947},[],"Autenticación y condición",{"_3699":73908,"_31384":73879,"_21647":123949,"_5":14929,"_28559":123862,"_3075":54453},[],{"_3699":73909,"_31384":73879,"_21647":123951,"_5":14929,"_28559":123862,"_3075":54456},[],{"_3699":73910,"_31384":73879,"_21647":123953,"_5":14929,"_28559":123862,"_3075":123954},[],"No exige credencial EST; HTTPS y los controles de infraestructura siguen aplicándose.",{"_3699":73911,"_31384":73879,"_21647":123956,"_5":14929,"_28559":123862,"_3075":54462},[],{"_3699":73912,"_31384":73879,"_21647":123958,"_5":14929,"_28559":123862,"_3075":54465},[],{"_3699":73913,"_31384":73879,"_21647":123960,"_5":14929,"_28559":123862,"_3075":123961},[],"Autenticación inicial y política de registro y sustitución del DMS.",{"_3699":73914,"_31384":73879,"_21647":123963,"_5":14929,"_28559":123862,"_3075":54471},[],{"_3699":73915,"_31384":73879,"_21647":123965,"_5":14929,"_28559":123862,"_3075":54465},[],{"_3699":73916,"_31384":73879,"_21647":123967,"_5":14929,"_28559":123862,"_3075":123968},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3699":73917,"_31384":73879,"_21647":123970,"_5":14929,"_28559":123862,"_3075":54479},[],{"_3699":73918,"_31384":73879,"_21647":123972,"_5":14929,"_28559":123862,"_3075":54465},[],{"_3699":73919,"_31384":73879,"_21647":123974,"_5":14929,"_28559":123862,"_3075":123975},[],"Autenticación inicial y generación de claves habilitada.",{"_3699":73920,"_31384":73879,"_21647":123977,"_5":14929,"_28559":123862,"_3075":123978},[],"Lamassu no implementa `/csrattrs` ni `/fullcmc`. Tampoco hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3699":73921,"_31384":73879,"_21647":123980,"_5":14929,"_28559":123866,"_3075":123981},[],"El DMS autentica la solicitud antes de aplicar las reglas de registro y emisión. Cada operación lee su autenticación de un bloque `est_rfc7030_settings` propio:",{"_3699":73922,"_31384":73879,"_21647":123983,"_5":14929,"_28559":123866,"_3075":123984},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3699":73923,"_31384":73879,"_21647":123986,"_5":14929,"_28559":123866,"_3075":123987},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3699":73924,"_31384":73879,"_21647":123989,"_5":14929,"_28559":123866,"_3075":123990},[],"Los dos bloques se almacenan por separado y uno no hereda del otro, así que lee ambos antes de editar. `auth_mode` admite estos valores:",{"_3699":73925,"_31384":73879,"_21647":123992,"_5":14929,"_28559":123866,"_3075":54502},[],{"_3699":73926,"_31384":73879,"_21647":123994,"_5":14929,"_28559":123866,"_3075":123995},[],"Control aplicado en la operación configurada",{"_3699":73927,"_31384":73879,"_21647":123997,"_5":14929,"_28559":123866,"_3075":54508},[],{"_3699":73928,"_31384":73879,"_21647":123999,"_5":14929,"_28559":123866,"_3075":124000},[],"Validación del certificado presentado.",{"_3699":73929,"_31384":73879,"_21647":124002,"_5":14929,"_28559":123866,"_3075":54514},[],{"_3699":73930,"_31384":73879,"_21647":124004,"_5":14929,"_28559":123866,"_3075":124005},[],"Autorización del webhook configurado.",{"_3699":73931,"_31384":73879,"_21647":124007,"_5":14929,"_28559":123866,"_3075":54520},[],{"_3699":73932,"_31384":73879,"_21647":124009,"_5":14929,"_28559":123866,"_3075":124010},[],"Validación del certificado y, después, aprobación del webhook.",{"_3699":73933,"_31384":73879,"_21647":124012,"_5":14929,"_28559":123866,"_3075":54526},[],{"_3699":73934,"_31384":73879,"_21647":124014,"_5":14929,"_28559":123866,"_3075":124015},[],"Sin autenticación del solicitante por el DMS.",{"_3699":73935,"_31384":73879,"_21647":124017,"_5":14929,"_28559":123866,"_3075":124018},[],"Los modos con webhook también se ejecutan en el reenrolamiento si se configuran en su bloque. Un modo ausente o no reconocido hace fallar la operación: no hay una degradación implícita a `NO_AUTH`. `NO_AUTH` no acredita la propiedad del ID solicitado.",{"_3699":73936,"_31384":73879,"_21647":124020,"_5":14929,"_28559":123870,"_3075":124021},[],"Los modos con certificado leen `client_certificate_settings` en el mismo bloque:",{"_3699":73937,"_31384":73879,"_21647":124023,"_5":14929,"_28559":123870,"_3075":124024},[],"Campo",{"_3699":73938,"_31384":73879,"_21647":124026,"_5":14929,"_28559":123870,"_3075":124027},[],"Descripción",{"_3699":73939,"_31384":73879,"_21647":124029,"_5":14929,"_28559":123870,"_3075":54544},[],{"_3699":73940,"_31384":73879,"_21647":124031,"_5":14929,"_28559":123870,"_3075":124032},[],"IDs de las CAs frente a las que se valida el certificado presentado. Se usa la primera que lo valida.",{"_3699":73941,"_31384":73879,"_21647":124034,"_5":14929,"_28559":123870,"_3075":54550},[],{"_3699":73942,"_31384":73879,"_21647":124036,"_5":14929,"_28559":123870,"_3075":124037},[],"**Allow expired certificates**: acepta certificados vencidos en el enrolamiento inicial.",{"_3699":73943,"_31384":73879,"_21647":124039,"_5":14929,"_28559":123870,"_3075":54556},[],{"_3699":73944,"_31384":73879,"_21647":124041,"_5":14929,"_28559":123870,"_3075":124042},[],"Si es mayor que 0, solo se validan ese número de certificados de la cadena presentada.",{"_3699":73945,"_31384":73879,"_21647":124044,"_5":14929,"_28559":123870,"_3075":54562},[],{"_3699":73946,"_31384":73879,"_21647":124046,"_5":14929,"_28559":123870,"_3075":124047},[],"**Allow certificates without revocation information**: acepta certificados sin información de revocación; `false` por defecto.",{"_3699":73947,"_31384":73879,"_21647":124049,"_5":14929,"_28559":123870,"_3075":124050},[],"El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3699":73948,"_31384":73879,"_21647":124052,"_5":14929,"_28559":123870,"_3075":124053},[],"**Revocación.** En el enrolamiento inicial se comprueban el certificado de cliente y todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Los certificados gestionados por Lamassu se comprueban con su estado almacenado, y los externos mediante sus endpoints OCSP y CRL. La operación falla cerrada cuando la revocación no puede verificarse: los endpoints que no responden, la evidencia caducada o inválida y los estados no concluyentes rechazan siempre el certificado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Revocación y comprobaciones detalla la evidencia que deben presentar los endpoints. Las listas CRL descargadas para estas comprobaciones se reutilizan durante un tiempo limitado antes de volver a descargarse; consulta Revocación y comprobaciones para conocer la ventana de caché y su efecto sobre la visibilidad de una revocación.",{"_3699":73949,"_31384":73879,"_21647":124055,"_5":14929,"_28559":123870,"_3075":124056},[],"`allow_unverifiable_revocation` relaja solo un caso: un certificado, o una CA intermedia de la cadena, que Lamassu no gestiona y que no declara ningún endpoint OCSP o CRL. Con la opción activada ese certificado se acepta aunque esté revocado, y la consola muestra el aviso **Revocation will not be verified**. La opción se configura por separado en el bloque de enrolamiento y en el de reenrolamiento, y está desactivada en los DMS creados antes de que existiera.",{"_3699":73950,"_31384":73879,"_21647":124058,"_5":14929,"_28559":123870,"_3075":124059},[],"**Reenrolamiento.** El validador prueba primero la CA de enrolamiento y después las `validation_cas` del bloque de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable, y las CAs que solo figuran en la `validation_cas` del bloque inicial no amplían la aceptación: durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador compara solo la hoja TLS presentada con esas CAs y comprueba únicamente su revocación. En este bloque `chain_level_validation` y `allow_expired` se almacenan pero no se consultan; el vencimiento lo rige `enable_expired_renewal`.",{"_3699":73951,"_31384":73879,"_21647":124061,"_5":14929,"_28559":123874,"_3075":124062},[],"Los modos con webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`. Estos ajustes definen el destino, el método, el timeout y cómo se autentica Lamassu ante el receptor; el contrato del webhook describe la credencial del dispositivo, el cuerpo de la llamada y la respuesta esperada.",{"_3699":73952,"_31384":73879,"_21647":124064,"_5":14929,"_28559":123874,"_3075":124065},[],"Campo de `external_webhook_settings`",{"_3699":73953,"_31384":73879,"_21647":124067,"_5":14929,"_28559":123874,"_3075":124068},[],"Decisión",{"_3699":73954,"_31384":73879,"_21647":124070,"_5":14929,"_28559":123874,"_3075":54589},[],{"_3699":73955,"_31384":73879,"_21647":124072,"_5":14929,"_28559":123874,"_3075":124073},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3699":73956,"_31384":73879,"_21647":124075,"_5":14929,"_28559":123874,"_3075":54595},[],{"_3699":73957,"_31384":73879,"_21647":124077,"_5":14929,"_28559":123874,"_3075":124078},[],"`POST` o `PUT`; `POST` por defecto.",{"_3699":73958,"_31384":73879,"_21647":124080,"_5":14929,"_28559":123874,"_3075":54601},[],{"_3699":73959,"_31384":73879,"_21647":124082,"_5":14929,"_28559":123874,"_3075":124083},[],"Etiqueta usada en los logs del servicio.",{"_3699":73960,"_31384":73879,"_21647":124085,"_5":14929,"_28559":123874,"_3075":54607},[],{"_3699":73961,"_31384":73879,"_21647":124087,"_5":14929,"_28559":123874,"_3075":124088},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3699":73962,"_31384":73879,"_21647":124090,"_5":14929,"_28559":123874,"_3075":54613},[],{"_3699":73963,"_31384":73879,"_21647":124092,"_5":14929,"_28559":123874,"_3075":124093},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3699":73964,"_31384":73879,"_21647":124095,"_5":14929,"_28559":123874,"_3075":54619},[],{"_3699":73965,"_31384":73879,"_21647":124097,"_5":14929,"_28559":123874,"_3075":124098},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3699":73966,"_31384":73879,"_21647":124100,"_5":14929,"_28559":123874,"_3075":54625},[],{"_3699":73967,"_31384":73879,"_21647":124102,"_5":14929,"_28559":123874,"_3075":124103},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3699":73968,"_31384":73879,"_21647":124105,"_5":14929,"_28559":123874,"_3075":54631},[],{"_3699":73969,"_31384":73879,"_21647":124107,"_5":14929,"_28559":123874,"_3075":124108},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3699":73970,"_31384":73879,"_21647":124110,"_5":14929,"_28559":123874,"_3075":54637},[],{"_3699":73971,"_31384":73879,"_21647":124112,"_5":14929,"_28559":123874,"_3075":124113},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3699":73972,"_31384":73879,"_21647":124115,"_5":14929,"_28559":123874,"_3075":54643},[],{"_3699":73973,"_31384":73879,"_21647":124117,"_5":14929,"_28559":123874,"_3075":124118},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3699":73974,"_31384":73879,"_21647":124120,"_5":14929,"_28559":123874,"_3075":124121},[],"Crear o actualizar un DMS que usa el webhook en alguno de sus bloques valida esta configuración. Si no es válida, la respuesta es HTTP 400, con un cuerpo que empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config`. Estas reglas se aplican:",{"_3699":73975,"_31384":73879,"_21647":124123,"_5":14929,"_28559":123874,"_3075":124124},[],"La URL, el método y las opciones deben ser válidos, y `mtls_options.cert_content` y `key_content` deben corresponderse con un certificado y una clave privada coincidentes.",{"_3699":73976,"_31384":73879,"_21647":124126,"_5":14929,"_28559":123874,"_3075":124127},[],"Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas, porque el servicio no lee archivos. Introduce el certificado y la clave como PEM, codificado en Base64 o en claro, en `cert_content` y `key_content`.",{"_3699":73977,"_31384":73879,"_21647":124129,"_5":14929,"_28559":123874,"_3075":124130},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían (por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded`), y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient`.",{"_3699":73978,"_31384":73879,"_21647":124132,"_5":14929,"_28559":123874,"_3075":124133},[],"Con `config.auth_mode` a `apikey`, `jwt` o `mtls`, el cuerpo debe llevar su bloque de opciones (`apikey_options`, `jwt_options` o `mtls_options`) y ningún otro. Los nombres heredados `apikey`, `oidc` y `mtls` fallan la validación, y `validate_server_cert` se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3699":73979,"_31384":73879,"_21647":124135,"_5":14929,"_28559":123874,"_3075":124136},[],"La clave `http_client` pertenece a los canales de alertas; en un cuerpo de DMS se ignora. La configuración del DMS va en `external_webhook_settings.config`.",{"_3699":73980,"_31384":73879,"_21647":124138,"_5":14929,"_28559":123874,"_3075":124139},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3699":73981,"_31384":73879,"_21647":124141,"_5":14929,"_28559":123874,"_3075":124142},[],"La consola ofrece editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos **Log Level**, **Call Timeout**, **HTTP Authentication** y credenciales que los canales webhook, además del interruptor **Skip TLS Verification** (`insecure_skip_verify`, desactivado por defecto; la consola avisa al activarlo). El editor rechaza las rutas de archivo en los campos de certificado y clave, y al guardar reescribe `external_webhook_settings.config` con las claves actuales y el material codificado en Base64. Las configuraciones migradas desde 3.8.0 que referenciaban archivos o dependían de `validate_server_cert: false` requieren corrección; consulta Webhooks del DMS.",{"_3699":73982,"_31384":73879,"_21647":124144,"_5":14929,"_28559":123878,"_3075":124145},[],"Para recorrer todas las operaciones de un primer enrolamiento, sigue Enrola y conecta tu primer dispositivo.",{"_3699":73983,"_31384":73879,"_21647":124147,"_5":14929,"_28559":123878,"_3075":124148},[],"Los ejemplos de esta página necesitan el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Usan Bash, curl con `--fail-with-body` y OpenSSL 3.x (openssl-pkcs7 para extraer certificados y openssl-x509 para preparar la renovación); trabaja en un directorio privado. Si integras un cliente EST genérico, comprueba antes las particularidades de Lamassu descritas en cada operación, como la respuesta PEM o el formato multipart de `/serverkeygen`.",{"_3699":73984,"_31384":73879,"_21647":124150,"_5":14929,"_28559":123878,"_3075":124151},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Autenticación y confianza. Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación:",{"_3699":73985,"_31384":73879,"_21647":124153,"_5":14929,"_28559":123878,"_3075":124154},[],"Cuando una petición falla, conserva el código HTTP, las cabeceras y el cuerpo antes de decodificar nada. Un 500 no implica un fallo transitorio: los rechazos del servicio también lo devuelven. El diagnóstico explica cómo interpretarlos.",{"_3699":73986,"_31384":73879,"_21647":124156,"_5":14929,"_28559":123881,"_3075":124157},[],"`GET /cacerts` descarga el conjunto de certificados que publica el DMS. El cliente puede inspeccionarlo y usar los certificados aprobados para construir cadenas de confianza.",{"_3699":73987,"_31384":73879,"_21647":124159,"_5":14929,"_28559":123884,"_3075":124160},[],"`settings.ca_distribution_settings` determina qué certificados devuelve `/cacerts`:",{"_3699":73988,"_31384":73879,"_21647":124162,"_5":14929,"_28559":123884,"_3075":124024},[],{"_3699":73989,"_31384":73879,"_21647":124164,"_5":14929,"_28559":123884,"_3075":124165},[],"Contenido que añade",{"_3699":73990,"_31384":73879,"_21647":124167,"_5":14929,"_28559":123884,"_3075":54696},[],{"_3699":73991,"_31384":73879,"_21647":124169,"_5":14929,"_28559":123884,"_3075":124170},[],"El certificado TLS downstream disponible. Puede ser una hoja, no una CA de emisión.",{"_3699":73992,"_31384":73879,"_21647":124172,"_5":14929,"_28559":123884,"_3075":54702},[],{"_3699":73993,"_31384":73879,"_21647":124174,"_5":14929,"_28559":123884,"_3075":124175},[],"El certificado de la CA de enrolamiento seleccionada.",{"_3699":73994,"_31384":73879,"_21647":124177,"_5":14929,"_28559":123884,"_3075":54708},[],{"_3699":73995,"_31384":73879,"_21647":124179,"_5":14929,"_28559":123884,"_3075":124180},[],"Los certificados de las CAs elegidas explícitamente.",{"_3699":73996,"_31384":73879,"_21647":124182,"_5":14929,"_28559":123884,"_3075":124183},[],"El DMS no añade los ascendientes de esas CAs: seleccionar la CA de enrolamiento no publica su raíz ni sus intermedias, que deben elegirse en **Managed CAs**. El conjunto puede contener hojas, raíces e intermedias, incluso de más de una jerarquía durante una migración. La posición de cada certificado no define la cadena: identifícalos por sujeto, emisor, AKI/SKI, firma y restricciones.",{"_3699":73997,"_31384":73879,"_21647":124185,"_5":14929,"_28559":123888,"_3075":124186},[],"Envía un GET por HTTPS sin cuerpo y sin credencial EST. Siguen aplicándose los controles del Gateway.",{"_3699":73998,"_31384":73879,"_21647":124188,"_5":14929,"_28559":123888,"_3075":124189},[],"**Respuesta predeterminada.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres.",{"_3699":73999,"_31384":73879,"_21647":124191,"_5":14929,"_28559":123888,"_3075":124192},[],"**Respuesta PEM.** Lamassu selecciona este formato cuando `Accept` es exactamente `application/x-pem-file` y devuelve ese mismo valor en `Content-Type`. El cuerpo contiene los certificados en PEM.",{"_3699":74000,"_31384":73879,"_21647":124194,"_5":14929,"_28559":123892,"_3075":124195},[],"El ejemplo descarga la respuesta predeterminada y la convierte a PEM. Usa `EST_BASE` y `est-trust.pem` de Antes de empezar.",{"_3699":74001,"_31384":73879,"_21647":124197,"_5":14929,"_28559":123892,"_3075":124198},[],"Comprueba las huellas, emisores y fechas frente a la configuración de distribución. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3699":74002,"_31384":73879,"_21647":124200,"_5":14929,"_28559":123896,"_3075":124201},[],"`POST /simpleenroll` emite el certificado inicial de un dispositivo a partir de una CSR. Lamassu toma el identificador del dispositivo del CN y vincula el certificado emitido a su identidad. La clave privada permanece en el cliente.",{"_3699":74003,"_31384":73879,"_21647":124203,"_5":14929,"_28559":123899,"_3075":124204},[],"Las opciones del enrolamiento inicial se guardan en `settings.enrollment_settings`:",{"_3699":74004,"_31384":73879,"_21647":124206,"_5":14929,"_28559":123899,"_3075":124024},[],{"_3699":74005,"_31384":73879,"_21647":124208,"_5":14929,"_28559":123899,"_3075":124027},[],{"_3699":74006,"_31384":73879,"_21647":124210,"_5":14929,"_28559":123899,"_3075":54742},[],{"_3699":74007,"_31384":73879,"_21647":124212,"_5":14929,"_28559":123899,"_3075":124213},[],"`EST_RFC7030` para estas operaciones.",{"_3699":74008,"_31384":73879,"_21647":124215,"_5":14929,"_28559":123899,"_3075":54748},[],{"_3699":74009,"_31384":73879,"_21647":124217,"_5":14929,"_28559":123899,"_3075":124218},[],"ID de la CA que firma los certificados.",{"_3699":74010,"_31384":73879,"_21647":124220,"_5":14929,"_28559":123899,"_3075":54754},[],{"_3699":74011,"_31384":73879,"_21647":124222,"_5":14929,"_28559":123899,"_3075":124223},[],"`JITP` crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. `PRE_REGISTRATION` exige que el ID exista previamente.",{"_3699":74012,"_31384":73879,"_21647":124225,"_5":14929,"_28559":123899,"_3075":54760},[],{"_3699":74013,"_31384":73879,"_21647":124227,"_5":14929,"_28559":123899,"_3075":124228},[],"Etiquetas, metadatos e icono que recibe un dispositivo dado de alta por JITP.",{"_3699":74014,"_31384":73879,"_21647":124230,"_5":14929,"_28559":123899,"_3075":54766},[],{"_3699":74015,"_31384":73879,"_21647":124232,"_5":14929,"_28559":123899,"_3075":124233},[],"Permite `/simpleenroll` para un ID existente del mismo DMS.",{"_3699":74016,"_31384":73879,"_21647":124235,"_5":14929,"_28559":123899,"_3075":54772},[],{"_3699":74017,"_31384":73879,"_21647":124237,"_5":14929,"_28559":123899,"_3075":124238},[],"Comprueba la posesión de la clave de la CSR. Mantenlo en `true`.",{"_3699":74018,"_31384":73879,"_21647":124240,"_5":14929,"_28559":123899,"_3075":54778},[],{"_3699":74019,"_31384":73879,"_21647":124242,"_5":14929,"_28559":123899,"_3075":124243},[],"Autenticación del enrolamiento inicial; consulta Autenticación por operación.",{"_3699":74020,"_31384":73879,"_21647":124245,"_5":14929,"_28559":123899,"_3075":124246},[],"**Registro y sustitución.** En `PRE_REGISTRATION`, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad; consulta las condiciones de prerregistro antes de utilizar este modo. Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. La sustitución puede intentar revocar el certificado anterior aunque falle una fase posterior: no es un cambio atómico. No la actives como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3699":74021,"_31384":73879,"_21647":124248,"_5":14929,"_28559":123899,"_3075":124249},[],"**Perfil de emisión.** El perfil se define en `settings`, no en `enrollment_settings`, y se aplica a las tres operaciones que emiten certificados. `settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se usa el perfil predeterminado de la CA. El perfil resuelto debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan en Perfiles. Cambiar el DMS afecta a las solicitudes futuras; no modifica certificados ya firmados ni instala confianza en los clientes.",{"_3699":74022,"_31384":73879,"_21647":124251,"_5":14929,"_28559":123902,"_3075":124252},[],"Envía `Content-Type: application/pkcs10` y una CSR PKCS#10 DER codificada en Base64 en el cuerpo. Lamassu decodifica el cuerpo como Base64, sin envoltorio PEM ni JSON.",{"_3699":74023,"_31384":73879,"_21647":124254,"_5":14929,"_28559":123902,"_3075":124255},[],"**Respuesta predeterminada.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El PKCS#7 contiene el certificado emitido. Obtén por separado los certificados de CA que necesites para verificar su cadena.",{"_3699":74024,"_31384":73879,"_21647":124257,"_5":14929,"_28559":123902,"_3075":124258},[],"**Respuesta PEM.** Envía exactamente `Accept: application/x-pem-file` para recibir el certificado en PEM con `Content-Type: application/x-pem-file`.",{"_3699":74025,"_31384":73879,"_21647":124260,"_5":14929,"_28559":123905,"_3075":124261},[],"El ejemplo usa la autenticación inicial `CLIENT_CERTIFICATE` y los archivos de Antes de empezar.",{"_3699":74026,"_31384":73879,"_21647":124263,"_5":14929,"_28559":123905,"_3075":124264},[],"**Prepara la CSR.** El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3699":74027,"_31384":73879,"_21647":124266,"_5":14929,"_28559":123905,"_3075":124267},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3699":74028,"_31384":73879,"_21647":124269,"_5":14929,"_28559":123905,"_3075":124270},[],"**Solicita la identidad.** Envía la CSR autenticándote con la credencial bootstrap:",{"_3699":74029,"_31384":73879,"_21647":124272,"_5":14929,"_28559":123905,"_3075":124273},[],"Si curl falla, el ejemplo se detiene antes de decodificar: una respuesta de error no es un certificado. Un timeout deja el resultado de la operación por comprobar en Lamassu, así que no repitas automáticamente una emisión.",{"_3699":74030,"_31384":73879,"_21647":124275,"_5":14929,"_28559":123905,"_3075":124276},[],"**Comprueba e instala el resultado.** Para el caso de una raíz que emite directamente:",{"_3699":74031,"_31384":73879,"_21647":124278,"_5":14929,"_28559":123905,"_3075":124279},[],"`cmp` debe terminar con código 0. Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3699":74032,"_31384":73879,"_21647":124281,"_5":14929,"_28559":123905,"_3075":124282},[],"Consulta el dispositivo en Lamassu: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo; la asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3699":74033,"_31384":73879,"_21647":124284,"_5":14929,"_28559":123908,"_3075":124285},[],"`POST /simplereenroll` emite un certificado sucesor para una identidad activa. El cliente conserva el identificador del dispositivo y puede solicitar el certificado con una clave nueva.",{"_3699":74034,"_31384":73879,"_21647":124287,"_5":14929,"_28559":123911,"_3075":124288},[],"Las opciones de renovación se guardan en `settings.reenrollment_settings`:",{"_3699":74035,"_31384":73879,"_21647":124290,"_5":14929,"_28559":123911,"_3075":124024},[],{"_3699":74036,"_31384":73879,"_21647":124292,"_5":14929,"_28559":123911,"_3075":124027},[],{"_3699":74037,"_31384":73879,"_21647":124294,"_5":14929,"_28559":123911,"_3075":54778},[],{"_3699":74038,"_31384":73879,"_21647":124296,"_5":14929,"_28559":123911,"_3075":124297},[],"Autenticación del reenrolamiento, independiente de la inicial; consulta Autenticación por operación.",{"_3699":74039,"_31384":73879,"_21647":124299,"_5":14929,"_28559":123911,"_3075":54838},[],{"_3699":74040,"_31384":73879,"_21647":124301,"_5":14929,"_28559":123911,"_3075":124302},[],"CAs de validación de reenrolamiento, probadas después de la CA de enrolamiento. Es opcional y suele poblarse durante una rotación de CAs, mientras se renuevan los dispositivos con certificados de la CA anterior.",{"_3699":74041,"_31384":73879,"_21647":124304,"_5":14929,"_28559":123911,"_3075":54844},[],{"_3699":74042,"_31384":73879,"_21647":124306,"_5":14929,"_28559":123911,"_3075":124307},[],"La ventana de renovación abre en el `NotAfter` del certificado activo menos este delta.",{"_3699":74043,"_31384":73879,"_21647":124309,"_5":14929,"_28559":123911,"_3075":54850},[],{"_3699":74044,"_31384":73879,"_21647":124311,"_5":14929,"_28559":123911,"_3075":124312},[],"Umbral preventivo de monitorización. Produce estados y avisos; no amplía la ventana.",{"_3699":74045,"_31384":73879,"_21647":124314,"_5":14929,"_28559":123911,"_3075":54856},[],{"_3699":74046,"_31384":73879,"_21647":124316,"_5":14929,"_28559":123911,"_3075":124317},[],"Umbral crítico de monitorización. Produce estados y avisos; no amplía la ventana.",{"_3699":74047,"_31384":73879,"_21647":124319,"_5":14929,"_28559":123911,"_3075":54862},[],{"_3699":74048,"_31384":73879,"_21647":124321,"_5":14929,"_28559":123911,"_3075":124322},[],"Acepta un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3699":74049,"_31384":73879,"_21647":124324,"_5":14929,"_28559":123911,"_3075":54868},[],{"_3699":74050,"_31384":73879,"_21647":124326,"_5":14929,"_28559":123911,"_3075":124327},[],"Si el certificado anterior está `ACTIVE`, intenta revocarlo con motivo Superseded antes de vincular el sucesor.",{"_3699":74051,"_31384":73879,"_21647":124329,"_5":14929,"_28559":123911,"_3075":124330},[],"El campo plano heredado `reenrollment_settings.additional_validation_cas` no forma parte de la API: se ignora sin error, así que un cuerpo de actualización construido con él vacía `validation_cas`. Lee el DMS antes de editarlo por API.",{"_3699":74052,"_31384":73879,"_21647":124332,"_5":14929,"_28559":123911,"_3075":124333},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona las solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Mantén un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse; consulta Recupera según el estado.",{"_3699":74053,"_31384":73879,"_21647":124335,"_5":14929,"_28559":123914,"_3075":124336},[],"Usa el mismo formato de CSR y cabeceras que en `simpleenroll`. La respuesta contiene el certificado sucesor en PKCS#7 DER codificado en Base64, o en PEM si envías exactamente `Accept: application/x-pem-file`.",{"_3699":74054,"_31384":73879,"_21647":124338,"_5":14929,"_28559":123914,"_3075":124339},[],"Con autenticación por certificado, Lamassu exige que el CN de la credencial coincida con el de la CSR y compara el sujeto solicitado con el del certificado actual. El DMS rechaza un certificado activo revocado o una solicitud anterior a la ventana de renovación. Certificado de cliente detalla las CAs admitidas, el vencimiento y las comprobaciones de revocación.",{"_3699":74055,"_31384":73879,"_21647":124341,"_5":14929,"_28559":123917,"_3075":124342},[],"El ejemplo continúa el enrolamiento inicial en la misma sesión Bash, con `device.crt` y `device.key` como identidad actual.",{"_3699":74056,"_31384":73879,"_21647":124344,"_5":14929,"_28559":123917,"_3075":124345},[],"**Prepara la renovación.** Antes de solicitar el sucesor:",{"_3699":74057,"_31384":73879,"_21647":124347,"_5":14929,"_28559":123917,"_3075":124348},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3699":74058,"_31384":73879,"_21647":124350,"_5":14929,"_28559":123917,"_3075":124351},[],"Comprueba el modo de autenticación del reenrolamiento: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual; no asumas que la credencial bootstrap está admitida.",{"_3699":74059,"_31384":73879,"_21647":124353,"_5":14929,"_28559":123917,"_3075":124354},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`.",{"_3699":74060,"_31384":73879,"_21647":124356,"_5":14929,"_28559":123917,"_3075":124357},[],"Revisa **Revoke on Re-enrollment**. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3699":74061,"_31384":73879,"_21647":124359,"_5":14929,"_28559":123917,"_3075":124360},[],"**Solicita el certificado sucesor.** La petición se autentica con `device.crt` y `device.key`, y la CSR contiene una clave nueva compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo el SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend compara el sujeto con la identidad actual: intenta la igualdad de RawSubject y después compara CN, OU, O, L, ST y C, así que reconstruir solo el CN puede perder atributos requeridos.",{"_3699":74062,"_31384":73879,"_21647":124362,"_5":14929,"_28559":123917,"_3075":124363},[],"Comprueba también las extensiones, las fechas y que la serie corresponde al slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3699":74063,"_31384":73879,"_21647":124365,"_5":14929,"_28559":123917,"_3075":124366},[],"**Instala y comprueba la nueva pareja.** Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3699":74064,"_31384":73879,"_21647":124368,"_5":14929,"_28559":123917,"_3075":124369},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y el consumo de su revocación.",{"_3699":74065,"_31384":73879,"_21647":124371,"_5":14929,"_28559":123920,"_3075":124372},[],"Situación",{"_3699":74066,"_31384":73879,"_21647":124374,"_5":14929,"_28559":123920,"_3075":124375},[],"Procedimiento",{"_3699":74067,"_31384":73879,"_21647":124377,"_5":14929,"_28559":123920,"_3075":124378},[],"Certificado vigente, fuera de ventana",{"_3699":74068,"_31384":73879,"_21647":124380,"_5":14929,"_28559":123920,"_3075":124381},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3699":74069,"_31384":73879,"_21647":124383,"_5":14929,"_28559":123920,"_3075":124384},[],"Certificado vencido, clave disponible",{"_3699":74070,"_31384":73879,"_21647":124386,"_5":14929,"_28559":123920,"_3075":124387},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3699":74071,"_31384":73879,"_21647":124389,"_5":14929,"_28559":123920,"_3075":124390},[],"Renovación por webhook o `NO_AUTH`",{"_3699":74072,"_31384":73879,"_21647":124392,"_5":14929,"_28559":123920,"_3075":124393},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el webhook debe autorizar explícitamente la recuperación que admita.",{"_3699":74073,"_31384":73879,"_21647":124395,"_5":14929,"_28559":123920,"_3075":124396},[],"Clave perdida o inaccesible",{"_3699":74074,"_31384":73879,"_21647":124398,"_5":14929,"_28559":123920,"_3075":124399},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3699":74075,"_31384":73879,"_21647":124401,"_5":14929,"_28559":123920,"_3075":124402},[],"Identidad actual revocada",{"_3699":74076,"_31384":73879,"_21647":124404,"_5":14929,"_28559":123920,"_3075":124405},[],"`simplereenroll` rechaza el certificado actual revocado y conservar sus archivos no restaura una conexión válida. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3699":74077,"_31384":73879,"_21647":124407,"_5":14929,"_28559":123920,"_3075":124408},[],"Dispositivo sin identidad",{"_3699":74078,"_31384":73879,"_21647":124410,"_5":14929,"_28559":123920,"_3075":124411},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3699":74079,"_31384":73879,"_21647":124413,"_5":14929,"_28559":123920,"_3075":124414},[],"Dispositivo retirado",{"_3699":74080,"_31384":73879,"_21647":124416,"_5":14929,"_28559":123920,"_3075":124417},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3699":74081,"_31384":73879,"_21647":124419,"_5":14929,"_28559":123920,"_3075":124420},[],"Timeout, HTTP 500 o fallo de instalación",{"_3699":74082,"_31384":73879,"_21647":124422,"_5":14929,"_28559":123920,"_3075":124423},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3699":74083,"_31384":73879,"_21647":124425,"_5":14929,"_28559":123924,"_3075":124426},[],"`POST /serverkeygen` genera una clave software en Lamassu, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El cliente recibe la clave privada y el certificado.",{"_3699":74084,"_31384":73879,"_21647":124428,"_5":14929,"_28559":123927,"_3075":124429},[],"`settings.server_keygen_settings` controla la generación de claves. El resto de la operación aplica la configuración del enrolamiento inicial; antes de probarla con un ID registrado, revisa si esa configuración permite sustituir el certificado.",{"_3699":74085,"_31384":73879,"_21647":124431,"_5":14929,"_28559":123927,"_3075":124024},[],{"_3699":74086,"_31384":73879,"_21647":124433,"_5":14929,"_28559":123927,"_3075":124027},[],{"_3699":74087,"_31384":73879,"_21647":124435,"_5":14929,"_28559":123927,"_3075":54980},[],{"_3699":74088,"_31384":73879,"_21647":124437,"_5":14929,"_28559":123927,"_3075":124438},[],"Activa la operación. Con la operación deshabilitada, la consola omite el campo `key`.",{"_3699":74089,"_31384":73879,"_21647":124440,"_5":14929,"_28559":123927,"_3075":54986},[],{"_3699":74090,"_31384":73879,"_21647":124442,"_5":14929,"_28559":123927,"_3075":124443},[],"RSA o ECDSA. El perfil de emisión debe permitir el algoritmo y el tamaño elegidos.",{"_3699":74091,"_31384":73879,"_21647":124445,"_5":14929,"_28559":123927,"_3075":54992},[],{"_3699":74092,"_31384":73879,"_21647":124447,"_5":14929,"_28559":123927,"_3075":124448},[],"Tamaño del módulo para RSA o curva para ECDSA. La consola ofrece RSA de 2048, 3072 y 4096 bits (4096 por defecto) y ECDSA P-256, P-384 y P-521 (P-256 por defecto).",{"_3699":74093,"_31384":73879,"_21647":124450,"_5":14929,"_28559":123927,"_3075":124451},[],"Para ECDSA, el servicio también reconoce los valores 224, 256, 384 y 521 como P-224, P-256, P-384 y P-521, y un valor desconocido selecciona P-256. Elige un tamaño compatible y comprueba la clave resultante.",{"_3699":74094,"_31384":73879,"_21647":124453,"_5":14929,"_28559":123930,"_3075":124454},[],"Envía una CSR PKCS#10 DER codificada en Base64 con `Content-Type: application/pkcs10`. La respuesta usa el formato multipart de esta operación incluso si se solicita PEM mediante `Accept`. La clave se genera en software aunque la CA firme con una clave alojada en HSM.",{"_3699":74095,"_31384":73879,"_21647":124456,"_5":14929,"_28559":123930,"_3075":124457},[],"El cuerpo es **MIME multipart/mixed**, con el boundary indicado en `Content-Type`, y tiene dos partes:",{"_3699":74096,"_31384":73879,"_21647":124459,"_5":14929,"_28559":123930,"_3075":124460},[],"Parte",{"_3699":74097,"_31384":73879,"_21647":124462,"_5":14929,"_28559":123930,"_3075":124463},[],"Contenido tras decodificar su Base64",{"_3699":74098,"_31384":73879,"_21647":124465,"_5":14929,"_28559":123930,"_3075":55013},[],{"_3699":74099,"_31384":73879,"_21647":124467,"_5":14929,"_28559":123930,"_3075":124468},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3699":74100,"_31384":73879,"_21647":124470,"_5":14929,"_28559":123930,"_3075":55019},[],{"_3699":74101,"_31384":73879,"_21647":124472,"_5":14929,"_28559":123930,"_3075":124473},[],"PKCS#7 DER con el certificado emitido.",{"_3699":74102,"_31384":73879,"_21647":124475,"_5":14929,"_28559":123930,"_3075":124476},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3699":74103,"_31384":73879,"_21647":124478,"_5":14929,"_28559":123933,"_3075":124479},[],"El ejemplo usa `EST_BASE` y los archivos de confianza y bootstrap de Antes de empezar. Elige un ID libre y admitido, como `est-serverkeygen-001`. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3699":74104,"_31384":73879,"_21647":124481,"_5":14929,"_28559":123933,"_3075":124482},[],"Procesa las partes MIME según sus cabeceras y comprueba que la clave recibida corresponde al certificado. Inspecciona el CN, la serie, las fechas y los usos, y comprueba la asociación en Lamassu antes de instalar. Protege los archivos que contienen la clave y elimina las copias temporales según el almacenamiento del dispositivo.",{"_3699":74105,"_31384":73879,"_21647":124484,"_5":14929,"_28559":123933,"_3075":124485},[],"<Card title=\"Autenticación y confianza\" description=\"Credenciales bootstrap, contrato del webhook y comprobaciones de revocación.\" href=\"/docs/platform/iot-fleets/est/bootstrap-identity\" />",{"_3699":74106,"_31384":73879,"_21647":124487,"_5":14929,"_28559":123933,"_3075":124488},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta el slot, el historial y el estado de cada identidad emitida.\" href=\"/docs/platform/iot-fleets/device-management\" />",{"_3699":74107,"_31384":73879,"_21647":124490,"_5":14929,"_28559":123933,"_3075":124491},[],"<Card title=\"Diagnóstico de enrolamiento\" description=\"Localiza fallos de transporte, autenticación, registro, emisión e instalación.\" href=\"/docs/platform/iot-fleets/est/troubleshooting\" />",{"_3699":74108,"_31384":74108,"_5":15283,"_3075":124493,"_31709":124494,"_21647":124495,"_28559":74108},"Referencia EST",[51094,122172,53807,54269],[],{"_3699":74109,"_31384":74108,"_21647":124497,"_5":14929,"_28559":74108,"_3075":124498},[],"El protocolo Enrollment over Secure Transport definido en RFC 7030.",{"_3699":74110,"_31384":74108,"_5":31706,"_21647":124500,"_28559":124501,"_3075":124502},[],"/docs/es/platform/iot-fleets/est#operaciones","Operaciones",{"_3699":74111,"_31384":74108,"_5":31706,"_21647":124504,"_28559":124505,"_3075":124506},[],"/docs/es/platform/iot-fleets/est#autenticación-y-mensajes","Autenticación y mensajes",{"_3699":74112,"_31384":74108,"_21647":124508,"_5":14929,"_28559":74108,"_3075":124509},[],"Enrollment over Secure Transport (EST) es un protocolo para obtener y renovar certificados X.509 mediante HTTPS. Un cliente EST se comunica con un servidor EST, que gestiona la solicitud de certificado y facilita los certificados de las autoridades de certificación. El estándar define mensajes, operaciones y mecanismos de autenticación. RFC 7030",{"_3699":74113,"_31384":74108,"_21647":124511,"_5":14929,"_28559":124501,"_3075":124512},[],"Las rutas de operación se añaden al prefijo `/.well-known/est`, que puede incluir una etiqueta para identificar la CA o el servicio.",{"_3699":74114,"_31384":74108,"_21647":124514,"_5":14929,"_28559":124501,"_3075":121932},[],{"_3699":74115,"_31384":74108,"_21647":124516,"_5":14929,"_28559":124501,"_3075":123944},[],{"_3699":74116,"_31384":74108,"_21647":124518,"_5":14929,"_28559":124501,"_3075":124519},[],"Función",{"_3699":74117,"_31384":74108,"_21647":124521,"_5":14929,"_28559":124501,"_3075":124522},[],"Soporte del servidor",{"_3699":74118,"_31384":74108,"_21647":124524,"_5":14929,"_28559":124501,"_3075":54453},[],{"_3699":74119,"_31384":74108,"_21647":124526,"_5":14929,"_28559":124501,"_3075":54456},[],{"_3699":74120,"_31384":74108,"_21647":124528,"_5":14929,"_28559":124501,"_3075":124529},[],"Obtener certificados de CA.",{"_3699":74121,"_31384":74108,"_21647":124531,"_5":14929,"_28559":124501,"_3075":124532},[],"Obligatorio",{"_3699":74122,"_31384":74108,"_21647":124534,"_5":14929,"_28559":124501,"_3075":54462},[],{"_3699":74123,"_31384":74108,"_21647":124536,"_5":14929,"_28559":124501,"_3075":54465},[],{"_3699":74124,"_31384":74108,"_21647":124538,"_5":14929,"_28559":124501,"_3075":124539},[],"Solicitar un certificado inicial mediante una CSR.",{"_3699":74125,"_31384":74108,"_21647":124541,"_5":14929,"_28559":124501,"_3075":124532},[],{"_3699":74126,"_31384":74108,"_21647":124543,"_5":14929,"_28559":124501,"_3075":54471},[],{"_3699":74127,"_31384":74108,"_21647":124545,"_5":14929,"_28559":124501,"_3075":54465},[],{"_3699":74128,"_31384":74108,"_21647":124547,"_5":14929,"_28559":124501,"_3075":124548},[],"Solicitar la renovación o sustitución de clave de un certificado.",{"_3699":74129,"_31384":74108,"_21647":124550,"_5":14929,"_28559":124501,"_3075":124532},[],{"_3699":74130,"_31384":74108,"_21647":124552,"_5":14929,"_28559":124501,"_3075":54479},[],{"_3699":74131,"_31384":74108,"_21647":124554,"_5":14929,"_28559":124501,"_3075":54465},[],{"_3699":74132,"_31384":74108,"_21647":124556,"_5":14929,"_28559":124501,"_3075":124557},[],"Solicitar una clave generada por el servidor y el certificado asociado.",{"_3699":74133,"_31384":74108,"_21647":124559,"_5":14929,"_28559":124501,"_3075":124560},[],"Opcional",{"_3699":74134,"_31384":74108,"_21647":124562,"_5":14929,"_28559":124501,"_3075":55110},[],{"_3699":74135,"_31384":74108,"_21647":124564,"_5":14929,"_28559":124501,"_3075":54456},[],{"_3699":74136,"_31384":74108,"_21647":124566,"_5":14929,"_28559":124501,"_3075":124567},[],"Consultar atributos sugeridos para la CSR.",{"_3699":74137,"_31384":74108,"_21647":124569,"_5":14929,"_28559":124501,"_3075":124560},[],{"_3699":74138,"_31384":74108,"_21647":124571,"_5":14929,"_28559":124501,"_3075":55120},[],{"_3699":74139,"_31384":74108,"_21647":124573,"_5":14929,"_28559":124501,"_3075":54465},[],{"_3699":74140,"_31384":74108,"_21647":124575,"_5":14929,"_28559":124501,"_3075":124576},[],"Enviar una solicitud Full CMC.",{"_3699":74141,"_31384":74108,"_21647":124578,"_5":14929,"_28559":124501,"_3075":124560},[],{"_3699":74142,"_31384":74108,"_21647":124580,"_5":14929,"_28559":124505,"_3075":124581},[],"EST utiliza TLS para proteger el intercambio. El cliente autentica al servidor y el servidor autentica y autoriza al cliente mediante los mecanismos definidos por el estándar. La distribución inicial de certificados de CA tiene condiciones particulares para establecer la confianza. RFC 7030, secciones 3.3 y 4.1",{"_3699":74143,"_31384":74108,"_21647":124583,"_5":14929,"_28559":124505,"_3075":124584},[],"Las solicitudes de `/simpleenroll` y `/simplereenroll` utilizan una CSR PKCS#10. La respuesta de certificado utiliza PKCS#7. La respuesta de `/serverkeygen` es `multipart/mixed` y contiene la clave y el certificado. El estándar también define la solicitud y la respuesta Full CMC y el formato de atributos de CSR. RFC 7030, sección 3.2.4",{"_3699":74144,"_31384":74108,"_21647":124586,"_5":14929,"_28559":124505,"_3075":124587},[],"Consulta EST en Lamassu para conocer las operaciones disponibles y su configuración.",{"_3699":74145,"_31384":74145,"_5":15283,"_3075":124589,"_31709":124590,"_21647":124591,"_28559":74145},"Diagnóstico de enrolamiento",[51094,122172,53807,54269],[],{"_3699":74146,"_31384":74145,"_21647":124593,"_5":14929,"_28559":74145,"_3075":124594},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3699":74147,"_31384":74145,"_5":31706,"_21647":124596,"_28559":124597,"_3075":124598},[],"/docs/es/platform/iot-fleets/est/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3699":74148,"_31384":74145,"_5":31706,"_21647":124600,"_28559":124601,"_3075":124602},[],"/docs/es/platform/iot-fleets/est/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3699":74149,"_31384":74145,"_5":31706,"_21647":124604,"_28559":124605,"_3075":124606},[],"/docs/es/platform/iot-fleets/est/troubleshooting#notas-de-compatibilidad","Notas de compatibilidad",{"_3699":74150,"_31384":74145,"_5":31706,"_21647":124608,"_28559":124609,"_3075":124610},[],"/docs/es/platform/iot-fleets/est/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3699":74151,"_31384":74145,"_21647":124612,"_5":14929,"_28559":74145,"_3075":124613},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3699":74152,"_31384":74145,"_21647":124615,"_5":14929,"_28559":124601,"_3075":124616},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3699":74153,"_31384":74145,"_21647":124618,"_5":14929,"_28559":124601,"_3075":124619},[],"Síntoma o mensaje",{"_3699":74154,"_31384":74145,"_21647":124621,"_5":14929,"_28559":124601,"_3075":124622},[],"Qué revisar",{"_3699":74155,"_31384":74145,"_21647":124624,"_5":14929,"_28559":124601,"_3075":124625},[],"curl rechaza TLS, nombre o emisor",{"_3699":74156,"_31384":74145,"_21647":124627,"_5":14929,"_28559":124601,"_3075":124628},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3699":74157,"_31384":74145,"_21647":124630,"_5":14929,"_28559":124601,"_3075":124631},[],"404 o APS ausente",{"_3699":74158,"_31384":74145,"_21647":124633,"_5":14929,"_28559":124601,"_3075":124634},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3699":74159,"_31384":74145,"_21647":124636,"_5":14929,"_28559":124601,"_3075":124637},[],"400, error de CSR o formato",{"_3699":74160,"_31384":74145,"_21647":124639,"_5":14929,"_28559":124601,"_3075":124640},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3699":74161,"_31384":74145,"_21647":124642,"_5":14929,"_28559":124601,"_3075":124643},[],"Credencial ausente o certificado no válido",{"_3699":74162,"_31384":74145,"_21647":124645,"_5":14929,"_28559":124601,"_3075":124646},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3699":74163,"_31384":74145,"_21647":124648,"_5":14929,"_28559":124601,"_3075":124649},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3699":74164,"_31384":74145,"_21647":124651,"_5":14929,"_28559":124601,"_3075":124652},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3699":74165,"_31384":74145,"_21647":124654,"_5":14929,"_28559":124601,"_3075":124655},[],"Webhook deniega, expira o responde sin autorización",{"_3699":74166,"_31384":74145,"_21647":124657,"_5":14929,"_28559":124601,"_3075":124658},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3699":74167,"_31384":74145,"_21647":124660,"_5":14929,"_28559":124601,"_3075":55209},[],{"_3699":74168,"_31384":74145,"_21647":124662,"_5":14929,"_28559":124601,"_3075":124663},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3699":74169,"_31384":74145,"_21647":124665,"_5":14929,"_28559":124601,"_3075":55215},[],{"_3699":74170,"_31384":74145,"_21647":124667,"_5":14929,"_28559":124601,"_3075":124668},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3699":74171,"_31384":74145,"_21647":124670,"_5":14929,"_28559":124601,"_3075":55221},[],{"_3699":74172,"_31384":74145,"_21647":124672,"_5":14929,"_28559":124601,"_3075":124673},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3699":74173,"_31384":74145,"_21647":124675,"_5":14929,"_28559":124601,"_3075":55227},[],{"_3699":74174,"_31384":74145,"_21647":124677,"_5":14929,"_28559":124601,"_3075":124678},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3699":74175,"_31384":74145,"_21647":124680,"_5":14929,"_28559":124601,"_3075":55233},[],{"_3699":74176,"_31384":74145,"_21647":124682,"_5":14929,"_28559":124601,"_3075":124683},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3699":74177,"_31384":74145,"_21647":124685,"_5":14929,"_28559":124601,"_3075":124686},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3699":74178,"_31384":74145,"_21647":124688,"_5":14929,"_28559":124601,"_3075":124689},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3699":74179,"_31384":74145,"_21647":124691,"_5":14929,"_28559":124601,"_3075":124692},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3699":74180,"_31384":74145,"_21647":124694,"_5":14929,"_28559":124601,"_3075":124695},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3699":74181,"_31384":74145,"_21647":124697,"_5":14929,"_28559":124601,"_3075":55251},[],{"_3699":74182,"_31384":74145,"_21647":124699,"_5":14929,"_28559":124601,"_3075":124700},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3699":74183,"_31384":74145,"_21647":124702,"_5":14929,"_28559":124601,"_3075":55257},[],{"_3699":74184,"_31384":74145,"_21647":124704,"_5":14929,"_28559":124601,"_3075":124705},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3699":74185,"_31384":74145,"_21647":124707,"_5":14929,"_28559":124601,"_3075":124708},[],"DMS propietario distinto",{"_3699":74186,"_31384":74145,"_21647":124710,"_5":14929,"_28559":124601,"_3075":124711},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3699":74187,"_31384":74145,"_21647":124713,"_5":14929,"_28559":124601,"_3075":55269},[],{"_3699":74188,"_31384":74145,"_21647":124715,"_5":14929,"_28559":124601,"_3075":124716},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3699":74189,"_31384":74145,"_21647":124718,"_5":14929,"_28559":124601,"_3075":55275},[],{"_3699":74190,"_31384":74145,"_21647":124720,"_5":14929,"_28559":124601,"_3075":124721},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3699":74191,"_31384":74145,"_21647":124723,"_5":14929,"_28559":124601,"_3075":124724},[],"Certificado actual revocado",{"_3699":74192,"_31384":74145,"_21647":124726,"_5":14929,"_28559":124601,"_3075":124727},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3699":74193,"_31384":74145,"_21647":124729,"_5":14929,"_28559":124601,"_3075":124730},[],"Error de CA, perfil o firma",{"_3699":74194,"_31384":74145,"_21647":124732,"_5":14929,"_28559":124601,"_3075":124733},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3699":74195,"_31384":74145,"_21647":124735,"_5":14929,"_28559":124601,"_3075":124736},[],"HTTP 200 sin conexión del dispositivo",{"_3699":74196,"_31384":74145,"_21647":124738,"_5":14929,"_28559":124601,"_3075":124739},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3699":74197,"_31384":74145,"_21647":124741,"_5":14929,"_28559":124601,"_3075":124742},[],"Timeout o error después de emitir",{"_3699":74198,"_31384":74145,"_21647":124744,"_5":14929,"_28559":124601,"_3075":124745},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3699":74199,"_31384":74145,"_21647":124747,"_5":14929,"_28559":124605,"_3075":124748},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3699":74200,"_31384":74145,"_21647":124750,"_5":14929,"_28559":124605,"_3075":124751},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la guía de EST en Lamassu.",{"_3699":74201,"_31384":74145,"_21647":124753,"_5":14929,"_28559":124609,"_3075":124754},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3699":74202,"_31384":74145,"_21647":124756,"_5":14929,"_28559":124609,"_3075":124757},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3699":74203,"_31384":74145,"_21647":124759,"_5":14929,"_28559":124609,"_3075":124760},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3699":74204,"_31384":74145,"_21647":124762,"_5":14929,"_28559":124609,"_3075":124763},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3699":74205,"_31384":74145,"_21647":124765,"_5":14929,"_28559":124609,"_3075":124766},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3699":74206,"_31384":74145,"_21647":124768,"_5":14929,"_28559":124609,"_3075":124769},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse (incluido un estado OCSP Unknown) se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3699":74207,"_31384":74145,"_21647":124771,"_5":14929,"_28559":124609,"_3075":124772},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3699":74208,"_31384":74208,"_5":15283,"_3075":55331,"_31709":124774,"_21647":124776,"_28559":74208},[51094,122172,53807,123317,124775],"Integraciones",[],{"_3699":74209,"_31384":74208,"_21647":124778,"_5":14929,"_28559":74208,"_3075":124779},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3699":74210,"_31384":74208,"_5":31706,"_21647":124781,"_28559":124782,"_3075":124783},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3699":74211,"_31384":74208,"_5":31706,"_21647":124785,"_28559":124786,"_3075":124787},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3699":74212,"_31384":74208,"_5":31706,"_21647":124789,"_28559":124790,"_3075":124791},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3699":74213,"_31384":74208,"_5":31706,"_21647":124793,"_28559":124794,"_3075":124795},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3699":74214,"_31384":74208,"_5":31706,"_21647":124797,"_28559":124798,"_3075":124799},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3699":74215,"_31384":74208,"_5":31706,"_21647":124801,"_28559":124802,"_3075":124803},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3699":74216,"_31384":74208,"_5":31706,"_21647":124805,"_28559":124806,"_3075":124807},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3699":74217,"_31384":74208,"_5":31706,"_21647":124809,"_28559":124810,"_3075":124811},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3699":74218,"_31384":74208,"_5":31706,"_21647":124813,"_28559":124814,"_3075":55373},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3699":74219,"_31384":74208,"_5":31706,"_21647":124816,"_28559":124817,"_3075":55377},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3699":74220,"_31384":74208,"_5":31706,"_21647":124819,"_28559":124820,"_3075":124821},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3699":74221,"_31384":74208,"_5":31706,"_21647":124823,"_28559":124824,"_3075":124825},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3699":74222,"_31384":74208,"_5":31706,"_21647":124827,"_28559":124828,"_3075":124829},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3699":74223,"_31384":74208,"_5":31706,"_21647":124831,"_28559":124832,"_3075":124833},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3699":74224,"_31384":74208,"_5":31706,"_21647":124835,"_28559":124836,"_3075":124837},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3699":74225,"_31384":74208,"_5":31706,"_21647":124839,"_28559":124840,"_3075":124841},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3699":74226,"_31384":74208,"_5":31706,"_21647":124843,"_28559":124844,"_3075":124845},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3699":74227,"_31384":74208,"_5":31706,"_21647":124847,"_28559":124848,"_3075":124849},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3699":74228,"_31384":74208,"_5":31706,"_21647":124851,"_28559":124852,"_3075":124853},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3699":74229,"_31384":74208,"_5":31706,"_21647":124855,"_28559":124856,"_3075":124857},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3699":74230,"_31384":74208,"_5":31706,"_21647":124859,"_28559":124860,"_3075":124861},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3699":74231,"_31384":74208,"_5":31706,"_21647":124863,"_28559":124864,"_3075":124865},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3699":74232,"_31384":74208,"_5":31706,"_21647":124867,"_28559":124868,"_3075":124869},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3699":74233,"_31384":74208,"_5":31706,"_21647":124871,"_28559":124872,"_3075":124873},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3699":74234,"_31384":74208,"_5":31706,"_21647":124875,"_28559":124876,"_3075":124877},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3699":74235,"_31384":74208,"_21647":124879,"_5":14929,"_28559":74208,"_3075":124880},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3699":74236,"_31384":74208,"_21647":124882,"_5":14929,"_28559":74208,"_3075":124883},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3699":74237,"_31384":74208,"_21647":124885,"_5":14929,"_28559":74208,"_3075":124886},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3699":74238,"_31384":74208,"_21647":124888,"_5":14929,"_28559":124782,"_3075":124889},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3699":74239,"_31384":74208,"_21647":124891,"_5":14929,"_28559":124782,"_3075":124892},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3699":74240,"_31384":74208,"_21647":124894,"_5":14929,"_28559":124782,"_3075":124895},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3699":74241,"_31384":74208,"_21647":124897,"_5":14929,"_28559":124782,"_3075":124898},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3699":74242,"_31384":74208,"_21647":124900,"_5":14929,"_28559":124786,"_3075":124901},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3699":74243,"_31384":74208,"_21647":124903,"_5":14929,"_28559":124790,"_3075":124904},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3699":74244,"_31384":74208,"_21647":124906,"_5":14929,"_28559":124790,"_3075":124907},[],"Acción IAM",{"_3699":74245,"_31384":74208,"_21647":124909,"_5":14929,"_28559":124790,"_3075":121047},[],{"_3699":74246,"_31384":74208,"_21647":124911,"_5":14929,"_28559":124790,"_3075":55472},[],{"_3699":74247,"_31384":74208,"_21647":124913,"_5":14929,"_28559":124790,"_3075":124914},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3699":74248,"_31384":74208,"_21647":124916,"_5":14929,"_28559":124790,"_3075":55478},[],{"_3699":74249,"_31384":74208,"_21647":124918,"_5":14929,"_28559":124790,"_3075":124919},[],"Registrar la CA en AWS IoT",{"_3699":74250,"_31384":74208,"_21647":124921,"_5":14929,"_28559":124790,"_3075":55484},[],{"_3699":74251,"_31384":74208,"_21647":124923,"_5":14929,"_28559":124790,"_3075":124924},[],"Consultar el estado del registro de la CA",{"_3699":74252,"_31384":74208,"_21647":124926,"_5":14929,"_28559":124790,"_3075":55490},[],{"_3699":74253,"_31384":74208,"_21647":124928,"_5":14929,"_28559":124790,"_3075":124929},[],"Crear o actualizar Things en IoT Core",{"_3699":74254,"_31384":74208,"_21647":124931,"_5":14929,"_28559":124790,"_3075":55496},[],{"_3699":74255,"_31384":74208,"_21647":124933,"_5":14929,"_28559":124790,"_3075":124934},[],"Aprovisionar Things mediante plantilla",{"_3699":74256,"_31384":74208,"_21647":124936,"_5":14929,"_28559":124790,"_3075":55502},[],{"_3699":74257,"_31384":74208,"_21647":124938,"_5":14929,"_28559":124790,"_3075":124939},[],"Registrar certificados de dispositivo",{"_3699":74258,"_31384":74208,"_21647":124941,"_5":14929,"_28559":124790,"_3075":55508},[],{"_3699":74259,"_31384":74208,"_21647":124943,"_5":14929,"_28559":124790,"_3075":124944},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3699":74260,"_31384":74208,"_21647":124946,"_5":14929,"_28559":124790,"_3075":55514},[],{"_3699":74261,"_31384":74208,"_21647":124948,"_5":14929,"_28559":124790,"_3075":124949},[],"Crear y adjuntar políticas IoT",{"_3699":74262,"_31384":74208,"_21647":124951,"_5":14929,"_28559":124790,"_3075":55520},[],{"_3699":74263,"_31384":74208,"_21647":124953,"_5":14929,"_28559":124790,"_3075":124954},[],"Gestionar grupos de Things",{"_3699":74264,"_31384":74208,"_21647":124956,"_5":14929,"_28559":124790,"_3075":55526},[],{"_3699":74265,"_31384":74208,"_21647":124958,"_5":14929,"_28559":124790,"_3075":124959},[],"Crear plantillas JITP",{"_3699":74266,"_31384":74208,"_21647":124961,"_5":14929,"_28559":124790,"_3075":55532},[],{"_3699":74267,"_31384":74208,"_21647":124963,"_5":14929,"_28559":124790,"_3075":124964},[],"Leer y escribir el Device Shadow",{"_3699":74268,"_31384":74208,"_21647":124966,"_5":14929,"_28559":124790,"_3075":124967},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3699":74269,"_31384":74208,"_21647":124969,"_5":14929,"_28559":124794,"_3075":124970},[],"Parámetro",{"_3699":74270,"_31384":74208,"_21647":124972,"_5":14929,"_28559":124794,"_3075":124973},[],"Tipo",{"_3699":74271,"_31384":74208,"_21647":124975,"_5":14929,"_28559":124794,"_3075":124976},[],"Requerido",{"_3699":74272,"_31384":74208,"_21647":124978,"_5":14929,"_28559":124794,"_3075":124027},[],{"_3699":74273,"_31384":74208,"_21647":124980,"_5":14929,"_28559":124794,"_3075":55552},[],{"_3699":74274,"_31384":74208,"_21647":124982,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74275,"_31384":74208,"_21647":124984,"_5":14929,"_28559":124794,"_3075":124985},[],"Sí",{"_3699":74276,"_31384":74208,"_21647":124987,"_5":14929,"_28559":124794,"_3075":124988},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3699":74277,"_31384":74208,"_21647":124990,"_5":14929,"_28559":124794,"_3075":55563},[],{"_3699":74278,"_31384":74208,"_21647":124992,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74279,"_31384":74208,"_21647":124994,"_5":14929,"_28559":124794,"_3075":124985},[],{"_3699":74280,"_31384":74208,"_21647":124996,"_5":14929,"_28559":124794,"_3075":124997},[],"Región AWS donde opera el conector.",{"_3699":74281,"_31384":74208,"_21647":124999,"_5":14929,"_28559":124794,"_3075":55573},[],{"_3699":74282,"_31384":74208,"_21647":125001,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74283,"_31384":74208,"_21647":125003,"_5":14929,"_28559":124794,"_3075":124985},[],{"_3699":74284,"_31384":74208,"_21647":125005,"_5":14929,"_28559":124794,"_3075":125006},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3699":74285,"_31384":74208,"_21647":125008,"_5":14929,"_28559":124794,"_3075":55583},[],{"_3699":74286,"_31384":74208,"_21647":125010,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74287,"_31384":74208,"_21647":125012,"_5":14929,"_28559":124794,"_3075":125013},[],"Solo con `auth_method=static`",{"_3699":74288,"_31384":74208,"_21647":125015,"_5":14929,"_28559":124794,"_3075":125016},[],"Clave de acceso AWS.",{"_3699":74289,"_31384":74208,"_21647":125018,"_5":14929,"_28559":124794,"_3075":55594},[],{"_3699":74290,"_31384":74208,"_21647":125020,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74291,"_31384":74208,"_21647":125022,"_5":14929,"_28559":124794,"_3075":125013},[],{"_3699":74292,"_31384":74208,"_21647":125024,"_5":14929,"_28559":124794,"_3075":125025},[],"Clave secreta AWS.",{"_3699":74293,"_31384":74208,"_21647":125027,"_5":14929,"_28559":124794,"_3075":55604},[],{"_3699":74294,"_31384":74208,"_21647":125029,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74295,"_31384":74208,"_21647":125031,"_5":14929,"_28559":124794,"_3075":55609},[],{"_3699":74296,"_31384":74208,"_21647":125033,"_5":14929,"_28559":124794,"_3075":125034},[],"Token de sesión (con `auth_method=static`).",{"_3699":74297,"_31384":74208,"_21647":125036,"_5":14929,"_28559":124794,"_3075":55615},[],{"_3699":74298,"_31384":74208,"_21647":125038,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74299,"_31384":74208,"_21647":125040,"_5":14929,"_28559":124794,"_3075":125041},[],"Solo con `auth_method=role`",{"_3699":74300,"_31384":74208,"_21647":125043,"_5":14929,"_28559":124794,"_3075":125044},[],"ARN del rol a asumir.",{"_3699":74301,"_31384":74208,"_21647":125046,"_5":14929,"_28559":124794,"_3075":55626},[],{"_3699":74302,"_31384":74208,"_21647":125048,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74303,"_31384":74208,"_21647":125050,"_5":14929,"_28559":124794,"_3075":55609},[],{"_3699":74304,"_31384":74208,"_21647":125052,"_5":14929,"_28559":124794,"_3075":125053},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3699":74305,"_31384":74208,"_21647":125055,"_5":14929,"_28559":124794,"_3075":55636},[],{"_3699":74306,"_31384":74208,"_21647":125057,"_5":14929,"_28559":124794,"_3075":93207},[],{"_3699":74307,"_31384":74208,"_21647":125059,"_5":14929,"_28559":124794,"_3075":124985},[],{"_3699":74308,"_31384":74208,"_21647":125061,"_5":14929,"_28559":124794,"_3075":125062},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3699":74309,"_31384":74208,"_21647":125064,"_5":14929,"_28559":124794,"_3075":55646},[],{"_3699":74310,"_31384":74208,"_21647":125066,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74311,"_31384":74208,"_21647":125068,"_5":14929,"_28559":124794,"_3075":124985},[],{"_3699":74312,"_31384":74208,"_21647":125070,"_5":14929,"_28559":124794,"_3075":125071},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3699":74313,"_31384":74208,"_21647":125073,"_5":14929,"_28559":124794,"_3075":55656},[],{"_3699":74314,"_31384":74208,"_21647":125075,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74315,"_31384":74208,"_21647":125077,"_5":14929,"_28559":124794,"_3075":124985},[],{"_3699":74316,"_31384":74208,"_21647":125079,"_5":14929,"_28559":124794,"_3075":125080},[],"URL HTTP del Device Manager de Lamassu.",{"_3699":74317,"_31384":74208,"_21647":125082,"_5":14929,"_28559":124794,"_3075":55666},[],{"_3699":74318,"_31384":74208,"_21647":125084,"_5":14929,"_28559":124794,"_3075":25872},[],{"_3699":74319,"_31384":74208,"_21647":125086,"_5":14929,"_28559":124794,"_3075":124985},[],{"_3699":74320,"_31384":74208,"_21647":125088,"_5":14929,"_28559":124794,"_3075":125089},[],"URL HTTP del servicio de CA de Lamassu.",{"_3699":74321,"_31384":74208,"_21647":125091,"_5":14929,"_28559":124798,"_3075":125092},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3699":74322,"_31384":74208,"_21647":125094,"_5":14929,"_28559":124798,"_3075":125095},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3699":74323,"_31384":74208,"_21647":125097,"_5":14929,"_28559":124798,"_3075":125098},[],"Tipo de CloudEvent",{"_3699":74324,"_31384":74208,"_21647":125100,"_5":14929,"_28559":124798,"_3075":125101},[],"Recurso en Lamassu",{"_3699":74325,"_31384":74208,"_21647":125103,"_5":14929,"_28559":124798,"_3075":125104},[],"Recurso AWS",{"_3699":74326,"_31384":74208,"_21647":125106,"_5":14929,"_28559":124798,"_3075":125107},[],"Acciones IAM",{"_3699":74327,"_31384":74208,"_21647":125109,"_5":14929,"_28559":124798,"_3075":125110},[],"Llamadas AWS y efecto",{"_3699":74328,"_31384":74208,"_21647":125112,"_5":14929,"_28559":124798,"_3075":125113},[],"Dónde en esta página",{"_3699":74329,"_31384":74208,"_21647":125115,"_5":14929,"_28559":124798,"_3075":55700},[],{"_3699":74330,"_31384":74208,"_21647":125117,"_5":14929,"_28559":124798,"_3075":55703},[],{"_3699":74331,"_31384":74208,"_21647":125119,"_5":14929,"_28559":124798,"_3075":55706},[],{"_3699":74332,"_31384":74208,"_21647":125121,"_5":14929,"_28559":124798,"_3075":55709},[],{"_3699":74333,"_31384":74208,"_21647":125123,"_5":14929,"_28559":124798,"_3075":125124},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3699":74334,"_31384":74208,"_21647":125126,"_5":14929,"_28559":124798,"_3075":124811},[],{"_3699":74335,"_31384":74208,"_21647":125128,"_5":14929,"_28559":124798,"_3075":55717},[],{"_3699":74336,"_31384":74208,"_21647":125130,"_5":14929,"_28559":124798,"_3075":55720},[],{"_3699":74337,"_31384":74208,"_21647":125132,"_5":14929,"_28559":124798,"_3075":55723},[],{"_3699":74338,"_31384":74208,"_21647":125134,"_5":14929,"_28559":124798,"_3075":55726},[],{"_3699":74339,"_31384":74208,"_21647":125136,"_5":14929,"_28559":124798,"_3075":125137},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3699":74340,"_31384":74208,"_21647":125139,"_5":14929,"_28559":124798,"_3075":124837},[],{"_3699":74341,"_31384":74208,"_21647":125141,"_5":14929,"_28559":124798,"_3075":55734},[],{"_3699":74342,"_31384":74208,"_21647":125143,"_5":14929,"_28559":124798,"_3075":125144},[],"Dispositivo",{"_3699":74343,"_31384":74208,"_21647":125146,"_5":14929,"_28559":124798,"_3075":55740},[],{"_3699":74344,"_31384":74208,"_21647":125148,"_5":14929,"_28559":124798,"_3075":55743},[],{"_3699":74345,"_31384":74208,"_21647":125150,"_5":14929,"_28559":124798,"_3075":125151},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3699":74346,"_31384":74208,"_21647":125153,"_5":14929,"_28559":124798,"_3075":124845},[],{"_3699":74347,"_31384":74208,"_21647":125155,"_5":14929,"_28559":124798,"_3075":55751},[],{"_3699":74348,"_31384":74208,"_21647":125157,"_5":14929,"_28559":124798,"_3075":125158},[],"Certificado",{"_3699":74349,"_31384":74208,"_21647":125160,"_5":14929,"_28559":124798,"_3075":55757},[],{"_3699":74350,"_31384":74208,"_21647":125162,"_5":14929,"_28559":124798,"_3075":125163},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3699":74351,"_31384":74208,"_21647":125165,"_5":14929,"_28559":124798,"_3075":125166},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3699":74352,"_31384":74208,"_21647":125168,"_5":14929,"_28559":124798,"_3075":124857},[],{"_3699":74353,"_31384":74208,"_21647":125170,"_5":14929,"_28559":124798,"_3075":55768},[],{"_3699":74354,"_31384":74208,"_21647":125172,"_5":14929,"_28559":124798,"_3075":125173},[],"Certificado / Dispositivo",{"_3699":74355,"_31384":74208,"_21647":125175,"_5":14929,"_28559":124798,"_3075":55774},[],{"_3699":74356,"_31384":74208,"_21647":125177,"_5":14929,"_28559":124798,"_3075":51490},[],{"_3699":74357,"_31384":74208,"_21647":125179,"_5":14929,"_28559":124798,"_3075":125180},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3699":74358,"_31384":74208,"_21647":125182,"_5":14929,"_28559":124798,"_3075":124865},[],{"_3699":74359,"_31384":74208,"_21647":125184,"_5":14929,"_28559":124802,"_3075":125185},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3699":74360,"_31384":74208,"_21647":125187,"_5":14929,"_28559":124806,"_3075":125188},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3699":74361,"_31384":74208,"_21647":125190,"_5":14929,"_28559":124806,"_3075":125191},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3699":74362,"_31384":74208,"_21647":125193,"_5":14929,"_28559":124810,"_3075":125194},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3699":74363,"_31384":74208,"_21647":125196,"_5":14929,"_28559":124810,"_3075":125197},[],"Transición",{"_3699":74364,"_31384":74208,"_21647":125199,"_5":14929,"_28559":124810,"_3075":125200},[],"Llamadas AWS",{"_3699":74365,"_31384":74208,"_21647":125202,"_5":14929,"_28559":124810,"_3075":125203},[],"`NoRegistrada` → `Solicitada`",{"_3699":74366,"_31384":74208,"_21647":125205,"_5":14929,"_28559":124810,"_3075":125206},[],"ninguna (solo escritura de metadatos)",{"_3699":74367,"_31384":74208,"_21647":125208,"_5":14929,"_28559":124810,"_3075":125209},[],"`Solicitada` → `Registrando`",{"_3699":74368,"_31384":74208,"_21647":125211,"_5":14929,"_28559":124810,"_3075":125212},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3699":74369,"_31384":74208,"_21647":125214,"_5":14929,"_28559":124810,"_3075":125215},[],"`Registrando` → `Completada`",{"_3699":74370,"_31384":74208,"_21647":125217,"_5":14929,"_28559":124810,"_3075":125218},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3699":74371,"_31384":74208,"_21647":125220,"_5":14929,"_28559":124810,"_3075":125221},[],"`Registrando` → `Fallida`",{"_3699":74372,"_31384":74208,"_21647":125223,"_5":14929,"_28559":124810,"_3075":125224},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3699":74373,"_31384":74208,"_21647":125226,"_5":14929,"_28559":124810,"_3075":125227},[],"`Fallida` / `Completada` → `Solicitada`",{"_3699":74374,"_31384":74208,"_21647":125229,"_5":14929,"_28559":124810,"_3075":125230},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3699":74375,"_31384":74208,"_21647":125232,"_5":14929,"_28559":124814,"_3075":125233},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3699":74376,"_31384":74208,"_21647":125235,"_5":14929,"_28559":124814,"_3075":125236},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3699":74377,"_31384":74208,"_21647":125238,"_5":14929,"_28559":124814,"_3075":125239},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3699":74378,"_31384":74208,"_21647":125241,"_5":14929,"_28559":124814,"_3075":125242},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3699":74379,"_31384":74208,"_21647":125244,"_5":14929,"_28559":124814,"_3075":125245},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3699":74380,"_31384":74208,"_21647":125247,"_5":14929,"_28559":124814,"_3075":125248},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3699":74381,"_31384":74208,"_21647":125250,"_5":14929,"_28559":124817,"_3075":125251},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3699":74382,"_31384":74208,"_21647":125253,"_5":14929,"_28559":124820,"_3075":125254},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3699":74383,"_31384":74208,"_21647":125256,"_5":14929,"_28559":124820,"_3075":125257},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3699":74384,"_31384":74208,"_21647":125259,"_5":14929,"_28559":124824,"_3075":125260},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3699":74385,"_31384":74208,"_21647":125262,"_5":14929,"_28559":124828,"_3075":125263},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3699":74386,"_31384":74208,"_21647":125265,"_5":14929,"_28559":124828,"_3075":125266},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3699":74387,"_31384":74208,"_21647":125268,"_5":14929,"_28559":124828,"_3075":125269},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3699":74388,"_31384":74208,"_21647":125271,"_5":14929,"_28559":124828,"_3075":125272},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3699":74389,"_31384":74208,"_21647":125274,"_5":14929,"_28559":124828,"_3075":125275},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3699":74390,"_31384":74208,"_21647":125277,"_5":14929,"_28559":124828,"_3075":125278},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3699":74391,"_31384":74208,"_21647":125280,"_5":14929,"_28559":124832,"_3075":125281},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3699":74392,"_31384":74208,"_21647":125283,"_5":14929,"_28559":124832,"_3075":125284},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3699":74393,"_31384":74208,"_21647":125286,"_5":14929,"_28559":124832,"_3075":125287},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3699":74394,"_31384":74208,"_21647":125289,"_5":14929,"_28559":124832,"_3075":125290},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3699":74395,"_31384":74208,"_21647":125292,"_5":14929,"_28559":124832,"_3075":125293},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3699":74396,"_31384":74208,"_21647":125295,"_5":14929,"_28559":124836,"_3075":125296},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3699":74397,"_31384":74208,"_21647":125298,"_5":14929,"_28559":124836,"_3075":125197},[],{"_3699":74398,"_31384":74208,"_21647":125300,"_5":14929,"_28559":124836,"_3075":125200},[],{"_3699":74399,"_31384":74208,"_21647":125302,"_5":14929,"_28559":124836,"_3075":125303},[],"`SinConfigurar` → `None` / `Auto`",{"_3699":74400,"_31384":74208,"_21647":125305,"_5":14929,"_28559":124836,"_3075":125306},[],"ninguna (solo configuración)",{"_3699":74401,"_31384":74208,"_21647":125308,"_5":14929,"_28559":124836,"_3075":55911},[],{"_3699":74402,"_31384":74208,"_21647":125310,"_5":14929,"_28559":124836,"_3075":125306},[],{"_3699":74403,"_31384":74208,"_21647":125312,"_5":14929,"_28559":124836,"_3075":125313},[],"Cualquiera → `Jitp`",{"_3699":74404,"_31384":74208,"_21647":125315,"_5":14929,"_28559":124836,"_3075":125316},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3699":74405,"_31384":74208,"_21647":125318,"_5":14929,"_28559":124836,"_3075":55922},[],{"_3699":74406,"_31384":74208,"_21647":125320,"_5":14929,"_28559":124836,"_3075":125321},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3699":74407,"_31384":74208,"_21647":125323,"_5":14929,"_28559":124840,"_3075":125324},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3699":74408,"_31384":74208,"_21647":125326,"_5":14929,"_28559":124840,"_3075":125327},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3699":74409,"_31384":74208,"_21647":125329,"_5":14929,"_28559":124840,"_3075":125330},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3699":74410,"_31384":74208,"_21647":125332,"_5":14929,"_28559":124844,"_3075":125333},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3699":74411,"_31384":74208,"_21647":125335,"_5":14929,"_28559":124844,"_3075":125197},[],{"_3699":74412,"_31384":74208,"_21647":125337,"_5":14929,"_28559":124844,"_3075":125200},[],{"_3699":74413,"_31384":74208,"_21647":125339,"_5":14929,"_28559":124844,"_3075":125340},[],"`Ausente` → `Aprovisionado`",{"_3699":74414,"_31384":74208,"_21647":125342,"_5":14929,"_28559":124844,"_3075":125343},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3699":74415,"_31384":74208,"_21647":125345,"_5":14929,"_28559":124844,"_3075":125346},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3699":74416,"_31384":74208,"_21647":125348,"_5":14929,"_28559":124844,"_3075":125349},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3699":74417,"_31384":74208,"_21647":125351,"_5":14929,"_28559":124844,"_3075":125352},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3699":74418,"_31384":74208,"_21647":125354,"_5":14929,"_28559":124848,"_3075":125355},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3699":74419,"_31384":74208,"_21647":125357,"_5":14929,"_28559":124848,"_3075":125358},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3699":74420,"_31384":74208,"_21647":125360,"_5":14929,"_28559":124848,"_3075":125361},[],"Para que el flujo JITP funcione correctamente:",{"_3699":74421,"_31384":74208,"_21647":125363,"_5":14929,"_28559":124848,"_3075":125364},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3699":74422,"_31384":74208,"_21647":125366,"_5":14929,"_28559":124848,"_3075":125367},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3699":74423,"_31384":74208,"_21647":125369,"_5":14929,"_28559":124848,"_3075":125370},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3699":74424,"_31384":74208,"_21647":125372,"_5":14929,"_28559":124848,"_3075":125373},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3699":74425,"_31384":74208,"_21647":125375,"_5":14929,"_28559":124852,"_3075":125376},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3699":74426,"_31384":74208,"_21647":125378,"_5":14929,"_28559":124852,"_3075":125379},[],"Estado en Lamassu",{"_3699":74427,"_31384":74208,"_21647":125381,"_5":14929,"_28559":124852,"_3075":125382},[],"Razón de revocación",{"_3699":74428,"_31384":74208,"_21647":125384,"_5":14929,"_28559":124852,"_3075":125385},[],"Estado en AWS IoT Core",{"_3699":74429,"_31384":74208,"_21647":125387,"_5":14929,"_28559":124852,"_3075":55992},[],{"_3699":74430,"_31384":74208,"_21647":125389,"_5":14929,"_28559":124852,"_3075":125390},[],"Ninguna",{"_3699":74431,"_31384":74208,"_21647":125392,"_5":14929,"_28559":124852,"_3075":55998},[],{"_3699":74432,"_31384":74208,"_21647":125394,"_5":14929,"_28559":124852,"_3075":56001},[],{"_3699":74433,"_31384":74208,"_21647":125396,"_5":14929,"_28559":124852,"_3075":56004},[],{"_3699":74434,"_31384":74208,"_21647":125398,"_5":14929,"_28559":124852,"_3075":56007},[],{"_3699":74435,"_31384":74208,"_21647":125400,"_5":14929,"_28559":124852,"_3075":56001},[],{"_3699":74436,"_31384":74208,"_21647":125402,"_5":14929,"_28559":124852,"_3075":125403},[],"Cualquier otra razón",{"_3699":74437,"_31384":74208,"_21647":125405,"_5":14929,"_28559":124852,"_3075":56015},[],{"_3699":74438,"_31384":74208,"_21647":125407,"_5":14929,"_28559":124852,"_3075":125408},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3699":74439,"_31384":74208,"_21647":125410,"_5":14929,"_28559":124856,"_3075":125411},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3699":74440,"_31384":74208,"_21647":125413,"_5":14929,"_28559":124856,"_3075":125197},[],{"_3699":74441,"_31384":74208,"_21647":125415,"_5":14929,"_28559":124856,"_3075":125200},[],{"_3699":74442,"_31384":74208,"_21647":125417,"_5":14929,"_28559":124856,"_3075":125418},[],"`NoSincronizado` → `Active`",{"_3699":74443,"_31384":74208,"_21647":125420,"_5":14929,"_28559":124856,"_3075":55508},[],{"_3699":74444,"_31384":74208,"_21647":125422,"_5":14929,"_28559":124856,"_3075":56033},[],{"_3699":74445,"_31384":74208,"_21647":125424,"_5":14929,"_28559":124856,"_3075":125425},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3699":74446,"_31384":74208,"_21647":125427,"_5":14929,"_28559":124856,"_3075":56039},[],{"_3699":74447,"_31384":74208,"_21647":125429,"_5":14929,"_28559":124856,"_3075":125425},[],{"_3699":74448,"_31384":74208,"_21647":125431,"_5":14929,"_28559":124856,"_3075":56044},[],{"_3699":74449,"_31384":74208,"_21647":125433,"_5":14929,"_28559":124856,"_3075":55508},[],{"_3699":74450,"_31384":74208,"_21647":125435,"_5":14929,"_28559":124856,"_3075":56049},[],{"_3699":74451,"_31384":74208,"_21647":125437,"_5":14929,"_28559":124856,"_3075":125438},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3699":74452,"_31384":74208,"_21647":125440,"_5":14929,"_28559":124860,"_3075":125441},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3699":74453,"_31384":74208,"_21647":125443,"_5":14929,"_28559":124860,"_3075":125444},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3699":74454,"_31384":74208,"_21647":125446,"_5":14929,"_28559":124860,"_3075":125447},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3699":74455,"_31384":74208,"_21647":125449,"_5":14929,"_28559":124864,"_3075":125450},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3699":74456,"_31384":74208,"_21647":125452,"_5":14929,"_28559":124864,"_3075":125453},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3699":74457,"_31384":74208,"_21647":125455,"_5":14929,"_28559":124868,"_3075":125456},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3699":74458,"_31384":74208,"_21647":125458,"_5":14929,"_28559":124868,"_3075":125459},[],"Existen dos tipos de acciones:",{"_3699":74459,"_31384":74208,"_21647":125461,"_5":14929,"_28559":124868,"_3075":125462},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3699":74460,"_31384":74208,"_21647":125464,"_5":14929,"_28559":124868,"_3075":125465},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3699":74461,"_31384":74208,"_21647":125467,"_5":14929,"_28559":124868,"_3075":125468},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3699":74462,"_31384":74208,"_21647":125470,"_5":14929,"_28559":124872,"_3075":125471},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3699":74463,"_31384":74208,"_21647":125473,"_5":14929,"_28559":124872,"_3075":125474},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3699":74464,"_31384":74208,"_21647":125476,"_5":14929,"_28559":124872,"_3075":125477},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3699":74465,"_31384":74208,"_21647":125479,"_5":14929,"_28559":124876,"_3075":125480},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3699":74466,"_31384":74208,"_21647":125482,"_5":14929,"_28559":124876,"_3075":125483},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3699":74467,"_31384":74208,"_21647":125485,"_5":14929,"_28559":124876,"_3075":125486},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3699":74468,"_31384":74208,"_21647":125488,"_5":14929,"_28559":124876,"_3075":125489},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3699":74469,"_31384":74208,"_21647":125491,"_5":14929,"_28559":124876,"_3075":125492},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3699":74470,"_31384":74208,"_21647":125494,"_5":14929,"_28559":124876,"_3075":125495},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3699":74471,"_31384":74208,"_21647":125497,"_5":14929,"_28559":124876,"_3075":125498},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3699":74472,"_31384":74208,"_21647":125500,"_5":14929,"_28559":124876,"_3075":125501},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3699":74473,"_31384":74208,"_21647":125503,"_5":14929,"_28559":124876,"_3075":125504},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3699":74474,"_31384":74208,"_21647":125506,"_5":14929,"_28559":124876,"_3075":125507},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3699":74475,"_31384":74208,"_21647":125509,"_5":14929,"_28559":124876,"_3075":125510},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3699":74476,"_31384":74208,"_21647":125512,"_5":14929,"_28559":124876,"_3075":125513},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3699":74477,"_31384":74208,"_21647":125515,"_5":14929,"_28559":124876,"_3075":125516},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3699":74478,"_31384":74208,"_21647":125518,"_5":14929,"_28559":124876,"_3075":125519},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3699":74479,"_31384":74208,"_21647":125521,"_5":14929,"_28559":124876,"_3075":125522},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3699":74480,"_31384":74208,"_21647":125524,"_5":14929,"_28559":124876,"_3075":125525},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3699":74481,"_31384":74208,"_21647":125527,"_5":14929,"_28559":124876,"_3075":125528},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3699":74482,"_31384":74208,"_21647":125530,"_5":14929,"_28559":124876,"_3075":125531},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3699":74483,"_31384":74208,"_21647":125533,"_5":14929,"_28559":124876,"_3075":125534},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3699":74484,"_31384":74208,"_21647":125536,"_5":14929,"_28559":124876,"_3075":125537},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3699":74485,"_31384":74208,"_21647":125539,"_5":14929,"_28559":124876,"_3075":125540},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3699":74486,"_31384":74208,"_21647":125542,"_5":14929,"_28559":124876,"_3075":125543},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3699":74487,"_31384":74208,"_21647":125545,"_5":14929,"_28559":124876,"_3075":125546},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/est\" />",{"_3699":74488,"_31384":74208,"_21647":125548,"_5":14929,"_28559":124876,"_3075":125549},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3699":74489,"_31384":74489,"_5":15283,"_3075":53807,"_31709":125551,"_21647":125552,"_28559":74489},[51094,122172,53807],[],{"_3699":74490,"_31384":74489,"_21647":125554,"_5":14929,"_28559":74489,"_3075":125555},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3699":74491,"_31384":74489,"_5":31706,"_21647":125557,"_28559":125558,"_3075":125559},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3699":74492,"_31384":74489,"_5":31706,"_21647":125561,"_28559":125562,"_3075":123317},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3699":74493,"_31384":74489,"_5":31706,"_21647":125564,"_28559":125565,"_3075":123508},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3699":74494,"_31384":74489,"_5":31706,"_21647":125567,"_28559":125568,"_3075":124775},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3699":74495,"_31384":74489,"_5":31706,"_21647":125570,"_28559":125571,"_3075":125572},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3699":74496,"_31384":74489,"_21647":125574,"_5":14929,"_28559":74489,"_3075":125575},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3699":74497,"_31384":74489,"_21647":125577,"_5":14929,"_28559":125558,"_3075":125578},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3699":74498,"_31384":74489,"_21647":125580,"_5":14929,"_28559":125558,"_3075":125581},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3699":74499,"_31384":74489,"_21647":125583,"_5":14929,"_28559":125562,"_3075":125584},[],"Recurso",{"_3699":74500,"_31384":74489,"_21647":125586,"_5":14929,"_28559":125562,"_3075":125587},[],"Qué representa",{"_3699":74501,"_31384":74489,"_21647":125589,"_5":14929,"_28559":125562,"_3075":125590},[],"**Dispositivo**",{"_3699":74502,"_31384":74489,"_21647":125592,"_5":14929,"_28559":125562,"_3075":125593},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3699":74503,"_31384":74489,"_21647":125595,"_5":14929,"_28559":125562,"_3075":125596},[],"**Identidad**",{"_3699":74504,"_31384":74489,"_21647":125598,"_5":14929,"_28559":125562,"_3075":125599},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3699":74505,"_31384":74489,"_21647":125601,"_5":14929,"_28559":125562,"_3075":56216},[],{"_3699":74506,"_31384":74489,"_21647":125603,"_5":14929,"_28559":125562,"_3075":125604},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3699":74507,"_31384":74489,"_21647":125606,"_5":14929,"_28559":125562,"_3075":125607},[],"**Flota**",{"_3699":74508,"_31384":74489,"_21647":125609,"_5":14929,"_28559":125562,"_3075":125610},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3699":74509,"_31384":74489,"_21647":125612,"_5":14929,"_28559":125562,"_3075":125613},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3699":74510,"_31384":74489,"_21647":125615,"_5":14929,"_28559":125562,"_3075":125616},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3699":74511,"_31384":74489,"_21647":125618,"_5":14929,"_28559":125565,"_3075":125619},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3699":74512,"_31384":74489,"_21647":125621,"_5":14929,"_28559":125565,"_3075":125622},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3699":74513,"_31384":74489,"_21647":125624,"_5":14929,"_28559":125565,"_3075":125625},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3699":74514,"_31384":74489,"_21647":125627,"_5":14929,"_28559":125565,"_3075":125628},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3699":74515,"_31384":74489,"_21647":125630,"_5":14929,"_28559":125565,"_3075":125631},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3699":74516,"_31384":74489,"_21647":125633,"_5":14929,"_28559":125565,"_3075":125634},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3699":74517,"_31384":74489,"_21647":125636,"_5":14929,"_28559":125565,"_3075":125637},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3699":74518,"_31384":74489,"_21647":125639,"_5":14929,"_28559":125565,"_3075":125640},[],"<Card title=\"EST (RFC 7030)\" description=\"Consulta las guías de autenticación, cliente y renovación.\" href=\"/docs/platform/iot-fleets/est\" />",{"_3699":74519,"_31384":74489,"_21647":125642,"_5":14929,"_28559":125568,"_3075":125643},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3699":74520,"_31384":74489,"_21647":125645,"_5":14929,"_28559":125568,"_3075":125646},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3699":74521,"_31384":74489,"_21647":125648,"_5":14929,"_28559":125571,"_3075":125649},[],"Participante",{"_3699":74522,"_31384":74489,"_21647":125651,"_5":14929,"_28559":125571,"_3075":125652},[],"Responsabilidad",{"_3699":74523,"_31384":74489,"_21647":125654,"_5":14929,"_28559":125571,"_3075":125655},[],"Administrador PKI",{"_3699":74524,"_31384":74489,"_21647":125657,"_5":14929,"_28559":125571,"_3075":125658},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3699":74525,"_31384":74489,"_21647":125660,"_5":14929,"_28559":125571,"_3075":125661},[],"Administrador del aprovisionamiento",{"_3699":74526,"_31384":74489,"_21647":125663,"_5":14929,"_28559":125571,"_3075":125664},[],"DMS, admisión, autenticación por operación e inventario.",{"_3699":74527,"_31384":74489,"_21647":125666,"_5":14929,"_28559":125571,"_3075":125667},[],"Integrador del dispositivo",{"_3699":74528,"_31384":74489,"_21647":125669,"_5":14929,"_28559":125571,"_3075":125670},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3699":74529,"_31384":74489,"_21647":125672,"_5":14929,"_28559":125571,"_3075":125673},[],"Integrador del consumidor",{"_3699":74530,"_31384":74489,"_21647":125675,"_5":14929,"_28559":125571,"_3075":125676},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3699":74531,"_31384":74489,"_21647":125678,"_5":14929,"_28559":125571,"_3075":125679},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3699":74532,"_31384":74532,"_5":15283,"_3075":125681,"_31709":125682,"_21647":125684,"_28559":74532},"Enrola y conecta tu primer dispositivo",[51094,122172,53807,125683],"Primeros pasos",[],{"_3699":74533,"_31384":74532,"_21647":125686,"_5":14929,"_28559":74532,"_3075":125687},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3699":74534,"_31384":74532,"_5":31706,"_21647":125689,"_28559":125690,"_3075":120677},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3699":74535,"_31384":74532,"_5":31706,"_21647":125692,"_28559":125693,"_3075":125694},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3699":74536,"_31384":74532,"_5":31706,"_21647":125696,"_28559":125697,"_3075":125698},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3699":74537,"_31384":74532,"_5":31706,"_21647":125700,"_28559":125701,"_3075":125702},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3699":74538,"_31384":74532,"_5":31706,"_21647":125704,"_28559":125705,"_3075":125706},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3699":74539,"_31384":74532,"_5":31706,"_21647":125708,"_28559":125709,"_3075":125710},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3699":74540,"_31384":74532,"_5":31706,"_21647":125712,"_28559":125713,"_3075":125714},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3699":74541,"_31384":74532,"_5":31706,"_21647":125716,"_28559":125717,"_3075":125718},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3699":74542,"_31384":74532,"_21647":125720,"_5":14929,"_28559":74532,"_3075":125721},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3699":74543,"_31384":74532,"_21647":125723,"_5":14929,"_28559":125690,"_3075":125724},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3699":74544,"_31384":74532,"_21647":125726,"_5":14929,"_28559":125690,"_3075":125727},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3699":74545,"_31384":74532,"_21647":125729,"_5":14929,"_28559":125690,"_3075":125730},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3699":74546,"_31384":74532,"_21647":125732,"_5":14929,"_28559":125690,"_3075":125733},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3699":74547,"_31384":74532,"_21647":125735,"_5":14929,"_28559":125690,"_3075":125736},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3699":74548,"_31384":74532,"_21647":125738,"_5":14929,"_28559":125693,"_3075":125739},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3699":74549,"_31384":74532,"_21647":125741,"_5":14929,"_28559":125693,"_3075":125742},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3699":74550,"_31384":74532,"_21647":125744,"_5":14929,"_28559":125697,"_3075":125745},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3699":74551,"_31384":74532,"_21647":125747,"_5":14929,"_28559":125697,"_3075":125748},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3699":74552,"_31384":74532,"_21647":125750,"_5":14929,"_28559":125697,"_3075":125751},[],"Ajuste",{"_3699":74553,"_31384":74532,"_21647":125753,"_5":14929,"_28559":125697,"_3075":125754},[],"Valor de evaluación",{"_3699":74554,"_31384":74532,"_21647":125756,"_5":14929,"_28559":125697,"_3075":56372},[],{"_3699":74555,"_31384":74532,"_21647":125758,"_5":14929,"_28559":125697,"_3075":125759},[],"Raíz emisora de `device-root.pem`.",{"_3699":74556,"_31384":74532,"_21647":125761,"_5":14929,"_28559":125697,"_3075":125762},[],"Perfil de emisión",{"_3699":74557,"_31384":74532,"_21647":125764,"_5":14929,"_28559":125697,"_3075":125765},[],"Perfil final de 1 hora que acabas de preparar.",{"_3699":74558,"_31384":74532,"_21647":125767,"_5":14929,"_28559":125697,"_3075":56384},[],{"_3699":74559,"_31384":74532,"_21647":125769,"_5":14929,"_28559":125697,"_3075":56387},[],{"_3699":74560,"_31384":74532,"_21647":125771,"_5":14929,"_28559":125697,"_3075":56390},[],{"_3699":74561,"_31384":74532,"_21647":125773,"_5":14929,"_28559":125697,"_3075":125774},[],"Habilitado.",{"_3699":74562,"_31384":74532,"_21647":125776,"_5":14929,"_28559":125697,"_3075":56396},[],{"_3699":74563,"_31384":74532,"_21647":125778,"_5":14929,"_28559":125697,"_3075":125779},[],"Deshabilitado; el ID debe ser nuevo.",{"_3699":74564,"_31384":74532,"_21647":125781,"_5":14929,"_28559":125697,"_3075":125782},[],"Autenticación inicial",{"_3699":74565,"_31384":74532,"_21647":125784,"_5":14929,"_28559":125697,"_3075":125785},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3699":74566,"_31384":74532,"_21647":125787,"_5":14929,"_28559":125697,"_3075":125788},[],"Autenticación de renovación",{"_3699":74567,"_31384":74532,"_21647":125790,"_5":14929,"_28559":125697,"_3075":125791},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3699":74568,"_31384":74532,"_21647":125793,"_5":14929,"_28559":125697,"_3075":56414},[],{"_3699":74569,"_31384":74532,"_21647":125795,"_5":14929,"_28559":125697,"_3075":125796},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3699":74570,"_31384":74532,"_21647":125798,"_5":14929,"_28559":125697,"_3075":56420},[],{"_3699":74571,"_31384":74532,"_21647":125800,"_5":14929,"_28559":125697,"_3075":125801},[],"1 hora.",{"_3699":74572,"_31384":74532,"_21647":125803,"_5":14929,"_28559":125697,"_3075":56426},[],{"_3699":74573,"_31384":74532,"_21647":125805,"_5":14929,"_28559":125697,"_3075":125806},[],"30 minutos / 10 minutos.",{"_3699":74574,"_31384":74532,"_21647":125808,"_5":14929,"_28559":125697,"_3075":56432},[],{"_3699":74575,"_31384":74532,"_21647":125810,"_5":14929,"_28559":125697,"_3075":125811},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3699":74576,"_31384":74532,"_21647":125813,"_5":14929,"_28559":125697,"_3075":54256},[],{"_3699":74577,"_31384":74532,"_21647":125815,"_5":14929,"_28559":125697,"_3075":125816},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3699":74578,"_31384":74532,"_21647":125818,"_5":14929,"_28559":125697,"_3075":56443},[],{"_3699":74579,"_31384":74532,"_21647":125820,"_5":14929,"_28559":125697,"_3075":125821},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3699":74580,"_31384":74532,"_21647":125823,"_5":14929,"_28559":125697,"_3075":125824},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3699":74581,"_31384":74532,"_21647":125826,"_5":14929,"_28559":125701,"_3075":125827},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3699":74582,"_31384":74532,"_21647":125829,"_5":14929,"_28559":125701,"_3075":125830},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3699":74583,"_31384":74532,"_21647":125832,"_5":14929,"_28559":125705,"_3075":125833},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3699":74584,"_31384":74532,"_21647":125835,"_5":14929,"_28559":125705,"_3075":125836},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3699":74585,"_31384":74532,"_21647":125838,"_5":14929,"_28559":125705,"_3075":125839},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3699":74586,"_31384":74532,"_21647":125841,"_5":14929,"_28559":125709,"_3075":125842},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3699":74587,"_31384":74532,"_21647":125844,"_5":14929,"_28559":125709,"_3075":125845},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3699":74588,"_31384":74532,"_21647":125847,"_5":14929,"_28559":125713,"_3075":125848},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3699":74589,"_31384":74532,"_21647":125850,"_5":14929,"_28559":125713,"_3075":125851},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3699":74590,"_31384":74532,"_21647":125853,"_5":14929,"_28559":125713,"_3075":125854},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3699":74591,"_31384":74532,"_21647":125856,"_5":14929,"_28559":125713,"_3075":125857},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3699":74592,"_31384":74532,"_21647":125859,"_5":14929,"_28559":125713,"_3075":125860},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3699":74593,"_31384":74532,"_21647":125862,"_5":14929,"_28559":125717,"_3075":125863},[],"Comprobación",{"_3699":74594,"_31384":74532,"_21647":125865,"_5":14929,"_28559":125717,"_3075":125866},[],"Resultado esperado",{"_3699":74595,"_31384":74532,"_21647":125868,"_5":14929,"_28559":125717,"_3075":125869},[],"Registro",{"_3699":74596,"_31384":74532,"_21647":125871,"_5":14929,"_28559":125717,"_3075":125872},[],"ID creado automáticamente y DMS correcto.",{"_3699":74597,"_31384":74532,"_21647":125874,"_5":14929,"_28559":125717,"_3075":125158},[],{"_3699":74598,"_31384":74532,"_21647":125876,"_5":14929,"_28559":125717,"_3075":125877},[],"CN, perfil, serie y clave verificados.",{"_3699":74599,"_31384":74532,"_21647":125879,"_5":14929,"_28559":125717,"_3075":125880},[],"Inventario",{"_3699":74600,"_31384":74532,"_21647":125882,"_5":14929,"_28559":125717,"_3075":125883},[],"Serie recibida visible como identidad actual y en el historial.",{"_3699":74601,"_31384":74532,"_21647":125885,"_5":14929,"_28559":125717,"_3075":125886},[],"Consumidor",{"_3699":74602,"_31384":74532,"_21647":125888,"_5":14929,"_28559":125717,"_3075":125889},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3699":74603,"_31384":74532,"_21647":125891,"_5":14929,"_28559":125717,"_3075":125892},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3699":74604,"_31384":74532,"_21647":125894,"_5":14929,"_28559":125717,"_3075":125895},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3699":74605,"_31384":74605,"_5":15283,"_3075":123338,"_31709":125897,"_21647":125898,"_28559":74605},[51094,122172,53807,125683],[],{"_3699":74606,"_31384":74605,"_21647":125900,"_5":14929,"_28559":74605,"_3075":125901},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3699":74607,"_31384":74605,"_5":31706,"_21647":125903,"_28559":125904,"_3075":120677},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3699":74608,"_31384":74605,"_5":31706,"_21647":125906,"_28559":125907,"_3075":125908},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3699":74609,"_31384":74605,"_5":31706,"_21647":125910,"_28559":125911,"_3075":125912},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3699":74610,"_31384":74605,"_5":31706,"_21647":125914,"_28559":125915,"_3075":125916},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3699":74611,"_31384":74605,"_5":31706,"_21647":125918,"_28559":125919,"_3075":125920},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3699":74612,"_31384":74605,"_5":31706,"_21647":125922,"_28559":125923,"_3075":125924},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3699":74613,"_31384":74605,"_5":31706,"_21647":125926,"_28559":125927,"_3075":125866},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3699":74614,"_31384":74605,"_5":31706,"_21647":125929,"_28559":125930,"_3075":125931},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3699":74615,"_31384":74605,"_5":31706,"_21647":125933,"_28559":125934,"_3075":125935},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3699":74616,"_31384":74605,"_21647":125937,"_5":14929,"_28559":74605,"_3075":125938},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3699":74617,"_31384":74605,"_21647":125940,"_5":14929,"_28559":74605,"_3075":125941},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3699":74618,"_31384":74605,"_21647":125943,"_5":14929,"_28559":125904,"_3075":125944},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3699":74619,"_31384":74605,"_21647":125946,"_5":14929,"_28559":125904,"_3075":125947},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3699":74620,"_31384":74605,"_21647":125949,"_5":14929,"_28559":125904,"_3075":125950},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3699":74621,"_31384":74605,"_21647":125952,"_5":14929,"_28559":125904,"_3075":125953},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3699":74622,"_31384":74605,"_21647":125955,"_5":14929,"_28559":125907,"_3075":125956},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3699":74623,"_31384":74605,"_21647":125958,"_5":14929,"_28559":125907,"_3075":125959},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3699":74624,"_31384":74605,"_21647":125961,"_5":14929,"_28559":125907,"_3075":125962},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3699":74625,"_31384":74605,"_21647":125964,"_5":14929,"_28559":125907,"_3075":125965},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3699":74626,"_31384":74605,"_21647":125967,"_5":14929,"_28559":125907,"_3075":125968},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3699":74627,"_31384":74605,"_21647":125970,"_5":14929,"_28559":125907,"_3075":125971},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3699":74628,"_31384":74605,"_21647":125973,"_5":14929,"_28559":125907,"_3075":125974},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3699":74629,"_31384":74605,"_21647":125976,"_5":14929,"_28559":125907,"_3075":125977},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3699":74630,"_31384":74605,"_21647":125979,"_5":14929,"_28559":125911,"_3075":125980},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3699":74631,"_31384":74605,"_21647":125982,"_5":14929,"_28559":125911,"_3075":56608},[],{"_3699":74632,"_31384":74605,"_21647":125984,"_5":14929,"_28559":125911,"_3075":125985},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3699":74633,"_31384":74605,"_21647":125987,"_5":14929,"_28559":125911,"_3075":125988},[],"**Icon** y **Tags**: clasificación opcional.",{"_3699":74634,"_31384":74605,"_21647":125990,"_5":14929,"_28559":125911,"_3075":125991},[],"Confirma el registro.",{"_3699":74635,"_31384":74605,"_21647":125993,"_5":14929,"_28559":125915,"_3075":125994},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3699":74636,"_31384":74605,"_21647":125996,"_5":14929,"_28559":125915,"_3075":125997},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3699":74637,"_31384":74605,"_21647":125999,"_5":14929,"_28559":125919,"_3075":126000},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3699":74638,"_31384":74605,"_21647":126002,"_5":14929,"_28559":125919,"_3075":126003},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3699":74639,"_31384":74605,"_21647":126005,"_5":14929,"_28559":125923,"_3075":126006},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3699":74640,"_31384":74605,"_21647":126008,"_5":14929,"_28559":125923,"_3075":126009},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3699":74641,"_31384":74605,"_21647":126011,"_5":14929,"_28559":125927,"_3075":125863},[],{"_3699":74642,"_31384":74605,"_21647":126013,"_5":14929,"_28559":125927,"_3075":126014},[],"Resultado",{"_3699":74643,"_31384":74605,"_21647":126016,"_5":14929,"_28559":125927,"_3075":125144},[],{"_3699":74644,"_31384":74605,"_21647":126018,"_5":14929,"_28559":125927,"_3075":126019},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3699":74645,"_31384":74605,"_21647":126021,"_5":14929,"_28559":125927,"_3075":126022},[],"Identidad actual",{"_3699":74646,"_31384":74605,"_21647":126024,"_5":14929,"_28559":125927,"_3075":126025},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3699":74647,"_31384":74605,"_21647":126027,"_5":14929,"_28559":125927,"_3075":126028},[],"Historial",{"_3699":74648,"_31384":74605,"_21647":126030,"_5":14929,"_28559":125927,"_3075":126031},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3699":74649,"_31384":74605,"_21647":126033,"_5":14929,"_28559":125927,"_3075":126034},[],"Clave y certificado",{"_3699":74650,"_31384":74605,"_21647":126036,"_5":14929,"_28559":125927,"_3075":126037},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3699":74651,"_31384":74605,"_21647":126039,"_5":14929,"_28559":125930,"_3075":126040},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3699":74652,"_31384":74605,"_21647":126042,"_5":14929,"_28559":125930,"_3075":126043},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3699":74653,"_31384":74605,"_21647":126045,"_5":14929,"_28559":125930,"_3075":126046},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3699":74654,"_31384":74605,"_21647":126048,"_5":14929,"_28559":125930,"_3075":126049},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3699":74655,"_31384":74605,"_21647":126051,"_5":14929,"_28559":125934,"_3075":126052},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3699":74656,"_31384":74605,"_21647":126054,"_5":14929,"_28559":125934,"_3075":126055},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3699":74657,"_31384":74605,"_21647":126057,"_5":14929,"_28559":125934,"_3075":126058},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3699":74658,"_31384":74658,"_5":15283,"_3075":126060,"_31709":126061,"_21647":126062,"_28559":74658},"Plataforma Lamassu IoT",[51094,122172],[],{"_3699":74659,"_31384":74658,"_21647":126064,"_5":14929,"_28559":74658,"_3075":126065},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3699":74660,"_31384":74658,"_5":31706,"_21647":126067,"_28559":126068,"_3075":125559},[],"/docs/es/platform/overview#empieza-aquí",{"_3699":74661,"_31384":74658,"_5":31706,"_21647":126070,"_28559":126071,"_3075":126072},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3699":74662,"_31384":74658,"_5":31706,"_21647":126074,"_28559":126075,"_3075":126076},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3699":74663,"_31384":74658,"_5":31706,"_21647":126078,"_28559":126079,"_3075":126080},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3699":74664,"_31384":74658,"_5":31706,"_21647":126082,"_28559":126083,"_3075":126084},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3699":74665,"_31384":74658,"_5":31706,"_21647":126086,"_28559":126087,"_3075":126088},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3699":74666,"_31384":74658,"_5":31706,"_21647":126090,"_28559":126091,"_3075":126092},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3699":74667,"_31384":74658,"_5":31706,"_21647":126094,"_28559":126095,"_3075":126096},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3699":74668,"_31384":74658,"_5":31706,"_21647":126098,"_28559":126099,"_3075":126100},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3699":74669,"_31384":74658,"_5":31706,"_21647":126102,"_28559":126103,"_3075":126104},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3699":74670,"_31384":74658,"_5":31706,"_21647":126106,"_28559":126107,"_3075":126108},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3699":74671,"_31384":74658,"_21647":126110,"_5":14929,"_28559":74658,"_3075":126111},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3699":74672,"_31384":74658,"_21647":126113,"_5":14929,"_28559":126068,"_3075":126114},[],"Elige el resultado que necesitas obtener:",{"_3699":74673,"_31384":74658,"_21647":126116,"_5":14929,"_28559":126068,"_3075":126117},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3699":74674,"_31384":74658,"_21647":126119,"_5":14929,"_28559":126068,"_3075":126120},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3699":74675,"_31384":74658,"_21647":126122,"_5":14929,"_28559":126068,"_3075":126123},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3699":74676,"_31384":74658,"_21647":126125,"_5":14929,"_28559":126071,"_3075":126126},[],"Bloque",{"_3699":74677,"_31384":74658,"_21647":126128,"_5":14929,"_28559":126071,"_3075":126129},[],"Qué gestionas",{"_3699":74678,"_31384":74658,"_21647":126131,"_5":14929,"_28559":126071,"_3075":126132},[],"Punto de entrada",{"_3699":74679,"_31384":74658,"_21647":126134,"_5":14929,"_28559":126071,"_3075":56761},[],{"_3699":74680,"_31384":74658,"_21647":126136,"_5":14929,"_28559":126071,"_3075":126137},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3699":74681,"_31384":74658,"_21647":126139,"_5":14929,"_28559":126071,"_3075":126140},[],"Visión general de PKI",{"_3699":74682,"_31384":74658,"_21647":126142,"_5":14929,"_28559":126071,"_3075":56770},[],{"_3699":74683,"_31384":74658,"_21647":126144,"_5":14929,"_28559":126071,"_3075":126145},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3699":74684,"_31384":74658,"_21647":126147,"_5":14929,"_28559":126071,"_3075":126148},[],"Visión general de IoT Fleets",{"_3699":74685,"_31384":74658,"_21647":126150,"_5":14929,"_28559":126071,"_3075":126151},[],"**Administración**",{"_3699":74686,"_31384":74658,"_21647":126153,"_5":14929,"_28559":126071,"_3075":126154},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3699":74687,"_31384":74658,"_21647":126156,"_5":14929,"_28559":126071,"_3075":122174},[],{"_3699":74688,"_31384":74658,"_21647":126158,"_5":14929,"_28559":126071,"_3075":126159},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3699":74689,"_31384":74658,"_21647":126161,"_5":14929,"_28559":126075,"_3075":126162},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3699":74690,"_31384":74658,"_21647":126164,"_5":14929,"_28559":126075,"_3075":126165},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3699":74691,"_31384":74658,"_21647":126167,"_5":14929,"_28559":126075,"_3075":126168},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3699":74692,"_31384":74658,"_21647":126170,"_5":14929,"_28559":126075,"_3075":126171},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3699":74693,"_31384":74658,"_21647":126173,"_5":14929,"_28559":126075,"_3075":126174},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3699":74694,"_31384":74658,"_21647":126176,"_5":14929,"_28559":126075,"_3075":126177},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3699":74695,"_31384":74658,"_21647":126179,"_5":14929,"_28559":126083,"_3075":126180},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3699":74696,"_31384":74658,"_21647":126182,"_5":14929,"_28559":126087,"_3075":126183},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3699":74697,"_31384":74658,"_21647":126185,"_5":14929,"_28559":126091,"_3075":126186},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3699":74698,"_31384":74658,"_21647":126188,"_5":14929,"_28559":126095,"_3075":126189},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3699":74699,"_31384":74658,"_21647":126191,"_5":14929,"_28559":126099,"_3075":126192},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3699":74700,"_31384":74658,"_21647":126194,"_5":14929,"_28559":126103,"_3075":126195},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3699":74701,"_31384":74658,"_21647":126197,"_5":14929,"_28559":126107,"_3075":125652},[],{"_3699":74702,"_31384":74658,"_21647":126199,"_5":14929,"_28559":126107,"_3075":126200},[],"Qué prepara o comprueba",{"_3699":74703,"_31384":74658,"_21647":126202,"_5":14929,"_28559":126107,"_3075":125655},[],{"_3699":74704,"_31384":74658,"_21647":126204,"_5":14929,"_28559":126107,"_3075":126205},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3699":74705,"_31384":74658,"_21647":126207,"_5":14929,"_28559":126107,"_3075":126208},[],"Administrador de la flota",{"_3699":74706,"_31384":74658,"_21647":126210,"_5":14929,"_28559":126107,"_3075":126211},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3699":74707,"_31384":74658,"_21647":126213,"_5":14929,"_28559":126107,"_3075":125667},[],{"_3699":74708,"_31384":74658,"_21647":126215,"_5":14929,"_28559":126107,"_3075":126216},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3699":74709,"_31384":74658,"_21647":126218,"_5":14929,"_28559":126107,"_3075":125673},[],{"_3699":74710,"_31384":74658,"_21647":126220,"_5":14929,"_28559":126107,"_3075":126221},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3699":74711,"_31384":74658,"_21647":126223,"_5":14929,"_28559":126107,"_3075":126224},[],"Operador de infraestructura",{"_3699":74712,"_31384":74658,"_21647":126226,"_5":14929,"_28559":126107,"_3075":126227},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3699":74713,"_31384":74658,"_21647":126229,"_5":14929,"_28559":126107,"_3075":126230},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3699":74714,"_31384":74714,"_5":15283,"_3075":126232,"_31709":126233,"_21647":126235,"_28559":74714},"Jerarquía y rotación de CAs",[51094,122172,56862,126234],"Claves, autoridades y certificados",[],{"_3699":74715,"_31384":74714,"_21647":126237,"_5":14929,"_28559":74714,"_3075":126238},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3699":74716,"_31384":74714,"_5":31706,"_21647":126240,"_28559":126241,"_3075":126242},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3699":74717,"_31384":74714,"_5":31706,"_21647":126244,"_28559":126245,"_3075":126246},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3699":74718,"_31384":74714,"_5":31706,"_21647":126248,"_28559":126249,"_3075":126250},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3699":74719,"_31384":74714,"_5":31706,"_21647":126252,"_28559":126253,"_3075":126254},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3699":74720,"_31384":74714,"_5":31706,"_21647":126256,"_28559":126257,"_3075":126258},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3699":74721,"_31384":74714,"_5":31706,"_21647":126260,"_28559":126261,"_3075":126262},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3699":74722,"_31384":74714,"_5":31706,"_21647":126264,"_28559":126265,"_3075":126266},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3699":74723,"_31384":74714,"_5":31706,"_21647":126268,"_28559":126269,"_3075":126270},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3699":74724,"_31384":74714,"_5":31706,"_21647":126272,"_28559":126273,"_3075":126274},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3699":74725,"_31384":74714,"_5":31706,"_21647":126276,"_28559":126277,"_3075":126278},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3699":74726,"_31384":74714,"_5":31706,"_21647":126280,"_28559":126281,"_3075":126282},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3699":74727,"_31384":74714,"_5":31706,"_21647":126284,"_28559":126285,"_3075":126286},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3699":74728,"_31384":74714,"_21647":126288,"_5":14929,"_28559":74714,"_3075":126289},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3699":74729,"_31384":74714,"_21647":126291,"_5":14929,"_28559":74714,"_3075":126292},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3699":74730,"_31384":74714,"_21647":126294,"_5":14929,"_28559":126241,"_3075":126295},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3699":74731,"_31384":74714,"_21647":126297,"_5":14929,"_28559":126241,"_3075":126298},[],"entorno, como producción y preproducción;",{"_3699":74732,"_31384":74714,"_21647":126300,"_5":14929,"_28559":126241,"_3075":126301},[],"propietario o equipo operador;",{"_3699":74733,"_31384":74714,"_21647":126303,"_5":14929,"_28559":126241,"_3075":126304},[],"familia de dispositivos o proceso de fabricación;",{"_3699":74734,"_31384":74714,"_21647":126306,"_5":14929,"_28559":126241,"_3075":126307},[],"región o requisito regulatorio;",{"_3699":74735,"_31384":74714,"_21647":126309,"_5":14929,"_28559":126241,"_3075":126310},[],"motor criptográfico o política de clave;",{"_3699":74736,"_31384":74714,"_21647":126312,"_5":14929,"_28559":126241,"_3075":126313},[],"ventana de mantenimiento y ritmo de renovación.",{"_3699":74737,"_31384":74714,"_21647":126315,"_5":14929,"_28559":126241,"_3075":126316},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3699":74738,"_31384":74714,"_21647":126318,"_5":14929,"_28559":126241,"_3075":126319},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3699":74739,"_31384":74714,"_21647":126321,"_5":14929,"_28559":126245,"_3075":126322},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3699":74740,"_31384":74714,"_21647":126324,"_5":14929,"_28559":126245,"_3075":126325},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3699":74741,"_31384":74714,"_21647":126327,"_5":14929,"_28559":126245,"_3075":126328},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3699":74742,"_31384":74714,"_21647":126330,"_5":14929,"_28559":126245,"_3075":126331},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3699":74743,"_31384":74714,"_21647":126333,"_5":14929,"_28559":126249,"_3075":126334},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3699":74744,"_31384":74714,"_21647":126336,"_5":14929,"_28559":126249,"_3075":126337},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3699":74745,"_31384":74714,"_21647":126339,"_5":14929,"_28559":126249,"_3075":126340},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3699":74746,"_31384":74714,"_21647":126342,"_5":14929,"_28559":126249,"_3075":126343},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3699":74747,"_31384":74714,"_21647":126345,"_5":14929,"_28559":126257,"_3075":126346},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3699":74748,"_31384":74714,"_21647":126348,"_5":14929,"_28559":126261,"_3075":126349},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3699":74749,"_31384":74714,"_21647":126351,"_5":14929,"_28559":126265,"_3075":126352},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3699":74750,"_31384":74714,"_21647":126354,"_5":14929,"_28559":126269,"_3075":126355},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3699":74751,"_31384":74714,"_21647":126357,"_5":14929,"_28559":126273,"_3075":126358},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3699":74752,"_31384":74714,"_21647":126360,"_5":14929,"_28559":126277,"_3075":126361},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3699":74753,"_31384":74714,"_21647":126363,"_5":14929,"_28559":126281,"_3075":126364},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3699":74754,"_31384":74714,"_21647":126366,"_5":14929,"_28559":126281,"_3075":126367},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3699":74755,"_31384":74714,"_21647":126369,"_5":14929,"_28559":126281,"_3075":126370},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3699":74756,"_31384":74714,"_21647":126372,"_5":14929,"_28559":126281,"_3075":126373},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3699":74757,"_31384":74714,"_21647":126375,"_5":14929,"_28559":126285,"_3075":126376},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3699":74758,"_31384":74714,"_21647":126378,"_5":14929,"_28559":126285,"_3075":126379},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3699":74759,"_31384":74714,"_21647":126381,"_5":14929,"_28559":126285,"_3075":126382},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3699":74760,"_31384":74714,"_21647":126384,"_5":14929,"_28559":126285,"_3075":126385},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3699":74761,"_31384":74714,"_21647":126387,"_5":14929,"_28559":126285,"_3075":126388},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3699":74762,"_31384":74714,"_21647":126390,"_5":14929,"_28559":126285,"_3075":126391},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3699":74763,"_31384":74714,"_21647":126393,"_5":14929,"_28559":126285,"_3075":126394},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3699":74764,"_31384":74764,"_5":15283,"_3075":126396,"_31709":126397,"_21647":126398,"_28559":74764},"Autoridades de certificación",[51094,122172,56862,126234],[],{"_3699":74765,"_31384":74764,"_21647":126400,"_5":14929,"_28559":74764,"_3075":126401},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3699":74766,"_31384":74764,"_5":31706,"_21647":126403,"_28559":126404,"_3075":126405},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3699":74767,"_31384":74764,"_5":31706,"_21647":126407,"_28559":126408,"_3075":126409},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3699":74768,"_31384":74764,"_5":31706,"_21647":126411,"_28559":126412,"_3075":120677},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3699":74769,"_31384":74764,"_5":31706,"_21647":126414,"_28559":126415,"_3075":126416},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3699":74770,"_31384":74764,"_5":31706,"_21647":126418,"_28559":126419,"_3075":126420},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3699":74771,"_31384":74764,"_5":31706,"_21647":126422,"_28559":126423,"_3075":126424},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3699":74772,"_31384":74764,"_5":31706,"_21647":126426,"_28559":126427,"_3075":126428},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3699":74773,"_31384":74764,"_5":31706,"_21647":126430,"_28559":126431,"_3075":126432},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3699":74774,"_31384":74764,"_5":31706,"_21647":126434,"_28559":126435,"_3075":126436},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3699":74775,"_31384":74764,"_5":31706,"_21647":126438,"_28559":126439,"_3075":126440},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3699":74776,"_31384":74764,"_5":31706,"_21647":126442,"_28559":126443,"_3075":126444},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3699":74777,"_31384":74764,"_5":31706,"_21647":126446,"_28559":126447,"_3075":126448},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3699":74778,"_31384":74764,"_5":31706,"_21647":126450,"_28559":126451,"_3075":126452},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3699":74779,"_31384":74764,"_5":31706,"_21647":126454,"_28559":126455,"_3075":126456},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3699":74780,"_31384":74764,"_5":31706,"_21647":126458,"_28559":126459,"_3075":126460},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3699":74781,"_31384":74764,"_5":31706,"_21647":126462,"_28559":126463,"_3075":126464},[],"/docs/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3699":74782,"_31384":74764,"_5":31706,"_21647":126466,"_28559":126467,"_3075":126468},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3699":74783,"_31384":74764,"_5":31706,"_21647":126470,"_28559":126471,"_3075":126472},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3699":74784,"_31384":74764,"_5":31706,"_21647":126474,"_28559":126475,"_3075":126476},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3699":74785,"_31384":74764,"_5":31706,"_21647":126478,"_28559":126479,"_3075":126480},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3699":74786,"_31384":74764,"_5":31706,"_21647":126482,"_28559":126483,"_3075":126484},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3699":74787,"_31384":74764,"_5":31706,"_21647":126486,"_28559":126487,"_3075":126488},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3699":74788,"_31384":74764,"_5":31706,"_21647":126490,"_28559":126491,"_3075":126492},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3699":74789,"_31384":74764,"_5":31706,"_21647":126494,"_28559":126495,"_3075":126496},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3699":74790,"_31384":74764,"_21647":126498,"_5":14929,"_28559":74764,"_3075":126499},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3699":74791,"_31384":74764,"_21647":126501,"_5":14929,"_28559":74764,"_3075":126502},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3699":74792,"_31384":74764,"_21647":126504,"_5":14929,"_28559":74764,"_3075":126505},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3699":74793,"_31384":74764,"_21647":126507,"_5":14929,"_28559":126404,"_3075":126508},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3699":74794,"_31384":74764,"_21647":126510,"_5":14929,"_28559":126404,"_3075":126511},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3699":74795,"_31384":74764,"_21647":126513,"_5":14929,"_28559":126404,"_3075":126514},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3699":74796,"_31384":74764,"_21647":126516,"_5":14929,"_28559":126404,"_3075":126517},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3699":74797,"_31384":74764,"_21647":126519,"_5":14929,"_28559":126404,"_3075":126520},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3699":74798,"_31384":74764,"_21647":126522,"_5":14929,"_28559":126412,"_3075":126523},[],"Decide si la CA será raíz o intermedia.",{"_3699":74799,"_31384":74764,"_21647":126525,"_5":14929,"_28559":126412,"_3075":126526},[],"Elige el motor que custodiará la clave.",{"_3699":74800,"_31384":74764,"_21647":126528,"_5":14929,"_28559":126412,"_3075":126529},[],"Define una validez superior a la de los certificados que emitirá.",{"_3699":74801,"_31384":74764,"_21647":126531,"_5":14929,"_28559":126412,"_3075":126532},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3699":74802,"_31384":74764,"_21647":126534,"_5":14929,"_28559":126415,"_3075":126535},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3699":74803,"_31384":74764,"_21647":126537,"_5":14929,"_28559":126419,"_3075":126538},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3699":74804,"_31384":74764,"_21647":126540,"_5":14929,"_28559":126419,"_3075":126541},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3699":74805,"_31384":74764,"_21647":126543,"_5":14929,"_28559":126423,"_3075":126544},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3699":74806,"_31384":74764,"_21647":126546,"_5":14929,"_28559":126427,"_3075":126547},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3699":74807,"_31384":74764,"_21647":126549,"_5":14929,"_28559":126427,"_3075":126550},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3699":74808,"_31384":74764,"_21647":126552,"_5":14929,"_28559":126427,"_3075":126553},[],"`ST`: estado o provincia.",{"_3699":74809,"_31384":74764,"_21647":126555,"_5":14929,"_28559":126427,"_3075":126556},[],"`L`: localidad.",{"_3699":74810,"_31384":74764,"_21647":126558,"_5":14929,"_28559":126427,"_3075":126559},[],"`O`: organización.",{"_3699":74811,"_31384":74764,"_21647":126561,"_5":14929,"_28559":126427,"_3075":126562},[],"`OU`: unidad organizativa.",{"_3699":74812,"_31384":74764,"_21647":126564,"_5":14929,"_28559":126427,"_3075":126565},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3699":74813,"_31384":74764,"_21647":126567,"_5":14929,"_28559":126431,"_3075":126568},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3699":74814,"_31384":74764,"_21647":126570,"_5":14929,"_28559":126431,"_3075":126571},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3699":74815,"_31384":74764,"_21647":126573,"_5":14929,"_28559":126435,"_3075":126574},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3699":74816,"_31384":74764,"_21647":126576,"_5":14929,"_28559":126435,"_3075":126577},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3699":74817,"_31384":74764,"_21647":126579,"_5":14929,"_28559":126439,"_3075":126580},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3699":74818,"_31384":74764,"_21647":126582,"_5":14929,"_28559":126439,"_3075":126583},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3699":74819,"_31384":74764,"_21647":126585,"_5":14929,"_28559":126443,"_3075":126586},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3699":74820,"_31384":74764,"_21647":126588,"_5":14929,"_28559":126443,"_3075":126589},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3699":74821,"_31384":74764,"_21647":126591,"_5":14929,"_28559":126443,"_3075":126592},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3699":74822,"_31384":74764,"_21647":126594,"_5":14929,"_28559":126443,"_3075":126595},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3699":74823,"_31384":74764,"_21647":126597,"_5":14929,"_28559":126447,"_3075":126598},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3699":74824,"_31384":74764,"_21647":126600,"_5":14929,"_28559":126451,"_3075":126601},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos. Cuando la clave privada se importa junto con la CA, aparece en el inventario de claves del KMS como `Key For CA CN=<subject CN> (imported)`, siguiendo la misma convención que las claves generadas al crear una CA (`Key For CA CN=<subject CN>`) más el sufijo `(imported)`.",{"_3699":74825,"_31384":74764,"_21647":126603,"_5":14929,"_28559":126451,"_3075":126604},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3699":74826,"_31384":74764,"_21647":126606,"_5":14929,"_28559":126455,"_3075":126607},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3699":74827,"_31384":74764,"_21647":126609,"_5":14929,"_28559":126459,"_3075":126610},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3699":74828,"_31384":74764,"_21647":126612,"_5":14929,"_28559":126459,"_3075":126613},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3699":74829,"_31384":74764,"_21647":126615,"_5":14929,"_28559":126459,"_3075":126616},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3699":74830,"_31384":74764,"_21647":126618,"_5":14929,"_28559":126463,"_3075":126619},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3699":74831,"_31384":74764,"_21647":126621,"_5":14929,"_28559":126463,"_3075":126622},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3699":74832,"_31384":74764,"_21647":126624,"_5":14929,"_28559":126463,"_3075":126625},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3699":74833,"_31384":74764,"_21647":126627,"_5":14929,"_28559":126463,"_3075":126628},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3699":74834,"_31384":74764,"_21647":126630,"_5":14929,"_28559":126467,"_3075":126631},[],"Abre una CA desde el inventario para consultar:",{"_3699":74835,"_31384":74764,"_21647":126633,"_5":14929,"_28559":126467,"_3075":126634},[],"Estado y periodo de validez.",{"_3699":74836,"_31384":74764,"_21647":126636,"_5":14929,"_28559":126467,"_3075":126637},[],"Certificado y cadena en formato PEM.",{"_3699":74837,"_31384":74764,"_21647":126639,"_5":14929,"_28559":126467,"_3075":126640},[],"Número de certificados activos, expirados y revocados.",{"_3699":74838,"_31384":74764,"_21647":126642,"_5":14929,"_28559":126467,"_3075":126643},[],"Certificados emitidos en **Issued Certificates**.",{"_3699":74839,"_31384":74764,"_21647":126645,"_5":14929,"_28559":126467,"_3075":126646},[],"CRL vinculada a la autoridad.",{"_3699":74840,"_31384":74764,"_21647":126648,"_5":14929,"_28559":126467,"_3075":126649},[],"Metadatos y motor criptográfico asociado.",{"_3699":74841,"_31384":74764,"_21647":126651,"_5":14929,"_28559":126467,"_3075":126652},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3699":74842,"_31384":74764,"_21647":126654,"_5":14929,"_28559":126471,"_3075":126655},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3699":74843,"_31384":74764,"_21647":126657,"_5":14929,"_28559":126471,"_3075":126658},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3699":74844,"_31384":74764,"_21647":126660,"_5":14929,"_28559":126471,"_3075":126661},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3699":74845,"_31384":74764,"_21647":126663,"_5":14929,"_28559":126471,"_3075":126664},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3699":74846,"_31384":74764,"_21647":126666,"_5":14929,"_28559":126471,"_3075":126667},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3699":74847,"_31384":74764,"_21647":126669,"_5":14929,"_28559":126471,"_3075":126670},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3699":74848,"_31384":74764,"_21647":126672,"_5":14929,"_28559":126475,"_3075":126673},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3699":74849,"_31384":74764,"_21647":126675,"_5":14929,"_28559":126479,"_3075":126676},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3699":74850,"_31384":74764,"_21647":126678,"_5":14929,"_28559":126483,"_3075":126679},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3699":74851,"_31384":74764,"_21647":126681,"_5":14929,"_28559":126487,"_3075":126682},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3699":74852,"_31384":74764,"_21647":126684,"_5":14929,"_28559":126491,"_3075":126685},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3699":74853,"_31384":74764,"_21647":126687,"_5":14929,"_28559":126495,"_3075":126688},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3699":74854,"_31384":74764,"_21647":126690,"_5":14929,"_28559":126495,"_3075":126691},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3699":74855,"_31384":74764,"_21647":126693,"_5":14929,"_28559":126495,"_3075":126694},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3699":74856,"_31384":74764,"_21647":126696,"_5":14929,"_28559":126495,"_3075":126697},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3699":74857,"_31384":74764,"_21647":126699,"_5":14929,"_28559":126495,"_3075":126700},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3699":74858,"_31384":74858,"_5":15283,"_3075":126702,"_31709":126703,"_21647":126704,"_28559":74858},"Perfiles de certificado",[51094,122172,56862,126234],[],{"_3699":74859,"_31384":74858,"_21647":126706,"_5":14929,"_28559":74858,"_3075":126707},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3699":74860,"_31384":74858,"_5":31706,"_21647":126709,"_28559":126710,"_3075":126711},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3699":74861,"_31384":74858,"_5":31706,"_21647":126713,"_28559":126714,"_3075":126715},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3699":74862,"_31384":74858,"_5":31706,"_21647":126717,"_28559":126718,"_3075":126719},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3699":74863,"_31384":74858,"_5":31706,"_21647":126721,"_28559":126722,"_3075":126723},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3699":74864,"_31384":74858,"_5":31706,"_21647":126725,"_28559":126726,"_3075":126727},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3699":74865,"_31384":74858,"_5":31706,"_21647":126729,"_28559":126730,"_3075":126731},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3699":74866,"_31384":74858,"_5":31706,"_21647":126733,"_28559":126734,"_3075":126735},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3699":74867,"_31384":74858,"_5":31706,"_21647":126737,"_28559":126738,"_3075":126739},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3699":74868,"_31384":74858,"_5":31706,"_21647":126741,"_28559":126742,"_3075":126743},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3699":74869,"_31384":74858,"_5":31706,"_21647":126745,"_28559":126746,"_3075":126747},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3699":74870,"_31384":74858,"_5":31706,"_21647":126749,"_28559":126750,"_3075":126751},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3699":74871,"_31384":74858,"_5":31706,"_21647":126753,"_28559":126754,"_3075":126755},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3699":74872,"_31384":74858,"_5":31706,"_21647":126757,"_28559":126758,"_3075":126759},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3699":74873,"_31384":74858,"_5":31706,"_21647":126761,"_28559":126762,"_3075":126763},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3699":74874,"_31384":74858,"_5":31706,"_21647":126765,"_28559":126766,"_3075":126767},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3699":74875,"_31384":74858,"_5":31706,"_21647":126769,"_28559":126770,"_3075":126771},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3699":74876,"_31384":74858,"_21647":126773,"_5":14929,"_28559":74858,"_3075":126774},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3699":74877,"_31384":74858,"_21647":126776,"_5":14929,"_28559":74858,"_3075":126777},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3699":74878,"_31384":74858,"_21647":126779,"_5":14929,"_28559":126714,"_3075":126780},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3699":74879,"_31384":74858,"_21647":126782,"_5":14929,"_28559":126714,"_3075":126783},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3699":74880,"_31384":74858,"_21647":126785,"_5":14929,"_28559":126718,"_3075":126786},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3699":74881,"_31384":74858,"_21647":126788,"_5":14929,"_28559":126722,"_3075":126789},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3699":74882,"_31384":74858,"_21647":126791,"_5":14929,"_28559":126722,"_3075":126792},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3699":74883,"_31384":74858,"_21647":126794,"_5":14929,"_28559":126722,"_3075":126795},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3699":74884,"_31384":74858,"_21647":126797,"_5":14929,"_28559":126726,"_3075":126798},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3699":74885,"_31384":74858,"_21647":126800,"_5":14929,"_28559":126730,"_3075":126801},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3699":74886,"_31384":74858,"_21647":126803,"_5":14929,"_28559":126730,"_3075":126804},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3699":74887,"_31384":74858,"_21647":126806,"_5":14929,"_28559":126734,"_3075":126807},[],"La aplicación criptográfica puede:",{"_3699":74888,"_31384":74858,"_21647":126809,"_5":14929,"_28559":126734,"_3075":126810},[],"permitir o bloquear claves RSA;",{"_3699":74889,"_31384":74858,"_21647":126812,"_5":14929,"_28559":126734,"_3075":126813},[],"limitar los tamaños RSA admitidos;",{"_3699":74890,"_31384":74858,"_21647":126815,"_5":14929,"_28559":126734,"_3075":126816},[],"permitir o bloquear claves ECDSA;",{"_3699":74891,"_31384":74858,"_21647":126818,"_5":14929,"_28559":126734,"_3075":126819},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3699":74892,"_31384":74858,"_21647":126821,"_5":14929,"_28559":126734,"_3075":126822},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3699":74893,"_31384":74858,"_21647":126824,"_5":14929,"_28559":126738,"_3075":126825},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3699":74894,"_31384":74858,"_21647":126827,"_5":14929,"_28559":126738,"_3075":121932},[],{"_3699":74895,"_31384":74858,"_21647":126829,"_5":14929,"_28559":126738,"_3075":126830},[],"Primera opción",{"_3699":74896,"_31384":74858,"_21647":126832,"_5":14929,"_28559":126738,"_3075":126833},[],"Segunda opción",{"_3699":74897,"_31384":74858,"_21647":126835,"_5":14929,"_28559":126738,"_3075":126836},[],"Si no hay ninguna",{"_3699":74898,"_31384":74858,"_21647":126838,"_5":14929,"_28559":126738,"_3075":126839},[],"Firma directa con una CA",{"_3699":74899,"_31384":74858,"_21647":126841,"_5":14929,"_28559":126738,"_3075":126842},[],"`issuance_profile` incluido en la solicitud",{"_3699":74900,"_31384":74858,"_21647":126844,"_5":14929,"_28559":126738,"_3075":126845},[],"`issuance_profile_id` de la solicitud",{"_3699":74901,"_31384":74858,"_21647":126847,"_5":14929,"_28559":126738,"_3075":126848},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3699":74902,"_31384":74858,"_21647":126850,"_5":14929,"_28559":126738,"_3075":126851},[],"Emisión mediante DMS",{"_3699":74903,"_31384":74858,"_21647":126853,"_5":14929,"_28559":126738,"_3075":57483},[],{"_3699":74904,"_31384":74858,"_21647":126855,"_5":14929,"_28559":126738,"_3075":126856},[],"`settings.issuance_profile` incluido en el DMS",{"_3699":74905,"_31384":74858,"_21647":126858,"_5":14929,"_28559":126738,"_3075":126859},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3699":74906,"_31384":74858,"_21647":126861,"_5":14929,"_28559":126738,"_3075":126862},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3699":74907,"_31384":74858,"_21647":126864,"_5":14929,"_28559":126738,"_3075":126865},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3699":74908,"_31384":74858,"_21647":126867,"_5":14929,"_28559":126746,"_3075":126868},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3699":74909,"_31384":74858,"_21647":126870,"_5":14929,"_28559":126750,"_3075":126871},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3699":74910,"_31384":74858,"_21647":126873,"_5":14929,"_28559":126754,"_3075":126874},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3699":74911,"_31384":74858,"_21647":126876,"_5":14929,"_28559":126758,"_3075":126877},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3699":74912,"_31384":74858,"_21647":126879,"_5":14929,"_28559":126762,"_3075":126880},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3699":74913,"_31384":74858,"_21647":126882,"_5":14929,"_28559":126762,"_3075":126883},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3699":74914,"_31384":74858,"_21647":126885,"_5":14929,"_28559":126766,"_3075":126886},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3699":74915,"_31384":74858,"_21647":126888,"_5":14929,"_28559":126766,"_3075":126889},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3699":74916,"_31384":74858,"_21647":126891,"_5":14929,"_28559":126766,"_3075":126892},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3699":74917,"_31384":74858,"_21647":126894,"_5":14929,"_28559":126766,"_3075":126895},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3699":74918,"_31384":74858,"_21647":126897,"_5":14929,"_28559":126770,"_3075":126898},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3699":74919,"_31384":74858,"_21647":126900,"_5":14929,"_28559":126770,"_3075":126901},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3699":74920,"_31384":74920,"_5":15283,"_3075":126903,"_31709":126904,"_21647":126906,"_28559":74920},"Validación de certificados",[51094,122172,56862,126905],"Validación",[],{"_3699":74921,"_31384":74920,"_21647":126908,"_5":14929,"_28559":74920,"_3075":126909},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3699":74922,"_31384":74920,"_5":31706,"_21647":126911,"_28559":126912,"_3075":126913},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3699":74923,"_31384":74920,"_5":31706,"_21647":126915,"_28559":126916,"_3075":126917},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3699":74924,"_31384":74920,"_5":31706,"_21647":126919,"_28559":126920,"_3075":126921},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3699":74925,"_31384":74920,"_21647":126923,"_5":14929,"_28559":74920,"_3075":126924},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3699":74926,"_31384":74920,"_21647":126926,"_5":14929,"_28559":126912,"_3075":126927},[],"Verifica estos criterios juntos:",{"_3699":74927,"_31384":74920,"_21647":126929,"_5":14929,"_28559":126912,"_3075":125863},[],{"_3699":74928,"_31384":74920,"_21647":126931,"_5":14929,"_28559":126912,"_3075":126932},[],"Resultado necesario",{"_3699":74929,"_31384":74920,"_21647":126934,"_5":14929,"_28559":126912,"_3075":126935},[],"Cadena y firma",{"_3699":74930,"_31384":74920,"_21647":126937,"_5":14929,"_28559":126912,"_3075":126938},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3699":74931,"_31384":74920,"_21647":126940,"_5":14929,"_28559":126912,"_3075":126941},[],"Fechas",{"_3699":74932,"_31384":74920,"_21647":126943,"_5":14929,"_28559":126912,"_3075":126944},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3699":74933,"_31384":74920,"_21647":126946,"_5":14929,"_28559":126912,"_3075":121842},[],{"_3699":74934,"_31384":74920,"_21647":126948,"_5":14929,"_28559":126912,"_3075":126949},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3699":74935,"_31384":74920,"_21647":126951,"_5":14929,"_28559":126912,"_3075":126952},[],"Uso",{"_3699":74936,"_31384":74920,"_21647":126954,"_5":14929,"_28559":126912,"_3075":126955},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3699":74937,"_31384":74920,"_21647":126957,"_5":14929,"_28559":126912,"_3075":126958},[],"Revocación",{"_3699":74938,"_31384":74920,"_21647":126960,"_5":14929,"_28559":126912,"_3075":126961},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3699":74939,"_31384":74920,"_21647":126963,"_5":14929,"_28559":126912,"_3075":126964},[],"Autorización",{"_3699":74940,"_31384":74920,"_21647":126966,"_5":14929,"_28559":126912,"_3075":126967},[],"La aplicación permite la acción a esa identidad.",{"_3699":74941,"_31384":74920,"_21647":126969,"_5":14929,"_28559":126912,"_3075":126970},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3699":74942,"_31384":74920,"_21647":126972,"_5":14929,"_28559":126916,"_3075":126973},[],"Mecanismo",{"_3699":74943,"_31384":74920,"_21647":126975,"_5":14929,"_28559":126916,"_3075":126976},[],"Cuándo utilizarlo",{"_3699":74944,"_31384":74920,"_21647":126978,"_5":14929,"_28559":126916,"_3075":126979},[],"Qué debes mantener",{"_3699":74945,"_31384":74920,"_21647":126981,"_5":14929,"_28559":126916,"_3075":57611},[],{"_3699":74946,"_31384":74920,"_21647":126983,"_5":14929,"_28559":126916,"_3075":126984},[],"Consulta del estado de un certificado concreto.",{"_3699":74947,"_31384":74920,"_21647":126986,"_5":14929,"_28559":126916,"_3075":126987},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3699":74948,"_31384":74920,"_21647":126989,"_5":14929,"_28559":126916,"_3075":57620},[],{"_3699":74949,"_31384":74920,"_21647":126991,"_5":14929,"_28559":126916,"_3075":126992},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3699":74950,"_31384":74920,"_21647":126994,"_5":14929,"_28559":126916,"_3075":126995},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3699":74951,"_31384":74920,"_21647":126997,"_5":14929,"_28559":126916,"_3075":126998},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3699":74952,"_31384":74920,"_21647":127000,"_5":14929,"_28559":126916,"_3075":127001},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3699":74953,"_31384":74920,"_21647":127003,"_5":14929,"_28559":126920,"_3075":127004},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3699":74954,"_31384":74920,"_21647":127006,"_5":14929,"_28559":126920,"_3075":127007},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3699":74955,"_31384":74920,"_21647":127009,"_5":14929,"_28559":126920,"_3075":127010},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3699":74956,"_31384":74920,"_21647":127012,"_5":14929,"_28559":126920,"_3075":127013},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3699":74957,"_31384":74920,"_21647":127015,"_5":14929,"_28559":126920,"_3075":127016},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3699":74958,"_31384":74920,"_21647":127018,"_5":14929,"_28559":126920,"_3075":127019},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3699":74959,"_31384":74920,"_21647":127021,"_5":14929,"_28559":126920,"_3075":127022},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3699":74960,"_31384":74920,"_21647":127024,"_5":14929,"_28559":126920,"_3075":127025},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3699":74961,"_31384":74920,"_21647":127027,"_5":14929,"_28559":126920,"_3075":127028},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3699":74962,"_31384":74962,"_5":15283,"_3075":127030,"_31709":127031,"_21647":127032,"_28559":74962},"Certificados",[51094,122172,56862,126234],[],{"_3699":74963,"_31384":74962,"_21647":127034,"_5":14929,"_28559":74962,"_3075":127035},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3699":74964,"_31384":74962,"_5":31706,"_21647":127037,"_28559":127038,"_3075":127039},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3699":74965,"_31384":74962,"_5":31706,"_21647":127041,"_28559":127042,"_3075":127043},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3699":74966,"_31384":74962,"_5":31706,"_21647":127045,"_28559":127046,"_3075":127047},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3699":74967,"_31384":74962,"_5":31706,"_21647":127049,"_28559":127050,"_3075":127051},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3699":74968,"_31384":74962,"_5":31706,"_21647":127053,"_28559":127054,"_3075":127055},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3699":74969,"_31384":74962,"_5":31706,"_21647":127057,"_28559":127058,"_3075":127059},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3699":74970,"_31384":74962,"_5":31706,"_21647":127061,"_28559":127062,"_3075":127063},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3699":74971,"_31384":74962,"_5":31706,"_21647":127065,"_28559":127066,"_3075":127067},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3699":74972,"_31384":74962,"_5":31706,"_21647":127069,"_28559":127070,"_3075":127071},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3699":74973,"_31384":74962,"_21647":127073,"_5":14929,"_28559":74962,"_3075":127074},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3699":74974,"_31384":74962,"_21647":127076,"_5":14929,"_28559":127038,"_3075":127077},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3699":74975,"_31384":74962,"_21647":127079,"_5":14929,"_28559":127038,"_3075":127080},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3699":74976,"_31384":74962,"_21647":127082,"_5":14929,"_28559":127038,"_3075":127083},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3699":74977,"_31384":74962,"_21647":127085,"_5":14929,"_28559":127038,"_3075":127086},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3699":74978,"_31384":74962,"_21647":127088,"_5":14929,"_28559":127038,"_3075":127089},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3699":74979,"_31384":74962,"_21647":127091,"_5":14929,"_28559":127038,"_3075":127092},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3699":74980,"_31384":74962,"_21647":127094,"_5":14929,"_28559":127038,"_3075":127095},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3699":74981,"_31384":74962,"_21647":127097,"_5":14929,"_28559":127042,"_3075":127098},[],"Descarga el PEM e inspecciónalo:",{"_3699":74982,"_31384":74962,"_21647":127100,"_5":14929,"_28559":127042,"_3075":127101},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3699":74983,"_31384":74962,"_21647":127103,"_5":14929,"_28559":127046,"_3075":127104},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3699":74984,"_31384":74962,"_21647":127106,"_5":14929,"_28559":127046,"_3075":127107},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3699":74985,"_31384":74962,"_21647":127109,"_5":14929,"_28559":127046,"_3075":127110},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3699":74986,"_31384":74962,"_21647":127112,"_5":14929,"_28559":127046,"_3075":127113},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3699":74987,"_31384":74962,"_21647":127115,"_5":14929,"_28559":127046,"_3075":127116},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3699":74988,"_31384":74962,"_21647":127118,"_5":14929,"_28559":127046,"_3075":127119},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3699":74989,"_31384":74962,"_21647":127121,"_5":14929,"_28559":127046,"_3075":127122},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3699":74990,"_31384":74962,"_21647":127124,"_5":14929,"_28559":127050,"_3075":127125},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3699":74991,"_31384":74962,"_21647":127127,"_5":14929,"_28559":127054,"_3075":127128},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3699":74992,"_31384":74962,"_21647":127130,"_5":14929,"_28559":127058,"_3075":127131},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3699":74993,"_31384":74962,"_21647":127133,"_5":14929,"_28559":127062,"_3075":127134},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3699":74994,"_31384":74962,"_21647":127136,"_5":14929,"_28559":127062,"_3075":127137},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3699":74995,"_31384":74962,"_21647":127139,"_5":14929,"_28559":127062,"_3075":127140},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3699":74996,"_31384":74962,"_21647":127142,"_5":14929,"_28559":127066,"_3075":127143},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3699":74997,"_31384":74962,"_21647":127145,"_5":14929,"_28559":127066,"_3075":127146},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3699":74998,"_31384":74962,"_21647":127148,"_5":14929,"_28559":127066,"_3075":127149},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3699":74999,"_31384":74962,"_21647":127151,"_5":14929,"_28559":127070,"_3075":127152},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3699":75000,"_31384":74962,"_21647":127154,"_5":14929,"_28559":127070,"_3075":127155},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3699":75001,"_31384":75001,"_5":15283,"_3075":127157,"_31709":127158,"_21647":127160,"_28559":75001},"Ciclo de vida de un certificado",[51094,122172,56862,127159],"Conceptos",[],{"_3699":75002,"_31384":75001,"_21647":127162,"_5":14929,"_28559":75001,"_3075":127163},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3699":75003,"_31384":75001,"_5":31706,"_21647":127165,"_28559":127166,"_3075":127167},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3699":75004,"_31384":75001,"_5":31706,"_21647":127169,"_28559":127170,"_3075":127171},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3699":75005,"_31384":75001,"_5":31706,"_21647":127173,"_28559":127174,"_3075":127175},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3699":75006,"_31384":75001,"_5":31706,"_21647":127177,"_28559":127178,"_3075":127179},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3699":75007,"_31384":75001,"_5":31706,"_21647":127181,"_28559":127182,"_3075":127183},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3699":75008,"_31384":75001,"_5":31706,"_21647":127185,"_28559":127186,"_3075":127187},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3699":75009,"_31384":75001,"_5":31706,"_21647":127189,"_28559":127190,"_3075":124857},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3699":75010,"_31384":75001,"_5":31706,"_21647":127192,"_28559":127193,"_3075":127194},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3699":75011,"_31384":75001,"_5":31706,"_21647":127196,"_28559":127197,"_3075":127198},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3699":75012,"_31384":75001,"_5":31706,"_21647":127200,"_28559":127201,"_3075":127202},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3699":75013,"_31384":75001,"_21647":127204,"_5":14929,"_28559":75001,"_3075":127205},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3699":75014,"_31384":75001,"_21647":127207,"_5":14929,"_28559":127170,"_3075":127208},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3699":75015,"_31384":75001,"_21647":127210,"_5":14929,"_28559":127174,"_3075":127211},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3699":75016,"_31384":75001,"_21647":127213,"_5":14929,"_28559":127178,"_3075":127214},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3699":75017,"_31384":75001,"_21647":127216,"_5":14929,"_28559":127182,"_3075":127217},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3699":75018,"_31384":75001,"_21647":127219,"_5":14929,"_28559":127186,"_3075":127220},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3699":75019,"_31384":75001,"_21647":127222,"_5":14929,"_28559":127190,"_3075":127223},[],"Lamassu persiste cuatro estados X.509:",{"_3699":75020,"_31384":75001,"_21647":127225,"_5":14929,"_28559":127190,"_3075":127226},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3699":75021,"_31384":75001,"_21647":127228,"_5":14929,"_28559":127190,"_3075":127229},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3699":75022,"_31384":75001,"_21647":127231,"_5":14929,"_28559":127190,"_3075":127232},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3699":75023,"_31384":75001,"_21647":127234,"_5":14929,"_28559":127190,"_3075":127235},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3699":75024,"_31384":75001,"_21647":127237,"_5":14929,"_28559":127190,"_3075":127238},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3699":75025,"_31384":75001,"_21647":127240,"_5":14929,"_28559":127193,"_3075":127241},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3699":75026,"_31384":75001,"_21647":127243,"_5":14929,"_28559":127193,"_3075":127244},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3699":75027,"_31384":75001,"_21647":127246,"_5":14929,"_28559":127193,"_3075":127247},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3699":75028,"_31384":75001,"_21647":127249,"_5":14929,"_28559":127197,"_3075":127250},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3699":75029,"_31384":75001,"_21647":127252,"_5":14929,"_28559":127197,"_3075":127253},[],"Antes de confirmar:",{"_3699":75030,"_31384":75001,"_21647":127255,"_5":14929,"_28559":127197,"_3075":127256},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3699":75031,"_31384":75001,"_21647":127258,"_5":14929,"_28559":127197,"_3075":127259},[],"Distribuye la nueva cadena de confianza.",{"_3699":75032,"_31384":75001,"_21647":127261,"_5":14929,"_28559":127197,"_3075":127262},[],"Reemite las identidades necesarias.",{"_3699":75033,"_31384":75001,"_21647":127264,"_5":14929,"_28559":127197,"_3075":127265},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3699":75034,"_31384":75001,"_21647":127267,"_5":14929,"_28559":127197,"_3075":127268},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3699":75035,"_31384":75001,"_21647":127270,"_5":14929,"_28559":127197,"_3075":127271},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3699":75036,"_31384":75001,"_21647":127273,"_5":14929,"_28559":127201,"_3075":127274},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3699":75037,"_31384":75001,"_21647":127276,"_5":14929,"_28559":127201,"_3075":127277},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3699":75038,"_31384":75001,"_21647":127279,"_5":14929,"_28559":127201,"_3075":127280},[],"Cambios de estado y razones de revocación.",{"_3699":75039,"_31384":75001,"_21647":127282,"_5":14929,"_28559":127201,"_3075":127283},[],"Publicación y vigencia de OCSP y CRLs.",{"_3699":75040,"_31384":75001,"_21647":127285,"_5":14929,"_28559":127201,"_3075":127286},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3699":75041,"_31384":75001,"_21647":127288,"_5":14929,"_28559":127201,"_3075":127289},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3699":75042,"_31384":75042,"_5":15283,"_3075":127291,"_31709":127292,"_21647":127293,"_28559":75042},"Modelo de confianza",[51094,122172,56862,127159],[],{"_3699":75043,"_31384":75042,"_21647":127295,"_5":14929,"_28559":75042,"_3075":127296},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3699":75044,"_31384":75042,"_5":31706,"_21647":127298,"_28559":127299,"_3075":127300},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3699":75045,"_31384":75042,"_5":31706,"_21647":127302,"_28559":127303,"_3075":127304},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3699":75046,"_31384":75042,"_5":31706,"_21647":127306,"_28559":127307,"_3075":127308},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3699":75047,"_31384":75042,"_5":31706,"_21647":127310,"_28559":127311,"_3075":127312},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3699":75048,"_31384":75042,"_5":31706,"_21647":127314,"_28559":127315,"_3075":127316},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3699":75049,"_31384":75042,"_5":31706,"_21647":127318,"_28559":127319,"_3075":127320},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3699":75050,"_31384":75042,"_5":31706,"_21647":127322,"_28559":127323,"_3075":127324},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3699":75051,"_31384":75042,"_5":31706,"_21647":127326,"_28559":127327,"_3075":127328},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3699":75052,"_31384":75042,"_5":31706,"_21647":127330,"_28559":127331,"_3075":127332},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3699":75053,"_31384":75042,"_5":31706,"_21647":127334,"_28559":127335,"_3075":127336},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3699":75054,"_31384":75042,"_21647":127338,"_5":14929,"_28559":75042,"_3075":127339},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3699":75055,"_31384":75042,"_21647":127341,"_5":14929,"_28559":127303,"_3075":127342},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3699":75056,"_31384":75042,"_21647":127344,"_5":14929,"_28559":127307,"_3075":127345},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3699":75057,"_31384":75042,"_21647":127347,"_5":14929,"_28559":127311,"_3075":127348},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3699":75058,"_31384":75042,"_21647":127350,"_5":14929,"_28559":127315,"_3075":127351},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3699":75059,"_31384":75042,"_21647":127353,"_5":14929,"_28559":127319,"_3075":127354},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3699":75060,"_31384":75042,"_21647":127356,"_5":14929,"_28559":127319,"_3075":127357},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3699":75061,"_31384":75042,"_21647":127359,"_5":14929,"_28559":127319,"_3075":127360},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3699":75062,"_31384":75042,"_21647":127362,"_5":14929,"_28559":127319,"_3075":127363},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3699":75063,"_31384":75042,"_21647":127365,"_5":14929,"_28559":127319,"_3075":127366},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3699":75064,"_31384":75042,"_21647":127368,"_5":14929,"_28559":127319,"_3075":127369},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3699":75065,"_31384":75042,"_21647":127371,"_5":14929,"_28559":127323,"_3075":127372},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3699":75066,"_31384":75042,"_21647":127374,"_5":14929,"_28559":127323,"_3075":127375},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3699":75067,"_31384":75042,"_21647":127377,"_5":14929,"_28559":127323,"_3075":127378},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3699":75068,"_31384":75042,"_21647":127380,"_5":14929,"_28559":127323,"_3075":127381},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3699":75069,"_31384":75042,"_21647":127383,"_5":14929,"_28559":127323,"_3075":127384},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3699":75070,"_31384":75042,"_21647":127386,"_5":14929,"_28559":127327,"_3075":127387},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3699":75071,"_31384":75042,"_21647":127389,"_5":14929,"_28559":127327,"_3075":127390},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3699":75072,"_31384":75042,"_21647":127392,"_5":14929,"_28559":127327,"_3075":127393},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3699":75073,"_31384":75042,"_21647":127395,"_5":14929,"_28559":127327,"_3075":127396},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3699":75074,"_31384":75042,"_21647":127398,"_5":14929,"_28559":127327,"_3075":127399},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3699":75075,"_31384":75042,"_21647":127401,"_5":14929,"_28559":127327,"_3075":127402},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3699":75076,"_31384":75042,"_21647":127404,"_5":14929,"_28559":127327,"_3075":127405},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3699":75077,"_31384":75042,"_21647":127407,"_5":14929,"_28559":127331,"_3075":127408},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3699":75078,"_31384":75042,"_21647":127410,"_5":14929,"_28559":127335,"_3075":127411},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3699":75079,"_31384":75042,"_21647":127413,"_5":14929,"_28559":127335,"_3075":127414},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3699":75080,"_31384":75042,"_21647":127416,"_5":14929,"_28559":127335,"_3075":127417},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3699":75081,"_31384":75042,"_21647":127419,"_5":14929,"_28559":127335,"_3075":127420},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3699":75082,"_31384":75042,"_21647":127422,"_5":14929,"_28559":127335,"_3075":127423},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3699":75083,"_31384":75042,"_21647":127425,"_5":14929,"_28559":127335,"_3075":127426},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3699":75084,"_31384":75042,"_21647":127428,"_5":14929,"_28559":127335,"_3075":127429},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3699":75085,"_31384":75085,"_5":15283,"_3075":127431,"_31709":127432,"_21647":127433,"_28559":75085},"Listas de revocación (CRL)",[51094,122172,56862,126905],[],{"_3699":75086,"_31384":75085,"_21647":127435,"_5":14929,"_28559":75085,"_3075":127436},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3699":75087,"_31384":75085,"_5":31706,"_21647":127438,"_28559":127439,"_3075":127440},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3699":75088,"_31384":75085,"_5":31706,"_21647":127442,"_28559":127443,"_3075":127444},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3699":75089,"_31384":75085,"_5":31706,"_21647":127446,"_28559":127447,"_3075":127448},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3699":75090,"_31384":75085,"_5":31706,"_21647":127450,"_28559":127451,"_3075":127452},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3699":75091,"_31384":75085,"_5":31706,"_21647":127454,"_28559":127455,"_3075":127456},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3699":75092,"_31384":75085,"_5":31706,"_21647":127458,"_28559":127459,"_3075":127460},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3699":75093,"_31384":75085,"_5":31706,"_21647":127462,"_28559":127463,"_3075":127464},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3699":75094,"_31384":75085,"_5":31706,"_21647":127466,"_28559":127467,"_3075":127468},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3699":75095,"_31384":75085,"_21647":127470,"_5":14929,"_28559":75085,"_3075":127471},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3699":75096,"_31384":75085,"_21647":127473,"_5":14929,"_28559":127439,"_3075":127474},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3699":75097,"_31384":75085,"_21647":127476,"_5":14929,"_28559":127439,"_3075":124024},[],{"_3699":75098,"_31384":75085,"_21647":127478,"_5":14929,"_28559":127439,"_3075":124519},[],{"_3699":75099,"_31384":75085,"_21647":127480,"_5":14929,"_28559":127439,"_3075":52755},[],{"_3699":75100,"_31384":75085,"_21647":127482,"_5":14929,"_28559":127439,"_3075":127483},[],"ID de la CA a la que pertenecen los ajustes.",{"_3699":75101,"_31384":75085,"_21647":127485,"_5":14929,"_28559":127439,"_3075":58118},[],{"_3699":75102,"_31384":75085,"_21647":127487,"_5":14929,"_28559":127439,"_3075":127488},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3699":75103,"_31384":75085,"_21647":127490,"_5":14929,"_28559":127439,"_3075":58124},[],{"_3699":75104,"_31384":75085,"_21647":127492,"_5":14929,"_28559":127439,"_3075":127493},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3699":75105,"_31384":75085,"_21647":127495,"_5":14929,"_28559":127439,"_3075":58130},[],{"_3699":75106,"_31384":75085,"_21647":127497,"_5":14929,"_28559":127439,"_3075":127498},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3699":75107,"_31384":75085,"_21647":127500,"_5":14929,"_28559":127439,"_3075":127501},[],"Campo de `crl_options`",{"_3699":75108,"_31384":75085,"_21647":127503,"_5":14929,"_28559":127439,"_3075":124519},[],{"_3699":75109,"_31384":75085,"_21647":127505,"_5":14929,"_28559":127439,"_3075":127506},[],"Valor inicial",{"_3699":75110,"_31384":75085,"_21647":127508,"_5":14929,"_28559":127439,"_3075":58144},[],{"_3699":75111,"_31384":75085,"_21647":127510,"_5":14929,"_28559":127439,"_3075":127511},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3699":75112,"_31384":75085,"_21647":127513,"_5":14929,"_28559":127439,"_3075":127514},[],"7 días.",{"_3699":75113,"_31384":75085,"_21647":127516,"_5":14929,"_28559":127439,"_3075":58153},[],{"_3699":75114,"_31384":75085,"_21647":127518,"_5":14929,"_28559":127439,"_3075":127519},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3699":75115,"_31384":75085,"_21647":127521,"_5":14929,"_28559":127439,"_3075":127522},[],"6 días y 23 horas.",{"_3699":75116,"_31384":75085,"_21647":127524,"_5":14929,"_28559":127439,"_3075":58162},[],{"_3699":75117,"_31384":75085,"_21647":127526,"_5":14929,"_28559":127439,"_3075":127527},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3699":75118,"_31384":75085,"_21647":127529,"_5":14929,"_28559":127439,"_3075":58168},[],{"_3699":75119,"_31384":75085,"_21647":127531,"_5":14929,"_28559":127439,"_3075":58171},[],{"_3699":75120,"_31384":75085,"_21647":127533,"_5":14929,"_28559":127439,"_3075":127534},[],"Número de serie del certificado existente que firma la CRL.",{"_3699":75121,"_31384":75085,"_21647":127536,"_5":14929,"_28559":127439,"_3075":127537},[],"Número de serie del certificado actual de la CA.",{"_3699":75122,"_31384":75085,"_21647":127539,"_5":14929,"_28559":127439,"_3075":127540},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3699":75123,"_31384":75085,"_21647":127542,"_5":14929,"_28559":127439,"_3075":127543},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3699":75124,"_31384":75085,"_21647":127545,"_5":14929,"_28559":127439,"_3075":127546},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3699":75125,"_31384":75085,"_21647":127548,"_5":14929,"_28559":127439,"_3075":127549},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3699":75126,"_31384":75085,"_21647":127551,"_5":14929,"_28559":127439,"_3075":127552},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3699":75127,"_31384":75085,"_21647":127554,"_5":14929,"_28559":127439,"_3075":127555},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3699":75128,"_31384":75085,"_21647":127557,"_5":14929,"_28559":127439,"_3075":127558},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3699":75129,"_31384":75085,"_21647":127560,"_5":14929,"_28559":127439,"_3075":127561},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3699":75130,"_31384":75085,"_21647":127563,"_5":14929,"_28559":127439,"_3075":127564},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3699":75131,"_31384":75085,"_21647":127566,"_5":14929,"_28559":127439,"_3075":127567},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3699":75132,"_31384":75085,"_21647":127569,"_5":14929,"_28559":127439,"_3075":127570},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3699":75133,"_31384":75085,"_21647":127572,"_5":14929,"_28559":127443,"_3075":127573},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3699":75134,"_31384":75085,"_21647":127575,"_5":14929,"_28559":127443,"_3075":127576},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3699":75135,"_31384":75085,"_21647":127578,"_5":14929,"_28559":127443,"_3075":127579},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3699":75136,"_31384":75085,"_21647":127581,"_5":14929,"_28559":127443,"_3075":127582},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3699":75137,"_31384":75085,"_21647":127584,"_5":14929,"_28559":127447,"_3075":127585},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3699":75138,"_31384":75085,"_21647":127587,"_5":14929,"_28559":127447,"_3075":127588},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3699":75139,"_31384":75085,"_21647":127590,"_5":14929,"_28559":127447,"_3075":127591},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3699":75140,"_31384":75085,"_21647":127593,"_5":14929,"_28559":127447,"_3075":127594},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3699":75141,"_31384":75085,"_21647":127596,"_5":14929,"_28559":127447,"_3075":127597},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3699":75142,"_31384":75085,"_21647":127599,"_5":14929,"_28559":127447,"_3075":127600},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3699":75143,"_31384":75085,"_21647":127602,"_5":14929,"_28559":127447,"_3075":127603},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3699":75144,"_31384":75085,"_21647":127605,"_5":14929,"_28559":127447,"_3075":127606},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3699":75145,"_31384":75085,"_21647":127608,"_5":14929,"_28559":127447,"_3075":127609},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3699":75146,"_31384":75085,"_21647":127611,"_5":14929,"_28559":127451,"_3075":127612},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3699":75147,"_31384":75085,"_21647":127614,"_5":14929,"_28559":127451,"_3075":127615},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3699":75148,"_31384":75085,"_21647":127617,"_5":14929,"_28559":127455,"_3075":127618},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3699":75149,"_31384":75085,"_21647":127620,"_5":14929,"_28559":127455,"_3075":127621},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3699":75150,"_31384":75085,"_21647":127623,"_5":14929,"_28559":127455,"_3075":127624},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3699":75151,"_31384":75085,"_21647":127626,"_5":14929,"_28559":127455,"_3075":127627},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3699":75152,"_31384":75085,"_21647":127629,"_5":14929,"_28559":127455,"_3075":127630},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3699":75153,"_31384":75085,"_21647":127632,"_5":14929,"_28559":127459,"_3075":127633},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3699":75154,"_31384":75085,"_21647":127635,"_5":14929,"_28559":127459,"_3075":123944},[],{"_3699":75155,"_31384":75085,"_21647":127637,"_5":14929,"_28559":127459,"_3075":127638},[],"Path relativo",{"_3699":75156,"_31384":75085,"_21647":127640,"_5":14929,"_28559":127459,"_3075":121932},[],{"_3699":75157,"_31384":75085,"_21647":127642,"_5":14929,"_28559":127459,"_3075":58283},[],{"_3699":75158,"_31384":75085,"_21647":127644,"_5":14929,"_28559":127459,"_3075":58286},[],{"_3699":75159,"_31384":75085,"_21647":127646,"_5":14929,"_28559":127459,"_3075":127647},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3699":75160,"_31384":75085,"_21647":127649,"_5":14929,"_28559":127459,"_3075":58283},[],{"_3699":75161,"_31384":75085,"_21647":127651,"_5":14929,"_28559":127459,"_3075":58294},[],{"_3699":75162,"_31384":75085,"_21647":127653,"_5":14929,"_28559":127459,"_3075":127654},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3699":75163,"_31384":75085,"_21647":127656,"_5":14929,"_28559":127459,"_3075":58300},[],{"_3699":75164,"_31384":75085,"_21647":127658,"_5":14929,"_28559":127459,"_3075":58294},[],{"_3699":75165,"_31384":75085,"_21647":127660,"_5":14929,"_28559":127459,"_3075":127661},[],"Sustituir la configuración de CRL de una CA.",{"_3699":75166,"_31384":75085,"_21647":127663,"_5":14929,"_28559":127459,"_3075":58308},[],{"_3699":75167,"_31384":75085,"_21647":127665,"_5":14929,"_28559":127459,"_3075":58294},[],{"_3699":75168,"_31384":75085,"_21647":127667,"_5":14929,"_28559":127459,"_3075":127668},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3699":75169,"_31384":75085,"_21647":127670,"_5":14929,"_28559":127459,"_3075":127671},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3699":75170,"_31384":75085,"_21647":127673,"_5":14929,"_28559":127459,"_3075":127674},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3699":75171,"_31384":75085,"_21647":127676,"_5":14929,"_28559":127459,"_3075":127677},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3699":75172,"_31384":75085,"_21647":127679,"_5":14929,"_28559":127463,"_3075":127680},[],"Síntoma",{"_3699":75173,"_31384":75085,"_21647":127682,"_5":14929,"_28559":127463,"_3075":127683},[],"Causa",{"_3699":75174,"_31384":75085,"_21647":127685,"_5":14929,"_28559":127463,"_3075":127686},[],"Acción",{"_3699":75175,"_31384":75085,"_21647":127688,"_5":14929,"_28559":127463,"_3075":127689},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3699":75176,"_31384":75085,"_21647":127691,"_5":14929,"_28559":127463,"_3075":127692},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3699":75177,"_31384":75085,"_21647":127694,"_5":14929,"_28559":127463,"_3075":127695},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3699":75178,"_31384":75085,"_21647":127697,"_5":14929,"_28559":127463,"_3075":127698},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3699":75179,"_31384":75085,"_21647":127700,"_5":14929,"_28559":127463,"_3075":127701},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3699":75180,"_31384":75085,"_21647":127703,"_5":14929,"_28559":127463,"_3075":127704},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3699":75181,"_31384":75085,"_21647":127706,"_5":14929,"_28559":127463,"_3075":127707},[],"`PUT` devuelve 400.",{"_3699":75182,"_31384":75085,"_21647":127709,"_5":14929,"_28559":127463,"_3075":127710},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3699":75183,"_31384":75085,"_21647":127712,"_5":14929,"_28559":127463,"_3075":127713},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3699":75184,"_31384":75085,"_21647":127715,"_5":14929,"_28559":127463,"_3075":127716},[],"`PUT` devuelve 404.",{"_3699":75185,"_31384":75085,"_21647":127718,"_5":14929,"_28559":127463,"_3075":127719},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3699":75186,"_31384":75085,"_21647":127721,"_5":14929,"_28559":127463,"_3075":127722},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3699":75187,"_31384":75085,"_21647":127724,"_5":14929,"_28559":127463,"_3075":127725},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3699":75188,"_31384":75085,"_21647":127727,"_5":14929,"_28559":127463,"_3075":127728},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3699":75189,"_31384":75085,"_21647":127730,"_5":14929,"_28559":127463,"_3075":127731},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3699":75190,"_31384":75085,"_21647":127733,"_5":14929,"_28559":127463,"_3075":127734},[],"La CRL no cambia tras revocar un certificado.",{"_3699":75191,"_31384":75085,"_21647":127736,"_5":14929,"_28559":127463,"_3075":127737},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3699":75192,"_31384":75085,"_21647":127739,"_5":14929,"_28559":127463,"_3075":127740},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3699":75193,"_31384":75085,"_21647":127742,"_5":14929,"_28559":127463,"_3075":127743},[],"Un verificador rechaza la CRL por el emisor.",{"_3699":75194,"_31384":75085,"_21647":127745,"_5":14929,"_28559":127463,"_3075":127746},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3699":75195,"_31384":75085,"_21647":127748,"_5":14929,"_28559":127463,"_3075":127749},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3699":75196,"_31384":75085,"_21647":127751,"_5":14929,"_28559":127467,"_3075":127752},[],"RFC 5280: perfil X.509 y CRL.",{"_3699":75197,"_31384":75085,"_21647":127754,"_5":14929,"_28559":127467,"_3075":58400},[],{"_3699":75198,"_31384":75085,"_21647":127756,"_5":14929,"_28559":127467,"_3075":58403},[],{"_3699":75199,"_31384":75085,"_21647":127758,"_5":14929,"_28559":127467,"_3075":127759},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3699":75200,"_31384":75085,"_21647":127761,"_5":14929,"_28559":127467,"_3075":127762},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3699":75201,"_31384":75201,"_5":15283,"_3075":127764,"_31709":127765,"_21647":127766,"_28559":75201},"Protocolos de enrolamiento",[51094,122172,56862,126234],[],{"_3699":75202,"_31384":75201,"_21647":127768,"_5":14929,"_28559":75201,"_3075":127769},[],"Solicita y renueva certificados de una CA de Lamassu.",{"_3699":75203,"_31384":75201,"_21647":127771,"_5":14929,"_28559":75201,"_3075":127772},[],"Lamassu admite EST (Enrollment over Secure Transport), definido en el RFC 7030. El DMS aplica la política de enrolamiento y la CA configurada emite los certificados.",{"_3699":75204,"_31384":75201,"_21647":127774,"_5":14929,"_28559":75201,"_3075":127775},[],"Endpoint principal",{"_3699":75205,"_31384":75201,"_21647":127777,"_5":14929,"_28559":75201,"_3075":127778},[],"Para qué sirve",{"_3699":75206,"_31384":75201,"_21647":127780,"_5":14929,"_28559":75201,"_3075":58427},[],{"_3699":75207,"_31384":75201,"_21647":127782,"_5":14929,"_28559":75201,"_3075":127783},[],"Obtiene los certificados de CA publicados por el DMS.",{"_3699":75208,"_31384":75201,"_21647":127785,"_5":14929,"_28559":75201,"_3075":58433},[],{"_3699":75209,"_31384":75201,"_21647":127787,"_5":14929,"_28559":75201,"_3075":127788},[],"Solicita un certificado inicial mediante una CSR.",{"_3699":75210,"_31384":75201,"_21647":127790,"_5":14929,"_28559":75201,"_3075":58438},[],{"_3699":75211,"_31384":75201,"_21647":127792,"_5":14929,"_28559":75201,"_3075":127793},[],"Solicita un certificado sucesor para una identidad existente.",{"_3699":75212,"_31384":75201,"_21647":127795,"_5":14929,"_28559":75201,"_3075":127796},[],"Consulta EST (RFC 7030) para configurar el cliente, preparar la autenticación, consultar los formatos y usar la generación opcional de claves en el servidor.",{"_3699":75213,"_31384":75213,"_5":15283,"_3075":127798,"_31709":127799,"_21647":127800,"_28559":75213},"Claves y motores criptográficos",[51094,122172,56862,126234],[],{"_3699":75214,"_31384":75213,"_21647":127802,"_5":14929,"_28559":75213,"_3075":127803},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3699":75215,"_31384":75213,"_5":31706,"_21647":127805,"_28559":127806,"_3075":127807},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3699":75216,"_31384":75213,"_5":31706,"_21647":127809,"_28559":127810,"_3075":127811},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3699":75217,"_31384":75213,"_5":31706,"_21647":127813,"_28559":127814,"_3075":58463},[],"/docs/es/platform/pki/key-management#file-system",{"_3699":75218,"_31384":75213,"_5":31706,"_21647":127816,"_28559":127817,"_3075":58467},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3699":75219,"_31384":75213,"_5":31706,"_21647":127819,"_28559":127820,"_3075":58471},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3699":75220,"_31384":75213,"_5":31706,"_21647":127822,"_28559":127823,"_3075":58475},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3699":75221,"_31384":75213,"_5":31706,"_21647":127825,"_28559":127826,"_3075":58479},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3699":75222,"_31384":75213,"_5":31706,"_21647":127828,"_28559":127829,"_3075":58483},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3699":75223,"_31384":75213,"_5":31706,"_21647":127831,"_28559":127832,"_3075":127833},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3699":75224,"_31384":75213,"_5":31706,"_21647":127835,"_28559":127836,"_3075":127837},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3699":75225,"_31384":75213,"_5":31706,"_21647":127839,"_28559":127840,"_3075":127841},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3699":75226,"_31384":75213,"_5":31706,"_21647":127843,"_28559":127844,"_3075":127845},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3699":75227,"_31384":75213,"_5":31706,"_21647":127847,"_28559":127848,"_3075":127849},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3699":75228,"_31384":75213,"_5":31706,"_21647":127851,"_28559":127852,"_3075":127853},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3699":75229,"_31384":75213,"_5":31706,"_21647":127855,"_28559":127856,"_3075":127857},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3699":75230,"_31384":75213,"_5":31706,"_21647":127859,"_28559":127860,"_3075":58515},[],"/docs/es/platform/pki/key-management#sign",{"_3699":75231,"_31384":75213,"_5":31706,"_21647":127862,"_28559":127863,"_3075":58519},[],"/docs/es/platform/pki/key-management#verify",{"_3699":75232,"_31384":75213,"_5":31706,"_21647":127865,"_28559":127866,"_3075":127867},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3699":75233,"_31384":75213,"_5":31706,"_21647":127869,"_28559":127870,"_3075":127871},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3699":75234,"_31384":75213,"_5":31706,"_21647":127873,"_28559":127874,"_3075":127875},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3699":75235,"_31384":75213,"_21647":127877,"_5":14929,"_28559":75213,"_3075":127878},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3699":75236,"_31384":75213,"_21647":127880,"_5":14929,"_28559":75213,"_3075":127881},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3699":75237,"_31384":75213,"_21647":127883,"_5":14929,"_28559":127806,"_3075":127884},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3699":75238,"_31384":75213,"_21647":127886,"_5":14929,"_28559":127806,"_3075":127887},[],"En la práctica, permite:",{"_3699":75239,"_31384":75213,"_21647":127889,"_5":14929,"_28559":127806,"_3075":127890},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3699":75240,"_31384":75213,"_21647":127892,"_5":14929,"_28559":127806,"_3075":127893},[],"Importar claves creadas externamente.",{"_3699":75241,"_31384":75213,"_21647":127895,"_5":14929,"_28559":127806,"_3075":127896},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3699":75242,"_31384":75213,"_21647":127898,"_5":14929,"_28559":127806,"_3075":127899},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3699":75243,"_31384":75213,"_21647":127901,"_5":14929,"_28559":127810,"_3075":127902},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3699":75244,"_31384":75213,"_21647":127904,"_5":14929,"_28559":127810,"_3075":127905},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3699":75245,"_31384":75213,"_21647":127907,"_5":14929,"_28559":127810,"_3075":127908},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3699":75246,"_31384":75213,"_21647":127910,"_5":14929,"_28559":127814,"_3075":127911},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3699":75247,"_31384":75213,"_21647":127913,"_5":14929,"_28559":127817,"_3075":127914},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3699":75248,"_31384":75213,"_21647":127916,"_5":14929,"_28559":127817,"_3075":127917},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3699":75249,"_31384":75213,"_21647":127919,"_5":14929,"_28559":127820,"_3075":127920},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3699":75250,"_31384":75213,"_21647":127922,"_5":14929,"_28559":127823,"_3075":127923},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3699":75251,"_31384":75213,"_21647":127925,"_5":14929,"_28559":127826,"_3075":127926},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3699":75252,"_31384":75213,"_21647":127928,"_5":14929,"_28559":127829,"_3075":127929},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3699":75253,"_31384":75213,"_21647":127931,"_5":14929,"_28559":127829,"_3075":127932},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3699":75254,"_31384":75213,"_21647":127934,"_5":14929,"_28559":127829,"_3075":127935},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3699":75255,"_31384":75213,"_21647":127937,"_5":14929,"_28559":127829,"_3075":127938},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3699":75256,"_31384":75213,"_21647":127940,"_5":14929,"_28559":127832,"_3075":127941},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3699":75257,"_31384":75213,"_21647":127943,"_5":14929,"_28559":127832,"_3075":127944},[],"La tabla incluye los siguientes campos:",{"_3699":75258,"_31384":75213,"_21647":127946,"_5":14929,"_28559":127832,"_3075":127947},[],"**Name**: nombre descriptivo de la clave.",{"_3699":75259,"_31384":75213,"_21647":127949,"_5":14929,"_28559":127832,"_3075":127950},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3699":75260,"_31384":75213,"_21647":127952,"_5":14929,"_28559":127832,"_3075":127953},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3699":75261,"_31384":75213,"_21647":127955,"_5":14929,"_28559":127832,"_3075":127956},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3699":75262,"_31384":75213,"_21647":127958,"_5":14929,"_28559":127832,"_3075":127959},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3699":75263,"_31384":75213,"_21647":127961,"_5":14929,"_28559":127832,"_3075":127962},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3699":75264,"_31384":75213,"_21647":127964,"_5":14929,"_28559":127832,"_3075":127965},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3699":75265,"_31384":75213,"_21647":127967,"_5":14929,"_28559":127832,"_3075":127968},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3699":75266,"_31384":75213,"_21647":127970,"_5":14929,"_28559":127832,"_3075":127971},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3699":75267,"_31384":75213,"_21647":127973,"_5":14929,"_28559":127832,"_3075":127974},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3699":75268,"_31384":75213,"_21647":127976,"_5":14929,"_28559":127832,"_3075":127977},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3699":75269,"_31384":75213,"_21647":127979,"_5":14929,"_28559":127832,"_3075":127980},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3699":75270,"_31384":75213,"_21647":127982,"_5":14929,"_28559":127832,"_3075":127983},[],"**Delete Key** para eliminar la clave del sistema.",{"_3699":75271,"_31384":75213,"_21647":127985,"_5":14929,"_28559":127836,"_3075":127986},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3699":75272,"_31384":75213,"_21647":127988,"_5":14929,"_28559":127840,"_3075":127989},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3699":75273,"_31384":75213,"_21647":127991,"_5":14929,"_28559":127840,"_3075":127992},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3699":75274,"_31384":75213,"_21647":127994,"_5":14929,"_28559":127840,"_3075":127995},[],"**Key Name**: nombre único y descriptivo.",{"_3699":75275,"_31384":75213,"_21647":127997,"_5":14929,"_28559":127840,"_3075":127998},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3699":75276,"_31384":75213,"_21647":128000,"_5":14929,"_28559":127840,"_3075":128001},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3699":75277,"_31384":75213,"_21647":128003,"_5":14929,"_28559":127840,"_3075":128004},[],"**Tags**: metadatos para clasificar la clave.",{"_3699":75278,"_31384":75213,"_21647":128006,"_5":14929,"_28559":127840,"_3075":128007},[],"**Metadata**: información adicional para usos avanzados.",{"_3699":75279,"_31384":75213,"_21647":128009,"_5":14929,"_28559":127844,"_3075":128010},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3699":75280,"_31384":75213,"_21647":128012,"_5":14929,"_28559":127844,"_3075":128013},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3699":75281,"_31384":75213,"_21647":128015,"_5":14929,"_28559":127844,"_3075":128016},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3699":75282,"_31384":75213,"_21647":128018,"_5":14929,"_28559":127844,"_3075":128019},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3699":75283,"_31384":75213,"_21647":128021,"_5":14929,"_28559":127844,"_3075":128022},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3699":75284,"_31384":75213,"_21647":128024,"_5":14929,"_28559":127844,"_3075":128025},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3699":75285,"_31384":75213,"_21647":128027,"_5":14929,"_28559":127844,"_3075":128028},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3699":75286,"_31384":75213,"_21647":128030,"_5":14929,"_28559":127844,"_3075":128031},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3699":75287,"_31384":75213,"_21647":128033,"_5":14929,"_28559":127844,"_3075":128034},[],"**Metadata**: información adicional opcional.",{"_3699":75288,"_31384":75213,"_21647":128036,"_5":14929,"_28559":127844,"_3075":128037},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3699":75289,"_31384":75213,"_21647":128039,"_5":14929,"_28559":127844,"_3075":128040},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3699":75290,"_31384":75213,"_21647":128042,"_5":14929,"_28559":127848,"_3075":128043},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3699":75291,"_31384":75213,"_21647":128045,"_5":14929,"_28559":127852,"_3075":128046},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3699":75292,"_31384":75213,"_21647":128048,"_5":14929,"_28559":127852,"_3075":128049},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3699":75293,"_31384":75213,"_21647":128051,"_5":14929,"_28559":127852,"_3075":128052},[],"**Key Name**: nombre descriptivo.",{"_3699":75294,"_31384":75213,"_21647":128054,"_5":14929,"_28559":127852,"_3075":128055},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3699":75295,"_31384":75213,"_21647":128057,"_5":14929,"_28559":127852,"_3075":128058},[],"**Tags**: etiquetas asociadas.",{"_3699":75296,"_31384":75213,"_21647":128060,"_5":14929,"_28559":127852,"_3075":128061},[],"**Aliases**: nombres alternativos.",{"_3699":75297,"_31384":75213,"_21647":128063,"_5":14929,"_28559":127852,"_3075":128064},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3699":75298,"_31384":75213,"_21647":128066,"_5":14929,"_28559":127852,"_3075":128067},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3699":75299,"_31384":75213,"_21647":128069,"_5":14929,"_28559":127852,"_3075":128070},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3699":75300,"_31384":75213,"_21647":128072,"_5":14929,"_28559":127852,"_3075":128073},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3699":75301,"_31384":75213,"_21647":128075,"_5":14929,"_28559":127856,"_3075":128076},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3699":75302,"_31384":75213,"_21647":128078,"_5":14929,"_28559":127856,"_3075":128079},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3699":75303,"_31384":75213,"_21647":128081,"_5":14929,"_28559":127856,"_3075":128082},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3699":75304,"_31384":75213,"_21647":128084,"_5":14929,"_28559":127860,"_3075":128085},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3699":75305,"_31384":75213,"_21647":128087,"_5":14929,"_28559":127860,"_3075":128088},[],"Campos principales:",{"_3699":75306,"_31384":75213,"_21647":128090,"_5":14929,"_28559":127860,"_3075":128091},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3699":75307,"_31384":75213,"_21647":128093,"_5":14929,"_28559":127860,"_3075":128094},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3699":75308,"_31384":75213,"_21647":128096,"_5":14929,"_28559":127860,"_3075":128097},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3699":75309,"_31384":75213,"_21647":128099,"_5":14929,"_28559":127860,"_3075":128100},[],"**Message**: contenido que se va a firmar.",{"_3699":75310,"_31384":75213,"_21647":128102,"_5":14929,"_28559":127860,"_3075":128103},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3699":75311,"_31384":75213,"_21647":128105,"_5":14929,"_28559":127863,"_3075":128106},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3699":75312,"_31384":75213,"_21647":128108,"_5":14929,"_28559":127863,"_3075":128088},[],{"_3699":75313,"_31384":75213,"_21647":128110,"_5":14929,"_28559":127863,"_3075":128111},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3699":75314,"_31384":75213,"_21647":128113,"_5":14929,"_28559":127863,"_3075":128114},[],"**Message Type**: `Raw` o `Digest`.",{"_3699":75315,"_31384":75213,"_21647":128116,"_5":14929,"_28559":127863,"_3075":128117},[],"**Payload Encoding**: codificación del mensaje.",{"_3699":75316,"_31384":75213,"_21647":128119,"_5":14929,"_28559":127863,"_3075":128120},[],"**Message**: mensaje original o hash.",{"_3699":75317,"_31384":75213,"_21647":128122,"_5":14929,"_28559":127863,"_3075":128123},[],"**Signature**: firma que se desea comprobar.",{"_3699":75318,"_31384":75213,"_21647":128125,"_5":14929,"_28559":127863,"_3075":128126},[],"**Result**: indicador del resultado de la validación.",{"_3699":75319,"_31384":75213,"_21647":128128,"_5":14929,"_28559":127866,"_3075":128129},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3699":75320,"_31384":75213,"_21647":128131,"_5":14929,"_28559":127866,"_3075":128132},[],"Este flujo es útil para:",{"_3699":75321,"_31384":75213,"_21647":128134,"_5":14929,"_28559":127866,"_3075":128135},[],"Solicitar certificados a una CA externa.",{"_3699":75322,"_31384":75213,"_21647":128137,"_5":14929,"_28559":127866,"_3075":128138},[],"Renovar una identidad manteniendo la misma clave.",{"_3699":75323,"_31384":75213,"_21647":128140,"_5":14929,"_28559":127866,"_3075":128141},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3699":75324,"_31384":75213,"_21647":128143,"_5":14929,"_28559":127866,"_3075":128144},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3699":75325,"_31384":75213,"_21647":128146,"_5":14929,"_28559":127866,"_3075":128147},[],"**Organization (O)**: organización o empresa.",{"_3699":75326,"_31384":75213,"_21647":128149,"_5":14929,"_28559":127866,"_3075":128150},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3699":75327,"_31384":75213,"_21647":128152,"_5":14929,"_28559":127866,"_3075":128153},[],"**Country (C)**: código de país de dos letras.",{"_3699":75328,"_31384":75213,"_21647":128155,"_5":14929,"_28559":127866,"_3075":128156},[],"**State / Province (ST)**: estado o provincia.",{"_3699":75329,"_31384":75213,"_21647":128158,"_5":14929,"_28559":127866,"_3075":128159},[],"**Locality (L)**: ciudad o localidad.",{"_3699":75330,"_31384":75213,"_21647":128161,"_5":14929,"_28559":127866,"_3075":128162},[],"**Email Address**: correo de contacto.",{"_3699":75331,"_31384":75213,"_21647":128164,"_5":14929,"_28559":127866,"_3075":128165},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3699":75332,"_31384":75213,"_21647":128167,"_5":14929,"_28559":127866,"_3075":128168},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3699":75333,"_31384":75213,"_21647":128170,"_5":14929,"_28559":127870,"_3075":128171},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3699":75334,"_31384":75213,"_21647":128173,"_5":14929,"_28559":127870,"_3075":128174},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3699":75335,"_31384":75213,"_21647":128176,"_5":14929,"_28559":127874,"_3075":128177},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3699":75336,"_31384":75213,"_21647":128179,"_5":14929,"_28559":127874,"_3075":128180},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3699":75337,"_31384":75337,"_5":15283,"_3075":128182,"_31709":128183,"_21647":128184,"_28559":75337},"Validación online con OCSP",[51094,122172,56862,126905],[],{"_3699":75338,"_31384":75337,"_21647":128186,"_5":14929,"_28559":75337,"_3075":128187},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3699":75339,"_31384":75337,"_5":31706,"_21647":128189,"_28559":128190,"_3075":128191},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3699":75340,"_31384":75337,"_5":31706,"_21647":128193,"_28559":128194,"_3075":128195},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3699":75341,"_31384":75337,"_5":31706,"_21647":128197,"_28559":128198,"_3075":128199},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3699":75342,"_31384":75337,"_5":31706,"_21647":128201,"_28559":128202,"_3075":128203},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3699":75343,"_31384":75337,"_5":31706,"_21647":128205,"_28559":128206,"_3075":128207},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3699":75344,"_31384":75337,"_5":31706,"_21647":128209,"_28559":128210,"_3075":127468},[],"/docs/es/platform/pki/ocsp#referencias",{"_3699":75345,"_31384":75337,"_21647":128212,"_5":14929,"_28559":75337,"_3075":128213},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3699":75346,"_31384":75337,"_21647":128215,"_5":14929,"_28559":128190,"_3075":128216},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3699":75347,"_31384":75337,"_21647":128218,"_5":14929,"_28559":128190,"_3075":128219},[],"Estado del registro",{"_3699":75348,"_31384":75337,"_21647":128221,"_5":14929,"_28559":128190,"_3075":128222},[],"Respuesta firmada",{"_3699":75349,"_31384":75337,"_21647":128224,"_5":14929,"_28559":128190,"_3075":55998},[],{"_3699":75350,"_31384":75337,"_21647":128226,"_5":14929,"_28559":128190,"_3075":58883},[],{"_3699":75351,"_31384":75337,"_21647":128228,"_5":14929,"_28559":128190,"_3075":56015},[],{"_3699":75352,"_31384":75337,"_21647":128230,"_5":14929,"_28559":128190,"_3075":128231},[],"`Revoked`, con razón y fecha de revocación.",{"_3699":75353,"_31384":75337,"_21647":128233,"_5":14929,"_28559":128190,"_3075":128234},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3699":75354,"_31384":75337,"_21647":128236,"_5":14929,"_28559":128190,"_3075":128237},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3699":75355,"_31384":75337,"_21647":128239,"_5":14929,"_28559":128190,"_3075":128240},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3699":75356,"_31384":75337,"_21647":128242,"_5":14929,"_28559":128190,"_3075":128243},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3699":75357,"_31384":75337,"_21647":128245,"_5":14929,"_28559":128190,"_3075":128246},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3699":75358,"_31384":75337,"_21647":128248,"_5":14929,"_28559":128194,"_3075":128249},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3699":75359,"_31384":75337,"_21647":128251,"_5":14929,"_28559":128194,"_3075":128252},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3699":75360,"_31384":75337,"_21647":128254,"_5":14929,"_28559":128198,"_3075":128255},[],"El servicio acepta:",{"_3699":75361,"_31384":75337,"_21647":128257,"_5":14929,"_28559":128198,"_3075":123944},[],{"_3699":75362,"_31384":75337,"_21647":128259,"_5":14929,"_28559":128198,"_3075":128260},[],"Ruta del servicio VA",{"_3699":75363,"_31384":75337,"_21647":128262,"_5":14929,"_28559":128198,"_3075":128263},[],"Formato",{"_3699":75364,"_31384":75337,"_21647":128265,"_5":14929,"_28559":128198,"_3075":58923},[],{"_3699":75365,"_31384":75337,"_21647":128267,"_5":14929,"_28559":128198,"_3075":58926},[],{"_3699":75366,"_31384":75337,"_21647":128269,"_5":14929,"_28559":128198,"_3075":128270},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3699":75367,"_31384":75337,"_21647":128272,"_5":14929,"_28559":128198,"_3075":58283},[],{"_3699":75368,"_31384":75337,"_21647":128274,"_5":14929,"_28559":128198,"_3075":58934},[],{"_3699":75369,"_31384":75337,"_21647":128276,"_5":14929,"_28559":128198,"_3075":128277},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3699":75370,"_31384":75337,"_21647":128279,"_5":14929,"_28559":128198,"_3075":128280},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3699":75371,"_31384":75337,"_21647":128282,"_5":14929,"_28559":128202,"_3075":128283},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3699":75372,"_31384":75337,"_21647":128285,"_5":14929,"_28559":128202,"_3075":128286},[],"Genera la solicitud:",{"_3699":75373,"_31384":75337,"_21647":128288,"_5":14929,"_28559":128202,"_3075":128289},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3699":75374,"_31384":75337,"_21647":128291,"_5":14929,"_28559":128202,"_3075":128292},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3699":75375,"_31384":75337,"_21647":128294,"_5":14929,"_28559":128202,"_3075":128295},[],"Verifica el DER recibido:",{"_3699":75376,"_31384":75337,"_21647":128297,"_5":14929,"_28559":128202,"_3075":128298},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3699":75377,"_31384":75337,"_21647":128300,"_5":14929,"_28559":128206,"_3075":128301},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3699":75378,"_31384":75337,"_21647":128303,"_5":14929,"_28559":128206,"_3075":128304},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3699":75379,"_31384":75337,"_21647":128306,"_5":14929,"_28559":128210,"_3075":58967},[],{"_3699":75380,"_31384":75337,"_21647":128308,"_5":14929,"_28559":128210,"_3075":58970},[],{"_3699":75381,"_31384":75337,"_21647":128310,"_5":14929,"_28559":128210,"_3075":128311},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3699":75382,"_31384":75337,"_21647":128313,"_5":14929,"_28559":128210,"_3075":127762},[],{"_3699":75383,"_31384":75383,"_5":15283,"_3075":56862,"_31709":128315,"_21647":128316,"_28559":75383},[51094,122172,56862],[],{"_3699":75384,"_31384":75383,"_21647":128318,"_5":14929,"_28559":75383,"_3075":128319},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3699":75385,"_31384":75383,"_5":31706,"_21647":128321,"_28559":128322,"_3075":125559},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3699":75386,"_31384":75383,"_5":31706,"_21647":128324,"_28559":128325,"_3075":128326},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3699":75387,"_31384":75383,"_5":31706,"_21647":128328,"_28559":128329,"_3075":126080},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3699":75388,"_31384":75383,"_5":31706,"_21647":128331,"_28559":128332,"_3075":126084},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3699":75389,"_31384":75383,"_5":31706,"_21647":128334,"_28559":128335,"_3075":126088},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3699":75390,"_31384":75383,"_5":31706,"_21647":128337,"_28559":128338,"_3075":126092},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3699":75391,"_31384":75383,"_5":31706,"_21647":128340,"_28559":128341,"_3075":126100},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3699":75392,"_31384":75383,"_5":31706,"_21647":128343,"_28559":128344,"_3075":128345},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3699":75393,"_31384":75383,"_5":31706,"_21647":128347,"_28559":128348,"_3075":127071},[],"/docs/es/platform/pki/overview#continúa",{"_3699":75394,"_31384":75383,"_21647":128350,"_5":14929,"_28559":75383,"_3075":128351},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3699":75395,"_31384":75383,"_21647":128353,"_5":14929,"_28559":128322,"_3075":128354},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3699":75396,"_31384":75383,"_21647":128356,"_5":14929,"_28559":128322,"_3075":128357},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3699":75397,"_31384":75383,"_21647":128359,"_5":14929,"_28559":128325,"_3075":128360},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3699":75398,"_31384":75383,"_21647":128362,"_5":14929,"_28559":128325,"_3075":128363},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3699":75399,"_31384":75383,"_21647":128365,"_5":14929,"_28559":128325,"_3075":128366},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3699":75400,"_31384":75383,"_21647":128368,"_5":14929,"_28559":128325,"_3075":128369},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3699":75401,"_31384":75383,"_21647":128371,"_5":14929,"_28559":128325,"_3075":128372},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3699":75402,"_31384":75383,"_21647":128374,"_5":14929,"_28559":128332,"_3075":128375},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3699":75403,"_31384":75383,"_21647":128377,"_5":14929,"_28559":128335,"_3075":128378},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3699":75404,"_31384":75383,"_21647":128380,"_5":14929,"_28559":128338,"_3075":128381},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3699":75405,"_31384":75383,"_21647":128383,"_5":14929,"_28559":128338,"_3075":128384},[],"Los protocolos de enrolamiento permiten que los clientes obtengan y renueven certificados de una CA de Lamassu.",{"_3699":75406,"_31384":75383,"_21647":128386,"_5":14929,"_28559":128341,"_3075":128387},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3699":75407,"_31384":75383,"_21647":128389,"_5":14929,"_28559":128344,"_3075":128390},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3699":75408,"_31384":75383,"_21647":128392,"_5":14929,"_28559":128344,"_3075":128393},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3699":75409,"_31384":75383,"_21647":128395,"_5":14929,"_28559":128344,"_3075":128396},[],"su clave pública corresponda a la clave privada del cliente;",{"_3699":75410,"_31384":75383,"_21647":128398,"_5":14929,"_28559":128344,"_3075":128399},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3699":75411,"_31384":75383,"_21647":128401,"_5":14929,"_28559":128344,"_3075":128402},[],"sus fechas y usos permitan la operación;",{"_3699":75412,"_31384":75383,"_21647":128404,"_5":14929,"_28559":128344,"_3075":128405},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3699":75413,"_31384":75383,"_21647":128407,"_5":14929,"_28559":128344,"_3075":128408},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3699":75414,"_31384":75383,"_21647":128410,"_5":14929,"_28559":128348,"_3075":128411},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3699":75415,"_31384":75383,"_21647":128413,"_5":14929,"_28559":128348,"_3075":128414},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3699":75416,"_31384":75383,"_21647":128416,"_5":14929,"_28559":128348,"_3075":128417},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3699":75417,"_31384":75417,"_5":15283,"_3075":128419,"_31709":128420,"_21647":128421,"_28559":75417},"Crea tu primera CA",[51094,122172,56862,125683],[],{"_3699":75418,"_31384":75417,"_21647":128423,"_5":14929,"_28559":75417,"_3075":128424},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3699":75419,"_31384":75417,"_5":31706,"_21647":128426,"_28559":128427,"_3075":120677},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3699":75420,"_31384":75417,"_5":31706,"_21647":128429,"_28559":128430,"_3075":128431},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3699":75421,"_31384":75417,"_5":31706,"_21647":128433,"_28559":128434,"_3075":128435},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3699":75422,"_31384":75417,"_5":31706,"_21647":128437,"_28559":128438,"_3075":128439},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3699":75423,"_31384":75417,"_5":31706,"_21647":128441,"_28559":128442,"_3075":128443},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3699":75424,"_31384":75417,"_5":31706,"_21647":128445,"_28559":128446,"_3075":128447},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3699":75425,"_31384":75417,"_5":31706,"_21647":128449,"_28559":128450,"_3075":128451},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3699":75426,"_31384":75417,"_5":31706,"_21647":128453,"_28559":128454,"_3075":125931},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3699":75427,"_31384":75417,"_5":31706,"_21647":128456,"_28559":128457,"_3075":120701},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3699":75428,"_31384":75417,"_21647":128459,"_5":14929,"_28559":75417,"_3075":128460},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3699":75429,"_31384":75417,"_21647":128462,"_5":14929,"_28559":128427,"_3075":128463},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3699":75430,"_31384":75417,"_21647":128465,"_5":14929,"_28559":128427,"_3075":128466},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3699":75431,"_31384":75417,"_21647":128468,"_5":14929,"_28559":128427,"_3075":128469},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3699":75432,"_31384":75417,"_21647":128471,"_5":14929,"_28559":128427,"_3075":128472},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3699":75433,"_31384":75417,"_21647":128474,"_5":14929,"_28559":128430,"_3075":128475},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3699":75434,"_31384":75417,"_21647":128477,"_5":14929,"_28559":128430,"_3075":128478},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3699":75435,"_31384":75417,"_21647":128480,"_5":14929,"_28559":128434,"_3075":128481},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3699":75436,"_31384":75417,"_21647":128483,"_5":14929,"_28559":128434,"_3075":128484},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3699":75437,"_31384":75417,"_21647":128486,"_5":14929,"_28559":128438,"_3075":128487},[],"Selecciona **Root CA** y completa:",{"_3699":75438,"_31384":75417,"_21647":128489,"_5":14929,"_28559":128438,"_3075":59152},[],{"_3699":75439,"_31384":75417,"_21647":128491,"_5":14929,"_28559":128438,"_3075":128492},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3699":75440,"_31384":75417,"_21647":128494,"_5":14929,"_28559":128438,"_3075":128495},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3699":75441,"_31384":75417,"_21647":128497,"_5":14929,"_28559":128438,"_3075":128498},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3699":75442,"_31384":75417,"_21647":128500,"_5":14929,"_28559":128438,"_3075":128501},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3699":75443,"_31384":75417,"_21647":128503,"_5":14929,"_28559":128442,"_3075":128504},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3699":75444,"_31384":75417,"_21647":128506,"_5":14929,"_28559":128446,"_3075":128507},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3699":75445,"_31384":75417,"_21647":128509,"_5":14929,"_28559":128446,"_3075":128510},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3699":75446,"_31384":75417,"_21647":128512,"_5":14929,"_28559":128450,"_3075":128513},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3699":75447,"_31384":75417,"_21647":128515,"_5":14929,"_28559":128450,"_3075":128516},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3699":75448,"_31384":75417,"_21647":128518,"_5":14929,"_28559":128450,"_3075":128519},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3699":75449,"_31384":75417,"_21647":128521,"_5":14929,"_28559":128454,"_3075":128522},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3699":75450,"_31384":75417,"_21647":128524,"_5":14929,"_28559":128454,"_3075":128525},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3699":75451,"_31384":75417,"_21647":128527,"_5":14929,"_28559":128454,"_3075":128528},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3699":75452,"_31384":75417,"_21647":128530,"_5":14929,"_28559":128454,"_3075":128531},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3699":75453,"_31384":75417,"_21647":128533,"_5":14929,"_28559":128457,"_3075":128534},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3699":75454,"_31384":75454,"_5":15283,"_3075":128536,"_31709":128537,"_21647":128538,"_28559":75454},"Emite y verifica un certificado",[51094,122172,56862,125683],[],{"_3699":75455,"_31384":75454,"_21647":128540,"_5":14929,"_28559":75454,"_3075":128541},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3699":75456,"_31384":75454,"_5":31706,"_21647":128543,"_28559":128544,"_3075":120677},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3699":75457,"_31384":75454,"_5":31706,"_21647":128546,"_28559":128547,"_3075":128548},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3699":75458,"_31384":75454,"_5":31706,"_21647":128550,"_28559":128551,"_3075":128552},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3699":75459,"_31384":75454,"_5":31706,"_21647":128554,"_28559":128555,"_3075":128556},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3699":75460,"_31384":75454,"_5":31706,"_21647":128558,"_28559":128559,"_3075":128560},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3699":75461,"_31384":75454,"_5":31706,"_21647":128562,"_28559":128563,"_3075":128564},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3699":75462,"_31384":75454,"_5":31706,"_21647":128566,"_28559":128567,"_3075":128568},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3699":75463,"_31384":75454,"_5":31706,"_21647":128570,"_28559":128571,"_3075":128572},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3699":75464,"_31384":75454,"_5":31706,"_21647":128574,"_28559":128575,"_3075":128576},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3699":75465,"_31384":75454,"_5":31706,"_21647":128578,"_28559":128579,"_3075":128580},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3699":75466,"_31384":75454,"_5":31706,"_21647":128582,"_28559":128583,"_3075":125931},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3699":75467,"_31384":75454,"_5":31706,"_21647":128585,"_28559":128586,"_3075":120701},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3699":75468,"_31384":75454,"_21647":128588,"_5":14929,"_28559":75454,"_3075":128589},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3699":75469,"_31384":75454,"_21647":128591,"_5":14929,"_28559":128544,"_3075":128592},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3699":75470,"_31384":75454,"_21647":128594,"_5":14929,"_28559":128544,"_3075":128595},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3699":75471,"_31384":75454,"_21647":128597,"_5":14929,"_28559":128544,"_3075":128598},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3699":75472,"_31384":75454,"_21647":128600,"_5":14929,"_28559":128544,"_3075":128601},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3699":75473,"_31384":75454,"_21647":128603,"_5":14929,"_28559":128544,"_3075":128604},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3699":75474,"_31384":75454,"_21647":128606,"_5":14929,"_28559":128547,"_3075":128607},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3699":75475,"_31384":75454,"_21647":128609,"_5":14929,"_28559":128551,"_3075":128610},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3699":75476,"_31384":75454,"_21647":128612,"_5":14929,"_28559":128551,"_3075":128613},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3699":75477,"_31384":75454,"_21647":128615,"_5":14929,"_28559":128555,"_3075":128616},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3699":75478,"_31384":75454,"_21647":128618,"_5":14929,"_28559":128555,"_3075":128619},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3699":75479,"_31384":75454,"_21647":128621,"_5":14929,"_28559":128559,"_3075":128622},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3699":75480,"_31384":75454,"_21647":128624,"_5":14929,"_28559":128559,"_3075":128625},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3699":75481,"_31384":75454,"_21647":128627,"_5":14929,"_28559":128563,"_3075":128628},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3699":75482,"_31384":75454,"_21647":128630,"_5":14929,"_28559":128567,"_3075":128631},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3699":75483,"_31384":75454,"_21647":128633,"_5":14929,"_28559":128571,"_3075":128634},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3699":75484,"_31384":75454,"_21647":128636,"_5":14929,"_28559":128575,"_3075":128637},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3699":75485,"_31384":75454,"_21647":128639,"_5":14929,"_28559":128575,"_3075":128640},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3699":75486,"_31384":75454,"_21647":128642,"_5":14929,"_28559":128575,"_3075":128643},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3699":75487,"_31384":75454,"_21647":128645,"_5":14929,"_28559":128579,"_3075":128646},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3699":75488,"_31384":75454,"_21647":128648,"_5":14929,"_28559":128579,"_3075":128649},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3699":75489,"_31384":75454,"_21647":128651,"_5":14929,"_28559":128579,"_3075":128652},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3699":75490,"_31384":75454,"_21647":128654,"_5":14929,"_28559":128583,"_3075":126014},[],{"_3699":75491,"_31384":75454,"_21647":128656,"_5":14929,"_28559":128583,"_3075":124622},[],{"_3699":75492,"_31384":75454,"_21647":128658,"_5":14929,"_28559":128583,"_3075":128659},[],"La CA rechaza la emisión",{"_3699":75493,"_31384":75454,"_21647":128661,"_5":14929,"_28559":128583,"_3075":128662},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3699":75494,"_31384":75454,"_21647":128664,"_5":14929,"_28559":128583,"_3075":128665},[],"Sujeto o usos diferentes",{"_3699":75495,"_31384":75454,"_21647":128667,"_5":14929,"_28559":128583,"_3075":128668},[],"Perfil aplicado y valores solicitados.",{"_3699":75496,"_31384":75454,"_21647":128670,"_5":14929,"_28559":128583,"_3075":128671},[],"No se encuentra el emisor",{"_3699":75497,"_31384":75454,"_21647":128673,"_5":14929,"_28559":128583,"_3075":128674},[],"CA descargada y cadena intermedia necesaria.",{"_3699":75498,"_31384":75454,"_21647":128676,"_5":14929,"_28559":128583,"_3075":128677},[],"Falla la vigencia",{"_3699":75499,"_31384":75454,"_21647":128679,"_5":14929,"_28559":128583,"_3075":128680},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3699":75500,"_31384":75454,"_21647":128682,"_5":14929,"_28559":128583,"_3075":128683},[],"Los resúmenes de clave difieren",{"_3699":75501,"_31384":75454,"_21647":128685,"_5":14929,"_28559":128583,"_3075":128686},[],"Archivos de certificado y clave de la misma emisión.",{"_3699":75502,"_31384":75454,"_21647":128688,"_5":14929,"_28559":128583,"_3075":128689},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3699":75503,"_31384":75454,"_21647":128691,"_5":14929,"_28559":128586,"_3075":128692},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3699":75504,"_31384":75454,"_21647":128694,"_5":14929,"_28559":128586,"_3075":128695},[],"Gestionar certificados para inspección, estado y revocación.",{"_3699":75505,"_31384":75454,"_21647":128697,"_5":14929,"_28559":128586,"_3075":128698},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3699":75506,"_31384":75454,"_21647":128700,"_5":14929,"_28559":128586,"_3075":128701},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3699":75507,"_31384":75454,"_21647":128703,"_5":14929,"_28559":128586,"_3075":128704},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3699":75508,"_31384":75508,"_5":15283,"_3075":128706,"_31709":128707,"_21647":128708,"_28559":75508},"Primeros pasos de PKI",[51094,122172,56862,125683],[],{"_3699":75509,"_31384":75508,"_21647":128710,"_5":14929,"_28559":75508,"_3075":128711},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3699":75510,"_31384":75508,"_5":31706,"_21647":128713,"_28559":128714,"_3075":120677},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3699":75511,"_31384":75508,"_5":31706,"_21647":128716,"_28559":128717,"_3075":128718},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3699":75512,"_31384":75508,"_5":31706,"_21647":128720,"_28559":128721,"_3075":125866},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3699":75513,"_31384":75508,"_5":31706,"_21647":128723,"_28559":128724,"_3075":128725},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3699":75514,"_31384":75508,"_21647":128727,"_5":14929,"_28559":75508,"_3075":128728},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3699":75515,"_31384":75508,"_21647":128730,"_5":14929,"_28559":128714,"_3075":128731},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3699":75516,"_31384":75508,"_21647":128733,"_5":14929,"_28559":128714,"_3075":128734},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3699":75517,"_31384":75508,"_21647":128736,"_5":14929,"_28559":128714,"_3075":128737},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3699":75518,"_31384":75508,"_21647":128739,"_5":14929,"_28559":128714,"_3075":128740},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3699":75519,"_31384":75508,"_21647":128742,"_5":14929,"_28559":128714,"_3075":128743},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3699":75520,"_31384":75508,"_21647":128745,"_5":14929,"_28559":128717,"_3075":128746},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3699":75521,"_31384":75508,"_21647":128748,"_5":14929,"_28559":128717,"_3075":128749},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3699":75522,"_31384":75508,"_21647":128751,"_5":14929,"_28559":128717,"_3075":128752},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3699":75523,"_31384":75508,"_21647":128754,"_5":14929,"_28559":128717,"_3075":128755},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3699":75524,"_31384":75508,"_21647":128757,"_5":14929,"_28559":128721,"_3075":128758},[],"Archivo o recurso",{"_3699":75525,"_31384":75508,"_21647":128760,"_5":14929,"_28559":128721,"_3075":125863},[],{"_3699":75526,"_31384":75508,"_21647":128762,"_5":14929,"_28559":128721,"_3075":128763},[],"CA raíz activa y `ca.pem`",{"_3699":75527,"_31384":75508,"_21647":128765,"_5":14929,"_28559":128721,"_3075":128766},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3699":75528,"_31384":75508,"_21647":128768,"_5":14929,"_28559":128721,"_3075":128769},[],"Certificado final y `device.crt`",{"_3699":75529,"_31384":75508,"_21647":128771,"_5":14929,"_28559":128721,"_3075":128772},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3699":75530,"_31384":75508,"_21647":128774,"_5":14929,"_28559":128721,"_3075":128775},[],"Clave privada `device.key`",{"_3699":75531,"_31384":75508,"_21647":128777,"_5":14929,"_28559":128721,"_3075":128778},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3699":75532,"_31384":75508,"_21647":128780,"_5":14929,"_28559":128721,"_3075":128781},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3699":75533,"_31384":75508,"_21647":128783,"_5":14929,"_28559":128724,"_3075":128784},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3699":75534,"_31384":75508,"_21647":128786,"_5":14929,"_28559":128724,"_3075":128787},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3699":75535,"_31384":75508,"_21647":128789,"_5":14929,"_28559":128724,"_3075":128790},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3699":75536,"_31384":75536,"_5":15283,"_3075":128792,"_31709":128793,"_21647":128795,"_28559":75536},"Resolución de problemas PKI",[51094,122172,56862,128794],"Resolución de problemas",[],{"_3699":75537,"_31384":75536,"_21647":128797,"_5":14929,"_28559":75536,"_3075":128798},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3699":75538,"_31384":75536,"_5":31706,"_21647":128800,"_28559":128801,"_3075":128802},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3699":75539,"_31384":75536,"_5":31706,"_21647":128804,"_28559":128805,"_3075":128806},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3699":75540,"_31384":75536,"_5":31706,"_21647":128808,"_28559":128809,"_3075":128810},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3699":75541,"_31384":75536,"_21647":128812,"_5":14929,"_28559":75536,"_3075":128813},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3699":75542,"_31384":75536,"_21647":128815,"_5":14929,"_28559":75536,"_3075":128816},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3699":75543,"_31384":75536,"_21647":128818,"_5":14929,"_28559":128801,"_3075":125863},[],{"_3699":75544,"_31384":75536,"_21647":128820,"_5":14929,"_28559":128801,"_3075":124622},[],{"_3699":75545,"_31384":75536,"_21647":128822,"_5":14929,"_28559":128801,"_3075":120701},[],{"_3699":75546,"_31384":75536,"_21647":128824,"_5":14929,"_28559":128801,"_3075":55703},[],{"_3699":75547,"_31384":75536,"_21647":128826,"_5":14929,"_28559":128801,"_3075":128827},[],"Existe, está activa y sus fechas son utilizables.",{"_3699":75548,"_31384":75536,"_21647":128829,"_5":14929,"_28559":128801,"_3075":128830},[],"Autoridades.",{"_3699":75549,"_31384":75536,"_21647":128832,"_5":14929,"_28559":128801,"_3075":128833},[],"Clave",{"_3699":75550,"_31384":75536,"_21647":128835,"_5":14929,"_28559":128801,"_3075":128836},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3699":75551,"_31384":75536,"_21647":128838,"_5":14929,"_28559":128801,"_3075":128839},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3699":75552,"_31384":75536,"_21647":128841,"_5":14929,"_28559":128801,"_3075":59506},[],{"_3699":75553,"_31384":75536,"_21647":128843,"_5":14929,"_28559":128801,"_3075":128844},[],"PEM correcto y firma verificable.",{"_3699":75554,"_31384":75536,"_21647":128846,"_5":14929,"_28559":128801,"_3075":59512},[],{"_3699":75555,"_31384":75536,"_21647":128848,"_5":14929,"_28559":128801,"_3075":128849},[],"Perfil",{"_3699":75556,"_31384":75536,"_21647":128851,"_5":14929,"_28559":128801,"_3075":128852},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3699":75557,"_31384":75536,"_21647":128854,"_5":14929,"_28559":128801,"_3075":128855},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3699":75558,"_31384":75536,"_21647":128857,"_5":14929,"_28559":128801,"_3075":126014},[],{"_3699":75559,"_31384":75536,"_21647":128859,"_5":14929,"_28559":128801,"_3075":128860},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3699":75560,"_31384":75536,"_21647":128862,"_5":14929,"_28559":128801,"_3075":128863},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3699":75561,"_31384":75536,"_21647":128865,"_5":14929,"_28559":128801,"_3075":128866},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3699":75562,"_31384":75536,"_21647":128868,"_5":14929,"_28559":128801,"_3075":128869},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3699":75563,"_31384":75536,"_21647":128871,"_5":14929,"_28559":128801,"_3075":128872},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3699":75564,"_31384":75536,"_21647":128874,"_5":14929,"_28559":128805,"_3075":128875},[],"Revisa cada frontera por separado:",{"_3699":75565,"_31384":75536,"_21647":128877,"_5":14929,"_28559":128805,"_3075":128878},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3699":75566,"_31384":75536,"_21647":128880,"_5":14929,"_28559":128805,"_3075":128881},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3699":75567,"_31384":75536,"_21647":128883,"_5":14929,"_28559":128805,"_3075":128884},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3699":75568,"_31384":75536,"_21647":128886,"_5":14929,"_28559":128805,"_3075":128887},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3699":75569,"_31384":75536,"_21647":128889,"_5":14929,"_28559":128805,"_3075":128890},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3699":75570,"_31384":75536,"_21647":128892,"_5":14929,"_28559":128805,"_3075":128893},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3699":75571,"_31384":75536,"_21647":128895,"_5":14929,"_28559":128809,"_3075":128896},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3699":75572,"_31384":75536,"_21647":128898,"_5":14929,"_28559":128809,"_3075":128899},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3699":75573,"_31384":75573,"_5":15283,"_3075":128901,"_31709":128902,"_21647":128903,"_28559":75573},"Seguridad",[51094],[],{"_3699":75574,"_31384":75573,"_21647":128905,"_5":14929,"_28559":75573,"_3075":128906},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3699":75575,"_31384":75573,"_5":31706,"_21647":128908,"_28559":128909,"_3075":128910},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3699":75576,"_31384":75573,"_5":31706,"_21647":128912,"_28559":128913,"_3075":128914},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3699":75577,"_31384":75573,"_5":31706,"_21647":128916,"_28559":128917,"_3075":128918},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3699":75578,"_31384":75573,"_5":31706,"_21647":128920,"_28559":128921,"_3075":128922},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3699":75579,"_31384":75573,"_21647":128924,"_5":14929,"_28559":75573,"_3075":128925},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3699":75580,"_31384":75573,"_21647":128927,"_5":14929,"_28559":128909,"_3075":128928},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3699":75581,"_31384":75573,"_21647":128930,"_5":14929,"_28559":128909,"_3075":128931},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3699":75582,"_31384":75573,"_21647":128933,"_5":14929,"_28559":128909,"_3075":15544},[],{"_3699":75583,"_31384":75573,"_21647":128935,"_5":14929,"_28559":128909,"_3075":15480},[],{"_3699":75584,"_31384":75573,"_21647":128937,"_5":14929,"_28559":128909,"_3075":15531},[],{"_3699":75585,"_31384":75573,"_21647":128939,"_5":14929,"_28559":128909,"_3075":128940},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3699":75586,"_31384":75573,"_21647":128942,"_5":14929,"_28559":128909,"_3075":128943},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3699":75587,"_31384":75573,"_21647":128945,"_5":14929,"_28559":128913,"_3075":128946},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3699":75588,"_31384":75573,"_21647":128948,"_5":14929,"_28559":128913,"_3075":128949},[],"No incluyas en el reporte:",{"_3699":75589,"_31384":75573,"_21647":128951,"_5":14929,"_28559":128913,"_3075":128952},[],"Credenciales, tokens o claves privadas",{"_3699":75590,"_31384":75573,"_21647":128954,"_5":14929,"_28559":128913,"_3075":128955},[],"Datos de clientes o información identificable de clientes",{"_3699":75591,"_31384":75573,"_21647":128957,"_5":14929,"_28559":128913,"_3075":128958},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3699":75592,"_31384":75573,"_21647":128960,"_5":14929,"_28559":128917,"_3075":128961},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3699":75593,"_31384":75573,"_21647":128963,"_5":14929,"_28559":128917,"_3075":128964},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3699":75594,"_31384":75573,"_21647":128966,"_5":14929,"_28559":128921,"_3075":128967},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3699":75595,"_31384":75573,"_21647":128969,"_5":14929,"_28559":128921,"_3075":128970},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3699":75596,"_31384":75573,"_21647":128972,"_5":14929,"_28559":128921,"_3075":128973},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3699":75597,"_31384":75573,"_21647":128975,"_5":14929,"_28559":128921,"_3075":128976},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3699":75598,"_31384":75573,"_21647":128978,"_5":14929,"_28559":128921,"_3075":128979},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3699":75599,"_31384":75599,"_5":15283,"_3075":128981,"_31709":128982,"_21647":128984,"_28559":75599},"3.8.0 a 4.0.0",[51094,128983],"Actualizaciones",[],{"_3699":75600,"_31384":75599,"_21647":128986,"_5":14929,"_28559":75599,"_3075":128987},[],"Qué cambia en 4.0.0, qué cambios rompen los clientes de API, los consumidores de eventos y los dispositivos de 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3699":75601,"_31384":75599,"_5":31706,"_21647":128989,"_28559":128990,"_3075":128991},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios","Cambios",{"_3699":75602,"_31384":75599,"_5":31706,"_21647":128993,"_28559":128994,"_3075":128995},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3699":75603,"_31384":75599,"_5":31706,"_21647":128997,"_28559":128998,"_3075":128999},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-despliegue","Chart de Helm y despliegue",{"_3699":75604,"_31384":75599,"_5":31706,"_21647":129001,"_28559":129002,"_3075":129003},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3699":75605,"_31384":75599,"_5":31706,"_21647":129005,"_28559":129006,"_3075":129007},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3699":75606,"_31384":75599,"_5":31706,"_21647":129009,"_28559":129010,"_3075":129011},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3699":75607,"_31384":75599,"_5":31706,"_21647":129013,"_28559":129014,"_3075":129015},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3699":75608,"_31384":75599,"_5":31706,"_21647":129017,"_28559":129018,"_3075":121272},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3699":75609,"_31384":75599,"_5":31706,"_21647":129020,"_28559":129021,"_3075":129022},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3699":75610,"_31384":75599,"_5":31706,"_21647":129024,"_28559":129025,"_3075":129026},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3699":75611,"_31384":75599,"_5":31706,"_21647":129028,"_28559":129029,"_3075":126964},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autorización",{"_3699":75612,"_31384":75599,"_5":31706,"_21647":129031,"_28559":129032,"_3075":129033},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3699":75613,"_31384":75599,"_5":31706,"_21647":129035,"_28559":129036,"_3075":129037},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3699":75614,"_31384":75599,"_5":31706,"_21647":129039,"_28559":129040,"_3075":129041},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3699":75615,"_31384":75599,"_5":31706,"_21647":129043,"_28559":129044,"_3075":129045},[],"/docs/es/upgrades/3-8-0-to-4-0-0#almacenamiento-y-datos","Almacenamiento y datos",{"_3699":75616,"_31384":75599,"_5":31706,"_21647":129047,"_28559":129048,"_3075":129049},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3699":75617,"_31384":75599,"_5":31706,"_21647":129051,"_28559":129052,"_3075":129053},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3699":75618,"_31384":75599,"_5":31706,"_21647":129055,"_28559":129056,"_3075":129057},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3699":75619,"_31384":75599,"_5":31706,"_21647":129059,"_28559":129060,"_3075":129061},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3699":75620,"_31384":75599,"_5":31706,"_21647":129063,"_28559":129064,"_3075":129065},[],"/docs/es/upgrades/3-8-0-to-4-0-0#migración-de-los-ajustes-de-crl","Migración de los ajustes de CRL",{"_3699":75621,"_31384":75599,"_5":31706,"_21647":129067,"_28559":129068,"_3075":129069},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3699":75622,"_31384":75599,"_5":31706,"_21647":129071,"_28559":129072,"_3075":129073},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3699":75623,"_31384":75599,"_5":31706,"_21647":129075,"_28559":129076,"_3075":124821},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-del-dms",{"_3699":75624,"_31384":75599,"_5":31706,"_21647":129078,"_28559":129079,"_3075":129080},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3699":75625,"_31384":75599,"_5":31706,"_21647":129082,"_28559":129083,"_3075":129084},[],"/docs/es/upgrades/3-8-0-to-4-0-0#verificación-del-certificado-del-receptor-del-webhook","Verificación del certificado del receptor del webhook",{"_3699":75626,"_31384":75599,"_5":31706,"_21647":129086,"_28559":129087,"_3075":59754},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3699":75627,"_31384":75599,"_5":31706,"_21647":129089,"_28559":129090,"_3075":129091},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-y-sdk","API y SDK",{"_3699":75628,"_31384":75599,"_5":31706,"_21647":129093,"_28559":129094,"_3075":129095},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3699":75629,"_31384":75599,"_5":31706,"_21647":129097,"_28559":129098,"_3075":129099},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3699":75630,"_31384":75599,"_5":31706,"_21647":129101,"_28559":129102,"_3075":129103},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3699":75631,"_31384":75599,"_5":31706,"_21647":129105,"_28559":129106,"_3075":129107},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3699":75632,"_31384":75599,"_5":31706,"_21647":129109,"_28559":129110,"_3075":129111},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3699":75633,"_31384":75599,"_5":31706,"_21647":129113,"_28559":129114,"_3075":129115},[],"/docs/es/upgrades/3-8-0-to-4-0-0#alias-de-claves-del-kms-en-conflicto","Alias de claves del KMS en conflicto",{"_3699":75634,"_31384":75599,"_5":31706,"_21647":129117,"_28559":129118,"_3075":129119},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3699":75635,"_31384":75599,"_5":31706,"_21647":129121,"_28559":129122,"_3075":129123},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3699":75636,"_31384":75599,"_5":31706,"_21647":129125,"_28559":129126,"_3075":129127},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3699":75637,"_31384":75599,"_5":31706,"_21647":129129,"_28559":129130,"_3075":129131},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3699":75638,"_31384":75599,"_5":31706,"_21647":129133,"_28559":129134,"_3075":129135},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos","Eventos",{"_3699":75639,"_31384":75599,"_5":31706,"_21647":129137,"_28559":129138,"_3075":129139},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3699":75640,"_31384":75599,"_5":31706,"_21647":129141,"_28559":129142,"_3075":129143},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comportamiento-del-enrolamiento","Comportamiento del enrolamiento",{"_3699":75641,"_31384":75599,"_5":31706,"_21647":129145,"_28559":129146,"_3075":129147},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3699":75642,"_31384":75599,"_5":31706,"_21647":129149,"_28559":129150,"_3075":129151},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3699":75643,"_31384":75599,"_5":31706,"_21647":129153,"_28559":129154,"_3075":129155},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3699":75644,"_31384":75599,"_5":31706,"_21647":129157,"_28559":129158,"_3075":129159},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3699":75645,"_31384":75599,"_5":31706,"_21647":129161,"_28559":129162,"_3075":129163},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3699":75646,"_31384":75599,"_5":31706,"_21647":129165,"_28559":129166,"_3075":129167},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3699":75647,"_31384":75599,"_5":31706,"_21647":129169,"_28559":129170,"_3075":129171},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3699":75648,"_31384":75599,"_5":31706,"_21647":129173,"_28559":129174,"_3075":129175},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3699":75649,"_31384":75599,"_5":31706,"_21647":129177,"_28559":129178,"_3075":129179},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3699":75650,"_31384":75599,"_5":31706,"_21647":129181,"_28559":129182,"_3075":124877},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3699":75651,"_31384":75599,"_5":31706,"_21647":129184,"_28559":129185,"_3075":129186},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3699":75652,"_31384":75599,"_5":31706,"_21647":129188,"_28559":129189,"_3075":129190},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3699":75653,"_31384":75599,"_21647":129192,"_5":14929,"_28559":75599,"_3075":129193},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3699":75654,"_31384":75599,"_21647":129195,"_5":14929,"_28559":75599,"_3075":129196},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3699":75655,"_31384":75599,"_21647":129198,"_5":14929,"_28559":75599,"_3075":129199},[],"Cambios: qué es distinto en el despliegue, el almacenamiento y los datos guardados, qué migra la actualización por sí sola y cuáles de estos cambios requieren tu intervención.",{"_3699":75656,"_31384":75599,"_21647":129201,"_5":14929,"_28559":75599,"_3075":129202},[],"Breaking changes: cambios en la API, los eventos y el comportamiento del que dependen los clientes, las integraciones y los dispositivos, a quién afecta cada uno y qué hacer.",{"_3699":75657,"_31384":75599,"_21647":129204,"_5":14929,"_28559":75599,"_3075":129205},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3699":75658,"_31384":75599,"_21647":129207,"_5":14929,"_28559":75599,"_3075":129208},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3699":75659,"_31384":75599,"_21647":129210,"_5":14929,"_28559":75599,"_3075":129211},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3699":75660,"_31384":75599,"_21647":129213,"_5":14929,"_28559":128990,"_3075":129214},[],"Estos cambios afectan a cómo se despliega Lamassu, dónde guarda sus datos y cómo se convierten esos datos. No cambian la API ni los eventos: lo que deben adaptar los clientes, las integraciones y los dispositivos se recoge en Breaking changes. La propia actualización aplica la mayoría de estos cambios; los que requieren acción del operador lo indican, y la guía de migración con Helm realiza esa acción en orden.",{"_3699":75661,"_31384":75599,"_21647":129216,"_5":14929,"_28559":128994,"_3075":129217},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3699":75662,"_31384":75599,"_21647":129219,"_5":14929,"_28559":128994,"_3075":129220},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3699":75663,"_31384":75599,"_21647":129222,"_5":14929,"_28559":128994,"_3075":129223},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3699":75664,"_31384":75599,"_21647":129225,"_5":14929,"_28559":128994,"_3075":129226},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources` y los alias iguales a un ID de clave existente (consulta Alias de claves del KMS en conflicto). La migración de la VA convierte cada rol de VA en los ajustes de CRL de su CA y resuelve su firmante de CRL (consulta Migración de los ajustes de CRL).",{"_3699":75665,"_31384":75599,"_21647":129228,"_5":14929,"_28559":128994,"_3075":129229},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3699":75666,"_31384":75599,"_21647":129231,"_5":14929,"_28559":128994,"_3075":129232},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3699":75667,"_31384":75599,"_21647":129234,"_5":14929,"_28559":129002,"_3075":129235},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3699":75668,"_31384":75599,"_21647":129237,"_5":14929,"_28559":129002,"_3075":129238},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3699":75669,"_31384":75599,"_21647":129240,"_5":14929,"_28559":129002,"_3075":129241},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, y los volúmenes existentes deben ser accesibles por esa identidad.",{"_3699":75670,"_31384":75599,"_21647":129243,"_5":14929,"_28559":129002,"_3075":129244},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3699":75671,"_31384":75599,"_21647":129246,"_5":14929,"_28559":129002,"_3075":129247},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3699":75672,"_31384":75599,"_21647":129249,"_5":14929,"_28559":129006,"_3075":129250},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3699":75673,"_31384":75599,"_21647":129252,"_5":14929,"_28559":129006,"_3075":129253},[],"El paso 4 de la guía de migración copia los datos.",{"_3699":75674,"_31384":75599,"_21647":129255,"_5":14929,"_28559":129010,"_3075":129256},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3699":75675,"_31384":75599,"_21647":129258,"_5":14929,"_28559":129010,"_3075":129259},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3699":75676,"_31384":75599,"_21647":129261,"_5":14929,"_28559":129010,"_3075":129262},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3699":75677,"_31384":75599,"_21647":129264,"_5":14929,"_28559":129014,"_3075":129265},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3699":75678,"_31384":75599,"_21647":129267,"_5":14929,"_28559":129018,"_3075":129268},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3699":75679,"_31384":75599,"_21647":129270,"_5":14929,"_28559":129018,"_3075":129271},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3699":75680,"_31384":75599,"_21647":129273,"_5":14929,"_28559":129021,"_3075":129274},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3699":75681,"_31384":75599,"_21647":129276,"_5":14929,"_28559":129021,"_3075":129277},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3699":75682,"_31384":75599,"_21647":129279,"_5":14929,"_28559":129021,"_3075":129280},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3699":75683,"_31384":75599,"_21647":129282,"_5":14929,"_28559":129021,"_3075":129283},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3699":75684,"_31384":75599,"_21647":129285,"_5":14929,"_28559":129021,"_3075":129286},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3699":75685,"_31384":75599,"_21647":129288,"_5":14929,"_28559":129021,"_3075":129289},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3699":75686,"_31384":75599,"_21647":129291,"_5":14929,"_28559":129025,"_3075":129292},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3699":75687,"_31384":75599,"_21647":129294,"_5":14929,"_28559":129032,"_3075":129295},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3699":75688,"_31384":75599,"_21647":129297,"_5":14929,"_28559":129032,"_3075":129298},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3699":75689,"_31384":75599,"_21647":129300,"_5":14929,"_28559":129036,"_3075":129301},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3699":75690,"_31384":75599,"_21647":129303,"_5":14929,"_28559":129040,"_3075":129304},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3699":75691,"_31384":75599,"_21647":129306,"_5":14929,"_28559":129048,"_3075":129307},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3699":75692,"_31384":75599,"_21647":129309,"_5":14929,"_28559":129048,"_3075":129310},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3699":75693,"_31384":75599,"_21647":129312,"_5":14929,"_28559":129052,"_3075":129313},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3699":75694,"_31384":75599,"_21647":129315,"_5":14929,"_28559":129052,"_3075":129316},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3699":75695,"_31384":75599,"_21647":129318,"_5":14929,"_28559":129052,"_3075":129319},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3699":75696,"_31384":75599,"_21647":129321,"_5":14929,"_28559":129052,"_3075":129322},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3699":75697,"_31384":75599,"_21647":129324,"_5":14929,"_28559":129056,"_3075":129325},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3699":75698,"_31384":75599,"_21647":129327,"_5":14929,"_28559":129056,"_3075":129328},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3699":75699,"_31384":75599,"_21647":129330,"_5":14929,"_28559":129056,"_3075":129331},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3699":75700,"_31384":75599,"_21647":129333,"_5":14929,"_28559":129056,"_3075":129334},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3699":75701,"_31384":75599,"_21647":129336,"_5":14929,"_28559":129056,"_3075":129337},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3699":75702,"_31384":75599,"_21647":129339,"_5":14929,"_28559":129056,"_3075":129340},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3699":75703,"_31384":75599,"_21647":129342,"_5":14929,"_28559":129056,"_3075":129343},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3699":75704,"_31384":75599,"_21647":129345,"_5":14929,"_28559":129056,"_3075":129346},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3699":75705,"_31384":75599,"_21647":129348,"_5":14929,"_28559":129060,"_3075":129349},[],"La migración elimina los metadatos heredados `lamassu.io/kms/binded-resources` y registra en el KMS, solo con su clave pública, las claves ausentes necesarias para conservar referencias de certificados. Estas entradas no recuperan la clave privada. Consulta Gestión de claves y CRL para el comportamiento de las referencias.",{"_3699":75706,"_31384":75599,"_21647":129351,"_5":14929,"_28559":129064,"_3075":129352},[],"La migración de la VA convierte cada rol de VA de 3.8.0, indexado por el SKI de la CA, en los ajustes de CRL de una CA, indexados por su ID de CA. Cada CA obtiene sus propios ajustes, incluso cuando dos CAs comparten clave. Ajustes de CRL indexados por ID de CA describe lo que cambia para los clientes de API.",{"_3699":75707,"_31384":75599,"_21647":129354,"_5":14929,"_28559":129064,"_3075":129355},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3699":75708,"_31384":75599,"_21647":129357,"_5":14929,"_28559":129064,"_3075":129358},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3699":75709,"_31384":75599,"_21647":129360,"_5":14929,"_28559":129064,"_3075":129361},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3699":75710,"_31384":75599,"_21647":129363,"_5":14929,"_28559":129064,"_3075":129364},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3699":75711,"_31384":75599,"_21647":129366,"_5":14929,"_28559":129064,"_3075":129367},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3699":75712,"_31384":75599,"_21647":129369,"_5":14929,"_28559":129064,"_3075":129370},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3699":75713,"_31384":75599,"_21647":129372,"_5":14929,"_28559":129064,"_3075":129373},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3699":75714,"_31384":75599,"_21647":129375,"_5":14929,"_28559":129064,"_3075":129376},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3699":75715,"_31384":75599,"_21647":129378,"_5":14929,"_28559":129068,"_3075":129379},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3699":75716,"_31384":75599,"_21647":129381,"_5":14929,"_28559":129072,"_3075":129382},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. Consulta Eventos de dispositivo para adaptar los consumidores.",{"_3699":75717,"_31384":75599,"_21647":129384,"_5":14929,"_28559":129079,"_3075":129385},[],"Los ajustes de autenticación del reenrolamiento son independientes de los del enrolamiento inicial; no requieren migración. Consulta Autenticación por operación.",{"_3699":75718,"_31384":75599,"_21647":129387,"_5":14929,"_28559":129083,"_3075":129388},[],"Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3699":75719,"_31384":75599,"_21647":129390,"_5":14929,"_28559":129087,"_3075":129391},[],"Estos cambios modifican el contrato del que dependen los clientes de 3.8.0: endpoints y campos de la API REST, métodos del SDK de Go, los eventos que publican los servicios y el comportamiento que ven los dispositivos durante el enrolamiento. Los clientes, las integraciones y los dispositivos construidos para 3.8.0 tienen que adaptarse a ellos. Cada uno afecta solo a las integraciones que usan lo que cambia; comprueba la columna «A quién afecta». Los cambios en el despliegue, el almacenamiento y los datos guardados están en Cambios, aunque requieran acción durante la actualización.",{"_3699":75720,"_31384":75599,"_21647":129393,"_5":14929,"_28559":129087,"_3075":129394},[],"Cambio",{"_3699":75721,"_31384":75599,"_21647":129396,"_5":14929,"_28559":129087,"_3075":129397},[],"A quién afecta",{"_3699":75722,"_31384":75599,"_21647":129399,"_5":14929,"_28559":129087,"_3075":129400},[],"Gravedad",{"_3699":75723,"_31384":75599,"_21647":129402,"_5":14929,"_28559":129087,"_3075":127686},[],{"_3699":75724,"_31384":75599,"_21647":129404,"_5":14929,"_28559":129087,"_3075":129095},[],{"_3699":75725,"_31384":75599,"_21647":129406,"_5":14929,"_28559":129087,"_3075":129407},[],"Clientes de `/v1/roles`, políticas de autorización personalizadas sobre `va_role` y verificadores de certificados emitidos tras la actualización",{"_3699":75726,"_31384":75599,"_21647":129409,"_5":14929,"_28559":129087,"_3075":129410},[],"Alta: se eliminan las rutas `/v1/roles`",{"_3699":75727,"_31384":75599,"_21647":129412,"_5":14929,"_28559":129087,"_3075":129413},[],"Pasar los clientes a `/v1/crl-settings` con el ID de CA y actualizar las políticas",{"_3699":75728,"_31384":75599,"_21647":129415,"_5":14929,"_28559":129087,"_3075":129119},[],{"_3699":75729,"_31384":75599,"_21647":129417,"_5":14929,"_28559":129087,"_3075":129418},[],"Clientes que leen o escriben configuraciones de webhook por API, y DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3699":75730,"_31384":75599,"_21647":129420,"_5":14929,"_28559":129087,"_3075":129421},[],"Alta: los enrolamientos que llaman a un webhook con referencias a archivos fallan",{"_3699":75731,"_31384":75599,"_21647":129423,"_5":14929,"_28559":129087,"_3075":129424},[],"Usar los nombres de campo nuevos; volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3699":75732,"_31384":75599,"_21647":129426,"_5":14929,"_28559":129087,"_3075":129147},[],{"_3699":75733,"_31384":75599,"_21647":129428,"_5":14929,"_28559":129087,"_3075":129429},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3699":75734,"_31384":75599,"_21647":129431,"_5":14929,"_28559":129087,"_3075":129432},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3699":75735,"_31384":75599,"_21647":129434,"_5":14929,"_28559":129087,"_3075":129435},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3699":75736,"_31384":75599,"_21647":129437,"_5":14929,"_28559":129087,"_3075":129123},[],{"_3699":75737,"_31384":75599,"_21647":129439,"_5":14929,"_28559":129087,"_3075":129440},[],"Scripts y consolas que editan DMS por API",{"_3699":75738,"_31384":75599,"_21647":129442,"_5":14929,"_28559":129087,"_3075":129443},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3699":75739,"_31384":75599,"_21647":129445,"_5":14929,"_28559":129087,"_3075":129446},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3699":75740,"_31384":75599,"_21647":129448,"_5":14929,"_28559":129087,"_3075":129099},[],{"_3699":75741,"_31384":75599,"_21647":129450,"_5":14929,"_28559":129087,"_3075":129451},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3699":75742,"_31384":75599,"_21647":129453,"_5":14929,"_28559":129087,"_3075":129454},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3699":75743,"_31384":75599,"_21647":129456,"_5":14929,"_28559":129087,"_3075":129457},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3699":75744,"_31384":75599,"_21647":129459,"_5":14929,"_28559":129087,"_3075":129139},[],{"_3699":75745,"_31384":75599,"_21647":129461,"_5":14929,"_28559":129087,"_3075":129462},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3699":75746,"_31384":75599,"_21647":129464,"_5":14929,"_28559":129087,"_3075":129465},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3699":75747,"_31384":75599,"_21647":129467,"_5":14929,"_28559":129087,"_3075":129468},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3699":75748,"_31384":75599,"_21647":129470,"_5":14929,"_28559":129087,"_3075":129103},[],{"_3699":75749,"_31384":75599,"_21647":129472,"_5":14929,"_28559":129087,"_3075":129473},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3699":75750,"_31384":75599,"_21647":129475,"_5":14929,"_28559":129087,"_3075":129476},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3699":75751,"_31384":75599,"_21647":129478,"_5":14929,"_28559":129087,"_3075":129479},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3699":75752,"_31384":75599,"_21647":129481,"_5":14929,"_28559":129087,"_3075":129131},[],{"_3699":75753,"_31384":75599,"_21647":129483,"_5":14929,"_28559":129087,"_3075":129484},[],"Consumidores que leen el campo `events` del dispositivo",{"_3699":75754,"_31384":75599,"_21647":129486,"_5":14929,"_28559":129087,"_3075":129487},[],"Media: el campo desaparece",{"_3699":75755,"_31384":75599,"_21647":129489,"_5":14929,"_28559":129087,"_3075":129490},[],"Usar los nuevos endpoints de eventos",{"_3699":75756,"_31384":75599,"_21647":129492,"_5":14929,"_28559":129087,"_3075":129115},[],{"_3699":75757,"_31384":75599,"_21647":129494,"_5":14929,"_28559":129087,"_3075":129495},[],"Clientes que usan un alias igual a un ID de clave existente",{"_3699":75758,"_31384":75599,"_21647":129497,"_5":14929,"_28559":129087,"_3075":129498},[],"Media: el alias se elimina y el ID tiene prioridad",{"_3699":75759,"_31384":75599,"_21647":129500,"_5":14929,"_28559":129087,"_3075":129501},[],"Revisar y actualizar las referencias afectadas",{"_3699":75760,"_31384":75599,"_21647":129503,"_5":14929,"_28559":129087,"_3075":129127},[],{"_3699":75761,"_31384":75599,"_21647":129505,"_5":14929,"_28559":129087,"_3075":129506},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3699":75762,"_31384":75599,"_21647":129508,"_5":14929,"_28559":129087,"_3075":129509},[],"Baja: prevalece el ID de la URL",{"_3699":75763,"_31384":75599,"_21647":129511,"_5":14929,"_28559":129087,"_3075":129512},[],"Enviar el ID en la URL",{"_3699":75764,"_31384":75599,"_21647":129514,"_5":14929,"_28559":129087,"_3075":129107},[],{"_3699":75765,"_31384":75599,"_21647":129516,"_5":14929,"_28559":129087,"_3075":129517},[],"Clientes que envían un `id` al crear o importar CAs",{"_3699":75766,"_31384":75599,"_21647":129519,"_5":14929,"_28559":129087,"_3075":129520},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3699":75767,"_31384":75599,"_21647":129522,"_5":14929,"_28559":129087,"_3075":129523},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3699":75768,"_31384":75599,"_21647":129525,"_5":14929,"_28559":129087,"_3075":129111},[],{"_3699":75769,"_31384":75599,"_21647":129527,"_5":14929,"_28559":129087,"_3075":129528},[],"Consumidores que comparan el `type` del certificado",{"_3699":75770,"_31384":75599,"_21647":129530,"_5":14929,"_28559":129087,"_3075":129531},[],"Baja: dos valores cambian de nombre",{"_3699":75771,"_31384":75599,"_21647":129533,"_5":14929,"_28559":129087,"_3075":129534},[],"Adaptar los consumidores",{"_3699":75772,"_31384":75599,"_21647":129536,"_5":14929,"_28559":129094,"_3075":129537},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave.",{"_3699":75773,"_31384":75599,"_21647":129539,"_5":14929,"_28559":129094,"_3075":129540},[],"Adapta los clientes de `/v1/roles` a `/v1/crl-settings` usando el ID de CA. La guía de CRL describe las operaciones y opciones.",{"_3699":75774,"_31384":75599,"_21647":129542,"_5":14929,"_28559":129094,"_3075":129543},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3699":75775,"_31384":75599,"_21647":129545,"_5":14929,"_28559":129094,"_3075":129546},[],"Migración de los ajustes de CRL describe cómo convierte la actualización los roles guardados, con qué datos aborta y por qué no puede revertirse.",{"_3699":75776,"_31384":75599,"_21647":129548,"_5":14929,"_28559":129094,"_3075":129549},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3699":75777,"_31384":75599,"_21647":129551,"_5":14929,"_28559":129098,"_3075":129552},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3699":75778,"_31384":75599,"_21647":129554,"_5":14929,"_28559":129102,"_3075":129555},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3699":75779,"_31384":75599,"_21647":129557,"_5":14929,"_28559":129106,"_3075":129558},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3699":75780,"_31384":75599,"_21647":129560,"_5":14929,"_28559":129110,"_3075":129561},[],"Los valores del campo `type` del certificado cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. La actualización convierte los valores almacenados; adapta los consumidores que leen o comparan esos valores.",{"_3699":75781,"_31384":75599,"_21647":129563,"_5":14929,"_28559":129114,"_3075":129564},[],"Los identificadores del KMS se resuelven ahora como ID de clave antes que como alias. Por eso la migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente. Los alias afectados se descartan, no se redirigen: un cliente que usaba uno llega ahora a la clave con ese ID.",{"_3699":75782,"_31384":75599,"_21647":129566,"_5":14929,"_28559":129118,"_3075":129567},[],"Las configuraciones de webhook cambian de formato y sus campos se renombran. La actualización reescribe las configuraciones almacenadas; los clientes de API que las leen o escriben deben usar los nombres nuevos:",{"_3699":75783,"_31384":75599,"_21647":129569,"_5":14929,"_28559":129118,"_3075":129570},[],"Campo en 3.8.0",{"_3699":75784,"_31384":75599,"_21647":129572,"_5":14929,"_28559":129118,"_3075":129573},[],"Campo en 4.0.0",{"_3699":75785,"_31384":75599,"_21647":129575,"_5":14929,"_28559":129118,"_3075":60243},[],{"_3699":75786,"_31384":75599,"_21647":129577,"_5":14929,"_28559":129118,"_3075":129578},[],"`insecure_skip_verify` (con el valor negado)",{"_3699":75787,"_31384":75599,"_21647":129580,"_5":14929,"_28559":129118,"_3075":60249},[],{"_3699":75788,"_31384":75599,"_21647":129582,"_5":14929,"_28559":129118,"_3075":60252},[],{"_3699":75789,"_31384":75599,"_21647":129584,"_5":14929,"_28559":129118,"_3075":60255},[],{"_3699":75790,"_31384":75599,"_21647":129586,"_5":14929,"_28559":129118,"_3075":60258},[],{"_3699":75791,"_31384":75599,"_21647":129588,"_5":14929,"_28559":129118,"_3075":60261},[],{"_3699":75792,"_31384":75599,"_21647":129590,"_5":14929,"_28559":129118,"_3075":60264},[],{"_3699":75793,"_31384":75599,"_21647":129592,"_5":14929,"_28559":129118,"_3075":129593},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Las referencias a archivos sí requieren intervención; revisa también la verificación del receptor.",{"_3699":75794,"_31384":75599,"_21647":129595,"_5":14929,"_28559":129118,"_3075":129596},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3699":75795,"_31384":75599,"_21647":129598,"_5":14929,"_28559":129122,"_3075":129599},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3699":75796,"_31384":75599,"_21647":129601,"_5":14929,"_28559":129122,"_3075":129602},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3699":75797,"_31384":75599,"_21647":129604,"_5":14929,"_28559":129122,"_3075":129605},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3699":75798,"_31384":75599,"_21647":129607,"_5":14929,"_28559":129126,"_3075":129608},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3699":75799,"_31384":75599,"_21647":129610,"_5":14929,"_28559":129130,"_3075":129611},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3699":75800,"_31384":75599,"_21647":129613,"_5":14929,"_28559":129130,"_3075":129614},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3699":75801,"_31384":75599,"_21647":129616,"_5":14929,"_28559":129130,"_3075":129617},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3699":75802,"_31384":75599,"_21647":129619,"_5":14929,"_28559":129130,"_3075":129620},[],"El endpoint también admite SSE. Consulta API de eventos y flujo en vivo.",{"_3699":75803,"_31384":75599,"_21647":129622,"_5":14929,"_28559":129134,"_3075":129623},[],"Dos cambios afectan a las suscripciones de alertas y a los consumidores del bus de eventos: los eventos de la VA cambian de nombre y de forma, y `ca.sign.signature` deja de publicarse porque la CA ya no firma datos arbitrarios (consulta Eliminación de los endpoints de firma arbitraria de la CA).",{"_3699":75804,"_31384":75599,"_21647":129625,"_5":14929,"_28559":129138,"_3075":129626},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3699":75805,"_31384":75599,"_21647":129628,"_5":14929,"_28559":129146,"_3075":129629},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3699":75806,"_31384":75599,"_21647":129631,"_5":14929,"_28559":129146,"_3075":129632},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3699":75807,"_31384":75599,"_21647":129634,"_5":14929,"_28559":129150,"_3075":129635},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3699":75808,"_31384":75599,"_21647":129637,"_5":14929,"_28559":129154,"_3075":129638},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Migración de los ajustes de CRL).",{"_3699":75809,"_31384":75599,"_21647":129640,"_5":14929,"_28559":129154,"_3075":129641},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3699":75810,"_31384":75599,"_21647":129643,"_5":14929,"_28559":129154,"_3075":129644},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3699":75811,"_31384":75599,"_21647":129646,"_5":14929,"_28559":129154,"_3075":129647},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3699":75812,"_31384":75599,"_21647":129649,"_5":14929,"_28559":129154,"_3075":129650},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3699":75813,"_31384":75599,"_21647":129652,"_5":14929,"_28559":129154,"_3075":129653},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3699":75814,"_31384":75599,"_21647":129655,"_5":14929,"_28559":129158,"_3075":129656},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3699":75815,"_31384":75599,"_21647":129658,"_5":14929,"_28559":129158,"_3075":129659},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3699":75816,"_31384":75599,"_21647":129661,"_5":14929,"_28559":129158,"_3075":129662},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3699":75817,"_31384":75599,"_21647":129664,"_5":14929,"_28559":129158,"_3075":129665},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3699":75818,"_31384":75599,"_21647":129667,"_5":14929,"_28559":129158,"_3075":129668},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3699":75819,"_31384":75599,"_21647":129670,"_5":14929,"_28559":129162,"_3075":129671},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3699":75820,"_31384":75599,"_21647":129673,"_5":14929,"_28559":129162,"_3075":129674},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3699":75821,"_31384":75599,"_21647":129676,"_5":14929,"_28559":129162,"_3075":129677},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3699":75822,"_31384":75599,"_21647":129679,"_5":14929,"_28559":129162,"_3075":60354},[],{"_3699":75823,"_31384":75599,"_21647":129681,"_5":14929,"_28559":129162,"_3075":129682},[],"Claves de datos obligatorias",{"_3699":75824,"_31384":75599,"_21647":129684,"_5":14929,"_28559":129162,"_3075":129685},[],"Cuándo",{"_3699":75825,"_31384":75599,"_21647":129687,"_5":14929,"_28559":129162,"_3075":129688},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3699":75826,"_31384":75599,"_21647":129690,"_5":14929,"_28559":129162,"_3075":60366},[],{"_3699":75827,"_31384":75599,"_21647":129692,"_5":14929,"_28559":129162,"_3075":129693},[],"Siempre",{"_3699":75828,"_31384":75599,"_21647":129695,"_5":14929,"_28559":129162,"_3075":129696},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3699":75829,"_31384":75599,"_21647":129698,"_5":14929,"_28559":129162,"_3075":60366},[],{"_3699":75830,"_31384":75599,"_21647":129700,"_5":14929,"_28559":129162,"_3075":129693},[],{"_3699":75831,"_31384":75599,"_21647":129702,"_5":14929,"_28559":129162,"_3075":60379},[],{"_3699":75832,"_31384":75599,"_21647":129704,"_5":14929,"_28559":129162,"_3075":60366},[],{"_3699":75833,"_31384":75599,"_21647":129706,"_5":14929,"_28559":129162,"_3075":129707},[],"Solo cuando hay autenticación SMTP",{"_3699":75834,"_31384":75599,"_21647":129709,"_5":14929,"_28559":129162,"_3075":129710},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3699":75835,"_31384":75599,"_21647":129712,"_5":14929,"_28559":129162,"_3075":129713},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3699":75836,"_31384":75599,"_21647":129715,"_5":14929,"_28559":129162,"_3075":129716},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3699":75837,"_31384":75599,"_21647":129718,"_5":14929,"_28559":129162,"_3075":129719},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3699":75838,"_31384":75599,"_21647":129721,"_5":14929,"_28559":129162,"_3075":129722},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3699":75839,"_31384":75599,"_21647":129724,"_5":14929,"_28559":129162,"_3075":129725},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3699":75840,"_31384":75599,"_21647":129727,"_5":14929,"_28559":129162,"_3075":129728},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3699":75841,"_31384":75599,"_21647":129730,"_5":14929,"_28559":129162,"_3075":129731},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3699":75842,"_31384":75599,"_21647":129733,"_5":14929,"_28559":129162,"_3075":129734},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3699":75843,"_31384":75599,"_21647":129736,"_5":14929,"_28559":129162,"_3075":129737},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3699":75844,"_31384":75599,"_21647":129739,"_5":14929,"_28559":129162,"_3075":129740},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3699":75845,"_31384":75599,"_21647":129742,"_5":14929,"_28559":129162,"_3075":129743},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3699":75846,"_31384":75599,"_21647":129745,"_5":14929,"_28559":129162,"_3075":129746},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3699":75847,"_31384":75599,"_21647":129748,"_5":14929,"_28559":129162,"_3075":129749},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3699":75848,"_31384":75599,"_21647":129751,"_5":14929,"_28559":129162,"_3075":129752},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3699":75849,"_31384":75599,"_21647":129754,"_5":14929,"_28559":129166,"_3075":129755},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3699":75850,"_31384":75599,"_21647":129757,"_5":14929,"_28559":129166,"_3075":129758},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3699":75851,"_31384":75599,"_21647":129760,"_5":14929,"_28559":129170,"_3075":129761},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3699":75852,"_31384":75599,"_21647":129763,"_5":14929,"_28559":129170,"_3075":129764},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3699":75853,"_31384":75599,"_21647":129766,"_5":14929,"_28559":129170,"_3075":129767},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3699":75854,"_31384":75599,"_21647":129769,"_5":14929,"_28559":129170,"_3075":129770},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3699":75855,"_31384":75599,"_21647":129772,"_5":14929,"_28559":129170,"_3075":129773},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3699":75856,"_31384":75599,"_21647":129775,"_5":14929,"_28559":129170,"_3075":129776},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3699":75857,"_31384":75599,"_21647":129778,"_5":14929,"_28559":129170,"_3075":129779},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3699":75858,"_31384":75599,"_21647":129781,"_5":14929,"_28559":129170,"_3075":129782},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3699":75859,"_31384":75599,"_21647":129784,"_5":14929,"_28559":129170,"_3075":129785},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3699":75860,"_31384":75599,"_21647":129787,"_5":14929,"_28559":129170,"_3075":129788},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3699":75861,"_31384":75599,"_21647":129790,"_5":14929,"_28559":129170,"_3075":129791},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3699":75862,"_31384":75599,"_21647":129793,"_5":14929,"_28559":129174,"_3075":129794},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3699":75863,"_31384":75599,"_21647":129796,"_5":14929,"_28559":129174,"_3075":129797},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3699":75864,"_31384":75599,"_21647":129799,"_5":14929,"_28559":129178,"_3075":129800},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3699":75865,"_31384":75599,"_21647":129802,"_5":14929,"_28559":129178,"_3075":129803},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3699":75866,"_31384":75599,"_21647":129805,"_5":14929,"_28559":129178,"_3075":129806},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3699":75867,"_31384":75599,"_21647":129808,"_5":14929,"_28559":129178,"_3075":129809},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3699":75868,"_31384":75599,"_21647":129811,"_5":14929,"_28559":129178,"_3075":129812},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3699":75869,"_31384":75599,"_21647":129814,"_5":14929,"_28559":129178,"_3075":129815},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3699":75870,"_31384":75599,"_21647":129817,"_5":14929,"_28559":129178,"_3075":129818},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3699":75871,"_31384":75599,"_21647":129820,"_5":14929,"_28559":129178,"_3075":129821},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3699":75872,"_31384":75599,"_21647":129823,"_5":14929,"_28559":129182,"_3075":129824},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3699":75873,"_31384":75599,"_21647":129826,"_5":14929,"_28559":129182,"_3075":129827},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3699":75874,"_31384":75599,"_21647":129829,"_5":14929,"_28559":129182,"_3075":129830},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3699":75875,"_31384":75599,"_21647":129832,"_5":14929,"_28559":129182,"_3075":129833},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3699":75876,"_31384":75599,"_21647":129835,"_5":14929,"_28559":129182,"_3075":129836},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3699":75877,"_31384":75599,"_21647":129838,"_5":14929,"_28559":129182,"_3075":129839},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3699":75878,"_31384":75599,"_21647":129841,"_5":14929,"_28559":129182,"_3075":129842},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3699":75879,"_31384":75599,"_21647":129844,"_5":14929,"_28559":129182,"_3075":129845},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3699":75880,"_31384":75599,"_21647":129847,"_5":14929,"_28559":129182,"_3075":129848},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3699":75881,"_31384":75599,"_21647":129850,"_5":14929,"_28559":129182,"_3075":129851},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3699":75882,"_31384":75599,"_21647":129853,"_5":14929,"_28559":129182,"_3075":129854},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3699":75883,"_31384":75599,"_21647":129856,"_5":14929,"_28559":129185,"_3075":129857},[],"Tras la actualización, comprueba en este orden:",{"_3699":75884,"_31384":75599,"_21647":129859,"_5":14929,"_28559":129185,"_3075":129860},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3699":75885,"_31384":75599,"_21647":129862,"_5":14929,"_28559":129185,"_3075":129863},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3699":75886,"_31384":75599,"_21647":129865,"_5":14929,"_28559":129185,"_3075":129866},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3699":75887,"_31384":75599,"_21647":129868,"_5":14929,"_28559":129185,"_3075":129869},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3699":75888,"_31384":75599,"_21647":129871,"_5":14929,"_28559":129185,"_3075":129872},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3699":75889,"_31384":75599,"_21647":129874,"_5":14929,"_28559":129185,"_3075":129875},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3699":75890,"_31384":75599,"_21647":129877,"_5":14929,"_28559":129185,"_3075":129878},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3699":75891,"_31384":75599,"_21647":129880,"_5":14929,"_28559":129185,"_3075":129881},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3699":75892,"_31384":75599,"_21647":129883,"_5":14929,"_28559":129185,"_3075":129884},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada. En AMQP las colas de suscriptores de SSE son auto-delete y desaparecen cuando su instancia se detiene; en proveedores de event bus sin soporte de suscriptores efímeros, comprueba que no se acumulen colas de SSE por proceso.",{"_3699":75893,"_31384":75599,"_21647":129886,"_5":14929,"_28559":129185,"_3075":129887},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3699":75894,"_31384":75599,"_21647":129889,"_5":14929,"_28559":129185,"_3075":129890},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3699":75895,"_31384":75599,"_21647":129892,"_5":14929,"_28559":129185,"_3075":129893},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3699":75896,"_31384":75599,"_21647":129895,"_5":14929,"_28559":129185,"_3075":129896},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3699":75897,"_31384":75599,"_21647":129898,"_5":14929,"_28559":129185,"_3075":129899},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3699":75898,"_31384":75599,"_21647":129901,"_5":14929,"_28559":129185,"_3075":129902},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3699":75899,"_31384":75599,"_21647":129904,"_5":14929,"_28559":129189,"_3075":129905},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3699":75900,"_31384":75599,"_21647":129907,"_5":14929,"_28559":129189,"_3075":129908},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3699":75901,"_31384":75599,"_21647":129910,"_5":14929,"_28559":129189,"_3075":129911},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3699":75902,"_31384":75599,"_21647":129913,"_5":14929,"_28559":129189,"_3075":129914},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3699":75903,"_31384":75599,"_21647":129916,"_5":14929,"_28559":129189,"_3075":129917},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60597":129919,"_60599":129920,"_60601":129921,"_60603":129922,"_18816":3110,"_72842":3110},"spanish",[3075,31384,5,28559],{"_3075":25872,"_31384":25872,"_5":25872,"_28559":25872},{"_3075":129923,"_31384":132981,"_5":136039,"_28559":139097},{"_4849":129924,"_60607":129925,"_5":25872},{"_15010":3399,"_15377":5881,"_15396":8372,"_30384":3165,"_15383":7803,"_20570":5677,"_15031":3288,"_15038":3287,"_30321":15483,"_30734":6255,"_30771":7984,"_30360":3999,"_35739":5457,"_30463":21048,"_30815":16524,"_35746":3755,"_35749":6956,"_35752":11665,"_35755":7255,"_31207":14811,"_35760":6436,"_35762":4360,"_31242":19160,"_15392":3564,"_35766":7844,"_35769":7258,"_35771":8498,"_30810":3503,"_31227":7993,"_31255":18577,"_35776":5919,"_35778":5655,"_35780":7310,"_30474":3188,"_35783":3475,"_35785":4595,"_35787":20120,"_35789":5184,"_35791":3597,"_30397":3671,"_35794":3441,"_35796":4951,"_30391":3586,"_30847":7229,"_35800":11522,"_35802":6207,"_35805":4988,"_30437":18886,"_35809":5210,"_30312":7919,"_35812":6278,