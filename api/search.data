:102756,"_33369":102759,"_33371":102762,"_33373":102765,"_33375":102768,"_33377":102771,"_33379":102774,"_33381":102776,"_33383":102779,"_33385":102782,"_33387":102785,"_33389":102788,"_33391":102791,"_33393":102794,"_33395":102797,"_33397":102800,"_33399":102803,"_33401":102806,"_33403":102809,"_33405":102812,"_33407":102815,"_33409":102818,"_33411":102821,"_33413":102825,"_33415":102828,"_33417":102831,"_33419":102835,"_33421":102839,"_33423":102843,"_33425":102847,"_33427":102851,"_33429":102854,"_33431":102858,"_33433":102862,"_33435":102866,"_33437":102869,"_33439":102872,"_33441":102875,"_33443":102878,"_33445":102881,"_33447":102884,"_33449":102887,"_33451":102890,"_33453":102893,"_33455":102896,"_33457":102899,"_33459":102902,"_33461":102905,"_33463":102908,"_33465":102911,"_33467":102914,"_33469":102917,"_33471":102920,"_33473":102923,"_33475":102926,"_33477":102929,"_33479":102932,"_33481":102935,"_33483":102938,"_33485":102940,"_33487":102942,"_33489":102945,"_33491":102948,"_33493":102951,"_33495":102954,"_33497":102957,"_33499":102960,"_33501":102963,"_33503":102966,"_33505":102969,"_33507":102972,"_33509":102975,"_33511":102978,"_33513":102981,"_33515":102984,"_33517":102987,"_33519":102990,"_33521":102994,"_33523":102997,"_33525":103000,"_33527":103004,"_33529":103007,"_33531":103011,"_33533":103014,"_33535":103017,"_33537":103020,"_33539":103023,"_33541":103026,"_33543":103029,"_33545":103032,"_33547":103035,"_33549":103038,"_33551":103041,"_33553":103044,"_33555":103046,"_33557":103049,"_33559":103052,"_33561":103055,"_33563":103058,"_33565":103061,"_33567":103064,"_33569":103067,"_33571":103070,"_33573":103073,"_33575":103076,"_33577":103081,"_33579":103084,"_33581":103088,"_33583":103092,"_33585":103096,"_33587":103099,"_33589":103102,"_33591":103104,"_33593":103106,"_33595":103108,"_33597":103110,"_33599":103113,"_33601":103116,"_33603":103119,"_33605":103122,"_33607":103125,"_33609":103127,"_33611":103130,"_33613":103132,"_33615":103135,"_33617":103138,"_33619":103141,"_33621":103143,"_33623":103146,"_33625":103149,"_33627":103152,"_33629":103155,"_33631":103158,"_33633":103161,"_33635":103164,"_33637":103167,"_33639":103170,"_33641":103173,"_33643":103176,"_33645":103179},{"_2857":57743,"_25170":57743,"_5":12294,"_2384":95917,"_25485":95918,"_17548":95921,"_23820":57743},"Despliega desde AWS Marketplace",[40817,95919,95920],"Despliegue","Otros modelos",[],{"_2857":57744,"_25170":57743,"_17548":95923,"_5":17443,"_23820":57743,"_2384":95924},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_2857":57745,"_25170":57743,"_5":25482,"_17548":95926,"_23820":95927,"_2384":95928},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_2857":57746,"_25170":57743,"_5":25482,"_17548":95930,"_23820":95931,"_2384":95932},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_2857":57747,"_25170":57743,"_5":25482,"_17548":95934,"_23820":95935,"_2384":95936},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_2857":57748,"_25170":57743,"_5":25482,"_17548":95938,"_23820":95939,"_2384":95940},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_2857":57749,"_25170":57743,"_5":25482,"_17548":95942,"_23820":95943,"_2384":95944},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_2857":57750,"_25170":57743,"_5":25482,"_17548":95946,"_23820":95947,"_2384":95948},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_2857":57751,"_25170":57743,"_5":25482,"_17548":95950,"_23820":95951,"_2384":95952},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_2857":57752,"_25170":57743,"_17548":95954,"_5":17443,"_23820":57743,"_2384":95955},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_2857":57753,"_25170":57743,"_17548":95957,"_5":17443,"_23820":95927,"_2384":95958},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_2857":57754,"_25170":57743,"_17548":95960,"_5":17443,"_23820":95927,"_2384":95961},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_2857":57755,"_25170":57743,"_17548":95963,"_5":17443,"_23820":95927,"_2384":95964},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_2857":57756,"_25170":57743,"_17548":95966,"_5":17443,"_23820":95931,"_2384":95967},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_2857":57757,"_25170":57743,"_17548":95969,"_5":17443,"_23820":95931,"_2384":95970},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_2857":57758,"_25170":57743,"_17548":95972,"_5":17443,"_23820":95931,"_2384":95973},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_2857":57759,"_25170":57743,"_17548":95975,"_5":17443,"_23820":95935,"_2384":95976},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_2857":57760,"_25170":57743,"_17548":95978,"_5":17443,"_23820":95939,"_2384":95979},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_2857":57761,"_25170":57743,"_17548":95981,"_5":17443,"_23820":95943,"_2384":95982},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_2857":57762,"_25170":57743,"_17548":95984,"_5":17443,"_23820":95947,"_2384":95985},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_2857":57763,"_25170":57743,"_17548":95987,"_5":17443,"_23820":95951,"_2384":95988},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_2857":57764,"_25170":57764,"_5":12294,"_2384":95990,"_25485":95991,"_17548":95992,"_23820":57764},"Despliega Lamassu",[40817,95919],[],{"_2857":57765,"_25170":57764,"_17548":95994,"_5":17443,"_23820":57764,"_2384":95995},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_2857":57766,"_25170":57764,"_5":25482,"_17548":95997,"_23820":95998,"_2384":95999},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_2857":57767,"_25170":57764,"_5":25482,"_17548":96001,"_23820":96002,"_2384":96003},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_2857":57768,"_25170":57764,"_5":25482,"_17548":96005,"_23820":96006,"_2384":96007},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_2857":57769,"_25170":57764,"_17548":96009,"_5":17443,"_23820":57764,"_2384":96010},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_2857":57770,"_25170":57764,"_17548":96012,"_5":17443,"_23820":95998,"_2384":96013},[],"Modelo",{"_2857":57771,"_25170":57764,"_17548":96015,"_5":17443,"_23820":95998,"_2384":96016},[],"Recomendado para",{"_2857":57772,"_25170":57764,"_17548":96018,"_5":17443,"_23820":95998,"_2384":96019},[],"Quién opera la infraestructura",{"_2857":57773,"_25170":57764,"_17548":96021,"_5":17443,"_23820":95998,"_2384":96022},[],"Punto de partida",{"_2857":57774,"_25170":57764,"_17548":96024,"_5":17443,"_23820":95998,"_2384":40924},[],{"_2857":57775,"_25170":57764,"_17548":96026,"_5":17443,"_23820":95998,"_2384":96027},[],"Producción, entornos regulados y despliegues personalizados",{"_2857":57776,"_25170":57764,"_17548":96029,"_5":17443,"_23820":95998,"_2384":96030},[],"Tu equipo",{"_2857":57777,"_25170":57764,"_17548":96032,"_5":17443,"_23820":95998,"_2384":96033},[],"Helm o Fastlane",{"_2857":57778,"_25170":57764,"_17548":96035,"_5":17443,"_23820":95998,"_2384":40936},[],{"_2857":57779,"_25170":57764,"_17548":96037,"_5":17443,"_23820":95998,"_2384":96038},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_2857":57780,"_25170":57764,"_17548":96040,"_5":17443,"_23820":95998,"_2384":96030},[],{"_2857":57781,"_25170":57764,"_17548":96042,"_5":17443,"_23820":95998,"_2384":96043},[],"Imagen preconfigurada en EC2",{"_2857":57782,"_25170":57764,"_17548":96045,"_5":17443,"_23820":95998,"_2384":40947},[],{"_2857":57783,"_25170":57764,"_17548":96047,"_5":17443,"_23820":95998,"_2384":96048},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_2857":57784,"_25170":57764,"_17548":96050,"_5":17443,"_23820":95998,"_2384":40953},[],{"_2857":57785,"_25170":57764,"_17548":96052,"_5":17443,"_23820":95998,"_2384":96053},[],"Suscripción gestionada",{"_2857":57786,"_25170":57764,"_17548":96055,"_5":17443,"_23820":95998,"_2384":96056},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2857":57787,"_25170":57764,"_17548":96058,"_5":17443,"_23820":95998,"_2384":96059},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2857":57788,"_25170":57764,"_17548":96061,"_5":17443,"_23820":95998,"_2384":96062},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_2857":57789,"_25170":57764,"_17548":96064,"_5":17443,"_23820":96002,"_2384":96065},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_2857":57790,"_25170":57764,"_17548":96067,"_5":17443,"_23820":96006,"_2384":96068},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_2857":57791,"_25170":57791,"_5":12294,"_2384":96070,"_25485":96071,"_17548":96072,"_23820":57791},"Utiliza Lamassu como SaaS",[40817,95919,95920],[],{"_2857":57792,"_25170":57791,"_17548":96074,"_5":17443,"_23820":57791,"_2384":96075},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_2857":57793,"_25170":57791,"_5":25482,"_17548":96077,"_23820":96078,"_2384":96079},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_2857":57794,"_25170":57791,"_5":25482,"_17548":96081,"_23820":96082,"_2384":96083},[],"/docs/es/deployment/saas#planes","Planes",{"_2857":57795,"_25170":57791,"_5":25482,"_17548":96085,"_23820":96086,"_2384":96087},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_2857":57796,"_25170":57791,"_17548":96089,"_5":17443,"_23820":57791,"_2384":96090},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_2857":57797,"_25170":57791,"_17548":96092,"_5":17443,"_23820":96078,"_2384":96093},[],"Disponibilidad y mantenimiento de la plataforma.",{"_2857":57798,"_25170":57791,"_17548":96095,"_5":17443,"_23820":96078,"_2384":96096},[],"Copias de seguridad automáticas.",{"_2857":57799,"_25170":57791,"_17548":96098,"_5":17443,"_23820":96078,"_2384":96099},[],"Actualizaciones de versión.",{"_2857":57800,"_25170":57791,"_17548":96101,"_5":17443,"_23820":96078,"_2384":96102},[],"Soporte técnico y SLA según el plan contratado.",{"_2857":57801,"_25170":57791,"_17548":96104,"_5":17443,"_23820":96082,"_2384":41008},[],{"_2857":57802,"_25170":57791,"_17548":96106,"_5":17443,"_23820":96082,"_2384":96107},[],"Dispositivos",{"_2857":57803,"_25170":57791,"_17548":96109,"_5":17443,"_23820":96082,"_2384":96110},[],"Soporte",{"_2857":57804,"_25170":57791,"_17548":96112,"_5":17443,"_23820":96082,"_2384":41017},[],{"_2857":57805,"_25170":57791,"_17548":96114,"_5":17443,"_23820":96082,"_2384":41020},[],{"_2857":57806,"_25170":57791,"_17548":96116,"_5":17443,"_23820":96082,"_2384":96117},[],"Hasta 1.000",{"_2857":57807,"_25170":57791,"_17548":96119,"_5":17443,"_23820":96082,"_2384":41026},[],{"_2857":57808,"_25170":57791,"_17548":96121,"_5":17443,"_23820":96082,"_2384":96122},[],"99,5 %",{"_2857":57809,"_25170":57791,"_17548":96124,"_5":17443,"_23820":96082,"_2384":41032},[],{"_2857":57810,"_25170":57791,"_17548":96126,"_5":17443,"_23820":96082,"_2384":96127},[],"Hasta 10.000",{"_2857":57811,"_25170":57791,"_17548":96129,"_5":17443,"_23820":96082,"_2384":96130},[],"Email y chat",{"_2857":57812,"_25170":57791,"_17548":96132,"_5":17443,"_23820":96082,"_2384":96133},[],"99,9 %",{"_2857":57813,"_25170":57791,"_17548":96135,"_5":17443,"_23820":96082,"_2384":41044},[],{"_2857":57814,"_25170":57791,"_17548":96137,"_5":17443,"_23820":96082,"_2384":96138},[],"Ilimitados",{"_2857":57815,"_25170":57791,"_17548":96140,"_5":17443,"_23820":96082,"_2384":96141},[],"Dedicado",{"_2857":57816,"_25170":57791,"_17548":96143,"_5":17443,"_23820":96082,"_2384":96144},[],"99,99 %",{"_2857":57817,"_25170":57791,"_17548":96146,"_5":17443,"_23820":96086,"_2384":96147},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_2857":57818,"_25170":57791,"_17548":96149,"_5":17443,"_23820":96086,"_2384":96150},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_2857":57819,"_25170":57819,"_5":12294,"_2384":41061,"_25485":96152,"_17548":96154,"_23820":57819},[40817,95919,96153],"Kubernetes autogestionado",[],{"_2857":57820,"_25170":57819,"_17548":96156,"_5":17443,"_23820":57819,"_2384":96157},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_2857":57821,"_25170":57819,"_5":25482,"_17548":96159,"_23820":96160,"_2384":96161},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_2857":57822,"_25170":57819,"_5":25482,"_17548":96163,"_23820":96164,"_2384":96165},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_2857":57823,"_25170":57819,"_5":25482,"_17548":96167,"_23820":96168,"_2384":96169},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_2857":57824,"_25170":57819,"_5":25482,"_17548":96171,"_23820":96172,"_2384":96173},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_2857":57825,"_25170":57819,"_5":25482,"_17548":96175,"_23820":96176,"_2384":96177},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_2857":57826,"_25170":57819,"_5":25482,"_17548":96179,"_23820":96180,"_2384":96181},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_2857":57827,"_25170":57819,"_5":25482,"_17548":96183,"_23820":96184,"_2384":96185},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_2857":57828,"_25170":57819,"_5":25482,"_17548":96187,"_23820":96188,"_2384":96189},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_2857":57829,"_25170":57819,"_5":25482,"_17548":96191,"_23820":96192,"_2384":96193},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_2857":57830,"_25170":57819,"_5":25482,"_17548":96195,"_23820":96196,"_2384":96197},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_2857":57831,"_25170":57819,"_17548":96199,"_5":17443,"_23820":96160,"_2384":96200},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_2857":57832,"_25170":57819,"_17548":96202,"_5":17443,"_23820":96160,"_2384":96203},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_2857":57833,"_25170":57819,"_17548":96205,"_5":17443,"_23820":96164,"_2384":96206},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_2857":57834,"_25170":57819,"_17548":96208,"_5":17443,"_23820":96164,"_2384":96209},[],"Fastlane instala o configura",{"_2857":57835,"_25170":57819,"_17548":96211,"_5":17443,"_23820":96164,"_2384":96212},[],"Tú sigues proporcionando",{"_2857":57836,"_25170":57819,"_17548":96214,"_5":17443,"_23820":96164,"_2384":96215},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_2857":57837,"_25170":57819,"_17548":96217,"_5":17443,"_23820":96164,"_2384":96218},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_2857":57838,"_25170":57819,"_17548":96220,"_5":17443,"_23820":96164,"_2384":96221},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_2857":57839,"_25170":57819,"_17548":96223,"_5":17443,"_23820":96164,"_2384":96224},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_2857":57840,"_25170":57819,"_17548":96226,"_5":17443,"_23820":96164,"_2384":96227},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_2857":57841,"_25170":57819,"_17548":96229,"_5":17443,"_23820":96164,"_2384":96230},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_2857":57842,"_25170":57819,"_17548":96232,"_5":17443,"_23820":96164,"_2384":96233},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_2857":57843,"_25170":57819,"_17548":96235,"_5":17443,"_23820":96164,"_2384":96236},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_2857":57844,"_25170":57819,"_17548":96238,"_5":17443,"_23820":96164,"_2384":96239},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_2857":57845,"_25170":57819,"_17548":96241,"_5":17443,"_23820":96168,"_2384":96242},[],"Necesitas:",{"_2857":57846,"_25170":57819,"_17548":96244,"_5":17443,"_23820":96168,"_2384":96245},[],"un clúster Kubernetes existente",{"_2857":57847,"_25170":57819,"_17548":96247,"_5":17443,"_23820":96168,"_2384":96248},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_2857":57848,"_25170":57819,"_17548":96250,"_5":17443,"_23820":96168,"_2384":41159},[],{"_2857":57849,"_25170":57819,"_17548":96252,"_5":17443,"_23820":96168,"_2384":19868},[],{"_2857":57850,"_25170":57819,"_17548":96254,"_5":17443,"_23820":96168,"_2384":96255},[],"`jq` solo si usas `--sample-data`",{"_2857":57851,"_25170":57819,"_17548":96257,"_5":17443,"_23820":96168,"_2384":96258},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_2857":57852,"_25170":57819,"_17548":96260,"_5":17443,"_23820":96168,"_2384":96261},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_2857":57853,"_25170":57819,"_17548":96263,"_5":17443,"_23820":96168,"_2384":96264},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_2857":57854,"_25170":57819,"_17548":96266,"_5":17443,"_23820":96172,"_2384":96267},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_2857":57855,"_25170":57819,"_17548":96269,"_5":17443,"_23820":96172,"_2384":96270},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_2857":57856,"_25170":57819,"_17548":96272,"_5":17443,"_23820":96176,"_2384":96273},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_2857":57857,"_25170":57819,"_17548":96275,"_5":17443,"_23820":96176,"_2384":96276},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_2857":57858,"_25170":57819,"_17548":96278,"_5":17443,"_23820":96176,"_2384":96279},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_2857":57859,"_25170":57819,"_17548":96281,"_5":17443,"_23820":96176,"_2384":96282},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_2857":57860,"_25170":57819,"_17548":96284,"_5":17443,"_23820":96180,"_2384":96285},[],"Opción",{"_2857":57861,"_25170":57819,"_17548":96287,"_5":17443,"_23820":96180,"_2384":96288},[],"Valor predeterminado",{"_2857":57862,"_25170":57819,"_17548":96290,"_5":17443,"_23820":96180,"_2384":96291},[],"Propósito",{"_2857":57863,"_25170":57819,"_17548":96293,"_5":17443,"_23820":96180,"_2384":41203},[],{"_2857":57864,"_25170":57819,"_17548":96295,"_5":17443,"_23820":96180,"_2384":41206},[],{"_2857":57865,"_25170":57819,"_17548":96297,"_5":17443,"_23820":96180,"_2384":96298},[],"Muestra la ayuda",{"_2857":57866,"_25170":57819,"_17548":96300,"_5":17443,"_23820":96180,"_2384":41212},[],{"_2857":57867,"_25170":57819,"_17548":96302,"_5":17443,"_23820":96180,"_2384":96303},[],"contexto actual",{"_2857":57868,"_25170":57819,"_17548":96305,"_5":17443,"_23820":96180,"_2384":96306},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_2857":57869,"_25170":57819,"_17548":96308,"_5":17443,"_23820":96180,"_2384":41221},[],{"_2857":57870,"_25170":57819,"_17548":96310,"_5":17443,"_23820":96180,"_2384":5349},[],{"_2857":57871,"_25170":57819,"_17548":96312,"_5":17443,"_23820":96180,"_2384":96313},[],"Omite prompts y genera credenciales para las dependencias",{"_2857":57872,"_25170":57819,"_17548":96315,"_5":17443,"_23820":96180,"_2384":41229},[],{"_2857":57873,"_25170":57819,"_17548":96317,"_5":17443,"_23820":96180,"_2384":41232},[],{"_2857":57874,"_25170":57819,"_17548":96319,"_5":17443,"_23820":96180,"_2384":96320},[],"Namespace de la instalación",{"_2857":57875,"_25170":57819,"_17548":96322,"_5":17443,"_23820":96180,"_2384":41238},[],{"_2857":57876,"_25170":57819,"_17548":96324,"_5":17443,"_23820":96180,"_2384":41241},[],{"_2857":57877,"_25170":57819,"_17548":96326,"_5":17443,"_23820":96180,"_2384":96327},[],"Dominio usado por la UI, OIDC y el certificado",{"_2857":57878,"_25170":57819,"_17548":96329,"_5":17443,"_23820":96180,"_2384":41247},[],{"_2857":57879,"_25170":57819,"_17548":96331,"_5":17443,"_23820":96180,"_2384":12520},[],{"_2857":57880,"_25170":57819,"_17548":96333,"_5":17443,"_23820":96180,"_2384":96334},[],"Versión del chart de Lamassu",{"_2857":57881,"_25170":57819,"_17548":96336,"_5":17443,"_23820":96180,"_2384":41255},[],{"_2857":57882,"_25170":57819,"_17548":96338,"_5":17443,"_23820":96180,"_2384":41258},[],{"_2857":57883,"_25170":57819,"_17548":96340,"_5":17443,"_23820":96180,"_2384":96341},[],"Puerto del listener HTTPS",{"_2857":57884,"_25170":57819,"_17548":96343,"_5":17443,"_23820":96180,"_2384":41264},[],{"_2857":57885,"_25170":57819,"_17548":96345,"_5":17443,"_23820":96180,"_2384":41267},[],{"_2857":57886,"_25170":57819,"_17548":96347,"_5":17443,"_23820":96180,"_2384":96348},[],"Puerto del listener HTTP",{"_2857":57887,"_25170":57819,"_17548":96350,"_5":17443,"_23820":96180,"_2384":41273},[],{"_2857":57888,"_25170":57819,"_17548":96352,"_5":17443,"_23820":96180,"_2384":41206},[],{"_2857":57889,"_25170":57819,"_17548":96354,"_5":17443,"_23820":96180,"_2384":96355},[],"Certificado PEM para TLS downstream",{"_2857":57890,"_25170":57819,"_17548":96357,"_5":17443,"_23820":96180,"_2384":41281},[],{"_2857":57891,"_25170":57819,"_17548":96359,"_5":17443,"_23820":96180,"_2384":41206},[],{"_2857":57892,"_25170":57819,"_17548":96361,"_5":17443,"_23820":96180,"_2384":96362},[],"Clave privada PEM para TLS downstream",{"_2857":57893,"_25170":57819,"_17548":96364,"_5":17443,"_23820":96180,"_2384":41289},[],{"_2857":57894,"_25170":57819,"_17548":96366,"_5":17443,"_23820":96180,"_2384":96367},[],"chart del repositorio",{"_2857":57895,"_25170":57819,"_17548":96369,"_5":17443,"_23820":96180,"_2384":96370},[],"Usa un chart local de Lamassu sin empaquetar",{"_2857":57896,"_25170":57819,"_17548":96372,"_5":17443,"_23820":96180,"_2384":41298},[],{"_2857":57897,"_25170":57819,"_17548":96374,"_5":17443,"_23820":96180,"_2384":96375},[],"detección automática",{"_2857":57898,"_25170":57819,"_17548":96377,"_5":17443,"_23820":96180,"_2384":96378},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_2857":57899,"_25170":57819,"_17548":96380,"_5":17443,"_23820":96180,"_2384":41306},[],{"_2857":57900,"_25170":57819,"_17548":96382,"_5":17443,"_23820":96180,"_2384":5349},[],{"_2857":57901,"_25170":57819,"_17548":96384,"_5":17443,"_23820":96180,"_2384":96385},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_2857":57902,"_25170":57819,"_17548":96387,"_5":17443,"_23820":96180,"_2384":41314},[],{"_2857":57903,"_25170":57819,"_17548":96389,"_5":17443,"_23820":96180,"_2384":5349},[],{"_2857":57904,"_25170":57819,"_17548":96391,"_5":17443,"_23820":96180,"_2384":96392},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_2857":57905,"_25170":57819,"_17548":96394,"_5":17443,"_23820":96180,"_2384":41322},[],{"_2857":57906,"_25170":57819,"_17548":96396,"_5":17443,"_23820":96180,"_2384":5349},[],{"_2857":57907,"_25170":57819,"_17548":96398,"_5":17443,"_23820":96180,"_2384":96399},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_2857":57908,"_25170":57819,"_17548":96401,"_5":17443,"_23820":96180,"_2384":41330},[],{"_2857":57909,"_25170":57819,"_17548":96403,"_5":17443,"_23820":96180,"_2384":41333},[],{"_2857":57910,"_25170":57819,"_17548":96405,"_5":17443,"_23820":96180,"_2384":96406},[],"Usa otro chart local de SoftHSM",{"_2857":57911,"_25170":57819,"_17548":96408,"_5":17443,"_23820":96180,"_2384":96409},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_2857":57912,"_25170":57819,"_17548":96411,"_5":17443,"_23820":96184,"_2384":41342},[],{"_2857":57913,"_25170":57819,"_17548":96413,"_5":17443,"_23820":96184,"_2384":96414},[],"valida las herramientas locales y el clúster seleccionado",{"_2857":57914,"_25170":57819,"_17548":96416,"_5":17443,"_23820":96184,"_2384":96417},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_2857":57915,"_25170":57819,"_17548":96419,"_5":17443,"_23820":96184,"_2384":96420},[],"crea el namespace",{"_2857":57916,"_25170":57819,"_17548":96422,"_5":17443,"_23820":96184,"_2384":96423},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_2857":57917,"_25170":57819,"_17548":96425,"_5":17443,"_23820":96184,"_2384":96426},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_2857":57918,"_25170":57819,"_17548":96428,"_5":17443,"_23820":96184,"_2384":96429},[],"instala RabbitMQ",{"_2857":57919,"_25170":57819,"_17548":96431,"_5":17443,"_23820":96184,"_2384":96432},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_2857":57920,"_25170":57819,"_17548":96434,"_5":17443,"_23820":96184,"_2384":96435},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_2857":57921,"_25170":57819,"_17548":96437,"_5":17443,"_23820":96184,"_2384":96438},[],"carga datos de ejemplo opcionalmente",{"_2857":57922,"_25170":57819,"_17548":96440,"_5":17443,"_23820":96184,"_2384":96441},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_2857":57923,"_25170":57819,"_17548":96443,"_5":17443,"_23820":96188,"_2384":96444},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_2857":57924,"_25170":57819,"_17548":96446,"_5":17443,"_23820":96188,"_2384":96447},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_2857":57925,"_25170":57819,"_17548":96449,"_5":17443,"_23820":96192,"_2384":96450},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso.",{"_2857":57926,"_25170":57819,"_17548":96452,"_5":17443,"_23820":96192,"_2384":96453},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_2857":57927,"_25170":57819,"_17548":96455,"_5":17443,"_23820":96192,"_2384":96456},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_2857":57928,"_25170":57819,"_17548":96458,"_5":17443,"_23820":96196,"_2384":96459},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_2857":57929,"_25170":57929,"_5":12294,"_2384":96461,"_25485":96462,"_17548":96463,"_23820":57929},"Instala con Helm",[40817,95919,96153],[],{"_2857":57930,"_25170":57929,"_17548":96465,"_5":17443,"_23820":57929,"_2384":96466},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_2857":57931,"_25170":57929,"_5":25482,"_17548":96468,"_23820":96469,"_2384":96470},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_2857":57932,"_25170":57929,"_5":25482,"_17548":96472,"_23820":96473,"_2384":96169},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_2857":57933,"_25170":57929,"_5":25482,"_17548":96475,"_23820":96476,"_2384":96477},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_2857":57934,"_25170":57929,"_5":25482,"_17548":96479,"_23820":96480,"_2384":96481},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_2857":57935,"_25170":57929,"_5":25482,"_17548":96483,"_23820":96484,"_2384":96485},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_2857":57936,"_25170":57929,"_5":25482,"_17548":96487,"_23820":96488,"_2384":96489},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_2857":57937,"_25170":57929,"_5":25482,"_17548":96491,"_23820":96492,"_2384":96493},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_2857":57938,"_25170":57929,"_5":25482,"_17548":96495,"_23820":96496,"_2384":96497},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_2857":57939,"_25170":57929,"_5":25482,"_17548":96499,"_23820":96500,"_2384":96501},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_2857":57940,"_25170":57929,"_17548":96503,"_5":17443,"_23820":96469,"_2384":96504},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_2857":57941,"_25170":57929,"_17548":96506,"_5":17443,"_23820":96473,"_2384":96507},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_2857":57942,"_25170":57929,"_17548":96509,"_5":17443,"_23820":96473,"_2384":96510},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_2857":57943,"_25170":57929,"_17548":96512,"_5":17443,"_23820":96473,"_2384":96513},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_2857":57944,"_25170":57929,"_17548":96515,"_5":17443,"_23820":96473,"_2384":96516},[],"un broker RabbitMQ accesible y sus credenciales",{"_2857":57945,"_25170":57929,"_17548":96518,"_5":17443,"_23820":96473,"_2384":96519},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_2857":57946,"_25170":57929,"_17548":96521,"_5":17443,"_23820":96473,"_2384":96522},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_2857":57947,"_25170":57929,"_17548":96524,"_5":17443,"_23820":96473,"_2384":96525},[],"cert-manager 1.14+; para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_2857":57948,"_25170":57929,"_17548":96527,"_5":17443,"_23820":96473,"_2384":96528},[],"una StorageClass y un diseño de tráfico externo",{"_2857":57949,"_25170":57929,"_17548":96530,"_5":17443,"_23820":96473,"_2384":96531},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_2857":57950,"_25170":57929,"_17548":96533,"_5":17443,"_23820":96473,"_2384":96534},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_2857":57951,"_25170":57929,"_17548":96536,"_5":17443,"_23820":96473,"_2384":96537},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_2857":57952,"_25170":57929,"_17548":96539,"_5":17443,"_23820":96476,"_2384":96540},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_2857":57953,"_25170":57929,"_17548":96542,"_5":17443,"_23820":96476,"_2384":96543},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_2857":57954,"_25170":57929,"_17548":96545,"_5":17443,"_23820":96476,"_2384":96546},[],"Instala cert-manager por separado antes de Lamassu. El chart actual renderiza sus recursos de issuer self-signed y certificado CA incluso cuando `tls.type: external` hace que el Gateway use un Secret TLS existente. Seleccionar TLS externo no elimina por tanto el requisito de cert-manager.",{"_2857":57955,"_25170":57929,"_17548":96548,"_5":17443,"_23820":96480,"_2384":96549},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_2857":57956,"_25170":57929,"_17548":96551,"_5":17443,"_23820":96480,"_2384":96552},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_2857":57957,"_25170":57929,"_17548":96554,"_5":17443,"_23820":96480,"_2384":96555},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_2857":57958,"_25170":57929,"_17548":96557,"_5":17443,"_23820":96484,"_2384":96558},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo:",{"_2857":57959,"_25170":57929,"_17548":96560,"_5":17443,"_23820":96488,"_2384":96561},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_2857":57960,"_25170":57929,"_17548":96563,"_5":17443,"_23820":96488,"_2384":96564},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_2857":57961,"_25170":57929,"_17548":96566,"_5":17443,"_23820":96488,"_2384":96567},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_2857":57962,"_25170":57929,"_17548":96569,"_5":17443,"_23820":96488,"_2384":96570},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_2857":57963,"_25170":57929,"_17548":96572,"_5":17443,"_23820":96492,"_2384":96573},[],"Para instalar un checkout local:",{"_2857":57964,"_25170":57929,"_17548":96575,"_5":17443,"_23820":96496,"_2384":96576},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_2857":57965,"_25170":57929,"_17548":96578,"_5":17443,"_23820":96496,"_2384":96579},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_2857":57966,"_25170":57929,"_17548":96581,"_5":17443,"_23820":96500,"_2384":96582},[],"Antes de pasar a producción, revisa:",{"_2857":57967,"_25170":57929,"_17548":96584,"_5":17443,"_23820":96500,"_2384":96585},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_2857":57968,"_25170":57929,"_17548":96587,"_5":17443,"_23820":96500,"_2384":96588},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_2857":57969,"_25170":57929,"_17548":96590,"_5":17443,"_23820":96500,"_2384":96591},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_2857":57970,"_25170":57929,"_17548":96593,"_5":17443,"_23820":96500,"_2384":96594},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_2857":57971,"_25170":57929,"_17548":96596,"_5":17443,"_23820":96500,"_2384":96597},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_2857":57972,"_25170":57929,"_17548":96599,"_5":17443,"_23820":96500,"_2384":96600},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_2857":57973,"_25170":57929,"_17548":96602,"_5":17443,"_23820":96500,"_2384":96603},[],"SMTP, observabilidad y entrega de alertas",{"_2857":57974,"_25170":57929,"_17548":96605,"_5":17443,"_23820":96500,"_2384":96606},[],"las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_2857":57975,"_25170":57929,"_17548":96608,"_5":17443,"_23820":96500,"_2384":96609},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_2857":57976,"_25170":57976,"_5":12294,"_2384":96611,"_25485":96612,"_17548":96613,"_23820":57976},"Expón el Gateway",[40817,95919,96153],[],{"_2857":57977,"_25170":57976,"_17548":96615,"_5":17443,"_23820":57976,"_2384":96616},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_2857":57978,"_25170":57976,"_5":25482,"_17548":96618,"_23820":96619,"_2384":96620},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_2857":57979,"_25170":57976,"_5":25482,"_17548":96622,"_23820":96623,"_2384":96624},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_2857":57980,"_25170":57976,"_5":25482,"_17548":96626,"_23820":96627,"_2384":96628},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_2857":57981,"_25170":57976,"_5":25482,"_17548":96630,"_23820":96631,"_2384":41563},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_2857":57982,"_25170":57976,"_5":25482,"_17548":96633,"_23820":96634,"_2384":96635},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_2857":57983,"_25170":57976,"_5":25482,"_17548":96637,"_23820":96638,"_2384":96639},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_2857":57984,"_25170":57976,"_5":25482,"_17548":96641,"_23820":96642,"_2384":96643},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_2857":57985,"_25170":57976,"_5":25482,"_17548":96645,"_23820":96646,"_2384":96647},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_2857":57986,"_25170":57976,"_5":25482,"_17548":96649,"_23820":96650,"_2384":96651},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_2857":57987,"_25170":57976,"_17548":96653,"_5":17443,"_23820":96619,"_2384":96654},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_2857":57988,"_25170":57976,"_17548":96656,"_5":17443,"_23820":96619,"_2384":96657},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_2857":57989,"_25170":57976,"_17548":96659,"_5":17443,"_23820":96623,"_2384":96660},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_2857":57990,"_25170":57976,"_17548":96662,"_5":17443,"_23820":96623,"_2384":96663},[],"Defínelo únicamente cuando:",{"_2857":57991,"_25170":57976,"_17548":96665,"_5":17443,"_23820":96623,"_2384":96666},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_2857":57992,"_25170":57976,"_17548":96668,"_5":17443,"_23820":96623,"_2384":96669},[],"esa dirección está asignada a este Gateway",{"_2857":57993,"_25170":57976,"_17548":96671,"_5":17443,"_23820":96623,"_2384":96672},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_2857":57994,"_25170":57976,"_17548":96674,"_5":17443,"_23820":96623,"_2384":96675},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_2857":57995,"_25170":57976,"_17548":96677,"_5":17443,"_23820":96623,"_2384":96678},[],"No confundas estos valores:",{"_2857":57996,"_25170":57976,"_17548":96680,"_5":17443,"_23820":96623,"_2384":96681},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_2857":57997,"_25170":57976,"_17548":96683,"_5":17443,"_23820":96623,"_2384":96684},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_2857":57998,"_25170":57976,"_17548":96686,"_5":17443,"_23820":96623,"_2384":96687},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_2857":57999,"_25170":57976,"_17548":96689,"_5":17443,"_23820":96627,"_2384":96690},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_2857":58000,"_25170":57976,"_17548":96692,"_5":17443,"_23820":96627,"_2384":96693},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_2857":58001,"_25170":57976,"_17548":96695,"_5":17443,"_23820":96631,"_2384":96696},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_2857":58002,"_25170":57976,"_17548":96698,"_5":17443,"_23820":96631,"_2384":96699},[],"Para el diseño recomendado:",{"_2857":58003,"_25170":57976,"_17548":96701,"_5":17443,"_23820":96631,"_2384":96702},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_2857":58004,"_25170":57976,"_17548":96704,"_5":17443,"_23820":96631,"_2384":96705},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_2857":58005,"_25170":57976,"_17548":96707,"_5":17443,"_23820":96631,"_2384":96708},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_2857":58006,"_25170":57976,"_17548":96710,"_5":17443,"_23820":96631,"_2384":96711},[],"Apunta DNS a la dirección accesible de la VM.",{"_2857":58007,"_25170":57976,"_17548":96713,"_5":17443,"_23820":96631,"_2384":96714},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_2857":58008,"_25170":57976,"_17548":96716,"_5":17443,"_23820":96634,"_2384":96717},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_2857":58009,"_25170":57976,"_17548":96719,"_5":17443,"_23820":96638,"_2384":96720},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_2857":58010,"_25170":57976,"_17548":96722,"_5":17443,"_23820":96638,"_2384":96723},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_2857":58011,"_25170":57976,"_17548":96725,"_5":17443,"_23820":96642,"_2384":96726},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_2857":58012,"_25170":57976,"_17548":96728,"_5":17443,"_23820":96642,"_2384":96729},[],"Requisito",{"_2857":58013,"_25170":57976,"_17548":96731,"_5":17443,"_23820":96642,"_2384":96732},[],"Diseño recomendado",{"_2857":58014,"_25170":57976,"_17548":96734,"_5":17443,"_23820":96642,"_2384":96735},[],"Consecuencia",{"_2857":58015,"_25170":57976,"_17548":96737,"_5":17443,"_23820":96642,"_2384":96738},[],"Varias URL o servicios de Lamassu",{"_2857":58016,"_25170":57976,"_17548":96740,"_5":17443,"_23820":96642,"_2384":96741},[],"Un Gateway con varias rutas",{"_2857":58017,"_25170":57976,"_17548":96743,"_5":17443,"_23820":96642,"_2384":96744},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_2857":58018,"_25170":57976,"_17548":96746,"_5":17443,"_23820":96642,"_2384":96747},[],"Gateways independientes e IP externas distintas",{"_2857":58019,"_25170":57976,"_17548":96749,"_5":17443,"_23820":96642,"_2384":96750},[],"Una VIP por Gateway",{"_2857":58020,"_25170":57976,"_17548":96752,"_5":17443,"_23820":96642,"_2384":96753},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_2857":58021,"_25170":57976,"_17548":96755,"_5":17443,"_23820":96642,"_2384":96756},[],"Gateways independientes, un nodo y una IP",{"_2857":58022,"_25170":57976,"_17548":96758,"_5":17443,"_23820":96642,"_2384":96759},[],"Puertos externos diferentes",{"_2857":58023,"_25170":57976,"_17548":96761,"_5":17443,"_23820":96642,"_2384":96762},[],"Los clientes deben indicar puertos no estándar",{"_2857":58024,"_25170":57976,"_17548":96764,"_5":17443,"_23820":96642,"_2384":96765},[],"Terminación TLS/mTLS separada detrás de una IP",{"_2857":58025,"_25170":57976,"_17548":96767,"_5":17443,"_23820":96642,"_2384":96768},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_2857":58026,"_25170":57976,"_17548":96770,"_5":17443,"_23820":96642,"_2384":96771},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_2857":58027,"_25170":57976,"_17548":96773,"_5":17443,"_23820":96642,"_2384":96774},[],"Recursos Gateway separados pero proxy compartido",{"_2857":58028,"_25170":57976,"_17548":96776,"_5":17443,"_23820":96642,"_2384":96777},[],"Modo merged Gateway de Envoy",{"_2857":58029,"_25170":57976,"_17548":96779,"_5":17443,"_23820":96642,"_2384":96780},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_2857":58030,"_25170":57976,"_17548":96782,"_5":17443,"_23820":96642,"_2384":96783},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_2857":58031,"_25170":57976,"_17548":96785,"_5":17443,"_23820":96642,"_2384":96786},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_2857":58032,"_25170":57976,"_17548":96788,"_5":17443,"_23820":96642,"_2384":96789},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_2857":58033,"_25170":57976,"_17548":96791,"_5":17443,"_23820":96642,"_2384":96792},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_2857":58034,"_25170":57976,"_17548":96794,"_5":17443,"_23820":96646,"_2384":96795},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_2857":58035,"_25170":57976,"_17548":96797,"_5":17443,"_23820":96646,"_2384":96798},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_2857":58036,"_25170":57976,"_17548":96800,"_5":17443,"_23820":96646,"_2384":96801},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_2857":58037,"_25170":57976,"_17548":96803,"_5":17443,"_23820":96646,"_2384":96804},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_2857":58038,"_25170":57976,"_17548":96806,"_5":17443,"_23820":96646,"_2384":96807},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_2857":58039,"_25170":57976,"_17548":96809,"_5":17443,"_23820":96650,"_2384":96810},[],"Comprueba, en orden:",{"_2857":58040,"_25170":57976,"_17548":96812,"_5":17443,"_23820":96650,"_2384":96813},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_2857":58041,"_25170":57976,"_17548":96815,"_5":17443,"_23820":96650,"_2384":96816},[],"Su estado contiene la dirección esperada.",{"_2857":58042,"_25170":57976,"_17548":96818,"_5":17443,"_23820":96650,"_2384":96819},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_2857":58043,"_25170":57976,"_17548":96821,"_5":17443,"_23820":96650,"_2384":96822},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_2857":58044,"_25170":57976,"_17548":96824,"_5":17443,"_23820":96650,"_2384":96825},[],"DNS resuelve al endpoint accesible externamente.",{"_2857":58045,"_25170":57976,"_17548":96827,"_5":17443,"_23820":96650,"_2384":96828},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_2857":58046,"_25170":57976,"_17548":96830,"_5":17443,"_23820":96650,"_2384":96831},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_2857":58047,"_25170":58047,"_5":12294,"_2384":40924,"_25485":96833,"_17548":96834,"_23820":58047},[40817,95919,96153],[],{"_2857":58048,"_25170":58047,"_17548":96836,"_5":17443,"_23820":58047,"_2384":96837},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_2857":58049,"_25170":58047,"_5":25482,"_17548":96839,"_23820":96840,"_2384":96841},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_2857":58050,"_25170":58047,"_5":25482,"_17548":96843,"_23820":96844,"_2384":96845},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_2857":58051,"_25170":58047,"_5":25482,"_17548":96847,"_23820":96848,"_2384":96849},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_2857":58052,"_25170":58047,"_5":25482,"_17548":96851,"_23820":96852,"_2384":96853},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_2857":58053,"_25170":58047,"_5":25482,"_17548":96855,"_23820":96856,"_2384":96857},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_2857":58054,"_25170":58047,"_5":25482,"_17548":96859,"_23820":96860,"_2384":96861},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_2857":58055,"_25170":58047,"_17548":96863,"_5":17443,"_23820":96840,"_2384":96864},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_2857":58056,"_25170":58047,"_17548":96866,"_5":17443,"_23820":96844,"_2384":96867},[],"Flujo",{"_2857":58057,"_25170":58047,"_17548":96869,"_5":17443,"_23820":96844,"_2384":96870},[],"Úsalo para",{"_2857":58058,"_25170":58047,"_17548":96872,"_5":17443,"_23820":96844,"_2384":96873},[],"Qué instala",{"_2857":58059,"_25170":58047,"_17548":96875,"_5":17443,"_23820":96844,"_2384":41808},[],{"_2857":58060,"_25170":58047,"_17548":96877,"_5":17443,"_23820":96844,"_2384":96878},[],"Producción y entornos controlados",{"_2857":58061,"_25170":58047,"_17548":96880,"_5":17443,"_23820":96844,"_2384":96881},[],"Servicios de Lamassu y recursos de Gateway API",{"_2857":58062,"_25170":58047,"_17548":96883,"_5":17443,"_23820":96844,"_2384":41061},[],{"_2857":58063,"_25170":58047,"_17548":96885,"_5":17443,"_23820":96844,"_2384":96886},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_2857":58064,"_25170":58047,"_17548":96888,"_5":17443,"_23820":96844,"_2384":96889},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_2857":58065,"_25170":58047,"_17548":96891,"_5":17443,"_23820":96848,"_2384":96892},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_2857":58066,"_25170":58047,"_17548":96894,"_5":17443,"_23820":96848,"_2384":96895},[],"Área",{"_2857":58067,"_25170":58047,"_17548":96897,"_5":17443,"_23820":96848,"_2384":96898},[],"El chart de Lamassu proporciona",{"_2857":58068,"_25170":58047,"_17548":96900,"_5":17443,"_23820":96848,"_2384":96901},[],"Tú proporcionas",{"_2857":58069,"_25170":58047,"_17548":96903,"_5":17443,"_23820":96848,"_2384":96904},[],"Aplicaciones Lamassu",{"_2857":58070,"_25170":58047,"_17548":96906,"_5":17443,"_23820":96848,"_2384":96907},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_2857":58071,"_25170":58047,"_17548":96909,"_5":17443,"_23820":96848,"_2384":96910},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_2857":58072,"_25170":58047,"_17548":96912,"_5":17443,"_23820":96848,"_2384":96913},[],"Datos PostgreSQL",{"_2857":58073,"_25170":58047,"_17548":96915,"_5":17443,"_23820":96848,"_2384":96916},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_2857":58074,"_25170":58047,"_17548":96918,"_5":17443,"_23820":96848,"_2384":96919},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_2857":58075,"_25170":58047,"_17548":96921,"_5":17443,"_23820":96848,"_2384":96922},[],"Mensajería",{"_2857":58076,"_25170":58047,"_17548":96924,"_5":17443,"_23820":96848,"_2384":96925},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu",{"_2857":58077,"_25170":58047,"_17548":96927,"_5":17443,"_23820":96848,"_2384":96928},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_2857":58078,"_25170":58047,"_17548":96930,"_5":17443,"_23820":96848,"_2384":96931},[],"Identidad",{"_2857":58079,"_25170":58047,"_17548":96933,"_5":17443,"_23820":96848,"_2384":96934},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_2857":58080,"_25170":58047,"_17548":96936,"_5":17443,"_23820":96848,"_2384":96937},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_2857":58081,"_25170":58047,"_17548":96939,"_5":17443,"_23820":96848,"_2384":96940},[],"Enrutamiento externo",{"_2857":58082,"_25170":58047,"_17548":96942,"_5":17443,"_23820":96848,"_2384":96943},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_2857":58083,"_25170":58047,"_17548":96945,"_5":17443,"_23820":96848,"_2384":96946},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_2857":58084,"_25170":58047,"_17548":96948,"_5":17443,"_23820":96848,"_2384":41882},[],{"_2857":58085,"_25170":58047,"_17548":96950,"_5":17443,"_23820":96848,"_2384":96951},[],"Recursos `Issuer` y `Certificate` CA de cert-manager; un `Certificate` downstream gestionado por el chart o una referencia a tu Secret TLS",{"_2857":58086,"_25170":58047,"_17548":96953,"_5":17443,"_23820":96848,"_2384":96954},[],"cert-manager; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_2857":58087,"_25170":58047,"_17548":96956,"_5":17443,"_23820":96848,"_2384":96957},[],"Datos persistentes de la aplicación",{"_2857":58088,"_25170":58047,"_17548":96959,"_5":17443,"_23820":96848,"_2384":96960},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_2857":58089,"_25170":58047,"_17548":96962,"_5":17443,"_23820":96848,"_2384":96963},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_2857":58090,"_25170":58047,"_17548":96965,"_5":17443,"_23820":96848,"_2384":96966},[],"Integraciones opcionales",{"_2857":58091,"_25170":58047,"_17548":96968,"_5":17443,"_23820":96848,"_2384":96969},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_2857":58092,"_25170":58047,"_17548":96971,"_5":17443,"_23820":96848,"_2384":96972},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_2857":58093,"_25170":58047,"_17548":96974,"_5":17443,"_23820":96848,"_2384":96975},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_2857":58094,"_25170":58047,"_17548":96977,"_5":17443,"_23820":96848,"_2384":96978},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_2857":58095,"_25170":58047,"_17548":96980,"_5":17443,"_23820":96852,"_2384":96981},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_2857":58096,"_25170":58047,"_17548":96983,"_5":17443,"_23820":96852,"_2384":96984},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_2857":58097,"_25170":58047,"_17548":96986,"_5":17443,"_23820":96856,"_2384":96987},[],"Kubernetes 1.24 o posterior",{"_2857":58098,"_25170":58047,"_17548":96989,"_5":17443,"_23820":96856,"_2384":96990},[],"Helm 3.2 o posterior",{"_2857":58099,"_25170":58047,"_17548":96992,"_5":17443,"_23820":96856,"_2384":96993},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_2857":58100,"_25170":58047,"_17548":96995,"_5":17443,"_23820":96856,"_2384":96996},[],"cert-manager 1.14 o posterior; el chart actual renderiza recursos issuer y certificate de cert-manager",{"_2857":58101,"_25170":58047,"_17548":96998,"_5":17443,"_23820":96856,"_2384":96999},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_2857":58102,"_25170":58047,"_17548":97001,"_5":17443,"_23820":96856,"_2384":97002},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_2857":58103,"_25170":58047,"_17548":97004,"_5":17443,"_23820":96856,"_2384":97005},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior.",{"_2857":58104,"_25170":58047,"_17548":97007,"_5":17443,"_23820":96860,"_2384":97008},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2857":58105,"_25170":58047,"_17548":97010,"_5":17443,"_23820":96860,"_2384":97011},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2857":58106,"_25170":58047,"_17548":97013,"_5":17443,"_23820":96860,"_2384":97014},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2857":58107,"_25170":58107,"_5":12294,"_2384":97016,"_25485":97017,"_17548":97019,"_23820":58107},"Resolución de problemas de despliegue",[40817,95919,97018],"Operación",[],{"_2857":58108,"_25170":58107,"_17548":97021,"_5":17443,"_23820":58107,"_2384":97022},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_2857":58109,"_25170":58107,"_5":25482,"_17548":97024,"_23820":97025,"_2384":97026},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_2857":58110,"_25170":58107,"_5":25482,"_17548":97028,"_23820":97029,"_2384":97030},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_2857":58111,"_25170":58107,"_5":25482,"_17548":97032,"_23820":97033,"_2384":97034},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_2857":58112,"_25170":58107,"_5":25482,"_17548":97036,"_23820":97037,"_2384":97038},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_2857":58113,"_25170":58107,"_5":25482,"_17548":97040,"_23820":97041,"_2384":97042},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_2857":58114,"_25170":58107,"_5":25482,"_17548":97044,"_23820":97045,"_2384":97046},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_2857":58115,"_25170":58107,"_5":25482,"_17548":97048,"_23820":97049,"_2384":97050},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_2857":58116,"_25170":58107,"_5":25482,"_17548":97052,"_23820":97053,"_2384":97054},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_2857":58117,"_25170":58107,"_5":25482,"_17548":97056,"_23820":97057,"_2384":97058},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_2857":58118,"_25170":58107,"_5":25482,"_17548":97060,"_23820":97061,"_2384":97062},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_2857":58119,"_25170":58107,"_5":25482,"_17548":97064,"_23820":97065,"_2384":97066},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_2857":58120,"_25170":58107,"_5":25482,"_17548":97068,"_23820":97069,"_2384":97070},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_2857":58121,"_25170":58107,"_17548":97072,"_5":17443,"_23820":58107,"_2384":97073},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_2857":58122,"_25170":58107,"_17548":97075,"_5":17443,"_23820":97029,"_2384":97076},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_2857":58123,"_25170":58107,"_17548":97078,"_5":17443,"_23820":97033,"_2384":97079},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_2857":58124,"_25170":58107,"_17548":97081,"_5":17443,"_23820":97037,"_2384":97082},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_2857":58125,"_25170":58107,"_17548":97084,"_5":17443,"_23820":97041,"_2384":97085},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_2857":58126,"_25170":58107,"_17548":97087,"_5":17443,"_23820":97045,"_2384":97088},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_2857":58127,"_25170":58107,"_17548":97090,"_5":17443,"_23820":97049,"_2384":97091},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_2857":58128,"_25170":58107,"_17548":97093,"_5":17443,"_23820":97049,"_2384":97094},[],"Ejecuta también la prueba de conectividad del chart:",{"_2857":58129,"_25170":58107,"_17548":97096,"_5":17443,"_23820":97049,"_2384":97097},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_2857":58130,"_25170":58107,"_17548":97099,"_5":17443,"_23820":97049,"_2384":97100},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_2857":58131,"_25170":58107,"_17548":97102,"_5":17443,"_23820":97053,"_2384":97103},[],"Si recibes un 401:",{"_2857":58132,"_25170":58107,"_17548":97105,"_5":17443,"_23820":97053,"_2384":97106},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_2857":58133,"_25170":58107,"_17548":97108,"_5":17443,"_23820":97053,"_2384":97109},[],"verifica emisor, audiencia y expiración del token;",{"_2857":58134,"_25170":58107,"_17548":97111,"_5":17443,"_23820":97053,"_2384":97112},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_2857":58135,"_25170":58107,"_17548":97114,"_5":17443,"_23820":97053,"_2384":97115},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_2857":58136,"_25170":58107,"_17548":97117,"_5":17443,"_23820":97053,"_2384":97118},[],"Si el login termina pero las APIs devuelven 403:",{"_2857":58137,"_25170":58107,"_17548":97120,"_5":17443,"_23820":97053,"_2384":97121},[],"inspecciona los claims reales del token;",{"_2857":58138,"_25170":58107,"_17548":97123,"_5":17443,"_23820":97053,"_2384":97124},[],"confirma que coinciden con un principal activo;",{"_2857":58139,"_25170":58107,"_17548":97126,"_5":17443,"_23820":97053,"_2384":97127},[],"revisa las políticas concedidas al principal;",{"_2857":58140,"_25170":58107,"_17548":97129,"_5":17443,"_23820":97053,"_2384":97130},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_2857":58141,"_25170":58107,"_17548":97132,"_5":17443,"_23820":97053,"_2384":97133},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_2857":58142,"_25170":58107,"_17548":97135,"_5":17443,"_23820":97057,"_2384":97136},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_2857":58143,"_25170":58107,"_17548":97138,"_5":17443,"_23820":97057,"_2384":97139},[],"Localiza el pod y Service de authz.",{"_2857":58144,"_25170":58107,"_17548":97141,"_5":17443,"_23820":97057,"_2384":97142},[],"Comprueba /health, logs y conexión a su base de datos.",{"_2857":58145,"_25170":58107,"_17548":97144,"_5":17443,"_23820":97057,"_2384":97145},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_2857":58146,"_25170":58107,"_17548":97147,"_5":17443,"_23820":97057,"_2384":97148},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_2857":58147,"_25170":58107,"_17548":97150,"_5":17443,"_23820":97057,"_2384":97151},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_2857":58148,"_25170":58107,"_17548":97153,"_5":17443,"_23820":97061,"_2384":97154},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_2857":58149,"_25170":58107,"_17548":97156,"_5":17443,"_23820":97061,"_2384":97157},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_2857":58150,"_25170":58107,"_17548":97159,"_5":17443,"_23820":97061,"_2384":97160},[],"volumen persistente sin enlazar;",{"_2857":58151,"_25170":58107,"_17548":97162,"_5":17443,"_23820":97061,"_2384":97163},[],"imagen inaccesible o política de pull incorrecta;",{"_2857":58152,"_25170":58107,"_17548":97165,"_5":17443,"_23820":97061,"_2384":97166},[],"configuración inválida del motor criptográfico;",{"_2857":58153,"_25170":58107,"_17548":97168,"_5":17443,"_23820":97061,"_2384":97169},[],"límites de CPU o memoria demasiado bajos;",{"_2857":58154,"_25170":58107,"_17548":97171,"_5":17443,"_23820":97061,"_2384":97172},[],"migración previa incompleta.",{"_2857":58155,"_25170":58107,"_17548":97174,"_5":17443,"_23820":97061,"_2384":97175},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_2857":58156,"_25170":58107,"_17548":97177,"_5":17443,"_23820":97061,"_2384":97178},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_2857":58157,"_25170":58107,"_17548":97180,"_5":17443,"_23820":97065,"_2384":97181},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_2857":58158,"_25170":58107,"_17548":97183,"_5":17443,"_23820":97065,"_2384":97184},[],"verifica que esté habilitado en el servicio emisor;",{"_2857":58159,"_25170":58107,"_17548":97186,"_5":17443,"_23820":97065,"_2384":97187},[],"comprueba conectividad y credenciales AMQP;",{"_2857":58160,"_25170":58107,"_17548":97189,"_5":17443,"_23820":97065,"_2384":97190},[],"revisa exchange, routing key, colas y consumidores;",{"_2857":58161,"_25170":58107,"_17548":97192,"_5":17443,"_23820":97065,"_2384":97193},[],"inspecciona dead-letter queues;",{"_2857":58162,"_25170":58107,"_17548":97195,"_5":17443,"_23820":97065,"_2384":97196},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_2857":58163,"_25170":58107,"_17548":97198,"_5":17443,"_23820":97065,"_2384":97199},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_2857":58164,"_25170":58107,"_17548":97201,"_5":17443,"_23820":97069,"_2384":97202},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_2857":58165,"_25170":58107,"_17548":97204,"_5":17443,"_23820":97069,"_2384":97205},[],"Antes de cerrar una incidencia, guarda:",{"_2857":58166,"_25170":58107,"_17548":97207,"_5":17443,"_23820":97069,"_2384":97208},[],"causa confirmada;",{"_2857":58167,"_25170":58107,"_17548":97210,"_5":17443,"_23820":97069,"_2384":97211},[],"alcance temporal y recursos afectados;",{"_2857":58168,"_25170":58107,"_17548":97213,"_5":17443,"_23820":97069,"_2384":97214},[],"comandos o consultas utilizados;",{"_2857":58169,"_25170":58107,"_17548":97216,"_5":17443,"_23820":97069,"_2384":97217},[],"cambio aplicado y forma de revertirlo;",{"_2857":58170,"_25170":58107,"_17548":97219,"_5":17443,"_23820":97069,"_2384":97220},[],"validación desde un consumidor;",{"_2857":58171,"_25170":58107,"_17548":97222,"_5":17443,"_23820":97069,"_2384":97223},[],"acción preventiva y propietario.",{"_2857":58172,"_25170":58172,"_5":12294,"_2384":97225,"_25485":97226,"_17548":97229,"_23820":58172},"Control de acceso",[40817,97227,97228],"Plataforma","Administración",[],{"_2857":58173,"_25170":58172,"_17548":97231,"_5":17443,"_23820":58172,"_2384":97232},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_2857":58174,"_25170":58172,"_5":25482,"_17548":97234,"_23820":97235,"_2384":97236},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_2857":58175,"_25170":58172,"_5":25482,"_17548":97238,"_23820":97239,"_2384":97240},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_2857":58176,"_25170":58172,"_5":25482,"_17548":97242,"_23820":97243,"_2384":97244},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_2857":58177,"_25170":58172,"_5":25482,"_17548":97246,"_23820":97247,"_2384":97248},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_2857":58178,"_25170":58172,"_5":25482,"_17548":97250,"_23820":97251,"_2384":97252},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_2857":58179,"_25170":58172,"_5":25482,"_17548":97254,"_23820":97255,"_2384":97256},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_2857":58180,"_25170":58172,"_5":25482,"_17548":97258,"_23820":97259,"_2384":97260},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_2857":58181,"_25170":58172,"_5":25482,"_17548":97262,"_23820":97263,"_2384":97264},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_2857":58182,"_25170":58172,"_5":25482,"_17548":97266,"_23820":97267,"_2384":97268},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_2857":58183,"_25170":58172,"_5":25482,"_17548":97270,"_23820":97271,"_2384":97272},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_2857":58184,"_25170":58172,"_5":25482,"_17548":97274,"_23820":97275,"_2384":97276},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_2857":58185,"_25170":58172,"_5":25482,"_17548":97278,"_23820":97279,"_2384":97280},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_2857":58186,"_25170":58172,"_5":25482,"_17548":97282,"_23820":97283,"_2384":97284},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_2857":58187,"_25170":58172,"_5":25482,"_17548":97286,"_23820":97287,"_2384":97288},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_2857":58188,"_25170":58172,"_5":25482,"_17548":97290,"_23820":97291,"_2384":97292},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_2857":58189,"_25170":58172,"_5":25482,"_17548":97294,"_23820":97295,"_2384":96489},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_2857":58190,"_25170":58172,"_5":25482,"_17548":97297,"_23820":97298,"_2384":97299},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_2857":58191,"_25170":58172,"_5":25482,"_17548":97301,"_23820":97302,"_2384":97303},[],"/docs/es/platform/administration/access-control#configura-las-dos-validaciones-jwt","Configura las dos validaciones JWT",{"_2857":58192,"_25170":58172,"_5":25482,"_17548":97305,"_23820":97306,"_2384":97307},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_2857":58193,"_25170":58172,"_5":25482,"_17548":97309,"_23820":97310,"_2384":97311},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_2857":58194,"_25170":58172,"_5":25482,"_17548":97313,"_23820":97314,"_2384":97315},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_2857":58195,"_25170":58172,"_5":25482,"_17548":97317,"_23820":97318,"_2384":97319},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_2857":58196,"_25170":58172,"_5":25482,"_17548":97321,"_23820":97322,"_2384":97323},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_2857":58197,"_25170":58172,"_5":25482,"_17548":97325,"_23820":97326,"_2384":97327},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_2857":58198,"_25170":58172,"_5":25482,"_17548":97329,"_23820":97330,"_2384":97331},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_2857":58199,"_25170":58172,"_5":25482,"_17548":97333,"_23820":97334,"_2384":97335},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_2857":58200,"_25170":58172,"_5":25482,"_17548":97337,"_23820":97338,"_2384":97339},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_2857":58201,"_25170":58172,"_5":25482,"_17548":97341,"_23820":97342,"_2384":97343},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_2857":58202,"_25170":58172,"_5":25482,"_17548":97345,"_23820":97346,"_2384":97347},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_2857":58203,"_25170":58172,"_5":25482,"_17548":97349,"_23820":97350,"_2384":97351},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_2857":58204,"_25170":58172,"_5":25482,"_17548":97353,"_23820":97354,"_2384":97355},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_2857":58205,"_25170":58172,"_17548":97357,"_5":17443,"_23820":58172,"_2384":97358},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_2857":58206,"_25170":58172,"_17548":97360,"_5":17443,"_23820":58172,"_2384":97361},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_2857":58207,"_25170":58172,"_17548":97363,"_5":17443,"_23820":58172,"_2384":97364},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_2857":58208,"_25170":58172,"_17548":97366,"_5":17443,"_23820":97235,"_2384":97367},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_2857":58209,"_25170":58172,"_17548":97369,"_5":17443,"_23820":97235,"_2384":97370},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_2857":58210,"_25170":58172,"_17548":97372,"_5":17443,"_23820":97235,"_2384":97373},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_2857":58211,"_25170":58172,"_17548":97375,"_5":17443,"_23820":97235,"_2384":97376},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_2857":58212,"_25170":58172,"_17548":97378,"_5":17443,"_23820":97235,"_2384":97379},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_2857":58213,"_25170":58172,"_17548":97381,"_5":17443,"_23820":97235,"_2384":97382},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_2857":58214,"_25170":58172,"_17548":97384,"_5":17443,"_23820":97239,"_2384":97385},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_2857":58215,"_25170":58172,"_17548":97387,"_5":17443,"_23820":97239,"_2384":97388},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_2857":58216,"_25170":58172,"_17548":97390,"_5":17443,"_23820":97243,"_2384":97391},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_2857":58217,"_25170":58172,"_17548":97393,"_5":17443,"_23820":97243,"_2384":97394},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_2857":58218,"_25170":58172,"_17548":97396,"_5":17443,"_23820":97243,"_2384":97397},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_2857":58219,"_25170":58172,"_17548":97399,"_5":17443,"_23820":97243,"_2384":97400},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_2857":58220,"_25170":58172,"_17548":97402,"_5":17443,"_23820":97243,"_2384":97403},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_2857":58221,"_25170":58172,"_17548":97405,"_5":17443,"_23820":97243,"_2384":97406},[],"Carga por separado las políticas concedidas a cada principal.",{"_2857":58222,"_25170":58172,"_17548":97408,"_5":17443,"_23820":97243,"_2384":97409},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_2857":58223,"_25170":58172,"_17548":97411,"_5":17443,"_23820":97243,"_2384":97412},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_2857":58224,"_25170":58172,"_17548":97414,"_5":17443,"_23820":97243,"_2384":97415},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_2857":58225,"_25170":58172,"_17548":97417,"_5":17443,"_23820":97243,"_2384":97418},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_2857":58226,"_25170":58172,"_17548":97420,"_5":17443,"_23820":97243,"_2384":97421},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_2857":58227,"_25170":58172,"_17548":97423,"_5":17443,"_23820":97243,"_2384":97424},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_2857":58228,"_25170":58172,"_17548":97426,"_5":17443,"_23820":97247,"_2384":97427},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_2857":58229,"_25170":58172,"_17548":97429,"_5":17443,"_23820":97247,"_2384":97430},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_2857":58230,"_25170":58172,"_17548":97432,"_5":17443,"_23820":97247,"_2384":97433},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_2857":58231,"_25170":58172,"_17548":97435,"_5":17443,"_23820":97247,"_2384":97436},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_2857":58232,"_25170":58172,"_17548":97438,"_5":17443,"_23820":97247,"_2384":97439},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_2857":58233,"_25170":58172,"_17548":97441,"_5":17443,"_23820":97247,"_2384":97442},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_2857":58234,"_25170":58172,"_17548":97444,"_5":17443,"_23820":97247,"_2384":97445},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_2857":58235,"_25170":58172,"_17548":97447,"_5":17443,"_23820":97247,"_2384":97448},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_2857":58236,"_25170":58172,"_17548":97450,"_5":17443,"_23820":97251,"_2384":97451},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_2857":58237,"_25170":58172,"_17548":97453,"_5":17443,"_23820":97251,"_2384":97454},[],"La decisión se toma con el contexto de la operación de dominio:",{"_2857":58238,"_25170":58172,"_17548":97456,"_5":17443,"_23820":97251,"_2384":97457},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_2857":58239,"_25170":58172,"_17548":97459,"_5":17443,"_23820":97251,"_2384":97460},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_2857":58240,"_25170":58172,"_17548":97462,"_5":17443,"_23820":97251,"_2384":97463},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_2857":58241,"_25170":58172,"_17548":97465,"_5":17443,"_23820":97251,"_2384":97466},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_2857":58242,"_25170":58172,"_17548":97468,"_5":17443,"_23820":97251,"_2384":97469},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_2857":58243,"_25170":58172,"_17548":97471,"_5":17443,"_23820":97251,"_2384":97472},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_2857":58244,"_25170":58172,"_17548":97474,"_5":17443,"_23820":97251,"_2384":97475},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_2857":58245,"_25170":58172,"_17548":97477,"_5":17443,"_23820":97251,"_2384":97478},[],"Las acciones se dividen en dos grupos:",{"_2857":58246,"_25170":58172,"_17548":97480,"_5":17443,"_23820":97251,"_2384":97481},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_2857":58247,"_25170":58172,"_17548":97483,"_5":17443,"_23820":97251,"_2384":97484},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_2857":58248,"_25170":58172,"_17548":97486,"_5":17443,"_23820":97251,"_2384":97487},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_2857":58249,"_25170":58172,"_17548":97489,"_5":17443,"_23820":97255,"_2384":97490},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_2857":58250,"_25170":58172,"_17548":97492,"_5":17443,"_23820":97255,"_2384":97493},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_2857":58251,"_25170":58172,"_17548":97495,"_5":17443,"_23820":97255,"_2384":97496},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_2857":58252,"_25170":58172,"_17548":97498,"_5":17443,"_23820":97259,"_2384":97499},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_2857":58253,"_25170":58172,"_17548":97501,"_5":17443,"_23820":97259,"_2384":97502},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_2857":58254,"_25170":58172,"_17548":97504,"_5":17443,"_23820":97259,"_2384":97505},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_2857":58255,"_25170":58172,"_17548":97507,"_5":17443,"_23820":97259,"_2384":97508},[],"Los operadores implementados son:",{"_2857":58256,"_25170":58172,"_17548":97510,"_5":17443,"_23820":97259,"_2384":97511},[],"`equals`, para igualdad exacta;",{"_2857":58257,"_25170":58172,"_17548":97513,"_5":17443,"_23820":97259,"_2384":97514},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_2857":58258,"_25170":58172,"_17548":97516,"_5":17443,"_23820":97259,"_2384":97517},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_2857":58259,"_25170":58172,"_17548":97519,"_5":17443,"_23820":97259,"_2384":97520},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_2857":58260,"_25170":58172,"_17548":97522,"_5":17443,"_23820":97263,"_2384":97523},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_2857":58261,"_25170":58172,"_17548":97525,"_5":17443,"_23820":97263,"_2384":97526},[],"Los modos disponibles son:",{"_2857":58262,"_25170":58172,"_17548":97528,"_5":17443,"_23820":97263,"_2384":97529},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_2857":58263,"_25170":58172,"_17548":97531,"_5":17443,"_23820":97263,"_2384":97532},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_2857":58264,"_25170":58172,"_17548":97534,"_5":17443,"_23820":97263,"_2384":97535},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_2857":58265,"_25170":58172,"_17548":97537,"_5":17443,"_23820":97263,"_2384":97538},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_2857":58266,"_25170":58172,"_17548":97540,"_5":17443,"_23820":97263,"_2384":97541},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_2857":58267,"_25170":58172,"_17548":97543,"_5":17443,"_23820":97263,"_2384":97544},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_2857":58268,"_25170":58172,"_17548":97546,"_5":17443,"_23820":97267,"_2384":97547},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_2857":58269,"_25170":58172,"_17548":97549,"_5":17443,"_23820":97267,"_2384":97550},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_2857":58270,"_25170":58172,"_17548":97552,"_5":17443,"_23820":97267,"_2384":97553},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_2857":58271,"_25170":58172,"_17548":97555,"_5":17443,"_23820":97267,"_2384":97556},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_2857":58272,"_25170":58172,"_17548":97558,"_5":17443,"_23820":97275,"_2384":97559},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_2857":58273,"_25170":58172,"_17548":97561,"_5":17443,"_23820":97275,"_2384":97562},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_2857":58274,"_25170":58172,"_17548":97564,"_5":17443,"_23820":97279,"_2384":97565},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_2857":58275,"_25170":58172,"_17548":97567,"_5":17443,"_23820":97279,"_2384":97568},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_2857":58276,"_25170":58172,"_17548":97570,"_5":17443,"_23820":97283,"_2384":97571},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_2857":58277,"_25170":58172,"_17548":97573,"_5":17443,"_23820":97283,"_2384":97574},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_2857":58278,"_25170":58172,"_17548":97576,"_5":17443,"_23820":97283,"_2384":97577},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_2857":58279,"_25170":58172,"_17548":97579,"_5":17443,"_23820":97287,"_2384":97580},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_2857":58280,"_25170":58172,"_17548":97582,"_5":17443,"_23820":97287,"_2384":97583},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_2857":58281,"_25170":58172,"_17548":97585,"_5":17443,"_23820":97287,"_2384":97586},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_2857":58282,"_25170":58172,"_17548":97588,"_5":17443,"_23820":97287,"_2384":97589},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_2857":58283,"_25170":58172,"_17548":97591,"_5":17443,"_23820":97287,"_2384":97592},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_2857":58284,"_25170":58172,"_17548":97594,"_5":17443,"_23820":97287,"_2384":97595},[],"Ten en cuenta que:",{"_2857":58285,"_25170":58172,"_17548":97597,"_5":17443,"_23820":97287,"_2384":97598},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_2857":58286,"_25170":58172,"_17548":97600,"_5":17443,"_23820":97287,"_2384":97601},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_2857":58287,"_25170":58172,"_17548":97603,"_5":17443,"_23820":97287,"_2384":97604},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_2857":58288,"_25170":58172,"_17548":97606,"_5":17443,"_23820":97291,"_2384":97607},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_2857":58289,"_25170":58172,"_17548":97609,"_5":17443,"_23820":97291,"_2384":97610},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_2857":58290,"_25170":58172,"_17548":97612,"_5":17443,"_23820":97291,"_2384":97613},[],"acceso completo y de solo lectura a KMS;",{"_2857":58291,"_25170":58172,"_17548":97615,"_5":17443,"_23820":97291,"_2384":97616},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_2857":58292,"_25170":58172,"_17548":97618,"_5":17443,"_23820":97291,"_2384":97619},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_2857":58293,"_25170":58172,"_17548":97621,"_5":17443,"_23820":97291,"_2384":97622},[],"acceso a la interfaz;",{"_2857":58294,"_25170":58172,"_17548":97624,"_5":17443,"_23820":97291,"_2384":97625},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_2857":58295,"_25170":58172,"_17548":97627,"_5":17443,"_23820":97291,"_2384":97628},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_2857":58296,"_25170":58172,"_17548":97630,"_5":17443,"_23820":97291,"_2384":97631},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_2857":58297,"_25170":58172,"_17548":97633,"_5":17443,"_23820":97295,"_2384":97634},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_2857":58298,"_25170":58172,"_17548":97636,"_5":17443,"_23820":97295,"_2384":97637},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_2857":58299,"_25170":58172,"_17548":97639,"_5":17443,"_23820":97295,"_2384":97640},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_2857":58300,"_25170":58172,"_17548":97642,"_5":17443,"_23820":97298,"_2384":97643},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_2857":58301,"_25170":58172,"_17548":97645,"_5":17443,"_23820":97302,"_2384":97646},[],"El Gateway utiliza `auth.authentication.apiGateway.jwks` para autenticar peticiones. `authz` utiliza `services.authz.jwkUrl` para resolver los principales OIDC. Ambos endpoints deben contener las claves del mismo emisor y ser alcanzables desde sus respectivos componentes.",{"_2857":58302,"_25170":58172,"_17548":97648,"_5":17443,"_23820":97306,"_2384":97649},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_2857":58303,"_25170":58172,"_17548":97651,"_5":17443,"_23820":97310,"_2384":97652},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_2857":58304,"_25170":58172,"_17548":97654,"_5":17443,"_23820":97314,"_2384":97655},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_2857":58305,"_25170":58172,"_17548":97657,"_5":17443,"_23820":97318,"_2384":97658},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_2857":58306,"_25170":58172,"_17548":97660,"_5":17443,"_23820":97318,"_2384":97661},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_2857":58307,"_25170":58172,"_17548":97663,"_5":17443,"_23820":97322,"_2384":97664},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_2857":58308,"_25170":58172,"_17548":97666,"_5":17443,"_23820":97322,"_2384":97667},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_2857":58309,"_25170":58172,"_17548":97669,"_5":17443,"_23820":97322,"_2384":97670},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_2857":58310,"_25170":58172,"_17548":97672,"_5":17443,"_23820":97322,"_2384":97673},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_2857":58311,"_25170":58172,"_17548":97675,"_5":17443,"_23820":97322,"_2384":97676},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_2857":58312,"_25170":58172,"_17548":97678,"_5":17443,"_23820":97322,"_2384":97679},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_2857":58313,"_25170":58172,"_17548":97681,"_5":17443,"_23820":97322,"_2384":97682},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_2857":58314,"_25170":58172,"_17548":97684,"_5":17443,"_23820":97322,"_2384":97685},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_2857":58315,"_25170":58172,"_17548":97687,"_5":17443,"_23820":97326,"_2384":97688},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_2857":58316,"_25170":58172,"_17548":97690,"_5":17443,"_23820":97326,"_2384":97691},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_2857":58317,"_25170":58172,"_17548":97693,"_5":17443,"_23820":97326,"_2384":97694},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_2857":58318,"_25170":58172,"_17548":97696,"_5":17443,"_23820":97330,"_2384":97697},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_2857":58319,"_25170":58172,"_17548":97699,"_5":17443,"_23820":97330,"_2384":97700},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_2857":58320,"_25170":58172,"_17548":97702,"_5":17443,"_23820":97330,"_2384":97703},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_2857":58321,"_25170":58172,"_17548":97705,"_5":17443,"_23820":97330,"_2384":97706},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_2857":58322,"_25170":58172,"_17548":97708,"_5":17443,"_23820":97330,"_2384":97709},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_2857":58323,"_25170":58172,"_17548":97711,"_5":17443,"_23820":97330,"_2384":97712},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_2857":58324,"_25170":58172,"_17548":97714,"_5":17443,"_23820":97330,"_2384":97715},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_2857":58325,"_25170":58172,"_17548":97717,"_5":17443,"_23820":97330,"_2384":97718},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_2857":58326,"_25170":58172,"_17548":97720,"_5":17443,"_23820":97338,"_2384":97721},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_2857":58327,"_25170":58172,"_17548":97723,"_5":17443,"_23820":97342,"_2384":97724},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_2857":58328,"_25170":58172,"_17548":97726,"_5":17443,"_23820":97342,"_2384":97727},[],"que exista un principal activo del tipo correcto;",{"_2857":58329,"_25170":58172,"_17548":97729,"_5":17443,"_23820":97342,"_2384":97730},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_2857":58330,"_25170":58172,"_17548":97732,"_5":17443,"_23820":97342,"_2384":97733},[],"que todas las condiciones del principal se cumplan;",{"_2857":58331,"_25170":58172,"_17548":97735,"_5":17443,"_23820":97342,"_2384":97736},[],"que el principal tenga concedida la política esperada;",{"_2857":58332,"_25170":58172,"_17548":97738,"_5":17443,"_23820":97342,"_2384":97739},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_2857":58333,"_25170":58172,"_17548":97741,"_5":17443,"_23820":97342,"_2384":97742},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_2857":58334,"_25170":58172,"_17548":97744,"_5":17443,"_23820":97342,"_2384":97745},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_2857":58335,"_25170":58172,"_17548":97747,"_5":17443,"_23820":97346,"_2384":97748},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_2857":58336,"_25170":58172,"_17548":97750,"_5":17443,"_23820":97350,"_2384":97751},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_2857":58337,"_25170":58172,"_17548":97753,"_5":17443,"_23820":97354,"_2384":97754},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_2857":58338,"_25170":58172,"_17548":97756,"_5":17443,"_23820":97354,"_2384":97757},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_2857":58339,"_25170":58339,"_5":12294,"_2384":97759,"_25485":97760,"_17548":97761,"_23820":58339},"Alertas y suscripciones",[40817,97227,97228],[],{"_2857":58340,"_25170":58339,"_17548":97763,"_5":17443,"_23820":58339,"_2384":97764},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_2857":58341,"_25170":58339,"_5":25482,"_17548":97766,"_23820":97767,"_2384":97768},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_2857":58342,"_25170":58339,"_5":25482,"_17548":97770,"_23820":97771,"_2384":97772},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_2857":58343,"_25170":58339,"_5":25482,"_17548":97774,"_23820":97775,"_2384":97776},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_2857":58344,"_25170":58339,"_5":25482,"_17548":97778,"_23820":97779,"_2384":97780},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_2857":58345,"_25170":58339,"_5":25482,"_17548":97782,"_23820":97783,"_2384":97784},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_2857":58346,"_25170":58339,"_5":25482,"_17548":97786,"_23820":97787,"_2384":97788},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_2857":58347,"_25170":58339,"_5":25482,"_17548":97790,"_23820":97791,"_2384":97792},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_2857":58348,"_25170":58339,"_5":25482,"_17548":97794,"_23820":97795,"_2384":97796},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_2857":58349,"_25170":58339,"_5":25482,"_17548":97798,"_23820":97799,"_2384":97800},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_2857":58350,"_25170":58339,"_5":25482,"_17548":97802,"_23820":97803,"_2384":97804},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_2857":58351,"_25170":58339,"_17548":97806,"_5":17443,"_23820":58339,"_2384":97807},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_2857":58352,"_25170":58339,"_17548":97809,"_5":17443,"_23820":97767,"_2384":97810},[],"Un servicio publica un evento de dominio.",{"_2857":58353,"_25170":58339,"_17548":97812,"_5":17443,"_23820":97767,"_2384":97813},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_2857":58354,"_25170":58339,"_17548":97815,"_5":17443,"_23820":97767,"_2384":97816},[],"El filtro de cada suscripción decide si debe notificarse.",{"_2857":58355,"_25170":58339,"_17548":97818,"_5":17443,"_23820":97767,"_2384":97819},[],"Lamassu entrega el evento al canal configurado.",{"_2857":58356,"_25170":58339,"_17548":97821,"_5":17443,"_23820":97767,"_2384":97822},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_2857":58357,"_25170":58339,"_17548":97824,"_5":17443,"_23820":97771,"_2384":97825},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_2857":58358,"_25170":58339,"_17548":97827,"_5":17443,"_23820":97771,"_2384":97828},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_2857":58359,"_25170":58339,"_17548":97830,"_5":17443,"_23820":97771,"_2384":97831},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_2857":58360,"_25170":58339,"_17548":97833,"_5":17443,"_23820":97771,"_2384":97834},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_2857":58361,"_25170":58339,"_17548":97836,"_5":17443,"_23820":97771,"_2384":97837},[],"`apikey_options` necesita `header` y `key`.",{"_2857":58362,"_25170":58339,"_17548":97839,"_5":17443,"_23820":97771,"_2384":97840},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2857":58363,"_25170":58339,"_17548":97842,"_5":17443,"_23820":97771,"_2384":97843},[],"`mtls_options` necesita el PEM en línea `cert_content` y `key_content`; los valores que referencian archivos del servidor se rechazan.",{"_2857":58364,"_25170":58339,"_17548":97845,"_5":17443,"_23820":97771,"_2384":97846},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_2857":58365,"_25170":58339,"_17548":97848,"_5":17443,"_23820":97779,"_2384":97849},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_2857":58366,"_25170":58339,"_17548":97851,"_5":17443,"_23820":97783,"_2384":97852},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_2857":58367,"_25170":58339,"_17548":97854,"_5":17443,"_23820":97787,"_2384":97855},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_2857":58368,"_25170":58339,"_17548":97857,"_5":17443,"_23820":97787,"_2384":97858},[],"**None** notifica todas las instancias del evento.",{"_2857":58369,"_25170":58339,"_17548":97860,"_5":17443,"_23820":97787,"_2384":97861},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_2857":58370,"_25170":58339,"_17548":97863,"_5":17443,"_23820":97787,"_2384":97864},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_2857":58371,"_25170":58339,"_17548":97866,"_5":17443,"_23820":97787,"_2384":97867},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_2857":58372,"_25170":58339,"_17548":97869,"_5":17443,"_23820":97787,"_2384":97870},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_2857":58373,"_25170":58339,"_17548":97872,"_5":17443,"_23820":97791,"_2384":97873},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_2857":58374,"_25170":58339,"_17548":97875,"_5":17443,"_23820":97795,"_2384":97876},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_2857":58375,"_25170":58339,"_17548":97878,"_5":17443,"_23820":97795,"_2384":97879},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_2857":58376,"_25170":58339,"_17548":97881,"_5":17443,"_23820":97795,"_2384":97882},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_2857":58377,"_25170":58339,"_17548":97884,"_5":17443,"_23820":97795,"_2384":97885},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_2857":58378,"_25170":58339,"_17548":97887,"_5":17443,"_23820":97795,"_2384":97888},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_2857":58379,"_25170":58339,"_17548":97890,"_5":17443,"_23820":97795,"_2384":97891},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_2857":58380,"_25170":58339,"_17548":97893,"_5":17443,"_23820":97795,"_2384":97894},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_2857":58381,"_25170":58339,"_17548":97896,"_5":17443,"_23820":97795,"_2384":97897},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_2857":58382,"_25170":58339,"_17548":97899,"_5":17443,"_23820":97799,"_2384":97900},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_2857":58383,"_25170":58339,"_17548":97902,"_5":17443,"_23820":97803,"_2384":97903},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_2857":58384,"_25170":58339,"_17548":97905,"_5":17443,"_23820":97803,"_2384":97906},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_2857":58385,"_25170":58339,"_17548":97908,"_5":17443,"_23820":97803,"_2384":97909},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_2857":58386,"_25170":58339,"_17548":97911,"_5":17443,"_23820":97803,"_2384":97912},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_2857":58387,"_25170":58339,"_17548":97914,"_5":17443,"_23820":97803,"_2384":97915},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_2857":58388,"_25170":58339,"_17548":97917,"_5":17443,"_23820":97803,"_2384":97918},[],"**Validación:** `va.role.crl.create`.",{"_2857":58389,"_25170":58339,"_17548":97920,"_5":17443,"_23820":97803,"_2384":97921},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_2857":58390,"_25170":58339,"_17548":97923,"_5":17443,"_23820":97803,"_2384":97924},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_2857":58391,"_25170":58391,"_5":12294,"_2384":97926,"_25485":97927,"_17548":97928,"_23820":58391},"Registros de auditoría",[40817,97227,97228],[],{"_2857":58392,"_25170":58391,"_17548":97930,"_5":17443,"_23820":58391,"_2384":97931},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_2857":58393,"_25170":58391,"_5":25482,"_17548":97933,"_23820":97934,"_2384":97935},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_2857":58394,"_25170":58391,"_5":25482,"_17548":97937,"_23820":97938,"_2384":97939},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_2857":58395,"_25170":58391,"_5":25482,"_17548":97941,"_23820":97942,"_2384":97943},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_2857":58396,"_25170":58391,"_5":25482,"_17548":97945,"_23820":97946,"_2384":97947},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_2857":58397,"_25170":58391,"_5":25482,"_17548":97949,"_23820":97950,"_2384":97951},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_2857":58398,"_25170":58391,"_5":25482,"_17548":97953,"_23820":97954,"_2384":97955},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_2857":58399,"_25170":58391,"_5":25482,"_17548":97957,"_23820":97958,"_2384":97959},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_2857":58400,"_25170":58391,"_5":25482,"_17548":97961,"_23820":97962,"_2384":97963},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_2857":58401,"_25170":58391,"_5":25482,"_17548":97965,"_23820":97966,"_2384":97967},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_2857":58402,"_25170":58391,"_5":25482,"_17548":97969,"_23820":97970,"_2384":97971},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_2857":58403,"_25170":58391,"_5":25482,"_17548":97973,"_23820":97974,"_2384":97975},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_2857":58404,"_25170":58391,"_17548":97977,"_5":17443,"_23820":58391,"_2384":97978},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_2857":58405,"_25170":58391,"_17548":97980,"_5":17443,"_23820":97934,"_2384":97981},[],"El cuerpo de auditoría incluye:",{"_2857":58406,"_25170":58391,"_17548":97983,"_5":17443,"_23820":97934,"_2384":97984},[],"input: datos recibidos por la operación;",{"_2857":58407,"_25170":58391,"_17548":97986,"_5":17443,"_23820":97934,"_2384":97987},[],"has\\_error: indica si el servicio devolvió un error;",{"_2857":58408,"_25170":58391,"_17548":97989,"_5":17443,"_23820":97934,"_2384":97990},[],"output: resultado producido o mensaje de error;",{"_2857":58409,"_25170":58391,"_17548":97992,"_5":17443,"_23820":97934,"_2384":97993},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_2857":58410,"_25170":58391,"_17548":97995,"_5":17443,"_23820":97934,"_2384":97996},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_2857":58411,"_25170":58391,"_17548":97998,"_5":17443,"_23820":97934,"_2384":97999},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_2857":58412,"_25170":58391,"_17548":98001,"_5":17443,"_23820":97938,"_2384":98002},[],"El backend aplica auditoría a mutaciones de:",{"_2857":58413,"_25170":58391,"_17548":98004,"_5":17443,"_23820":97938,"_2384":98005},[],"autoridades, certificados y perfiles de emisión;",{"_2857":58414,"_25170":58391,"_17548":98007,"_5":17443,"_23820":97938,"_2384":98008},[],"claves y motores KMS;",{"_2857":58415,"_25170":58391,"_17548":98010,"_5":17443,"_23820":97938,"_2384":98011},[],"dispositivos e identidades;",{"_2857":58416,"_25170":58391,"_17548":98013,"_5":17443,"_23820":97938,"_2384":98014},[],"DMS y operaciones de enrolamiento;",{"_2857":58417,"_25170":58391,"_17548":98016,"_5":17443,"_23820":97938,"_2384":98017},[],"funciones de validación y CRL;",{"_2857":58418,"_25170":58391,"_17548":98019,"_5":17443,"_23820":97938,"_2384":98020},[],"principales, políticas y concesiones de autorización.",{"_2857":58419,"_25170":58391,"_17548":98022,"_5":17443,"_23820":97938,"_2384":98023},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_2857":58420,"_25170":58391,"_17548":98025,"_5":17443,"_23820":97942,"_2384":98026},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_2857":58421,"_25170":58391,"_17548":98028,"_5":17443,"_23820":97942,"_2384":98029},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_2857":58422,"_25170":58391,"_17548":98031,"_5":17443,"_23820":97942,"_2384":98032},[],"Diseña el consumidor para:",{"_2857":58423,"_25170":58391,"_17548":98034,"_5":17443,"_23820":97942,"_2384":98035},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_2857":58424,"_25170":58391,"_17548":98037,"_5":17443,"_23820":97942,"_2384":98038},[],"conservar el CloudEvent completo sin modificar;",{"_2857":58425,"_25170":58391,"_17548":98040,"_5":17443,"_23820":97942,"_2384":98041},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_2857":58426,"_25170":58391,"_17548":98043,"_5":17443,"_23820":97942,"_2384":98044},[],"cifrar en tránsito y en reposo;",{"_2857":58427,"_25170":58391,"_17548":98046,"_5":17443,"_23820":97942,"_2384":98047},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_2857":58428,"_25170":58391,"_17548":98049,"_5":17443,"_23820":97942,"_2384":98050},[],"aplicar una política explícita de retención y legal hold;",{"_2857":58429,"_25170":58391,"_17548":98052,"_5":17443,"_23820":97942,"_2384":98053},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_2857":58430,"_25170":58391,"_17548":98055,"_5":17443,"_23820":97946,"_2384":98056},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_2857":58431,"_25170":58391,"_17548":98058,"_5":17443,"_23820":97946,"_2384":98059},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_2857":58432,"_25170":58391,"_17548":98061,"_5":17443,"_23820":97954,"_2384":98062},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_2857":58433,"_25170":58391,"_17548":98064,"_5":17443,"_23820":97958,"_2384":98065},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_2857":58434,"_25170":58391,"_17548":98067,"_5":17443,"_23820":97962,"_2384":98068},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_2857":58435,"_25170":58391,"_17548":98070,"_5":17443,"_23820":97966,"_2384":98071},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_2857":58436,"_25170":58391,"_17548":98073,"_5":17443,"_23820":97970,"_2384":98074},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_2857":58437,"_25170":58391,"_17548":98076,"_5":17443,"_23820":97974,"_2384":98077},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_2857":58438,"_25170":58391,"_17548":98079,"_5":17443,"_23820":97974,"_2384":98080},[],"aparece un evento de auditoría correcto;",{"_2857":58439,"_25170":58391,"_17548":98082,"_5":17443,"_23820":97974,"_2384":98083},[],"el principal coincide con la identidad utilizada;",{"_2857":58440,"_25170":58391,"_17548":98085,"_5":17443,"_23820":97974,"_2384":98086},[],"el consumidor lo persiste una sola vez;",{"_2857":58441,"_25170":58391,"_17548":98088,"_5":17443,"_23820":97974,"_2384":98089},[],"puede recuperarse por recurso, actor y periodo;",{"_2857":58442,"_25170":58391,"_17548":98091,"_5":17443,"_23820":97974,"_2384":98092},[],"una interrupción del consumidor produce una alerta.",{"_2857":58443,"_25170":58391,"_17548":98094,"_5":17443,"_23820":97974,"_2384":98095},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_2857":58444,"_25170":58444,"_5":12294,"_2384":98097,"_25485":98098,"_17548":98099,"_23820":58444},"Arquitectura de la plataforma",[40817,97227],[],{"_2857":58445,"_25170":58444,"_17548":98101,"_5":17443,"_23820":58444,"_2384":98102},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_2857":58446,"_25170":58444,"_5":25482,"_17548":98104,"_23820":98105,"_2384":98106},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_2857":58447,"_25170":58444,"_5":25482,"_17548":98108,"_23820":98109,"_2384":98110},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_2857":58448,"_25170":58444,"_5":25482,"_17548":98112,"_23820":98113,"_2384":98114},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_2857":58449,"_25170":58444,"_5":25482,"_17548":98116,"_23820":98117,"_2384":98118},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_2857":58450,"_25170":58444,"_5":25482,"_17548":98120,"_23820":98121,"_2384":98122},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_2857":58451,"_25170":58444,"_17548":98124,"_5":17443,"_23820":58444,"_2384":98125},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_2857":58452,"_25170":58444,"_17548":98127,"_5":17443,"_23820":58444,"_2384":98128},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_2857":58453,"_25170":58444,"_17548":98130,"_5":17443,"_23820":98105,"_2384":98131},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_2857":58454,"_25170":58444,"_17548":98133,"_5":17443,"_23820":98109,"_2384":98134},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_2857":58455,"_25170":58444,"_17548":98136,"_5":17443,"_23820":98113,"_2384":98137},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_2857":58456,"_25170":58444,"_17548":98139,"_5":17443,"_23820":98117,"_2384":98140},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_2857":58457,"_25170":58444,"_17548":98142,"_5":17443,"_23820":98121,"_2384":98143},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_2857":58458,"_25170":58458,"_5":12294,"_2384":98145,"_25485":98146,"_17548":98147,"_23820":58458},"Cómo funciona Lamassu",[40817,97227],[],{"_2857":58459,"_25170":58458,"_17548":98149,"_5":17443,"_23820":58458,"_2384":98150},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_2857":58460,"_25170":58458,"_5":25482,"_17548":98152,"_23820":98153,"_2384":98154},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_2857":58461,"_25170":58458,"_5":25482,"_17548":98156,"_23820":98157,"_2384":98158},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_2857":58462,"_25170":58458,"_17548":98160,"_5":17443,"_23820":58458,"_2384":98161},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_2857":58463,"_25170":58458,"_17548":98163,"_5":17443,"_23820":98153,"_2384":98164},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_2857":58464,"_25170":58458,"_17548":98166,"_5":17443,"_23820":98153,"_2384":98167},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_2857":58465,"_25170":58458,"_17548":98169,"_5":17443,"_23820":98153,"_2384":98170},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_2857":58466,"_25170":58458,"_17548":98172,"_5":17443,"_23820":98153,"_2384":98173},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_2857":58467,"_25170":58458,"_17548":98175,"_5":17443,"_23820":98153,"_2384":98176},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_2857":58468,"_25170":58458,"_17548":98178,"_5":17443,"_23820":98157,"_2384":98179},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_2857":58469,"_25170":58458,"_17548":98181,"_5":17443,"_23820":98157,"_2384":98182},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_2857":58470,"_25170":58458,"_17548":98184,"_5":17443,"_23820":98157,"_2384":98185},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_2857":58471,"_25170":58458,"_17548":98187,"_5":17443,"_23820":98157,"_2384":98188},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_2857":58472,"_25170":58458,"_17548":98190,"_5":17443,"_23820":98157,"_2384":98191},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_2857":58473,"_25170":58458,"_17548":98193,"_5":17443,"_23820":98157,"_2384":98194},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_2857":58474,"_25170":58458,"_17548":98196,"_5":17443,"_23820":98157,"_2384":98197},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2857":58475,"_25170":58475,"_5":12294,"_2384":98199,"_25485":98200,"_17548":98201,"_23820":58475},"Dispositivos e identidades",[40817,97227,43135,98199],[],{"_2857":58476,"_25170":58475,"_17548":98203,"_5":17443,"_23820":58475,"_2384":98204},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_2857":58477,"_25170":58475,"_5":25482,"_17548":98206,"_23820":98207,"_2384":98208},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_2857":58478,"_25170":58475,"_5":25482,"_17548":98210,"_23820":98211,"_2384":98212},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_2857":58479,"_25170":58475,"_5":25482,"_17548":98214,"_23820":98215,"_2384":98216},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_2857":58480,"_25170":58475,"_5":25482,"_17548":98218,"_23820":98219,"_2384":98220},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_2857":58481,"_25170":58475,"_5":25482,"_17548":98222,"_23820":98223,"_2384":98224},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_2857":58482,"_25170":58475,"_5":25482,"_17548":98226,"_23820":98227,"_2384":98228},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_2857":58483,"_25170":58475,"_5":25482,"_17548":98230,"_23820":98231,"_2384":98232},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_2857":58484,"_25170":58475,"_5":25482,"_17548":98234,"_23820":98235,"_2384":98236},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_2857":58485,"_25170":58475,"_5":25482,"_17548":98238,"_23820":98239,"_2384":98240},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_2857":58486,"_25170":58475,"_5":25482,"_17548":98242,"_23820":98243,"_2384":98244},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_2857":58487,"_25170":58475,"_5":25482,"_17548":98246,"_23820":98247,"_2384":98248},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_2857":58488,"_25170":58475,"_17548":98250,"_5":17443,"_23820":58475,"_2384":98251},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_2857":58489,"_25170":58475,"_17548":98253,"_5":17443,"_23820":58475,"_2384":98254},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_2857":58490,"_25170":58475,"_17548":98256,"_5":17443,"_23820":98207,"_2384":98257},[],"Vista operativa",{"_2857":58491,"_25170":58475,"_17548":98259,"_5":17443,"_23820":98207,"_2384":98260},[],"Interpretación",{"_2857":58492,"_25170":58475,"_17548":98262,"_5":17443,"_23820":98207,"_2384":43198},[],{"_2857":58493,"_25170":58475,"_17548":98264,"_5":17443,"_23820":98207,"_2384":98265},[],"Hay registro, pero todavía no hay identidad asociada.",{"_2857":58494,"_25170":58475,"_17548":98267,"_5":17443,"_23820":98207,"_2384":43204},[],{"_2857":58495,"_25170":58475,"_17548":98269,"_5":17443,"_23820":98207,"_2384":98270},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_2857":58496,"_25170":58475,"_17548":98272,"_5":17443,"_23820":98207,"_2384":43210},[],{"_2857":58497,"_25170":58475,"_17548":98274,"_5":17443,"_23820":98207,"_2384":98275},[],"La identidad está en la ventana operativa de renovación.",{"_2857":58498,"_25170":58475,"_17548":98277,"_5":17443,"_23820":98207,"_2384":43216},[],{"_2857":58499,"_25170":58475,"_17548":98279,"_5":17443,"_23820":98207,"_2384":98280},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_2857":58500,"_25170":58475,"_17548":98282,"_5":17443,"_23820":98207,"_2384":43222},[],{"_2857":58501,"_25170":58475,"_17548":98284,"_5":17443,"_23820":98207,"_2384":98285},[],"La identidad ha vencido.",{"_2857":58502,"_25170":58475,"_17548":98287,"_5":17443,"_23820":98207,"_2384":43228},[],{"_2857":58503,"_25170":58475,"_17548":98289,"_5":17443,"_23820":98207,"_2384":98290},[],"La identidad está marcada como revocada.",{"_2857":58504,"_25170":58475,"_17548":98292,"_5":17443,"_23820":98207,"_2384":43234},[],{"_2857":58505,"_25170":58475,"_17548":98294,"_5":17443,"_23820":98207,"_2384":98295},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_2857":58506,"_25170":58475,"_17548":98297,"_5":17443,"_23820":98207,"_2384":98298},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_2857":58507,"_25170":58475,"_17548":98300,"_5":17443,"_23820":98211,"_2384":98301},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_2857":58508,"_25170":58475,"_17548":98303,"_5":17443,"_23820":98211,"_2384":98304},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_2857":58509,"_25170":58475,"_17548":98306,"_5":17443,"_23820":98211,"_2384":98307},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_2857":58510,"_25170":58475,"_17548":98309,"_5":17443,"_23820":98211,"_2384":98310},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_2857":58511,"_25170":58475,"_17548":98312,"_5":17443,"_23820":98215,"_2384":98313},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_2857":58512,"_25170":58475,"_17548":98315,"_5":17443,"_23820":98219,"_2384":98316},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_2857":58513,"_25170":58475,"_17548":98318,"_5":17443,"_23820":98223,"_2384":98319},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_2857":58514,"_25170":58475,"_17548":98321,"_5":17443,"_23820":98227,"_2384":98322},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_2857":58515,"_25170":58475,"_17548":98324,"_5":17443,"_23820":98231,"_2384":98325},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_2857":58516,"_25170":58475,"_17548":98327,"_5":17443,"_23820":98231,"_2384":98328},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_2857":58517,"_25170":58475,"_17548":98330,"_5":17443,"_23820":98235,"_2384":98331},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_2857":58518,"_25170":58475,"_17548":98333,"_5":17443,"_23820":98235,"_2384":98334},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_2857":58519,"_25170":58475,"_17548":98336,"_5":17443,"_23820":98235,"_2384":98337},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_2857":58520,"_25170":58475,"_17548":98339,"_5":17443,"_23820":98235,"_2384":98340},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_2857":58521,"_25170":58475,"_17548":98342,"_5":17443,"_23820":98235,"_2384":98343},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_2857":58522,"_25170":58475,"_17548":98345,"_5":17443,"_23820":98235,"_2384":98346},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_2857":58523,"_25170":58475,"_17548":98348,"_5":17443,"_23820":98239,"_2384":98349},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_2857":58524,"_25170":58475,"_17548":98351,"_5":17443,"_23820":98239,"_2384":98352},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_2857":58525,"_25170":58475,"_17548":98354,"_5":17443,"_23820":98243,"_2384":98355},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_2857":58526,"_25170":58475,"_17548":98357,"_5":17443,"_23820":98243,"_2384":98358},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_2857":58527,"_25170":58475,"_17548":98360,"_5":17443,"_23820":98243,"_2384":98361},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_2857":58528,"_25170":58475,"_17548":98363,"_5":17443,"_23820":98243,"_2384":98364},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_2857":58529,"_25170":58475,"_17548":98366,"_5":17443,"_23820":98247,"_2384":98367},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":58530,"_25170":58475,"_17548":98369,"_5":17443,"_23820":98247,"_2384":98370},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":58531,"_25170":58531,"_5":12294,"_2384":98372,"_25485":98373,"_17548":98375,"_23820":58531},"Identidad inicial y autenticación",[40817,97227,43135,98199,98374],"Enrolamiento con PKI",[],{"_2857":58532,"_25170":58531,"_17548":98377,"_5":17443,"_23820":58531,"_2384":98378},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_2857":58533,"_25170":58531,"_5":25482,"_17548":98380,"_23820":98381,"_2384":98382},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_2857":58534,"_25170":58531,"_5":25482,"_17548":98384,"_23820":98385,"_2384":98386},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_2857":58535,"_25170":58531,"_5":25482,"_17548":98388,"_23820":98389,"_2384":98390},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_2857":58536,"_25170":58531,"_5":25482,"_17548":98392,"_23820":98393,"_2384":98394},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_2857":58537,"_25170":58531,"_5":25482,"_17548":98396,"_23820":98397,"_2384":98398},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_2857":58538,"_25170":58531,"_17548":98400,"_5":17443,"_23820":58531,"_2384":98401},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_2857":58539,"_25170":58531,"_17548":98403,"_5":17443,"_23820":98381,"_2384":98404},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_2857":58540,"_25170":58531,"_17548":98406,"_5":17443,"_23820":98381,"_2384":98407},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_2857":58541,"_25170":58531,"_17548":98409,"_5":17443,"_23820":98385,"_2384":98410},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_2857":58542,"_25170":58531,"_17548":98412,"_5":17443,"_23820":98385,"_2384":98413},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_2857":58543,"_25170":58531,"_17548":98415,"_5":17443,"_23820":98385,"_2384":98416},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_2857":58544,"_25170":58531,"_17548":98418,"_5":17443,"_23820":98389,"_2384":98419},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_2857":58545,"_25170":58531,"_17548":98421,"_5":17443,"_23820":98389,"_2384":98422},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_2857":58546,"_25170":58531,"_17548":98424,"_5":17443,"_23820":98393,"_2384":98425},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_2857":58547,"_25170":58531,"_17548":98427,"_5":17443,"_23820":98393,"_2384":98428},[],"Ejemplo de cuerpo:",{"_2857":58548,"_25170":58531,"_17548":98430,"_5":17443,"_23820":98393,"_2384":98431},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_2857":58549,"_25170":58531,"_17548":98433,"_5":17443,"_23820":98393,"_2384":98434},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_2857":58550,"_25170":58531,"_17548":98436,"_5":17443,"_23820":98393,"_2384":98437},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_2857":58551,"_25170":58531,"_17548":98439,"_5":17443,"_23820":98393,"_2384":98440},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_2857":58552,"_25170":58531,"_17548":98442,"_5":17443,"_23820":98397,"_2384":98443},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_2857":58553,"_25170":58531,"_17548":98445,"_5":17443,"_23820":98397,"_2384":98446},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_2857":58554,"_25170":58554,"_5":12294,"_2384":98448,"_25485":98449,"_17548":98450,"_23820":58554},"Configura y opera el DMS",[40817,97227,43135,98199,98374],[],{"_2857":58555,"_25170":58554,"_17548":98452,"_5":17443,"_23820":58554,"_2384":98453},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_2857":58556,"_25170":58554,"_5":25482,"_17548":98455,"_23820":98456,"_2384":95928},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_2857":58557,"_25170":58554,"_5":25482,"_17548":98458,"_23820":98459,"_2384":98460},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_2857":58558,"_25170":58554,"_5":25482,"_17548":98462,"_23820":98463,"_2384":98464},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_2857":58559,"_25170":58554,"_5":25482,"_17548":98466,"_23820":98467,"_2384":98468},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_2857":58560,"_25170":58554,"_5":25482,"_17548":98470,"_23820":98471,"_2384":98472},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_2857":58561,"_25170":58554,"_5":25482,"_17548":98474,"_23820":98475,"_2384":98476},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_2857":58562,"_25170":58554,"_5":25482,"_17548":98478,"_23820":98479,"_2384":98480},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_2857":58563,"_25170":58554,"_5":25482,"_17548":98482,"_23820":98483,"_2384":98484},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_2857":58564,"_25170":58554,"_5":25482,"_17548":98486,"_23820":98487,"_2384":43430},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_2857":58565,"_25170":58554,"_5":25482,"_17548":98489,"_23820":98490,"_2384":43434},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_2857":58566,"_25170":58554,"_5":25482,"_17548":98492,"_23820":98493,"_2384":98494},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_2857":58567,"_25170":58554,"_5":25482,"_17548":98496,"_23820":98497,"_2384":98498},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_2857":58568,"_25170":58554,"_5":25482,"_17548":98500,"_23820":98501,"_2384":98502},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_2857":58569,"_25170":58554,"_5":25482,"_17548":98504,"_23820":98505,"_2384":98506},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_2857":58570,"_25170":58554,"_5":25482,"_17548":98508,"_23820":98509,"_2384":43454},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_2857":58571,"_25170":58554,"_5":25482,"_17548":98511,"_23820":98512,"_2384":98513},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_2857":58572,"_25170":58554,"_5":25482,"_17548":98515,"_23820":98516,"_2384":98517},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_2857":58573,"_25170":58554,"_5":25482,"_17548":98519,"_23820":98520,"_2384":98521},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_2857":58574,"_25170":58554,"_17548":98523,"_5":17443,"_23820":58554,"_2384":98524},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_2857":58575,"_25170":58554,"_17548":98526,"_5":17443,"_23820":98456,"_2384":98527},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_2857":58576,"_25170":58554,"_17548":98529,"_5":17443,"_23820":98456,"_2384":98530},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_2857":58577,"_25170":58554,"_17548":98532,"_5":17443,"_23820":98463,"_2384":98533},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_2857":58578,"_25170":58554,"_17548":98535,"_5":17443,"_23820":98467,"_2384":98536},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_2857":58579,"_25170":58554,"_17548":98538,"_5":17443,"_23820":98471,"_2384":98539},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_2857":58580,"_25170":58554,"_17548":98541,"_5":17443,"_23820":98475,"_2384":98542},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_2857":58581,"_25170":58554,"_17548":98544,"_5":17443,"_23820":98479,"_2384":98545},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_2857":58582,"_25170":58554,"_17548":98547,"_5":17443,"_23820":98487,"_2384":98548},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_2857":58583,"_25170":58554,"_17548":98550,"_5":17443,"_23820":98487,"_2384":98551},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_2857":58584,"_25170":58554,"_17548":98553,"_5":17443,"_23820":98490,"_2384":98554},[],"Campo de `settings.enrollment_settings`",{"_2857":58585,"_25170":58554,"_17548":98556,"_5":17443,"_23820":98490,"_2384":98557},[],"Decisión",{"_2857":58586,"_25170":58554,"_17548":98559,"_5":17443,"_23820":98490,"_2384":43505},[],{"_2857":58587,"_25170":58554,"_17548":98561,"_5":17443,"_23820":98490,"_2384":98562},[],"`EST_RFC7030` para estas operaciones.",{"_2857":58588,"_25170":58554,"_17548":98564,"_5":17443,"_23820":98490,"_2384":43511},[],{"_2857":58589,"_25170":58554,"_17548":98566,"_5":17443,"_23820":98490,"_2384":98567},[],"ID de la CA que firmará.",{"_2857":58590,"_25170":58554,"_17548":98569,"_5":17443,"_23820":98490,"_2384":43517},[],{"_2857":58591,"_25170":58554,"_17548":98571,"_5":17443,"_23820":98490,"_2384":98572},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_2857":58592,"_25170":58554,"_17548":98574,"_5":17443,"_23820":98490,"_2384":43523},[],{"_2857":58593,"_25170":58554,"_17548":98576,"_5":17443,"_23820":98490,"_2384":98577},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_2857":58594,"_25170":58554,"_17548":98579,"_5":17443,"_23820":98490,"_2384":43529},[],{"_2857":58595,"_25170":58554,"_17548":98581,"_5":17443,"_23820":98490,"_2384":98582},[],"Uno de los cuatro modos de autenticación.",{"_2857":58596,"_25170":58554,"_17548":98584,"_5":17443,"_23820":98490,"_2384":98585},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_2857":58597,"_25170":58554,"_17548":98587,"_5":17443,"_23820":98493,"_2384":98588},[],"Los bloques son independientes:",{"_2857":58598,"_25170":58554,"_17548":98590,"_5":17443,"_23820":98493,"_2384":98591},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_2857":58599,"_25170":58554,"_17548":98593,"_5":17443,"_23820":98493,"_2384":98594},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_2857":58600,"_25170":58554,"_17548":98596,"_5":17443,"_23820":98493,"_2384":43547},[],{"_2857":58601,"_25170":58554,"_17548":98598,"_5":17443,"_23820":98493,"_2384":98599},[],"Control aplicado en la operación configurada",{"_2857":58602,"_25170":58554,"_17548":98601,"_5":17443,"_23820":98493,"_2384":43553},[],{"_2857":58603,"_25170":58554,"_17548":98603,"_5":17443,"_23820":98493,"_2384":98604},[],"Validación del certificado presentado.",{"_2857":58604,"_25170":58554,"_17548":98606,"_5":17443,"_23820":98493,"_2384":43559},[],{"_2857":58605,"_25170":58554,"_17548":98608,"_5":17443,"_23820":98493,"_2384":98609},[],"Autorización del webhook configurado.",{"_2857":58606,"_25170":58554,"_17548":98611,"_5":17443,"_23820":98493,"_2384":43565},[],{"_2857":58607,"_25170":58554,"_17548":98613,"_5":17443,"_23820":98493,"_2384":98614},[],"Validación del certificado y, después, aprobación del webhook.",{"_2857":58608,"_25170":58554,"_17548":98616,"_5":17443,"_23820":98493,"_2384":43571},[],{"_2857":58609,"_25170":58554,"_17548":98618,"_5":17443,"_23820":98493,"_2384":98619},[],"Sin autenticación del solicitante por el DMS.",{"_2857":58610,"_25170":58554,"_17548":98621,"_5":17443,"_23820":98493,"_2384":98622},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_2857":58611,"_25170":58554,"_17548":98624,"_5":17443,"_23820":98493,"_2384":98625},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_2857":58612,"_25170":58554,"_17548":98627,"_5":17443,"_23820":98493,"_2384":98628},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_2857":58613,"_25170":58554,"_17548":98630,"_5":17443,"_23820":98493,"_2384":98631},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_2857":58614,"_25170":58554,"_17548":98633,"_5":17443,"_23820":98497,"_2384":98634},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_2857":58615,"_25170":58554,"_17548":98636,"_5":17443,"_23820":98497,"_2384":98637},[],"Campo de `external_webhook_settings`",{"_2857":58616,"_25170":58554,"_17548":98639,"_5":17443,"_23820":98497,"_2384":98557},[],{"_2857":58617,"_25170":58554,"_17548":98641,"_5":17443,"_23820":98497,"_2384":43597},[],{"_2857":58618,"_25170":58554,"_17548":98643,"_5":17443,"_23820":98497,"_2384":98644},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_2857":58619,"_25170":58554,"_17548":98646,"_5":17443,"_23820":98497,"_2384":43603},[],{"_2857":58620,"_25170":58554,"_17548":98648,"_5":17443,"_23820":98497,"_2384":98649},[],"`POST` o `PUT`; `POST` por defecto.",{"_2857":58621,"_25170":58554,"_17548":98651,"_5":17443,"_23820":98497,"_2384":43609},[],{"_2857":58622,"_25170":58554,"_17548":98653,"_5":17443,"_23820":98497,"_2384":98654},[],"Etiqueta usada en los logs del servicio.",{"_2857":58623,"_25170":58554,"_17548":98656,"_5":17443,"_23820":98497,"_2384":43615},[],{"_2857":58624,"_25170":58554,"_17548":98658,"_5":17443,"_23820":98497,"_2384":98659},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_2857":58625,"_25170":58554,"_17548":98661,"_5":17443,"_23820":98497,"_2384":43621},[],{"_2857":58626,"_25170":58554,"_17548":98663,"_5":17443,"_23820":98497,"_2384":98664},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_2857":58627,"_25170":58554,"_17548":98666,"_5":17443,"_23820":98497,"_2384":43627},[],{"_2857":58628,"_25170":58554,"_17548":98668,"_5":17443,"_23820":98497,"_2384":98669},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_2857":58629,"_25170":58554,"_17548":98671,"_5":17443,"_23820":98497,"_2384":43633},[],{"_2857":58630,"_25170":58554,"_17548":98673,"_5":17443,"_23820":98497,"_2384":98674},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM en línea.",{"_2857":58631,"_25170":58554,"_17548":98676,"_5":17443,"_23820":98497,"_2384":43639},[],{"_2857":58632,"_25170":58554,"_17548":98678,"_5":17443,"_23820":98497,"_2384":98679},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_2857":58633,"_25170":58554,"_17548":98681,"_5":17443,"_23820":98497,"_2384":43645},[],{"_2857":58634,"_25170":58554,"_17548":98683,"_5":17443,"_23820":98497,"_2384":98684},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_2857":58635,"_25170":58554,"_17548":98686,"_5":17443,"_23820":98497,"_2384":98687},[],"Reglas de esa configuración:",{"_2857":58636,"_25170":58554,"_17548":98689,"_5":17443,"_23820":98497,"_2384":98690},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que entrega el PEM como `mtls_options.cert_content` y `key_content`.",{"_2857":58637,"_25170":58554,"_17548":98692,"_5":17443,"_23820":98497,"_2384":98693},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_2857":58638,"_25170":58554,"_17548":98695,"_5":17443,"_23820":98497,"_2384":98696},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_2857":58639,"_25170":58554,"_17548":98698,"_5":17443,"_23820":98497,"_2384":98699},[],"La API ignora los campos heredados `validate_server_cert`, `apikey`, `oidc` y `mtls`. Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` que aún solo contenga los campos de opción heredados (`apikey`, `oidc`, `mtls`) falla la validación con 400; solo se aceptan cuerpos heredados `noauth`, y sus credenciales se descartan.",{"_2857":58640,"_25170":58554,"_17548":98701,"_5":17443,"_23820":98497,"_2384":98702},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_2857":58641,"_25170":58554,"_17548":98704,"_5":17443,"_23820":98497,"_2384":98705},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_2857":58642,"_25170":58554,"_17548":98707,"_5":17443,"_23820":98497,"_2384":98708},[],"La migración `20260604110000` copia la autenticación inicial al bloque de renovación si este falta y existe la estructura necesaria. No sustituye una configuración ya presente. Después de actualizar, lee ambos bloques; si la consola de tu versión no expone la configuración independiente, utiliza la API DMS.",{"_2857":58643,"_25170":58554,"_17548":98710,"_5":17443,"_23820":98497,"_2384":98711},[],"La migración `20261021120000` reescribe todas las configuraciones de webhook almacenadas con este formato: `validate_server_cert` pasa a ser `insecure_skip_verify` negado (una configuración con `validate_server_cert` a false sigue sin verificar el certificado), `oidc` pasa a ser `jwt_options`, `apikey` pasa a ser `apikey_options` y `mtls` pasa a ser `mtls_options`. Cuando el certificado y la clave heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `key_content` y no requieren ninguna acción. En cualquier otro caso, incluida una configuración mixta (certificado PEM y clave como ruta de fichero), ambos valores pasan a `mtls_options.cert_file` y `key_file`. La entrega rechaza cualquier configuración de webhook que haga referencia a ficheros, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se vuelvan a introducir como contenido PEM, o se eliminen los campos de fichero sobrantes si el webhook no usa mTLS. Si la consola de tu versión no muestra esos campos, edita el DMS mediante la API de DMS.",{"_2857":58644,"_25170":58554,"_17548":98713,"_5":17443,"_23820":98497,"_2384":98714},[],"La migración `20261022120000` traslada `reenrollment_settings.additional_validation_cas` a `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, sustituyendo lo que hubiera en la clave anidada. Ese valor anidado nunca se consultó al validar reenrolamientos, así que el conjunto de confianza efectivo no cambia; una lista plana ausente o nula pasa a ser una lista vacía. Los DMS sin `reenrollment_settings` quedan intactos. Los cuerpos que aún contengan `additional_validation_cas` se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET ya no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con el formato antiguo vacía en silencio la lista migrada.",{"_2857":58645,"_25170":58554,"_17548":98716,"_5":17443,"_23820":98501,"_2384":98717},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_2857":58646,"_25170":58554,"_17548":98719,"_5":17443,"_23820":98505,"_2384":98720},[],"Campo de `settings.reenrollment_settings`",{"_2857":58647,"_25170":58554,"_17548":98722,"_5":17443,"_23820":98505,"_2384":98723},[],"Función",{"_2857":58648,"_25170":58554,"_17548":98725,"_5":17443,"_23820":98505,"_2384":43689},[],{"_2857":58649,"_25170":58554,"_17548":98727,"_5":17443,"_23820":98505,"_2384":98728},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_2857":58650,"_25170":58554,"_17548":98730,"_5":17443,"_23820":98505,"_2384":43695},[],{"_2857":58651,"_25170":58554,"_17548":98732,"_5":17443,"_23820":98505,"_2384":98733},[],"Umbral operativo preventivo de monitorización.",{"_2857":58652,"_25170":58554,"_17548":98735,"_5":17443,"_23820":98505,"_2384":43701},[],{"_2857":58653,"_25170":58554,"_17548":98737,"_5":17443,"_23820":98505,"_2384":98738},[],"Umbral operativo crítico de monitorización.",{"_2857":58654,"_25170":58554,"_17548":98740,"_5":17443,"_23820":98505,"_2384":43707},[],{"_2857":58655,"_25170":58554,"_17548":98742,"_5":17443,"_23820":98505,"_2384":98743},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_2857":58656,"_25170":58554,"_17548":98745,"_5":17443,"_23820":98505,"_2384":43713},[],{"_2857":58657,"_25170":58554,"_17548":98747,"_5":17443,"_23820":98505,"_2384":98748},[],"CAs de validación adicionales para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_2857":58658,"_25170":58554,"_17548":98750,"_5":17443,"_23820":98505,"_2384":43719},[],{"_2857":58659,"_25170":58554,"_17548":98752,"_5":17443,"_23820":98505,"_2384":98753},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_2857":58660,"_25170":58554,"_17548":98755,"_5":17443,"_23820":98505,"_2384":98756},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_2857":58661,"_25170":58554,"_17548":98758,"_5":17443,"_23820":98509,"_2384":98759},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. Algoritmo y tamaño proceden de su campo `key`; el perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_2857":58662,"_25170":58554,"_17548":98761,"_5":17443,"_23820":98512,"_2384":96285},[],{"_2857":58663,"_25170":58554,"_17548":98763,"_5":17443,"_23820":98512,"_2384":98764},[],"Qué publica",{"_2857":58664,"_25170":58554,"_17548":98766,"_5":17443,"_23820":98512,"_2384":43736},[],{"_2857":58665,"_25170":58554,"_17548":98768,"_5":17443,"_23820":98512,"_2384":98769},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_2857":58666,"_25170":58554,"_17548":98771,"_5":17443,"_23820":98512,"_2384":43742},[],{"_2857":58667,"_25170":58554,"_17548":98773,"_5":17443,"_23820":98512,"_2384":98774},[],"Certificado de la CA emisora seleccionada.",{"_2857":58668,"_25170":58554,"_17548":98776,"_5":17443,"_23820":98512,"_2384":43748},[],{"_2857":58669,"_25170":58554,"_17548":98778,"_5":17443,"_23820":98512,"_2384":98779},[],"Certificados de las CAs elegidas explícitamente.",{"_2857":58670,"_25170":58554,"_17548":98781,"_5":17443,"_23820":98512,"_2384":98782},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_2857":58671,"_25170":58554,"_17548":98784,"_5":17443,"_23820":98516,"_2384":98785},[],"**Edit** cambia nombre, ajustes y metadatos. La actualización del backend sustituye esos bloques completos; al usar la API, lee el DMS antes de enviar una edición para no perder campos.",{"_2857":58672,"_25170":58554,"_17548":98787,"_5":17443,"_23820":98516,"_2384":98788},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_2857":58673,"_25170":58554,"_17548":98790,"_5":17443,"_23820":98516,"_2384":98791},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_2857":58674,"_25170":58554,"_17548":98793,"_5":17443,"_23820":98520,"_2384":98794},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_2857":58675,"_25170":58675,"_5":12294,"_2384":98796,"_25485":98797,"_17548":98798,"_23820":58675},"Integra el cliente EST",[40817,97227,43135,98199,98374],[],{"_2857":58676,"_25170":58675,"_17548":98800,"_5":17443,"_23820":58675,"_2384":98801},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_2857":58677,"_25170":58675,"_5":25482,"_17548":98803,"_23820":98804,"_2384":95928},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_2857":58678,"_25170":58675,"_5":25482,"_17548":98806,"_23820":98807,"_2384":98808},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_2857":58679,"_25170":58675,"_5":25482,"_17548":98810,"_23820":98811,"_2384":98812},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_2857":58680,"_25170":58675,"_5":25482,"_17548":98814,"_23820":98815,"_2384":98816},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_2857":58681,"_25170":58675,"_5":25482,"_17548":98818,"_23820":98819,"_2384":98820},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_2857":58682,"_25170":58675,"_5":25482,"_17548":98822,"_23820":98823,"_2384":98824},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_2857":58683,"_25170":58675,"_17548":98826,"_5":17443,"_23820":58675,"_2384":98827},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_2857":58684,"_25170":58675,"_17548":98829,"_5":17443,"_23820":98804,"_2384":98830},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_2857":58685,"_25170":58675,"_17548":98832,"_5":17443,"_23820":98804,"_2384":98833},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_2857":58686,"_25170":58675,"_17548":98835,"_5":17443,"_23820":98804,"_2384":98836},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_2857":58687,"_25170":58675,"_17548":98838,"_5":17443,"_23820":98807,"_2384":98839},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_2857":58688,"_25170":58675,"_17548":98841,"_5":17443,"_23820":98807,"_2384":98842},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_2857":58689,"_25170":58675,"_17548":98844,"_5":17443,"_23820":98811,"_2384":98845},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_2857":58690,"_25170":58675,"_17548":98847,"_5":17443,"_23820":98811,"_2384":98848},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_2857":58691,"_25170":58675,"_17548":98850,"_5":17443,"_23820":98815,"_2384":98851},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_2857":58692,"_25170":58675,"_17548":98853,"_5":17443,"_23820":98815,"_2384":98854},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_2857":58693,"_25170":58675,"_17548":98856,"_5":17443,"_23820":98819,"_2384":98857},[],"Para el caso de una raíz que emite directamente:",{"_2857":58694,"_25170":58675,"_17548":98859,"_5":17443,"_23820":98819,"_2384":98860},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_2857":58695,"_25170":58675,"_17548":98862,"_5":17443,"_23820":98819,"_2384":98863},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_2857":58696,"_25170":58675,"_17548":98865,"_5":17443,"_23820":98823,"_2384":98866},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_2857":58697,"_25170":58697,"_5":12294,"_2384":98868,"_25485":98869,"_17548":98870,"_23820":58697},"Referencia EST",[40817,97227,43135,98199,98374],[],{"_2857":58698,"_25170":58697,"_17548":98872,"_5":17443,"_23820":58697,"_2384":98873},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_2857":58699,"_25170":58697,"_5":25482,"_17548":98875,"_23820":98876,"_2384":98877},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_2857":58700,"_25170":58697,"_5":25482,"_17548":98879,"_23820":98880,"_2384":19066},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2857":58701,"_25170":58697,"_5":25482,"_17548":98882,"_23820":98883,"_2384":21842},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2857":58702,"_25170":58697,"_5":25482,"_17548":98885,"_23820":98886,"_2384":21849},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2857":58703,"_25170":58697,"_5":25482,"_17548":98888,"_23820":98889,"_2384":21219},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2857":58704,"_25170":58697,"_5":25482,"_17548":98891,"_23820":98892,"_2384":98893},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_2857":58705,"_25170":58697,"_5":25482,"_17548":98895,"_23820":98896,"_2384":98897},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_2857":58706,"_25170":58697,"_5":25482,"_17548":98899,"_23820":98900,"_2384":98901},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_2857":58707,"_25170":58697,"_17548":98903,"_5":17443,"_23820":58697,"_2384":98904},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_2857":58708,"_25170":58697,"_17548":98906,"_5":17443,"_23820":98876,"_2384":98907},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_2857":58709,"_25170":58697,"_17548":98909,"_5":17443,"_23820":98876,"_2384":97018},[],{"_2857":58710,"_25170":58697,"_17548":98911,"_5":17443,"_23820":98876,"_2384":98912},[],"Método",{"_2857":58711,"_25170":58697,"_17548":98914,"_5":17443,"_23820":98876,"_2384":98915},[],"Autenticación y condición",{"_2857":58712,"_25170":58697,"_17548":98917,"_5":17443,"_23820":98876,"_2384":43891},[],{"_2857":58713,"_25170":58697,"_17548":98919,"_5":17443,"_23820":98876,"_2384":43894},[],{"_2857":58714,"_25170":58697,"_17548":98921,"_5":17443,"_23820":98876,"_2384":98922},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_2857":58715,"_25170":58697,"_17548":98924,"_5":17443,"_23820":98876,"_2384":43900},[],{"_2857":58716,"_25170":58697,"_17548":98926,"_5":17443,"_23820":98876,"_2384":43903},[],{"_2857":58717,"_25170":58697,"_17548":98928,"_5":17443,"_23820":98876,"_2384":98929},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_2857":58718,"_25170":58697,"_17548":98931,"_5":17443,"_23820":98876,"_2384":43909},[],{"_2857":58719,"_25170":58697,"_17548":98933,"_5":17443,"_23820":98876,"_2384":43903},[],{"_2857":58720,"_25170":58697,"_17548":98935,"_5":17443,"_23820":98876,"_2384":98936},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_2857":58721,"_25170":58697,"_17548":98938,"_5":17443,"_23820":98876,"_2384":43917},[],{"_2857":58722,"_25170":58697,"_17548":98940,"_5":17443,"_23820":98876,"_2384":43903},[],{"_2857":58723,"_25170":58697,"_17548":98942,"_5":17443,"_23820":98876,"_2384":98943},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_2857":58724,"_25170":58697,"_17548":98945,"_5":17443,"_23820":98876,"_2384":98946},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_2857":58725,"_25170":58697,"_17548":98948,"_5":17443,"_23820":98880,"_2384":98949},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_2857":58726,"_25170":58697,"_17548":98951,"_5":17443,"_23820":98880,"_2384":98952},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_2857":58727,"_25170":58697,"_17548":98954,"_5":17443,"_23820":98883,"_2384":98955},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_2857":58728,"_25170":58697,"_17548":98957,"_5":17443,"_23820":98883,"_2384":98958},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_2857":58729,"_25170":58697,"_17548":98960,"_5":17443,"_23820":98886,"_2384":98961},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_2857":58730,"_25170":58697,"_17548":98963,"_5":17443,"_23820":98886,"_2384":98964},[],"La CA de enrolamiento o una CA de validación configurada en el bloque de reenrolamiento valida la credencial en el modo mTLS. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_2857":58731,"_25170":58697,"_17548":98966,"_5":17443,"_23820":98889,"_2384":98967},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_2857":58732,"_25170":58697,"_17548":98969,"_5":17443,"_23820":98889,"_2384":98970},[],"El código admite RSA y ECDSA de 224, 256, 384 o 521 bits. Un tamaño ECDSA no reconocido puede producir fallback a 256; elige explícitamente un tamaño compatible y comprueba la clave resultante. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_2857":58733,"_25170":58697,"_17548":98972,"_5":17443,"_23820":98892,"_2384":98973},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_2857":58734,"_25170":58697,"_17548":98975,"_5":17443,"_23820":98892,"_2384":98976},[],"Parte",{"_2857":58735,"_25170":58697,"_17548":98978,"_5":17443,"_23820":98892,"_2384":98979},[],"Contenido tras decodificar su Base64",{"_2857":58736,"_25170":58697,"_17548":98981,"_5":17443,"_23820":98892,"_2384":43961},[],{"_2857":58737,"_25170":58697,"_17548":98983,"_5":17443,"_23820":98892,"_2384":98984},[],"Clave privada PKCS#8 DER sin cifrar.",{"_2857":58738,"_25170":58697,"_17548":98986,"_5":17443,"_23820":98892,"_2384":43967},[],{"_2857":58739,"_25170":58697,"_17548":98988,"_5":17443,"_23820":98892,"_2384":98989},[],"PKCS#7 DER con el certificado emitido.",{"_2857":58740,"_25170":58697,"_17548":98991,"_5":17443,"_23820":98892,"_2384":98992},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_2857":58741,"_25170":58697,"_17548":98994,"_5":17443,"_23820":98896,"_2384":98995},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_2857":58742,"_25170":58697,"_17548":98997,"_5":17443,"_23820":98896,"_2384":98998},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_2857":58743,"_25170":58697,"_17548":99000,"_5":17443,"_23820":98896,"_2384":99001},[],"Convierte y comprueba el resultado:",{"_2857":58744,"_25170":58697,"_17548":99003,"_5":17443,"_23820":98896,"_2384":99004},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_2857":58745,"_25170":58697,"_17548":99006,"_5":17443,"_23820":98900,"_2384":99007},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_2857":58746,"_25170":58697,"_17548":99009,"_5":17443,"_23820":98900,"_2384":99010},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_2857":58747,"_25170":58747,"_5":12294,"_2384":98374,"_25485":99012,"_17548":99013,"_23820":58747},[40817,97227,43135,98199,98374],[],{"_2857":58748,"_25170":58747,"_17548":99015,"_5":17443,"_23820":58747,"_2384":99016},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_2857":58749,"_25170":58747,"_5":25482,"_17548":99018,"_23820":99019,"_2384":99020},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_2857":58750,"_25170":58747,"_5":25482,"_17548":99022,"_23820":99023,"_2384":99024},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_2857":58751,"_25170":58747,"_5":25482,"_17548":99026,"_23820":99027,"_2384":99028},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_2857":58752,"_25170":58747,"_5":25482,"_17548":99030,"_23820":99031,"_2384":99032},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_2857":58753,"_25170":58747,"_17548":99034,"_5":17443,"_23820":58747,"_2384":99035},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_2857":58754,"_25170":58747,"_17548":99037,"_5":17443,"_23820":99019,"_2384":99038},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_2857":58755,"_25170":58747,"_17548":99040,"_5":17443,"_23820":99019,"_2384":99041},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_2857":58756,"_25170":58747,"_17548":99043,"_5":17443,"_23820":99019,"_2384":99044},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_2857":58757,"_25170":58747,"_17548":99046,"_5":17443,"_23820":99019,"_2384":99047},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_2857":58758,"_25170":58747,"_17548":99049,"_5":17443,"_23820":99019,"_2384":99050},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_2857":58759,"_25170":58747,"_17548":99052,"_5":17443,"_23820":99019,"_2384":99053},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_2857":58760,"_25170":58747,"_17548":99055,"_5":17443,"_23820":99023,"_2384":99056},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2857":58761,"_25170":58747,"_17548":99058,"_5":17443,"_23820":99023,"_2384":99059},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":58762,"_25170":58747,"_17548":99061,"_5":17443,"_23820":99023,"_2384":99062},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2857":58763,"_25170":58747,"_17548":99064,"_5":17443,"_23820":99023,"_2384":99065},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2857":58764,"_25170":58747,"_17548":99067,"_5":17443,"_23820":99027,"_2384":99068},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":58765,"_25170":58747,"_17548":99070,"_5":17443,"_23820":99027,"_2384":99071},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2857":58766,"_25170":58747,"_17548":99073,"_5":17443,"_23820":99027,"_2384":99074},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2857":58767,"_25170":58747,"_17548":99076,"_5":17443,"_23820":99027,"_2384":99077},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2857":58768,"_25170":58747,"_17548":99079,"_5":17443,"_23820":99031,"_2384":99080},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato y migraciones, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_2857":58769,"_25170":58747,"_17548":99082,"_5":17443,"_23820":99031,"_2384":99083},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_2857":58770,"_25170":58770,"_5":12294,"_2384":99085,"_25485":99086,"_17548":99087,"_23820":58770},"Estrategias de aprovisionamiento",[40817,97227,43135,98199,98374],[],{"_2857":58771,"_25170":58770,"_17548":99089,"_5":17443,"_23820":58770,"_2384":99090},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_2857":58772,"_25170":58770,"_5":25482,"_17548":99092,"_23820":99093,"_2384":99094},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_2857":58773,"_25170":58770,"_5":25482,"_17548":99096,"_23820":99097,"_2384":99098},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_2857":58774,"_25170":58770,"_5":25482,"_17548":99100,"_23820":99101,"_2384":99102},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_2857":58775,"_25170":58770,"_5":25482,"_17548":99104,"_23820":99105,"_2384":99106},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_2857":58776,"_25170":58770,"_5":25482,"_17548":99108,"_23820":99109,"_2384":99110},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_2857":58777,"_25170":58770,"_17548":99112,"_5":17443,"_23820":58770,"_2384":99113},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_2857":58778,"_25170":58770,"_17548":99115,"_5":17443,"_23820":99093,"_2384":99116},[],"Recorrido",{"_2857":58779,"_25170":58770,"_17548":99118,"_5":17443,"_23820":99093,"_2384":99119},[],"Cuándo existe el dispositivo",{"_2857":58780,"_25170":58770,"_17548":99121,"_5":17443,"_23820":99093,"_2384":99122},[],"Qué compruebas",{"_2857":58781,"_25170":58770,"_17548":99124,"_5":17443,"_23820":99093,"_2384":99125},[],"Asignación manual",{"_2857":58782,"_25170":58770,"_17548":99127,"_5":17443,"_23820":99093,"_2384":99128},[],"El operador lo crea antes de asociar un certificado.",{"_2857":58783,"_25170":58770,"_17548":99130,"_5":17443,"_23820":99093,"_2384":99131},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_2857":58784,"_25170":58770,"_17548":99133,"_5":17443,"_23820":99093,"_2384":99134},[],"EST con `JITP`",{"_2857":58785,"_25170":58770,"_17548":99136,"_5":17443,"_23820":99093,"_2384":99137},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_2857":58786,"_25170":58770,"_17548":99139,"_5":17443,"_23820":99093,"_2384":99140},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_2857":58787,"_25170":58770,"_17548":99142,"_5":17443,"_23820":99093,"_2384":99143},[],"EST con `PRE_REGISTRATION`",{"_2857":58788,"_25170":58770,"_17548":99145,"_5":17443,"_23820":99093,"_2384":99146},[],"Debe existir antes de `/simpleenroll`.",{"_2857":58789,"_25170":58770,"_17548":99148,"_5":17443,"_23820":99093,"_2384":99149},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_2857":58790,"_25170":58770,"_17548":99151,"_5":17443,"_23820":99093,"_2384":99152},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_2857":58791,"_25170":58770,"_17548":99154,"_5":17443,"_23820":99093,"_2384":99155},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_2857":58792,"_25170":58770,"_17548":99157,"_5":17443,"_23820":99097,"_2384":99158},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_2857":58793,"_25170":58770,"_17548":99160,"_5":17443,"_23820":99097,"_2384":99161},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_2857":58794,"_25170":58770,"_17548":99163,"_5":17443,"_23820":99097,"_2384":99164},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_2857":58795,"_25170":58770,"_17548":99166,"_5":17443,"_23820":99101,"_2384":99167},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_2857":58796,"_25170":58770,"_17548":99169,"_5":17443,"_23820":99101,"_2384":99170},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_2857":58797,"_25170":58770,"_17548":99172,"_5":17443,"_23820":99101,"_2384":99173},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_2857":58798,"_25170":58770,"_17548":99175,"_5":17443,"_23820":99101,"_2384":99176},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_2857":58799,"_25170":58770,"_17548":99178,"_5":17443,"_23820":99101,"_2384":99179},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_2857":58800,"_25170":58770,"_17548":99181,"_5":17443,"_23820":99101,"_2384":99182},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_2857":58801,"_25170":58770,"_17548":99184,"_5":17443,"_23820":99105,"_2384":96285},[],{"_2857":58802,"_25170":58770,"_17548":99186,"_5":17443,"_23820":99105,"_2384":99187},[],"Material que atraviesa EST",{"_2857":58803,"_25170":58770,"_17548":99189,"_5":17443,"_23820":99105,"_2384":99190},[],"Clave generada por el dispositivo",{"_2857":58804,"_25170":58770,"_17548":99192,"_5":17443,"_23820":99105,"_2384":99193},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_2857":58805,"_25170":58770,"_17548":99195,"_5":17443,"_23820":99105,"_2384":99196},[],"Clave ya disponible en el dispositivo",{"_2857":58806,"_25170":58770,"_17548":99198,"_5":17443,"_23820":99105,"_2384":99199},[],"CSR firmada con la clave existente y certificado nuevo.",{"_2857":58807,"_25170":58770,"_17548":99201,"_5":17443,"_23820":99105,"_2384":43454},[],{"_2857":58808,"_25170":58770,"_17548":99203,"_5":17443,"_23820":99105,"_2384":99204},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_2857":58809,"_25170":58770,"_17548":99206,"_5":17443,"_23820":99105,"_2384":99207},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_2857":58810,"_25170":58770,"_17548":99209,"_5":17443,"_23820":99109,"_2384":99210},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_2857":58811,"_25170":58811,"_5":12294,"_2384":99212,"_25485":99213,"_17548":99214,"_23820":58811},"Renovación y recuperación",[40817,97227,43135,98199,98374],[],{"_2857":58812,"_25170":58811,"_17548":99216,"_5":17443,"_23820":58811,"_2384":99217},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_2857":58813,"_25170":58811,"_5":25482,"_17548":99219,"_23820":99220,"_2384":99221},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_2857":58814,"_25170":58811,"_5":25482,"_17548":99223,"_23820":99224,"_2384":99225},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_2857":58815,"_25170":58811,"_5":25482,"_17548":99227,"_23820":99228,"_2384":99229},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_2857":58816,"_25170":58811,"_5":25482,"_17548":99231,"_23820":99232,"_2384":99233},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_2857":58817,"_25170":58811,"_5":25482,"_17548":99235,"_23820":99236,"_2384":99237},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_2857":58818,"_25170":58811,"_17548":99239,"_5":17443,"_23820":58811,"_2384":99240},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_2857":58819,"_25170":58811,"_17548":99242,"_5":17443,"_23820":99220,"_2384":99243},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_2857":58820,"_25170":58811,"_17548":99245,"_5":17443,"_23820":99220,"_2384":99246},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_2857":58821,"_25170":58811,"_17548":99248,"_5":17443,"_23820":99220,"_2384":99249},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_2857":58822,"_25170":58811,"_17548":99251,"_5":17443,"_23820":99220,"_2384":99252},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_2857":58823,"_25170":58811,"_17548":99254,"_5":17443,"_23820":99224,"_2384":99255},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_2857":58824,"_25170":58811,"_17548":99257,"_5":17443,"_23820":99224,"_2384":99258},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_2857":58825,"_25170":58811,"_17548":99260,"_5":17443,"_23820":99228,"_2384":99261},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_2857":58826,"_25170":58811,"_17548":99263,"_5":17443,"_23820":99228,"_2384":99264},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_2857":58827,"_25170":58811,"_17548":99266,"_5":17443,"_23820":99228,"_2384":99267},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_2857":58828,"_25170":58811,"_17548":99269,"_5":17443,"_23820":99232,"_2384":99270},[],"Situación",{"_2857":58829,"_25170":58811,"_17548":99272,"_5":17443,"_23820":99232,"_2384":99273},[],"Procedimiento",{"_2857":58830,"_25170":58811,"_17548":99275,"_5":17443,"_23820":99232,"_2384":99276},[],"Certificado vigente, fuera de ventana",{"_2857":58831,"_25170":58811,"_17548":99278,"_5":17443,"_23820":99232,"_2384":99279},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_2857":58832,"_25170":58811,"_17548":99281,"_5":17443,"_23820":99232,"_2384":99282},[],"Certificado vencido, clave disponible",{"_2857":58833,"_25170":58811,"_17548":99284,"_5":17443,"_23820":99232,"_2384":99285},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_2857":58834,"_25170":58811,"_17548":99287,"_5":17443,"_23820":99232,"_2384":99288},[],"Renovación por webhook o `NO_AUTH`",{"_2857":58835,"_25170":58811,"_17548":99290,"_5":17443,"_23820":99232,"_2384":99291},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_2857":58836,"_25170":58811,"_17548":99293,"_5":17443,"_23820":99232,"_2384":99294},[],"Clave perdida o inaccesible",{"_2857":58837,"_25170":58811,"_17548":99296,"_5":17443,"_23820":99232,"_2384":99297},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_2857":58838,"_25170":58811,"_17548":99299,"_5":17443,"_23820":99232,"_2384":99300},[],"Identidad actual revocada",{"_2857":58839,"_25170":58811,"_17548":99302,"_5":17443,"_23820":99232,"_2384":99303},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_2857":58840,"_25170":58811,"_17548":99305,"_5":17443,"_23820":99232,"_2384":99306},[],"Dispositivo sin identidad",{"_2857":58841,"_25170":58811,"_17548":99308,"_5":17443,"_23820":99232,"_2384":99309},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_2857":58842,"_25170":58811,"_17548":99311,"_5":17443,"_23820":99232,"_2384":99312},[],"Dispositivo retirado",{"_2857":58843,"_25170":58811,"_17548":99314,"_5":17443,"_23820":99232,"_2384":99315},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_2857":58844,"_25170":58811,"_17548":99317,"_5":17443,"_23820":99232,"_2384":99318},[],"Timeout, HTTP 500 o fallo de instalación",{"_2857":58845,"_25170":58811,"_17548":99320,"_5":17443,"_23820":99232,"_2384":99321},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_2857":58846,"_25170":58811,"_17548":99323,"_5":17443,"_23820":99236,"_2384":99324},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_2857":58847,"_25170":58811,"_17548":99326,"_5":17443,"_23820":99236,"_2384":99327},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_2857":58848,"_25170":58848,"_5":12294,"_2384":99329,"_25485":99330,"_17548":99331,"_23820":58848},"Diagnóstico de enrolamiento",[40817,97227,43135,98199,98374],[],{"_2857":58849,"_25170":58848,"_17548":99333,"_5":17443,"_23820":58848,"_2384":99334},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_2857":58850,"_25170":58848,"_5":25482,"_17548":99336,"_23820":99337,"_2384":99338},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_2857":58851,"_25170":58848,"_5":25482,"_17548":99340,"_23820":99341,"_2384":99342},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_2857":58852,"_25170":58848,"_5":25482,"_17548":99344,"_23820":99345,"_2384":98901},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_2857":58853,"_25170":58848,"_5":25482,"_17548":99347,"_23820":99348,"_2384":99349},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_2857":58854,"_25170":58848,"_17548":99351,"_5":17443,"_23820":58848,"_2384":99352},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_2857":58855,"_25170":58848,"_17548":99354,"_5":17443,"_23820":99341,"_2384":99355},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_2857":58856,"_25170":58848,"_17548":99357,"_5":17443,"_23820":99341,"_2384":99358},[],"Síntoma o mensaje",{"_2857":58857,"_25170":58848,"_17548":99360,"_5":17443,"_23820":99341,"_2384":99361},[],"Qué revisar",{"_2857":58858,"_25170":58848,"_17548":99363,"_5":17443,"_23820":99341,"_2384":99364},[],"curl rechaza TLS, nombre o emisor",{"_2857":58859,"_25170":58848,"_17548":99366,"_5":17443,"_23820":99341,"_2384":99367},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_2857":58860,"_25170":58848,"_17548":99369,"_5":17443,"_23820":99341,"_2384":99370},[],"404 o APS ausente",{"_2857":58861,"_25170":58848,"_17548":99372,"_5":17443,"_23820":99341,"_2384":99373},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_2857":58862,"_25170":58848,"_17548":99375,"_5":17443,"_23820":99341,"_2384":99376},[],"400, error de CSR o formato",{"_2857":58863,"_25170":58848,"_17548":99378,"_5":17443,"_23820":99341,"_2384":99379},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_2857":58864,"_25170":58848,"_17548":99381,"_5":17443,"_23820":99341,"_2384":99382},[],"Credencial ausente o certificado no válido",{"_2857":58865,"_25170":58848,"_17548":99384,"_5":17443,"_23820":99341,"_2384":99385},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_2857":58866,"_25170":58848,"_17548":99387,"_5":17443,"_23820":99341,"_2384":99388},[],"Webhook deniega, expira o responde sin autorización",{"_2857":58867,"_25170":58848,"_17548":99390,"_5":17443,"_23820":99341,"_2384":99391},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_2857":58868,"_25170":58848,"_17548":99393,"_5":17443,"_23820":99341,"_2384":44374},[],{"_2857":58869,"_25170":58848,"_17548":99395,"_5":17443,"_23820":99341,"_2384":99396},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_2857":58870,"_25170":58848,"_17548":99398,"_5":17443,"_23820":99341,"_2384":44380},[],{"_2857":58871,"_25170":58848,"_17548":99400,"_5":17443,"_23820":99341,"_2384":99401},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_2857":58872,"_25170":58848,"_17548":99403,"_5":17443,"_23820":99341,"_2384":44386},[],{"_2857":58873,"_25170":58848,"_17548":99405,"_5":17443,"_23820":99341,"_2384":99406},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el PEM como `cert_content` y `key_content`; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la nota de migración en DMS.",{"_2857":58874,"_25170":58848,"_17548":99408,"_5":17443,"_23820":99341,"_2384":99409},[],"400 `struct validation error` al crear o actualizar un DMS",{"_2857":58875,"_25170":58848,"_17548":99411,"_5":17443,"_23820":99341,"_2384":99412},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_2857":58876,"_25170":58848,"_17548":99414,"_5":17443,"_23820":99341,"_2384":99415},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_2857":58877,"_25170":58848,"_17548":99417,"_5":17443,"_23820":99341,"_2384":99418},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_2857":58878,"_25170":58848,"_17548":99420,"_5":17443,"_23820":99341,"_2384":44404},[],{"_2857":58879,"_25170":58848,"_17548":99422,"_5":17443,"_23820":99341,"_2384":99423},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_2857":58880,"_25170":58848,"_17548":99425,"_5":17443,"_23820":99341,"_2384":44410},[],{"_2857":58881,"_25170":58848,"_17548":99427,"_5":17443,"_23820":99341,"_2384":99428},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_2857":58882,"_25170":58848,"_17548":99430,"_5":17443,"_23820":99341,"_2384":99431},[],"DMS propietario distinto",{"_2857":58883,"_25170":58848,"_17548":99433,"_5":17443,"_23820":99341,"_2384":99434},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_2857":58884,"_25170":58848,"_17548":99436,"_5":17443,"_23820":99341,"_2384":44422},[],{"_2857":58885,"_25170":58848,"_17548":99438,"_5":17443,"_23820":99341,"_2384":99439},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_2857":58886,"_25170":58848,"_17548":99441,"_5":17443,"_23820":99341,"_2384":44428},[],{"_2857":58887,"_25170":58848,"_17548":99443,"_5":17443,"_23820":99341,"_2384":99444},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_2857":58888,"_25170":58848,"_17548":99446,"_5":17443,"_23820":99341,"_2384":99447},[],"Certificado actual revocado",{"_2857":58889,"_25170":58848,"_17548":99449,"_5":17443,"_23820":99341,"_2384":99450},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_2857":58890,"_25170":58848,"_17548":99452,"_5":17443,"_23820":99341,"_2384":99453},[],"Error de CA, perfil o firma",{"_2857":58891,"_25170":58848,"_17548":99455,"_5":17443,"_23820":99341,"_2384":99456},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_2857":58892,"_25170":58848,"_17548":99458,"_5":17443,"_23820":99341,"_2384":99459},[],"HTTP 200 sin conexión del dispositivo",{"_2857":58893,"_25170":58848,"_17548":99461,"_5":17443,"_23820":99341,"_2384":99462},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_2857":58894,"_25170":58848,"_17548":99464,"_5":17443,"_23820":99341,"_2384":99465},[],"Timeout o error después de emitir",{"_2857":58895,"_25170":58848,"_17548":99467,"_5":17443,"_23820":99341,"_2384":99468},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_2857":58896,"_25170":58848,"_17548":99470,"_5":17443,"_23820":99345,"_2384":99471},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado tras una migración y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_2857":58897,"_25170":58848,"_17548":99473,"_5":17443,"_23820":99345,"_2384":99474},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_2857":58898,"_25170":58848,"_17548":99476,"_5":17443,"_23820":99348,"_2384":99477},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_2857":58899,"_25170":58848,"_17548":99479,"_5":17443,"_23820":99348,"_2384":99480},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_2857":58900,"_25170":58848,"_17548":99482,"_5":17443,"_23820":99348,"_2384":99483},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_2857":58901,"_25170":58848,"_17548":99485,"_5":17443,"_23820":99348,"_2384":99486},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_2857":58902,"_25170":58848,"_17548":99488,"_5":17443,"_23820":99348,"_2384":99489},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_2857":58903,"_25170":58848,"_17548":99491,"_5":17443,"_23820":99348,"_2384":99492},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_2857":58904,"_25170":58848,"_17548":99494,"_5":17443,"_23820":99348,"_2384":99495},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_2857":58905,"_25170":58905,"_5":12294,"_2384":99497,"_25485":99498,"_17548":99499,"_23820":58905},"Distribución y actualización de confianza",[40817,97227,43135,98199,98374],[],{"_2857":58906,"_25170":58905,"_17548":99501,"_5":17443,"_23820":58905,"_2384":99502},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_2857":58907,"_25170":58905,"_5":25482,"_17548":99504,"_23820":99505,"_2384":99506},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_2857":58908,"_25170":58905,"_5":25482,"_17548":99508,"_23820":99509,"_2384":99510},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_2857":58909,"_25170":58905,"_5":25482,"_17548":99512,"_23820":99513,"_2384":99514},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_2857":58910,"_25170":58905,"_5":25482,"_17548":99516,"_23820":99517,"_2384":99518},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_2857":58911,"_25170":58905,"_5":25482,"_17548":99520,"_23820":99521,"_2384":99522},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_2857":58912,"_25170":58905,"_17548":99524,"_5":17443,"_23820":58905,"_2384":99525},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_2857":58913,"_25170":58905,"_17548":99527,"_5":17443,"_23820":99505,"_2384":99528},[],"Relación",{"_2857":58914,"_25170":58905,"_17548":99530,"_5":17443,"_23820":99505,"_2384":99531},[],"Material que prepara el responsable",{"_2857":58915,"_25170":58905,"_17548":99533,"_5":17443,"_23820":99505,"_2384":99534},[],"Dispositivo → servidor EST",{"_2857":58916,"_25170":58905,"_17548":99536,"_5":17443,"_23820":99505,"_2384":99537},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_2857":58917,"_25170":58905,"_17548":99539,"_5":17443,"_23820":99505,"_2384":99540},[],"DMS → solicitante",{"_2857":58918,"_25170":58905,"_17548":99542,"_5":17443,"_23820":99505,"_2384":99543},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_2857":58919,"_25170":58905,"_17548":99545,"_5":17443,"_23820":99505,"_2384":99546},[],"Consumidor → dispositivo",{"_2857":58920,"_25170":58905,"_17548":99548,"_5":17443,"_23820":99505,"_2384":99549},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_2857":58921,"_25170":58905,"_17548":99551,"_5":17443,"_23820":99505,"_2384":99552},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_2857":58922,"_25170":58905,"_17548":99554,"_5":17443,"_23820":99509,"_2384":99555},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_2857":58923,"_25170":58905,"_17548":99557,"_5":17443,"_23820":99509,"_2384":99558},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_2857":58924,"_25170":58905,"_17548":99560,"_5":17443,"_23820":99513,"_2384":99561},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_2857":58925,"_25170":58905,"_17548":99563,"_5":17443,"_23820":99513,"_2384":99564},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_2857":58926,"_25170":58905,"_17548":99566,"_5":17443,"_23820":99513,"_2384":99567},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_2857":58927,"_25170":58905,"_17548":99569,"_5":17443,"_23820":99513,"_2384":99570},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_2857":58928,"_25170":58905,"_17548":99572,"_5":17443,"_23820":99513,"_2384":99573},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_2857":58929,"_25170":58905,"_17548":99575,"_5":17443,"_23820":99513,"_2384":99576},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_2857":58930,"_25170":58905,"_17548":99578,"_5":17443,"_23820":99517,"_2384":99579},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_2857":58931,"_25170":58905,"_17548":99581,"_5":17443,"_23820":99517,"_2384":99582},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Al cambiar la CA de enrolamiento, añade a esa lista la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento; los valores migrados de `additional_validation_cas` viven ahora ahí. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_2857":58932,"_25170":58905,"_17548":99584,"_5":17443,"_23820":99517,"_2384":99585},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_2857":58933,"_25170":58905,"_17548":99587,"_5":17443,"_23820":99521,"_2384":99588},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_2857":58934,"_25170":58934,"_5":12294,"_2384":44577,"_25485":99590,"_17548":99592,"_23820":58934},[40817,97227,43135,98199,99591],"Integraciones",[],{"_2857":58935,"_25170":58934,"_17548":99594,"_5":17443,"_23820":58934,"_2384":99595},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_2857":58936,"_25170":58934,"_5":25482,"_17548":99597,"_23820":99598,"_2384":99599},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_2857":58937,"_25170":58934,"_5":25482,"_17548":99601,"_23820":99602,"_2384":99603},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_2857":58938,"_25170":58934,"_5":25482,"_17548":99605,"_23820":99606,"_2384":99607},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_2857":58939,"_25170":58934,"_5":25482,"_17548":99609,"_23820":99610,"_2384":99611},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_2857":58940,"_25170":58934,"_5":25482,"_17548":99613,"_23820":99614,"_2384":99615},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_2857":58941,"_25170":58934,"_5":25482,"_17548":99617,"_23820":99618,"_2384":99619},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_2857":58942,"_25170":58934,"_5":25482,"_17548":99621,"_23820":99622,"_2384":44611},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_2857":58943,"_25170":58934,"_5":25482,"_17548":99624,"_23820":99625,"_2384":44615},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_2857":58944,"_25170":58934,"_5":25482,"_17548":99627,"_23820":99628,"_2384":99629},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_2857":58945,"_25170":58934,"_5":25482,"_17548":99631,"_23820":99632,"_2384":99633},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_2857":58946,"_25170":58934,"_5":25482,"_17548":99635,"_23820":99636,"_2384":99637},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_2857":58947,"_25170":58934,"_5":25482,"_17548":99639,"_23820":99640,"_2384":99641},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_2857":58948,"_25170":58934,"_5":25482,"_17548":99643,"_23820":99644,"_2384":99645},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_2857":58949,"_25170":58934,"_5":25482,"_17548":99647,"_23820":99648,"_2384":99649},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_2857":58950,"_25170":58934,"_5":25482,"_17548":99651,"_23820":99652,"_2384":99653},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_2857":58951,"_25170":58934,"_5":25482,"_17548":99655,"_23820":99656,"_2384":99657},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_2857":58952,"_25170":58934,"_5":25482,"_17548":99659,"_23820":99660,"_2384":99661},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_2857":58953,"_25170":58934,"_5":25482,"_17548":99663,"_23820":99664,"_2384":99665},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_2857":58954,"_25170":58934,"_5":25482,"_17548":99667,"_23820":99668,"_2384":99669},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_2857":58955,"_25170":58934,"_5":25482,"_17548":99671,"_23820":99672,"_2384":99673},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_2857":58956,"_25170":58934,"_17548":99675,"_5":17443,"_23820":58934,"_2384":99676},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_2857":58957,"_25170":58934,"_17548":99678,"_5":17443,"_23820":58934,"_2384":99679},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_2857":58958,"_25170":58934,"_17548":99681,"_5":17443,"_23820":58934,"_2384":99682},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_2857":58959,"_25170":58934,"_17548":99684,"_5":17443,"_23820":99598,"_2384":99685},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_2857":58960,"_25170":58934,"_17548":99687,"_5":17443,"_23820":99598,"_2384":99688},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_2857":58961,"_25170":58934,"_17548":99690,"_5":17443,"_23820":99598,"_2384":99691},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_2857":58962,"_25170":58934,"_17548":99693,"_5":17443,"_23820":99598,"_2384":99694},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_2857":58963,"_25170":58934,"_17548":99696,"_5":17443,"_23820":99602,"_2384":99697},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_2857":58964,"_25170":58934,"_17548":99699,"_5":17443,"_23820":99606,"_2384":99700},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_2857":58965,"_25170":58934,"_17548":99702,"_5":17443,"_23820":99606,"_2384":99703},[],"Acción IAM",{"_2857":58966,"_25170":58934,"_17548":99705,"_5":17443,"_23820":99606,"_2384":96291},[],{"_2857":58967,"_25170":58934,"_17548":99707,"_5":17443,"_23820":99606,"_2384":44698},[],{"_2857":58968,"_25170":58934,"_17548":99709,"_5":17443,"_23820":99606,"_2384":99710},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_2857":58969,"_25170":58934,"_17548":99712,"_5":17443,"_23820":99606,"_2384":44704},[],{"_2857":58970,"_25170":58934,"_17548":99714,"_5":17443,"_23820":99606,"_2384":99715},[],"Registrar la CA en AWS IoT",{"_2857":58971,"_25170":58934,"_17548":99717,"_5":17443,"_23820":99606,"_2384":44710},[],{"_2857":58972,"_25170":58934,"_17548":99719,"_5":17443,"_23820":99606,"_2384":99720},[],"Consultar el estado del registro de la CA",{"_2857":58973,"_25170":58934,"_17548":99722,"_5":17443,"_23820":99606,"_2384":44716},[],{"_2857":58974,"_25170":58934,"_17548":99724,"_5":17443,"_23820":99606,"_2384":99725},[],"Crear o actualizar Things en IoT Core",{"_2857":58975,"_25170":58934,"_17548":99727,"_5":17443,"_23820":99606,"_2384":44722},[],{"_2857":58976,"_25170":58934,"_17548":99729,"_5":17443,"_23820":99606,"_2384":99730},[],"Aprovisionar Things mediante plantilla",{"_2857":58977,"_25170":58934,"_17548":99732,"_5":17443,"_23820":99606,"_2384":44728},[],{"_2857":58978,"_25170":58934,"_17548":99734,"_5":17443,"_23820":99606,"_2384":99735},[],"Registrar certificados de dispositivo",{"_2857":58979,"_25170":58934,"_17548":99737,"_5":17443,"_23820":99606,"_2384":44734},[],{"_2857":58980,"_25170":58934,"_17548":99739,"_5":17443,"_23820":99606,"_2384":99740},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_2857":58981,"_25170":58934,"_17548":99742,"_5":17443,"_23820":99606,"_2384":44740},[],{"_2857":58982,"_25170":58934,"_17548":99744,"_5":17443,"_23820":99606,"_2384":99745},[],"Crear y adjuntar políticas IoT",{"_2857":58983,"_25170":58934,"_17548":99747,"_5":17443,"_23820":99606,"_2384":44746},[],{"_2857":58984,"_25170":58934,"_17548":99749,"_5":17443,"_23820":99606,"_2384":99750},[],"Gestionar grupos de Things",{"_2857":58985,"_25170":58934,"_17548":99752,"_5":17443,"_23820":99606,"_2384":44752},[],{"_2857":58986,"_25170":58934,"_17548":99754,"_5":17443,"_23820":99606,"_2384":99755},[],"Crear plantillas JITP",{"_2857":58987,"_25170":58934,"_17548":99757,"_5":17443,"_23820":99606,"_2384":44758},[],{"_2857":58988,"_25170":58934,"_17548":99759,"_5":17443,"_23820":99606,"_2384":99760},[],"Leer y escribir el Device Shadow",{"_2857":58989,"_25170":58934,"_17548":99762,"_5":17443,"_23820":99606,"_2384":99763},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_2857":58990,"_25170":58934,"_17548":99765,"_5":17443,"_23820":99610,"_2384":99766},[],"Parámetro",{"_2857":58991,"_25170":58934,"_17548":99768,"_5":17443,"_23820":99610,"_2384":99769},[],"Tipo",{"_2857":58992,"_25170":58934,"_17548":99771,"_5":17443,"_23820":99610,"_2384":99772},[],"Requerido",{"_2857":58993,"_25170":58934,"_17548":99774,"_5":17443,"_23820":99610,"_2384":99775},[],"Descripción",{"_2857":58994,"_25170":58934,"_17548":99777,"_5":17443,"_23820":99610,"_2384":44779},[],{"_2857":58995,"_25170":58934,"_17548":99779,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":58996,"_25170":58934,"_17548":99781,"_5":17443,"_23820":99610,"_2384":99782},[],"Sí",{"_2857":58997,"_25170":58934,"_17548":99784,"_5":17443,"_23820":99610,"_2384":99785},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_2857":58998,"_25170":58934,"_17548":99787,"_5":17443,"_23820":99610,"_2384":44790},[],{"_2857":58999,"_25170":58934,"_17548":99789,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59000,"_25170":58934,"_17548":99791,"_5":17443,"_23820":99610,"_2384":99782},[],{"_2857":59001,"_25170":58934,"_17548":99793,"_5":17443,"_23820":99610,"_2384":99794},[],"Región AWS donde opera el conector.",{"_2857":59002,"_25170":58934,"_17548":99796,"_5":17443,"_23820":99610,"_2384":44800},[],{"_2857":59003,"_25170":58934,"_17548":99798,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59004,"_25170":58934,"_17548":99800,"_5":17443,"_23820":99610,"_2384":99782},[],{"_2857":59005,"_25170":58934,"_17548":99802,"_5":17443,"_23820":99610,"_2384":99803},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_2857":59006,"_25170":58934,"_17548":99805,"_5":17443,"_23820":99610,"_2384":44810},[],{"_2857":59007,"_25170":58934,"_17548":99807,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59008,"_25170":58934,"_17548":99809,"_5":17443,"_23820":99610,"_2384":99810},[],"Solo con `auth_method=static`",{"_2857":59009,"_25170":58934,"_17548":99812,"_5":17443,"_23820":99610,"_2384":99813},[],"Clave de acceso AWS.",{"_2857":59010,"_25170":58934,"_17548":99815,"_5":17443,"_23820":99610,"_2384":44821},[],{"_2857":59011,"_25170":58934,"_17548":99817,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59012,"_25170":58934,"_17548":99819,"_5":17443,"_23820":99610,"_2384":99810},[],{"_2857":59013,"_25170":58934,"_17548":99821,"_5":17443,"_23820":99610,"_2384":99822},[],"Clave secreta AWS.",{"_2857":59014,"_25170":58934,"_17548":99824,"_5":17443,"_23820":99610,"_2384":44831},[],{"_2857":59015,"_25170":58934,"_17548":99826,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59016,"_25170":58934,"_17548":99828,"_5":17443,"_23820":99610,"_2384":44836},[],{"_2857":59017,"_25170":58934,"_17548":99830,"_5":17443,"_23820":99610,"_2384":99831},[],"Token de sesión (con `auth_method=static`).",{"_2857":59018,"_25170":58934,"_17548":99833,"_5":17443,"_23820":99610,"_2384":44842},[],{"_2857":59019,"_25170":58934,"_17548":99835,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59020,"_25170":58934,"_17548":99837,"_5":17443,"_23820":99610,"_2384":99838},[],"Solo con `auth_method=role`",{"_2857":59021,"_25170":58934,"_17548":99840,"_5":17443,"_23820":99610,"_2384":99841},[],"ARN del rol a asumir.",{"_2857":59022,"_25170":58934,"_17548":99843,"_5":17443,"_23820":99610,"_2384":44853},[],{"_2857":59023,"_25170":58934,"_17548":99845,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59024,"_25170":58934,"_17548":99847,"_5":17443,"_23820":99610,"_2384":44836},[],{"_2857":59025,"_25170":58934,"_17548":99849,"_5":17443,"_23820":99610,"_2384":99850},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_2857":59026,"_25170":58934,"_17548":99852,"_5":17443,"_23820":99610,"_2384":44863},[],{"_2857":59027,"_25170":58934,"_17548":99854,"_5":17443,"_23820":99610,"_2384":14719},[],{"_2857":59028,"_25170":58934,"_17548":99856,"_5":17443,"_23820":99610,"_2384":99782},[],{"_2857":59029,"_25170":58934,"_17548":99858,"_5":17443,"_23820":99610,"_2384":99859},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_2857":59030,"_25170":58934,"_17548":99861,"_5":17443,"_23820":99610,"_2384":44873},[],{"_2857":59031,"_25170":58934,"_17548":99863,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59032,"_25170":58934,"_17548":99865,"_5":17443,"_23820":99610,"_2384":99782},[],{"_2857":59033,"_25170":58934,"_17548":99867,"_5":17443,"_23820":99610,"_2384":99868},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_2857":59034,"_25170":58934,"_17548":99870,"_5":17443,"_23820":99610,"_2384":44883},[],{"_2857":59035,"_25170":58934,"_17548":99872,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59036,"_25170":58934,"_17548":99874,"_5":17443,"_23820":99610,"_2384":99782},[],{"_2857":59037,"_25170":58934,"_17548":99876,"_5":17443,"_23820":99610,"_2384":99877},[],"URL HTTP del Device Manager de Lamassu.",{"_2857":59038,"_25170":58934,"_17548":99879,"_5":17443,"_23820":99610,"_2384":44893},[],{"_2857":59039,"_25170":58934,"_17548":99881,"_5":17443,"_23820":99610,"_2384":20963},[],{"_2857":59040,"_25170":58934,"_17548":99883,"_5":17443,"_23820":99610,"_2384":99782},[],{"_2857":59041,"_25170":58934,"_17548":99885,"_5":17443,"_23820":99610,"_2384":99886},[],"URL HTTP del servicio de CA de Lamassu.",{"_2857":59042,"_25170":58934,"_17548":99888,"_5":17443,"_23820":99614,"_2384":99889},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_2857":59043,"_25170":58934,"_17548":99891,"_5":17443,"_23820":99618,"_2384":99892},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_2857":59044,"_25170":58934,"_17548":99894,"_5":17443,"_23820":99618,"_2384":99895},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_2857":59045,"_25170":58934,"_17548":99897,"_5":17443,"_23820":99622,"_2384":99898},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_2857":59046,"_25170":58934,"_17548":99900,"_5":17443,"_23820":99622,"_2384":99901},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_2857":59047,"_25170":58934,"_17548":99903,"_5":17443,"_23820":99622,"_2384":99904},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_2857":59048,"_25170":58934,"_17548":99906,"_5":17443,"_23820":99622,"_2384":99907},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_2857":59049,"_25170":58934,"_17548":99909,"_5":17443,"_23820":99622,"_2384":99910},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_2857":59050,"_25170":58934,"_17548":99912,"_5":17443,"_23820":99622,"_2384":99913},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_2857":59051,"_25170":58934,"_17548":99915,"_5":17443,"_23820":99625,"_2384":99916},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_2857":59052,"_25170":58934,"_17548":99918,"_5":17443,"_23820":99628,"_2384":99919},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_2857":59053,"_25170":58934,"_17548":99921,"_5":17443,"_23820":99628,"_2384":99922},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_2857":59054,"_25170":58934,"_17548":99924,"_5":17443,"_23820":99632,"_2384":99925},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_2857":59055,"_25170":58934,"_17548":99927,"_5":17443,"_23820":99636,"_2384":99928},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_2857":59056,"_25170":58934,"_17548":99930,"_5":17443,"_23820":99636,"_2384":99931},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_2857":59057,"_25170":58934,"_17548":99933,"_5":17443,"_23820":99636,"_2384":99934},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_2857":59058,"_25170":58934,"_17548":99936,"_5":17443,"_23820":99636,"_2384":99937},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_2857":59059,"_25170":58934,"_17548":99939,"_5":17443,"_23820":99636,"_2384":99940},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_2857":59060,"_25170":58934,"_17548":99942,"_5":17443,"_23820":99636,"_2384":99943},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_2857":59061,"_25170":58934,"_17548":99945,"_5":17443,"_23820":99640,"_2384":99946},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_2857":59062,"_25170":58934,"_17548":99948,"_5":17443,"_23820":99640,"_2384":99949},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_2857":59063,"_25170":58934,"_17548":99951,"_5":17443,"_23820":99640,"_2384":99952},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_2857":59064,"_25170":58934,"_17548":99954,"_5":17443,"_23820":99644,"_2384":99955},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_2857":59065,"_25170":58934,"_17548":99957,"_5":17443,"_23820":99644,"_2384":99958},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_2857":59066,"_25170":58934,"_17548":99960,"_5":17443,"_23820":99644,"_2384":99961},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_2857":59067,"_25170":58934,"_17548":99963,"_5":17443,"_23820":99648,"_2384":99964},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_2857":59068,"_25170":58934,"_17548":99966,"_5":17443,"_23820":99648,"_2384":99967},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_2857":59069,"_25170":58934,"_17548":99969,"_5":17443,"_23820":99648,"_2384":99970},[],"Para que el flujo JITP funcione correctamente:",{"_2857":59070,"_25170":58934,"_17548":99972,"_5":17443,"_23820":99648,"_2384":99973},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_2857":59071,"_25170":58934,"_17548":99975,"_5":17443,"_23820":99648,"_2384":99976},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_2857":59072,"_25170":58934,"_17548":99978,"_5":17443,"_23820":99648,"_2384":99979},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_2857":59073,"_25170":58934,"_17548":99981,"_5":17443,"_23820":99648,"_2384":99982},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_2857":59074,"_25170":58934,"_17548":99984,"_5":17443,"_23820":99652,"_2384":99985},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_2857":59075,"_25170":58934,"_17548":99987,"_5":17443,"_23820":99652,"_2384":99988},[],"Estado en Lamassu",{"_2857":59076,"_25170":58934,"_17548":99990,"_5":17443,"_23820":99652,"_2384":99991},[],"Razón de revocación",{"_2857":59077,"_25170":58934,"_17548":99993,"_5":17443,"_23820":99652,"_2384":99994},[],"Estado en AWS IoT Core",{"_2857":59078,"_25170":58934,"_17548":99996,"_5":17443,"_23820":99652,"_2384":45014},[],{"_2857":59079,"_25170":58934,"_17548":99998,"_5":17443,"_23820":99652,"_2384":99999},[],"Ninguna",{"_2857":59080,"_25170":58934,"_17548":100001,"_5":17443,"_23820":99652,"_2384":45020},[],{"_2857":59081,"_25170":58934,"_17548":100003,"_5":17443,"_23820":99652,"_2384":45023},[],{"_2857":59082,"_25170":58934,"_17548":100005,"_5":17443,"_23820":99652,"_2384":45026},[],{"_2857":59083,"_25170":58934,"_17548":100007,"_5":17443,"_23820":99652,"_2384":45029},[],{"_2857":59084,"_25170":58934,"_17548":100009,"_5":17443,"_23820":99652,"_2384":45023},[],{"_2857":59085,"_25170":58934,"_17548":100011,"_5":17443,"_23820":99652,"_2384":100012},[],"Cualquier otra razón",{"_2857":59086,"_25170":58934,"_17548":100014,"_5":17443,"_23820":99652,"_2384":45037},[],{"_2857":59087,"_25170":58934,"_17548":100016,"_5":17443,"_23820":99652,"_2384":100017},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_2857":59088,"_25170":58934,"_17548":100019,"_5":17443,"_23820":99656,"_2384":100020},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_2857":59089,"_25170":58934,"_17548":100022,"_5":17443,"_23820":99656,"_2384":100023},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_2857":59090,"_25170":58934,"_17548":100025,"_5":17443,"_23820":99656,"_2384":100026},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_2857":59091,"_25170":58934,"_17548":100028,"_5":17443,"_23820":99660,"_2384":100029},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_2857":59092,"_25170":58934,"_17548":100031,"_5":17443,"_23820":99660,"_2384":100032},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_2857":59093,"_25170":58934,"_17548":100034,"_5":17443,"_23820":99664,"_2384":100035},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_2857":59094,"_25170":58934,"_17548":100037,"_5":17443,"_23820":99664,"_2384":100038},[],"Existen dos tipos de acciones:",{"_2857":59095,"_25170":58934,"_17548":100040,"_5":17443,"_23820":99664,"_2384":100041},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_2857":59096,"_25170":58934,"_17548":100043,"_5":17443,"_23820":99664,"_2384":100044},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_2857":59097,"_25170":58934,"_17548":100046,"_5":17443,"_23820":99664,"_2384":100047},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_2857":59098,"_25170":58934,"_17548":100049,"_5":17443,"_23820":99668,"_2384":100050},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_2857":59099,"_25170":58934,"_17548":100052,"_5":17443,"_23820":99668,"_2384":100053},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_2857":59100,"_25170":58934,"_17548":100055,"_5":17443,"_23820":99668,"_2384":100056},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_2857":59101,"_25170":58934,"_17548":100058,"_5":17443,"_23820":99672,"_2384":100059},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_2857":59102,"_25170":58934,"_17548":100061,"_5":17443,"_23820":99672,"_2384":100062},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_2857":59103,"_25170":58934,"_17548":100064,"_5":17443,"_23820":99672,"_2384":100065},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_2857":59104,"_25170":58934,"_17548":100067,"_5":17443,"_23820":99672,"_2384":100068},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_2857":59105,"_25170":58934,"_17548":100070,"_5":17443,"_23820":99672,"_2384":100071},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_2857":59106,"_25170":58934,"_17548":100073,"_5":17443,"_23820":99672,"_2384":100074},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_2857":59107,"_25170":58934,"_17548":100076,"_5":17443,"_23820":99672,"_2384":100077},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_2857":59108,"_25170":58934,"_17548":100079,"_5":17443,"_23820":99672,"_2384":100080},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_2857":59109,"_25170":58934,"_17548":100082,"_5":17443,"_23820":99672,"_2384":100083},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_2857":59110,"_25170":58934,"_17548":100085,"_5":17443,"_23820":99672,"_2384":100086},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_2857":59111,"_25170":58934,"_17548":100088,"_5":17443,"_23820":99672,"_2384":100089},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_2857":59112,"_25170":58934,"_17548":100091,"_5":17443,"_23820":99672,"_2384":100092},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_2857":59113,"_25170":58934,"_17548":100094,"_5":17443,"_23820":99672,"_2384":100095},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_2857":59114,"_25170":58934,"_17548":100097,"_5":17443,"_23820":99672,"_2384":100098},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_2857":59115,"_25170":58934,"_17548":100100,"_5":17443,"_23820":99672,"_2384":100101},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_2857":59116,"_25170":58934,"_17548":100103,"_5":17443,"_23820":99672,"_2384":100104},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_2857":59117,"_25170":58934,"_17548":100106,"_5":17443,"_23820":99672,"_2384":100107},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_2857":59118,"_25170":58934,"_17548":100109,"_5":17443,"_23820":99672,"_2384":100110},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_2857":59119,"_25170":58934,"_17548":100112,"_5":17443,"_23820":99672,"_2384":100113},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":59120,"_25170":58934,"_17548":100115,"_5":17443,"_23820":99672,"_2384":100116},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2857":59121,"_25170":58934,"_17548":100118,"_5":17443,"_23820":99672,"_2384":100119},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_2857":59122,"_25170":59122,"_5":12294,"_2384":43135,"_25485":100121,"_17548":100122,"_23820":59122},[40817,97227,43135],[],{"_2857":59123,"_25170":59122,"_17548":100124,"_5":17443,"_23820":59122,"_2384":100125},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_2857":59124,"_25170":59122,"_5":25482,"_17548":100127,"_23820":100128,"_2384":100129},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_2857":59125,"_25170":59122,"_5":25482,"_17548":100131,"_23820":100132,"_2384":98199},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_2857":59126,"_25170":59122,"_5":25482,"_17548":100134,"_23820":100135,"_2384":98374},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_2857":59127,"_25170":59122,"_5":25482,"_17548":100137,"_23820":100138,"_2384":99591},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_2857":59128,"_25170":59122,"_5":25482,"_17548":100140,"_23820":100141,"_2384":100142},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_2857":59129,"_25170":59122,"_17548":100144,"_5":17443,"_23820":59122,"_2384":100145},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_2857":59130,"_25170":59122,"_17548":100147,"_5":17443,"_23820":100128,"_2384":100148},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_2857":59131,"_25170":59122,"_17548":100150,"_5":17443,"_23820":100128,"_2384":100151},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_2857":59132,"_25170":59122,"_17548":100153,"_5":17443,"_23820":100132,"_2384":100154},[],"Recurso",{"_2857":59133,"_25170":59122,"_17548":100156,"_5":17443,"_23820":100132,"_2384":100157},[],"Qué representa",{"_2857":59134,"_25170":59122,"_17548":100159,"_5":17443,"_23820":100132,"_2384":100160},[],"**Dispositivo**",{"_2857":59135,"_25170":59122,"_17548":100162,"_5":17443,"_23820":100132,"_2384":100163},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_2857":59136,"_25170":59122,"_17548":100165,"_5":17443,"_23820":100132,"_2384":100166},[],"**Identidad**",{"_2857":59137,"_25170":59122,"_17548":100168,"_5":17443,"_23820":100132,"_2384":100169},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_2857":59138,"_25170":59122,"_17548":100171,"_5":17443,"_23820":100132,"_2384":45195},[],{"_2857":59139,"_25170":59122,"_17548":100173,"_5":17443,"_23820":100132,"_2384":100174},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_2857":59140,"_25170":59122,"_17548":100176,"_5":17443,"_23820":100132,"_2384":100177},[],"**Flota**",{"_2857":59141,"_25170":59122,"_17548":100179,"_5":17443,"_23820":100132,"_2384":100180},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_2857":59142,"_25170":59122,"_17548":100182,"_5":17443,"_23820":100132,"_2384":100183},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_2857":59143,"_25170":59122,"_17548":100185,"_5":17443,"_23820":100132,"_2384":100186},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_2857":59144,"_25170":59122,"_17548":100188,"_5":17443,"_23820":100135,"_2384":100189},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_2857":59145,"_25170":59122,"_17548":100191,"_5":17443,"_23820":100135,"_2384":100192},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_2857":59146,"_25170":59122,"_17548":100194,"_5":17443,"_23820":100135,"_2384":100195},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_2857":59147,"_25170":59122,"_17548":100197,"_5":17443,"_23820":100135,"_2384":100198},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_2857":59148,"_25170":59122,"_17548":100200,"_5":17443,"_23820":100135,"_2384":100201},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_2857":59149,"_25170":59122,"_17548":100203,"_5":17443,"_23820":100135,"_2384":100204},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_2857":59150,"_25170":59122,"_17548":100206,"_5":17443,"_23820":100135,"_2384":100207},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2857":59151,"_25170":59122,"_17548":100209,"_5":17443,"_23820":100135,"_2384":100210},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2857":59152,"_25170":59122,"_17548":100212,"_5":17443,"_23820":100138,"_2384":100213},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_2857":59153,"_25170":59122,"_17548":100215,"_5":17443,"_23820":100138,"_2384":100216},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_2857":59154,"_25170":59122,"_17548":100218,"_5":17443,"_23820":100141,"_2384":100219},[],"Participante",{"_2857":59155,"_25170":59122,"_17548":100221,"_5":17443,"_23820":100141,"_2384":100222},[],"Responsabilidad",{"_2857":59156,"_25170":59122,"_17548":100224,"_5":17443,"_23820":100141,"_2384":100225},[],"Administrador PKI",{"_2857":59157,"_25170":59122,"_17548":100227,"_5":17443,"_23820":100141,"_2384":100228},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_2857":59158,"_25170":59122,"_17548":100230,"_5":17443,"_23820":100141,"_2384":100231},[],"Administrador del aprovisionamiento",{"_2857":59159,"_25170":59122,"_17548":100233,"_5":17443,"_23820":100141,"_2384":100234},[],"DMS, admisión, autenticación por operación e inventario.",{"_2857":59160,"_25170":59122,"_17548":100236,"_5":17443,"_23820":100141,"_2384":100237},[],"Integrador del dispositivo",{"_2857":59161,"_25170":59122,"_17548":100239,"_5":17443,"_23820":100141,"_2384":100240},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_2857":59162,"_25170":59122,"_17548":100242,"_5":17443,"_23820":100141,"_2384":100243},[],"Integrador del consumidor",{"_2857":59163,"_25170":59122,"_17548":100245,"_5":17443,"_23820":100141,"_2384":100246},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_2857":59164,"_25170":59122,"_17548":100248,"_5":17443,"_23820":100141,"_2384":100249},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_2857":59165,"_25170":59165,"_5":12294,"_2384":100251,"_25485":100252,"_17548":100254,"_23820":59165},"Enrola y conecta tu primer dispositivo",[40817,97227,43135,100253],"Primeros pasos",[],{"_2857":59166,"_25170":59165,"_17548":100256,"_5":17443,"_23820":59165,"_2384":100257},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_2857":59167,"_25170":59165,"_5":25482,"_17548":100259,"_23820":100260,"_2384":95928},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_2857":59168,"_25170":59165,"_5":25482,"_17548":100262,"_23820":100263,"_2384":100264},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_2857":59169,"_25170":59165,"_5":25482,"_17548":100266,"_23820":100267,"_2384":100268},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_2857":59170,"_25170":59165,"_5":25482,"_17548":100270,"_23820":100271,"_2384":100272},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_2857":59171,"_25170":59165,"_5":25482,"_17548":100274,"_23820":100275,"_2384":100276},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_2857":59172,"_25170":59165,"_5":25482,"_17548":100278,"_23820":100279,"_2384":100280},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_2857":59173,"_25170":59165,"_5":25482,"_17548":100282,"_23820":100283,"_2384":100284},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_2857":59174,"_25170":59165,"_5":25482,"_17548":100286,"_23820":100287,"_2384":100288},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_2857":59175,"_25170":59165,"_17548":100290,"_5":17443,"_23820":59165,"_2384":100291},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_2857":59176,"_25170":59165,"_17548":100293,"_5":17443,"_23820":100260,"_2384":100294},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_2857":59177,"_25170":59165,"_17548":100296,"_5":17443,"_23820":100260,"_2384":100297},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_2857":59178,"_25170":59165,"_17548":100299,"_5":17443,"_23820":100260,"_2384":100300},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_2857":59179,"_25170":59165,"_17548":100302,"_5":17443,"_23820":100260,"_2384":100303},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_2857":59180,"_25170":59165,"_17548":100305,"_5":17443,"_23820":100260,"_2384":100306},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_2857":59181,"_25170":59165,"_17548":100308,"_5":17443,"_23820":100263,"_2384":100309},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_2857":59182,"_25170":59165,"_17548":100311,"_5":17443,"_23820":100263,"_2384":100312},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_2857":59183,"_25170":59165,"_17548":100314,"_5":17443,"_23820":100267,"_2384":100315},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_2857":59184,"_25170":59165,"_17548":100317,"_5":17443,"_23820":100267,"_2384":100318},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_2857":59185,"_25170":59165,"_17548":100320,"_5":17443,"_23820":100267,"_2384":100321},[],"Ajuste",{"_2857":59186,"_25170":59165,"_17548":100323,"_5":17443,"_23820":100267,"_2384":100324},[],"Valor de evaluación",{"_2857":59187,"_25170":59165,"_17548":100326,"_5":17443,"_23820":100267,"_2384":45351},[],{"_2857":59188,"_25170":59165,"_17548":100328,"_5":17443,"_23820":100267,"_2384":100329},[],"Raíz emisora de `device-root.pem`.",{"_2857":59189,"_25170":59165,"_17548":100331,"_5":17443,"_23820":100267,"_2384":98502},[],{"_2857":59190,"_25170":59165,"_17548":100333,"_5":17443,"_23820":100267,"_2384":100334},[],"Perfil final de 1 hora que acabas de preparar.",{"_2857":59191,"_25170":59165,"_17548":100336,"_5":17443,"_23820":100267,"_2384":45362},[],{"_2857":59192,"_25170":59165,"_17548":100338,"_5":17443,"_23820":100267,"_2384":45365},[],{"_2857":59193,"_25170":59165,"_17548":100340,"_5":17443,"_23820":100267,"_2384":45368},[],{"_2857":59194,"_25170":59165,"_17548":100342,"_5":17443,"_23820":100267,"_2384":100343},[],"Habilitado.",{"_2857":59195,"_25170":59165,"_17548":100345,"_5":17443,"_23820":100267,"_2384":45374},[],{"_2857":59196,"_25170":59165,"_17548":100347,"_5":17443,"_23820":100267,"_2384":100348},[],"Deshabilitado; el ID debe ser nuevo.",{"_2857":59197,"_25170":59165,"_17548":100350,"_5":17443,"_23820":100267,"_2384":100351},[],"Autenticación inicial",{"_2857":59198,"_25170":59165,"_17548":100353,"_5":17443,"_23820":100267,"_2384":100354},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_2857":59199,"_25170":59165,"_17548":100356,"_5":17443,"_23820":100267,"_2384":100357},[],"Autenticación de renovación",{"_2857":59200,"_25170":59165,"_17548":100359,"_5":17443,"_23820":100267,"_2384":100360},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_2857":59201,"_25170":59165,"_17548":100362,"_5":17443,"_23820":100267,"_2384":45392},[],{"_2857":59202,"_25170":59165,"_17548":100364,"_5":17443,"_23820":100267,"_2384":100365},[],"Lista vacía para esta emisión directa / deshabilitado.",{"_2857":59203,"_25170":59165,"_17548":100367,"_5":17443,"_23820":100267,"_2384":45398},[],{"_2857":59204,"_25170":59165,"_17548":100369,"_5":17443,"_23820":100267,"_2384":100370},[],"1 hora.",{"_2857":59205,"_25170":59165,"_17548":100372,"_5":17443,"_23820":100267,"_2384":45404},[],{"_2857":59206,"_25170":59165,"_17548":100374,"_5":17443,"_23820":100267,"_2384":100375},[],"30 minutos / 10 minutos.",{"_2857":59207,"_25170":59165,"_17548":100377,"_5":17443,"_23820":100267,"_2384":45410},[],{"_2857":59208,"_25170":59165,"_17548":100379,"_5":17443,"_23820":100267,"_2384":100380},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_2857":59209,"_25170":59165,"_17548":100382,"_5":17443,"_23820":100267,"_2384":43454},[],{"_2857":59210,"_25170":59165,"_17548":100384,"_5":17443,"_23820":100267,"_2384":100385},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_2857":59211,"_25170":59165,"_17548":100387,"_5":17443,"_23820":100267,"_2384":45421},[],{"_2857":59212,"_25170":59165,"_17548":100389,"_5":17443,"_23820":100267,"_2384":100390},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_2857":59213,"_25170":59165,"_17548":100392,"_5":17443,"_23820":100267,"_2384":100393},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. Si tu consola no expone el bloque independiente, configura y comprueba el recurso mediante la API DMS y la guía DMS.",{"_2857":59214,"_25170":59165,"_17548":100395,"_5":17443,"_23820":100271,"_2384":100396},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_2857":59215,"_25170":59165,"_17548":100398,"_5":17443,"_23820":100271,"_2384":100399},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_2857":59216,"_25170":59165,"_17548":100401,"_5":17443,"_23820":100275,"_2384":100402},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_2857":59217,"_25170":59165,"_17548":100404,"_5":17443,"_23820":100275,"_2384":100405},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_2857":59218,"_25170":59165,"_17548":100407,"_5":17443,"_23820":100275,"_2384":100408},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_2857":59219,"_25170":59165,"_17548":100410,"_5":17443,"_23820":100279,"_2384":100411},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_2857":59220,"_25170":59165,"_17548":100413,"_5":17443,"_23820":100279,"_2384":100414},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_2857":59221,"_25170":59165,"_17548":100416,"_5":17443,"_23820":100283,"_2384":100417},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_2857":59222,"_25170":59165,"_17548":100419,"_5":17443,"_23820":100283,"_2384":100420},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_2857":59223,"_25170":59165,"_17548":100422,"_5":17443,"_23820":100283,"_2384":100423},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_2857":59224,"_25170":59165,"_17548":100425,"_5":17443,"_23820":100283,"_2384":100426},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_2857":59225,"_25170":59165,"_17548":100428,"_5":17443,"_23820":100283,"_2384":100429},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_2857":59226,"_25170":59165,"_17548":100431,"_5":17443,"_23820":100287,"_2384":100432},[],"Comprobación",{"_2857":59227,"_25170":59165,"_17548":100434,"_5":17443,"_23820":100287,"_2384":100435},[],"Resultado esperado",{"_2857":59228,"_25170":59165,"_17548":100437,"_5":17443,"_23820":100287,"_2384":100438},[],"Registro",{"_2857":59229,"_25170":59165,"_17548":100440,"_5":17443,"_23820":100287,"_2384":100441},[],"ID creado automáticamente y DMS correcto.",{"_2857":59230,"_25170":59165,"_17548":100443,"_5":17443,"_23820":100287,"_2384":100444},[],"Certificado",{"_2857":59231,"_25170":59165,"_17548":100446,"_5":17443,"_23820":100287,"_2384":100447},[],"CN, perfil, serie y clave verificados.",{"_2857":59232,"_25170":59165,"_17548":100449,"_5":17443,"_23820":100287,"_2384":100450},[],"Inventario",{"_2857":59233,"_25170":59165,"_17548":100452,"_5":17443,"_23820":100287,"_2384":100453},[],"Serie recibida visible como identidad actual y en el historial.",{"_2857":59234,"_25170":59165,"_17548":100455,"_5":17443,"_23820":100287,"_2384":100456},[],"Consumidor",{"_2857":59235,"_25170":59165,"_17548":100458,"_5":17443,"_23820":100287,"_2384":100459},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_2857":59236,"_25170":59165,"_17548":100461,"_5":17443,"_23820":100287,"_2384":100462},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_2857":59237,"_25170":59165,"_17548":100464,"_5":17443,"_23820":100287,"_2384":100465},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_2857":59238,"_25170":59238,"_5":12294,"_2384":98216,"_25485":100467,"_17548":100468,"_23820":59238},[40817,97227,43135,100253],[],{"_2857":59239,"_25170":59238,"_17548":100470,"_5":17443,"_23820":59238,"_2384":100471},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_2857":59240,"_25170":59238,"_5":25482,"_17548":100473,"_23820":100474,"_2384":95928},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_2857":59241,"_25170":59238,"_5":25482,"_17548":100476,"_23820":100477,"_2384":100478},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_2857":59242,"_25170":59238,"_5":25482,"_17548":100480,"_23820":100481,"_2384":100482},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_2857":59243,"_25170":59238,"_5":25482,"_17548":100484,"_23820":100485,"_2384":100486},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_2857":59244,"_25170":59238,"_5":25482,"_17548":100488,"_23820":100489,"_2384":100490},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_2857":59245,"_25170":59238,"_5":25482,"_17548":100492,"_23820":100493,"_2384":100494},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_2857":59246,"_25170":59238,"_5":25482,"_17548":100496,"_23820":100497,"_2384":100435},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_2857":59247,"_25170":59238,"_5":25482,"_17548":100499,"_23820":100500,"_2384":100501},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_2857":59248,"_25170":59238,"_5":25482,"_17548":100503,"_23820":100504,"_2384":100505},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_2857":59249,"_25170":59238,"_17548":100507,"_5":17443,"_23820":59238,"_2384":100508},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_2857":59250,"_25170":59238,"_17548":100510,"_5":17443,"_23820":59238,"_2384":100511},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_2857":59251,"_25170":59238,"_17548":100513,"_5":17443,"_23820":100474,"_2384":100514},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_2857":59252,"_25170":59238,"_17548":100516,"_5":17443,"_23820":100474,"_2384":100517},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_2857":59253,"_25170":59238,"_17548":100519,"_5":17443,"_23820":100474,"_2384":100520},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_2857":59254,"_25170":59238,"_17548":100522,"_5":17443,"_23820":100474,"_2384":100523},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_2857":59255,"_25170":59238,"_17548":100525,"_5":17443,"_23820":100477,"_2384":100526},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_2857":59256,"_25170":59238,"_17548":100528,"_5":17443,"_23820":100477,"_2384":100529},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_2857":59257,"_25170":59238,"_17548":100531,"_5":17443,"_23820":100477,"_2384":100532},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_2857":59258,"_25170":59238,"_17548":100534,"_5":17443,"_23820":100477,"_2384":100535},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_2857":59259,"_25170":59238,"_17548":100537,"_5":17443,"_23820":100477,"_2384":100538},[],"Configura **Authentication Mode** como `CLIENT_CERTIFICATE` y añade en **Validation CAs** la CA cuyos certificados iniciales aceptarás. Para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deshabilitada la generación de claves en servidor si no la vas a utilizar.",{"_2857":59260,"_25170":59238,"_17548":100540,"_5":17443,"_23820":100477,"_2384":100541},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_2857":59261,"_25170":59238,"_17548":100543,"_5":17443,"_23820":100477,"_2384":100544},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_2857":59262,"_25170":59238,"_17548":100546,"_5":17443,"_23820":100477,"_2384":100547},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_2857":59263,"_25170":59238,"_17548":100549,"_5":17443,"_23820":100481,"_2384":100550},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_2857":59264,"_25170":59238,"_17548":100552,"_5":17443,"_23820":100481,"_2384":45587},[],{"_2857":59265,"_25170":59238,"_17548":100554,"_5":17443,"_23820":100481,"_2384":100555},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_2857":59266,"_25170":59238,"_17548":100557,"_5":17443,"_23820":100481,"_2384":100558},[],"**Icon** y **Tags**: clasificación opcional.",{"_2857":59267,"_25170":59238,"_17548":100560,"_5":17443,"_23820":100481,"_2384":100561},[],"Confirma el registro.",{"_2857":59268,"_25170":59238,"_17548":100563,"_5":17443,"_23820":100485,"_2384":100564},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_2857":59269,"_25170":59238,"_17548":100566,"_5":17443,"_23820":100485,"_2384":100567},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_2857":59270,"_25170":59238,"_17548":100569,"_5":17443,"_23820":100489,"_2384":100570},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_2857":59271,"_25170":59238,"_17548":100572,"_5":17443,"_23820":100489,"_2384":100573},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_2857":59272,"_25170":59238,"_17548":100575,"_5":17443,"_23820":100493,"_2384":100576},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_2857":59273,"_25170":59238,"_17548":100578,"_5":17443,"_23820":100493,"_2384":100579},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_2857":59274,"_25170":59238,"_17548":100581,"_5":17443,"_23820":100497,"_2384":100432},[],{"_2857":59275,"_25170":59238,"_17548":100583,"_5":17443,"_23820":100497,"_2384":100584},[],"Resultado",{"_2857":59276,"_25170":59238,"_17548":100586,"_5":17443,"_23820":100497,"_2384":100587},[],"Dispositivo",{"_2857":59277,"_25170":59238,"_17548":100589,"_5":17443,"_23820":100497,"_2384":100590},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_2857":59278,"_25170":59238,"_17548":100592,"_5":17443,"_23820":100497,"_2384":100593},[],"Identidad actual",{"_2857":59279,"_25170":59238,"_17548":100595,"_5":17443,"_23820":100497,"_2384":100596},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_2857":59280,"_25170":59238,"_17548":100598,"_5":17443,"_23820":100497,"_2384":100599},[],"Historial",{"_2857":59281,"_25170":59238,"_17548":100601,"_5":17443,"_23820":100497,"_2384":100602},[],"La emisión asociada aparece con su número de serie y fechas.",{"_2857":59282,"_25170":59238,"_17548":100604,"_5":17443,"_23820":100497,"_2384":100605},[],"Clave y certificado",{"_2857":59283,"_25170":59238,"_17548":100607,"_5":17443,"_23820":100497,"_2384":100608},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_2857":59284,"_25170":59238,"_17548":100610,"_5":17443,"_23820":100500,"_2384":100611},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_2857":59285,"_25170":59238,"_17548":100613,"_5":17443,"_23820":100500,"_2384":100614},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_2857":59286,"_25170":59238,"_17548":100616,"_5":17443,"_23820":100500,"_2384":100617},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_2857":59287,"_25170":59238,"_17548":100619,"_5":17443,"_23820":100500,"_2384":100620},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_2857":59288,"_25170":59238,"_17548":100622,"_5":17443,"_23820":100504,"_2384":100623},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_2857":59289,"_25170":59238,"_17548":100625,"_5":17443,"_23820":100504,"_2384":100626},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_2857":59290,"_25170":59238,"_17548":100628,"_5":17443,"_23820":100504,"_2384":100629},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_2857":59291,"_25170":59291,"_5":12294,"_2384":100631,"_25485":100632,"_17548":100633,"_23820":59291},"Plataforma Lamassu IoT",[40817,97227],[],{"_2857":59292,"_25170":59291,"_17548":100635,"_5":17443,"_23820":59291,"_2384":100636},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_2857":59293,"_25170":59291,"_5":25482,"_17548":100638,"_23820":100639,"_2384":100129},[],"/docs/es/platform/overview#empieza-aquí",{"_2857":59294,"_25170":59291,"_5":25482,"_17548":100641,"_23820":100642,"_2384":100643},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_2857":59295,"_25170":59291,"_5":25482,"_17548":100645,"_23820":100646,"_2384":100647},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_2857":59296,"_25170":59291,"_5":25482,"_17548":100649,"_23820":100650,"_2384":100651},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_2857":59297,"_25170":59291,"_5":25482,"_17548":100653,"_23820":100654,"_2384":100655},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_2857":59298,"_25170":59291,"_5":25482,"_17548":100657,"_23820":100658,"_2384":100659},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_2857":59299,"_25170":59291,"_5":25482,"_17548":100661,"_23820":100662,"_2384":100663},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_2857":59300,"_25170":59291,"_5":25482,"_17548":100665,"_23820":100666,"_2384":100667},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_2857":59301,"_25170":59291,"_5":25482,"_17548":100669,"_23820":100670,"_2384":100671},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_2857":59302,"_25170":59291,"_5":25482,"_17548":100673,"_23820":100674,"_2384":100675},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_2857":59303,"_25170":59291,"_5":25482,"_17548":100677,"_23820":100678,"_2384":100679},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_2857":59304,"_25170":59291,"_17548":100681,"_5":17443,"_23820":59291,"_2384":100682},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_2857":59305,"_25170":59291,"_17548":100684,"_5":17443,"_23820":100639,"_2384":100685},[],"Elige el resultado que necesitas obtener:",{"_2857":59306,"_25170":59291,"_17548":100687,"_5":17443,"_23820":100639,"_2384":100688},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":59307,"_25170":59291,"_17548":100690,"_5":17443,"_23820":100639,"_2384":100691},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2857":59308,"_25170":59291,"_17548":100693,"_5":17443,"_23820":100639,"_2384":100694},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_2857":59309,"_25170":59291,"_17548":100696,"_5":17443,"_23820":100642,"_2384":100697},[],"Bloque",{"_2857":59310,"_25170":59291,"_17548":100699,"_5":17443,"_23820":100642,"_2384":100700},[],"Qué gestionas",{"_2857":59311,"_25170":59291,"_17548":100702,"_5":17443,"_23820":100642,"_2384":100703},[],"Punto de entrada",{"_2857":59312,"_25170":59291,"_17548":100705,"_5":17443,"_23820":100642,"_2384":45741},[],{"_2857":59313,"_25170":59291,"_17548":100707,"_5":17443,"_23820":100642,"_2384":100708},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_2857":59314,"_25170":59291,"_17548":100710,"_5":17443,"_23820":100642,"_2384":100711},[],"Visión general de PKI",{"_2857":59315,"_25170":59291,"_17548":100713,"_5":17443,"_23820":100642,"_2384":45750},[],{"_2857":59316,"_25170":59291,"_17548":100715,"_5":17443,"_23820":100642,"_2384":100716},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_2857":59317,"_25170":59291,"_17548":100718,"_5":17443,"_23820":100642,"_2384":100719},[],"Visión general de IoT Fleets",{"_2857":59318,"_25170":59291,"_17548":100721,"_5":17443,"_23820":100642,"_2384":100722},[],"**Administración**",{"_2857":59319,"_25170":59291,"_17548":100724,"_5":17443,"_23820":100642,"_2384":100725},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_2857":59320,"_25170":59291,"_17548":100727,"_5":17443,"_23820":100642,"_2384":97225},[],{"_2857":59321,"_25170":59291,"_17548":100729,"_5":17443,"_23820":100642,"_2384":100730},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_2857":59322,"_25170":59291,"_17548":100732,"_5":17443,"_23820":100646,"_2384":100733},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_2857":59323,"_25170":59291,"_17548":100735,"_5":17443,"_23820":100646,"_2384":100736},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_2857":59324,"_25170":59291,"_17548":100738,"_5":17443,"_23820":100646,"_2384":100739},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_2857":59325,"_25170":59291,"_17548":100741,"_5":17443,"_23820":100646,"_2384":100742},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_2857":59326,"_25170":59291,"_17548":100744,"_5":17443,"_23820":100646,"_2384":100745},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_2857":59327,"_25170":59291,"_17548":100747,"_5":17443,"_23820":100646,"_2384":100748},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_2857":59328,"_25170":59291,"_17548":100750,"_5":17443,"_23820":100654,"_2384":100751},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_2857":59329,"_25170":59291,"_17548":100753,"_5":17443,"_23820":100658,"_2384":100754},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_2857":59330,"_25170":59291,"_17548":100756,"_5":17443,"_23820":100662,"_2384":100757},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_2857":59331,"_25170":59291,"_17548":100759,"_5":17443,"_23820":100666,"_2384":100760},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_2857":59332,"_25170":59291,"_17548":100762,"_5":17443,"_23820":100670,"_2384":100763},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_2857":59333,"_25170":59291,"_17548":100765,"_5":17443,"_23820":100674,"_2384":100766},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_2857":59334,"_25170":59291,"_17548":100768,"_5":17443,"_23820":100678,"_2384":100222},[],{"_2857":59335,"_25170":59291,"_17548":100770,"_5":17443,"_23820":100678,"_2384":100771},[],"Qué prepara o comprueba",{"_2857":59336,"_25170":59291,"_17548":100773,"_5":17443,"_23820":100678,"_2384":100225},[],{"_2857":59337,"_25170":59291,"_17548":100775,"_5":17443,"_23820":100678,"_2384":100776},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_2857":59338,"_25170":59291,"_17548":100778,"_5":17443,"_23820":100678,"_2384":100779},[],"Administrador de la flota",{"_2857":59339,"_25170":59291,"_17548":100781,"_5":17443,"_23820":100678,"_2384":100782},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_2857":59340,"_25170":59291,"_17548":100784,"_5":17443,"_23820":100678,"_2384":100237},[],{"_2857":59341,"_25170":59291,"_17548":100786,"_5":17443,"_23820":100678,"_2384":100787},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_2857":59342,"_25170":59291,"_17548":100789,"_5":17443,"_23820":100678,"_2384":100243},[],{"_2857":59343,"_25170":59291,"_17548":100791,"_5":17443,"_23820":100678,"_2384":100792},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_2857":59344,"_25170":59291,"_17548":100794,"_5":17443,"_23820":100678,"_2384":100795},[],"Operador de infraestructura",{"_2857":59345,"_25170":59291,"_17548":100797,"_5":17443,"_23820":100678,"_2384":100798},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_2857":59346,"_25170":59291,"_17548":100800,"_5":17443,"_23820":100678,"_2384":100801},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_2857":59347,"_25170":59347,"_5":12294,"_2384":100803,"_25485":100804,"_17548":100806,"_23820":59347},"Jerarquía y rotación de CAs",[40817,97227,45842,100805],"Claves, autoridades y certificados",[],{"_2857":59348,"_25170":59347,"_17548":100808,"_5":17443,"_23820":59347,"_2384":100809},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_2857":59349,"_25170":59347,"_5":25482,"_17548":100811,"_23820":100812,"_2384":100813},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_2857":59350,"_25170":59347,"_5":25482,"_17548":100815,"_23820":100816,"_2384":100817},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_2857":59351,"_25170":59347,"_5":25482,"_17548":100819,"_23820":100820,"_2384":100821},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_2857":59352,"_25170":59347,"_5":25482,"_17548":100823,"_23820":100824,"_2384":100825},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_2857":59353,"_25170":59347,"_5":25482,"_17548":100827,"_23820":100828,"_2384":100829},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_2857":59354,"_25170":59347,"_5":25482,"_17548":100831,"_23820":100832,"_2384":100833},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_2857":59355,"_25170":59347,"_5":25482,"_17548":100835,"_23820":100836,"_2384":100837},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_2857":59356,"_25170":59347,"_5":25482,"_17548":100839,"_23820":100840,"_2384":100841},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_2857":59357,"_25170":59347,"_5":25482,"_17548":100843,"_23820":100844,"_2384":100845},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_2857":59358,"_25170":59347,"_5":25482,"_17548":100847,"_23820":100848,"_2384":100849},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_2857":59359,"_25170":59347,"_5":25482,"_17548":100851,"_23820":100852,"_2384":100853},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_2857":59360,"_25170":59347,"_5":25482,"_17548":100855,"_23820":100856,"_2384":100857},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_2857":59361,"_25170":59347,"_17548":100859,"_5":17443,"_23820":59347,"_2384":100860},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_2857":59362,"_25170":59347,"_17548":100862,"_5":17443,"_23820":59347,"_2384":100863},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_2857":59363,"_25170":59347,"_17548":100865,"_5":17443,"_23820":100812,"_2384":100866},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_2857":59364,"_25170":59347,"_17548":100868,"_5":17443,"_23820":100812,"_2384":100869},[],"entorno, como producción y preproducción;",{"_2857":59365,"_25170":59347,"_17548":100871,"_5":17443,"_23820":100812,"_2384":100872},[],"propietario o equipo operador;",{"_2857":59366,"_25170":59347,"_17548":100874,"_5":17443,"_23820":100812,"_2384":100875},[],"familia de dispositivos o proceso de fabricación;",{"_2857":59367,"_25170":59347,"_17548":100877,"_5":17443,"_23820":100812,"_2384":100878},[],"región o requisito regulatorio;",{"_2857":59368,"_25170":59347,"_17548":100880,"_5":17443,"_23820":100812,"_2384":100881},[],"motor criptográfico o política de clave;",{"_2857":59369,"_25170":59347,"_17548":100883,"_5":17443,"_23820":100812,"_2384":100884},[],"ventana de mantenimiento y ritmo de renovación.",{"_2857":59370,"_25170":59347,"_17548":100886,"_5":17443,"_23820":100812,"_2384":100887},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_2857":59371,"_25170":59347,"_17548":100889,"_5":17443,"_23820":100812,"_2384":100890},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_2857":59372,"_25170":59347,"_17548":100892,"_5":17443,"_23820":100816,"_2384":100893},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_2857":59373,"_25170":59347,"_17548":100895,"_5":17443,"_23820":100816,"_2384":100896},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_2857":59374,"_25170":59347,"_17548":100898,"_5":17443,"_23820":100816,"_2384":100899},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_2857":59375,"_25170":59347,"_17548":100901,"_5":17443,"_23820":100820,"_2384":100902},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_2857":59376,"_25170":59347,"_17548":100904,"_5":17443,"_23820":100820,"_2384":100905},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_2857":59377,"_25170":59347,"_17548":100907,"_5":17443,"_23820":100820,"_2384":100908},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_2857":59378,"_25170":59347,"_17548":100910,"_5":17443,"_23820":100820,"_2384":100911},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_2857":59379,"_25170":59347,"_17548":100913,"_5":17443,"_23820":100828,"_2384":100914},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_2857":59380,"_25170":59347,"_17548":100916,"_5":17443,"_23820":100832,"_2384":100917},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_2857":59381,"_25170":59347,"_17548":100919,"_5":17443,"_23820":100836,"_2384":100920},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_2857":59382,"_25170":59347,"_17548":100922,"_5":17443,"_23820":100840,"_2384":100923},[],"Actualiza la CA de enrolamiento y el perfil de los DMS y añade la CA anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS mientras sigan renovando cohortes con certificados antiguos. La guía DMS documenta ese ajuste.",{"_2857":59383,"_25170":59347,"_17548":100925,"_5":17443,"_23820":100844,"_2384":100926},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_2857":59384,"_25170":59347,"_17548":100928,"_5":17443,"_23820":100848,"_2384":100929},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión y de las CAs distribuidas. Revócala si la política lo exige.",{"_2857":59385,"_25170":59347,"_17548":100931,"_5":17443,"_23820":100852,"_2384":100932},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_2857":59386,"_25170":59347,"_17548":100934,"_5":17443,"_23820":100852,"_2384":100935},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_2857":59387,"_25170":59347,"_17548":100937,"_5":17443,"_23820":100852,"_2384":100938},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_2857":59388,"_25170":59347,"_17548":100940,"_5":17443,"_23820":100852,"_2384":100941},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_2857":59389,"_25170":59347,"_17548":100943,"_5":17443,"_23820":100856,"_2384":100944},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_2857":59390,"_25170":59347,"_17548":100946,"_5":17443,"_23820":100856,"_2384":100947},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_2857":59391,"_25170":59347,"_17548":100949,"_5":17443,"_23820":100856,"_2384":100950},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_2857":59392,"_25170":59347,"_17548":100952,"_5":17443,"_23820":100856,"_2384":100953},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_2857":59393,"_25170":59347,"_17548":100955,"_5":17443,"_23820":100856,"_2384":100956},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_2857":59394,"_25170":59347,"_17548":100958,"_5":17443,"_23820":100856,"_2384":100959},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_2857":59395,"_25170":59347,"_17548":100961,"_5":17443,"_23820":100856,"_2384":100962},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_2857":59396,"_25170":59396,"_5":12294,"_2384":100964,"_25485":100965,"_17548":100966,"_23820":59396},"Autoridades de certificación",[40817,97227,45842,100805],[],{"_2857":59397,"_25170":59396,"_17548":100968,"_5":17443,"_23820":59396,"_2384":100969},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_2857":59398,"_25170":59396,"_5":25482,"_17548":100971,"_23820":100972,"_2384":100973},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_2857":59399,"_25170":59396,"_5":25482,"_17548":100975,"_23820":100976,"_2384":100977},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_2857":59400,"_25170":59396,"_5":25482,"_17548":100979,"_23820":100980,"_2384":95928},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_2857":59401,"_25170":59396,"_5":25482,"_17548":100982,"_23820":100983,"_2384":100984},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_2857":59402,"_25170":59396,"_5":25482,"_17548":100986,"_23820":100987,"_2384":100988},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_2857":59403,"_25170":59396,"_5":25482,"_17548":100990,"_23820":100991,"_2384":100992},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_2857":59404,"_25170":59396,"_5":25482,"_17548":100994,"_23820":100995,"_2384":100996},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_2857":59405,"_25170":59396,"_5":25482,"_17548":100998,"_23820":100999,"_2384":101000},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_2857":59406,"_25170":59396,"_5":25482,"_17548":101002,"_23820":101003,"_2384":101004},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_2857":59407,"_25170":59396,"_5":25482,"_17548":101006,"_23820":101007,"_2384":101008},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_2857":59408,"_25170":59396,"_5":25482,"_17548":101010,"_23820":101011,"_2384":101012},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_2857":59409,"_25170":59396,"_5":25482,"_17548":101014,"_23820":101015,"_2384":101016},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_2857":59410,"_25170":59396,"_5":25482,"_17548":101018,"_23820":101019,"_2384":101020},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_2857":59411,"_25170":59396,"_5":25482,"_17548":101022,"_23820":101023,"_2384":101024},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_2857":59412,"_25170":59396,"_5":25482,"_17548":101026,"_23820":101027,"_2384":101028},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_2857":59413,"_25170":59396,"_5":25482,"_17548":101030,"_23820":101031,"_2384":101032},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_2857":59414,"_25170":59396,"_5":25482,"_17548":101034,"_23820":101035,"_2384":101036},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_2857":59415,"_25170":59396,"_5":25482,"_17548":101038,"_23820":101039,"_2384":101040},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_2857":59416,"_25170":59396,"_5":25482,"_17548":101042,"_23820":101043,"_2384":101044},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_2857":59417,"_25170":59396,"_5":25482,"_17548":101046,"_23820":101047,"_2384":101048},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_2857":59418,"_25170":59396,"_5":25482,"_17548":101050,"_23820":101051,"_2384":101052},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_2857":59419,"_25170":59396,"_5":25482,"_17548":101054,"_23820":101055,"_2384":101056},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_2857":59420,"_25170":59396,"_17548":101058,"_5":17443,"_23820":59396,"_2384":101059},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_2857":59421,"_25170":59396,"_17548":101061,"_5":17443,"_23820":59396,"_2384":101062},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_2857":59422,"_25170":59396,"_17548":101064,"_5":17443,"_23820":59396,"_2384":101065},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_2857":59423,"_25170":59396,"_17548":101067,"_5":17443,"_23820":100972,"_2384":101068},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_2857":59424,"_25170":59396,"_17548":101070,"_5":17443,"_23820":100972,"_2384":101071},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_2857":59425,"_25170":59396,"_17548":101073,"_5":17443,"_23820":100972,"_2384":101074},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_2857":59426,"_25170":59396,"_17548":101076,"_5":17443,"_23820":100972,"_2384":101077},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_2857":59427,"_25170":59396,"_17548":101079,"_5":17443,"_23820":100972,"_2384":101080},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_2857":59428,"_25170":59396,"_17548":101082,"_5":17443,"_23820":100980,"_2384":101083},[],"Decide si la CA será raíz o intermedia.",{"_2857":59429,"_25170":59396,"_17548":101085,"_5":17443,"_23820":100980,"_2384":101086},[],"Elige el motor que custodiará la clave.",{"_2857":59430,"_25170":59396,"_17548":101088,"_5":17443,"_23820":100980,"_2384":101089},[],"Define una validez superior a la de los certificados que emitirá.",{"_2857":59431,"_25170":59396,"_17548":101091,"_5":17443,"_23820":100980,"_2384":101092},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_2857":59432,"_25170":59396,"_17548":101094,"_5":17443,"_23820":100983,"_2384":101095},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_2857":59433,"_25170":59396,"_17548":101097,"_5":17443,"_23820":100987,"_2384":101098},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_2857":59434,"_25170":59396,"_17548":101100,"_5":17443,"_23820":100987,"_2384":101101},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_2857":59435,"_25170":59396,"_17548":101103,"_5":17443,"_23820":100991,"_2384":101104},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_2857":59436,"_25170":59396,"_17548":101106,"_5":17443,"_23820":100995,"_2384":101107},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_2857":59437,"_25170":59396,"_17548":101109,"_5":17443,"_23820":100995,"_2384":101110},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_2857":59438,"_25170":59396,"_17548":101112,"_5":17443,"_23820":100995,"_2384":101113},[],"`ST`: estado o provincia.",{"_2857":59439,"_25170":59396,"_17548":101115,"_5":17443,"_23820":100995,"_2384":101116},[],"`L`: localidad.",{"_2857":59440,"_25170":59396,"_17548":101118,"_5":17443,"_23820":100995,"_2384":101119},[],"`O`: organización.",{"_2857":59441,"_25170":59396,"_17548":101121,"_5":17443,"_23820":100995,"_2384":101122},[],"`OU`: unidad organizativa.",{"_2857":59442,"_25170":59396,"_17548":101124,"_5":17443,"_23820":100995,"_2384":101125},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_2857":59443,"_25170":59396,"_17548":101127,"_5":17443,"_23820":100999,"_2384":101128},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_2857":59444,"_25170":59396,"_17548":101130,"_5":17443,"_23820":100999,"_2384":101131},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_2857":59445,"_25170":59396,"_17548":101133,"_5":17443,"_23820":101003,"_2384":101134},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_2857":59446,"_25170":59396,"_17548":101136,"_5":17443,"_23820":101003,"_2384":101137},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_2857":59447,"_25170":59396,"_17548":101139,"_5":17443,"_23820":101007,"_2384":101140},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_2857":59448,"_25170":59396,"_17548":101142,"_5":17443,"_23820":101007,"_2384":101143},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_2857":59449,"_25170":59396,"_17548":101145,"_5":17443,"_23820":101011,"_2384":101146},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_2857":59450,"_25170":59396,"_17548":101148,"_5":17443,"_23820":101015,"_2384":101149},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_2857":59451,"_25170":59396,"_17548":101151,"_5":17443,"_23820":101019,"_2384":101152},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_2857":59452,"_25170":59396,"_17548":101154,"_5":17443,"_23820":101023,"_2384":101155},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_2857":59453,"_25170":59396,"_17548":101157,"_5":17443,"_23820":101027,"_2384":101158},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_2857":59454,"_25170":59396,"_17548":101160,"_5":17443,"_23820":101027,"_2384":101161},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_2857":59455,"_25170":59396,"_17548":101163,"_5":17443,"_23820":101031,"_2384":101164},[],"Abre una CA desde el inventario para consultar:",{"_2857":59456,"_25170":59396,"_17548":101166,"_5":17443,"_23820":101031,"_2384":101167},[],"Estado y periodo de validez.",{"_2857":59457,"_25170":59396,"_17548":101169,"_5":17443,"_23820":101031,"_2384":101170},[],"Certificado y cadena en formato PEM.",{"_2857":59458,"_25170":59396,"_17548":101172,"_5":17443,"_23820":101031,"_2384":101173},[],"Número de certificados activos, expirados y revocados.",{"_2857":59459,"_25170":59396,"_17548":101175,"_5":17443,"_23820":101031,"_2384":101176},[],"Certificados emitidos en **Issued Certificates**.",{"_2857":59460,"_25170":59396,"_17548":101178,"_5":17443,"_23820":101031,"_2384":101179},[],"CRL vinculada a la autoridad.",{"_2857":59461,"_25170":59396,"_17548":101181,"_5":17443,"_23820":101031,"_2384":101182},[],"Metadatos y motor criptográfico asociado.",{"_2857":59462,"_25170":59396,"_17548":101184,"_5":17443,"_23820":101031,"_2384":101185},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_2857":59463,"_25170":59396,"_17548":101187,"_5":17443,"_23820":101035,"_2384":101188},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_2857":59464,"_25170":59396,"_17548":101190,"_5":17443,"_23820":101035,"_2384":101191},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_2857":59465,"_25170":59396,"_17548":101193,"_5":17443,"_23820":101035,"_2384":101194},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_2857":59466,"_25170":59396,"_17548":101196,"_5":17443,"_23820":101035,"_2384":101197},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_2857":59467,"_25170":59396,"_17548":101199,"_5":17443,"_23820":101039,"_2384":101200},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_2857":59468,"_25170":59396,"_17548":101202,"_5":17443,"_23820":101043,"_2384":101203},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_2857":59469,"_25170":59396,"_17548":101205,"_5":17443,"_23820":101047,"_2384":101206},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_2857":59470,"_25170":59396,"_17548":101208,"_5":17443,"_23820":101051,"_2384":101209},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_2857":59471,"_25170":59396,"_17548":101211,"_5":17443,"_23820":101055,"_2384":101212},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_2857":59472,"_25170":59396,"_17548":101214,"_5":17443,"_23820":101055,"_2384":101215},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_2857":59473,"_25170":59473,"_5":12294,"_2384":101217,"_25485":101218,"_17548":101219,"_23820":59473},"Perfiles de certificado",[40817,97227,45842,100805],[],{"_2857":59474,"_25170":59473,"_17548":101221,"_5":17443,"_23820":59473,"_2384":101222},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_2857":59475,"_25170":59473,"_5":25482,"_17548":101224,"_23820":101225,"_2384":101226},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_2857":59476,"_25170":59473,"_5":25482,"_17548":101228,"_23820":101229,"_2384":101230},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_2857":59477,"_25170":59473,"_5":25482,"_17548":101232,"_23820":101233,"_2384":101234},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_2857":59478,"_25170":59473,"_5":25482,"_17548":101236,"_23820":101237,"_2384":101238},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_2857":59479,"_25170":59473,"_5":25482,"_17548":101240,"_23820":101241,"_2384":101242},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_2857":59480,"_25170":59473,"_5":25482,"_17548":101244,"_23820":101245,"_2384":101246},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_2857":59481,"_25170":59473,"_5":25482,"_17548":101248,"_23820":101249,"_2384":101250},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_2857":59482,"_25170":59473,"_5":25482,"_17548":101252,"_23820":101253,"_2384":101254},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_2857":59483,"_25170":59473,"_5":25482,"_17548":101256,"_23820":101257,"_2384":101258},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_2857":59484,"_25170":59473,"_5":25482,"_17548":101260,"_23820":101261,"_2384":101262},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_2857":59485,"_25170":59473,"_5":25482,"_17548":101264,"_23820":101265,"_2384":101266},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_2857":59486,"_25170":59473,"_5":25482,"_17548":101268,"_23820":101269,"_2384":101270},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_2857":59487,"_25170":59473,"_5":25482,"_17548":101272,"_23820":101273,"_2384":101274},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_2857":59488,"_25170":59473,"_5":25482,"_17548":101276,"_23820":101277,"_2384":101278},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_2857":59489,"_25170":59473,"_5":25482,"_17548":101280,"_23820":101281,"_2384":101282},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_2857":59490,"_25170":59473,"_5":25482,"_17548":101284,"_23820":101285,"_2384":101286},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_2857":59491,"_25170":59473,"_17548":101288,"_5":17443,"_23820":59473,"_2384":101289},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_2857":59492,"_25170":59473,"_17548":101291,"_5":17443,"_23820":59473,"_2384":101292},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_2857":59493,"_25170":59473,"_17548":101294,"_5":17443,"_23820":101229,"_2384":101295},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_2857":59494,"_25170":59473,"_17548":101297,"_5":17443,"_23820":101229,"_2384":101298},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_2857":59495,"_25170":59473,"_17548":101300,"_5":17443,"_23820":101233,"_2384":101301},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_2857":59496,"_25170":59473,"_17548":101303,"_5":17443,"_23820":101237,"_2384":101304},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_2857":59497,"_25170":59473,"_17548":101306,"_5":17443,"_23820":101237,"_2384":101307},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_2857":59498,"_25170":59473,"_17548":101309,"_5":17443,"_23820":101237,"_2384":101310},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_2857":59499,"_25170":59473,"_17548":101312,"_5":17443,"_23820":101241,"_2384":101313},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_2857":59500,"_25170":59473,"_17548":101315,"_5":17443,"_23820":101245,"_2384":101316},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_2857":59501,"_25170":59473,"_17548":101318,"_5":17443,"_23820":101245,"_2384":101319},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_2857":59502,"_25170":59473,"_17548":101321,"_5":17443,"_23820":101249,"_2384":101322},[],"La aplicación criptográfica puede:",{"_2857":59503,"_25170":59473,"_17548":101324,"_5":17443,"_23820":101249,"_2384":101325},[],"permitir o bloquear claves RSA;",{"_2857":59504,"_25170":59473,"_17548":101327,"_5":17443,"_23820":101249,"_2384":101328},[],"limitar los tamaños RSA admitidos;",{"_2857":59505,"_25170":59473,"_17548":101330,"_5":17443,"_23820":101249,"_2384":101331},[],"permitir o bloquear claves ECDSA;",{"_2857":59506,"_25170":59473,"_17548":101333,"_5":17443,"_23820":101249,"_2384":101334},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_2857":59507,"_25170":59473,"_17548":101336,"_5":17443,"_23820":101249,"_2384":101337},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_2857":59508,"_25170":59473,"_17548":101339,"_5":17443,"_23820":101253,"_2384":101340},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_2857":59509,"_25170":59473,"_17548":101342,"_5":17443,"_23820":101253,"_2384":97018},[],{"_2857":59510,"_25170":59473,"_17548":101344,"_5":17443,"_23820":101253,"_2384":101345},[],"Primera opción",{"_2857":59511,"_25170":59473,"_17548":101347,"_5":17443,"_23820":101253,"_2384":101348},[],"Segunda opción",{"_2857":59512,"_25170":59473,"_17548":101350,"_5":17443,"_23820":101253,"_2384":101351},[],"Si no hay ninguna",{"_2857":59513,"_25170":59473,"_17548":101353,"_5":17443,"_23820":101253,"_2384":101354},[],"Firma directa con una CA",{"_2857":59514,"_25170":59473,"_17548":101356,"_5":17443,"_23820":101253,"_2384":101357},[],"`issuance_profile` incluido en la solicitud",{"_2857":59515,"_25170":59473,"_17548":101359,"_5":17443,"_23820":101253,"_2384":101360},[],"`issuance_profile_id` de la solicitud",{"_2857":59516,"_25170":59473,"_17548":101362,"_5":17443,"_23820":101253,"_2384":101363},[],"Perfil predeterminado de la CA (`profile_id`).",{"_2857":59517,"_25170":59473,"_17548":101365,"_5":17443,"_23820":101253,"_2384":101366},[],"Emisión mediante DMS",{"_2857":59518,"_25170":59473,"_17548":101368,"_5":17443,"_23820":101253,"_2384":46407},[],{"_2857":59519,"_25170":59473,"_17548":101370,"_5":17443,"_23820":101253,"_2384":101371},[],"`settings.issuance_profile` incluido en el DMS",{"_2857":59520,"_25170":59473,"_17548":101373,"_5":17443,"_23820":101253,"_2384":101374},[],"Perfil predeterminado de la CA de enrolamiento.",{"_2857":59521,"_25170":59473,"_17548":101376,"_5":17443,"_23820":101253,"_2384":101377},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_2857":59522,"_25170":59473,"_17548":101379,"_5":17443,"_23820":101253,"_2384":101380},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_2857":59523,"_25170":59473,"_17548":101382,"_5":17443,"_23820":101261,"_2384":101383},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_2857":59524,"_25170":59473,"_17548":101385,"_5":17443,"_23820":101265,"_2384":101386},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_2857":59525,"_25170":59473,"_17548":101388,"_5":17443,"_23820":101269,"_2384":101389},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_2857":59526,"_25170":59473,"_17548":101391,"_5":17443,"_23820":101273,"_2384":101392},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_2857":59527,"_25170":59473,"_17548":101394,"_5":17443,"_23820":101277,"_2384":101395},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_2857":59528,"_25170":59473,"_17548":101397,"_5":17443,"_23820":101277,"_2384":101398},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_2857":59529,"_25170":59473,"_17548":101400,"_5":17443,"_23820":101281,"_2384":101401},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_2857":59530,"_25170":59473,"_17548":101403,"_5":17443,"_23820":101281,"_2384":101404},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_2857":59531,"_25170":59473,"_17548":101406,"_5":17443,"_23820":101281,"_2384":101407},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_2857":59532,"_25170":59473,"_17548":101409,"_5":17443,"_23820":101281,"_2384":101410},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_2857":59533,"_25170":59473,"_17548":101412,"_5":17443,"_23820":101285,"_2384":101413},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_2857":59534,"_25170":59473,"_17548":101415,"_5":17443,"_23820":101285,"_2384":101416},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_2857":59535,"_25170":59535,"_5":12294,"_2384":101418,"_25485":101419,"_17548":101421,"_23820":59535},"Validación de certificados",[40817,97227,45842,101420],"Validación",[],{"_2857":59536,"_25170":59535,"_17548":101423,"_5":17443,"_23820":59535,"_2384":101424},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_2857":59537,"_25170":59535,"_5":25482,"_17548":101426,"_23820":101427,"_2384":101428},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_2857":59538,"_25170":59535,"_5":25482,"_17548":101430,"_23820":101431,"_2384":101432},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_2857":59539,"_25170":59535,"_5":25482,"_17548":101434,"_23820":101435,"_2384":101436},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_2857":59540,"_25170":59535,"_17548":101438,"_5":17443,"_23820":59535,"_2384":101439},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_2857":59541,"_25170":59535,"_17548":101441,"_5":17443,"_23820":101427,"_2384":101442},[],"Verifica estos criterios juntos:",{"_2857":59542,"_25170":59535,"_17548":101444,"_5":17443,"_23820":101427,"_2384":100432},[],{"_2857":59543,"_25170":59535,"_17548":101446,"_5":17443,"_23820":101427,"_2384":101447},[],"Resultado necesario",{"_2857":59544,"_25170":59535,"_17548":101449,"_5":17443,"_23820":101427,"_2384":101450},[],"Cadena y firma",{"_2857":59545,"_25170":59535,"_17548":101452,"_5":17443,"_23820":101427,"_2384":101453},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_2857":59546,"_25170":59535,"_17548":101455,"_5":17443,"_23820":101427,"_2384":101456},[],"Fechas",{"_2857":59547,"_25170":59535,"_17548":101458,"_5":17443,"_23820":101427,"_2384":101459},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_2857":59548,"_25170":59535,"_17548":101461,"_5":17443,"_23820":101427,"_2384":96931},[],{"_2857":59549,"_25170":59535,"_17548":101463,"_5":17443,"_23820":101427,"_2384":101464},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_2857":59550,"_25170":59535,"_17548":101466,"_5":17443,"_23820":101427,"_2384":101467},[],"Uso",{"_2857":59551,"_25170":59535,"_17548":101469,"_5":17443,"_23820":101427,"_2384":101470},[],"KU, EKU y restricciones permiten la operación concreta.",{"_2857":59552,"_25170":59535,"_17548":101472,"_5":17443,"_23820":101427,"_2384":101473},[],"Revocación",{"_2857":59553,"_25170":59535,"_17548":101475,"_5":17443,"_23820":101427,"_2384":101476},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_2857":59554,"_25170":59535,"_17548":101478,"_5":17443,"_23820":101427,"_2384":101479},[],"Autorización",{"_2857":59555,"_25170":59535,"_17548":101481,"_5":17443,"_23820":101427,"_2384":101482},[],"La aplicación permite la acción a esa identidad.",{"_2857":59556,"_25170":59535,"_17548":101484,"_5":17443,"_23820":101427,"_2384":101485},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_2857":59557,"_25170":59535,"_17548":101487,"_5":17443,"_23820":101431,"_2384":101488},[],"Mecanismo",{"_2857":59558,"_25170":59535,"_17548":101490,"_5":17443,"_23820":101431,"_2384":101491},[],"Cuándo utilizarlo",{"_2857":59559,"_25170":59535,"_17548":101493,"_5":17443,"_23820":101431,"_2384":101494},[],"Qué debes mantener",{"_2857":59560,"_25170":59535,"_17548":101496,"_5":17443,"_23820":101431,"_2384":46535},[],{"_2857":59561,"_25170":59535,"_17548":101498,"_5":17443,"_23820":101431,"_2384":101499},[],"Consulta del estado de un certificado concreto.",{"_2857":59562,"_25170":59535,"_17548":101501,"_5":17443,"_23820":101431,"_2384":101502},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_2857":59563,"_25170":59535,"_17548":101504,"_5":17443,"_23820":101431,"_2384":46544},[],{"_2857":59564,"_25170":59535,"_17548":101506,"_5":17443,"_23820":101431,"_2384":101507},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_2857":59565,"_25170":59535,"_17548":101509,"_5":17443,"_23820":101431,"_2384":101510},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_2857":59566,"_25170":59535,"_17548":101512,"_5":17443,"_23820":101431,"_2384":101513},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_2857":59567,"_25170":59535,"_17548":101515,"_5":17443,"_23820":101431,"_2384":101516},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_2857":59568,"_25170":59535,"_17548":101518,"_5":17443,"_23820":101435,"_2384":101519},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_2857":59569,"_25170":59535,"_17548":101521,"_5":17443,"_23820":101435,"_2384":101522},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_2857":59570,"_25170":59535,"_17548":101524,"_5":17443,"_23820":101435,"_2384":101525},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_2857":59571,"_25170":59535,"_17548":101527,"_5":17443,"_23820":101435,"_2384":101528},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_2857":59572,"_25170":59535,"_17548":101530,"_5":17443,"_23820":101435,"_2384":101531},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_2857":59573,"_25170":59535,"_17548":101533,"_5":17443,"_23820":101435,"_2384":101534},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_2857":59574,"_25170":59535,"_17548":101536,"_5":17443,"_23820":101435,"_2384":101537},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_2857":59575,"_25170":59535,"_17548":101539,"_5":17443,"_23820":101435,"_2384":101540},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59576,"_25170":59535,"_17548":101542,"_5":17443,"_23820":101435,"_2384":101543},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_2857":59577,"_25170":59577,"_5":12294,"_2384":101545,"_25485":101546,"_17548":101547,"_23820":59577},"Certificados",[40817,97227,45842,100805],[],{"_2857":59578,"_25170":59577,"_17548":101549,"_5":17443,"_23820":59577,"_2384":101550},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_2857":59579,"_25170":59577,"_5":25482,"_17548":101552,"_23820":101553,"_2384":101554},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_2857":59580,"_25170":59577,"_5":25482,"_17548":101556,"_23820":101557,"_2384":101558},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_2857":59581,"_25170":59577,"_5":25482,"_17548":101560,"_23820":101561,"_2384":101562},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_2857":59582,"_25170":59577,"_5":25482,"_17548":101564,"_23820":101565,"_2384":101566},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_2857":59583,"_25170":59577,"_5":25482,"_17548":101568,"_23820":101569,"_2384":101570},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_2857":59584,"_25170":59577,"_5":25482,"_17548":101572,"_23820":101573,"_2384":101574},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_2857":59585,"_25170":59577,"_5":25482,"_17548":101576,"_23820":101577,"_2384":101578},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_2857":59586,"_25170":59577,"_5":25482,"_17548":101580,"_23820":101581,"_2384":101582},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_2857":59587,"_25170":59577,"_5":25482,"_17548":101584,"_23820":101585,"_2384":101586},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_2857":59588,"_25170":59577,"_17548":101588,"_5":17443,"_23820":59577,"_2384":101589},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_2857":59589,"_25170":59577,"_17548":101591,"_5":17443,"_23820":101553,"_2384":101592},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_2857":59590,"_25170":59577,"_17548":101594,"_5":17443,"_23820":101553,"_2384":101595},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_2857":59591,"_25170":59577,"_17548":101597,"_5":17443,"_23820":101557,"_2384":101598},[],"Descarga el PEM e inspecciónalo:",{"_2857":59592,"_25170":59577,"_17548":101600,"_5":17443,"_23820":101557,"_2384":101601},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_2857":59593,"_25170":59577,"_17548":101603,"_5":17443,"_23820":101561,"_2384":101604},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_2857":59594,"_25170":59577,"_17548":101606,"_5":17443,"_23820":101561,"_2384":101607},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_2857":59595,"_25170":59577,"_17548":101609,"_5":17443,"_23820":101561,"_2384":101610},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_2857":59596,"_25170":59577,"_17548":101612,"_5":17443,"_23820":101561,"_2384":101613},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_2857":59597,"_25170":59577,"_17548":101615,"_5":17443,"_23820":101561,"_2384":101616},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_2857":59598,"_25170":59577,"_17548":101618,"_5":17443,"_23820":101561,"_2384":101619},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_2857":59599,"_25170":59577,"_17548":101621,"_5":17443,"_23820":101561,"_2384":101622},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_2857":59600,"_25170":59577,"_17548":101624,"_5":17443,"_23820":101565,"_2384":101625},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_2857":59601,"_25170":59577,"_17548":101627,"_5":17443,"_23820":101569,"_2384":101628},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_2857":59602,"_25170":59577,"_17548":101630,"_5":17443,"_23820":101573,"_2384":101631},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_2857":59603,"_25170":59577,"_17548":101633,"_5":17443,"_23820":101577,"_2384":101634},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_2857":59604,"_25170":59577,"_17548":101636,"_5":17443,"_23820":101577,"_2384":101637},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_2857":59605,"_25170":59577,"_17548":101639,"_5":17443,"_23820":101577,"_2384":101640},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_2857":59606,"_25170":59577,"_17548":101642,"_5":17443,"_23820":101581,"_2384":101643},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_2857":59607,"_25170":59577,"_17548":101645,"_5":17443,"_23820":101581,"_2384":101646},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_2857":59608,"_25170":59577,"_17548":101648,"_5":17443,"_23820":101581,"_2384":101649},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_2857":59609,"_25170":59577,"_17548":101651,"_5":17443,"_23820":101585,"_2384":101652},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59610,"_25170":59577,"_17548":101654,"_5":17443,"_23820":101585,"_2384":101655},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_2857":59611,"_25170":59611,"_5":12294,"_2384":101657,"_25485":101658,"_17548":101660,"_23820":59611},"Ciclo de vida de un certificado",[40817,97227,45842,101659],"Conceptos",[],{"_2857":59612,"_25170":59611,"_17548":101662,"_5":17443,"_23820":59611,"_2384":101663},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_2857":59613,"_25170":59611,"_5":25482,"_17548":101665,"_23820":101666,"_2384":101667},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_2857":59614,"_25170":59611,"_5":25482,"_17548":101669,"_23820":101670,"_2384":101671},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_2857":59615,"_25170":59611,"_5":25482,"_17548":101673,"_23820":101674,"_2384":101675},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_2857":59616,"_25170":59611,"_5":25482,"_17548":101677,"_23820":101678,"_2384":101679},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_2857":59617,"_25170":59611,"_5":25482,"_17548":101681,"_23820":101682,"_2384":101683},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_2857":59618,"_25170":59611,"_5":25482,"_17548":101685,"_23820":101686,"_2384":101687},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_2857":59619,"_25170":59611,"_5":25482,"_17548":101689,"_23820":101690,"_2384":101691},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado","Estados del certificado",{"_2857":59620,"_25170":59611,"_5":25482,"_17548":101693,"_23820":101694,"_2384":101695},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_2857":59621,"_25170":59611,"_5":25482,"_17548":101697,"_23820":101698,"_2384":101699},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_2857":59622,"_25170":59611,"_5":25482,"_17548":101701,"_23820":101702,"_2384":101703},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_2857":59623,"_25170":59611,"_17548":101705,"_5":17443,"_23820":59611,"_2384":101706},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_2857":59624,"_25170":59611,"_17548":101708,"_5":17443,"_23820":101670,"_2384":101709},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_2857":59625,"_25170":59611,"_17548":101711,"_5":17443,"_23820":101674,"_2384":101712},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_2857":59626,"_25170":59611,"_17548":101714,"_5":17443,"_23820":101678,"_2384":101715},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_2857":59627,"_25170":59611,"_17548":101717,"_5":17443,"_23820":101682,"_2384":101718},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_2857":59628,"_25170":59611,"_17548":101720,"_5":17443,"_23820":101686,"_2384":101721},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_2857":59629,"_25170":59611,"_17548":101723,"_5":17443,"_23820":101690,"_2384":101724},[],"Lamassu persiste cuatro estados X.509:",{"_2857":59630,"_25170":59611,"_17548":101726,"_5":17443,"_23820":101690,"_2384":101727},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_2857":59631,"_25170":59611,"_17548":101729,"_5":17443,"_23820":101690,"_2384":101730},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_2857":59632,"_25170":59611,"_17548":101732,"_5":17443,"_23820":101690,"_2384":101733},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_2857":59633,"_25170":59611,"_17548":101735,"_5":17443,"_23820":101690,"_2384":101736},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_2857":59634,"_25170":59611,"_17548":101738,"_5":17443,"_23820":101690,"_2384":101739},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_2857":59635,"_25170":59611,"_17548":101741,"_5":17443,"_23820":101694,"_2384":101742},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_2857":59636,"_25170":59611,"_17548":101744,"_5":17443,"_23820":101694,"_2384":101745},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_2857":59637,"_25170":59611,"_17548":101747,"_5":17443,"_23820":101694,"_2384":101748},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_2857":59638,"_25170":59611,"_17548":101750,"_5":17443,"_23820":101698,"_2384":101751},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_2857":59639,"_25170":59611,"_17548":101753,"_5":17443,"_23820":101698,"_2384":101754},[],"Antes de confirmar:",{"_2857":59640,"_25170":59611,"_17548":101756,"_5":17443,"_23820":101698,"_2384":101757},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_2857":59641,"_25170":59611,"_17548":101759,"_5":17443,"_23820":101698,"_2384":101760},[],"Distribuye la nueva cadena de confianza.",{"_2857":59642,"_25170":59611,"_17548":101762,"_5":17443,"_23820":101698,"_2384":101763},[],"Reemite las identidades necesarias.",{"_2857":59643,"_25170":59611,"_17548":101765,"_5":17443,"_23820":101698,"_2384":101766},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_2857":59644,"_25170":59611,"_17548":101768,"_5":17443,"_23820":101698,"_2384":101769},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_2857":59645,"_25170":59611,"_17548":101771,"_5":17443,"_23820":101698,"_2384":101772},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_2857":59646,"_25170":59611,"_17548":101774,"_5":17443,"_23820":101702,"_2384":101775},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_2857":59647,"_25170":59611,"_17548":101777,"_5":17443,"_23820":101702,"_2384":101778},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_2857":59648,"_25170":59611,"_17548":101780,"_5":17443,"_23820":101702,"_2384":101781},[],"Cambios de estado y razones de revocación.",{"_2857":59649,"_25170":59611,"_17548":101783,"_5":17443,"_23820":101702,"_2384":101784},[],"Publicación y vigencia de OCSP y CRLs.",{"_2857":59650,"_25170":59611,"_17548":101786,"_5":17443,"_23820":101702,"_2384":101787},[],"Dependencias que todavía presentan un certificado sustituido.",{"_2857":59651,"_25170":59611,"_17548":101789,"_5":17443,"_23820":101702,"_2384":101790},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_2857":59652,"_25170":59652,"_5":12294,"_2384":101792,"_25485":101793,"_17548":101794,"_23820":59652},"Modelo de confianza",[40817,97227,45842,101659],[],{"_2857":59653,"_25170":59652,"_17548":101796,"_5":17443,"_23820":59652,"_2384":101797},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_2857":59654,"_25170":59652,"_5":25482,"_17548":101799,"_23820":101800,"_2384":101801},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_2857":59655,"_25170":59652,"_5":25482,"_17548":101803,"_23820":101804,"_2384":101805},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_2857":59656,"_25170":59652,"_5":25482,"_17548":101807,"_23820":101808,"_2384":101809},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_2857":59657,"_25170":59652,"_5":25482,"_17548":101811,"_23820":101812,"_2384":101813},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_2857":59658,"_25170":59652,"_5":25482,"_17548":101815,"_23820":101816,"_2384":101817},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_2857":59659,"_25170":59652,"_5":25482,"_17548":101819,"_23820":101820,"_2384":101821},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_2857":59660,"_25170":59652,"_5":25482,"_17548":101823,"_23820":101824,"_2384":101825},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_2857":59661,"_25170":59652,"_5":25482,"_17548":101827,"_23820":101828,"_2384":101829},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_2857":59662,"_25170":59652,"_5":25482,"_17548":101831,"_23820":101832,"_2384":101833},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_2857":59663,"_25170":59652,"_5":25482,"_17548":101835,"_23820":101836,"_2384":101837},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_2857":59664,"_25170":59652,"_17548":101839,"_5":17443,"_23820":59652,"_2384":101840},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_2857":59665,"_25170":59652,"_17548":101842,"_5":17443,"_23820":101804,"_2384":101843},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_2857":59666,"_25170":59652,"_17548":101845,"_5":17443,"_23820":101808,"_2384":101846},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_2857":59667,"_25170":59652,"_17548":101848,"_5":17443,"_23820":101812,"_2384":101849},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_2857":59668,"_25170":59652,"_17548":101851,"_5":17443,"_23820":101816,"_2384":101852},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_2857":59669,"_25170":59652,"_17548":101854,"_5":17443,"_23820":101820,"_2384":101855},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_2857":59670,"_25170":59652,"_17548":101857,"_5":17443,"_23820":101820,"_2384":101858},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_2857":59671,"_25170":59652,"_17548":101860,"_5":17443,"_23820":101820,"_2384":101861},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_2857":59672,"_25170":59652,"_17548":101863,"_5":17443,"_23820":101820,"_2384":101864},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_2857":59673,"_25170":59652,"_17548":101866,"_5":17443,"_23820":101820,"_2384":101867},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_2857":59674,"_25170":59652,"_17548":101869,"_5":17443,"_23820":101820,"_2384":101870},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_2857":59675,"_25170":59652,"_17548":101872,"_5":17443,"_23820":101824,"_2384":101873},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_2857":59676,"_25170":59652,"_17548":101875,"_5":17443,"_23820":101824,"_2384":101876},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_2857":59677,"_25170":59652,"_17548":101878,"_5":17443,"_23820":101824,"_2384":101879},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, Lamassu prueba primero la CA de enrolamiento y después las CAs de validación configuradas en el bloque de re-enrolamiento.",{"_2857":59678,"_25170":59652,"_17548":101881,"_5":17443,"_23820":101824,"_2384":101882},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_2857":59679,"_25170":59652,"_17548":101884,"_5":17443,"_23820":101824,"_2384":101885},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_2857":59680,"_25170":59652,"_17548":101887,"_5":17443,"_23820":101828,"_2384":101888},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_2857":59681,"_25170":59652,"_17548":101890,"_5":17443,"_23820":101828,"_2384":101891},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_2857":59682,"_25170":59652,"_17548":101893,"_5":17443,"_23820":101828,"_2384":101894},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_2857":59683,"_25170":59652,"_17548":101896,"_5":17443,"_23820":101828,"_2384":101897},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_2857":59684,"_25170":59652,"_17548":101899,"_5":17443,"_23820":101828,"_2384":101900},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_2857":59685,"_25170":59652,"_17548":101902,"_5":17443,"_23820":101828,"_2384":101903},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_2857":59686,"_25170":59652,"_17548":101905,"_5":17443,"_23820":101828,"_2384":101906},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_2857":59687,"_25170":59652,"_17548":101908,"_5":17443,"_23820":101832,"_2384":101909},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_2857":59688,"_25170":59652,"_17548":101911,"_5":17443,"_23820":101836,"_2384":101912},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_2857":59689,"_25170":59652,"_17548":101914,"_5":17443,"_23820":101836,"_2384":101915},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_2857":59690,"_25170":59652,"_17548":101917,"_5":17443,"_23820":101836,"_2384":101918},[],"Asigna perfiles explícitos a cada caso de uso.",{"_2857":59691,"_25170":59652,"_17548":101920,"_5":17443,"_23820":101836,"_2384":101921},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_2857":59692,"_25170":59652,"_17548":101923,"_5":17443,"_23820":101836,"_2384":101924},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_2857":59693,"_25170":59652,"_17548":101926,"_5":17443,"_23820":101836,"_2384":101927},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_2857":59694,"_25170":59652,"_17548":101929,"_5":17443,"_23820":101836,"_2384":101930},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_2857":59695,"_25170":59695,"_5":12294,"_2384":101932,"_25485":101933,"_17548":101934,"_23820":59695},"Listas de revocación (CRL)",[40817,97227,45842,101420],[],{"_2857":59696,"_25170":59695,"_17548":101936,"_5":17443,"_23820":59695,"_2384":101937},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_2857":59697,"_25170":59695,"_5":25482,"_17548":101939,"_23820":101940,"_2384":101941},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_2857":59698,"_25170":59695,"_5":25482,"_17548":101943,"_23820":101944,"_2384":101945},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_2857":59699,"_25170":59695,"_5":25482,"_17548":101947,"_23820":101948,"_2384":101949},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_2857":59700,"_25170":59695,"_5":25482,"_17548":101951,"_23820":101952,"_2384":101953},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_2857":59701,"_25170":59695,"_5":25482,"_17548":101955,"_23820":101956,"_2384":101957},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_2857":59702,"_25170":59695,"_5":25482,"_17548":101959,"_23820":101960,"_2384":101961},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_2857":59703,"_25170":59695,"_5":25482,"_17548":101963,"_23820":101964,"_2384":101965},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_2857":59704,"_25170":59695,"_17548":101967,"_5":17443,"_23820":59695,"_2384":101968},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_2857":59705,"_25170":59695,"_17548":101970,"_5":17443,"_23820":101940,"_2384":101971},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_2857":59706,"_25170":59695,"_17548":101973,"_5":17443,"_23820":101940,"_2384":101974},[],"Campo de `crl_options`",{"_2857":59707,"_25170":59695,"_17548":101976,"_5":17443,"_23820":101940,"_2384":98723},[],{"_2857":59708,"_25170":59695,"_17548":101978,"_5":17443,"_23820":101940,"_2384":101979},[],"Valor inicial del backend",{"_2857":59709,"_25170":59695,"_17548":101981,"_5":17443,"_23820":101940,"_2384":47022},[],{"_2857":59710,"_25170":59695,"_17548":101983,"_5":17443,"_23820":101940,"_2384":101984},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_2857":59711,"_25170":59695,"_17548":101986,"_5":17443,"_23820":101940,"_2384":101987},[],"7 días.",{"_2857":59712,"_25170":59695,"_17548":101989,"_5":17443,"_23820":101940,"_2384":47031},[],{"_2857":59713,"_25170":59695,"_17548":101991,"_5":17443,"_23820":101940,"_2384":101992},[],"Plazo desde la publicación que activa la renovación programada.",{"_2857":59714,"_25170":59695,"_17548":101994,"_5":17443,"_23820":101940,"_2384":101995},[],"6 días y 23 horas.",{"_2857":59715,"_25170":59695,"_17548":101997,"_5":17443,"_23820":101940,"_2384":47040},[],{"_2857":59716,"_25170":59695,"_17548":101999,"_5":17443,"_23820":101940,"_2384":102000},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_2857":59717,"_25170":59695,"_17548":102002,"_5":17443,"_23820":101940,"_2384":47046},[],{"_2857":59718,"_25170":59695,"_17548":102004,"_5":17443,"_23820":101940,"_2384":47049},[],{"_2857":59719,"_25170":59695,"_17548":102006,"_5":17443,"_23820":101940,"_2384":102007},[],"Campo de configuración inicializado con el SKI de la CA.",{"_2857":59720,"_25170":59695,"_17548":102009,"_5":17443,"_23820":101940,"_2384":102010},[],"SKI de la CA.",{"_2857":59721,"_25170":59695,"_17548":102012,"_5":17443,"_23820":101940,"_2384":102013},[],"El generador utiliza la clave de la CA identificada por el SKI solicitado. No interpretes `subject_key_id_signer` como soporte verificado de una CA delegada distinta: cambiar el campo no cambia el firmante en ese flujo.",{"_2857":59722,"_25170":59695,"_17548":102015,"_5":17443,"_23820":101940,"_2384":102016},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_2857":59723,"_25170":59695,"_17548":102018,"_5":17443,"_23820":101944,"_2384":102019},[],"El trabajo programado solicita otra lista cuando se alcanza `refresh_interval` o cuando la lista está próxima a vencer según el periodo de vigilancia configurado. Esto depende de que el trabajo, almacenamiento y firma funcionen; no garantiza renovación ante un fallo del servicio.",{"_2857":59724,"_25170":59695,"_17548":102021,"_5":17443,"_23820":101944,"_2384":102022},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_2857":59725,"_25170":59695,"_17548":102024,"_5":17443,"_23820":101944,"_2384":102025},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_2857":59726,"_25170":59695,"_17548":102027,"_5":17443,"_23820":101948,"_2384":102028},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_2857":59727,"_25170":59695,"_17548":102030,"_5":17443,"_23820":101948,"_2384":102031},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_2857":59728,"_25170":59695,"_17548":102033,"_5":17443,"_23820":101952,"_2384":102034},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_2857":59729,"_25170":59695,"_17548":102036,"_5":17443,"_23820":101952,"_2384":102037},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_2857":59730,"_25170":59695,"_17548":102039,"_5":17443,"_23820":101952,"_2384":102040},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_2857":59731,"_25170":59695,"_17548":102042,"_5":17443,"_23820":101952,"_2384":102043},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_2857":59732,"_25170":59695,"_17548":102045,"_5":17443,"_23820":101952,"_2384":102046},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_2857":59733,"_25170":59695,"_17548":102048,"_5":17443,"_23820":101956,"_2384":102049},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_2857":59734,"_25170":59695,"_17548":102051,"_5":17443,"_23820":101956,"_2384":98912},[],{"_2857":59735,"_25170":59695,"_17548":102053,"_5":17443,"_23820":101956,"_2384":102054},[],"Path relativo",{"_2857":59736,"_25170":59695,"_17548":102056,"_5":17443,"_23820":101956,"_2384":97018},[],{"_2857":59737,"_25170":59695,"_17548":102058,"_5":17443,"_23820":101956,"_2384":47104},[],{"_2857":59738,"_25170":59695,"_17548":102060,"_5":17443,"_23820":101956,"_2384":47107},[],{"_2857":59739,"_25170":59695,"_17548":102062,"_5":17443,"_23820":101956,"_2384":102063},[],"Consultar `crl_options` y `latest_crl`.",{"_2857":59740,"_25170":59695,"_17548":102065,"_5":17443,"_23820":101956,"_2384":47113},[],{"_2857":59741,"_25170":59695,"_17548":102067,"_5":17443,"_23820":101956,"_2384":47107},[],{"_2857":59742,"_25170":59695,"_17548":102069,"_5":17443,"_23820":101956,"_2384":102070},[],"Sustituir la configuración de CRL.",{"_2857":59743,"_25170":59695,"_17548":102072,"_5":17443,"_23820":101956,"_2384":102073},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_2857":59744,"_25170":59695,"_17548":102075,"_5":17443,"_23820":101956,"_2384":102076},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_2857":59745,"_25170":59695,"_17548":102078,"_5":17443,"_23820":101960,"_2384":102079},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_2857":59746,"_25170":59695,"_17548":102081,"_5":17443,"_23820":101964,"_2384":102082},[],"RFC 5280: perfil X.509 y CRL.",{"_2857":59747,"_25170":59695,"_17548":102084,"_5":17443,"_23820":101964,"_2384":47133},[],{"_2857":59748,"_25170":59695,"_17548":102086,"_5":17443,"_23820":101964,"_2384":47136},[],{"_2857":59749,"_25170":59695,"_17548":102088,"_5":17443,"_23820":101964,"_2384":102089},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_2857":59750,"_25170":59695,"_17548":102091,"_5":17443,"_23820":101964,"_2384":102092},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2857":59751,"_25170":59751,"_5":12294,"_2384":102094,"_25485":102095,"_17548":102096,"_23820":59751},"Claves y motores criptográficos",[40817,97227,45842,100805],[],{"_2857":59752,"_25170":59751,"_17548":102098,"_5":17443,"_23820":59751,"_2384":102099},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_2857":59753,"_25170":59751,"_5":25482,"_17548":102101,"_23820":102102,"_2384":102103},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_2857":59754,"_25170":59751,"_5":25482,"_17548":102105,"_23820":102106,"_2384":102107},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_2857":59755,"_25170":59751,"_5":25482,"_17548":102109,"_23820":102110,"_2384":47161},[],"/docs/es/platform/pki/key-management#file-system",{"_2857":59756,"_25170":59751,"_5":25482,"_17548":102112,"_23820":102113,"_2384":47165},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_2857":59757,"_25170":59751,"_5":25482,"_17548":102115,"_23820":102116,"_2384":47169},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_2857":59758,"_25170":59751,"_5":25482,"_17548":102118,"_23820":102119,"_2384":47173},[],"/docs/es/platform/pki/key-management#aws-kms",{"_2857":59759,"_25170":59751,"_5":25482,"_17548":102121,"_23820":102122,"_2384":47177},[],"/docs/es/platform/pki/key-management#pkcs11",{"_2857":59760,"_25170":59751,"_5":25482,"_17548":102124,"_23820":102125,"_2384":47181},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_2857":59761,"_25170":59751,"_5":25482,"_17548":102127,"_23820":102128,"_2384":102129},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_2857":59762,"_25170":59751,"_5":25482,"_17548":102131,"_23820":102132,"_2384":102133},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_2857":59763,"_25170":59751,"_5":25482,"_17548":102135,"_23820":102136,"_2384":102137},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_2857":59764,"_25170":59751,"_5":25482,"_17548":102139,"_23820":102140,"_2384":102141},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_2857":59765,"_25170":59751,"_5":25482,"_17548":102143,"_23820":102144,"_2384":102145},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_2857":59766,"_25170":59751,"_5":25482,"_17548":102147,"_23820":102148,"_2384":102149},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_2857":59767,"_25170":59751,"_5":25482,"_17548":102151,"_23820":102152,"_2384":102153},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_2857":59768,"_25170":59751,"_5":25482,"_17548":102155,"_23820":102156,"_2384":47213},[],"/docs/es/platform/pki/key-management#sign",{"_2857":59769,"_25170":59751,"_5":25482,"_17548":102158,"_23820":102159,"_2384":47217},[],"/docs/es/platform/pki/key-management#verify",{"_2857":59770,"_25170":59751,"_5":25482,"_17548":102161,"_23820":102162,"_2384":102163},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_2857":59771,"_25170":59751,"_5":25482,"_17548":102165,"_23820":102166,"_2384":102167},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_2857":59772,"_25170":59751,"_5":25482,"_17548":102169,"_23820":102170,"_2384":102171},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_2857":59773,"_25170":59751,"_17548":102173,"_5":17443,"_23820":59751,"_2384":102174},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_2857":59774,"_25170":59751,"_17548":102176,"_5":17443,"_23820":59751,"_2384":102177},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_2857":59775,"_25170":59751,"_17548":102179,"_5":17443,"_23820":102102,"_2384":102180},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_2857":59776,"_25170":59751,"_17548":102182,"_5":17443,"_23820":102102,"_2384":102183},[],"En la práctica, permite:",{"_2857":59777,"_25170":59751,"_17548":102185,"_5":17443,"_23820":102102,"_2384":102186},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_2857":59778,"_25170":59751,"_17548":102188,"_5":17443,"_23820":102102,"_2384":102189},[],"Importar claves creadas externamente.",{"_2857":59779,"_25170":59751,"_17548":102191,"_5":17443,"_23820":102102,"_2384":102192},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_2857":59780,"_25170":59751,"_17548":102194,"_5":17443,"_23820":102102,"_2384":102195},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_2857":59781,"_25170":59751,"_17548":102197,"_5":17443,"_23820":102106,"_2384":102198},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_2857":59782,"_25170":59751,"_17548":102200,"_5":17443,"_23820":102106,"_2384":102201},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_2857":59783,"_25170":59751,"_17548":102203,"_5":17443,"_23820":102106,"_2384":102204},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_2857":59784,"_25170":59751,"_17548":102206,"_5":17443,"_23820":102110,"_2384":102207},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_2857":59785,"_25170":59751,"_17548":102209,"_5":17443,"_23820":102113,"_2384":102210},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_2857":59786,"_25170":59751,"_17548":102212,"_5":17443,"_23820":102116,"_2384":102213},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_2857":59787,"_25170":59751,"_17548":102215,"_5":17443,"_23820":102119,"_2384":102216},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_2857":59788,"_25170":59751,"_17548":102218,"_5":17443,"_23820":102122,"_2384":102219},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_2857":59789,"_25170":59751,"_17548":102221,"_5":17443,"_23820":102125,"_2384":102222},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_2857":59790,"_25170":59751,"_17548":102224,"_5":17443,"_23820":102125,"_2384":102225},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_2857":59791,"_25170":59751,"_17548":102227,"_5":17443,"_23820":102125,"_2384":102228},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_2857":59792,"_25170":59751,"_17548":102230,"_5":17443,"_23820":102125,"_2384":102231},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_2857":59793,"_25170":59751,"_17548":102233,"_5":17443,"_23820":102128,"_2384":102234},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_2857":59794,"_25170":59751,"_17548":102236,"_5":17443,"_23820":102128,"_2384":102237},[],"La tabla incluye los siguientes campos:",{"_2857":59795,"_25170":59751,"_17548":102239,"_5":17443,"_23820":102128,"_2384":102240},[],"**Name**: nombre descriptivo de la clave.",{"_2857":59796,"_25170":59751,"_17548":102242,"_5":17443,"_23820":102128,"_2384":102243},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_2857":59797,"_25170":59751,"_17548":102245,"_5":17443,"_23820":102128,"_2384":102246},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_2857":59798,"_25170":59751,"_17548":102248,"_5":17443,"_23820":102128,"_2384":102249},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_2857":59799,"_25170":59751,"_17548":102251,"_5":17443,"_23820":102128,"_2384":102252},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_2857":59800,"_25170":59751,"_17548":102254,"_5":17443,"_23820":102128,"_2384":102255},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_2857":59801,"_25170":59751,"_17548":102257,"_5":17443,"_23820":102128,"_2384":102258},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_2857":59802,"_25170":59751,"_17548":102260,"_5":17443,"_23820":102128,"_2384":102261},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_2857":59803,"_25170":59751,"_17548":102263,"_5":17443,"_23820":102128,"_2384":102264},[],"Desde esta vista también se accede a las acciones más habituales:",{"_2857":59804,"_25170":59751,"_17548":102266,"_5":17443,"_23820":102128,"_2384":102267},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_2857":59805,"_25170":59751,"_17548":102269,"_5":17443,"_23820":102128,"_2384":102270},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_2857":59806,"_25170":59751,"_17548":102272,"_5":17443,"_23820":102128,"_2384":102273},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_2857":59807,"_25170":59751,"_17548":102275,"_5":17443,"_23820":102128,"_2384":102276},[],"**Delete Key** para eliminar la clave del sistema.",{"_2857":59808,"_25170":59751,"_17548":102278,"_5":17443,"_23820":102132,"_2384":102279},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_2857":59809,"_25170":59751,"_17548":102281,"_5":17443,"_23820":102136,"_2384":102282},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_2857":59810,"_25170":59751,"_17548":102284,"_5":17443,"_23820":102136,"_2384":102285},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_2857":59811,"_25170":59751,"_17548":102287,"_5":17443,"_23820":102136,"_2384":102288},[],"**Key Name**: nombre único y descriptivo.",{"_2857":59812,"_25170":59751,"_17548":102290,"_5":17443,"_23820":102136,"_2384":102291},[],"**Crypto Engine**: motor que custodiará la clave.",{"_2857":59813,"_25170":59751,"_17548":102293,"_5":17443,"_23820":102136,"_2384":102294},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_2857":59814,"_25170":59751,"_17548":102296,"_5":17443,"_23820":102136,"_2384":102297},[],"**Tags**: metadatos para clasificar la clave.",{"_2857":59815,"_25170":59751,"_17548":102299,"_5":17443,"_23820":102136,"_2384":102300},[],"**Metadata**: información adicional para usos avanzados.",{"_2857":59816,"_25170":59751,"_17548":102302,"_5":17443,"_23820":102140,"_2384":102303},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_2857":59817,"_25170":59751,"_17548":102305,"_5":17443,"_23820":102140,"_2384":102306},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_2857":59818,"_25170":59751,"_17548":102308,"_5":17443,"_23820":102140,"_2384":102309},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_2857":59819,"_25170":59751,"_17548":102311,"_5":17443,"_23820":102140,"_2384":102312},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_2857":59820,"_25170":59751,"_17548":102314,"_5":17443,"_23820":102140,"_2384":102315},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_2857":59821,"_25170":59751,"_17548":102317,"_5":17443,"_23820":102140,"_2384":102318},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_2857":59822,"_25170":59751,"_17548":102320,"_5":17443,"_23820":102140,"_2384":102321},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_2857":59823,"_25170":59751,"_17548":102323,"_5":17443,"_23820":102140,"_2384":102324},[],"**Tags**: etiquetas para organización y búsqueda.",{"_2857":59824,"_25170":59751,"_17548":102326,"_5":17443,"_23820":102140,"_2384":102327},[],"**Metadata**: información adicional opcional.",{"_2857":59825,"_25170":59751,"_17548":102329,"_5":17443,"_23820":102140,"_2384":102330},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_2857":59826,"_25170":59751,"_17548":102332,"_5":17443,"_23820":102140,"_2384":102333},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_2857":59827,"_25170":59751,"_17548":102335,"_5":17443,"_23820":102144,"_2384":102336},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_2857":59828,"_25170":59751,"_17548":102338,"_5":17443,"_23820":102148,"_2384":102339},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_2857":59829,"_25170":59751,"_17548":102341,"_5":17443,"_23820":102148,"_2384":102342},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_2857":59830,"_25170":59751,"_17548":102344,"_5":17443,"_23820":102148,"_2384":102345},[],"**Key Name**: nombre descriptivo.",{"_2857":59831,"_25170":59751,"_17548":102347,"_5":17443,"_23820":102148,"_2384":102348},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_2857":59832,"_25170":59751,"_17548":102350,"_5":17443,"_23820":102148,"_2384":102351},[],"**Tags**: etiquetas asociadas.",{"_2857":59833,"_25170":59751,"_17548":102353,"_5":17443,"_23820":102148,"_2384":102354},[],"**Aliases**: nombres alternativos.",{"_2857":59834,"_25170":59751,"_17548":102356,"_5":17443,"_23820":102148,"_2384":102357},[],"**Crypto Engine**: motor en el que reside la clave.",{"_2857":59835,"_25170":59751,"_17548":102359,"_5":17443,"_23820":102148,"_2384":102360},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_2857":59836,"_25170":59751,"_17548":102362,"_5":17443,"_23820":102148,"_2384":102363},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_2857":59837,"_25170":59751,"_17548":102365,"_5":17443,"_23820":102148,"_2384":102366},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_2857":59838,"_25170":59751,"_17548":102368,"_5":17443,"_23820":102152,"_2384":102369},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_2857":59839,"_25170":59751,"_17548":102371,"_5":17443,"_23820":102152,"_2384":102372},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_2857":59840,"_25170":59751,"_17548":102374,"_5":17443,"_23820":102152,"_2384":102375},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_2857":59841,"_25170":59751,"_17548":102377,"_5":17443,"_23820":102156,"_2384":102378},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_2857":59842,"_25170":59751,"_17548":102380,"_5":17443,"_23820":102156,"_2384":102381},[],"Campos principales:",{"_2857":59843,"_25170":59751,"_17548":102383,"_5":17443,"_23820":102156,"_2384":102384},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_2857":59844,"_25170":59751,"_17548":102386,"_5":17443,"_23820":102156,"_2384":102387},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_2857":59845,"_25170":59751,"_17548":102389,"_5":17443,"_23820":102156,"_2384":102390},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_2857":59846,"_25170":59751,"_17548":102392,"_5":17443,"_23820":102156,"_2384":102393},[],"**Message**: contenido que se va a firmar.",{"_2857":59847,"_25170":59751,"_17548":102395,"_5":17443,"_23820":102156,"_2384":102396},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_2857":59848,"_25170":59751,"_17548":102398,"_5":17443,"_23820":102159,"_2384":102399},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_2857":59849,"_25170":59751,"_17548":102401,"_5":17443,"_23820":102159,"_2384":102381},[],{"_2857":59850,"_25170":59751,"_17548":102403,"_5":17443,"_23820":102159,"_2384":102404},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_2857":59851,"_25170":59751,"_17548":102406,"_5":17443,"_23820":102159,"_2384":102407},[],"**Message Type**: `Raw` o `Digest`.",{"_2857":59852,"_25170":59751,"_17548":102409,"_5":17443,"_23820":102159,"_2384":102410},[],"**Payload Encoding**: codificación del mensaje.",{"_2857":59853,"_25170":59751,"_17548":102412,"_5":17443,"_23820":102159,"_2384":102413},[],"**Message**: mensaje original o hash.",{"_2857":59854,"_25170":59751,"_17548":102415,"_5":17443,"_23820":102159,"_2384":102416},[],"**Signature**: firma que se desea comprobar.",{"_2857":59855,"_25170":59751,"_17548":102418,"_5":17443,"_23820":102159,"_2384":102419},[],"**Result**: indicador del resultado de la validación.",{"_2857":59856,"_25170":59751,"_17548":102421,"_5":17443,"_23820":102162,"_2384":102422},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_2857":59857,"_25170":59751,"_17548":102424,"_5":17443,"_23820":102162,"_2384":102425},[],"Este flujo es útil para:",{"_2857":59858,"_25170":59751,"_17548":102427,"_5":17443,"_23820":102162,"_2384":102428},[],"Solicitar certificados a una CA externa.",{"_2857":59859,"_25170":59751,"_17548":102430,"_5":17443,"_23820":102162,"_2384":102431},[],"Renovar una identidad manteniendo la misma clave.",{"_2857":59860,"_25170":59751,"_17548":102433,"_5":17443,"_23820":102162,"_2384":102434},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_2857":59861,"_25170":59751,"_17548":102436,"_5":17443,"_23820":102162,"_2384":102437},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_2857":59862,"_25170":59751,"_17548":102439,"_5":17443,"_23820":102162,"_2384":102440},[],"**Organization (O)**: organización o empresa.",{"_2857":59863,"_25170":59751,"_17548":102442,"_5":17443,"_23820":102162,"_2384":102443},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_2857":59864,"_25170":59751,"_17548":102445,"_5":17443,"_23820":102162,"_2384":102446},[],"**Country (C)**: código de país de dos letras.",{"_2857":59865,"_25170":59751,"_17548":102448,"_5":17443,"_23820":102162,"_2384":102449},[],"**State / Province (ST)**: estado o provincia.",{"_2857":59866,"_25170":59751,"_17548":102451,"_5":17443,"_23820":102162,"_2384":102452},[],"**Locality (L)**: ciudad o localidad.",{"_2857":59867,"_25170":59751,"_17548":102454,"_5":17443,"_23820":102162,"_2384":102455},[],"**Email Address**: correo de contacto.",{"_2857":59868,"_25170":59751,"_17548":102457,"_5":17443,"_23820":102162,"_2384":102458},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_2857":59869,"_25170":59751,"_17548":102460,"_5":17443,"_23820":102162,"_2384":102461},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_2857":59870,"_25170":59751,"_17548":102463,"_5":17443,"_23820":102166,"_2384":102464},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_2857":59871,"_25170":59751,"_17548":102466,"_5":17443,"_23820":102166,"_2384":47525},[],{"_2857":59872,"_25170":59751,"_17548":102468,"_5":17443,"_23820":102170,"_2384":102469},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_2857":59873,"_25170":59873,"_5":12294,"_2384":102471,"_25485":102472,"_17548":102473,"_23820":59873},"Validación online con OCSP",[40817,97227,45842,101420],[],{"_2857":59874,"_25170":59873,"_17548":102475,"_5":17443,"_23820":59873,"_2384":102476},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_2857":59875,"_25170":59873,"_5":25482,"_17548":102478,"_23820":102479,"_2384":102480},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_2857":59876,"_25170":59873,"_5":25482,"_17548":102482,"_23820":102483,"_2384":102484},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_2857":59877,"_25170":59873,"_5":25482,"_17548":102486,"_23820":102487,"_2384":102488},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_2857":59878,"_25170":59873,"_5":25482,"_17548":102490,"_23820":102491,"_2384":102492},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_2857":59879,"_25170":59873,"_5":25482,"_17548":102494,"_23820":102495,"_2384":102496},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_2857":59880,"_25170":59873,"_5":25482,"_17548":102498,"_23820":102499,"_2384":101965},[],"/docs/es/platform/pki/ocsp#referencias",{"_2857":59881,"_25170":59873,"_17548":102501,"_5":17443,"_23820":59873,"_2384":102502},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_2857":59882,"_25170":59873,"_17548":102504,"_5":17443,"_23820":102479,"_2384":102505},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_2857":59883,"_25170":59873,"_17548":102507,"_5":17443,"_23820":102479,"_2384":102508},[],"Estado del registro",{"_2857":59884,"_25170":59873,"_17548":102510,"_5":17443,"_23820":102479,"_2384":102511},[],"Respuesta firmada",{"_2857":59885,"_25170":59873,"_17548":102513,"_5":17443,"_23820":102479,"_2384":45020},[],{"_2857":59886,"_25170":59873,"_17548":102515,"_5":17443,"_23820":102479,"_2384":47575},[],{"_2857":59887,"_25170":59873,"_17548":102517,"_5":17443,"_23820":102479,"_2384":45037},[],{"_2857":59888,"_25170":59873,"_17548":102519,"_5":17443,"_23820":102479,"_2384":102520},[],"`Revoked`, con razón y fecha de revocación.",{"_2857":59889,"_25170":59873,"_17548":102522,"_5":17443,"_23820":102479,"_2384":102523},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_2857":59890,"_25170":59873,"_17548":102525,"_5":17443,"_23820":102479,"_2384":102526},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_2857":59891,"_25170":59873,"_17548":102528,"_5":17443,"_23820":102479,"_2384":102529},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_2857":59892,"_25170":59873,"_17548":102531,"_5":17443,"_23820":102479,"_2384":102532},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_2857":59893,"_25170":59873,"_17548":102534,"_5":17443,"_23820":102479,"_2384":102535},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_2857":59894,"_25170":59873,"_17548":102537,"_5":17443,"_23820":102483,"_2384":102538},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_2857":59895,"_25170":59873,"_17548":102540,"_5":17443,"_23820":102483,"_2384":102541},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_2857":59896,"_25170":59873,"_17548":102543,"_5":17443,"_23820":102487,"_2384":102544},[],"El servicio acepta:",{"_2857":59897,"_25170":59873,"_17548":102546,"_5":17443,"_23820":102487,"_2384":98912},[],{"_2857":59898,"_25170":59873,"_17548":102548,"_5":17443,"_23820":102487,"_2384":102549},[],"Ruta del servicio VA",{"_2857":59899,"_25170":59873,"_17548":102551,"_5":17443,"_23820":102487,"_2384":102552},[],"Formato",{"_2857":59900,"_25170":59873,"_17548":102554,"_5":17443,"_23820":102487,"_2384":47615},[],{"_2857":59901,"_25170":59873,"_17548":102556,"_5":17443,"_23820":102487,"_2384":47618},[],{"_2857":59902,"_25170":59873,"_17548":102558,"_5":17443,"_23820":102487,"_2384":102559},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_2857":59903,"_25170":59873,"_17548":102561,"_5":17443,"_23820":102487,"_2384":47104},[],{"_2857":59904,"_25170":59873,"_17548":102563,"_5":17443,"_23820":102487,"_2384":47626},[],{"_2857":59905,"_25170":59873,"_17548":102565,"_5":17443,"_23820":102487,"_2384":102566},[],"Solicitud DER codificada en Base64 URL con padding.",{"_2857":59906,"_25170":59873,"_17548":102568,"_5":17443,"_23820":102487,"_2384":102569},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_2857":59907,"_25170":59873,"_17548":102571,"_5":17443,"_23820":102491,"_2384":102572},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_2857":59908,"_25170":59873,"_17548":102574,"_5":17443,"_23820":102491,"_2384":102575},[],"Genera la solicitud:",{"_2857":59909,"_25170":59873,"_17548":102577,"_5":17443,"_23820":102491,"_2384":102578},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_2857":59910,"_25170":59873,"_17548":102580,"_5":17443,"_23820":102491,"_2384":102581},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_2857":59911,"_25170":59873,"_17548":102583,"_5":17443,"_23820":102491,"_2384":102584},[],"Verifica el DER recibido:",{"_2857":59912,"_25170":59873,"_17548":102586,"_5":17443,"_23820":102491,"_2384":102587},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_2857":59913,"_25170":59873,"_17548":102589,"_5":17443,"_23820":102495,"_2384":102590},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_2857":59914,"_25170":59873,"_17548":102592,"_5":17443,"_23820":102495,"_2384":102593},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_2857":59915,"_25170":59873,"_17548":102595,"_5":17443,"_23820":102499,"_2384":47659},[],{"_2857":59916,"_25170":59873,"_17548":102597,"_5":17443,"_23820":102499,"_2384":47662},[],{"_2857":59917,"_25170":59873,"_17548":102599,"_5":17443,"_23820":102499,"_2384":102600},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_2857":59918,"_25170":59873,"_17548":102602,"_5":17443,"_23820":102499,"_2384":102092},[],{"_2857":59919,"_25170":59919,"_5":12294,"_2384":45842,"_25485":102604,"_17548":102605,"_23820":59919},[40817,97227,45842],[],{"_2857":59920,"_25170":59919,"_17548":102607,"_5":17443,"_23820":59919,"_2384":102608},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_2857":59921,"_25170":59919,"_5":25482,"_17548":102610,"_23820":102611,"_2384":100129},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_2857":59922,"_25170":59919,"_5":25482,"_17548":102613,"_23820":102614,"_2384":102615},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_2857":59923,"_25170":59919,"_5":25482,"_17548":102617,"_23820":102618,"_2384":100651},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_2857":59924,"_25170":59919,"_5":25482,"_17548":102620,"_23820":102621,"_2384":100655},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_2857":59925,"_25170":59919,"_5":25482,"_17548":102623,"_23820":102624,"_2384":100659},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_2857":59926,"_25170":59919,"_5":25482,"_17548":102626,"_23820":102627,"_2384":100663},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_2857":59927,"_25170":59919,"_5":25482,"_17548":102629,"_23820":102630,"_2384":100671},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_2857":59928,"_25170":59919,"_5":25482,"_17548":102632,"_23820":102633,"_2384":102634},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_2857":59929,"_25170":59919,"_5":25482,"_17548":102636,"_23820":102637,"_2384":101586},[],"/docs/es/platform/pki/overview#continúa",{"_2857":59930,"_25170":59919,"_17548":102639,"_5":17443,"_23820":59919,"_2384":102640},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_2857":59931,"_25170":59919,"_17548":102642,"_5":17443,"_23820":102611,"_2384":102643},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_2857":59932,"_25170":59919,"_17548":102645,"_5":17443,"_23820":102611,"_2384":102646},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_2857":59933,"_25170":59919,"_17548":102648,"_5":17443,"_23820":102614,"_2384":102649},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_2857":59934,"_25170":59919,"_17548":102651,"_5":17443,"_23820":102614,"_2384":102652},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_2857":59935,"_25170":59919,"_17548":102654,"_5":17443,"_23820":102614,"_2384":102655},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_2857":59936,"_25170":59919,"_17548":102657,"_5":17443,"_23820":102614,"_2384":102658},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_2857":59937,"_25170":59919,"_17548":102660,"_5":17443,"_23820":102614,"_2384":102661},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_2857":59938,"_25170":59919,"_17548":102663,"_5":17443,"_23820":102621,"_2384":102664},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_2857":59939,"_25170":59919,"_17548":102666,"_5":17443,"_23820":102624,"_2384":102667},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_2857":59940,"_25170":59919,"_17548":102669,"_5":17443,"_23820":102627,"_2384":102670},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_2857":59941,"_25170":59919,"_17548":102672,"_5":17443,"_23820":102630,"_2384":102673},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_2857":59942,"_25170":59919,"_17548":102675,"_5":17443,"_23820":102633,"_2384":102676},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_2857":59943,"_25170":59919,"_17548":102678,"_5":17443,"_23820":102633,"_2384":102679},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_2857":59944,"_25170":59919,"_17548":102681,"_5":17443,"_23820":102633,"_2384":102682},[],"su clave pública corresponda a la clave privada del cliente;",{"_2857":59945,"_25170":59919,"_17548":102684,"_5":17443,"_23820":102633,"_2384":102685},[],"su cadena alcance una raíz confiable para el consumidor;",{"_2857":59946,"_25170":59919,"_17548":102687,"_5":17443,"_23820":102633,"_2384":102688},[],"sus fechas y usos permitan la operación;",{"_2857":59947,"_25170":59919,"_17548":102690,"_5":17443,"_23820":102633,"_2384":102691},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_2857":59948,"_25170":59919,"_17548":102693,"_5":17443,"_23820":102633,"_2384":102694},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_2857":59949,"_25170":59919,"_17548":102696,"_5":17443,"_23820":102637,"_2384":102697},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2857":59950,"_25170":59919,"_17548":102699,"_5":17443,"_23820":102637,"_2384":102700},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2857":59951,"_25170":59919,"_17548":102702,"_5":17443,"_23820":102637,"_2384":102703},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2857":59952,"_25170":59952,"_5":12294,"_2384":102705,"_25485":102706,"_17548":102707,"_23820":59952},"Crea tu primera CA",[40817,97227,45842,100253],[],{"_2857":59953,"_25170":59952,"_17548":102709,"_5":17443,"_23820":59952,"_2384":102710},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_2857":59954,"_25170":59952,"_5":25482,"_17548":102712,"_23820":102713,"_2384":95928},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_2857":59955,"_25170":59952,"_5":25482,"_17548":102715,"_23820":102716,"_2384":102717},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_2857":59956,"_25170":59952,"_5":25482,"_17548":102719,"_23820":102720,"_2384":102721},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_2857":59957,"_25170":59952,"_5":25482,"_17548":102723,"_23820":102724,"_2384":102725},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_2857":59958,"_25170":59952,"_5":25482,"_17548":102727,"_23820":102728,"_2384":102729},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_2857":59959,"_25170":59952,"_5":25482,"_17548":102731,"_23820":102732,"_2384":102733},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_2857":59960,"_25170":59952,"_5":25482,"_17548":102735,"_23820":102736,"_2384":102737},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_2857":59961,"_25170":59952,"_5":25482,"_17548":102739,"_23820":102740,"_2384":100501},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_2857":59962,"_25170":59952,"_5":25482,"_17548":102742,"_23820":102743,"_2384":95952},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_2857":59963,"_25170":59952,"_17548":102745,"_5":17443,"_23820":59952,"_2384":102746},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_2857":59964,"_25170":59952,"_17548":102748,"_5":17443,"_23820":102713,"_2384":102749},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_2857":59965,"_25170":59952,"_17548":102751,"_5":17443,"_23820":102713,"_2384":102752},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_2857":59966,"_25170":59952,"_17548":102754,"_5":17443,"_23820":102713,"_2384":102755},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_2857":59967,"_25170":59952,"_17548":102757,"_5":17443,"_23820":102713,"_2384":102758},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_2857":59968,"_25170":59952,"_17548":102760,"_5":17443,"_23820":102716,"_2384":102761},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_2857":59969,"_25170":59952,"_17548":102763,"_5":17443,"_23820":102716,"_2384":102764},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_2857":59970,"_25170":59952,"_17548":102766,"_5":17443,"_23820":102720,"_2384":102767},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_2857":59971,"_25170":59952,"_17548":102769,"_5":17443,"_23820":102720,"_2384":102770},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_2857":59972,"_25170":59952,"_17548":102772,"_5":17443,"_23820":102724,"_2384":102773},[],"Selecciona **Root CA** y completa:",{"_2857":59973,"_25170":59952,"_17548":102775,"_5":17443,"_23820":102724,"_2384":47841},[],{"_2857":59974,"_25170":59952,"_17548":102777,"_5":17443,"_23820":102724,"_2384":102778},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_2857":59975,"_25170":59952,"_17548":102780,"_5":17443,"_23820":102724,"_2384":102781},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_2857":59976,"_25170":59952,"_17548":102783,"_5":17443,"_23820":102724,"_2384":102784},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_2857":59977,"_25170":59952,"_17548":102786,"_5":17443,"_23820":102724,"_2384":102787},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_2857":59978,"_25170":59952,"_17548":102789,"_5":17443,"_23820":102728,"_2384":102790},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_2857":59979,"_25170":59952,"_17548":102792,"_5":17443,"_23820":102732,"_2384":102793},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_2857":59980,"_25170":59952,"_17548":102795,"_5":17443,"_23820":102732,"_2384":102796},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_2857":59981,"_25170":59952,"_17548":102798,"_5":17443,"_23820":102736,"_2384":102799},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_2857":59982,"_25170":59952,"_17548":102801,"_5":17443,"_23820":102736,"_2384":102802},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_2857":59983,"_25170":59952,"_17548":102804,"_5":17443,"_23820":102736,"_2384":102805},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_2857":59984,"_25170":59952,"_17548":102807,"_5":17443,"_23820":102740,"_2384":102808},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_2857":59985,"_25170":59952,"_17548":102810,"_5":17443,"_23820":102740,"_2384":102811},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_2857":59986,"_25170":59952,"_17548":102813,"_5":17443,"_23820":102740,"_2384":102814},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_2857":59987,"_25170":59952,"_17548":102816,"_5":17443,"_23820":102740,"_2384":102817},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_2857":59988,"_25170":59952,"_17548":102819,"_5":17443,"_23820":102743,"_2384":102820},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_2857":59989,"_25170":59989,"_5":12294,"_2384":102822,"_25485":102823,"_17548":102824,"_23820":59989},"Emite y verifica un certificado",[40817,97227,45842,100253],[],{"_2857":59990,"_25170":59989,"_17548":102826,"_5":17443,"_23820":59989,"_2384":102827},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_2857":59991,"_25170":59989,"_5":25482,"_17548":102829,"_23820":102830,"_2384":95928},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_2857":59992,"_25170":59989,"_5":25482,"_17548":102832,"_23820":102833,"_2384":102834},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_2857":59993,"_25170":59989,"_5":25482,"_17548":102836,"_23820":102837,"_2384":102838},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_2857":59994,"_25170":59989,"_5":25482,"_17548":102840,"_23820":102841,"_2384":102842},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_2857":59995,"_25170":59989,"_5":25482,"_17548":102844,"_23820":102845,"_2384":102846},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_2857":59996,"_25170":59989,"_5":25482,"_17548":102848,"_23820":102849,"_2384":102850},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_2857":59997,"_25170":59989,"_5":25482,"_17548":102852,"_23820":102853,"_2384":102733},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_2857":59998,"_25170":59989,"_5":25482,"_17548":102855,"_23820":102856,"_2384":102857},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_2857":59999,"_25170":59989,"_5":25482,"_17548":102859,"_23820":102860,"_2384":102861},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_2857":60000,"_25170":59989,"_5":25482,"_17548":102863,"_23820":102864,"_2384":102865},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_2857":60001,"_25170":59989,"_5":25482,"_17548":102867,"_23820":102868,"_2384":100501},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_2857":60002,"_25170":59989,"_5":25482,"_17548":102870,"_23820":102871,"_2384":95952},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_2857":60003,"_25170":59989,"_17548":102873,"_5":17443,"_23820":59989,"_2384":102874},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_2857":60004,"_25170":59989,"_17548":102876,"_5":17443,"_23820":102830,"_2384":102877},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_2857":60005,"_25170":59989,"_17548":102879,"_5":17443,"_23820":102830,"_2384":102880},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_2857":60006,"_25170":59989,"_17548":102882,"_5":17443,"_23820":102830,"_2384":102883},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_2857":60007,"_25170":59989,"_17548":102885,"_5":17443,"_23820":102830,"_2384":102886},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_2857":60008,"_25170":59989,"_17548":102888,"_5":17443,"_23820":102830,"_2384":102889},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_2857":60009,"_25170":59989,"_17548":102891,"_5":17443,"_23820":102833,"_2384":102892},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_2857":60010,"_25170":59989,"_17548":102894,"_5":17443,"_23820":102837,"_2384":102895},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_2857":60011,"_25170":59989,"_17548":102897,"_5":17443,"_23820":102837,"_2384":102898},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_2857":60012,"_25170":59989,"_17548":102900,"_5":17443,"_23820":102841,"_2384":102901},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_2857":60013,"_25170":59989,"_17548":102903,"_5":17443,"_23820":102841,"_2384":102904},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_2857":60014,"_25170":59989,"_17548":102906,"_5":17443,"_23820":102845,"_2384":102907},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_2857":60015,"_25170":59989,"_17548":102909,"_5":17443,"_23820":102845,"_2384":102910},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_2857":60016,"_25170":59989,"_17548":102912,"_5":17443,"_23820":102849,"_2384":102913},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_2857":60017,"_25170":59989,"_17548":102915,"_5":17443,"_23820":102853,"_2384":102916},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_2857":60018,"_25170":59989,"_17548":102918,"_5":17443,"_23820":102856,"_2384":102919},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_2857":60019,"_25170":59989,"_17548":102921,"_5":17443,"_23820":102860,"_2384":102922},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_2857":60020,"_25170":59989,"_17548":102924,"_5":17443,"_23820":102860,"_2384":102925},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_2857":60021,"_25170":59989,"_17548":102927,"_5":17443,"_23820":102860,"_2384":102928},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_2857":60022,"_25170":59989,"_17548":102930,"_5":17443,"_23820":102864,"_2384":102931},[],"En Bash, compara los dos resúmenes de clave pública:",{"_2857":60023,"_25170":59989,"_17548":102933,"_5":17443,"_23820":102864,"_2384":102934},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_2857":60024,"_25170":59989,"_17548":102936,"_5":17443,"_23820":102864,"_2384":102937},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_2857":60025,"_25170":59989,"_17548":102939,"_5":17443,"_23820":102868,"_2384":100584},[],{"_2857":60026,"_25170":59989,"_17548":102941,"_5":17443,"_23820":102868,"_2384":99361},[],{"_2857":60027,"_25170":59989,"_17548":102943,"_5":17443,"_23820":102868,"_2384":102944},[],"La CA rechaza la emisión",{"_2857":60028,"_25170":59989,"_17548":102946,"_5":17443,"_23820":102868,"_2384":102947},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_2857":60029,"_25170":59989,"_17548":102949,"_5":17443,"_23820":102868,"_2384":102950},[],"Sujeto o usos diferentes",{"_2857":60030,"_25170":59989,"_17548":102952,"_5":17443,"_23820":102868,"_2384":102953},[],"Perfil aplicado y valores solicitados.",{"_2857":60031,"_25170":59989,"_17548":102955,"_5":17443,"_23820":102868,"_2384":102956},[],"No se encuentra el emisor",{"_2857":60032,"_25170":59989,"_17548":102958,"_5":17443,"_23820":102868,"_2384":102959},[],"CA descargada y cadena intermedia necesaria.",{"_2857":60033,"_25170":59989,"_17548":102961,"_5":17443,"_23820":102868,"_2384":102962},[],"Falla la vigencia",{"_2857":60034,"_25170":59989,"_17548":102964,"_5":17443,"_23820":102868,"_2384":102965},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_2857":60035,"_25170":59989,"_17548":102967,"_5":17443,"_23820":102868,"_2384":102968},[],"Los resúmenes de clave difieren",{"_2857":60036,"_25170":59989,"_17548":102970,"_5":17443,"_23820":102868,"_2384":102971},[],"Archivos de certificado y clave de la misma emisión.",{"_2857":60037,"_25170":59989,"_17548":102973,"_5":17443,"_23820":102868,"_2384":102974},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_2857":60038,"_25170":59989,"_17548":102976,"_5":17443,"_23820":102871,"_2384":102977},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_2857":60039,"_25170":59989,"_17548":102979,"_5":17443,"_23820":102871,"_2384":102980},[],"Gestionar certificados para inspección, estado y revocación.",{"_2857":60040,"_25170":59989,"_17548":102982,"_5":17443,"_23820":102871,"_2384":102983},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_2857":60041,"_25170":59989,"_17548":102985,"_5":17443,"_23820":102871,"_2384":102986},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_2857":60042,"_25170":59989,"_17548":102988,"_5":17443,"_23820":102871,"_2384":102989},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_2857":60043,"_25170":60043,"_5":12294,"_2384":102991,"_25485":102992,"_17548":102993,"_23820":60043},"Primeros pasos de PKI",[40817,97227,45842,100253],[],{"_2857":60044,"_25170":60043,"_17548":102995,"_5":17443,"_23820":60043,"_2384":102996},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_2857":60045,"_25170":60043,"_5":25482,"_17548":102998,"_23820":102999,"_2384":95928},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_2857":60046,"_25170":60043,"_5":25482,"_17548":103001,"_23820":103002,"_2384":103003},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_2857":60047,"_25170":60043,"_5":25482,"_17548":103005,"_23820":103006,"_2384":100435},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_2857":60048,"_25170":60043,"_5":25482,"_17548":103008,"_23820":103009,"_2384":103010},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_2857":60049,"_25170":60043,"_17548":103012,"_5":17443,"_23820":60043,"_2384":103013},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_2857":60050,"_25170":60043,"_17548":103015,"_5":17443,"_23820":102999,"_2384":103016},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_2857":60051,"_25170":60043,"_17548":103018,"_5":17443,"_23820":102999,"_2384":103019},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_2857":60052,"_25170":60043,"_17548":103021,"_5":17443,"_23820":102999,"_2384":103022},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_2857":60053,"_25170":60043,"_17548":103024,"_5":17443,"_23820":102999,"_2384":103025},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_2857":60054,"_25170":60043,"_17548":103027,"_5":17443,"_23820":102999,"_2384":103028},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_2857":60055,"_25170":60043,"_17548":103030,"_5":17443,"_23820":103002,"_2384":103031},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2857":60056,"_25170":60043,"_17548":103033,"_5":17443,"_23820":103002,"_2384":103034},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2857":60057,"_25170":60043,"_17548":103036,"_5":17443,"_23820":103002,"_2384":103037},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_2857":60058,"_25170":60043,"_17548":103039,"_5":17443,"_23820":103002,"_2384":103040},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_2857":60059,"_25170":60043,"_17548":103042,"_5":17443,"_23820":103006,"_2384":103043},[],"Archivo o recurso",{"_2857":60060,"_25170":60043,"_17548":103045,"_5":17443,"_23820":103006,"_2384":100432},[],{"_2857":60061,"_25170":60043,"_17548":103047,"_5":17443,"_23820":103006,"_2384":103048},[],"CA raíz activa y `ca.pem`",{"_2857":60062,"_25170":60043,"_17548":103050,"_5":17443,"_23820":103006,"_2384":103051},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_2857":60063,"_25170":60043,"_17548":103053,"_5":17443,"_23820":103006,"_2384":103054},[],"Certificado final y `device.crt`",{"_2857":60064,"_25170":60043,"_17548":103056,"_5":17443,"_23820":103006,"_2384":103057},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_2857":60065,"_25170":60043,"_17548":103059,"_5":17443,"_23820":103006,"_2384":103060},[],"Clave privada `device.key`",{"_2857":60066,"_25170":60043,"_17548":103062,"_5":17443,"_23820":103006,"_2384":103063},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_2857":60067,"_25170":60043,"_17548":103065,"_5":17443,"_23820":103006,"_2384":103066},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_2857":60068,"_25170":60043,"_17548":103068,"_5":17443,"_23820":103009,"_2384":103069},[],"Para operar certificados, continúa con Certificados y Validación.",{"_2857":60069,"_25170":60043,"_17548":103071,"_5":17443,"_23820":103009,"_2384":103072},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_2857":60070,"_25170":60043,"_17548":103074,"_5":17443,"_23820":103009,"_2384":103075},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_2857":60071,"_25170":60071,"_5":12294,"_2384":103077,"_25485":103078,"_17548":103080,"_23820":60071},"Resolución de problemas PKI",[40817,97227,45842,103079],"Resolución de problemas",[],{"_2857":60072,"_25170":60071,"_17548":103082,"_5":17443,"_23820":60071,"_2384":103083},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_2857":60073,"_25170":60071,"_5":25482,"_17548":103085,"_23820":103086,"_2384":103087},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_2857":60074,"_25170":60071,"_5":25482,"_17548":103089,"_23820":103090,"_2384":103091},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_2857":60075,"_25170":60071,"_5":25482,"_17548":103093,"_23820":103094,"_2384":103095},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_2857":60076,"_25170":60071,"_17548":103097,"_5":17443,"_23820":60071,"_2384":103098},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_2857":60077,"_25170":60071,"_17548":103100,"_5":17443,"_23820":60071,"_2384":103101},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_2857":60078,"_25170":60071,"_17548":103103,"_5":17443,"_23820":103086,"_2384":100432},[],{"_2857":60079,"_25170":60071,"_17548":103105,"_5":17443,"_23820":103086,"_2384":99361},[],{"_2857":60080,"_25170":60071,"_17548":103107,"_5":17443,"_23820":103086,"_2384":95952},[],{"_2857":60081,"_25170":60071,"_17548":103109,"_5":17443,"_23820":103086,"_2384":48177},[],{"_2857":60082,"_25170":60071,"_17548":103111,"_5":17443,"_23820":103086,"_2384":103112},[],"Existe, está activa y sus fechas son utilizables.",{"_2857":60083,"_25170":60071,"_17548":103114,"_5":17443,"_23820":103086,"_2384":103115},[],"Autoridades.",{"_2857":60084,"_25170":60071,"_17548":103117,"_5":17443,"_23820":103086,"_2384":103118},[],"Clave",{"_2857":60085,"_25170":60071,"_17548":103120,"_5":17443,"_23820":103086,"_2384":103121},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_2857":60086,"_25170":60071,"_17548":103123,"_5":17443,"_23820":103086,"_2384":103124},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_2857":60087,"_25170":60071,"_17548":103126,"_5":17443,"_23820":103086,"_2384":48195},[],{"_2857":60088,"_25170":60071,"_17548":103128,"_5":17443,"_23820":103086,"_2384":103129},[],"PEM correcto y firma verificable.",{"_2857":60089,"_25170":60071,"_17548":103131,"_5":17443,"_23820":103086,"_2384":48201},[],{"_2857":60090,"_25170":60071,"_17548":103133,"_5":17443,"_23820":103086,"_2384":103134},[],"Perfil",{"_2857":60091,"_25170":60071,"_17548":103136,"_5":17443,"_23820":103086,"_2384":103137},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_2857":60092,"_25170":60071,"_17548":103139,"_5":17443,"_23820":103086,"_2384":103140},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_2857":60093,"_25170":60071,"_17548":103142,"_5":17443,"_23820":103086,"_2384":100584},[],{"_2857":60094,"_25170":60071,"_17548":103144,"_5":17443,"_23820":103086,"_2384":103145},[],"Sujeto, SAN, usos y fechas adecuados.",{"_2857":60095,"_25170":60071,"_17548":103147,"_5":17443,"_23820":103086,"_2384":103148},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_2857":60096,"_25170":60071,"_17548":103150,"_5":17443,"_23820":103086,"_2384":103151},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_2857":60097,"_25170":60071,"_17548":103153,"_5":17443,"_23820":103086,"_2384":103154},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_2857":60098,"_25170":60071,"_17548":103156,"_5":17443,"_23820":103090,"_2384":103157},[],"Revisa cada frontera por separado:",{"_2857":60099,"_25170":60071,"_17548":103159,"_5":17443,"_23820":103090,"_2384":103160},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_2857":60100,"_25170":60071,"_17548":103162,"_5":17443,"_23820":103090,"_2384":103163},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_2857":60101,"_25170":60071,"_17548":103165,"_5":17443,"_23820":103090,"_2384":103166},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_2857":60102,"_25170":60071,"_17548":103168,"_5":17443,"_23820":103090,"_2384":103169},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_2857":60103,"_25170":60071,"_17548":103171,"_5":17443,"_23820":103090,"_2384":103172},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_2857":60104,"_25170":60071,"_17548":103174,"_5":17443,"_23820":103090,"_2384":103175},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_2857":60105,"_25170":60071,"_17548":103177,"_5":17443,"_23820":103094,"_2384":103178},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_2857":60106,"_25170":60071,"_17548":103180,"_5":17443,"_23820":103094,"_2384":103181},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_48255":103183,"_48257":103184,"_48259":103185,"_48261":103186,"_15231":2406,"_57736":2406},"spanish",[2384,25170,5,