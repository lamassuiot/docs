268":49280,"_34270":49283,"_34272":49286,"_34274":49289,"_34276":49291},{"_2926":15,"_25561":15,"_5":12525,"_2452":41649,"_25885":41650,"_17855":41654,"_24230":15},"Deploy from AWS Marketplace",[41651,41652,41653],"Docs","Deployment","Other models",[],{"_2926":16,"_25561":15,"_17855":41656,"_5":17750,"_24230":15,"_2452":41657},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_2926":17,"_25561":15,"_5":25882,"_17855":41659,"_24230":41660,"_2452":41661},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_2926":18,"_25561":15,"_5":25882,"_17855":41663,"_24230":41664,"_2452":41665},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_2926":19,"_25561":15,"_5":25882,"_17855":41667,"_24230":41668,"_2452":41669},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_2926":20,"_25561":15,"_5":25882,"_17855":41671,"_24230":41672,"_2452":41673},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_2926":21,"_25561":15,"_5":25882,"_17855":41675,"_24230":41676,"_2452":41677},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_2926":22,"_25561":15,"_5":25882,"_17855":41679,"_24230":41680,"_2452":41681},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_2926":23,"_25561":15,"_5":25882,"_17855":41683,"_24230":41684,"_2452":41685},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_2926":24,"_25561":15,"_17855":41687,"_5":17750,"_24230":15,"_2452":41688},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_2926":25,"_25561":15,"_17855":41690,"_5":17750,"_24230":41660,"_2452":41691},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_2926":26,"_25561":15,"_17855":41693,"_5":17750,"_24230":41660,"_2452":41694},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_2926":27,"_25561":15,"_17855":41696,"_5":17750,"_24230":41660,"_2452":41697},[],"A security group allowing the necessary endpoints.",{"_2926":28,"_25561":15,"_17855":41699,"_5":17750,"_24230":41664,"_2452":41700},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_2926":29,"_25561":15,"_17855":41702,"_5":17750,"_24230":41664,"_2452":41703},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_2926":30,"_25561":15,"_17855":41705,"_5":17750,"_24230":41664,"_2452":41706},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_2926":31,"_25561":15,"_17855":41708,"_5":17750,"_24230":41668,"_2452":41709},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_2926":32,"_25561":15,"_17855":41711,"_5":17750,"_24230":41672,"_2452":41712},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_2926":33,"_25561":15,"_17855":41714,"_5":17750,"_24230":41676,"_2452":41715},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_2926":34,"_25561":15,"_17855":41717,"_5":17750,"_24230":41680,"_2452":41718},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_2926":35,"_25561":15,"_17855":41720,"_5":17750,"_24230":41684,"_2452":41721},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_2926":36,"_25561":36,"_5":12525,"_2452":41723,"_25885":41724,"_17855":41725,"_24230":36},"Deploy Lamassu",[41651,41652],[],{"_2926":37,"_25561":36,"_17855":41727,"_5":17750,"_24230":36,"_2452":41728},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_2926":38,"_25561":36,"_5":25882,"_17855":41730,"_24230":41731,"_2452":41732},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_2926":39,"_25561":36,"_5":25882,"_17855":41734,"_24230":41735,"_2452":41736},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_2926":40,"_25561":36,"_5":25882,"_17855":41738,"_24230":41739,"_2452":41740},[],"/docs/deployment/overview#after-deployment","After deployment",{"_2926":41,"_25561":36,"_17855":41742,"_5":17750,"_24230":36,"_2452":41743},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_2926":42,"_25561":36,"_17855":41745,"_5":17750,"_24230":41731,"_2452":41746},[],"Model",{"_2926":43,"_25561":36,"_17855":41748,"_5":17750,"_24230":41731,"_2452":41749},[],"Recommended for",{"_2926":44,"_25561":36,"_17855":41751,"_5":17750,"_24230":41731,"_2452":41752},[],"Who operates the infrastructure",{"_2926":45,"_25561":36,"_17855":41754,"_5":17750,"_24230":41731,"_2452":41755},[],"Starting point",{"_2926":46,"_25561":36,"_17855":41757,"_5":17750,"_24230":41731,"_2452":41758},[],"Kubernetes self-managed",{"_2926":47,"_25561":36,"_17855":41760,"_5":17750,"_24230":41731,"_2452":41761},[],"Production, regulated environments and custom deployments",{"_2926":48,"_25561":36,"_17855":41763,"_5":17750,"_24230":41731,"_2452":41764},[],"Your team",{"_2926":49,"_25561":36,"_17855":41766,"_5":17750,"_24230":41731,"_2452":41767},[],"Helm or Fastlane",{"_2926":50,"_25561":36,"_17855":41769,"_5":17750,"_24230":41731,"_2452":41770},[],"AWS Marketplace",{"_2926":51,"_25561":36,"_17855":41772,"_5":17750,"_24230":41731,"_2452":41773},[],"Evaluation or a dedicated deployment inside an AWS account",{"_2926":52,"_25561":36,"_17855":41775,"_5":17750,"_24230":41731,"_2452":41764},[],{"_2926":53,"_25561":36,"_17855":41777,"_5":17750,"_24230":41731,"_2452":41778},[],"Preconfigured image on EC2",{"_2926":54,"_25561":36,"_17855":41780,"_5":17750,"_24230":41731,"_2452":41781},[],"SaaS",{"_2926":55,"_25561":36,"_17855":41783,"_5":17750,"_24230":41731,"_2452":41784},[],"Teams that want to use the platform without operating it",{"_2926":56,"_25561":36,"_17855":41786,"_5":17750,"_24230":41731,"_2452":41787},[],"Lamassu",{"_2926":57,"_25561":36,"_17855":41789,"_5":17750,"_24230":41731,"_2452":41790},[],"Managed subscription",{"_2926":58,"_25561":36,"_17855":41792,"_5":17750,"_24230":41731,"_2452":41793},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_2926":59,"_25561":36,"_17855":41795,"_5":17750,"_24230":41731,"_2452":41796},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_2926":60,"_25561":36,"_17855":41798,"_5":17750,"_24230":41731,"_2452":41799},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_2926":61,"_25561":36,"_17855":41801,"_5":17750,"_24230":41735,"_2452":41802},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_2926":62,"_25561":36,"_17855":41804,"_5":17750,"_24230":41739,"_2452":41805},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_2926":63,"_25561":63,"_5":12525,"_2452":41807,"_25885":41808,"_17855":41809,"_24230":63},"Use Lamassu as SaaS",[41651,41652,41653],[],{"_2926":64,"_25561":63,"_17855":41811,"_5":17750,"_24230":63,"_2452":41812},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_2926":65,"_25561":63,"_5":25882,"_17855":41814,"_24230":41815,"_2452":41816},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_2926":66,"_25561":63,"_5":25882,"_17855":41818,"_24230":41819,"_2452":41820},[],"/docs/deployment/saas#plans","Plans",{"_2926":67,"_25561":63,"_5":25882,"_17855":41822,"_24230":41823,"_2452":41824},[],"/docs/deployment/saas#request-access","Request access",{"_2926":68,"_25561":63,"_17855":41826,"_5":17750,"_24230":63,"_2452":41827},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_2926":69,"_25561":63,"_17855":41829,"_5":17750,"_24230":41815,"_2452":41830},[],"Platform availability and maintenance.",{"_2926":70,"_25561":63,"_17855":41832,"_5":17750,"_24230":41815,"_2452":41833},[],"Automatic backups.",{"_2926":71,"_25561":63,"_17855":41835,"_5":17750,"_24230":41815,"_2452":41836},[],"Version upgrades.",{"_2926":72,"_25561":63,"_17855":41838,"_5":17750,"_24230":41815,"_2452":41839},[],"Technical support and SLA according to your plan.",{"_2926":73,"_25561":63,"_17855":41841,"_5":17750,"_24230":41819,"_2452":41842},[],"Plan",{"_2926":74,"_25561":63,"_17855":41844,"_5":17750,"_24230":41819,"_2452":41845},[],"Devices",{"_2926":75,"_25561":63,"_17855":41847,"_5":17750,"_24230":41819,"_2452":41848},[],"Support",{"_2926":76,"_25561":63,"_17855":41850,"_5":17750,"_24230":41819,"_2452":41851},[],"SLA",{"_2926":77,"_25561":63,"_17855":41853,"_5":17750,"_24230":41819,"_2452":41854},[],"Starter",{"_2926":78,"_25561":63,"_17855":41856,"_5":17750,"_24230":41819,"_2452":41857},[],"Up to 1,000",{"_2926":79,"_25561":63,"_17855":41859,"_5":17750,"_24230":41819,"_2452":41860},[],"Email",{"_2926":80,"_25561":63,"_17855":41862,"_5":17750,"_24230":41819,"_2452":41863},[],"99.5 %",{"_2926":81,"_25561":63,"_17855":41865,"_5":17750,"_24230":41819,"_2452":41866},[],"Professional",{"_2926":82,"_25561":63,"_17855":41868,"_5":17750,"_24230":41819,"_2452":41869},[],"Up to 10,000",{"_2926":83,"_25561":63,"_17855":41871,"_5":17750,"_24230":41819,"_2452":41872},[],"Email and chat",{"_2926":84,"_25561":63,"_17855":41874,"_5":17750,"_24230":41819,"_2452":41875},[],"99.9 %",{"_2926":85,"_25561":63,"_17855":41877,"_5":17750,"_24230":41819,"_2452":41878},[],"Enterprise",{"_2926":86,"_25561":63,"_17855":41880,"_5":17750,"_24230":41819,"_2452":41881},[],"Unlimited",{"_2926":87,"_25561":63,"_17855":41883,"_5":17750,"_24230":41819,"_2452":41884},[],"Dedicated",{"_2926":88,"_25561":63,"_17855":41886,"_5":17750,"_24230":41819,"_2452":41887},[],"99.99 %",{"_2926":89,"_25561":63,"_17855":41889,"_5":17750,"_24230":41823,"_2452":41890},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_2926":90,"_25561":63,"_17855":41892,"_5":17750,"_24230":41823,"_2452":41893},[],"When you receive your instance's credentials, continue with Get started.",{"_2926":91,"_25561":91,"_5":12525,"_2452":41895,"_25885":41896,"_17855":41897,"_24230":91},"Fastlane",[41651,41652,41758],[],{"_2926":92,"_25561":91,"_17855":41899,"_5":17750,"_24230":91,"_2452":41900},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_2926":93,"_25561":91,"_5":25882,"_17855":41902,"_24230":41903,"_2452":41904},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_2926":94,"_25561":91,"_5":25882,"_17855":41906,"_24230":41907,"_2452":41908},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_2926":95,"_25561":91,"_5":25882,"_17855":41910,"_24230":41911,"_2452":41661},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_2926":96,"_25561":91,"_5":25882,"_17855":41913,"_24230":41914,"_2452":41915},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_2926":97,"_25561":91,"_5":25882,"_17855":41917,"_24230":41918,"_2452":41919},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_2926":98,"_25561":91,"_5":25882,"_17855":41921,"_24230":41922,"_2452":41923},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_2926":99,"_25561":91,"_5":25882,"_17855":41925,"_24230":41926,"_2452":41927},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_2926":100,"_25561":91,"_5":25882,"_17855":41929,"_24230":41930,"_2452":41931},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_2926":101,"_25561":91,"_5":25882,"_17855":41933,"_24230":41934,"_2452":41935},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_2926":102,"_25561":91,"_5":25882,"_17855":41937,"_24230":41938,"_2452":41939},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_2926":103,"_25561":91,"_17855":41941,"_5":17750,"_24230":41903,"_2452":41942},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_2926":104,"_25561":91,"_17855":41944,"_5":17750,"_24230":41903,"_2452":41945},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_2926":105,"_25561":91,"_17855":41947,"_5":17750,"_24230":41907,"_2452":41948},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_2926":106,"_25561":91,"_17855":41950,"_5":17750,"_24230":41907,"_2452":41951},[],"Fastlane installs or configures",{"_2926":107,"_25561":91,"_17855":41953,"_5":17750,"_24230":41907,"_2452":41954},[],"You still provide",{"_2926":108,"_25561":91,"_17855":41956,"_5":17750,"_24230":41907,"_2452":41957},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_2926":109,"_25561":91,"_17855":41959,"_5":17750,"_24230":41907,"_2452":41960},[],"The Kubernetes cluster, nodes and persistent storage",{"_2926":110,"_25561":91,"_17855":41962,"_5":17750,"_24230":41907,"_2452":41963},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_2926":111,"_25561":91,"_17855":41965,"_5":17750,"_24230":41907,"_2452":41966},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_2926":112,"_25561":91,"_17855":41968,"_5":17750,"_24230":41907,"_2452":41969},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_2926":113,"_25561":91,"_17855":41971,"_5":17750,"_24230":41907,"_2452":41972},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_2926":114,"_25561":91,"_17855":41974,"_5":17750,"_24230":41907,"_2452":41975},[],"Optional observability and lab HSM components",{"_2926":115,"_25561":91,"_17855":41977,"_5":17750,"_24230":41907,"_2452":41978},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_2926":116,"_25561":91,"_17855":41980,"_5":17750,"_24230":41907,"_2452":41981},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_2926":117,"_25561":91,"_17855":41983,"_5":17750,"_24230":41911,"_2452":41984},[],"You need:",{"_2926":118,"_25561":91,"_17855":41986,"_5":17750,"_24230":41911,"_2452":41987},[],"an existing Kubernetes cluster",{"_2926":119,"_25561":91,"_17855":41989,"_5":17750,"_24230":41911,"_2452":41990},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_2926":120,"_25561":91,"_17855":41992,"_5":17750,"_24230":41911,"_2452":41993},[],"`yq`",{"_2926":121,"_25561":91,"_17855":41995,"_5":17750,"_24230":41911,"_2452":20208},[],{"_2926":122,"_25561":91,"_17855":41997,"_5":17750,"_24230":41911,"_2452":41998},[],"`jq` only when using `--sample-data`",{"_2926":123,"_25561":91,"_17855":42000,"_5":17750,"_24230":41911,"_2452":42001},[],"free external ports 80 and 443 on a single-node K3s host",{"_2926":124,"_25561":91,"_17855":42003,"_5":17750,"_24230":41911,"_2452":42004},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_2926":125,"_25561":91,"_17855":42006,"_5":17750,"_24230":41911,"_2452":42007},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_2926":126,"_25561":91,"_17855":42009,"_5":17750,"_24230":41914,"_2452":42010},[],"Run the script from a clone of the Helm repository:",{"_2926":127,"_25561":91,"_17855":42012,"_5":17750,"_24230":41914,"_2452":42013},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_2926":128,"_25561":91,"_17855":42015,"_5":17750,"_24230":41918,"_2452":42016},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_2926":129,"_25561":91,"_17855":42018,"_5":17750,"_24230":41918,"_2452":42019},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_2926":130,"_25561":91,"_17855":42021,"_5":17750,"_24230":41918,"_2452":42022},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_2926":131,"_25561":91,"_17855":42024,"_5":17750,"_24230":41918,"_2452":42025},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_2926":132,"_25561":91,"_17855":42027,"_5":17750,"_24230":41922,"_2452":42028},[],"Option",{"_2926":133,"_25561":91,"_17855":42030,"_5":17750,"_24230":41922,"_2452":42031},[],"Default",{"_2926":134,"_25561":91,"_17855":42033,"_5":17750,"_24230":41922,"_2452":42034},[],"Purpose",{"_2926":135,"_25561":91,"_17855":42036,"_5":17750,"_24230":41922,"_2452":42037},[],"`-h`, `--help`",{"_2926":136,"_25561":91,"_17855":42039,"_5":17750,"_24230":41922,"_2452":42040},[],"—",{"_2926":137,"_25561":91,"_17855":42042,"_5":17750,"_24230":41922,"_2452":42043},[],"Show help",{"_2926":138,"_25561":91,"_17855":42045,"_5":17750,"_24230":41922,"_2452":42046},[],"`-c`, `--context`",{"_2926":139,"_25561":91,"_17855":42048,"_5":17750,"_24230":41922,"_2452":42049},[],"current context",{"_2926":140,"_25561":91,"_17855":42051,"_5":17750,"_24230":41922,"_2452":42052},[],"Select the kubeconfig context for kubectl and Helm",{"_2926":141,"_25561":91,"_17855":42054,"_5":17750,"_24230":41922,"_2452":42055},[],"`-n`, `--non-interactive`",{"_2926":142,"_25561":91,"_17855":42057,"_5":17750,"_24230":41922,"_2452":5458},[],{"_2926":143,"_25561":91,"_17855":42059,"_5":17750,"_24230":41922,"_2452":42060},[],"Skip prompts and generate dependency credentials",{"_2926":144,"_25561":91,"_17855":42062,"_5":17750,"_24230":41922,"_2452":42063},[],"`-ns`, `--namespace`",{"_2926":145,"_25561":91,"_17855":42065,"_5":17750,"_24230":41922,"_2452":42066},[],"`lamassu-dev`",{"_2926":146,"_25561":91,"_17855":42068,"_5":17750,"_24230":41922,"_2452":42069},[],"Namespace for the installation",{"_2926":147,"_25561":91,"_17855":42071,"_5":17750,"_24230":41922,"_2452":42072},[],"`-d`, `--domain`",{"_2926":148,"_25561":91,"_17855":42074,"_5":17750,"_24230":41922,"_2452":42075},[],"`dev.lamassu.io`",{"_2926":149,"_25561":91,"_17855":42077,"_5":17750,"_24230":41922,"_2452":42078},[],"Domain used by the UI, OIDC and certificate",{"_2926":150,"_25561":91,"_17855":42080,"_5":17750,"_24230":41922,"_2452":42081},[],"`-v`, `--version`",{"_2926":151,"_25561":91,"_17855":42083,"_5":17750,"_24230":41922,"_2452":12756},[],{"_2926":152,"_25561":91,"_17855":42085,"_5":17750,"_24230":41922,"_2452":42086},[],"Lamassu chart version",{"_2926":153,"_25561":91,"_17855":42088,"_5":17750,"_24230":41922,"_2452":42089},[],"`--https-port`",{"_2926":154,"_25561":91,"_17855":42091,"_5":17750,"_24230":41922,"_2452":42092},[],"`443`",{"_2926":155,"_25561":91,"_17855":42094,"_5":17750,"_24230":41922,"_2452":42095},[],"Gateway HTTPS listener port",{"_2926":156,"_25561":91,"_17855":42097,"_5":17750,"_24230":41922,"_2452":42098},[],"`--http-port`",{"_2926":157,"_25561":91,"_17855":42100,"_5":17750,"_24230":41922,"_2452":42101},[],"`80`",{"_2926":158,"_25561":91,"_17855":42103,"_5":17750,"_24230":41922,"_2452":42104},[],"Gateway HTTP listener port",{"_2926":159,"_25561":91,"_17855":42106,"_5":17750,"_24230":41922,"_2452":42107},[],"`--tls-crt`",{"_2926":160,"_25561":91,"_17855":42109,"_5":17750,"_24230":41922,"_2452":42040},[],{"_2926":161,"_25561":91,"_17855":42111,"_5":17750,"_24230":41922,"_2452":42112},[],"PEM certificate for downstream TLS",{"_2926":162,"_25561":91,"_17855":42114,"_5":17750,"_24230":41922,"_2452":42115},[],"`--tls-key`",{"_2926":163,"_25561":91,"_17855":42117,"_5":17750,"_24230":41922,"_2452":42040},[],{"_2926":164,"_25561":91,"_17855":42119,"_5":17750,"_24230":41922,"_2452":42120},[],"PEM private key for downstream TLS",{"_2926":165,"_25561":91,"_17855":42122,"_5":17750,"_24230":41922,"_2452":42123},[],"`-l`, `--local-chart-path`",{"_2926":166,"_25561":91,"_17855":42125,"_5":17750,"_24230":41922,"_2452":42126},[],"repository chart",{"_2926":167,"_25561":91,"_17855":42128,"_5":17750,"_24230":41922,"_2452":42129},[],"Use an unpacked local Lamassu chart",{"_2926":168,"_25561":91,"_17855":42131,"_5":17750,"_24230":41922,"_2452":42132},[],"`-ip`, `--gateway-ip`",{"_2926":169,"_25561":91,"_17855":42134,"_5":17750,"_24230":41922,"_2452":7390},[],{"_2926":170,"_25561":91,"_17855":42136,"_5":17750,"_24230":41922,"_2452":42137},[],"Override the address written to `gateway.addresses`",{"_2926":171,"_25561":91,"_17855":42139,"_5":17750,"_24230":41922,"_2452":42140},[],"`--otel`",{"_2926":172,"_25561":91,"_17855":42142,"_5":17750,"_24230":41922,"_2452":5458},[],{"_2926":173,"_25561":91,"_17855":42144,"_5":17750,"_24230":41922,"_2452":42145},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_2926":174,"_25561":91,"_17855":42147,"_5":17750,"_24230":41922,"_2452":42148},[],"`--sample-data`",{"_2926":175,"_25561":91,"_17855":42150,"_5":17750,"_24230":41922,"_2452":5458},[],{"_2926":176,"_25561":91,"_17855":42152,"_5":17750,"_24230":41922,"_2452":42153},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_2926":177,"_25561":91,"_17855":42155,"_5":17750,"_24230":41922,"_2452":42156},[],"`--with-hsm`",{"_2926":178,"_25561":91,"_17855":42158,"_5":17750,"_24230":41922,"_2452":5458},[],{"_2926":179,"_25561":91,"_17855":42160,"_5":17750,"_24230":41922,"_2452":42161},[],"Install lab HSM components and configure KMS for PKCS#11",{"_2926":180,"_25561":91,"_17855":42163,"_5":17750,"_24230":41922,"_2452":42164},[],"`--softhsm-chart-path`",{"_2926":181,"_25561":91,"_17855":42166,"_5":17750,"_24230":41922,"_2452":42167},[],"`./charts/softhsm`",{"_2926":182,"_25561":91,"_17855":42169,"_5":17750,"_24230":41922,"_2452":42170},[],"Use a different local SoftHSM chart",{"_2926":183,"_25561":91,"_17855":42172,"_5":17750,"_24230":41922,"_2452":42173},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_2926":184,"_25561":91,"_17855":42175,"_5":17750,"_24230":41926,"_2452":42176},[],"Fastlane:",{"_2926":185,"_25561":91,"_17855":42178,"_5":17750,"_24230":41926,"_2452":42179},[],"validates local tools and the selected cluster",{"_2926":186,"_25561":91,"_17855":42181,"_5":17750,"_24230":41926,"_2452":42182},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_2926":187,"_25561":91,"_17855":42184,"_5":17750,"_24230":41926,"_2452":42185},[],"creates the namespace",{"_2926":188,"_25561":91,"_17855":42187,"_5":17750,"_24230":41926,"_2452":42188},[],"installs PostgreSQL and creates the required databases",{"_2926":189,"_25561":91,"_17855":42190,"_5":17750,"_24230":41926,"_2452":42191},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_2926":190,"_25561":91,"_17855":42193,"_5":17750,"_24230":41926,"_2452":42194},[],"installs RabbitMQ",{"_2926":191,"_25561":91,"_17855":42196,"_5":17750,"_24230":41926,"_2452":42197},[],"optionally installs observability and lab HSM components",{"_2926":192,"_25561":91,"_17855":42199,"_5":17750,"_24230":41926,"_2452":42200},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_2926":193,"_25561":91,"_17855":42202,"_5":17750,"_24230":41926,"_2452":42203},[],"optionally loads sample data",{"_2926":194,"_25561":91,"_17855":42205,"_5":17750,"_24230":41926,"_2452":42206},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_2926":195,"_25561":91,"_17855":42208,"_5":17750,"_24230":41930,"_2452":42209},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_2926":196,"_25561":91,"_17855":42211,"_5":17750,"_24230":41930,"_2452":42212},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_2926":197,"_25561":91,"_17855":42214,"_5":17750,"_24230":41934,"_2452":42215},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use.",{"_2926":198,"_25561":91,"_17855":42217,"_5":17750,"_24230":41934,"_2452":42218},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_2926":199,"_25561":91,"_17855":42220,"_5":17750,"_24230":41934,"_2452":42221},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_2926":200,"_25561":91,"_17855":42223,"_5":17750,"_24230":41938,"_2452":42224},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_2926":201,"_25561":201,"_5":12525,"_2452":42226,"_25885":42227,"_17855":42228,"_24230":201},"Install with Helm",[41651,41652,41758],[],{"_2926":202,"_25561":201,"_17855":42230,"_5":17750,"_24230":201,"_2452":42231},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_2926":203,"_25561":201,"_5":25882,"_17855":42233,"_24230":42234,"_2452":42235},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_2926":204,"_25561":201,"_5":25882,"_17855":42237,"_24230":42238,"_2452":41661},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_2926":205,"_25561":201,"_5":25882,"_17855":42240,"_24230":42241,"_2452":42242},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_2926":206,"_25561":201,"_5":25882,"_17855":42244,"_24230":42245,"_2452":42246},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_2926":207,"_25561":201,"_5":25882,"_17855":42248,"_24230":42249,"_2452":42250},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_2926":208,"_25561":201,"_5":25882,"_17855":42252,"_24230":42253,"_2452":42254},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_2926":209,"_25561":201,"_5":25882,"_17855":42256,"_24230":42257,"_2452":42258},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_2926":210,"_25561":201,"_5":25882,"_17855":42260,"_24230":42261,"_2452":42262},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_2926":211,"_25561":201,"_5":25882,"_17855":42264,"_24230":42265,"_2452":42266},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_2926":212,"_25561":201,"_17855":42268,"_5":17750,"_24230":42234,"_2452":42269},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_2926":213,"_25561":201,"_17855":42271,"_5":17750,"_24230":42238,"_2452":42272},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_2926":214,"_25561":201,"_17855":42274,"_5":17750,"_24230":42238,"_2452":42275},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_2926":215,"_25561":201,"_17855":42277,"_5":17750,"_24230":42238,"_2452":42278},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_2926":216,"_25561":201,"_17855":42280,"_5":17750,"_24230":42238,"_2452":42281},[],"a reachable RabbitMQ broker and credentials",{"_2926":217,"_25561":201,"_17855":42283,"_5":17750,"_24230":42238,"_2452":42284},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_2926":218,"_25561":201,"_17855":42286,"_5":17750,"_24230":42238,"_2452":42287},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_2926":219,"_25561":201,"_17855":42289,"_5":17750,"_24230":42238,"_2452":42290},[],"cert-manager 1.14+; for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_2926":220,"_25561":201,"_17855":42292,"_5":17750,"_24230":42238,"_2452":42293},[],"a StorageClass and an external traffic design",{"_2926":221,"_25561":201,"_17855":42295,"_5":17750,"_24230":42238,"_2452":42296},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_2926":222,"_25561":201,"_17855":42298,"_5":17750,"_24230":42238,"_2452":42299},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_2926":223,"_25561":201,"_17855":42301,"_5":17750,"_24230":42238,"_2452":42302},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_2926":224,"_25561":201,"_17855":42304,"_5":17750,"_24230":42241,"_2452":42305},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_2926":225,"_25561":201,"_17855":42307,"_5":17750,"_24230":42241,"_2452":42308},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_2926":226,"_25561":201,"_17855":42310,"_5":17750,"_24230":42241,"_2452":42311},[],"Install cert-manager separately before Lamassu. The current chart renders its self-signed issuer and CA certificate resources even when `tls.type: external` makes the Gateway use an existing TLS Secret. Selecting external TLS therefore does not remove the cert-manager prerequisite.",{"_2926":227,"_25561":201,"_17855":42313,"_5":17750,"_24230":42245,"_2452":42314},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_2926":228,"_25561":201,"_17855":42316,"_5":17750,"_24230":42245,"_2452":42317},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_2926":229,"_25561":201,"_17855":42319,"_5":17750,"_24230":42245,"_2452":42320},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_2926":230,"_25561":201,"_17855":42322,"_5":17750,"_24230":42249,"_2452":42323},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it:",{"_2926":231,"_25561":201,"_17855":42325,"_5":17750,"_24230":42253,"_2452":42326},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_2926":232,"_25561":201,"_17855":42328,"_5":17750,"_24230":42253,"_2452":42329},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_2926":233,"_25561":201,"_17855":42331,"_5":17750,"_24230":42253,"_2452":42332},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_2926":234,"_25561":201,"_17855":42334,"_5":17750,"_24230":42253,"_2452":42335},[],"See Access control for the principal and policy model.",{"_2926":235,"_25561":201,"_17855":42337,"_5":17750,"_24230":42257,"_2452":42338},[],"To install a local checkout instead:",{"_2926":236,"_25561":201,"_17855":42340,"_5":17750,"_24230":42261,"_2452":42341},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_2926":237,"_25561":201,"_17855":42343,"_5":17750,"_24230":42261,"_2452":42344},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_2926":238,"_25561":201,"_17855":42346,"_5":17750,"_24230":42265,"_2452":42347},[],"Before going live, review:",{"_2926":239,"_25561":201,"_17855":42349,"_5":17750,"_24230":42265,"_2452":42350},[],"backup and recovery for PostgreSQL and persistent volumes",{"_2926":240,"_25561":201,"_17855":42352,"_5":17750,"_24230":42265,"_2452":42353},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_2926":241,"_25561":201,"_17855":42355,"_5":17750,"_24230":42265,"_2452":42356},[],"shared VA storage before increasing VA replicas",{"_2926":242,"_25561":201,"_17855":42358,"_5":17750,"_24230":42265,"_2452":42359},[],"managed OIDC roles and removal of evaluation credentials",{"_2926":243,"_25561":201,"_17855":42361,"_5":17750,"_24230":42265,"_2452":42362},[],"a trusted TLS issuer or externally managed certificate",{"_2926":244,"_25561":201,"_17855":42364,"_5":17750,"_24230":42265,"_2452":42365},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_2926":245,"_25561":201,"_17855":42367,"_5":17750,"_24230":42265,"_2452":42368},[],"SMTP, observability and alert delivery",{"_2926":246,"_25561":201,"_17855":42370,"_5":17750,"_24230":42265,"_2452":42371},[],"the migration notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_2926":247,"_25561":201,"_17855":42373,"_5":17750,"_24230":42265,"_2452":42374},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_2926":248,"_25561":248,"_5":12525,"_2452":42376,"_25885":42377,"_17855":42378,"_24230":248},"Expose the Gateway",[41651,41652,41758],[],{"_2926":249,"_25561":248,"_17855":42380,"_5":17750,"_24230":248,"_2452":42381},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_2926":250,"_25561":248,"_5":25882,"_17855":42383,"_24230":42384,"_2452":42385},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_2926":251,"_25561":248,"_5":25882,"_17855":42387,"_24230":42388,"_2452":42389},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_2926":252,"_25561":248,"_5":25882,"_17855":42391,"_24230":42392,"_2452":42393},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_2926":253,"_25561":248,"_5":25882,"_17855":42395,"_24230":42396,"_2452":42397},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_2926":254,"_25561":248,"_5":25882,"_17855":42399,"_24230":42400,"_2452":42401},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_2926":255,"_25561":248,"_5":25882,"_17855":42403,"_24230":42404,"_2452":42405},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_2926":256,"_25561":248,"_5":25882,"_17855":42407,"_24230":42408,"_2452":42409},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_2926":257,"_25561":248,"_5":25882,"_17855":42411,"_24230":42412,"_2452":42413},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_2926":258,"_25561":248,"_5":25882,"_17855":42415,"_24230":42416,"_2452":42417},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_2926":259,"_25561":248,"_17855":42419,"_5":17750,"_24230":42384,"_2452":42420},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_2926":260,"_25561":248,"_17855":42422,"_5":17750,"_24230":42384,"_2452":42423},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_2926":261,"_25561":248,"_17855":42425,"_5":17750,"_24230":42388,"_2452":42426},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_2926":262,"_25561":248,"_17855":42428,"_5":17750,"_24230":42388,"_2452":42429},[],"Set it only when:",{"_2926":263,"_25561":248,"_17855":42431,"_5":17750,"_24230":42388,"_2452":42432},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_2926":264,"_25561":248,"_17855":42434,"_5":17750,"_24230":42388,"_2452":42435},[],"that address is allocated to this Gateway",{"_2926":265,"_25561":248,"_17855":42437,"_5":17750,"_24230":42388,"_2452":42438},[],"the surrounding network already routes traffic for it to the cluster",{"_2926":266,"_25561":248,"_17855":42440,"_5":17750,"_24230":42388,"_2452":42441},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_2926":267,"_25561":248,"_17855":42443,"_5":17750,"_24230":42388,"_2452":42444},[],"Keep these two settings separate:",{"_2926":268,"_25561":248,"_17855":42446,"_5":17750,"_24230":42388,"_2452":42447},[],"`gateway.addresses` requests an address for the Gateway.",{"_2926":269,"_25561":248,"_17855":42449,"_5":17750,"_24230":42388,"_2452":42450},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_2926":270,"_25561":248,"_17855":42452,"_5":17750,"_24230":42388,"_2452":42453},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_2926":271,"_25561":248,"_17855":42455,"_5":17750,"_24230":42392,"_2452":42456},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_2926":272,"_25561":248,"_17855":42458,"_5":17750,"_24230":42392,"_2452":42459},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_2926":273,"_25561":248,"_17855":42461,"_5":17750,"_24230":42396,"_2452":42462},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_2926":274,"_25561":248,"_17855":42464,"_5":17750,"_24230":42396,"_2452":42465},[],"For the recommended design:",{"_2926":275,"_25561":248,"_17855":42467,"_5":17750,"_24230":42396,"_2452":42468},[],"Use only one externally exposed Lamassu Gateway.",{"_2926":276,"_25561":248,"_17855":42470,"_5":17750,"_24230":42396,"_2452":42471},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_2926":277,"_25561":248,"_17855":42473,"_5":17750,"_24230":42396,"_2452":42474},[],"Allow those ports through the VM firewall and any upstream security group.",{"_2926":278,"_25561":248,"_17855":42476,"_5":17750,"_24230":42396,"_2452":42477},[],"Point DNS at the VM's reachable address.",{"_2926":279,"_25561":248,"_17855":42479,"_5":17750,"_24230":42396,"_2452":42480},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_2926":280,"_25561":248,"_17855":42482,"_5":17750,"_24230":42400,"_2452":42483},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_2926":281,"_25561":248,"_17855":42485,"_5":17750,"_24230":42404,"_2452":42486},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_2926":282,"_25561":248,"_17855":42488,"_5":17750,"_24230":42404,"_2452":42489},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_2926":283,"_25561":248,"_17855":42491,"_5":17750,"_24230":42408,"_2452":42492},[],"First decide whether you need three independent data planes or only three hostnames.",{"_2926":284,"_25561":248,"_17855":42494,"_5":17750,"_24230":42408,"_2452":42495},[],"Requirement",{"_2926":285,"_25561":248,"_17855":42497,"_5":17750,"_24230":42408,"_2452":42498},[],"Recommended design",{"_2926":286,"_25561":248,"_17855":42500,"_5":17750,"_24230":42408,"_2452":42501},[],"Consequence",{"_2926":287,"_25561":248,"_17855":42503,"_5":17750,"_24230":42408,"_2452":42504},[],"Several Lamassu URLs or services",{"_2926":288,"_25561":248,"_17855":42506,"_5":17750,"_24230":42408,"_2452":42507},[],"One Gateway with multiple routes",{"_2926":289,"_25561":248,"_17855":42509,"_5":17750,"_24230":42408,"_2452":42510},[],"One IP and one proxy fleet; this is the chart default",{"_2926":290,"_25561":248,"_17855":42512,"_5":17750,"_24230":42408,"_2452":42513},[],"Independent Gateways and separate external IPs",{"_2926":291,"_25561":248,"_17855":42515,"_5":17750,"_24230":42408,"_2452":42516},[],"One VIP per Gateway",{"_2926":292,"_25561":248,"_17855":42518,"_5":17750,"_24230":42408,"_2452":42519},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_2926":293,"_25561":248,"_17855":42521,"_5":17750,"_24230":42408,"_2452":42522},[],"Independent Gateways on one node and one IP",{"_2926":294,"_25561":248,"_17855":42524,"_5":17750,"_24230":42408,"_2452":42525},[],"Use different external ports",{"_2926":295,"_25561":248,"_17855":42527,"_5":17750,"_24230":42408,"_2452":42528},[],"Clients must include non-standard ports",{"_2926":296,"_25561":248,"_17855":42530,"_5":17750,"_24230":42408,"_2452":42531},[],"Separate TLS/mTLS termination behind one IP",{"_2926":297,"_25561":248,"_17855":42533,"_5":17750,"_24230":42408,"_2452":42534},[],"Front-door SNI routing to internal Gateways",{"_2926":298,"_25561":248,"_17855":42536,"_5":17750,"_24230":42408,"_2452":42537},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_2926":299,"_25561":248,"_17855":42539,"_5":17750,"_24230":42408,"_2452":42540},[],"Separate Gateway resources but shared proxy infrastructure",{"_2926":300,"_25561":248,"_17855":42542,"_5":17750,"_24230":42408,"_2452":42543},[],"Envoy merged-Gateway mode",{"_2926":301,"_25561":248,"_17855":42545,"_5":17750,"_24230":42408,"_2452":42546},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_2926":302,"_25561":248,"_17855":42548,"_5":17750,"_24230":42408,"_2452":42549},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_2926":303,"_25561":248,"_17855":42551,"_5":17750,"_24230":42408,"_2452":42552},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_2926":304,"_25561":248,"_17855":42554,"_5":17750,"_24230":42408,"_2452":42555},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_2926":305,"_25561":248,"_17855":42557,"_5":17750,"_24230":42408,"_2452":42558},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_2926":306,"_25561":248,"_17855":42560,"_5":17750,"_24230":42412,"_2452":42561},[],"If one Gateway can own TLS and routing, use the chart default.",{"_2926":307,"_25561":248,"_17855":42563,"_5":17750,"_24230":42412,"_2452":42564},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_2926":308,"_25561":248,"_17855":42566,"_5":17750,"_24230":42412,"_2452":42567},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_2926":309,"_25561":248,"_17855":42569,"_5":17750,"_24230":42412,"_2452":42570},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_2926":310,"_25561":248,"_17855":42572,"_5":17750,"_24230":42412,"_2452":42573},[],"If none of those are possible, use different external ports or change the external network design.",{"_2926":311,"_25561":248,"_17855":42575,"_5":17750,"_24230":42416,"_2452":42576},[],"Check, in order:",{"_2926":312,"_25561":248,"_17855":42578,"_5":17750,"_24230":42416,"_2452":42579},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_2926":313,"_25561":248,"_17855":42581,"_5":17750,"_24230":42416,"_2452":42582},[],"Its status contains the expected address.",{"_2926":314,"_25561":248,"_17855":42584,"_5":17750,"_24230":42416,"_2452":42585},[],"The generated `LoadBalancer` Service has a usable external address.",{"_2926":315,"_25561":248,"_17855":42587,"_5":17750,"_24230":42416,"_2452":42588},[],"Port 443 reaches that address from the client network.",{"_2926":316,"_25561":248,"_17855":42590,"_5":17750,"_24230":42416,"_2452":42591},[],"DNS resolves to the externally reachable endpoint.",{"_2926":317,"_25561":248,"_17855":42593,"_5":17750,"_24230":42416,"_2452":42594},[],"The certificate contains the DNS name or IP used by the client.",{"_2926":318,"_25561":248,"_17855":42596,"_5":17750,"_24230":42416,"_2452":42597},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_2926":319,"_25561":319,"_5":12525,"_2452":41758,"_25885":42599,"_17855":42600,"_24230":319},[41651,41652,41758],[],{"_2926":320,"_25561":319,"_17855":42602,"_5":17750,"_24230":319,"_2452":42603},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_2926":321,"_25561":319,"_5":25882,"_17855":42605,"_24230":42606,"_2452":42607},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_2926":322,"_25561":319,"_5":25882,"_17855":42609,"_24230":42610,"_2452":42611},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_2926":323,"_25561":319,"_5":25882,"_17855":42613,"_24230":42614,"_2452":42615},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_2926":324,"_25561":319,"_5":25882,"_17855":42617,"_24230":42618,"_2452":42619},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_2926":325,"_25561":319,"_5":25882,"_17855":42621,"_24230":42622,"_2452":42623},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_2926":326,"_25561":319,"_5":25882,"_17855":42625,"_24230":42626,"_2452":42627},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_2926":327,"_25561":319,"_17855":42629,"_5":17750,"_24230":42606,"_2452":42630},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_2926":328,"_25561":319,"_17855":42632,"_5":17750,"_24230":42610,"_2452":42633},[],"Workflow",{"_2926":329,"_25561":319,"_17855":42635,"_5":17750,"_24230":42610,"_2452":42636},[],"Use it for",{"_2926":330,"_25561":319,"_17855":42638,"_5":17750,"_24230":42610,"_2452":42639},[],"What it installs",{"_2926":331,"_25561":319,"_17855":42641,"_5":17750,"_24230":42610,"_2452":42642},[],"Helm",{"_2926":332,"_25561":319,"_17855":42644,"_5":17750,"_24230":42610,"_2452":42645},[],"Production and controlled environments",{"_2926":333,"_25561":319,"_17855":42647,"_5":17750,"_24230":42610,"_2452":42648},[],"Lamassu services and Gateway API resources",{"_2926":334,"_25561":319,"_17855":42650,"_5":17750,"_24230":42610,"_2452":41895},[],{"_2926":335,"_25561":319,"_17855":42652,"_5":17750,"_24230":42610,"_2452":42653},[],"Evaluation, demos, CI and small lab clusters",{"_2926":336,"_25561":319,"_17855":42655,"_5":17750,"_24230":42610,"_2452":42656},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_2926":337,"_25561":319,"_17855":42658,"_5":17750,"_24230":42614,"_2452":42659},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_2926":338,"_25561":319,"_17855":42661,"_5":17750,"_24230":42614,"_2452":42662},[],"Area",{"_2926":339,"_25561":319,"_17855":42664,"_5":17750,"_24230":42614,"_2452":42665},[],"The Lamassu chart provides",{"_2926":340,"_25561":319,"_17855":42667,"_5":17750,"_24230":42614,"_2452":42668},[],"You provide",{"_2926":341,"_25561":319,"_17855":42670,"_5":17750,"_24230":42614,"_2452":42671},[],"Lamassu applications",{"_2926":342,"_25561":319,"_17855":42673,"_5":17750,"_24230":42614,"_2452":42674},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_2926":343,"_25561":319,"_17855":42676,"_5":17750,"_24230":42614,"_2452":42677},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_2926":344,"_25561":319,"_17855":42679,"_5":17750,"_24230":42614,"_2452":42680},[],"PostgreSQL data",{"_2926":345,"_25561":319,"_17855":42682,"_5":17750,"_24230":42614,"_2452":42683},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_2926":346,"_25561":319,"_17855":42685,"_5":17750,"_24230":42614,"_2452":42686},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_2926":347,"_25561":319,"_17855":42688,"_5":17750,"_24230":42614,"_2452":42689},[],"Messaging",{"_2926":348,"_25561":319,"_17855":42691,"_5":17750,"_24230":42614,"_2452":42692},[],"RabbitMQ connection configuration for the Lamassu services",{"_2926":349,"_25561":319,"_17855":42694,"_5":17750,"_24230":42614,"_2452":42695},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_2926":350,"_25561":319,"_17855":42697,"_5":17750,"_24230":42614,"_2452":42698},[],"Identity",{"_2926":351,"_25561":319,"_17855":42700,"_5":17750,"_24230":42614,"_2452":42701},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_2926":352,"_25561":319,"_17855":42703,"_5":17750,"_24230":42614,"_2452":42704},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_2926":353,"_25561":319,"_17855":42706,"_5":17750,"_24230":42614,"_2452":42707},[],"External routing",{"_2926":354,"_25561":319,"_17855":42709,"_5":17750,"_24230":42614,"_2452":42710},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_2926":355,"_25561":319,"_17855":42712,"_5":17750,"_24230":42614,"_2452":42713},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_2926":356,"_25561":319,"_17855":42715,"_5":17750,"_24230":42614,"_2452":42716},[],"TLS",{"_2926":357,"_25561":319,"_17855":42718,"_5":17750,"_24230":42614,"_2452":42719},[],"cert-manager `Issuer` and CA `Certificate` resources; either a chart-managed downstream `Certificate` or a reference to your TLS Secret",{"_2926":358,"_25561":319,"_17855":42721,"_5":17750,"_24230":42614,"_2452":42722},[],"cert-manager itself; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_2926":359,"_25561":319,"_17855":42724,"_5":17750,"_24230":42614,"_2452":42725},[],"Persistent application data",{"_2926":360,"_25561":319,"_17855":42727,"_5":17750,"_24230":42614,"_2452":42728},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_2926":361,"_25561":319,"_17855":42730,"_5":17750,"_24230":42614,"_2452":42731},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_2926":362,"_25561":319,"_17855":42733,"_5":17750,"_24230":42614,"_2452":42734},[],"Optional integrations",{"_2926":363,"_25561":319,"_17855":42736,"_5":17750,"_24230":42614,"_2452":42737},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_2926":364,"_25561":319,"_17855":42739,"_5":17750,"_24230":42614,"_2452":42740},[],"The observability backends, cloud credentials and production HSM or external key service",{"_2926":365,"_25561":319,"_17855":42742,"_5":17750,"_24230":42614,"_2452":42743},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_2926":366,"_25561":319,"_17855":42745,"_5":17750,"_24230":42614,"_2452":42746},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_2926":367,"_25561":319,"_17855":42748,"_5":17750,"_24230":42618,"_2452":42749},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_2926":368,"_25561":319,"_17855":42751,"_5":17750,"_24230":42618,"_2452":42752},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_2926":369,"_25561":319,"_17855":42754,"_5":17750,"_24230":42622,"_2452":42755},[],"Kubernetes 1.24 or newer",{"_2926":370,"_25561":319,"_17855":42757,"_5":17750,"_24230":42622,"_2452":42758},[],"Helm 3.2 or newer",{"_2926":371,"_25561":319,"_17855":42760,"_5":17750,"_24230":42622,"_2452":42761},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_2926":372,"_25561":319,"_17855":42763,"_5":17750,"_24230":42622,"_2452":42764},[],"cert-manager 1.14 or newer; the current chart renders cert-manager issuer and certificate resources",{"_2926":373,"_25561":319,"_17855":42766,"_5":17750,"_24230":42622,"_2452":42767},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_2926":374,"_25561":319,"_17855":42769,"_5":17750,"_24230":42622,"_2452":42770},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_2926":375,"_25561":319,"_17855":42772,"_5":17750,"_24230":42622,"_2452":42773},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer.",{"_2926":376,"_25561":319,"_17855":42775,"_5":17750,"_24230":42626,"_2452":42776},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_2926":377,"_25561":319,"_17855":42778,"_5":17750,"_24230":42626,"_2452":42779},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_2926":378,"_25561":319,"_17855":42781,"_5":17750,"_24230":42626,"_2452":42782},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_2926":379,"_25561":379,"_5":12525,"_2452":42784,"_25885":42785,"_17855":42787,"_24230":379},"Deployment troubleshooting",[41651,41652,42786],"Operations",[],{"_2926":380,"_25561":379,"_17855":42789,"_5":17750,"_24230":379,"_2452":42790},[],"Diagnose access, service health and infrastructure dependencies.",{"_2926":381,"_25561":379,"_5":25882,"_17855":42792,"_24230":42793,"_2452":42794},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_2926":382,"_25561":379,"_5":25882,"_17855":42796,"_24230":42797,"_2452":42798},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_2926":383,"_25561":379,"_5":25882,"_17855":42800,"_24230":42801,"_2452":42802},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_2926":384,"_25561":379,"_5":25882,"_17855":42804,"_24230":42805,"_2452":42806},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_2926":385,"_25561":379,"_5":25882,"_17855":42808,"_24230":42809,"_2452":42810},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_2926":386,"_25561":379,"_5":25882,"_17855":42812,"_24230":42813,"_2452":42814},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_2926":387,"_25561":379,"_5":25882,"_17855":42816,"_24230":42817,"_2452":42818},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_2926":388,"_25561":379,"_5":25882,"_17855":42820,"_24230":42821,"_2452":42822},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_2926":389,"_25561":379,"_5":25882,"_17855":42824,"_24230":42825,"_2452":42826},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_2926":390,"_25561":379,"_5":25882,"_17855":42828,"_24230":42829,"_2452":42830},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_2926":391,"_25561":379,"_5":25882,"_17855":42832,"_24230":42833,"_2452":42834},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_2926":392,"_25561":379,"_5":25882,"_17855":42836,"_24230":42837,"_2452":42838},[],"/docs/deployment/troubleshooting#observability","Observability",{"_2926":393,"_25561":379,"_17855":42840,"_5":17750,"_24230":379,"_2452":42841},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_2926":394,"_25561":379,"_17855":42843,"_5":17750,"_24230":42797,"_2452":42844},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_2926":395,"_25561":379,"_17855":42846,"_5":17750,"_24230":42801,"_2452":42847},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_2926":396,"_25561":379,"_17855":42849,"_5":17750,"_24230":42805,"_2452":42850},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_2926":397,"_25561":379,"_17855":42852,"_5":17750,"_24230":42809,"_2452":42853},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_2926":398,"_25561":379,"_17855":42855,"_5":17750,"_24230":42813,"_2452":42856},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_2926":399,"_25561":379,"_17855":42858,"_5":17750,"_24230":42817,"_2452":42859},[],"Replace the placeholders with your real release, namespace and deployment.",{"_2926":400,"_25561":379,"_17855":42861,"_5":17750,"_24230":42817,"_2452":42862},[],"Also run the chart's connectivity test:",{"_2926":401,"_25561":379,"_17855":42864,"_5":17750,"_24230":42817,"_2452":42865},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_2926":402,"_25561":379,"_17855":42867,"_5":17750,"_24230":42817,"_2452":42868},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_2926":403,"_25561":379,"_17855":42870,"_5":17750,"_24230":42821,"_2452":42871},[],"If you receive a 401:",{"_2926":404,"_25561":379,"_17855":42873,"_5":17750,"_24230":42821,"_2452":42874},[],"check that the UI's OIDC authority is reachable from the browser;",{"_2926":405,"_25561":379,"_17855":42876,"_5":17750,"_24230":42821,"_2452":42877},[],"verify issuer, audience and expiration of the token;",{"_2926":406,"_25561":379,"_17855":42879,"_5":17750,"_24230":42821,"_2452":42880},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_2926":407,"_25561":379,"_17855":42882,"_5":17750,"_24230":42821,"_2452":42883},[],"check that the provider's public and internal routes point to the same realm.",{"_2926":408,"_25561":379,"_17855":42885,"_5":17750,"_24230":42821,"_2452":42886},[],"If login succeeds but the APIs return 403:",{"_2926":409,"_25561":379,"_17855":42888,"_5":17750,"_24230":42821,"_2452":42889},[],"inspect the token's real claims;",{"_2926":410,"_25561":379,"_17855":42891,"_5":17750,"_24230":42821,"_2452":42892},[],"confirm they match an active principal;",{"_2926":411,"_25561":379,"_17855":42894,"_5":17750,"_24230":42821,"_2452":42895},[],"review the policies granted to that principal;",{"_2926":412,"_25561":379,"_17855":42897,"_5":17750,"_24230":42821,"_2452":42898},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_2926":413,"_25561":379,"_17855":42900,"_5":17750,"_24230":42821,"_2452":42901},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_2926":414,"_25561":379,"_17855":42903,"_5":17750,"_24230":42825,"_2452":42904},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_2926":415,"_25561":379,"_17855":42906,"_5":17750,"_24230":42825,"_2452":42907},[],"Locate the authz pod and Service.",{"_2926":416,"_25561":379,"_17855":42909,"_5":17750,"_24230":42825,"_2452":42910},[],"Check /health, logs and its database connection.",{"_2926":417,"_25561":379,"_17855":42912,"_5":17750,"_24230":42825,"_2452":42913},[],"Verify the DNS and port configured in externalAuthorization.",{"_2926":418,"_25561":379,"_17855":42915,"_5":17750,"_24230":42825,"_2452":42916},[],"Check the check route is /v1/ext\\_authz/check.",{"_2926":419,"_25561":379,"_17855":42918,"_5":17750,"_24230":42825,"_2452":42919},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_2926":420,"_25561":379,"_17855":42921,"_5":17750,"_24230":42829,"_2452":42922},[],"Review kubectl describe pod first. Common causes are:",{"_2926":421,"_25561":379,"_17855":42924,"_5":17750,"_24230":42829,"_2452":42925},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_2926":422,"_25561":379,"_17855":42927,"_5":17750,"_24230":42829,"_2452":42928},[],"unbound persistent volume;",{"_2926":423,"_25561":379,"_17855":42930,"_5":17750,"_24230":42829,"_2452":42931},[],"inaccessible image or incorrect pull policy;",{"_2926":424,"_25561":379,"_17855":42933,"_5":17750,"_24230":42829,"_2452":42934},[],"invalid cryptographic engine configuration;",{"_2926":425,"_25561":379,"_17855":42936,"_5":17750,"_24230":42829,"_2452":42937},[],"CPU or memory limits set too low;",{"_2926":426,"_25561":379,"_17855":42939,"_5":17750,"_24230":42829,"_2452":42940},[],"an incomplete prior migration.",{"_2926":427,"_25561":379,"_17855":42942,"_5":17750,"_24230":42829,"_2452":42943},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_2926":428,"_25561":379,"_17855":42945,"_5":17750,"_24230":42829,"_2452":42946},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_2926":429,"_25561":379,"_17855":42948,"_5":17750,"_24230":42833,"_2452":42949},[],"Domain and audit events depend on the bus publisher:",{"_2926":430,"_25561":379,"_17855":42951,"_5":17750,"_24230":42833,"_2452":42952},[],"verify it is enabled in the emitting service;",{"_2926":431,"_25561":379,"_17855":42954,"_5":17750,"_24230":42833,"_2452":42955},[],"check AMQP connectivity and credentials;",{"_2926":432,"_25561":379,"_17855":42957,"_5":17750,"_24230":42833,"_2452":42958},[],"review exchange, routing key, queues and consumers;",{"_2926":433,"_25561":379,"_17855":42960,"_5":17750,"_24230":42833,"_2452":42961},[],"inspect dead-letter queues;",{"_2926":434,"_25561":379,"_17855":42963,"_5":17750,"_24230":42833,"_2452":42964},[],"alert on orphan durable queues and backlog growth.",{"_2926":435,"_25561":379,"_17855":42966,"_5":17750,"_24230":42833,"_2452":42967},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_2926":436,"_25561":379,"_17855":42969,"_5":17750,"_24230":42837,"_2452":42970},[],"The chart can enable OpenTelemetry instrumentation. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, authz, service and dependency.",{"_2926":437,"_25561":379,"_17855":42972,"_5":17750,"_24230":42837,"_2452":42973},[],"Before closing an incident, record:",{"_2926":438,"_25561":379,"_17855":42975,"_5":17750,"_24230":42837,"_2452":42976},[],"the confirmed cause;",{"_2926":439,"_25561":379,"_17855":42978,"_5":17750,"_24230":42837,"_2452":42979},[],"the time scope and affected resources;",{"_2926":440,"_25561":379,"_17855":42981,"_5":17750,"_24230":42837,"_2452":42982},[],"the commands or queries used;",{"_2926":441,"_25561":379,"_17855":42984,"_5":17750,"_24230":42837,"_2452":42985},[],"the applied change and how to revert it;",{"_2926":442,"_25561":379,"_17855":42987,"_5":17750,"_24230":42837,"_2452":42988},[],"validation from a consumer;",{"_2926":443,"_25561":379,"_17855":42990,"_5":17750,"_24230":42837,"_2452":42991},[],"the preventive action and its owner.",{"_2926":444,"_25561":444,"_5":12525,"_2452":42993,"_25885":42994,"_17855":42997,"_24230":444},"Access control",[41651,42995,42996],"Platform","Administration",[],{"_2926":445,"_25561":444,"_17855":42999,"_5":17750,"_24230":444,"_2452":43000},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_2926":446,"_25561":444,"_5":25882,"_17855":43002,"_24230":43003,"_2452":43004},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_2926":447,"_25561":444,"_5":25882,"_17855":43006,"_24230":43007,"_2452":43008},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_2926":448,"_25561":444,"_5":25882,"_17855":43010,"_24230":43011,"_2452":43012},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_2926":449,"_25561":444,"_5":25882,"_17855":43014,"_24230":43015,"_2452":43016},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_2926":450,"_25561":444,"_5":25882,"_17855":43018,"_24230":43019,"_2452":43020},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_2926":451,"_25561":444,"_5":25882,"_17855":43022,"_24230":43023,"_2452":43024},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_2926":452,"_25561":444,"_5":25882,"_17855":43026,"_24230":43027,"_2452":43028},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_2926":453,"_25561":444,"_5":25882,"_17855":43030,"_24230":43031,"_2452":43032},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_2926":454,"_25561":444,"_5":25882,"_17855":43034,"_24230":43035,"_2452":43036},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_2926":455,"_25561":444,"_5":25882,"_17855":43038,"_24230":43039,"_2452":43040},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_2926":456,"_25561":444,"_5":25882,"_17855":43042,"_24230":43043,"_2452":43044},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_2926":457,"_25561":444,"_5":25882,"_17855":43046,"_24230":43047,"_2452":43048},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_2926":458,"_25561":444,"_5":25882,"_17855":43050,"_24230":43051,"_2452":43052},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_2926":459,"_25561":444,"_5":25882,"_17855":43054,"_24230":43055,"_2452":43056},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_2926":460,"_25561":444,"_5":25882,"_17855":43058,"_24230":43059,"_2452":43060},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_2926":461,"_25561":444,"_5":25882,"_17855":43062,"_24230":43063,"_2452":42254},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_2926":462,"_25561":444,"_5":25882,"_17855":43065,"_24230":43066,"_2452":43067},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_2926":463,"_25561":444,"_5":25882,"_17855":43069,"_24230":43070,"_2452":43071},[],"/docs/platform/administration/access-control#configure-the-two-jwt-validations","Configure the two JWT validations",{"_2926":464,"_25561":444,"_5":25882,"_17855":43073,"_24230":43074,"_2452":43075},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_2926":465,"_25561":444,"_5":25882,"_17855":43077,"_24230":43078,"_2452":43079},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_2926":466,"_25561":444,"_5":25882,"_17855":43081,"_24230":43082,"_2452":43083},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_2926":467,"_25561":444,"_5":25882,"_17855":43085,"_24230":43086,"_2452":43087},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_2926":468,"_25561":444,"_5":25882,"_17855":43089,"_24230":43090,"_2452":43091},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_2926":469,"_25561":444,"_5":25882,"_17855":43093,"_24230":43094,"_2452":43095},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_2926":470,"_25561":444,"_5":25882,"_17855":43097,"_24230":43098,"_2452":43099},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_2926":471,"_25561":444,"_5":25882,"_17855":43101,"_24230":43102,"_2452":43103},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_2926":472,"_25561":444,"_5":25882,"_17855":43105,"_24230":43106,"_2452":43107},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_2926":473,"_25561":444,"_5":25882,"_17855":43109,"_24230":43110,"_2452":43111},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_2926":474,"_25561":444,"_5":25882,"_17855":43113,"_24230":43114,"_2452":43115},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_2926":475,"_25561":444,"_5":25882,"_17855":43117,"_24230":43118,"_2452":43119},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_2926":476,"_25561":444,"_5":25882,"_17855":43121,"_24230":43122,"_2452":43123},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_2926":477,"_25561":444,"_17855":43125,"_5":17750,"_24230":444,"_2452":43126},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_2926":478,"_25561":444,"_17855":43128,"_5":17750,"_24230":444,"_2452":43129},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_2926":479,"_25561":444,"_17855":43131,"_5":17750,"_24230":444,"_2452":43132},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_2926":480,"_25561":444,"_17855":43134,"_5":17750,"_24230":43003,"_2452":43135},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_2926":481,"_25561":444,"_17855":43137,"_5":17750,"_24230":43003,"_2452":43138},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_2926":482,"_25561":444,"_17855":43140,"_5":17750,"_24230":43003,"_2452":43141},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_2926":483,"_25561":444,"_17855":43143,"_5":17750,"_24230":43003,"_2452":43144},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_2926":484,"_25561":444,"_17855":43146,"_5":17750,"_24230":43003,"_2452":43147},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_2926":485,"_25561":444,"_17855":43149,"_5":17750,"_24230":43003,"_2452":43150},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_2926":486,"_25561":444,"_17855":43152,"_5":17750,"_24230":43007,"_2452":43153},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_2926":487,"_25561":444,"_17855":43155,"_5":17750,"_24230":43007,"_2452":43156},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_2926":488,"_25561":444,"_17855":43158,"_5":17750,"_24230":43011,"_2452":43159},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_2926":489,"_25561":444,"_17855":43161,"_5":17750,"_24230":43011,"_2452":43162},[],"The decision is made **before forwarding the request to the service**:",{"_2926":490,"_25561":444,"_17855":43164,"_5":17750,"_24230":43011,"_2452":43165},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_2926":491,"_25561":444,"_17855":43167,"_5":17750,"_24230":43011,"_2452":43168},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_2926":492,"_25561":444,"_17855":43170,"_5":17750,"_24230":43011,"_2452":43171},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_2926":493,"_25561":444,"_17855":43173,"_5":17750,"_24230":43011,"_2452":43174},[],"It separately loads the policies granted to each principal.",{"_2926":494,"_25561":444,"_17855":43176,"_5":17750,"_24230":43011,"_2452":43177},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_2926":495,"_25561":444,"_17855":43179,"_5":17750,"_24230":43011,"_2452":43180},[],"`authz` looks for an HTTP rule granting that action.",{"_2926":496,"_25561":444,"_17855":43182,"_5":17750,"_24230":43011,"_2452":43183},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_2926":497,"_25561":444,"_17855":43185,"_5":17750,"_24230":43011,"_2452":43186},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_2926":498,"_25561":444,"_17855":43188,"_5":17750,"_24230":43011,"_2452":43189},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_2926":499,"_25561":444,"_17855":43191,"_5":17750,"_24230":43011,"_2452":43192},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_2926":500,"_25561":444,"_17855":43194,"_5":17750,"_24230":43015,"_2452":43195},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_2926":501,"_25561":444,"_17855":43197,"_5":17750,"_24230":43015,"_2452":43198},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_2926":502,"_25561":444,"_17855":43200,"_5":17750,"_24230":43015,"_2452":43201},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_2926":503,"_25561":444,"_17855":43203,"_5":17750,"_24230":43015,"_2452":43204},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_2926":504,"_25561":444,"_17855":43206,"_5":17750,"_24230":43015,"_2452":43207},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_2926":505,"_25561":444,"_17855":43209,"_5":17750,"_24230":43015,"_2452":43210},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_2926":506,"_25561":444,"_17855":43212,"_5":17750,"_24230":43015,"_2452":43213},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_2926":507,"_25561":444,"_17855":43215,"_5":17750,"_24230":43015,"_2452":43216},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_2926":508,"_25561":444,"_17855":43218,"_5":17750,"_24230":43019,"_2452":43219},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_2926":509,"_25561":444,"_17855":43221,"_5":17750,"_24230":43019,"_2452":43222},[],"The decision is made with the domain operation context:",{"_2926":510,"_25561":444,"_17855":43224,"_5":17750,"_24230":43019,"_2452":43225},[],"The middleware extracts the credential and resolves the matching principals.",{"_2926":511,"_25561":444,"_17855":43227,"_5":17750,"_24230":43019,"_2452":43228},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_2926":512,"_25561":444,"_17855":43230,"_5":17750,"_24230":43019,"_2452":43231},[],"`authz` gathers the entity rules of the granted policies.",{"_2926":513,"_25561":444,"_17855":43233,"_5":17750,"_24230":43019,"_2452":43234},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_2926":514,"_25561":444,"_17855":43236,"_5":17750,"_24230":43019,"_2452":43237},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_2926":515,"_25561":444,"_17855":43239,"_5":17750,"_24230":43019,"_2452":43240},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_2926":516,"_25561":444,"_17855":43242,"_5":17750,"_24230":43019,"_2452":43243},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_2926":517,"_25561":444,"_17855":43245,"_5":17750,"_24230":43019,"_2452":43246},[],"Actions fall into two groups:",{"_2926":518,"_25561":444,"_17855":43248,"_5":17750,"_24230":43019,"_2452":43249},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_2926":519,"_25561":444,"_17855":43251,"_5":17750,"_24230":43019,"_2452":43252},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_2926":520,"_25561":444,"_17855":43254,"_5":17750,"_24230":43019,"_2452":43255},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_2926":521,"_25561":444,"_17855":43257,"_5":17750,"_24230":43023,"_2452":43258},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_2926":522,"_25561":444,"_17855":43260,"_5":17750,"_24230":43023,"_2452":43261},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_2926":523,"_25561":444,"_17855":43263,"_5":17750,"_24230":43023,"_2452":43264},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_2926":524,"_25561":444,"_17855":43266,"_5":17750,"_24230":43027,"_2452":43267},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_2926":525,"_25561":444,"_17855":43269,"_5":17750,"_24230":43027,"_2452":43270},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_2926":526,"_25561":444,"_17855":43272,"_5":17750,"_24230":43027,"_2452":43273},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_2926":527,"_25561":444,"_17855":43275,"_5":17750,"_24230":43027,"_2452":43276},[],"The implemented operators are:",{"_2926":528,"_25561":444,"_17855":43278,"_5":17750,"_24230":43027,"_2452":43279},[],"`equals`, for exact equality;",{"_2926":529,"_25561":444,"_17855":43281,"_5":17750,"_24230":43027,"_2452":43282},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_2926":530,"_25561":444,"_17855":43284,"_5":17750,"_24230":43027,"_2452":43285},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_2926":531,"_25561":444,"_17855":43287,"_5":17750,"_24230":43027,"_2452":43288},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_2926":532,"_25561":444,"_17855":43290,"_5":17750,"_24230":43031,"_2452":43291},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_2926":533,"_25561":444,"_17855":43293,"_5":17750,"_24230":43031,"_2452":43294},[],"The available modes are:",{"_2926":534,"_25561":444,"_17855":43296,"_5":17750,"_24230":43031,"_2452":43297},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_2926":535,"_25561":444,"_17855":43299,"_5":17750,"_24230":43031,"_2452":43300},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_2926":536,"_25561":444,"_17855":43302,"_5":17750,"_24230":43031,"_2452":43303},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_2926":537,"_25561":444,"_17855":43305,"_5":17750,"_24230":43031,"_2452":43306},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_2926":538,"_25561":444,"_17855":43308,"_5":17750,"_24230":43031,"_2452":43309},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_2926":539,"_25561":444,"_17855":43311,"_5":17750,"_24230":43031,"_2452":43312},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_2926":540,"_25561":444,"_17855":43314,"_5":17750,"_24230":43035,"_2452":43315},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_2926":541,"_25561":444,"_17855":43317,"_5":17750,"_24230":43035,"_2452":43318},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_2926":542,"_25561":444,"_17855":43320,"_5":17750,"_24230":43035,"_2452":43321},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_2926":543,"_25561":444,"_17855":43323,"_5":17750,"_24230":43035,"_2452":43324},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_2926":544,"_25561":444,"_17855":43326,"_5":17750,"_24230":43043,"_2452":43327},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_2926":545,"_25561":444,"_17855":43329,"_5":17750,"_24230":43043,"_2452":43330},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_2926":546,"_25561":444,"_17855":43332,"_5":17750,"_24230":43047,"_2452":43333},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_2926":547,"_25561":444,"_17855":43335,"_5":17750,"_24230":43047,"_2452":43336},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_2926":548,"_25561":444,"_17855":43338,"_5":17750,"_24230":43051,"_2452":43339},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_2926":549,"_25561":444,"_17855":43341,"_5":17750,"_24230":43051,"_2452":43342},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_2926":550,"_25561":444,"_17855":43344,"_5":17750,"_24230":43051,"_2452":43345},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_2926":551,"_25561":444,"_17855":43347,"_5":17750,"_24230":43055,"_2452":43348},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_2926":552,"_25561":444,"_17855":43350,"_5":17750,"_24230":43055,"_2452":43351},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_2926":553,"_25561":444,"_17855":43353,"_5":17750,"_24230":43055,"_2452":43354},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_2926":554,"_25561":444,"_17855":43356,"_5":17750,"_24230":43055,"_2452":43357},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_2926":555,"_25561":444,"_17855":43359,"_5":17750,"_24230":43055,"_2452":43360},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_2926":556,"_25561":444,"_17855":43362,"_5":17750,"_24230":43055,"_2452":43363},[],"Note that:",{"_2926":557,"_25561":444,"_17855":43365,"_5":17750,"_24230":43055,"_2452":43366},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_2926":558,"_25561":444,"_17855":43368,"_5":17750,"_24230":43055,"_2452":43369},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_2926":559,"_25561":444,"_17855":43371,"_5":17750,"_24230":43055,"_2452":43372},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_2926":560,"_25561":444,"_17855":43374,"_5":17750,"_24230":43059,"_2452":43375},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_2926":561,"_25561":444,"_17855":43377,"_5":17750,"_24230":43059,"_2452":43378},[],"full and read-only access to certificates and authorities;",{"_2926":562,"_25561":444,"_17855":43380,"_5":17750,"_24230":43059,"_2452":43381},[],"full and read-only access to the KMS;",{"_2926":563,"_25561":444,"_17855":43383,"_5":17750,"_24230":43059,"_2452":43384},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_2926":564,"_25561":444,"_17855":43386,"_5":17750,"_24230":43059,"_2452":43387},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_2926":565,"_25561":444,"_17855":43389,"_5":17750,"_24230":43059,"_2452":43390},[],"console access;",{"_2926":566,"_25561":444,"_17855":43392,"_5":17750,"_24230":43059,"_2452":43393},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_2926":567,"_25561":444,"_17855":43395,"_5":17750,"_24230":43059,"_2452":43396},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_2926":568,"_25561":444,"_17855":43398,"_5":17750,"_24230":43059,"_2452":43399},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_2926":569,"_25561":444,"_17855":43401,"_5":17750,"_24230":43063,"_2452":43402},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_2926":570,"_25561":444,"_17855":43404,"_5":17750,"_24230":43063,"_2452":43405},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_2926":571,"_25561":444,"_17855":43407,"_5":17750,"_24230":43063,"_2452":43408},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_2926":572,"_25561":444,"_17855":43410,"_5":17750,"_24230":43066,"_2452":43411},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_2926":573,"_25561":444,"_17855":43413,"_5":17750,"_24230":43070,"_2452":43414},[],"The Gateway uses `auth.authentication.apiGateway.jwks` to authenticate requests. `authz` uses `services.authz.jwkUrl` to resolve OIDC principals. Both endpoints must contain the keys of the same issuer and be reachable from their respective components.",{"_2926":574,"_25561":444,"_17855":43416,"_5":17750,"_24230":43074,"_2452":43417},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_2926":575,"_25561":444,"_17855":43419,"_5":17750,"_24230":43078,"_2452":43420},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_2926":576,"_25561":444,"_17855":43422,"_5":17750,"_24230":43082,"_2452":43423},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_2926":577,"_25561":444,"_17855":43425,"_5":17750,"_24230":43086,"_2452":43426},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_2926":578,"_25561":444,"_17855":43428,"_5":17750,"_24230":43086,"_2452":43429},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_2926":579,"_25561":444,"_17855":43431,"_5":17750,"_24230":43090,"_2452":43432},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_2926":580,"_25561":444,"_17855":43434,"_5":17750,"_24230":43090,"_2452":43435},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_2926":581,"_25561":444,"_17855":43437,"_5":17750,"_24230":43090,"_2452":43438},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_2926":582,"_25561":444,"_17855":43440,"_5":17750,"_24230":43090,"_2452":43441},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_2926":583,"_25561":444,"_17855":43443,"_5":17750,"_24230":43090,"_2452":43444},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_2926":584,"_25561":444,"_17855":43446,"_5":17750,"_24230":43090,"_2452":43447},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_2926":585,"_25561":444,"_17855":43449,"_5":17750,"_24230":43090,"_2452":43450},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_2926":586,"_25561":444,"_17855":43452,"_5":17750,"_24230":43090,"_2452":43453},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_2926":587,"_25561":444,"_17855":43455,"_5":17750,"_24230":43094,"_2452":43456},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_2926":588,"_25561":444,"_17855":43458,"_5":17750,"_24230":43094,"_2452":43459},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_2926":589,"_25561":444,"_17855":43461,"_5":17750,"_24230":43094,"_2452":43462},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_2926":590,"_25561":444,"_17855":43464,"_5":17750,"_24230":43098,"_2452":43465},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_2926":591,"_25561":444,"_17855":43467,"_5":17750,"_24230":43098,"_2452":43468},[],"Use groups or stable roles for people and independent identities for automations.",{"_2926":592,"_25561":444,"_17855":43470,"_5":17750,"_24230":43098,"_2452":43471},[],"Keep at least two recovery administrators and test their access periodically.",{"_2926":593,"_25561":444,"_17855":43473,"_5":17750,"_24230":43098,"_2452":43474},[],"Review active principals, their matches and their grants after IdP changes.",{"_2926":594,"_25561":444,"_17855":43476,"_5":17750,"_24230":43098,"_2452":43477},[],"Search for wildcards in policies before upgrading Lamassu.",{"_2926":595,"_25561":444,"_17855":43479,"_5":17750,"_24230":43098,"_2452":43480},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_2926":596,"_25561":444,"_17855":43482,"_5":17750,"_24230":43098,"_2452":43483},[],"Always test one allowed and one denied operation for each role.",{"_2926":597,"_25561":444,"_17855":43485,"_5":17750,"_24230":43098,"_2452":43486},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_2926":598,"_25561":444,"_17855":43488,"_5":17750,"_24230":43106,"_2452":43489},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_2926":599,"_25561":444,"_17855":43491,"_5":17750,"_24230":43110,"_2452":43492},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_2926":600,"_25561":444,"_17855":43494,"_5":17750,"_24230":43110,"_2452":43495},[],"that an active principal of the correct type exists;",{"_2926":601,"_25561":444,"_17855":43497,"_5":17750,"_24230":43110,"_2452":43498},[],"that the claim paths and values match the real token exactly;",{"_2926":602,"_25561":444,"_17855":43500,"_5":17750,"_24230":43110,"_2452":43501},[],"that all of the principal's conditions hold;",{"_2926":603,"_25561":444,"_17855":43503,"_5":17750,"_24230":43110,"_2452":43504},[],"that the principal has the expected policy granted;",{"_2926":604,"_25561":444,"_17855":43506,"_5":17750,"_24230":43110,"_2452":43507},[],"that the policy includes the action and the requested resource type or route;",{"_2926":605,"_25561":444,"_17855":43509,"_5":17750,"_24230":43110,"_2452":43510},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_2926":606,"_25561":444,"_17855":43512,"_5":17750,"_24230":43110,"_2452":43513},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry instrumentation enabled, each decision also produces a span — `engine.CheckHTTP` on the Gateway path — whose attributes record `authz.allowed`, the matched policy and the matched principal, so you can correlate the denial with the Gateway trace.",{"_2926":607,"_25561":444,"_17855":43515,"_5":17750,"_24230":43114,"_2452":43516},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_2926":608,"_25561":444,"_17855":43518,"_5":17750,"_24230":43118,"_2452":43519},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_2926":609,"_25561":444,"_17855":43521,"_5":17750,"_24230":43122,"_2452":43522},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_2926":610,"_25561":444,"_17855":43524,"_5":17750,"_24230":43122,"_2452":43525},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_2926":611,"_25561":611,"_5":12525,"_2452":43527,"_25885":43528,"_17855":43529,"_24230":611},"Alerts and subscriptions",[41651,42995,42996],[],{"_2926":612,"_25561":611,"_17855":43531,"_5":17750,"_24230":611,"_2452":43532},[],"Send PKI events to people and external systems.",{"_2926":613,"_25561":611,"_5":25882,"_17855":43534,"_24230":43535,"_2452":43536},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_2926":614,"_25561":611,"_5":25882,"_17855":43538,"_24230":43539,"_2452":43540},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_2926":615,"_25561":611,"_5":25882,"_17855":43542,"_24230":43543,"_2452":43544},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_2926":616,"_25561":611,"_5":25882,"_17855":43546,"_24230":43547,"_2452":43548},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_2926":617,"_25561":611,"_5":25882,"_17855":43550,"_24230":43551,"_2452":43552},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_2926":618,"_25561":611,"_5":25882,"_17855":43554,"_24230":43555,"_2452":43556},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_2926":619,"_25561":611,"_5":25882,"_17855":43558,"_24230":43559,"_2452":43560},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_2926":620,"_25561":611,"_5":25882,"_17855":43562,"_24230":43563,"_2452":43564},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_2926":621,"_25561":611,"_5":25882,"_17855":43566,"_24230":43567,"_2452":43568},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_2926":622,"_25561":611,"_5":25882,"_17855":43570,"_24230":43571,"_2452":43572},[],"/docs/platform/administration/alerts#event-families","Event families",{"_2926":623,"_25561":611,"_17855":43574,"_5":17750,"_24230":611,"_2452":43575},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_2926":624,"_25561":611,"_17855":43577,"_5":17750,"_24230":43535,"_2452":43578},[],"A service publishes a domain event.",{"_2926":625,"_25561":611,"_17855":43580,"_5":17750,"_24230":43535,"_2452":43581},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_2926":626,"_25561":611,"_17855":43583,"_5":17750,"_24230":43535,"_2452":43584},[],"Each subscription's filter decides whether it should be notified.",{"_2926":627,"_25561":611,"_17855":43586,"_5":17750,"_24230":43535,"_2452":43587},[],"Lamassu delivers the event to the configured channel.",{"_2926":628,"_25561":611,"_17855":43589,"_5":17750,"_24230":43535,"_2452":43590},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_2926":629,"_25561":611,"_17855":43592,"_5":17750,"_24230":43539,"_2452":43593},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_2926":630,"_25561":611,"_17855":43595,"_5":17750,"_24230":43539,"_2452":43596},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_2926":631,"_25561":611,"_17855":43598,"_5":17750,"_24230":43539,"_2452":43599},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_2926":632,"_25561":611,"_17855":43601,"_5":17750,"_24230":43539,"_2452":43602},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_2926":633,"_25561":611,"_17855":43604,"_5":17750,"_24230":43539,"_2452":43605},[],"`apikey_options` requires `header` and `key`.",{"_2926":634,"_25561":611,"_17855":43607,"_5":17750,"_24230":43539,"_2452":43608},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2926":635,"_25561":611,"_17855":43610,"_5":17750,"_24230":43539,"_2452":43611},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_2926":636,"_25561":611,"_17855":43613,"_5":17750,"_24230":43539,"_2452":43614},[],"The alerts API reference documents the full `http_client` schema.",{"_2926":637,"_25561":611,"_17855":43616,"_5":17750,"_24230":43547,"_2452":43617},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_2926":638,"_25561":611,"_17855":43619,"_5":17750,"_24230":43551,"_2452":43620},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_2926":639,"_25561":611,"_17855":43622,"_5":17750,"_24230":43555,"_2452":43623},[],"Add a filter if you don't want to receive every instance of the event.",{"_2926":640,"_25561":611,"_17855":43625,"_5":17750,"_24230":43555,"_2452":43626},[],"**None** notifies all instances of the event.",{"_2926":641,"_25561":611,"_17855":43628,"_5":17750,"_24230":43555,"_2452":43629},[],"**JSON Path** evaluates one or more specific fields.",{"_2926":642,"_25561":611,"_17855":43631,"_5":17750,"_24230":43555,"_2452":43632},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_2926":643,"_25561":611,"_17855":43634,"_5":17750,"_24230":43555,"_2452":43635},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_2926":644,"_25561":611,"_17855":43637,"_5":17750,"_24230":43555,"_2452":43638},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_2926":645,"_25561":611,"_17855":43640,"_5":17750,"_24230":43559,"_2452":43641},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_2926":646,"_25561":611,"_17855":43643,"_5":17750,"_24230":43563,"_2452":43644},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_2926":647,"_25561":611,"_17855":43646,"_5":17750,"_24230":43563,"_2452":43647},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_2926":648,"_25561":611,"_17855":43649,"_5":17750,"_24230":43563,"_2452":43650},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_2926":649,"_25561":611,"_17855":43652,"_5":17750,"_24230":43563,"_2452":43653},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_2926":650,"_25561":611,"_17855":43655,"_5":17750,"_24230":43563,"_2452":43656},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_2926":651,"_25561":611,"_17855":43658,"_5":17750,"_24230":43563,"_2452":43659},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_2926":652,"_25561":611,"_17855":43661,"_5":17750,"_24230":43563,"_2452":43662},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_2926":653,"_25561":611,"_17855":43664,"_5":17750,"_24230":43563,"_2452":43665},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_2926":654,"_25561":611,"_17855":43667,"_5":17750,"_24230":43567,"_2452":43668},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_2926":655,"_25561":611,"_17855":43670,"_5":17750,"_24230":43571,"_2452":43671},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_2926":656,"_25561":611,"_17855":43673,"_5":17750,"_24230":43571,"_2452":43674},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_2926":657,"_25561":611,"_17855":43676,"_5":17750,"_24230":43571,"_2452":43677},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_2926":658,"_25561":611,"_17855":43679,"_5":17750,"_24230":43571,"_2452":43680},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_2926":659,"_25561":611,"_17855":43682,"_5":17750,"_24230":43571,"_2452":43683},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_2926":660,"_25561":611,"_17855":43685,"_5":17750,"_24230":43571,"_2452":43686},[],"**Validation:** `va.role.crl.create`.",{"_2926":661,"_25561":611,"_17855":43688,"_5":17750,"_24230":43571,"_2452":43689},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_2926":662,"_25561":611,"_17855":43691,"_5":17750,"_24230":43571,"_2452":43692},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_2926":663,"_25561":663,"_5":12525,"_2452":43694,"_25885":43695,"_17855":43696,"_24230":663},"Audit logs",[41651,42995,42996],[],{"_2926":664,"_25561":663,"_17855":43698,"_5":17750,"_24230":663,"_2452":43699},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_2926":665,"_25561":663,"_5":25882,"_17855":43701,"_24230":43702,"_2452":43703},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_2926":666,"_25561":663,"_5":25882,"_17855":43705,"_24230":43706,"_2452":43707},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_2926":667,"_25561":663,"_5":25882,"_17855":43709,"_24230":43710,"_2452":43711},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_2926":668,"_25561":663,"_5":25882,"_17855":43713,"_24230":43714,"_2452":43715},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_2926":669,"_25561":663,"_5":25882,"_17855":43717,"_24230":43718,"_2452":43719},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_2926":670,"_25561":663,"_5":25882,"_17855":43721,"_24230":43722,"_2452":43723},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_2926":671,"_25561":663,"_5":25882,"_17855":43725,"_24230":43726,"_2452":43727},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_2926":672,"_25561":663,"_5":25882,"_17855":43729,"_24230":43730,"_2452":43731},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_2926":673,"_25561":663,"_5":25882,"_17855":43733,"_24230":43734,"_2452":43735},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_2926":674,"_25561":663,"_5":25882,"_17855":43737,"_24230":43738,"_2452":43739},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_2926":675,"_25561":663,"_5":25882,"_17855":43741,"_24230":43742,"_2452":43743},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_2926":676,"_25561":663,"_17855":43745,"_5":17750,"_24230":663,"_2452":43746},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_2926":677,"_25561":663,"_17855":43748,"_5":17750,"_24230":43702,"_2452":43749},[],"The audit body includes:",{"_2926":678,"_25561":663,"_17855":43751,"_5":17750,"_24230":43702,"_2452":43752},[],"input: data received by the operation;",{"_2926":679,"_25561":663,"_17855":43754,"_5":17750,"_24230":43702,"_2452":43755},[],"has\\_error: whether the service returned an error;",{"_2926":680,"_25561":663,"_17855":43757,"_5":17750,"_24230":43702,"_2452":43758},[],"output: produced result or error message;",{"_2926":681,"_25561":663,"_17855":43760,"_5":17750,"_24230":43702,"_2452":43761},[],"principals: identifiers of the principals that matched the request.",{"_2926":682,"_25561":663,"_17855":43763,"_5":17750,"_24230":43702,"_2452":43764},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_2926":683,"_25561":663,"_17855":43766,"_5":17750,"_24230":43702,"_2452":43767},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_2926":684,"_25561":663,"_17855":43769,"_5":17750,"_24230":43706,"_2452":43770},[],"The backend applies auditing to mutations of:",{"_2926":685,"_25561":663,"_17855":43772,"_5":17750,"_24230":43706,"_2452":43773},[],"authorities, certificates and issuance profiles;",{"_2926":686,"_25561":663,"_17855":43775,"_5":17750,"_24230":43706,"_2452":43776},[],"keys and KMS engines;",{"_2926":687,"_25561":663,"_17855":43778,"_5":17750,"_24230":43706,"_2452":43779},[],"devices and identities;",{"_2926":688,"_25561":663,"_17855":43781,"_5":17750,"_24230":43706,"_2452":43782},[],"DMSs and enrollment operations;",{"_2926":689,"_25561":663,"_17855":43784,"_5":17750,"_24230":43706,"_2452":43785},[],"validation functions and CRL;",{"_2926":690,"_25561":663,"_17855":43787,"_5":17750,"_24230":43706,"_2452":43788},[],"principals, policies and authorization grants.",{"_2926":691,"_25561":663,"_17855":43790,"_5":17750,"_24230":43706,"_2452":43791},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_2926":692,"_25561":663,"_17855":43793,"_5":17750,"_24230":43710,"_2452":43794},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_2926":693,"_25561":663,"_17855":43796,"_5":17750,"_24230":43710,"_2452":43797},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_2926":694,"_25561":663,"_17855":43799,"_5":17750,"_24230":43710,"_2452":43800},[],"Design the consumer to:",{"_2926":695,"_25561":663,"_17855":43802,"_5":17750,"_24230":43710,"_2452":43803},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_2926":696,"_25561":663,"_17855":43805,"_5":17750,"_24230":43710,"_2452":43806},[],"keep the complete CloudEvent unmodified;",{"_2926":697,"_25561":663,"_17855":43808,"_5":17750,"_24230":43710,"_2452":43809},[],"record the ingestion time and detect duplicates by ID;",{"_2926":698,"_25561":663,"_17855":43811,"_5":17750,"_24230":43710,"_2452":43812},[],"encrypt in transit and at rest;",{"_2926":699,"_25561":663,"_17855":43814,"_5":17750,"_24230":43710,"_2452":43815},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_2926":700,"_25561":663,"_17855":43817,"_5":17750,"_24230":43710,"_2452":43818},[],"apply an explicit retention and legal hold policy;",{"_2926":701,"_25561":663,"_17855":43820,"_5":17750,"_24230":43710,"_2452":43821},[],"alert if it stops consuming or the pending queue grows.",{"_2926":702,"_25561":663,"_17855":43823,"_5":17750,"_24230":43714,"_2452":43824},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_2926":703,"_25561":663,"_17855":43826,"_5":17750,"_24230":43714,"_2452":43827},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_2926":704,"_25561":663,"_17855":43829,"_5":17750,"_24230":43722,"_2452":43830},[],"Start from the reported time and normalize every source to UTC.",{"_2926":705,"_25561":663,"_17855":43832,"_5":17750,"_24230":43726,"_2452":43833},[],"Filter by event type, service source and resource identifier.",{"_2926":706,"_25561":663,"_17855":43835,"_5":17750,"_24230":43730,"_2452":43836},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_2926":707,"_25561":663,"_17855":43838,"_5":17750,"_24230":43734,"_2452":43839},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_2926":708,"_25561":663,"_17855":43841,"_5":17750,"_24230":43738,"_2452":43842},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_2926":709,"_25561":663,"_17855":43844,"_5":17750,"_24230":43742,"_2452":43845},[],"Generate a controlled mutation in a test environment and check that:",{"_2926":710,"_25561":663,"_17855":43847,"_5":17750,"_24230":43742,"_2452":43848},[],"a successful audit event appears;",{"_2926":711,"_25561":663,"_17855":43850,"_5":17750,"_24230":43742,"_2452":43851},[],"the principal matches the identity used;",{"_2926":712,"_25561":663,"_17855":43853,"_5":17750,"_24230":43742,"_2452":43854},[],"the consumer persists it exactly once;",{"_2926":713,"_25561":663,"_17855":43856,"_5":17750,"_24230":43742,"_2452":43857},[],"it can be retrieved by resource, actor and period;",{"_2926":714,"_25561":663,"_17855":43859,"_5":17750,"_24230":43742,"_2452":43860},[],"a consumer outage raises an alert.",{"_2926":715,"_25561":663,"_17855":43862,"_5":17750,"_24230":43742,"_2452":43863},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_2926":716,"_25561":716,"_5":12525,"_2452":43865,"_25885":43866,"_17855":43867,"_24230":716},"Platform architecture",[41651,42995],[],{"_2926":717,"_25561":716,"_17855":43869,"_5":17750,"_24230":716,"_2452":43870},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_2926":718,"_25561":716,"_5":25882,"_17855":43872,"_24230":43873,"_2452":43874},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_2926":719,"_25561":716,"_5":25882,"_17855":43876,"_24230":43877,"_2452":43878},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_2926":720,"_25561":716,"_5":25882,"_17855":43880,"_24230":43881,"_2452":43882},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_2926":721,"_25561":716,"_5":25882,"_17855":43884,"_24230":43885,"_2452":43886},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_2926":722,"_25561":716,"_5":25882,"_17855":43888,"_24230":43889,"_2452":43890},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_2926":723,"_25561":716,"_17855":43892,"_5":17750,"_24230":716,"_2452":43893},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_2926":724,"_25561":716,"_17855":43895,"_5":17750,"_24230":716,"_2452":43896},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_2926":725,"_25561":716,"_17855":43898,"_5":17750,"_24230":43873,"_2452":43899},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_2926":726,"_25561":716,"_17855":43901,"_5":17750,"_24230":43877,"_2452":43902},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_2926":727,"_25561":716,"_17855":43904,"_5":17750,"_24230":43881,"_2452":43905},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_2926":728,"_25561":716,"_17855":43907,"_5":17750,"_24230":43885,"_2452":43908},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_2926":729,"_25561":716,"_17855":43910,"_5":17750,"_24230":43889,"_2452":43911},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_2926":730,"_25561":730,"_5":12525,"_2452":43913,"_25885":43914,"_17855":43915,"_24230":730},"How Lamassu works",[41651,42995],[],{"_2926":731,"_25561":730,"_17855":43917,"_5":17750,"_24230":730,"_2452":43918},[],"The mental model of trust, keys, certificates and devices.",{"_2926":732,"_25561":730,"_5":25882,"_17855":43920,"_24230":43921,"_2452":43922},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_2926":733,"_25561":730,"_5":25882,"_17855":43924,"_24230":43925,"_2452":43926},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_2926":734,"_25561":730,"_17855":43928,"_5":17750,"_24230":730,"_2452":43929},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_2926":735,"_25561":730,"_17855":43931,"_5":17750,"_24230":43921,"_2452":43932},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_2926":736,"_25561":730,"_17855":43934,"_5":17750,"_24230":43921,"_2452":43935},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_2926":737,"_25561":730,"_17855":43937,"_5":17750,"_24230":43921,"_2452":43938},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_2926":738,"_25561":730,"_17855":43940,"_5":17750,"_24230":43921,"_2452":43941},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_2926":739,"_25561":730,"_17855":43943,"_5":17750,"_24230":43921,"_2452":43944},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_2926":740,"_25561":730,"_17855":43946,"_5":17750,"_24230":43925,"_2452":43947},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_2926":741,"_25561":730,"_17855":43949,"_5":17750,"_24230":43925,"_2452":43950},[],"A DMS relates that CA to an enrollment policy.",{"_2926":742,"_25561":730,"_17855":43952,"_5":17750,"_24230":43925,"_2452":43953},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_2926":743,"_25561":730,"_17855":43955,"_5":17750,"_24230":43925,"_2452":43956},[],"Lamassu keeps the inventory, history and status of the identity.",{"_2926":744,"_25561":730,"_17855":43958,"_5":17750,"_24230":43925,"_2452":43959},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_2926":745,"_25561":730,"_17855":43961,"_5":17750,"_24230":43925,"_2452":43962},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_2926":746,"_25561":730,"_17855":43964,"_5":17750,"_24230":43925,"_2452":43965},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_2926":747,"_25561":747,"_5":12525,"_2452":43967,"_25885":43968,"_17855":43970,"_24230":747},"Devices and identities",[41651,42995,43969,43967],"IoT Fleets",[],{"_2926":748,"_25561":747,"_17855":43972,"_5":17750,"_24230":747,"_2452":43973},[],"Register, inspect and retire devices while checking their current identity and history.",{"_2926":749,"_25561":747,"_5":25882,"_17855":43975,"_24230":43976,"_2452":43977},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_2926":750,"_25561":747,"_5":25882,"_17855":43979,"_24230":43980,"_2452":43981},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_2926":751,"_25561":747,"_5":25882,"_17855":43983,"_24230":43984,"_2452":43985},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_2926":752,"_25561":747,"_5":25882,"_17855":43987,"_24230":43988,"_2452":43989},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_2926":753,"_25561":747,"_5":25882,"_17855":43991,"_24230":43992,"_2452":43993},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_2926":754,"_25561":747,"_5":25882,"_17855":43995,"_24230":43996,"_2452":43997},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_2926":755,"_25561":747,"_5":25882,"_17855":43999,"_24230":44000,"_2452":44001},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_2926":756,"_25561":747,"_5":25882,"_17855":44003,"_24230":44004,"_2452":44005},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_2926":757,"_25561":747,"_5":25882,"_17855":44007,"_24230":44008,"_2452":44009},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_2926":758,"_25561":747,"_5":25882,"_17855":44011,"_24230":44012,"_2452":44013},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_2926":759,"_25561":747,"_5":25882,"_17855":44015,"_24230":44016,"_2452":44017},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_2926":760,"_25561":747,"_17855":44019,"_5":17750,"_24230":747,"_2452":44020},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_2926":761,"_25561":747,"_17855":44022,"_5":17750,"_24230":747,"_2452":44023},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_2926":762,"_25561":747,"_17855":44025,"_5":17750,"_24230":43976,"_2452":44026},[],"Operational view",{"_2926":763,"_25561":747,"_17855":44028,"_5":17750,"_24230":43976,"_2452":44029},[],"Meaning",{"_2926":764,"_25561":747,"_17855":44031,"_5":17750,"_24230":43976,"_2452":44032},[],"**No Identity**",{"_2926":765,"_25561":747,"_17855":44034,"_5":17750,"_24230":43976,"_2452":44035},[],"A record exists without an associated identity.",{"_2926":766,"_25561":747,"_17855":44037,"_5":17750,"_24230":43976,"_2452":44038},[],"**Active**",{"_2926":767,"_25561":747,"_17855":44040,"_5":17750,"_24230":43976,"_2452":44041},[],"The slot is active; also check certificate dates, status and usages.",{"_2926":768,"_25561":747,"_17855":44043,"_5":17750,"_24230":43976,"_2452":44044},[],"**Renewal Pending**",{"_2926":769,"_25561":747,"_17855":44046,"_5":17750,"_24230":43976,"_2452":44047},[],"The identity is in the operational renewal window.",{"_2926":770,"_25561":747,"_17855":44049,"_5":17750,"_24230":43976,"_2452":44050},[],"**Expiring Soon**",{"_2926":771,"_25561":747,"_17855":44052,"_5":17750,"_24230":43976,"_2452":44053},[],"Expiration is approaching according to configured thresholds.",{"_2926":772,"_25561":747,"_17855":44055,"_5":17750,"_24230":43976,"_2452":44056},[],"**Expired**",{"_2926":773,"_25561":747,"_17855":44058,"_5":17750,"_24230":43976,"_2452":44059},[],"The identity has expired.",{"_2926":774,"_25561":747,"_17855":44061,"_5":17750,"_24230":43976,"_2452":44062},[],"**Revoked**",{"_2926":775,"_25561":747,"_17855":44064,"_5":17750,"_24230":43976,"_2452":44065},[],"The identity is marked revoked.",{"_2926":776,"_25561":747,"_17855":44067,"_5":17750,"_24230":43976,"_2452":44068},[],"**Decommissioned**",{"_2926":777,"_25561":747,"_17855":44070,"_5":17750,"_24230":43976,"_2452":44071},[],"The record is retired and ordinary updates do not restore operation.",{"_2926":778,"_25561":747,"_17855":44073,"_5":17750,"_24230":43976,"_2452":44074},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_2926":779,"_25561":747,"_17855":44076,"_5":17750,"_24230":43980,"_2452":44077},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_2926":780,"_25561":747,"_17855":44079,"_5":17750,"_24230":43980,"_2452":44080},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_2926":781,"_25561":747,"_17855":44082,"_5":17750,"_24230":43980,"_2452":44083},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_2926":782,"_25561":747,"_17855":44085,"_5":17750,"_24230":43980,"_2452":44086},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_2926":783,"_25561":747,"_17855":44088,"_5":17750,"_24230":43984,"_2452":44089},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_2926":784,"_25561":747,"_17855":44091,"_5":17750,"_24230":43988,"_2452":44092},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_2926":785,"_25561":747,"_17855":44094,"_5":17750,"_24230":43992,"_2452":44095},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_2926":786,"_25561":747,"_17855":44097,"_5":17750,"_24230":43996,"_2452":44098},[],"Add model, environment or location tags and an icon according to your inventory.",{"_2926":787,"_25561":747,"_17855":44100,"_5":17750,"_24230":44000,"_2452":44101},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_2926":788,"_25561":747,"_17855":44103,"_5":17750,"_24230":44000,"_2452":44104},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_2926":789,"_25561":747,"_17855":44106,"_5":17750,"_24230":44004,"_2452":44107},[],"From **No Identity**, use **Assign Identity**:",{"_2926":790,"_25561":747,"_17855":44109,"_5":17750,"_24230":44004,"_2452":44110},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_2926":791,"_25561":747,"_17855":44112,"_5":17750,"_24230":44004,"_2452":44113},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_2926":792,"_25561":747,"_17855":44115,"_5":17750,"_24230":44004,"_2452":44116},[],"Confirm and read the serial, active version and history again.",{"_2926":793,"_25561":747,"_17855":44118,"_5":17750,"_24230":44004,"_2452":44119},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_2926":794,"_25561":747,"_17855":44121,"_5":17750,"_24230":44004,"_2452":44122},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_2926":795,"_25561":747,"_17855":44124,"_5":17750,"_24230":44008,"_2452":44125},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_2926":796,"_25561":747,"_17855":44127,"_5":17750,"_24230":44008,"_2452":44128},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_2926":797,"_25561":747,"_17855":44130,"_5":17750,"_24230":44012,"_2452":44131},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_2926":798,"_25561":747,"_17855":44133,"_5":17750,"_24230":44012,"_2452":44134},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_2926":799,"_25561":747,"_17855":44136,"_5":17750,"_24230":44012,"_2452":44137},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_2926":800,"_25561":747,"_17855":44139,"_5":17750,"_24230":44012,"_2452":44140},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_2926":801,"_25561":747,"_17855":44142,"_5":17750,"_24230":44016,"_2452":44143},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2926":802,"_25561":747,"_17855":44145,"_5":17750,"_24230":44016,"_2452":44146},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2926":803,"_25561":803,"_5":12525,"_2452":44148,"_25885":44149,"_17855":44151,"_24230":803},"Bootstrap identity and authentication",[41651,42995,43969,43967,44150],"Enrollment with PKI",[],{"_2926":804,"_25561":803,"_17855":44153,"_5":17750,"_24230":803,"_2452":44154},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_2926":805,"_25561":803,"_5":25882,"_17855":44156,"_24230":44157,"_2452":44158},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_2926":806,"_25561":803,"_5":25882,"_17855":44160,"_24230":44161,"_2452":44162},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_2926":807,"_25561":803,"_5":25882,"_17855":44164,"_24230":44165,"_2452":44166},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_2926":808,"_25561":803,"_5":25882,"_17855":44168,"_24230":44169,"_2452":44170},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_2926":809,"_25561":803,"_5":25882,"_17855":44172,"_24230":44173,"_2452":44174},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_2926":810,"_25561":803,"_17855":44176,"_5":17750,"_24230":803,"_2452":44177},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_2926":811,"_25561":803,"_17855":44179,"_5":17750,"_24230":44157,"_2452":44180},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_2926":812,"_25561":803,"_17855":44182,"_5":17750,"_24230":44157,"_2452":44183},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_2926":813,"_25561":803,"_17855":44185,"_5":17750,"_24230":44161,"_2452":44186},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_2926":814,"_25561":803,"_17855":44188,"_5":17750,"_24230":44161,"_2452":44189},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_2926":815,"_25561":803,"_17855":44191,"_5":17750,"_24230":44161,"_2452":44192},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_2926":816,"_25561":803,"_17855":44194,"_5":17750,"_24230":44165,"_2452":44195},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_2926":817,"_25561":803,"_17855":44197,"_5":17750,"_24230":44165,"_2452":44198},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_2926":818,"_25561":803,"_17855":44200,"_5":17750,"_24230":44169,"_2452":44201},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_2926":819,"_25561":803,"_17855":44203,"_5":17750,"_24230":44169,"_2452":44204},[],"Example body:",{"_2926":820,"_25561":803,"_17855":44206,"_5":17750,"_24230":44169,"_2452":44207},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_2926":821,"_25561":803,"_17855":44209,"_5":17750,"_24230":44169,"_2452":44210},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_2926":822,"_25561":803,"_17855":44212,"_5":17750,"_24230":44169,"_2452":44213},[],"Continuation requires a successful HTTP response and JSON:",{"_2926":823,"_25561":803,"_17855":44215,"_5":17750,"_24230":44169,"_2452":44216},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_2926":824,"_25561":803,"_17855":44218,"_5":17750,"_24230":44173,"_2452":44219},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_2926":825,"_25561":803,"_17855":44221,"_5":17750,"_24230":44173,"_2452":44222},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_2926":826,"_25561":826,"_5":12525,"_2452":44224,"_25885":44225,"_17855":44226,"_24230":826},"Configure and operate the DMS",[41651,42995,43969,43967,44150],[],{"_2926":827,"_25561":826,"_17855":44228,"_5":17750,"_24230":826,"_2452":44229},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_2926":828,"_25561":826,"_5":25882,"_17855":44231,"_24230":44232,"_2452":41661},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_2926":829,"_25561":826,"_5":25882,"_17855":44234,"_24230":44235,"_2452":44236},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_2926":830,"_25561":826,"_5":25882,"_17855":44238,"_24230":44239,"_2452":44240},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_2926":831,"_25561":826,"_5":25882,"_17855":44242,"_24230":44243,"_2452":44244},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_2926":832,"_25561":826,"_5":25882,"_17855":44246,"_24230":44247,"_2452":44248},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_2926":833,"_25561":826,"_5":25882,"_17855":44250,"_24230":44251,"_2452":44252},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_2926":834,"_25561":826,"_5":25882,"_17855":44254,"_24230":44255,"_2452":44256},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_2926":835,"_25561":826,"_5":25882,"_17855":44258,"_24230":44259,"_2452":44260},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_2926":836,"_25561":826,"_5":25882,"_17855":44262,"_24230":44263,"_2452":44264},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_2926":837,"_25561":826,"_5":25882,"_17855":44266,"_24230":44267,"_2452":44268},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_2926":838,"_25561":826,"_5":25882,"_17855":44270,"_24230":44271,"_2452":44272},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_2926":839,"_25561":826,"_5":25882,"_17855":44274,"_24230":44275,"_2452":44276},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_2926":840,"_25561":826,"_5":25882,"_17855":44278,"_24230":44279,"_2452":44280},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_2926":841,"_25561":826,"_5":25882,"_17855":44282,"_24230":44283,"_2452":44284},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_2926":842,"_25561":826,"_5":25882,"_17855":44286,"_24230":44287,"_2452":44288},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_2926":843,"_25561":826,"_5":25882,"_17855":44290,"_24230":44291,"_2452":44292},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_2926":844,"_25561":826,"_5":25882,"_17855":44294,"_24230":44295,"_2452":44296},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_2926":845,"_25561":826,"_5":25882,"_17855":44298,"_24230":44299,"_2452":44300},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_2926":846,"_25561":826,"_17855":44302,"_5":17750,"_24230":826,"_2452":44303},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_2926":847,"_25561":826,"_17855":44305,"_5":17750,"_24230":44232,"_2452":44306},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_2926":848,"_25561":826,"_17855":44308,"_5":17750,"_24230":44232,"_2452":44309},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_2926":849,"_25561":826,"_17855":44311,"_5":17750,"_24230":44239,"_2452":44312},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_2926":850,"_25561":826,"_17855":44314,"_5":17750,"_24230":44243,"_2452":44315},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_2926":851,"_25561":826,"_17855":44317,"_5":17750,"_24230":44247,"_2452":44318},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_2926":852,"_25561":826,"_17855":44320,"_5":17750,"_24230":44251,"_2452":44321},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_2926":853,"_25561":826,"_17855":44323,"_5":17750,"_24230":44255,"_2452":44324},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_2926":854,"_25561":826,"_17855":44326,"_5":17750,"_24230":44263,"_2452":44327},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_2926":855,"_25561":826,"_17855":44329,"_5":17750,"_24230":44263,"_2452":44330},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_2926":856,"_25561":826,"_17855":44332,"_5":17750,"_24230":44267,"_2452":44333},[],"`settings.enrollment_settings` field",{"_2926":857,"_25561":826,"_17855":44335,"_5":17750,"_24230":44267,"_2452":44336},[],"Decision",{"_2926":858,"_25561":826,"_17855":44338,"_5":17750,"_24230":44267,"_2452":44339},[],"`protocol`",{"_2926":859,"_25561":826,"_17855":44341,"_5":17750,"_24230":44267,"_2452":44342},[],"`EST_RFC7030` for these operations.",{"_2926":860,"_25561":826,"_17855":44344,"_5":17750,"_24230":44267,"_2452":44345},[],"`enrollment_ca`",{"_2926":861,"_25561":826,"_17855":44347,"_5":17750,"_24230":44267,"_2452":44348},[],"ID of the signing CA.",{"_2926":862,"_25561":826,"_17855":44350,"_5":17750,"_24230":44267,"_2452":44351},[],"`verify_csr_signature`",{"_2926":863,"_25561":826,"_17855":44353,"_5":17750,"_24230":44267,"_2452":44354},[],"Keep `true` to verify CSR key possession.",{"_2926":864,"_25561":826,"_17855":44356,"_5":17750,"_24230":44267,"_2452":44357},[],"`enable_replaceable_enrollment`",{"_2926":865,"_25561":826,"_17855":44359,"_5":17750,"_24230":44267,"_2452":44360},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_2926":866,"_25561":826,"_17855":44362,"_5":17750,"_24230":44267,"_2452":44363},[],"`est_rfc7030_settings.auth_mode`",{"_2926":867,"_25561":826,"_17855":44365,"_5":17750,"_24230":44267,"_2452":44366},[],"One of the four authentication modes.",{"_2926":868,"_25561":826,"_17855":44368,"_5":17750,"_24230":44267,"_2452":44369},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_2926":869,"_25561":826,"_17855":44371,"_5":17750,"_24230":44271,"_2452":44372},[],"The blocks are independent:",{"_2926":870,"_25561":826,"_17855":44374,"_5":17750,"_24230":44271,"_2452":44375},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_2926":871,"_25561":826,"_17855":44377,"_5":17750,"_24230":44271,"_2452":44378},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_2926":872,"_25561":826,"_17855":44380,"_5":17750,"_24230":44271,"_2452":44381},[],"`auth_mode`",{"_2926":873,"_25561":826,"_17855":44383,"_5":17750,"_24230":44271,"_2452":44384},[],"Control applied in the configured operation",{"_2926":874,"_25561":826,"_17855":44386,"_5":17750,"_24230":44271,"_2452":44387},[],"`CLIENT_CERTIFICATE`",{"_2926":875,"_25561":826,"_17855":44389,"_5":17750,"_24230":44271,"_2452":44390},[],"Presented certificate validation.",{"_2926":876,"_25561":826,"_17855":44392,"_5":17750,"_24230":44271,"_2452":44393},[],"`EXTERNAL_WEBHOOK`",{"_2926":877,"_25561":826,"_17855":44395,"_5":17750,"_24230":44271,"_2452":44396},[],"Configured webhook authorization.",{"_2926":878,"_25561":826,"_17855":44398,"_5":17750,"_24230":44271,"_2452":44399},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_2926":879,"_25561":826,"_17855":44401,"_5":17750,"_24230":44271,"_2452":44402},[],"Certificate validation followed by webhook approval.",{"_2926":880,"_25561":826,"_17855":44404,"_5":17750,"_24230":44271,"_2452":44405},[],"`NO_AUTH`",{"_2926":881,"_25561":826,"_17855":44407,"_5":17750,"_24230":44271,"_2452":44408},[],"No DMS requester authentication.",{"_2926":882,"_25561":826,"_17855":44410,"_5":17750,"_24230":44271,"_2452":44411},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_2926":883,"_25561":826,"_17855":44413,"_5":17750,"_24230":44271,"_2452":44414},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_2926":884,"_25561":826,"_17855":44416,"_5":17750,"_24230":44271,"_2452":44417},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_2926":885,"_25561":826,"_17855":44419,"_5":17750,"_24230":44271,"_2452":44420},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_2926":886,"_25561":826,"_17855":44422,"_5":17750,"_24230":44275,"_2452":44423},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_2926":887,"_25561":826,"_17855":44425,"_5":17750,"_24230":44275,"_2452":44426},[],"`external_webhook_settings` field",{"_2926":888,"_25561":826,"_17855":44428,"_5":17750,"_24230":44275,"_2452":44336},[],{"_2926":889,"_25561":826,"_17855":44430,"_5":17750,"_24230":44275,"_2452":44431},[],"`url`",{"_2926":890,"_25561":826,"_17855":44433,"_5":17750,"_24230":44275,"_2452":44434},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_2926":891,"_25561":826,"_17855":44436,"_5":17750,"_24230":44275,"_2452":44437},[],"`method`",{"_2926":892,"_25561":826,"_17855":44439,"_5":17750,"_24230":44275,"_2452":44440},[],"`POST` or `PUT`; `POST` by default.",{"_2926":893,"_25561":826,"_17855":44442,"_5":17750,"_24230":44275,"_2452":44443},[],"`name`",{"_2926":894,"_25561":826,"_17855":44445,"_5":17750,"_24230":44275,"_2452":44446},[],"Label used in service logs.",{"_2926":895,"_25561":826,"_17855":44448,"_5":17750,"_24230":44275,"_2452":44449},[],"`config.auth_mode`",{"_2926":896,"_25561":826,"_17855":44451,"_5":17750,"_24230":44275,"_2452":44452},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_2926":897,"_25561":826,"_17855":44454,"_5":17750,"_24230":44275,"_2452":44455},[],"`config.apikey_options`",{"_2926":898,"_25561":826,"_17855":44457,"_5":17750,"_24230":44275,"_2452":44458},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_2926":899,"_25561":826,"_17855":44460,"_5":17750,"_24230":44275,"_2452":44461},[],"`config.jwt_options`",{"_2926":900,"_25561":826,"_17855":44463,"_5":17750,"_24230":44275,"_2452":44464},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_2926":901,"_25561":826,"_17855":44466,"_5":17750,"_24230":44275,"_2452":44467},[],"`config.mtls_options`",{"_2926":902,"_25561":826,"_17855":44469,"_5":17750,"_24230":44275,"_2452":44470},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_2926":903,"_25561":826,"_17855":44472,"_5":17750,"_24230":44275,"_2452":44473},[],"`config.insecure_skip_verify`",{"_2926":904,"_25561":826,"_17855":44475,"_5":17750,"_24230":44275,"_2452":44476},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_2926":905,"_25561":826,"_17855":44478,"_5":17750,"_24230":44275,"_2452":44479},[],"`config.call_timeout`",{"_2926":906,"_25561":826,"_17855":44481,"_5":17750,"_24230":44275,"_2452":44482},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_2926":907,"_25561":826,"_17855":44484,"_5":17750,"_24230":44275,"_2452":44485},[],"Rules for that configuration:",{"_2926":908,"_25561":826,"_17855":44487,"_5":17750,"_24230":44275,"_2452":44488},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_2926":909,"_25561":826,"_17855":44490,"_5":17750,"_24230":44275,"_2452":44491},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_2926":910,"_25561":826,"_17855":44493,"_5":17750,"_24230":44275,"_2452":44494},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_2926":911,"_25561":826,"_17855":44496,"_5":17750,"_24230":44275,"_2452":44497},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_2926":912,"_25561":826,"_17855":44499,"_5":17750,"_24230":44275,"_2452":44500},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_2926":913,"_25561":826,"_17855":44502,"_5":17750,"_24230":44275,"_2452":44503},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_2926":914,"_25561":826,"_17855":44505,"_5":17750,"_24230":44275,"_2452":44506},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing, and if your version's console does not expose independent settings, use the DMS API.",{"_2926":915,"_25561":826,"_17855":44508,"_5":17750,"_24230":44275,"_2452":44509},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_2926":916,"_25561":826,"_17855":44511,"_5":17750,"_24230":44275,"_2452":44512},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_2926":917,"_25561":826,"_17855":44514,"_5":17750,"_24230":44279,"_2452":44515},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_2926":918,"_25561":826,"_17855":44517,"_5":17750,"_24230":44283,"_2452":44518},[],"`settings.reenrollment_settings` field",{"_2926":919,"_25561":826,"_17855":44520,"_5":17750,"_24230":44283,"_2452":42034},[],{"_2926":920,"_25561":826,"_17855":44522,"_5":17750,"_24230":44283,"_2452":44523},[],"`reenrollment_delta`",{"_2926":921,"_25561":826,"_17855":44525,"_5":17750,"_24230":44283,"_2452":44526},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_2926":922,"_25561":826,"_17855":44528,"_5":17750,"_24230":44283,"_2452":44529},[],"`preventive_delta`",{"_2926":923,"_25561":826,"_17855":44531,"_5":17750,"_24230":44283,"_2452":44532},[],"Preventive operational monitoring threshold.",{"_2926":924,"_25561":826,"_17855":44534,"_5":17750,"_24230":44283,"_2452":44535},[],"`critical_delta`",{"_2926":925,"_25561":826,"_17855":44537,"_5":17750,"_24230":44283,"_2452":44538},[],"Critical operational monitoring threshold.",{"_2926":926,"_25561":826,"_17855":44540,"_5":17750,"_24230":44283,"_2452":44541},[],"`enable_expired_renewal`",{"_2926":927,"_25561":826,"_17855":44543,"_5":17750,"_24230":44283,"_2452":44544},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_2926":928,"_25561":826,"_17855":44546,"_5":17750,"_24230":44283,"_2452":44547},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_2926":929,"_25561":826,"_17855":44549,"_5":17750,"_24230":44283,"_2452":44550},[],"Additional validation CAs for the renewal mTLS credential, tried after the enrollment CA; typically populated during CA rotation while old-CA cohorts renew.",{"_2926":930,"_25561":826,"_17855":44552,"_5":17750,"_24230":44283,"_2452":44553},[],"`revoke_on_reenrollment`",{"_2926":931,"_25561":826,"_17855":44555,"_5":17750,"_24230":44283,"_2452":44556},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_2926":932,"_25561":826,"_17855":44558,"_5":17750,"_24230":44283,"_2452":44559},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_2926":933,"_25561":826,"_17855":44561,"_5":17750,"_24230":44287,"_2452":44562},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. Algorithm and size come from its `key` field; the profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_2926":934,"_25561":826,"_17855":44564,"_5":17750,"_24230":44291,"_2452":42028},[],{"_2926":935,"_25561":826,"_17855":44566,"_5":17750,"_24230":44291,"_2452":44567},[],"Published material",{"_2926":936,"_25561":826,"_17855":44569,"_5":17750,"_24230":44291,"_2452":44570},[],"**Include Lamassu System CA**",{"_2926":937,"_25561":826,"_17855":44572,"_5":17750,"_24230":44291,"_2452":44573},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_2926":938,"_25561":826,"_17855":44575,"_5":17750,"_24230":44291,"_2452":44576},[],"**Include Enrollment CA**",{"_2926":939,"_25561":826,"_17855":44578,"_5":17750,"_24230":44291,"_2452":44579},[],"Selected issuing CA certificate.",{"_2926":940,"_25561":826,"_17855":44581,"_5":17750,"_24230":44291,"_2452":44582},[],"**Managed CAs**",{"_2926":941,"_25561":826,"_17855":44584,"_5":17750,"_24230":44291,"_2452":44585},[],"Explicitly selected CA certificates.",{"_2926":942,"_25561":826,"_17855":44587,"_5":17750,"_24230":44291,"_2452":44588},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_2926":943,"_25561":826,"_17855":44590,"_5":17750,"_24230":44295,"_2452":44591},[],"**Edit** changes name, settings and metadata. Backend updates replace these complete blocks; read the DMS before sending API edits to avoid losing fields.",{"_2926":944,"_25561":826,"_17855":44593,"_5":17750,"_24230":44295,"_2452":44594},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_2926":945,"_25561":826,"_17855":44596,"_5":17750,"_24230":44295,"_2452":44597},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_2926":946,"_25561":826,"_17855":44599,"_5":17750,"_24230":44299,"_2452":44600},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_2926":947,"_25561":947,"_5":12525,"_2452":44602,"_25885":44603,"_17855":44604,"_24230":947},"Integrate the EST client",[41651,42995,43969,43967,44150],[],{"_2926":948,"_25561":947,"_17855":44606,"_5":17750,"_24230":947,"_2452":44607},[],"Prepare trust, send a CSR and check the identity you receive.",{"_2926":949,"_25561":947,"_5":25882,"_17855":44609,"_24230":44610,"_2452":41661},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_2926":950,"_25561":947,"_5":25882,"_17855":44612,"_24230":44613,"_2452":44614},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_2926":951,"_25561":947,"_5":25882,"_17855":44616,"_24230":44617,"_2452":44618},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_2926":952,"_25561":947,"_5":25882,"_17855":44620,"_24230":44621,"_2452":44622},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_2926":953,"_25561":947,"_5":25882,"_17855":44624,"_24230":44625,"_2452":44626},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_2926":954,"_25561":947,"_5":25882,"_17855":44628,"_24230":44629,"_2452":44630},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_2926":955,"_25561":947,"_17855":44632,"_5":17750,"_24230":947,"_2452":44633},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_2926":956,"_25561":947,"_17855":44635,"_5":17750,"_24230":44610,"_2452":44636},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_2926":957,"_25561":947,"_17855":44638,"_5":17750,"_24230":44610,"_2452":44639},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_2926":958,"_25561":947,"_17855":44641,"_5":17750,"_24230":44610,"_2452":44642},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_2926":959,"_25561":947,"_17855":44644,"_5":17750,"_24230":44613,"_2452":44645},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_2926":960,"_25561":947,"_17855":44647,"_5":17750,"_24230":44613,"_2452":44648},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_2926":961,"_25561":947,"_17855":44650,"_5":17750,"_24230":44617,"_2452":44651},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_2926":962,"_25561":947,"_17855":44653,"_5":17750,"_24230":44617,"_2452":44654},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_2926":963,"_25561":947,"_17855":44656,"_5":17750,"_24230":44621,"_2452":44657},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_2926":964,"_25561":947,"_17855":44659,"_5":17750,"_24230":44621,"_2452":44660},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_2926":965,"_25561":947,"_17855":44662,"_5":17750,"_24230":44625,"_2452":44663},[],"For a root that issues directly:",{"_2926":966,"_25561":947,"_17855":44665,"_5":17750,"_24230":44625,"_2452":44666},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_2926":967,"_25561":947,"_17855":44668,"_5":17750,"_24230":44625,"_2452":44669},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_2926":968,"_25561":947,"_17855":44671,"_5":17750,"_24230":44629,"_2452":44672},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_2926":969,"_25561":969,"_5":12525,"_2452":44674,"_25885":44675,"_17855":44676,"_24230":969},"EST reference",[41651,42995,43969,43967,44150],[],{"_2926":970,"_25561":969,"_17855":44678,"_5":17750,"_24230":969,"_2452":44679},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_2926":971,"_25561":969,"_5":25882,"_17855":44681,"_24230":44682,"_2452":44683},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_2926":972,"_25561":969,"_5":25882,"_17855":44685,"_24230":44686,"_2452":19404},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_2926":973,"_25561":969,"_5":25882,"_17855":44688,"_24230":44689,"_2452":22211},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_2926":974,"_25561":969,"_5":25882,"_17855":44691,"_24230":44692,"_2452":22218},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_2926":975,"_25561":969,"_5":25882,"_17855":44694,"_24230":44695,"_2452":21577},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_2926":976,"_25561":969,"_5":25882,"_17855":44697,"_24230":44698,"_2452":44699},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_2926":977,"_25561":969,"_5":25882,"_17855":44701,"_24230":44702,"_2452":44703},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_2926":978,"_25561":969,"_5":25882,"_17855":44705,"_24230":44706,"_2452":44707},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_2926":979,"_25561":969,"_17855":44709,"_5":17750,"_24230":969,"_2452":44710},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_2926":980,"_25561":969,"_17855":44712,"_5":17750,"_24230":44682,"_2452":44713},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_2926":981,"_25561":969,"_17855":44715,"_5":17750,"_24230":44682,"_2452":44716},[],"Operation",{"_2926":982,"_25561":969,"_17855":44718,"_5":17750,"_24230":44682,"_2452":44719},[],"Method",{"_2926":983,"_25561":969,"_17855":44721,"_5":17750,"_24230":44682,"_2452":44722},[],"Authentication and condition",{"_2926":984,"_25561":969,"_17855":44724,"_5":17750,"_24230":44682,"_2452":44725},[],"`/cacerts`",{"_2926":985,"_25561":969,"_17855":44727,"_5":17750,"_24230":44682,"_2452":44728},[],"GET",{"_2926":986,"_25561":969,"_17855":44730,"_5":17750,"_24230":44682,"_2452":44731},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_2926":987,"_25561":969,"_17855":44733,"_5":17750,"_24230":44682,"_2452":44734},[],"`/simpleenroll`",{"_2926":988,"_25561":969,"_17855":44736,"_5":17750,"_24230":44682,"_2452":44737},[],"POST",{"_2926":989,"_25561":969,"_17855":44739,"_5":17750,"_24230":44682,"_2452":44740},[],"Initial authentication and DMS registration/replacement policy.",{"_2926":990,"_25561":969,"_17855":44742,"_5":17750,"_24230":44682,"_2452":44743},[],"`/simplereenroll`",{"_2926":991,"_25561":969,"_17855":44745,"_5":17750,"_24230":44682,"_2452":44737},[],{"_2926":992,"_25561":969,"_17855":44747,"_5":17750,"_24230":44682,"_2452":44748},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_2926":993,"_25561":969,"_17855":44750,"_5":17750,"_24230":44682,"_2452":44751},[],"`/serverkeygen`",{"_2926":994,"_25561":969,"_17855":44753,"_5":17750,"_24230":44682,"_2452":44737},[],{"_2926":995,"_25561":969,"_17855":44755,"_5":17750,"_24230":44682,"_2452":44756},[],"Initial authentication and admission; server generation enabled.",{"_2926":996,"_25561":969,"_17855":44758,"_5":17750,"_24230":44682,"_2452":44759},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_2926":997,"_25561":969,"_17855":44761,"_5":17750,"_24230":44686,"_2452":44762},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_2926":998,"_25561":969,"_17855":44764,"_5":17750,"_24230":44686,"_2452":44765},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_2926":999,"_25561":969,"_17855":44767,"_5":17750,"_24230":44689,"_2452":44768},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_2926":1000,"_25561":969,"_17855":44770,"_5":17750,"_24230":44689,"_2452":44771},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_2926":1001,"_25561":969,"_17855":44773,"_5":17750,"_24230":44692,"_2452":44774},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_2926":1002,"_25561":969,"_17855":44776,"_5":17750,"_24230":44692,"_2452":44777},[],"The enrollment CA or a validation CA configured in the re-enrollment block validates the credential in mTLS mode. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_2926":1003,"_25561":969,"_17855":44779,"_5":17750,"_24230":44695,"_2452":44780},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_2926":1004,"_25561":969,"_17855":44782,"_5":17750,"_24230":44695,"_2452":44783},[],"The code supports RSA and ECDSA with 224, 256, 384 or 521 bits. An unrecognized ECDSA size can fall back to 256; explicitly select a compatible size and check the resulting key. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_2926":1005,"_25561":969,"_17855":44785,"_5":17750,"_24230":44698,"_2452":44786},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_2926":1006,"_25561":969,"_17855":44788,"_5":17750,"_24230":44698,"_2452":44789},[],"Part",{"_2926":1007,"_25561":969,"_17855":44791,"_5":17750,"_24230":44698,"_2452":44792},[],"Content after decoding its Base64",{"_2926":1008,"_25561":969,"_17855":44794,"_5":17750,"_24230":44698,"_2452":44795},[],"`application/pkcs8`",{"_2926":1009,"_25561":969,"_17855":44797,"_5":17750,"_24230":44698,"_2452":44798},[],"Unencrypted DER PKCS#8 private key.",{"_2926":1010,"_25561":969,"_17855":44800,"_5":17750,"_24230":44698,"_2452":44801},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_2926":1011,"_25561":969,"_17855":44803,"_5":17750,"_24230":44698,"_2452":44804},[],"DER PKCS#7 containing the issued certificate.",{"_2926":1012,"_25561":969,"_17855":44806,"_5":17750,"_24230":44698,"_2452":44807},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_2926":1013,"_25561":969,"_17855":44809,"_5":17750,"_24230":44702,"_2452":44810},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_2926":1014,"_25561":969,"_17855":44812,"_5":17750,"_24230":44702,"_2452":44813},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_2926":1015,"_25561":969,"_17855":44815,"_5":17750,"_24230":44702,"_2452":44816},[],"Convert and check the result:",{"_2926":1016,"_25561":969,"_17855":44818,"_5":17750,"_24230":44702,"_2452":44819},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_2926":1017,"_25561":969,"_17855":44821,"_5":17750,"_24230":44706,"_2452":44822},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_2926":1018,"_25561":969,"_17855":44824,"_5":17750,"_24230":44706,"_2452":44825},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_2926":1019,"_25561":1019,"_5":12525,"_2452":44150,"_25885":44827,"_17855":44828,"_24230":1019},[41651,42995,43969,43967,44150],[],{"_2926":1020,"_25561":1019,"_17855":44830,"_5":17750,"_24230":1019,"_2452":44831},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_2926":1021,"_25561":1019,"_5":25882,"_17855":44833,"_24230":44834,"_2452":44835},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_2926":1022,"_25561":1019,"_5":25882,"_17855":44837,"_24230":44838,"_2452":44839},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_2926":1023,"_25561":1019,"_5":25882,"_17855":44841,"_24230":44842,"_2452":44843},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_2926":1024,"_25561":1019,"_5":25882,"_17855":44845,"_24230":44846,"_2452":44847},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_2926":1025,"_25561":1019,"_17855":44849,"_5":17750,"_24230":1019,"_2452":44850},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_2926":1026,"_25561":1019,"_17855":44852,"_5":17750,"_24230":44834,"_2452":44853},[],"The administrator prepares the CA, issuance profile and DMS.",{"_2926":1027,"_25561":1019,"_17855":44855,"_5":17750,"_24230":44834,"_2452":44856},[],"The integrator installs initial EST server trust and an admission credential.",{"_2926":1028,"_25561":1019,"_17855":44858,"_5":17750,"_24230":44834,"_2452":44859},[],"The client requests an identity for its `Device ID` through EST.",{"_2926":1029,"_25561":1019,"_17855":44861,"_5":17750,"_24230":44834,"_2452":44862},[],"Certificate, device binding and key/certificate installation are checked.",{"_2926":1030,"_25561":1019,"_17855":44864,"_5":17750,"_24230":44834,"_2452":44865},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_2926":1031,"_25561":1019,"_17855":44867,"_5":17750,"_24230":44834,"_2452":44868},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_2926":1032,"_25561":1019,"_17855":44870,"_5":17750,"_24230":44838,"_2452":44871},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_2926":1033,"_25561":1019,"_17855":44873,"_5":17750,"_24230":44838,"_2452":44874},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":1034,"_25561":1019,"_17855":44876,"_5":17750,"_24230":44838,"_2452":44877},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_2926":1035,"_25561":1019,"_17855":44879,"_5":17750,"_24230":44838,"_2452":44880},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_2926":1036,"_25561":1019,"_17855":44882,"_5":17750,"_24230":44842,"_2452":44883},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2926":1037,"_25561":1019,"_17855":44885,"_5":17750,"_24230":44842,"_2452":44886},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_2926":1038,"_25561":1019,"_17855":44888,"_5":17750,"_24230":44842,"_2452":44889},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_2926":1039,"_25561":1019,"_17855":44891,"_5":17750,"_24230":44842,"_2452":44892},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_2926":1040,"_25561":1019,"_17855":44894,"_5":17750,"_24230":44846,"_2452":44895},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_2926":1041,"_25561":1019,"_17855":44897,"_5":17750,"_24230":44846,"_2452":44898},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_2926":1042,"_25561":1042,"_5":12525,"_2452":44900,"_25885":44901,"_17855":44902,"_24230":1042},"Provisioning strategies",[41651,42995,43969,43967,44150],[],{"_2926":1043,"_25561":1042,"_17855":44904,"_5":17750,"_24230":1042,"_2452":44905},[],"Choose device registration, identity authorization and key generation.",{"_2926":1044,"_25561":1042,"_5":25882,"_17855":44907,"_24230":44908,"_2452":44909},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_2926":1045,"_25561":1042,"_5":25882,"_17855":44911,"_24230":44912,"_2452":44913},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_2926":1046,"_25561":1042,"_5":25882,"_17855":44915,"_24230":44916,"_2452":44917},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_2926":1047,"_25561":1042,"_5":25882,"_17855":44919,"_24230":44920,"_2452":44921},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_2926":1048,"_25561":1042,"_5":25882,"_17855":44923,"_24230":44924,"_2452":44925},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_2926":1049,"_25561":1042,"_17855":44927,"_5":17750,"_24230":1042,"_2452":44928},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_2926":1050,"_25561":1042,"_17855":44930,"_5":17750,"_24230":44908,"_2452":44931},[],"Path",{"_2926":1051,"_25561":1042,"_17855":44933,"_5":17750,"_24230":44908,"_2452":44934},[],"When the device exists",{"_2926":1052,"_25561":1042,"_17855":44936,"_5":17750,"_24230":44908,"_2452":44937},[],"What to check",{"_2926":1053,"_25561":1042,"_17855":44939,"_5":17750,"_24230":44908,"_2452":44940},[],"Manual assignment",{"_2926":1054,"_25561":1042,"_17855":44942,"_5":17750,"_24230":44908,"_2452":44943},[],"An operator creates it before associating a certificate.",{"_2926":1055,"_25561":1042,"_17855":44945,"_5":17750,"_24230":44908,"_2452":44946},[],"ID, owning DMS, certificate CN and bound serial.",{"_2926":1056,"_25561":1042,"_17855":44948,"_5":17750,"_24230":44908,"_2452":44949},[],"EST with `JITP`",{"_2926":1057,"_25561":1042,"_17855":44951,"_5":17750,"_24230":44908,"_2452":44952},[],"Created for an unknown CN during `/simpleenroll`.",{"_2926":1058,"_25561":1042,"_17855":44954,"_5":17750,"_24230":44908,"_2452":44955},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_2926":1059,"_25561":1042,"_17855":44957,"_5":17750,"_24230":44908,"_2452":44958},[],"EST with `PRE_REGISTRATION`",{"_2926":1060,"_25561":1042,"_17855":44960,"_5":17750,"_24230":44908,"_2452":44961},[],"Must exist before `/simpleenroll`.",{"_2926":1061,"_25561":1042,"_17855":44963,"_5":17750,"_24230":44908,"_2452":44964},[],"Approved record, same DMS and replacement conditions for your version.",{"_2926":1062,"_25561":1042,"_17855":44966,"_5":17750,"_24230":44908,"_2452":44967},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_2926":1063,"_25561":1042,"_17855":44969,"_5":17750,"_24230":44908,"_2452":44970},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_2926":1064,"_25561":1042,"_17855":44972,"_5":17750,"_24230":44912,"_2452":44973},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_2926":1065,"_25561":1042,"_17855":44975,"_5":17750,"_24230":44912,"_2452":44976},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_2926":1066,"_25561":1042,"_17855":44978,"_5":17750,"_24230":44912,"_2452":44979},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_2926":1067,"_25561":1042,"_17855":44981,"_5":17750,"_24230":44916,"_2452":44982},[],"Decide initial enrollment and re-enrollment separately:",{"_2926":1068,"_25561":1042,"_17855":44984,"_5":17750,"_24230":44916,"_2452":44985},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_2926":1069,"_25561":1042,"_17855":44987,"_5":17750,"_24230":44916,"_2452":44988},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_2926":1070,"_25561":1042,"_17855":44990,"_5":17750,"_24230":44916,"_2452":44991},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_2926":1071,"_25561":1042,"_17855":44993,"_5":17750,"_24230":44916,"_2452":44994},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_2926":1072,"_25561":1042,"_17855":44996,"_5":17750,"_24230":44916,"_2452":44997},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_2926":1073,"_25561":1042,"_17855":44999,"_5":17750,"_24230":44920,"_2452":42028},[],{"_2926":1074,"_25561":1042,"_17855":45001,"_5":17750,"_24230":44920,"_2452":45002},[],"Material crossing EST",{"_2926":1075,"_25561":1042,"_17855":45004,"_5":17750,"_24230":44920,"_2452":45005},[],"Device-generated key",{"_2926":1076,"_25561":1042,"_17855":45007,"_5":17750,"_24230":44920,"_2452":45008},[],"Public CSR and certificate; the key stays on the client.",{"_2926":1077,"_25561":1042,"_17855":45010,"_5":17750,"_24230":44920,"_2452":45011},[],"Existing device key",{"_2926":1078,"_25561":1042,"_17855":45013,"_5":17750,"_24230":44920,"_2452":45014},[],"CSR signed with that key and a new certificate.",{"_2926":1079,"_25561":1042,"_17855":45016,"_5":17750,"_24230":44920,"_2452":44288},[],{"_2926":1080,"_25561":1042,"_17855":45018,"_5":17750,"_24230":44920,"_2452":45019},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_2926":1081,"_25561":1042,"_17855":45021,"_5":17750,"_24230":44920,"_2452":45022},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_2926":1082,"_25561":1042,"_17855":45024,"_5":17750,"_24230":44924,"_2452":45025},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_2926":1083,"_25561":1083,"_5":12525,"_2452":45027,"_25885":45028,"_17855":45029,"_24230":1083},"Renewal and recovery",[41651,42995,43969,43967,44150],[],{"_2926":1084,"_25561":1083,"_17855":45031,"_5":17750,"_24230":1083,"_2452":45032},[],"Renew without losing the identity and recover devices according to their actual state.",{"_2926":1085,"_25561":1083,"_5":25882,"_17855":45034,"_24230":45035,"_2452":45036},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_2926":1086,"_25561":1083,"_5":25882,"_17855":45038,"_24230":45039,"_2452":45040},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_2926":1087,"_25561":1083,"_5":25882,"_17855":45042,"_24230":45043,"_2452":45044},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_2926":1088,"_25561":1083,"_5":25882,"_17855":45046,"_24230":45047,"_2452":45048},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_2926":1089,"_25561":1083,"_5":25882,"_17855":45050,"_24230":45051,"_2452":45052},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_2926":1090,"_25561":1083,"_17855":45054,"_5":17750,"_24230":1083,"_2452":45055},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_2926":1091,"_25561":1083,"_17855":45057,"_5":17750,"_24230":45035,"_2452":45058},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_2926":1092,"_25561":1083,"_17855":45060,"_5":17750,"_24230":45035,"_2452":45061},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_2926":1093,"_25561":1083,"_17855":45063,"_5":17750,"_24230":45035,"_2452":45064},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_2926":1094,"_25561":1083,"_17855":45066,"_5":17750,"_24230":45035,"_2452":45067},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_2926":1095,"_25561":1083,"_17855":45069,"_5":17750,"_24230":45039,"_2452":45070},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_2926":1096,"_25561":1083,"_17855":45072,"_5":17750,"_24230":45039,"_2452":45073},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_2926":1097,"_25561":1083,"_17855":45075,"_5":17750,"_24230":45043,"_2452":45076},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_2926":1098,"_25561":1083,"_17855":45078,"_5":17750,"_24230":45043,"_2452":45079},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_2926":1099,"_25561":1083,"_17855":45081,"_5":17750,"_24230":45043,"_2452":45082},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_2926":1100,"_25561":1083,"_17855":45084,"_5":17750,"_24230":45047,"_2452":45085},[],"Situation",{"_2926":1101,"_25561":1083,"_17855":45087,"_5":17750,"_24230":45047,"_2452":45088},[],"Procedure",{"_2926":1102,"_25561":1083,"_17855":45090,"_5":17750,"_24230":45047,"_2452":45091},[],"Valid certificate, outside the window",{"_2926":1103,"_25561":1083,"_17855":45093,"_5":17750,"_24230":45047,"_2452":45094},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_2926":1104,"_25561":1083,"_17855":45096,"_5":17750,"_24230":45047,"_2452":45097},[],"Expired certificate, key available",{"_2926":1105,"_25561":1083,"_17855":45099,"_5":17750,"_24230":45047,"_2452":45100},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_2926":1106,"_25561":1083,"_17855":45102,"_5":17750,"_24230":45047,"_2452":45103},[],"Renewal through webhook or `NO_AUTH`",{"_2926":1107,"_25561":1083,"_17855":45105,"_5":17750,"_24230":45047,"_2452":45106},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_2926":1108,"_25561":1083,"_17855":45108,"_5":17750,"_24230":45047,"_2452":45109},[],"Lost or inaccessible key",{"_2926":1109,"_25561":1083,"_17855":45111,"_5":17750,"_24230":45047,"_2452":45112},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_2926":1110,"_25561":1083,"_17855":45114,"_5":17750,"_24230":45047,"_2452":45115},[],"Current identity revoked",{"_2926":1111,"_25561":1083,"_17855":45117,"_5":17750,"_24230":45047,"_2452":45118},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_2926":1112,"_25561":1083,"_17855":45120,"_5":17750,"_24230":45047,"_2452":45121},[],"Device without an identity",{"_2926":1113,"_25561":1083,"_17855":45123,"_5":17750,"_24230":45047,"_2452":45124},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_2926":1114,"_25561":1083,"_17855":45126,"_5":17750,"_24230":45047,"_2452":45127},[],"Retired device",{"_2926":1115,"_25561":1083,"_17855":45129,"_5":17750,"_24230":45047,"_2452":45130},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_2926":1116,"_25561":1083,"_17855":45132,"_5":17750,"_24230":45047,"_2452":45133},[],"Timeout, HTTP 500 or installation failure",{"_2926":1117,"_25561":1083,"_17855":45135,"_5":17750,"_24230":45047,"_2452":45136},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_2926":1118,"_25561":1083,"_17855":45138,"_5":17750,"_24230":45051,"_2452":45139},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_2926":1119,"_25561":1083,"_17855":45141,"_5":17750,"_24230":45051,"_2452":45142},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_2926":1120,"_25561":1120,"_5":12525,"_2452":45144,"_25885":45145,"_17855":45146,"_24230":1120},"Enrollment troubleshooting",[41651,42995,43969,43967,44150],[],{"_2926":1121,"_25561":1120,"_17855":45148,"_5":17750,"_24230":1120,"_2452":45149},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_2926":1122,"_25561":1120,"_5":25882,"_17855":45151,"_24230":45152,"_2452":45153},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_2926":1123,"_25561":1120,"_5":25882,"_17855":45155,"_24230":45156,"_2452":45157},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_2926":1124,"_25561":1120,"_5":25882,"_17855":45159,"_24230":45160,"_2452":44707},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_2926":1125,"_25561":1120,"_5":25882,"_17855":45162,"_24230":45163,"_2452":45164},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_2926":1126,"_25561":1120,"_17855":45166,"_5":17750,"_24230":1120,"_2452":45167},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_2926":1127,"_25561":1120,"_17855":45169,"_5":17750,"_24230":45156,"_2452":45170},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_2926":1128,"_25561":1120,"_17855":45172,"_5":17750,"_24230":45156,"_2452":45173},[],"Symptom or message",{"_2926":1129,"_25561":1120,"_17855":45175,"_5":17750,"_24230":45156,"_2452":44937},[],{"_2926":1130,"_25561":1120,"_17855":45177,"_5":17750,"_24230":45156,"_2452":45178},[],"curl rejects TLS, name or issuer",{"_2926":1131,"_25561":1120,"_17855":45180,"_5":17750,"_24230":45156,"_2452":45181},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_2926":1132,"_25561":1120,"_17855":45183,"_5":17750,"_24230":45156,"_2452":45184},[],"404 or missing APS",{"_2926":1133,"_25561":1120,"_17855":45186,"_5":17750,"_24230":45156,"_2452":45187},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_2926":1134,"_25561":1120,"_17855":45189,"_5":17750,"_24230":45156,"_2452":45190},[],"400, CSR or format error",{"_2926":1135,"_25561":1120,"_17855":45192,"_5":17750,"_24230":45156,"_2452":45193},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_2926":1136,"_25561":1120,"_17855":45195,"_5":17750,"_24230":45156,"_2452":45196},[],"Missing credential or invalid certificate",{"_2926":1137,"_25561":1120,"_17855":45198,"_5":17750,"_24230":45156,"_2452":45199},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_2926":1138,"_25561":1120,"_17855":45201,"_5":17750,"_24230":45156,"_2452":45202},[],"Webhook denies, times out or responds without authorization",{"_2926":1139,"_25561":1120,"_17855":45204,"_5":17750,"_24230":45156,"_2452":45205},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_2926":1140,"_25561":1120,"_17855":45207,"_5":17750,"_24230":45156,"_2452":45208},[],"`unexpected status code: <n>: redirects are not followed`",{"_2926":1141,"_25561":1120,"_17855":45210,"_5":17750,"_24230":45156,"_2452":45211},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_2926":1142,"_25561":1120,"_17855":45213,"_5":17750,"_24230":45156,"_2452":45214},[],"`webhook response exceeds 1048576 bytes`",{"_2926":1143,"_25561":1120,"_17855":45216,"_5":17750,"_24230":45156,"_2452":45217},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_2926":1144,"_25561":1120,"_17855":45219,"_5":17750,"_24230":45156,"_2452":45220},[],"`webhook config must not reference files`",{"_2926":1145,"_25561":1120,"_17855":45222,"_5":17750,"_24230":45156,"_2452":45223},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_2926":1146,"_25561":1120,"_17855":45225,"_5":17750,"_24230":45156,"_2452":45226},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_2926":1147,"_25561":1120,"_17855":45228,"_5":17750,"_24230":45156,"_2452":45229},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_2926":1148,"_25561":1120,"_17855":45231,"_5":17750,"_24230":45156,"_2452":45232},[],"`webhook mTLS certificate and key are invalid: …`",{"_2926":1149,"_25561":1120,"_17855":45234,"_5":17750,"_24230":45156,"_2452":45235},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_2926":1150,"_25561":1120,"_17855":45237,"_5":17750,"_24230":45156,"_2452":45238},[],"400 `struct validation error` creating or updating a DMS",{"_2926":1151,"_25561":1120,"_17855":45240,"_5":17750,"_24230":45156,"_2452":45241},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_2926":1152,"_25561":1120,"_17855":45243,"_5":17750,"_24230":45156,"_2452":45244},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_2926":1153,"_25561":1120,"_17855":45246,"_5":17750,"_24230":45156,"_2452":45247},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_2926":1154,"_25561":1120,"_17855":45249,"_5":17750,"_24230":45156,"_2452":45250},[],"`device not preregistered`",{"_2926":1155,"_25561":1120,"_17855":45252,"_5":17750,"_24230":45156,"_2452":45253},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_2926":1156,"_25561":1120,"_17855":45255,"_5":17750,"_24230":45156,"_2452":45256},[],"`forbiddenNewEnrollment`",{"_2926":1157,"_25561":1120,"_17855":45258,"_5":17750,"_24230":45156,"_2452":45259},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_2926":1158,"_25561":1120,"_17855":45261,"_5":17750,"_24230":45156,"_2452":45262},[],"Different owning DMS",{"_2926":1159,"_25561":1120,"_17855":45264,"_5":17750,"_24230":45156,"_2452":45265},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_2926":1160,"_25561":1120,"_17855":45267,"_5":17750,"_24230":45156,"_2452":45268},[],"`invalid RawSubject bytes`",{"_2926":1161,"_25561":1120,"_17855":45270,"_5":17750,"_24230":45156,"_2452":45271},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_2926":1162,"_25561":1120,"_17855":45273,"_5":17750,"_24230":45156,"_2452":45274},[],"`invalid reenroll window`",{"_2926":1163,"_25561":1120,"_17855":45276,"_5":17750,"_24230":45156,"_2452":45277},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_2926":1164,"_25561":1120,"_17855":45279,"_5":17750,"_24230":45156,"_2452":45280},[],"Current certificate revoked",{"_2926":1165,"_25561":1120,"_17855":45282,"_5":17750,"_24230":45156,"_2452":45283},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_2926":1166,"_25561":1120,"_17855":45285,"_5":17750,"_24230":45156,"_2452":45286},[],"CA, profile or signing error",{"_2926":1167,"_25561":1120,"_17855":45288,"_5":17750,"_24230":45156,"_2452":45289},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_2926":1168,"_25561":1120,"_17855":45291,"_5":17750,"_24230":45156,"_2452":45292},[],"HTTP 200 without a device connection",{"_2926":1169,"_25561":1120,"_17855":45294,"_5":17750,"_24230":45156,"_2452":45295},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_2926":1170,"_25561":1120,"_17855":45297,"_5":17750,"_24230":45156,"_2452":45298},[],"Timeout or error after issuance",{"_2926":1171,"_25561":1120,"_17855":45300,"_5":17750,"_24230":45156,"_2452":45301},[],"New certificates, current slot and previous identity's state before retrying.",{"_2926":1172,"_25561":1120,"_17855":45303,"_5":17750,"_24230":45160,"_2452":45304},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_2926":1173,"_25561":1120,"_17855":45306,"_5":17750,"_24230":45160,"_2452":45307},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_2926":1174,"_25561":1120,"_17855":45309,"_5":17750,"_24230":45163,"_2452":45310},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_2926":1175,"_25561":1120,"_17855":45312,"_5":17750,"_24230":45163,"_2452":45313},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_2926":1176,"_25561":1120,"_17855":45315,"_5":17750,"_24230":45163,"_2452":45316},[],"Verify the CSR locally and relate its CN to the inventory.",{"_2926":1177,"_25561":1120,"_17855":45318,"_5":17750,"_24230":45163,"_2452":45319},[],"Make one request, save headers/body and query the device and certificates.",{"_2926":1178,"_25561":1120,"_17855":45321,"_5":17750,"_24230":45163,"_2452":45322},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_2926":1179,"_25561":1120,"_17855":45324,"_5":17750,"_24230":45163,"_2452":45325},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_2926":1180,"_25561":1120,"_17855":45327,"_5":17750,"_24230":45163,"_2452":45328},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_2926":1181,"_25561":1181,"_5":12525,"_2452":45330,"_25885":45331,"_17855":45332,"_24230":1181},"Trust distribution and updates",[41651,42995,43969,43967,44150],[],{"_2926":1182,"_25561":1181,"_17855":45334,"_5":17750,"_24230":1181,"_2452":45335},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_2926":1183,"_25561":1181,"_5":25882,"_17855":45337,"_24230":45338,"_2452":45339},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_2926":1184,"_25561":1181,"_5":25882,"_17855":45341,"_24230":45342,"_2452":45343},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_2926":1185,"_25561":1181,"_5":25882,"_17855":45345,"_24230":45346,"_2452":45347},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_2926":1186,"_25561":1181,"_5":25882,"_17855":45349,"_24230":45350,"_2452":45351},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_2926":1187,"_25561":1181,"_5":25882,"_17855":45353,"_24230":45354,"_2452":45355},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_2926":1188,"_25561":1181,"_17855":45357,"_5":17750,"_24230":1181,"_2452":45358},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_2926":1189,"_25561":1181,"_17855":45360,"_5":17750,"_24230":45338,"_2452":45361},[],"Relationship",{"_2926":1190,"_25561":1181,"_17855":45363,"_5":17750,"_24230":45338,"_2452":45364},[],"Material prepared by its owner",{"_2926":1191,"_25561":1181,"_17855":45366,"_5":17750,"_24230":45338,"_2452":45367},[],"Device → EST server",{"_2926":1192,"_25561":1181,"_17855":45369,"_5":17750,"_24230":45338,"_2452":45370},[],"Previously verified server root, chain or pin and TLS name.",{"_2926":1193,"_25561":1181,"_17855":45372,"_5":17750,"_24230":45338,"_2452":45373},[],"DMS → requester",{"_2926":1194,"_25561":1181,"_17855":45375,"_5":17750,"_24230":45338,"_2452":45376},[],"CAs and rules authorizing initial or renewal credentials.",{"_2926":1195,"_25561":1181,"_17855":45378,"_5":17750,"_24230":45338,"_2452":45379},[],"Consumer → device",{"_2926":1196,"_25561":1181,"_17855":45381,"_5":17750,"_24230":45338,"_2452":45382},[],"Operational identity roots, intermediates, validation and permissions.",{"_2926":1197,"_25561":1181,"_17855":45384,"_5":17750,"_24230":45338,"_2452":45385},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_2926":1198,"_25561":1181,"_17855":45387,"_5":17750,"_24230":45342,"_2452":45388},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_2926":1199,"_25561":1181,"_17855":45390,"_5":17750,"_24230":45342,"_2452":45391},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_2926":1200,"_25561":1181,"_17855":45393,"_5":17750,"_24230":45346,"_2452":45394},[],"Keep initial EST server trust separate from identity consumer trust.",{"_2926":1201,"_25561":1181,"_17855":45396,"_5":17750,"_24230":45346,"_2452":45397},[],"Select policy-approved roots as anchors.",{"_2926":1202,"_25561":1181,"_17855":45399,"_5":17750,"_24230":45346,"_2452":45400},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_2926":1203,"_25561":1181,"_17855":45402,"_5":17750,"_24230":45346,"_2452":45403},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_2926":1204,"_25561":1181,"_17855":45405,"_5":17750,"_24230":45346,"_2452":45406},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_2926":1205,"_25561":1181,"_17855":45408,"_5":17750,"_24230":45346,"_2452":45409},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_2926":1206,"_25561":1181,"_17855":45411,"_5":17750,"_24230":45350,"_2452":45412},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_2926":1207,"_25561":1181,"_17855":45414,"_5":17750,"_24230":45350,"_2452":45415},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. When switching the enrollment CA, add the previous issuance CA to that list so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_2926":1208,"_25561":1181,"_17855":45417,"_5":17750,"_24230":45350,"_2452":45418},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_2926":1209,"_25561":1181,"_17855":45420,"_5":17750,"_24230":45354,"_2452":45421},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_2926":1210,"_25561":1210,"_5":12525,"_2452":45423,"_25885":45424,"_17855":45426,"_24230":1210},"AWS IoT Core",[41651,42995,43969,43967,45425],"Integrations",[],{"_2926":1211,"_25561":1210,"_17855":45428,"_5":17750,"_24230":1210,"_2452":45429},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_2926":1212,"_25561":1210,"_5":25882,"_17855":45431,"_24230":45432,"_2452":45433},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_2926":1213,"_25561":1210,"_5":25882,"_17855":45435,"_24230":45436,"_2452":45437},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_2926":1214,"_25561":1210,"_5":25882,"_17855":45439,"_24230":45440,"_2452":45441},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_2926":1215,"_25561":1210,"_5":25882,"_17855":45443,"_24230":45444,"_2452":45445},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_2926":1216,"_25561":1210,"_5":25882,"_17855":45447,"_24230":45448,"_2452":45449},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_2926":1217,"_25561":1210,"_5":25882,"_17855":45451,"_24230":45452,"_2452":45453},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_2926":1218,"_25561":1210,"_5":25882,"_17855":45455,"_24230":45456,"_2452":45457},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_2926":1219,"_25561":1210,"_5":25882,"_17855":45459,"_24230":45460,"_2452":45461},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_2926":1220,"_25561":1210,"_5":25882,"_17855":45463,"_24230":45464,"_2452":45465},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_2926":1221,"_25561":1210,"_5":25882,"_17855":45467,"_24230":45468,"_2452":45469},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_2926":1222,"_25561":1210,"_5":25882,"_17855":45471,"_24230":45472,"_2452":45473},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_2926":1223,"_25561":1210,"_5":25882,"_17855":45475,"_24230":45476,"_2452":45477},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_2926":1224,"_25561":1210,"_5":25882,"_17855":45479,"_24230":45480,"_2452":45481},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_2926":1225,"_25561":1210,"_5":25882,"_17855":45483,"_24230":45484,"_2452":45485},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_2926":1226,"_25561":1210,"_5":25882,"_17855":45487,"_24230":45488,"_2452":45489},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_2926":1227,"_25561":1210,"_5":25882,"_17855":45491,"_24230":45492,"_2452":45493},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_2926":1228,"_25561":1210,"_5":25882,"_17855":45495,"_24230":45496,"_2452":45497},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_2926":1229,"_25561":1210,"_5":25882,"_17855":45499,"_24230":45500,"_2452":45501},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_2926":1230,"_25561":1210,"_5":25882,"_17855":45503,"_24230":45504,"_2452":45505},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_2926":1231,"_25561":1210,"_5":25882,"_17855":45507,"_24230":45508,"_2452":45509},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_2926":1232,"_25561":1210,"_17855":45511,"_5":17750,"_24230":1210,"_2452":45512},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_2926":1233,"_25561":1210,"_17855":45514,"_5":17750,"_24230":1210,"_2452":45515},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_2926":1234,"_25561":1210,"_17855":45517,"_5":17750,"_24230":1210,"_2452":45518},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_2926":1235,"_25561":1210,"_17855":45520,"_5":17750,"_24230":45432,"_2452":45521},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_2926":1236,"_25561":1210,"_17855":45523,"_5":17750,"_24230":45432,"_2452":45524},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_2926":1237,"_25561":1210,"_17855":45526,"_5":17750,"_24230":45432,"_2452":45527},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_2926":1238,"_25561":1210,"_17855":45529,"_5":17750,"_24230":45432,"_2452":45530},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_2926":1239,"_25561":1210,"_17855":45532,"_5":17750,"_24230":45436,"_2452":45533},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_2926":1240,"_25561":1210,"_17855":45535,"_5":17750,"_24230":45440,"_2452":45536},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_2926":1241,"_25561":1210,"_17855":45538,"_5":17750,"_24230":45440,"_2452":45539},[],"IAM action",{"_2926":1242,"_25561":1210,"_17855":45541,"_5":17750,"_24230":45440,"_2452":42034},[],{"_2926":1243,"_25561":1210,"_17855":45543,"_5":17750,"_24230":45440,"_2452":45544},[],"`iot:GetRegistrationCode`",{"_2926":1244,"_25561":1210,"_17855":45546,"_5":17750,"_24230":45440,"_2452":45547},[],"Obtain the verification code for CA registration in the Primary Account",{"_2926":1245,"_25561":1210,"_17855":45549,"_5":17750,"_24230":45440,"_2452":45550},[],"`iot:RegisterCACertificate`",{"_2926":1246,"_25561":1210,"_17855":45552,"_5":17750,"_24230":45440,"_2452":45553},[],"Register the CA in AWS IoT",{"_2926":1247,"_25561":1210,"_17855":45555,"_5":17750,"_24230":45440,"_2452":45556},[],"`iot:DescribeCACertificate`",{"_2926":1248,"_25561":1210,"_17855":45558,"_5":17750,"_24230":45440,"_2452":45559},[],"Check the CA registration status",{"_2926":1249,"_25561":1210,"_17855":45561,"_5":17750,"_24230":45440,"_2452":45562},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_2926":1250,"_25561":1210,"_17855":45564,"_5":17750,"_24230":45440,"_2452":45565},[],"Create or update Things in IoT Core",{"_2926":1251,"_25561":1210,"_17855":45567,"_5":17750,"_24230":45440,"_2452":45568},[],"`iot:RegisterThing`",{"_2926":1252,"_25561":1210,"_17855":45570,"_5":17750,"_24230":45440,"_2452":45571},[],"Provision Things through a template",{"_2926":1253,"_25561":1210,"_17855":45573,"_5":17750,"_24230":45440,"_2452":45574},[],"`iot:RegisterCertificate`",{"_2926":1254,"_25561":1210,"_17855":45576,"_5":17750,"_24230":45440,"_2452":45577},[],"Register device certificates",{"_2926":1255,"_25561":1210,"_17855":45579,"_5":17750,"_24230":45440,"_2452":45580},[],"`iot:UpdateCertificate`",{"_2926":1256,"_25561":1210,"_17855":45582,"_5":17750,"_24230":45440,"_2452":45583},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_2926":1257,"_25561":1210,"_17855":45585,"_5":17750,"_24230":45440,"_2452":45586},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_2926":1258,"_25561":1210,"_17855":45588,"_5":17750,"_24230":45440,"_2452":45589},[],"Create and attach IoT policies",{"_2926":1259,"_25561":1210,"_17855":45591,"_5":17750,"_24230":45440,"_2452":45592},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_2926":1260,"_25561":1210,"_17855":45594,"_5":17750,"_24230":45440,"_2452":45595},[],"Manage Thing groups",{"_2926":1261,"_25561":1210,"_17855":45597,"_5":17750,"_24230":45440,"_2452":45598},[],"`iot:CreateProvisioningTemplate`",{"_2926":1262,"_25561":1210,"_17855":45600,"_5":17750,"_24230":45440,"_2452":45601},[],"Create JITP templates",{"_2926":1263,"_25561":1210,"_17855":45603,"_5":17750,"_24230":45440,"_2452":45604},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_2926":1264,"_25561":1210,"_17855":45606,"_5":17750,"_24230":45440,"_2452":45607},[],"Read and write the Device Shadow",{"_2926":1265,"_25561":1210,"_17855":45609,"_5":17750,"_24230":45440,"_2452":45610},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_2926":1266,"_25561":1210,"_17855":45612,"_5":17750,"_24230":45444,"_2452":45613},[],"Parameter",{"_2926":1267,"_25561":1210,"_17855":45615,"_5":17750,"_24230":45444,"_2452":45616},[],"Type",{"_2926":1268,"_25561":1210,"_17855":45618,"_5":17750,"_24230":45444,"_2452":45619},[],"Required",{"_2926":1269,"_25561":1210,"_17855":45621,"_5":17750,"_24230":45444,"_2452":45622},[],"Description",{"_2926":1270,"_25561":1210,"_17855":45624,"_5":17750,"_24230":45444,"_2452":45625},[],"`connector_id`",{"_2926":1271,"_25561":1210,"_17855":45627,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1272,"_25561":1210,"_17855":45629,"_5":17750,"_24230":45444,"_2452":45630},[],"Yes",{"_2926":1273,"_25561":1210,"_17855":45632,"_5":17750,"_24230":45444,"_2452":45633},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_2926":1274,"_25561":1210,"_17855":45635,"_5":17750,"_24230":45444,"_2452":45636},[],"`aws_config.region`",{"_2926":1275,"_25561":1210,"_17855":45638,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1276,"_25561":1210,"_17855":45640,"_5":17750,"_24230":45444,"_2452":45630},[],{"_2926":1277,"_25561":1210,"_17855":45642,"_5":17750,"_24230":45444,"_2452":45643},[],"AWS region where the connector operates.",{"_2926":1278,"_25561":1210,"_17855":45645,"_5":17750,"_24230":45444,"_2452":45646},[],"`aws_config.auth_method`",{"_2926":1279,"_25561":1210,"_17855":45648,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1280,"_25561":1210,"_17855":45650,"_5":17750,"_24230":45444,"_2452":45630},[],{"_2926":1281,"_25561":1210,"_17855":45652,"_5":17750,"_24230":45444,"_2452":45653},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_2926":1282,"_25561":1210,"_17855":45655,"_5":17750,"_24230":45444,"_2452":45656},[],"`aws_config.access_key_id`",{"_2926":1283,"_25561":1210,"_17855":45658,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1284,"_25561":1210,"_17855":45660,"_5":17750,"_24230":45444,"_2452":45661},[],"Only with `auth_method=static`",{"_2926":1285,"_25561":1210,"_17855":45663,"_5":17750,"_24230":45444,"_2452":45664},[],"AWS access key.",{"_2926":1286,"_25561":1210,"_17855":45666,"_5":17750,"_24230":45444,"_2452":45667},[],"`aws_config.secret_access_key`",{"_2926":1287,"_25561":1210,"_17855":45669,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1288,"_25561":1210,"_17855":45671,"_5":17750,"_24230":45444,"_2452":45661},[],{"_2926":1289,"_25561":1210,"_17855":45673,"_5":17750,"_24230":45444,"_2452":45674},[],"AWS secret key.",{"_2926":1290,"_25561":1210,"_17855":45676,"_5":17750,"_24230":45444,"_2452":45677},[],"`aws_config.session_token`",{"_2926":1291,"_25561":1210,"_17855":45679,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1292,"_25561":1210,"_17855":45681,"_5":17750,"_24230":45444,"_2452":45682},[],"No",{"_2926":1293,"_25561":1210,"_17855":45684,"_5":17750,"_24230":45444,"_2452":45685},[],"Session token (with `auth_method=static`).",{"_2926":1294,"_25561":1210,"_17855":45687,"_5":17750,"_24230":45444,"_2452":45688},[],"`aws_config.role_arn`",{"_2926":1295,"_25561":1210,"_17855":45690,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1296,"_25561":1210,"_17855":45692,"_5":17750,"_24230":45444,"_2452":45693},[],"Only with `auth_method=role`",{"_2926":1297,"_25561":1210,"_17855":45695,"_5":17750,"_24230":45444,"_2452":45696},[],"ARN of the role to assume.",{"_2926":1298,"_25561":1210,"_17855":45698,"_5":17750,"_24230":45444,"_2452":45699},[],"`aws_config.endpoint_url`",{"_2926":1299,"_25561":1210,"_17855":45701,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1300,"_25561":1210,"_17855":45703,"_5":17750,"_24230":45444,"_2452":45682},[],{"_2926":1301,"_25561":1210,"_17855":45705,"_5":17750,"_24230":45444,"_2452":45706},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_2926":1302,"_25561":1210,"_17855":45708,"_5":17750,"_24230":45444,"_2452":45709},[],"`subscriber_event_bus`",{"_2926":1303,"_25561":1210,"_17855":45711,"_5":17750,"_24230":45444,"_2452":14967},[],{"_2926":1304,"_25561":1210,"_17855":45713,"_5":17750,"_24230":45444,"_2452":45630},[],{"_2926":1305,"_25561":1210,"_17855":45715,"_5":17750,"_24230":45444,"_2452":45716},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_2926":1306,"_25561":1210,"_17855":45718,"_5":17750,"_24230":45444,"_2452":45719},[],"`dms_manager_client`",{"_2926":1307,"_25561":1210,"_17855":45721,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1308,"_25561":1210,"_17855":45723,"_5":17750,"_24230":45444,"_2452":45630},[],{"_2926":1309,"_25561":1210,"_17855":45725,"_5":17750,"_24230":45444,"_2452":45726},[],"HTTP URL of Lamassu's DMS Manager service.",{"_2926":1310,"_25561":1210,"_17855":45728,"_5":17750,"_24230":45444,"_2452":45729},[],"`device_manager_client`",{"_2926":1311,"_25561":1210,"_17855":45731,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1312,"_25561":1210,"_17855":45733,"_5":17750,"_24230":45444,"_2452":45630},[],{"_2926":1313,"_25561":1210,"_17855":45735,"_5":17750,"_24230":45444,"_2452":45736},[],"HTTP URL of Lamassu's Device Manager.",{"_2926":1314,"_25561":1210,"_17855":45738,"_5":17750,"_24230":45444,"_2452":45739},[],"`ca_client`",{"_2926":1315,"_25561":1210,"_17855":45741,"_5":17750,"_24230":45444,"_2452":21321},[],{"_2926":1316,"_25561":1210,"_17855":45743,"_5":17750,"_24230":45444,"_2452":45630},[],{"_2926":1317,"_25561":1210,"_17855":45745,"_5":17750,"_24230":45444,"_2452":45746},[],"HTTP URL of Lamassu's CA service.",{"_2926":1318,"_25561":1210,"_17855":45748,"_5":17750,"_24230":45448,"_2452":45749},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_2926":1319,"_25561":1210,"_17855":45751,"_5":17750,"_24230":45452,"_2452":45752},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_2926":1320,"_25561":1210,"_17855":45754,"_5":17750,"_24230":45452,"_2452":45755},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_2926":1321,"_25561":1210,"_17855":45757,"_5":17750,"_24230":45456,"_2452":45758},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_2926":1322,"_25561":1210,"_17855":45760,"_5":17750,"_24230":45456,"_2452":45761},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_2926":1323,"_25561":1210,"_17855":45763,"_5":17750,"_24230":45456,"_2452":45764},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_2926":1324,"_25561":1210,"_17855":45766,"_5":17750,"_24230":45456,"_2452":45767},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_2926":1325,"_25561":1210,"_17855":45769,"_5":17750,"_24230":45456,"_2452":45770},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_2926":1326,"_25561":1210,"_17855":45772,"_5":17750,"_24230":45456,"_2452":45773},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_2926":1327,"_25561":1210,"_17855":45775,"_5":17750,"_24230":45460,"_2452":45776},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_2926":1328,"_25561":1210,"_17855":45778,"_5":17750,"_24230":45464,"_2452":45779},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_2926":1329,"_25561":1210,"_17855":45781,"_5":17750,"_24230":45464,"_2452":45782},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_2926":1330,"_25561":1210,"_17855":45784,"_5":17750,"_24230":45468,"_2452":45785},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_2926":1331,"_25561":1210,"_17855":45787,"_5":17750,"_24230":45472,"_2452":45788},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_2926":1332,"_25561":1210,"_17855":45790,"_5":17750,"_24230":45472,"_2452":45791},[],"Creates or updates the IoT policies configured in the DMS.",{"_2926":1333,"_25561":1210,"_17855":45793,"_5":17750,"_24230":45472,"_2452":45794},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_2926":1334,"_25561":1210,"_17855":45796,"_5":17750,"_24230":45472,"_2452":45797},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_2926":1335,"_25561":1210,"_17855":45799,"_5":17750,"_24230":45472,"_2452":45800},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_2926":1336,"_25561":1210,"_17855":45802,"_5":17750,"_24230":45472,"_2452":45803},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_2926":1337,"_25561":1210,"_17855":45805,"_5":17750,"_24230":45472,"_2452":45806},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_2926":1338,"_25561":1210,"_17855":45808,"_5":17750,"_24230":45476,"_2452":45809},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. This template is created or updated at the moment the DMS is created or updated in Lamassu — not at device enrollment time. From then on, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_2926":1339,"_25561":1210,"_17855":45811,"_5":17750,"_24230":45476,"_2452":45812},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_2926":1340,"_25561":1210,"_17855":45814,"_5":17750,"_24230":45476,"_2452":45815},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_2926":1341,"_25561":1210,"_17855":45817,"_5":17750,"_24230":45480,"_2452":45818},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_2926":1342,"_25561":1210,"_17855":45820,"_5":17750,"_24230":45480,"_2452":45821},[],"The full flow from the device's perspective is:",{"_2926":1343,"_25561":1210,"_17855":45823,"_5":17750,"_24230":45480,"_2452":45824},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_2926":1344,"_25561":1210,"_17855":45826,"_5":17750,"_24230":45484,"_2452":45827},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_2926":1345,"_25561":1210,"_17855":45829,"_5":17750,"_24230":45484,"_2452":45830},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_2926":1346,"_25561":1210,"_17855":45832,"_5":17750,"_24230":45484,"_2452":45833},[],"For the JITP flow to work correctly:",{"_2926":1347,"_25561":1210,"_17855":45835,"_5":17750,"_24230":45484,"_2452":45836},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_2926":1348,"_25561":1210,"_17855":45838,"_5":17750,"_24230":45484,"_2452":45839},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_2926":1349,"_25561":1210,"_17855":45841,"_5":17750,"_24230":45484,"_2452":45842},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_2926":1350,"_25561":1210,"_17855":45844,"_5":17750,"_24230":45484,"_2452":45845},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_2926":1351,"_25561":1210,"_17855":45847,"_5":17750,"_24230":45488,"_2452":45848},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_2926":1352,"_25561":1210,"_17855":45850,"_5":17750,"_24230":45488,"_2452":45851},[],"Status in Lamassu",{"_2926":1353,"_25561":1210,"_17855":45853,"_5":17750,"_24230":45488,"_2452":45854},[],"Revocation reason",{"_2926":1354,"_25561":1210,"_17855":45856,"_5":17750,"_24230":45488,"_2452":45857},[],"Status in AWS IoT Core",{"_2926":1355,"_25561":1210,"_17855":45859,"_5":17750,"_24230":45488,"_2452":45860},[],"`Active`",{"_2926":1356,"_25561":1210,"_17855":45862,"_5":17750,"_24230":45488,"_2452":45863},[],"None",{"_2926":1357,"_25561":1210,"_17855":45865,"_5":17750,"_24230":45488,"_2452":45866},[],"`ACTIVE`",{"_2926":1358,"_25561":1210,"_17855":45868,"_5":17750,"_24230":45488,"_2452":45869},[],"`Revoked`",{"_2926":1359,"_25561":1210,"_17855":45871,"_5":17750,"_24230":45488,"_2452":45872},[],"`certificateHold`",{"_2926":1360,"_25561":1210,"_17855":45874,"_5":17750,"_24230":45488,"_2452":45875},[],"`INACTIVE`",{"_2926":1361,"_25561":1210,"_17855":45877,"_5":17750,"_24230":45488,"_2452":45869},[],{"_2926":1362,"_25561":1210,"_17855":45879,"_5":17750,"_24230":45488,"_2452":45880},[],"Any other reason",{"_2926":1363,"_25561":1210,"_17855":45882,"_5":17750,"_24230":45488,"_2452":45883},[],"`REVOKED`",{"_2926":1364,"_25561":1210,"_17855":45885,"_5":17750,"_24230":45488,"_2452":45886},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_2926":1365,"_25561":1210,"_17855":45888,"_5":17750,"_24230":45492,"_2452":45889},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_2926":1366,"_25561":1210,"_17855":45891,"_5":17750,"_24230":45492,"_2452":45892},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_2926":1367,"_25561":1210,"_17855":45894,"_5":17750,"_24230":45492,"_2452":45895},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_2926":1368,"_25561":1210,"_17855":45897,"_5":17750,"_24230":45496,"_2452":45898},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_2926":1369,"_25561":1210,"_17855":45900,"_5":17750,"_24230":45496,"_2452":45901},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_2926":1370,"_25561":1210,"_17855":45903,"_5":17750,"_24230":45500,"_2452":45904},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_2926":1371,"_25561":1210,"_17855":45906,"_5":17750,"_24230":45500,"_2452":45907},[],"There are two action types:",{"_2926":1372,"_25561":1210,"_17855":45909,"_5":17750,"_24230":45500,"_2452":45910},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_2926":1373,"_25561":1210,"_17855":45912,"_5":17750,"_24230":45500,"_2452":45913},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_2926":1374,"_25561":1210,"_17855":45915,"_5":17750,"_24230":45500,"_2452":45916},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_2926":1375,"_25561":1210,"_17855":45918,"_5":17750,"_24230":45504,"_2452":45919},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_2926":1376,"_25561":1210,"_17855":45921,"_5":17750,"_24230":45504,"_2452":45922},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_2926":1377,"_25561":1210,"_17855":45924,"_5":17750,"_24230":45504,"_2452":45925},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_2926":1378,"_25561":1210,"_17855":45927,"_5":17750,"_24230":45508,"_2452":45928},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_2926":1379,"_25561":1210,"_17855":45930,"_5":17750,"_24230":45508,"_2452":45931},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_2926":1380,"_25561":1210,"_17855":45933,"_5":17750,"_24230":45508,"_2452":45934},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_2926":1381,"_25561":1210,"_17855":45936,"_5":17750,"_24230":45508,"_2452":45937},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_2926":1382,"_25561":1210,"_17855":45939,"_5":17750,"_24230":45508,"_2452":45940},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_2926":1383,"_25561":1210,"_17855":45942,"_5":17750,"_24230":45508,"_2452":45943},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_2926":1384,"_25561":1210,"_17855":45945,"_5":17750,"_24230":45508,"_2452":45946},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_2926":1385,"_25561":1210,"_17855":45948,"_5":17750,"_24230":45508,"_2452":45949},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_2926":1386,"_25561":1210,"_17855":45951,"_5":17750,"_24230":45508,"_2452":45952},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_2926":1387,"_25561":1210,"_17855":45954,"_5":17750,"_24230":45508,"_2452":45955},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_2926":1388,"_25561":1210,"_17855":45957,"_5":17750,"_24230":45508,"_2452":45958},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_2926":1389,"_25561":1210,"_17855":45960,"_5":17750,"_24230":45508,"_2452":45961},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_2926":1390,"_25561":1210,"_17855":45963,"_5":17750,"_24230":45508,"_2452":45964},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_2926":1391,"_25561":1210,"_17855":45966,"_5":17750,"_24230":45508,"_2452":45967},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_2926":1392,"_25561":1210,"_17855":45969,"_5":17750,"_24230":45508,"_2452":45970},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_2926":1393,"_25561":1210,"_17855":45972,"_5":17750,"_24230":45508,"_2452":45973},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_2926":1394,"_25561":1210,"_17855":45975,"_5":17750,"_24230":45508,"_2452":45976},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_2926":1395,"_25561":1210,"_17855":45978,"_5":17750,"_24230":45508,"_2452":45979},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_2926":1396,"_25561":1210,"_17855":45981,"_5":17750,"_24230":45508,"_2452":45982},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":1397,"_25561":1210,"_17855":45984,"_5":17750,"_24230":45508,"_2452":45985},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_2926":1398,"_25561":1210,"_17855":45987,"_5":17750,"_24230":45508,"_2452":45988},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_2926":1399,"_25561":1399,"_5":12525,"_2452":43969,"_25885":45990,"_17855":45991,"_24230":1399},[41651,42995,43969],[],{"_2926":1400,"_25561":1399,"_17855":45993,"_5":17750,"_24230":1399,"_2452":45994},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_2926":1401,"_25561":1399,"_5":25882,"_17855":45996,"_24230":45997,"_2452":45998},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_2926":1402,"_25561":1399,"_5":25882,"_17855":46000,"_24230":46001,"_2452":43967},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_2926":1403,"_25561":1399,"_5":25882,"_17855":46003,"_24230":46004,"_2452":44150},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_2926":1404,"_25561":1399,"_5":25882,"_17855":46006,"_24230":46007,"_2452":45425},[],"/docs/platform/iot-fleets/overview#integrations",{"_2926":1405,"_25561":1399,"_5":25882,"_17855":46009,"_24230":46010,"_2452":46011},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_2926":1406,"_25561":1399,"_17855":46013,"_5":17750,"_24230":1399,"_2452":46014},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_2926":1407,"_25561":1399,"_17855":46016,"_5":17750,"_24230":45997,"_2452":46017},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_2926":1408,"_25561":1399,"_17855":46019,"_5":17750,"_24230":45997,"_2452":46020},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_2926":1409,"_25561":1399,"_17855":46022,"_5":17750,"_24230":46001,"_2452":46023},[],"Resource",{"_2926":1410,"_25561":1399,"_17855":46025,"_5":17750,"_24230":46001,"_2452":46026},[],"What it represents",{"_2926":1411,"_25561":1399,"_17855":46028,"_5":17750,"_24230":46001,"_2452":46029},[],"**Device**",{"_2926":1412,"_25561":1399,"_17855":46031,"_5":17750,"_24230":46001,"_2452":46032},[],"An inventory entry with an identifier, owning DMS and classification.",{"_2926":1413,"_25561":1399,"_17855":46034,"_5":17750,"_24230":46001,"_2452":46035},[],"**Identity**",{"_2926":1414,"_25561":1399,"_17855":46037,"_5":17750,"_24230":46001,"_2452":46038},[],"The device's association with its certificates: an active version and a history.",{"_2926":1415,"_25561":1399,"_17855":46040,"_5":17750,"_24230":46001,"_2452":46041},[],"**DMS**",{"_2926":1416,"_25561":1399,"_17855":46043,"_5":17750,"_24230":46001,"_2452":46044},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_2926":1417,"_25561":1399,"_17855":46046,"_5":17750,"_24230":46001,"_2452":46047},[],"**Fleet**",{"_2926":1418,"_25561":1399,"_17855":46049,"_5":17750,"_24230":46001,"_2452":46050},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_2926":1419,"_25561":1399,"_17855":46052,"_5":17750,"_24230":46001,"_2452":46053},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_2926":1420,"_25561":1399,"_17855":46055,"_5":17750,"_24230":46001,"_2452":46056},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_2926":1421,"_25561":1399,"_17855":46058,"_5":17750,"_24230":46004,"_2452":46059},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_2926":1422,"_25561":1399,"_17855":46061,"_5":17750,"_24230":46004,"_2452":46062},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_2926":1423,"_25561":1399,"_17855":46064,"_5":17750,"_24230":46004,"_2452":46065},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_2926":1424,"_25561":1399,"_17855":46067,"_5":17750,"_24230":46004,"_2452":46068},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_2926":1425,"_25561":1399,"_17855":46070,"_5":17750,"_24230":46004,"_2452":46071},[],"**Result:** request the certificate, install it and check its association with the device.",{"_2926":1426,"_25561":1399,"_17855":46073,"_5":17750,"_24230":46004,"_2452":46074},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_2926":1427,"_25561":1399,"_17855":46076,"_5":17750,"_24230":46004,"_2452":46077},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_2926":1428,"_25561":1399,"_17855":46079,"_5":17750,"_24230":46004,"_2452":46080},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_2926":1429,"_25561":1399,"_17855":46082,"_5":17750,"_24230":46007,"_2452":46083},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_2926":1430,"_25561":1399,"_17855":46085,"_5":17750,"_24230":46007,"_2452":46086},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_2926":1431,"_25561":1399,"_17855":46088,"_5":17750,"_24230":46010,"_2452":46089},[],"Participant",{"_2926":1432,"_25561":1399,"_17855":46091,"_5":17750,"_24230":46010,"_2452":46092},[],"Responsibility",{"_2926":1433,"_25561":1399,"_17855":46094,"_5":17750,"_24230":46010,"_2452":46095},[],"PKI administrator",{"_2926":1434,"_25561":1399,"_17855":46097,"_5":17750,"_24230":46010,"_2452":46098},[],"CA, issuance profile, chain and revocation publication.",{"_2926":1435,"_25561":1399,"_17855":46100,"_5":17750,"_24230":46010,"_2452":46101},[],"Provisioning administrator",{"_2926":1436,"_25561":1399,"_17855":46103,"_5":17750,"_24230":46010,"_2452":46104},[],"DMS, admission, authentication per operation and inventory.",{"_2926":1437,"_25561":1399,"_17855":46106,"_5":17750,"_24230":46010,"_2452":46107},[],"Device integrator",{"_2926":1438,"_25561":1399,"_17855":46109,"_5":17750,"_24230":46010,"_2452":46110},[],"Initial credential, key, EST client, trust and certificate installation.",{"_2926":1439,"_25561":1399,"_17855":46112,"_5":17750,"_24230":46010,"_2452":46113},[],"Consumer integrator",{"_2926":1440,"_25561":1399,"_17855":46115,"_5":17750,"_24230":46010,"_2452":46116},[],"Trusted issuers, validation and device permissions in the destination.",{"_2926":1441,"_25561":1399,"_17855":46118,"_5":17750,"_24230":46010,"_2452":46119},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_2926":1442,"_25561":1442,"_5":12525,"_2452":46121,"_25885":46122,"_17855":46124,"_24230":1442},"Enroll and connect your first device",[41651,42995,43969,46123],"Getting started",[],{"_2926":1443,"_25561":1442,"_17855":46126,"_5":17750,"_24230":1442,"_2452":46127},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_2926":1444,"_25561":1442,"_5":25882,"_17855":46129,"_24230":46130,"_2452":41661},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_2926":1445,"_25561":1442,"_5":25882,"_17855":46132,"_24230":46133,"_2452":46134},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_2926":1446,"_25561":1442,"_5":25882,"_17855":46136,"_24230":46137,"_2452":46138},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_2926":1447,"_25561":1442,"_5":25882,"_17855":46140,"_24230":46141,"_2452":46142},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_2926":1448,"_25561":1442,"_5":25882,"_17855":46144,"_24230":46145,"_2452":46146},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_2926":1449,"_25561":1442,"_5":25882,"_17855":46148,"_24230":46149,"_2452":46150},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_2926":1450,"_25561":1442,"_5":25882,"_17855":46152,"_24230":46153,"_2452":46154},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_2926":1451,"_25561":1442,"_5":25882,"_17855":46156,"_24230":46157,"_2452":46158},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_2926":1452,"_25561":1442,"_17855":46160,"_5":17750,"_24230":1442,"_2452":46161},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_2926":1453,"_25561":1442,"_17855":46163,"_5":17750,"_24230":46130,"_2452":46164},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_2926":1454,"_25561":1442,"_17855":46166,"_5":17750,"_24230":46130,"_2452":46167},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_2926":1455,"_25561":1442,"_17855":46169,"_5":17750,"_24230":46130,"_2452":46170},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_2926":1456,"_25561":1442,"_17855":46172,"_5":17750,"_24230":46130,"_2452":46173},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_2926":1457,"_25561":1442,"_17855":46175,"_5":17750,"_24230":46130,"_2452":46176},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_2926":1458,"_25561":1442,"_17855":46178,"_5":17750,"_24230":46133,"_2452":46179},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_2926":1459,"_25561":1442,"_17855":46181,"_5":17750,"_24230":46133,"_2452":46182},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_2926":1460,"_25561":1442,"_17855":46184,"_5":17750,"_24230":46137,"_2452":46185},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_2926":1461,"_25561":1442,"_17855":46187,"_5":17750,"_24230":46137,"_2452":46188},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_2926":1462,"_25561":1442,"_17855":46190,"_5":17750,"_24230":46137,"_2452":46191},[],"Setting",{"_2926":1463,"_25561":1442,"_17855":46193,"_5":17750,"_24230":46137,"_2452":46194},[],"Evaluation value",{"_2926":1464,"_25561":1442,"_17855":46196,"_5":17750,"_24230":46137,"_2452":46197},[],"Enrollment CA",{"_2926":1465,"_25561":1442,"_17855":46199,"_5":17750,"_24230":46137,"_2452":46200},[],"Issuing root from `device-root.pem`.",{"_2926":1466,"_25561":1442,"_17855":46202,"_5":17750,"_24230":46137,"_2452":44280},[],{"_2926":1467,"_25561":1442,"_17855":46204,"_5":17750,"_24230":46137,"_2452":46205},[],"The 1-hour leaf profile you just prepared.",{"_2926":1468,"_25561":1442,"_17855":46207,"_5":17750,"_24230":46137,"_2452":46208},[],"Protocol / Registration Mode",{"_2926":1469,"_25561":1442,"_17855":46210,"_5":17750,"_24230":46137,"_2452":46211},[],"`EST_RFC7030` / `JITP`.",{"_2926":1470,"_25561":1442,"_17855":46213,"_5":17750,"_24230":46137,"_2452":46214},[],"Verify CSR Signature",{"_2926":1471,"_25561":1442,"_17855":46216,"_5":17750,"_24230":46137,"_2452":46217},[],"Enabled.",{"_2926":1472,"_25561":1442,"_17855":46219,"_5":17750,"_24230":46137,"_2452":46220},[],"Enable Replaceable Enrollment",{"_2926":1473,"_25561":1442,"_17855":46222,"_5":17750,"_24230":46137,"_2452":46223},[],"Disabled; the ID must be new.",{"_2926":1474,"_25561":1442,"_17855":46225,"_5":17750,"_24230":46137,"_2452":46226},[],"Initial authentication",{"_2926":1475,"_25561":1442,"_17855":46228,"_5":17750,"_24230":46137,"_2452":46229},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_2926":1476,"_25561":1442,"_17855":46231,"_5":17750,"_24230":46137,"_2452":46232},[],"Renewal authentication",{"_2926":1477,"_25561":1442,"_17855":46234,"_5":17750,"_24230":46137,"_2452":46235},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_2926":1478,"_25561":1442,"_17855":46237,"_5":17750,"_24230":46137,"_2452":46238},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_2926":1479,"_25561":1442,"_17855":46240,"_5":17750,"_24230":46137,"_2452":46241},[],"Empty list for this direct issuance / disabled.",{"_2926":1480,"_25561":1442,"_17855":46243,"_5":17750,"_24230":46137,"_2452":46244},[],"Re-enrollment Delta",{"_2926":1481,"_25561":1442,"_17855":46246,"_5":17750,"_24230":46137,"_2452":46247},[],"1 hour.",{"_2926":1482,"_25561":1442,"_17855":46249,"_5":17750,"_24230":46137,"_2452":46250},[],"Preventive / Critical Delta",{"_2926":1483,"_25561":1442,"_17855":46252,"_5":17750,"_24230":46137,"_2452":46253},[],"30 minutes / 10 minutes.",{"_2926":1484,"_25561":1442,"_17855":46255,"_5":17750,"_24230":46137,"_2452":46256},[],"Revoke on Re-enrollment",{"_2926":1485,"_25561":1442,"_17855":46258,"_5":17750,"_24230":46137,"_2452":46259},[],"Disabled to test the successor before retiring the previous identity.",{"_2926":1486,"_25561":1442,"_17855":46261,"_5":17750,"_24230":46137,"_2452":44288},[],{"_2926":1487,"_25561":1442,"_17855":46263,"_5":17750,"_24230":46137,"_2452":46264},[],"Disabled; the operational key is generated in the client.",{"_2926":1488,"_25561":1442,"_17855":46266,"_5":17750,"_24230":46137,"_2452":46267},[],"CA Distribution",{"_2926":1489,"_25561":1442,"_17855":46269,"_5":17750,"_24230":46137,"_2452":46270},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_2926":1490,"_25561":1442,"_17855":46272,"_5":17750,"_24230":46137,"_2452":46273},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. If your console does not expose the independent block, configure and check the resource through the DMS API and DMS guide.",{"_2926":1491,"_25561":1442,"_17855":46275,"_5":17750,"_24230":46141,"_2452":46276},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_2926":1492,"_25561":1442,"_17855":46278,"_5":17750,"_24230":46141,"_2452":46279},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_2926":1493,"_25561":1442,"_17855":46281,"_5":17750,"_24230":46145,"_2452":46282},[],"Generate a new key and CSR with the selected identifier:",{"_2926":1494,"_25561":1442,"_17855":46284,"_5":17750,"_24230":46145,"_2452":46285},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_2926":1495,"_25561":1442,"_17855":46287,"_5":17750,"_24230":46145,"_2452":46288},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_2926":1496,"_25561":1442,"_17855":46290,"_5":17750,"_24230":46149,"_2452":46291},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_2926":1497,"_25561":1442,"_17855":46293,"_5":17750,"_24230":46149,"_2452":46294},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_2926":1498,"_25561":1442,"_17855":46296,"_5":17750,"_24230":46153,"_2452":46297},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_2926":1499,"_25561":1442,"_17855":46299,"_5":17750,"_24230":46153,"_2452":46300},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_2926":1500,"_25561":1442,"_17855":46302,"_5":17750,"_24230":46153,"_2452":46303},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_2926":1501,"_25561":1442,"_17855":46305,"_5":17750,"_24230":46153,"_2452":46306},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_2926":1502,"_25561":1442,"_17855":46308,"_5":17750,"_24230":46153,"_2452":46309},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_2926":1503,"_25561":1442,"_17855":46311,"_5":17750,"_24230":46157,"_2452":46312},[],"Check",{"_2926":1504,"_25561":1442,"_17855":46314,"_5":17750,"_24230":46157,"_2452":46315},[],"Expected result",{"_2926":1505,"_25561":1442,"_17855":46317,"_5":17750,"_24230":46157,"_2452":46318},[],"Registration",{"_2926":1506,"_25561":1442,"_17855":46320,"_5":17750,"_24230":46157,"_2452":46321},[],"ID created automatically and correct DMS.",{"_2926":1507,"_25561":1442,"_17855":46323,"_5":17750,"_24230":46157,"_2452":46324},[],"Certificate",{"_2926":1508,"_25561":1442,"_17855":46326,"_5":17750,"_24230":46157,"_2452":46327},[],"CN, profile, serial and key verified.",{"_2926":1509,"_25561":1442,"_17855":46329,"_5":17750,"_24230":46157,"_2452":46330},[],"Inventory",{"_2926":1510,"_25561":1442,"_17855":46332,"_5":17750,"_24230":46157,"_2452":46333},[],"Received serial visible as the current identity and in history.",{"_2926":1511,"_25561":1442,"_17855":46335,"_5":17750,"_24230":46157,"_2452":46336},[],"Consumer",{"_2926":1512,"_25561":1442,"_17855":46338,"_5":17750,"_24230":46157,"_2452":46339},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_2926":1513,"_25561":1442,"_17855":46341,"_5":17750,"_24230":46157,"_2452":46342},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_2926":1514,"_25561":1442,"_17855":46344,"_5":17750,"_24230":46157,"_2452":46345},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_2926":1515,"_25561":1515,"_5":12525,"_2452":43985,"_25885":46347,"_17855":46348,"_24230":1515},[41651,42995,43969,46123],[],{"_2926":1516,"_25561":1515,"_17855":46350,"_5":17750,"_24230":1515,"_2452":46351},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_2926":1517,"_25561":1515,"_5":25882,"_17855":46353,"_24230":46354,"_2452":41661},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_2926":1518,"_25561":1515,"_5":25882,"_17855":46356,"_24230":46357,"_2452":46358},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_2926":1519,"_25561":1515,"_5":25882,"_17855":46360,"_24230":46361,"_2452":46362},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_2926":1520,"_25561":1515,"_5":25882,"_17855":46364,"_24230":46365,"_2452":46366},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_2926":1521,"_25561":1515,"_5":25882,"_17855":46368,"_24230":46369,"_2452":46370},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_2926":1522,"_25561":1515,"_5":25882,"_17855":46372,"_24230":46373,"_2452":46374},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_2926":1523,"_25561":1515,"_5":25882,"_17855":46376,"_24230":46377,"_2452":46315},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_2926":1524,"_25561":1515,"_5":25882,"_17855":46379,"_24230":46380,"_2452":46381},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_2926":1525,"_25561":1515,"_5":25882,"_17855":46383,"_24230":46384,"_2452":46385},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_2926":1526,"_25561":1515,"_17855":46387,"_5":17750,"_24230":1515,"_2452":46388},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_2926":1527,"_25561":1515,"_17855":46390,"_5":17750,"_24230":1515,"_2452":46391},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_2926":1528,"_25561":1515,"_17855":46393,"_5":17750,"_24230":46354,"_2452":46394},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_2926":1529,"_25561":1515,"_17855":46396,"_5":17750,"_24230":46354,"_2452":46397},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_2926":1530,"_25561":1515,"_17855":46399,"_5":17750,"_24230":46354,"_2452":46400},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_2926":1531,"_25561":1515,"_17855":46402,"_5":17750,"_24230":46354,"_2452":46403},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_2926":1532,"_25561":1515,"_17855":46405,"_5":17750,"_24230":46357,"_2452":46406},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_2926":1533,"_25561":1515,"_17855":46408,"_5":17750,"_24230":46357,"_2452":46409},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_2926":1534,"_25561":1515,"_17855":46411,"_5":17750,"_24230":46357,"_2452":46412},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_2926":1535,"_25561":1515,"_17855":46414,"_5":17750,"_24230":46357,"_2452":46415},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_2926":1536,"_25561":1515,"_17855":46417,"_5":17750,"_24230":46357,"_2452":46418},[],"Set **Authentication Mode** to `CLIENT_CERTIFICATE` and add the CA whose initial certificates you will accept in **Validation CAs**. For this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and server key generation disabled if you will not use it.",{"_2926":1537,"_25561":1515,"_17855":46420,"_5":17750,"_24230":46357,"_2452":46421},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_2926":1538,"_25561":1515,"_17855":46423,"_5":17750,"_24230":46357,"_2452":46424},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_2926":1539,"_25561":1515,"_17855":46426,"_5":17750,"_24230":46357,"_2452":46427},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_2926":1540,"_25561":1515,"_17855":46429,"_5":17750,"_24230":46361,"_2452":46430},[],"Open **Managed Devices** and the registration action. Complete:",{"_2926":1541,"_25561":1515,"_17855":46432,"_5":17750,"_24230":46361,"_2452":46433},[],"**Device ID**: `device-001`.",{"_2926":1542,"_25561":1515,"_17855":46435,"_5":17750,"_24230":46361,"_2452":46436},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_2926":1543,"_25561":1515,"_17855":46438,"_5":17750,"_24230":46361,"_2452":46439},[],"**Icon** and **Tags**: optional classification.",{"_2926":1544,"_25561":1515,"_17855":46441,"_5":17750,"_24230":46361,"_2452":46442},[],"Confirm registration.",{"_2926":1545,"_25561":1515,"_17855":46444,"_5":17750,"_24230":46365,"_2452":46445},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_2926":1546,"_25561":1515,"_17855":46447,"_5":17750,"_24230":46365,"_2452":46448},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_2926":1547,"_25561":1515,"_17855":46450,"_5":17750,"_24230":46369,"_2452":46451},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_2926":1548,"_25561":1515,"_17855":46453,"_5":17750,"_24230":46369,"_2452":46454},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_2926":1549,"_25561":1515,"_17855":46456,"_5":17750,"_24230":46373,"_2452":46457},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_2926":1550,"_25561":1515,"_17855":46459,"_5":17750,"_24230":46373,"_2452":46460},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_2926":1551,"_25561":1515,"_17855":46462,"_5":17750,"_24230":46377,"_2452":46312},[],{"_2926":1552,"_25561":1515,"_17855":46464,"_5":17750,"_24230":46377,"_2452":46465},[],"Result",{"_2926":1553,"_25561":1515,"_17855":46467,"_5":17750,"_24230":46377,"_2452":46468},[],"Device",{"_2926":1554,"_25561":1515,"_17855":46470,"_5":17750,"_24230":46377,"_2452":46471},[],"`device-001` appears in inventory with the expected DMS.",{"_2926":1555,"_25561":1515,"_17855":46473,"_5":17750,"_24230":46377,"_2452":46474},[],"Current identity",{"_2926":1556,"_25561":1515,"_17855":46476,"_5":17750,"_24230":46377,"_2452":46477},[],"The associated certificate matches the one you verified in PKI.",{"_2926":1557,"_25561":1515,"_17855":46479,"_5":17750,"_24230":46377,"_2452":46480},[],"History",{"_2926":1558,"_25561":1515,"_17855":46482,"_5":17750,"_24230":46377,"_2452":46483},[],"The associated issuance appears with its serial number and dates.",{"_2926":1559,"_25561":1515,"_17855":46485,"_5":17750,"_24230":46377,"_2452":46486},[],"Key and certificate",{"_2926":1560,"_25561":1515,"_17855":46488,"_5":17750,"_24230":46377,"_2452":46489},[],"You have the verified pair ready to install on the device.",{"_2926":1561,"_25561":1515,"_17855":46491,"_5":17750,"_24230":46380,"_2452":46492},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_2926":1562,"_25561":1515,"_17855":46494,"_5":17750,"_24230":46380,"_2452":46495},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_2926":1563,"_25561":1515,"_17855":46497,"_5":17750,"_24230":46380,"_2452":46498},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_2926":1564,"_25561":1515,"_17855":46500,"_5":17750,"_24230":46380,"_2452":46501},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_2926":1565,"_25561":1515,"_17855":46503,"_5":17750,"_24230":46384,"_2452":46504},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_2926":1566,"_25561":1515,"_17855":46506,"_5":17750,"_24230":46384,"_2452":46507},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_2926":1567,"_25561":1515,"_17855":46509,"_5":17750,"_24230":46384,"_2452":46510},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_2926":1568,"_25561":1568,"_5":12525,"_2452":46512,"_25885":46513,"_17855":46514,"_24230":1568},"Lamassu IoT Platform",[41651,42995],[],{"_2926":1569,"_25561":1568,"_17855":46516,"_5":17750,"_24230":1568,"_2452":46517},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_2926":1570,"_25561":1568,"_5":25882,"_17855":46519,"_24230":46520,"_2452":45998},[],"/docs/platform/overview#start-here",{"_2926":1571,"_25561":1568,"_5":25882,"_17855":46522,"_24230":46523,"_2452":46524},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_2926":1572,"_25561":1568,"_5":25882,"_17855":46526,"_24230":46527,"_2452":46528},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_2926":1573,"_25561":1568,"_5":25882,"_17855":46530,"_24230":46531,"_2452":46532},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_2926":1574,"_25561":1568,"_5":25882,"_17855":46534,"_24230":46535,"_2452":46536},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_2926":1575,"_25561":1568,"_5":25882,"_17855":46538,"_24230":46539,"_2452":46540},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_2926":1576,"_25561":1568,"_5":25882,"_17855":46542,"_24230":46543,"_2452":46544},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_2926":1577,"_25561":1568,"_5":25882,"_17855":46546,"_24230":46547,"_2452":46548},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_2926":1578,"_25561":1568,"_5":25882,"_17855":46550,"_24230":46551,"_2452":46552},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_2926":1579,"_25561":1568,"_5":25882,"_17855":46554,"_24230":46555,"_2452":46556},[],"/docs/platform/overview#react-to-events","React to events",{"_2926":1580,"_25561":1568,"_5":25882,"_17855":46558,"_24230":46559,"_2452":46560},[],"/docs/platform/overview#operational-reference","Operational reference",{"_2926":1581,"_25561":1568,"_17855":46562,"_5":17750,"_24230":1568,"_2452":46563},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_2926":1582,"_25561":1568,"_17855":46565,"_5":17750,"_24230":46520,"_2452":46566},[],"Choose the result you need:",{"_2926":1583,"_25561":1568,"_17855":46568,"_5":17750,"_24230":46520,"_2452":46569},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2926":1584,"_25561":1568,"_17855":46571,"_5":17750,"_24230":46520,"_2452":46572},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_2926":1585,"_25561":1568,"_17855":46574,"_5":17750,"_24230":46520,"_2452":46575},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_2926":1586,"_25561":1568,"_17855":46577,"_5":17750,"_24230":46523,"_2452":46578},[],"Section",{"_2926":1587,"_25561":1568,"_17855":46580,"_5":17750,"_24230":46523,"_2452":46581},[],"What you manage",{"_2926":1588,"_25561":1568,"_17855":46583,"_5":17750,"_24230":46523,"_2452":46584},[],"Entry point",{"_2926":1589,"_25561":1568,"_17855":46586,"_5":17750,"_24230":46523,"_2452":46587},[],"**PKI**",{"_2926":1590,"_25561":1568,"_17855":46589,"_5":17750,"_24230":46523,"_2452":46590},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_2926":1591,"_25561":1568,"_17855":46592,"_5":17750,"_24230":46523,"_2452":46593},[],"PKI overview",{"_2926":1592,"_25561":1568,"_17855":46595,"_5":17750,"_24230":46523,"_2452":46596},[],"**IoT Fleets**",{"_2926":1593,"_25561":1568,"_17855":46598,"_5":17750,"_24230":46523,"_2452":46599},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_2926":1594,"_25561":1568,"_17855":46601,"_5":17750,"_24230":46523,"_2452":46602},[],"IoT Fleets overview",{"_2926":1595,"_25561":1568,"_17855":46604,"_5":17750,"_24230":46523,"_2452":46605},[],"**Administration**",{"_2926":1596,"_25561":1568,"_17855":46607,"_5":17750,"_24230":46523,"_2452":46608},[],"Operator permissions, audit and event subscriptions.",{"_2926":1597,"_25561":1568,"_17855":46610,"_5":17750,"_24230":46523,"_2452":42993},[],{"_2926":1598,"_25561":1568,"_17855":46612,"_5":17750,"_24230":46523,"_2452":46613},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_2926":1599,"_25561":1568,"_17855":46615,"_5":17750,"_24230":46527,"_2452":46616},[],"An identity's journey connects four responsibilities:",{"_2926":1600,"_25561":1568,"_17855":46618,"_5":17750,"_24230":46527,"_2452":46619},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_2926":1601,"_25561":1568,"_17855":46621,"_5":17750,"_24230":46527,"_2452":46622},[],"The provisioning administrator configures the DMS and initial trust.",{"_2926":1602,"_25561":1568,"_17855":46624,"_5":17750,"_24230":46527,"_2452":46625},[],"The device client requests a certificate and installs it with the matching key.",{"_2926":1603,"_25561":1568,"_17855":46627,"_5":17750,"_24230":46527,"_2452":46628},[],"The consumer validates the identity and applies its access permissions.",{"_2926":1604,"_25561":1568,"_17855":46630,"_5":17750,"_24230":46527,"_2452":46631},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_2926":1605,"_25561":1568,"_17855":46633,"_5":17750,"_24230":46535,"_2452":46634},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_2926":1606,"_25561":1568,"_17855":46636,"_5":17750,"_24230":46539,"_2452":46637},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_2926":1607,"_25561":1568,"_17855":46639,"_5":17750,"_24230":46543,"_2452":46640},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_2926":1608,"_25561":1568,"_17855":46642,"_5":17750,"_24230":46547,"_2452":46643},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_2926":1609,"_25561":1568,"_17855":46645,"_5":17750,"_24230":46551,"_2452":46646},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_2926":1610,"_25561":1568,"_17855":46648,"_5":17750,"_24230":46555,"_2452":46649},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_2926":1611,"_25561":1568,"_17855":46651,"_5":17750,"_24230":46559,"_2452":46092},[],{"_2926":1612,"_25561":1568,"_17855":46653,"_5":17750,"_24230":46559,"_2452":46654},[],"What it prepares or checks",{"_2926":1613,"_25561":1568,"_17855":46656,"_5":17750,"_24230":46559,"_2452":46095},[],{"_2926":1614,"_25561":1568,"_17855":46658,"_5":17750,"_24230":46559,"_2452":46659},[],"Key custody, CA hierarchy, profiles and validation.",{"_2926":1615,"_25561":1568,"_17855":46661,"_5":17750,"_24230":46559,"_2452":46662},[],"Fleet administrator",{"_2926":1616,"_25561":1568,"_17855":46664,"_5":17750,"_24230":46559,"_2452":46665},[],"DMS, device admission, renewal policy and inventory.",{"_2926":1617,"_25561":1568,"_17855":46667,"_5":17750,"_24230":46559,"_2452":46107},[],{"_2926":1618,"_25561":1568,"_17855":46669,"_5":17750,"_24230":46559,"_2452":46670},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_2926":1619,"_25561":1568,"_17855":46672,"_5":17750,"_24230":46559,"_2452":46113},[],{"_2926":1620,"_25561":1568,"_17855":46674,"_5":17750,"_24230":46559,"_2452":46675},[],"Issuer trust, certificate validation and permissions in the destination.",{"_2926":1621,"_25561":1568,"_17855":46677,"_5":17750,"_24230":46559,"_2452":46678},[],"Infrastructure operator",{"_2926":1622,"_25561":1568,"_17855":46680,"_5":17750,"_24230":46559,"_2452":46681},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_2926":1623,"_25561":1568,"_17855":46683,"_5":17750,"_24230":46559,"_2452":46684},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_2926":1624,"_25561":1624,"_5":12525,"_2452":46686,"_25885":46687,"_17855":46690,"_24230":1624},"CA hierarchy and rotation",[41651,42995,46688,46689],"PKI","Keys, authorities and certificates",[],{"_2926":1625,"_25561":1624,"_17855":46692,"_5":17750,"_24230":1624,"_2452":46693},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_2926":1626,"_25561":1624,"_5":25882,"_17855":46695,"_24230":46696,"_2452":46697},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_2926":1627,"_25561":1624,"_5":25882,"_17855":46699,"_24230":46700,"_2452":46701},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_2926":1628,"_25561":1624,"_5":25882,"_17855":46703,"_24230":46704,"_2452":46705},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_2926":1629,"_25561":1624,"_5":25882,"_17855":46707,"_24230":46708,"_2452":46709},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_2926":1630,"_25561":1624,"_5":25882,"_17855":46711,"_24230":46712,"_2452":46713},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_2926":1631,"_25561":1624,"_5":25882,"_17855":46715,"_24230":46716,"_2452":46717},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_2926":1632,"_25561":1624,"_5":25882,"_17855":46719,"_24230":46720,"_2452":46721},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_2926":1633,"_25561":1624,"_5":25882,"_17855":46723,"_24230":46724,"_2452":46725},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_2926":1634,"_25561":1624,"_5":25882,"_17855":46727,"_24230":46728,"_2452":46729},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_2926":1635,"_25561":1624,"_5":25882,"_17855":46731,"_24230":46732,"_2452":46733},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_2926":1636,"_25561":1624,"_5":25882,"_17855":46735,"_24230":46736,"_2452":46737},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_2926":1637,"_25561":1624,"_5":25882,"_17855":46739,"_24230":46740,"_2452":46741},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_2926":1638,"_25561":1624,"_17855":46743,"_5":17750,"_24230":1624,"_2452":46744},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_2926":1639,"_25561":1624,"_17855":46746,"_5":17750,"_24230":1624,"_2452":46747},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_2926":1640,"_25561":1624,"_17855":46749,"_5":17750,"_24230":46696,"_2452":46750},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_2926":1641,"_25561":1624,"_17855":46752,"_5":17750,"_24230":46696,"_2452":46753},[],"environment, such as production and preproduction;",{"_2926":1642,"_25561":1624,"_17855":46755,"_5":17750,"_24230":46696,"_2452":46756},[],"owner or operating team;",{"_2926":1643,"_25561":1624,"_17855":46758,"_5":17750,"_24230":46696,"_2452":46759},[],"device family or manufacturing process;",{"_2926":1644,"_25561":1624,"_17855":46761,"_5":17750,"_24230":46696,"_2452":46762},[],"region or regulatory requirement;",{"_2926":1645,"_25561":1624,"_17855":46764,"_5":17750,"_24230":46696,"_2452":46765},[],"cryptographic engine or key policy;",{"_2926":1646,"_25561":1624,"_17855":46767,"_5":17750,"_24230":46696,"_2452":46768},[],"maintenance window and renewal cadence.",{"_2926":1647,"_25561":1624,"_17855":46770,"_5":17750,"_24230":46696,"_2452":46771},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_2926":1648,"_25561":1624,"_17855":46773,"_5":17750,"_24230":46696,"_2452":46774},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_2926":1649,"_25561":1624,"_17855":46776,"_5":17750,"_24230":46700,"_2452":46777},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_2926":1650,"_25561":1624,"_17855":46779,"_5":17750,"_24230":46700,"_2452":46780},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_2926":1651,"_25561":1624,"_17855":46782,"_5":17750,"_24230":46700,"_2452":46783},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_2926":1652,"_25561":1624,"_17855":46785,"_5":17750,"_24230":46704,"_2452":46786},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_2926":1653,"_25561":1624,"_17855":46788,"_5":17750,"_24230":46704,"_2452":46789},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_2926":1654,"_25561":1624,"_17855":46791,"_5":17750,"_24230":46704,"_2452":46792},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_2926":1655,"_25561":1624,"_17855":46794,"_5":17750,"_24230":46704,"_2452":46795},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_2926":1656,"_25561":1624,"_17855":46797,"_5":17750,"_24230":46712,"_2452":46798},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_2926":1657,"_25561":1624,"_17855":46800,"_5":17750,"_24230":46716,"_2452":46801},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_2926":1658,"_25561":1624,"_17855":46803,"_5":17750,"_24230":46720,"_2452":46804},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_2926":1659,"_25561":1624,"_17855":46806,"_5":17750,"_24230":46724,"_2452":46807},[],"Update the enrollment CA and profile of the DMSs, and add the old CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) while old-CA cohorts still renew. The DMS guide documents the setting.",{"_2926":1660,"_25561":1624,"_17855":46809,"_5":17750,"_24230":46728,"_2452":46810},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_2926":1661,"_25561":1624,"_17855":46812,"_5":17750,"_24230":46732,"_2452":46813},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance and from the distributed CAs. Revoke it if policy requires it.",{"_2926":1662,"_25561":1624,"_17855":46815,"_5":17750,"_24230":46736,"_2452":46816},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_2926":1663,"_25561":1624,"_17855":46818,"_5":17750,"_24230":46736,"_2452":46819},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_2926":1664,"_25561":1624,"_17855":46821,"_5":17750,"_24230":46736,"_2452":46822},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_2926":1665,"_25561":1624,"_17855":46824,"_5":17750,"_24230":46736,"_2452":46825},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_2926":1666,"_25561":1624,"_17855":46827,"_5":17750,"_24230":46740,"_2452":46828},[],"The new chain ends in an anchor installed by the consumer.",{"_2926":1667,"_25561":1624,"_17855":46830,"_5":17750,"_24230":46740,"_2452":46831},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_2926":1668,"_25561":1624,"_17855":46833,"_5":17750,"_24230":46740,"_2452":46834},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_2926":1669,"_25561":1624,"_17855":46836,"_5":17750,"_24230":46740,"_2452":46837},[],"Re-enrollment accepts the old identity during the planned period.",{"_2926":1670,"_25561":1624,"_17855":46839,"_5":17750,"_24230":46740,"_2452":46840},[],"OCSP and CRL respond for the authorities that remain active.",{"_2926":1671,"_25561":1624,"_17855":46842,"_5":17750,"_24230":46740,"_2452":46843},[],"No DMS is left accidentally issuing from the old CA.",{"_2926":1672,"_25561":1624,"_17855":46845,"_5":17750,"_24230":46740,"_2452":46846},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_2926":1673,"_25561":1673,"_5":12525,"_2452":46848,"_25885":46849,"_17855":46850,"_24230":1673},"Certification authorities",[41651,42995,46688,46689],[],{"_2926":1674,"_25561":1673,"_17855":46852,"_5":17750,"_24230":1673,"_2452":46853},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_2926":1675,"_25561":1673,"_5":25882,"_17855":46855,"_24230":46856,"_2452":46857},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_2926":1676,"_25561":1673,"_5":25882,"_17855":46859,"_24230":46860,"_2452":46861},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_2926":1677,"_25561":1673,"_5":25882,"_17855":46863,"_24230":46864,"_2452":41661},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_2926":1678,"_25561":1673,"_5":25882,"_17855":46866,"_24230":46867,"_2452":46868},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_2926":1679,"_25561":1673,"_5":25882,"_17855":46870,"_24230":46871,"_2452":46872},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_2926":1680,"_25561":1673,"_5":25882,"_17855":46874,"_24230":46875,"_2452":46876},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_2926":1681,"_25561":1673,"_5":25882,"_17855":46878,"_24230":46879,"_2452":46880},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_2926":1682,"_25561":1673,"_5":25882,"_17855":46882,"_24230":46883,"_2452":46884},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_2926":1683,"_25561":1673,"_5":25882,"_17855":46886,"_24230":46887,"_2452":46888},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_2926":1684,"_25561":1673,"_5":25882,"_17855":46890,"_24230":46891,"_2452":46892},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_2926":1685,"_25561":1673,"_5":25882,"_17855":46894,"_24230":46895,"_2452":46896},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_2926":1686,"_25561":1673,"_5":25882,"_17855":46898,"_24230":46899,"_2452":46900},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_2926":1687,"_25561":1673,"_5":25882,"_17855":46902,"_24230":46903,"_2452":46904},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_2926":1688,"_25561":1673,"_5":25882,"_17855":46906,"_24230":46907,"_2452":46908},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_2926":1689,"_25561":1673,"_5":25882,"_17855":46910,"_24230":46911,"_2452":46912},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_2926":1690,"_25561":1673,"_5":25882,"_17855":46914,"_24230":46915,"_2452":46916},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_2926":1691,"_25561":1673,"_5":25882,"_17855":46918,"_24230":46919,"_2452":46920},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_2926":1692,"_25561":1673,"_5":25882,"_17855":46922,"_24230":46923,"_2452":46924},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_2926":1693,"_25561":1673,"_5":25882,"_17855":46926,"_24230":46927,"_2452":46928},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_2926":1694,"_25561":1673,"_5":25882,"_17855":46930,"_24230":46931,"_2452":46932},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_2926":1695,"_25561":1673,"_5":25882,"_17855":46934,"_24230":46935,"_2452":46936},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_2926":1696,"_25561":1673,"_5":25882,"_17855":46938,"_24230":46939,"_2452":46940},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_2926":1697,"_25561":1673,"_17855":46942,"_5":17750,"_24230":1673,"_2452":46943},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_2926":1698,"_25561":1673,"_17855":46945,"_5":17750,"_24230":1673,"_2452":46946},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_2926":1699,"_25561":1673,"_17855":46948,"_5":17750,"_24230":1673,"_2452":46949},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_2926":1700,"_25561":1673,"_17855":46951,"_5":17750,"_24230":46856,"_2452":46952},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_2926":1701,"_25561":1673,"_17855":46954,"_5":17750,"_24230":46856,"_2452":46955},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_2926":1702,"_25561":1673,"_17855":46957,"_5":17750,"_24230":46856,"_2452":46958},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_2926":1703,"_25561":1673,"_17855":46960,"_5":17750,"_24230":46856,"_2452":46961},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_2926":1704,"_25561":1673,"_17855":46963,"_5":17750,"_24230":46856,"_2452":46964},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_2926":1705,"_25561":1673,"_17855":46966,"_5":17750,"_24230":46864,"_2452":46967},[],"Decide whether the CA will be a root or an intermediate.",{"_2926":1706,"_25561":1673,"_17855":46969,"_5":17750,"_24230":46864,"_2452":46970},[],"Choose the engine that will keep the key.",{"_2926":1707,"_25561":1673,"_17855":46972,"_5":17750,"_24230":46864,"_2452":46973},[],"Define a validity longer than that of the certificates it will issue.",{"_2926":1708,"_25561":1673,"_17855":46975,"_5":17750,"_24230":46864,"_2452":46976},[],"For an intermediate CA, make sure the parent CA is active.",{"_2926":1709,"_25561":1673,"_17855":46978,"_5":17750,"_24230":46867,"_2452":46979},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_2926":1710,"_25561":1673,"_17855":46981,"_5":17750,"_24230":46871,"_2452":46982},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_2926":1711,"_25561":1673,"_17855":46984,"_5":17750,"_24230":46871,"_2452":46985},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_2926":1712,"_25561":1673,"_17855":46987,"_5":17750,"_24230":46875,"_2452":46988},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_2926":1713,"_25561":1673,"_17855":46990,"_5":17750,"_24230":46879,"_2452":46991},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_2926":1714,"_25561":1673,"_17855":46993,"_5":17750,"_24230":46879,"_2452":46994},[],"`C`: two-letter ISO 3166-1 country code.",{"_2926":1715,"_25561":1673,"_17855":46996,"_5":17750,"_24230":46879,"_2452":46997},[],"`ST`: state or province.",{"_2926":1716,"_25561":1673,"_17855":46999,"_5":17750,"_24230":46879,"_2452":47000},[],"`L`: locality.",{"_2926":1717,"_25561":1673,"_17855":47002,"_5":17750,"_24230":46879,"_2452":47003},[],"`O`: organization.",{"_2926":1718,"_25561":1673,"_17855":47005,"_5":17750,"_24230":46879,"_2452":47006},[],"`OU`: organizational unit.",{"_2926":1719,"_25561":1673,"_17855":47008,"_5":17750,"_24230":46879,"_2452":47009},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_2926":1720,"_25561":1673,"_17855":47011,"_5":17750,"_24230":46883,"_2452":47012},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_2926":1721,"_25561":1673,"_17855":47014,"_5":17750,"_24230":46883,"_2452":47015},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_2926":1722,"_25561":1673,"_17855":47017,"_5":17750,"_24230":46887,"_2452":47018},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_2926":1723,"_25561":1673,"_17855":47020,"_5":17750,"_24230":46887,"_2452":47021},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_2926":1724,"_25561":1673,"_17855":47023,"_5":17750,"_24230":46891,"_2452":47024},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_2926":1725,"_25561":1673,"_17855":47026,"_5":17750,"_24230":46891,"_2452":47027},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_2926":1726,"_25561":1673,"_17855":47029,"_5":17750,"_24230":46895,"_2452":47030},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_2926":1727,"_25561":1673,"_17855":47032,"_5":17750,"_24230":46899,"_2452":47033},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_2926":1728,"_25561":1673,"_17855":47035,"_5":17750,"_24230":46903,"_2452":47036},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_2926":1729,"_25561":1673,"_17855":47038,"_5":17750,"_24230":46907,"_2452":47039},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_2926":1730,"_25561":1673,"_17855":47041,"_5":17750,"_24230":46911,"_2452":47042},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_2926":1731,"_25561":1673,"_17855":47044,"_5":17750,"_24230":46911,"_2452":47045},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_2926":1732,"_25561":1673,"_17855":47047,"_5":17750,"_24230":46915,"_2452":47048},[],"Open a CA from the inventory to review:",{"_2926":1733,"_25561":1673,"_17855":47050,"_5":17750,"_24230":46915,"_2452":47051},[],"Status and validity period.",{"_2926":1734,"_25561":1673,"_17855":47053,"_5":17750,"_24230":46915,"_2452":47054},[],"Certificate and chain in PEM format.",{"_2926":1735,"_25561":1673,"_17855":47056,"_5":17750,"_24230":46915,"_2452":47057},[],"Number of active, expired and revoked certificates.",{"_2926":1736,"_25561":1673,"_17855":47059,"_5":17750,"_24230":46915,"_2452":47060},[],"Certificates issued in **Issued Certificates**.",{"_2926":1737,"_25561":1673,"_17855":47062,"_5":17750,"_24230":46915,"_2452":47063},[],"The CRL linked to the authority.",{"_2926":1738,"_25561":1673,"_17855":47065,"_5":17750,"_24230":46915,"_2452":47066},[],"Metadata and the associated cryptographic engine.",{"_2926":1739,"_25561":1673,"_17855":47068,"_5":17750,"_24230":46915,"_2452":47069},[],"You can filter the inventory by name, status and CA type.",{"_2926":1740,"_25561":1673,"_17855":47071,"_5":17750,"_24230":46919,"_2452":47072},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_2926":1741,"_25561":1673,"_17855":47074,"_5":17750,"_24230":46919,"_2452":47075},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_2926":1742,"_25561":1673,"_17855":47077,"_5":17750,"_24230":46919,"_2452":47078},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_2926":1743,"_25561":1673,"_17855":47080,"_5":17750,"_24230":46919,"_2452":47081},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_2926":1744,"_25561":1673,"_17855":47083,"_5":17750,"_24230":46923,"_2452":47084},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_2926":1745,"_25561":1673,"_17855":47086,"_5":17750,"_24230":46927,"_2452":47087},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_2926":1746,"_25561":1673,"_17855":47089,"_5":17750,"_24230":46931,"_2452":47090},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_2926":1747,"_25561":1673,"_17855":47092,"_5":17750,"_24230":46935,"_2452":47093},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_2926":1748,"_25561":1673,"_17855":47095,"_5":17750,"_24230":46939,"_2452":47096},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_2926":1749,"_25561":1673,"_17855":47098,"_5":17750,"_24230":46939,"_2452":47099},[],"Permanent deletion is only available after revoking. Delete the record only when your retention and audit policy allows it.",{"_2926":1750,"_25561":1750,"_5":12525,"_2452":47101,"_25885":47102,"_17855":47103,"_24230":1750},"Certificate profiles",[41651,42995,46688,46689],[],{"_2926":1751,"_25561":1750,"_17855":47105,"_5":17750,"_24230":1750,"_2452":47106},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_2926":1752,"_25561":1750,"_5":25882,"_17855":47108,"_24230":47109,"_2452":47110},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_2926":1753,"_25561":1750,"_5":25882,"_17855":47112,"_24230":47113,"_2452":47114},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_2926":1754,"_25561":1750,"_5":25882,"_17855":47116,"_24230":47117,"_2452":47118},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_2926":1755,"_25561":1750,"_5":25882,"_17855":47120,"_24230":47121,"_2452":47122},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_2926":1756,"_25561":1750,"_5":25882,"_17855":47124,"_24230":47125,"_2452":47126},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_2926":1757,"_25561":1750,"_5":25882,"_17855":47128,"_24230":47129,"_2452":47130},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_2926":1758,"_25561":1750,"_5":25882,"_17855":47132,"_24230":47133,"_2452":47134},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_2926":1759,"_25561":1750,"_5":25882,"_17855":47136,"_24230":47137,"_2452":47138},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_2926":1760,"_25561":1750,"_5":25882,"_17855":47140,"_24230":47141,"_2452":47142},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_2926":1761,"_25561":1750,"_5":25882,"_17855":47144,"_24230":47145,"_2452":47146},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_2926":1762,"_25561":1750,"_5":25882,"_17855":47148,"_24230":47149,"_2452":47150},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_2926":1763,"_25561":1750,"_5":25882,"_17855":47152,"_24230":47153,"_2452":47154},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_2926":1764,"_25561":1750,"_5":25882,"_17855":47156,"_24230":47157,"_2452":47158},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_2926":1765,"_25561":1750,"_5":25882,"_17855":47160,"_24230":47161,"_2452":47162},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_2926":1766,"_25561":1750,"_5":25882,"_17855":47164,"_24230":47165,"_2452":47166},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_2926":1767,"_25561":1750,"_5":25882,"_17855":47168,"_24230":47169,"_2452":47170},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_2926":1768,"_25561":1750,"_17855":47172,"_5":17750,"_24230":1750,"_2452":47173},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_2926":1769,"_25561":1750,"_17855":47175,"_5":17750,"_24230":1750,"_2452":47176},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_2926":1770,"_25561":1750,"_17855":47178,"_5":17750,"_24230":47113,"_2452":47179},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_2926":1771,"_25561":1750,"_17855":47181,"_5":17750,"_24230":47113,"_2452":47182},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_2926":1772,"_25561":1750,"_17855":47184,"_5":17750,"_24230":47117,"_2452":47185},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_2926":1773,"_25561":1750,"_17855":47187,"_5":17750,"_24230":47121,"_2452":47188},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_2926":1774,"_25561":1750,"_17855":47190,"_5":17750,"_24230":47121,"_2452":47191},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_2926":1775,"_25561":1750,"_17855":47193,"_5":17750,"_24230":47121,"_2452":47194},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_2926":1776,"_25561":1750,"_17855":47196,"_5":17750,"_24230":47125,"_2452":47197},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_2926":1777,"_25561":1750,"_17855":47199,"_5":17750,"_24230":47129,"_2452":47200},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_2926":1778,"_25561":1750,"_17855":47202,"_5":17750,"_24230":47129,"_2452":47203},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_2926":1779,"_25561":1750,"_17855":47205,"_5":17750,"_24230":47133,"_2452":47206},[],"The cryptographic enforcement can:",{"_2926":1780,"_25561":1750,"_17855":47208,"_5":17750,"_24230":47133,"_2452":47209},[],"allow or block RSA keys;",{"_2926":1781,"_25561":1750,"_17855":47211,"_5":17750,"_24230":47133,"_2452":47212},[],"limit the supported RSA sizes;",{"_2926":1782,"_25561":1750,"_17855":47214,"_5":17750,"_24230":47133,"_2452":47215},[],"allow or block ECDSA keys;",{"_2926":1783,"_25561":1750,"_17855":47217,"_5":17750,"_24230":47133,"_2452":47218},[],"limit the supported ECDSA sizes or curves.",{"_2926":1784,"_25561":1750,"_17855":47220,"_5":17750,"_24230":47133,"_2452":47221},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_2926":1785,"_25561":1750,"_17855":47223,"_5":17750,"_24230":47137,"_2452":47224},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_2926":1786,"_25561":1750,"_17855":47226,"_5":17750,"_24230":47137,"_2452":44716},[],{"_2926":1787,"_25561":1750,"_17855":47228,"_5":17750,"_24230":47137,"_2452":47229},[],"First choice",{"_2926":1788,"_25561":1750,"_17855":47231,"_5":17750,"_24230":47137,"_2452":47232},[],"Second choice",{"_2926":1789,"_25561":1750,"_17855":47234,"_5":17750,"_24230":47137,"_2452":47235},[],"If neither is supplied",{"_2926":1790,"_25561":1750,"_17855":47237,"_5":17750,"_24230":47137,"_2452":47238},[],"Direct signing with a CA",{"_2926":1791,"_25561":1750,"_17855":47240,"_5":17750,"_24230":47137,"_2452":47241},[],"`issuance_profile` embedded in the request",{"_2926":1792,"_25561":1750,"_17855":47243,"_5":17750,"_24230":47137,"_2452":47244},[],"Request `issuance_profile_id`",{"_2926":1793,"_25561":1750,"_17855":47246,"_5":17750,"_24230":47137,"_2452":47247},[],"CA default profile (`profile_id`).",{"_2926":1794,"_25561":1750,"_17855":47249,"_5":17750,"_24230":47137,"_2452":47250},[],"Issuance through a DMS",{"_2926":1795,"_25561":1750,"_17855":47252,"_5":17750,"_24230":47137,"_2452":47253},[],"`settings.issuance_profile_id`",{"_2926":1796,"_25561":1750,"_17855":47255,"_5":17750,"_24230":47137,"_2452":47256},[],"`settings.issuance_profile` embedded in the DMS",{"_2926":1797,"_25561":1750,"_17855":47258,"_5":17750,"_24230":47137,"_2452":47259},[],"Enrollment CA default profile.",{"_2926":1798,"_25561":1750,"_17855":47261,"_5":17750,"_24230":47137,"_2452":47262},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_2926":1799,"_25561":1750,"_17855":47264,"_5":17750,"_24230":47137,"_2452":47265},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_2926":1800,"_25561":1750,"_17855":47267,"_5":17750,"_24230":47145,"_2452":47268},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_2926":1801,"_25561":1750,"_17855":47270,"_5":17750,"_24230":47149,"_2452":47271},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_2926":1802,"_25561":1750,"_17855":47273,"_5":17750,"_24230":47153,"_2452":47274},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_2926":1803,"_25561":1750,"_17855":47276,"_5":17750,"_24230":47157,"_2452":47277},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_2926":1804,"_25561":1750,"_17855":47279,"_5":17750,"_24230":47161,"_2452":47280},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_2926":1805,"_25561":1750,"_17855":47282,"_5":17750,"_24230":47161,"_2452":47283},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_2926":1806,"_25561":1750,"_17855":47285,"_5":17750,"_24230":47165,"_2452":47286},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_2926":1807,"_25561":1750,"_17855":47288,"_5":17750,"_24230":47165,"_2452":47289},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_2926":1808,"_25561":1750,"_17855":47291,"_5":17750,"_24230":47165,"_2452":47292},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_2926":1809,"_25561":1750,"_17855":47294,"_5":17750,"_24230":47165,"_2452":47295},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_2926":1810,"_25561":1750,"_17855":47297,"_5":17750,"_24230":47169,"_2452":47298},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_2926":1811,"_25561":1750,"_17855":47300,"_5":17750,"_24230":47169,"_2452":47301},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_2926":1812,"_25561":1812,"_5":12525,"_2452":47303,"_25885":47304,"_17855":47306,"_24230":1812},"Certificate validation",[41651,42995,46688,47305],"Validation",[],{"_2926":1813,"_25561":1812,"_17855":47308,"_5":17750,"_24230":1812,"_2452":47309},[],"Check chain, identity, purpose and revocation from the consumer.",{"_2926":1814,"_25561":1812,"_5":25882,"_17855":47311,"_24230":47312,"_2452":47313},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_2926":1815,"_25561":1812,"_5":25882,"_17855":47315,"_24230":47316,"_2452":47317},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_2926":1816,"_25561":1812,"_5":25882,"_17855":47319,"_24230":47320,"_2452":47321},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_2926":1817,"_25561":1812,"_17855":47323,"_5":17750,"_24230":1812,"_2452":47324},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_2926":1818,"_25561":1812,"_17855":47326,"_5":17750,"_24230":47312,"_2452":47327},[],"Verify these criteria together:",{"_2926":1819,"_25561":1812,"_17855":47329,"_5":17750,"_24230":47312,"_2452":46312},[],{"_2926":1820,"_25561":1812,"_17855":47331,"_5":17750,"_24230":47312,"_2452":47332},[],"Required result",{"_2926":1821,"_25561":1812,"_17855":47334,"_5":17750,"_24230":47312,"_2452":47335},[],"Chain and signature",{"_2926":1822,"_25561":1812,"_17855":47337,"_5":17750,"_24230":47312,"_2452":47338},[],"Valid chain to a root deliberately installed in the consumer.",{"_2926":1823,"_25561":1812,"_17855":47340,"_5":17750,"_24230":47312,"_2452":47341},[],"Dates",{"_2926":1824,"_25561":1812,"_17855":47343,"_5":17750,"_24230":47312,"_2452":47344},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_2926":1825,"_25561":1812,"_17855":47346,"_5":17750,"_24230":47312,"_2452":42698},[],{"_2926":1826,"_25561":1812,"_17855":47348,"_5":17750,"_24230":47312,"_2452":47349},[],"Name, SAN or identifier matches the expected peer.",{"_2926":1827,"_25561":1812,"_17855":47351,"_5":17750,"_24230":47312,"_2452":42034},[],{"_2926":1828,"_25561":1812,"_17855":47353,"_5":17750,"_24230":47312,"_2452":47354},[],"KU, EKU and constraints permit the specific operation.",{"_2926":1829,"_25561":1812,"_17855":47356,"_5":17750,"_24230":47312,"_2452":47357},[],"Revocation",{"_2926":1830,"_25561":1812,"_17855":47359,"_5":17750,"_24230":47312,"_2452":47360},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_2926":1831,"_25561":1812,"_17855":47362,"_5":17750,"_24230":47312,"_2452":47363},[],"Authorization",{"_2926":1832,"_25561":1812,"_17855":47365,"_5":17750,"_24230":47312,"_2452":47366},[],"The application permits that identity to perform the action.",{"_2926":1833,"_25561":1812,"_17855":47368,"_5":17750,"_24230":47312,"_2452":47369},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_2926":1834,"_25561":1812,"_17855":47371,"_5":17750,"_24230":47316,"_2452":47372},[],"Mechanism",{"_2926":1835,"_25561":1812,"_17855":47374,"_5":17750,"_24230":47316,"_2452":47375},[],"When to use it",{"_2926":1836,"_25561":1812,"_17855":47377,"_5":17750,"_24230":47316,"_2452":47378},[],"What you must maintain",{"_2926":1837,"_25561":1812,"_17855":47380,"_5":17750,"_24230":47316,"_2452":47381},[],"OCSP",{"_2926":1838,"_25561":1812,"_17855":47383,"_5":17750,"_24230":47316,"_2452":47384},[],"Status query for a specific certificate.",{"_2926":1839,"_25561":1812,"_17855":47386,"_5":17750,"_24230":47316,"_2452":47387},[],"Responder access, signature verification and cache/freshness policy.",{"_2926":1840,"_25561":1812,"_17855":47389,"_5":17750,"_24230":47316,"_2452":47390},[],"CRL",{"_2926":1841,"_25561":1812,"_17855":47392,"_5":17750,"_24230":47316,"_2452":47393},[],"Local checks for many certificates or offline operation.",{"_2926":1842,"_25561":1812,"_17855":47395,"_5":17750,"_24230":47316,"_2452":47396},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_2926":1843,"_25561":1812,"_17855":47398,"_5":17750,"_24230":47316,"_2452":47399},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_2926":1844,"_25561":1812,"_17855":47401,"_5":17750,"_24230":47316,"_2452":47402},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_2926":1845,"_25561":1812,"_17855":47404,"_5":17750,"_24230":47320,"_2452":47405},[],"Accept a current, authorized certificate with a known chain.",{"_2926":1846,"_25561":1812,"_17855":47407,"_5":17750,"_24230":47320,"_2452":47408},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_2926":1847,"_25561":1812,"_17855":47410,"_5":17750,"_24230":47320,"_2452":47411},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_2926":1848,"_25561":1812,"_17855":47413,"_5":17750,"_24230":47320,"_2452":47414},[],"Check that a new connection with that identity is rejected.",{"_2926":1849,"_25561":1812,"_17855":47416,"_5":17750,"_24230":47320,"_2452":47417},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_2926":1850,"_25561":1812,"_17855":47419,"_5":17750,"_24230":47320,"_2452":47420},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_2926":1851,"_25561":1812,"_17855":47422,"_5":17750,"_24230":47320,"_2452":47423},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_2926":1852,"_25561":1812,"_17855":47425,"_5":17750,"_24230":47320,"_2452":47426},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":1853,"_25561":1812,"_17855":47428,"_5":17750,"_24230":47320,"_2452":47429},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_2926":1854,"_25561":1854,"_5":12525,"_2452":47431,"_25885":47432,"_17855":47433,"_24230":1854},"Certificates",[41651,42995,46688,46689],[],{"_2926":1855,"_25561":1854,"_17855":47435,"_5":17750,"_24230":1854,"_2452":47436},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_2926":1856,"_25561":1854,"_5":25882,"_17855":47438,"_24230":47439,"_2452":47440},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_2926":1857,"_25561":1854,"_5":25882,"_17855":47442,"_24230":47443,"_2452":47444},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_2926":1858,"_25561":1854,"_5":25882,"_17855":47446,"_24230":47447,"_2452":47448},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_2926":1859,"_25561":1854,"_5":25882,"_17855":47450,"_24230":47451,"_2452":47452},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_2926":1860,"_25561":1854,"_5":25882,"_17855":47454,"_24230":47455,"_2452":47456},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_2926":1861,"_25561":1854,"_5":25882,"_17855":47458,"_24230":47459,"_2452":47460},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_2926":1862,"_25561":1854,"_5":25882,"_17855":47462,"_24230":47463,"_2452":47464},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_2926":1863,"_25561":1854,"_5":25882,"_17855":47466,"_24230":47467,"_2452":47468},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_2926":1864,"_25561":1854,"_5":25882,"_17855":47470,"_24230":47471,"_2452":47472},[],"/docs/platform/pki/certificates#continue","Continue",{"_2926":1865,"_25561":1854,"_17855":47474,"_5":17750,"_24230":1854,"_2452":47475},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_2926":1866,"_25561":1854,"_17855":47477,"_5":17750,"_24230":47439,"_2452":47478},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_2926":1867,"_25561":1854,"_17855":47480,"_5":17750,"_24230":47439,"_2452":47481},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_2926":1868,"_25561":1854,"_17855":47483,"_5":17750,"_24230":47443,"_2452":47484},[],"Download the PEM and inspect it:",{"_2926":1869,"_25561":1854,"_17855":47486,"_5":17750,"_24230":47443,"_2452":47487},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_2926":1870,"_25561":1854,"_17855":47489,"_5":17750,"_24230":47447,"_2452":47490},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_2926":1871,"_25561":1854,"_17855":47492,"_5":17750,"_24230":47447,"_2452":47493},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_2926":1872,"_25561":1854,"_17855":47495,"_5":17750,"_24230":47447,"_2452":47496},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_2926":1873,"_25561":1854,"_17855":47498,"_5":17750,"_24230":47447,"_2452":47499},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_2926":1874,"_25561":1854,"_17855":47501,"_5":17750,"_24230":47447,"_2452":47502},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_2926":1875,"_25561":1854,"_17855":47504,"_5":17750,"_24230":47447,"_2452":47505},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_2926":1876,"_25561":1854,"_17855":47507,"_5":17750,"_24230":47447,"_2452":47508},[],"For browser key generation, follow Issue your first certificate.",{"_2926":1877,"_25561":1854,"_17855":47510,"_5":17750,"_24230":47451,"_2452":47511},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_2926":1878,"_25561":1854,"_17855":47513,"_5":17750,"_24230":47455,"_2452":47514},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_2926":1879,"_25561":1854,"_17855":47516,"_5":17750,"_24230":47459,"_2452":47517},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_2926":1880,"_25561":1854,"_17855":47519,"_5":17750,"_24230":47463,"_2452":47520},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_2926":1881,"_25561":1854,"_17855":47522,"_5":17750,"_24230":47463,"_2452":47523},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_2926":1882,"_25561":1854,"_17855":47525,"_5":17750,"_24230":47463,"_2452":47526},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_2926":1883,"_25561":1854,"_17855":47528,"_5":17750,"_24230":47467,"_2452":47529},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_2926":1884,"_25561":1854,"_17855":47531,"_5":17750,"_24230":47467,"_2452":47532},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_2926":1885,"_25561":1854,"_17855":47534,"_5":17750,"_24230":47467,"_2452":47535},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_2926":1886,"_25561":1854,"_17855":47537,"_5":17750,"_24230":47471,"_2452":47538},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":1887,"_25561":1854,"_17855":47540,"_5":17750,"_24230":47471,"_2452":47541},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_2926":1888,"_25561":1888,"_5":12525,"_2452":47543,"_25885":47544,"_17855":47546,"_24230":1888},"Certificate lifecycle",[41651,42995,46688,47545],"Concepts",[],{"_2926":1889,"_25561":1888,"_17855":47548,"_5":17750,"_24230":1888,"_2452":47549},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_2926":1890,"_25561":1888,"_5":25882,"_17855":47551,"_24230":47552,"_2452":47553},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_2926":1891,"_25561":1888,"_5":25882,"_17855":47555,"_24230":47556,"_2452":47557},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_2926":1892,"_25561":1888,"_5":25882,"_17855":47559,"_24230":47560,"_2452":47561},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_2926":1893,"_25561":1888,"_5":25882,"_17855":47563,"_24230":47564,"_2452":47565},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_2926":1894,"_25561":1888,"_5":25882,"_17855":47567,"_24230":47568,"_2452":47569},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_2926":1895,"_25561":1888,"_5":25882,"_17855":47571,"_24230":47572,"_2452":47573},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_2926":1896,"_25561":1888,"_5":25882,"_17855":47575,"_24230":47576,"_2452":47577},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_2926":1897,"_25561":1888,"_5":25882,"_17855":47579,"_24230":47580,"_2452":47581},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_2926":1898,"_25561":1888,"_5":25882,"_17855":47583,"_24230":47584,"_2452":47585},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_2926":1899,"_25561":1888,"_5":25882,"_17855":47587,"_24230":47588,"_2452":47589},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_2926":1900,"_25561":1888,"_17855":47591,"_5":17750,"_24230":1888,"_2452":47592},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_2926":1901,"_25561":1888,"_17855":47594,"_5":17750,"_24230":47556,"_2452":47595},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_2926":1902,"_25561":1888,"_17855":47597,"_5":17750,"_24230":47560,"_2452":47598},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_2926":1903,"_25561":1888,"_17855":47600,"_5":17750,"_24230":47564,"_2452":47601},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_2926":1904,"_25561":1888,"_17855":47603,"_5":17750,"_24230":47568,"_2452":47604},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_2926":1905,"_25561":1888,"_17855":47606,"_5":17750,"_24230":47572,"_2452":47607},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_2926":1906,"_25561":1888,"_17855":47609,"_5":17750,"_24230":47576,"_2452":47610},[],"Lamassu persists four X.509 states:",{"_2926":1907,"_25561":1888,"_17855":47612,"_5":17750,"_24230":47576,"_2452":47613},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_2926":1908,"_25561":1888,"_17855":47615,"_5":17750,"_24230":47576,"_2452":47616},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_2926":1909,"_25561":1888,"_17855":47618,"_5":17750,"_24230":47576,"_2452":47619},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_2926":1910,"_25561":1888,"_17855":47621,"_5":17750,"_24230":47576,"_2452":47622},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_2926":1911,"_25561":1888,"_17855":47624,"_5":17750,"_24230":47576,"_2452":47625},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_2926":1912,"_25561":1888,"_17855":47627,"_5":17750,"_24230":47580,"_2452":47628},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_2926":1913,"_25561":1888,"_17855":47630,"_5":17750,"_24230":47580,"_2452":47631},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_2926":1914,"_25561":1888,"_17855":47633,"_5":17750,"_24230":47580,"_2452":47634},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_2926":1915,"_25561":1888,"_17855":47636,"_5":17750,"_24230":47584,"_2452":47637},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_2926":1916,"_25561":1888,"_17855":47639,"_5":17750,"_24230":47584,"_2452":47640},[],"Before confirming:",{"_2926":1917,"_25561":1888,"_17855":47642,"_5":17750,"_24230":47584,"_2452":47643},[],"Identify DMSs, devices and services that trust that chain.",{"_2926":1918,"_25561":1888,"_17855":47645,"_5":17750,"_24230":47584,"_2452":47646},[],"Distribute the new chain of trust.",{"_2926":1919,"_25561":1888,"_17855":47648,"_5":17750,"_24230":47584,"_2452":47649},[],"Reissue the necessary identities.",{"_2926":1920,"_25561":1888,"_17855":47651,"_5":17750,"_24230":47584,"_2452":47652},[],"Check OCSP and CRL from a real consumer.",{"_2926":1921,"_25561":1888,"_17855":47654,"_5":17750,"_24230":47584,"_2452":47655},[],"Revoke the old CA once no legitimate traffic remains.",{"_2926":1922,"_25561":1888,"_17855":47657,"_5":17750,"_24230":47584,"_2452":47658},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_2926":1923,"_25561":1888,"_17855":47660,"_5":17750,"_24230":47588,"_2452":47661},[],"Certificates entering the preventive or critical renewal window.",{"_2926":1924,"_25561":1888,"_17855":47663,"_5":17750,"_24230":47588,"_2452":47664},[],"Repeated enrollment or re-enrollment failures.",{"_2926":1925,"_25561":1888,"_17855":47666,"_5":17750,"_24230":47588,"_2452":47667},[],"Status changes and revocation reasons.",{"_2926":1926,"_25561":1888,"_17855":47669,"_5":17750,"_24230":47588,"_2452":47670},[],"OCSP and CRL publication and validity.",{"_2926":1927,"_25561":1888,"_17855":47672,"_5":17750,"_24230":47588,"_2452":47673},[],"Dependencies still presenting a replaced certificate.",{"_2926":1928,"_25561":1888,"_17855":47675,"_5":17750,"_24230":47588,"_2452":47676},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_2926":1929,"_25561":1929,"_5":12525,"_2452":47678,"_25885":47679,"_17855":47680,"_24230":1929},"Trust model",[41651,42995,46688,47545],[],{"_2926":1930,"_25561":1929,"_17855":47682,"_5":17750,"_24230":1929,"_2452":47683},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_2926":1931,"_25561":1929,"_5":25882,"_17855":47685,"_24230":47686,"_2452":47687},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_2926":1932,"_25561":1929,"_5":25882,"_17855":47689,"_24230":47690,"_2452":47691},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_2926":1933,"_25561":1929,"_5":25882,"_17855":47693,"_24230":47694,"_2452":47695},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_2926":1934,"_25561":1929,"_5":25882,"_17855":47697,"_24230":47698,"_2452":47699},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_2926":1935,"_25561":1929,"_5":25882,"_17855":47701,"_24230":47702,"_2452":47703},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_2926":1936,"_25561":1929,"_5":25882,"_17855":47705,"_24230":47706,"_2452":47707},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_2926":1937,"_25561":1929,"_5":25882,"_17855":47709,"_24230":47710,"_2452":47711},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_2926":1938,"_25561":1929,"_5":25882,"_17855":47713,"_24230":47714,"_2452":47715},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_2926":1939,"_25561":1929,"_5":25882,"_17855":47717,"_24230":47718,"_2452":47719},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_2926":1940,"_25561":1929,"_5":25882,"_17855":47721,"_24230":47722,"_2452":47723},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_2926":1941,"_25561":1929,"_17855":47725,"_5":17750,"_24230":1929,"_2452":47726},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_2926":1942,"_25561":1929,"_17855":47728,"_5":17750,"_24230":47690,"_2452":47729},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_2926":1943,"_25561":1929,"_17855":47731,"_5":17750,"_24230":47694,"_2452":47732},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_2926":1944,"_25561":1929,"_17855":47734,"_5":17750,"_24230":47698,"_2452":47735},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_2926":1945,"_25561":1929,"_17855":47737,"_5":17750,"_24230":47702,"_2452":47738},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_2926":1946,"_25561":1929,"_17855":47740,"_5":17750,"_24230":47706,"_2452":47741},[],"The device proves it can enroll according to the DMS policy.",{"_2926":1947,"_25561":1929,"_17855":47743,"_5":17750,"_24230":47706,"_2452":47744},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_2926":1948,"_25561":1929,"_17855":47746,"_5":17750,"_24230":47706,"_2452":47747},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_2926":1949,"_25561":1929,"_17855":47749,"_5":17750,"_24230":47706,"_2452":47750},[],"The device installs the certificate and the chain it needs.",{"_2926":1950,"_25561":1929,"_17855":47752,"_5":17750,"_24230":47706,"_2452":47753},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_2926":1951,"_25561":1929,"_17855":47755,"_5":17750,"_24230":47706,"_2452":47756},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_2926":1952,"_25561":1929,"_17855":47758,"_5":17750,"_24230":47710,"_2452":47759},[],"A DMS relates three sets that are worth designing separately:",{"_2926":1953,"_25561":1929,"_17855":47761,"_5":17750,"_24230":47710,"_2452":47762},[],"**Enrollment CA:** signs the new identities.",{"_2926":1954,"_25561":1929,"_17855":47764,"_5":17750,"_24230":47710,"_2452":47765},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, Lamassu tries the enrollment CA first and then the validation CAs configured in the re-enrollment block.",{"_2926":1955,"_25561":1929,"_17855":47767,"_5":17750,"_24230":47710,"_2452":47768},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_2926":1956,"_25561":1929,"_17855":47770,"_5":17750,"_24230":47710,"_2452":47771},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_2926":1957,"_25561":1929,"_17855":47773,"_5":17750,"_24230":47714,"_2452":47774},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_2926":1958,"_25561":1929,"_17855":47776,"_5":17750,"_24230":47714,"_2452":47777},[],"that the current date is between `Not Before` and `Not After`;",{"_2926":1959,"_25561":1929,"_17855":47779,"_5":17750,"_24230":47714,"_2452":47780},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_2926":1960,"_25561":1929,"_17855":47782,"_5":17750,"_24230":47714,"_2452":47783},[],"that names, SANs and subject match the expected identity;",{"_2926":1961,"_25561":1929,"_17855":47785,"_5":17750,"_24230":47714,"_2452":47786},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_2926":1962,"_25561":1929,"_17855":47788,"_5":17750,"_24230":47714,"_2452":47789},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_2926":1963,"_25561":1929,"_17855":47791,"_5":17750,"_24230":47714,"_2452":47792},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_2926":1964,"_25561":1929,"_17855":47794,"_5":17750,"_24230":47718,"_2452":47795},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_2926":1965,"_25561":1929,"_17855":47797,"_5":17750,"_24230":47722,"_2452":47798},[],"Keep the root out of daily operations, or with very restricted access.",{"_2926":1966,"_25561":1929,"_17855":47800,"_5":17750,"_24230":47722,"_2452":47801},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_2926":1967,"_25561":1929,"_17855":47803,"_5":17750,"_24230":47722,"_2452":47804},[],"Assign explicit profiles to every use case.",{"_2926":1968,"_25561":1929,"_17855":47806,"_5":17750,"_24230":47722,"_2452":47807},[],"Distribute the new trust before starting a rotation.",{"_2926":1969,"_25561":1929,"_17855":47809,"_5":17750,"_24230":47722,"_2452":47810},[],"Keep enough overlap to renew a disconnected fleet.",{"_2926":1970,"_25561":1929,"_17855":47812,"_5":17750,"_24230":47722,"_2452":47813},[],"Validate from the consuming system, not only from the Lamassu console.",{"_2926":1971,"_25561":1929,"_17855":47815,"_5":17750,"_24230":47722,"_2452":47816},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_2926":1972,"_25561":1972,"_5":12525,"_2452":47818,"_25885":47819,"_17855":47820,"_24230":1972},"Revocation lists (CRL)",[41651,42995,46688,47305],[],{"_2926":1973,"_25561":1972,"_17855":47822,"_5":17750,"_24230":1972,"_2452":47823},[],"Generate and distribute signed lists to validate certificates offline.",{"_2926":1974,"_25561":1972,"_5":25882,"_17855":47825,"_24230":47826,"_2452":47827},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_2926":1975,"_25561":1972,"_5":25882,"_17855":47829,"_24230":47830,"_2452":47831},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_2926":1976,"_25561":1972,"_5":25882,"_17855":47833,"_24230":47834,"_2452":47835},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_2926":1977,"_25561":1972,"_5":25882,"_17855":47837,"_24230":47838,"_2452":47839},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_2926":1978,"_25561":1972,"_5":25882,"_17855":47841,"_24230":47842,"_2452":47843},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_2926":1979,"_25561":1972,"_5":25882,"_17855":47845,"_24230":47846,"_2452":47847},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_2926":1980,"_25561":1972,"_5":25882,"_17855":47849,"_24230":47850,"_2452":47851},[],"/docs/platform/pki/crl#references","References",{"_2926":1981,"_25561":1972,"_17855":47853,"_5":17750,"_24230":1972,"_2452":47854},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_2926":1982,"_25561":1972,"_17855":47856,"_5":17750,"_24230":47826,"_2452":47857},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_2926":1983,"_25561":1972,"_17855":47859,"_5":17750,"_24230":47826,"_2452":47860},[],"`crl_options` field",{"_2926":1984,"_25561":1972,"_17855":47862,"_5":17750,"_24230":47826,"_2452":42034},[],{"_2926":1985,"_25561":1972,"_17855":47864,"_5":17750,"_24230":47826,"_2452":47865},[],"Backend initial value",{"_2926":1986,"_25561":1972,"_17855":47867,"_5":17750,"_24230":47826,"_2452":47868},[],"`validity`",{"_2926":1987,"_25561":1972,"_17855":47870,"_5":17750,"_24230":47826,"_2452":47871},[],"Time from `thisUpdate` to `nextUpdate`.",{"_2926":1988,"_25561":1972,"_17855":47873,"_5":17750,"_24230":47826,"_2452":47874},[],"7 days.",{"_2926":1989,"_25561":1972,"_17855":47876,"_5":17750,"_24230":47826,"_2452":47877},[],"`refresh_interval`",{"_2926":1990,"_25561":1972,"_17855":47879,"_5":17750,"_24230":47826,"_2452":47880},[],"Time since publication that triggers scheduled renewal.",{"_2926":1991,"_25561":1972,"_17855":47882,"_5":17750,"_24230":47826,"_2452":47883},[],"6 days and 23 hours.",{"_2926":1992,"_25561":1972,"_17855":47885,"_5":17750,"_24230":47826,"_2452":47886},[],"`regenerate_on_revoke`",{"_2926":1993,"_25561":1972,"_17855":47888,"_5":17750,"_24230":47826,"_2452":47889},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_2926":1994,"_25561":1972,"_17855":47891,"_5":17750,"_24230":47826,"_2452":47892},[],"`true`.",{"_2926":1995,"_25561":1972,"_17855":47894,"_5":17750,"_24230":47826,"_2452":47895},[],"`subject_key_id_signer`",{"_2926":1996,"_25561":1972,"_17855":47897,"_5":17750,"_24230":47826,"_2452":47898},[],"Configuration field initialized with the CA’s SKI.",{"_2926":1997,"_25561":1972,"_17855":47900,"_5":17750,"_24230":47826,"_2452":47901},[],"CA SKI.",{"_2926":1998,"_25561":1972,"_17855":47903,"_5":17750,"_24230":47826,"_2452":47904},[],"The generator uses the key of the CA identified by the requested SKI. Do not interpret `subject_key_id_signer` as verified support for a different delegated CA: changing that field does not change the signer in this flow.",{"_2926":1999,"_25561":1972,"_17855":47906,"_5":17750,"_24230":47826,"_2452":47907},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_2926":2000,"_25561":1972,"_17855":47909,"_5":17750,"_24230":47830,"_2452":47910},[],"The scheduled job requests another list when `refresh_interval` is reached or when the list approaches expiration within the configured watch period. This depends on working jobs, storage and signing; it does not guarantee renewal during a service failure.",{"_2926":2001,"_25561":1972,"_17855":47912,"_5":17750,"_24230":47830,"_2452":47913},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_2926":2002,"_25561":1972,"_17855":47915,"_5":17750,"_24230":47830,"_2452":47916},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_2926":2003,"_25561":1972,"_17855":47918,"_5":17750,"_24230":47834,"_2452":47919},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_2926":2004,"_25561":1972,"_17855":47921,"_5":17750,"_24230":47834,"_2452":47922},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_2926":2005,"_25561":1972,"_17855":47924,"_5":17750,"_24230":47838,"_2452":47925},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_2926":2006,"_25561":1972,"_17855":47927,"_5":17750,"_24230":47838,"_2452":47928},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_2926":2007,"_25561":1972,"_17855":47930,"_5":17750,"_24230":47838,"_2452":47931},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_2926":2008,"_25561":1972,"_17855":47933,"_5":17750,"_24230":47838,"_2452":47934},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_2926":2009,"_25561":1972,"_17855":47936,"_5":17750,"_24230":47838,"_2452":47937},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_2926":2010,"_25561":1972,"_17855":47939,"_5":17750,"_24230":47842,"_2452":47940},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_2926":2011,"_25561":1972,"_17855":47942,"_5":17750,"_24230":47842,"_2452":44719},[],{"_2926":2012,"_25561":1972,"_17855":47944,"_5":17750,"_24230":47842,"_2452":47945},[],"Relative path",{"_2926":2013,"_25561":1972,"_17855":47947,"_5":17750,"_24230":47842,"_2452":44716},[],{"_2926":2014,"_25561":1972,"_17855":47949,"_5":17750,"_24230":47842,"_2452":47950},[],"`GET`",{"_2926":2015,"_25561":1972,"_17855":47952,"_5":17750,"_24230":47842,"_2452":47953},[],"`/v1/roles/{ca-ski}`",{"_2926":2016,"_25561":1972,"_17855":47955,"_5":17750,"_24230":47842,"_2452":47956},[],"Read `crl_options` and `latest_crl`.",{"_2926":2017,"_25561":1972,"_17855":47958,"_5":17750,"_24230":47842,"_2452":47959},[],"`PUT`",{"_2926":2018,"_25561":1972,"_17855":47961,"_5":17750,"_24230":47842,"_2452":47953},[],{"_2926":2019,"_25561":1972,"_17855":47963,"_5":17750,"_24230":47842,"_2452":47964},[],"Replace CRL configuration.",{"_2926":2020,"_25561":1972,"_17855":47966,"_5":17750,"_24230":47842,"_2452":47967},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_2926":2021,"_25561":1972,"_17855":47969,"_5":17750,"_24230":47842,"_2452":47970},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_2926":2022,"_25561":1972,"_17855":47972,"_5":17750,"_24230":47846,"_2452":47973},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_2926":2023,"_25561":1972,"_17855":47975,"_5":17750,"_24230":47850,"_2452":47976},[],"RFC 5280: X.509 and CRL profile.",{"_2926":2024,"_25561":1972,"_17855":47978,"_5":17750,"_24230":47850,"_2452":47979},[],"OpenSSL: openssl-crl.",{"_2926":2025,"_25561":1972,"_17855":47981,"_5":17750,"_24230":47850,"_2452":47982},[],"OpenSSL: openssl-verify.",{"_2926":2026,"_25561":1972,"_17855":47984,"_5":17750,"_24230":47850,"_2452":47985},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_2926":2027,"_25561":1972,"_17855":47987,"_5":17750,"_24230":47850,"_2452":47988},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_2926":2028,"_25561":2028,"_5":12525,"_2452":47990,"_25885":47991,"_17855":47992,"_24230":2028},"Keys and cryptographic engines",[41651,42995,46688,46689],[],{"_2926":2029,"_25561":2028,"_17855":47994,"_5":17750,"_24230":2028,"_2452":47995},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_2926":2030,"_25561":2028,"_5":25882,"_17855":47997,"_24230":47998,"_2452":47999},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_2926":2031,"_25561":2028,"_5":25882,"_17855":48001,"_24230":48002,"_2452":48003},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_2926":2032,"_25561":2028,"_5":25882,"_17855":48005,"_24230":48006,"_2452":48007},[],"/docs/platform/pki/key-management#file-system","File System",{"_2926":2033,"_25561":2028,"_5":25882,"_17855":48009,"_24230":48010,"_2452":48011},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_2926":2034,"_25561":2028,"_5":25882,"_17855":48013,"_24230":48014,"_2452":48015},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_2926":2035,"_25561":2028,"_5":25882,"_17855":48017,"_24230":48018,"_2452":48019},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_2926":2036,"_25561":2028,"_5":25882,"_17855":48021,"_24230":48022,"_2452":48023},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_2926":2037,"_25561":2028,"_5":25882,"_17855":48025,"_24230":48026,"_2452":48027},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_2926":2038,"_25561":2028,"_5":25882,"_17855":48029,"_24230":48030,"_2452":48031},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_2926":2039,"_25561":2028,"_5":25882,"_17855":48033,"_24230":48034,"_2452":48035},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_2926":2040,"_25561":2028,"_5":25882,"_17855":48037,"_24230":48038,"_2452":48039},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_2926":2041,"_25561":2028,"_5":25882,"_17855":48041,"_24230":48042,"_2452":48043},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_2926":2042,"_25561":2028,"_5":25882,"_17855":48045,"_24230":48046,"_2452":48047},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_2926":2043,"_25561":2028,"_5":25882,"_17855":48049,"_24230":48050,"_2452":48051},[],"/docs/platform/pki/key-management#view-details","View details",{"_2926":2044,"_25561":2028,"_5":25882,"_17855":48053,"_24230":48054,"_2452":48055},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_2926":2045,"_25561":2028,"_5":25882,"_17855":48057,"_24230":48058,"_2452":48059},[],"/docs/platform/pki/key-management#sign","Sign",{"_2926":2046,"_25561":2028,"_5":25882,"_17855":48061,"_24230":48062,"_2452":48063},[],"/docs/platform/pki/key-management#verify","Verify",{"_2926":2047,"_25561":2028,"_5":25882,"_17855":48065,"_24230":48066,"_2452":48067},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_2926":2048,"_25561":2028,"_5":25882,"_17855":48069,"_24230":48070,"_2452":48071},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_2926":2049,"_25561":2028,"_5":25882,"_17855":48073,"_24230":48074,"_2452":48075},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_2926":2050,"_25561":2028,"_17855":48077,"_5":17750,"_24230":2028,"_2452":48078},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_2926":2051,"_25561":2028,"_17855":48080,"_5":17750,"_24230":2028,"_2452":48081},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_2926":2052,"_25561":2028,"_17855":48083,"_5":17750,"_24230":47998,"_2452":48084},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_2926":2053,"_25561":2028,"_17855":48086,"_5":17750,"_24230":47998,"_2452":48087},[],"In practice, it lets you:",{"_2926":2054,"_25561":2028,"_17855":48089,"_5":17750,"_24230":47998,"_2452":48090},[],"Generate new key pairs from Lamassu IoT.",{"_2926":2055,"_25561":2028,"_17855":48092,"_5":17750,"_24230":47998,"_2452":48093},[],"Import keys created externally.",{"_2926":2056,"_25561":2028,"_17855":48095,"_5":17750,"_24230":47998,"_2452":48096},[],"Delegate custody and cryptographic operations to external engines.",{"_2926":2057,"_25561":2028,"_17855":48098,"_5":17750,"_24230":47998,"_2452":48099},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_2926":2058,"_25561":2028,"_17855":48101,"_5":17750,"_24230":48002,"_2452":48102},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_2926":2059,"_25561":2028,"_17855":48104,"_5":17750,"_24230":48002,"_2452":48105},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_2926":2060,"_25561":2028,"_17855":48107,"_5":17750,"_24230":48002,"_2452":48108},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_2926":2061,"_25561":2028,"_17855":48110,"_5":17750,"_24230":48006,"_2452":48111},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_2926":2062,"_25561":2028,"_17855":48113,"_5":17750,"_24230":48010,"_2452":48114},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_2926":2063,"_25561":2028,"_17855":48116,"_5":17750,"_24230":48014,"_2452":48117},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_2926":2064,"_25561":2028,"_17855":48119,"_5":17750,"_24230":48018,"_2452":48120},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_2926":2065,"_25561":2028,"_17855":48122,"_5":17750,"_24230":48022,"_2452":48123},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_2926":2066,"_25561":2028,"_17855":48125,"_5":17750,"_24230":48026,"_2452":48126},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_2926":2067,"_25561":2028,"_17855":48128,"_5":17750,"_24230":48026,"_2452":48129},[],"Lamassu shows the enabled engines in the console.",{"_2926":2068,"_25561":2028,"_17855":48131,"_5":17750,"_24230":48026,"_2452":48132},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_2926":2069,"_25561":2028,"_17855":48134,"_5":17750,"_24230":48026,"_2452":48135},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_2926":2070,"_25561":2028,"_17855":48137,"_5":17750,"_24230":48030,"_2452":48138},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_2926":2071,"_25561":2028,"_17855":48140,"_5":17750,"_24230":48030,"_2452":48141},[],"The table includes the following fields:",{"_2926":2072,"_25561":2028,"_17855":48143,"_5":17750,"_24230":48030,"_2452":48144},[],"**Name**: descriptive name of the key.",{"_2926":2073,"_25561":2028,"_17855":48146,"_5":17750,"_24230":48030,"_2452":48147},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_2926":2074,"_25561":2028,"_17855":48149,"_5":17750,"_24230":48030,"_2452":48150},[],"**Strength**: visual indicator of cryptographic strength.",{"_2926":2075,"_25561":2028,"_17855":48152,"_5":17750,"_24230":48030,"_2452":48153},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_2926":2076,"_25561":2028,"_17855":48155,"_5":17750,"_24230":48030,"_2452":48156},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_2926":2077,"_25561":2028,"_17855":48158,"_5":17750,"_24230":48030,"_2452":48159},[],"**Aliases**: alternative names associated with the key.",{"_2926":2078,"_25561":2028,"_17855":48161,"_5":17750,"_24230":48030,"_2452":48162},[],"**Tags**: labels for classification and search.",{"_2926":2079,"_25561":2028,"_17855":48164,"_5":17750,"_24230":48030,"_2452":48165},[],"**Related Entities**: certificates or other entities linked to that key.",{"_2926":2080,"_25561":2028,"_17855":48167,"_5":17750,"_24230":48030,"_2452":48168},[],"From this view you also reach the most common actions:",{"_2926":2081,"_25561":2028,"_17855":48170,"_5":17750,"_24230":48030,"_2452":48171},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_2926":2082,"_25561":2028,"_17855":48173,"_5":17750,"_24230":48030,"_2452":48174},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_2926":2083,"_25561":2028,"_17855":48176,"_5":17750,"_24230":48030,"_2452":48177},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_2926":2084,"_25561":2028,"_17855":48179,"_5":17750,"_24230":48030,"_2452":48180},[],"**Delete Key** to remove the key from the system.",{"_2926":2085,"_25561":2028,"_17855":48182,"_5":17750,"_24230":48034,"_2452":48183},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_2926":2086,"_25561":2028,"_17855":48185,"_5":17750,"_24230":48038,"_2452":48186},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_2926":2087,"_25561":2028,"_17855":48188,"_5":17750,"_24230":48038,"_2452":48189},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_2926":2088,"_25561":2028,"_17855":48191,"_5":17750,"_24230":48038,"_2452":48192},[],"**Key Name**: unique and descriptive name.",{"_2926":2089,"_25561":2028,"_17855":48194,"_5":17750,"_24230":48038,"_2452":48195},[],"**Crypto Engine**: engine that will keep the key.",{"_2926":2090,"_25561":2028,"_17855":48197,"_5":17750,"_24230":48038,"_2452":48198},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_2926":2091,"_25561":2028,"_17855":48200,"_5":17750,"_24230":48038,"_2452":48201},[],"**Tags**: metadata to classify the key.",{"_2926":2092,"_25561":2028,"_17855":48203,"_5":17750,"_24230":48038,"_2452":48204},[],"**Metadata**: additional information for advanced uses.",{"_2926":2093,"_25561":2028,"_17855":48206,"_5":17750,"_24230":48042,"_2452":48207},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_2926":2094,"_25561":2028,"_17855":48209,"_5":17750,"_24230":48042,"_2452":48210},[],"When you have an exportable private key and the destination engine supports import.",{"_2926":2095,"_25561":2028,"_17855":48212,"_5":17750,"_24230":48042,"_2452":48213},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_2926":2096,"_25561":2028,"_17855":48215,"_5":17750,"_24230":48042,"_2452":48216},[],"When Lamassu must operate with a root of trust created by a third party.",{"_2926":2097,"_25561":2028,"_17855":48218,"_5":17750,"_24230":48042,"_2452":48219},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_2926":2098,"_25561":2028,"_17855":48221,"_5":17750,"_24230":48042,"_2452":48222},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_2926":2099,"_25561":2028,"_17855":48224,"_5":17750,"_24230":48042,"_2452":48225},[],"**Crypto Engine**: engine that will keep the imported key.",{"_2926":2100,"_25561":2028,"_17855":48227,"_5":17750,"_24230":48042,"_2452":48228},[],"**Tags**: labels for organization and search.",{"_2926":2101,"_25561":2028,"_17855":48230,"_5":17750,"_24230":48042,"_2452":48231},[],"**Metadata**: additional optional information.",{"_2926":2102,"_25561":2028,"_17855":48233,"_5":17750,"_24230":48042,"_2452":48234},[],"**Private Key (PEM)**: private key in PEM format.",{"_2926":2103,"_25561":2028,"_17855":48236,"_5":17750,"_24230":48042,"_2452":48237},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_2926":2104,"_25561":2028,"_17855":48239,"_5":17750,"_24230":48046,"_2452":48240},[],"Each registered key has a detail view and several operational actions.",{"_2926":2105,"_25561":2028,"_17855":48242,"_5":17750,"_24230":48050,"_2452":48243},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_2926":2106,"_25561":2028,"_17855":48245,"_5":17750,"_24230":48050,"_2452":48246},[],"The **Overview** tab shows, among others, these fields:",{"_2926":2107,"_25561":2028,"_17855":48248,"_5":17750,"_24230":48050,"_2452":48249},[],"**Key Name**: descriptive name.",{"_2926":2108,"_25561":2028,"_17855":48251,"_5":17750,"_24230":48050,"_2452":48252},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_2926":2109,"_25561":2028,"_17855":48254,"_5":17750,"_24230":48050,"_2452":48255},[],"**Tags**: associated labels.",{"_2926":2110,"_25561":2028,"_17855":48257,"_5":17750,"_24230":48050,"_2452":48258},[],"**Aliases**: alternative names.",{"_2926":2111,"_25561":2028,"_17855":48260,"_5":17750,"_24230":48050,"_2452":48261},[],"**Crypto Engine**: engine where the key resides.",{"_2926":2112,"_25561":2028,"_17855":48263,"_5":17750,"_24230":48050,"_2452":48264},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_2926":2113,"_25561":2028,"_17855":48266,"_5":17750,"_24230":48050,"_2452":48267},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_2926":2114,"_25561":2028,"_17855":48269,"_5":17750,"_24230":48050,"_2452":48270},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_2926":2115,"_25561":2028,"_17855":48272,"_5":17750,"_24230":48054,"_2452":48273},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_2926":2116,"_25561":2028,"_17855":48275,"_5":17750,"_24230":48054,"_2452":48276},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_2926":2117,"_25561":2028,"_17855":48278,"_5":17750,"_24230":48054,"_2452":48279},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_2926":2118,"_25561":2028,"_17855":48281,"_5":17750,"_24230":48058,"_2452":48282},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_2926":2119,"_25561":2028,"_17855":48284,"_5":17750,"_24230":48058,"_2452":48285},[],"Main fields:",{"_2926":2120,"_25561":2028,"_17855":48287,"_5":17750,"_24230":48058,"_2452":48288},[],"**Algorithm**: signing algorithm available for the key type.",{"_2926":2121,"_25561":2028,"_17855":48290,"_5":17750,"_24230":48058,"_2452":48291},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_2926":2122,"_25561":2028,"_17855":48293,"_5":17750,"_24230":48058,"_2452":48294},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_2926":2123,"_25561":2028,"_17855":48296,"_5":17750,"_24230":48058,"_2452":48297},[],"**Message**: content to sign.",{"_2926":2124,"_25561":2028,"_17855":48299,"_5":17750,"_24230":48058,"_2452":48300},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_2926":2125,"_25561":2028,"_17855":48302,"_5":17750,"_24230":48062,"_2452":48303},[],"This tab checks whether a signature corresponds to the associated public key.",{"_2926":2126,"_25561":2028,"_17855":48305,"_5":17750,"_24230":48062,"_2452":48285},[],{"_2926":2127,"_25561":2028,"_17855":48307,"_5":17750,"_24230":48062,"_2452":48308},[],"**Algorithm**: must match the algorithm used for the signature.",{"_2926":2128,"_25561":2028,"_17855":48310,"_5":17750,"_24230":48062,"_2452":48311},[],"**Message Type**: `Raw` or `Digest`.",{"_2926":2129,"_25561":2028,"_17855":48313,"_5":17750,"_24230":48062,"_2452":48314},[],"**Payload Encoding**: encoding of the message.",{"_2926":2130,"_25561":2028,"_17855":48316,"_5":17750,"_24230":48062,"_2452":48317},[],"**Message**: original message or hash.",{"_2926":2131,"_25561":2028,"_17855":48319,"_5":17750,"_24230":48062,"_2452":48320},[],"**Signature**: signature to check.",{"_2926":2132,"_25561":2028,"_17855":48322,"_5":17750,"_24230":48062,"_2452":48323},[],"**Result**: indicator of the validation result.",{"_2926":2133,"_25561":2028,"_17855":48325,"_5":17750,"_24230":48066,"_2452":48326},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_2926":2134,"_25561":2028,"_17855":48328,"_5":17750,"_24230":48066,"_2452":48329},[],"This flow is useful for:",{"_2926":2135,"_25561":2028,"_17855":48331,"_5":17750,"_24230":48066,"_2452":48332},[],"Requesting certificates from an external CA.",{"_2926":2136,"_25561":2028,"_17855":48334,"_5":17750,"_24230":48066,"_2452":48335},[],"Renewing an identity while keeping the same key.",{"_2926":2137,"_25561":2028,"_17855":48337,"_5":17750,"_24230":48066,"_2452":48338},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_2926":2138,"_25561":2028,"_17855":48340,"_5":17750,"_24230":48066,"_2452":48341},[],"**Common Name (CN)**: main name of the identity.",{"_2926":2139,"_25561":2028,"_17855":48343,"_5":17750,"_24230":48066,"_2452":48344},[],"**Organization (O)**: organization or company.",{"_2926":2140,"_25561":2028,"_17855":48346,"_5":17750,"_24230":48066,"_2452":48347},[],"**Organizational Unit (OU)**: department or unit.",{"_2926":2141,"_25561":2028,"_17855":48349,"_5":17750,"_24230":48066,"_2452":48350},[],"**Country (C)**: two-letter country code.",{"_2926":2142,"_25561":2028,"_17855":48352,"_5":17750,"_24230":48066,"_2452":48353},[],"**State / Province (ST)**: state or province.",{"_2926":2143,"_25561":2028,"_17855":48355,"_5":17750,"_24230":48066,"_2452":48356},[],"**Locality (L)**: city or locality.",{"_2926":2144,"_25561":2028,"_17855":48358,"_5":17750,"_24230":48066,"_2452":48359},[],"**Email Address**: contact email.",{"_2926":2145,"_25561":2028,"_17855":48361,"_5":17750,"_24230":48066,"_2452":48362},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_2926":2146,"_25561":2028,"_17855":48364,"_5":17750,"_24230":48066,"_2452":48365},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_2926":2147,"_25561":2028,"_17855":48367,"_5":17750,"_24230":48070,"_2452":48368},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_2926":2148,"_25561":2028,"_17855":48370,"_5":17750,"_24230":48070,"_2452":48371},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_2926":2149,"_25561":2028,"_17855":48373,"_5":17750,"_24230":48074,"_2452":48374},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_2926":2150,"_25561":2150,"_5":12525,"_2452":48376,"_25885":48377,"_17855":48378,"_24230":2150},"Online validation with OCSP",[41651,42995,46688,47305],[],{"_2926":2151,"_25561":2150,"_17855":48380,"_5":17750,"_24230":2150,"_2452":48381},[],"Query signed status and verify the responder’s response.",{"_2926":2152,"_25561":2150,"_5":25882,"_17855":48383,"_24230":48384,"_2452":48385},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_2926":2153,"_25561":2150,"_5":25882,"_17855":48387,"_24230":48388,"_2452":48389},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_2926":2154,"_25561":2150,"_5":25882,"_17855":48391,"_24230":48392,"_2452":48393},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_2926":2155,"_25561":2150,"_5":25882,"_17855":48395,"_24230":48396,"_2452":48397},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_2926":2156,"_25561":2150,"_5":25882,"_17855":48399,"_24230":48400,"_2452":48401},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_2926":2157,"_25561":2150,"_5":25882,"_17855":48403,"_24230":48404,"_2452":47851},[],"/docs/platform/pki/ocsp#references",{"_2926":2158,"_25561":2150,"_17855":48406,"_5":17750,"_24230":2150,"_2452":48407},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_2926":2159,"_25561":2150,"_17855":48409,"_5":17750,"_24230":48384,"_2452":48410},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_2926":2160,"_25561":2150,"_17855":48412,"_5":17750,"_24230":48384,"_2452":48413},[],"Record status",{"_2926":2161,"_25561":2150,"_17855":48415,"_5":17750,"_24230":48384,"_2452":48416},[],"Signed response",{"_2926":2162,"_25561":2150,"_17855":48418,"_5":17750,"_24230":48384,"_2452":45866},[],{"_2926":2163,"_25561":2150,"_17855":48420,"_5":17750,"_24230":48384,"_2452":48421},[],"`Good`.",{"_2926":2164,"_25561":2150,"_17855":48423,"_5":17750,"_24230":48384,"_2452":45883},[],{"_2926":2165,"_25561":2150,"_17855":48425,"_5":17750,"_24230":48384,"_2452":48426},[],"`Revoked`, with revocation reason and timestamp.",{"_2926":2166,"_25561":2150,"_17855":48428,"_5":17750,"_24230":48384,"_2452":48429},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_2926":2167,"_25561":2150,"_17855":48431,"_5":17750,"_24230":48384,"_2452":48432},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_2926":2168,"_25561":2150,"_17855":48434,"_5":17750,"_24230":48384,"_2452":48435},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_2926":2169,"_25561":2150,"_17855":48437,"_5":17750,"_24230":48384,"_2452":48438},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_2926":2170,"_25561":2150,"_17855":48440,"_5":17750,"_24230":48384,"_2452":48441},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_2926":2171,"_25561":2150,"_17855":48443,"_5":17750,"_24230":48388,"_2452":48444},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_2926":2172,"_25561":2150,"_17855":48446,"_5":17750,"_24230":48388,"_2452":48447},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_2926":2173,"_25561":2150,"_17855":48449,"_5":17750,"_24230":48392,"_2452":48450},[],"The service accepts:",{"_2926":2174,"_25561":2150,"_17855":48452,"_5":17750,"_24230":48392,"_2452":44719},[],{"_2926":2175,"_25561":2150,"_17855":48454,"_5":17750,"_24230":48392,"_2452":48455},[],"VA service path",{"_2926":2176,"_25561":2150,"_17855":48457,"_5":17750,"_24230":48392,"_2452":48458},[],"Format",{"_2926":2177,"_25561":2150,"_17855":48460,"_5":17750,"_24230":48392,"_2452":48461},[],"`POST`",{"_2926":2178,"_25561":2150,"_17855":48463,"_5":17750,"_24230":48392,"_2452":48464},[],"`/ocsp`",{"_2926":2179,"_25561":2150,"_17855":48466,"_5":17750,"_24230":48392,"_2452":48467},[],"DER request, `Content-Type: application/ocsp-request`.",{"_2926":2180,"_25561":2150,"_17855":48469,"_5":17750,"_24230":48392,"_2452":47950},[],{"_2926":2181,"_25561":2150,"_17855":48471,"_5":17750,"_24230":48392,"_2452":48472},[],"`/ocsp/{ocsp_request}`",{"_2926":2182,"_25561":2150,"_17855":48474,"_5":17750,"_24230":48392,"_2452":48475},[],"DER request encoded using padded URL Base64.",{"_2926":2183,"_25561":2150,"_17855":48477,"_5":17750,"_24230":48392,"_2452":48478},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_2926":2184,"_25561":2150,"_17855":48480,"_5":17750,"_24230":48396,"_2452":48481},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_2926":2185,"_25561":2150,"_17855":48483,"_5":17750,"_24230":48396,"_2452":48484},[],"Generate the request:",{"_2926":2186,"_25561":2150,"_17855":48486,"_5":17750,"_24230":48396,"_2452":48487},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_2926":2187,"_25561":2150,"_17855":48489,"_5":17750,"_24230":48396,"_2452":48490},[],"Replace the example URL with the inspected endpoint:",{"_2926":2188,"_25561":2150,"_17855":48492,"_5":17750,"_24230":48396,"_2452":48493},[],"Verify the returned DER:",{"_2926":2189,"_25561":2150,"_17855":48495,"_5":17750,"_24230":48396,"_2452":48496},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_2926":2190,"_25561":2150,"_17855":48498,"_5":17750,"_24230":48400,"_2452":48499},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_2926":2191,"_25561":2150,"_17855":48501,"_5":17750,"_24230":48400,"_2452":48502},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_2926":2192,"_25561":2150,"_17855":48504,"_5":17750,"_24230":48404,"_2452":48505},[],"RFC 6960: OCSP.",{"_2926":2193,"_25561":2150,"_17855":48507,"_5":17750,"_24230":48404,"_2452":48508},[],"OpenSSL: openssl-ocsp.",{"_2926":2194,"_25561":2150,"_17855":48510,"_5":17750,"_24230":48404,"_2452":48511},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_2926":2195,"_25561":2150,"_17855":48513,"_5":17750,"_24230":48404,"_2452":47988},[],{"_2926":2196,"_25561":2196,"_5":12525,"_2452":46688,"_25885":48515,"_17855":48516,"_24230":2196},[41651,42995,46688],[],{"_2926":2197,"_25561":2196,"_17855":48518,"_5":17750,"_24230":2196,"_2452":48519},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_2926":2198,"_25561":2196,"_5":25882,"_17855":48521,"_24230":48522,"_2452":45998},[],"/docs/platform/pki/overview#start-here",{"_2926":2199,"_25561":2196,"_5":25882,"_17855":48524,"_24230":48525,"_2452":48526},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_2926":2200,"_25561":2196,"_5":25882,"_17855":48528,"_24230":48529,"_2452":46532},[],"/docs/platform/pki/overview#core-capabilities",{"_2926":2201,"_25561":2196,"_5":25882,"_17855":48531,"_24230":48532,"_2452":46536},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_2926":2202,"_25561":2196,"_5":25882,"_17855":48534,"_24230":48535,"_2452":46540},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_2926":2203,"_25561":2196,"_5":25882,"_17855":48537,"_24230":48538,"_2452":46544},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_2926":2204,"_25561":2196,"_5":25882,"_17855":48540,"_24230":48541,"_2452":46552},[],"/docs/platform/pki/overview#publish-validation-status",{"_2926":2205,"_25561":2196,"_5":25882,"_17855":48543,"_24230":48544,"_2452":48545},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_2926":2206,"_25561":2196,"_5":25882,"_17855":48547,"_24230":48548,"_2452":47472},[],"/docs/platform/pki/overview#continue",{"_2926":2207,"_25561":2196,"_17855":48550,"_5":17750,"_24230":2196,"_2452":48551},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_2926":2208,"_25561":2196,"_17855":48553,"_5":17750,"_24230":48522,"_2452":48554},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_2926":2209,"_25561":2196,"_17855":48556,"_5":17750,"_24230":48522,"_2452":48557},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_2926":2210,"_25561":2196,"_17855":48559,"_5":17750,"_24230":48525,"_2452":48560},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_2926":2211,"_25561":2196,"_17855":48562,"_5":17750,"_24230":48525,"_2452":48563},[],"An available cryptographic engine to keep the authority's key.",{"_2926":2212,"_25561":2196,"_17855":48565,"_5":17750,"_24230":48525,"_2452":48566},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_2926":2213,"_25561":2196,"_17855":48568,"_5":17750,"_24230":48525,"_2452":48569},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_2926":2214,"_25561":2196,"_17855":48571,"_5":17750,"_24230":48525,"_2452":48572},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_2926":2215,"_25561":2196,"_17855":48574,"_5":17750,"_24230":48532,"_2452":48575},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_2926":2216,"_25561":2196,"_17855":48577,"_5":17750,"_24230":48535,"_2452":48578},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_2926":2217,"_25561":2196,"_17855":48580,"_5":17750,"_24230":48538,"_2452":48581},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_2926":2218,"_25561":2196,"_17855":48583,"_5":17750,"_24230":48541,"_2452":48584},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_2926":2219,"_25561":2196,"_17855":48586,"_5":17750,"_24230":48544,"_2452":48587},[],"An active certificate in the console is one part of the check. Also verify that:",{"_2926":2220,"_25561":2196,"_17855":48589,"_5":17750,"_24230":48544,"_2452":48590},[],"its subject and extensions identify the expected client;",{"_2926":2221,"_25561":2196,"_17855":48592,"_5":17750,"_24230":48544,"_2452":48593},[],"its public key matches the client's private key;",{"_2926":2222,"_25561":2196,"_17855":48595,"_5":17750,"_24230":48544,"_2452":48596},[],"its chain reaches a root trusted by the consumer;",{"_2926":2223,"_25561":2196,"_17855":48598,"_5":17750,"_24230":48544,"_2452":48599},[],"its dates and usages allow the operation;",{"_2926":2224,"_25561":2196,"_17855":48601,"_5":17750,"_24230":48544,"_2452":48602},[],"the consumer applies revocation checks and authorization.",{"_2926":2225,"_25561":2196,"_17855":48604,"_5":17750,"_24230":48544,"_2452":48605},[],"The issuance path includes the first independent checks.",{"_2926":2226,"_25561":2196,"_17855":48607,"_5":17750,"_24230":48548,"_2452":48608},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_2926":2227,"_25561":2196,"_17855":48610,"_5":17750,"_24230":48548,"_2452":48611},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_2926":2228,"_25561":2196,"_17855":48613,"_5":17750,"_24230":48548,"_2452":48614},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_2926":2229,"_25561":2229,"_5":12525,"_2452":48616,"_25885":48617,"_17855":48618,"_24230":2229},"Create your first CA",[41651,42995,46688,46123],[],{"_2926":2230,"_25561":2229,"_17855":48620,"_5":17750,"_24230":2229,"_2452":48621},[],"Create an evaluation root and check its certificate before issuing.",{"_2926":2231,"_25561":2229,"_5":25882,"_17855":48623,"_24230":48624,"_2452":41661},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_2926":2232,"_25561":2229,"_5":25882,"_17855":48626,"_24230":48627,"_2452":48628},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard","Open the creation wizard",{"_2926":2233,"_25561":2229,"_5":25882,"_17855":48630,"_24230":48631,"_2452":48632},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key","Select the key",{"_2926":2234,"_25561":2229,"_5":25882,"_17855":48634,"_24230":48635,"_2452":48636},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority","Define the authority",{"_2926":2235,"_25561":2229,"_5":25882,"_17855":48638,"_24230":48639,"_2452":48640},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca","Review and create the CA",{"_2926":2236,"_25561":2229,"_5":25882,"_17855":48642,"_24230":48643,"_2452":48644},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result","Verify the result",{"_2926":2237,"_25561":2229,"_5":25882,"_17855":48646,"_24230":48647,"_2452":48648},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_2926":2238,"_25561":2229,"_5":25882,"_17855":48650,"_24230":48651,"_2452":46381},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_2926":2239,"_25561":2229,"_5":25882,"_17855":48653,"_24230":48654,"_2452":41685},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_2926":2240,"_25561":2229,"_17855":48656,"_5":17750,"_24230":2229,"_2452":48657},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_2926":2241,"_25561":2229,"_17855":48659,"_5":17750,"_24230":48624,"_2452":48660},[],"Console access and permission to create keys and authorities.",{"_2926":2242,"_25561":2229,"_17855":48662,"_5":17750,"_24230":48624,"_2452":48663},[],"An available cryptographic engine that supports the chosen algorithm.",{"_2926":2243,"_25561":2229,"_17855":48665,"_5":17750,"_24230":48624,"_2452":48666},[],"OpenSSL 3.x to check the downloaded certificate.",{"_2926":2244,"_25561":2229,"_17855":48668,"_5":17750,"_24230":48624,"_2452":48669},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_2926":2245,"_25561":2229,"_17855":48671,"_5":17750,"_24230":48627,"_2452":48672},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_2926":2246,"_25561":2229,"_17855":48674,"_5":17750,"_24230":48627,"_2452":48675},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_2926":2247,"_25561":2229,"_17855":48677,"_5":17750,"_24230":48631,"_2452":48678},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_2926":2248,"_25561":2229,"_17855":48680,"_5":17750,"_24230":48631,"_2452":48681},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_2926":2249,"_25561":2229,"_17855":48683,"_5":17750,"_24230":48635,"_2452":48684},[],"Select **Root CA** and complete:",{"_2926":2250,"_25561":2229,"_17855":48686,"_5":17750,"_24230":48635,"_2452":48687},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_2926":2251,"_25561":2229,"_17855":48689,"_5":17750,"_24230":48635,"_2452":48690},[],"**Subject**: organization and country details for your evaluation.",{"_2926":2252,"_25561":2229,"_17855":48692,"_5":17750,"_24230":48635,"_2452":48693},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_2926":2253,"_25561":2229,"_17855":48695,"_5":17750,"_24230":48635,"_2452":48696},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_2926":2254,"_25561":2229,"_17855":48698,"_5":17750,"_24230":48635,"_2452":48699},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_2926":2255,"_25561":2229,"_17855":48701,"_5":17750,"_24230":48639,"_2452":48702},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_2926":2256,"_25561":2229,"_17855":48704,"_5":17750,"_24230":48643,"_2452":48705},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_2926":2257,"_25561":2229,"_17855":48707,"_5":17750,"_24230":48643,"_2452":48708},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_2926":2258,"_25561":2229,"_17855":48710,"_5":17750,"_24230":48647,"_2452":48711},[],"Run from the directory where you saved `ca.pem`:",{"_2926":2259,"_25561":2229,"_17855":48713,"_5":17750,"_24230":48647,"_2452":48714},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_2926":2260,"_25561":2229,"_17855":48716,"_5":17750,"_24230":48647,"_2452":48717},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_2926":2261,"_25561":2229,"_17855":48719,"_5":17750,"_24230":48651,"_2452":48720},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_2926":2262,"_25561":2229,"_17855":48722,"_5":17750,"_24230":48651,"_2452":48723},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_2926":2263,"_25561":2229,"_17855":48725,"_5":17750,"_24230":48651,"_2452":48726},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_2926":2264,"_25561":2229,"_17855":48728,"_5":17750,"_24230":48651,"_2452":48729},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_2926":2265,"_25561":2229,"_17855":48731,"_5":17750,"_24230":48654,"_2452":48732},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_2926":2266,"_25561":2266,"_5":12525,"_2452":48734,"_25885":48735,"_17855":48736,"_24230":2266},"Issue and verify a certificate",[41651,42995,46688,46123],[],{"_2926":2267,"_25561":2266,"_17855":48738,"_5":17750,"_24230":2266,"_2452":48739},[],"Issue a client certificate and check content, chain and key correspondence.",{"_2926":2268,"_25561":2266,"_5":25882,"_17855":48741,"_24230":48742,"_2452":41661},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_2926":2269,"_25561":2266,"_5":25882,"_17855":48744,"_24230":48745,"_2452":48746},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_2926":2270,"_25561":2266,"_5":25882,"_17855":48748,"_24230":48749,"_2452":48750},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_2926":2271,"_25561":2266,"_5":25882,"_17855":48752,"_24230":48753,"_2452":48754},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_2926":2272,"_25561":2266,"_5":25882,"_17855":48756,"_24230":48757,"_2452":48758},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_2926":2273,"_25561":2266,"_5":25882,"_17855":48760,"_24230":48761,"_2452":48762},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_2926":2274,"_25561":2266,"_5":25882,"_17855":48764,"_24230":48765,"_2452":48644},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result",{"_2926":2275,"_25561":2266,"_5":25882,"_17855":48767,"_24230":48768,"_2452":48769},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_2926":2276,"_25561":2266,"_5":25882,"_17855":48771,"_24230":48772,"_2452":48773},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_2926":2277,"_25561":2266,"_5":25882,"_17855":48775,"_24230":48776,"_2452":48777},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_2926":2278,"_25561":2266,"_5":25882,"_17855":48779,"_24230":48780,"_2452":46381},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_2926":2279,"_25561":2266,"_5":25882,"_17855":48782,"_24230":48783,"_2452":41685},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_2926":2280,"_25561":2266,"_17855":48785,"_5":17750,"_24230":2266,"_2452":48786},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_2926":2281,"_25561":2266,"_17855":48788,"_5":17750,"_24230":48742,"_2452":48789},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_2926":2282,"_25561":2266,"_17855":48791,"_5":17750,"_24230":48742,"_2452":48792},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_2926":2283,"_25561":2266,"_17855":48794,"_5":17750,"_24230":48742,"_2452":48795},[],"OpenSSL 3.x and a working directory with restricted access.",{"_2926":2284,"_25561":2266,"_17855":48797,"_5":17750,"_24230":48742,"_2452":48798},[],"A client identifier: here we use `device-001`.",{"_2926":2285,"_25561":2266,"_17855":48800,"_5":17750,"_24230":48742,"_2452":48801},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_2926":2286,"_25561":2266,"_17855":48803,"_5":17750,"_24230":48745,"_2452":48804},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_2926":2287,"_25561":2266,"_17855":48806,"_5":17750,"_24230":48749,"_2452":48807},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_2926":2288,"_25561":2266,"_17855":48809,"_5":17750,"_24230":48749,"_2452":48810},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_2926":2289,"_25561":2266,"_17855":48812,"_5":17750,"_24230":48753,"_2452":48813},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_2926":2290,"_25561":2266,"_17855":48815,"_5":17750,"_24230":48753,"_2452":48816},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_2926":2291,"_25561":2266,"_17855":48818,"_5":17750,"_24230":48757,"_2452":48819},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_2926":2292,"_25561":2266,"_17855":48821,"_5":17750,"_24230":48757,"_2452":48822},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_2926":2293,"_25561":2266,"_17855":48824,"_5":17750,"_24230":48761,"_2452":48825},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_2926":2294,"_25561":2266,"_17855":48827,"_5":17750,"_24230":48765,"_2452":48828},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_2926":2295,"_25561":2266,"_17855":48830,"_5":17750,"_24230":48768,"_2452":48831},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_2926":2296,"_25561":2266,"_17855":48833,"_5":17750,"_24230":48772,"_2452":48834},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_2926":2297,"_25561":2266,"_17855":48836,"_5":17750,"_24230":48772,"_2452":48837},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_2926":2298,"_25561":2266,"_17855":48839,"_5":17750,"_24230":48772,"_2452":48840},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_2926":2299,"_25561":2266,"_17855":48842,"_5":17750,"_24230":48776,"_2452":48843},[],"In Bash, compare the two public-key digests:",{"_2926":2300,"_25561":2266,"_17855":48845,"_5":17750,"_24230":48776,"_2452":48846},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_2926":2301,"_25561":2266,"_17855":48848,"_5":17750,"_24230":48776,"_2452":48849},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_2926":2302,"_25561":2266,"_17855":48851,"_5":17750,"_24230":48780,"_2452":46465},[],{"_2926":2303,"_25561":2266,"_17855":48853,"_5":17750,"_24230":48780,"_2452":48854},[],"What to review",{"_2926":2304,"_25561":2266,"_17855":48856,"_5":17750,"_24230":48780,"_2452":48857},[],"The CA rejects issuance",{"_2926":2305,"_25561":2266,"_17855":48859,"_5":17750,"_24230":48780,"_2452":48860},[],"Permissions, CA state and key, algorithm and profile.",{"_2926":2306,"_25561":2266,"_17855":48862,"_5":17750,"_24230":48780,"_2452":48863},[],"Different subject or usages",{"_2926":2307,"_25561":2266,"_17855":48865,"_5":17750,"_24230":48780,"_2452":48866},[],"Applied profile and requested values.",{"_2926":2308,"_25561":2266,"_17855":48868,"_5":17750,"_24230":48780,"_2452":48869},[],"Issuer cannot be found",{"_2926":2309,"_25561":2266,"_17855":48871,"_5":17750,"_24230":48780,"_2452":48872},[],"Downloaded CA and required intermediate chain.",{"_2926":2310,"_25561":2266,"_17855":48874,"_5":17750,"_24230":48780,"_2452":48875},[],"Validity fails",{"_2926":2311,"_25561":2266,"_17855":48877,"_5":17750,"_24230":48780,"_2452":48878},[],"Certificate and CA dates, and the computer's clock.",{"_2926":2312,"_25561":2266,"_17855":48880,"_5":17750,"_24230":48780,"_2452":48881},[],"Public-key digests differ",{"_2926":2313,"_25561":2266,"_17855":48883,"_5":17750,"_24230":48780,"_2452":48884},[],"Certificate and key files from the same issuance.",{"_2926":2314,"_25561":2266,"_17855":48886,"_5":17750,"_24230":48780,"_2452":48887},[],"See PKI diagnostics to narrow an issuance failure.",{"_2926":2315,"_25561":2266,"_17855":48889,"_5":17750,"_24230":48783,"_2452":48890},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_2926":2316,"_25561":2266,"_17855":48892,"_5":17750,"_24230":48783,"_2452":48893},[],"Manage certificates for inspection, status and revocation.",{"_2926":2317,"_25561":2266,"_17855":48895,"_5":17750,"_24230":48783,"_2452":48896},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_2926":2318,"_25561":2266,"_17855":48898,"_5":17750,"_24230":48783,"_2452":48899},[],"Prepare EST for the device to request its next identities.",{"_2926":2319,"_25561":2266,"_17855":48901,"_5":17750,"_24230":48783,"_2452":48902},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_2926":2320,"_25561":2320,"_5":12525,"_2452":48904,"_25885":48905,"_17855":48906,"_24230":2320},"PKI getting started",[41651,42995,46688,46123],[],{"_2926":2321,"_25561":2320,"_17855":48908,"_5":17750,"_24230":2320,"_2452":48909},[],"Create a CA, issue a client certificate and check its chain and key.",{"_2926":2322,"_25561":2320,"_5":25882,"_17855":48911,"_24230":48912,"_2452":41661},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_2926":2323,"_25561":2320,"_5":25882,"_17855":48914,"_24230":48915,"_2452":48916},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_2926":2324,"_25561":2320,"_5":25882,"_17855":48918,"_24230":48919,"_2452":46315},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_2926":2325,"_25561":2320,"_5":25882,"_17855":48921,"_24230":48922,"_2452":48923},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_2926":2326,"_25561":2320,"_17855":48925,"_5":17750,"_24230":2320,"_2452":48926},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_2926":2327,"_25561":2320,"_17855":48928,"_5":17750,"_24230":48912,"_2452":48929},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_2926":2328,"_25561":2320,"_17855":48931,"_5":17750,"_24230":48912,"_2452":48932},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_2926":2329,"_25561":2320,"_17855":48934,"_5":17750,"_24230":48912,"_2452":48935},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_2926":2330,"_25561":2320,"_17855":48937,"_5":17750,"_24230":48912,"_2452":48938},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_2926":2331,"_25561":2320,"_17855":48940,"_5":17750,"_24230":48912,"_2452":48941},[],"A working directory with restricted access for the downloaded key.",{"_2926":2332,"_25561":2320,"_17855":48943,"_5":17750,"_24230":48915,"_2452":48944},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_2926":2333,"_25561":2320,"_17855":48946,"_5":17750,"_24230":48915,"_2452":48947},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_2926":2334,"_25561":2320,"_17855":48949,"_5":17750,"_24230":48915,"_2452":48950},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_2926":2335,"_25561":2320,"_17855":48952,"_5":17750,"_24230":48915,"_2452":48953},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_2926":2336,"_25561":2320,"_17855":48955,"_5":17750,"_24230":48919,"_2452":48956},[],"File or resource",{"_2926":2337,"_25561":2320,"_17855":48958,"_5":17750,"_24230":48919,"_2452":46312},[],{"_2926":2338,"_25561":2320,"_17855":48960,"_5":17750,"_24230":48919,"_2452":48961},[],"Active root CA and `ca.pem`",{"_2926":2339,"_25561":2320,"_17855":48963,"_5":17750,"_24230":48919,"_2452":48964},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_2926":2340,"_25561":2320,"_17855":48966,"_5":17750,"_24230":48919,"_2452":48967},[],"End-entity certificate and `device.crt`",{"_2926":2341,"_25561":2320,"_17855":48969,"_5":17750,"_24230":48919,"_2452":48970},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_2926":2342,"_25561":2320,"_17855":48972,"_5":17750,"_24230":48919,"_2452":48973},[],"Private key `device.key`",{"_2926":2343,"_25561":2320,"_17855":48975,"_5":17750,"_24230":48919,"_2452":48976},[],"Its public key matches the one included in `device.crt`.",{"_2926":2344,"_25561":2320,"_17855":48978,"_5":17750,"_24230":48919,"_2452":48979},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_2926":2345,"_25561":2320,"_17855":48981,"_5":17750,"_24230":48922,"_2452":48982},[],"To operate certificates, continue with Certificates and Validation.",{"_2926":2346,"_25561":2320,"_17855":48984,"_5":17750,"_24230":48922,"_2452":48985},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_2926":2347,"_25561":2320,"_17855":48987,"_5":17750,"_24230":48922,"_2452":48988},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_2926":2348,"_25561":2348,"_5":12525,"_2452":48990,"_25885":48991,"_17855":48992,"_24230":2348},"PKI troubleshooting",[41651,42995,46688,45509],[],{"_2926":2349,"_25561":2348,"_17855":48994,"_5":17750,"_24230":2348,"_2452":48995},[],"Diagnose certificate issuance, OCSP and CRL.",{"_2926":2350,"_25561":2348,"_5":25882,"_17855":48997,"_24230":48998,"_2452":48999},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_2926":2351,"_25561":2348,"_5":25882,"_17855":49001,"_24230":49002,"_2452":49003},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_2926":2352,"_25561":2348,"_5":25882,"_17855":49005,"_24230":49006,"_2452":49007},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_2926":2353,"_25561":2348,"_17855":49009,"_5":17750,"_24230":2348,"_2452":49010},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_2926":2354,"_25561":2348,"_17855":49012,"_5":17750,"_24230":2348,"_2452":49013},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_2926":2355,"_25561":2348,"_17855":49015,"_5":17750,"_24230":48998,"_2452":46312},[],{"_2926":2356,"_25561":2348,"_17855":49017,"_5":17750,"_24230":48998,"_2452":49018},[],"What to inspect",{"_2926":2357,"_25561":2348,"_17855":49020,"_5":17750,"_24230":48998,"_2452":41685},[],{"_2926":2358,"_25561":2348,"_17855":49022,"_5":17750,"_24230":48998,"_2452":49023},[],"CA",{"_2926":2359,"_25561":2348,"_17855":49025,"_5":17750,"_24230":48998,"_2452":49026},[],"Exists, is active and has usable dates.",{"_2926":2360,"_25561":2348,"_17855":49028,"_5":17750,"_24230":48998,"_2452":49029},[],"Authorities.",{"_2926":2361,"_25561":2348,"_17855":49031,"_5":17750,"_24230":48998,"_2452":49032},[],"Key",{"_2926":2362,"_25561":2348,"_17855":49034,"_5":17750,"_24230":48998,"_2452":49035},[],"The record has a usable private key and the engine can sign.",{"_2926":2363,"_25561":2348,"_17855":49037,"_5":17750,"_24230":48998,"_2452":49038},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_2926":2364,"_25561":2348,"_17855":49040,"_5":17750,"_24230":48998,"_2452":49041},[],"CSR",{"_2926":2365,"_25561":2348,"_17855":49043,"_5":17750,"_24230":48998,"_2452":49044},[],"Correct PEM and verifiable signature.",{"_2926":2366,"_25561":2348,"_17855":49046,"_5":17750,"_24230":48998,"_2452":49047},[],"`openssl req -in request.csr -noout -verify -text`.",{"_2926":2367,"_25561":2348,"_17855":49049,"_5":17750,"_24230":48998,"_2452":49050},[],"Profile",{"_2926":2368,"_25561":2348,"_17855":49052,"_5":17750,"_24230":48998,"_2452":49053},[],"Selected source, existing ID, allowed algorithm and size.",{"_2926":2369,"_25561":2348,"_17855":49055,"_5":17750,"_24230":48998,"_2452":49056},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_2926":2370,"_25561":2348,"_17855":49058,"_5":17750,"_24230":48998,"_2452":46465},[],{"_2926":2371,"_25561":2348,"_17855":49060,"_5":17750,"_24230":48998,"_2452":49061},[],"Appropriate subject, SAN, usages and dates.",{"_2926":2372,"_25561":2348,"_17855":49063,"_5":17750,"_24230":48998,"_2452":49064},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_2926":2373,"_25561":2348,"_17855":49066,"_5":17750,"_24230":48998,"_2452":49067},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_2926":2374,"_25561":2348,"_17855":49069,"_5":17750,"_24230":48998,"_2452":49070},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_2926":2375,"_25561":2348,"_17855":49072,"_5":17750,"_24230":49002,"_2452":49073},[],"Check each boundary independently:",{"_2926":2376,"_25561":2348,"_17855":49075,"_5":17750,"_24230":49002,"_2452":49076},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_2926":2377,"_25561":2348,"_17855":49078,"_5":17750,"_24230":49002,"_2452":49079},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_2926":2378,"_25561":2348,"_17855":49081,"_5":17750,"_24230":49002,"_2452":49082},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_2926":2379,"_25561":2348,"_17855":49084,"_5":17750,"_24230":49002,"_2452":49085},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_2926":2380,"_25561":2348,"_17855":49087,"_5":17750,"_24230":49002,"_2452":49088},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_2926":2381,"_25561":2348,"_17855":49090,"_5":17750,"_24230":49002,"_2452":49091},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_2926":2382,"_25561":2348,"_17855":49093,"_5":17750,"_24230":49006,"_2452":49094},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_2926":2383,"_25561":2348,"_17855":49096,"_5":17750,"_24230":49006,"_2452":49097},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_2926":2384,"_25561":2384,"_5":12525,"_2452":49099,"_25885":49100,"_17855":49102,"_24230":2384},"3.8.0 to 4.0.0",[41651,49101],"Upgrades",[],{"_2926":2385,"_25561":2384,"_17855":49104,"_5":17750,"_24230":2384,"_2452":49105},[],"4.0.0 changes that affect DMS configuration, what can break after upgrading from 3.8.0, and how to verify it.",{"_2926":2386,"_25561":2384,"_5":25882,"_17855":49107,"_24230":49108,"_2452":49109},[],"/docs/upgrades/3-8-0-to-4-0-0#summary","Summary",{"_2926":2387,"_25561":2384,"_5":25882,"_17855":49111,"_24230":49112,"_2452":49113},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_2926":2388,"_25561":2384,"_5":25882,"_17855":49115,"_24230":49116,"_2452":49117},[],"/docs/upgrades/3-8-0-to-4-0-0#webhooks-with-file-references","Webhooks with file references",{"_2926":2389,"_25561":2384,"_5":25882,"_17855":49119,"_24230":49120,"_2452":49121},[],"/docs/upgrades/3-8-0-to-4-0-0#receiver-certificate-verification","Receiver certificate verification",{"_2926":2390,"_25561":2384,"_5":25882,"_17855":49123,"_24230":49124,"_2452":49125},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_2926":2391,"_25561":2384,"_5":25882,"_17855":49127,"_24230":49128,"_2452":49129},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_2926":2392,"_25561":2384,"_5":25882,"_17855":49131,"_24230":49132,"_2452":49133},[],"/docs/upgrades/3-8-0-to-4-0-0#verification-checklist","Verification checklist",{"_2926":2393,"_25561":2384,"_17855":49135,"_5":17750,"_24230":2384,"_2452":49136},[],"Upgrading from 3.8.0 to 4.0.0 automatically migrates stored DMS configuration. Most of it converts without intervention, but three changes can leave enrollments failing or configs holding unexpected values if they are not reviewed. This page states what changes, what symptoms to expect and what to do in each case. Current behavior of each feature is documented in the DMS pages.",{"_2926":2394,"_25561":2384,"_17855":49138,"_5":17750,"_24230":49108,"_2452":49139},[],"Change",{"_2926":2395,"_25561":2384,"_17855":49141,"_5":17750,"_24230":49108,"_2452":49142},[],"Who is affected",{"_2926":2396,"_25561":2384,"_17855":49144,"_5":17750,"_24230":49108,"_2452":49145},[],"Severity",{"_2926":2397,"_25561":2384,"_17855":49147,"_5":17750,"_24230":49108,"_2452":49148},[],"Action",{"_2926":2398,"_25561":2384,"_17855":49150,"_5":17750,"_24230":49108,"_2452":49117},[],{"_2926":2399,"_25561":2384,"_17855":49152,"_5":17750,"_24230":49108,"_2452":49153},[],"DMSs with a webhook whose mTLS certificate or key were file paths",{"_2926":2400,"_25561":2384,"_17855":49155,"_5":17750,"_24230":49108,"_2452":49156},[],"High: enrollments and re-enrollments calling the webhook fail",{"_2926":2401,"_25561":2384,"_17855":49158,"_5":17750,"_24230":49108,"_2452":49159},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_2926":2402,"_25561":2384,"_17855":49161,"_5":17750,"_24230":49108,"_2452":49121},[],{"_2926":2403,"_25561":2384,"_17855":49163,"_5":17750,"_24230":49108,"_2452":49164},[],"DMSs with a webhook that had `validate_server_cert: false`",{"_2926":2404,"_25561":2384,"_17855":49166,"_5":17750,"_24230":49108,"_2452":49167},[],"Medium: webhook credentials are sent to an unverified receiver",{"_2926":2405,"_25561":2384,"_17855":49169,"_5":17750,"_24230":49108,"_2452":49170},[],"Set `insecure_skip_verify` to `false`",{"_2926":2406,"_25561":2384,"_17855":49172,"_5":17750,"_24230":49108,"_2452":49125},[],{"_2926":2407,"_25561":2384,"_17855":49174,"_5":17750,"_24230":49108,"_2452":49175},[],"Scripts and consoles that edit DMSs through the API",{"_2926":2408,"_25561":2384,"_17855":49177,"_5":17750,"_24230":49108,"_2452":49178},[],"Medium: an edit in the old layout silently empties `validation_cas`",{"_2926":2409,"_25561":2384,"_17855":49180,"_5":17750,"_24230":49108,"_2452":49181},[],"Read the DMS before editing and use the new field",{"_2926":2410,"_25561":2384,"_17855":49183,"_5":17750,"_24230":49108,"_2452":49129},[],{"_2926":2411,"_25561":2384,"_17855":49185,"_5":17750,"_24230":49108,"_2452":49186},[],"Any DMS",{"_2926":2412,"_25561":2384,"_17855":49188,"_5":17750,"_24230":49108,"_2452":49189},[],"Low: informational",{"_2926":2413,"_25561":2384,"_17855":49191,"_5":17750,"_24230":49108,"_2452":49192},[],"Read both blocks before editing",{"_2926":2414,"_25561":2384,"_17855":49194,"_5":17750,"_24230":49108,"_2452":49195},[],"A verification checklist at the end confirms the result.",{"_2926":2415,"_25561":2384,"_17855":49197,"_5":17750,"_24230":49112,"_2452":49198},[],"Stored webhook configs are rewritten to the current layout. Fields are renamed as follows:",{"_2926":2416,"_25561":2384,"_17855":49200,"_5":17750,"_24230":49112,"_2452":49201},[],"Field in 3.8.0",{"_2926":2417,"_25561":2384,"_17855":49203,"_5":17750,"_24230":49112,"_2452":49204},[],"Field in 4.0.0",{"_2926":2418,"_25561":2384,"_17855":49206,"_5":17750,"_24230":49112,"_2452":49207},[],"`validate_server_cert`",{"_2926":2419,"_25561":2384,"_17855":49209,"_5":17750,"_24230":49112,"_2452":49210},[],"`insecure_skip_verify` (value negated)",{"_2926":2420,"_25561":2384,"_17855":49212,"_5":17750,"_24230":49112,"_2452":49213},[],"`oidc`",{"_2926":2421,"_25561":2384,"_17855":49215,"_5":17750,"_24230":49112,"_2452":49216},[],"`jwt_options`",{"_2926":2422,"_25561":2384,"_17855":49218,"_5":17750,"_24230":49112,"_2452":49219},[],"`apikey`",{"_2926":2423,"_25561":2384,"_17855":49221,"_5":17750,"_24230":49112,"_2452":49222},[],"`apikey_options`",{"_2926":2424,"_25561":2384,"_17855":49224,"_5":17750,"_24230":49112,"_2452":49225},[],"`mtls`",{"_2926":2425,"_25561":2384,"_17855":49227,"_5":17750,"_24230":49112,"_2452":49228},[],"`mtls_options`",{"_2926":2426,"_25561":2384,"_17855":49230,"_5":17750,"_24230":49112,"_2452":49231},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. The two cases below do need it.",{"_2926":2427,"_25561":2384,"_17855":49233,"_5":17750,"_24230":49116,"_2452":49234},[],"A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields, and does so on every call, whatever the configured authentication mode. As a result, every enroll and re-enroll that calls that webhook fails until the config is fixed.",{"_2926":2428,"_25561":2384,"_17855":49236,"_5":17750,"_24230":49116,"_2452":49237},[],"There are two ways to fix it, depending on the webhook:",{"_2926":2429,"_25561":2384,"_17855":49239,"_5":17750,"_24230":49116,"_2452":49240},[],"If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM.",{"_2926":2430,"_25561":2384,"_17855":49242,"_5":17750,"_24230":49116,"_2452":49243},[],"If the webhook does not use mTLS, remove the leftover file fields.",{"_2926":2431,"_25561":2384,"_17855":49245,"_5":17750,"_24230":49116,"_2452":49246},[],"Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`).",{"_2926":2432,"_25561":2384,"_17855":49248,"_5":17750,"_24230":49116,"_2452":49249},[],"A variant of the same problem exists: if the stored config holds file paths inside `mtls_options.cert_content` or `mtls_options.key_content`, every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fails validation. Settings are replaced wholesale, so the stored config must be resent with the certificate and key as PEM.",{"_2926":2433,"_25561":2384,"_17855":49251,"_5":17750,"_24230":49120,"_2452":49252},[],"A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`. Receiver certificate verification therefore stays skipped until that field is set to `false`.",{"_2926":2434,"_25561":2384,"_17855":49254,"_5":17750,"_24230":49120,"_2452":49255},[],"It should be corrected on every migrated config. The webhook authorization channel carries the API key or bearer token, so skipping verification exposes those credentials to a network-positioned attacker. Keeping `insecure_skip_verify: true` is only justified when the receiver certificate is deliberately unverifiable.",{"_2926":2435,"_25561":2384,"_17855":49257,"_5":17750,"_24230":49124,"_2452":49258},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`.",{"_2926":2436,"_25561":2384,"_17855":49260,"_5":17750,"_24230":49124,"_2452":49261},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_2926":2437,"_25561":2384,"_17855":49263,"_5":17750,"_24230":49124,"_2452":49264},[],"What does change is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently ignored because unknown JSON fields are dropped, and GET responses no longer include it. Consequently, an update body built from the old layout empties `validation_cas` without returning any error. To avoid it, always read the DMS before sending an edit and reuse the layout the API returns.",{"_2926":2438,"_25561":2384,"_17855":49266,"_5":17750,"_24230":49128,"_2452":49267},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but both blocks should be read before editing a DMS so that one is not modified while believing the other is being edited.",{"_2926":2439,"_25561":2384,"_17855":49269,"_5":17750,"_24230":49128,"_2452":49270},[],"If the console version does not expose independent settings, they can be edited through the DMS API.",{"_2926":2440,"_25561":2384,"_17855":49272,"_5":17750,"_24230":49132,"_2452":49273},[],"After applying the upgrade, check in this order:",{"_2926":2441,"_25561":2384,"_17855":49275,"_5":17750,"_24230":49132,"_2452":49276},[],"**Webhooks without file fields.** List the DMSs that use a webhook for enrollment or re-enrollment and confirm each `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_2926":2442,"_25561":2384,"_17855":49278,"_5":17750,"_24230":49132,"_2452":49279},[],"**Receiver verification.** Confirm `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_2926":2443,"_25561":2384,"_17855":49281,"_5":17750,"_24230":49132,"_2452":49282},[],"**Delivery.** Trigger, or wait for, one enroll or re-enroll through each migrated webhook and confirm the authorization call completes.",{"_2926":2444,"_25561":2384,"_17855":49284,"_5":17750,"_24230":49132,"_2452":49285},[],"**Trust set.** Read `est_rfc7030_settings.client_certificate_settings.validation_cas` and confirm it holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_2926":2445,"_25561":2384,"_17855":49287,"_5":17750,"_24230":49132,"_2452":49288},[],"**API clients.** Update any script or console that uses the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), since they silently drop those values.",{"_2926":2446,"_25561":2384,"_17855":49290,"_5":17750,"_24230":49132,"_2452":45982},[],{"_2926":2447,"_25561":2384,"_17855":49292,"_5":17750,"_24230":49132,"_2452":49293},[],"<Card title=\"DMS API\" href=\"/docs/api-reference/dms-manager\" />","count","sorting",{"_49297":49298,"_49299":49300,"_49301":49302,"_49303":49304,"_15501":2474,"_59050":2474},"language","english","sortableProperties",[2452,25561,5,24230],"sortablePropertiesWithTypes",{"_2452":21321,"_25561":21321,"_5":21321,"_24230":21321},"sorts",{"_2452":49305,"_25561":51742,"_5":54178,"_24230":56614},{"_3906":49306,"_49307":49308,"_5":21321},{"_12265":5505,"_12618":4089,"_12625":5802,"_24781":5938,"_24343":2817,"_16955":4289,"_12286":2796,"_12293":6564,"_24743":3993,"_25104":23546,"_25125":6015,"_24756":3526,"_29425":6008,"_25136":7964,"_29430":25290,"_29433":4919,"_29436":6370,"_29439":4092,"_29442":2699,"_25437":14186,"_29447":3815,"_29449":4993,"_25467":2691,"_25427":5810,"_29453":2779,"_2945