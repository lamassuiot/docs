2,"_26136":34415,"_26138":34419,"_26140":34422,"_26142":34425,"_26144":34429,"_26146":34433,"_26148":34437,"_26150":34441,"_26152":34445,"_26154":34448,"_26156":34451,"_26158":34454,"_26160":34457,"_26162":34460,"_26164":34463,"_26166":34466,"_26168":34469,"_26170":34472,"_26172":34475,"_26174":34478,"_26176":34481,"_26178":34484,"_26180":34487,"_26182":34490,"_26184":34494,"_26186":34498,"_26188":34502,"_26190":34505,"_26192":34508,"_26194":34511,"_26196":34514},{"_3357":11,"_21031":11,"_5":21226,"_1362":30290,"_21239":30291,"_17751":30295,"_8158":11},"Despliega desde AWS Marketplace",[30292,30293,30294],"Docs","Despliegue","Otros modelos",[],{"_3357":12,"_21031":11,"_17751":30297,"_5":21231,"_8158":11,"_1362":30298},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3357":13,"_21031":11,"_5":21236,"_17751":30300,"_8158":30301,"_1362":30302},[],"/docs/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3357":14,"_21031":11,"_5":21236,"_17751":30304,"_8158":30305,"_1362":30306},[],"/docs/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3357":15,"_21031":11,"_5":21236,"_17751":30308,"_8158":30309,"_1362":30310},[],"/docs/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3357":16,"_21031":11,"_5":21236,"_17751":30312,"_8158":30313,"_1362":30314},[],"/docs/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3357":17,"_21031":11,"_5":21236,"_17751":30316,"_8158":30317,"_1362":30318},[],"/docs/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3357":18,"_21031":11,"_5":21236,"_17751":30320,"_8158":30321,"_1362":30322},[],"/docs/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3357":19,"_21031":11,"_5":21236,"_17751":30324,"_8158":30325,"_1362":30326},[],"/docs/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3357":20,"_21031":11,"_17751":30328,"_5":21231,"_8158":11,"_1362":30329},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3357":21,"_21031":11,"_17751":30331,"_5":21231,"_8158":30301,"_1362":30332},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3357":22,"_21031":11,"_17751":30334,"_5":21231,"_8158":30301,"_1362":30335},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3357":23,"_21031":11,"_17751":30337,"_5":21231,"_8158":30301,"_1362":30338},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3357":24,"_21031":11,"_17751":30340,"_5":21231,"_8158":30305,"_1362":30341},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3357":25,"_21031":11,"_17751":30343,"_5":21231,"_8158":30305,"_1362":30344},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3357":26,"_21031":11,"_17751":30346,"_5":21231,"_8158":30305,"_1362":30347},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3357":27,"_21031":11,"_17751":30349,"_5":21231,"_8158":30309,"_1362":30350},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3357":28,"_21031":11,"_17751":30352,"_5":21231,"_8158":30313,"_1362":30353},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3357":29,"_21031":11,"_17751":30355,"_5":21231,"_8158":30317,"_1362":30356},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3357":30,"_21031":11,"_17751":30358,"_5":21231,"_8158":30321,"_1362":30359},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3357":31,"_21031":11,"_17751":30361,"_5":21231,"_8158":30325,"_1362":30362},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3357":32,"_21031":32,"_5":21226,"_1362":30364,"_21239":30365,"_17751":30366,"_8158":32},"Despliega Lamassu",[30292,30293],[],{"_3357":33,"_21031":32,"_17751":30368,"_5":21231,"_8158":32,"_1362":30369},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3357":34,"_21031":32,"_5":21236,"_17751":30371,"_8158":30372,"_1362":30373},[],"/docs/deployment/overview#elige-un-modelo","Elige un modelo",{"_3357":35,"_21031":32,"_5":21236,"_17751":30375,"_8158":30376,"_1362":30377},[],"/docs/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3357":36,"_21031":32,"_5":21236,"_17751":30379,"_8158":30380,"_1362":30381},[],"/docs/deployment/overview#después-del-despliegue","Después del despliegue",{"_3357":37,"_21031":32,"_17751":30383,"_5":21231,"_8158":32,"_1362":30384},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3357":38,"_21031":32,"_17751":30386,"_5":21231,"_8158":30372,"_1362":30387},[],"Modelo",{"_3357":39,"_21031":32,"_17751":30389,"_5":21231,"_8158":30372,"_1362":30390},[],"Recomendado para",{"_3357":40,"_21031":32,"_17751":30392,"_5":21231,"_8158":30372,"_1362":30393},[],"Quién opera la infraestructura",{"_3357":41,"_21031":32,"_17751":30395,"_5":21231,"_8158":30372,"_1362":30396},[],"Punto de partida",{"_3357":42,"_21031":32,"_17751":30398,"_5":21231,"_8158":30372,"_1362":30399},[],"Kubernetes self-managed",{"_3357":43,"_21031":32,"_17751":30401,"_5":21231,"_8158":30372,"_1362":30402},[],"Producción, entornos regulados y despliegues personalizados",{"_3357":44,"_21031":32,"_17751":30404,"_5":21231,"_8158":30372,"_1362":30405},[],"Tu equipo",{"_3357":45,"_21031":32,"_17751":30407,"_5":21231,"_8158":30372,"_1362":30408},[],"Helm o Fastlane",{"_3357":46,"_21031":32,"_17751":30410,"_5":21231,"_8158":30372,"_1362":30411},[],"AWS Marketplace",{"_3357":47,"_21031":32,"_17751":30413,"_5":21231,"_8158":30372,"_1362":30414},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3357":48,"_21031":32,"_17751":30416,"_5":21231,"_8158":30372,"_1362":30405},[],{"_3357":49,"_21031":32,"_17751":30418,"_5":21231,"_8158":30372,"_1362":30419},[],"Imagen preconfigurada en EC2",{"_3357":50,"_21031":32,"_17751":30421,"_5":21231,"_8158":30372,"_1362":30422},[],"SaaS",{"_3357":51,"_21031":32,"_17751":30424,"_5":21231,"_8158":30372,"_1362":30425},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3357":52,"_21031":32,"_17751":30427,"_5":21231,"_8158":30372,"_1362":30428},[],"Lamassu",{"_3357":53,"_21031":32,"_17751":30430,"_5":21231,"_8158":30372,"_1362":30431},[],"Suscripción gestionada",{"_3357":54,"_21031":32,"_17751":30433,"_5":21231,"_8158":30372,"_1362":30434},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3357":55,"_21031":32,"_17751":30436,"_5":21231,"_8158":30372,"_1362":30437},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3357":56,"_21031":32,"_17751":30439,"_5":21231,"_8158":30372,"_1362":30440},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3357":57,"_21031":32,"_17751":30442,"_5":21231,"_8158":30376,"_1362":30443},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3357":58,"_21031":32,"_17751":30445,"_5":21231,"_8158":30380,"_1362":30446},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3357":59,"_21031":59,"_5":21226,"_1362":30448,"_21239":30449,"_17751":30450,"_8158":59},"Utiliza Lamassu como SaaS",[30292,30293,30294],[],{"_3357":60,"_21031":59,"_17751":30452,"_5":21231,"_8158":59,"_1362":30453},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3357":61,"_21031":59,"_5":21236,"_17751":30455,"_8158":30456,"_1362":30457},[],"/docs/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3357":62,"_21031":59,"_5":21236,"_17751":30459,"_8158":30460,"_1362":30461},[],"/docs/deployment/saas#planes","Planes",{"_3357":63,"_21031":59,"_5":21236,"_17751":30463,"_8158":30464,"_1362":30465},[],"/docs/deployment/saas#solicita-acceso","Solicita acceso",{"_3357":64,"_21031":59,"_17751":30467,"_5":21231,"_8158":59,"_1362":30468},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3357":65,"_21031":59,"_17751":30470,"_5":21231,"_8158":30456,"_1362":30471},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3357":66,"_21031":59,"_17751":30473,"_5":21231,"_8158":30456,"_1362":30474},[],"Copias de seguridad automáticas.",{"_3357":67,"_21031":59,"_17751":30476,"_5":21231,"_8158":30456,"_1362":30477},[],"Actualizaciones de versión.",{"_3357":68,"_21031":59,"_17751":30479,"_5":21231,"_8158":30456,"_1362":30480},[],"Soporte técnico y SLA según el plan contratado.",{"_3357":69,"_21031":59,"_17751":30482,"_5":21231,"_8158":30460,"_1362":30483},[],"Plan",{"_3357":70,"_21031":59,"_17751":30485,"_5":21231,"_8158":30460,"_1362":30486},[],"Dispositivos",{"_3357":71,"_21031":59,"_17751":30488,"_5":21231,"_8158":30460,"_1362":30489},[],"Soporte",{"_3357":72,"_21031":59,"_17751":30491,"_5":21231,"_8158":30460,"_1362":30492},[],"SLA",{"_3357":73,"_21031":59,"_17751":30494,"_5":21231,"_8158":30460,"_1362":30495},[],"Starter",{"_3357":74,"_21031":59,"_17751":30497,"_5":21231,"_8158":30460,"_1362":30498},[],"Hasta 1.000",{"_3357":75,"_21031":59,"_17751":30500,"_5":21231,"_8158":30460,"_1362":30501},[],"Email",{"_3357":76,"_21031":59,"_17751":30503,"_5":21231,"_8158":30460,"_1362":30504},[],"99,5 %",{"_3357":77,"_21031":59,"_17751":30506,"_5":21231,"_8158":30460,"_1362":30507},[],"Professional",{"_3357":78,"_21031":59,"_17751":30509,"_5":21231,"_8158":30460,"_1362":30510},[],"Hasta 10.000",{"_3357":79,"_21031":59,"_17751":30512,"_5":21231,"_8158":30460,"_1362":30513},[],"Email y chat",{"_3357":80,"_21031":59,"_17751":30515,"_5":21231,"_8158":30460,"_1362":30516},[],"99,9 %",{"_3357":81,"_21031":59,"_17751":30518,"_5":21231,"_8158":30460,"_1362":30519},[],"Enterprise",{"_3357":82,"_21031":59,"_17751":30521,"_5":21231,"_8158":30460,"_1362":30522},[],"Ilimitados",{"_3357":83,"_21031":59,"_17751":30524,"_5":21231,"_8158":30460,"_1362":30525},[],"Dedicado",{"_3357":84,"_21031":59,"_17751":30527,"_5":21231,"_8158":30460,"_1362":30528},[],"99,99 %",{"_3357":85,"_21031":59,"_17751":30530,"_5":21231,"_8158":30464,"_1362":30531},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3357":86,"_21031":59,"_17751":30533,"_5":21231,"_8158":30464,"_1362":30534},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3357":87,"_21031":87,"_5":21226,"_1362":30536,"_21239":30537,"_17751":30538,"_8158":87},"Fastlane",[30292,30293,30399],[],{"_3357":88,"_21031":87,"_17751":30540,"_5":21231,"_8158":87,"_1362":30541},[],"Referencia del script scripts/lamassu-fast-lane.sh para desplegar Lamassu PKI de forma automatizada en Kubernetes",{"_3357":89,"_21031":87,"_5":21236,"_17751":30543,"_8158":30544,"_1362":30545},[],"/docs/deployment/self-hosted/fastlane#fastlane---despliegue-automatizado-en-kubernetes","Fastlane - Despliegue automatizado en Kubernetes",{"_3357":90,"_21031":87,"_5":21236,"_17751":30547,"_8158":30548,"_1362":30549},[],"/docs/deployment/self-hosted/fastlane#flags-de-línea-de-comandos","Flags de línea de comandos",{"_3357":91,"_21031":87,"_5":21236,"_17751":30551,"_8158":30552,"_1362":30553},[],"/docs/deployment/self-hosted/fastlane#detección-de-distribución-kubernetes","Detección de distribución Kubernetes",{"_3357":92,"_21031":87,"_5":21236,"_17751":30555,"_8158":30556,"_1362":30557},[],"/docs/deployment/self-hosted/fastlane#verificación-de-dependencias","Verificación de dependencias",{"_3357":93,"_21031":87,"_5":21236,"_17751":30559,"_8158":30560,"_1362":30561},[],"/docs/deployment/self-hosted/fastlane#addons-obligatorios-en-microk8s","Addons obligatorios en MicroK8s",{"_3357":94,"_21031":87,"_5":21236,"_17751":30563,"_8158":30564,"_1362":30565},[],"/docs/deployment/self-hosted/fastlane#modo-interactivo-vs-no-interactivo","Modo interactivo vs no interactivo",{"_3357":95,"_21031":87,"_5":21236,"_17751":30567,"_8158":30568,"_1362":30569},[],"/docs/deployment/self-hosted/fastlane#modo-interactivo-por-defecto","Modo interactivo (por defecto)",{"_3357":96,"_21031":87,"_5":21236,"_17751":30571,"_8158":30572,"_1362":30573},[],"/docs/deployment/self-hosted/fastlane#modo-no-interactivo--n","Modo no interactivo (`-n`)",{"_3357":97,"_21031":87,"_5":21236,"_17751":30575,"_8158":30576,"_1362":30577},[],"/docs/deployment/self-hosted/fastlane#modo-online-vs-offline","Modo online vs offline",{"_3357":98,"_21031":87,"_5":21236,"_17751":30579,"_8158":30580,"_1362":30581},[],"/docs/deployment/self-hosted/fastlane#modo-online-por-defecto","Modo online (por defecto)",{"_3357":99,"_21031":87,"_5":21236,"_17751":30583,"_8158":30584,"_1362":30585},[],"/docs/deployment/self-hosted/fastlane#modo-offline","Modo offline",{"_3357":100,"_21031":87,"_5":21236,"_17751":30587,"_8158":30588,"_1362":30589},[],"/docs/deployment/self-hosted/fastlane#instalación-de-componentes","Instalación de componentes",{"_3357":101,"_21031":87,"_5":21236,"_17751":30591,"_8158":30592,"_1362":30593},[],"/docs/deployment/self-hosted/fastlane#postgresql-install_postgresql","PostgreSQL (`install_postgresql`)",{"_3357":102,"_21031":87,"_5":21236,"_17751":30595,"_8158":30596,"_1362":30597},[],"/docs/deployment/self-hosted/fastlane#keycloak-install_keycloak","Keycloak (`install_keycloak`)",{"_3357":103,"_21031":87,"_5":21236,"_17751":30599,"_8158":30600,"_1362":30601},[],"/docs/deployment/self-hosted/fastlane#rabbitmq-install_rabbitmq","RabbitMQ (`install_rabbitmq`)",{"_3357":104,"_21031":87,"_5":21236,"_17751":30603,"_8158":30604,"_1362":30605},[],"/docs/deployment/self-hosted/fastlane#lamassu-install_lamassu","Lamassu (`install_lamassu`)",{"_3357":105,"_21031":87,"_5":21236,"_17751":30607,"_8158":30608,"_1362":30609},[],"/docs/deployment/self-hosted/fastlane#configuración-tls","Configuración TLS",{"_3357":106,"_21031":87,"_5":21236,"_17751":30611,"_8158":30612,"_1362":30613},[],"/docs/deployment/self-hosted/fastlane#certificado-externo","Certificado externo",{"_3357":107,"_21031":87,"_5":21236,"_17751":30615,"_8158":30616,"_1362":30617},[],"/docs/deployment/self-hosted/fastlane#certificado-gestionado-por-cert-manager","Certificado gestionado por cert-manager",{"_3357":108,"_21031":87,"_5":21236,"_17751":30619,"_8158":30620,"_1362":30621},[],"/docs/deployment/self-hosted/fastlane#salida-tras-la-instalación","Salida tras la instalación",{"_3357":109,"_21031":87,"_5":21236,"_17751":30623,"_8158":30624,"_1362":30625},[],"/docs/deployment/self-hosted/fastlane#uso-en-ci","Uso en CI",{"_3357":110,"_21031":87,"_5":21236,"_17751":30627,"_8158":30628,"_1362":30629},[],"/docs/deployment/self-hosted/fastlane#ejemplo-rápido","Ejemplo rápido",{"_3357":111,"_21031":87,"_5":21236,"_17751":30631,"_8158":30632,"_1362":30633},[],"/docs/deployment/self-hosted/fastlane#resumen","Resumen",{"_3357":112,"_21031":87,"_17751":30635,"_5":21231,"_8158":30544,"_1362":30636},[],"Esta sección documenta el script `scripts/lamassu-fast-lane.sh`, cuyo objetivo es desplegar de forma automatizada una pila completa de Lamassu PKI sobre un clúster Kubernetes ya existente, con intervención manual mínima.",{"_3357":113,"_21031":87,"_17751":30638,"_5":21231,"_8158":30544,"_1362":30639},[],"La instalación incluye:",{"_3357":114,"_21031":87,"_17751":30641,"_5":21231,"_8158":30544,"_1362":30642},[],"PostgreSQL",{"_3357":115,"_21031":87,"_17751":30644,"_5":21231,"_8158":30544,"_1362":30645},[],"Keycloak",{"_3357":116,"_21031":87,"_17751":30647,"_5":21231,"_8158":30544,"_1362":30648},[],"RabbitMQ",{"_3357":117,"_21031":87,"_17751":30650,"_5":21231,"_8158":30544,"_1362":30651},[],"Chart Helm de Lamassu",{"_3357":118,"_21031":87,"_17751":30653,"_5":21231,"_8158":30548,"_1362":30654},[],"Todos los parámetros son procesados por la función `process_flags`.",{"_3357":119,"_21031":87,"_17751":30656,"_5":21231,"_8158":30548,"_1362":30657},[],"Flag",{"_3357":120,"_21031":87,"_17751":30659,"_5":21231,"_8158":30548,"_1362":30660},[],"Valor por defecto",{"_3357":121,"_21031":87,"_17751":30662,"_5":21231,"_8158":30548,"_1362":30663},[],"Descripción",{"_3357":122,"_21031":87,"_17751":30665,"_5":21231,"_8158":30548,"_1362":30666},[],"`-h`, `--help`",{"_3357":123,"_21031":87,"_17751":30668,"_5":21231,"_8158":30548,"_1362":2767},[],{"_3357":124,"_21031":87,"_17751":30670,"_5":21231,"_8158":30548,"_1362":30671},[],"Muestra la ayuda y finaliza",{"_3357":125,"_21031":87,"_17751":30673,"_5":21231,"_8158":30548,"_1362":30674},[],"`-n`, `--non-interactive`",{"_3357":126,"_21031":87,"_17751":30676,"_5":21231,"_8158":30548,"_1362":30677},[],"`false`",{"_3357":127,"_21031":87,"_17751":30679,"_5":21231,"_8158":30548,"_1362":30680},[],"Omite prompts y genera/usa credenciales por defecto",{"_3357":128,"_21031":87,"_17751":30682,"_5":21231,"_8158":30548,"_1362":30683},[],"`-ns`, `--namespace`",{"_3357":129,"_21031":87,"_17751":30685,"_5":21231,"_8158":30548,"_1362":30686},[],"`lamassu-dev`",{"_3357":130,"_21031":87,"_17751":30688,"_5":21231,"_8158":30548,"_1362":30689},[],"Namespace Kubernetes donde se despliegan los recursos",{"_3357":131,"_21031":87,"_17751":30691,"_5":21231,"_8158":30548,"_1362":30692},[],"`-d`, `--domain`",{"_3357":132,"_21031":87,"_17751":30694,"_5":21231,"_8158":30548,"_1362":30695},[],"`dev.lamassu.io`",{"_3357":133,"_21031":87,"_17751":30697,"_5":21231,"_8158":30548,"_1362":30698},[],"Dominio usado para endpoint y certificados TLS",{"_3357":134,"_21031":87,"_17751":30700,"_5":21231,"_8158":30548,"_1362":30701},[],"`-v`, `--version`",{"_3357":135,"_21031":87,"_17751":30703,"_5":21231,"_8158":30548,"_1362":30704},[],"`latest`",{"_3357":136,"_21031":87,"_17751":30706,"_5":21231,"_8158":30548,"_1362":30707},[],"Versión del chart Helm de Lamassu",{"_3357":137,"_21031":87,"_17751":30709,"_5":21231,"_8158":30548,"_1362":30710},[],"`--https-port`",{"_3357":138,"_21031":87,"_17751":30712,"_5":21231,"_8158":30548,"_1362":30713},[],"`443`",{"_3357":139,"_21031":87,"_17751":30715,"_5":21231,"_8158":30548,"_1362":30716},[],"Puerto HTTPS del gateway",{"_3357":140,"_21031":87,"_17751":30718,"_5":21231,"_8158":30548,"_1362":30719},[],"`--http-port`",{"_3357":141,"_21031":87,"_17751":30721,"_5":21231,"_8158":30548,"_1362":30722},[],"`80`",{"_3357":142,"_21031":87,"_17751":30724,"_5":21231,"_8158":30548,"_1362":30725},[],"Puerto HTTP del gateway",{"_3357":143,"_21031":87,"_17751":30727,"_5":21231,"_8158":30548,"_1362":30728},[],"`--offline`",{"_3357":144,"_21031":87,"_17751":30730,"_5":21231,"_8158":30548,"_1362":30677},[],{"_3357":145,"_21031":87,"_17751":30732,"_5":21231,"_8158":30548,"_1362":30733},[],"Activa modo offline",{"_3357":146,"_21031":87,"_17751":30735,"_5":21231,"_8158":30548,"_1362":30736},[],"`--tls-crt`",{"_3357":147,"_21031":87,"_17751":30738,"_5":21231,"_8158":30548,"_1362":2767},[],{"_3357":148,"_21031":87,"_17751":30740,"_5":21231,"_8158":30548,"_1362":30741},[],"Ruta al certificado TLS (PEM)",{"_3357":149,"_21031":87,"_17751":30743,"_5":21231,"_8158":30548,"_1362":30744},[],"`--tls-key`",{"_3357":150,"_21031":87,"_17751":30746,"_5":21231,"_8158":30548,"_1362":2767},[],{"_3357":151,"_21031":87,"_17751":30748,"_5":21231,"_8158":30548,"_1362":30749},[],"Ruta a la clave privada TLS (PEM)",{"_3357":152,"_21031":87,"_17751":30751,"_5":21231,"_8158":30548,"_1362":30752},[],"`--helm-chart-lamassu`",{"_3357":153,"_21031":87,"_17751":30754,"_5":21231,"_8158":30548,"_1362":2767},[],{"_3357":154,"_21031":87,"_17751":30756,"_5":21231,"_8158":30548,"_1362":30757},[],"Ruta a chart local Lamassu (`.tgz`)",{"_3357":155,"_21031":87,"_17751":30759,"_5":21231,"_8158":30548,"_1362":30760},[],"`--helm-chart-postgres`",{"_3357":156,"_21031":87,"_17751":30762,"_5":21231,"_8158":30548,"_1362":2767},[],{"_3357":157,"_21031":87,"_17751":30764,"_5":21231,"_8158":30548,"_1362":30765},[],"Ruta a chart local PostgreSQL (`.tgz`)",{"_3357":158,"_21031":87,"_17751":30767,"_5":21231,"_8158":30548,"_1362":30768},[],"`--helm-chart-keycloak`",{"_3357":159,"_21031":87,"_17751":30770,"_5":21231,"_8158":30548,"_1362":2767},[],{"_3357":160,"_21031":87,"_17751":30772,"_5":21231,"_8158":30548,"_1362":30773},[],"Ruta a chart local Keycloak (`.tgz`)",{"_3357":161,"_21031":87,"_17751":30775,"_5":21231,"_8158":30548,"_1362":30776},[],"`--helm-chart-rabbitmq`",{"_3357":162,"_21031":87,"_17751":30778,"_5":21231,"_8158":30548,"_1362":2767},[],{"_3357":163,"_21031":87,"_17751":30780,"_5":21231,"_8158":30548,"_1362":30781},[],"Ruta a chart local RabbitMQ (`.tgz`)",{"_3357":164,"_21031":87,"_17751":30783,"_5":21231,"_8158":30548,"_1362":30784},[],"`-l`, `--local-chart-path`",{"_3357":165,"_21031":87,"_17751":30786,"_5":21231,"_8158":30548,"_1362":2767},[],{"_3357":166,"_21031":87,"_17751":30788,"_5":21231,"_8158":30548,"_1362":30789},[],"Ruta a directorio local descomprimido del chart Lamassu",{"_3357":167,"_21031":87,"_17751":30791,"_5":21231,"_8158":30552,"_1362":30792},[],"La función `detect_distribution` identifica la distribución con el siguiente orden de prioridad:",{"_3357":168,"_21031":87,"_17751":30794,"_5":21231,"_8158":30552,"_1362":30795},[],"`microk8s`",{"_3357":169,"_21031":87,"_17751":30797,"_5":21231,"_8158":30552,"_1362":30798},[],"`k3s`",{"_3357":170,"_21031":87,"_17751":30800,"_5":21231,"_8158":30552,"_1362":30801},[],"`kind`",{"_3357":171,"_21031":87,"_17751":30803,"_5":21231,"_8158":30552,"_1362":30804},[],"Kubernetes estándar",{"_3357":172,"_21031":87,"_17751":30806,"_5":21231,"_8158":30552,"_1362":30807},[],"Comportamientos específicos:",{"_3357":173,"_21031":87,"_17751":30809,"_5":21231,"_8158":30552,"_1362":30810},[],"En `microk8s`, los comandos se ejecutan con prefijos `microk8s kubectl` y `microk8s helm`.",{"_3357":174,"_21031":87,"_17751":30812,"_5":21231,"_8158":30552,"_1362":30813},[],"En `kind`, el script muestra una advertencia de uso exclusivo para pruebas.",{"_3357":175,"_21031":87,"_17751":30815,"_5":21231,"_8158":30556,"_1362":30816},[],"La función `check_dependencies` valida prerequisitos según la distribución detectada.",{"_3357":176,"_21031":87,"_17751":30818,"_5":21231,"_8158":30556,"_1362":30819},[],"Requisitos generales:",{"_3357":177,"_21031":87,"_17751":30821,"_5":21231,"_8158":30556,"_1362":30822},[],"`yq`",{"_3357":178,"_21031":87,"_17751":30824,"_5":21231,"_8158":30556,"_1362":30825},[],"CLI de la distribución detectada",{"_3357":179,"_21031":87,"_17751":30827,"_5":21231,"_8158":30556,"_1362":30828},[],"Los requisitos específicos dependen de la distribución: `k3s` necesita `kubectl` y `helm`, mientras que `microk8s` utiliza `microk8s kubectl` y `microk8s helm`.",{"_3357":180,"_21031":87,"_17751":30830,"_5":21231,"_8158":30560,"_1362":30831},[],"Se valida que estén habilitados:",{"_3357":181,"_21031":87,"_17751":30833,"_5":21231,"_8158":30560,"_1362":30834},[],"`helm`",{"_3357":182,"_21031":87,"_17751":30836,"_5":21231,"_8158":30560,"_1362":30837},[],"`hostpath-storage`",{"_3357":183,"_21031":87,"_17751":30839,"_5":21231,"_8158":30560,"_1362":30840},[],"`dns`",{"_3357":184,"_21031":87,"_17751":30842,"_5":21231,"_8158":30560,"_1362":30843},[],"`cert-manager`",{"_3357":185,"_21031":87,"_17751":30845,"_5":21231,"_8158":30560,"_1362":30846},[],"También se verifica un release Helm de Envoy Gateway llamado `eg` en el namespace `envoy-gateway-system`.\nSi no existe, se instala automáticamente la versión `v1.3.0` y se crea un `GatewayClass` llamado `eg`.",{"_3357":186,"_21031":87,"_17751":30848,"_5":21231,"_8158":30568,"_1362":30849},[],"La función `request_config_data` solicita:",{"_3357":187,"_21031":87,"_17751":30851,"_5":21231,"_8158":30568,"_1362":30852},[],"Dominio Lamassu",{"_3357":188,"_21031":87,"_17751":30854,"_5":21231,"_8158":30568,"_1362":30855},[],"Usuario y contraseña admin PostgreSQL",{"_3357":189,"_21031":87,"_17751":30857,"_5":21231,"_8158":30568,"_1362":30858},[],"Usuario y contraseña admin RabbitMQ",{"_3357":190,"_21031":87,"_17751":30860,"_5":21231,"_8158":30568,"_1362":30861},[],"Usuario y contraseña admin Keycloak",{"_3357":191,"_21031":87,"_17751":30863,"_5":21231,"_8158":30568,"_1362":30864},[],"Namespace Kubernetes",{"_3357":192,"_21031":87,"_17751":30866,"_5":21231,"_8158":30572,"_1362":30867},[],"Se generan credenciales aleatorias de 30 caracteres alfanuméricos.",{"_3357":193,"_21031":87,"_17751":30869,"_5":21231,"_8158":30572,"_1362":30870},[],"Se usan valores por defecto para dominio y namespace, salvo que se sobrescriban con flags.",{"_3357":194,"_21031":87,"_17751":30872,"_5":21231,"_8158":30576,"_1362":30873},[],"El script admite dos estrategias para obtener charts Helm.",{"_3357":195,"_21031":87,"_17751":30875,"_5":21231,"_8158":30580,"_1362":30876},[],"Los charts se descargan desde repositorios remotos.",{"_3357":196,"_21031":87,"_17751":30878,"_5":21231,"_8158":30584,"_1362":30879},[],"Requiere obligatoriamente rutas a los cuatro charts:",{"_3357":197,"_21031":87,"_17751":30881,"_5":21231,"_8158":30584,"_1362":30752},[],{"_3357":198,"_21031":87,"_17751":30883,"_5":21231,"_8158":30584,"_1362":30760},[],{"_3357":199,"_21031":87,"_17751":30885,"_5":21231,"_8158":30584,"_1362":30768},[],{"_3357":200,"_21031":87,"_17751":30887,"_5":21231,"_8158":30584,"_1362":30776},[],{"_3357":201,"_21031":87,"_17751":30889,"_5":21231,"_8158":30584,"_1362":30890},[],"Si falta cualquiera de ellos, el script finaliza con error.",{"_3357":202,"_21031":87,"_17751":30892,"_5":21231,"_8158":30584,"_1362":30893},[],"En este modo se fuerza:",{"_3357":203,"_21031":87,"_17751":30895,"_5":21231,"_8158":30592,"_1362":30896},[],"Chart: `oci://registry-1.docker.io/cloudpirates/postgres`",{"_3357":204,"_21031":87,"_17751":30898,"_5":21231,"_8158":30592,"_1362":30899},[],"Versión del chart: `0.19.0`",{"_3357":205,"_21031":87,"_17751":30901,"_5":21231,"_8158":30592,"_1362":30902},[],"Release: `postgres`",{"_3357":206,"_21031":87,"_17751":30904,"_5":21231,"_8158":30592,"_1362":30905},[],"`fullnameOverride: \"postgresql\"`",{"_3357":207,"_21031":87,"_17751":30907,"_5":21231,"_8158":30592,"_1362":30908},[],"El script SQL de inicialización crea una base de datos por servicio: `auth` para Keycloak, `alerts` para Alerts, `ca` para CA, `va` para VA, `cloudproxy` para Cloud Proxy, `devicemanager` para Device Manager, `dmsmanager` para DMS Manager y `kms` para KMS.",{"_3357":208,"_21031":87,"_17751":30910,"_5":21231,"_8158":30596,"_1362":30911},[],"Chart: `oci://registry-1.docker.io/cloudpirates/keycloak`",{"_3357":209,"_21031":87,"_17751":30913,"_5":21231,"_8158":30596,"_1362":30914},[],"Versión del chart: `0.20.0`",{"_3357":210,"_21031":87,"_17751":30916,"_5":21231,"_8158":30596,"_1362":30917},[],"Release: `auth`",{"_3357":211,"_21031":87,"_17751":30919,"_5":21231,"_8158":30596,"_1362":30920},[],"Uso de base de datos externa: `postgresql:5432/auth`",{"_3357":212,"_21031":87,"_17751":30922,"_5":21231,"_8158":30596,"_1362":30923},[],"Imagen de Keycloak fijada en `keycloak/keycloak:26.6.0`",{"_3357":213,"_21031":87,"_17751":30925,"_5":21231,"_8158":30596,"_1362":30926},[],"`httpRelativePath: /auth/`",{"_3357":214,"_21031":87,"_17751":30928,"_5":21231,"_8158":30596,"_1362":30929},[],"`proxyHeaders: xforwarded`",{"_3357":215,"_21031":87,"_17751":30931,"_5":21231,"_8158":30596,"_1362":30932},[],"Configuración automática del realm `lamassu`:",{"_3357":216,"_21031":87,"_17751":30934,"_5":21231,"_8158":30596,"_1362":30935},[],"Rol: `pki-admin`",{"_3357":217,"_21031":87,"_17751":30937,"_5":21231,"_8158":30596,"_1362":30938},[],"Usuario inicial: `lamassu` / `lamassu` (cambio obligatorio)",{"_3357":218,"_21031":87,"_17751":30940,"_5":21231,"_8158":30596,"_1362":30941},[],"Cliente público: `frontend` con `/*` en redirect URIs",{"_3357":219,"_21031":87,"_17751":30943,"_5":21231,"_8158":30596,"_1362":30944},[],"En modo online se descarga automáticamente un tema personalizado desde:",{"_3357":220,"_21031":87,"_17751":30946,"_5":21231,"_8158":30596,"_1362":30947},[],"`github.com/lamassuiot/keycloak-theme`",{"_3357":221,"_21031":87,"_17751":30949,"_5":21231,"_8158":30600,"_1362":30950},[],"Chart: `oci://registry-1.docker.io/cloudpirates/rabbitmq`",{"_3357":222,"_21031":87,"_17751":30952,"_5":21231,"_8158":30600,"_1362":30914},[],{"_3357":223,"_21031":87,"_17751":30954,"_5":21231,"_8158":30600,"_1362":30955},[],"Release: `rabbitmq`",{"_3357":224,"_21031":87,"_17751":30957,"_5":21231,"_8158":30600,"_1362":30958},[],"`fullnameOverride: \"rabbitmq\"`",{"_3357":225,"_21031":87,"_17751":30960,"_5":21231,"_8158":30600,"_1362":30961},[],"Credenciales inyectadas dinámicamente mediante `yq`",{"_3357":226,"_21031":87,"_17751":30963,"_5":21231,"_8158":30604,"_1362":30964},[],"Se genera un archivo `lamassu.yaml` que se pasa a `helm install`.",{"_3357":227,"_21031":87,"_17751":30966,"_5":21231,"_8158":30604,"_1362":30967},[],"Configuraciones principales:",{"_3357":228,"_21031":87,"_17751":30969,"_5":21231,"_8158":30604,"_1362":30970},[],"PostgreSQL: host `postgresql`, puerto `5432`",{"_3357":229,"_21031":87,"_17751":30972,"_5":21231,"_8158":30604,"_1362":30973},[],"AMQP: host `rabbitmq`, puerto `5672`, TLS deshabilitado",{"_3357":230,"_21031":87,"_17751":30975,"_5":21231,"_8158":30604,"_1362":30976},[],"OIDC JWKS:\n`http://auth-keycloak.<NAMESPACE>/auth/realms/lamassu/protocol/openid-connect/certs`",{"_3357":231,"_21031":87,"_17751":30978,"_5":21231,"_8158":30604,"_1362":30979},[],"Ruta adicional de gateway: `/auth -> auth-keycloak:8080`",{"_3357":232,"_21031":87,"_17751":30981,"_5":21231,"_8158":30604,"_1362":30982},[],"Direcciones de gateway: IP(s) obtenidas con `hostname -I`",{"_3357":233,"_21031":87,"_17751":30984,"_5":21231,"_8158":30604,"_1362":30985},[],"Puertos de gateway: desde `--https-port` y `--http-port`",{"_3357":234,"_21031":87,"_17751":30987,"_5":21231,"_8158":30604,"_1362":30988},[],"Dominios CA: valor de `--domain`",{"_3357":235,"_21031":87,"_17751":30990,"_5":21231,"_8158":30604,"_1362":30991},[],"Cuando se ejecuta en modo online y no se usa `--local-chart-path`, el script añade el repositorio Helm:",{"_3357":236,"_21031":87,"_17751":30993,"_5":21231,"_8158":30604,"_1362":30994},[],"Después instala el release `lamassu` usando la versión indicada por `--version` si se ha proporcionado.",{"_3357":237,"_21031":87,"_17751":30996,"_5":21231,"_8158":30604,"_1362":30997},[],"Si `--https-port` es distinto de `443`, el puerto se añade al dominio antes de escribirlo en `values`.",{"_3357":238,"_21031":87,"_17751":30999,"_5":21231,"_8158":30612,"_1362":31000},[],"Si se proporcionan:",{"_3357":239,"_21031":87,"_17751":31002,"_5":21231,"_8158":30612,"_1362":30736},[],{"_3357":240,"_21031":87,"_17751":31004,"_5":21231,"_8158":30612,"_1362":30744},[],{"_3357":241,"_21031":87,"_17751":31006,"_5":21231,"_8158":30612,"_1362":31007},[],"Se crea un secret Kubernetes:",{"_3357":242,"_21031":87,"_17751":31009,"_5":21231,"_8158":30612,"_1362":31010},[],"`downstream-provided-crt`",{"_3357":243,"_21031":87,"_17751":31012,"_5":21231,"_8158":30612,"_1362":31013},[],"Y se configura:",{"_3357":244,"_21031":87,"_17751":31015,"_5":21231,"_8158":30616,"_1362":31016},[],"Si no se proporciona certificado:",{"_3357":245,"_21031":87,"_17751":31018,"_5":21231,"_8158":30616,"_1362":31019},[],"Además, el script crea un `Issuer` self-signed y el recurso `Certificate`.",{"_3357":246,"_21031":87,"_17751":31021,"_5":21231,"_8158":30616,"_1362":31022},[],"Si el usuario quiere reutilizar un `Issuer` o `ClusterIssuer` corporativo, ese flujo no lo automatiza Fastlane; en ese caso es preferible un despliegue manual del chart con un archivo `values.yaml` propio.",{"_3357":247,"_21031":87,"_17751":31024,"_5":21231,"_8158":30620,"_1362":31025},[],"En caso de éxito, se muestra:",{"_3357":248,"_21031":87,"_17751":31027,"_5":21231,"_8158":30620,"_1362":31028},[],"URL de Lamassu UI: `https://<DOMAIN>`",{"_3357":249,"_21031":87,"_17751":31030,"_5":21231,"_8158":30620,"_1362":31031},[],"Credenciales iniciales: `lamassu / lamassu`",{"_3357":250,"_21031":87,"_17751":31033,"_5":21231,"_8158":30620,"_1362":31034},[],"Consola Keycloak: `https://<DOMAIN>/auth/admin`",{"_3357":251,"_21031":87,"_17751":31036,"_5":21231,"_8158":30620,"_1362":31037},[],"Credenciales admin de Keycloak",{"_3357":252,"_21031":87,"_17751":31039,"_5":21231,"_8158":30620,"_1362":31040},[],"El usuario `lamassu` se crea con:",{"_3357":253,"_21031":87,"_17751":31042,"_5":21231,"_8158":30620,"_1362":31043},[],"Por tanto, debe cambiar contraseña en el primer acceso.",{"_3357":254,"_21031":87,"_17751":31045,"_5":21231,"_8158":30624,"_1362":31046},[],"El script está pensado también para validaciones rápidas y smoke tests locales. Tras la instalación puede ejecutarse:",{"_3357":255,"_21031":87,"_17751":31048,"_5":21231,"_8158":30624,"_1362":31049},[],"El chart incluye una prueba que valida conectividad contra `ca`, `dms-manager`, `device-manager`, `va` y `ui`.",{"_3357":256,"_21031":87,"_17751":31051,"_5":21231,"_8158":30624,"_1362":31052},[],"Ejemplo:",{"_3357":257,"_21031":87,"_17751":31054,"_5":21231,"_8158":30624,"_1362":31055},[],"En este escenario:",{"_3357":258,"_21031":87,"_17751":31057,"_5":21231,"_8158":30624,"_1362":31058},[],"`-n`: modo no interactivo",{"_3357":259,"_21031":87,"_17751":31060,"_5":21231,"_8158":30624,"_1362":31061},[],"`-ns`: namespace específico",{"_3357":260,"_21031":87,"_17751":31063,"_5":21231,"_8158":30624,"_1362":31064},[],"`-d`: dominio de CI",{"_3357":261,"_21031":87,"_17751":31066,"_5":21231,"_8158":30624,"_1362":31067},[],"`-l`: chart local",{"_3357":262,"_21031":87,"_17751":31069,"_5":21231,"_8158":30632,"_1362":31070},[],"`lamassu-fast-lane.sh` proporciona un mecanismo totalmente automatizado para desplegar un entorno Lamassu funcional en Kubernetes en pocos minutos, integrando base de datos, autenticación, mensajería, gateway y TLS.",{"_3357":263,"_21031":87,"_17751":31072,"_5":21231,"_8158":30632,"_1362":31073},[],"Está optimizado para rapidez, reproducibilidad y uso en entornos no productivos, con soporte para escenarios offline y pipelines de CI.",{"_3357":264,"_21031":264,"_5":21226,"_1362":30399,"_21239":31075,"_17751":31076,"_8158":264},[30292,30293,30399],[],{"_3357":265,"_21031":264,"_17751":31078,"_5":21231,"_8158":264,"_1362":31079},[],"Despliega Lamassu en tu propio clúster Kubernetes con Helm o Fastlane.",{"_3357":266,"_21031":264,"_5":21236,"_17751":31081,"_8158":31082,"_1362":31083},[],"/docs/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3357":267,"_21031":264,"_5":21236,"_17751":31085,"_8158":31086,"_1362":31087},[],"/docs/deployment/self-hosted/overview#quickstart","Quickstart",{"_3357":268,"_21031":264,"_5":21236,"_17751":31089,"_8158":31090,"_1362":31091},[],"/docs/deployment/self-hosted/overview#qué-se-despliega","Qué se despliega",{"_3357":269,"_21031":264,"_5":21236,"_17751":31093,"_8158":31094,"_1362":31095},[],"/docs/deployment/self-hosted/overview#requisitos-previos","Requisitos previos",{"_3357":270,"_21031":264,"_5":21236,"_17751":31097,"_8158":31098,"_1362":31099},[],"/docs/deployment/self-hosted/overview#opciones-de-despliegue","Opciones de despliegue",{"_3357":271,"_21031":264,"_5":21236,"_17751":31101,"_8158":31102,"_1362":31103},[],"/docs/deployment/self-hosted/overview#1-despliegue-manual-con-helm","1\\. Despliegue manual con Helm",{"_3357":272,"_21031":264,"_5":21236,"_17751":31105,"_8158":31106,"_1362":31107},[],"/docs/deployment/self-hosted/overview#2-despliegue-automatizado-con-fastlane","2\\. Despliegue automatizado con Fastlane",{"_3357":273,"_21031":264,"_5":21236,"_17751":31109,"_8158":31110,"_1362":31111},[],"/docs/deployment/self-hosted/overview#arquitectura","Arquitectura",{"_3357":274,"_21031":264,"_5":21236,"_17751":31113,"_8158":31114,"_1362":31115},[],"/docs/deployment/self-hosted/overview#instalación-manual-con-helm","Instalación manual con Helm",{"_3357":275,"_21031":264,"_5":21236,"_17751":31117,"_8158":31118,"_1362":31119},[],"/docs/deployment/self-hosted/overview#valores-mínimos-que-deben-definirse","Valores mínimos que deben definirse",{"_3357":276,"_21031":264,"_5":21236,"_17751":31121,"_8158":31122,"_1362":31123},[],"/docs/deployment/self-hosted/overview#áreas-de-configuración-más-relevantes","Áreas de configuración más relevantes",{"_3357":277,"_21031":264,"_5":21236,"_17751":31125,"_8158":31126,"_1362":31127},[],"/docs/deployment/self-hosted/overview#verificación-del-despliegue","Verificación del despliegue",{"_3357":278,"_21031":264,"_5":21236,"_17751":31129,"_8158":31130,"_1362":31131},[],"/docs/deployment/self-hosted/overview#repositorio-helm","Repositorio Helm",{"_3357":279,"_21031":264,"_5":21236,"_17751":31133,"_8158":31134,"_1362":31135},[],"/docs/deployment/self-hosted/overview#softhsm-como-complemento-opcional","SoftHSM como complemento opcional",{"_3357":280,"_21031":264,"_5":21236,"_17751":31137,"_8158":31138,"_1362":31139},[],"/docs/deployment/self-hosted/overview#versionado-y-migraciones","Versionado y migraciones",{"_3357":281,"_21031":264,"_17751":31141,"_5":21231,"_8158":31082,"_1362":31142},[],"Lamassu IoT puede desplegarse en infraestructura propia mediante **Kubernetes**, tanto en clústeres gestionados internamente como en entornos self-managed.",{"_3357":282,"_21031":264,"_17751":31144,"_5":21231,"_8158":31082,"_1362":31145},[],"La referencia principal para este despliegue es el repositorio `lamassu-helm`, que incluye:",{"_3357":283,"_21031":264,"_17751":31147,"_5":21231,"_8158":31082,"_1362":31148},[],"el chart principal de Lamassu",{"_3357":284,"_21031":264,"_17751":31150,"_5":21231,"_8158":31082,"_1362":31151},[],"un chart auxiliar de SoftHSM",{"_3357":285,"_21031":264,"_17751":31153,"_5":21231,"_8158":31082,"_1362":31154},[],"el script de despliegue automatizado `scripts/lamassu-fast-lane.sh`",{"_3357":286,"_21031":264,"_17751":31156,"_5":21231,"_8158":31086,"_1362":31157},[],"Si lo que necesitas es levantar un entorno funcional lo antes posible, la vía más rápida es usar Fastlane desde el repositorio `lamassu-helm`:",{"_3357":287,"_21031":264,"_17751":31159,"_5":21231,"_8158":31086,"_1362":31160},[],"Ese flujo:",{"_3357":288,"_21031":264,"_17751":31162,"_5":21231,"_8158":31086,"_1362":31163},[],"crea o reutiliza el namespace indicado",{"_3357":289,"_21031":264,"_17751":31165,"_5":21231,"_8158":31086,"_1362":31166},[],"instala PostgreSQL, Keycloak y RabbitMQ",{"_3357":290,"_21031":264,"_17751":31168,"_5":21231,"_8158":31086,"_1362":31169},[],"despliega el chart de Lamassu",{"_3357":291,"_21031":264,"_17751":31171,"_5":21231,"_8158":31086,"_1362":31172},[],"deja la UI expuesta en `https://<dominio>`",{"_3357":292,"_21031":264,"_17751":31174,"_5":21231,"_8158":31086,"_1362":31175},[],"Si buscas un despliegue productivo o más controlado, sigue con la instalación manual mediante Helm que se describe más abajo.",{"_3357":293,"_21031":264,"_17751":31177,"_5":21231,"_8158":31090,"_1362":31178},[],"El chart principal `charts/lamassu`, actualmente en la serie `3.7.x`, despliega estos componentes:",{"_3357":294,"_21031":264,"_17751":31180,"_5":21231,"_8158":31090,"_1362":31181},[],"`ui`",{"_3357":295,"_21031":264,"_17751":31183,"_5":21231,"_8158":31090,"_1362":31184},[],"`ca`",{"_3357":296,"_21031":264,"_17751":31186,"_5":21231,"_8158":31090,"_1362":31187},[],"`va`",{"_3357":297,"_21031":264,"_17751":31189,"_5":21231,"_8158":31090,"_1362":31190},[],"`kms`",{"_3357":298,"_21031":264,"_17751":31192,"_5":21231,"_8158":31090,"_1362":31193},[],"`device-manager`",{"_3357":299,"_21031":264,"_17751":31195,"_5":21231,"_8158":31090,"_1362":31196},[],"`dms-manager`",{"_3357":300,"_21031":264,"_17751":31198,"_5":21231,"_8158":31090,"_1362":31199},[],"`alerts`",{"_3357":301,"_21031":264,"_17751":31201,"_5":21231,"_8158":31090,"_1362":31202},[],"recursos de Gateway API y políticas de Envoy Gateway",{"_3357":302,"_21031":264,"_17751":31204,"_5":21231,"_8158":31090,"_1362":31205},[],"job de migraciones de base de datos",{"_3357":303,"_21031":264,"_17751":31207,"_5":21231,"_8158":31094,"_1362":31208},[],"Clúster Kubernetes `1.19+`",{"_3357":304,"_21031":264,"_17751":31210,"_5":21231,"_8158":31094,"_1362":31211},[],"`kubectl` configurado con acceso al clúster",{"_3357":305,"_21031":264,"_17751":31213,"_5":21231,"_8158":31094,"_1362":31214},[],"Helm `3.2.0+`",{"_3357":306,"_21031":264,"_17751":31216,"_5":21231,"_8158":31094,"_1362":31217},[],"`cert-manager 1.14+` para la gestión de certificados cuando se usa `tls.type=certManager`",{"_3357":307,"_21031":264,"_17751":31219,"_5":21231,"_8158":31094,"_1362":31220},[],"`Envoy Gateway 1.3.0+`, ya que el chart publica servicios mediante Gateway API y no mediante Ingress",{"_3357":308,"_21031":264,"_17751":31222,"_5":21231,"_8158":31094,"_1362":31223},[],"Acceso a un registro de contenedores o imágenes previamente importadas si se trabaja en modo offline",{"_3357":309,"_21031":264,"_17751":31225,"_5":21231,"_8158":31094,"_1362":31226},[],"Almacenamiento persistente disponible para PostgreSQL, RabbitMQ, VA y KMS",{"_3357":310,"_21031":264,"_17751":31228,"_5":21231,"_8158":31098,"_1362":31229},[],"Hay dos formas de desplegar Lamassu on-prem:",{"_3357":311,"_21031":264,"_17751":31231,"_5":21231,"_8158":31102,"_1362":31232},[],"Es la opción recomendada para entornos productivos o controlados, donde PostgreSQL, RabbitMQ, Keycloak, certificados y direccionamiento del Gateway ya están definidos por el equipo de plataforma.",{"_3357":312,"_21031":264,"_17751":31234,"_5":21231,"_8158":31106,"_1362":31235},[],"Es la opción más útil para pruebas, demos, CI o bootstrap rápido de un entorno. Fastlane levanta PostgreSQL, Keycloak, RabbitMQ y Lamassu en un único flujo. Su comportamiento está documentado en la página siguiente.",{"_3357":313,"_21031":264,"_17751":31237,"_5":21231,"_8158":31110,"_1362":31238},[],"Lamassu IoT se despliega como un conjunto de microservicios Kubernetes independientes. El chart principal crea `Deployment`, `StatefulSet`, `Service`, `ConfigMap`, `HTTPRoute`, `Gateway`, certificados y recursos auxiliares según los valores definidos.",{"_3357":314,"_21031":264,"_17751":31240,"_5":21231,"_8158":31110,"_1362":31241},[],"Dependencias externas requeridas por el chart principal:",{"_3357":315,"_21031":264,"_17751":31243,"_5":21231,"_8158":31110,"_1362":30642},[],{"_3357":316,"_21031":264,"_17751":31245,"_5":21231,"_8158":31110,"_1362":30648},[],{"_3357":317,"_21031":264,"_17751":31247,"_5":21231,"_8158":31110,"_1362":31248},[],"proveedor OIDC, típicamente Keycloak",{"_3357":318,"_21031":264,"_17751":31250,"_5":21231,"_8158":31110,"_1362":31251},[],"El chart no instala estas dependencias por sí solo. Para un despliegue manual hay que provisionarlas antes. Si se busca un entorno funcional rápido para laboratorio o validación, el script Fastlane sí instala PostgreSQL, RabbitMQ y Keycloak además del chart de Lamassu.",{"_3357":319,"_21031":264,"_17751":31253,"_5":21231,"_8158":31114,"_1362":31254},[],"Agregar el repositorio Helm:",{"_3357":320,"_21031":264,"_17751":31256,"_5":21231,"_8158":31114,"_1362":31257},[],"O instalar desde una copia local del repositorio:",{"_3357":321,"_21031":264,"_17751":31259,"_5":21231,"_8158":31118,"_1362":31260},[],"Los valores por defecto del chart son deliberadamente incompletos para dependencias externas. Como mínimo, un despliegue manual debe definir:",{"_3357":322,"_21031":264,"_17751":31262,"_5":21231,"_8158":31118,"_1362":31263},[],"`postgres.hostname`, `postgres.username`, `postgres.password`",{"_3357":323,"_21031":264,"_17751":31265,"_5":21231,"_8158":31118,"_1362":31266},[],"`amqp.hostname`, `amqp.username`, `amqp.password`",{"_3357":324,"_21031":264,"_17751":31268,"_5":21231,"_8158":31118,"_1362":31269},[],"`auth.oidc.frontend.authority`",{"_3357":325,"_21031":264,"_17751":31271,"_5":21231,"_8158":31118,"_1362":31272},[],"`auth.oidc.apiGateway.jwks`",{"_3357":326,"_21031":264,"_17751":31274,"_5":21231,"_8158":31118,"_1362":31275},[],"`services.ca.domains`",{"_3357":327,"_21031":264,"_17751":31277,"_5":21231,"_8158":31118,"_1362":31278},[],"`gateway.addresses` o una estrategia equivalente de publicación según el clúster",{"_3357":328,"_21031":264,"_17751":31280,"_5":21231,"_8158":31118,"_1362":31281},[],"`tls.*` según se use `certManager` o certificado externo",{"_3357":329,"_21031":264,"_17751":31283,"_5":21231,"_8158":31118,"_1362":31284},[],"Ejemplo base:",{"_3357":330,"_21031":264,"_17751":31286,"_5":21231,"_8158":31122,"_1362":31287},[],"**TLS:** `tls.type`, `tls.certManagerOptions.*` y `tls.externalOptions.secretName` controlan el certificado *downstream* del Gateway.",{"_3357":331,"_21031":264,"_17751":31289,"_5":21231,"_8158":31122,"_1362":31290},[],"**Gateway:** `gateway.addresses`, `gateway.ports.*` y `gateway.extraRouting` publican la UI y las APIs mediante Envoy Gateway.",{"_3357":332,"_21031":264,"_17751":31292,"_5":21231,"_8158":31122,"_1362":31293},[],"**Persistencia:** `postgres.*` define la conexión a PostgreSQL.",{"_3357":333,"_21031":264,"_17751":31295,"_5":21231,"_8158":31122,"_1362":31296},[],"**Mensajería:** `amqp.*` configura la conexión a RabbitMQ.",{"_3357":334,"_21031":264,"_17751":31298,"_5":21231,"_8158":31122,"_1362":31299},[],"**Identidad:** `auth.oidc.frontend.*` y `auth.oidc.apiGateway.jwks` configuran el login y la validación JWT.",{"_3357":335,"_21031":264,"_17751":31301,"_5":21231,"_8158":31122,"_1362":31302},[],"**Autoridades:** `services.ca.domains` establece los dominios autorizados para CA y certificados.",{"_3357":336,"_21031":264,"_17751":31304,"_5":21231,"_8158":31122,"_1362":31305},[],"**Claves:** `services.kms.cryptoEngines.*` configura los motores criptográficos y su almacenamiento.",{"_3357":337,"_21031":264,"_17751":31307,"_5":21231,"_8158":31122,"_1362":31308},[],"**Alertas:** `services.alerts.smtp_server.*` prepara el envío de correo.",{"_3357":338,"_21031":264,"_17751":31310,"_5":21231,"_8158":31126,"_1362":31311},[],"El chart incluye una prueba Helm en `charts/lamassu/templates/tests/test-connections.yml`. Tras instalarlo, puede validarse con:",{"_3357":339,"_21031":264,"_17751":31313,"_5":21231,"_8158":31126,"_1362":31314},[],"La prueba comprueba al menos:",{"_3357":340,"_21031":264,"_17751":31316,"_5":21231,"_8158":31126,"_1362":31317},[],"salud de `ca`",{"_3357":341,"_21031":264,"_17751":31319,"_5":21231,"_8158":31126,"_1362":31320},[],"salud de `dms-manager`",{"_3357":342,"_21031":264,"_17751":31322,"_5":21231,"_8158":31126,"_1362":31323},[],"salud de `device-manager`",{"_3357":343,"_21031":264,"_17751":31325,"_5":21231,"_8158":31126,"_1362":31326},[],"salud de `va`",{"_3357":344,"_21031":264,"_17751":31328,"_5":21231,"_8158":31126,"_1362":31329},[],"respuesta HTML esperada del servicio `ui`",{"_3357":345,"_21031":264,"_17751":31331,"_5":21231,"_8158":31130,"_1362":31332},[],"El repositorio `lamassu-helm` está organizado en tres bloques principales:",{"_3357":346,"_21031":264,"_17751":31334,"_5":21231,"_8158":31130,"_1362":31335},[],"`charts/lamassu`: chart principal de Lamassu",{"_3357":347,"_21031":264,"_17751":31337,"_5":21231,"_8158":31130,"_1362":31338},[],"`charts/softhsm`: chart opcional para laboratorios o escenarios de integración con PKCS#11 emulado",{"_3357":348,"_21031":264,"_17751":31340,"_5":21231,"_8158":31130,"_1362":31341},[],"`scripts/lamassu-fast-lane.sh`: automatización para levantar dependencias y desplegar Lamassu con intervención mínima",{"_3357":349,"_21031":264,"_17751":31343,"_5":21231,"_8158":31134,"_1362":31344},[],"El chart `charts/softhsm` no forma parte del despliegue estándar, pero resulta útil en entornos de laboratorio cuando se necesita simular un HSM compatible con PKCS#11. No sustituye al backend KMS principal; sirve como soporte para pruebas o integraciones concretas.",{"_3357":350,"_21031":264,"_17751":31346,"_5":21231,"_8158":31138,"_1362":31347},[],"La serie actual del chart principal es `3.7.x`. Para upgrades entre versiones, el repositorio incluye guías específicas en `charts/lamassu/CHANGELOG/`, especialmente en cambios importantes como la adopción de Envoy Gateway o la introducción del servicio KMS.",{"_3357":351,"_21031":351,"_5":21226,"_1362":31349,"_21239":31350,"_17751":31353,"_8158":351},"Alertas y suscripciones",[30292,31351,31352],"Plataforma","Operar Lamassu",[],{"_3357":352,"_21031":351,"_17751":31355,"_5":21231,"_8158":351,"_1362":31356},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3357":353,"_21031":351,"_5":21236,"_17751":31358,"_8158":31359,"_1362":31360},[],"/docs/platform/pki/alerts#cómo-funciona","Cómo funciona",{"_3357":354,"_21031":351,"_5":21236,"_17751":31362,"_8158":31363,"_1362":31364},[],"/docs/platform/pki/alerts#canales-disponibles","Canales disponibles",{"_3357":355,"_21031":351,"_5":21236,"_17751":31366,"_8158":31367,"_1362":31368},[],"/docs/platform/pki/alerts#crea-una-suscripción","Crea una suscripción",{"_3357":356,"_21031":351,"_5":21236,"_17751":31370,"_8158":31371,"_1362":31372},[],"/docs/platform/pki/alerts#elige-el-evento","Elige el evento",{"_3357":357,"_21031":351,"_5":21236,"_17751":31374,"_8158":31375,"_1362":31376},[],"/docs/platform/pki/alerts#configura-el-destino","Configura el destino",{"_3357":358,"_21031":351,"_5":21236,"_17751":31378,"_8158":31379,"_1362":31380},[],"/docs/platform/pki/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3357":359,"_21031":351,"_5":21236,"_17751":31382,"_8158":31383,"_1362":31384},[],"/docs/platform/pki/alerts#revisa-y-activa","Revisa y activa",{"_3357":360,"_21031":351,"_5":21236,"_17751":31386,"_8158":31387,"_1362":31388},[],"/docs/platform/pki/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3357":361,"_21031":351,"_5":21236,"_17751":31390,"_8158":31391,"_1362":31392},[],"/docs/platform/pki/alerts#familias-de-eventos","Familias de eventos",{"_3357":362,"_21031":351,"_17751":31394,"_5":21231,"_8158":351,"_1362":31395},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3357":363,"_21031":351,"_17751":31397,"_5":21231,"_8158":31359,"_1362":31398},[],"Un servicio publica un evento de dominio.",{"_3357":364,"_21031":351,"_17751":31400,"_5":21231,"_8158":31359,"_1362":31401},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3357":365,"_21031":351,"_17751":31403,"_5":21231,"_8158":31359,"_1362":31404},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3357":366,"_21031":351,"_17751":31406,"_5":21231,"_8158":31359,"_1362":31407},[],"Lamassu entrega el evento al canal configurado.",{"_3357":367,"_21031":351,"_17751":31409,"_5":21231,"_8158":31359,"_1362":31410},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3357":368,"_21031":351,"_17751":31412,"_5":21231,"_8158":31363,"_1362":31413},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino.",{"_3357":369,"_21031":351,"_17751":31415,"_5":21231,"_8158":31363,"_1362":31416},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3357":370,"_21031":351,"_17751":31418,"_5":21231,"_8158":31363,"_1362":31419},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3357":371,"_21031":351,"_17751":31421,"_5":21231,"_8158":31371,"_1362":31422},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3357":372,"_21031":351,"_17751":31424,"_5":21231,"_8158":31375,"_1362":31425},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3357":373,"_21031":351,"_17751":31427,"_5":21231,"_8158":31379,"_1362":31428},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3357":374,"_21031":351,"_17751":31430,"_5":21231,"_8158":31379,"_1362":31431},[],"**None** notifica todas las instancias del evento.",{"_3357":375,"_21031":351,"_17751":31433,"_5":21231,"_8158":31379,"_1362":31434},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3357":376,"_21031":351,"_17751":31436,"_5":21231,"_8158":31379,"_1362":31437},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3357":377,"_21031":351,"_17751":31439,"_5":21231,"_8158":31379,"_1362":31440},[],"**JavaScript** permite expresar lógica personalizada.",{"_3357":378,"_21031":351,"_17751":31442,"_5":21231,"_8158":31379,"_1362":31443},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3357":379,"_21031":351,"_17751":31445,"_5":21231,"_8158":31383,"_1362":31446},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3357":380,"_21031":351,"_17751":31448,"_5":21231,"_8158":31387,"_1362":31449},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3357":381,"_21031":351,"_17751":31451,"_5":21231,"_8158":31391,"_1362":31452},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3357":382,"_21031":351,"_17751":31454,"_5":21231,"_8158":31391,"_1362":31455},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3357":383,"_21031":351,"_17751":31457,"_5":21231,"_8158":31391,"_1362":31458},[],"**Perfiles:** `profile.create`, `profile.update` y `profile.delete`.",{"_3357":384,"_21031":351,"_17751":31460,"_5":21231,"_8158":31391,"_1362":31461},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3357":385,"_21031":351,"_17751":31463,"_5":21231,"_8158":31391,"_1362":31464},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3357":386,"_21031":351,"_17751":31466,"_5":21231,"_8158":31391,"_1362":31467},[],"**Validación:** `va.role.crl.create`.",{"_3357":387,"_21031":351,"_17751":31469,"_5":21231,"_8158":31391,"_1362":31470},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign.message` y `kms.delete`.",{"_3357":388,"_21031":351,"_17751":31472,"_5":21231,"_8158":31391,"_1362":31473},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3357":389,"_21031":389,"_5":21226,"_1362":31475,"_21239":31476,"_17751":31477,"_8158":389},"Autoridades de certificación",[30292,31351,31352],[],{"_3357":390,"_21031":389,"_17751":31479,"_5":21231,"_8158":389,"_1362":31480},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3357":391,"_21031":389,"_5":21236,"_17751":31482,"_8158":31483,"_1362":31484},[],"/docs/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3357":392,"_21031":389,"_5":21236,"_17751":31486,"_8158":31487,"_1362":31488},[],"/docs/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3357":393,"_21031":389,"_5":21236,"_17751":31490,"_8158":31491,"_1362":30302},[],"/docs/platform/pki/certificate-authorities#antes-de-empezar",{"_3357":394,"_21031":389,"_5":21236,"_17751":31493,"_8158":31494,"_1362":31495},[],"/docs/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3357":395,"_21031":389,"_5":21236,"_17751":31497,"_8158":31498,"_1362":31499},[],"/docs/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3357":396,"_21031":389,"_5":21236,"_17751":31501,"_8158":31502,"_1362":31503},[],"/docs/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3357":397,"_21031":389,"_5":21236,"_17751":31505,"_8158":31506,"_1362":31507},[],"/docs/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3357":398,"_21031":389,"_5":21236,"_17751":31509,"_8158":31510,"_1362":31511},[],"/docs/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3357":399,"_21031":389,"_5":21236,"_17751":31513,"_8158":31514,"_1362":31515},[],"/docs/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3357":400,"_21031":389,"_5":21236,"_17751":31517,"_8158":31518,"_1362":31519},[],"/docs/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3357":401,"_21031":389,"_5":21236,"_17751":31521,"_8158":31522,"_1362":31523},[],"/docs/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3357":402,"_21031":389,"_5":21236,"_17751":31525,"_8158":31526,"_1362":31527},[],"/docs/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3357":403,"_21031":389,"_5":21236,"_17751":31529,"_8158":31530,"_1362":31531},[],"/docs/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3357":404,"_21031":389,"_5":21236,"_17751":31533,"_8158":31534,"_1362":31535},[],"/docs/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3357":405,"_21031":389,"_5":21236,"_17751":31537,"_8158":31538,"_1362":31539},[],"/docs/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3357":406,"_21031":389,"_5":21236,"_17751":31541,"_8158":31542,"_1362":31543},[],"/docs/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3357":407,"_21031":389,"_5":21236,"_17751":31545,"_8158":31546,"_1362":31547},[],"/docs/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3357":408,"_21031":389,"_5":21236,"_17751":31549,"_8158":31550,"_1362":31551},[],"/docs/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3357":409,"_21031":389,"_5":21236,"_17751":31553,"_8158":31554,"_1362":31555},[],"/docs/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3357":410,"_21031":389,"_5":21236,"_17751":31557,"_8158":31558,"_1362":31559},[],"/docs/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3357":411,"_21031":389,"_5":21236,"_17751":31561,"_8158":31562,"_1362":31563},[],"/docs/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3357":412,"_21031":389,"_5":21236,"_17751":31565,"_8158":31566,"_1362":31567},[],"/docs/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3357":413,"_21031":389,"_17751":31569,"_5":21231,"_8158":389,"_1362":31570},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3357":414,"_21031":389,"_17751":31572,"_5":21231,"_8158":31483,"_1362":31573},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3357":415,"_21031":389,"_17751":31575,"_5":21231,"_8158":31483,"_1362":31576},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3357":416,"_21031":389,"_17751":31578,"_5":21231,"_8158":31483,"_1362":31579},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3357":417,"_21031":389,"_17751":31581,"_5":21231,"_8158":31483,"_1362":31582},[],"**Importar solo el certificado:** añade una autoridad para construir cadenas y validar, pero no para emitir.",{"_3357":418,"_21031":389,"_17751":31584,"_5":21231,"_8158":31483,"_1362":31585},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3357":419,"_21031":389,"_17751":31587,"_5":21231,"_8158":31491,"_1362":31588},[],"Decide si la CA será raíz o intermedia.",{"_3357":420,"_21031":389,"_17751":31590,"_5":21231,"_8158":31491,"_1362":31591},[],"Elige el motor que custodiará la clave.",{"_3357":421,"_21031":389,"_17751":31593,"_5":21231,"_8158":31491,"_1362":31594},[],"Define una validez superior a la de los certificados que emitirá.",{"_3357":422,"_21031":389,"_17751":31596,"_5":21231,"_8158":31491,"_1362":31597},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3357":423,"_21031":389,"_17751":31599,"_5":21231,"_8158":31494,"_1362":31600},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3357":424,"_21031":389,"_17751":31602,"_5":21231,"_8158":31498,"_1362":31603},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3357":425,"_21031":389,"_17751":31605,"_5":21231,"_8158":31498,"_1362":31606},[],"Para RSA puedes elegir 1024, 2048, 3072 o 4096 bits. Para EC están disponibles las curvas P-256, P-384 y P-521.",{"_3357":426,"_21031":389,"_17751":31608,"_5":21231,"_8158":31502,"_1362":31609},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3357":427,"_21031":389,"_17751":31611,"_5":21231,"_8158":31506,"_1362":31612},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3357":428,"_21031":389,"_17751":31614,"_5":21231,"_8158":31506,"_1362":31615},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3357":429,"_21031":389,"_17751":31617,"_5":21231,"_8158":31506,"_1362":31618},[],"`ST`: estado o provincia.",{"_3357":430,"_21031":389,"_17751":31620,"_5":21231,"_8158":31506,"_1362":31621},[],"`L`: localidad.",{"_3357":431,"_21031":389,"_17751":31623,"_5":21231,"_8158":31506,"_1362":31624},[],"`O`: organización.",{"_3357":432,"_21031":389,"_17751":31626,"_5":21231,"_8158":31506,"_1362":31627},[],"`OU`: unidad organizativa.",{"_3357":433,"_21031":389,"_17751":31629,"_5":21231,"_8158":31506,"_1362":31630},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3357":434,"_21031":389,"_17751":31632,"_5":21231,"_8158":31510,"_1362":31633},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3357":435,"_21031":389,"_17751":31635,"_5":21231,"_8158":31510,"_1362":31636},[],"Selecciona un perfil de emisión existente o configura los `Key Usage` y `Extended Key Usage` en el formulario. Si no eliges un perfil, Lamassu aplica los usos básicos predeterminados.",{"_3357":436,"_21031":389,"_17751":31638,"_5":21231,"_8158":31514,"_1362":31639},[],"Confirma el formulario. La CA debe aparecer en el inventario con su certificado PEM, estado, fecha de expiración y relación de certificados emitidos.",{"_3357":437,"_21031":389,"_17751":31641,"_5":21231,"_8158":31514,"_1362":31642},[],"Una CA no puede emitir certificados que superen su propia fecha de expiración. Deja margen suficiente para renovar o sustituir la autoridad sin interrumpir a los consumidores.",{"_3357":438,"_21031":389,"_17751":31644,"_5":21231,"_8158":31518,"_1362":31645},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3357":439,"_21031":389,"_17751":31647,"_5":21231,"_8158":31518,"_1362":31648},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3357":440,"_21031":389,"_17751":31650,"_5":21231,"_8158":31522,"_1362":31651},[],"La importación conserva una autoridad creada fuera de Lamassu.",{"_3357":441,"_21031":389,"_17751":31653,"_5":21231,"_8158":31526,"_1362":31654},[],"Elige el motor que custodiará la clave importada.",{"_3357":442,"_21031":389,"_17751":31656,"_5":21231,"_8158":31530,"_1362":31657},[],"Proporciona el certificado de CA y la clave privada en formato PEM. Para una CA subordinada, añade opcionalmente la cadena de validación.",{"_3357":443,"_21031":389,"_17751":31659,"_5":21231,"_8158":31534,"_1362":31660},[],"Configura la validez que recibirán los certificados finales cuando una solicitud no indique otra duración.",{"_3357":444,"_21031":389,"_17751":31662,"_5":21231,"_8158":31538,"_1362":31663},[],"Lamassu comprueba que el certificado pertenece a una CA y que el material es coherente antes de registrarlo.",{"_3357":445,"_21031":389,"_17751":31665,"_5":21231,"_8158":31538,"_1362":31666},[],"Si no dispones de la clave privada, importa únicamente el certificado. La autoridad podrá formar parte de cadenas de confianza y procesos de validación, pero no podrá emitir certificados desde Lamassu.",{"_3357":446,"_21031":389,"_17751":31668,"_5":21231,"_8158":31542,"_1362":31669},[],"Abre una CA desde el inventario para consultar:",{"_3357":447,"_21031":389,"_17751":31671,"_5":21231,"_8158":31542,"_1362":31672},[],"Estado y periodo de validez.",{"_3357":448,"_21031":389,"_17751":31674,"_5":21231,"_8158":31542,"_1362":31675},[],"Certificado y cadena en formato PEM.",{"_3357":449,"_21031":389,"_17751":31677,"_5":21231,"_8158":31542,"_1362":31678},[],"Número de certificados activos, expirados y revocados.",{"_3357":450,"_21031":389,"_17751":31680,"_5":21231,"_8158":31542,"_1362":31681},[],"Certificados emitidos en **Issued Certificates**.",{"_3357":451,"_21031":389,"_17751":31683,"_5":21231,"_8158":31542,"_1362":31684},[],"CRL vinculada a la autoridad.",{"_3357":452,"_21031":389,"_17751":31686,"_5":21231,"_8158":31542,"_1362":31687},[],"Metadatos y motor criptográfico asociado.",{"_3357":453,"_21031":389,"_17751":31689,"_5":21231,"_8158":31542,"_1362":31690},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3357":454,"_21031":389,"_17751":31692,"_5":21231,"_8158":31546,"_1362":31693},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3357":455,"_21031":389,"_17751":31695,"_5":21231,"_8158":31546,"_1362":31696},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3357":456,"_21031":389,"_17751":31698,"_5":21231,"_8158":31546,"_1362":31699},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3357":457,"_21031":389,"_17751":31701,"_5":21231,"_8158":31546,"_1362":31702},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3357":458,"_21031":389,"_17751":31704,"_5":21231,"_8158":31550,"_1362":31705},[],"Revocar una CA invalida la confianza en los certificados que ha emitido y puede interrumpir dispositivos y servicios. La acción es irreversible.",{"_3357":459,"_21031":389,"_17751":31707,"_5":21231,"_8158":31554,"_1362":31708},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3357":460,"_21031":389,"_17751":31710,"_5":21231,"_8158":31558,"_1362":31711},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3357":461,"_21031":389,"_17751":31713,"_5":21231,"_8158":31562,"_1362":31714},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3357":462,"_21031":389,"_17751":31716,"_5":21231,"_8158":31566,"_1362":31717},[],"El estado debe cambiar a **REVOKED** y la CRL debe reflejar la nueva información. La CA deja de poder emitir certificados.",{"_3357":463,"_21031":389,"_17751":31719,"_5":21231,"_8158":31566,"_1362":31720},[],"La eliminación permanente solo está disponible después de revocar. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3357":464,"_21031":464,"_5":21226,"_1362":31722,"_21239":31723,"_17751":31724,"_8158":464},"Validación de certificados",[30292,31351,31352],[],{"_3357":465,"_21031":464,"_17751":31726,"_5":21231,"_8158":464,"_1362":31727},[],"Publica el estado de las identidades mediante OCSP y CRL.",{"_3357":466,"_21031":464,"_5":21236,"_17751":31729,"_8158":31730,"_1362":31731},[],"/docs/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3357":467,"_21031":464,"_17751":31733,"_5":21231,"_8158":464,"_1362":31734},[],"La emisión demuestra quién firmó un certificado; la validación permite saber si todavía debe aceptarse. Lamassu publica el estado mediante dos mecanismos complementarios.",{"_3357":468,"_21031":464,"_17751":31736,"_5":21231,"_8158":31730,"_1362":31737},[],"Usa **OCSP** cuando el consumidor esté conectado y necesite consultar el estado más reciente de un certificado concreto.",{"_3357":469,"_21031":464,"_17751":31739,"_5":21231,"_8158":31730,"_1362":31740},[],"Usa una **CRL** cuando la validación deba realizarse localmente, sin conexión o sobre un volumen elevado de certificados. El consumidor descarga periódicamente una lista firmada y la conserva hasta la siguiente actualización.",{"_3357":470,"_21031":464,"_17751":31742,"_5":21231,"_8158":31730,"_1362":31743},[],"Muchos entornos utilizan ambos: OCSP como comprobación primaria y CRL como mecanismo local o de respaldo.",{"_3357":471,"_21031":464,"_17751":31745,"_5":21231,"_8158":31730,"_1362":31746},[],"<Card title=\"Validación online con OCSP\" description=\"Consulta estados Good, Revoked y Unknown en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_3357":472,"_21031":464,"_17751":31748,"_5":21231,"_8158":31730,"_1362":31749},[],"<Card title=\"Listas de revocación\" description=\"Genera, publica y distribuye CRLs por autoridad.\" href=\"/docs/platform/pki/crl\" />",{"_3357":473,"_21031":473,"_5":21226,"_1362":31751,"_21239":31752,"_17751":31753,"_8158":473},"Certificados",[30292,31351,31352],[],{"_3357":474,"_21031":473,"_17751":31755,"_5":21231,"_8158":473,"_1362":31756},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3357":475,"_21031":473,"_5":21236,"_17751":31758,"_8158":31759,"_1362":31760},[],"/docs/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3357":476,"_21031":473,"_5":21236,"_17751":31762,"_8158":31763,"_1362":31764},[],"/docs/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3357":477,"_21031":473,"_5":21236,"_17751":31766,"_8158":31767,"_1362":31768},[],"/docs/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3357":478,"_21031":473,"_5":21236,"_17751":31770,"_8158":31771,"_1362":31772},[],"/docs/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3357":479,"_21031":473,"_5":21236,"_17751":31774,"_8158":31775,"_1362":31776},[],"/docs/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3357":480,"_21031":473,"_5":21236,"_17751":31778,"_8158":31779,"_1362":31780},[],"/docs/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3357":481,"_21031":473,"_5":21236,"_17751":31782,"_8158":31783,"_1362":31784},[],"/docs/platform/pki/certificates#continúa","Continúa",{"_3357":482,"_21031":473,"_17751":31786,"_5":21231,"_8158":473,"_1362":31787},[],"El inventario de certificados ofrece una vista global de las identidades emitidas por todas las autoridades. También puedes abrir **Issued Certificates** dentro de una CA para limitar la vista a ese emisor.",{"_3357":483,"_21031":473,"_17751":31789,"_5":21231,"_8158":31759,"_1362":31790},[],"Abre **Certificates** y filtra por:",{"_3357":484,"_21031":473,"_17751":31792,"_5":21231,"_8158":31759,"_1362":31793},[],"`Common Name` del sujeto.",{"_3357":485,"_21031":473,"_17751":31795,"_5":21231,"_8158":31759,"_1362":31796},[],"Número de serie.",{"_3357":486,"_21031":473,"_17751":31798,"_5":21231,"_8158":31759,"_1362":31799},[],"Estado.",{"_3357":487,"_21031":473,"_17751":31801,"_5":21231,"_8158":31759,"_1362":31802},[],"Autoridad emisora.",{"_3357":488,"_21031":473,"_17751":31804,"_5":21231,"_8158":31759,"_1362":31805},[],"Utiliza **Quick Inspect** para una comprobación rápida o **View Details** para ver el sujeto, SANs, usos, cadena, periodo de validez y metadatos completos.",{"_3357":489,"_21031":473,"_17751":31807,"_5":21231,"_8158":31763,"_1362":31808},[],"La acción de descarga entrega el certificado en formato PEM. Si el certificado se emitió mediante un CSR externo, la clave privada permanece en el sistema que generó ese CSR. Si se generó en el navegador, la clave solo estuvo disponible al finalizar la emisión.",{"_3357":490,"_21031":473,"_17751":31810,"_5":21231,"_8158":31767,"_1362":31811},[],"Revoca una identidad cuando la clave se haya comprometido, el sujeto ya no esté autorizado o el certificado deba dejar de aceptarse antes de expirar.",{"_3357":491,"_21031":473,"_17751":31813,"_5":21231,"_8158":31771,"_1362":31814},[],"En el inventario o la vista de detalle, selecciona **Revoke Certificate**.",{"_3357":492,"_21031":473,"_17751":31816,"_5":21231,"_8158":31775,"_1362":31817},[],"Selecciona la razón que represente el incidente. Esta información se publica en OCSP y en la CRL.",{"_3357":493,"_21031":473,"_17751":31819,"_5":21231,"_8158":31779,"_1362":31820},[],"Confirma la operación y comprueba que el estado sea **Revoked**. Si la CA regenera la CRL al revocar, verifica también que exista una versión nueva.",{"_3357":494,"_21031":473,"_17751":31822,"_5":21231,"_8158":31779,"_1362":31823},[],"Una revocación con la razón `CertificateHold` puede reactivarse. Las demás razones producen una revocación definitiva.",{"_3357":495,"_21031":473,"_17751":31825,"_5":21231,"_8158":31783,"_1362":31826},[],"<Card title=\"Validar con OCSP\" description=\"Consulta el estado de un certificado en tiempo real.\" href=\"/docs/platform/pki/ocsp\" />",{"_3357":496,"_21031":473,"_17751":31828,"_5":21231,"_8158":31783,"_1362":31829},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación offline.\" href=\"/docs/platform/pki/crl\" />",{"_3357":497,"_21031":497,"_5":21226,"_1362":31831,"_21239":31832,"_17751":31834,"_8158":497},"Arquitectura de la plataforma",[30292,31351,31833],"Conceptos",[],{"_3357":498,"_21031":497,"_17751":31836,"_5":21231,"_8158":497,"_1362":31837},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3357":499,"_21031":497,"_5":21236,"_17751":31839,"_8158":31840,"_1362":31841},[],"/docs/platform/pki/concepts/architecture#plano-de-control","Plano de control",{"_3357":500,"_21031":497,"_5":21236,"_17751":31843,"_8158":31844,"_1362":31845},[],"/docs/platform/pki/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3357":501,"_21031":497,"_5":21236,"_17751":31847,"_8158":31848,"_1362":31849},[],"/docs/platform/pki/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3357":502,"_21031":497,"_5":21236,"_17751":31851,"_8158":31852,"_1362":31853},[],"/docs/platform/pki/concepts/architecture#estado-y-validación","Estado y validación",{"_3357":503,"_21031":497,"_5":21236,"_17751":31855,"_8158":31856,"_1362":31857},[],"/docs/platform/pki/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3357":504,"_21031":497,"_17751":31859,"_5":21231,"_8158":497,"_1362":31860},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3357":505,"_21031":497,"_17751":31862,"_5":21231,"_8158":31840,"_1362":31863},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3357":506,"_21031":497,"_17751":31865,"_5":21231,"_8158":31844,"_1362":31866},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3357":507,"_21031":497,"_17751":31868,"_5":21231,"_8158":31848,"_1362":31869},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3357":508,"_21031":497,"_17751":31871,"_5":21231,"_8158":31852,"_1362":31872},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3357":509,"_21031":497,"_17751":31874,"_5":21231,"_8158":31856,"_1362":31875},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3357":510,"_21031":510,"_5":21226,"_1362":31877,"_21239":31878,"_17751":31879,"_8158":510},"Ciclo de vida de una identidad",[30292,31351,31833],[],{"_3357":511,"_21031":510,"_17751":31881,"_5":21231,"_8158":510,"_1362":31882},[],"Estados, transiciones y decisiones operativas de un certificado de dispositivo.",{"_3357":512,"_21031":510,"_5":21236,"_17751":31884,"_8158":31885,"_1362":31886},[],"/docs/platform/pki/concepts/certificate-lifecycle#estados-principales","Estados principales",{"_3357":513,"_21031":510,"_5":21236,"_17751":31888,"_8158":31889,"_1362":31890},[],"/docs/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3357":514,"_21031":510,"_5":21236,"_17751":31892,"_8158":31893,"_1362":31894},[],"/docs/platform/pki/concepts/certificate-lifecycle#observabilidad","Observabilidad",{"_3357":515,"_21031":510,"_17751":31896,"_5":21231,"_8158":510,"_1362":31897},[],"Una identidad no termina cuando se emite el certificado. Lamassu mantiene su relación con el dispositivo y registra los cambios necesarios para renovarla, suspenderla o retirarla.",{"_3357":516,"_21031":510,"_17751":31899,"_5":21231,"_8158":31885,"_1362":31900},[],"**`No Identity`**: el dispositivo está registrado pero no tiene certificado. Debes enrolarlo o asignarle una identidad.",{"_3357":517,"_21031":510,"_17751":31902,"_5":21231,"_8158":31885,"_1362":31903},[],"**`Active`**: el certificado está vigente y puede utilizarse. Monitoriza su validez y prepara la renovación.",{"_3357":518,"_21031":510,"_17751":31905,"_5":21231,"_8158":31885,"_1362":31906},[],"**`Renewal Pending`**: la identidad ha entrado en la ventana de renovación. El dispositivo ya puede iniciar el re-enrolamiento.",{"_3357":519,"_21031":510,"_17751":31908,"_5":21231,"_8158":31885,"_1362":31909},[],"**`Expiring Soon`**: la fecha de expiración está próxima y la renovación requiere atención prioritaria.",{"_3357":520,"_21031":510,"_17751":31911,"_5":21231,"_8158":31885,"_1362":31912},[],"**`Expired`**: el certificado ha superado su validez. Emite una identidad nueva.",{"_3357":521,"_21031":510,"_17751":31914,"_5":21231,"_8158":31885,"_1362":31915},[],"**`Revoked`**: el certificado se ha invalidado antes de expirar. Investiga la causa y sustitúyelo si procede.",{"_3357":522,"_21031":510,"_17751":31917,"_5":21231,"_8158":31885,"_1362":31918},[],"**`Decommissioned`**: el dispositivo se ha retirado definitivamente y no debe volver a enrolarse.",{"_3357":523,"_21031":510,"_17751":31920,"_5":21231,"_8158":31889,"_1362":31921},[],"La **renovación** sustituye una identidad que sigue siendo fiable antes de que expire. La **revocación** comunica que un certificado ya no debe aceptarse. Revoca cuando exista compromiso, retirada o un cambio que invalide la identidad; renueva para mantener la continuidad operativa.",{"_3357":524,"_21031":510,"_17751":31923,"_5":21231,"_8158":31889,"_1362":31924},[],"Dar de baja un dispositivo revoca sus certificados y le impide obtener nuevas identidades. Utiliza esta acción únicamente cuando el dispositivo se retire de forma permanente.",{"_3357":525,"_21031":510,"_17751":31926,"_5":21231,"_8158":31893,"_1362":31927},[],"El historial de certificados muestra todas las identidades asociadas a un dispositivo. La línea de tiempo registra enrolamientos, renovaciones y cambios de estado. Las suscripciones permiten enviar estos eventos a correo, Microsoft Teams o webhooks.",{"_3357":526,"_21031":526,"_5":21226,"_1362":31929,"_21239":31930,"_17751":31931,"_8158":526},"Cómo funciona Lamassu",[30292,31351,31833],[],{"_3357":527,"_21031":526,"_17751":31933,"_5":21231,"_8158":526,"_1362":31934},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3357":528,"_21031":526,"_5":21236,"_17751":31936,"_8158":31937,"_1362":31938},[],"/docs/platform/pki/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3357":529,"_21031":526,"_5":21236,"_17751":31940,"_8158":31941,"_1362":31942},[],"/docs/platform/pki/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3357":530,"_21031":526,"_17751":31944,"_5":21231,"_8158":526,"_1362":31945},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3357":531,"_21031":526,"_17751":31947,"_5":21231,"_8158":31937,"_1362":31948},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3357":532,"_21031":526,"_17751":31950,"_5":21231,"_8158":31937,"_1362":31951},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3357":533,"_21031":526,"_17751":31953,"_5":21231,"_8158":31937,"_1362":31954},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3357":534,"_21031":526,"_17751":31956,"_5":21231,"_8158":31937,"_1362":31957},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3357":535,"_21031":526,"_17751":31959,"_5":21231,"_8158":31937,"_1362":31960},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3357":536,"_21031":526,"_17751":31962,"_5":21231,"_8158":31941,"_1362":31963},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3357":537,"_21031":526,"_17751":31965,"_5":21231,"_8158":31941,"_1362":31966},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3357":538,"_21031":526,"_17751":31968,"_5":21231,"_8158":31941,"_1362":31969},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3357":539,"_21031":526,"_17751":31971,"_5":21231,"_8158":31941,"_1362":31972},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3357":540,"_21031":526,"_17751":31974,"_5":21231,"_8158":31941,"_1362":31975},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3357":541,"_21031":526,"_17751":31977,"_5":21231,"_8158":31941,"_1362":31978},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/pki/concepts/architecture\" />",{"_3357":542,"_21031":526,"_17751":31980,"_5":21231,"_8158":31941,"_1362":31981},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3357":543,"_21031":543,"_5":21226,"_1362":31983,"_21239":31984,"_17751":31985,"_8158":543},"Listas de revocación (CRL)",[30292,31351,31352],[],{"_3357":544,"_21031":543,"_17751":31987,"_5":21231,"_8158":543,"_1362":31988},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3357":545,"_21031":543,"_5":21236,"_17751":31990,"_8158":31991,"_1362":31992},[],"/docs/platform/pki/crl#servicio-crl","Servicio CRL",{"_3357":546,"_21031":543,"_5":21236,"_17751":31994,"_8158":31995,"_1362":31996},[],"/docs/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3357":547,"_21031":543,"_5":21236,"_17751":31998,"_8158":31999,"_1362":32000},[],"/docs/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3357":548,"_21031":543,"_5":21236,"_17751":32002,"_8158":32003,"_1362":32004},[],"/docs/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3357":549,"_21031":543,"_5":21236,"_17751":32006,"_8158":32007,"_1362":32008},[],"/docs/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3357":550,"_21031":543,"_5":21236,"_17751":32010,"_8158":32011,"_1362":32012},[],"/docs/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3357":551,"_21031":543,"_5":21236,"_17751":32014,"_8158":32015,"_1362":32016},[],"/docs/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3357":552,"_21031":543,"_5":21236,"_17751":32018,"_8158":32019,"_1362":32020},[],"/docs/platform/pki/crl#referencias","Referencias",{"_3357":553,"_21031":543,"_17751":32022,"_5":21231,"_8158":31991,"_1362":32023},[],"Una CRL (*Certificate Revocation List*) es una lista firmada que contiene los números de serie de los certificados revocados antes de su fecha de caducidad. A diferencia de OCSP, no requiere una consulta en tiempo real: la parte que confía descarga la lista periódicamente y la consulta de forma local.",{"_3357":554,"_21031":543,"_17751":32025,"_5":21231,"_8158":31991,"_1362":32026},[],"Lamassu genera y mantiene una CRL por cada CA que gestiona. Cada CRL está firmada con la clave privada de la propia CA emisora y se almacena en el sistema de almacenamiento de objetos configurado en la plataforma.",{"_3357":555,"_21031":543,"_17751":32028,"_5":21231,"_8158":31995,"_1362":32029},[],"La publicación de la CRL de cada CA se controla mediante un *rol VA*. Este objeto define cómo se genera, cuándo se regenera y qué clave se utiliza para firmarla.",{"_3357":556,"_21031":543,"_17751":32031,"_5":21231,"_8158":31995,"_1362":32032},[],"Los parámetros principales son:",{"_3357":557,"_21031":543,"_17751":32034,"_5":21231,"_8158":31995,"_1362":32035},[],"**`validity`** define el periodo de validez reflejado en `nextUpdate`. Su valor predeterminado es 7 días.",{"_3357":558,"_21031":543,"_17751":32037,"_5":21231,"_8158":31995,"_1362":32038},[],"**`refresh_interval`** establece el intervalo mínimo entre regeneraciones programadas. Por defecto es aproximadamente 6 días y 23 horas.",{"_3357":559,"_21031":543,"_17751":32040,"_5":21231,"_8158":31995,"_1362":32041},[],"**`regenerate_on_revoke`** ordena publicar una versión nueva inmediatamente después de una revocación. Está activo por defecto.",{"_3357":560,"_21031":543,"_17751":32043,"_5":21231,"_8158":31995,"_1362":32044},[],"El campo `subject_key_id_signer` identifica la CA cuya clave privada firma la CRL. Por defecto, cada CA firma su propia CRL.",{"_3357":561,"_21031":543,"_17751":32046,"_5":21231,"_8158":31995,"_1362":32047},[],"Cada CRL lleva un número de versión incremental. Lamassu almacena todas las versiones en la ruta `pki/va/crl/{subject_key_id}/{version}.crl` del almacenamiento de objetos.",{"_3357":562,"_21031":543,"_17751":32049,"_5":21231,"_8158":31999,"_1362":32050},[],"Un proceso en segundo plano supervisa los roles VA activos. Cuando la validez restante de la CRL vigente cae por debajo del período de vigilancia configurado (*blind period*), el sistema solicita la generación de una nueva CRL. Así se evita que la CRL publicada caduque sin que exista una versión válida disponible.",{"_3357":563,"_21031":543,"_17751":32052,"_5":21231,"_8158":31999,"_1362":32053},[],"Además, cuando `regenerate_on_revoke` está activo, que es el comportamiento por defecto, cualquier revocación de un certificado desencadena inmediatamente la generación de una nueva CRL para la CA afectada. Esto reduce al mínimo el tiempo entre la revocación y su publicación.",{"_3357":564,"_21031":543,"_17751":32055,"_5":21231,"_8158":32003,"_1362":32056},[],"Cada entrada de la CRL incluye el número de serie del certificado revocado, la fecha de revocación y el código de razón conforme a RFC 5280.",{"_3357":565,"_21031":543,"_17751":32058,"_5":21231,"_8158":32003,"_1362":32059},[],"La CRL incluye también la extensión *Issuing Distribution Point* (IDP, OID 2.5.29.28), marcada como crítica, que indica la URL pública desde la que puede descargarse. Esa URL apunta al endpoint `/crl/{subject_key_id}` de cada dominio VA configurado.",{"_3357":566,"_21031":543,"_17751":32061,"_5":21231,"_8158":32007,"_1362":32062},[],"La CRL más reciente de una CA se puede obtener directamente sin autenticación:",{"_3357":567,"_21031":543,"_17751":32064,"_5":21231,"_8158":32007,"_1362":32065},[],"La respuesta tiene `Content-Type: application/pkix-crl` y contiene la CRL en formato DER.",{"_3357":568,"_21031":543,"_17751":32067,"_5":21231,"_8158":32011,"_1362":32068},[],"El rol VA de una CA se puede consultar y actualizar mediante la API:",{"_3357":569,"_21031":543,"_17751":32070,"_5":21231,"_8158":32011,"_1362":32071},[],"Método",{"_3357":570,"_21031":543,"_17751":32073,"_5":21231,"_8158":32011,"_1362":32074},[],"Ruta",{"_3357":571,"_21031":543,"_17751":32076,"_5":21231,"_8158":32011,"_1362":30663},[],{"_3357":572,"_21031":543,"_17751":32078,"_5":21231,"_8158":32011,"_1362":32079},[],"`GET`",{"_3357":573,"_21031":543,"_17751":32081,"_5":21231,"_8158":32011,"_1362":32082},[],"`/v1/roles/{ca-ski}`",{"_3357":574,"_21031":543,"_17751":32084,"_5":21231,"_8158":32011,"_1362":32085},[],"Devuelve la configuración del rol VA y los metadatos de la última CRL emitida.",{"_3357":575,"_21031":543,"_17751":32087,"_5":21231,"_8158":32011,"_1362":32088},[],"`PUT`",{"_3357":576,"_21031":543,"_17751":32090,"_5":21231,"_8158":32011,"_1362":32082},[],{"_3357":577,"_21031":543,"_17751":32092,"_5":21231,"_8158":32011,"_1362":32093},[],"Actualiza los parámetros de la configuración del rol VA (`validity`, `refresh_interval`, `regenerate_on_revoke`).",{"_3357":578,"_21031":543,"_17751":32095,"_5":21231,"_8158":32011,"_1362":32096},[],"Ejemplo de consulta del rol VA:",{"_3357":579,"_21031":543,"_17751":32098,"_5":21231,"_8158":32011,"_1362":32099},[],"La respuesta incluye el campo `latest_crl` con la versión, la fecha de inicio de validez y la fecha de caducidad de la CRL actualmente publicada.",{"_3357":580,"_21031":543,"_17751":32101,"_5":21231,"_8158":32015,"_1362":32102},[],"Desde el panel de detalle de una CA es posible previsualizar el contenido de la CRL activa y descargarla directamente para su uso offline o para importarla en aplicaciones que realicen validación local.",{"_3357":581,"_21031":543,"_17751":32104,"_5":21231,"_8158":32019,"_1362":32105},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile*",{"_3357":582,"_21031":543,"_17751":32107,"_5":21231,"_8158":32019,"_1362":32108},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3357":583,"_21031":543,"_17751":32110,"_5":21231,"_8158":32019,"_1362":32111},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3357":584,"_21031":584,"_5":21226,"_1362":32113,"_21239":32114,"_17751":32115,"_8158":584},"Device Management Service",[30292,31351,31352],[],{"_3357":585,"_21031":584,"_17751":32117,"_5":21231,"_8158":584,"_1362":32118},[],"Define cómo una flota recibe, renueva y utiliza sus identidades.",{"_3357":586,"_21031":584,"_5":21236,"_17751":32120,"_8158":32121,"_1362":30302},[],"/docs/platform/pki/device-enrollment#antes-de-empezar",{"_3357":587,"_21031":584,"_5":21236,"_17751":32123,"_8158":32124,"_1362":32125},[],"/docs/platform/pki/device-enrollment#configura-un-dms","Configura un DMS",{"_3357":588,"_21031":584,"_5":21236,"_17751":32127,"_8158":32128,"_1362":32129},[],"/docs/platform/pki/device-enrollment#identifica-la-flota","Identifica la flota",{"_3357":589,"_21031":584,"_5":21236,"_17751":32131,"_8158":32132,"_1362":32133},[],"/docs/platform/pki/device-enrollment#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3357":590,"_21031":584,"_5":21236,"_17751":32135,"_8158":32136,"_1362":32137},[],"/docs/platform/pki/device-enrollment#configura-est","Configura EST",{"_3357":591,"_21031":584,"_5":21236,"_17751":32139,"_8158":32140,"_1362":32141},[],"/docs/platform/pki/device-enrollment#distribuye-la-confianza","Distribuye la confianza",{"_3357":592,"_21031":584,"_5":21236,"_17751":32143,"_8158":32144,"_1362":32145},[],"/docs/platform/pki/device-enrollment#verifica-los-endpoints","Verifica los endpoints",{"_3357":593,"_21031":584,"_5":21236,"_17751":32147,"_8158":32148,"_1362":32149},[],"/docs/platform/pki/device-enrollment#distribución-de-confianza","Distribución de confianza",{"_3357":594,"_21031":584,"_5":21236,"_17751":32151,"_8158":32152,"_1362":32153},[],"/docs/platform/pki/device-enrollment#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3357":595,"_21031":584,"_5":21236,"_17751":32155,"_8158":32156,"_1362":32157},[],"/docs/platform/pki/device-enrollment#integra-los-dispositivos","Integra los dispositivos",{"_3357":596,"_21031":584,"_17751":32159,"_5":21231,"_8158":584,"_1362":32160},[],"Un &#x2A;*Device Management Service (DMS)** actúa como autoridad de registro frente a una flota. Recibe solicitudes, aplica la política de autenticación y encarga la emisión a la CA configurada.",{"_3357":597,"_21031":584,"_17751":32162,"_5":21231,"_8158":584,"_1362":32163},[],"Cada DMS es un límite operativo independiente: puede representar una línea de producto, un entorno o un tipo de dispositivo con su propia CA, reglas de autenticación, confianza distribuida y ventana de renovación.",{"_3357":598,"_21031":584,"_17751":32165,"_5":21231,"_8158":32121,"_1362":32166},[],"Crea o importa al menos una CA activa.",{"_3357":599,"_21031":584,"_17751":32168,"_5":21231,"_8158":32121,"_1362":32169},[],"Decide cómo se autenticarán los dispositivos durante el primer enrolamiento.",{"_3357":600,"_21031":584,"_17751":32171,"_5":21231,"_8158":32121,"_1362":32172},[],"Define qué autoridades debe recibir el dispositivo como anclas de confianza.",{"_3357":601,"_21031":584,"_17751":32174,"_5":21231,"_8158":32121,"_1362":32175},[],"Asegúrate de tener permisos para administrar DMS.",{"_3357":602,"_21031":584,"_17751":32177,"_5":21231,"_8158":32128,"_1362":32178},[],"Asigna al DMS un nombre que describa su alcance, por ejemplo una familia de dispositivos o un entorno.",{"_3357":603,"_21031":584,"_17751":32180,"_5":21231,"_8158":32132,"_1362":32181},[],"Elige la autoridad que emitirá las identidades. Su política y periodo de validez condicionan los certificados que podrá obtener la flota.",{"_3357":604,"_21031":584,"_17751":32183,"_5":21231,"_8158":32136,"_1362":32184},[],"Define la autenticación de `enroll`, la política de `reenroll`, la ventana de renovación y, si se necesita, `serverkeygen`.",{"_3357":605,"_21031":584,"_17751":32186,"_5":21231,"_8158":32140,"_1362":32187},[],"Configura **CA Distribution** para controlar la respuesta del endpoint `cacerts`.",{"_3357":606,"_21031":584,"_17751":32189,"_5":21231,"_8158":32144,"_1362":32190},[],"Desde el menú del DMS, abre &#x2A;*EST (RFC-7030)** y comprueba la URL base y los ejemplos de invocación antes de integrar el firmware.",{"_3357":607,"_21031":584,"_17751":32192,"_5":21231,"_8158":32148,"_1362":32193},[],"**Include Lamassu System CA** distribuye el certificado TLS del servidor Lamassu, útil para *pinning*. No representa una CA de emisión.",{"_3357":608,"_21031":584,"_17751":32195,"_5":21231,"_8158":32148,"_1362":32196},[],"**Include Enrollment CA** añade la autoridad configurada para emitir las identidades del DMS.",{"_3357":609,"_21031":584,"_17751":32198,"_5":21231,"_8158":32148,"_1362":32199},[],"**Managed CAs** permite incluir autoridades adicionales que el dispositivo debe considerar de confianza.",{"_3357":610,"_21031":584,"_17751":32201,"_5":21231,"_8158":32152,"_1362":32202},[],"**Edit** modifica la política del DMS.",{"_3357":611,"_21031":584,"_17751":32204,"_5":21231,"_8158":32152,"_1362":32205},[],"**Go to DMS owned devices** abre únicamente los dispositivos de esa flota.",{"_3357":612,"_21031":584,"_17751":32207,"_5":21231,"_8158":32152,"_1362":32208},[],"**Show/Edit Metadata** permite gestionar configuración avanzada y datos de integraciones.",{"_3357":613,"_21031":584,"_17751":32210,"_5":21231,"_8158":32152,"_1362":32211},[],"**EST (RFC-7030)** muestra los endpoints y ejemplos específicos del DMS.",{"_3357":614,"_21031":584,"_17751":32213,"_5":21231,"_8158":32152,"_1362":32214},[],"**Delete** elimina el DMS y su configuración. La acción es irreversible.",{"_3357":615,"_21031":584,"_17751":32216,"_5":21231,"_8158":32156,"_1362":32217},[],"<Card title=\"Enrolamiento EST\" description=\"Configura autenticación, endpoints y flujos para firmware.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3357":616,"_21031":584,"_17751":32219,"_5":21231,"_8158":32156,"_1362":32220},[],"<Card title=\"Dispositivos e identidades\" description=\"Consulta estados, historial y acciones operativas.\" href=\"/docs/platform/pki/device-management\" />",{"_3357":617,"_21031":617,"_5":21226,"_1362":32222,"_21239":32223,"_17751":32224,"_8158":617},"Dispositivos e identidades",[30292,31351,31352],[],{"_3357":618,"_21031":617,"_17751":32226,"_5":21231,"_8158":617,"_1362":32227},[],"Registra dispositivos y controla sus identidades durante todo el ciclo de vida.",{"_3357":619,"_21031":617,"_5":21236,"_17751":32229,"_8158":32230,"_1362":32231},[],"/docs/platform/pki/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3357":620,"_21031":617,"_5":21236,"_17751":32233,"_8158":32234,"_1362":32235},[],"/docs/platform/pki/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3357":621,"_21031":617,"_5":21236,"_17751":32237,"_8158":32238,"_1362":32239},[],"/docs/platform/pki/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3357":622,"_21031":617,"_5":21236,"_17751":32241,"_8158":32242,"_1362":32243},[],"/docs/platform/pki/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3357":623,"_21031":617,"_5":21236,"_17751":32245,"_8158":32246,"_1362":32247},[],"/docs/platform/pki/device-management#define-su-pertenencia","Define su pertenencia",{"_3357":624,"_21031":617,"_5":21236,"_17751":32249,"_8158":32250,"_1362":32251},[],"/docs/platform/pki/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3357":625,"_21031":617,"_5":21236,"_17751":32253,"_8158":32254,"_1362":32255},[],"/docs/platform/pki/device-management#verifica-el-alta","Verifica el alta",{"_3357":626,"_21031":617,"_5":21236,"_17751":32257,"_8158":32258,"_1362":32259},[],"/docs/platform/pki/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3357":627,"_21031":617,"_5":21236,"_17751":32261,"_8158":32262,"_1362":32263},[],"/docs/platform/pki/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3357":628,"_21031":617,"_5":21236,"_17751":32265,"_8158":32266,"_1362":32267},[],"/docs/platform/pki/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3357":629,"_21031":617,"_5":21236,"_17751":32269,"_8158":32270,"_1362":32271},[],"/docs/platform/pki/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3357":630,"_21031":617,"_17751":32273,"_5":21231,"_8158":617,"_1362":32274},[],"Un dispositivo gestionado representa una entidad de tu flota y conserva el historial de los certificados que ha utilizado. Lamassu separa el dispositivo de su identidad actual para que puedas renovar o sustituir certificados sin perder trazabilidad.",{"_3357":631,"_21031":617,"_17751":32276,"_5":21231,"_8158":32230,"_1362":32277},[],"**Active** indica que el dispositivo tiene una identidad válida.",{"_3357":632,"_21031":617,"_17751":32279,"_5":21231,"_8158":32230,"_1362":32280},[],"**No Identity** aparece cuando está registrado, pero todavía no tiene un certificado asociado.",{"_3357":633,"_21031":617,"_17751":32282,"_5":21231,"_8158":32230,"_1362":32283},[],"**Renewal Pending** señala que ha entrado en la ventana de renovación.",{"_3357":634,"_21031":617,"_17751":32285,"_5":21231,"_8158":32230,"_1362":32286},[],"**Expiring Soon** advierte que el certificado está próximo a expirar.",{"_3357":635,"_21031":617,"_17751":32288,"_5":21231,"_8158":32230,"_1362":32289},[],"**Expired** indica que la identidad ha superado su fecha de validez.",{"_3357":636,"_21031":617,"_17751":32291,"_5":21231,"_8158":32230,"_1362":32292},[],"**Revoked** identifica un certificado invalidado antes de su expiración.",{"_3357":637,"_21031":617,"_17751":32294,"_5":21231,"_8158":32230,"_1362":32295},[],"**Decommissioned** corresponde a un dispositivo retirado de forma permanente.",{"_3357":638,"_21031":617,"_17751":32297,"_5":21231,"_8158":32230,"_1362":32298},[],"El inventario permite filtrar por `Device ID`, etiquetas y estado.",{"_3357":639,"_21031":617,"_17751":32300,"_5":21231,"_8158":32234,"_1362":32301},[],"La vista de detalle separa dos perspectivas:",{"_3357":640,"_21031":617,"_17751":32303,"_5":21231,"_8158":32234,"_1362":32304},[],"**Certificate History** conserva todos los certificados asociados, con su número de serie, emisor, estado y periodo de validez.",{"_3357":641,"_21031":617,"_17751":32306,"_5":21231,"_8158":32234,"_1362":32307},[],"**Device Event Timeline** ordena cronológicamente registros, enrolamientos, renovaciones y cambios de estado.",{"_3357":642,"_21031":617,"_17751":32309,"_5":21231,"_8158":32234,"_1362":32310},[],"Utiliza el historial para auditoría y la línea de tiempo para reconstruir un incidente o diagnosticar una transición inesperada.",{"_3357":643,"_21031":617,"_17751":32312,"_5":21231,"_8158":32238,"_1362":32313},[],"El registro previo es útil cuando la política exige que el dispositivo exista antes de solicitar su primer certificado.",{"_3357":644,"_21031":617,"_17751":32315,"_5":21231,"_8158":32242,"_1362":32316},[],"Desde **Managed Devices**, abre el formulario de registro.",{"_3357":645,"_21031":617,"_17751":32318,"_5":21231,"_8158":32246,"_1362":32319},[],"Introduce un **Device ID** único y selecciona el DMS que aplicará las políticas de enrolamiento y renovación.",{"_3357":646,"_21031":617,"_17751":32321,"_5":21231,"_8158":32250,"_1362":32322},[],"Añade un icono y etiquetas si necesitas agruparlo por modelo, ubicación, entorno u otro criterio operativo.",{"_3357":647,"_21031":617,"_17751":32324,"_5":21231,"_8158":32254,"_1362":32325},[],"El dispositivo debe aparecer con estado **No Identity** hasta que complete el enrolamiento o reciba una identidad manual.",{"_3357":648,"_21031":617,"_17751":32327,"_5":21231,"_8158":32258,"_1362":32328},[],"La acción **Assign Identity** está disponible mientras el dispositivo permanece en **No Identity**.",{"_3357":649,"_21031":617,"_17751":32330,"_5":21231,"_8158":32258,"_1362":32331},[],"Abre el dispositivo y selecciona **Assign Identity**.",{"_3357":650,"_21031":617,"_17751":32333,"_5":21231,"_8158":32258,"_1362":32334},[],"Elige un certificado activo cuyo `Common Name` coincida con el `Device ID`.",{"_3357":651,"_21031":617,"_17751":32336,"_5":21231,"_8158":32258,"_1362":32337},[],"Si no existe, selecciona **Issue New Instead** y elige una CA vinculada al DMS.",{"_3357":652,"_21031":617,"_17751":32339,"_5":21231,"_8158":32258,"_1362":32340},[],"Confirma la asignación.",{"_3357":653,"_21031":617,"_17751":32342,"_5":21231,"_8158":32258,"_1362":32343},[],"El dispositivo debe cambiar a **Active** y el certificado debe aparecer en su historial.",{"_3357":654,"_21031":617,"_17751":32345,"_5":21231,"_8158":32262,"_1362":32346},[],"En **Device Event Timeline**, localiza el último certificado activo y selecciona **Revoke**. Elige una razón conforme a tu política y confirma la operación.",{"_3357":655,"_21031":617,"_17751":32348,"_5":21231,"_8158":32262,"_1362":32349},[],"La revocación invalida el certificado, pero no elimina el dispositivo. Puedes restaurar su operación asignándole una identidad nueva. `CertificateHold` permite reactivar el certificado retenido; el resto de razones son definitivas.",{"_3357":656,"_21031":617,"_17751":32351,"_5":21231,"_8158":32266,"_1362":32352},[],"Esta acción revoca todos los certificados del dispositivo e impide que vuelva a obtener una identidad.",{"_3357":657,"_21031":617,"_17751":32354,"_5":21231,"_8158":32266,"_1362":32355},[],"Usa **Decommission** únicamente cuando el dispositivo haya dejado de operar o ya no sea fiable. Tras confirmar, Lamassu revoca la identidad activa con `CessationOfOperation` y cambia el estado a **Decommissioned**.",{"_3357":658,"_21031":617,"_17751":32357,"_5":21231,"_8158":32270,"_1362":32358},[],"<Card title=\"Configura un DMS\" description=\"Define la CA, confianza y políticas de la flota.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3357":659,"_21031":617,"_17751":32360,"_5":21231,"_8158":32270,"_1362":32361},[],"<Card title=\"Integra EST\" description=\"Permite que el dispositivo solicite y renueve su identidad.\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3357":660,"_21031":660,"_5":21226,"_1362":32363,"_21239":32364,"_17751":32365,"_8158":660},"Enrolamiento de dispositivos con EST",[30292,31351,31352],[],{"_3357":661,"_21031":660,"_17751":32367,"_5":21231,"_8158":660,"_1362":32368},[],"Guía del protocolo EST en Lamassu IoT, con la configuración del DMS para el administrador PKI y la referencia de endpoints para el integrador de dispositivos.",{"_3357":662,"_21031":660,"_5":21236,"_17751":32370,"_8158":32371,"_1362":32372},[],"/docs/platform/pki/est-enrollment#est-enrollment-over-secure-transport","EST: Enrollment over Secure Transport",{"_3357":663,"_21031":660,"_5":21236,"_17751":32374,"_8158":32375,"_1362":32376},[],"/docs/platform/pki/est-enrollment#configuración-del-dms","Configuración del DMS",{"_3357":664,"_21031":660,"_5":21236,"_17751":32378,"_8158":32379,"_1362":31095},[],"/docs/platform/pki/est-enrollment#requisitos-previos",{"_3357":665,"_21031":660,"_5":21236,"_17751":32381,"_8158":32382,"_1362":32383},[],"/docs/platform/pki/est-enrollment#configuración-de-enrollment","Configuración de enrollment",{"_3357":666,"_21031":660,"_5":21236,"_17751":32385,"_8158":32386,"_1362":32387},[],"/docs/platform/pki/est-enrollment#enrollment-device-registration","Enrollment Device Registration",{"_3357":667,"_21031":660,"_5":21236,"_17751":32389,"_8158":32390,"_1362":32391},[],"/docs/platform/pki/est-enrollment#enrollment-settings","Enrollment Settings",{"_3357":668,"_21031":660,"_5":21236,"_17751":32393,"_8158":32394,"_1362":32395},[],"/docs/platform/pki/est-enrollment#perfil-de-emisión","Perfil de emisión",{"_3357":669,"_21031":660,"_5":21236,"_17751":32397,"_8158":32398,"_1362":32399},[],"/docs/platform/pki/est-enrollment#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3357":670,"_21031":660,"_5":21236,"_17751":32401,"_8158":32402,"_1362":32403},[],"/docs/platform/pki/est-enrollment#configuración-de-serverkeygen","Configuración de ServerKeyGen",{"_3357":671,"_21031":660,"_5":21236,"_17751":32405,"_8158":32406,"_1362":32407},[],"/docs/platform/pki/est-enrollment#verificar-la-configuración","Verificar la configuración",{"_3357":672,"_21031":660,"_5":21236,"_17751":32409,"_8158":32410,"_1362":32411},[],"/docs/platform/pki/est-enrollment#integración-de-dispositivos","Integración de dispositivos",{"_3357":673,"_21031":660,"_5":21236,"_17751":32413,"_8158":32414,"_1362":30302},[],"/docs/platform/pki/est-enrollment#antes-de-empezar",{"_3357":674,"_21031":660,"_5":21236,"_17751":32416,"_8158":32417,"_1362":32418},[],"/docs/platform/pki/est-enrollment#resumen-del-flujo","Resumen del flujo",{"_3357":675,"_21031":660,"_5":21236,"_17751":32420,"_8158":32421,"_1362":32422},[],"/docs/platform/pki/est-enrollment#modelo-de-autenticación-del-cliente","Modelo de autenticación del cliente",{"_3357":676,"_21031":660,"_5":21236,"_17751":32424,"_8158":32425,"_1362":32426},[],"/docs/platform/pki/est-enrollment#referencia-de-endpoints","Referencia de endpoints",{"_3357":677,"_21031":660,"_5":21236,"_17751":32428,"_8158":32429,"_1362":32430},[],"/docs/platform/pki/est-enrollment#cacerts","`/cacerts`",{"_3357":678,"_21031":660,"_5":21236,"_17751":32432,"_8158":32433,"_1362":32434},[],"/docs/platform/pki/est-enrollment#simpleenroll","`/simpleenroll`",{"_3357":679,"_21031":660,"_5":21236,"_17751":32436,"_8158":32437,"_1362":32438},[],"/docs/platform/pki/est-enrollment#simplereenroll","`/simplereenroll`",{"_3357":680,"_21031":660,"_5":21236,"_17751":32440,"_8158":32441,"_1362":32442},[],"/docs/platform/pki/est-enrollment#serverkeygen","`/serverkeygen`",{"_3357":681,"_21031":660,"_5":21236,"_17751":32444,"_8158":32445,"_1362":32446},[],"/docs/platform/pki/est-enrollment#flujos-completos","Flujos completos",{"_3357":682,"_21031":660,"_5":21236,"_17751":32448,"_8158":32449,"_1362":32450},[],"/docs/platform/pki/est-enrollment#ejemplo-end-to-end-enroll","Ejemplo end-to-end: enroll",{"_3357":683,"_21031":660,"_5":21236,"_17751":32452,"_8158":32453,"_1362":32454},[],"/docs/platform/pki/est-enrollment#ejemplo-end-to-end-reenroll","Ejemplo end-to-end: reenroll",{"_3357":684,"_21031":660,"_5":21236,"_17751":32456,"_8158":32457,"_1362":32458},[],"/docs/platform/pki/est-enrollment#próximos-pasos-tras-el-enrolamiento","Próximos pasos tras el enrolamiento",{"_3357":685,"_21031":660,"_5":21236,"_17751":32460,"_8158":32461,"_1362":32462},[],"/docs/platform/pki/est-enrollment#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3357":686,"_21031":660,"_5":21236,"_17751":32464,"_8158":32465,"_1362":32466},[],"/docs/platform/pki/est-enrollment#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3357":687,"_21031":660,"_5":21236,"_17751":32468,"_8158":32469,"_1362":32470},[],"/docs/platform/pki/est-enrollment#notas-de-compatibilidad","Notas de compatibilidad",{"_3357":688,"_21031":660,"_17751":32472,"_5":21231,"_8158":32371,"_1362":32473},[],"Lamassu IoT implementa el protocolo &#x2A;*EST (Enrollment over Secure Transport)** descrito en el RFC 7030 como su único mecanismo de inscripción de certificados para dispositivos. Cada DMS expone los endpoints EST, valida al dispositivo y aplica sus propias políticas de autenticación, registro y renovación. Así, actúa como autoridad de registro (RA) frente al cliente.",{"_3357":689,"_21031":660,"_17751":32475,"_5":21231,"_8158":32371,"_1362":32476},[],"La entidad que emite y firma criptográficamente el certificado es siempre la **CA asociada al DMS**, no el DMS. El DMS coordina el proceso: recibe el CSR, autentica al dispositivo y aplica la política de emisión. Esta distinción es relevante para el administrador PKI al seleccionar la `EnrollmentCA` y para el integrador al interpretar la cadena de confianza recibida de `/cacerts`.",{"_3357":690,"_21031":660,"_17751":32478,"_5":21231,"_8158":32371,"_1362":32479},[],"Esta guía está dividida en dos partes:",{"_3357":691,"_21031":660,"_17751":32481,"_5":21231,"_8158":32371,"_1362":32482},[],"Configuración del DMS, para el administrador PKI.",{"_3357":692,"_21031":660,"_17751":32484,"_5":21231,"_8158":32371,"_1362":32485},[],"Integración de dispositivos, para quien consume los endpoints EST desde firmware, scripts o servicios de aprovisionamiento.",{"_3357":693,"_21031":660,"_17751":32487,"_5":21231,"_8158":32371,"_1362":32488},[],"Si solo necesita una orientación rápida, este es el recorrido recomendado:",{"_3357":694,"_21031":660,"_17751":32490,"_5":21231,"_8158":32371,"_1362":32491},[],"**Administrador PKI:** empiece por Configuración del DMS y termine con Diagnóstico y compatibilidad.",{"_3357":695,"_21031":660,"_17751":32493,"_5":21231,"_8158":32371,"_1362":32494},[],"**Integrador de dispositivos:** empiece por Antes de empezar y continúe con `/cacerts`, `/simpleenroll`, `/simplereenroll` o `/serverkeygen`, según el flujo que vaya a implementar.",{"_3357":696,"_21031":660,"_17751":32496,"_5":21231,"_8158":32379,"_1362":32497},[],"Antes de configurar un DMS para EST, deben existir los siguientes recursos en la plataforma:",{"_3357":697,"_21031":660,"_17751":32499,"_5":21231,"_8158":32379,"_1362":32500},[],"**Una CA disponible**: la CA que actuará como `EnrollmentCA` debe estar creada y en estado activo en Lamassu. Si el modo de autenticación es `CLIENT_CERTIFICATE`, también deben estar creadas las CAs de validación del certificado bootstrap.",{"_3357":698,"_21031":660,"_17751":32502,"_5":21231,"_8158":32379,"_1362":32503},[],"**Un DMS creado**: el DMS al que se aplicará esta configuración debe existir previamente. La configuración EST se aplica sobre un DMS existente, no lo crea.",{"_3357":699,"_21031":660,"_17751":32505,"_5":21231,"_8158":32379,"_1362":32506},[],"Conviene separar cuatro bloques de configuración:",{"_3357":700,"_21031":660,"_17751":32508,"_5":21231,"_8158":32379,"_1362":32509},[],"Cómo se realizará el enrollment inicial, incluyendo el modo de alta y la autenticación del cliente.",{"_3357":701,"_21031":660,"_17751":32511,"_5":21231,"_8158":32379,"_1362":32512},[],"Cómo se gestionará el re-enrollment de certificados ya emitidos.",{"_3357":702,"_21031":660,"_17751":32514,"_5":21231,"_8158":32379,"_1362":32515},[],"Cómo se configurará el endpoint cacerts para la distribución de las CAs de confianza utilizadas por los dispositivos.",{"_3357":703,"_21031":660,"_17751":32517,"_5":21231,"_8158":32379,"_1362":32518},[],"Si se habilitará la generación de claves en servidor mediante `ServerKeyGen`.",{"_3357":704,"_21031":660,"_17751":32520,"_5":21231,"_8158":32386,"_1362":32521},[],"En esta sección se define cómo se registran los dispositivos nuevos y con qué credenciales se autentican.",{"_3357":705,"_21031":660,"_17751":32523,"_5":21231,"_8158":32386,"_1362":32524},[],"**Registration Mode**: determina el comportamiento al recibir una inscripción inicial. En modo `JITP` (*Just-In-Time Provisioning*), el dispositivo se crea automáticamente la primera vez que se presenta, aplicando los tags, metadatos e icono definidos en el perfil de aprovisionamiento. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente en la plataforma; si no existe, la solicitud se rechaza con `device not preregistered`. El modo JITP es adecuado para flotas grandes donde el inventario se construye durante el despliegue; el modo `PRE_REGISTRATION` encaja en entornos de alta seguridad donde cada dispositivo se aprueba de forma explícita antes de recibir un certificado.",{"_3357":706,"_21031":660,"_17751":32526,"_5":21231,"_8158":32386,"_1362":32527},[],"**Tags**: se aplican a cada dispositivo creado automáticamente por este DMS. Son opcionales y solo tienen efecto en modo JITP. Los tags permiten mejorar la búsqueda de dispositivos.",{"_3357":707,"_21031":660,"_17751":32529,"_5":21231,"_8158":32386,"_1362":32530},[],"**Icon**: se aplica a cada dispositivo creado automáticamente por este DMS. Es opcional y solo tiene efecto en modo JITP. Únicamente visual.",{"_3357":708,"_21031":660,"_17751":32532,"_5":21231,"_8158":32390,"_1362":32533},[],"**Enrollment CA**: identifica la CA que firmará los certificados de identidad emitidos a través de este DMS. Su elección determina la cadena de confianza que el dispositivo recibirá y la raíz contra la que los sistemas de backend validarán los certificados de flota.",{"_3357":709,"_21031":660,"_17751":32535,"_5":21231,"_8158":32390,"_1362":32536},[],"**Allow Override Enrollment** (`enable_replaceable_enrollment`): permite que un dispositivo ya enrolado vuelva a inscribirse mediante `/simpleenroll`. Cuando está activa, el certificado anterior se revoca con la razón `superseded` y el slot de identidad se actualiza. Cuando está inactiva, un segundo intento de `simpleenroll` se rechaza con `forbiddenNewEnrollment`. Esta opción debe habilitarse con precaución en entornos de producción, ya que permite sustituir la identidad de un dispositivo sin pasar por el flujo de re-enrollment.",{"_3357":710,"_21031":660,"_17751":32538,"_5":21231,"_8158":32390,"_1362":32539},[],"**Verify CSR Signature** (`verify_csr_signature`): controla si el servidor valida la firma del CSR contra la clave pública declarada en él (prueba de posesión PKCS#10). Cuando está inactiva, un solicitante podría enviar un CSR con una clave pública que no controla y obtener un certificado vinculado a ella. Para flotas IoT en redes abiertas debe estar activa.",{"_3357":711,"_21031":660,"_17751":32541,"_5":21231,"_8158":32390,"_1362":32542},[],"**Authentication Mode**: define cómo el DMS valida la identidad del dispositivo durante el enrollment. Puede exigir un certificado mTLS (`CLIENT_CERTIFICATE`), delegar la autorización en un webhook (`EXTERNAL_WEBHOOK`), combinar ambos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`) o aceptar solicitudes sin autenticación (`NO_AUTH`). Este último modo debe limitarse a laboratorios o redes de aprovisionamiento aisladas.",{"_3357":712,"_21031":660,"_17751":32544,"_5":21231,"_8158":32390,"_1362":32545},[],"Cuando el modo es `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_3357":713,"_21031":660,"_17751":32547,"_5":21231,"_8158":32390,"_1362":32548},[],"**Validation CAs**: lista de CAs de confianza para validar el certificado bootstrap presentado por el dispositivo.",{"_3357":714,"_21031":660,"_17751":32550,"_5":21231,"_8158":32390,"_1362":32551},[],"**Chain Validation Level**: profundidad máxima de la cadena de validación. El valor `-1` valida la cadena completa hasta la CA raíz.",{"_3357":715,"_21031":660,"_17751":32553,"_5":21231,"_8158":32390,"_1362":32554},[],"**Allow Authenticating Expired Certificates**: si está activo, acepta certificados cliente caducados. Es útil en escenarios de recuperación donde el dispositivo no pudo renovar su certificado a tiempo.",{"_3357":716,"_21031":660,"_17751":32556,"_5":21231,"_8158":32390,"_1362":32557},[],"Cuando el modo incluye `EXTERNAL_WEBHOOK`, se configuran además estos parámetros:",{"_3357":717,"_21031":660,"_17751":32559,"_5":21231,"_8158":32390,"_1362":32560},[],"**Webhook URL**: dirección del servicio externo que decidirá la autorización.",{"_3357":718,"_21031":660,"_17751":32562,"_5":21231,"_8158":32390,"_1362":32563},[],"**HTTP Method**: método HTTP utilizado para invocar el webhook. Admite `POST` (por defecto) o `PUT`; ambos son equivalentes para el webhook, solo cambia el verbo con el que Lamassu realiza la llamada.",{"_3357":719,"_21031":660,"_17751":32565,"_5":21231,"_8158":32390,"_1362":32566},[],"**Timeout**: tiempo máximo de espera de la llamada al webhook. Si no se especifica, el valor por defecto es de **10 segundos**; superado ese plazo sin respuesta, Lamassu deniega la operación.",{"_3357":720,"_21031":660,"_17751":32568,"_5":21231,"_8158":32390,"_1362":32569},[],"**Webhook Authentication Mode**: modo de autenticación del webhook hacia el servicio externo, por ejemplo `ApiKey`, `OIDC` o `mTLS`.",{"_3357":721,"_21031":660,"_17751":32571,"_5":21231,"_8158":32390,"_1362":32572},[],"El contrato exacto que debe implementar el servicio webhook (esquema de petición y respuesta, ejemplos) está publicado como especificación OpenAPI: referencia del webhook de autorización.",{"_3357":722,"_21031":660,"_17751":32574,"_5":21231,"_8158":32394,"_1362":32575},[],"El comportamiento del certificado emitido no lo determina únicamente el CSR del dispositivo, sino el **perfil de emisión** (`IssuanceProfile`) asociado al DMS. El integrador no configura este perfil, pero sus reglas afectan al contenido del certificado final:",{"_3357":723,"_21031":660,"_17751":32577,"_5":21231,"_8158":32394,"_1362":32578},[],"**`HonorSubject`** controla si el subject del CSR se traslada literalmente al certificado. Si está desactivado, la CA aplica la plantilla del perfil e ignora el subject recibido.",{"_3357":724,"_21031":660,"_17751":32580,"_5":21231,"_8158":32394,"_1362":32581},[],"**`HonorKeyUsage`** decide si se respeta el `KeyUsage` del CSR o se sustituye por el definido en la plantilla.",{"_3357":725,"_21031":660,"_17751":32583,"_5":21231,"_8158":32394,"_1362":32584},[],"**`HonorExtendedKeyUsages`** aplica la misma regla a `ExtKeyUsage`.",{"_3357":726,"_21031":660,"_17751":32586,"_5":21231,"_8158":32394,"_1362":32587},[],"**`HonorExtensions`** controla si el resto de extensiones del CSR, como SAN o CDP, se incluyen en el certificado.",{"_3357":727,"_21031":660,"_17751":32589,"_5":21231,"_8158":32394,"_1362":32590},[],"Esto es relevante para el integrador: el `KeyUsage`, `ExtKeyUsage` y los SAN que declara el CSR pueden no aparecer tal cual en el certificado final si el perfil así lo decide. Consulte con el administrador PKI si el certificado emitido no contiene las extensiones esperadas.",{"_3357":728,"_21031":660,"_17751":32592,"_5":21231,"_8158":32398,"_1362":32593},[],"La sección **Re-Enrollment Settings** controla el proceso de renovación de certificados. El re-enrollment puede realizarse únicamente cuando el certificado está dentro de la ventana configurada, y opcionalmente también cuando el certificado ya ha caducado.",{"_3357":729,"_21031":660,"_17751":32595,"_5":21231,"_8158":32398,"_1362":32596},[],"**Revoke On Re-Enroll**: si está activo, el certificado anterior se revoca automáticamente con la razón `superseded` una vez emitido el nuevo.",{"_3357":730,"_21031":660,"_17751":32598,"_5":21231,"_8158":32398,"_1362":32599},[],"**Allow Expired Renewal**: permite renovar un certificado ya caducado. Es útil cuando un dispositivo ha estado desconectado y no pudo renovar dentro de la ventana.",{"_3357":731,"_21031":660,"_17751":32601,"_5":21231,"_8158":32398,"_1362":32602},[],"**Allowed Renewal Delta**: ventana de tiempo previa a la caducidad durante la cual se permite el re-enrollment. Antes de que se abra esta ventana, la solicitud se rechaza con `invalid reenroll window`.",{"_3357":732,"_21031":660,"_17751":32604,"_5":21231,"_8158":32398,"_1362":32605},[],"**Preventive Renewal Delta**: tiempo previo a la caducidad a partir del cual se emiten alertas de renovación preventiva.",{"_3357":733,"_21031":660,"_17751":32607,"_5":21231,"_8158":32398,"_1362":32608},[],"**Critical Renewal Delta**: umbral más cercano al vencimiento que activa alertas de estado crítico.",{"_3357":734,"_21031":660,"_17751":32610,"_5":21231,"_8158":32398,"_1362":32611},[],"**Additional Validation CAs**: CAs adicionales aceptadas como emisoras del certificado en vigor durante el re-enrollment. Permite migrar a una nueva CA de enrolamiento sin interrumpir la renovación de dispositivos ya enrolados con la CA anterior.",{"_3357":735,"_21031":660,"_17751":32613,"_5":21231,"_8158":32402,"_1362":32614},[],"La sección **Server Key Generation** permite que Lamassu genere el par de claves del dispositivo en el servidor y lo devuelva junto con el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada.",{"_3357":736,"_21031":660,"_17751":32616,"_5":21231,"_8158":32402,"_1362":32617},[],"La opción **Enable Server-Side Key Generation** activa el endpoint `/serverkeygen`. Cuando está inactiva, cualquier llamada a ese endpoint se rechaza con `server key generation not enabled`.",{"_3357":737,"_21031":660,"_17751":32619,"_5":21231,"_8158":32402,"_1362":32620},[],"**Key Type** selecciona el algoritmo: `RSA` o `ECDSA`. El campo &#x2A;*Key Size (bits)** determina el tamaño de la clave. Para ECDSA, el tamaño en bits determina también la curva: 256 corresponde a P-256, 384 a P-384 y 521 a P-521.",{"_3357":738,"_21031":660,"_17751":32622,"_5":21231,"_8158":32402,"_1362":32623},[],"La clave se genera en el motor software del servidor, no en un Crypto Engine de hardware como AWS KMS o PKCS#11. La única protección de la clave en tránsito es el canal TLS; no se aplica cifrado adicional (CMS EnvelopedData) sobre la clave antes de enviarla al dispositivo. Consulte el apartado `/serverkeygen` de la referencia para integrador para conocer el formato exacto de la respuesta y las consideraciones de seguridad.",{"_3357":739,"_21031":660,"_17751":32625,"_5":21231,"_8158":32406,"_1362":32626},[],"Una vez aplicados los ajustes de enrollment, re-enrollment y ServerKeyGen, puede confirmar que el DMS está operativo de las siguientes formas:",{"_3357":740,"_21031":660,"_17751":32628,"_5":21231,"_8158":32406,"_1362":32629},[],"**Desde la consola**: accede al detalle del DMS y comprueba que la sección EST muestra la CA de enrolamiento asignada y el modo de autenticación configurado.",{"_3357":741,"_21031":660,"_17751":32631,"_5":21231,"_8158":32406,"_1362":32632},[],"**Con una solicitud de prueba**: invoca el endpoint `/cacerts` del DMS desde un cliente `curl` con la confianza del servidor. Una respuesta `200 OK` con contenido base64 confirma que el DMS está activo y que la CA de enrolamiento es accesible.",{"_3357":742,"_21031":660,"_17751":32634,"_5":21231,"_8158":32406,"_1362":32635},[],"Si el DMS no existe o la CA no está disponible, el servidor responde con `DMS not found` u otro mensaje de error. Consulte la sección Diagnóstico y compatibilidad para interpretar los mensajes de error.",{"_3357":743,"_21031":660,"_17751":32637,"_5":21231,"_8158":32410,"_1362":32638},[],"*Esta sección está dirigida al integrador de dispositivos.*",{"_3357":744,"_21031":660,"_17751":32640,"_5":21231,"_8158":32410,"_1362":32641},[],"Los endpoints EST de Lamassu se publican bajo el prefijo `/.well-known/est` y exigen siempre la presencia del segmento de ruta `{aps}`, que se interpreta como el identificador del DMS al que se dirige la operación. La asociación es directa: el valor de `{aps}` recibido en la URL se utiliza como ID de DMS al consultar el almacén interno. Las variantes registradas sin `{aps}` (por ejemplo `/.well-known/est/cacerts`) están enrutadas en el código, pero su gestor exige el campo `APS` y devuelve `400 Bad Request` con el mensaje `Field validation for 'APS' failed` cuando el segmento no se proporciona.",{"_3357":745,"_21031":660,"_17751":32643,"_5":21231,"_8158":32410,"_1362":32644},[],"Esta parte sigue el orden habitual de trabajo del integrador: primero los requisitos previos y el modelo de autenticación, después la referencia de cada endpoint y, al final, ejemplos completos y material de diagnóstico.",{"_3357":746,"_21031":660,"_17751":32646,"_5":21231,"_8158":32414,"_1362":32647},[],"El administrador PKI debe haber configurado un DMS con el protocolo `EST_RFC7030`, una CA de enrolamiento asignada y al menos un modo de autenticación. Sin esa configuración previa, Lamassu rechaza cualquier solicitud de enrolamiento. Los detalles de esa configuración se encuentran en la sección de configuración del DMS de esta misma página.",{"_3357":747,"_21031":660,"_17751":32649,"_5":21231,"_8158":32414,"_1362":32650},[],"Antes de realizar la primera llamada, asegúrese de tener:",{"_3357":748,"_21031":660,"_17751":32652,"_5":21231,"_8158":32414,"_1362":32653},[],"**La URL del host EST**, por ejemplo `https://est.lamassu.example`, proporcionada por el administrador PKI.",{"_3357":749,"_21031":660,"_17751":32655,"_5":21231,"_8158":32414,"_1362":32656},[],"**El ancla de confianza del servidor** (`lamassu-trust.pem`), raíz o intermedia, con la que el cliente validará el TLS de Lamassu.",{"_3357":750,"_21031":660,"_17751":32658,"_5":21231,"_8158":32414,"_1362":32659},[],"**El certificado bootstrap y su clave privada** si el DMS usa `CLIENT_CERTIFICATE` o `CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`. Esta identidad debe proceder de una de las `ValidationCAs` configuradas, normalmente una CA de aprovisionamiento distinta de la CA de enrolamiento.",{"_3357":751,"_21031":660,"_17751":32661,"_5":21231,"_8158":32414,"_1362":32662},[],"**El ID del DMS** (`{aps}`), que debe aparecer en todas las rutas EST.",{"_3357":752,"_21031":660,"_17751":32664,"_5":21231,"_8158":32417,"_1362":32665},[],"**Descargue la confianza con `/cacerts`:** el cliente valida el TLS del servidor y recibe los certificados en PKCS#7 o PEM.",{"_3357":753,"_21031":660,"_17751":32667,"_5":21231,"_8158":32417,"_1362":32668},[],"**Realice el alta inicial con `/simpleenroll`:** presente el certificado bootstrap o la credencial definida por `AuthMode` para obtener el certificado del dispositivo.",{"_3357":754,"_21031":660,"_17751":32670,"_5":21231,"_8158":32417,"_1362":32671},[],"**Renueve con `/simplereenroll`:** autentíquese con el certificado actual del dispositivo para obtener uno nuevo.",{"_3357":755,"_21031":660,"_17751":32673,"_5":21231,"_8158":32417,"_1362":32674},[],"**Use `/serverkeygen` solo si necesita generación de claves en servidor:** aplica la misma autenticación que `/simpleenroll` y devuelve la clave privada PKCS#8 junto con el certificado.",{"_3357":756,"_21031":660,"_17751":32676,"_5":21231,"_8158":32421,"_1362":32677},[],"La implementación de Lamassu reconoce cuatro configuraciones de autenticación para `/simpleenroll`, expresadas mediante el campo `EnrollmentOptionsESTRFC7030.AuthMode` del DMS. Tres son modos simples (`CLIENT_CERTIFICATE`, `EXTERNAL_WEBHOOK`, `NO_AUTH`) y una combina dos controles (`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`). El cliente debe presentarse en el modo que el DMS espera; cualquier otra combinación genera un fallo en la inscripción.",{"_3357":757,"_21031":660,"_17751":32679,"_5":21231,"_8158":32421,"_1362":32680},[],"Modo (`AuthMode`)",{"_3357":758,"_21031":660,"_17751":32682,"_5":21231,"_8158":32421,"_1362":30663},[],{"_3357":759,"_21031":660,"_17751":32684,"_5":21231,"_8158":32421,"_1362":32685},[],"Credencial esperada",{"_3357":760,"_21031":660,"_17751":32687,"_5":21231,"_8158":32421,"_1362":32688},[],"Aplica en enroll",{"_3357":761,"_21031":660,"_17751":32690,"_5":21231,"_8158":32421,"_1362":32691},[],"Aplica en reenroll",{"_3357":762,"_21031":660,"_17751":32693,"_5":21231,"_8158":32421,"_1362":32694},[],"`CLIENT_CERTIFICATE`",{"_3357":763,"_21031":660,"_17751":32696,"_5":21231,"_8158":32421,"_1362":32697},[],"mTLS con certificado X.509",{"_3357":764,"_21031":660,"_17751":32699,"_5":21231,"_8158":32421,"_1362":32700},[],"Certificado y clave privada cliente",{"_3357":765,"_21031":660,"_17751":32702,"_5":21231,"_8158":32421,"_1362":32703},[],"Sí",{"_3357":766,"_21031":660,"_17751":32705,"_5":21231,"_8158":32421,"_1362":32706},[],"Sí (con el certificado en vigor)",{"_3357":767,"_21031":660,"_17751":32708,"_5":21231,"_8158":32421,"_1362":32709},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3357":768,"_21031":660,"_17751":32711,"_5":21231,"_8158":32421,"_1362":32712},[],"mTLS más validación por webhook",{"_3357":769,"_21031":660,"_17751":32714,"_5":21231,"_8158":32421,"_1362":32715},[],"Certificado y clave privada cliente, más aprobación del webhook",{"_3357":770,"_21031":660,"_17751":32717,"_5":21231,"_8158":32421,"_1362":32703},[],{"_3357":771,"_21031":660,"_17751":32719,"_5":21231,"_8158":32421,"_1362":32720},[],"No como combinación; en reenroll no mantiene ambos controles",{"_3357":772,"_21031":660,"_17751":32722,"_5":21231,"_8158":32421,"_1362":32723},[],"`EXTERNAL_WEBHOOK`",{"_3357":773,"_21031":660,"_17751":32725,"_5":21231,"_8158":32421,"_1362":32726},[],"Webhook externo de autorización",{"_3357":774,"_21031":660,"_17751":32728,"_5":21231,"_8158":32421,"_1362":32729},[],"Ninguna en el canal TLS",{"_3357":775,"_21031":660,"_17751":32731,"_5":21231,"_8158":32421,"_1362":32703},[],{"_3357":776,"_21031":660,"_17751":32733,"_5":21231,"_8158":32421,"_1362":32734},[],"No, degrada a `NO_AUTH`",{"_3357":777,"_21031":660,"_17751":32736,"_5":21231,"_8158":32421,"_1362":32737},[],"`NO_AUTH`",{"_3357":778,"_21031":660,"_17751":32739,"_5":21231,"_8158":32421,"_1362":32740},[],"Sin autenticación",{"_3357":779,"_21031":660,"_17751":32742,"_5":21231,"_8158":32421,"_1362":32743},[],"Ninguna",{"_3357":780,"_21031":660,"_17751":32745,"_5":21231,"_8158":32421,"_1362":32746},[],"Sí (uso restringido)",{"_3357":781,"_21031":660,"_17751":32748,"_5":21231,"_8158":32421,"_1362":32746},[],{"_3357":782,"_21031":660,"_17751":32750,"_5":21231,"_8158":32421,"_1362":32751},[],"JWT **no es un modo de autenticación válido en EST**. El extractor de identidad JWT existe en el código pero solo se evalúa en la API de administración de Lamassu. Cualquier *Bearer token* enviado a `/.well-known/est/...` se ignora silenciosamente. Cuando el DMS está configurado con `AuthMode: CLIENT_CERTIFICATE`, una petición que solo aporte JWT se rechaza por falta de certificado cliente. Cuando el DMS está en `AuthMode: NO_AUTH`, la petición se procesa como tal y el JWT no añade ni resta autorización.",{"_3357":783,"_21031":660,"_17751":32753,"_5":21231,"_8158":32421,"_1362":32754},[],"**`CLIENT_CERTIFICATE`**: el cliente presenta un certificado X.509 emitido por una de las CAs declaradas en `AuthOptionsMTLS.ValidationCAs`. El proceso valida la cadena del certificado contra esas CAs mediante los parámetros `ValidationCAs`, `AllowExpired` y `ChainLevelValidation`. Además, el servicio comprueba el estado de revocación en tres pasos: primero busca el cert en la base de datos local de Lamassu; si no lo encuentra, consulta los responders OCSP listados en la extensión AIA; si OCSP falla, intenta los CRL Distribution Points (CDP). Un certificado revocado interrumpe la inscripción con `certificate is revoked`.",{"_3357":784,"_21031":660,"_17751":32756,"_5":21231,"_8158":32421,"_1362":32757},[],"Sus parámetros principales son `ValidationCAs`, la lista de CAs que pueden validar el certificado bootstrap o el certificado en vigor; `AllowExpired`, que permite aceptar certificados cliente caducados; y `ChainLevelValidation`, que limita la profundidad de la cadena cuando su valor es mayor que cero.",{"_3357":785,"_21031":660,"_17751":32759,"_5":21231,"_8158":32421,"_1362":32760},[],"**`EXTERNAL_WEBHOOK`**: Lamassu delega la decisión de autorización en un servicio HTTP externo. El servidor EST construye una petición `POST` al webhook configurado con un cuerpo JSON que reproduce el contexto de la inscripción.",{"_3357":786,"_21031":660,"_17751":32762,"_5":21231,"_8158":32421,"_1362":32763},[],"El valor del campo `csr` es la **codificación base64 del PEM** del CSR (no el DER, y no el PEM en claro). El webhook debe responder con `2xx` y un cuerpo JSON `{\"authorized\": true}` para continuar; cualquier otra respuesta aborta el enrolamiento con `external webhook denied enrollment`. Un `204 No Content` **no es una respuesta válida** aunque sea un código `2xx`: Lamassu exige un cuerpo JSON con el campo `authorized`, así que un webhook que responda sin cuerpo deniega la operación igual que un error.",{"_3357":787,"_21031":660,"_17751":32765,"_5":21231,"_8158":32421,"_1362":32766},[],"**`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`**: combina los dos modos anteriores durante `/simpleenroll`. El cliente debe presentar un certificado mTLS válido y el webhook debe devolver `authorized: true`. En `/simplereenroll` la combinación no se conserva: el chequeo conjunto mTLS + webhook no se mantiene, por lo que el integrador no debe asumir que las mismas garantías del enrollment inicial aplican en reenroll.",{"_3357":788,"_21031":660,"_17751":32768,"_5":21231,"_8158":32421,"_1362":32769},[],"**`NO_AUTH`**: el DMS acepta cualquier CSR sin validar identidad del cliente. Lamassu emite un aviso en su log (`DMS is configured with NoAuth, allowing enrollment`) y procede al alta. Debe restringirse a entornos controlados (una red de aprovisionamiento aislada); cualquier red expuesta a internet con un DMS en `NO_AUTH` queda abierta a la emisión de certificados por terceros no autorizados.",{"_3357":789,"_21031":660,"_17751":32771,"_5":21231,"_8158":32425,"_1362":32772},[],"Las siguientes secciones describen los endpoints en el orden más habitual de uso dentro del ciclo de vida del dispositivo:",{"_3357":790,"_21031":660,"_17751":32774,"_5":21231,"_8158":32425,"_1362":32775},[],"`/cacerts`: descarga de la cadena de confianza.",{"_3357":791,"_21031":660,"_17751":32777,"_5":21231,"_8158":32425,"_1362":32778},[],"`/simpleenroll`: inscripción inicial del certificado.",{"_3357":792,"_21031":660,"_17751":32780,"_5":21231,"_8158":32425,"_1362":32781},[],"`/simplereenroll`: renovación de un certificado ya emitido.",{"_3357":793,"_21031":660,"_17751":32783,"_5":21231,"_8158":32425,"_1362":32784},[],"`/serverkeygen`: inscripción con generación de clave en servidor.",{"_3357":794,"_21031":660,"_17751":32786,"_5":21231,"_8158":32429,"_1362":32787},[],"El endpoint `GET /.well-known/est/{aps}/cacerts` distribuye los certificados que el dispositivo necesita para validar al servidor EST y al resto de las CAs gestionadas por el DMS. Lamassu inserta los certificados en este orden: primero el certificado **downstream** del servidor Lamassu, que es la hoja TLS del servidor y no una CA, útil para pinning si `IncludeLamassuSystemCA` está activado; después la lista `ManagedCAs` declarada en el DMS; y por último la CA de enrolamiento, si `IncludeEnrollmentCA` está activado.",{"_3357":795,"_21031":660,"_17751":32789,"_5":21231,"_8158":32429,"_1362":32790},[],"`CADistributionSettings` permite decidir qué se publica:",{"_3357":796,"_21031":660,"_17751":32792,"_5":21231,"_8158":32429,"_1362":32793},[],"**`IncludeLamassuSystemCA`** añade el certificado *downstream* del servidor Lamassu. Es la hoja TLS que el cliente puede usar para anclar la conexión, no una CA.",{"_3357":797,"_21031":660,"_17751":32795,"_5":21231,"_8158":32429,"_1362":32796},[],"**`IncludeEnrollmentCA`** añade la CA emisora del DMS, responsable de firmar los certificados de dispositivo.",{"_3357":798,"_21031":660,"_17751":32798,"_5":21231,"_8158":32429,"_1362":32799},[],"**`ManagedCAs`** publica CAs adicionales como anclas de confianza.",{"_3357":799,"_21031":660,"_17751":32801,"_5":21231,"_8158":32429,"_1362":32802},[],"El formato por defecto es PKCS#7 *degenerate* (sólo certificados) codificado en base64. La respuesta declara `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El base64 viene troceado en líneas de **76 caracteres** terminadas en CRLF, una anchura conforme con S/MIME (RFC 5751), no los 64 que sugieren ciertas guías de RFC 7030. Este troceo aplica únicamente a `/cacerts` y `/simpleenroll`; las partes internas de `/serverkeygen` no llevan wrap, como se explica más abajo.",{"_3357":800,"_21031":660,"_17751":32804,"_5":21231,"_8158":32429,"_1362":32805},[],"El PKCS#7 *degenerate* es un **conjunto** de certificados sin orden semántico definido. Aunque Lamassu los inserta en el orden indicado, el integrador no debe asumir ese orden al validar cadenas: la cadena debe construirse por correspondencia `Subject`/`Issuer` (o por AKI/SKI), no por la posición en la respuesta.",{"_3357":801,"_21031":660,"_17751":32807,"_5":21231,"_8158":32429,"_1362":32808},[],"El flag `-i` (ignore garbage) ayuda a tolerar el CRLF que Lamassu añade y es necesario en algunos `base64` (BusyBox, BSD); en GNU coreutils se ignora.",{"_3357":802,"_21031":660,"_17751":32810,"_5":21231,"_8158":32429,"_1362":32811},[],"Lamassu añade además una extensión sobre el RFC: si el cliente envía la cabecera `Accept: application/x-pem-file`, el servidor responde con la concatenación PEM de los mismos certificados, sin el envoltorio PKCS#7. Esto facilita el consumo desde scripts. La extensión también funciona en `/simpleenroll` y `/simplereenroll`.",{"_3357":803,"_21031":660,"_17751":32813,"_5":21231,"_8158":32433,"_1362":32814},[],"El endpoint `POST /.well-known/est/{aps}/simpleenroll` recibe un CSR y devuelve el certificado emitido. El cuerpo de la petición debe ser el **PKCS#10 (CSR) en DER, codificado en base64** sin saltos de línea. La base64 envuelve directamente al DER, no al PEM. La cabecera `Content-Type` debe valer `application/pkcs10`. Si el `Content-Type` es diferente, el servidor responde `400` con `content-type must be application/pkcs10`; si el cuerpo no es base64 válido, responde `400` con `body payload must be base64 encoded`.",{"_3357":804,"_21031":660,"_17751":32816,"_5":21231,"_8158":32433,"_1362":32817},[],"La respuesta sigue el mismo envoltorio que `/cacerts`: PKCS#7 *degenerate* en base64, con `Content-Type: application/pkcs7-mime; smime-type=certs-only`. El PKCS#7 contiene **únicamente el certificado de hoja** recién emitido; no incluye la CA emisora ni intermediarios. Esto cumple RFC 7030 §4.2.3 (donde la cadena es opcional) pero implica que el integrador debe combinar este certificado con la cadena obtenida de `/cacerts` antes de presentarlo a cualquier relying party que valide cadena completa (por ejemplo, un broker MQTT con mTLS estricta).",{"_3357":805,"_21031":660,"_17751":32819,"_5":21231,"_8158":32433,"_1362":32820},[],"Varios campos del DMS gobiernan el comportamiento de `/simpleenroll`. El integrador no los configura, pero conviene conocerlos para interpretar los rechazos:",{"_3357":806,"_21031":660,"_17751":32822,"_5":21231,"_8158":32433,"_1362":32823},[],"**`EnrollmentSettings.RegistrationMode`** decide si el dispositivo se crea durante la primera inscripción (`JITP`) o debe existir previamente (`PRE_REGISTRATION`).",{"_3357":807,"_21031":660,"_17751":32825,"_5":21231,"_8158":32433,"_1362":32826},[],"**`EnrollmentSettings.EnableReplaceableEnrollment`** permite repetir `/simpleenroll` para un dispositivo ya enrolado. Al hacerlo, revoca el certificado anterior como `superseded`; si está desactivado, el servidor responde con `forbiddenNewEnrollment`.",{"_3357":808,"_21031":660,"_17751":32828,"_5":21231,"_8158":32433,"_1362":32829},[],"**`EnrollmentSettings.VerifyCSRSignature`** valida que quien envía el CSR controla la clave privada declarada. Para flotas IoT en redes abiertas debe estar activo.",{"_3357":809,"_21031":660,"_17751":32831,"_5":21231,"_8158":32433,"_1362":32832},[],"En modo `JITP`, el primer `simpleenroll` con un `CommonName` que aún no existe en Lamassu crea el dispositivo automáticamente. En modo `PRE_REGISTRATION`, el dispositivo debe existir previamente; un `CommonName` desconocido se rechaza con `device not preregistered`. Consulte Configuración de enrollment para más detalles sobre ambos modos y el comportamiento del perfil de emisión.",{"_3357":810,"_21031":660,"_17751":32834,"_5":21231,"_8158":32437,"_1362":32835},[],"El endpoint `POST /.well-known/est/{aps}/simplereenroll` renueva el certificado de un dispositivo ya enrolado. El formato del cuerpo es idéntico al de `/simpleenroll` (DER base64 sin saltos, `Content-Type: application/pkcs10`). La diferencia está en la autenticación: el cliente debe presentar **el certificado en vigor** del dispositivo (no el bootstrap) como credencial mTLS.",{"_3357":811,"_21031":660,"_17751":32837,"_5":21231,"_8158":32437,"_1362":32838},[],"Si el DMS está configurado con `AuthMode: EXTERNAL_WEBHOOK`, el webhook **no se invoca** durante `/simplereenroll`. El flujo de renovación degrada silenciosamente a `NO_AUTH`: cualquier cliente que conozca un `CommonName` válido puede solicitar reenroll para ese dispositivo sin autenticación (`allowing reenroll: using NO AUTH mode` en el log). Un DMS con `EXTERNAL_WEBHOOK` no debe usarse en producción para flujos de reenroll a menos que se controle la red de acceso al endpoint.",{"_3357":812,"_21031":660,"_17751":32840,"_5":21231,"_8158":32437,"_1362":32841},[],"El comportamiento del reenroll está condicionado por varios campos de `ReEnrollmentSettings`:",{"_3357":813,"_21031":660,"_17751":32843,"_5":21231,"_8158":32437,"_1362":32844},[],"**`ReEnrollmentDelta`** abre la ventana de renovación en `NotAfter - ReEnrollmentDelta`. Antes de ese instante, el servidor responde con `invalid reenroll window`.",{"_3357":814,"_21031":660,"_17751":32846,"_5":21231,"_8158":32437,"_1362":32847},[],"**`EnableExpiredRenewal`** permite usar un certificado ya caducado como prueba de identidad; si está desactivado, el servidor responde con `expired certificate`.",{"_3357":815,"_21031":660,"_17751":32849,"_5":21231,"_8158":32437,"_1362":32850},[],"**`RevokeOnReEnrollment`** revoca el certificado anterior como `superseded` después de emitir el nuevo.",{"_3357":816,"_21031":660,"_17751":32852,"_5":21231,"_8158":32437,"_1362":32853},[],"**`AdditionalValidationCAs`** añade emisores válidos para el certificado actual, además de la CA de enrolamiento del DMS.",{"_3357":817,"_21031":660,"_17751":32855,"_5":21231,"_8158":32437,"_1362":32856},[],"**Inmutabilidad del subject**: el CSR de renovación debe tener exactamente el mismo subject que el certificado en vigor. Lamassu compara, byte a byte, el `RawSubject` del CSR con el del certificado (`slices.Compare`). Si los bytes difieren, el servidor cae a una comparación semántica de respaldo sobre los atributos `CommonName`, `OrganizationalUnit`, `Organization`, `Locality`, `Province` y `Country`. Si todos esos atributos coinciden, el reenroll continúa pese a la diferencia de bytes (rescata casos donde solo cambia la codificación, `PrintableString` frente a `UTF8String`). Si algún atributo difiere, el reenroll se aborta con `invalid RawSubject bytes`. El integrador debe regenerar el CSR con exactamente el mismo subject que en la inscripción inicial para no depender del comportamiento de fallback.",{"_3357":818,"_21031":660,"_17751":32858,"_5":21231,"_8158":32437,"_1362":32859},[],"**Validación de la cadena del certificado presentado**: la validación se intenta primero contra la CA de enrolamiento del DMS; si falla, recorre las `AdditionalValidationCAs`. La validación es \"shallow\": cada CA se prueba como ancla, no se compone una cadena multinivel. El cliente debe presentar la cadena completa en el handshake mTLS. Un certificado revocado aborta el reenroll con `certificate is revoked`.",{"_3357":819,"_21031":660,"_17751":32861,"_5":21231,"_8158":32441,"_1362":32862},[],"El endpoint `POST /.well-known/est/{aps}/serverkeygen` permite que Lamassu genere el par de claves del dispositivo en el servidor y devuelva, en la misma respuesta, la clave privada y el certificado emitido. Es útil para dispositivos con capacidad criptográfica limitada o flujos donde la clave se aprovisiona durante la fabricación.",{"_3357":820,"_21031":660,"_17751":32864,"_5":21231,"_8158":32441,"_1362":32865},[],"Este endpoint requiere que `ServerKeyGen.Enabled` valga `true` en el DMS. Si no está activado, el servidor responde con `server key generation not enabled`. La autenticación se aplica igual que en `/simpleenroll`: el integrador presenta la credencial que corresponda al `AuthMode` del DMS.",{"_3357":821,"_21031":660,"_17751":32867,"_5":21231,"_8158":32441,"_1362":32868},[],"El algoritmo y el tamaño de la clave generada se deciden por el DMS, no por el cliente.",{"_3357":822,"_21031":660,"_17751":32870,"_5":21231,"_8158":32441,"_1362":32871},[],"**RSA** admite cualquier tamaño aceptado por `crypto/rsa`; los valores habituales son 2048, 3072 y 4096 bits. Un valor no válido hace fallar la generación con un error `500`.",{"_3357":823,"_21031":660,"_17751":32873,"_5":21231,"_8158":32441,"_1362":32874},[],"**ECDSA** admite 224, 256, 384 y 521 bits, equivalentes a P-224, P-256 (`prime256v1`), P-384 y P-521. Cualquier otro valor degrada **silenciosamente** a P-256 y solo deja un aviso en el log: el cliente no recibe un error y puede obtener una curva distinta de la esperada.",{"_3357":824,"_21031":660,"_17751":32876,"_5":21231,"_8158":32441,"_1362":32877},[],"El CSR enviado por el cliente sirve únicamente para transportar el subject y las extensiones; la prueba de posesión PKCS#10 no aplica aquí porque el cliente no es quien generó la clave. Lamassu descarta la clave pública del CSR original, genera un par de claves nuevo con su entropía interna, en motor software y no en un Crypto Engine de hardware como AWS KMS o PKCS#11, construye un CSR nuevo con esa clave y procede a una inscripción interna equivalente a `/simpleenroll`.",{"_3357":825,"_21031":660,"_17751":32879,"_5":21231,"_8158":32441,"_1362":32880},[],"La respuesta es un `multipart/mixed` con el boundary literal `estServerLamassuBoundary`. Contiene dos partes:",{"_3357":826,"_21031":660,"_17751":32882,"_5":21231,"_8158":32441,"_1362":32883},[],"La clave privada en formato **PKCS#8 sin cifrar**, codificada en base64 dentro de una parte con `Content-Type: application/pkcs8`.",{"_3357":827,"_21031":660,"_17751":32885,"_5":21231,"_8158":32441,"_1362":32886},[],"El certificado emitido en PKCS#7 *degenerate* base64, dentro de una parte con `Content-Type: application/pkcs7-mime; smime-type=certs-only`.",{"_3357":828,"_21031":660,"_17751":32888,"_5":21231,"_8158":32441,"_1362":32889},[],"A diferencia de `/cacerts` y `/simpleenroll`, donde el base64 va troceado en líneas de 76 caracteres, cada parte de `/serverkeygen` viaja como **una única línea base64 sin saltos**. Cualquier proxy inverso que reescriba el cuerpo (por ejemplo, normalizando line endings) puede romper el parseo.",{"_3357":829,"_21031":660,"_17751":32891,"_5":21231,"_8158":32441,"_1362":32892},[],"Este endpoint invierte el principio PKI por el que el subscriber controla su clave privada. La clave se serializa en PKCS#8 sin cifrar (`PrivateKeyInfo`, sin `EncryptedPrivateKeyInfo`). No se aplica el envoltorio CMS `EnvelopedData` contemplado en RFC 7030 §4.4.2; no se aplica AES key wrap ni cifrado simétrico por contraseña. La única protección es el TLS del canal. El integrador debe garantizar que: (a) ningún proxy inverso termine TLS y registre el cuerpo de la respuesta; (b) la clave se cifre en reposo inmediatamente tras recibirla; (c) la cuenta de auditoría en el servidor Lamassu queda como punto único de origen de la clave.",{"_3357":830,"_21031":660,"_17751":32894,"_5":21231,"_8158":32441,"_1362":32895},[],"Para separar las dos partes, el siguiente fragmento usa `awk` con el boundary literal. Funciona con la estructura exacta de Lamassu (cada parte = headers + línea en blanco + una sola línea base64); cualquier proxy intermedio que reescriba el cuerpo lo romperá.",{"_3357":831,"_21031":660,"_17751":32897,"_5":21231,"_8158":32445,"_1362":32898},[],"Una vez revisados los endpoints por separado, estos ejemplos muestran cómo encadenarlos en dos escenarios habituales: el alta inicial de un dispositivo y la renovación de un certificado ya emitido.",{"_3357":832,"_21031":660,"_17751":32900,"_5":21231,"_8158":32449,"_1362":32901},[],"El siguiente script ilustra el proceso completo de inscripción de un dispositivo con clave EC P-256 generada localmente y autenticación mTLS contra un certificado bootstrap.",{"_3357":833,"_21031":660,"_17751":32903,"_5":21231,"_8158":32453,"_1362":32904},[],"El siguiente script reproduce un proceso de renovación: detecta la expiración del certificado actual, regenera el CSR con el **mismo subject** y se autentica con el certificado en vigor.",{"_3357":834,"_21031":660,"_17751":32906,"_5":21231,"_8158":32457,"_1362":32907},[],"Una vez que el dispositivo ha obtenido su certificado de identidad, los pasos habituales son:",{"_3357":835,"_21031":660,"_17751":32909,"_5":21231,"_8158":32457,"_1362":32910},[],"**Instalar la cadena de confianza** (`cacerts.pem`) en el almacén de confianza del dispositivo. El broker MQTT, el servidor HTTPS o cualquier relying party que valide mTLS necesitará esta cadena.",{"_3357":836,"_21031":660,"_17751":32912,"_5":21231,"_8158":32457,"_1362":32913},[],"**Combinar el certificado de hoja con la cadena** antes de presentarlo en conexiones mTLS. La respuesta de `/simpleenroll` contiene solo el certificado de hoja; el relying party puede rechazar la conexión si no recibe la cadena completa.",{"_3357":837,"_21031":660,"_17751":32915,"_5":21231,"_8158":32457,"_1362":32916},[],"**Planificar la renovación**: configurar en el dispositivo un temporizador que invoque `/simplereenroll` dentro de la ventana `ReEnrollmentDelta` antes de la caducidad del certificado. No espere a que caduque salvo que `EnableExpiredRenewal` esté activo.",{"_3357":838,"_21031":660,"_17751":32918,"_5":21231,"_8158":32465,"_1362":32919},[],"Lamassu mapea casi todos los errores de negocio a `500 Internal Server Error`, no a `4xx`. El código de estado HTTP no es suficiente para distinguir entre un error de red y un error de política. El integrador debe inspeccionar el campo `err` del cuerpo JSON (`{\"err\": \"<mensaje>\"}`) para determinar la causa exacta del fallo.",{"_3357":839,"_21031":660,"_17751":32921,"_5":21231,"_8158":32465,"_1362":32922},[],"HTTP",{"_3357":840,"_21031":660,"_17751":32924,"_5":21231,"_8158":32465,"_1362":32925},[],"Mensaje",{"_3357":841,"_21031":660,"_17751":32927,"_5":21231,"_8158":32465,"_1362":32928},[],"Causa",{"_3357":842,"_21031":660,"_17751":32930,"_5":21231,"_8158":32465,"_1362":32931},[],"Acción del integrador",{"_3357":843,"_21031":660,"_17751":32933,"_5":21231,"_8158":32465,"_1362":19589},[],{"_3357":844,"_21031":660,"_17751":32935,"_5":21231,"_8158":32465,"_1362":32936},[],"`Field validation for 'APS' failed`",{"_3357":845,"_21031":660,"_17751":32938,"_5":21231,"_8158":32465,"_1362":32939},[],"El segmento `{aps}` falta en la URL.",{"_3357":846,"_21031":660,"_17751":32941,"_5":21231,"_8158":32465,"_1362":32942},[],"Incluir el ID del DMS en la ruta.",{"_3357":847,"_21031":660,"_17751":32944,"_5":21231,"_8158":32465,"_1362":19589},[],{"_3357":848,"_21031":660,"_17751":32946,"_5":21231,"_8158":32465,"_1362":32947},[],"`content-type must be application/pkcs10`",{"_3357":849,"_21031":660,"_17751":32949,"_5":21231,"_8158":32465,"_1362":32950},[],"Cabecera `Content-Type` ausente o incorrecta.",{"_3357":850,"_21031":660,"_17751":32952,"_5":21231,"_8158":32465,"_1362":32953},[],"Fijar `Content-Type: application/pkcs10`.",{"_3357":851,"_21031":660,"_17751":32955,"_5":21231,"_8158":32465,"_1362":19589},[],{"_3357":852,"_21031":660,"_17751":32957,"_5":21231,"_8158":32465,"_1362":32958},[],"`body payload must be base64 encoded`",{"_3357":853,"_21031":660,"_17751":32960,"_5":21231,"_8158":32465,"_1362":32961},[],"El cuerpo no es base64 válido.",{"_3357":854,"_21031":660,"_17751":32963,"_5":21231,"_8158":32465,"_1362":32964},[],"Usar `base64 -w 0` para evitar saltos de línea.",{"_3357":855,"_21031":660,"_17751":32966,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":856,"_21031":660,"_17751":32968,"_5":21231,"_8158":32465,"_1362":32969},[],"`DMS not found`",{"_3357":857,"_21031":660,"_17751":32971,"_5":21231,"_8158":32465,"_1362":32972},[],"El valor `{aps}` no se corresponde con ningún DMS.",{"_3357":858,"_21031":660,"_17751":32974,"_5":21231,"_8158":32465,"_1362":32975},[],"Verificar el identificador con el administrador PKI.",{"_3357":859,"_21031":660,"_17751":32977,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":860,"_21031":660,"_17751":32979,"_5":21231,"_8158":32465,"_1362":32980},[],"`invalid certificate`",{"_3357":861,"_21031":660,"_17751":32982,"_5":21231,"_8158":32465,"_1362":32983},[],"El certificado cliente no es válido contra `ValidationCAs`.",{"_3357":862,"_21031":660,"_17751":32985,"_5":21231,"_8158":32465,"_1362":32986},[],"Comprobar la cadena del certificado bootstrap.",{"_3357":863,"_21031":660,"_17751":32988,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":864,"_21031":660,"_17751":32990,"_5":21231,"_8158":32465,"_1362":32991},[],"`certificate is revoked`",{"_3357":865,"_21031":660,"_17751":32993,"_5":21231,"_8158":32465,"_1362":32994},[],"El certificado **presentado como credencial mTLS** está revocado en Lamassu o vía OCSP/CRL externos.",{"_3357":866,"_21031":660,"_17751":32996,"_5":21231,"_8158":32465,"_1362":32997},[],"Solicitar un nuevo certificado bootstrap o investigar la revocación.",{"_3357":867,"_21031":660,"_17751":32999,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":868,"_21031":660,"_17751":33001,"_5":21231,"_8158":32465,"_1362":33002},[],"`revoked certificate`",{"_3357":869,"_21031":660,"_17751":33004,"_5":21231,"_8158":32465,"_1362":33005},[],"En reenroll, el certificado **activo del dispositivo en la base de datos** figura como revocado.",{"_3357":870,"_21031":660,"_17751":33007,"_5":21231,"_8158":32465,"_1362":33008},[],"Revisar el estado del slot de identidad; si la revocación fue intencional, emitir un nuevo enroll en lugar de reenroll.",{"_3357":871,"_21031":660,"_17751":33010,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":872,"_21031":660,"_17751":33012,"_5":21231,"_8158":32465,"_1362":33013},[],"`expired certificate`",{"_3357":873,"_21031":660,"_17751":33015,"_5":21231,"_8158":32465,"_1362":33016},[],"El certificado presentado ha caducado y el DMS no permite `AllowExpired`/`EnableExpiredRenewal`.",{"_3357":874,"_21031":660,"_17751":33018,"_5":21231,"_8158":32465,"_1362":33019},[],"Renovar antes de la caducidad o solicitar habilitar `EnableExpiredRenewal`.",{"_3357":875,"_21031":660,"_17751":33021,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":876,"_21031":660,"_17751":33023,"_5":21231,"_8158":32465,"_1362":33024},[],"`forbiddenNewEnrollment`",{"_3357":877,"_21031":660,"_17751":33026,"_5":21231,"_8158":32465,"_1362":33027},[],"El dispositivo ya está enrolado y `EnableReplaceableEnrollment` es `false`.",{"_3357":878,"_21031":660,"_17751":33029,"_5":21231,"_8158":32465,"_1362":33030},[],"Usar `/simplereenroll` o pedir al administrador que habilite el flag.",{"_3357":879,"_21031":660,"_17751":33032,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":880,"_21031":660,"_17751":33034,"_5":21231,"_8158":32465,"_1362":33035},[],"`device not preregistered`",{"_3357":881,"_21031":660,"_17751":33037,"_5":21231,"_8158":32465,"_1362":33038},[],"El DMS está en `PRE_REGISTRATION` y el dispositivo no existe.",{"_3357":882,"_21031":660,"_17751":33040,"_5":21231,"_8158":32465,"_1362":33041},[],"Registrar el dispositivo antes de inscribirlo.",{"_3357":883,"_21031":660,"_17751":33043,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":884,"_21031":660,"_17751":33045,"_5":21231,"_8158":32465,"_1362":33046},[],"`invalid reenroll window`",{"_3357":885,"_21031":660,"_17751":33048,"_5":21231,"_8158":32465,"_1362":33049},[],"Se intenta renovar antes de `NotAfter - ReEnrollmentDelta`.",{"_3357":886,"_21031":660,"_17751":33051,"_5":21231,"_8158":32465,"_1362":33052},[],"Esperar a la apertura de la ventana o pedir un `ReEnrollmentDelta` mayor.",{"_3357":887,"_21031":660,"_17751":33054,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":888,"_21031":660,"_17751":33056,"_5":21231,"_8158":32465,"_1362":33057},[],"`invalid RawSubject bytes`",{"_3357":889,"_21031":660,"_17751":33059,"_5":21231,"_8158":32465,"_1362":33060},[],"El subject del CSR de renovación no coincide con el del certificado en vigor.",{"_3357":890,"_21031":660,"_17751":33062,"_5":21231,"_8158":32465,"_1362":33063},[],"Regenerar el CSR con el subject exacto del cert anterior.",{"_3357":891,"_21031":660,"_17751":33065,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":892,"_21031":660,"_17751":33067,"_5":21231,"_8158":32465,"_1362":33068},[],"`external webhook denied enrollment`",{"_3357":893,"_21031":660,"_17751":33070,"_5":21231,"_8158":32465,"_1362":33071},[],"El webhook devolvió un código no `2xx` o `authorized != true`.",{"_3357":894,"_21031":660,"_17751":33073,"_5":21231,"_8158":32465,"_1362":33074},[],"Revisar los logs del servicio webhook.",{"_3357":895,"_21031":660,"_17751":33076,"_5":21231,"_8158":32465,"_1362":19175},[],{"_3357":896,"_21031":660,"_17751":33078,"_5":21231,"_8158":32465,"_1362":33079},[],"`server key generation not enabled`",{"_3357":897,"_21031":660,"_17751":33081,"_5":21231,"_8158":32465,"_1362":33082},[],"`/serverkeygen` está deshabilitado en el DMS.",{"_3357":898,"_21031":660,"_17751":33084,"_5":21231,"_8158":32465,"_1362":33085},[],"Pedir al administrador activar `ServerKeyGen.Enabled`.",{"_3357":899,"_21031":660,"_17751":33087,"_5":21231,"_8158":32465,"_1362":33088},[],"Para los mensajes que no figuren en esta tabla, los logs del servidor Lamassu (con los campos `func`, `dms`, `device-cn`, `step`, `auth-method`, `auth-status`) son el primer lugar donde buscar la causa.",{"_3357":900,"_21031":660,"_17751":33090,"_5":21231,"_8158":32469,"_1362":33091},[],"La implementación de Lamassu se ajusta al RFC 7030 en lo esencial pero introduce varias particularidades que pueden afectar a clientes EST estrictos o a librerías de terceros:",{"_3357":901,"_21031":660,"_17751":33093,"_5":21231,"_8158":32469,"_1362":33094},[],"Los endpoints `/csrattrs` y `/fullcmc` del RFC 7030 **no están implementados** en Lamassu. Un cliente que invoque `/.well-known/est/<DMS_ID>/csrattrs` recibirá `404 Not Found` en lugar del `204 No Content` que el RFC sugiere para \"sin atributos\". Las librerías EST estrictas deben configurarse para no intentar `csrattrs`.",{"_3357":902,"_21031":660,"_17751":33096,"_5":21231,"_8158":32469,"_1362":33097},[],"El base64 de la respuesta de `/cacerts` y `/simpleenroll` se trocea en líneas de **76 caracteres** terminadas con CRLF (conforme con S/MIME, RFC 5751). Las partes de `/serverkeygen` no aplican wrap.",{"_3357":903,"_21031":660,"_17751":33099,"_5":21231,"_8158":32469,"_1362":33100},[],"El boundary del `multipart/mixed` en `/serverkeygen` está fijado y no se puede negociar.",{"_3357":904,"_21031":660,"_17751":33102,"_5":21231,"_8158":32469,"_1362":33103},[],"El segmento `{aps}` es **obligatorio** en todas las rutas EST. Las rutas registradas sin `{aps}` están en el código pero responden `400`.",{"_3357":905,"_21031":660,"_17751":33105,"_5":21231,"_8158":32469,"_1362":33106},[],"El cuerpo de `/cacerts`, `/simpleenroll` y `/simplereenroll` puede devolverse como PEM concatenado si el cliente envía `Accept: application/x-pem-file`. Esta es una extensión específica de Lamassu y no aparece en el RFC.",{"_3357":906,"_21031":660,"_17751":33108,"_5":21231,"_8158":32469,"_1362":33109},[],"El servidor no rechaza explícitamente CSRs firmados con SHA-1 o MD5; el integrador debe generar el CSR con SHA-256 o superior.",{"_3357":907,"_21031":660,"_17751":33111,"_5":21231,"_8158":32469,"_1362":33112},[],"<Card title=\"Visión general del DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3357":908,"_21031":660,"_17751":33114,"_5":21231,"_8158":32469,"_1362":33115},[],"<Card title=\"Validación OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3357":909,"_21031":660,"_17751":33117,"_5":21231,"_8158":32469,"_1362":33118},[],"<Card title=\"Gestionar dispositivos\" href=\"/docs/platform/pki/device-management\" />",{"_3357":910,"_21031":910,"_5":21226,"_1362":33120,"_21239":33121,"_17751":33123,"_8158":910},"AWS IoT Core",[30292,31351,33122],"Integraciones",[],{"_3357":911,"_21031":910,"_17751":33125,"_5":21231,"_8158":910,"_1362":33126},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3357":912,"_21031":910,"_5":21236,"_17751":33128,"_8158":33129,"_1362":33130},[],"/docs/platform/pki/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3357":913,"_21031":910,"_5":21236,"_17751":33132,"_8158":33133,"_1362":33134},[],"/docs/platform/pki/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3357":914,"_21031":910,"_5":21236,"_17751":33136,"_8158":33137,"_1362":33138},[],"/docs/platform/pki/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3357":915,"_21031":910,"_5":21236,"_17751":33140,"_8158":33141,"_1362":33142},[],"/docs/platform/pki/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3357":916,"_21031":910,"_5":21236,"_17751":33144,"_8158":33145,"_1362":33146},[],"/docs/platform/pki/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3357":917,"_21031":910,"_5":21236,"_17751":33148,"_8158":33149,"_1362":33150},[],"/docs/platform/pki/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3357":918,"_21031":910,"_5":21236,"_17751":33152,"_8158":33153,"_1362":33154},[],"/docs/platform/pki/integrations/aws-iot-core#primary-account","Primary Account",{"_3357":919,"_21031":910,"_5":21236,"_17751":33156,"_8158":33157,"_1362":33158},[],"/docs/platform/pki/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3357":920,"_21031":910,"_5":21236,"_17751":33160,"_8158":33161,"_1362":32376},[],"/docs/platform/pki/integrations/aws-iot-core#configuración-del-dms",{"_3357":921,"_21031":910,"_5":21236,"_17751":33163,"_8158":33164,"_1362":33165},[],"/docs/platform/pki/integrations/aws-iot-core#modo-none","Modo `none`",{"_3357":922,"_21031":910,"_5":21236,"_17751":33167,"_8158":33168,"_1362":33169},[],"/docs/platform/pki/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3357":923,"_21031":910,"_5":21236,"_17751":33171,"_8158":33172,"_1362":33173},[],"/docs/platform/pki/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3357":924,"_21031":910,"_5":21236,"_17751":33175,"_8158":33176,"_1362":33177},[],"/docs/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3357":925,"_21031":910,"_5":21236,"_17751":33179,"_8158":33180,"_1362":33181},[],"/docs/platform/pki/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3357":926,"_21031":910,"_5":21236,"_17751":33183,"_8158":33184,"_1362":33185},[],"/docs/platform/pki/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3357":927,"_21031":910,"_5":21236,"_17751":33187,"_8158":33188,"_1362":33189},[],"/docs/platform/pki/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3357":928,"_21031":910,"_5":21236,"_17751":33191,"_8158":33192,"_1362":33193},[],"/docs/platform/pki/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3357":929,"_21031":910,"_5":21236,"_17751":33195,"_8158":33196,"_1362":33197},[],"/docs/platform/pki/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3357":930,"_21031":910,"_5":21236,"_17751":33199,"_8158":33200,"_1362":33201},[],"/docs/platform/pki/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3357":931,"_21031":910,"_5":21236,"_17751":33203,"_8158":33204,"_1362":33205},[],"/docs/platform/pki/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3357":932,"_21031":910,"_17751":33207,"_5":21231,"_8158":910,"_1362":33208},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3357":933,"_21031":910,"_17751":33210,"_5":21231,"_8158":910,"_1362":33211},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3357":934,"_21031":910,"_17751":33213,"_5":21231,"_8158":910,"_1362":33214},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3357":935,"_21031":910,"_17751":33216,"_5":21231,"_8158":33129,"_1362":33217},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3357":936,"_21031":910,"_17751":33219,"_5":21231,"_8158":33129,"_1362":33220},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3357":937,"_21031":910,"_17751":33222,"_5":21231,"_8158":33129,"_1362":33223},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3357":938,"_21031":910,"_17751":33225,"_5":21231,"_8158":33129,"_1362":33226},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3357":939,"_21031":910,"_17751":33228,"_5":21231,"_8158":33133,"_1362":33229},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3357":940,"_21031":910,"_17751":33231,"_5":21231,"_8158":33137,"_1362":33232},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3357":941,"_21031":910,"_17751":33234,"_5":21231,"_8158":33137,"_1362":33235},[],"Acción IAM",{"_3357":942,"_21031":910,"_17751":33237,"_5":21231,"_8158":33137,"_1362":33238},[],"Propósito",{"_3357":943,"_21031":910,"_17751":33240,"_5":21231,"_8158":33137,"_1362":33241},[],"`iot:GetRegistrationCode`",{"_3357":944,"_21031":910,"_17751":33243,"_5":21231,"_8158":33137,"_1362":33244},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3357":945,"_21031":910,"_17751":33246,"_5":21231,"_8158":33137,"_1362":33247},[],"`iot:RegisterCACertificate`",{"_3357":946,"_21031":910,"_17751":33249,"_5":21231,"_8158":33137,"_1362":33250},[],"Registrar la CA en AWS IoT",{"_3357":947,"_21031":910,"_17751":33252,"_5":21231,"_8158":33137,"_1362":33253},[],"`iot:DescribeCACertificate`",{"_3357":948,"_21031":910,"_17751":33255,"_5":21231,"_8158":33137,"_1362":33256},[],"Consultar el estado del registro de la CA",{"_3357":949,"_21031":910,"_17751":33258,"_5":21231,"_8158":33137,"_1362":33259},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3357":950,"_21031":910,"_17751":33261,"_5":21231,"_8158":33137,"_1362":33262},[],"Crear o actualizar Things en IoT Core",{"_3357":951,"_21031":910,"_17751":33264,"_5":21231,"_8158":33137,"_1362":33265},[],"`iot:RegisterThing`",{"_3357":952,"_21031":910,"_17751":33267,"_5":21231,"_8158":33137,"_1362":33268},[],"Aprovisionar Things mediante plantilla",{"_3357":953,"_21031":910,"_17751":33270,"_5":21231,"_8158":33137,"_1362":33271},[],"`iot:RegisterCertificate`",{"_3357":954,"_21031":910,"_17751":33273,"_5":21231,"_8158":33137,"_1362":33274},[],"Registrar certificados de dispositivo",{"_3357":955,"_21031":910,"_17751":33276,"_5":21231,"_8158":33137,"_1362":33277},[],"`iot:UpdateCertificate`",{"_3357":956,"_21031":910,"_17751":33279,"_5":21231,"_8158":33137,"_1362":33280},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3357":957,"_21031":910,"_17751":33282,"_5":21231,"_8158":33137,"_1362":33283},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3357":958,"_21031":910,"_17751":33285,"_5":21231,"_8158":33137,"_1362":33286},[],"Crear y adjuntar políticas IoT",{"_3357":959,"_21031":910,"_17751":33288,"_5":21231,"_8158":33137,"_1362":33289},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3357":960,"_21031":910,"_17751":33291,"_5":21231,"_8158":33137,"_1362":33292},[],"Gestionar grupos de Things",{"_3357":961,"_21031":910,"_17751":33294,"_5":21231,"_8158":33137,"_1362":33295},[],"`iot:CreateProvisioningTemplate`",{"_3357":962,"_21031":910,"_17751":33297,"_5":21231,"_8158":33137,"_1362":33298},[],"Crear plantillas JITP",{"_3357":963,"_21031":910,"_17751":33300,"_5":21231,"_8158":33137,"_1362":33301},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3357":964,"_21031":910,"_17751":33303,"_5":21231,"_8158":33137,"_1362":33304},[],"Leer y escribir el Device Shadow",{"_3357":965,"_21031":910,"_17751":33306,"_5":21231,"_8158":33137,"_1362":33307},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3357":966,"_21031":910,"_17751":33309,"_5":21231,"_8158":33141,"_1362":33310},[],"Parámetro",{"_3357":967,"_21031":910,"_17751":33312,"_5":21231,"_8158":33141,"_1362":33313},[],"Tipo",{"_3357":968,"_21031":910,"_17751":33315,"_5":21231,"_8158":33141,"_1362":33316},[],"Requerido",{"_3357":969,"_21031":910,"_17751":33318,"_5":21231,"_8158":33141,"_1362":30663},[],{"_3357":970,"_21031":910,"_17751":33320,"_5":21231,"_8158":33141,"_1362":33321},[],"`connector_id`",{"_3357":971,"_21031":910,"_17751":33323,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":972,"_21031":910,"_17751":33325,"_5":21231,"_8158":33141,"_1362":32703},[],{"_3357":973,"_21031":910,"_17751":33327,"_5":21231,"_8158":33141,"_1362":33328},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3357":974,"_21031":910,"_17751":33330,"_5":21231,"_8158":33141,"_1362":33331},[],"`aws_config.region`",{"_3357":975,"_21031":910,"_17751":33333,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":976,"_21031":910,"_17751":33335,"_5":21231,"_8158":33141,"_1362":32703},[],{"_3357":977,"_21031":910,"_17751":33337,"_5":21231,"_8158":33141,"_1362":33338},[],"Región AWS donde opera el conector.",{"_3357":978,"_21031":910,"_17751":33340,"_5":21231,"_8158":33141,"_1362":33341},[],"`aws_config.auth_method`",{"_3357":979,"_21031":910,"_17751":33343,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":980,"_21031":910,"_17751":33345,"_5":21231,"_8158":33141,"_1362":32703},[],{"_3357":981,"_21031":910,"_17751":33347,"_5":21231,"_8158":33141,"_1362":33348},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3357":982,"_21031":910,"_17751":33350,"_5":21231,"_8158":33141,"_1362":33351},[],"`aws_config.access_key_id`",{"_3357":983,"_21031":910,"_17751":33353,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":984,"_21031":910,"_17751":33355,"_5":21231,"_8158":33141,"_1362":33356},[],"Solo con `auth_method=static`",{"_3357":985,"_21031":910,"_17751":33358,"_5":21231,"_8158":33141,"_1362":33359},[],"Clave de acceso AWS.",{"_3357":986,"_21031":910,"_17751":33361,"_5":21231,"_8158":33141,"_1362":33362},[],"`aws_config.secret_access_key`",{"_3357":987,"_21031":910,"_17751":33364,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":988,"_21031":910,"_17751":33366,"_5":21231,"_8158":33141,"_1362":33356},[],{"_3357":989,"_21031":910,"_17751":33368,"_5":21231,"_8158":33141,"_1362":33369},[],"Clave secreta AWS.",{"_3357":990,"_21031":910,"_17751":33371,"_5":21231,"_8158":33141,"_1362":33372},[],"`aws_config.session_token`",{"_3357":991,"_21031":910,"_17751":33374,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":992,"_21031":910,"_17751":33376,"_5":21231,"_8158":33141,"_1362":33377},[],"No",{"_3357":993,"_21031":910,"_17751":33379,"_5":21231,"_8158":33141,"_1362":33380},[],"Token de sesión (con `auth_method=static`).",{"_3357":994,"_21031":910,"_17751":33382,"_5":21231,"_8158":33141,"_1362":33383},[],"`aws_config.role_arn`",{"_3357":995,"_21031":910,"_17751":33385,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":996,"_21031":910,"_17751":33387,"_5":21231,"_8158":33141,"_1362":33388},[],"Solo con `auth_method=role`",{"_3357":997,"_21031":910,"_17751":33390,"_5":21231,"_8158":33141,"_1362":33391},[],"ARN del rol a asumir.",{"_3357":998,"_21031":910,"_17751":33393,"_5":21231,"_8158":33141,"_1362":33394},[],"`aws_config.endpoint_url`",{"_3357":999,"_21031":910,"_17751":33396,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":1000,"_21031":910,"_17751":33398,"_5":21231,"_8158":33141,"_1362":33377},[],{"_3357":1001,"_21031":910,"_17751":33400,"_5":21231,"_8158":33141,"_1362":33401},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3357":1002,"_21031":910,"_17751":33403,"_5":21231,"_8158":33141,"_1362":33404},[],"`subscriber_event_bus`",{"_3357":1003,"_21031":910,"_17751":33406,"_5":21231,"_8158":33141,"_1362":13438},[],{"_3357":1004,"_21031":910,"_17751":33408,"_5":21231,"_8158":33141,"_1362":32703},[],{"_3357":1005,"_21031":910,"_17751":33410,"_5":21231,"_8158":33141,"_1362":33411},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3357":1006,"_21031":910,"_17751":33413,"_5":21231,"_8158":33141,"_1362":33414},[],"`dms_manager_client`",{"_3357":1007,"_21031":910,"_17751":33416,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":1008,"_21031":910,"_17751":33418,"_5":21231,"_8158":33141,"_1362":32703},[],{"_3357":1009,"_21031":910,"_17751":33420,"_5":21231,"_8158":33141,"_1362":33421},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3357":1010,"_21031":910,"_17751":33423,"_5":21231,"_8158":33141,"_1362":33424},[],"`device_manager_client`",{"_3357":1011,"_21031":910,"_17751":33426,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":1012,"_21031":910,"_17751":33428,"_5":21231,"_8158":33141,"_1362":32703},[],{"_3357":1013,"_21031":910,"_17751":33430,"_5":21231,"_8158":33141,"_1362":33431},[],"URL HTTP del Device Manager de Lamassu.",{"_3357":1014,"_21031":910,"_17751":33433,"_5":21231,"_8158":33141,"_1362":33434},[],"`ca_client`",{"_3357":1015,"_21031":910,"_17751":33436,"_5":21231,"_8158":33141,"_1362":17441},[],{"_3357":1016,"_21031":910,"_17751":33438,"_5":21231,"_8158":33141,"_1362":32703},[],{"_3357":1017,"_21031":910,"_17751":33440,"_5":21231,"_8158":33141,"_1362":33441},[],"URL HTTP del servicio de CA de Lamassu.",{"_3357":1018,"_21031":910,"_17751":33443,"_5":21231,"_8158":33145,"_1362":33444},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3357":1019,"_21031":910,"_17751":33446,"_5":21231,"_8158":33149,"_1362":33447},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3357":1020,"_21031":910,"_17751":33449,"_5":21231,"_8158":33149,"_1362":33450},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3357":1021,"_21031":910,"_17751":33452,"_5":21231,"_8158":33153,"_1362":33453},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3357":1022,"_21031":910,"_17751":33455,"_5":21231,"_8158":33153,"_1362":33456},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3357":1023,"_21031":910,"_17751":33458,"_5":21231,"_8158":33153,"_1362":33459},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3357":1024,"_21031":910,"_17751":33461,"_5":21231,"_8158":33153,"_1362":33462},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3357":1025,"_21031":910,"_17751":33464,"_5":21231,"_8158":33153,"_1362":33465},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3357":1026,"_21031":910,"_17751":33467,"_5":21231,"_8158":33153,"_1362":33468},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3357":1027,"_21031":910,"_17751":33470,"_5":21231,"_8158":33157,"_1362":33471},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3357":1028,"_21031":910,"_17751":33473,"_5":21231,"_8158":33161,"_1362":33474},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3357":1029,"_21031":910,"_17751":33476,"_5":21231,"_8158":33161,"_1362":33477},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3357":1030,"_21031":910,"_17751":33479,"_5":21231,"_8158":33164,"_1362":33480},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3357":1031,"_21031":910,"_17751":33482,"_5":21231,"_8158":33168,"_1362":33483},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3357":1032,"_21031":910,"_17751":33485,"_5":21231,"_8158":33168,"_1362":33486},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3357":1033,"_21031":910,"_17751":33488,"_5":21231,"_8158":33168,"_1362":33489},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3357":1034,"_21031":910,"_17751":33491,"_5":21231,"_8158":33168,"_1362":33492},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3357":1035,"_21031":910,"_17751":33494,"_5":21231,"_8158":33168,"_1362":33495},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3357":1036,"_21031":910,"_17751":33497,"_5":21231,"_8158":33168,"_1362":33498},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3357":1037,"_21031":910,"_17751":33500,"_5":21231,"_8158":33172,"_1362":33501},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. Esta plantilla se crea o actualiza en el momento en que el DMS se crea o actualiza en Lamassu - no en el momento del enrolamiento del dispositivo. A partir de ese momento, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3357":1038,"_21031":910,"_17751":33503,"_5":21231,"_8158":33172,"_1362":33504},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3357":1039,"_21031":910,"_17751":33506,"_5":21231,"_8158":33172,"_1362":33507},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3357":1040,"_21031":910,"_17751":33509,"_5":21231,"_8158":33176,"_1362":33510},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3357":1041,"_21031":910,"_17751":33512,"_5":21231,"_8158":33176,"_1362":33513},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3357":1042,"_21031":910,"_17751":33515,"_5":21231,"_8158":33176,"_1362":33516},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3357":1043,"_21031":910,"_17751":33518,"_5":21231,"_8158":33180,"_1362":33519},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3357":1044,"_21031":910,"_17751":33521,"_5":21231,"_8158":33180,"_1362":33522},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3357":1045,"_21031":910,"_17751":33524,"_5":21231,"_8158":33180,"_1362":33525},[],"Para que el flujo JITP funcione correctamente:",{"_3357":1046,"_21031":910,"_17751":33527,"_5":21231,"_8158":33180,"_1362":33528},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3357":1047,"_21031":910,"_17751":33530,"_5":21231,"_8158":33180,"_1362":33531},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3357":1048,"_21031":910,"_17751":33533,"_5":21231,"_8158":33180,"_1362":33534},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3357":1049,"_21031":910,"_17751":33536,"_5":21231,"_8158":33180,"_1362":33537},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3357":1050,"_21031":910,"_17751":33539,"_5":21231,"_8158":33184,"_1362":33540},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3357":1051,"_21031":910,"_17751":33542,"_5":21231,"_8158":33184,"_1362":33543},[],"Estado en Lamassu",{"_3357":1052,"_21031":910,"_17751":33545,"_5":21231,"_8158":33184,"_1362":33546},[],"Razón de revocación",{"_3357":1053,"_21031":910,"_17751":33548,"_5":21231,"_8158":33184,"_1362":33549},[],"Estado en AWS IoT Core",{"_3357":1054,"_21031":910,"_17751":33551,"_5":21231,"_8158":33184,"_1362":33552},[],"`Active`",{"_3357":1055,"_21031":910,"_17751":33554,"_5":21231,"_8158":33184,"_1362":32743},[],{"_3357":1056,"_21031":910,"_17751":33556,"_5":21231,"_8158":33184,"_1362":33557},[],"`ACTIVE`",{"_3357":1057,"_21031":910,"_17751":33559,"_5":21231,"_8158":33184,"_1362":33560},[],"`Revoked`",{"_3357":1058,"_21031":910,"_17751":33562,"_5":21231,"_8158":33184,"_1362":33563},[],"`certificateHold`",{"_3357":1059,"_21031":910,"_17751":33565,"_5":21231,"_8158":33184,"_1362":33566},[],"`INACTIVE`",{"_3357":1060,"_21031":910,"_17751":33568,"_5":21231,"_8158":33184,"_1362":33560},[],{"_3357":1061,"_21031":910,"_17751":33570,"_5":21231,"_8158":33184,"_1362":33571},[],"Cualquier otra razón",{"_3357":1062,"_21031":910,"_17751":33573,"_5":21231,"_8158":33184,"_1362":33574},[],"`REVOKED`",{"_3357":1063,"_21031":910,"_17751":33576,"_5":21231,"_8158":33184,"_1362":33577},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3357":1064,"_21031":910,"_17751":33579,"_5":21231,"_8158":33188,"_1362":33580},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3357":1065,"_21031":910,"_17751":33582,"_5":21231,"_8158":33188,"_1362":33583},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3357":1066,"_21031":910,"_17751":33585,"_5":21231,"_8158":33188,"_1362":33586},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3357":1067,"_21031":910,"_17751":33588,"_5":21231,"_8158":33192,"_1362":33589},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3357":1068,"_21031":910,"_17751":33591,"_5":21231,"_8158":33192,"_1362":33592},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3357":1069,"_21031":910,"_17751":33594,"_5":21231,"_8158":33196,"_1362":33595},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3357":1070,"_21031":910,"_17751":33597,"_5":21231,"_8158":33196,"_1362":33598},[],"Existen dos tipos de acciones:",{"_3357":1071,"_21031":910,"_17751":33600,"_5":21231,"_8158":33196,"_1362":33601},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3357":1072,"_21031":910,"_17751":33603,"_5":21231,"_8158":33196,"_1362":33604},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3357":1073,"_21031":910,"_17751":33606,"_5":21231,"_8158":33196,"_1362":33607},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3357":1074,"_21031":910,"_17751":33609,"_5":21231,"_8158":33200,"_1362":33610},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3357":1075,"_21031":910,"_17751":33612,"_5":21231,"_8158":33200,"_1362":33613},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3357":1076,"_21031":910,"_17751":33615,"_5":21231,"_8158":33200,"_1362":33616},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3357":1077,"_21031":910,"_17751":33618,"_5":21231,"_8158":33204,"_1362":33619},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3357":1078,"_21031":910,"_17751":33621,"_5":21231,"_8158":33204,"_1362":33622},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3357":1079,"_21031":910,"_17751":33624,"_5":21231,"_8158":33204,"_1362":33625},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3357":1080,"_21031":910,"_17751":33627,"_5":21231,"_8158":33204,"_1362":33628},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3357":1081,"_21031":910,"_17751":33630,"_5":21231,"_8158":33204,"_1362":33631},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3357":1082,"_21031":910,"_17751":33633,"_5":21231,"_8158":33204,"_1362":33634},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3357":1083,"_21031":910,"_17751":33636,"_5":21231,"_8158":33204,"_1362":33637},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3357":1084,"_21031":910,"_17751":33639,"_5":21231,"_8158":33204,"_1362":33640},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3357":1085,"_21031":910,"_17751":33642,"_5":21231,"_8158":33204,"_1362":33643},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3357":1086,"_21031":910,"_17751":33645,"_5":21231,"_8158":33204,"_1362":33646},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3357":1087,"_21031":910,"_17751":33648,"_5":21231,"_8158":33204,"_1362":33649},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3357":1088,"_21031":910,"_17751":33651,"_5":21231,"_8158":33204,"_1362":33652},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3357":1089,"_21031":910,"_17751":33654,"_5":21231,"_8158":33204,"_1362":33655},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3357":1090,"_21031":910,"_17751":33657,"_5":21231,"_8158":33204,"_1362":33658},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3357":1091,"_21031":910,"_17751":33660,"_5":21231,"_8158":33204,"_1362":33661},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3357":1092,"_21031":910,"_17751":33663,"_5":21231,"_8158":33204,"_1362":33664},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3357":1093,"_21031":910,"_17751":33666,"_5":21231,"_8158":33204,"_1362":33667},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3357":1094,"_21031":910,"_17751":33669,"_5":21231,"_8158":33204,"_1362":33670},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3357":1095,"_21031":910,"_17751":33672,"_5":21231,"_8158":33204,"_1362":33673},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3357":1096,"_21031":910,"_17751":33675,"_5":21231,"_8158":33204,"_1362":33676},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/pki/est-enrollment\" />",{"_3357":1097,"_21031":910,"_17751":33678,"_5":21231,"_8158":33204,"_1362":33679},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3357":1098,"_21031":1098,"_5":21226,"_1362":33681,"_21239":33682,"_17751":33683,"_8158":1098},"Claves y motores criptográficos",[30292,31351,31352],[],{"_3357":1099,"_21031":1098,"_17751":33685,"_5":21231,"_8158":1098,"_1362":33686},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3357":1100,"_21031":1098,"_5":21236,"_17751":33688,"_8158":33689,"_1362":33690},[],"/docs/platform/pki/key-management#gestión-de-claves-criptográficas","Gestión de claves criptográficas",{"_3357":1101,"_21031":1098,"_5":21236,"_17751":33692,"_8158":33693,"_1362":33694},[],"/docs/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3357":1102,"_21031":1098,"_5":21236,"_17751":33696,"_8158":33697,"_1362":33698},[],"/docs/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3357":1103,"_21031":1098,"_5":21236,"_17751":33700,"_8158":33701,"_1362":33702},[],"/docs/platform/pki/key-management#file-system","File System",{"_3357":1104,"_21031":1098,"_5":21236,"_17751":33704,"_8158":33705,"_1362":33706},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3357":1105,"_21031":1098,"_5":21236,"_17751":33708,"_8158":33709,"_1362":33710},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3357":1106,"_21031":1098,"_5":21236,"_17751":33712,"_8158":33713,"_1362":33714},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3357":1107,"_21031":1098,"_5":21236,"_17751":33716,"_8158":33717,"_1362":33718},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3357":1108,"_21031":1098,"_5":21236,"_17751":33720,"_8158":33721,"_1362":33722},[],"/docs/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3357":1109,"_21031":1098,"_5":21236,"_17751":33724,"_8158":33725,"_1362":33726},[],"/docs/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3357":1110,"_21031":1098,"_5":21236,"_17751":33728,"_8158":33729,"_1362":33730},[],"/docs/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3357":1111,"_21031":1098,"_5":21236,"_17751":33732,"_8158":33733,"_1362":33734},[],"/docs/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3357":1112,"_21031":1098,"_5":21236,"_17751":33736,"_8158":33737,"_1362":33738},[],"/docs/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3357":1113,"_21031":1098,"_5":21236,"_17751":33740,"_8158":33741,"_1362":33742},[],"/docs/platform/pki/key-management#ver-detalles","Ver detalles",{"_3357":1114,"_21031":1098,"_5":21236,"_17751":33744,"_8158":33745,"_1362":33746},[],"/docs/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3357":1115,"_21031":1098,"_5":21236,"_17751":33748,"_8158":33749,"_1362":33750},[],"/docs/platform/pki/key-management#sign","Sign",{"_3357":1116,"_21031":1098,"_5":21236,"_17751":33752,"_8158":33753,"_1362":33754},[],"/docs/platform/pki/key-management#verify","Verify",{"_3357":1117,"_21031":1098,"_5":21236,"_17751":33756,"_8158":33757,"_1362":33758},[],"/docs/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3357":1118,"_21031":1098,"_5":21236,"_17751":33760,"_8158":33761,"_1362":33762},[],"/docs/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3357":1119,"_21031":1098,"_17751":33764,"_5":21231,"_8158":33689,"_1362":33765},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3357":1120,"_21031":1098,"_17751":33767,"_5":21231,"_8158":33689,"_1362":33768},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3357":1121,"_21031":1098,"_17751":33770,"_5":21231,"_8158":33693,"_1362":33771},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3357":1122,"_21031":1098,"_17751":33773,"_5":21231,"_8158":33693,"_1362":33774},[],"En la práctica, permite:",{"_3357":1123,"_21031":1098,"_17751":33776,"_5":21231,"_8158":33693,"_1362":33777},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3357":1124,"_21031":1098,"_17751":33779,"_5":21231,"_8158":33693,"_1362":33780},[],"Importar claves creadas externamente.",{"_3357":1125,"_21031":1098,"_17751":33782,"_5":21231,"_8158":33693,"_1362":33783},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3357":1126,"_21031":1098,"_17751":33785,"_5":21231,"_8158":33693,"_1362":33786},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3357":1127,"_21031":1098,"_17751":33788,"_5":21231,"_8158":33697,"_1362":33789},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3357":1128,"_21031":1098,"_17751":33791,"_5":21231,"_8158":33697,"_1362":33792},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3357":1129,"_21031":1098,"_17751":33794,"_5":21231,"_8158":33697,"_1362":33795},[],"Actualmente, Lamassu soporta cinco tipos de motor. Elige según el nivel de aislamiento que necesites y quién debe poder acceder al material privado.",{"_3357":1130,"_21031":1098,"_17751":33797,"_5":21231,"_8158":33701,"_1362":33798},[],"Genera las claves con las librerías criptográficas de Go y delega su protección en el sistema de archivos. Funciona tanto on-premise como en cloud, pero no evita la extracción de la clave y no está recomendado para producción.",{"_3357":1131,"_21031":1098,"_17751":33800,"_5":21231,"_8158":33705,"_1362":33801},[],"Protege las claves en reposo y puede ejecutarse on-premise o en cloud. Un administrador con permisos suficientes todavía puede visualizar el material privado, por lo que conviene limitar el acceso administrativo y custodiar las claves de *unseal*.",{"_3357":1132,"_21031":1098,"_17751":33803,"_5":21231,"_8158":33709,"_1362":33804},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3357":1133,"_21031":1098,"_17751":33806,"_5":21231,"_8158":33713,"_1362":33807},[],"Genera las claves con entropía hardware y no expone la clave privada. Las operaciones se ejecutan dentro del servicio. Aun así, una identidad con permisos suficientes podría utilizar la clave para firmar, por lo que la política IAM sigue siendo crítica.",{"_3357":1134,"_21031":1098,"_17751":33809,"_5":21231,"_8158":33717,"_1362":33810},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3357":1135,"_21031":1098,"_17751":33812,"_5":21231,"_8158":33717,"_1362":33813},[],"Lamassu muestra en la consola el listado completo de motores habilitados.",{"_3357":1136,"_21031":1098,"_17751":33815,"_5":21231,"_8158":33717,"_1362":33816},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3357":1137,"_21031":1098,"_17751":33818,"_5":21231,"_8158":33717,"_1362":33819},[],"Durante el despliegue es obligatorio definir un motor por defecto. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3357":1138,"_21031":1098,"_17751":33821,"_5":21231,"_8158":33721,"_1362":33822},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3357":1139,"_21031":1098,"_17751":33824,"_5":21231,"_8158":33721,"_1362":33825},[],"La tabla incluye los siguientes campos:",{"_3357":1140,"_21031":1098,"_17751":33827,"_5":21231,"_8158":33721,"_1362":33828},[],"**Name**: nombre descriptivo de la clave.",{"_3357":1141,"_21031":1098,"_17751":33830,"_5":21231,"_8158":33721,"_1362":33831},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3357":1142,"_21031":1098,"_17751":33833,"_5":21231,"_8158":33721,"_1362":33834},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3357":1143,"_21031":1098,"_17751":33836,"_5":21231,"_8158":33721,"_1362":33837},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3357":1144,"_21031":1098,"_17751":33839,"_5":21231,"_8158":33721,"_1362":33840},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3357":1145,"_21031":1098,"_17751":33842,"_5":21231,"_8158":33721,"_1362":33843},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3357":1146,"_21031":1098,"_17751":33845,"_5":21231,"_8158":33721,"_1362":33846},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3357":1147,"_21031":1098,"_17751":33848,"_5":21231,"_8158":33721,"_1362":33849},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3357":1148,"_21031":1098,"_17751":33851,"_5":21231,"_8158":33721,"_1362":33852},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3357":1149,"_21031":1098,"_17751":33854,"_5":21231,"_8158":33721,"_1362":33855},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3357":1150,"_21031":1098,"_17751":33857,"_5":21231,"_8158":33721,"_1362":33858},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3357":1151,"_21031":1098,"_17751":33860,"_5":21231,"_8158":33721,"_1362":33861},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3357":1152,"_21031":1098,"_17751":33863,"_5":21231,"_8158":33721,"_1362":33864},[],"**Delete Key** para eliminar la clave del sistema.",{"_3357":1153,"_21031":1098,"_17751":33866,"_5":21231,"_8158":33725,"_1362":33867},[],"El alta de claves se realiza desde el asistente que se abre con **Create New Key**.",{"_3357":1154,"_21031":1098,"_17751":33869,"_5":21231,"_8158":33729,"_1362":33870},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3357":1155,"_21031":1098,"_17751":33872,"_5":21231,"_8158":33729,"_1362":33873},[],"En la primera pantalla del asistente, elija **Generate New Key Pair** y después defina los parámetros principales:",{"_3357":1156,"_21031":1098,"_17751":33875,"_5":21231,"_8158":33729,"_1362":33876},[],"**Key Name**: nombre único y descriptivo.",{"_3357":1157,"_21031":1098,"_17751":33878,"_5":21231,"_8158":33729,"_1362":33879},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3357":1158,"_21031":1098,"_17751":33881,"_5":21231,"_8158":33729,"_1362":33882},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3357":1159,"_21031":1098,"_17751":33884,"_5":21231,"_8158":33729,"_1362":33885},[],"**Tags**: metadatos para clasificar la clave.",{"_3357":1160,"_21031":1098,"_17751":33887,"_5":21231,"_8158":33729,"_1362":33888},[],"**Metadata**: información adicional para usos avanzados.",{"_3357":1161,"_21031":1098,"_17751":33890,"_5":21231,"_8158":33733,"_1362":33891},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3357":1162,"_21031":1098,"_17751":33893,"_5":21231,"_8158":33733,"_1362":33894},[],"Cuando la clave se ha generado en un entorno aislado o en un HSM externo.",{"_3357":1163,"_21031":1098,"_17751":33896,"_5":21231,"_8158":33733,"_1362":33897},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3357":1164,"_21031":1098,"_17751":33899,"_5":21231,"_8158":33733,"_1362":33900},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3357":1165,"_21031":1098,"_17751":33902,"_5":21231,"_8158":33733,"_1362":33903},[],"En el asistente, elija **Import Existing Key Pair** y complete los campos solicitados:",{"_3357":1166,"_21031":1098,"_17751":33905,"_5":21231,"_8158":33733,"_1362":33906},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3357":1167,"_21031":1098,"_17751":33908,"_5":21231,"_8158":33733,"_1362":33909},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3357":1168,"_21031":1098,"_17751":33911,"_5":21231,"_8158":33733,"_1362":33912},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3357":1169,"_21031":1098,"_17751":33914,"_5":21231,"_8158":33733,"_1362":33915},[],"**Metadata**: información adicional opcional.",{"_3357":1170,"_21031":1098,"_17751":33917,"_5":21231,"_8158":33733,"_1362":33918},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3357":1171,"_21031":1098,"_17751":33920,"_5":21231,"_8158":33733,"_1362":33921},[],"Una vez completado el asistente, la clave queda almacenada en el motor seleccionado y puede utilizarse para firma, generación de CSR y el resto de operaciones soportadas por KMS.",{"_3357":1172,"_21031":1098,"_17751":33923,"_5":21231,"_8158":33737,"_1362":33924},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3357":1173,"_21031":1098,"_17751":33926,"_5":21231,"_8158":33741,"_1362":33927},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3357":1174,"_21031":1098,"_17751":33929,"_5":21231,"_8158":33741,"_1362":33930},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3357":1175,"_21031":1098,"_17751":33932,"_5":21231,"_8158":33741,"_1362":33933},[],"**Key Name**: nombre descriptivo.",{"_3357":1176,"_21031":1098,"_17751":33935,"_5":21231,"_8158":33741,"_1362":33936},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3357":1177,"_21031":1098,"_17751":33938,"_5":21231,"_8158":33741,"_1362":33939},[],"**Tags**: etiquetas asociadas.",{"_3357":1178,"_21031":1098,"_17751":33941,"_5":21231,"_8158":33741,"_1362":33942},[],"**Aliases**: nombres alternativos.",{"_3357":1179,"_21031":1098,"_17751":33944,"_5":21231,"_8158":33741,"_1362":33945},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3357":1180,"_21031":1098,"_17751":33947,"_5":21231,"_8158":33741,"_1362":33948},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3357":1181,"_21031":1098,"_17751":33950,"_5":21231,"_8158":33741,"_1362":33951},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3357":1182,"_21031":1098,"_17751":33953,"_5":21231,"_8158":33741,"_1362":33954},[],"La pestaña **Public Key** presenta la clave pública en formato PEM, lista para consulta o copia.",{"_3357":1183,"_21031":1098,"_17751":33956,"_5":21231,"_8158":33745,"_1362":33957},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3357":1184,"_21031":1098,"_17751":33959,"_5":21231,"_8158":33745,"_1362":33960},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3357":1185,"_21031":1098,"_17751":33962,"_5":21231,"_8158":33749,"_1362":33963},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3357":1186,"_21031":1098,"_17751":33965,"_5":21231,"_8158":33749,"_1362":33966},[],"Campos principales:",{"_3357":1187,"_21031":1098,"_17751":33968,"_5":21231,"_8158":33749,"_1362":33969},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3357":1188,"_21031":1098,"_17751":33971,"_5":21231,"_8158":33749,"_1362":33972},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3357":1189,"_21031":1098,"_17751":33974,"_5":21231,"_8158":33749,"_1362":33975},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3357":1190,"_21031":1098,"_17751":33977,"_5":21231,"_8158":33749,"_1362":33978},[],"**Message**: contenido que se va a firmar.",{"_3357":1191,"_21031":1098,"_17751":33980,"_5":21231,"_8158":33749,"_1362":33981},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3357":1192,"_21031":1098,"_17751":33983,"_5":21231,"_8158":33753,"_1362":33984},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3357":1193,"_21031":1098,"_17751":33986,"_5":21231,"_8158":33753,"_1362":33966},[],{"_3357":1194,"_21031":1098,"_17751":33988,"_5":21231,"_8158":33753,"_1362":33989},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3357":1195,"_21031":1098,"_17751":33991,"_5":21231,"_8158":33753,"_1362":33992},[],"**Message Type**: `Raw` o `Digest`.",{"_3357":1196,"_21031":1098,"_17751":33994,"_5":21231,"_8158":33753,"_1362":33995},[],"**Payload Encoding**: codificación del mensaje.",{"_3357":1197,"_21031":1098,"_17751":33997,"_5":21231,"_8158":33753,"_1362":33998},[],"**Message**: mensaje original o hash.",{"_3357":1198,"_21031":1098,"_17751":34000,"_5":21231,"_8158":33753,"_1362":34001},[],"**Signature**: firma que se desea comprobar.",{"_3357":1199,"_21031":1098,"_17751":34003,"_5":21231,"_8158":33753,"_1362":34004},[],"**Result**: indicador del resultado de la validación.",{"_3357":1200,"_21031":1098,"_17751":34006,"_5":21231,"_8158":33757,"_1362":34007},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3357":1201,"_21031":1098,"_17751":34009,"_5":21231,"_8158":33757,"_1362":34010},[],"Este flujo es útil para:",{"_3357":1202,"_21031":1098,"_17751":34012,"_5":21231,"_8158":33757,"_1362":34013},[],"Solicitar certificados a una CA externa.",{"_3357":1203,"_21031":1098,"_17751":34015,"_5":21231,"_8158":33757,"_1362":34016},[],"Renovar una identidad manteniendo la misma clave.",{"_3357":1204,"_21031":1098,"_17751":34018,"_5":21231,"_8158":33757,"_1362":34019},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3357":1205,"_21031":1098,"_17751":34021,"_5":21231,"_8158":33757,"_1362":34022},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3357":1206,"_21031":1098,"_17751":34024,"_5":21231,"_8158":33757,"_1362":34025},[],"**Organization (O)**: organización o empresa.",{"_3357":1207,"_21031":1098,"_17751":34027,"_5":21231,"_8158":33757,"_1362":34028},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3357":1208,"_21031":1098,"_17751":34030,"_5":21231,"_8158":33757,"_1362":34031},[],"**Country (C)**: código de país de dos letras.",{"_3357":1209,"_21031":1098,"_17751":34033,"_5":21231,"_8158":33757,"_1362":34034},[],"**State / Province (ST)**: estado o provincia.",{"_3357":1210,"_21031":1098,"_17751":34036,"_5":21231,"_8158":33757,"_1362":34037},[],"**Locality (L)**: ciudad o localidad.",{"_3357":1211,"_21031":1098,"_17751":34039,"_5":21231,"_8158":33757,"_1362":34040},[],"**Email Address**: correo de contacto.",{"_3357":1212,"_21031":1098,"_17751":34042,"_5":21231,"_8158":33757,"_1362":34043},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3357":1213,"_21031":1098,"_17751":34045,"_5":21231,"_8158":33757,"_1362":34046},[],"Una vez completado el formulario, Lamassu genera la CSR y la presenta para su descarga o copia.",{"_3357":1214,"_21031":1098,"_17751":34048,"_5":21231,"_8158":33761,"_1362":34049},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3357":1215,"_21031":1098,"_17751":34051,"_5":21231,"_8158":33761,"_1362":34052},[],"Esta opción muestra los pasos necesarios para configurar el entorno local, cargar el módulo PKCS#11 y ejecutar firmas con herramientas como OpenSSL sin extraer la clave privada del entorno custodiado.",{"_3357":1216,"_21031":1216,"_5":21226,"_1362":34054,"_21239":34055,"_17751":34056,"_8158":1216},"Validación online con OCSP",[30292,31351,31352],[],{"_3357":1217,"_21031":1216,"_17751":34058,"_5":21231,"_8158":1216,"_1362":34059},[],"Consulta en tiempo real si un certificado sigue vigente o se ha revocado.",{"_3357":1218,"_21031":1216,"_5":21236,"_17751":34061,"_8158":34062,"_1362":34063},[],"/docs/platform/pki/ocsp#servicio-ocsp","Servicio OCSP",{"_3357":1219,"_21031":1216,"_5":21236,"_17751":34065,"_8158":34066,"_1362":34067},[],"/docs/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3357":1220,"_21031":1216,"_5":21236,"_17751":34069,"_8158":34070,"_1362":34071},[],"/docs/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3357":1221,"_21031":1216,"_5":21236,"_17751":34073,"_8158":34074,"_1362":34075},[],"/docs/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3357":1222,"_21031":1216,"_5":21236,"_17751":34077,"_8158":34078,"_1362":34079},[],"/docs/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3357":1223,"_21031":1216,"_5":21236,"_17751":34081,"_8158":34082,"_1362":32020},[],"/docs/platform/pki/ocsp#referencias",{"_3357":1224,"_21031":1216,"_17751":34084,"_5":21231,"_8158":34062,"_1362":34085},[],"OCSP (Online Certificate Status Protocol) es el mecanismo que permite a una parte que confía comprobar, en tiempo real, si un certificado concreto está vigente o ha sido revocado. En lugar de descargar una lista completa de certificados revocados, el cliente envía una consulta con el número de serie del certificado y recibe una respuesta firmada con el estado actual.",{"_3357":1225,"_21031":1216,"_17751":34087,"_5":21231,"_8158":34062,"_1362":34088},[],"Lamassu integra un respondedor OCSP propio que atiende estas consultas consultando directamente la base de datos interna de certificados. No se requiere ningún componente externo.",{"_3357":1226,"_21031":1216,"_17751":34090,"_5":21231,"_8158":34066,"_1362":34091},[],"Cuando un cliente solicita el estado de un certificado, el respondedor localiza el certificado por su número de serie y determina su estado según el registro interno:",{"_3357":1227,"_21031":1216,"_17751":34093,"_5":21231,"_8158":34066,"_1362":34094},[],"Si el certificado está activo, la respuesta indica `Good`.",{"_3357":1228,"_21031":1216,"_17751":34096,"_5":21231,"_8158":34066,"_1362":34097},[],"Si el certificado ha sido revocado, la respuesta indica `Revoked` e incluye la marca de tiempo de revocación y el código de razón conforme a RFC 5280.",{"_3357":1229,"_21031":1216,"_17751":34099,"_5":21231,"_8158":34066,"_1362":34100},[],"Si el número de serie no se encuentra o el estado no es reconocible, la respuesta indica `Unknown`.",{"_3357":1230,"_21031":1216,"_17751":34102,"_5":21231,"_8158":34066,"_1362":34103},[],"La respuesta OCSP es firmada por la CA emisora del certificado consultado, utilizando el motor criptográfico asociado a esa CA. Lamassu no utiliza un certificado delegado de firma OCSP: la CA actúa directamente como respondedor.",{"_3357":1231,"_21031":1216,"_17751":34105,"_5":21231,"_8158":34066,"_1362":34106},[],"Cada respuesta tiene una ventana de validez de 24 horas, reflejada en los campos `thisUpdate` y `nextUpdate` de la respuesta. Los clientes que cacheen respuestas deben tener en cuenta esta ventana al determinar durante cuánto tiempo una respuesta sigue siendo válida.",{"_3357":1232,"_21031":1216,"_17751":34108,"_5":21231,"_8158":34070,"_1362":34109},[],"La URL del respondedor OCSP se incorpora automáticamente en la extensión AIA (*Authority Information Access*) de todos los certificados emitidos por Lamassu. Los clientes que verifican certificados pueden leer esta URL directamente del certificado sin necesidad de configuración adicional.",{"_3357":1233,"_21031":1216,"_17751":34111,"_5":21231,"_8158":34074,"_1362":34112},[],"El respondedor acepta los dos formatos definidos en RFC 6960:",{"_3357":1234,"_21031":1216,"_17751":34114,"_5":21231,"_8158":34074,"_1362":34115},[],"`GET /ocsp/{ocsp_request}` incluye la petición OCSP codificada en Base64url dentro de la propia URL.",{"_3357":1235,"_21031":1216,"_17751":34117,"_5":21231,"_8158":34074,"_1362":34118},[],"`POST /ocsp` envía la petición en el cuerpo con `Content-Type: application/ocsp-request`.",{"_3357":1236,"_21031":1216,"_17751":34120,"_5":21231,"_8158":34074,"_1362":34121},[],"Ejemplo de consulta con `curl` mediante POST:",{"_3357":1237,"_21031":1216,"_17751":34123,"_5":21231,"_8158":34074,"_1362":34124},[],"La respuesta tiene `Content-Type: application/ocsp-response` y contiene la respuesta OCSP en formato DER.",{"_3357":1238,"_21031":1216,"_17751":34126,"_5":21231,"_8158":34078,"_1362":34127},[],"Desde la pantalla de certificados de Lamassu es posible lanzar una petición OCSP directamente sobre el certificado seleccionado mediante la acción **OCSP Check**. Esta acción muestra el estado devuelto por el respondedor sin necesidad de herramientas externas.",{"_3357":1239,"_21031":1216,"_17751":34129,"_5":21231,"_8158":34082,"_1362":34130},[],"RFC 6960 - *X.509 Internet Public Key Infrastructure Online Certificate Status Protocol – OCSP*",{"_3357":1240,"_21031":1216,"_17751":34132,"_5":21231,"_8158":34082,"_1362":34133},[],"RFC 5280 - *Internet X.509 Public Key Infrastructure Certificate and Certificate Revocation List (CRL) Profile* (razones de revocación, sección 5.3.1)",{"_3357":1241,"_21031":1216,"_17751":34135,"_5":21231,"_8158":34082,"_1362":34136},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3357":1242,"_21031":1216,"_17751":34138,"_5":21231,"_8158":34082,"_1362":32111},[],{"_3357":1243,"_21031":1243,"_5":21226,"_1362":34140,"_21239":34141,"_17751":34142,"_8158":1243},"Plataforma Lamassu IoT",[30292,31351],[],{"_3357":1244,"_21031":1243,"_17751":34144,"_5":21231,"_8158":1243,"_1362":34145},[],"Gestiona la PKI y las identidades digitales de tus dispositivos desde una única plataforma.",{"_3357":1245,"_21031":1243,"_5":21236,"_17751":34147,"_8158":34148,"_1362":34149},[],"/docs/platform/pki/overview#empieza-aquí","Empieza aquí",{"_3357":1246,"_21031":1243,"_5":21236,"_17751":34151,"_8158":34152,"_1362":34153},[],"/docs/platform/pki/overview#capacidades-principales","Capacidades principales",{"_3357":1247,"_21031":1243,"_5":21236,"_17751":34155,"_8158":34156,"_1362":34157},[],"/docs/platform/pki/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3357":1248,"_21031":1243,"_5":21236,"_17751":34159,"_8158":34160,"_1362":34161},[],"/docs/platform/pki/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3357":1249,"_21031":1243,"_5":21236,"_17751":34163,"_8158":34164,"_1362":34165},[],"/docs/platform/pki/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3357":1250,"_21031":1243,"_5":21236,"_17751":34167,"_8158":34168,"_1362":34169},[],"/docs/platform/pki/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3357":1251,"_21031":1243,"_5":21236,"_17751":34171,"_8158":34172,"_1362":34173},[],"/docs/platform/pki/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3357":1252,"_21031":1243,"_5":21236,"_17751":34175,"_8158":34176,"_1362":34177},[],"/docs/platform/pki/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3357":1253,"_21031":1243,"_5":21236,"_17751":34179,"_8158":34180,"_1362":34181},[],"/docs/platform/pki/overview#elige-tu-recorrido","Elige tu recorrido",{"_3357":1254,"_21031":1243,"_17751":34183,"_5":21231,"_8158":1243,"_1362":34184},[],"Lamassu IoT centraliza la emisión, distribución, renovación y revocación de identidades X.509 para dispositivos conectados. Puedes construir una PKI privada, proteger sus claves y automatizar el enrolamiento de una flota sin perder visibilidad sobre cada certificado.",{"_3357":1255,"_21031":1243,"_17751":34186,"_5":21231,"_8158":34148,"_1362":34187},[],"<Card title=\"Primeros pasos\" description=\"Crea una CA, emite un certificado y registra tu primer dispositivo.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3357":1256,"_21031":1243,"_17751":34189,"_5":21231,"_8158":34148,"_1362":34190},[],"<Card title=\"Cómo funciona Lamassu\" description=\"Construye el modelo mental de autoridades, claves, identidades y validación.\" href=\"/docs/platform/pki/concepts/overview\" />",{"_3357":1257,"_21031":1243,"_17751":34192,"_5":21231,"_8158":34156,"_1362":34193},[],"Crea autoridades raíz e intermedias o importa una PKI existente. Define qué autoridad puede emitir cada identidad y conserva la cadena de confianza completa.",{"_3357":1258,"_21031":1243,"_17751":34195,"_5":21231,"_8158":34160,"_1362":34196},[],"Genera y custodia claves mediante motores software, HSMs PKCS#11 o servicios cloud. Lamassu desacopla las operaciones de la ubicación física de la clave.",{"_3357":1259,"_21031":1243,"_17751":34198,"_5":21231,"_8158":34164,"_1362":34199},[],"Emite certificados desde la consola o a partir de un CSR, consulta su estado y revócalos cuando dejan de ser fiables.",{"_3357":1260,"_21031":1243,"_17751":34201,"_5":21231,"_8158":34168,"_1362":34202},[],"Define políticas de enrolamiento mediante un Device Management Service (DMS) y deja que los dispositivos soliciten o renueven su identidad a través de EST.",{"_3357":1261,"_21031":1243,"_17751":34204,"_5":21231,"_8158":34172,"_1362":34205},[],"Ofrece validación online mediante OCSP y distribuye CRLs para consumidores que necesitan comprobar certificados sin conexión.",{"_3357":1262,"_21031":1243,"_17751":34207,"_5":21231,"_8158":34176,"_1362":34208},[],"Suscríbete a cambios del ciclo de vida y envía notificaciones por correo, Microsoft Teams o webhooks.",{"_3357":1263,"_21031":1243,"_17751":34210,"_5":21231,"_8158":34180,"_1362":34211},[],"<Card title=\"Administro la PKI\" description=\"Configura motores, autoridades, emisión y validación.\" href=\"/docs/platform/pki/key-management\" />",{"_3357":1264,"_21031":1243,"_17751":34213,"_5":21231,"_8158":34180,"_1362":34214},[],"<Card title=\"Integro un dispositivo\" description=\"Configura el DMS y usa EST para obtener una identidad.\" href=\"/docs/platform/pki/device-enrollment\" />",{"_3357":1265,"_21031":1243,"_17751":34216,"_5":21231,"_8158":34180,"_1362":34217},[],"<Card title=\"Opero la plataforma\" description=\"Despliega Lamassu y prepara sus dependencias.\" href=\"/docs/deployment/overview\" />",{"_3357":1266,"_21031":1243,"_17751":34219,"_5":21231,"_8158":34180,"_1362":34220},[],"<Card title=\"Integro otro sistema\" description=\"Conecta Lamassu con AWS IoT Core y otros destinos.\" href=\"/docs/platform/pki/integrations/aws-iot-core\" />",{"_3357":1267,"_21031":1267,"_5":21226,"_1362":34222,"_21239":34223,"_17751":34225,"_8158":1267},"Crea tu primera CA",[30292,31351,34224],"Primeros pasos",[],{"_3357":1268,"_21031":1267,"_17751":34227,"_5":21231,"_8158":1267,"_1362":34228},[],"Crea una autoridad raíz y comprueba que está preparada para emitir certificados.",{"_3357":1269,"_21031":1267,"_5":21236,"_17751":34230,"_8158":34231,"_1362":30302},[],"/docs/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3357":1270,"_21031":1267,"_5":21236,"_17751":34233,"_8158":34234,"_1362":34235},[],"/docs/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación","Abre el asistente de creación",{"_3357":1271,"_21031":1267,"_5":21236,"_17751":34237,"_8158":34238,"_1362":34239},[],"/docs/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave","Selecciona la clave",{"_3357":1272,"_21031":1267,"_5":21236,"_17751":34241,"_8158":34242,"_1362":34243},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad","Define la autoridad",{"_3357":1273,"_21031":1267,"_5":21236,"_17751":34245,"_8158":34246,"_1362":34247},[],"/docs/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca","Revisa y crea la CA",{"_3357":1274,"_21031":1267,"_5":21236,"_17751":34249,"_8158":34250,"_1362":34251},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado","Verifica el resultado",{"_3357":1275,"_21031":1267,"_5":21236,"_17751":34253,"_8158":34254,"_1362":30326},[],"/docs/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3357":1276,"_21031":1267,"_17751":34256,"_5":21231,"_8158":1267,"_1362":34257},[],"En este quickstart crearás una autoridad de certificación raíz con un nuevo par de claves. Al terminar tendrás una CA activa que podrás usar en el siguiente quickstart.",{"_3357":1277,"_21031":1267,"_17751":34259,"_5":21231,"_8158":34231,"_1362":34260},[],"Acceso a la consola con permisos para gestionar autoridades.",{"_3357":1278,"_21031":1267,"_17751":34262,"_5":21231,"_8158":34231,"_1362":34263},[],"Al menos un motor criptográfico disponible.",{"_3357":1279,"_21031":1267,"_17751":34265,"_5":21231,"_8158":34231,"_1362":34266},[],"Un nombre que identifique el propósito de la CA, por ejemplo `Acme Device Root CA`.",{"_3357":1280,"_21031":1267,"_17751":34268,"_5":21231,"_8158":34231,"_1362":34269},[],"Una CA raíz se autofirma y actúa como ancla de confianza. Para producción suele ser preferible mantener la raíz más protegida y emitir desde una CA intermedia.",{"_3357":1281,"_21031":1267,"_17751":34271,"_5":21231,"_8158":34234,"_1362":34272},[],"En el menú lateral, abre **Certification Authorities** y selecciona **Create New CA**.",{"_3357":1282,"_21031":1267,"_17751":34274,"_5":21231,"_8158":34234,"_1362":34275},[],"Elige crear una CA con un par de claves nuevo. Si ya tienes la clave en el KMS, usa &#x2A;*Create New CA (Existing Key)**.",{"_3357":1283,"_21031":1267,"_17751":34277,"_5":21231,"_8158":34238,"_1362":34278},[],"Elige el motor criptográfico que custodiará la clave y configura el algoritmo. Para una primera CA puedes usar **EC P-384**, siempre que sea compatible con tus consumidores.",{"_3357":1284,"_21031":1267,"_17751":34280,"_5":21231,"_8158":34238,"_1362":34281},[],"La clave privada permanecerá bajo el control del motor seleccionado.",{"_3357":1285,"_21031":1267,"_17751":34283,"_5":21231,"_8158":34242,"_1362":34284},[],"Selecciona **Root CA** y completa:",{"_3357":1286,"_21031":1267,"_17751":34286,"_5":21231,"_8158":34242,"_1362":34287},[],"**CA Name**: un nombre único y reconocible.",{"_3357":1287,"_21031":1267,"_17751":34289,"_5":21231,"_8158":34242,"_1362":34290},[],"**Subject**: al menos la organización y el país que identificarán a la autoridad.",{"_3357":1288,"_21031":1267,"_17751":34292,"_5":21231,"_8158":34242,"_1362":34293},[],"**CA Certificate Expiration**: una validez mayor que la de los certificados que emitirá.",{"_3357":1289,"_21031":1267,"_17751":34295,"_5":21231,"_8158":34242,"_1362":34296},[],"**Default End-Entity Certificate Issuance Expiration**: la validez predeterminada de los certificados finales.",{"_3357":1290,"_21031":1267,"_17751":34298,"_5":21231,"_8158":34242,"_1362":34299},[],"El nombre de la CA se utilizará como `Common Name` del certificado.",{"_3357":1291,"_21031":1267,"_17751":34301,"_5":21231,"_8158":34246,"_1362":34302},[],"Comprueba el algoritmo, el sujeto y las fechas antes de confirmar. Estos valores definen el ancla de confianza y no deberían elegirse como simples datos de prueba en un entorno productivo.",{"_3357":1292,"_21031":1267,"_17751":34304,"_5":21231,"_8158":34250,"_1362":34305},[],"Abre la nueva CA desde el listado. Debe aparecer activa y mostrar su certificado PEM, la fecha de expiración y la pestaña **Issued Certificates**.",{"_3357":1293,"_21031":1267,"_17751":34307,"_5":21231,"_8158":34254,"_1362":34308},[],"Usa la autoridad para emitir tu primer certificado, o consulta la guía completa de autoridades para crear una CA intermedia, importar una CA o definir perfiles avanzados.",{"_3357":1294,"_21031":1294,"_5":21226,"_1362":34310,"_21239":34311,"_17751":34312,"_8158":1294},"Emite tu primer certificado",[30292,31351,34224],[],{"_3357":1295,"_21031":1294,"_17751":34314,"_5":21231,"_8158":1294,"_1362":34315},[],"Emite una identidad X.509 desde la consola y verifica el resultado.",{"_3357":1296,"_21031":1294,"_5":21236,"_17751":34317,"_8158":34318,"_1362":30302},[],"/docs/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3357":1297,"_21031":1294,"_5":21236,"_17751":34320,"_8158":34321,"_1362":34322},[],"/docs/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3357":1298,"_21031":1294,"_5":21236,"_17751":34324,"_8158":34325,"_1362":34326},[],"/docs/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3357":1299,"_21031":1294,"_5":21236,"_17751":34328,"_8158":34329,"_1362":34330},[],"/docs/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3357":1300,"_21031":1294,"_5":21236,"_17751":34332,"_8158":34333,"_1362":34334},[],"/docs/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3357":1301,"_21031":1294,"_5":21236,"_17751":34336,"_8158":34337,"_1362":34338},[],"/docs/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3357":1302,"_21031":1294,"_5":21236,"_17751":34340,"_8158":34341,"_1362":34251},[],"/docs/platform/pki/quickstarts/issue-certificate#verifica-el-resultado",{"_3357":1303,"_21031":1294,"_5":21236,"_17751":34343,"_8158":34344,"_1362":30326},[],"/docs/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3357":1304,"_21031":1294,"_17751":34346,"_5":21231,"_8158":1294,"_1362":34347},[],"En este quickstart Lamassu generará la clave y el CSR en el navegador, y la CA emitirá el certificado. Al terminar descargarás el certificado y su clave privada.",{"_3357":1305,"_21031":1294,"_17751":34349,"_5":21231,"_8158":34318,"_1362":34350},[],"Una CA activa con permiso para emitir certificados.",{"_3357":1306,"_21031":1294,"_17751":34352,"_5":21231,"_8158":34318,"_1362":34353},[],"Un nombre para la identidad, por ejemplo `device-001.example.internal`.",{"_3357":1307,"_21031":1294,"_17751":34355,"_5":21231,"_8158":34318,"_1362":34356},[],"Un lugar seguro en el que custodiar la clave privada descargada.",{"_3357":1308,"_21031":1294,"_17751":34358,"_5":21231,"_8158":34318,"_1362":34359},[],"En este flujo la clave se genera en el navegador y Lamassu no la almacena. Descárgala y protégela antes de cerrar el resultado de la operación.",{"_3357":1309,"_21031":1294,"_17751":34361,"_5":21231,"_8158":34321,"_1362":34362},[],"Abre la CA creada en el quickstart anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3357":1310,"_21031":1294,"_17751":34364,"_5":21231,"_8158":34325,"_1362":34365},[],"Selecciona **Generate Key & CSR in Browser**. Usa **Upload Existing CSR** cuando la clave privada deba generarse y permanecer en el sistema de destino.",{"_3357":1311,"_21031":1294,"_17751":34367,"_5":21231,"_8158":34329,"_1362":34368},[],"Introduce el `Common Name` y, si corresponde, la organización, unidad organizativa y ubicación. Añade SANs para cada nombre DNS, dirección IP, correo o URI con el que se vaya a validar la identidad.",{"_3357":1312,"_21031":1294,"_17751":34370,"_5":21231,"_8158":34333,"_1362":34371},[],"Elige RSA o ECDSA, define la validez y selecciona los usos de clave. Para una identidad de dispositivo que usa mTLS, habilita **Digital Signature** y **Client Authentication**.",{"_3357":1313,"_21031":1294,"_17751":34373,"_5":21231,"_8158":34333,"_1362":34374},[],"La validez no puede superar la fecha de expiración de la CA emisora.",{"_3357":1314,"_21031":1294,"_17751":34376,"_5":21231,"_8158":34337,"_1362":34377},[],"Confirma la emisión y descarga inmediatamente el certificado y la clave privada en formato PEM.",{"_3357":1315,"_21031":1294,"_17751":34379,"_5":21231,"_8158":34341,"_1362":34380},[],"El certificado debe aparecer en **Issued Certificates** con estado activo. Comprueba su sujeto, SANs, emisor, usos y periodo de validez.",{"_3357":1316,"_21031":1294,"_17751":34382,"_5":21231,"_8158":34344,"_1362":34383},[],"Registra tu primer dispositivo para asociar la identidad a una entidad gestionada, o consulta la gestión de certificados.",{"_3357":1317,"_21031":1317,"_5":21226,"_1362":34224,"_21239":34385,"_17751":34386,"_8158":1317},[30292,31351,34224],[],{"_3357":1318,"_21031":1317,"_17751":34388,"_5":21231,"_8158":1317,"_1362":34389},[],"Obtén un primer resultado con Lamassu y continúa desde una base funcional.",{"_3357":1319,"_21031":1317,"_5":21236,"_17751":34391,"_8158":34392,"_1362":34393},[],"/docs/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3357":1320,"_21031":1317,"_5":21236,"_17751":34395,"_8158":34396,"_1362":30302},[],"/docs/platform/pki/quickstarts/overview#antes-de-empezar",{"_3357":1321,"_21031":1317,"_17751":34398,"_5":21231,"_8158":1317,"_1362":34399},[],"Los quickstarts te llevan desde una instancia preparada hasta una identidad de dispositivo activa. Cada guía produce un resultado verificable y enlaza la explicación detallada cuando necesitas ir más allá.",{"_3357":1322,"_21031":1317,"_17751":34401,"_5":21231,"_8158":34392,"_1362":34402},[],"<Card title=\"1. Crea tu primera CA\" description=\"Establece una raíz de confianza capaz de emitir certificados.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3357":1323,"_21031":1317,"_17751":34404,"_5":21231,"_8158":34392,"_1362":34405},[],"<Card title=\"2. Emite un certificado\" description=\"Crea una identidad X.509 y verifica su contenido.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3357":1324,"_21031":1317,"_17751":34407,"_5":21231,"_8158":34392,"_1362":34408},[],"<Card title=\"3. Registra un dispositivo\" description=\"Añade un dispositivo y asígnale su primera identidad.\" href=\"/docs/platform/pki/quickstarts/register-device\" />",{"_3357":1325,"_21031":1317,"_17751":34410,"_5":21231,"_8158":34396,"_1362":34411},[],"Necesitas acceso a la consola de Lamassu IoT y permisos para administrar claves, autoridades y dispositivos. La instancia debe tener al menos un motor criptográfico configurado.",{"_3357":1326,"_21031":1317,"_17751":34413,"_5":21231,"_8158":34396,"_1362":34414},[],"Si todavía no tienes una instancia, elige primero un modelo de despliegue.",{"_3357":1327,"_21031":1327,"_5":21226,"_1362":34416,"_21239":34417,"_17751":34418,"_8158":1327},"Registra tu primer dispositivo",[30292,31351,34224],[],{"_3357":1328,"_21031":1327,"_17751":34420,"_5":21231,"_8158":1327,"_1362":34421},[],"Añade un dispositivo a Lamassu y asígnale una identidad activa.",{"_3357":1329,"_21031":1327,"_5":21236,"_17751":34423,"_8158":34424,"_1362":30302},[],"/docs/platform/pki/quickstarts/register-device#antes-de-empezar",{"_3357":1330,"_21031":1327,"_5":21236,"_17751":34426,"_8158":34427,"_1362":34428},[],"/docs/platform/pki/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3357":1331,"_21031":1327,"_5":21236,"_17751":34430,"_8158":34431,"_1362":34432},[],"/docs/platform/pki/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3357":1332,"_21031":1327,"_5":21236,"_17751":34434,"_8158":34435,"_1362":34436},[],"/docs/platform/pki/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3357":1333,"_21031":1327,"_5":21236,"_17751":34438,"_8158":34439,"_1362":34440},[],"/docs/platform/pki/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3357":1334,"_21031":1327,"_5":21236,"_17751":34442,"_8158":34443,"_1362":34444},[],"/docs/platform/pki/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3357":1335,"_21031":1327,"_17751":34446,"_5":21231,"_8158":1327,"_1362":34447},[],"En este quickstart registrarás manualmente un dispositivo y le asignarás su primer certificado. Es el recorrido más corto para entender cómo Lamassu relaciona una entidad física con su historial de identidades.",{"_3357":1336,"_21031":1327,"_17751":34449,"_5":21231,"_8158":34424,"_1362":34450},[],"Un DMS configurado.",{"_3357":1337,"_21031":1327,"_17751":34452,"_5":21231,"_8158":34424,"_1362":34453},[],"Una CA asociada al DMS.",{"_3357":1338,"_21031":1327,"_17751":34455,"_5":21231,"_8158":34424,"_1362":34456},[],"Un identificador único para el dispositivo.",{"_3357":1339,"_21031":1327,"_17751":34458,"_5":21231,"_8158":34427,"_1362":34459},[],"Abre **Managed Devices**, selecciona la acción para registrar un dispositivo y completa:",{"_3357":1340,"_21031":1327,"_17751":34461,"_5":21231,"_8158":34427,"_1362":34462},[],"**Device ID**: identificador único del dispositivo.",{"_3357":1341,"_21031":1327,"_17751":34464,"_5":21231,"_8158":34427,"_1362":34465},[],"**Registration Authority**: DMS que aplicará las políticas de enrolamiento.",{"_3357":1342,"_21031":1327,"_17751":34467,"_5":21231,"_8158":34427,"_1362":34468},[],"**Icon** y **Tags**: clasificación opcional para localizarlo después.",{"_3357":1343,"_21031":1327,"_17751":34470,"_5":21231,"_8158":34431,"_1362":34471},[],"Abre el dispositivo recién creado. Debe aparecer con estado **No Identity**: existe en el inventario, pero todavía no tiene un certificado asociado.",{"_3357":1344,"_21031":1327,"_17751":34473,"_5":21231,"_8158":34435,"_1362":34474},[],"Selecciona **Assign Identity**. Lamassu buscará certificados activos cuyo `Common Name` coincida con el `Device ID`.",{"_3357":1345,"_21031":1327,"_17751":34476,"_5":21231,"_8158":34435,"_1362":34477},[],"Selecciona un certificado existente o usa **Issue New Instead** para emitir uno desde una CA vinculada al DMS.",{"_3357":1346,"_21031":1327,"_17751":34479,"_5":21231,"_8158":34439,"_1362":34480},[],"Tras confirmar, el estado debe cambiar a **Active**. Revisa **Certificate History** para comprobar la identidad asociada y **Device Event Timeline** para ver el evento de asignación.",{"_3357":1347,"_21031":1327,"_17751":34482,"_5":21231,"_8158":34443,"_1362":34483},[],"El registro manual ayuda a entender el modelo, pero una flota debe usar enrolamiento automatizado. Continúa con Device Management Service y la integración EST.",{"_3357":1348,"_21031":1348,"_5":21226,"_1362":34485,"_17751":34486,"_8158":1348},"Test",[],{"_3357":1349,"_21031":1348,"_17751":34488,"_5":21231,"_8158":1348,"_1362":34489},[],"A document to test Fumadocs",{"_3357":1350,"_21031":1348,"_5":21236,"_17751":34491,"_8158":34492,"_1362":34493},[],"/docs/test#cards","Cards",{"_3357":1351,"_21031":1348,"_5":21236,"_17751":34495,"_8158":34496,"_1362":34497},[],"/docs/test#codeblock","CodeBlock",{"_3357":1352,"_21031":1348,"_5":21236,"_17751":34499,"_8158":34500,"_1362":34501},[],"/docs/test#list","List",{"_3357":1353,"_21031":1348,"_17751":34503,"_5":21231,"_8158":1348,"_1362":34504},[],"Hey there!",{"_3357":1354,"_21031":1348,"_17751":34506,"_5":21231,"_8158":34492,"_1362":34507},[],"<Card title=\"Learn more about Next.js\" href=\"https://nextjs.org/docs\" />",{"_3357":1355,"_21031":1348,"_17751":34509,"_5":21231,"_8158":34492,"_1362":34510},[],"<Card title=\"Learn more about Fumadocs\" href=\"https://fumadocs.dev\" />",{"_3357":1356,"_21031":1348,"_17751":34512,"_5":21231,"_8158":34500,"_1362":34513},[],"Hello",{"_3357":1357,"_21031":1348,"_17751":34515,"_5":21231,"_8158":34500,"_1362":34516},[],"World","count","sorting",{"_34520":34521,"_34522":34523,"_34524":34525,"_34526":34527,"_6645":1379,"_39930":1379},"language","english","sortableProperties",[1362,21031,5,8158],"sortablePropertiesWithTypes",{"_1362":17441,"_21031":17441,"_5":17441,"_8158":17441},"sorts",{"_1362":34528,"_21031":35880,"_5":37230,"_8158":38580},{"_3474":34529,"_34531":34532,"_5":17441},{"_11039":1595,"_6688":1604,"_11146":1501,"_19190":1814,"_11133":1487,"_19197":1547,"_11032":17448,"_8046":17447,"_19168":1844,"_20530":1734,"_20550":2298,"_23505":1871,"_23508":13069,"_20545":2450,"_23513":3987,"_23516":1423,"_23518":3145,"_23521":3720,"_20540":3090,"_20792":4133,"_23528":13029,"_23531":1597,"_20817":5229,"_11142":7659,"_23536":10299,"_20812":2886