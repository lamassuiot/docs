11197},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3322":67160,"_29016":67156,"_5":29336,"_20141":111199,"_26412":111200,"_2810":111201},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3322":67161,"_29016":67156,"_5":29336,"_20141":111203,"_26412":111204,"_2810":111205},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3322":67162,"_29016":67156,"_5":29336,"_20141":111207,"_26412":111208,"_2810":111209},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3322":67163,"_29016":67156,"_5":29336,"_20141":111211,"_26412":111212,"_2810":111213},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3322":67164,"_29016":67156,"_5":29336,"_20141":111215,"_26412":111216,"_2810":111217},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3322":67165,"_29016":67156,"_20141":111219,"_5":13774,"_26412":67156,"_2810":111220},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3322":67166,"_29016":67156,"_20141":111222,"_5":13774,"_26412":111192,"_2810":111223},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3322":67167,"_29016":67156,"_20141":111225,"_5":13774,"_26412":111192,"_2810":111226},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3322":67168,"_29016":67156,"_20141":111228,"_5":13774,"_26412":111192,"_2810":111229},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3322":67169,"_29016":67156,"_20141":111231,"_5":13774,"_26412":111196,"_2810":111232},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3322":67170,"_29016":67156,"_20141":111234,"_5":13774,"_26412":111196,"_2810":111235},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3322":67171,"_29016":67156,"_20141":111237,"_5":13774,"_26412":111196,"_2810":111238},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3322":67172,"_29016":67156,"_20141":111240,"_5":13774,"_26412":111200,"_2810":111241},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3322":67173,"_29016":67156,"_20141":111243,"_5":13774,"_26412":111204,"_2810":111244},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3322":67174,"_29016":67156,"_20141":111246,"_5":13774,"_26412":111208,"_2810":111247},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3322":67175,"_29016":67156,"_20141":111249,"_5":13774,"_26412":111212,"_2810":111250},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3322":67176,"_29016":67156,"_20141":111252,"_5":13774,"_26412":111216,"_2810":111253},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3322":67177,"_29016":67177,"_5":14132,"_2810":111255,"_29339":111256,"_20141":111257,"_26412":67177},"Despliega Lamassu",[47234,111184],[],{"_3322":67178,"_29016":67177,"_20141":111259,"_5":13774,"_26412":67177,"_2810":111260},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3322":67179,"_29016":67177,"_5":29336,"_20141":111262,"_26412":111263,"_2810":111264},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3322":67180,"_29016":67177,"_5":29336,"_20141":111266,"_26412":111267,"_2810":111268},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3322":67181,"_29016":67177,"_5":29336,"_20141":111270,"_26412":111271,"_2810":111272},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3322":67182,"_29016":67177,"_20141":111274,"_5":13774,"_26412":67177,"_2810":111275},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3322":67183,"_29016":67177,"_20141":111277,"_5":13774,"_26412":111263,"_2810":111278},[],"Modelo",{"_3322":67184,"_29016":67177,"_20141":111280,"_5":13774,"_26412":111263,"_2810":111281},[],"Recomendado para",{"_3322":67185,"_29016":67177,"_20141":111283,"_5":13774,"_26412":111263,"_2810":111284},[],"Quién opera la infraestructura",{"_3322":67186,"_29016":67177,"_20141":111286,"_5":13774,"_26412":111263,"_2810":111287},[],"Punto de partida",{"_3322":67187,"_29016":67177,"_20141":111289,"_5":13774,"_26412":111263,"_2810":47341},[],{"_3322":67188,"_29016":67177,"_20141":111291,"_5":13774,"_26412":111263,"_2810":111292},[],"Producción, entornos regulados y despliegues personalizados",{"_3322":67189,"_29016":67177,"_20141":111294,"_5":13774,"_26412":111263,"_2810":111295},[],"Tu equipo",{"_3322":67190,"_29016":67177,"_20141":111297,"_5":13774,"_26412":111263,"_2810":111298},[],"Helm o Fastlane",{"_3322":67191,"_29016":67177,"_20141":111300,"_5":13774,"_26412":111263,"_2810":47353},[],{"_3322":67192,"_29016":67177,"_20141":111302,"_5":13774,"_26412":111263,"_2810":111303},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3322":67193,"_29016":67177,"_20141":111305,"_5":13774,"_26412":111263,"_2810":111295},[],{"_3322":67194,"_29016":67177,"_20141":111307,"_5":13774,"_26412":111263,"_2810":111308},[],"Imagen preconfigurada en EC2",{"_3322":67195,"_29016":67177,"_20141":111310,"_5":13774,"_26412":111263,"_2810":47364},[],{"_3322":67196,"_29016":67177,"_20141":111312,"_5":13774,"_26412":111263,"_2810":111313},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3322":67197,"_29016":67177,"_20141":111315,"_5":13774,"_26412":111263,"_2810":47370},[],{"_3322":67198,"_29016":67177,"_20141":111317,"_5":13774,"_26412":111263,"_2810":111318},[],"Suscripción gestionada",{"_3322":67199,"_29016":67177,"_20141":111320,"_5":13774,"_26412":111263,"_2810":111321},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3322":67200,"_29016":67177,"_20141":111323,"_5":13774,"_26412":111263,"_2810":111324},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3322":67201,"_29016":67177,"_20141":111326,"_5":13774,"_26412":111263,"_2810":111327},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3322":67202,"_29016":67177,"_20141":111329,"_5":13774,"_26412":111267,"_2810":111330},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3322":67203,"_29016":67177,"_20141":111332,"_5":13774,"_26412":111271,"_2810":111333},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3322":67204,"_29016":67204,"_5":14132,"_2810":111335,"_29339":111336,"_20141":111337,"_26412":67204},"Utiliza Lamassu como SaaS",[47234,111184,111185],[],{"_3322":67205,"_29016":67204,"_20141":111339,"_5":13774,"_26412":67204,"_2810":111340},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3322":67206,"_29016":67204,"_5":29336,"_20141":111342,"_26412":111343,"_2810":111344},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3322":67207,"_29016":67204,"_5":29336,"_20141":111346,"_26412":111347,"_2810":111348},[],"/docs/es/deployment/saas#planes","Planes",{"_3322":67208,"_29016":67204,"_5":29336,"_20141":111350,"_26412":111351,"_2810":111352},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3322":67209,"_29016":67204,"_20141":111354,"_5":13774,"_26412":67204,"_2810":111355},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3322":67210,"_29016":67204,"_20141":111357,"_5":13774,"_26412":111343,"_2810":111358},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3322":67211,"_29016":67204,"_20141":111360,"_5":13774,"_26412":111343,"_2810":111361},[],"Copias de seguridad automáticas.",{"_3322":67212,"_29016":67204,"_20141":111363,"_5":13774,"_26412":111343,"_2810":111364},[],"Actualizaciones de versión.",{"_3322":67213,"_29016":67204,"_20141":111366,"_5":13774,"_26412":111343,"_2810":111367},[],"Soporte técnico y SLA según el plan contratado.",{"_3322":67214,"_29016":67204,"_20141":111369,"_5":13774,"_26412":111347,"_2810":47425},[],{"_3322":67215,"_29016":67204,"_20141":111371,"_5":13774,"_26412":111347,"_2810":111372},[],"Dispositivos",{"_3322":67216,"_29016":67204,"_20141":111374,"_5":13774,"_26412":111347,"_2810":111375},[],"Soporte",{"_3322":67217,"_29016":67204,"_20141":111377,"_5":13774,"_26412":111347,"_2810":47434},[],{"_3322":67218,"_29016":67204,"_20141":111379,"_5":13774,"_26412":111347,"_2810":47437},[],{"_3322":67219,"_29016":67204,"_20141":111381,"_5":13774,"_26412":111347,"_2810":111382},[],"Hasta 1.000",{"_3322":67220,"_29016":67204,"_20141":111384,"_5":13774,"_26412":111347,"_2810":47443},[],{"_3322":67221,"_29016":67204,"_20141":111386,"_5":13774,"_26412":111347,"_2810":111387},[],"99,5 %",{"_3322":67222,"_29016":67204,"_20141":111389,"_5":13774,"_26412":111347,"_2810":47449},[],{"_3322":67223,"_29016":67204,"_20141":111391,"_5":13774,"_26412":111347,"_2810":111392},[],"Hasta 10.000",{"_3322":67224,"_29016":67204,"_20141":111394,"_5":13774,"_26412":111347,"_2810":111395},[],"Email y chat",{"_3322":67225,"_29016":67204,"_20141":111397,"_5":13774,"_26412":111347,"_2810":111398},[],"99,9 %",{"_3322":67226,"_29016":67204,"_20141":111400,"_5":13774,"_26412":111347,"_2810":47461},[],{"_3322":67227,"_29016":67204,"_20141":111402,"_5":13774,"_26412":111347,"_2810":111403},[],"Ilimitados",{"_3322":67228,"_29016":67204,"_20141":111405,"_5":13774,"_26412":111347,"_2810":111406},[],"Dedicado",{"_3322":67229,"_29016":67204,"_20141":111408,"_5":13774,"_26412":111347,"_2810":111409},[],"99,99 %",{"_3322":67230,"_29016":67204,"_20141":111411,"_5":13774,"_26412":111351,"_2810":111412},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3322":67231,"_29016":67204,"_20141":111414,"_5":13774,"_26412":111351,"_2810":111415},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3322":67232,"_29016":67232,"_5":14132,"_2810":47478,"_29339":111417,"_20141":111419,"_26412":67232},[47234,111184,111418],"Kubernetes autogestionado",[],{"_3322":67233,"_29016":67232,"_20141":111421,"_5":13774,"_26412":67232,"_2810":111422},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3322":67234,"_29016":67232,"_5":29336,"_20141":111424,"_26412":111425,"_2810":111426},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3322":67235,"_29016":67232,"_5":29336,"_20141":111428,"_26412":111429,"_2810":111430},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3322":67236,"_29016":67232,"_5":29336,"_20141":111432,"_26412":111433,"_2810":111434},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3322":67237,"_29016":67232,"_5":29336,"_20141":111436,"_26412":111437,"_2810":111438},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3322":67238,"_29016":67232,"_5":29336,"_20141":111440,"_26412":111441,"_2810":111442},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3322":67239,"_29016":67232,"_5":29336,"_20141":111444,"_26412":111445,"_2810":111446},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3322":67240,"_29016":67232,"_5":29336,"_20141":111448,"_26412":111449,"_2810":111450},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3322":67241,"_29016":67232,"_5":29336,"_20141":111452,"_26412":111453,"_2810":111454},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3322":67242,"_29016":67232,"_5":29336,"_20141":111456,"_26412":111457,"_2810":111458},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3322":67243,"_29016":67232,"_5":29336,"_20141":111460,"_26412":111461,"_2810":111462},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3322":67244,"_29016":67232,"_5":29336,"_20141":111464,"_26412":111465,"_2810":111466},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3322":67245,"_29016":67232,"_20141":111468,"_5":13774,"_26412":111425,"_2810":111469},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3322":67246,"_29016":67232,"_20141":111471,"_5":13774,"_26412":111425,"_2810":111472},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3322":67247,"_29016":67232,"_20141":111474,"_5":13774,"_26412":111429,"_2810":111475},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3322":67248,"_29016":67232,"_20141":111477,"_5":13774,"_26412":111429,"_2810":111478},[],"Fastlane instala o configura",{"_3322":67249,"_29016":67232,"_20141":111480,"_5":13774,"_26412":111429,"_2810":111481},[],"Tú sigues proporcionando",{"_3322":67250,"_29016":67232,"_20141":111483,"_5":13774,"_26412":111429,"_2810":111484},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3322":67251,"_29016":67232,"_20141":111486,"_5":13774,"_26412":111429,"_2810":111487},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3322":67252,"_29016":67232,"_20141":111489,"_5":13774,"_26412":111429,"_2810":111490},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3322":67253,"_29016":67232,"_20141":111492,"_5":13774,"_26412":111429,"_2810":111493},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3322":67254,"_29016":67232,"_20141":111495,"_5":13774,"_26412":111429,"_2810":111496},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3322":67255,"_29016":67232,"_20141":111498,"_5":13774,"_26412":111429,"_2810":111499},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3322":67256,"_29016":67232,"_20141":111501,"_5":13774,"_26412":111429,"_2810":111502},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3322":67257,"_29016":67232,"_20141":111504,"_5":13774,"_26412":111429,"_2810":111505},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3322":67258,"_29016":67232,"_20141":111507,"_5":13774,"_26412":111429,"_2810":111508},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3322":67259,"_29016":67232,"_20141":111510,"_5":13774,"_26412":111433,"_2810":111511},[],"Necesitas:",{"_3322":67260,"_29016":67232,"_20141":111513,"_5":13774,"_26412":111433,"_2810":111514},[],"un clúster Kubernetes existente",{"_3322":67261,"_29016":67232,"_20141":111516,"_5":13774,"_26412":111433,"_2810":111517},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3322":67262,"_29016":67232,"_20141":111519,"_5":13774,"_26412":111433,"_2810":47580},[],{"_3322":67263,"_29016":67232,"_20141":111521,"_5":13774,"_26412":111433,"_2810":22790},[],{"_3322":67264,"_29016":67232,"_20141":111523,"_5":13774,"_26412":111433,"_2810":111524},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3322":67265,"_29016":67232,"_20141":111526,"_5":13774,"_26412":111433,"_2810":111527},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3322":67266,"_29016":67232,"_20141":111529,"_5":13774,"_26412":111433,"_2810":111530},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3322":67267,"_29016":67232,"_20141":111532,"_5":13774,"_26412":111433,"_2810":111533},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3322":67268,"_29016":67232,"_20141":111535,"_5":13774,"_26412":111433,"_2810":111536},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3322":67269,"_29016":67232,"_20141":111538,"_5":13774,"_26412":111437,"_2810":111539},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3322":67270,"_29016":67232,"_20141":111541,"_5":13774,"_26412":111437,"_2810":111542},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3322":67271,"_29016":67232,"_20141":111544,"_5":13774,"_26412":111441,"_2810":111545},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3322":67272,"_29016":67232,"_20141":111547,"_5":13774,"_26412":111441,"_2810":111548},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3322":67273,"_29016":67232,"_20141":111550,"_5":13774,"_26412":111441,"_2810":111551},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3322":67274,"_29016":67232,"_20141":111553,"_5":13774,"_26412":111441,"_2810":111554},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3322":67275,"_29016":67232,"_20141":111556,"_5":13774,"_26412":111445,"_2810":111557},[],"Opción",{"_3322":67276,"_29016":67232,"_20141":111559,"_5":13774,"_26412":111445,"_2810":111560},[],"Valor predeterminado",{"_3322":67277,"_29016":67232,"_20141":111562,"_5":13774,"_26412":111445,"_2810":111563},[],"Propósito",{"_3322":67278,"_29016":67232,"_20141":111565,"_5":13774,"_26412":111445,"_2810":47627},[],{"_3322":67279,"_29016":67232,"_20141":111567,"_5":13774,"_26412":111445,"_2810":47630},[],{"_3322":67280,"_29016":67232,"_20141":111569,"_5":13774,"_26412":111445,"_2810":111570},[],"Muestra la ayuda",{"_3322":67281,"_29016":67232,"_20141":111572,"_5":13774,"_26412":111445,"_2810":47636},[],{"_3322":67282,"_29016":67232,"_20141":111574,"_5":13774,"_26412":111445,"_2810":111575},[],"contexto actual",{"_3322":67283,"_29016":67232,"_20141":111577,"_5":13774,"_26412":111445,"_2810":111578},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3322":67284,"_29016":67232,"_20141":111580,"_5":13774,"_26412":111445,"_2810":47645},[],{"_3322":67285,"_29016":67232,"_20141":111582,"_5":13774,"_26412":111445,"_2810":6227},[],{"_3322":67286,"_29016":67232,"_20141":111584,"_5":13774,"_26412":111445,"_2810":111585},[],"Omite prompts y genera credenciales para las dependencias",{"_3322":67287,"_29016":67232,"_20141":111587,"_5":13774,"_26412":111445,"_2810":47653},[],{"_3322":67288,"_29016":67232,"_20141":111589,"_5":13774,"_26412":111445,"_2810":47656},[],{"_3322":67289,"_29016":67232,"_20141":111591,"_5":13774,"_26412":111445,"_2810":111592},[],"Namespace de la instalación",{"_3322":67290,"_29016":67232,"_20141":111594,"_5":13774,"_26412":111445,"_2810":47662},[],{"_3322":67291,"_29016":67232,"_20141":111596,"_5":13774,"_26412":111445,"_2810":47665},[],{"_3322":67292,"_29016":67232,"_20141":111598,"_5":13774,"_26412":111445,"_2810":111599},[],"Dominio usado por la UI, OIDC y el certificado",{"_3322":67293,"_29016":67232,"_20141":111601,"_5":13774,"_26412":111445,"_2810":47671},[],{"_3322":67294,"_29016":67232,"_20141":111603,"_5":13774,"_26412":111445,"_2810":14433},[],{"_3322":67295,"_29016":67232,"_20141":111605,"_5":13774,"_26412":111445,"_2810":111606},[],"Versión del chart de Lamassu",{"_3322":67296,"_29016":67232,"_20141":111608,"_5":13774,"_26412":111445,"_2810":47679},[],{"_3322":67297,"_29016":67232,"_20141":111610,"_5":13774,"_26412":111445,"_2810":47682},[],{"_3322":67298,"_29016":67232,"_20141":111612,"_5":13774,"_26412":111445,"_2810":111613},[],"Puerto del listener HTTPS",{"_3322":67299,"_29016":67232,"_20141":111615,"_5":13774,"_26412":111445,"_2810":47688},[],{"_3322":67300,"_29016":67232,"_20141":111617,"_5":13774,"_26412":111445,"_2810":47691},[],{"_3322":67301,"_29016":67232,"_20141":111619,"_5":13774,"_26412":111445,"_2810":111620},[],"Puerto del listener HTTP",{"_3322":67302,"_29016":67232,"_20141":111622,"_5":13774,"_26412":111445,"_2810":47697},[],{"_3322":67303,"_29016":67232,"_20141":111624,"_5":13774,"_26412":111445,"_2810":47630},[],{"_3322":67304,"_29016":67232,"_20141":111626,"_5":13774,"_26412":111445,"_2810":111627},[],"Certificado PEM para TLS downstream",{"_3322":67305,"_29016":67232,"_20141":111629,"_5":13774,"_26412":111445,"_2810":47705},[],{"_3322":67306,"_29016":67232,"_20141":111631,"_5":13774,"_26412":111445,"_2810":47630},[],{"_3322":67307,"_29016":67232,"_20141":111633,"_5":13774,"_26412":111445,"_2810":111634},[],"Clave privada PEM para TLS downstream",{"_3322":67308,"_29016":67232,"_20141":111636,"_5":13774,"_26412":111445,"_2810":47713},[],{"_3322":67309,"_29016":67232,"_20141":111638,"_5":13774,"_26412":111445,"_2810":111639},[],"chart del repositorio",{"_3322":67310,"_29016":67232,"_20141":111641,"_5":13774,"_26412":111445,"_2810":111642},[],"Usa un chart local de Lamassu sin empaquetar",{"_3322":67311,"_29016":67232,"_20141":111644,"_5":13774,"_26412":111445,"_2810":47722},[],{"_3322":67312,"_29016":67232,"_20141":111646,"_5":13774,"_26412":111445,"_2810":111647},[],"detección automática",{"_3322":67313,"_29016":67232,"_20141":111649,"_5":13774,"_26412":111445,"_2810":111650},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3322":67314,"_29016":67232,"_20141":111652,"_5":13774,"_26412":111445,"_2810":47730},[],{"_3322":67315,"_29016":67232,"_20141":111654,"_5":13774,"_26412":111445,"_2810":6227},[],{"_3322":67316,"_29016":67232,"_20141":111656,"_5":13774,"_26412":111445,"_2810":111657},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3322":67317,"_29016":67232,"_20141":111659,"_5":13774,"_26412":111445,"_2810":47738},[],{"_3322":67318,"_29016":67232,"_20141":111661,"_5":13774,"_26412":111445,"_2810":6227},[],{"_3322":67319,"_29016":67232,"_20141":111663,"_5":13774,"_26412":111445,"_2810":111664},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3322":67320,"_29016":67232,"_20141":111666,"_5":13774,"_26412":111445,"_2810":47746},[],{"_3322":67321,"_29016":67232,"_20141":111668,"_5":13774,"_26412":111445,"_2810":6227},[],{"_3322":67322,"_29016":67232,"_20141":111670,"_5":13774,"_26412":111445,"_2810":111671},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3322":67323,"_29016":67232,"_20141":111673,"_5":13774,"_26412":111445,"_2810":47754},[],{"_3322":67324,"_29016":67232,"_20141":111675,"_5":13774,"_26412":111445,"_2810":6227},[],{"_3322":67325,"_29016":67232,"_20141":111677,"_5":13774,"_26412":111445,"_2810":111678},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3322":67326,"_29016":67232,"_20141":111680,"_5":13774,"_26412":111445,"_2810":47762},[],{"_3322":67327,"_29016":67232,"_20141":111682,"_5":13774,"_26412":111445,"_2810":47765},[],{"_3322":67328,"_29016":67232,"_20141":111684,"_5":13774,"_26412":111445,"_2810":111685},[],"Usa otro chart local de SoftHSM",{"_3322":67329,"_29016":67232,"_20141":111687,"_5":13774,"_26412":111445,"_2810":111688},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3322":67330,"_29016":67232,"_20141":111690,"_5":13774,"_26412":111449,"_2810":111691},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3322":67331,"_29016":67232,"_20141":111693,"_5":13774,"_26412":111449,"_2810":111694},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3322":67332,"_29016":67232,"_20141":111696,"_5":13774,"_26412":111449,"_2810":111697},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3322":67333,"_29016":67232,"_20141":111699,"_5":13774,"_26412":111449,"_2810":111700},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3322":67334,"_29016":67232,"_20141":111702,"_5":13774,"_26412":111449,"_2810":111703},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3322":67335,"_29016":67232,"_20141":111705,"_5":13774,"_26412":111449,"_2810":111706},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3322":67336,"_29016":67232,"_20141":111708,"_5":13774,"_26412":111453,"_2810":47792},[],{"_3322":67337,"_29016":67232,"_20141":111710,"_5":13774,"_26412":111453,"_2810":111711},[],"valida las herramientas locales y el clúster seleccionado",{"_3322":67338,"_29016":67232,"_20141":111713,"_5":13774,"_26412":111453,"_2810":111714},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3322":67339,"_29016":67232,"_20141":111716,"_5":13774,"_26412":111453,"_2810":111717},[],"crea el namespace",{"_3322":67340,"_29016":67232,"_20141":111719,"_5":13774,"_26412":111453,"_2810":111720},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3322":67341,"_29016":67232,"_20141":111722,"_5":13774,"_26412":111453,"_2810":111723},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3322":67342,"_29016":67232,"_20141":111725,"_5":13774,"_26412":111453,"_2810":111726},[],"instala RabbitMQ",{"_3322":67343,"_29016":67232,"_20141":111728,"_5":13774,"_26412":111453,"_2810":111729},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3322":67344,"_29016":67232,"_20141":111731,"_5":13774,"_26412":111453,"_2810":111732},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3322":67345,"_29016":67232,"_20141":111734,"_5":13774,"_26412":111453,"_2810":111735},[],"carga datos de ejemplo opcionalmente",{"_3322":67346,"_29016":67232,"_20141":111737,"_5":13774,"_26412":111453,"_2810":111738},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3322":67347,"_29016":67232,"_20141":111740,"_5":13774,"_26412":111457,"_2810":111741},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3322":67348,"_29016":67232,"_20141":111743,"_5":13774,"_26412":111457,"_2810":111744},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3322":67349,"_29016":67232,"_20141":111746,"_5":13774,"_26412":111461,"_2810":111747},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3322":67350,"_29016":67232,"_20141":111749,"_5":13774,"_26412":111461,"_2810":111750},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3322":67351,"_29016":67232,"_20141":111752,"_5":13774,"_26412":111461,"_2810":111753},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3322":67352,"_29016":67232,"_20141":111755,"_5":13774,"_26412":111465,"_2810":111756},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3322":67353,"_29016":67353,"_5":14132,"_2810":111758,"_29339":111759,"_20141":111760,"_26412":67353},"Instala con Helm",[47234,111184,111418],[],{"_3322":67354,"_29016":67353,"_20141":111762,"_5":13774,"_26412":67353,"_2810":111763},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3322":67355,"_29016":67353,"_5":29336,"_20141":111765,"_26412":111766,"_2810":111767},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3322":67356,"_29016":67353,"_5":29336,"_20141":111769,"_26412":111770,"_2810":111434},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3322":67357,"_29016":67353,"_5":29336,"_20141":111772,"_26412":111773,"_2810":111774},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3322":67358,"_29016":67353,"_5":29336,"_20141":111776,"_26412":111777,"_2810":111778},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3322":67359,"_29016":67353,"_5":29336,"_20141":111780,"_26412":111781,"_2810":111782},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3322":67360,"_29016":67353,"_5":29336,"_20141":111784,"_26412":111785,"_2810":111786},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3322":67361,"_29016":67353,"_5":29336,"_20141":111788,"_26412":111789,"_2810":111790},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3322":67362,"_29016":67353,"_5":29336,"_20141":111792,"_26412":111793,"_2810":111794},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3322":67363,"_29016":67353,"_5":29336,"_20141":111796,"_26412":111797,"_2810":111798},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3322":67364,"_29016":67353,"_5":29336,"_20141":111800,"_26412":111801,"_2810":111802},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3322":67365,"_29016":67353,"_20141":111804,"_5":13774,"_26412":111766,"_2810":111805},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3322":67366,"_29016":67353,"_20141":111807,"_5":13774,"_26412":111770,"_2810":111808},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3322":67367,"_29016":67353,"_20141":111810,"_5":13774,"_26412":111770,"_2810":111811},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3322":67368,"_29016":67353,"_20141":111813,"_5":13774,"_26412":111770,"_2810":111814},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3322":67369,"_29016":67353,"_20141":111816,"_5":13774,"_26412":111770,"_2810":111817},[],"un broker RabbitMQ accesible y sus credenciales",{"_3322":67370,"_29016":67353,"_20141":111819,"_5":13774,"_26412":111770,"_2810":111820},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3322":67371,"_29016":67353,"_20141":111822,"_5":13774,"_26412":111770,"_2810":111823},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3322":67372,"_29016":67353,"_20141":111825,"_5":13774,"_26412":111770,"_2810":111826},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3322":67373,"_29016":67353,"_20141":111828,"_5":13774,"_26412":111770,"_2810":111829},[],"una StorageClass y un diseño de tráfico externo",{"_3322":67374,"_29016":67353,"_20141":111831,"_5":13774,"_26412":111770,"_2810":111832},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3322":67375,"_29016":67353,"_20141":111834,"_5":13774,"_26412":111770,"_2810":111835},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3322":67376,"_29016":67353,"_20141":111837,"_5":13774,"_26412":111770,"_2810":111838},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3322":67377,"_29016":67353,"_20141":111840,"_5":13774,"_26412":111773,"_2810":111841},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3322":67378,"_29016":67353,"_20141":111843,"_5":13774,"_26412":111773,"_2810":111844},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3322":67379,"_29016":67353,"_20141":111846,"_5":13774,"_26412":111773,"_2810":111847},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3322":67380,"_29016":67353,"_20141":111849,"_5":13774,"_26412":111777,"_2810":111850},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3322":67381,"_29016":67353,"_20141":111852,"_5":13774,"_26412":111777,"_2810":111853},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3322":67382,"_29016":67353,"_20141":111855,"_5":13774,"_26412":111777,"_2810":111856},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3322":67383,"_29016":67353,"_20141":111858,"_5":13774,"_26412":111777,"_2810":111859},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3322":67384,"_29016":67353,"_20141":111861,"_5":13774,"_26412":111781,"_2810":111862},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3322":67385,"_29016":67353,"_20141":111864,"_5":13774,"_26412":111785,"_2810":111865},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3322":67386,"_29016":67353,"_20141":111867,"_5":13774,"_26412":111785,"_2810":111868},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3322":67387,"_29016":67353,"_20141":111870,"_5":13774,"_26412":111785,"_2810":111871},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3322":67388,"_29016":67353,"_20141":111873,"_5":13774,"_26412":111785,"_2810":111874},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3322":67389,"_29016":67353,"_20141":111876,"_5":13774,"_26412":111785,"_2810":111877},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3322":67390,"_29016":67353,"_20141":111879,"_5":13774,"_26412":111785,"_2810":111880},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3322":67391,"_29016":67353,"_20141":111882,"_5":13774,"_26412":111785,"_2810":111883},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3322":67392,"_29016":67353,"_20141":111885,"_5":13774,"_26412":111789,"_2810":111886},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3322":67393,"_29016":67353,"_20141":111888,"_5":13774,"_26412":111789,"_2810":111889},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3322":67394,"_29016":67353,"_20141":111891,"_5":13774,"_26412":111789,"_2810":111892},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3322":67395,"_29016":67353,"_20141":111894,"_5":13774,"_26412":111789,"_2810":111895},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3322":67396,"_29016":67353,"_20141":111897,"_5":13774,"_26412":111793,"_2810":111898},[],"Para instalar un checkout local:",{"_3322":67397,"_29016":67353,"_20141":111900,"_5":13774,"_26412":111797,"_2810":111901},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3322":67398,"_29016":67353,"_20141":111903,"_5":13774,"_26412":111797,"_2810":111904},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3322":67399,"_29016":67353,"_20141":111906,"_5":13774,"_26412":111801,"_2810":111907},[],"Antes de pasar a producción, revisa:",{"_3322":67400,"_29016":67353,"_20141":111909,"_5":13774,"_26412":111801,"_2810":111910},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3322":67401,"_29016":67353,"_20141":111912,"_5":13774,"_26412":111801,"_2810":111913},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3322":67402,"_29016":67353,"_20141":111915,"_5":13774,"_26412":111801,"_2810":111916},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3322":67403,"_29016":67353,"_20141":111918,"_5":13774,"_26412":111801,"_2810":111919},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3322":67404,"_29016":67353,"_20141":111921,"_5":13774,"_26412":111801,"_2810":111922},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3322":67405,"_29016":67353,"_20141":111924,"_5":13774,"_26412":111801,"_2810":111925},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3322":67406,"_29016":67353,"_20141":111927,"_5":13774,"_26412":111801,"_2810":111928},[],"SMTP, observabilidad y entrega de alertas",{"_3322":67407,"_29016":67353,"_20141":111930,"_5":13774,"_26412":111801,"_2810":111931},[],"las guías de actualización entre versiones y las notas de `charts/lamassu/CHANGELOG/` antes de cada upgrade",{"_3322":67408,"_29016":67353,"_20141":111933,"_5":13774,"_26412":111801,"_2810":111934},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3322":67409,"_29016":67409,"_5":14132,"_2810":111936,"_29339":111937,"_20141":111938,"_26412":67409},"Expón el Gateway",[47234,111184,111418],[],{"_3322":67410,"_29016":67409,"_20141":111940,"_5":13774,"_26412":67409,"_2810":111941},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3322":67411,"_29016":67409,"_5":29336,"_20141":111943,"_26412":111944,"_2810":111945},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3322":67412,"_29016":67409,"_5":29336,"_20141":111947,"_26412":111948,"_2810":111949},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3322":67413,"_29016":67409,"_5":29336,"_20141":111951,"_26412":111952,"_2810":111953},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3322":67414,"_29016":67409,"_5":29336,"_20141":111955,"_26412":111956,"_2810":48041},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3322":67415,"_29016":67409,"_5":29336,"_20141":111958,"_26412":111959,"_2810":111960},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3322":67416,"_29016":67409,"_5":29336,"_20141":111962,"_26412":111963,"_2810":111964},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3322":67417,"_29016":67409,"_5":29336,"_20141":111966,"_26412":111967,"_2810":111968},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3322":67418,"_29016":67409,"_5":29336,"_20141":111970,"_26412":111971,"_2810":111972},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3322":67419,"_29016":67409,"_5":29336,"_20141":111974,"_26412":111975,"_2810":111976},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3322":67420,"_29016":67409,"_5":29336,"_20141":111978,"_26412":111979,"_2810":111980},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3322":67421,"_29016":67409,"_20141":111982,"_5":13774,"_26412":111944,"_2810":111983},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3322":67422,"_29016":67409,"_20141":111985,"_5":13774,"_26412":111944,"_2810":111986},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3322":67423,"_29016":67409,"_20141":111988,"_5":13774,"_26412":111948,"_2810":111989},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3322":67424,"_29016":67409,"_20141":111991,"_5":13774,"_26412":111948,"_2810":111992},[],"Defínelo únicamente cuando:",{"_3322":67425,"_29016":67409,"_20141":111994,"_5":13774,"_26412":111948,"_2810":111995},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3322":67426,"_29016":67409,"_20141":111997,"_5":13774,"_26412":111948,"_2810":111998},[],"esa dirección está asignada a este Gateway",{"_3322":67427,"_29016":67409,"_20141":112000,"_5":13774,"_26412":111948,"_2810":112001},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3322":67428,"_29016":67409,"_20141":112003,"_5":13774,"_26412":111948,"_2810":112004},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3322":67429,"_29016":67409,"_20141":112006,"_5":13774,"_26412":111948,"_2810":112007},[],"No confundas estos valores:",{"_3322":67430,"_29016":67409,"_20141":112009,"_5":13774,"_26412":111948,"_2810":112010},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3322":67431,"_29016":67409,"_20141":112012,"_5":13774,"_26412":111948,"_2810":112013},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3322":67432,"_29016":67409,"_20141":112015,"_5":13774,"_26412":111948,"_2810":112016},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3322":67433,"_29016":67409,"_20141":112018,"_5":13774,"_26412":111952,"_2810":112019},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3322":67434,"_29016":67409,"_20141":112021,"_5":13774,"_26412":111952,"_2810":112022},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3322":67435,"_29016":67409,"_20141":112024,"_5":13774,"_26412":111956,"_2810":112025},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3322":67436,"_29016":67409,"_20141":112027,"_5":13774,"_26412":111956,"_2810":112028},[],"Para el diseño recomendado:",{"_3322":67437,"_29016":67409,"_20141":112030,"_5":13774,"_26412":111956,"_2810":112031},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3322":67438,"_29016":67409,"_20141":112033,"_5":13774,"_26412":111956,"_2810":112034},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3322":67439,"_29016":67409,"_20141":112036,"_5":13774,"_26412":111956,"_2810":112037},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3322":67440,"_29016":67409,"_20141":112039,"_5":13774,"_26412":111956,"_2810":112040},[],"Apunta DNS a la dirección accesible de la VM.",{"_3322":67441,"_29016":67409,"_20141":112042,"_5":13774,"_26412":111956,"_2810":112043},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3322":67442,"_29016":67409,"_20141":112045,"_5":13774,"_26412":111959,"_2810":112046},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3322":67443,"_29016":67409,"_20141":112048,"_5":13774,"_26412":111963,"_2810":112049},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3322":67444,"_29016":67409,"_20141":112051,"_5":13774,"_26412":111963,"_2810":112052},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3322":67445,"_29016":67409,"_20141":112054,"_5":13774,"_26412":111967,"_2810":112055},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3322":67446,"_29016":67409,"_20141":112057,"_5":13774,"_26412":111967,"_2810":112058},[],"Requisito",{"_3322":67447,"_29016":67409,"_20141":112060,"_5":13774,"_26412":111967,"_2810":112061},[],"Diseño recomendado",{"_3322":67448,"_29016":67409,"_20141":112063,"_5":13774,"_26412":111967,"_2810":112064},[],"Consecuencia",{"_3322":67449,"_29016":67409,"_20141":112066,"_5":13774,"_26412":111967,"_2810":112067},[],"Varias URL o servicios de Lamassu",{"_3322":67450,"_29016":67409,"_20141":112069,"_5":13774,"_26412":111967,"_2810":112070},[],"Un Gateway con varias rutas",{"_3322":67451,"_29016":67409,"_20141":112072,"_5":13774,"_26412":111967,"_2810":112073},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3322":67452,"_29016":67409,"_20141":112075,"_5":13774,"_26412":111967,"_2810":112076},[],"Gateways independientes e IP externas distintas",{"_3322":67453,"_29016":67409,"_20141":112078,"_5":13774,"_26412":111967,"_2810":112079},[],"Una VIP por Gateway",{"_3322":67454,"_29016":67409,"_20141":112081,"_5":13774,"_26412":111967,"_2810":112082},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3322":67455,"_29016":67409,"_20141":112084,"_5":13774,"_26412":111967,"_2810":112085},[],"Gateways independientes, un nodo y una IP",{"_3322":67456,"_29016":67409,"_20141":112087,"_5":13774,"_26412":111967,"_2810":112088},[],"Puertos externos diferentes",{"_3322":67457,"_29016":67409,"_20141":112090,"_5":13774,"_26412":111967,"_2810":112091},[],"Los clientes deben indicar puertos no estándar",{"_3322":67458,"_29016":67409,"_20141":112093,"_5":13774,"_26412":111967,"_2810":112094},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3322":67459,"_29016":67409,"_20141":112096,"_5":13774,"_26412":111967,"_2810":112097},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3322":67460,"_29016":67409,"_20141":112099,"_5":13774,"_26412":111967,"_2810":112100},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3322":67461,"_29016":67409,"_20141":112102,"_5":13774,"_26412":111967,"_2810":112103},[],"Recursos Gateway separados pero proxy compartido",{"_3322":67462,"_29016":67409,"_20141":112105,"_5":13774,"_26412":111967,"_2810":112106},[],"Modo merged Gateway de Envoy",{"_3322":67463,"_29016":67409,"_20141":112108,"_5":13774,"_26412":111967,"_2810":112109},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3322":67464,"_29016":67409,"_20141":112111,"_5":13774,"_26412":111967,"_2810":112112},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3322":67465,"_29016":67409,"_20141":112114,"_5":13774,"_26412":111967,"_2810":112115},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3322":67466,"_29016":67409,"_20141":112117,"_5":13774,"_26412":111967,"_2810":112118},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3322":67467,"_29016":67409,"_20141":112120,"_5":13774,"_26412":111967,"_2810":112121},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3322":67468,"_29016":67409,"_20141":112123,"_5":13774,"_26412":111971,"_2810":112124},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3322":67469,"_29016":67409,"_20141":112126,"_5":13774,"_26412":111971,"_2810":112127},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3322":67470,"_29016":67409,"_20141":112129,"_5":13774,"_26412":111971,"_2810":112130},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3322":67471,"_29016":67409,"_20141":112132,"_5":13774,"_26412":111971,"_2810":112133},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3322":67472,"_29016":67409,"_20141":112135,"_5":13774,"_26412":111971,"_2810":112136},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3322":67473,"_29016":67409,"_20141":112138,"_5":13774,"_26412":111975,"_2810":112139},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3322":67474,"_29016":67409,"_20141":112141,"_5":13774,"_26412":111975,"_2810":112142},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3322":67475,"_29016":67409,"_20141":112144,"_5":13774,"_26412":111979,"_2810":112145},[],"Comprueba, en orden:",{"_3322":67476,"_29016":67409,"_20141":112147,"_5":13774,"_26412":111979,"_2810":112148},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3322":67477,"_29016":67409,"_20141":112150,"_5":13774,"_26412":111979,"_2810":112151},[],"Su estado contiene la dirección esperada.",{"_3322":67478,"_29016":67409,"_20141":112153,"_5":13774,"_26412":111979,"_2810":112154},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3322":67479,"_29016":67409,"_20141":112156,"_5":13774,"_26412":111979,"_2810":112157},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3322":67480,"_29016":67409,"_20141":112159,"_5":13774,"_26412":111979,"_2810":112160},[],"DNS resuelve al endpoint accesible externamente.",{"_3322":67481,"_29016":67409,"_20141":112162,"_5":13774,"_26412":111979,"_2810":112163},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3322":67482,"_29016":67409,"_20141":112165,"_5":13774,"_26412":111979,"_2810":112166},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3322":67483,"_29016":67483,"_5":14132,"_2810":47341,"_29339":112168,"_20141":112169,"_26412":67483},[47234,111184,111418],[],{"_3322":67484,"_29016":67483,"_20141":112171,"_5":13774,"_26412":67483,"_2810":112172},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3322":67485,"_29016":67483,"_5":29336,"_20141":112174,"_26412":112175,"_2810":112176},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3322":67486,"_29016":67483,"_5":29336,"_20141":112178,"_26412":112179,"_2810":112180},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3322":67487,"_29016":67483,"_5":29336,"_20141":112182,"_26412":112183,"_2810":112184},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3322":67488,"_29016":67483,"_5":29336,"_20141":112186,"_26412":112187,"_2810":112188},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3322":67489,"_29016":67483,"_5":29336,"_20141":112190,"_26412":112191,"_2810":112192},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3322":67490,"_29016":67483,"_5":29336,"_20141":112194,"_26412":112195,"_2810":112196},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3322":67491,"_29016":67483,"_20141":112198,"_5":13774,"_26412":112175,"_2810":112199},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3322":67492,"_29016":67483,"_20141":112201,"_5":13774,"_26412":112179,"_2810":112202},[],"Flujo",{"_3322":67493,"_29016":67483,"_20141":112204,"_5":13774,"_26412":112179,"_2810":112205},[],"Úsalo para",{"_3322":67494,"_29016":67483,"_20141":112207,"_5":13774,"_26412":112179,"_2810":112208},[],"Qué instala",{"_3322":67495,"_29016":67483,"_20141":112210,"_5":13774,"_26412":112179,"_2810":48296},[],{"_3322":67496,"_29016":67483,"_20141":112212,"_5":13774,"_26412":112179,"_2810":112213},[],"Producción y entornos controlados",{"_3322":67497,"_29016":67483,"_20141":112215,"_5":13774,"_26412":112179,"_2810":112216},[],"Servicios de Lamassu y recursos de Gateway API",{"_3322":67498,"_29016":67483,"_20141":112218,"_5":13774,"_26412":112179,"_2810":47478},[],{"_3322":67499,"_29016":67483,"_20141":112220,"_5":13774,"_26412":112179,"_2810":112221},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3322":67500,"_29016":67483,"_20141":112223,"_5":13774,"_26412":112179,"_2810":112224},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3322":67501,"_29016":67483,"_20141":112226,"_5":13774,"_26412":112183,"_2810":112227},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3322":67502,"_29016":67483,"_20141":112229,"_5":13774,"_26412":112183,"_2810":112230},[],"Área",{"_3322":67503,"_29016":67483,"_20141":112232,"_5":13774,"_26412":112183,"_2810":112233},[],"El chart de Lamassu proporciona",{"_3322":67504,"_29016":67483,"_20141":112235,"_5":13774,"_26412":112183,"_2810":112236},[],"Tú proporcionas",{"_3322":67505,"_29016":67483,"_20141":112238,"_5":13774,"_26412":112183,"_2810":112239},[],"Aplicaciones Lamassu",{"_3322":67506,"_29016":67483,"_20141":112241,"_5":13774,"_26412":112183,"_2810":112242},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3322":67507,"_29016":67483,"_20141":112244,"_5":13774,"_26412":112183,"_2810":112245},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3322":67508,"_29016":67483,"_20141":112247,"_5":13774,"_26412":112183,"_2810":112248},[],"Datos PostgreSQL",{"_3322":67509,"_29016":67483,"_20141":112250,"_5":13774,"_26412":112183,"_2810":112251},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3322":67510,"_29016":67483,"_20141":112253,"_5":13774,"_26412":112183,"_2810":112254},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3322":67511,"_29016":67483,"_20141":112256,"_5":13774,"_26412":112183,"_2810":112257},[],"Mensajería",{"_3322":67512,"_29016":67483,"_20141":112259,"_5":13774,"_26412":112183,"_2810":112260},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3322":67513,"_29016":67483,"_20141":112262,"_5":13774,"_26412":112183,"_2810":112263},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3322":67514,"_29016":67483,"_20141":112265,"_5":13774,"_26412":112183,"_2810":112266},[],"Identidad",{"_3322":67515,"_29016":67483,"_20141":112268,"_5":13774,"_26412":112183,"_2810":112269},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3322":67516,"_29016":67483,"_20141":112271,"_5":13774,"_26412":112183,"_2810":112272},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3322":67517,"_29016":67483,"_20141":112274,"_5":13774,"_26412":112183,"_2810":112275},[],"Enrutamiento externo",{"_3322":67518,"_29016":67483,"_20141":112277,"_5":13774,"_26412":112183,"_2810":112278},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3322":67519,"_29016":67483,"_20141":112280,"_5":13774,"_26412":112183,"_2810":112281},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3322":67520,"_29016":67483,"_20141":112283,"_5":13774,"_26412":112183,"_2810":48370},[],{"_3322":67521,"_29016":67483,"_20141":112285,"_5":13774,"_26412":112183,"_2810":112286},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3322":67522,"_29016":67483,"_20141":112288,"_5":13774,"_26412":112183,"_2810":112289},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3322":67523,"_29016":67483,"_20141":112291,"_5":13774,"_26412":112183,"_2810":112292},[],"Datos persistentes de la aplicación",{"_3322":67524,"_29016":67483,"_20141":112294,"_5":13774,"_26412":112183,"_2810":112295},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3322":67525,"_29016":67483,"_20141":112297,"_5":13774,"_26412":112183,"_2810":112298},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3322":67526,"_29016":67483,"_20141":112300,"_5":13774,"_26412":112183,"_2810":112301},[],"Integraciones opcionales",{"_3322":67527,"_29016":67483,"_20141":112303,"_5":13774,"_26412":112183,"_2810":112304},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3322":67528,"_29016":67483,"_20141":112306,"_5":13774,"_26412":112183,"_2810":112307},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3322":67529,"_29016":67483,"_20141":112309,"_5":13774,"_26412":112183,"_2810":112310},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3322":67530,"_29016":67483,"_20141":112312,"_5":13774,"_26412":112183,"_2810":112313},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3322":67531,"_29016":67483,"_20141":112315,"_5":13774,"_26412":112187,"_2810":112316},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3322":67532,"_29016":67483,"_20141":112318,"_5":13774,"_26412":112187,"_2810":112319},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3322":67533,"_29016":67483,"_20141":112321,"_5":13774,"_26412":112191,"_2810":112322},[],"Kubernetes 1.24 o posterior",{"_3322":67534,"_29016":67483,"_20141":112324,"_5":13774,"_26412":112191,"_2810":112325},[],"Helm 3.2 o posterior",{"_3322":67535,"_29016":67483,"_20141":112327,"_5":13774,"_26412":112191,"_2810":112328},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3322":67536,"_29016":67483,"_20141":112330,"_5":13774,"_26412":112191,"_2810":112331},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3322":67537,"_29016":67483,"_20141":112333,"_5":13774,"_26412":112191,"_2810":112334},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3322":67538,"_29016":67483,"_20141":112336,"_5":13774,"_26412":112191,"_2810":112337},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3322":67539,"_29016":67483,"_20141":112339,"_5":13774,"_26412":112191,"_2810":112340},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3322":67540,"_29016":67483,"_20141":112342,"_5":13774,"_26412":112195,"_2810":112343},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3322":67541,"_29016":67483,"_20141":112345,"_5":13774,"_26412":112195,"_2810":112346},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3322":67542,"_29016":67483,"_20141":112348,"_5":13774,"_26412":112195,"_2810":112349},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3322":67543,"_29016":67483,"_20141":112351,"_5":13774,"_26412":112195,"_2810":112352},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3322":67544,"_29016":67544,"_5":14132,"_2810":112354,"_29339":112355,"_20141":112357,"_26412":67544},"Resolución de problemas de despliegue",[47234,111184,112356],"Operación",[],{"_3322":67545,"_29016":67544,"_20141":112359,"_5":13774,"_26412":67544,"_2810":112360},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3322":67546,"_29016":67544,"_5":29336,"_20141":112362,"_26412":112363,"_2810":112364},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3322":67547,"_29016":67544,"_5":29336,"_20141":112366,"_26412":112367,"_2810":112368},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3322":67548,"_29016":67544,"_5":29336,"_20141":112370,"_26412":112371,"_2810":112372},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3322":67549,"_29016":67544,"_5":29336,"_20141":112374,"_26412":112375,"_2810":112376},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3322":67550,"_29016":67544,"_5":29336,"_20141":112378,"_26412":112379,"_2810":112380},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3322":67551,"_29016":67544,"_5":29336,"_20141":112382,"_26412":112383,"_2810":112384},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3322":67552,"_29016":67544,"_5":29336,"_20141":112386,"_26412":112387,"_2810":112388},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3322":67553,"_29016":67544,"_5":29336,"_20141":112390,"_26412":112391,"_2810":112392},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3322":67554,"_29016":67544,"_5":29336,"_20141":112394,"_26412":112395,"_2810":112396},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3322":67555,"_29016":67544,"_5":29336,"_20141":112398,"_26412":112399,"_2810":112400},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3322":67556,"_29016":67544,"_5":29336,"_20141":112402,"_26412":112403,"_2810":112404},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3322":67557,"_29016":67544,"_5":29336,"_20141":112406,"_26412":112407,"_2810":112408},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3322":67558,"_29016":67544,"_5":29336,"_20141":112410,"_26412":112411,"_2810":112412},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3322":67559,"_29016":67544,"_20141":112414,"_5":13774,"_26412":67544,"_2810":112415},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3322":67560,"_29016":67544,"_20141":112417,"_5":13774,"_26412":112367,"_2810":112418},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3322":67561,"_29016":67544,"_20141":112420,"_5":13774,"_26412":112371,"_2810":112421},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3322":67562,"_29016":67544,"_20141":112423,"_5":13774,"_26412":112375,"_2810":112424},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3322":67563,"_29016":67544,"_20141":112426,"_5":13774,"_26412":112379,"_2810":112427},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3322":67564,"_29016":67544,"_20141":112429,"_5":13774,"_26412":112383,"_2810":112430},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3322":67565,"_29016":67544,"_20141":112432,"_5":13774,"_26412":112387,"_2810":112433},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3322":67566,"_29016":67544,"_20141":112435,"_5":13774,"_26412":112387,"_2810":112436},[],"Ejecuta también la prueba de conectividad del chart:",{"_3322":67567,"_29016":67544,"_20141":112438,"_5":13774,"_26412":112387,"_2810":112439},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3322":67568,"_29016":67544,"_20141":112441,"_5":13774,"_26412":112387,"_2810":112442},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3322":67569,"_29016":67544,"_20141":112444,"_5":13774,"_26412":112391,"_2810":112445},[],"Si recibes un 401:",{"_3322":67570,"_29016":67544,"_20141":112447,"_5":13774,"_26412":112391,"_2810":112448},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3322":67571,"_29016":67544,"_20141":112450,"_5":13774,"_26412":112391,"_2810":112451},[],"verifica emisor, audiencia y expiración del token;",{"_3322":67572,"_29016":67544,"_20141":112453,"_5":13774,"_26412":112391,"_2810":112454},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3322":67573,"_29016":67544,"_20141":112456,"_5":13774,"_26412":112391,"_2810":112457},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3322":67574,"_29016":67544,"_20141":112459,"_5":13774,"_26412":112391,"_2810":112460},[],"Si el login termina pero las APIs devuelven 403:",{"_3322":67575,"_29016":67544,"_20141":112462,"_5":13774,"_26412":112391,"_2810":112463},[],"inspecciona los claims reales del token;",{"_3322":67576,"_29016":67544,"_20141":112465,"_5":13774,"_26412":112391,"_2810":112466},[],"confirma que coinciden con un principal activo;",{"_3322":67577,"_29016":67544,"_20141":112468,"_5":13774,"_26412":112391,"_2810":112469},[],"revisa las políticas concedidas al principal;",{"_3322":67578,"_29016":67544,"_20141":112471,"_5":13774,"_26412":112391,"_2810":112472},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3322":67579,"_29016":67544,"_20141":112474,"_5":13774,"_26412":112391,"_2810":112475},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3322":67580,"_29016":67544,"_20141":112477,"_5":13774,"_26412":112395,"_2810":112478},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3322":67581,"_29016":67544,"_20141":112480,"_5":13774,"_26412":112395,"_2810":112481},[],"Localiza el pod y Service de authz.",{"_3322":67582,"_29016":67544,"_20141":112483,"_5":13774,"_26412":112395,"_2810":112484},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3322":67583,"_29016":67544,"_20141":112486,"_5":13774,"_26412":112395,"_2810":112487},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3322":67584,"_29016":67544,"_20141":112489,"_5":13774,"_26412":112395,"_2810":112490},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3322":67585,"_29016":67544,"_20141":112492,"_5":13774,"_26412":112395,"_2810":112493},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3322":67586,"_29016":67544,"_20141":112495,"_5":13774,"_26412":112399,"_2810":112496},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3322":67587,"_29016":67544,"_20141":112498,"_5":13774,"_26412":112403,"_2810":112499},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3322":67588,"_29016":67544,"_20141":112501,"_5":13774,"_26412":112403,"_2810":112502},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3322":67589,"_29016":67544,"_20141":112504,"_5":13774,"_26412":112403,"_2810":112505},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3322":67590,"_29016":67544,"_20141":112507,"_5":13774,"_26412":112403,"_2810":112508},[],"volumen persistente sin enlazar;",{"_3322":67591,"_29016":67544,"_20141":112510,"_5":13774,"_26412":112403,"_2810":112511},[],"imagen inaccesible o política de pull incorrecta;",{"_3322":67592,"_29016":67544,"_20141":112513,"_5":13774,"_26412":112403,"_2810":112514},[],"configuración inválida del motor criptográfico;",{"_3322":67593,"_29016":67544,"_20141":112516,"_5":13774,"_26412":112403,"_2810":112517},[],"límites de CPU o memoria demasiado bajos;",{"_3322":67594,"_29016":67544,"_20141":112519,"_5":13774,"_26412":112403,"_2810":112520},[],"migración previa incompleta.",{"_3322":67595,"_29016":67544,"_20141":112522,"_5":13774,"_26412":112403,"_2810":112523},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3322":67596,"_29016":67544,"_20141":112525,"_5":13774,"_26412":112403,"_2810":112526},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3322":67597,"_29016":67544,"_20141":112528,"_5":13774,"_26412":112403,"_2810":112529},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3322":67598,"_29016":67544,"_20141":112531,"_5":13774,"_26412":112407,"_2810":112532},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3322":67599,"_29016":67544,"_20141":112534,"_5":13774,"_26412":112407,"_2810":112535},[],"verifica que esté habilitado en el servicio emisor;",{"_3322":67600,"_29016":67544,"_20141":112537,"_5":13774,"_26412":112407,"_2810":112538},[],"comprueba conectividad y credenciales AMQP;",{"_3322":67601,"_29016":67544,"_20141":112540,"_5":13774,"_26412":112407,"_2810":112541},[],"revisa exchange, routing key, colas y consumidores;",{"_3322":67602,"_29016":67544,"_20141":112543,"_5":13774,"_26412":112407,"_2810":112544},[],"inspecciona dead-letter queues;",{"_3322":67603,"_29016":67544,"_20141":112546,"_5":13774,"_26412":112407,"_2810":112547},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3322":67604,"_29016":67544,"_20141":112549,"_5":13774,"_26412":112407,"_2810":112550},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3322":67605,"_29016":67544,"_20141":112552,"_5":13774,"_26412":112407,"_2810":112553},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3322":67606,"_29016":67544,"_20141":112555,"_5":13774,"_26412":112407,"_2810":112556},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3322":67607,"_29016":67544,"_20141":112558,"_5":13774,"_26412":112407,"_2810":112559},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3322":67608,"_29016":67544,"_20141":112561,"_5":13774,"_26412":112407,"_2810":112562},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3322":67609,"_29016":67544,"_20141":112564,"_5":13774,"_26412":112407,"_2810":112565},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3322":67610,"_29016":67544,"_20141":112567,"_5":13774,"_26412":112407,"_2810":112568},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3322":67611,"_29016":67544,"_20141":112570,"_5":13774,"_26412":112411,"_2810":112571},[],"El chart puede habilitar instrumentación OpenTelemetry. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, authz, servicio y dependencia.",{"_3322":67612,"_29016":67544,"_20141":112573,"_5":13774,"_26412":112411,"_2810":112574},[],"Antes de cerrar una incidencia, guarda:",{"_3322":67613,"_29016":67544,"_20141":112576,"_5":13774,"_26412":112411,"_2810":112577},[],"causa confirmada;",{"_3322":67614,"_29016":67544,"_20141":112579,"_5":13774,"_26412":112411,"_2810":112580},[],"alcance temporal y recursos afectados;",{"_3322":67615,"_29016":67544,"_20141":112582,"_5":13774,"_26412":112411,"_2810":112583},[],"comandos o consultas utilizados;",{"_3322":67616,"_29016":67544,"_20141":112585,"_5":13774,"_26412":112411,"_2810":112586},[],"cambio aplicado y forma de revertirlo;",{"_3322":67617,"_29016":67544,"_20141":112588,"_5":13774,"_26412":112411,"_2810":112589},[],"validación desde un consumidor;",{"_3322":67618,"_29016":67544,"_20141":112591,"_5":13774,"_26412":112411,"_2810":112592},[],"acción preventiva y propietario.",{"_3322":67619,"_29016":67619,"_5":14132,"_2810":112594,"_29339":112595,"_20141":112598,"_26412":67619},"Control de acceso",[47234,112596,112597],"Plataforma","Administración",[],{"_3322":67620,"_29016":67619,"_20141":112600,"_5":13774,"_26412":67619,"_2810":112601},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3322":67621,"_29016":67619,"_5":29336,"_20141":112603,"_26412":112604,"_2810":112605},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3322":67622,"_29016":67619,"_5":29336,"_20141":112607,"_26412":112608,"_2810":112609},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3322":67623,"_29016":67619,"_5":29336,"_20141":112611,"_26412":112612,"_2810":112613},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3322":67624,"_29016":67619,"_5":29336,"_20141":112615,"_26412":112616,"_2810":112617},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3322":67625,"_29016":67619,"_5":29336,"_20141":112619,"_26412":112620,"_2810":112621},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3322":67626,"_29016":67619,"_5":29336,"_20141":112623,"_26412":112624,"_2810":112625},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3322":67627,"_29016":67619,"_5":29336,"_20141":112627,"_26412":112628,"_2810":112629},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3322":67628,"_29016":67619,"_5":29336,"_20141":112631,"_26412":112632,"_2810":112633},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3322":67629,"_29016":67619,"_5":29336,"_20141":112635,"_26412":112636,"_2810":112637},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3322":67630,"_29016":67619,"_5":29336,"_20141":112639,"_26412":112640,"_2810":112641},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3322":67631,"_29016":67619,"_5":29336,"_20141":112643,"_26412":112644,"_2810":112645},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3322":67632,"_29016":67619,"_5":29336,"_20141":112647,"_26412":112648,"_2810":112649},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3322":67633,"_29016":67619,"_5":29336,"_20141":112651,"_26412":112652,"_2810":112653},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3322":67634,"_29016":67619,"_5":29336,"_20141":112655,"_26412":112656,"_2810":112657},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3322":67635,"_29016":67619,"_5":29336,"_20141":112659,"_26412":112660,"_2810":112661},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3322":67636,"_29016":67619,"_5":29336,"_20141":112663,"_26412":112664,"_2810":111790},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3322":67637,"_29016":67619,"_5":29336,"_20141":112666,"_26412":112667,"_2810":112668},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3322":67638,"_29016":67619,"_5":29336,"_20141":112670,"_26412":112671,"_2810":112672},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3322":67639,"_29016":67619,"_5":29336,"_20141":112674,"_26412":112675,"_2810":112676},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3322":67640,"_29016":67619,"_5":29336,"_20141":112678,"_26412":112679,"_2810":112680},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3322":67641,"_29016":67619,"_5":29336,"_20141":112682,"_26412":112683,"_2810":112684},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3322":67642,"_29016":67619,"_5":29336,"_20141":112686,"_26412":112687,"_2810":112688},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3322":67643,"_29016":67619,"_5":29336,"_20141":112690,"_26412":112691,"_2810":112692},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3322":67644,"_29016":67619,"_5":29336,"_20141":112694,"_26412":112695,"_2810":112696},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3322":67645,"_29016":67619,"_5":29336,"_20141":112698,"_26412":112699,"_2810":112700},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3322":67646,"_29016":67619,"_5":29336,"_20141":112702,"_26412":112703,"_2810":112704},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3322":67647,"_29016":67619,"_5":29336,"_20141":112706,"_26412":112707,"_2810":112708},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3322":67648,"_29016":67619,"_5":29336,"_20141":112710,"_26412":112711,"_2810":112712},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3322":67649,"_29016":67619,"_5":29336,"_20141":112714,"_26412":112715,"_2810":112716},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3322":67650,"_29016":67619,"_5":29336,"_20141":112718,"_26412":112719,"_2810":112720},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3322":67651,"_29016":67619,"_5":29336,"_20141":112722,"_26412":112723,"_2810":112724},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3322":67652,"_29016":67619,"_20141":112726,"_5":13774,"_26412":67619,"_2810":112727},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3322":67653,"_29016":67619,"_20141":112729,"_5":13774,"_26412":67619,"_2810":112730},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3322":67654,"_29016":67619,"_20141":112732,"_5":13774,"_26412":67619,"_2810":112733},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3322":67655,"_29016":67619,"_20141":112735,"_5":13774,"_26412":112604,"_2810":112736},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3322":67656,"_29016":67619,"_20141":112738,"_5":13774,"_26412":112604,"_2810":112739},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3322":67657,"_29016":67619,"_20141":112741,"_5":13774,"_26412":112604,"_2810":112742},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3322":67658,"_29016":67619,"_20141":112744,"_5":13774,"_26412":112604,"_2810":112745},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3322":67659,"_29016":67619,"_20141":112747,"_5":13774,"_26412":112604,"_2810":112748},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3322":67660,"_29016":67619,"_20141":112750,"_5":13774,"_26412":112604,"_2810":112751},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3322":67661,"_29016":67619,"_20141":112753,"_5":13774,"_26412":112608,"_2810":112754},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3322":67662,"_29016":67619,"_20141":112756,"_5":13774,"_26412":112608,"_2810":112757},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3322":67663,"_29016":67619,"_20141":112759,"_5":13774,"_26412":112612,"_2810":112760},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3322":67664,"_29016":67619,"_20141":112762,"_5":13774,"_26412":112612,"_2810":112763},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3322":67665,"_29016":67619,"_20141":112765,"_5":13774,"_26412":112612,"_2810":112766},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3322":67666,"_29016":67619,"_20141":112768,"_5":13774,"_26412":112612,"_2810":112769},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3322":67667,"_29016":67619,"_20141":112771,"_5":13774,"_26412":112612,"_2810":112772},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3322":67668,"_29016":67619,"_20141":112774,"_5":13774,"_26412":112612,"_2810":112775},[],"Carga por separado las políticas concedidas a cada principal.",{"_3322":67669,"_29016":67619,"_20141":112777,"_5":13774,"_26412":112612,"_2810":112778},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3322":67670,"_29016":67619,"_20141":112780,"_5":13774,"_26412":112612,"_2810":112781},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3322":67671,"_29016":67619,"_20141":112783,"_5":13774,"_26412":112612,"_2810":112784},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3322":67672,"_29016":67619,"_20141":112786,"_5":13774,"_26412":112612,"_2810":112787},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3322":67673,"_29016":67619,"_20141":112789,"_5":13774,"_26412":112612,"_2810":112790},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3322":67674,"_29016":67619,"_20141":112792,"_5":13774,"_26412":112612,"_2810":112793},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3322":67675,"_29016":67619,"_20141":112795,"_5":13774,"_26412":112616,"_2810":112796},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3322":67676,"_29016":67619,"_20141":112798,"_5":13774,"_26412":112616,"_2810":112799},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3322":67677,"_29016":67619,"_20141":112801,"_5":13774,"_26412":112616,"_2810":112802},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3322":67678,"_29016":67619,"_20141":112804,"_5":13774,"_26412":112616,"_2810":112805},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3322":67679,"_29016":67619,"_20141":112807,"_5":13774,"_26412":112616,"_2810":112808},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3322":67680,"_29016":67619,"_20141":112810,"_5":13774,"_26412":112616,"_2810":112811},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3322":67681,"_29016":67619,"_20141":112813,"_5":13774,"_26412":112616,"_2810":112814},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3322":67682,"_29016":67619,"_20141":112816,"_5":13774,"_26412":112616,"_2810":112817},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3322":67683,"_29016":67619,"_20141":112819,"_5":13774,"_26412":112620,"_2810":112820},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3322":67684,"_29016":67619,"_20141":112822,"_5":13774,"_26412":112620,"_2810":112823},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3322":67685,"_29016":67619,"_20141":112825,"_5":13774,"_26412":112620,"_2810":112826},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3322":67686,"_29016":67619,"_20141":112828,"_5":13774,"_26412":112620,"_2810":112829},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3322":67687,"_29016":67619,"_20141":112831,"_5":13774,"_26412":112620,"_2810":112832},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3322":67688,"_29016":67619,"_20141":112834,"_5":13774,"_26412":112620,"_2810":112835},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3322":67689,"_29016":67619,"_20141":112837,"_5":13774,"_26412":112620,"_2810":112838},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3322":67690,"_29016":67619,"_20141":112840,"_5":13774,"_26412":112620,"_2810":112841},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3322":67691,"_29016":67619,"_20141":112843,"_5":13774,"_26412":112620,"_2810":112844},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3322":67692,"_29016":67619,"_20141":112846,"_5":13774,"_26412":112620,"_2810":112847},[],"Las acciones se dividen en dos grupos:",{"_3322":67693,"_29016":67619,"_20141":112849,"_5":13774,"_26412":112620,"_2810":112850},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3322":67694,"_29016":67619,"_20141":112852,"_5":13774,"_26412":112620,"_2810":112853},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3322":67695,"_29016":67619,"_20141":112855,"_5":13774,"_26412":112620,"_2810":112856},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3322":67696,"_29016":67619,"_20141":112858,"_5":13774,"_26412":112624,"_2810":112859},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3322":67697,"_29016":67619,"_20141":112861,"_5":13774,"_26412":112624,"_2810":112862},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3322":67698,"_29016":67619,"_20141":112864,"_5":13774,"_26412":112624,"_2810":112865},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3322":67699,"_29016":67619,"_20141":112867,"_5":13774,"_26412":112628,"_2810":112868},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3322":67700,"_29016":67619,"_20141":112870,"_5":13774,"_26412":112628,"_2810":112871},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3322":67701,"_29016":67619,"_20141":112873,"_5":13774,"_26412":112628,"_2810":112874},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3322":67702,"_29016":67619,"_20141":112876,"_5":13774,"_26412":112628,"_2810":112877},[],"Los operadores implementados son:",{"_3322":67703,"_29016":67619,"_20141":112879,"_5":13774,"_26412":112628,"_2810":112880},[],"`equals`, para igualdad exacta;",{"_3322":67704,"_29016":67619,"_20141":112882,"_5":13774,"_26412":112628,"_2810":112883},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3322":67705,"_29016":67619,"_20141":112885,"_5":13774,"_26412":112628,"_2810":112886},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3322":67706,"_29016":67619,"_20141":112888,"_5":13774,"_26412":112628,"_2810":112889},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3322":67707,"_29016":67619,"_20141":112891,"_5":13774,"_26412":112632,"_2810":112892},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3322":67708,"_29016":67619,"_20141":112894,"_5":13774,"_26412":112632,"_2810":112895},[],"Los modos disponibles son:",{"_3322":67709,"_29016":67619,"_20141":112897,"_5":13774,"_26412":112632,"_2810":112898},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3322":67710,"_29016":67619,"_20141":112900,"_5":13774,"_26412":112632,"_2810":112901},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3322":67711,"_29016":67619,"_20141":112903,"_5":13774,"_26412":112632,"_2810":112904},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3322":67712,"_29016":67619,"_20141":112906,"_5":13774,"_26412":112632,"_2810":112907},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3322":67713,"_29016":67619,"_20141":112909,"_5":13774,"_26412":112632,"_2810":112910},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3322":67714,"_29016":67619,"_20141":112912,"_5":13774,"_26412":112632,"_2810":112913},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3322":67715,"_29016":67619,"_20141":112915,"_5":13774,"_26412":112636,"_2810":112916},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3322":67716,"_29016":67619,"_20141":112918,"_5":13774,"_26412":112636,"_2810":112919},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3322":67717,"_29016":67619,"_20141":112921,"_5":13774,"_26412":112636,"_2810":112922},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3322":67718,"_29016":67619,"_20141":112924,"_5":13774,"_26412":112636,"_2810":112925},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3322":67719,"_29016":67619,"_20141":112927,"_5":13774,"_26412":112644,"_2810":112928},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3322":67720,"_29016":67619,"_20141":112930,"_5":13774,"_26412":112644,"_2810":112931},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3322":67721,"_29016":67619,"_20141":112933,"_5":13774,"_26412":112648,"_2810":112934},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3322":67722,"_29016":67619,"_20141":112936,"_5":13774,"_26412":112648,"_2810":112937},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3322":67723,"_29016":67619,"_20141":112939,"_5":13774,"_26412":112652,"_2810":112940},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3322":67724,"_29016":67619,"_20141":112942,"_5":13774,"_26412":112652,"_2810":112943},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3322":67725,"_29016":67619,"_20141":112945,"_5":13774,"_26412":112652,"_2810":112946},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3322":67726,"_29016":67619,"_20141":112948,"_5":13774,"_26412":112656,"_2810":112949},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3322":67727,"_29016":67619,"_20141":112951,"_5":13774,"_26412":112656,"_2810":112952},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3322":67728,"_29016":67619,"_20141":112954,"_5":13774,"_26412":112656,"_2810":112955},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3322":67729,"_29016":67619,"_20141":112957,"_5":13774,"_26412":112656,"_2810":112958},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3322":67730,"_29016":67619,"_20141":112960,"_5":13774,"_26412":112656,"_2810":112961},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3322":67731,"_29016":67619,"_20141":112963,"_5":13774,"_26412":112656,"_2810":112964},[],"Ten en cuenta que:",{"_3322":67732,"_29016":67619,"_20141":112966,"_5":13774,"_26412":112656,"_2810":112967},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3322":67733,"_29016":67619,"_20141":112969,"_5":13774,"_26412":112656,"_2810":112970},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3322":67734,"_29016":67619,"_20141":112972,"_5":13774,"_26412":112656,"_2810":112973},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3322":67735,"_29016":67619,"_20141":112975,"_5":13774,"_26412":112660,"_2810":112976},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3322":67736,"_29016":67619,"_20141":112978,"_5":13774,"_26412":112660,"_2810":112979},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3322":67737,"_29016":67619,"_20141":112981,"_5":13774,"_26412":112660,"_2810":112982},[],"acceso completo y de solo lectura a KMS;",{"_3322":67738,"_29016":67619,"_20141":112984,"_5":13774,"_26412":112660,"_2810":112985},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3322":67739,"_29016":67619,"_20141":112987,"_5":13774,"_26412":112660,"_2810":112988},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3322":67740,"_29016":67619,"_20141":112990,"_5":13774,"_26412":112660,"_2810":112991},[],"acceso a la interfaz;",{"_3322":67741,"_29016":67619,"_20141":112993,"_5":13774,"_26412":112660,"_2810":112994},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3322":67742,"_29016":67619,"_20141":112996,"_5":13774,"_26412":112660,"_2810":112997},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3322":67743,"_29016":67619,"_20141":112999,"_5":13774,"_26412":112660,"_2810":113000},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3322":67744,"_29016":67619,"_20141":113002,"_5":13774,"_26412":112664,"_2810":113003},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3322":67745,"_29016":67619,"_20141":113005,"_5":13774,"_26412":112664,"_2810":113006},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3322":67746,"_29016":67619,"_20141":113008,"_5":13774,"_26412":112664,"_2810":113009},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3322":67747,"_29016":67619,"_20141":113011,"_5":13774,"_26412":112667,"_2810":113012},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3322":67748,"_29016":67619,"_20141":113014,"_5":13774,"_26412":112671,"_2810":113015},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3322":67749,"_29016":67619,"_20141":113017,"_5":13774,"_26412":112671,"_2810":113018},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3322":67750,"_29016":67619,"_20141":113020,"_5":13774,"_26412":112675,"_2810":113021},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3322":67751,"_29016":67619,"_20141":113023,"_5":13774,"_26412":112679,"_2810":113024},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3322":67752,"_29016":67619,"_20141":113026,"_5":13774,"_26412":112683,"_2810":113027},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3322":67753,"_29016":67619,"_20141":113029,"_5":13774,"_26412":112687,"_2810":113030},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3322":67754,"_29016":67619,"_20141":113032,"_5":13774,"_26412":112687,"_2810":113033},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3322":67755,"_29016":67619,"_20141":113035,"_5":13774,"_26412":112691,"_2810":113036},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3322":67756,"_29016":67619,"_20141":113038,"_5":13774,"_26412":112691,"_2810":113039},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3322":67757,"_29016":67619,"_20141":113041,"_5":13774,"_26412":112691,"_2810":113042},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3322":67758,"_29016":67619,"_20141":113044,"_5":13774,"_26412":112691,"_2810":113045},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3322":67759,"_29016":67619,"_20141":113047,"_5":13774,"_26412":112691,"_2810":113048},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3322":67760,"_29016":67619,"_20141":113050,"_5":13774,"_26412":112691,"_2810":113051},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3322":67761,"_29016":67619,"_20141":113053,"_5":13774,"_26412":112691,"_2810":113054},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3322":67762,"_29016":67619,"_20141":113056,"_5":13774,"_26412":112691,"_2810":113057},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3322":67763,"_29016":67619,"_20141":113059,"_5":13774,"_26412":112695,"_2810":113060},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3322":67764,"_29016":67619,"_20141":113062,"_5":13774,"_26412":112695,"_2810":113063},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3322":67765,"_29016":67619,"_20141":113065,"_5":13774,"_26412":112695,"_2810":113066},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3322":67766,"_29016":67619,"_20141":113068,"_5":13774,"_26412":112699,"_2810":113069},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3322":67767,"_29016":67619,"_20141":113071,"_5":13774,"_26412":112699,"_2810":113072},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3322":67768,"_29016":67619,"_20141":113074,"_5":13774,"_26412":112699,"_2810":113075},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3322":67769,"_29016":67619,"_20141":113077,"_5":13774,"_26412":112699,"_2810":113078},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3322":67770,"_29016":67619,"_20141":113080,"_5":13774,"_26412":112699,"_2810":113081},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3322":67771,"_29016":67619,"_20141":113083,"_5":13774,"_26412":112699,"_2810":113084},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3322":67772,"_29016":67619,"_20141":113086,"_5":13774,"_26412":112699,"_2810":113087},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3322":67773,"_29016":67619,"_20141":113089,"_5":13774,"_26412":112699,"_2810":113090},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3322":67774,"_29016":67619,"_20141":113092,"_5":13774,"_26412":112707,"_2810":113093},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3322":67775,"_29016":67619,"_20141":113095,"_5":13774,"_26412":112711,"_2810":113096},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3322":67776,"_29016":67619,"_20141":113098,"_5":13774,"_26412":112711,"_2810":113099},[],"que exista un principal activo del tipo correcto;",{"_3322":67777,"_29016":67619,"_20141":113101,"_5":13774,"_26412":112711,"_2810":113102},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3322":67778,"_29016":67619,"_20141":113104,"_5":13774,"_26412":112711,"_2810":113105},[],"que todas las condiciones del principal se cumplan;",{"_3322":67779,"_29016":67619,"_20141":113107,"_5":13774,"_26412":112711,"_2810":113108},[],"que el principal tenga concedida la política esperada;",{"_3322":67780,"_29016":67619,"_20141":113110,"_5":13774,"_26412":112711,"_2810":113111},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3322":67781,"_29016":67619,"_20141":113113,"_5":13774,"_26412":112711,"_2810":113114},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3322":67782,"_29016":67619,"_20141":113116,"_5":13774,"_26412":112711,"_2810":113117},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con la instrumentación OpenTelemetry habilitada, cada decisión genera además un span —`engine.CheckHTTP` en el camino del Gateway— cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente, de forma que puedas correlacionar la denegación con la traza del Gateway.",{"_3322":67783,"_29016":67619,"_20141":113119,"_5":13774,"_26412":112715,"_2810":113120},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3322":67784,"_29016":67619,"_20141":113122,"_5":13774,"_26412":112719,"_2810":113123},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3322":67785,"_29016":67619,"_20141":113125,"_5":13774,"_26412":112723,"_2810":113126},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3322":67786,"_29016":67619,"_20141":113128,"_5":13774,"_26412":112723,"_2810":113129},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3322":67787,"_29016":67787,"_5":14132,"_2810":113131,"_29339":113132,"_20141":113133,"_26412":67787},"Alertas y suscripciones",[47234,112596,112597],[],{"_3322":67788,"_29016":67787,"_20141":113135,"_5":13774,"_26412":67787,"_2810":113136},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3322":67789,"_29016":67787,"_5":29336,"_20141":113138,"_26412":113139,"_2810":113140},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3322":67790,"_29016":67787,"_5":29336,"_20141":113142,"_26412":113143,"_2810":113144},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3322":67791,"_29016":67787,"_5":29336,"_20141":113146,"_26412":113147,"_2810":113148},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3322":67792,"_29016":67787,"_5":29336,"_20141":113150,"_26412":113151,"_2810":113152},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3322":67793,"_29016":67787,"_5":29336,"_20141":113154,"_26412":113155,"_2810":113156},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3322":67794,"_29016":67787,"_5":29336,"_20141":113158,"_26412":113159,"_2810":113160},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3322":67795,"_29016":67787,"_5":29336,"_20141":113162,"_26412":113163,"_2810":113164},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3322":67796,"_29016":67787,"_5":29336,"_20141":113166,"_26412":113167,"_2810":113168},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3322":67797,"_29016":67787,"_5":29336,"_20141":113170,"_26412":113171,"_2810":113172},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3322":67798,"_29016":67787,"_5":29336,"_20141":113174,"_26412":113175,"_2810":113176},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3322":67799,"_29016":67787,"_5":29336,"_20141":113178,"_26412":113179,"_2810":113180},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3322":67800,"_29016":67787,"_20141":113182,"_5":13774,"_26412":67787,"_2810":113183},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3322":67801,"_29016":67787,"_20141":113185,"_5":13774,"_26412":113139,"_2810":113186},[],"Un servicio publica un evento de dominio.",{"_3322":67802,"_29016":67787,"_20141":113188,"_5":13774,"_26412":113139,"_2810":113189},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3322":67803,"_29016":67787,"_20141":113191,"_5":13774,"_26412":113139,"_2810":113192},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3322":67804,"_29016":67787,"_20141":113194,"_5":13774,"_26412":113139,"_2810":113195},[],"Lamassu entrega el evento al canal configurado.",{"_3322":67805,"_29016":67787,"_20141":113197,"_5":13774,"_26412":113139,"_2810":113198},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3322":67806,"_29016":67787,"_20141":113200,"_5":13774,"_26412":113143,"_2810":113201},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3322":67807,"_29016":67787,"_20141":113203,"_5":13774,"_26412":113143,"_2810":113204},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3322":67808,"_29016":67787,"_20141":113206,"_5":13774,"_26412":113143,"_2810":113207},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3322":67809,"_29016":67787,"_20141":113209,"_5":13774,"_26412":113143,"_2810":113210},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3322":67810,"_29016":67787,"_20141":113212,"_5":13774,"_26412":113143,"_2810":113213},[],"`apikey_options` necesita `header` y `key`.",{"_3322":67811,"_29016":67787,"_20141":113215,"_5":13774,"_26412":113143,"_2810":113216},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3322":67812,"_29016":67787,"_20141":113218,"_5":13774,"_26412":113143,"_2810":113219},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3322":67813,"_29016":67787,"_20141":113221,"_5":13774,"_26412":113143,"_2810":113222},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3322":67814,"_29016":67787,"_20141":113224,"_5":13774,"_26412":113151,"_2810":113225},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3322":67815,"_29016":67787,"_20141":113227,"_5":13774,"_26412":113155,"_2810":113228},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3322":67816,"_29016":67787,"_20141":113230,"_5":13774,"_26412":113159,"_2810":113231},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3322":67817,"_29016":67787,"_20141":113233,"_5":13774,"_26412":113159,"_2810":113234},[],"**None** notifica todas las instancias del evento.",{"_3322":67818,"_29016":67787,"_20141":113236,"_5":13774,"_26412":113159,"_2810":113237},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3322":67819,"_29016":67787,"_20141":113239,"_5":13774,"_26412":113159,"_2810":113240},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3322":67820,"_29016":67787,"_20141":113242,"_5":13774,"_26412":113159,"_2810":113243},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3322":67821,"_29016":67787,"_20141":113245,"_5":13774,"_26412":113159,"_2810":113246},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3322":67822,"_29016":67787,"_20141":113248,"_5":13774,"_26412":113163,"_2810":113249},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3322":67823,"_29016":67787,"_20141":113251,"_5":13774,"_26412":113167,"_2810":113252},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3322":67824,"_29016":67787,"_20141":113254,"_5":13774,"_26412":113167,"_2810":113255},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3322":67825,"_29016":67787,"_20141":113257,"_5":13774,"_26412":113167,"_2810":113258},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3322":67826,"_29016":67787,"_20141":113260,"_5":13774,"_26412":113167,"_2810":113261},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3322":67827,"_29016":67787,"_20141":113263,"_5":13774,"_26412":113167,"_2810":113264},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3322":67828,"_29016":67787,"_20141":113266,"_5":13774,"_26412":113167,"_2810":113267},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3322":67829,"_29016":67787,"_20141":113269,"_5":13774,"_26412":113167,"_2810":113270},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3322":67830,"_29016":67787,"_20141":113272,"_5":13774,"_26412":113167,"_2810":113273},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3322":67831,"_29016":67787,"_20141":113275,"_5":13774,"_26412":113171,"_2810":113276},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3322":67832,"_29016":67787,"_20141":113278,"_5":13774,"_26412":113171,"_2810":113279},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3322":67833,"_29016":67787,"_20141":113281,"_5":13774,"_26412":113171,"_2810":113282},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3322":67834,"_29016":67787,"_20141":113284,"_5":13774,"_26412":113171,"_2810":113285},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3322":67835,"_29016":67787,"_20141":113287,"_5":13774,"_26412":113171,"_2810":113288},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3322":67836,"_29016":67787,"_20141":113290,"_5":13774,"_26412":113171,"_2810":113291},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3322":67837,"_29016":67787,"_20141":113293,"_5":13774,"_26412":113171,"_2810":113294},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3322":67838,"_29016":67787,"_20141":113296,"_5":13774,"_26412":113171,"_2810":113297},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3322":67839,"_29016":67787,"_20141":113299,"_5":13774,"_26412":113175,"_2810":113300},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3322":67840,"_29016":67787,"_20141":113302,"_5":13774,"_26412":113175,"_2810":113303},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3322":67841,"_29016":67787,"_20141":113305,"_5":13774,"_26412":113179,"_2810":113306},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3322":67842,"_29016":67787,"_20141":113308,"_5":13774,"_26412":113179,"_2810":113309},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3322":67843,"_29016":67787,"_20141":113311,"_5":13774,"_26412":113179,"_2810":113312},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3322":67844,"_29016":67787,"_20141":113314,"_5":13774,"_26412":113179,"_2810":113315},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3322":67845,"_29016":67787,"_20141":113317,"_5":13774,"_26412":113179,"_2810":113318},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3322":67846,"_29016":67787,"_20141":113320,"_5":13774,"_26412":113179,"_2810":113321},[],"**Validación:** `va.role.crl.create`.",{"_3322":67847,"_29016":67787,"_20141":113323,"_5":13774,"_26412":113179,"_2810":113324},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3322":67848,"_29016":67787,"_20141":113326,"_5":13774,"_26412":113179,"_2810":113327},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3322":67849,"_29016":67849,"_5":14132,"_2810":113329,"_29339":113330,"_20141":113331,"_26412":67849},"Registros de auditoría",[47234,112596,112597],[],{"_3322":67850,"_29016":67849,"_20141":113333,"_5":13774,"_26412":67849,"_2810":113334},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3322":67851,"_29016":67849,"_5":29336,"_20141":113336,"_26412":113337,"_2810":113338},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3322":67852,"_29016":67849,"_5":29336,"_20141":113340,"_26412":113341,"_2810":113342},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3322":67853,"_29016":67849,"_5":29336,"_20141":113344,"_26412":113345,"_2810":113346},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3322":67854,"_29016":67849,"_5":29336,"_20141":113348,"_26412":113349,"_2810":113350},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3322":67855,"_29016":67849,"_5":29336,"_20141":113352,"_26412":113353,"_2810":113354},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3322":67856,"_29016":67849,"_5":29336,"_20141":113356,"_26412":113357,"_2810":113358},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3322":67857,"_29016":67849,"_5":29336,"_20141":113360,"_26412":113361,"_2810":113362},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3322":67858,"_29016":67849,"_5":29336,"_20141":113364,"_26412":113365,"_2810":113366},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3322":67859,"_29016":67849,"_5":29336,"_20141":113368,"_26412":113369,"_2810":113370},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3322":67860,"_29016":67849,"_5":29336,"_20141":113372,"_26412":113373,"_2810":113374},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3322":67861,"_29016":67849,"_5":29336,"_20141":113376,"_26412":113377,"_2810":113378},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3322":67862,"_29016":67849,"_20141":113380,"_5":13774,"_26412":67849,"_2810":113381},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3322":67863,"_29016":67849,"_20141":113383,"_5":13774,"_26412":113337,"_2810":113384},[],"El cuerpo de auditoría incluye:",{"_3322":67864,"_29016":67849,"_20141":113386,"_5":13774,"_26412":113337,"_2810":113387},[],"input: datos recibidos por la operación;",{"_3322":67865,"_29016":67849,"_20141":113389,"_5":13774,"_26412":113337,"_2810":113390},[],"has\\_error: indica si el servicio devolvió un error;",{"_3322":67866,"_29016":67849,"_20141":113392,"_5":13774,"_26412":113337,"_2810":113393},[],"output: resultado producido o mensaje de error;",{"_3322":67867,"_29016":67849,"_20141":113395,"_5":13774,"_26412":113337,"_2810":113396},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3322":67868,"_29016":67849,"_20141":113398,"_5":13774,"_26412":113337,"_2810":113399},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3322":67869,"_29016":67849,"_20141":113401,"_5":13774,"_26412":113337,"_2810":113402},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3322":67870,"_29016":67849,"_20141":113404,"_5":13774,"_26412":113341,"_2810":113405},[],"El backend aplica auditoría a mutaciones de:",{"_3322":67871,"_29016":67849,"_20141":113407,"_5":13774,"_26412":113341,"_2810":113408},[],"autoridades, certificados y perfiles de emisión;",{"_3322":67872,"_29016":67849,"_20141":113410,"_5":13774,"_26412":113341,"_2810":113411},[],"claves y motores KMS;",{"_3322":67873,"_29016":67849,"_20141":113413,"_5":13774,"_26412":113341,"_2810":113414},[],"dispositivos e identidades;",{"_3322":67874,"_29016":67849,"_20141":113416,"_5":13774,"_26412":113341,"_2810":113417},[],"DMS y operaciones de enrolamiento;",{"_3322":67875,"_29016":67849,"_20141":113419,"_5":13774,"_26412":113341,"_2810":113420},[],"funciones de validación y CRL;",{"_3322":67876,"_29016":67849,"_20141":113422,"_5":13774,"_26412":113341,"_2810":113423},[],"principales, políticas y concesiones de autorización.",{"_3322":67877,"_29016":67849,"_20141":113425,"_5":13774,"_26412":113341,"_2810":113426},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3322":67878,"_29016":67849,"_20141":113428,"_5":13774,"_26412":113345,"_2810":113429},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3322":67879,"_29016":67849,"_20141":113431,"_5":13774,"_26412":113345,"_2810":113432},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3322":67880,"_29016":67849,"_20141":113434,"_5":13774,"_26412":113345,"_2810":113435},[],"Diseña el consumidor para:",{"_3322":67881,"_29016":67849,"_20141":113437,"_5":13774,"_26412":113345,"_2810":113438},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3322":67882,"_29016":67849,"_20141":113440,"_5":13774,"_26412":113345,"_2810":113441},[],"conservar el CloudEvent completo sin modificar;",{"_3322":67883,"_29016":67849,"_20141":113443,"_5":13774,"_26412":113345,"_2810":113444},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3322":67884,"_29016":67849,"_20141":113446,"_5":13774,"_26412":113345,"_2810":113447},[],"cifrar en tránsito y en reposo;",{"_3322":67885,"_29016":67849,"_20141":113449,"_5":13774,"_26412":113345,"_2810":113450},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3322":67886,"_29016":67849,"_20141":113452,"_5":13774,"_26412":113345,"_2810":113453},[],"aplicar una política explícita de retención y legal hold;",{"_3322":67887,"_29016":67849,"_20141":113455,"_5":13774,"_26412":113345,"_2810":113456},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3322":67888,"_29016":67849,"_20141":113458,"_5":13774,"_26412":113349,"_2810":113459},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3322":67889,"_29016":67849,"_20141":113461,"_5":13774,"_26412":113349,"_2810":113462},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3322":67890,"_29016":67849,"_20141":113464,"_5":13774,"_26412":113357,"_2810":113465},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3322":67891,"_29016":67849,"_20141":113467,"_5":13774,"_26412":113361,"_2810":113468},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3322":67892,"_29016":67849,"_20141":113470,"_5":13774,"_26412":113365,"_2810":113471},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3322":67893,"_29016":67849,"_20141":113473,"_5":13774,"_26412":113369,"_2810":113474},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3322":67894,"_29016":67849,"_20141":113476,"_5":13774,"_26412":113373,"_2810":113477},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3322":67895,"_29016":67849,"_20141":113479,"_5":13774,"_26412":113377,"_2810":113480},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3322":67896,"_29016":67849,"_20141":113482,"_5":13774,"_26412":113377,"_2810":113483},[],"aparece un evento de auditoría correcto;",{"_3322":67897,"_29016":67849,"_20141":113485,"_5":13774,"_26412":113377,"_2810":113486},[],"el principal coincide con la identidad utilizada;",{"_3322":67898,"_29016":67849,"_20141":113488,"_5":13774,"_26412":113377,"_2810":113489},[],"el consumidor lo persiste una sola vez;",{"_3322":67899,"_29016":67849,"_20141":113491,"_5":13774,"_26412":113377,"_2810":113492},[],"puede recuperarse por recurso, actor y periodo;",{"_3322":67900,"_29016":67849,"_20141":113494,"_5":13774,"_26412":113377,"_2810":113495},[],"una interrupción del consumidor produce una alerta.",{"_3322":67901,"_29016":67849,"_20141":113497,"_5":13774,"_26412":113377,"_2810":113498},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3322":67902,"_29016":67902,"_5":14132,"_2810":113500,"_29339":113501,"_20141":113502,"_26412":67902},"Arquitectura de la plataforma",[47234,112596],[],{"_3322":67903,"_29016":67902,"_20141":113504,"_5":13774,"_26412":67902,"_2810":113505},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3322":67904,"_29016":67902,"_5":29336,"_20141":113507,"_26412":113508,"_2810":113509},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3322":67905,"_29016":67902,"_5":29336,"_20141":113511,"_26412":113512,"_2810":113513},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3322":67906,"_29016":67902,"_5":29336,"_20141":113515,"_26412":113516,"_2810":113517},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3322":67907,"_29016":67902,"_5":29336,"_20141":113519,"_26412":113520,"_2810":113521},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3322":67908,"_29016":67902,"_5":29336,"_20141":113523,"_26412":113524,"_2810":113525},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3322":67909,"_29016":67902,"_20141":113527,"_5":13774,"_26412":67902,"_2810":113528},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3322":67910,"_29016":67902,"_20141":113530,"_5":13774,"_26412":67902,"_2810":113531},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3322":67911,"_29016":67902,"_20141":113533,"_5":13774,"_26412":113508,"_2810":113534},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3322":67912,"_29016":67902,"_20141":113536,"_5":13774,"_26412":113512,"_2810":113537},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3322":67913,"_29016":67902,"_20141":113539,"_5":13774,"_26412":113516,"_2810":113540},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3322":67914,"_29016":67902,"_20141":113542,"_5":13774,"_26412":113520,"_2810":113543},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3322":67915,"_29016":67902,"_20141":113545,"_5":13774,"_26412":113524,"_2810":113546},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3322":67916,"_29016":67916,"_5":14132,"_2810":113548,"_29339":113549,"_20141":113550,"_26412":67916},"Cómo funciona Lamassu",[47234,112596],[],{"_3322":67917,"_29016":67916,"_20141":113552,"_5":13774,"_26412":67916,"_2810":113553},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3322":67918,"_29016":67916,"_5":29336,"_20141":113555,"_26412":113556,"_2810":113557},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3322":67919,"_29016":67916,"_5":29336,"_20141":113559,"_26412":113560,"_2810":113561},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3322":67920,"_29016":67916,"_20141":113563,"_5":13774,"_26412":67916,"_2810":113564},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3322":67921,"_29016":67916,"_20141":113566,"_5":13774,"_26412":113556,"_2810":113567},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3322":67922,"_29016":67916,"_20141":113569,"_5":13774,"_26412":113556,"_2810":113570},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3322":67923,"_29016":67916,"_20141":113572,"_5":13774,"_26412":113556,"_2810":113573},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3322":67924,"_29016":67916,"_20141":113575,"_5":13774,"_26412":113556,"_2810":113576},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3322":67925,"_29016":67916,"_20141":113578,"_5":13774,"_26412":113556,"_2810":113579},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3322":67926,"_29016":67916,"_20141":113581,"_5":13774,"_26412":113560,"_2810":113582},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3322":67927,"_29016":67916,"_20141":113584,"_5":13774,"_26412":113560,"_2810":113585},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3322":67928,"_29016":67916,"_20141":113587,"_5":13774,"_26412":113560,"_2810":113588},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3322":67929,"_29016":67916,"_20141":113590,"_5":13774,"_26412":113560,"_2810":113591},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3322":67930,"_29016":67916,"_20141":113593,"_5":13774,"_26412":113560,"_2810":113594},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3322":67931,"_29016":67916,"_20141":113596,"_5":13774,"_26412":113560,"_2810":113597},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3322":67932,"_29016":67916,"_20141":113599,"_5":13774,"_26412":113560,"_2810":113600},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3322":67933,"_29016":67933,"_5":14132,"_2810":113602,"_29339":113603,"_20141":113604,"_26412":67933},"Dispositivos e identidades",[47234,112596,49691,113602],[],{"_3322":67934,"_29016":67933,"_20141":113606,"_5":13774,"_26412":67933,"_2810":113607},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3322":67935,"_29016":67933,"_5":29336,"_20141":113609,"_26412":113610,"_2810":113611},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3322":67936,"_29016":67933,"_5":29336,"_20141":113613,"_26412":113614,"_2810":113615},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3322":67937,"_29016":67933,"_5":29336,"_20141":113617,"_26412":113618,"_2810":113619},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3322":67938,"_29016":67933,"_5":29336,"_20141":113621,"_26412":113622,"_2810":113623},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3322":67939,"_29016":67933,"_5":29336,"_20141":113625,"_26412":113626,"_2810":113627},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3322":67940,"_29016":67933,"_5":29336,"_20141":113629,"_26412":113630,"_2810":113631},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3322":67941,"_29016":67933,"_5":29336,"_20141":113633,"_26412":113634,"_2810":113635},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3322":67942,"_29016":67933,"_5":29336,"_20141":113637,"_26412":113638,"_2810":113639},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3322":67943,"_29016":67933,"_5":29336,"_20141":113641,"_26412":113642,"_2810":113643},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3322":67944,"_29016":67933,"_5":29336,"_20141":113645,"_26412":113646,"_2810":113647},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3322":67945,"_29016":67933,"_5":29336,"_20141":113649,"_26412":113650,"_2810":113651},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3322":67946,"_29016":67933,"_20141":113653,"_5":13774,"_26412":67933,"_2810":113654},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3322":67947,"_29016":67933,"_20141":113656,"_5":13774,"_26412":67933,"_2810":113657},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3322":67948,"_29016":67933,"_20141":113659,"_5":13774,"_26412":113610,"_2810":113660},[],"Vista operativa",{"_3322":67949,"_29016":67933,"_20141":113662,"_5":13774,"_26412":113610,"_2810":113663},[],"Interpretación",{"_3322":67950,"_29016":67933,"_20141":113665,"_5":13774,"_26412":113610,"_2810":49754},[],{"_3322":67951,"_29016":67933,"_20141":113667,"_5":13774,"_26412":113610,"_2810":113668},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3322":67952,"_29016":67933,"_20141":113670,"_5":13774,"_26412":113610,"_2810":49760},[],{"_3322":67953,"_29016":67933,"_20141":113672,"_5":13774,"_26412":113610,"_2810":113673},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3322":67954,"_29016":67933,"_20141":113675,"_5":13774,"_26412":113610,"_2810":49766},[],{"_3322":67955,"_29016":67933,"_20141":113677,"_5":13774,"_26412":113610,"_2810":113678},[],"La identidad está en la ventana operativa de renovación.",{"_3322":67956,"_29016":67933,"_20141":113680,"_5":13774,"_26412":113610,"_2810":49772},[],{"_3322":67957,"_29016":67933,"_20141":113682,"_5":13774,"_26412":113610,"_2810":113683},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3322":67958,"_29016":67933,"_20141":113685,"_5":13774,"_26412":113610,"_2810":49778},[],{"_3322":67959,"_29016":67933,"_20141":113687,"_5":13774,"_26412":113610,"_2810":113688},[],"La identidad ha vencido.",{"_3322":67960,"_29016":67933,"_20141":113690,"_5":13774,"_26412":113610,"_2810":49784},[],{"_3322":67961,"_29016":67933,"_20141":113692,"_5":13774,"_26412":113610,"_2810":113693},[],"La identidad está marcada como revocada.",{"_3322":67962,"_29016":67933,"_20141":113695,"_5":13774,"_26412":113610,"_2810":49790},[],{"_3322":67963,"_29016":67933,"_20141":113697,"_5":13774,"_26412":113610,"_2810":113698},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3322":67964,"_29016":67933,"_20141":113700,"_5":13774,"_26412":113610,"_2810":113701},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3322":67965,"_29016":67933,"_20141":113703,"_5":13774,"_26412":113614,"_2810":113704},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3322":67966,"_29016":67933,"_20141":113706,"_5":13774,"_26412":113614,"_2810":113707},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3322":67967,"_29016":67933,"_20141":113709,"_5":13774,"_26412":113614,"_2810":113710},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3322":67968,"_29016":67933,"_20141":113712,"_5":13774,"_26412":113614,"_2810":113713},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3322":67969,"_29016":67933,"_20141":113715,"_5":13774,"_26412":113618,"_2810":113716},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3322":67970,"_29016":67933,"_20141":113718,"_5":13774,"_26412":113622,"_2810":113719},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3322":67971,"_29016":67933,"_20141":113721,"_5":13774,"_26412":113626,"_2810":113722},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3322":67972,"_29016":67933,"_20141":113724,"_5":13774,"_26412":113630,"_2810":113725},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3322":67973,"_29016":67933,"_20141":113727,"_5":13774,"_26412":113634,"_2810":113728},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3322":67974,"_29016":67933,"_20141":113730,"_5":13774,"_26412":113634,"_2810":113731},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3322":67975,"_29016":67933,"_20141":113733,"_5":13774,"_26412":113638,"_2810":113734},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3322":67976,"_29016":67933,"_20141":113736,"_5":13774,"_26412":113638,"_2810":113737},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3322":67977,"_29016":67933,"_20141":113739,"_5":13774,"_26412":113638,"_2810":113740},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3322":67978,"_29016":67933,"_20141":113742,"_5":13774,"_26412":113638,"_2810":113743},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3322":67979,"_29016":67933,"_20141":113745,"_5":13774,"_26412":113638,"_2810":113746},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3322":67980,"_29016":67933,"_20141":113748,"_5":13774,"_26412":113638,"_2810":113749},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3322":67981,"_29016":67933,"_20141":113751,"_5":13774,"_26412":113642,"_2810":113752},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3322":67982,"_29016":67933,"_20141":113754,"_5":13774,"_26412":113642,"_2810":113755},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3322":67983,"_29016":67933,"_20141":113757,"_5":13774,"_26412":113646,"_2810":113758},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3322":67984,"_29016":67933,"_20141":113760,"_5":13774,"_26412":113646,"_2810":113761},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3322":67985,"_29016":67933,"_20141":113763,"_5":13774,"_26412":113646,"_2810":113764},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3322":67986,"_29016":67933,"_20141":113766,"_5":13774,"_26412":113646,"_2810":113767},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3322":67987,"_29016":67933,"_20141":113769,"_5":13774,"_26412":113650,"_2810":113770},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3322":67988,"_29016":67933,"_20141":113772,"_5":13774,"_26412":113650,"_2810":113773},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3322":67989,"_29016":67989,"_5":14132,"_2810":113775,"_29339":113776,"_20141":113778,"_26412":67989},"Identidad inicial y autenticación",[47234,112596,49691,113602,113777],"Enrolamiento con PKI",[],{"_3322":67990,"_29016":67989,"_20141":113780,"_5":13774,"_26412":67989,"_2810":113781},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3322":67991,"_29016":67989,"_5":29336,"_20141":113783,"_26412":113784,"_2810":113785},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3322":67992,"_29016":67989,"_5":29336,"_20141":113787,"_26412":113788,"_2810":113789},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3322":67993,"_29016":67989,"_5":29336,"_20141":113791,"_26412":113792,"_2810":113793},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3322":67994,"_29016":67989,"_5":29336,"_20141":113795,"_26412":113796,"_2810":113797},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3322":67995,"_29016":67989,"_5":29336,"_20141":113799,"_26412":113800,"_2810":113801},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3322":67996,"_29016":67989,"_20141":113803,"_5":13774,"_26412":67989,"_2810":113804},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3322":67997,"_29016":67989,"_20141":113806,"_5":13774,"_26412":113784,"_2810":113807},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3322":67998,"_29016":67989,"_20141":113809,"_5":13774,"_26412":113784,"_2810":113810},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3322":67999,"_29016":67989,"_20141":113812,"_5":13774,"_26412":113788,"_2810":113813},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3322":68000,"_29016":67989,"_20141":113815,"_5":13774,"_26412":113788,"_2810":113816},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3322":68001,"_29016":67989,"_20141":113818,"_5":13774,"_26412":113788,"_2810":113819},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3322":68002,"_29016":67989,"_20141":113821,"_5":13774,"_26412":113792,"_2810":113822},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3322":68003,"_29016":67989,"_20141":113824,"_5":13774,"_26412":113792,"_2810":113825},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3322":68004,"_29016":67989,"_20141":113827,"_5":13774,"_26412":113796,"_2810":113828},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3322":68005,"_29016":67989,"_20141":113830,"_5":13774,"_26412":113796,"_2810":113831},[],"Ejemplo de cuerpo:",{"_3322":68006,"_29016":67989,"_20141":113833,"_5":13774,"_26412":113796,"_2810":113834},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3322":68007,"_29016":67989,"_20141":113836,"_5":13774,"_26412":113796,"_2810":113837},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3322":68008,"_29016":67989,"_20141":113839,"_5":13774,"_26412":113796,"_2810":113840},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3322":68009,"_29016":67989,"_20141":113842,"_5":13774,"_26412":113796,"_2810":113843},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3322":68010,"_29016":67989,"_20141":113845,"_5":13774,"_26412":113800,"_2810":113846},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3322":68011,"_29016":67989,"_20141":113848,"_5":13774,"_26412":113800,"_2810":113849},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3322":68012,"_29016":68012,"_5":14132,"_2810":113851,"_29339":113852,"_20141":113853,"_26412":68012},"Configura y opera el DMS",[47234,112596,49691,113602,113777],[],{"_3322":68013,"_29016":68012,"_20141":113855,"_5":13774,"_26412":68012,"_2810":113856},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3322":68014,"_29016":68012,"_5":29336,"_20141":113858,"_26412":113859,"_2810":111193},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3322":68015,"_29016":68012,"_5":29336,"_20141":113861,"_26412":113862,"_2810":113863},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3322":68016,"_29016":68012,"_5":29336,"_20141":113865,"_26412":113866,"_2810":113867},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3322":68017,"_29016":68012,"_5":29336,"_20141":113869,"_26412":113870,"_2810":113871},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3322":68018,"_29016":68012,"_5":29336,"_20141":113873,"_26412":113874,"_2810":113875},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3322":68019,"_29016":68012,"_5":29336,"_20141":113877,"_26412":113878,"_2810":113879},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3322":68020,"_29016":68012,"_5":29336,"_20141":113881,"_26412":113882,"_2810":113883},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3322":68021,"_29016":68012,"_5":29336,"_20141":113885,"_26412":113886,"_2810":113887},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3322":68022,"_29016":68012,"_5":29336,"_20141":113889,"_26412":113890,"_2810":49986},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3322":68023,"_29016":68012,"_5":29336,"_20141":113892,"_26412":113893,"_2810":49990},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3322":68024,"_29016":68012,"_5":29336,"_20141":113895,"_26412":113896,"_2810":113897},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3322":68025,"_29016":68012,"_5":29336,"_20141":113899,"_26412":113900,"_2810":113901},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3322":68026,"_29016":68012,"_5":29336,"_20141":113903,"_26412":113904,"_2810":113905},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3322":68027,"_29016":68012,"_5":29336,"_20141":113907,"_26412":113908,"_2810":113909},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3322":68028,"_29016":68012,"_5":29336,"_20141":113911,"_26412":113912,"_2810":50010},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3322":68029,"_29016":68012,"_5":29336,"_20141":113914,"_26412":113915,"_2810":113916},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3322":68030,"_29016":68012,"_5":29336,"_20141":113918,"_26412":113919,"_2810":113920},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3322":68031,"_29016":68012,"_5":29336,"_20141":113922,"_26412":113923,"_2810":113924},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3322":68032,"_29016":68012,"_20141":113926,"_5":13774,"_26412":68012,"_2810":113927},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3322":68033,"_29016":68012,"_20141":113929,"_5":13774,"_26412":113859,"_2810":113930},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3322":68034,"_29016":68012,"_20141":113932,"_5":13774,"_26412":113859,"_2810":113933},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3322":68035,"_29016":68012,"_20141":113935,"_5":13774,"_26412":113866,"_2810":113936},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3322":68036,"_29016":68012,"_20141":113938,"_5":13774,"_26412":113870,"_2810":113939},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3322":68037,"_29016":68012,"_20141":113941,"_5":13774,"_26412":113874,"_2810":113942},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3322":68038,"_29016":68012,"_20141":113944,"_5":13774,"_26412":113878,"_2810":113945},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3322":68039,"_29016":68012,"_20141":113947,"_5":13774,"_26412":113882,"_2810":113948},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3322":68040,"_29016":68012,"_20141":113950,"_5":13774,"_26412":113890,"_2810":113951},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3322":68041,"_29016":68012,"_20141":113953,"_5":13774,"_26412":113890,"_2810":113954},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3322":68042,"_29016":68012,"_20141":113956,"_5":13774,"_26412":113893,"_2810":113957},[],"Campo de `settings.enrollment_settings`",{"_3322":68043,"_29016":68012,"_20141":113959,"_5":13774,"_26412":113893,"_2810":113960},[],"Decisión",{"_3322":68044,"_29016":68012,"_20141":113962,"_5":13774,"_26412":113893,"_2810":50061},[],{"_3322":68045,"_29016":68012,"_20141":113964,"_5":13774,"_26412":113893,"_2810":113965},[],"`EST_RFC7030` para estas operaciones.",{"_3322":68046,"_29016":68012,"_20141":113967,"_5":13774,"_26412":113893,"_2810":50067},[],{"_3322":68047,"_29016":68012,"_20141":113969,"_5":13774,"_26412":113893,"_2810":113970},[],"ID de la CA que firmará.",{"_3322":68048,"_29016":68012,"_20141":113972,"_5":13774,"_26412":113893,"_2810":50073},[],{"_3322":68049,"_29016":68012,"_20141":113974,"_5":13774,"_26412":113893,"_2810":113975},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3322":68050,"_29016":68012,"_20141":113977,"_5":13774,"_26412":113893,"_2810":50079},[],{"_3322":68051,"_29016":68012,"_20141":113979,"_5":13774,"_26412":113893,"_2810":113980},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3322":68052,"_29016":68012,"_20141":113982,"_5":13774,"_26412":113893,"_2810":50085},[],{"_3322":68053,"_29016":68012,"_20141":113984,"_5":13774,"_26412":113893,"_2810":113985},[],"Uno de los cuatro modos de autenticación.",{"_3322":68054,"_29016":68012,"_20141":113987,"_5":13774,"_26412":113893,"_2810":113988},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3322":68055,"_29016":68012,"_20141":113990,"_5":13774,"_26412":113896,"_2810":113991},[],"Los bloques son independientes:",{"_3322":68056,"_29016":68012,"_20141":113993,"_5":13774,"_26412":113896,"_2810":113994},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3322":68057,"_29016":68012,"_20141":113996,"_5":13774,"_26412":113896,"_2810":113997},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3322":68058,"_29016":68012,"_20141":113999,"_5":13774,"_26412":113896,"_2810":50103},[],{"_3322":68059,"_29016":68012,"_20141":114001,"_5":13774,"_26412":113896,"_2810":114002},[],"Control aplicado en la operación configurada",{"_3322":68060,"_29016":68012,"_20141":114004,"_5":13774,"_26412":113896,"_2810":50109},[],{"_3322":68061,"_29016":68012,"_20141":114006,"_5":13774,"_26412":113896,"_2810":114007},[],"Validación del certificado presentado.",{"_3322":68062,"_29016":68012,"_20141":114009,"_5":13774,"_26412":113896,"_2810":50115},[],{"_3322":68063,"_29016":68012,"_20141":114011,"_5":13774,"_26412":113896,"_2810":114012},[],"Autorización del webhook configurado.",{"_3322":68064,"_29016":68012,"_20141":114014,"_5":13774,"_26412":113896,"_2810":50121},[],{"_3322":68065,"_29016":68012,"_20141":114016,"_5":13774,"_26412":113896,"_2810":114017},[],"Validación del certificado y, después, aprobación del webhook.",{"_3322":68066,"_29016":68012,"_20141":114019,"_5":13774,"_26412":113896,"_2810":50127},[],{"_3322":68067,"_29016":68012,"_20141":114021,"_5":13774,"_26412":113896,"_2810":114022},[],"Sin autenticación del solicitante por el DMS.",{"_3322":68068,"_29016":68012,"_20141":114024,"_5":13774,"_26412":113896,"_2810":114025},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3322":68069,"_29016":68012,"_20141":114027,"_5":13774,"_26412":113896,"_2810":114028},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3322":68070,"_29016":68012,"_20141":114030,"_5":13774,"_26412":113896,"_2810":114031},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3322":68071,"_29016":68012,"_20141":114033,"_5":13774,"_26412":113896,"_2810":114034},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3322":68072,"_29016":68012,"_20141":114036,"_5":13774,"_26412":113900,"_2810":114037},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3322":68073,"_29016":68012,"_20141":114039,"_5":13774,"_26412":113900,"_2810":114040},[],"Campo de `external_webhook_settings`",{"_3322":68074,"_29016":68012,"_20141":114042,"_5":13774,"_26412":113900,"_2810":113960},[],{"_3322":68075,"_29016":68012,"_20141":114044,"_5":13774,"_26412":113900,"_2810":50153},[],{"_3322":68076,"_29016":68012,"_20141":114046,"_5":13774,"_26412":113900,"_2810":114047},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3322":68077,"_29016":68012,"_20141":114049,"_5":13774,"_26412":113900,"_2810":50159},[],{"_3322":68078,"_29016":68012,"_20141":114051,"_5":13774,"_26412":113900,"_2810":114052},[],"`POST` o `PUT`; `POST` por defecto.",{"_3322":68079,"_29016":68012,"_20141":114054,"_5":13774,"_26412":113900,"_2810":50165},[],{"_3322":68080,"_29016":68012,"_20141":114056,"_5":13774,"_26412":113900,"_2810":114057},[],"Etiqueta usada en los logs del servicio.",{"_3322":68081,"_29016":68012,"_20141":114059,"_5":13774,"_26412":113900,"_2810":50171},[],{"_3322":68082,"_29016":68012,"_20141":114061,"_5":13774,"_26412":113900,"_2810":114062},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3322":68083,"_29016":68012,"_20141":114064,"_5":13774,"_26412":113900,"_2810":50177},[],{"_3322":68084,"_29016":68012,"_20141":114066,"_5":13774,"_26412":113900,"_2810":114067},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3322":68085,"_29016":68012,"_20141":114069,"_5":13774,"_26412":113900,"_2810":50183},[],{"_3322":68086,"_29016":68012,"_20141":114071,"_5":13774,"_26412":113900,"_2810":114072},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3322":68087,"_29016":68012,"_20141":114074,"_5":13774,"_26412":113900,"_2810":50189},[],{"_3322":68088,"_29016":68012,"_20141":114076,"_5":13774,"_26412":113900,"_2810":114077},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3322":68089,"_29016":68012,"_20141":114079,"_5":13774,"_26412":113900,"_2810":50195},[],{"_3322":68090,"_29016":68012,"_20141":114081,"_5":13774,"_26412":113900,"_2810":114082},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3322":68091,"_29016":68012,"_20141":114084,"_5":13774,"_26412":113900,"_2810":50201},[],{"_3322":68092,"_29016":68012,"_20141":114086,"_5":13774,"_26412":113900,"_2810":114087},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3322":68093,"_29016":68012,"_20141":114089,"_5":13774,"_26412":113900,"_2810":50207},[],{"_3322":68094,"_29016":68012,"_20141":114091,"_5":13774,"_26412":113900,"_2810":114092},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3322":68095,"_29016":68012,"_20141":114094,"_5":13774,"_26412":113900,"_2810":114095},[],"Reglas de esa configuración:",{"_3322":68096,"_29016":68012,"_20141":114097,"_5":13774,"_26412":113900,"_2810":114098},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3322":68097,"_29016":68012,"_20141":114100,"_5":13774,"_26412":113900,"_2810":114101},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3322":68098,"_29016":68012,"_20141":114103,"_5":13774,"_26412":113900,"_2810":114104},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3322":68099,"_29016":68012,"_20141":114106,"_5":13774,"_26412":113900,"_2810":114107},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3322":68100,"_29016":68012,"_20141":114109,"_5":13774,"_26412":113900,"_2810":114110},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3322":68101,"_29016":68012,"_20141":114112,"_5":13774,"_26412":113900,"_2810":114113},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3322":68102,"_29016":68012,"_20141":114115,"_5":13774,"_26412":113900,"_2810":114116},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3322":68103,"_29016":68012,"_20141":114118,"_5":13774,"_26412":113900,"_2810":114119},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3322":68104,"_29016":68012,"_20141":114121,"_5":13774,"_26412":113900,"_2810":114122},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3322":68105,"_29016":68012,"_20141":114124,"_5":13774,"_26412":113904,"_2810":114125},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3322":68106,"_29016":68012,"_20141":114127,"_5":13774,"_26412":113908,"_2810":114128},[],"Campo de `settings.reenrollment_settings`",{"_3322":68107,"_29016":68012,"_20141":114130,"_5":13774,"_26412":113908,"_2810":114131},[],"Función",{"_3322":68108,"_29016":68012,"_20141":114133,"_5":13774,"_26412":113908,"_2810":50251},[],{"_3322":68109,"_29016":68012,"_20141":114135,"_5":13774,"_26412":113908,"_2810":114136},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3322":68110,"_29016":68012,"_20141":114138,"_5":13774,"_26412":113908,"_2810":50257},[],{"_3322":68111,"_29016":68012,"_20141":114140,"_5":13774,"_26412":113908,"_2810":114141},[],"Umbral operativo preventivo de monitorización.",{"_3322":68112,"_29016":68012,"_20141":114143,"_5":13774,"_26412":113908,"_2810":50263},[],{"_3322":68113,"_29016":68012,"_20141":114145,"_5":13774,"_26412":113908,"_2810":114146},[],"Umbral operativo crítico de monitorización.",{"_3322":68114,"_29016":68012,"_20141":114148,"_5":13774,"_26412":113908,"_2810":50269},[],{"_3322":68115,"_29016":68012,"_20141":114150,"_5":13774,"_26412":113908,"_2810":114151},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3322":68116,"_29016":68012,"_20141":114153,"_5":13774,"_26412":113908,"_2810":50275},[],{"_3322":68117,"_29016":68012,"_20141":114155,"_5":13774,"_26412":113908,"_2810":114156},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3322":68118,"_29016":68012,"_20141":114158,"_5":13774,"_26412":113908,"_2810":50281},[],{"_3322":68119,"_29016":68012,"_20141":114160,"_5":13774,"_26412":113908,"_2810":114161},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3322":68120,"_29016":68012,"_20141":114163,"_5":13774,"_26412":113908,"_2810":114164},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3322":68121,"_29016":68012,"_20141":114166,"_5":13774,"_26412":113912,"_2810":114167},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3322":68122,"_29016":68012,"_20141":114169,"_5":13774,"_26412":113915,"_2810":111557},[],{"_3322":68123,"_29016":68012,"_20141":114171,"_5":13774,"_26412":113915,"_2810":114172},[],"Qué publica",{"_3322":68124,"_29016":68012,"_20141":114174,"_5":13774,"_26412":113915,"_2810":50298},[],{"_3322":68125,"_29016":68012,"_20141":114176,"_5":13774,"_26412":113915,"_2810":114177},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3322":68126,"_29016":68012,"_20141":114179,"_5":13774,"_26412":113915,"_2810":50304},[],{"_3322":68127,"_29016":68012,"_20141":114181,"_5":13774,"_26412":113915,"_2810":114182},[],"Certificado de la CA emisora seleccionada.",{"_3322":68128,"_29016":68012,"_20141":114184,"_5":13774,"_26412":113915,"_2810":50310},[],{"_3322":68129,"_29016":68012,"_20141":114186,"_5":13774,"_26412":113915,"_2810":114187},[],"Certificados de las CAs elegidas explícitamente.",{"_3322":68130,"_29016":68012,"_20141":114189,"_5":13774,"_26412":113915,"_2810":114190},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3322":68131,"_29016":68012,"_20141":114192,"_5":13774,"_26412":113919,"_2810":114193},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3322":68132,"_29016":68012,"_20141":114195,"_5":13774,"_26412":113919,"_2810":114196},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3322":68133,"_29016":68012,"_20141":114198,"_5":13774,"_26412":113919,"_2810":114199},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3322":68134,"_29016":68012,"_20141":114201,"_5":13774,"_26412":113923,"_2810":114202},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3322":68135,"_29016":68135,"_5":14132,"_2810":114204,"_29339":114205,"_20141":114206,"_26412":68135},"Integra el cliente EST",[47234,112596,49691,113602,113777],[],{"_3322":68136,"_29016":68135,"_20141":114208,"_5":13774,"_26412":68135,"_2810":114209},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3322":68137,"_29016":68135,"_5":29336,"_20141":114211,"_26412":114212,"_2810":111193},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3322":68138,"_29016":68135,"_5":29336,"_20141":114214,"_26412":114215,"_2810":114216},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3322":68139,"_29016":68135,"_5":29336,"_20141":114218,"_26412":114219,"_2810":114220},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3322":68140,"_29016":68135,"_5":29336,"_20141":114222,"_26412":114223,"_2810":114224},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3322":68141,"_29016":68135,"_5":29336,"_20141":114226,"_26412":114227,"_2810":114228},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3322":68142,"_29016":68135,"_5":29336,"_20141":114230,"_26412":114231,"_2810":114232},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3322":68143,"_29016":68135,"_20141":114234,"_5":13774,"_26412":68135,"_2810":114235},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3322":68144,"_29016":68135,"_20141":114237,"_5":13774,"_26412":114212,"_2810":114238},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3322":68145,"_29016":68135,"_20141":114240,"_5":13774,"_26412":114212,"_2810":114241},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3322":68146,"_29016":68135,"_20141":114243,"_5":13774,"_26412":114212,"_2810":114244},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3322":68147,"_29016":68135,"_20141":114246,"_5":13774,"_26412":114215,"_2810":114247},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3322":68148,"_29016":68135,"_20141":114249,"_5":13774,"_26412":114215,"_2810":114250},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3322":68149,"_29016":68135,"_20141":114252,"_5":13774,"_26412":114219,"_2810":114253},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3322":68150,"_29016":68135,"_20141":114255,"_5":13774,"_26412":114219,"_2810":114256},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3322":68151,"_29016":68135,"_20141":114258,"_5":13774,"_26412":114223,"_2810":114259},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3322":68152,"_29016":68135,"_20141":114261,"_5":13774,"_26412":114223,"_2810":114262},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3322":68153,"_29016":68135,"_20141":114264,"_5":13774,"_26412":114227,"_2810":114265},[],"Para el caso de una raíz que emite directamente:",{"_3322":68154,"_29016":68135,"_20141":114267,"_5":13774,"_26412":114227,"_2810":114268},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3322":68155,"_29016":68135,"_20141":114270,"_5":13774,"_26412":114227,"_2810":114271},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3322":68156,"_29016":68135,"_20141":114273,"_5":13774,"_26412":114231,"_2810":114274},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3322":68157,"_29016":68157,"_5":14132,"_2810":114276,"_29339":114277,"_20141":114278,"_26412":68157},"Referencia EST",[47234,112596,49691,113602,113777],[],{"_3322":68158,"_29016":68157,"_20141":114280,"_5":13774,"_26412":68157,"_2810":114281},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3322":68159,"_29016":68157,"_5":29336,"_20141":114283,"_26412":114284,"_2810":114285},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3322":68160,"_29016":68157,"_5":29336,"_20141":114287,"_26412":114288,"_2810":21865},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3322":68161,"_29016":68157,"_5":29336,"_20141":114290,"_26412":114291,"_2810":25057},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3322":68162,"_29016":68157,"_5":29336,"_20141":114293,"_26412":114294,"_2810":25064},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3322":68163,"_29016":68157,"_5":29336,"_20141":114296,"_26412":114297,"_2810":24397},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3322":68164,"_29016":68157,"_5":29336,"_20141":114299,"_26412":114300,"_2810":114301},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3322":68165,"_29016":68157,"_5":29336,"_20141":114303,"_26412":114304,"_2810":114305},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3322":68166,"_29016":68157,"_5":29336,"_20141":114307,"_26412":114308,"_2810":114309},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3322":68167,"_29016":68157,"_20141":114311,"_5":13774,"_26412":68157,"_2810":114312},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3322":68168,"_29016":68157,"_20141":114314,"_5":13774,"_26412":114284,"_2810":114315},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3322":68169,"_29016":68157,"_20141":114317,"_5":13774,"_26412":114284,"_2810":112356},[],{"_3322":68170,"_29016":68157,"_20141":114319,"_5":13774,"_26412":114284,"_2810":114320},[],"Método",{"_3322":68171,"_29016":68157,"_20141":114322,"_5":13774,"_26412":114284,"_2810":114323},[],"Autenticación y condición",{"_3322":68172,"_29016":68157,"_20141":114325,"_5":13774,"_26412":114284,"_2810":50453},[],{"_3322":68173,"_29016":68157,"_20141":114327,"_5":13774,"_26412":114284,"_2810":50456},[],{"_3322":68174,"_29016":68157,"_20141":114329,"_5":13774,"_26412":114284,"_2810":114330},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3322":68175,"_29016":68157,"_20141":114332,"_5":13774,"_26412":114284,"_2810":50462},[],{"_3322":68176,"_29016":68157,"_20141":114334,"_5":13774,"_26412":114284,"_2810":50465},[],{"_3322":68177,"_29016":68157,"_20141":114336,"_5":13774,"_26412":114284,"_2810":114337},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3322":68178,"_29016":68157,"_20141":114339,"_5":13774,"_26412":114284,"_2810":50471},[],{"_3322":68179,"_29016":68157,"_20141":114341,"_5":13774,"_26412":114284,"_2810":50465},[],{"_3322":68180,"_29016":68157,"_20141":114343,"_5":13774,"_26412":114284,"_2810":114344},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3322":68181,"_29016":68157,"_20141":114346,"_5":13774,"_26412":114284,"_2810":50479},[],{"_3322":68182,"_29016":68157,"_20141":114348,"_5":13774,"_26412":114284,"_2810":50465},[],{"_3322":68183,"_29016":68157,"_20141":114350,"_5":13774,"_26412":114284,"_2810":114351},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3322":68184,"_29016":68157,"_20141":114353,"_5":13774,"_26412":114284,"_2810":114354},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3322":68185,"_29016":68157,"_20141":114356,"_5":13774,"_26412":114288,"_2810":114357},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3322":68186,"_29016":68157,"_20141":114359,"_5":13774,"_26412":114288,"_2810":114360},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3322":68187,"_29016":68157,"_20141":114362,"_5":13774,"_26412":114291,"_2810":114363},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3322":68188,"_29016":68157,"_20141":114365,"_5":13774,"_26412":114291,"_2810":114366},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3322":68189,"_29016":68157,"_20141":114368,"_5":13774,"_26412":114294,"_2810":114369},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3322":68190,"_29016":68157,"_20141":114371,"_5":13774,"_26412":114294,"_2810":114372},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3322":68191,"_29016":68157,"_20141":114374,"_5":13774,"_26412":114297,"_2810":114375},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3322":68192,"_29016":68157,"_20141":114377,"_5":13774,"_26412":114297,"_2810":114378},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3322":68193,"_29016":68157,"_20141":114380,"_5":13774,"_26412":114300,"_2810":114381},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3322":68194,"_29016":68157,"_20141":114383,"_5":13774,"_26412":114300,"_2810":114384},[],"Parte",{"_3322":68195,"_29016":68157,"_20141":114386,"_5":13774,"_26412":114300,"_2810":114387},[],"Contenido tras decodificar su Base64",{"_3322":68196,"_29016":68157,"_20141":114389,"_5":13774,"_26412":114300,"_2810":50523},[],{"_3322":68197,"_29016":68157,"_20141":114391,"_5":13774,"_26412":114300,"_2810":114392},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3322":68198,"_29016":68157,"_20141":114394,"_5":13774,"_26412":114300,"_2810":50529},[],{"_3322":68199,"_29016":68157,"_20141":114396,"_5":13774,"_26412":114300,"_2810":114397},[],"PKCS#7 DER con el certificado emitido.",{"_3322":68200,"_29016":68157,"_20141":114399,"_5":13774,"_26412":114300,"_2810":114400},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3322":68201,"_29016":68157,"_20141":114402,"_5":13774,"_26412":114304,"_2810":114403},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3322":68202,"_29016":68157,"_20141":114405,"_5":13774,"_26412":114304,"_2810":114406},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3322":68203,"_29016":68157,"_20141":114408,"_5":13774,"_26412":114304,"_2810":114409},[],"Convierte y comprueba el resultado:",{"_3322":68204,"_29016":68157,"_20141":114411,"_5":13774,"_26412":114304,"_2810":114412},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3322":68205,"_29016":68157,"_20141":114414,"_5":13774,"_26412":114308,"_2810":114415},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3322":68206,"_29016":68157,"_20141":114417,"_5":13774,"_26412":114308,"_2810":114418},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3322":68207,"_29016":68207,"_5":14132,"_2810":113777,"_29339":114420,"_20141":114421,"_26412":68207},[47234,112596,49691,113602,113777],[],{"_3322":68208,"_29016":68207,"_20141":114423,"_5":13774,"_26412":68207,"_2810":114424},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3322":68209,"_29016":68207,"_5":29336,"_20141":114426,"_26412":114427,"_2810":114428},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3322":68210,"_29016":68207,"_5":29336,"_20141":114430,"_26412":114431,"_2810":114432},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3322":68211,"_29016":68207,"_5":29336,"_20141":114434,"_26412":114435,"_2810":114436},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3322":68212,"_29016":68207,"_5":29336,"_20141":114438,"_26412":114439,"_2810":114440},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3322":68213,"_29016":68207,"_20141":114442,"_5":13774,"_26412":68207,"_2810":114443},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3322":68214,"_29016":68207,"_20141":114445,"_5":13774,"_26412":114427,"_2810":114446},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3322":68215,"_29016":68207,"_20141":114448,"_5":13774,"_26412":114427,"_2810":114449},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3322":68216,"_29016":68207,"_20141":114451,"_5":13774,"_26412":114427,"_2810":114452},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3322":68217,"_29016":68207,"_20141":114454,"_5":13774,"_26412":114427,"_2810":114455},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3322":68218,"_29016":68207,"_20141":114457,"_5":13774,"_26412":114427,"_2810":114458},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3322":68219,"_29016":68207,"_20141":114460,"_5":13774,"_26412":114427,"_2810":114461},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3322":68220,"_29016":68207,"_20141":114463,"_5":13774,"_26412":114431,"_2810":114464},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3322":68221,"_29016":68207,"_20141":114466,"_5":13774,"_26412":114431,"_2810":114467},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3322":68222,"_29016":68207,"_20141":114469,"_5":13774,"_26412":114431,"_2810":114470},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3322":68223,"_29016":68207,"_20141":114472,"_5":13774,"_26412":114431,"_2810":114473},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3322":68224,"_29016":68207,"_20141":114475,"_5":13774,"_26412":114435,"_2810":114476},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3322":68225,"_29016":68207,"_20141":114478,"_5":13774,"_26412":114435,"_2810":114479},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3322":68226,"_29016":68207,"_20141":114481,"_5":13774,"_26412":114435,"_2810":114482},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3322":68227,"_29016":68207,"_20141":114484,"_5":13774,"_26412":114435,"_2810":114485},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3322":68228,"_29016":68207,"_20141":114487,"_5":13774,"_26412":114439,"_2810":114488},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3322":68229,"_29016":68207,"_20141":114490,"_5":13774,"_26412":114439,"_2810":114491},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3322":68230,"_29016":68230,"_5":14132,"_2810":114493,"_29339":114494,"_20141":114495,"_26412":68230},"Estrategias de aprovisionamiento",[47234,112596,49691,113602,113777],[],{"_3322":68231,"_29016":68230,"_20141":114497,"_5":13774,"_26412":68230,"_2810":114498},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3322":68232,"_29016":68230,"_5":29336,"_20141":114500,"_26412":114501,"_2810":114502},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3322":68233,"_29016":68230,"_5":29336,"_20141":114504,"_26412":114505,"_2810":114506},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3322":68234,"_29016":68230,"_5":29336,"_20141":114508,"_26412":114509,"_2810":114510},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3322":68235,"_29016":68230,"_5":29336,"_20141":114512,"_26412":114513,"_2810":114514},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3322":68236,"_29016":68230,"_5":29336,"_20141":114516,"_26412":114517,"_2810":114518},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3322":68237,"_29016":68230,"_20141":114520,"_5":13774,"_26412":68230,"_2810":114521},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3322":68238,"_29016":68230,"_20141":114523,"_5":13774,"_26412":114501,"_2810":114524},[],"Recorrido",{"_3322":68239,"_29016":68230,"_20141":114526,"_5":13774,"_26412":114501,"_2810":114527},[],"Cuándo existe el dispositivo",{"_3322":68240,"_29016":68230,"_20141":114529,"_5":13774,"_26412":114501,"_2810":114530},[],"Qué compruebas",{"_3322":68241,"_29016":68230,"_20141":114532,"_5":13774,"_26412":114501,"_2810":114533},[],"Asignación manual",{"_3322":68242,"_29016":68230,"_20141":114535,"_5":13774,"_26412":114501,"_2810":114536},[],"El operador lo crea antes de asociar un certificado.",{"_3322":68243,"_29016":68230,"_20141":114538,"_5":13774,"_26412":114501,"_2810":114539},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3322":68244,"_29016":68230,"_20141":114541,"_5":13774,"_26412":114501,"_2810":114542},[],"EST con `JITP`",{"_3322":68245,"_29016":68230,"_20141":114544,"_5":13774,"_26412":114501,"_2810":114545},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3322":68246,"_29016":68230,"_20141":114547,"_5":13774,"_26412":114501,"_2810":114548},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3322":68247,"_29016":68230,"_20141":114550,"_5":13774,"_26412":114501,"_2810":114551},[],"EST con `PRE_REGISTRATION`",{"_3322":68248,"_29016":68230,"_20141":114553,"_5":13774,"_26412":114501,"_2810":114554},[],"Debe existir antes de `/simpleenroll`.",{"_3322":68249,"_29016":68230,"_20141":114556,"_5":13774,"_26412":114501,"_2810":114557},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3322":68250,"_29016":68230,"_20141":114559,"_5":13774,"_26412":114501,"_2810":114560},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3322":68251,"_29016":68230,"_20141":114562,"_5":13774,"_26412":114501,"_2810":114563},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3322":68252,"_29016":68230,"_20141":114565,"_5":13774,"_26412":114505,"_2810":114566},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3322":68253,"_29016":68230,"_20141":114568,"_5":13774,"_26412":114505,"_2810":114569},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3322":68254,"_29016":68230,"_20141":114571,"_5":13774,"_26412":114505,"_2810":114572},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3322":68255,"_29016":68230,"_20141":114574,"_5":13774,"_26412":114509,"_2810":114575},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3322":68256,"_29016":68230,"_20141":114577,"_5":13774,"_26412":114509,"_2810":114578},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3322":68257,"_29016":68230,"_20141":114580,"_5":13774,"_26412":114509,"_2810":114581},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3322":68258,"_29016":68230,"_20141":114583,"_5":13774,"_26412":114509,"_2810":114584},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3322":68259,"_29016":68230,"_20141":114586,"_5":13774,"_26412":114509,"_2810":114587},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3322":68260,"_29016":68230,"_20141":114589,"_5":13774,"_26412":114509,"_2810":114590},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3322":68261,"_29016":68230,"_20141":114592,"_5":13774,"_26412":114513,"_2810":111557},[],{"_3322":68262,"_29016":68230,"_20141":114594,"_5":13774,"_26412":114513,"_2810":114595},[],"Material que atraviesa EST",{"_3322":68263,"_29016":68230,"_20141":114597,"_5":13774,"_26412":114513,"_2810":114598},[],"Clave generada por el dispositivo",{"_3322":68264,"_29016":68230,"_20141":114600,"_5":13774,"_26412":114513,"_2810":114601},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3322":68265,"_29016":68230,"_20141":114603,"_5":13774,"_26412":114513,"_2810":114604},[],"Clave ya disponible en el dispositivo",{"_3322":68266,"_29016":68230,"_20141":114606,"_5":13774,"_26412":114513,"_2810":114607},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3322":68267,"_29016":68230,"_20141":114609,"_5":13774,"_26412":114513,"_2810":50010},[],{"_3322":68268,"_29016":68230,"_20141":114611,"_5":13774,"_26412":114513,"_2810":114612},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3322":68269,"_29016":68230,"_20141":114614,"_5":13774,"_26412":114513,"_2810":114615},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3322":68270,"_29016":68230,"_20141":114617,"_5":13774,"_26412":114517,"_2810":114618},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3322":68271,"_29016":68271,"_5":14132,"_2810":114620,"_29339":114621,"_20141":114622,"_26412":68271},"Renovación y recuperación",[47234,112596,49691,113602,113777],[],{"_3322":68272,"_29016":68271,"_20141":114624,"_5":13774,"_26412":68271,"_2810":114625},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3322":68273,"_29016":68271,"_5":29336,"_20141":114627,"_26412":114628,"_2810":114629},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3322":68274,"_29016":68271,"_5":29336,"_20141":114631,"_26412":114632,"_2810":114633},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3322":68275,"_29016":68271,"_5":29336,"_20141":114635,"_26412":114636,"_2810":114637},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3322":68276,"_29016":68271,"_5":29336,"_20141":114639,"_26412":114640,"_2810":114641},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3322":68277,"_29016":68271,"_5":29336,"_20141":114643,"_26412":114644,"_2810":114645},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3322":68278,"_29016":68271,"_20141":114647,"_5":13774,"_26412":68271,"_2810":114648},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3322":68279,"_29016":68271,"_20141":114650,"_5":13774,"_26412":114628,"_2810":114651},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3322":68280,"_29016":68271,"_20141":114653,"_5":13774,"_26412":114628,"_2810":114654},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3322":68281,"_29016":68271,"_20141":114656,"_5":13774,"_26412":114628,"_2810":114657},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3322":68282,"_29016":68271,"_20141":114659,"_5":13774,"_26412":114628,"_2810":114660},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3322":68283,"_29016":68271,"_20141":114662,"_5":13774,"_26412":114632,"_2810":114663},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3322":68284,"_29016":68271,"_20141":114665,"_5":13774,"_26412":114632,"_2810":114666},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3322":68285,"_29016":68271,"_20141":114668,"_5":13774,"_26412":114636,"_2810":114669},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3322":68286,"_29016":68271,"_20141":114671,"_5":13774,"_26412":114636,"_2810":114672},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3322":68287,"_29016":68271,"_20141":114674,"_5":13774,"_26412":114636,"_2810":114675},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3322":68288,"_29016":68271,"_20141":114677,"_5":13774,"_26412":114640,"_2810":114678},[],"Situación",{"_3322":68289,"_29016":68271,"_20141":114680,"_5":13774,"_26412":114640,"_2810":114681},[],"Procedimiento",{"_3322":68290,"_29016":68271,"_20141":114683,"_5":13774,"_26412":114640,"_2810":114684},[],"Certificado vigente, fuera de ventana",{"_3322":68291,"_29016":68271,"_20141":114686,"_5":13774,"_26412":114640,"_2810":114687},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3322":68292,"_29016":68271,"_20141":114689,"_5":13774,"_26412":114640,"_2810":114690},[],"Certificado vencido, clave disponible",{"_3322":68293,"_29016":68271,"_20141":114692,"_5":13774,"_26412":114640,"_2810":114693},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3322":68294,"_29016":68271,"_20141":114695,"_5":13774,"_26412":114640,"_2810":114696},[],"Renovación por webhook o `NO_AUTH`",{"_3322":68295,"_29016":68271,"_20141":114698,"_5":13774,"_26412":114640,"_2810":114699},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3322":68296,"_29016":68271,"_20141":114701,"_5":13774,"_26412":114640,"_2810":114702},[],"Clave perdida o inaccesible",{"_3322":68297,"_29016":68271,"_20141":114704,"_5":13774,"_26412":114640,"_2810":114705},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3322":68298,"_29016":68271,"_20141":114707,"_5":13774,"_26412":114640,"_2810":114708},[],"Identidad actual revocada",{"_3322":68299,"_29016":68271,"_20141":114710,"_5":13774,"_26412":114640,"_2810":114711},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3322":68300,"_29016":68271,"_20141":114713,"_5":13774,"_26412":114640,"_2810":114714},[],"Dispositivo sin identidad",{"_3322":68301,"_29016":68271,"_20141":114716,"_5":13774,"_26412":114640,"_2810":114717},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3322":68302,"_29016":68271,"_20141":114719,"_5":13774,"_26412":114640,"_2810":114720},[],"Dispositivo retirado",{"_3322":68303,"_29016":68271,"_20141":114722,"_5":13774,"_26412":114640,"_2810":114723},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3322":68304,"_29016":68271,"_20141":114725,"_5":13774,"_26412":114640,"_2810":114726},[],"Timeout, HTTP 500 o fallo de instalación",{"_3322":68305,"_29016":68271,"_20141":114728,"_5":13774,"_26412":114640,"_2810":114729},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3322":68306,"_29016":68271,"_20141":114731,"_5":13774,"_26412":114644,"_2810":114732},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3322":68307,"_29016":68271,"_20141":114734,"_5":13774,"_26412":114644,"_2810":114735},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3322":68308,"_29016":68308,"_5":14132,"_2810":114737,"_29339":114738,"_20141":114739,"_26412":68308},"Diagnóstico de enrolamiento",[47234,112596,49691,113602,113777],[],{"_3322":68309,"_29016":68308,"_20141":114741,"_5":13774,"_26412":68308,"_2810":114742},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3322":68310,"_29016":68308,"_5":29336,"_20141":114744,"_26412":114745,"_2810":114746},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3322":68311,"_29016":68308,"_5":29336,"_20141":114748,"_26412":114749,"_2810":114750},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3322":68312,"_29016":68308,"_5":29336,"_20141":114752,"_26412":114753,"_2810":114309},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3322":68313,"_29016":68308,"_5":29336,"_20141":114755,"_26412":114756,"_2810":114757},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3322":68314,"_29016":68308,"_20141":114759,"_5":13774,"_26412":68308,"_2810":114760},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3322":68315,"_29016":68308,"_20141":114762,"_5":13774,"_26412":114749,"_2810":114763},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3322":68316,"_29016":68308,"_20141":114765,"_5":13774,"_26412":114749,"_2810":114766},[],"Síntoma o mensaje",{"_3322":68317,"_29016":68308,"_20141":114768,"_5":13774,"_26412":114749,"_2810":114769},[],"Qué revisar",{"_3322":68318,"_29016":68308,"_20141":114771,"_5":13774,"_26412":114749,"_2810":114772},[],"curl rechaza TLS, nombre o emisor",{"_3322":68319,"_29016":68308,"_20141":114774,"_5":13774,"_26412":114749,"_2810":114775},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3322":68320,"_29016":68308,"_20141":114777,"_5":13774,"_26412":114749,"_2810":114778},[],"404 o APS ausente",{"_3322":68321,"_29016":68308,"_20141":114780,"_5":13774,"_26412":114749,"_2810":114781},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3322":68322,"_29016":68308,"_20141":114783,"_5":13774,"_26412":114749,"_2810":114784},[],"400, error de CSR o formato",{"_3322":68323,"_29016":68308,"_20141":114786,"_5":13774,"_26412":114749,"_2810":114787},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3322":68324,"_29016":68308,"_20141":114789,"_5":13774,"_26412":114749,"_2810":114790},[],"Credencial ausente o certificado no válido",{"_3322":68325,"_29016":68308,"_20141":114792,"_5":13774,"_26412":114749,"_2810":114793},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3322":68326,"_29016":68308,"_20141":114795,"_5":13774,"_26412":114749,"_2810":114796},[],"Webhook deniega, expira o responde sin autorización",{"_3322":68327,"_29016":68308,"_20141":114798,"_5":13774,"_26412":114749,"_2810":114799},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3322":68328,"_29016":68308,"_20141":114801,"_5":13774,"_26412":114749,"_2810":50936},[],{"_3322":68329,"_29016":68308,"_20141":114803,"_5":13774,"_26412":114749,"_2810":114804},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3322":68330,"_29016":68308,"_20141":114806,"_5":13774,"_26412":114749,"_2810":50942},[],{"_3322":68331,"_29016":68308,"_20141":114808,"_5":13774,"_26412":114749,"_2810":114809},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3322":68332,"_29016":68308,"_20141":114811,"_5":13774,"_26412":114749,"_2810":50948},[],{"_3322":68333,"_29016":68308,"_20141":114813,"_5":13774,"_26412":114749,"_2810":114814},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3322":68334,"_29016":68308,"_20141":114816,"_5":13774,"_26412":114749,"_2810":50954},[],{"_3322":68335,"_29016":68308,"_20141":114818,"_5":13774,"_26412":114749,"_2810":114819},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3322":68336,"_29016":68308,"_20141":114821,"_5":13774,"_26412":114749,"_2810":50960},[],{"_3322":68337,"_29016":68308,"_20141":114823,"_5":13774,"_26412":114749,"_2810":114824},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3322":68338,"_29016":68308,"_20141":114826,"_5":13774,"_26412":114749,"_2810":114827},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3322":68339,"_29016":68308,"_20141":114829,"_5":13774,"_26412":114749,"_2810":114830},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3322":68340,"_29016":68308,"_20141":114832,"_5":13774,"_26412":114749,"_2810":114833},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3322":68341,"_29016":68308,"_20141":114835,"_5":13774,"_26412":114749,"_2810":114836},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3322":68342,"_29016":68308,"_20141":114838,"_5":13774,"_26412":114749,"_2810":50978},[],{"_3322":68343,"_29016":68308,"_20141":114840,"_5":13774,"_26412":114749,"_2810":114841},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3322":68344,"_29016":68308,"_20141":114843,"_5":13774,"_26412":114749,"_2810":50984},[],{"_3322":68345,"_29016":68308,"_20141":114845,"_5":13774,"_26412":114749,"_2810":114846},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3322":68346,"_29016":68308,"_20141":114848,"_5":13774,"_26412":114749,"_2810":114849},[],"DMS propietario distinto",{"_3322":68347,"_29016":68308,"_20141":114851,"_5":13774,"_26412":114749,"_2810":114852},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3322":68348,"_29016":68308,"_20141":114854,"_5":13774,"_26412":114749,"_2810":50996},[],{"_3322":68349,"_29016":68308,"_20141":114856,"_5":13774,"_26412":114749,"_2810":114857},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3322":68350,"_29016":68308,"_20141":114859,"_5":13774,"_26412":114749,"_2810":51002},[],{"_3322":68351,"_29016":68308,"_20141":114861,"_5":13774,"_26412":114749,"_2810":114862},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3322":68352,"_29016":68308,"_20141":114864,"_5":13774,"_26412":114749,"_2810":114865},[],"Certificado actual revocado",{"_3322":68353,"_29016":68308,"_20141":114867,"_5":13774,"_26412":114749,"_2810":114868},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3322":68354,"_29016":68308,"_20141":114870,"_5":13774,"_26412":114749,"_2810":114871},[],"Error de CA, perfil o firma",{"_3322":68355,"_29016":68308,"_20141":114873,"_5":13774,"_26412":114749,"_2810":114874},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3322":68356,"_29016":68308,"_20141":114876,"_5":13774,"_26412":114749,"_2810":114877},[],"HTTP 200 sin conexión del dispositivo",{"_3322":68357,"_29016":68308,"_20141":114879,"_5":13774,"_26412":114749,"_2810":114880},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3322":68358,"_29016":68308,"_20141":114882,"_5":13774,"_26412":114749,"_2810":114883},[],"Timeout o error después de emitir",{"_3322":68359,"_29016":68308,"_20141":114885,"_5":13774,"_26412":114749,"_2810":114886},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3322":68360,"_29016":68308,"_20141":114888,"_5":13774,"_26412":114753,"_2810":114889},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3322":68361,"_29016":68308,"_20141":114891,"_5":13774,"_26412":114753,"_2810":114892},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3322":68362,"_29016":68308,"_20141":114894,"_5":13774,"_26412":114756,"_2810":114895},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3322":68363,"_29016":68308,"_20141":114897,"_5":13774,"_26412":114756,"_2810":114898},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3322":68364,"_29016":68308,"_20141":114900,"_5":13774,"_26412":114756,"_2810":114901},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3322":68365,"_29016":68308,"_20141":114903,"_5":13774,"_26412":114756,"_2810":114904},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3322":68366,"_29016":68308,"_20141":114906,"_5":13774,"_26412":114756,"_2810":114907},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3322":68367,"_29016":68308,"_20141":114909,"_5":13774,"_26412":114756,"_2810":114910},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3322":68368,"_29016":68308,"_20141":114912,"_5":13774,"_26412":114756,"_2810":114913},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3322":68369,"_29016":68369,"_5":14132,"_2810":114915,"_29339":114916,"_20141":114917,"_26412":68369},"Distribución y actualización de confianza",[47234,112596,49691,113602,113777],[],{"_3322":68370,"_29016":68369,"_20141":114919,"_5":13774,"_26412":68369,"_2810":114920},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3322":68371,"_29016":68369,"_5":29336,"_20141":114922,"_26412":114923,"_2810":114924},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3322":68372,"_29016":68369,"_5":29336,"_20141":114926,"_26412":114927,"_2810":114928},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3322":68373,"_29016":68369,"_5":29336,"_20141":114930,"_26412":114931,"_2810":114932},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3322":68374,"_29016":68369,"_5":29336,"_20141":114934,"_26412":114935,"_2810":114936},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3322":68375,"_29016":68369,"_5":29336,"_20141":114938,"_26412":114939,"_2810":114940},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3322":68376,"_29016":68369,"_20141":114942,"_5":13774,"_26412":68369,"_2810":114943},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3322":68377,"_29016":68369,"_20141":114945,"_5":13774,"_26412":114923,"_2810":114946},[],"Relación",{"_3322":68378,"_29016":68369,"_20141":114948,"_5":13774,"_26412":114923,"_2810":114949},[],"Material que prepara el responsable",{"_3322":68379,"_29016":68369,"_20141":114951,"_5":13774,"_26412":114923,"_2810":114952},[],"Dispositivo → servidor EST",{"_3322":68380,"_29016":68369,"_20141":114954,"_5":13774,"_26412":114923,"_2810":114955},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3322":68381,"_29016":68369,"_20141":114957,"_5":13774,"_26412":114923,"_2810":114958},[],"DMS → solicitante",{"_3322":68382,"_29016":68369,"_20141":114960,"_5":13774,"_26412":114923,"_2810":114961},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3322":68383,"_29016":68369,"_20141":114963,"_5":13774,"_26412":114923,"_2810":114964},[],"Consumidor → dispositivo",{"_3322":68384,"_29016":68369,"_20141":114966,"_5":13774,"_26412":114923,"_2810":114967},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3322":68385,"_29016":68369,"_20141":114969,"_5":13774,"_26412":114923,"_2810":114970},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3322":68386,"_29016":68369,"_20141":114972,"_5":13774,"_26412":114927,"_2810":114973},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3322":68387,"_29016":68369,"_20141":114975,"_5":13774,"_26412":114927,"_2810":114976},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3322":68388,"_29016":68369,"_20141":114978,"_5":13774,"_26412":114931,"_2810":114979},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3322":68389,"_29016":68369,"_20141":114981,"_5":13774,"_26412":114931,"_2810":114982},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3322":68390,"_29016":68369,"_20141":114984,"_5":13774,"_26412":114931,"_2810":114985},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3322":68391,"_29016":68369,"_20141":114987,"_5":13774,"_26412":114931,"_2810":114988},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3322":68392,"_29016":68369,"_20141":114990,"_5":13774,"_26412":114931,"_2810":114991},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3322":68393,"_29016":68369,"_20141":114993,"_5":13774,"_26412":114931,"_2810":114994},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3322":68394,"_29016":68369,"_20141":114996,"_5":13774,"_26412":114935,"_2810":114997},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3322":68395,"_29016":68369,"_20141":114999,"_5":13774,"_26412":114935,"_2810":115000},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3322":68396,"_29016":68369,"_20141":115002,"_5":13774,"_26412":114935,"_2810":115003},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3322":68397,"_29016":68369,"_20141":115005,"_5":13774,"_26412":114939,"_2810":115006},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3322":68398,"_29016":68398,"_5":14132,"_2810":51151,"_29339":115008,"_20141":115010,"_26412":68398},[47234,112596,49691,113602,115009],"Integraciones",[],{"_3322":68399,"_29016":68398,"_20141":115012,"_5":13774,"_26412":68398,"_2810":115013},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3322":68400,"_29016":68398,"_5":29336,"_20141":115015,"_26412":115016,"_2810":115017},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3322":68401,"_29016":68398,"_5":29336,"_20141":115019,"_26412":115020,"_2810":115021},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3322":68402,"_29016":68398,"_5":29336,"_20141":115023,"_26412":115024,"_2810":115025},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3322":68403,"_29016":68398,"_5":29336,"_20141":115027,"_26412":115028,"_2810":115029},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3322":68404,"_29016":68398,"_5":29336,"_20141":115031,"_26412":115032,"_2810":115033},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_3322":68405,"_29016":68398,"_5":29336,"_20141":115035,"_26412":115036,"_2810":115037},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_3322":68406,"_29016":68398,"_5":29336,"_20141":115039,"_26412":115040,"_2810":115041},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3322":68407,"_29016":68398,"_5":29336,"_20141":115043,"_26412":115044,"_2810":115045},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3322":68408,"_29016":68398,"_5":29336,"_20141":115047,"_26412":115048,"_2810":115049},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3322":68409,"_29016":68398,"_5":29336,"_20141":115051,"_26412":115052,"_2810":115053},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3322":68410,"_29016":68398,"_5":29336,"_20141":115055,"_26412":115056,"_2810":115057},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3322":68411,"_29016":68398,"_5":29336,"_20141":115059,"_26412":115060,"_2810":115061},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3322":68412,"_29016":68398,"_5":29336,"_20141":115063,"_26412":115064,"_2810":51209},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3322":68413,"_29016":68398,"_5":29336,"_20141":115066,"_26412":115067,"_2810":51213},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3322":68414,"_29016":68398,"_5":29336,"_20141":115069,"_26412":115070,"_2810":115071},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3322":68415,"_29016":68398,"_5":29336,"_20141":115073,"_26412":115074,"_2810":115075},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3322":68416,"_29016":68398,"_5":29336,"_20141":115077,"_26412":115078,"_2810":115079},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3322":68417,"_29016":68398,"_5":29336,"_20141":115081,"_26412":115082,"_2810":115083},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3322":68418,"_29016":68398,"_5":29336,"_20141":115085,"_26412":115086,"_2810":115087},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3322":68419,"_29016":68398,"_5":29336,"_20141":115089,"_26412":115090,"_2810":115091},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3322":68420,"_29016":68398,"_5":29336,"_20141":115093,"_26412":115094,"_2810":115095},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3322":68421,"_29016":68398,"_5":29336,"_20141":115097,"_26412":115098,"_2810":115099},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3322":68422,"_29016":68398,"_5":29336,"_20141":115101,"_26412":115102,"_2810":115103},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3322":68423,"_29016":68398,"_5":29336,"_20141":115105,"_26412":115106,"_2810":115107},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3322":68424,"_29016":68398,"_5":29336,"_20141":115109,"_26412":115110,"_2810":115111},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3322":68425,"_29016":68398,"_5":29336,"_20141":115113,"_26412":115114,"_2810":115115},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3322":68426,"_29016":68398,"_20141":115117,"_5":13774,"_26412":68398,"_2810":115118},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3322":68427,"_29016":68398,"_20141":115120,"_5":13774,"_26412":68398,"_2810":115121},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3322":68428,"_29016":68398,"_20141":115123,"_5":13774,"_26412":68398,"_2810":115124},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3322":68429,"_29016":68398,"_20141":115126,"_5":13774,"_26412":115016,"_2810":115127},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3322":68430,"_29016":68398,"_20141":115129,"_5":13774,"_26412":115016,"_2810":115130},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3322":68431,"_29016":68398,"_20141":115132,"_5":13774,"_26412":115016,"_2810":115133},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3322":68432,"_29016":68398,"_20141":115135,"_5":13774,"_26412":115016,"_2810":115136},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3322":68433,"_29016":68398,"_20141":115138,"_5":13774,"_26412":115020,"_2810":115139},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3322":68434,"_29016":68398,"_20141":115141,"_5":13774,"_26412":115024,"_2810":115142},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3322":68435,"_29016":68398,"_20141":115144,"_5":13774,"_26412":115024,"_2810":115145},[],"Acción IAM",{"_3322":68436,"_29016":68398,"_20141":115147,"_5":13774,"_26412":115024,"_2810":111563},[],{"_3322":68437,"_29016":68398,"_20141":115149,"_5":13774,"_26412":115024,"_2810":51296},[],{"_3322":68438,"_29016":68398,"_20141":115151,"_5":13774,"_26412":115024,"_2810":115152},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3322":68439,"_29016":68398,"_20141":115154,"_5":13774,"_26412":115024,"_2810":51302},[],{"_3322":68440,"_29016":68398,"_20141":115156,"_5":13774,"_26412":115024,"_2810":115157},[],"Registrar la CA en AWS IoT",{"_3322":68441,"_29016":68398,"_20141":115159,"_5":13774,"_26412":115024,"_2810":51308},[],{"_3322":68442,"_29016":68398,"_20141":115161,"_5":13774,"_26412":115024,"_2810":115162},[],"Consultar el estado del registro de la CA",{"_3322":68443,"_29016":68398,"_20141":115164,"_5":13774,"_26412":115024,"_2810":51314},[],{"_3322":68444,"_29016":68398,"_20141":115166,"_5":13774,"_26412":115024,"_2810":115167},[],"Crear o actualizar Things en IoT Core",{"_3322":68445,"_29016":68398,"_20141":115169,"_5":13774,"_26412":115024,"_2810":51320},[],{"_3322":68446,"_29016":68398,"_20141":115171,"_5":13774,"_26412":115024,"_2810":115172},[],"Aprovisionar Things mediante plantilla",{"_3322":68447,"_29016":68398,"_20141":115174,"_5":13774,"_26412":115024,"_2810":51326},[],{"_3322":68448,"_29016":68398,"_20141":115176,"_5":13774,"_26412":115024,"_2810":115177},[],"Registrar certificados de dispositivo",{"_3322":68449,"_29016":68398,"_20141":115179,"_5":13774,"_26412":115024,"_2810":51332},[],{"_3322":68450,"_29016":68398,"_20141":115181,"_5":13774,"_26412":115024,"_2810":115182},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3322":68451,"_29016":68398,"_20141":115184,"_5":13774,"_26412":115024,"_2810":51338},[],{"_3322":68452,"_29016":68398,"_20141":115186,"_5":13774,"_26412":115024,"_2810":115187},[],"Crear y adjuntar políticas IoT",{"_3322":68453,"_29016":68398,"_20141":115189,"_5":13774,"_26412":115024,"_2810":51344},[],{"_3322":68454,"_29016":68398,"_20141":115191,"_5":13774,"_26412":115024,"_2810":115192},[],"Gestionar grupos de Things",{"_3322":68455,"_29016":68398,"_20141":115194,"_5":13774,"_26412":115024,"_2810":51350},[],{"_3322":68456,"_29016":68398,"_20141":115196,"_5":13774,"_26412":115024,"_2810":115197},[],"Crear plantillas JITP",{"_3322":68457,"_29016":68398,"_20141":115199,"_5":13774,"_26412":115024,"_2810":51356},[],{"_3322":68458,"_29016":68398,"_20141":115201,"_5":13774,"_26412":115024,"_2810":115202},[],"Leer y escribir el Device Shadow",{"_3322":68459,"_29016":68398,"_20141":115204,"_5":13774,"_26412":115024,"_2810":115205},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3322":68460,"_29016":68398,"_20141":115207,"_5":13774,"_26412":115028,"_2810":115208},[],"Parámetro",{"_3322":68461,"_29016":68398,"_20141":115210,"_5":13774,"_26412":115028,"_2810":115211},[],"Tipo",{"_3322":68462,"_29016":68398,"_20141":115213,"_5":13774,"_26412":115028,"_2810":115214},[],"Requerido",{"_3322":68463,"_29016":68398,"_20141":115216,"_5":13774,"_26412":115028,"_2810":115217},[],"Descripción",{"_3322":68464,"_29016":68398,"_20141":115219,"_5":13774,"_26412":115028,"_2810":51377},[],{"_3322":68465,"_29016":68398,"_20141":115221,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68466,"_29016":68398,"_20141":115223,"_5":13774,"_26412":115028,"_2810":115224},[],"Sí",{"_3322":68467,"_29016":68398,"_20141":115226,"_5":13774,"_26412":115028,"_2810":115227},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3322":68468,"_29016":68398,"_20141":115229,"_5":13774,"_26412":115028,"_2810":51388},[],{"_3322":68469,"_29016":68398,"_20141":115231,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68470,"_29016":68398,"_20141":115233,"_5":13774,"_26412":115028,"_2810":115224},[],{"_3322":68471,"_29016":68398,"_20141":115235,"_5":13774,"_26412":115028,"_2810":115236},[],"Región AWS donde opera el conector.",{"_3322":68472,"_29016":68398,"_20141":115238,"_5":13774,"_26412":115028,"_2810":51398},[],{"_3322":68473,"_29016":68398,"_20141":115240,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68474,"_29016":68398,"_20141":115242,"_5":13774,"_26412":115028,"_2810":115224},[],{"_3322":68475,"_29016":68398,"_20141":115244,"_5":13774,"_26412":115028,"_2810":115245},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3322":68476,"_29016":68398,"_20141":115247,"_5":13774,"_26412":115028,"_2810":51408},[],{"_3322":68477,"_29016":68398,"_20141":115249,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68478,"_29016":68398,"_20141":115251,"_5":13774,"_26412":115028,"_2810":115252},[],"Solo con `auth_method=static`",{"_3322":68479,"_29016":68398,"_20141":115254,"_5":13774,"_26412":115028,"_2810":115255},[],"Clave de acceso AWS.",{"_3322":68480,"_29016":68398,"_20141":115257,"_5":13774,"_26412":115028,"_2810":51419},[],{"_3322":68481,"_29016":68398,"_20141":115259,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68482,"_29016":68398,"_20141":115261,"_5":13774,"_26412":115028,"_2810":115252},[],{"_3322":68483,"_29016":68398,"_20141":115263,"_5":13774,"_26412":115028,"_2810":115264},[],"Clave secreta AWS.",{"_3322":68484,"_29016":68398,"_20141":115266,"_5":13774,"_26412":115028,"_2810":51429},[],{"_3322":68485,"_29016":68398,"_20141":115268,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68486,"_29016":68398,"_20141":115270,"_5":13774,"_26412":115028,"_2810":51434},[],{"_3322":68487,"_29016":68398,"_20141":115272,"_5":13774,"_26412":115028,"_2810":115273},[],"Token de sesión (con `auth_method=static`).",{"_3322":68488,"_29016":68398,"_20141":115275,"_5":13774,"_26412":115028,"_2810":51440},[],{"_3322":68489,"_29016":68398,"_20141":115277,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68490,"_29016":68398,"_20141":115279,"_5":13774,"_26412":115028,"_2810":115280},[],"Solo con `auth_method=role`",{"_3322":68491,"_29016":68398,"_20141":115282,"_5":13774,"_26412":115028,"_2810":115283},[],"ARN del rol a asumir.",{"_3322":68492,"_29016":68398,"_20141":115285,"_5":13774,"_26412":115028,"_2810":51451},[],{"_3322":68493,"_29016":68398,"_20141":115287,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68494,"_29016":68398,"_20141":115289,"_5":13774,"_26412":115028,"_2810":51434},[],{"_3322":68495,"_29016":68398,"_20141":115291,"_5":13774,"_26412":115028,"_2810":115292},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3322":68496,"_29016":68398,"_20141":115294,"_5":13774,"_26412":115028,"_2810":51461},[],{"_3322":68497,"_29016":68398,"_20141":115296,"_5":13774,"_26412":115028,"_2810":16929},[],{"_3322":68498,"_29016":68398,"_20141":115298,"_5":13774,"_26412":115028,"_2810":115224},[],{"_3322":68499,"_29016":68398,"_20141":115300,"_5":13774,"_26412":115028,"_2810":115301},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3322":68500,"_29016":68398,"_20141":115303,"_5":13774,"_26412":115028,"_2810":51471},[],{"_3322":68501,"_29016":68398,"_20141":115305,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68502,"_29016":68398,"_20141":115307,"_5":13774,"_26412":115028,"_2810":115224},[],{"_3322":68503,"_29016":68398,"_20141":115309,"_5":13774,"_26412":115028,"_2810":115310},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3322":68504,"_29016":68398,"_20141":115312,"_5":13774,"_26412":115028,"_2810":51481},[],{"_3322":68505,"_29016":68398,"_20141":115314,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68506,"_29016":68398,"_20141":115316,"_5":13774,"_26412":115028,"_2810":115224},[],{"_3322":68507,"_29016":68398,"_20141":115318,"_5":13774,"_26412":115028,"_2810":115319},[],"URL HTTP del Device Manager de Lamassu.",{"_3322":68508,"_29016":68398,"_20141":115321,"_5":13774,"_26412":115028,"_2810":51491},[],{"_3322":68509,"_29016":68398,"_20141":115323,"_5":13774,"_26412":115028,"_2810":24054},[],{"_3322":68510,"_29016":68398,"_20141":115325,"_5":13774,"_26412":115028,"_2810":115224},[],{"_3322":68511,"_29016":68398,"_20141":115327,"_5":13774,"_26412":115028,"_2810":115328},[],"URL HTTP del servicio de CA de Lamassu.",{"_3322":68512,"_29016":68398,"_20141":115330,"_5":13774,"_26412":115032,"_2810":115331},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3322":68513,"_29016":68398,"_20141":115333,"_5":13774,"_26412":115036,"_2810":115334},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3322":68514,"_29016":68398,"_20141":115336,"_5":13774,"_26412":115036,"_2810":115337},[],"Tipo de CloudEvent",{"_3322":68515,"_29016":68398,"_20141":115339,"_5":13774,"_26412":115036,"_2810":115340},[],"Recurso en Lamassu",{"_3322":68516,"_29016":68398,"_20141":115342,"_5":13774,"_26412":115036,"_2810":115343},[],"Recurso AWS",{"_3322":68517,"_29016":68398,"_20141":115345,"_5":13774,"_26412":115036,"_2810":115346},[],"Acciones IAM",{"_3322":68518,"_29016":68398,"_20141":115348,"_5":13774,"_26412":115036,"_2810":115349},[],"Llamadas AWS y efecto",{"_3322":68519,"_29016":68398,"_20141":115351,"_5":13774,"_26412":115036,"_2810":115352},[],"Dónde en esta página",{"_3322":68520,"_29016":68398,"_20141":115354,"_5":13774,"_26412":115036,"_2810":51525},[],{"_3322":68521,"_29016":68398,"_20141":115356,"_5":13774,"_26412":115036,"_2810":51528},[],{"_3322":68522,"_29016":68398,"_20141":115358,"_5":13774,"_26412":115036,"_2810":51531},[],{"_3322":68523,"_29016":68398,"_20141":115360,"_5":13774,"_26412":115036,"_2810":51534},[],{"_3322":68524,"_29016":68398,"_20141":115362,"_5":13774,"_26412":115036,"_2810":115363},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3322":68525,"_29016":68398,"_20141":115365,"_5":13774,"_26412":115036,"_2810":115041},[],{"_3322":68526,"_29016":68398,"_20141":115367,"_5":13774,"_26412":115036,"_2810":51542},[],{"_3322":68527,"_29016":68398,"_20141":115369,"_5":13774,"_26412":115036,"_2810":51545},[],{"_3322":68528,"_29016":68398,"_20141":115371,"_5":13774,"_26412":115036,"_2810":51548},[],{"_3322":68529,"_29016":68398,"_20141":115373,"_5":13774,"_26412":115036,"_2810":51551},[],{"_3322":68530,"_29016":68398,"_20141":115375,"_5":13774,"_26412":115036,"_2810":115376},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3322":68531,"_29016":68398,"_20141":115378,"_5":13774,"_26412":115036,"_2810":115045},[],{"_3322":68532,"_29016":68398,"_20141":115380,"_5":13774,"_26412":115036,"_2810":51559},[],{"_3322":68533,"_29016":68398,"_20141":115382,"_5":13774,"_26412":115036,"_2810":115383},[],"Dispositivo",{"_3322":68534,"_29016":68398,"_20141":115385,"_5":13774,"_26412":115036,"_2810":51565},[],{"_3322":68535,"_29016":68398,"_20141":115387,"_5":13774,"_26412":115036,"_2810":51568},[],{"_3322":68536,"_29016":68398,"_20141":115389,"_5":13774,"_26412":115036,"_2810":115390},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3322":68537,"_29016":68398,"_20141":115392,"_5":13774,"_26412":115036,"_2810":115053},[],{"_3322":68538,"_29016":68398,"_20141":115394,"_5":13774,"_26412":115036,"_2810":51576},[],{"_3322":68539,"_29016":68398,"_20141":115396,"_5":13774,"_26412":115036,"_2810":115397},[],"Certificado",{"_3322":68540,"_29016":68398,"_20141":115399,"_5":13774,"_26412":115036,"_2810":51582},[],{"_3322":68541,"_29016":68398,"_20141":115401,"_5":13774,"_26412":115036,"_2810":115402},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3322":68542,"_29016":68398,"_20141":115404,"_5":13774,"_26412":115036,"_2810":115405},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3322":68543,"_29016":68398,"_20141":115407,"_5":13774,"_26412":115036,"_2810":115049},[],{"_3322":68544,"_29016":68398,"_20141":115409,"_5":13774,"_26412":115036,"_2810":51593},[],{"_3322":68545,"_29016":68398,"_20141":115411,"_5":13774,"_26412":115036,"_2810":115412},[],"Certificado / Dispositivo",{"_3322":68546,"_29016":68398,"_20141":115414,"_5":13774,"_26412":115036,"_2810":51599},[],{"_3322":68547,"_29016":68398,"_20141":115416,"_5":13774,"_26412":115036,"_2810":47630},[],{"_3322":68548,"_29016":68398,"_20141":115418,"_5":13774,"_26412":115036,"_2810":115419},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3322":68549,"_29016":68398,"_20141":115421,"_5":13774,"_26412":115036,"_2810":115103},[],{"_3322":68550,"_29016":68398,"_20141":115423,"_5":13774,"_26412":115040,"_2810":115424},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3322":68551,"_29016":68398,"_20141":115426,"_5":13774,"_26412":115040,"_2810":115427},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_3322":68552,"_29016":68398,"_20141":115429,"_5":13774,"_26412":115040,"_2810":115430},[],"Transición",{"_3322":68553,"_29016":68398,"_20141":115432,"_5":13774,"_26412":115040,"_2810":115433},[],"Llamadas AWS",{"_3322":68554,"_29016":68398,"_20141":115435,"_5":13774,"_26412":115040,"_2810":115436},[],"`NoRegistrada` → `Solicitada`",{"_3322":68555,"_29016":68398,"_20141":115438,"_5":13774,"_26412":115040,"_2810":115439},[],"ninguna (solo escritura de metadatos)",{"_3322":68556,"_29016":68398,"_20141":115441,"_5":13774,"_26412":115040,"_2810":115442},[],"`Solicitada` → `Registrando`",{"_3322":68557,"_29016":68398,"_20141":115444,"_5":13774,"_26412":115040,"_2810":115445},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3322":68558,"_29016":68398,"_20141":115447,"_5":13774,"_26412":115040,"_2810":115448},[],"`Registrando` → `Completada`",{"_3322":68559,"_29016":68398,"_20141":115450,"_5":13774,"_26412":115040,"_2810":115451},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3322":68560,"_29016":68398,"_20141":115453,"_5":13774,"_26412":115040,"_2810":115454},[],"`Registrando` → `Fallida`",{"_3322":68561,"_29016":68398,"_20141":115456,"_5":13774,"_26412":115040,"_2810":115457},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3322":68562,"_29016":68398,"_20141":115459,"_5":13774,"_26412":115040,"_2810":115460},[],"`Fallida` / `Completada` → `Solicitada`",{"_3322":68563,"_29016":68398,"_20141":115462,"_5":13774,"_26412":115040,"_2810":115463},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3322":68564,"_29016":68398,"_20141":115465,"_5":13774,"_26412":115044,"_2810":115466},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3322":68565,"_29016":68398,"_20141":115468,"_5":13774,"_26412":115044,"_2810":115430},[],{"_3322":68566,"_29016":68398,"_20141":115470,"_5":13774,"_26412":115044,"_2810":115433},[],{"_3322":68567,"_29016":68398,"_20141":115472,"_5":13774,"_26412":115044,"_2810":115473},[],"`SinConfigurar` → `None` / `Auto`",{"_3322":68568,"_29016":68398,"_20141":115475,"_5":13774,"_26412":115044,"_2810":115476},[],"ninguna (solo configuración)",{"_3322":68569,"_29016":68398,"_20141":115478,"_5":13774,"_26412":115044,"_2810":51664},[],{"_3322":68570,"_29016":68398,"_20141":115480,"_5":13774,"_26412":115044,"_2810":115476},[],{"_3322":68571,"_29016":68398,"_20141":115482,"_5":13774,"_26412":115044,"_2810":115483},[],"Cualquiera → `Jitp`",{"_3322":68572,"_29016":68398,"_20141":115485,"_5":13774,"_26412":115044,"_2810":115486},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3322":68573,"_29016":68398,"_20141":115488,"_5":13774,"_26412":115044,"_2810":51675},[],{"_3322":68574,"_29016":68398,"_20141":115490,"_5":13774,"_26412":115044,"_2810":115491},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3322":68575,"_29016":68398,"_20141":115493,"_5":13774,"_26412":115048,"_2810":115494},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3322":68576,"_29016":68398,"_20141":115496,"_5":13774,"_26412":115048,"_2810":115430},[],{"_3322":68577,"_29016":68398,"_20141":115498,"_5":13774,"_26412":115048,"_2810":115433},[],{"_3322":68578,"_29016":68398,"_20141":115500,"_5":13774,"_26412":115048,"_2810":115501},[],"`NoSincronizado` → `Active`",{"_3322":68579,"_29016":68398,"_20141":115503,"_5":13774,"_26412":115048,"_2810":51332},[],{"_3322":68580,"_29016":68398,"_20141":115505,"_5":13774,"_26412":115048,"_2810":51693},[],{"_3322":68581,"_29016":68398,"_20141":115507,"_5":13774,"_26412":115048,"_2810":115508},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3322":68582,"_29016":68398,"_20141":115510,"_5":13774,"_26412":115048,"_2810":51699},[],{"_3322":68583,"_29016":68398,"_20141":115512,"_5":13774,"_26412":115048,"_2810":115508},[],{"_3322":68584,"_29016":68398,"_20141":115514,"_5":13774,"_26412":115048,"_2810":51704},[],{"_3322":68585,"_29016":68398,"_20141":115516,"_5":13774,"_26412":115048,"_2810":51332},[],{"_3322":68586,"_29016":68398,"_20141":115518,"_5":13774,"_26412":115048,"_2810":51709},[],{"_3322":68587,"_29016":68398,"_20141":115520,"_5":13774,"_26412":115048,"_2810":115521},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3322":68588,"_29016":68398,"_20141":115523,"_5":13774,"_26412":115052,"_2810":115524},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3322":68589,"_29016":68398,"_20141":115526,"_5":13774,"_26412":115052,"_2810":115430},[],{"_3322":68590,"_29016":68398,"_20141":115528,"_5":13774,"_26412":115052,"_2810":115433},[],{"_3322":68591,"_29016":68398,"_20141":115530,"_5":13774,"_26412":115052,"_2810":115531},[],"`Ausente` → `Aprovisionado`",{"_3322":68592,"_29016":68398,"_20141":115533,"_5":13774,"_26412":115052,"_2810":115534},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3322":68593,"_29016":68398,"_20141":115536,"_5":13774,"_26412":115052,"_2810":115537},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3322":68594,"_29016":68398,"_20141":115539,"_5":13774,"_26412":115052,"_2810":115540},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3322":68595,"_29016":68398,"_20141":115542,"_5":13774,"_26412":115052,"_2810":115543},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3322":68596,"_29016":68398,"_20141":115545,"_5":13774,"_26412":115056,"_2810":115546},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3322":68597,"_29016":68398,"_20141":115548,"_5":13774,"_26412":115060,"_2810":115549},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3322":68598,"_29016":68398,"_20141":115551,"_5":13774,"_26412":115060,"_2810":115552},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3322":68599,"_29016":68398,"_20141":115554,"_5":13774,"_26412":115064,"_2810":115555},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3322":68600,"_29016":68398,"_20141":115557,"_5":13774,"_26412":115064,"_2810":115558},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3322":68601,"_29016":68398,"_20141":115560,"_5":13774,"_26412":115064,"_2810":115561},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3322":68602,"_29016":68398,"_20141":115563,"_5":13774,"_26412":115064,"_2810":115564},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3322":68603,"_29016":68398,"_20141":115566,"_5":13774,"_26412":115064,"_2810":115567},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3322":68604,"_29016":68398,"_20141":115569,"_5":13774,"_26412":115064,"_2810":115570},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3322":68605,"_29016":68398,"_20141":115572,"_5":13774,"_26412":115067,"_2810":115573},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3322":68606,"_29016":68398,"_20141":115575,"_5":13774,"_26412":115070,"_2810":115576},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3322":68607,"_29016":68398,"_20141":115578,"_5":13774,"_26412":115070,"_2810":115579},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3322":68608,"_29016":68398,"_20141":115581,"_5":13774,"_26412":115074,"_2810":115582},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3322":68609,"_29016":68398,"_20141":115584,"_5":13774,"_26412":115078,"_2810":115585},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3322":68610,"_29016":68398,"_20141":115587,"_5":13774,"_26412":115078,"_2810":115588},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3322":68611,"_29016":68398,"_20141":115590,"_5":13774,"_26412":115078,"_2810":115591},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3322":68612,"_29016":68398,"_20141":115593,"_5":13774,"_26412":115078,"_2810":115594},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3322":68613,"_29016":68398,"_20141":115596,"_5":13774,"_26412":115078,"_2810":115597},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3322":68614,"_29016":68398,"_20141":115599,"_5":13774,"_26412":115078,"_2810":115600},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3322":68615,"_29016":68398,"_20141":115602,"_5":13774,"_26412":115082,"_2810":115603},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3322":68616,"_29016":68398,"_20141":115605,"_5":13774,"_26412":115082,"_2810":115606},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3322":68617,"_29016":68398,"_20141":115608,"_5":13774,"_26412":115082,"_2810":115609},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3322":68618,"_29016":68398,"_20141":115611,"_5":13774,"_26412":115082,"_2810":115612},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3322":68619,"_29016":68398,"_20141":115614,"_5":13774,"_26412":115082,"_2810":115615},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3322":68620,"_29016":68398,"_20141":115617,"_5":13774,"_26412":115086,"_2810":115618},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3322":68621,"_29016":68398,"_20141":115620,"_5":13774,"_26412":115086,"_2810":115621},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3322":68622,"_29016":68398,"_20141":115623,"_5":13774,"_26412":115086,"_2810":115624},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3322":68623,"_29016":68398,"_20141":115626,"_5":13774,"_26412":115090,"_2810":115627},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3322":68624,"_29016":68398,"_20141":115629,"_5":13774,"_26412":115090,"_2810":115630},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3322":68625,"_29016":68398,"_20141":115632,"_5":13774,"_26412":115090,"_2810":115633},[],"Para que el flujo JITP funcione correctamente:",{"_3322":68626,"_29016":68398,"_20141":115635,"_5":13774,"_26412":115090,"_2810":115636},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3322":68627,"_29016":68398,"_20141":115638,"_5":13774,"_26412":115090,"_2810":115639},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3322":68628,"_29016":68398,"_20141":115641,"_5":13774,"_26412":115090,"_2810":115642},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3322":68629,"_29016":68398,"_20141":115644,"_5":13774,"_26412":115090,"_2810":115645},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3322":68630,"_29016":68398,"_20141":115647,"_5":13774,"_26412":115094,"_2810":115648},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3322":68631,"_29016":68398,"_20141":115650,"_5":13774,"_26412":115094,"_2810":115651},[],"Estado en Lamassu",{"_3322":68632,"_29016":68398,"_20141":115653,"_5":13774,"_26412":115094,"_2810":115654},[],"Razón de revocación",{"_3322":68633,"_29016":68398,"_20141":115656,"_5":13774,"_26412":115094,"_2810":115657},[],"Estado en AWS IoT Core",{"_3322":68634,"_29016":68398,"_20141":115659,"_5":13774,"_26412":115094,"_2810":51854},[],{"_3322":68635,"_29016":68398,"_20141":115661,"_5":13774,"_26412":115094,"_2810":115662},[],"Ninguna",{"_3322":68636,"_29016":68398,"_20141":115664,"_5":13774,"_26412":115094,"_2810":51860},[],{"_3322":68637,"_29016":68398,"_20141":115666,"_5":13774,"_26412":115094,"_2810":51863},[],{"_3322":68638,"_29016":68398,"_20141":115668,"_5":13774,"_26412":115094,"_2810":51866},[],{"_3322":68639,"_29016":68398,"_20141":115670,"_5":13774,"_26412":115094,"_2810":51869},[],{"_3322":68640,"_29016":68398,"_20141":115672,"_5":13774,"_26412":115094,"_2810":51863},[],{"_3322":68641,"_29016":68398,"_20141":115674,"_5":13774,"_26412":115094,"_2810":115675},[],"Cualquier otra razón",{"_3322":68642,"_29016":68398,"_20141":115677,"_5":13774,"_26412":115094,"_2810":51877},[],{"_3322":68643,"_29016":68398,"_20141":115679,"_5":13774,"_26412":115094,"_2810":115680},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3322":68644,"_29016":68398,"_20141":115682,"_5":13774,"_26412":115098,"_2810":115683},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3322":68645,"_29016":68398,"_20141":115685,"_5":13774,"_26412":115098,"_2810":115686},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3322":68646,"_29016":68398,"_20141":115688,"_5":13774,"_26412":115098,"_2810":115689},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3322":68647,"_29016":68398,"_20141":115691,"_5":13774,"_26412":115102,"_2810":115692},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3322":68648,"_29016":68398,"_20141":115694,"_5":13774,"_26412":115102,"_2810":115695},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3322":68649,"_29016":68398,"_20141":115697,"_5":13774,"_26412":115106,"_2810":115698},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3322":68650,"_29016":68398,"_20141":115700,"_5":13774,"_26412":115106,"_2810":115701},[],"Existen dos tipos de acciones:",{"_3322":68651,"_29016":68398,"_20141":115703,"_5":13774,"_26412":115106,"_2810":115704},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3322":68652,"_29016":68398,"_20141":115706,"_5":13774,"_26412":115106,"_2810":115707},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3322":68653,"_29016":68398,"_20141":115709,"_5":13774,"_26412":115106,"_2810":115710},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3322":68654,"_29016":68398,"_20141":115712,"_5":13774,"_26412":115110,"_2810":115713},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3322":68655,"_29016":68398,"_20141":115715,"_5":13774,"_26412":115110,"_2810":115716},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3322":68656,"_29016":68398,"_20141":115718,"_5":13774,"_26412":115110,"_2810":115719},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3322":68657,"_29016":68398,"_20141":115721,"_5":13774,"_26412":115114,"_2810":115722},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3322":68658,"_29016":68398,"_20141":115724,"_5":13774,"_26412":115114,"_2810":115725},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3322":68659,"_29016":68398,"_20141":115727,"_5":13774,"_26412":115114,"_2810":115728},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3322":68660,"_29016":68398,"_20141":115730,"_5":13774,"_26412":115114,"_2810":115731},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3322":68661,"_29016":68398,"_20141":115733,"_5":13774,"_26412":115114,"_2810":115734},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3322":68662,"_29016":68398,"_20141":115736,"_5":13774,"_26412":115114,"_2810":115737},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3322":68663,"_29016":68398,"_20141":115739,"_5":13774,"_26412":115114,"_2810":115740},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3322":68664,"_29016":68398,"_20141":115742,"_5":13774,"_26412":115114,"_2810":115743},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3322":68665,"_29016":68398,"_20141":115745,"_5":13774,"_26412":115114,"_2810":115746},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3322":68666,"_29016":68398,"_20141":115748,"_5":13774,"_26412":115114,"_2810":115749},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3322":68667,"_29016":68398,"_20141":115751,"_5":13774,"_26412":115114,"_2810":115752},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3322":68668,"_29016":68398,"_20141":115754,"_5":13774,"_26412":115114,"_2810":115755},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3322":68669,"_29016":68398,"_20141":115757,"_5":13774,"_26412":115114,"_2810":115758},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3322":68670,"_29016":68398,"_20141":115760,"_5":13774,"_26412":115114,"_2810":115761},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3322":68671,"_29016":68398,"_20141":115763,"_5":13774,"_26412":115114,"_2810":115764},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3322":68672,"_29016":68398,"_20141":115766,"_5":13774,"_26412":115114,"_2810":115767},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3322":68673,"_29016":68398,"_20141":115769,"_5":13774,"_26412":115114,"_2810":115770},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3322":68674,"_29016":68398,"_20141":115772,"_5":13774,"_26412":115114,"_2810":115773},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3322":68675,"_29016":68398,"_20141":115775,"_5":13774,"_26412":115114,"_2810":115776},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3322":68676,"_29016":68398,"_20141":115778,"_5":13774,"_26412":115114,"_2810":115779},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3322":68677,"_29016":68398,"_20141":115781,"_5":13774,"_26412":115114,"_2810":115782},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3322":68678,"_29016":68398,"_20141":115784,"_5":13774,"_26412":115114,"_2810":115785},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3322":68679,"_29016":68398,"_20141":115787,"_5":13774,"_26412":115114,"_2810":115788},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3322":68680,"_29016":68398,"_20141":115790,"_5":13774,"_26412":115114,"_2810":115791},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3322":68681,"_29016":68681,"_5":14132,"_2810":49691,"_29339":115793,"_20141":115794,"_26412":68681},[47234,112596,49691],[],{"_3322":68682,"_29016":68681,"_20141":115796,"_5":13774,"_26412":68681,"_2810":115797},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3322":68683,"_29016":68681,"_5":29336,"_20141":115799,"_26412":115800,"_2810":115801},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3322":68684,"_29016":68681,"_5":29336,"_20141":115803,"_26412":115804,"_2810":113602},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3322":68685,"_29016":68681,"_5":29336,"_20141":115806,"_26412":115807,"_2810":113777},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3322":68686,"_29016":68681,"_5":29336,"_20141":115809,"_26412":115810,"_2810":115009},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3322":68687,"_29016":68681,"_5":29336,"_20141":115812,"_26412":115813,"_2810":115814},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3322":68688,"_29016":68681,"_20141":115816,"_5":13774,"_26412":68681,"_2810":115817},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3322":68689,"_29016":68681,"_20141":115819,"_5":13774,"_26412":115800,"_2810":115820},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3322":68690,"_29016":68681,"_20141":115822,"_5":13774,"_26412":115800,"_2810":115823},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3322":68691,"_29016":68681,"_20141":115825,"_5":13774,"_26412":115804,"_2810":115826},[],"Recurso",{"_3322":68692,"_29016":68681,"_20141":115828,"_5":13774,"_26412":115804,"_2810":115829},[],"Qué representa",{"_3322":68693,"_29016":68681,"_20141":115831,"_5":13774,"_26412":115804,"_2810":115832},[],"**Dispositivo**",{"_3322":68694,"_29016":68681,"_20141":115834,"_5":13774,"_26412":115804,"_2810":115835},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3322":68695,"_29016":68681,"_20141":115837,"_5":13774,"_26412":115804,"_2810":115838},[],"**Identidad**",{"_3322":68696,"_29016":68681,"_20141":115840,"_5":13774,"_26412":115804,"_2810":115841},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3322":68697,"_29016":68681,"_20141":115843,"_5":13774,"_26412":115804,"_2810":52044},[],{"_3322":68698,"_29016":68681,"_20141":115845,"_5":13774,"_26412":115804,"_2810":115846},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3322":68699,"_29016":68681,"_20141":115848,"_5":13774,"_26412":115804,"_2810":115849},[],"**Flota**",{"_3322":68700,"_29016":68681,"_20141":115851,"_5":13774,"_26412":115804,"_2810":115852},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3322":68701,"_29016":68681,"_20141":115854,"_5":13774,"_26412":115804,"_2810":115855},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3322":68702,"_29016":68681,"_20141":115857,"_5":13774,"_26412":115804,"_2810":115858},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3322":68703,"_29016":68681,"_20141":115860,"_5":13774,"_26412":115807,"_2810":115861},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3322":68704,"_29016":68681,"_20141":115863,"_5":13774,"_26412":115807,"_2810":115864},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3322":68705,"_29016":68681,"_20141":115866,"_5":13774,"_26412":115807,"_2810":115867},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3322":68706,"_29016":68681,"_20141":115869,"_5":13774,"_26412":115807,"_2810":115870},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3322":68707,"_29016":68681,"_20141":115872,"_5":13774,"_26412":115807,"_2810":115873},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3322":68708,"_29016":68681,"_20141":115875,"_5":13774,"_26412":115807,"_2810":115876},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3322":68709,"_29016":68681,"_20141":115878,"_5":13774,"_26412":115807,"_2810":115879},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3322":68710,"_29016":68681,"_20141":115881,"_5":13774,"_26412":115807,"_2810":115882},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3322":68711,"_29016":68681,"_20141":115884,"_5":13774,"_26412":115810,"_2810":115885},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3322":68712,"_29016":68681,"_20141":115887,"_5":13774,"_26412":115810,"_2810":115888},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3322":68713,"_29016":68681,"_20141":115890,"_5":13774,"_26412":115813,"_2810":115891},[],"Participante",{"_3322":68714,"_29016":68681,"_20141":115893,"_5":13774,"_26412":115813,"_2810":115894},[],"Responsabilidad",{"_3322":68715,"_29016":68681,"_20141":115896,"_5":13774,"_26412":115813,"_2810":115897},[],"Administrador PKI",{"_3322":68716,"_29016":68681,"_20141":115899,"_5":13774,"_26412":115813,"_2810":115900},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3322":68717,"_29016":68681,"_20141":115902,"_5":13774,"_26412":115813,"_2810":115903},[],"Administrador del aprovisionamiento",{"_3322":68718,"_29016":68681,"_20141":115905,"_5":13774,"_26412":115813,"_2810":115906},[],"DMS, admisión, autenticación por operación e inventario.",{"_3322":68719,"_29016":68681,"_20141":115908,"_5":13774,"_26412":115813,"_2810":115909},[],"Integrador del dispositivo",{"_3322":68720,"_29016":68681,"_20141":115911,"_5":13774,"_26412":115813,"_2810":115912},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3322":68721,"_29016":68681,"_20141":115914,"_5":13774,"_26412":115813,"_2810":115915},[],"Integrador del consumidor",{"_3322":68722,"_29016":68681,"_20141":115917,"_5":13774,"_26412":115813,"_2810":115918},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3322":68723,"_29016":68681,"_20141":115920,"_5":13774,"_26412":115813,"_2810":115921},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3322":68724,"_29016":68724,"_5":14132,"_2810":115923,"_29339":115924,"_20141":115926,"_26412":68724},"Enrola y conecta tu primer dispositivo",[47234,112596,49691,115925],"Primeros pasos",[],{"_3322":68725,"_29016":68724,"_20141":115928,"_5":13774,"_26412":68724,"_2810":115929},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3322":68726,"_29016":68724,"_5":29336,"_20141":115931,"_26412":115932,"_2810":111193},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3322":68727,"_29016":68724,"_5":29336,"_20141":115934,"_26412":115935,"_2810":115936},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3322":68728,"_29016":68724,"_5":29336,"_20141":115938,"_26412":115939,"_2810":115940},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3322":68729,"_29016":68724,"_5":29336,"_20141":115942,"_26412":115943,"_2810":115944},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3322":68730,"_29016":68724,"_5":29336,"_20141":115946,"_26412":115947,"_2810":115948},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3322":68731,"_29016":68724,"_5":29336,"_20141":115950,"_26412":115951,"_2810":115952},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3322":68732,"_29016":68724,"_5":29336,"_20141":115954,"_26412":115955,"_2810":115956},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3322":68733,"_29016":68724,"_5":29336,"_20141":115958,"_26412":115959,"_2810":115960},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3322":68734,"_29016":68724,"_20141":115962,"_5":13774,"_26412":68724,"_2810":115963},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3322":68735,"_29016":68724,"_20141":115965,"_5":13774,"_26412":115932,"_2810":115966},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3322":68736,"_29016":68724,"_20141":115968,"_5":13774,"_26412":115932,"_2810":115969},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3322":68737,"_29016":68724,"_20141":115971,"_5":13774,"_26412":115932,"_2810":115972},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3322":68738,"_29016":68724,"_20141":115974,"_5":13774,"_26412":115932,"_2810":115975},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3322":68739,"_29016":68724,"_20141":115977,"_5":13774,"_26412":115932,"_2810":115978},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3322":68740,"_29016":68724,"_20141":115980,"_5":13774,"_26412":115935,"_2810":115981},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3322":68741,"_29016":68724,"_20141":115983,"_5":13774,"_26412":115935,"_2810":115984},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3322":68742,"_29016":68724,"_20141":115986,"_5":13774,"_26412":115939,"_2810":115987},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3322":68743,"_29016":68724,"_20141":115989,"_5":13774,"_26412":115939,"_2810":115990},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3322":68744,"_29016":68724,"_20141":115992,"_5":13774,"_26412":115939,"_2810":115993},[],"Ajuste",{"_3322":68745,"_29016":68724,"_20141":115995,"_5":13774,"_26412":115939,"_2810":115996},[],"Valor de evaluación",{"_3322":68746,"_29016":68724,"_20141":115998,"_5":13774,"_26412":115939,"_2810":52200},[],{"_3322":68747,"_29016":68724,"_20141":116000,"_5":13774,"_26412":115939,"_2810":116001},[],"Raíz emisora de `device-root.pem`.",{"_3322":68748,"_29016":68724,"_20141":116003,"_5":13774,"_26412":115939,"_2810":113905},[],{"_3322":68749,"_29016":68724,"_20141":116005,"_5":13774,"_26412":115939,"_2810":116006},[],"Perfil final de 1 hora que acabas de preparar.",{"_3322":68750,"_29016":68724,"_20141":116008,"_5":13774,"_26412":115939,"_2810":52211},[],{"_3322":68751,"_29016":68724,"_20141":116010,"_5":13774,"_26412":115939,"_2810":52214},[],{"_3322":68752,"_29016":68724,"_20141":116012,"_5":13774,"_26412":115939,"_2810":52217},[],{"_3322":68753,"_29016":68724,"_20141":116014,"_5":13774,"_26412":115939,"_2810":116015},[],"Habilitado.",{"_3322":68754,"_29016":68724,"_20141":116017,"_5":13774,"_26412":115939,"_2810":52223},[],{"_3322":68755,"_29016":68724,"_20141":116019,"_5":13774,"_26412":115939,"_2810":116020},[],"Deshabilitado; el ID debe ser nuevo.",{"_3322":68756,"_29016":68724,"_20141":116022,"_5":13774,"_26412":115939,"_2810":116023},[],"Autenticación inicial",{"_3322":68757,"_29016":68724,"_20141":116025,"_5":13774,"_26412":115939,"_2810":116026},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3322":68758,"_29016":68724,"_20141":116028,"_5":13774,"_26412":115939,"_2810":116029},[],"Autenticación de renovación",{"_3322":68759,"_29016":68724,"_20141":116031,"_5":13774,"_26412":115939,"_2810":116032},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3322":68760,"_29016":68724,"_20141":116034,"_5":13774,"_26412":115939,"_2810":52241},[],{"_3322":68761,"_29016":68724,"_20141":116036,"_5":13774,"_26412":115939,"_2810":116037},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3322":68762,"_29016":68724,"_20141":116039,"_5":13774,"_26412":115939,"_2810":52247},[],{"_3322":68763,"_29016":68724,"_20141":116041,"_5":13774,"_26412":115939,"_2810":116042},[],"1 hora.",{"_3322":68764,"_29016":68724,"_20141":116044,"_5":13774,"_26412":115939,"_2810":52253},[],{"_3322":68765,"_29016":68724,"_20141":116046,"_5":13774,"_26412":115939,"_2810":116047},[],"30 minutos / 10 minutos.",{"_3322":68766,"_29016":68724,"_20141":116049,"_5":13774,"_26412":115939,"_2810":52259},[],{"_3322":68767,"_29016":68724,"_20141":116051,"_5":13774,"_26412":115939,"_2810":116052},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3322":68768,"_29016":68724,"_20141":116054,"_5":13774,"_26412":115939,"_2810":50010},[],{"_3322":68769,"_29016":68724,"_20141":116056,"_5":13774,"_26412":115939,"_2810":116057},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3322":68770,"_29016":68724,"_20141":116059,"_5":13774,"_26412":115939,"_2810":52270},[],{"_3322":68771,"_29016":68724,"_20141":116061,"_5":13774,"_26412":115939,"_2810":116062},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3322":68772,"_29016":68724,"_20141":116064,"_5":13774,"_26412":115939,"_2810":116065},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3322":68773,"_29016":68724,"_20141":116067,"_5":13774,"_26412":115943,"_2810":116068},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3322":68774,"_29016":68724,"_20141":116070,"_5":13774,"_26412":115943,"_2810":116071},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3322":68775,"_29016":68724,"_20141":116073,"_5":13774,"_26412":115947,"_2810":116074},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3322":68776,"_29016":68724,"_20141":116076,"_5":13774,"_26412":115947,"_2810":116077},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3322":68777,"_29016":68724,"_20141":116079,"_5":13774,"_26412":115947,"_2810":116080},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3322":68778,"_29016":68724,"_20141":116082,"_5":13774,"_26412":115951,"_2810":116083},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3322":68779,"_29016":68724,"_20141":116085,"_5":13774,"_26412":115951,"_2810":116086},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3322":68780,"_29016":68724,"_20141":116088,"_5":13774,"_26412":115955,"_2810":116089},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3322":68781,"_29016":68724,"_20141":116091,"_5":13774,"_26412":115955,"_2810":116092},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3322":68782,"_29016":68724,"_20141":116094,"_5":13774,"_26412":115955,"_2810":116095},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3322":68783,"_29016":68724,"_20141":116097,"_5":13774,"_26412":115955,"_2810":116098},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3322":68784,"_29016":68724,"_20141":116100,"_5":13774,"_26412":115955,"_2810":116101},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3322":68785,"_29016":68724,"_20141":116103,"_5":13774,"_26412":115959,"_2810":116104},[],"Comprobación",{"_3322":68786,"_29016":68724,"_20141":116106,"_5":13774,"_26412":115959,"_2810":116107},[],"Resultado esperado",{"_3322":68787,"_29016":68724,"_20141":116109,"_5":13774,"_26412":115959,"_2810":116110},[],"Registro",{"_3322":68788,"_29016":68724,"_20141":116112,"_5":13774,"_26412":115959,"_2810":116113},[],"ID creado automáticamente y DMS correcto.",{"_3322":68789,"_29016":68724,"_20141":116115,"_5":13774,"_26412":115959,"_2810":115397},[],{"_3322":68790,"_29016":68724,"_20141":116117,"_5":13774,"_26412":115959,"_2810":116118},[],"CN, perfil, serie y clave verificados.",{"_3322":68791,"_29016":68724,"_20141":116120,"_5":13774,"_26412":115959,"_2810":116121},[],"Inventario",{"_3322":68792,"_29016":68724,"_20141":116123,"_5":13774,"_26412":115959,"_2810":116124},[],"Serie recibida visible como identidad actual y en el historial.",{"_3322":68793,"_29016":68724,"_20141":116126,"_5":13774,"_26412":115959,"_2810":116127},[],"Consumidor",{"_3322":68794,"_29016":68724,"_20141":116129,"_5":13774,"_26412":115959,"_2810":116130},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3322":68795,"_29016":68724,"_20141":116132,"_5":13774,"_26412":115959,"_2810":116133},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3322":68796,"_29016":68724,"_20141":116135,"_5":13774,"_26412":115959,"_2810":116136},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3322":68797,"_29016":68797,"_5":14132,"_2810":113619,"_29339":116138,"_20141":116139,"_26412":68797},[47234,112596,49691,115925],[],{"_3322":68798,"_29016":68797,"_20141":116141,"_5":13774,"_26412":68797,"_2810":116142},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3322":68799,"_29016":68797,"_5":29336,"_20141":116144,"_26412":116145,"_2810":111193},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3322":68800,"_29016":68797,"_5":29336,"_20141":116147,"_26412":116148,"_2810":116149},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3322":68801,"_29016":68797,"_5":29336,"_20141":116151,"_26412":116152,"_2810":116153},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3322":68802,"_29016":68797,"_5":29336,"_20141":116155,"_26412":116156,"_2810":116157},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3322":68803,"_29016":68797,"_5":29336,"_20141":116159,"_26412":116160,"_2810":116161},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3322":68804,"_29016":68797,"_5":29336,"_20141":116163,"_26412":116164,"_2810":116165},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3322":68805,"_29016":68797,"_5":29336,"_20141":116167,"_26412":116168,"_2810":116107},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3322":68806,"_29016":68797,"_5":29336,"_20141":116170,"_26412":116171,"_2810":116172},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3322":68807,"_29016":68797,"_5":29336,"_20141":116174,"_26412":116175,"_2810":116176},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3322":68808,"_29016":68797,"_20141":116178,"_5":13774,"_26412":68797,"_2810":116179},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3322":68809,"_29016":68797,"_20141":116181,"_5":13774,"_26412":68797,"_2810":116182},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3322":68810,"_29016":68797,"_20141":116184,"_5":13774,"_26412":116145,"_2810":116185},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3322":68811,"_29016":68797,"_20141":116187,"_5":13774,"_26412":116145,"_2810":116188},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3322":68812,"_29016":68797,"_20141":116190,"_5":13774,"_26412":116145,"_2810":116191},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3322":68813,"_29016":68797,"_20141":116193,"_5":13774,"_26412":116145,"_2810":116194},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3322":68814,"_29016":68797,"_20141":116196,"_5":13774,"_26412":116148,"_2810":116197},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3322":68815,"_29016":68797,"_20141":116199,"_5":13774,"_26412":116148,"_2810":116200},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3322":68816,"_29016":68797,"_20141":116202,"_5":13774,"_26412":116148,"_2810":116203},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3322":68817,"_29016":68797,"_20141":116205,"_5":13774,"_26412":116148,"_2810":116206},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3322":68818,"_29016":68797,"_20141":116208,"_5":13774,"_26412":116148,"_2810":116209},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3322":68819,"_29016":68797,"_20141":116211,"_5":13774,"_26412":116148,"_2810":116212},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3322":68820,"_29016":68797,"_20141":116214,"_5":13774,"_26412":116148,"_2810":116215},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3322":68821,"_29016":68797,"_20141":116217,"_5":13774,"_26412":116148,"_2810":116218},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3322":68822,"_29016":68797,"_20141":116220,"_5":13774,"_26412":116152,"_2810":116221},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3322":68823,"_29016":68797,"_20141":116223,"_5":13774,"_26412":116152,"_2810":52435},[],{"_3322":68824,"_29016":68797,"_20141":116225,"_5":13774,"_26412":116152,"_2810":116226},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3322":68825,"_29016":68797,"_20141":116228,"_5":13774,"_26412":116152,"_2810":116229},[],"**Icon** y **Tags**: clasificación opcional.",{"_3322":68826,"_29016":68797,"_20141":116231,"_5":13774,"_26412":116152,"_2810":116232},[],"Confirma el registro.",{"_3322":68827,"_29016":68797,"_20141":116234,"_5":13774,"_26412":116156,"_2810":116235},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3322":68828,"_29016":68797,"_20141":116237,"_5":13774,"_26412":116156,"_2810":116238},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3322":68829,"_29016":68797,"_20141":116240,"_5":13774,"_26412":116160,"_2810":116241},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3322":68830,"_29016":68797,"_20141":116243,"_5":13774,"_26412":116160,"_2810":116244},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3322":68831,"_29016":68797,"_20141":116246,"_5":13774,"_26412":116164,"_2810":116247},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3322":68832,"_29016":68797,"_20141":116249,"_5":13774,"_26412":116164,"_2810":116250},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3322":68833,"_29016":68797,"_20141":116252,"_5":13774,"_26412":116168,"_2810":116104},[],{"_3322":68834,"_29016":68797,"_20141":116254,"_5":13774,"_26412":116168,"_2810":116255},[],"Resultado",{"_3322":68835,"_29016":68797,"_20141":116257,"_5":13774,"_26412":116168,"_2810":115383},[],{"_3322":68836,"_29016":68797,"_20141":116259,"_5":13774,"_26412":116168,"_2810":116260},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3322":68837,"_29016":68797,"_20141":116262,"_5":13774,"_26412":116168,"_2810":116263},[],"Identidad actual",{"_3322":68838,"_29016":68797,"_20141":116265,"_5":13774,"_26412":116168,"_2810":116266},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3322":68839,"_29016":68797,"_20141":116268,"_5":13774,"_26412":116168,"_2810":116269},[],"Historial",{"_3322":68840,"_29016":68797,"_20141":116271,"_5":13774,"_26412":116168,"_2810":116272},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3322":68841,"_29016":68797,"_20141":116274,"_5":13774,"_26412":116168,"_2810":116275},[],"Clave y certificado",{"_3322":68842,"_29016":68797,"_20141":116277,"_5":13774,"_26412":116168,"_2810":116278},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3322":68843,"_29016":68797,"_20141":116280,"_5":13774,"_26412":116171,"_2810":116281},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3322":68844,"_29016":68797,"_20141":116283,"_5":13774,"_26412":116171,"_2810":116284},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3322":68845,"_29016":68797,"_20141":116286,"_5":13774,"_26412":116171,"_2810":116287},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3322":68846,"_29016":68797,"_20141":116289,"_5":13774,"_26412":116171,"_2810":116290},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3322":68847,"_29016":68797,"_20141":116292,"_5":13774,"_26412":116175,"_2810":116293},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3322":68848,"_29016":68797,"_20141":116295,"_5":13774,"_26412":116175,"_2810":116296},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3322":68849,"_29016":68797,"_20141":116298,"_5":13774,"_26412":116175,"_2810":116299},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3322":68850,"_29016":68850,"_5":14132,"_2810":116301,"_29339":116302,"_20141":116303,"_26412":68850},"Plataforma Lamassu IoT",[47234,112596],[],{"_3322":68851,"_29016":68850,"_20141":116305,"_5":13774,"_26412":68850,"_2810":116306},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3322":68852,"_29016":68850,"_5":29336,"_20141":116308,"_26412":116309,"_2810":115801},[],"/docs/es/platform/overview#empieza-aquí",{"_3322":68853,"_29016":68850,"_5":29336,"_20141":116311,"_26412":116312,"_2810":116313},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3322":68854,"_29016":68850,"_5":29336,"_20141":116315,"_26412":116316,"_2810":116317},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3322":68855,"_29016":68850,"_5":29336,"_20141":116319,"_26412":116320,"_2810":116321},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3322":68856,"_29016":68850,"_5":29336,"_20141":116323,"_26412":116324,"_2810":116325},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3322":68857,"_29016":68850,"_5":29336,"_20141":116327,"_26412":116328,"_2810":116329},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3322":68858,"_29016":68850,"_5":29336,"_20141":116331,"_26412":116332,"_2810":116333},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3322":68859,"_29016":68850,"_5":29336,"_20141":116335,"_26412":116336,"_2810":116337},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3322":68860,"_29016":68850,"_5":29336,"_20141":116339,"_26412":116340,"_2810":116341},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3322":68861,"_29016":68850,"_5":29336,"_20141":116343,"_26412":116344,"_2810":116345},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3322":68862,"_29016":68850,"_5":29336,"_20141":116347,"_26412":116348,"_2810":116349},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3322":68863,"_29016":68850,"_20141":116351,"_5":13774,"_26412":68850,"_2810":116352},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3322":68864,"_29016":68850,"_20141":116354,"_5":13774,"_26412":116309,"_2810":116355},[],"Elige el resultado que necesitas obtener:",{"_3322":68865,"_29016":68850,"_20141":116357,"_5":13774,"_26412":116309,"_2810":116358},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3322":68866,"_29016":68850,"_20141":116360,"_5":13774,"_26412":116309,"_2810":116361},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3322":68867,"_29016":68850,"_20141":116363,"_5":13774,"_26412":116309,"_2810":116364},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3322":68868,"_29016":68850,"_20141":116366,"_5":13774,"_26412":116312,"_2810":116367},[],"Bloque",{"_3322":68869,"_29016":68850,"_20141":116369,"_5":13774,"_26412":116312,"_2810":116370},[],"Qué gestionas",{"_3322":68870,"_29016":68850,"_20141":116372,"_5":13774,"_26412":116312,"_2810":116373},[],"Punto de entrada",{"_3322":68871,"_29016":68850,"_20141":116375,"_5":13774,"_26412":116312,"_2810":52588},[],{"_3322":68872,"_29016":68850,"_20141":116377,"_5":13774,"_26412":116312,"_2810":116378},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3322":68873,"_29016":68850,"_20141":116380,"_5":13774,"_26412":116312,"_2810":116381},[],"Visión general de PKI",{"_3322":68874,"_29016":68850,"_20141":116383,"_5":13774,"_26412":116312,"_2810":52597},[],{"_3322":68875,"_29016":68850,"_20141":116385,"_5":13774,"_26412":116312,"_2810":116386},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3322":68876,"_29016":68850,"_20141":116388,"_5":13774,"_26412":116312,"_2810":116389},[],"Visión general de IoT Fleets",{"_3322":68877,"_29016":68850,"_20141":116391,"_5":13774,"_26412":116312,"_2810":116392},[],"**Administración**",{"_3322":68878,"_29016":68850,"_20141":116394,"_5":13774,"_26412":116312,"_2810":116395},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3322":68879,"_29016":68850,"_20141":116397,"_5":13774,"_26412":116312,"_2810":112594},[],{"_3322":68880,"_29016":68850,"_20141":116399,"_5":13774,"_26412":116312,"_2810":116400},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3322":68881,"_29016":68850,"_20141":116402,"_5":13774,"_26412":116316,"_2810":116403},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3322":68882,"_29016":68850,"_20141":116405,"_5":13774,"_26412":116316,"_2810":116406},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3322":68883,"_29016":68850,"_20141":116408,"_5":13774,"_26412":116316,"_2810":116409},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3322":68884,"_29016":68850,"_20141":116411,"_5":13774,"_26412":116316,"_2810":116412},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3322":68885,"_29016":68850,"_20141":116414,"_5":13774,"_26412":116316,"_2810":116415},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3322":68886,"_29016":68850,"_20141":116417,"_5":13774,"_26412":116316,"_2810":116418},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3322":68887,"_29016":68850,"_20141":116420,"_5":13774,"_26412":116324,"_2810":116421},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3322":68888,"_29016":68850,"_20141":116423,"_5":13774,"_26412":116328,"_2810":116424},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3322":68889,"_29016":68850,"_20141":116426,"_5":13774,"_26412":116332,"_2810":116427},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3322":68890,"_29016":68850,"_20141":116429,"_5":13774,"_26412":116336,"_2810":116430},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3322":68891,"_29016":68850,"_20141":116432,"_5":13774,"_26412":116340,"_2810":116433},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3322":68892,"_29016":68850,"_20141":116435,"_5":13774,"_26412":116344,"_2810":116436},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3322":68893,"_29016":68850,"_20141":116438,"_5":13774,"_26412":116348,"_2810":115894},[],{"_3322":68894,"_29016":68850,"_20141":116440,"_5":13774,"_26412":116348,"_2810":116441},[],"Qué prepara o comprueba",{"_3322":68895,"_29016":68850,"_20141":116443,"_5":13774,"_26412":116348,"_2810":115897},[],{"_3322":68896,"_29016":68850,"_20141":116445,"_5":13774,"_26412":116348,"_2810":116446},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3322":68897,"_29016":68850,"_20141":116448,"_5":13774,"_26412":116348,"_2810":116449},[],"Administrador de la flota",{"_3322":68898,"_29016":68850,"_20141":116451,"_5":13774,"_26412":116348,"_2810":116452},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3322":68899,"_29016":68850,"_20141":116454,"_5":13774,"_26412":116348,"_2810":115909},[],{"_3322":68900,"_29016":68850,"_20141":116456,"_5":13774,"_26412":116348,"_2810":116457},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3322":68901,"_29016":68850,"_20141":116459,"_5":13774,"_26412":116348,"_2810":115915},[],{"_3322":68902,"_29016":68850,"_20141":116461,"_5":13774,"_26412":116348,"_2810":116462},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3322":68903,"_29016":68850,"_20141":116464,"_5":13774,"_26412":116348,"_2810":116465},[],"Operador de infraestructura",{"_3322":68904,"_29016":68850,"_20141":116467,"_5":13774,"_26412":116348,"_2810":116468},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3322":68905,"_29016":68850,"_20141":116470,"_5":13774,"_26412":116348,"_2810":116471},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3322":68906,"_29016":68906,"_5":14132,"_2810":116473,"_29339":116474,"_20141":116476,"_26412":68906},"Jerarquía y rotación de CAs",[47234,112596,52689,116475],"Claves, autoridades y certificados",[],{"_3322":68907,"_29016":68906,"_20141":116478,"_5":13774,"_26412":68906,"_2810":116479},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3322":68908,"_29016":68906,"_5":29336,"_20141":116481,"_26412":116482,"_2810":116483},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3322":68909,"_29016":68906,"_5":29336,"_20141":116485,"_26412":116486,"_2810":116487},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3322":68910,"_29016":68906,"_5":29336,"_20141":116489,"_26412":116490,"_2810":116491},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3322":68911,"_29016":68906,"_5":29336,"_20141":116493,"_26412":116494,"_2810":116495},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3322":68912,"_29016":68906,"_5":29336,"_20141":116497,"_26412":116498,"_2810":116499},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3322":68913,"_29016":68906,"_5":29336,"_20141":116501,"_26412":116502,"_2810":116503},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3322":68914,"_29016":68906,"_5":29336,"_20141":116505,"_26412":116506,"_2810":116507},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3322":68915,"_29016":68906,"_5":29336,"_20141":116509,"_26412":116510,"_2810":116511},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3322":68916,"_29016":68906,"_5":29336,"_20141":116513,"_26412":116514,"_2810":116515},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3322":68917,"_29016":68906,"_5":29336,"_20141":116517,"_26412":116518,"_2810":116519},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3322":68918,"_29016":68906,"_5":29336,"_20141":116521,"_26412":116522,"_2810":116523},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3322":68919,"_29016":68906,"_5":29336,"_20141":116525,"_26412":116526,"_2810":116527},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3322":68920,"_29016":68906,"_20141":116529,"_5":13774,"_26412":68906,"_2810":116530},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3322":68921,"_29016":68906,"_20141":116532,"_5":13774,"_26412":68906,"_2810":116533},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3322":68922,"_29016":68906,"_20141":116535,"_5":13774,"_26412":116482,"_2810":116536},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3322":68923,"_29016":68906,"_20141":116538,"_5":13774,"_26412":116482,"_2810":116539},[],"entorno, como producción y preproducción;",{"_3322":68924,"_29016":68906,"_20141":116541,"_5":13774,"_26412":116482,"_2810":116542},[],"propietario o equipo operador;",{"_3322":68925,"_29016":68906,"_20141":116544,"_5":13774,"_26412":116482,"_2810":116545},[],"familia de dispositivos o proceso de fabricación;",{"_3322":68926,"_29016":68906,"_20141":116547,"_5":13774,"_26412":116482,"_2810":116548},[],"región o requisito regulatorio;",{"_3322":68927,"_29016":68906,"_20141":116550,"_5":13774,"_26412":116482,"_2810":116551},[],"motor criptográfico o política de clave;",{"_3322":68928,"_29016":68906,"_20141":116553,"_5":13774,"_26412":116482,"_2810":116554},[],"ventana de mantenimiento y ritmo de renovación.",{"_3322":68929,"_29016":68906,"_20141":116556,"_5":13774,"_26412":116482,"_2810":116557},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3322":68930,"_29016":68906,"_20141":116559,"_5":13774,"_26412":116482,"_2810":116560},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3322":68931,"_29016":68906,"_20141":116562,"_5":13774,"_26412":116486,"_2810":116563},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3322":68932,"_29016":68906,"_20141":116565,"_5":13774,"_26412":116486,"_2810":116566},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3322":68933,"_29016":68906,"_20141":116568,"_5":13774,"_26412":116486,"_2810":116569},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3322":68934,"_29016":68906,"_20141":116571,"_5":13774,"_26412":116490,"_2810":116572},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3322":68935,"_29016":68906,"_20141":116574,"_5":13774,"_26412":116490,"_2810":116575},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3322":68936,"_29016":68906,"_20141":116577,"_5":13774,"_26412":116490,"_2810":116578},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3322":68937,"_29016":68906,"_20141":116580,"_5":13774,"_26412":116490,"_2810":116581},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3322":68938,"_29016":68906,"_20141":116583,"_5":13774,"_26412":116498,"_2810":116584},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3322":68939,"_29016":68906,"_20141":116586,"_5":13774,"_26412":116502,"_2810":116587},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3322":68940,"_29016":68906,"_20141":116589,"_5":13774,"_26412":116506,"_2810":116590},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3322":68941,"_29016":68906,"_20141":116592,"_5":13774,"_26412":116510,"_2810":116593},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3322":68942,"_29016":68906,"_20141":116595,"_5":13774,"_26412":116514,"_2810":116596},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3322":68943,"_29016":68906,"_20141":116598,"_5":13774,"_26412":116518,"_2810":116599},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3322":68944,"_29016":68906,"_20141":116601,"_5":13774,"_26412":116522,"_2810":116602},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3322":68945,"_29016":68906,"_20141":116604,"_5":13774,"_26412":116522,"_2810":116605},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3322":68946,"_29016":68906,"_20141":116607,"_5":13774,"_26412":116522,"_2810":116608},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3322":68947,"_29016":68906,"_20141":116610,"_5":13774,"_26412":116522,"_2810":116611},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3322":68948,"_29016":68906,"_20141":116613,"_5":13774,"_26412":116526,"_2810":116614},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3322":68949,"_29016":68906,"_20141":116616,"_5":13774,"_26412":116526,"_2810":116617},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3322":68950,"_29016":68906,"_20141":116619,"_5":13774,"_26412":116526,"_2810":116620},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3322":68951,"_29016":68906,"_20141":116622,"_5":13774,"_26412":116526,"_2810":116623},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3322":68952,"_29016":68906,"_20141":116625,"_5":13774,"_26412":116526,"_2810":116626},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3322":68953,"_29016":68906,"_20141":116628,"_5":13774,"_26412":116526,"_2810":116629},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3322":68954,"_29016":68906,"_20141":116631,"_5":13774,"_26412":116526,"_2810":116632},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3322":68955,"_29016":68955,"_5":14132,"_2810":116634,"_29339":116635,"_20141":116636,"_26412":68955},"Autoridades de certificación",[47234,112596,52689,116475],[],{"_3322":68956,"_29016":68955,"_20141":116638,"_5":13774,"_26412":68955,"_2810":116639},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3322":68957,"_29016":68955,"_5":29336,"_20141":116641,"_26412":116642,"_2810":116643},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3322":68958,"_29016":68955,"_5":29336,"_20141":116645,"_26412":116646,"_2810":116647},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3322":68959,"_29016":68955,"_5":29336,"_20141":116649,"_26412":116650,"_2810":111193},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3322":68960,"_29016":68955,"_5":29336,"_20141":116652,"_26412":116653,"_2810":116654},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3322":68961,"_29016":68955,"_5":29336,"_20141":116656,"_26412":116657,"_2810":116658},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3322":68962,"_29016":68955,"_5":29336,"_20141":116660,"_26412":116661,"_2810":116662},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3322":68963,"_29016":68955,"_5":29336,"_20141":116664,"_26412":116665,"_2810":116666},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3322":68964,"_29016":68955,"_5":29336,"_20141":116668,"_26412":116669,"_2810":116670},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3322":68965,"_29016":68955,"_5":29336,"_20141":116672,"_26412":116673,"_2810":116674},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3322":68966,"_29016":68955,"_5":29336,"_20141":116676,"_26412":116677,"_2810":116678},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3322":68967,"_29016":68955,"_5":29336,"_20141":116680,"_26412":116681,"_2810":116682},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3322":68968,"_29016":68955,"_5":29336,"_20141":116684,"_26412":116685,"_2810":116686},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3322":68969,"_29016":68955,"_5":29336,"_20141":116688,"_26412":116689,"_2810":116690},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3322":68970,"_29016":68955,"_5":29336,"_20141":116692,"_26412":116693,"_2810":116694},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3322":68971,"_29016":68955,"_5":29336,"_20141":116696,"_26412":116697,"_2810":116698},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3322":68972,"_29016":68955,"_5":29336,"_20141":116700,"_26412":116701,"_2810":116702},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3322":68973,"_29016":68955,"_5":29336,"_20141":116704,"_26412":116705,"_2810":116706},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3322":68974,"_29016":68955,"_5":29336,"_20141":116708,"_26412":116709,"_2810":116710},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3322":68975,"_29016":68955,"_5":29336,"_20141":116712,"_26412":116713,"_2810":116714},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3322":68976,"_29016":68955,"_5":29336,"_20141":116716,"_26412":116717,"_2810":116718},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3322":68977,"_29016":68955,"_5":29336,"_20141":116720,"_26412":116721,"_2810":116722},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3322":68978,"_29016":68955,"_5":29336,"_20141":116724,"_26412":116725,"_2810":116726},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3322":68979,"_29016":68955,"_5":29336,"_20141":116728,"_26412":116729,"_2810":116730},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3322":68980,"_29016":68955,"_20141":116732,"_5":13774,"_26412":68955,"_2810":116733},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3322":68981,"_29016":68955,"_20141":116735,"_5":13774,"_26412":68955,"_2810":116736},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3322":68982,"_29016":68955,"_20141":116738,"_5":13774,"_26412":68955,"_2810":116739},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3322":68983,"_29016":68955,"_20141":116741,"_5":13774,"_26412":116642,"_2810":116742},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3322":68984,"_29016":68955,"_20141":116744,"_5":13774,"_26412":116642,"_2810":116745},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3322":68985,"_29016":68955,"_20141":116747,"_5":13774,"_26412":116642,"_2810":116748},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3322":68986,"_29016":68955,"_20141":116750,"_5":13774,"_26412":116642,"_2810":116751},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3322":68987,"_29016":68955,"_20141":116753,"_5":13774,"_26412":116642,"_2810":116754},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3322":68988,"_29016":68955,"_20141":116756,"_5":13774,"_26412":116650,"_2810":116757},[],"Decide si la CA será raíz o intermedia.",{"_3322":68989,"_29016":68955,"_20141":116759,"_5":13774,"_26412":116650,"_2810":116760},[],"Elige el motor que custodiará la clave.",{"_3322":68990,"_29016":68955,"_20141":116762,"_5":13774,"_26412":116650,"_2810":116763},[],"Define una validez superior a la de los certificados que emitirá.",{"_3322":68991,"_29016":68955,"_20141":116765,"_5":13774,"_26412":116650,"_2810":116766},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3322":68992,"_29016":68955,"_20141":116768,"_5":13774,"_26412":116653,"_2810":116769},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3322":68993,"_29016":68955,"_20141":116771,"_5":13774,"_26412":116657,"_2810":116772},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3322":68994,"_29016":68955,"_20141":116774,"_5":13774,"_26412":116657,"_2810":116775},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3322":68995,"_29016":68955,"_20141":116777,"_5":13774,"_26412":116661,"_2810":116778},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3322":68996,"_29016":68955,"_20141":116780,"_5":13774,"_26412":116665,"_2810":116781},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3322":68997,"_29016":68955,"_20141":116783,"_5":13774,"_26412":116665,"_2810":116784},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3322":68998,"_29016":68955,"_20141":116786,"_5":13774,"_26412":116665,"_2810":116787},[],"`ST`: estado o provincia.",{"_3322":68999,"_29016":68955,"_20141":116789,"_5":13774,"_26412":116665,"_2810":116790},[],"`L`: localidad.",{"_3322":69000,"_29016":68955,"_20141":116792,"_5":13774,"_26412":116665,"_2810":116793},[],"`O`: organización.",{"_3322":69001,"_29016":68955,"_20141":116795,"_5":13774,"_26412":116665,"_2810":116796},[],"`OU`: unidad organizativa.",{"_3322":69002,"_29016":68955,"_20141":116798,"_5":13774,"_26412":116665,"_2810":116799},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3322":69003,"_29016":68955,"_20141":116801,"_5":13774,"_26412":116669,"_2810":116802},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3322":69004,"_29016":68955,"_20141":116804,"_5":13774,"_26412":116669,"_2810":116805},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3322":69005,"_29016":68955,"_20141":116807,"_5":13774,"_26412":116673,"_2810":116808},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3322":69006,"_29016":68955,"_20141":116810,"_5":13774,"_26412":116673,"_2810":116811},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3322":69007,"_29016":68955,"_20141":116813,"_5":13774,"_26412":116677,"_2810":116814},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3322":69008,"_29016":68955,"_20141":116816,"_5":13774,"_26412":116677,"_2810":116817},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3322":69009,"_29016":68955,"_20141":116819,"_5":13774,"_26412":116681,"_2810":116820},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3322":69010,"_29016":68955,"_20141":116822,"_5":13774,"_26412":116685,"_2810":116823},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3322":69011,"_29016":68955,"_20141":116825,"_5":13774,"_26412":116689,"_2810":116826},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3322":69012,"_29016":68955,"_20141":116828,"_5":13774,"_26412":116693,"_2810":116829},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3322":69013,"_29016":68955,"_20141":116831,"_5":13774,"_26412":116697,"_2810":116832},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3322":69014,"_29016":68955,"_20141":116834,"_5":13774,"_26412":116697,"_2810":116835},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3322":69015,"_29016":68955,"_20141":116837,"_5":13774,"_26412":116701,"_2810":116838},[],"Abre una CA desde el inventario para consultar:",{"_3322":69016,"_29016":68955,"_20141":116840,"_5":13774,"_26412":116701,"_2810":116841},[],"Estado y periodo de validez.",{"_3322":69017,"_29016":68955,"_20141":116843,"_5":13774,"_26412":116701,"_2810":116844},[],"Certificado y cadena en formato PEM.",{"_3322":69018,"_29016":68955,"_20141":116846,"_5":13774,"_26412":116701,"_2810":116847},[],"Número de certificados activos, expirados y revocados.",{"_3322":69019,"_29016":68955,"_20141":116849,"_5":13774,"_26412":116701,"_2810":116850},[],"Certificados emitidos en **Issued Certificates**.",{"_3322":69020,"_29016":68955,"_20141":116852,"_5":13774,"_26412":116701,"_2810":116853},[],"CRL vinculada a la autoridad.",{"_3322":69021,"_29016":68955,"_20141":116855,"_5":13774,"_26412":116701,"_2810":116856},[],"Metadatos y motor criptográfico asociado.",{"_3322":69022,"_29016":68955,"_20141":116858,"_5":13774,"_26412":116701,"_2810":116859},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3322":69023,"_29016":68955,"_20141":116861,"_5":13774,"_26412":116705,"_2810":116862},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3322":69024,"_29016":68955,"_20141":116864,"_5":13774,"_26412":116705,"_2810":116865},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3322":69025,"_29016":68955,"_20141":116867,"_5":13774,"_26412":116705,"_2810":116868},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3322":69026,"_29016":68955,"_20141":116870,"_5":13774,"_26412":116705,"_2810":116871},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3322":69027,"_29016":68955,"_20141":116873,"_5":13774,"_26412":116709,"_2810":116874},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3322":69028,"_29016":68955,"_20141":116876,"_5":13774,"_26412":116713,"_2810":116877},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3322":69029,"_29016":68955,"_20141":116879,"_5":13774,"_26412":116717,"_2810":116880},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3322":69030,"_29016":68955,"_20141":116882,"_5":13774,"_26412":116721,"_2810":116883},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3322":69031,"_29016":68955,"_20141":116885,"_5":13774,"_26412":116725,"_2810":116886},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3322":69032,"_29016":68955,"_20141":116888,"_5":13774,"_26412":116729,"_2810":116889},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3322":69033,"_29016":68955,"_20141":116891,"_5":13774,"_26412":116729,"_2810":116892},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3322":69034,"_29016":68955,"_20141":116894,"_5":13774,"_26412":116729,"_2810":116895},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3322":69035,"_29016":69035,"_5":14132,"_2810":116897,"_29339":116898,"_20141":116899,"_26412":69035},"Perfiles de certificado",[47234,112596,52689,116475],[],{"_3322":69036,"_29016":69035,"_20141":116901,"_5":13774,"_26412":69035,"_2810":116902},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3322":69037,"_29016":69035,"_5":29336,"_20141":116904,"_26412":116905,"_2810":116906},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3322":69038,"_29016":69035,"_5":29336,"_20141":116908,"_26412":116909,"_2810":116910},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3322":69039,"_29016":69035,"_5":29336,"_20141":116912,"_26412":116913,"_2810":116914},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3322":69040,"_29016":69035,"_5":29336,"_20141":116916,"_26412":116917,"_2810":116918},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3322":69041,"_29016":69035,"_5":29336,"_20141":116920,"_26412":116921,"_2810":116922},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3322":69042,"_29016":69035,"_5":29336,"_20141":116924,"_26412":116925,"_2810":116926},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3322":69043,"_29016":69035,"_5":29336,"_20141":116928,"_26412":116929,"_2810":116930},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3322":69044,"_29016":69035,"_5":29336,"_20141":116932,"_26412":116933,"_2810":116934},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3322":69045,"_29016":69035,"_5":29336,"_20141":116936,"_26412":116937,"_2810":116938},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3322":69046,"_29016":69035,"_5":29336,"_20141":116940,"_26412":116941,"_2810":116942},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3322":69047,"_29016":69035,"_5":29336,"_20141":116944,"_26412":116945,"_2810":116946},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3322":69048,"_29016":69035,"_5":29336,"_20141":116948,"_26412":116949,"_2810":116950},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3322":69049,"_29016":69035,"_5":29336,"_20141":116952,"_26412":116953,"_2810":116954},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3322":69050,"_29016":69035,"_5":29336,"_20141":116956,"_26412":116957,"_2810":116958},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3322":69051,"_29016":69035,"_5":29336,"_20141":116960,"_26412":116961,"_2810":116962},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3322":69052,"_29016":69035,"_5":29336,"_20141":116964,"_26412":116965,"_2810":116966},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3322":69053,"_29016":69035,"_20141":116968,"_5":13774,"_26412":69035,"_2810":116969},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3322":69054,"_29016":69035,"_20141":116971,"_5":13774,"_26412":69035,"_2810":116972},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3322":69055,"_29016":69035,"_20141":116974,"_5":13774,"_26412":116909,"_2810":116975},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3322":69056,"_29016":69035,"_20141":116977,"_5":13774,"_26412":116909,"_2810":116978},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3322":69057,"_29016":69035,"_20141":116980,"_5":13774,"_26412":116913,"_2810":116981},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3322":69058,"_29016":69035,"_20141":116983,"_5":13774,"_26412":116917,"_2810":116984},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3322":69059,"_29016":69035,"_20141":116986,"_5":13774,"_26412":116917,"_2810":116987},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3322":69060,"_29016":69035,"_20141":116989,"_5":13774,"_26412":116917,"_2810":116990},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3322":69061,"_29016":69035,"_20141":116992,"_5":13774,"_26412":116921,"_2810":116993},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3322":69062,"_29016":69035,"_20141":116995,"_5":13774,"_26412":116925,"_2810":116996},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3322":69063,"_29016":69035,"_20141":116998,"_5":13774,"_26412":116925,"_2810":116999},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3322":69064,"_29016":69035,"_20141":117001,"_5":13774,"_26412":116929,"_2810":117002},[],"La aplicación criptográfica puede:",{"_3322":69065,"_29016":69035,"_20141":117004,"_5":13774,"_26412":116929,"_2810":117005},[],"permitir o bloquear claves RSA;",{"_3322":69066,"_29016":69035,"_20141":117007,"_5":13774,"_26412":116929,"_2810":117008},[],"limitar los tamaños RSA admitidos;",{"_3322":69067,"_29016":69035,"_20141":117010,"_5":13774,"_26412":116929,"_2810":117011},[],"permitir o bloquear claves ECDSA;",{"_3322":69068,"_29016":69035,"_20141":117013,"_5":13774,"_26412":116929,"_2810":117014},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3322":69069,"_29016":69035,"_20141":117016,"_5":13774,"_26412":116929,"_2810":117017},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3322":69070,"_29016":69035,"_20141":117019,"_5":13774,"_26412":116933,"_2810":117020},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3322":69071,"_29016":69035,"_20141":117022,"_5":13774,"_26412":116933,"_2810":112356},[],{"_3322":69072,"_29016":69035,"_20141":117024,"_5":13774,"_26412":116933,"_2810":117025},[],"Primera opción",{"_3322":69073,"_29016":69035,"_20141":117027,"_5":13774,"_26412":116933,"_2810":117028},[],"Segunda opción",{"_3322":69074,"_29016":69035,"_20141":117030,"_5":13774,"_26412":116933,"_2810":117031},[],"Si no hay ninguna",{"_3322":69075,"_29016":69035,"_20141":117033,"_5":13774,"_26412":116933,"_2810":117034},[],"Firma directa con una CA",{"_3322":69076,"_29016":69035,"_20141":117036,"_5":13774,"_26412":116933,"_2810":117037},[],"`issuance_profile` incluido en la solicitud",{"_3322":69077,"_29016":69035,"_20141":117039,"_5":13774,"_26412":116933,"_2810":117040},[],"`issuance_profile_id` de la solicitud",{"_3322":69078,"_29016":69035,"_20141":117042,"_5":13774,"_26412":116933,"_2810":117043},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3322":69079,"_29016":69035,"_20141":117045,"_5":13774,"_26412":116933,"_2810":117046},[],"Emisión mediante DMS",{"_3322":69080,"_29016":69035,"_20141":117048,"_5":13774,"_26412":116933,"_2810":53264},[],{"_3322":69081,"_29016":69035,"_20141":117050,"_5":13774,"_26412":116933,"_2810":117051},[],"`settings.issuance_profile` incluido en el DMS",{"_3322":69082,"_29016":69035,"_20141":117053,"_5":13774,"_26412":116933,"_2810":117054},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3322":69083,"_29016":69035,"_20141":117056,"_5":13774,"_26412":116933,"_2810":117057},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3322":69084,"_29016":69035,"_20141":117059,"_5":13774,"_26412":116933,"_2810":117060},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3322":69085,"_29016":69035,"_20141":117062,"_5":13774,"_26412":116941,"_2810":117063},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3322":69086,"_29016":69035,"_20141":117065,"_5":13774,"_26412":116945,"_2810":117066},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3322":69087,"_29016":69035,"_20141":117068,"_5":13774,"_26412":116949,"_2810":117069},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3322":69088,"_29016":69035,"_20141":117071,"_5":13774,"_26412":116953,"_2810":117072},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3322":69089,"_29016":69035,"_20141":117074,"_5":13774,"_26412":116957,"_2810":117075},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3322":69090,"_29016":69035,"_20141":117077,"_5":13774,"_26412":116957,"_2810":117078},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3322":69091,"_29016":69035,"_20141":117080,"_5":13774,"_26412":116961,"_2810":117081},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3322":69092,"_29016":69035,"_20141":117083,"_5":13774,"_26412":116961,"_2810":117084},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3322":69093,"_29016":69035,"_20141":117086,"_5":13774,"_26412":116961,"_2810":117087},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3322":69094,"_29016":69035,"_20141":117089,"_5":13774,"_26412":116961,"_2810":117090},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3322":69095,"_29016":69035,"_20141":117092,"_5":13774,"_26412":116965,"_2810":117093},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3322":69096,"_29016":69035,"_20141":117095,"_5":13774,"_26412":116965,"_2810":117096},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3322":69097,"_29016":69097,"_5":14132,"_2810":117098,"_29339":117099,"_20141":117101,"_26412":69097},"Validación de certificados",[47234,112596,52689,117100],"Validación",[],{"_3322":69098,"_29016":69097,"_20141":117103,"_5":13774,"_26412":69097,"_2810":117104},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3322":69099,"_29016":69097,"_5":29336,"_20141":117106,"_26412":117107,"_2810":117108},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3322":69100,"_29016":69097,"_5":29336,"_20141":117110,"_26412":117111,"_2810":117112},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3322":69101,"_29016":69097,"_5":29336,"_20141":117114,"_26412":117115,"_2810":117116},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3322":69102,"_29016":69097,"_20141":117118,"_5":13774,"_26412":69097,"_2810":117119},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3322":69103,"_29016":69097,"_20141":117121,"_5":13774,"_26412":117107,"_2810":117122},[],"Verifica estos criterios juntos:",{"_3322":69104,"_29016":69097,"_20141":117124,"_5":13774,"_26412":117107,"_2810":116104},[],{"_3322":69105,"_29016":69097,"_20141":117126,"_5":13774,"_26412":117107,"_2810":117127},[],"Resultado necesario",{"_3322":69106,"_29016":69097,"_20141":117129,"_5":13774,"_26412":117107,"_2810":117130},[],"Cadena y firma",{"_3322":69107,"_29016":69097,"_20141":117132,"_5":13774,"_26412":117107,"_2810":117133},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3322":69108,"_29016":69097,"_20141":117135,"_5":13774,"_26412":117107,"_2810":117136},[],"Fechas",{"_3322":69109,"_29016":69097,"_20141":117138,"_5":13774,"_26412":117107,"_2810":117139},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3322":69110,"_29016":69097,"_20141":117141,"_5":13774,"_26412":117107,"_2810":112266},[],{"_3322":69111,"_29016":69097,"_20141":117143,"_5":13774,"_26412":117107,"_2810":117144},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3322":69112,"_29016":69097,"_20141":117146,"_5":13774,"_26412":117107,"_2810":117147},[],"Uso",{"_3322":69113,"_29016":69097,"_20141":117149,"_5":13774,"_26412":117107,"_2810":117150},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3322":69114,"_29016":69097,"_20141":117152,"_5":13774,"_26412":117107,"_2810":117153},[],"Revocación",{"_3322":69115,"_29016":69097,"_20141":117155,"_5":13774,"_26412":117107,"_2810":117156},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3322":69116,"_29016":69097,"_20141":117158,"_5":13774,"_26412":117107,"_2810":117159},[],"Autorización",{"_3322":69117,"_29016":69097,"_20141":117161,"_5":13774,"_26412":117107,"_2810":117162},[],"La aplicación permite la acción a esa identidad.",{"_3322":69118,"_29016":69097,"_20141":117164,"_5":13774,"_26412":117107,"_2810":117165},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3322":69119,"_29016":69097,"_20141":117167,"_5":13774,"_26412":117111,"_2810":117168},[],"Mecanismo",{"_3322":69120,"_29016":69097,"_20141":117170,"_5":13774,"_26412":117111,"_2810":117171},[],"Cuándo utilizarlo",{"_3322":69121,"_29016":69097,"_20141":117173,"_5":13774,"_26412":117111,"_2810":117174},[],"Qué debes mantener",{"_3322":69122,"_29016":69097,"_20141":117176,"_5":13774,"_26412":117111,"_2810":53392},[],{"_3322":69123,"_29016":69097,"_20141":117178,"_5":13774,"_26412":117111,"_2810":117179},[],"Consulta del estado de un certificado concreto.",{"_3322":69124,"_29016":69097,"_20141":117181,"_5":13774,"_26412":117111,"_2810":117182},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3322":69125,"_29016":69097,"_20141":117184,"_5":13774,"_26412":117111,"_2810":53401},[],{"_3322":69126,"_29016":69097,"_20141":117186,"_5":13774,"_26412":117111,"_2810":117187},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3322":69127,"_29016":69097,"_20141":117189,"_5":13774,"_26412":117111,"_2810":117190},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3322":69128,"_29016":69097,"_20141":117192,"_5":13774,"_26412":117111,"_2810":117193},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3322":69129,"_29016":69097,"_20141":117195,"_5":13774,"_26412":117111,"_2810":117196},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3322":69130,"_29016":69097,"_20141":117198,"_5":13774,"_26412":117115,"_2810":117199},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3322":69131,"_29016":69097,"_20141":117201,"_5":13774,"_26412":117115,"_2810":117202},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3322":69132,"_29016":69097,"_20141":117204,"_5":13774,"_26412":117115,"_2810":117205},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3322":69133,"_29016":69097,"_20141":117207,"_5":13774,"_26412":117115,"_2810":117208},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3322":69134,"_29016":69097,"_20141":117210,"_5":13774,"_26412":117115,"_2810":117211},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3322":69135,"_29016":69097,"_20141":117213,"_5":13774,"_26412":117115,"_2810":117214},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3322":69136,"_29016":69097,"_20141":117216,"_5":13774,"_26412":117115,"_2810":117217},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3322":69137,"_29016":69097,"_20141":117219,"_5":13774,"_26412":117115,"_2810":117220},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3322":69138,"_29016":69097,"_20141":117222,"_5":13774,"_26412":117115,"_2810":117223},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3322":69139,"_29016":69139,"_5":14132,"_2810":117225,"_29339":117226,"_20141":117227,"_26412":69139},"Certificados",[47234,112596,52689,116475],[],{"_3322":69140,"_29016":69139,"_20141":117229,"_5":13774,"_26412":69139,"_2810":117230},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3322":69141,"_29016":69139,"_5":29336,"_20141":117232,"_26412":117233,"_2810":117234},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3322":69142,"_29016":69139,"_5":29336,"_20141":117236,"_26412":117237,"_2810":117238},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3322":69143,"_29016":69139,"_5":29336,"_20141":117240,"_26412":117241,"_2810":117242},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3322":69144,"_29016":69139,"_5":29336,"_20141":117244,"_26412":117245,"_2810":117246},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3322":69145,"_29016":69139,"_5":29336,"_20141":117248,"_26412":117249,"_2810":117250},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3322":69146,"_29016":69139,"_5":29336,"_20141":117252,"_26412":117253,"_2810":117254},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3322":69147,"_29016":69139,"_5":29336,"_20141":117256,"_26412":117257,"_2810":117258},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3322":69148,"_29016":69139,"_5":29336,"_20141":117260,"_26412":117261,"_2810":117262},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3322":69149,"_29016":69139,"_5":29336,"_20141":117264,"_26412":117265,"_2810":117266},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3322":69150,"_29016":69139,"_20141":117268,"_5":13774,"_26412":69139,"_2810":117269},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3322":69151,"_29016":69139,"_20141":117271,"_5":13774,"_26412":117233,"_2810":117272},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3322":69152,"_29016":69139,"_20141":117274,"_5":13774,"_26412":117233,"_2810":117275},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3322":69153,"_29016":69139,"_20141":117277,"_5":13774,"_26412":117237,"_2810":117278},[],"Descarga el PEM e inspecciónalo:",{"_3322":69154,"_29016":69139,"_20141":117280,"_5":13774,"_26412":117237,"_2810":117281},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3322":69155,"_29016":69139,"_20141":117283,"_5":13774,"_26412":117241,"_2810":117284},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3322":69156,"_29016":69139,"_20141":117286,"_5":13774,"_26412":117241,"_2810":117287},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3322":69157,"_29016":69139,"_20141":117289,"_5":13774,"_26412":117241,"_2810":117290},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3322":69158,"_29016":69139,"_20141":117292,"_5":13774,"_26412":117241,"_2810":117293},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3322":69159,"_29016":69139,"_20141":117295,"_5":13774,"_26412":117241,"_2810":117296},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3322":69160,"_29016":69139,"_20141":117298,"_5":13774,"_26412":117241,"_2810":117299},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3322":69161,"_29016":69139,"_20141":117301,"_5":13774,"_26412":117241,"_2810":117302},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3322":69162,"_29016":69139,"_20141":117304,"_5":13774,"_26412":117245,"_2810":117305},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3322":69163,"_29016":69139,"_20141":117307,"_5":13774,"_26412":117249,"_2810":117308},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3322":69164,"_29016":69139,"_20141":117310,"_5":13774,"_26412":117253,"_2810":117311},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3322":69165,"_29016":69139,"_20141":117313,"_5":13774,"_26412":117257,"_2810":117314},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3322":69166,"_29016":69139,"_20141":117316,"_5":13774,"_26412":117257,"_2810":117317},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3322":69167,"_29016":69139,"_20141":117319,"_5":13774,"_26412":117257,"_2810":117320},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3322":69168,"_29016":69139,"_20141":117322,"_5":13774,"_26412":117261,"_2810":117323},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3322":69169,"_29016":69139,"_20141":117325,"_5":13774,"_26412":117261,"_2810":117326},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3322":69170,"_29016":69139,"_20141":117328,"_5":13774,"_26412":117261,"_2810":117329},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3322":69171,"_29016":69139,"_20141":117331,"_5":13774,"_26412":117265,"_2810":117332},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3322":69172,"_29016":69139,"_20141":117334,"_5":13774,"_26412":117265,"_2810":117335},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3322":69173,"_29016":69173,"_5":14132,"_2810":117337,"_29339":117338,"_20141":117340,"_26412":69173},"Ciclo de vida de un certificado",[47234,112596,52689,117339],"Conceptos",[],{"_3322":69174,"_29016":69173,"_20141":117342,"_5":13774,"_26412":69173,"_2810":117343},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3322":69175,"_29016":69173,"_5":29336,"_20141":117345,"_26412":117346,"_2810":117347},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3322":69176,"_29016":69173,"_5":29336,"_20141":117349,"_26412":117350,"_2810":117351},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3322":69177,"_29016":69173,"_5":29336,"_20141":117353,"_26412":117354,"_2810":117355},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3322":69178,"_29016":69173,"_5":29336,"_20141":117357,"_26412":117358,"_2810":117359},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3322":69179,"_29016":69173,"_5":29336,"_20141":117361,"_26412":117362,"_2810":117363},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3322":69180,"_29016":69173,"_5":29336,"_20141":117365,"_26412":117366,"_2810":117367},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3322":69181,"_29016":69173,"_5":29336,"_20141":117369,"_26412":117370,"_2810":115049},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3322":69182,"_29016":69173,"_5":29336,"_20141":117372,"_26412":117373,"_2810":117374},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3322":69183,"_29016":69173,"_5":29336,"_20141":117376,"_26412":117377,"_2810":117378},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3322":69184,"_29016":69173,"_5":29336,"_20141":117380,"_26412":117381,"_2810":117382},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3322":69185,"_29016":69173,"_20141":117384,"_5":13774,"_26412":69173,"_2810":117385},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3322":69186,"_29016":69173,"_20141":117387,"_5":13774,"_26412":117350,"_2810":117388},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3322":69187,"_29016":69173,"_20141":117390,"_5":13774,"_26412":117354,"_2810":117391},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3322":69188,"_29016":69173,"_20141":117393,"_5":13774,"_26412":117358,"_2810":117394},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3322":69189,"_29016":69173,"_20141":117396,"_5":13774,"_26412":117362,"_2810":117397},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3322":69190,"_29016":69173,"_20141":117399,"_5":13774,"_26412":117366,"_2810":117400},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3322":69191,"_29016":69173,"_20141":117402,"_5":13774,"_26412":117370,"_2810":117403},[],"Lamassu persiste cuatro estados X.509:",{"_3322":69192,"_29016":69173,"_20141":117405,"_5":13774,"_26412":117370,"_2810":117406},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3322":69193,"_29016":69173,"_20141":117408,"_5":13774,"_26412":117370,"_2810":117409},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3322":69194,"_29016":69173,"_20141":117411,"_5":13774,"_26412":117370,"_2810":117412},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3322":69195,"_29016":69173,"_20141":117414,"_5":13774,"_26412":117370,"_2810":117415},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3322":69196,"_29016":69173,"_20141":117417,"_5":13774,"_26412":117370,"_2810":117418},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3322":69197,"_29016":69173,"_20141":117420,"_5":13774,"_26412":117373,"_2810":117421},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3322":69198,"_29016":69173,"_20141":117423,"_5":13774,"_26412":117373,"_2810":117424},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3322":69199,"_29016":69173,"_20141":117426,"_5":13774,"_26412":117373,"_2810":117427},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3322":69200,"_29016":69173,"_20141":117429,"_5":13774,"_26412":117377,"_2810":117430},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3322":69201,"_29016":69173,"_20141":117432,"_5":13774,"_26412":117377,"_2810":117433},[],"Antes de confirmar:",{"_3322":69202,"_29016":69173,"_20141":117435,"_5":13774,"_26412":117377,"_2810":117436},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3322":69203,"_29016":69173,"_20141":117438,"_5":13774,"_26412":117377,"_2810":117439},[],"Distribuye la nueva cadena de confianza.",{"_3322":69204,"_29016":69173,"_20141":117441,"_5":13774,"_26412":117377,"_2810":117442},[],"Reemite las identidades necesarias.",{"_3322":69205,"_29016":69173,"_20141":117444,"_5":13774,"_26412":117377,"_2810":117445},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3322":69206,"_29016":69173,"_20141":117447,"_5":13774,"_26412":117377,"_2810":117448},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3322":69207,"_29016":69173,"_20141":117450,"_5":13774,"_26412":117377,"_2810":117451},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3322":69208,"_29016":69173,"_20141":117453,"_5":13774,"_26412":117381,"_2810":117454},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3322":69209,"_29016":69173,"_20141":117456,"_5":13774,"_26412":117381,"_2810":117457},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3322":69210,"_29016":69173,"_20141":117459,"_5":13774,"_26412":117381,"_2810":117460},[],"Cambios de estado y razones de revocación.",{"_3322":69211,"_29016":69173,"_20141":117462,"_5":13774,"_26412":117381,"_2810":117463},[],"Publicación y vigencia de OCSP y CRLs.",{"_3322":69212,"_29016":69173,"_20141":117465,"_5":13774,"_26412":117381,"_2810":117466},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3322":69213,"_29016":69173,"_20141":117468,"_5":13774,"_26412":117381,"_2810":117469},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3322":69214,"_29016":69214,"_5":14132,"_2810":117471,"_29339":117472,"_20141":117473,"_26412":69214},"Modelo de confianza",[47234,112596,52689,117339],[],{"_3322":69215,"_29016":69214,"_20141":117475,"_5":13774,"_26412":69214,"_2810":117476},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3322":69216,"_29016":69214,"_5":29336,"_20141":117478,"_26412":117479,"_2810":117480},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3322":69217,"_29016":69214,"_5":29336,"_20141":117482,"_26412":117483,"_2810":117484},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3322":69218,"_29016":69214,"_5":29336,"_20141":117486,"_26412":117487,"_2810":117488},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3322":69219,"_29016":69214,"_5":29336,"_20141":117490,"_26412":117491,"_2810":117492},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3322":69220,"_29016":69214,"_5":29336,"_20141":117494,"_26412":117495,"_2810":117496},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3322":69221,"_29016":69214,"_5":29336,"_20141":117498,"_26412":117499,"_2810":117500},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3322":69222,"_29016":69214,"_5":29336,"_20141":117502,"_26412":117503,"_2810":117504},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3322":69223,"_29016":69214,"_5":29336,"_20141":117506,"_26412":117507,"_2810":117508},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3322":69224,"_29016":69214,"_5":29336,"_20141":117510,"_26412":117511,"_2810":117512},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3322":69225,"_29016":69214,"_5":29336,"_20141":117514,"_26412":117515,"_2810":117516},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3322":69226,"_29016":69214,"_20141":117518,"_5":13774,"_26412":69214,"_2810":117519},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3322":69227,"_29016":69214,"_20141":117521,"_5":13774,"_26412":117483,"_2810":117522},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3322":69228,"_29016":69214,"_20141":117524,"_5":13774,"_26412":117487,"_2810":117525},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3322":69229,"_29016":69214,"_20141":117527,"_5":13774,"_26412":117491,"_2810":117528},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3322":69230,"_29016":69214,"_20141":117530,"_5":13774,"_26412":117495,"_2810":117531},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3322":69231,"_29016":69214,"_20141":117533,"_5":13774,"_26412":117499,"_2810":117534},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3322":69232,"_29016":69214,"_20141":117536,"_5":13774,"_26412":117499,"_2810":117537},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3322":69233,"_29016":69214,"_20141":117539,"_5":13774,"_26412":117499,"_2810":117540},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3322":69234,"_29016":69214,"_20141":117542,"_5":13774,"_26412":117499,"_2810":117543},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3322":69235,"_29016":69214,"_20141":117545,"_5":13774,"_26412":117499,"_2810":117546},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3322":69236,"_29016":69214,"_20141":117548,"_5":13774,"_26412":117499,"_2810":117549},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3322":69237,"_29016":69214,"_20141":117551,"_5":13774,"_26412":117503,"_2810":117552},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3322":69238,"_29016":69214,"_20141":117554,"_5":13774,"_26412":117503,"_2810":117555},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3322":69239,"_29016":69214,"_20141":117557,"_5":13774,"_26412":117503,"_2810":117558},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3322":69240,"_29016":69214,"_20141":117560,"_5":13774,"_26412":117503,"_2810":117561},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3322":69241,"_29016":69214,"_20141":117563,"_5":13774,"_26412":117503,"_2810":117564},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3322":69242,"_29016":69214,"_20141":117566,"_5":13774,"_26412":117507,"_2810":117567},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3322":69243,"_29016":69214,"_20141":117569,"_5":13774,"_26412":117507,"_2810":117570},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3322":69244,"_29016":69214,"_20141":117572,"_5":13774,"_26412":117507,"_2810":117573},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3322":69245,"_29016":69214,"_20141":117575,"_5":13774,"_26412":117507,"_2810":117576},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3322":69246,"_29016":69214,"_20141":117578,"_5":13774,"_26412":117507,"_2810":117579},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3322":69247,"_29016":69214,"_20141":117581,"_5":13774,"_26412":117507,"_2810":117582},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3322":69248,"_29016":69214,"_20141":117584,"_5":13774,"_26412":117507,"_2810":117585},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3322":69249,"_29016":69214,"_20141":117587,"_5":13774,"_26412":117511,"_2810":117588},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3322":69250,"_29016":69214,"_20141":117590,"_5":13774,"_26412":117515,"_2810":117591},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3322":69251,"_29016":69214,"_20141":117593,"_5":13774,"_26412":117515,"_2810":117594},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3322":69252,"_29016":69214,"_20141":117596,"_5":13774,"_26412":117515,"_2810":117597},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3322":69253,"_29016":69214,"_20141":117599,"_5":13774,"_26412":117515,"_2810":117600},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3322":69254,"_29016":69214,"_20141":117602,"_5":13774,"_26412":117515,"_2810":117603},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3322":69255,"_29016":69214,"_20141":117605,"_5":13774,"_26412":117515,"_2810":117606},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3322":69256,"_29016":69214,"_20141":117608,"_5":13774,"_26412":117515,"_2810":117609},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3322":69257,"_29016":69257,"_5":14132,"_2810":117611,"_29339":117612,"_20141":117613,"_26412":69257},"Listas de revocación (CRL)",[47234,112596,52689,117100],[],{"_3322":69258,"_29016":69257,"_20141":117615,"_5":13774,"_26412":69257,"_2810":117616},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3322":69259,"_29016":69257,"_5":29336,"_20141":117618,"_26412":117619,"_2810":117620},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3322":69260,"_29016":69257,"_5":29336,"_20141":117622,"_26412":117623,"_2810":117624},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3322":69261,"_29016":69257,"_5":29336,"_20141":117626,"_26412":117627,"_2810":117628},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3322":69262,"_29016":69257,"_5":29336,"_20141":117630,"_26412":117631,"_2810":117632},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3322":69263,"_29016":69257,"_5":29336,"_20141":117634,"_26412":117635,"_2810":117636},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3322":69264,"_29016":69257,"_5":29336,"_20141":117638,"_26412":117639,"_2810":117640},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3322":69265,"_29016":69257,"_5":29336,"_20141":117642,"_26412":117643,"_2810":117644},[],"/docs/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3322":69266,"_29016":69257,"_5":29336,"_20141":117646,"_26412":117647,"_2810":117648},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3322":69267,"_29016":69257,"_5":29336,"_20141":117650,"_26412":117651,"_2810":117652},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3322":69268,"_29016":69257,"_20141":117654,"_5":13774,"_26412":69257,"_2810":117655},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3322":69269,"_29016":69257,"_20141":117657,"_5":13774,"_26412":117619,"_2810":117658},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3322":69270,"_29016":69257,"_20141":117660,"_5":13774,"_26412":117619,"_2810":117661},[],"Campo de `crl_options`",{"_3322":69271,"_29016":69257,"_20141":117663,"_5":13774,"_26412":117619,"_2810":114131},[],{"_3322":69272,"_29016":69257,"_20141":117665,"_5":13774,"_26412":117619,"_2810":117666},[],"Valor inicial del backend",{"_3322":69273,"_29016":69257,"_20141":117668,"_5":13774,"_26412":117619,"_2810":53887},[],{"_3322":69274,"_29016":69257,"_20141":117670,"_5":13774,"_26412":117619,"_2810":117671},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3322":69275,"_29016":69257,"_20141":117673,"_5":13774,"_26412":117619,"_2810":117674},[],"7 días.",{"_3322":69276,"_29016":69257,"_20141":117676,"_5":13774,"_26412":117619,"_2810":53896},[],{"_3322":69277,"_29016":69257,"_20141":117678,"_5":13774,"_26412":117619,"_2810":117679},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3322":69278,"_29016":69257,"_20141":117681,"_5":13774,"_26412":117619,"_2810":117682},[],"6 días y 23 horas.",{"_3322":69279,"_29016":69257,"_20141":117684,"_5":13774,"_26412":117619,"_2810":53905},[],{"_3322":69280,"_29016":69257,"_20141":117686,"_5":13774,"_26412":117619,"_2810":117687},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3322":69281,"_29016":69257,"_20141":117689,"_5":13774,"_26412":117619,"_2810":53911},[],{"_3322":69282,"_29016":69257,"_20141":117691,"_5":13774,"_26412":117619,"_2810":53914},[],{"_3322":69283,"_29016":69257,"_20141":117693,"_5":13774,"_26412":117619,"_2810":117694},[],"Número de serie del certificado existente que firma la CRL.",{"_3322":69284,"_29016":69257,"_20141":117696,"_5":13774,"_26412":117619,"_2810":117697},[],"Número de serie del certificado actual de la CA.",{"_3322":69285,"_29016":69257,"_20141":117699,"_5":13774,"_26412":117619,"_2810":117700},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3322":69286,"_29016":69257,"_20141":117702,"_5":13774,"_26412":117619,"_2810":117703},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3322":69287,"_29016":69257,"_20141":117705,"_5":13774,"_26412":117619,"_2810":117706},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3322":69288,"_29016":69257,"_20141":117708,"_5":13774,"_26412":117619,"_2810":117709},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3322":69289,"_29016":69257,"_20141":117711,"_5":13774,"_26412":117619,"_2810":117712},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3322":69290,"_29016":69257,"_20141":117714,"_5":13774,"_26412":117619,"_2810":117715},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3322":69291,"_29016":69257,"_20141":117717,"_5":13774,"_26412":117623,"_2810":117718},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3322":69292,"_29016":69257,"_20141":117720,"_5":13774,"_26412":117623,"_2810":117721},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3322":69293,"_29016":69257,"_20141":117723,"_5":13774,"_26412":117623,"_2810":117724},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3322":69294,"_29016":69257,"_20141":117726,"_5":13774,"_26412":117623,"_2810":117727},[],"Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3322":69295,"_29016":69257,"_20141":117729,"_5":13774,"_26412":117627,"_2810":117730},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3322":69296,"_29016":69257,"_20141":117732,"_5":13774,"_26412":117627,"_2810":117733},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3322":69297,"_29016":69257,"_20141":117735,"_5":13774,"_26412":117627,"_2810":117736},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3322":69298,"_29016":69257,"_20141":117738,"_5":13774,"_26412":117627,"_2810":117739},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3322":69299,"_29016":69257,"_20141":117741,"_5":13774,"_26412":117631,"_2810":117742},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3322":69300,"_29016":69257,"_20141":117744,"_5":13774,"_26412":117631,"_2810":117745},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3322":69301,"_29016":69257,"_20141":117747,"_5":13774,"_26412":117635,"_2810":117748},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3322":69302,"_29016":69257,"_20141":117750,"_5":13774,"_26412":117635,"_2810":117751},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3322":69303,"_29016":69257,"_20141":117753,"_5":13774,"_26412":117635,"_2810":117754},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3322":69304,"_29016":69257,"_20141":117756,"_5":13774,"_26412":117635,"_2810":117757},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3322":69305,"_29016":69257,"_20141":117759,"_5":13774,"_26412":117635,"_2810":117760},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3322":69306,"_29016":69257,"_20141":117762,"_5":13774,"_26412":117639,"_2810":117763},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3322":69307,"_29016":69257,"_20141":117765,"_5":13774,"_26412":117639,"_2810":114320},[],{"_3322":69308,"_29016":69257,"_20141":117767,"_5":13774,"_26412":117639,"_2810":117768},[],"Path relativo",{"_3322":69309,"_29016":69257,"_20141":117770,"_5":13774,"_26412":117639,"_2810":112356},[],{"_3322":69310,"_29016":69257,"_20141":117772,"_5":13774,"_26412":117639,"_2810":53996},[],{"_3322":69311,"_29016":69257,"_20141":117774,"_5":13774,"_26412":117639,"_2810":53999},[],{"_3322":69312,"_29016":69257,"_20141":117776,"_5":13774,"_26412":117639,"_2810":117777},[],"Consultar `crl_options` y `latest_crl`.",{"_3322":69313,"_29016":69257,"_20141":117779,"_5":13774,"_26412":117639,"_2810":54005},[],{"_3322":69314,"_29016":69257,"_20141":117781,"_5":13774,"_26412":117639,"_2810":53999},[],{"_3322":69315,"_29016":69257,"_20141":117783,"_5":13774,"_26412":117639,"_2810":117784},[],"Sustituir la configuración de CRL.",{"_3322":69316,"_29016":69257,"_20141":117786,"_5":13774,"_26412":117639,"_2810":117787},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3322":69317,"_29016":69257,"_20141":117789,"_5":13774,"_26412":117639,"_2810":117790},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3322":69318,"_29016":69257,"_20141":117792,"_5":13774,"_26412":117643,"_2810":117793},[],"Síntoma",{"_3322":69319,"_29016":69257,"_20141":117795,"_5":13774,"_26412":117643,"_2810":117796},[],"Causa",{"_3322":69320,"_29016":69257,"_20141":117798,"_5":13774,"_26412":117643,"_2810":117799},[],"Acción",{"_3322":69321,"_29016":69257,"_20141":117801,"_5":13774,"_26412":117643,"_2810":117802},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3322":69322,"_29016":69257,"_20141":117804,"_5":13774,"_26412":117643,"_2810":117805},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3322":69323,"_29016":69257,"_20141":117807,"_5":13774,"_26412":117643,"_2810":117808},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3322":69324,"_29016":69257,"_20141":117810,"_5":13774,"_26412":117643,"_2810":117811},[],"`PUT` devuelve 400.",{"_3322":69325,"_29016":69257,"_20141":117813,"_5":13774,"_26412":117643,"_2810":117814},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3322":69326,"_29016":69257,"_20141":117816,"_5":13774,"_26412":117643,"_2810":117817},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3322":69327,"_29016":69257,"_20141":117819,"_5":13774,"_26412":117643,"_2810":117820},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3322":69328,"_29016":69257,"_20141":117822,"_5":13774,"_26412":117643,"_2810":117823},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3322":69329,"_29016":69257,"_20141":117825,"_5":13774,"_26412":117643,"_2810":117826},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3322":69330,"_29016":69257,"_20141":117828,"_5":13774,"_26412":117643,"_2810":117829},[],"La CRL no cambia tras revocar un certificado.",{"_3322":69331,"_29016":69257,"_20141":117831,"_5":13774,"_26412":117643,"_2810":117832},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3322":69332,"_29016":69257,"_20141":117834,"_5":13774,"_26412":117643,"_2810":117835},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3322":69333,"_29016":69257,"_20141":117837,"_5":13774,"_26412":117643,"_2810":117838},[],"Un verificador rechaza la CRL por el emisor.",{"_3322":69334,"_29016":69257,"_20141":117840,"_5":13774,"_26412":117643,"_2810":117841},[],"Varias CAs comparten SKI.",{"_3322":69335,"_29016":69257,"_20141":117843,"_5":13774,"_26412":117643,"_2810":117844},[],"Consulta CAs que comparten clave.",{"_3322":69336,"_29016":69257,"_20141":117846,"_5":13774,"_26412":117647,"_2810":117847},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3322":69337,"_29016":69257,"_20141":117849,"_5":13774,"_26412":117651,"_2810":117850},[],"RFC 5280: perfil X.509 y CRL.",{"_3322":69338,"_29016":69257,"_20141":117852,"_5":13774,"_26412":117651,"_2810":54079},[],{"_3322":69339,"_29016":69257,"_20141":117854,"_5":13774,"_26412":117651,"_2810":54082},[],{"_3322":69340,"_29016":69257,"_20141":117856,"_5":13774,"_26412":117651,"_2810":117857},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3322":69341,"_29016":69257,"_20141":117859,"_5":13774,"_26412":117651,"_2810":117860},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3322":69342,"_29016":69342,"_5":14132,"_2810":117862,"_29339":117863,"_20141":117864,"_26412":69342},"Claves y motores criptográficos",[47234,112596,52689,116475],[],{"_3322":69343,"_29016":69342,"_20141":117866,"_5":13774,"_26412":69342,"_2810":117867},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3322":69344,"_29016":69342,"_5":29336,"_20141":117869,"_26412":117870,"_2810":117871},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3322":69345,"_29016":69342,"_5":29336,"_20141":117873,"_26412":117874,"_2810":117875},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3322":69346,"_29016":69342,"_5":29336,"_20141":117877,"_26412":117878,"_2810":54107},[],"/docs/es/platform/pki/key-management#file-system",{"_3322":69347,"_29016":69342,"_5":29336,"_20141":117880,"_26412":117881,"_2810":54111},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3322":69348,"_29016":69342,"_5":29336,"_20141":117883,"_26412":117884,"_2810":54115},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3322":69349,"_29016":69342,"_5":29336,"_20141":117886,"_26412":117887,"_2810":54119},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3322":69350,"_29016":69342,"_5":29336,"_20141":117889,"_26412":117890,"_2810":54123},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3322":69351,"_29016":69342,"_5":29336,"_20141":117892,"_26412":117893,"_2810":54127},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3322":69352,"_29016":69342,"_5":29336,"_20141":117895,"_26412":117896,"_2810":117897},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3322":69353,"_29016":69342,"_5":29336,"_20141":117899,"_26412":117900,"_2810":117901},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3322":69354,"_29016":69342,"_5":29336,"_20141":117903,"_26412":117904,"_2810":117905},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3322":69355,"_29016":69342,"_5":29336,"_20141":117907,"_26412":117908,"_2810":117909},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3322":69356,"_29016":69342,"_5":29336,"_20141":117911,"_26412":117912,"_2810":117913},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3322":69357,"_29016":69342,"_5":29336,"_20141":117915,"_26412":117916,"_2810":117917},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3322":69358,"_29016":69342,"_5":29336,"_20141":117919,"_26412":117920,"_2810":117921},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3322":69359,"_29016":69342,"_5":29336,"_20141":117923,"_26412":117924,"_2810":54159},[],"/docs/es/platform/pki/key-management#sign",{"_3322":69360,"_29016":69342,"_5":29336,"_20141":117926,"_26412":117927,"_2810":54163},[],"/docs/es/platform/pki/key-management#verify",{"_3322":69361,"_29016":69342,"_5":29336,"_20141":117929,"_26412":117930,"_2810":117931},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3322":69362,"_29016":69342,"_5":29336,"_20141":117933,"_26412":117934,"_2810":117935},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3322":69363,"_29016":69342,"_5":29336,"_20141":117937,"_26412":117938,"_2810":117939},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3322":69364,"_29016":69342,"_20141":117941,"_5":13774,"_26412":69342,"_2810":117942},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3322":69365,"_29016":69342,"_20141":117944,"_5":13774,"_26412":69342,"_2810":117945},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3322":69366,"_29016":69342,"_20141":117947,"_5":13774,"_26412":117870,"_2810":117948},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3322":69367,"_29016":69342,"_20141":117950,"_5":13774,"_26412":117870,"_2810":117951},[],"En la práctica, permite:",{"_3322":69368,"_29016":69342,"_20141":117953,"_5":13774,"_26412":117870,"_2810":117954},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3322":69369,"_29016":69342,"_20141":117956,"_5":13774,"_26412":117870,"_2810":117957},[],"Importar claves creadas externamente.",{"_3322":69370,"_29016":69342,"_20141":117959,"_5":13774,"_26412":117870,"_2810":117960},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3322":69371,"_29016":69342,"_20141":117962,"_5":13774,"_26412":117870,"_2810":117963},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3322":69372,"_29016":69342,"_20141":117965,"_5":13774,"_26412":117874,"_2810":117966},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3322":69373,"_29016":69342,"_20141":117968,"_5":13774,"_26412":117874,"_2810":117969},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3322":69374,"_29016":69342,"_20141":117971,"_5":13774,"_26412":117874,"_2810":117972},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3322":69375,"_29016":69342,"_20141":117974,"_5":13774,"_26412":117878,"_2810":117975},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3322":69376,"_29016":69342,"_20141":117977,"_5":13774,"_26412":117881,"_2810":117978},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3322":69377,"_29016":69342,"_20141":117980,"_5":13774,"_26412":117881,"_2810":117981},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3322":69378,"_29016":69342,"_20141":117983,"_5":13774,"_26412":117884,"_2810":117984},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3322":69379,"_29016":69342,"_20141":117986,"_5":13774,"_26412":117887,"_2810":117987},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3322":69380,"_29016":69342,"_20141":117989,"_5":13774,"_26412":117890,"_2810":117990},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3322":69381,"_29016":69342,"_20141":117992,"_5":13774,"_26412":117893,"_2810":117993},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3322":69382,"_29016":69342,"_20141":117995,"_5":13774,"_26412":117893,"_2810":117996},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3322":69383,"_29016":69342,"_20141":117998,"_5":13774,"_26412":117893,"_2810":117999},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3322":69384,"_29016":69342,"_20141":118001,"_5":13774,"_26412":117893,"_2810":118002},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3322":69385,"_29016":69342,"_20141":118004,"_5":13774,"_26412":117896,"_2810":118005},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3322":69386,"_29016":69342,"_20141":118007,"_5":13774,"_26412":117896,"_2810":118008},[],"La tabla incluye los siguientes campos:",{"_3322":69387,"_29016":69342,"_20141":118010,"_5":13774,"_26412":117896,"_2810":118011},[],"**Name**: nombre descriptivo de la clave.",{"_3322":69388,"_29016":69342,"_20141":118013,"_5":13774,"_26412":117896,"_2810":118014},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3322":69389,"_29016":69342,"_20141":118016,"_5":13774,"_26412":117896,"_2810":118017},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3322":69390,"_29016":69342,"_20141":118019,"_5":13774,"_26412":117896,"_2810":118020},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3322":69391,"_29016":69342,"_20141":118022,"_5":13774,"_26412":117896,"_2810":118023},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3322":69392,"_29016":69342,"_20141":118025,"_5":13774,"_26412":117896,"_2810":118026},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3322":69393,"_29016":69342,"_20141":118028,"_5":13774,"_26412":117896,"_2810":118029},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3322":69394,"_29016":69342,"_20141":118031,"_5":13774,"_26412":117896,"_2810":118032},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3322":69395,"_29016":69342,"_20141":118034,"_5":13774,"_26412":117896,"_2810":118035},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3322":69396,"_29016":69342,"_20141":118037,"_5":13774,"_26412":117896,"_2810":118038},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3322":69397,"_29016":69342,"_20141":118040,"_5":13774,"_26412":117896,"_2810":118041},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3322":69398,"_29016":69342,"_20141":118043,"_5":13774,"_26412":117896,"_2810":118044},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3322":69399,"_29016":69342,"_20141":118046,"_5":13774,"_26412":117896,"_2810":118047},[],"**Delete Key** para eliminar la clave del sistema.",{"_3322":69400,"_29016":69342,"_20141":118049,"_5":13774,"_26412":117900,"_2810":118050},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3322":69401,"_29016":69342,"_20141":118052,"_5":13774,"_26412":117904,"_2810":118053},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3322":69402,"_29016":69342,"_20141":118055,"_5":13774,"_26412":117904,"_2810":118056},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3322":69403,"_29016":69342,"_20141":118058,"_5":13774,"_26412":117904,"_2810":118059},[],"**Key Name**: nombre único y descriptivo.",{"_3322":69404,"_29016":69342,"_20141":118061,"_5":13774,"_26412":117904,"_2810":118062},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3322":69405,"_29016":69342,"_20141":118064,"_5":13774,"_26412":117904,"_2810":118065},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3322":69406,"_29016":69342,"_20141":118067,"_5":13774,"_26412":117904,"_2810":118068},[],"**Tags**: metadatos para clasificar la clave.",{"_3322":69407,"_29016":69342,"_20141":118070,"_5":13774,"_26412":117904,"_2810":118071},[],"**Metadata**: información adicional para usos avanzados.",{"_3322":69408,"_29016":69342,"_20141":118073,"_5":13774,"_26412":117908,"_2810":118074},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3322":69409,"_29016":69342,"_20141":118076,"_5":13774,"_26412":117908,"_2810":118077},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3322":69410,"_29016":69342,"_20141":118079,"_5":13774,"_26412":117908,"_2810":118080},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3322":69411,"_29016":69342,"_20141":118082,"_5":13774,"_26412":117908,"_2810":118083},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3322":69412,"_29016":69342,"_20141":118085,"_5":13774,"_26412":117908,"_2810":118086},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3322":69413,"_29016":69342,"_20141":118088,"_5":13774,"_26412":117908,"_2810":118089},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3322":69414,"_29016":69342,"_20141":118091,"_5":13774,"_26412":117908,"_2810":118092},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3322":69415,"_29016":69342,"_20141":118094,"_5":13774,"_26412":117908,"_2810":118095},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3322":69416,"_29016":69342,"_20141":118097,"_5":13774,"_26412":117908,"_2810":118098},[],"**Metadata**: información adicional opcional.",{"_3322":69417,"_29016":69342,"_20141":118100,"_5":13774,"_26412":117908,"_2810":118101},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3322":69418,"_29016":69342,"_20141":118103,"_5":13774,"_26412":117908,"_2810":118104},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3322":69419,"_29016":69342,"_20141":118106,"_5":13774,"_26412":117912,"_2810":118107},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3322":69420,"_29016":69342,"_20141":118109,"_5":13774,"_26412":117916,"_2810":118110},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3322":69421,"_29016":69342,"_20141":118112,"_5":13774,"_26412":117916,"_2810":118113},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3322":69422,"_29016":69342,"_20141":118115,"_5":13774,"_26412":117916,"_2810":118116},[],"**Key Name**: nombre descriptivo.",{"_3322":69423,"_29016":69342,"_20141":118118,"_5":13774,"_26412":117916,"_2810":118119},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3322":69424,"_29016":69342,"_20141":118121,"_5":13774,"_26412":117916,"_2810":118122},[],"**Tags**: etiquetas asociadas.",{"_3322":69425,"_29016":69342,"_20141":118124,"_5":13774,"_26412":117916,"_2810":118125},[],"**Aliases**: nombres alternativos.",{"_3322":69426,"_29016":69342,"_20141":118127,"_5":13774,"_26412":117916,"_2810":118128},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3322":69427,"_29016":69342,"_20141":118130,"_5":13774,"_26412":117916,"_2810":118131},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3322":69428,"_29016":69342,"_20141":118133,"_5":13774,"_26412":117916,"_2810":118134},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3322":69429,"_29016":69342,"_20141":118136,"_5":13774,"_26412":117916,"_2810":118137},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3322":69430,"_29016":69342,"_20141":118139,"_5":13774,"_26412":117920,"_2810":118140},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3322":69431,"_29016":69342,"_20141":118142,"_5":13774,"_26412":117920,"_2810":118143},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3322":69432,"_29016":69342,"_20141":118145,"_5":13774,"_26412":117920,"_2810":118146},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3322":69433,"_29016":69342,"_20141":118148,"_5":13774,"_26412":117924,"_2810":118149},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3322":69434,"_29016":69342,"_20141":118151,"_5":13774,"_26412":117924,"_2810":118152},[],"Campos principales:",{"_3322":69435,"_29016":69342,"_20141":118154,"_5":13774,"_26412":117924,"_2810":118155},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3322":69436,"_29016":69342,"_20141":118157,"_5":13774,"_26412":117924,"_2810":118158},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3322":69437,"_29016":69342,"_20141":118160,"_5":13774,"_26412":117924,"_2810":118161},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3322":69438,"_29016":69342,"_20141":118163,"_5":13774,"_26412":117924,"_2810":118164},[],"**Message**: contenido que se va a firmar.",{"_3322":69439,"_29016":69342,"_20141":118166,"_5":13774,"_26412":117924,"_2810":118167},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3322":69440,"_29016":69342,"_20141":118169,"_5":13774,"_26412":117927,"_2810":118170},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3322":69441,"_29016":69342,"_20141":118172,"_5":13774,"_26412":117927,"_2810":118152},[],{"_3322":69442,"_29016":69342,"_20141":118174,"_5":13774,"_26412":117927,"_2810":118175},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3322":69443,"_29016":69342,"_20141":118177,"_5":13774,"_26412":117927,"_2810":118178},[],"**Message Type**: `Raw` o `Digest`.",{"_3322":69444,"_29016":69342,"_20141":118180,"_5":13774,"_26412":117927,"_2810":118181},[],"**Payload Encoding**: codificación del mensaje.",{"_3322":69445,"_29016":69342,"_20141":118183,"_5":13774,"_26412":117927,"_2810":118184},[],"**Message**: mensaje original o hash.",{"_3322":69446,"_29016":69342,"_20141":118186,"_5":13774,"_26412":117927,"_2810":118187},[],"**Signature**: firma que se desea comprobar.",{"_3322":69447,"_29016":69342,"_20141":118189,"_5":13774,"_26412":117927,"_2810":118190},[],"**Result**: indicador del resultado de la validación.",{"_3322":69448,"_29016":69342,"_20141":118192,"_5":13774,"_26412":117930,"_2810":118193},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3322":69449,"_29016":69342,"_20141":118195,"_5":13774,"_26412":117930,"_2810":118196},[],"Este flujo es útil para:",{"_3322":69450,"_29016":69342,"_20141":118198,"_5":13774,"_26412":117930,"_2810":118199},[],"Solicitar certificados a una CA externa.",{"_3322":69451,"_29016":69342,"_20141":118201,"_5":13774,"_26412":117930,"_2810":118202},[],"Renovar una identidad manteniendo la misma clave.",{"_3322":69452,"_29016":69342,"_20141":118204,"_5":13774,"_26412":117930,"_2810":118205},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3322":69453,"_29016":69342,"_20141":118207,"_5":13774,"_26412":117930,"_2810":118208},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3322":69454,"_29016":69342,"_20141":118210,"_5":13774,"_26412":117930,"_2810":118211},[],"**Organization (O)**: organización o empresa.",{"_3322":69455,"_29016":69342,"_20141":118213,"_5":13774,"_26412":117930,"_2810":118214},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3322":69456,"_29016":69342,"_20141":118216,"_5":13774,"_26412":117930,"_2810":118217},[],"**Country (C)**: código de país de dos letras.",{"_3322":69457,"_29016":69342,"_20141":118219,"_5":13774,"_26412":117930,"_2810":118220},[],"**State / Province (ST)**: estado o provincia.",{"_3322":69458,"_29016":69342,"_20141":118222,"_5":13774,"_26412":117930,"_2810":118223},[],"**Locality (L)**: ciudad o localidad.",{"_3322":69459,"_29016":69342,"_20141":118225,"_5":13774,"_26412":117930,"_2810":118226},[],"**Email Address**: correo de contacto.",{"_3322":69460,"_29016":69342,"_20141":118228,"_5":13774,"_26412":117930,"_2810":118229},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3322":69461,"_29016":69342,"_20141":118231,"_5":13774,"_26412":117930,"_2810":118232},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3322":69462,"_29016":69342,"_20141":118234,"_5":13774,"_26412":117934,"_2810":118235},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3322":69463,"_29016":69342,"_20141":118237,"_5":13774,"_26412":117934,"_2810":54474},[],{"_3322":69464,"_29016":69342,"_20141":118239,"_5":13774,"_26412":117938,"_2810":118240},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3322":69465,"_29016":69465,"_5":14132,"_2810":118242,"_29339":118243,"_20141":118244,"_26412":69465},"Validación online con OCSP",[47234,112596,52689,117100],[],{"_3322":69466,"_29016":69465,"_20141":118246,"_5":13774,"_26412":69465,"_2810":118247},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3322":69467,"_29016":69465,"_5":29336,"_20141":118249,"_26412":118250,"_2810":118251},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3322":69468,"_29016":69465,"_5":29336,"_20141":118253,"_26412":118254,"_2810":118255},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3322":69469,"_29016":69465,"_5":29336,"_20141":118257,"_26412":118258,"_2810":118259},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3322":69470,"_29016":69465,"_5":29336,"_20141":118261,"_26412":118262,"_2810":118263},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3322":69471,"_29016":69465,"_5":29336,"_20141":118265,"_26412":118266,"_2810":118267},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3322":69472,"_29016":69465,"_5":29336,"_20141":118269,"_26412":118270,"_2810":117652},[],"/docs/es/platform/pki/ocsp#referencias",{"_3322":69473,"_29016":69465,"_20141":118272,"_5":13774,"_26412":69465,"_2810":118273},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3322":69474,"_29016":69465,"_20141":118275,"_5":13774,"_26412":118250,"_2810":118276},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3322":69475,"_29016":69465,"_20141":118278,"_5":13774,"_26412":118250,"_2810":118279},[],"Estado del registro",{"_3322":69476,"_29016":69465,"_20141":118281,"_5":13774,"_26412":118250,"_2810":118282},[],"Respuesta firmada",{"_3322":69477,"_29016":69465,"_20141":118284,"_5":13774,"_26412":118250,"_2810":51860},[],{"_3322":69478,"_29016":69465,"_20141":118286,"_5":13774,"_26412":118250,"_2810":54524},[],{"_3322":69479,"_29016":69465,"_20141":118288,"_5":13774,"_26412":118250,"_2810":51877},[],{"_3322":69480,"_29016":69465,"_20141":118290,"_5":13774,"_26412":118250,"_2810":118291},[],"`Revoked`, con razón y fecha de revocación.",{"_3322":69481,"_29016":69465,"_20141":118293,"_5":13774,"_26412":118250,"_2810":118294},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3322":69482,"_29016":69465,"_20141":118296,"_5":13774,"_26412":118250,"_2810":118297},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3322":69483,"_29016":69465,"_20141":118299,"_5":13774,"_26412":118250,"_2810":118300},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3322":69484,"_29016":69465,"_20141":118302,"_5":13774,"_26412":118250,"_2810":118303},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3322":69485,"_29016":69465,"_20141":118305,"_5":13774,"_26412":118250,"_2810":118306},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3322":69486,"_29016":69465,"_20141":118308,"_5":13774,"_26412":118254,"_2810":118309},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3322":69487,"_29016":69465,"_20141":118311,"_5":13774,"_26412":118254,"_2810":118312},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3322":69488,"_29016":69465,"_20141":118314,"_5":13774,"_26412":118258,"_2810":118315},[],"El servicio acepta:",{"_3322":69489,"_29016":69465,"_20141":118317,"_5":13774,"_26412":118258,"_2810":114320},[],{"_3322":69490,"_29016":69465,"_20141":118319,"_5":13774,"_26412":118258,"_2810":118320},[],"Ruta del servicio VA",{"_3322":69491,"_29016":69465,"_20141":118322,"_5":13774,"_26412":118258,"_2810":118323},[],"Formato",{"_3322":69492,"_29016":69465,"_20141":118325,"_5":13774,"_26412":118258,"_2810":54564},[],{"_3322":69493,"_29016":69465,"_20141":118327,"_5":13774,"_26412":118258,"_2810":54567},[],{"_3322":69494,"_29016":69465,"_20141":118329,"_5":13774,"_26412":118258,"_2810":118330},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3322":69495,"_29016":69465,"_20141":118332,"_5":13774,"_26412":118258,"_2810":53996},[],{"_3322":69496,"_29016":69465,"_20141":118334,"_5":13774,"_26412":118258,"_2810":54575},[],{"_3322":69497,"_29016":69465,"_20141":118336,"_5":13774,"_26412":118258,"_2810":118337},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3322":69498,"_29016":69465,"_20141":118339,"_5":13774,"_26412":118258,"_2810":118340},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3322":69499,"_29016":69465,"_20141":118342,"_5":13774,"_26412":118262,"_2810":118343},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3322":69500,"_29016":69465,"_20141":118345,"_5":13774,"_26412":118262,"_2810":118346},[],"Genera la solicitud:",{"_3322":69501,"_29016":69465,"_20141":118348,"_5":13774,"_26412":118262,"_2810":118349},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3322":69502,"_29016":69465,"_20141":118351,"_5":13774,"_26412":118262,"_2810":118352},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3322":69503,"_29016":69465,"_20141":118354,"_5":13774,"_26412":118262,"_2810":118355},[],"Verifica el DER recibido:",{"_3322":69504,"_29016":69465,"_20141":118357,"_5":13774,"_26412":118262,"_2810":118358},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3322":69505,"_29016":69465,"_20141":118360,"_5":13774,"_26412":118266,"_2810":118361},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3322":69506,"_29016":69465,"_20141":118363,"_5":13774,"_26412":118266,"_2810":118364},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3322":69507,"_29016":69465,"_20141":118366,"_5":13774,"_26412":118270,"_2810":54608},[],{"_3322":69508,"_29016":69465,"_20141":118368,"_5":13774,"_26412":118270,"_2810":54611},[],{"_3322":69509,"_29016":69465,"_20141":118370,"_5":13774,"_26412":118270,"_2810":118371},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3322":69510,"_29016":69465,"_20141":118373,"_5":13774,"_26412":118270,"_2810":117860},[],{"_3322":69511,"_29016":69511,"_5":14132,"_2810":52689,"_29339":118375,"_20141":118376,"_26412":69511},[47234,112596,52689],[],{"_3322":69512,"_29016":69511,"_20141":118378,"_5":13774,"_26412":69511,"_2810":118379},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3322":69513,"_29016":69511,"_5":29336,"_20141":118381,"_26412":118382,"_2810":115801},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3322":69514,"_29016":69511,"_5":29336,"_20141":118384,"_26412":118385,"_2810":118386},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3322":69515,"_29016":69511,"_5":29336,"_20141":118388,"_26412":118389,"_2810":116321},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3322":69516,"_29016":69511,"_5":29336,"_20141":118391,"_26412":118392,"_2810":116325},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3322":69517,"_29016":69511,"_5":29336,"_20141":118394,"_26412":118395,"_2810":116329},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3322":69518,"_29016":69511,"_5":29336,"_20141":118397,"_26412":118398,"_2810":116333},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3322":69519,"_29016":69511,"_5":29336,"_20141":118400,"_26412":118401,"_2810":116341},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3322":69520,"_29016":69511,"_5":29336,"_20141":118403,"_26412":118404,"_2810":118405},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3322":69521,"_29016":69511,"_5":29336,"_20141":118407,"_26412":118408,"_2810":117266},[],"/docs/es/platform/pki/overview#continúa",{"_3322":69522,"_29016":69511,"_20141":118410,"_5":13774,"_26412":69511,"_2810":118411},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3322":69523,"_29016":69511,"_20141":118413,"_5":13774,"_26412":118382,"_2810":118414},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3322":69524,"_29016":69511,"_20141":118416,"_5":13774,"_26412":118382,"_2810":118417},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3322":69525,"_29016":69511,"_20141":118419,"_5":13774,"_26412":118385,"_2810":118420},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3322":69526,"_29016":69511,"_20141":118422,"_5":13774,"_26412":118385,"_2810":118423},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3322":69527,"_29016":69511,"_20141":118425,"_5":13774,"_26412":118385,"_2810":118426},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3322":69528,"_29016":69511,"_20141":118428,"_5":13774,"_26412":118385,"_2810":118429},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3322":69529,"_29016":69511,"_20141":118431,"_5":13774,"_26412":118385,"_2810":118432},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3322":69530,"_29016":69511,"_20141":118434,"_5":13774,"_26412":118392,"_2810":118435},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3322":69531,"_29016":69511,"_20141":118437,"_5":13774,"_26412":118395,"_2810":118438},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3322":69532,"_29016":69511,"_20141":118440,"_5":13774,"_26412":118398,"_2810":118441},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3322":69533,"_29016":69511,"_20141":118443,"_5":13774,"_26412":118401,"_2810":118444},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3322":69534,"_29016":69511,"_20141":118446,"_5":13774,"_26412":118404,"_2810":118447},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3322":69535,"_29016":69511,"_20141":118449,"_5":13774,"_26412":118404,"_2810":118450},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3322":69536,"_29016":69511,"_20141":118452,"_5":13774,"_26412":118404,"_2810":118453},[],"su clave pública corresponda a la clave privada del cliente;",{"_3322":69537,"_29016":69511,"_20141":118455,"_5":13774,"_26412":118404,"_2810":118456},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3322":69538,"_29016":69511,"_20141":118458,"_5":13774,"_26412":118404,"_2810":118459},[],"sus fechas y usos permitan la operación;",{"_3322":69539,"_29016":69511,"_20141":118461,"_5":13774,"_26412":118404,"_2810":118462},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3322":69540,"_29016":69511,"_20141":118464,"_5":13774,"_26412":118404,"_2810":118465},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3322":69541,"_29016":69511,"_20141":118467,"_5":13774,"_26412":118408,"_2810":118468},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3322":69542,"_29016":69511,"_20141":118470,"_5":13774,"_26412":118408,"_2810":118471},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3322":69543,"_29016":69511,"_20141":118473,"_5":13774,"_26412":118408,"_2810":118474},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3322":69544,"_29016":69544,"_5":14132,"_2810":118476,"_29339":118477,"_20141":118478,"_26412":69544},"Crea tu primera CA",[47234,112596,52689,115925],[],{"_3322":69545,"_29016":69544,"_20141":118480,"_5":13774,"_26412":69544,"_2810":118481},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3322":69546,"_29016":69544,"_5":29336,"_20141":118483,"_26412":118484,"_2810":111193},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3322":69547,"_29016":69544,"_5":29336,"_20141":118486,"_26412":118487,"_2810":118488},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3322":69548,"_29016":69544,"_5":29336,"_20141":118490,"_26412":118491,"_2810":118492},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3322":69549,"_29016":69544,"_5":29336,"_20141":118494,"_26412":118495,"_2810":118496},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3322":69550,"_29016":69544,"_5":29336,"_20141":118498,"_26412":118499,"_2810":118500},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3322":69551,"_29016":69544,"_5":29336,"_20141":118502,"_26412":118503,"_2810":118504},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3322":69552,"_29016":69544,"_5":29336,"_20141":118506,"_26412":118507,"_2810":118508},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3322":69553,"_29016":69544,"_5":29336,"_20141":118510,"_26412":118511,"_2810":116172},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3322":69554,"_29016":69544,"_5":29336,"_20141":118513,"_26412":118514,"_2810":111217},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3322":69555,"_29016":69544,"_20141":118516,"_5":13774,"_26412":69544,"_2810":118517},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3322":69556,"_29016":69544,"_20141":118519,"_5":13774,"_26412":118484,"_2810":118520},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3322":69557,"_29016":69544,"_20141":118522,"_5":13774,"_26412":118484,"_2810":118523},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3322":69558,"_29016":69544,"_20141":118525,"_5":13774,"_26412":118484,"_2810":118526},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3322":69559,"_29016":69544,"_20141":118528,"_5":13774,"_26412":118484,"_2810":118529},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3322":69560,"_29016":69544,"_20141":118531,"_5":13774,"_26412":118487,"_2810":118532},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3322":69561,"_29016":69544,"_20141":118534,"_5":13774,"_26412":118487,"_2810":118535},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3322":69562,"_29016":69544,"_20141":118537,"_5":13774,"_26412":118491,"_2810":118538},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3322":69563,"_29016":69544,"_20141":118540,"_5":13774,"_26412":118491,"_2810":118541},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3322":69564,"_29016":69544,"_20141":118543,"_5":13774,"_26412":118495,"_2810":118544},[],"Selecciona **Root CA** y completa:",{"_3322":69565,"_29016":69544,"_20141":118546,"_5":13774,"_26412":118495,"_2810":54790},[],{"_3322":69566,"_29016":69544,"_20141":118548,"_5":13774,"_26412":118495,"_2810":118549},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3322":69567,"_29016":69544,"_20141":118551,"_5":13774,"_26412":118495,"_2810":118552},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3322":69568,"_29016":69544,"_20141":118554,"_5":13774,"_26412":118495,"_2810":118555},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3322":69569,"_29016":69544,"_20141":118557,"_5":13774,"_26412":118495,"_2810":118558},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3322":69570,"_29016":69544,"_20141":118560,"_5":13774,"_26412":118499,"_2810":118561},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3322":69571,"_29016":69544,"_20141":118563,"_5":13774,"_26412":118503,"_2810":118564},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3322":69572,"_29016":69544,"_20141":118566,"_5":13774,"_26412":118503,"_2810":118567},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3322":69573,"_29016":69544,"_20141":118569,"_5":13774,"_26412":118507,"_2810":118570},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3322":69574,"_29016":69544,"_20141":118572,"_5":13774,"_26412":118507,"_2810":118573},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3322":69575,"_29016":69544,"_20141":118575,"_5":13774,"_26412":118507,"_2810":118576},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3322":69576,"_29016":69544,"_20141":118578,"_5":13774,"_26412":118511,"_2810":118579},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3322":69577,"_29016":69544,"_20141":118581,"_5":13774,"_26412":118511,"_2810":118582},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3322":69578,"_29016":69544,"_20141":118584,"_5":13774,"_26412":118511,"_2810":118585},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3322":69579,"_29016":69544,"_20141":118587,"_5":13774,"_26412":118511,"_2810":118588},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3322":69580,"_29016":69544,"_20141":118590,"_5":13774,"_26412":118514,"_2810":118591},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3322":69581,"_29016":69581,"_5":14132,"_2810":118593,"_29339":118594,"_20141":118595,"_26412":69581},"Emite y verifica un certificado",[47234,112596,52689,115925],[],{"_3322":69582,"_29016":69581,"_20141":118597,"_5":13774,"_26412":69581,"_2810":118598},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3322":69583,"_29016":69581,"_5":29336,"_20141":118600,"_26412":118601,"_2810":111193},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3322":69584,"_29016":69581,"_5":29336,"_20141":118603,"_26412":118604,"_2810":118605},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3322":69585,"_29016":69581,"_5":29336,"_20141":118607,"_26412":118608,"_2810":118609},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3322":69586,"_29016":69581,"_5":29336,"_20141":118611,"_26412":118612,"_2810":118613},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3322":69587,"_29016":69581,"_5":29336,"_20141":118615,"_26412":118616,"_2810":118617},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3322":69588,"_29016":69581,"_5":29336,"_20141":118619,"_26412":118620,"_2810":118621},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3322":69589,"_29016":69581,"_5":29336,"_20141":118623,"_26412":118624,"_2810":118625},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3322":69590,"_29016":69581,"_5":29336,"_20141":118627,"_26412":118628,"_2810":118629},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3322":69591,"_29016":69581,"_5":29336,"_20141":118631,"_26412":118632,"_2810":118633},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3322":69592,"_29016":69581,"_5":29336,"_20141":118635,"_26412":118636,"_2810":118637},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3322":69593,"_29016":69581,"_5":29336,"_20141":118639,"_26412":118640,"_2810":116172},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3322":69594,"_29016":69581,"_5":29336,"_20141":118642,"_26412":118643,"_2810":111217},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3322":69595,"_29016":69581,"_20141":118645,"_5":13774,"_26412":69581,"_2810":118646},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3322":69596,"_29016":69581,"_20141":118648,"_5":13774,"_26412":118601,"_2810":118649},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3322":69597,"_29016":69581,"_20141":118651,"_5":13774,"_26412":118601,"_2810":118652},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3322":69598,"_29016":69581,"_20141":118654,"_5":13774,"_26412":118601,"_2810":118655},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3322":69599,"_29016":69581,"_20141":118657,"_5":13774,"_26412":118601,"_2810":118658},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3322":69600,"_29016":69581,"_20141":118660,"_5":13774,"_26412":118601,"_2810":118661},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3322":69601,"_29016":69581,"_20141":118663,"_5":13774,"_26412":118604,"_2810":118664},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3322":69602,"_29016":69581,"_20141":118666,"_5":13774,"_26412":118608,"_2810":118667},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3322":69603,"_29016":69581,"_20141":118669,"_5":13774,"_26412":118608,"_2810":118670},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3322":69604,"_29016":69581,"_20141":118672,"_5":13774,"_26412":118612,"_2810":118673},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3322":69605,"_29016":69581,"_20141":118675,"_5":13774,"_26412":118612,"_2810":118676},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3322":69606,"_29016":69581,"_20141":118678,"_5":13774,"_26412":118616,"_2810":118679},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3322":69607,"_29016":69581,"_20141":118681,"_5":13774,"_26412":118616,"_2810":118682},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3322":69608,"_29016":69581,"_20141":118684,"_5":13774,"_26412":118620,"_2810":118685},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3322":69609,"_29016":69581,"_20141":118687,"_5":13774,"_26412":118624,"_2810":118688},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3322":69610,"_29016":69581,"_20141":118690,"_5":13774,"_26412":118628,"_2810":118691},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3322":69611,"_29016":69581,"_20141":118693,"_5":13774,"_26412":118632,"_2810":118694},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3322":69612,"_29016":69581,"_20141":118696,"_5":13774,"_26412":118632,"_2810":118697},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3322":69613,"_29016":69581,"_20141":118699,"_5":13774,"_26412":118632,"_2810":118700},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3322":69614,"_29016":69581,"_20141":118702,"_5":13774,"_26412":118636,"_2810":118703},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3322":69615,"_29016":69581,"_20141":118705,"_5":13774,"_26412":118636,"_2810":118706},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3322":69616,"_29016":69581,"_20141":118708,"_5":13774,"_26412":118636,"_2810":118709},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3322":69617,"_29016":69581,"_20141":118711,"_5":13774,"_26412":118640,"_2810":116255},[],{"_3322":69618,"_29016":69581,"_20141":118713,"_5":13774,"_26412":118640,"_2810":114769},[],{"_3322":69619,"_29016":69581,"_20141":118715,"_5":13774,"_26412":118640,"_2810":118716},[],"La CA rechaza la emisión",{"_3322":69620,"_29016":69581,"_20141":118718,"_5":13774,"_26412":118640,"_2810":118719},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3322":69621,"_29016":69581,"_20141":118721,"_5":13774,"_26412":118640,"_2810":118722},[],"Sujeto o usos diferentes",{"_3322":69622,"_29016":69581,"_20141":118724,"_5":13774,"_26412":118640,"_2810":118725},[],"Perfil aplicado y valores solicitados.",{"_3322":69623,"_29016":69581,"_20141":118727,"_5":13774,"_26412":118640,"_2810":118728},[],"No se encuentra el emisor",{"_3322":69624,"_29016":69581,"_20141":118730,"_5":13774,"_26412":118640,"_2810":118731},[],"CA descargada y cadena intermedia necesaria.",{"_3322":69625,"_29016":69581,"_20141":118733,"_5":13774,"_26412":118640,"_2810":118734},[],"Falla la vigencia",{"_3322":69626,"_29016":69581,"_20141":118736,"_5":13774,"_26412":118640,"_2810":118737},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3322":69627,"_29016":69581,"_20141":118739,"_5":13774,"_26412":118640,"_2810":118740},[],"Los resúmenes de clave difieren",{"_3322":69628,"_29016":69581,"_20141":118742,"_5":13774,"_26412":118640,"_2810":118743},[],"Archivos de certificado y clave de la misma emisión.",{"_3322":69629,"_29016":69581,"_20141":118745,"_5":13774,"_26412":118640,"_2810":118746},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3322":69630,"_29016":69581,"_20141":118748,"_5":13774,"_26412":118643,"_2810":118749},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3322":69631,"_29016":69581,"_20141":118751,"_5":13774,"_26412":118643,"_2810":118752},[],"Gestionar certificados para inspección, estado y revocación.",{"_3322":69632,"_29016":69581,"_20141":118754,"_5":13774,"_26412":118643,"_2810":118755},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3322":69633,"_29016":69581,"_20141":118757,"_5":13774,"_26412":118643,"_2810":118758},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3322":69634,"_29016":69581,"_20141":118760,"_5":13774,"_26412":118643,"_2810":118761},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3322":69635,"_29016":69635,"_5":14132,"_2810":118763,"_29339":118764,"_20141":118765,"_26412":69635},"Primeros pasos de PKI",[47234,112596,52689,115925],[],{"_3322":69636,"_29016":69635,"_20141":118767,"_5":13774,"_26412":69635,"_2810":118768},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3322":69637,"_29016":69635,"_5":29336,"_20141":118770,"_26412":118771,"_2810":111193},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3322":69638,"_29016":69635,"_5":29336,"_20141":118773,"_26412":118774,"_2810":118775},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3322":69639,"_29016":69635,"_5":29336,"_20141":118777,"_26412":118778,"_2810":116107},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3322":69640,"_29016":69635,"_5":29336,"_20141":118780,"_26412":118781,"_2810":118782},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3322":69641,"_29016":69635,"_20141":118784,"_5":13774,"_26412":69635,"_2810":118785},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3322":69642,"_29016":69635,"_20141":118787,"_5":13774,"_26412":118771,"_2810":118788},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3322":69643,"_29016":69635,"_20141":118790,"_5":13774,"_26412":118771,"_2810":118791},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3322":69644,"_29016":69635,"_20141":118793,"_5":13774,"_26412":118771,"_2810":118794},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3322":69645,"_29016":69635,"_20141":118796,"_5":13774,"_26412":118771,"_2810":118797},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3322":69646,"_29016":69635,"_20141":118799,"_5":13774,"_26412":118771,"_2810":118800},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3322":69647,"_29016":69635,"_20141":118802,"_5":13774,"_26412":118774,"_2810":118803},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3322":69648,"_29016":69635,"_20141":118805,"_5":13774,"_26412":118774,"_2810":118806},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3322":69649,"_29016":69635,"_20141":118808,"_5":13774,"_26412":118774,"_2810":118809},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3322":69650,"_29016":69635,"_20141":118811,"_5":13774,"_26412":118774,"_2810":118812},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3322":69651,"_29016":69635,"_20141":118814,"_5":13774,"_26412":118778,"_2810":118815},[],"Archivo o recurso",{"_3322":69652,"_29016":69635,"_20141":118817,"_5":13774,"_26412":118778,"_2810":116104},[],{"_3322":69653,"_29016":69635,"_20141":118819,"_5":13774,"_26412":118778,"_2810":118820},[],"CA raíz activa y `ca.pem`",{"_3322":69654,"_29016":69635,"_20141":118822,"_5":13774,"_26412":118778,"_2810":118823},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3322":69655,"_29016":69635,"_20141":118825,"_5":13774,"_26412":118778,"_2810":118826},[],"Certificado final y `device.crt`",{"_3322":69656,"_29016":69635,"_20141":118828,"_5":13774,"_26412":118778,"_2810":118829},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3322":69657,"_29016":69635,"_20141":118831,"_5":13774,"_26412":118778,"_2810":118832},[],"Clave privada `device.key`",{"_3322":69658,"_29016":69635,"_20141":118834,"_5":13774,"_26412":118778,"_2810":118835},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3322":69659,"_29016":69635,"_20141":118837,"_5":13774,"_26412":118778,"_2810":118838},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3322":69660,"_29016":69635,"_20141":118840,"_5":13774,"_26412":118781,"_2810":118841},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3322":69661,"_29016":69635,"_20141":118843,"_5":13774,"_26412":118781,"_2810":118844},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3322":69662,"_29016":69635,"_20141":118846,"_5":13774,"_26412":118781,"_2810":118847},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3322":69663,"_29016":69663,"_5":14132,"_2810":118849,"_29339":118850,"_20141":118852,"_26412":69663},"Resolución de problemas PKI",[47234,112596,52689,118851],"Resolución de problemas",[],{"_3322":69664,"_29016":69663,"_20141":118854,"_5":13774,"_26412":69663,"_2810":118855},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3322":69665,"_29016":69663,"_5":29336,"_20141":118857,"_26412":118858,"_2810":118859},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3322":69666,"_29016":69663,"_5":29336,"_20141":118861,"_26412":118862,"_2810":118863},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3322":69667,"_29016":69663,"_5":29336,"_20141":118865,"_26412":118866,"_2810":118867},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3322":69668,"_29016":69663,"_20141":118869,"_5":13774,"_26412":69663,"_2810":118870},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3322":69669,"_29016":69663,"_20141":118872,"_5":13774,"_26412":69663,"_2810":118873},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3322":69670,"_29016":69663,"_20141":118875,"_5":13774,"_26412":118858,"_2810":116104},[],{"_3322":69671,"_29016":69663,"_20141":118877,"_5":13774,"_26412":118858,"_2810":114769},[],{"_3322":69672,"_29016":69663,"_20141":118879,"_5":13774,"_26412":118858,"_2810":111217},[],{"_3322":69673,"_29016":69663,"_20141":118881,"_5":13774,"_26412":118858,"_2810":51528},[],{"_3322":69674,"_29016":69663,"_20141":118883,"_5":13774,"_26412":118858,"_2810":118884},[],"Existe, está activa y sus fechas son utilizables.",{"_3322":69675,"_29016":69663,"_20141":118886,"_5":13774,"_26412":118858,"_2810":118887},[],"Autoridades.",{"_3322":69676,"_29016":69663,"_20141":118889,"_5":13774,"_26412":118858,"_2810":118890},[],"Clave",{"_3322":69677,"_29016":69663,"_20141":118892,"_5":13774,"_26412":118858,"_2810":118893},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3322":69678,"_29016":69663,"_20141":118895,"_5":13774,"_26412":118858,"_2810":118896},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3322":69679,"_29016":69663,"_20141":118898,"_5":13774,"_26412":118858,"_2810":55144},[],{"_3322":69680,"_29016":69663,"_20141":118900,"_5":13774,"_26412":118858,"_2810":118901},[],"PEM correcto y firma verificable.",{"_3322":69681,"_29016":69663,"_20141":118903,"_5":13774,"_26412":118858,"_2810":55150},[],{"_3322":69682,"_29016":69663,"_20141":118905,"_5":13774,"_26412":118858,"_2810":118906},[],"Perfil",{"_3322":69683,"_29016":69663,"_20141":118908,"_5":13774,"_26412":118858,"_2810":118909},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3322":69684,"_29016":69663,"_20141":118911,"_5":13774,"_26412":118858,"_2810":118912},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3322":69685,"_29016":69663,"_20141":118914,"_5":13774,"_26412":118858,"_2810":116255},[],{"_3322":69686,"_29016":69663,"_20141":118916,"_5":13774,"_26412":118858,"_2810":118917},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3322":69687,"_29016":69663,"_20141":118919,"_5":13774,"_26412":118858,"_2810":118920},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3322":69688,"_29016":69663,"_20141":118922,"_5":13774,"_26412":118858,"_2810":118923},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3322":69689,"_29016":69663,"_20141":118925,"_5":13774,"_26412":118858,"_2810":118926},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3322":69690,"_29016":69663,"_20141":118928,"_5":13774,"_26412":118862,"_2810":118929},[],"Revisa cada frontera por separado:",{"_3322":69691,"_29016":69663,"_20141":118931,"_5":13774,"_26412":118862,"_2810":118932},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3322":69692,"_29016":69663,"_20141":118934,"_5":13774,"_26412":118862,"_2810":118935},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3322":69693,"_29016":69663,"_20141":118937,"_5":13774,"_26412":118862,"_2810":118938},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3322":69694,"_29016":69663,"_20141":118940,"_5":13774,"_26412":118862,"_2810":118941},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3322":69695,"_29016":69663,"_20141":118943,"_5":13774,"_26412":118862,"_2810":118944},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3322":69696,"_29016":69663,"_20141":118946,"_5":13774,"_26412":118862,"_2810":118947},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3322":69697,"_29016":69663,"_20141":118949,"_5":13774,"_26412":118866,"_2810":118950},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3322":69698,"_29016":69663,"_20141":118952,"_5":13774,"_26412":118866,"_2810":118953},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3322":69699,"_29016":69699,"_5":14132,"_2810":118955,"_29339":118956,"_20141":118958,"_26412":69699},"3.8.0 a 4.0.0",[47234,118957],"Actualizaciones",[],{"_3322":69700,"_29016":69699,"_20141":118960,"_5":13774,"_26412":69699,"_2810":118961},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3322":69701,"_29016":69699,"_5":29336,"_20141":118963,"_26412":118964,"_2810":118965},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3322":69702,"_29016":69699,"_5":29336,"_20141":118967,"_26412":118968,"_2810":118969},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3322":69703,"_29016":69699,"_5":29336,"_20141":118971,"_26412":118972,"_2810":118973},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3322":69704,"_29016":69699,"_5":29336,"_20141":118975,"_26412":118976,"_2810":118977},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3322":69705,"_29016":69699,"_5":29336,"_20141":118979,"_26412":118980,"_2810":118981},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3322":69706,"_29016":69699,"_5":29336,"_20141":118983,"_26412":118984,"_2810":118985},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3322":69707,"_29016":69699,"_5":29336,"_20141":118987,"_26412":118988,"_2810":55236},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3322":69708,"_29016":69699,"_5":29336,"_20141":118990,"_26412":118991,"_2810":118992},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3322":69709,"_29016":69699,"_5":29336,"_20141":118994,"_26412":118995,"_2810":118996},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3322":69710,"_29016":69699,"_5":29336,"_20141":118998,"_26412":118999,"_2810":119000},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3322":69711,"_29016":69699,"_5":29336,"_20141":119002,"_26412":119003,"_2810":119004},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3322":69712,"_29016":69699,"_5":29336,"_20141":119006,"_26412":119007,"_2810":119008},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3322":69713,"_29016":69699,"_5":29336,"_20141":119010,"_26412":119011,"_2810":119012},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3322":69714,"_29016":69699,"_5":29336,"_20141":119014,"_26412":119015,"_2810":119016},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3322":69715,"_29016":69699,"_5":29336,"_20141":119018,"_26412":119019,"_2810":119020},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3322":69716,"_29016":69699,"_5":29336,"_20141":119022,"_26412":119023,"_2810":119024},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3322":69717,"_29016":69699,"_5":29336,"_20141":119026,"_26412":119027,"_2810":119028},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3322":69718,"_29016":69699,"_5":29336,"_20141":119030,"_26412":119031,"_2810":119032},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3322":69719,"_29016":69699,"_5":29336,"_20141":119034,"_26412":119035,"_2810":119036},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3322":69720,"_29016":69699,"_5":29336,"_20141":119038,"_26412":119039,"_2810":119040},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3322":69721,"_29016":69699,"_5":29336,"_20141":119042,"_26412":119043,"_2810":119044},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3322":69722,"_29016":69699,"_5":29336,"_20141":119046,"_26412":119047,"_2810":119048},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3322":69723,"_29016":69699,"_5":29336,"_20141":119050,"_26412":119051,"_2810":119052},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3322":69724,"_29016":69699,"_5":29336,"_20141":119054,"_26412":119055,"_2810":119056},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3322":69725,"_29016":69699,"_5":29336,"_20141":119058,"_26412":119059,"_2810":119060},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3322":69726,"_29016":69699,"_5":29336,"_20141":119062,"_26412":119063,"_2810":119064},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3322":69727,"_29016":69699,"_5":29336,"_20141":119066,"_26412":119067,"_2810":119068},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3322":69728,"_29016":69699,"_5":29336,"_20141":119070,"_26412":119071,"_2810":119072},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3322":69729,"_29016":69699,"_5":29336,"_20141":119074,"_26412":119075,"_2810":119076},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3322":69730,"_29016":69699,"_5":29336,"_20141":119078,"_26412":119079,"_2810":119080},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3322":69731,"_29016":69699,"_5":29336,"_20141":119082,"_26412":119083,"_2810":119084},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3322":69732,"_29016":69699,"_5":29336,"_20141":119086,"_26412":119087,"_2810":119088},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3322":69733,"_29016":69699,"_5":29336,"_20141":119090,"_26412":119091,"_2810":119092},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3322":69734,"_29016":69699,"_5":29336,"_20141":119094,"_26412":119095,"_2810":115115},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3322":69735,"_29016":69699,"_5":29336,"_20141":119097,"_26412":119098,"_2810":119099},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3322":69736,"_29016":69699,"_5":29336,"_20141":119101,"_26412":119102,"_2810":119103},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3322":69737,"_29016":69699,"_20141":119105,"_5":13774,"_26412":69699,"_2810":119106},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3322":69738,"_29016":69699,"_20141":119108,"_5":13774,"_26412":69699,"_2810":119109},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3322":69739,"_29016":69699,"_20141":119111,"_5":13774,"_26412":69699,"_2810":119112},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3322":69740,"_29016":69699,"_20141":119114,"_5":13774,"_26412":69699,"_2810":119115},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3322":69741,"_29016":69699,"_20141":119117,"_5":13774,"_26412":69699,"_2810":119118},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3322":69742,"_29016":69699,"_20141":119120,"_5":13774,"_26412":69699,"_2810":119121},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3322":69743,"_29016":69699,"_20141":119123,"_5":13774,"_26412":69699,"_2810":119124},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3322":69744,"_29016":69699,"_20141":119126,"_5":13774,"_26412":118968,"_2810":119127},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3322":69745,"_29016":69699,"_20141":119129,"_5":13774,"_26412":118968,"_2810":119130},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3322":69746,"_29016":69699,"_20141":119132,"_5":13774,"_26412":118972,"_2810":119133},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3322":69747,"_29016":69699,"_20141":119135,"_5":13774,"_26412":118972,"_2810":119136},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3322":69748,"_29016":69699,"_20141":119138,"_5":13774,"_26412":118976,"_2810":119139},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3322":69749,"_29016":69699,"_20141":119141,"_5":13774,"_26412":118980,"_2810":119142},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3322":69750,"_29016":69699,"_20141":119144,"_5":13774,"_26412":118980,"_2810":119145},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3322":69751,"_29016":69699,"_20141":119147,"_5":13774,"_26412":118980,"_2810":119148},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3322":69752,"_29016":69699,"_20141":119150,"_5":13774,"_26412":118980,"_2810":119151},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3322":69753,"_29016":69699,"_20141":119153,"_5":13774,"_26412":118980,"_2810":119154},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3322":69754,"_29016":69699,"_20141":119156,"_5":13774,"_26412":118984,"_2810":119157},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3322":69755,"_29016":69699,"_20141":119159,"_5":13774,"_26412":118984,"_2810":119160},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3322":69756,"_29016":69699,"_20141":119162,"_5":13774,"_26412":118984,"_2810":119163},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3322":69757,"_29016":69699,"_20141":119165,"_5":13774,"_26412":118984,"_2810":119166},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3322":69758,"_29016":69699,"_20141":119168,"_5":13774,"_26412":118984,"_2810":119169},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3322":69759,"_29016":69699,"_20141":119171,"_5":13774,"_26412":118988,"_2810":119172},[],"Cambio",{"_3322":69760,"_29016":69699,"_20141":119174,"_5":13774,"_26412":118988,"_2810":119175},[],"A quién afecta",{"_3322":69761,"_29016":69699,"_20141":119177,"_5":13774,"_26412":118988,"_2810":119178},[],"Gravedad",{"_3322":69762,"_29016":69699,"_20141":119180,"_5":13774,"_26412":118988,"_2810":117799},[],{"_3322":69763,"_29016":69699,"_20141":119182,"_5":13774,"_26412":118988,"_2810":118996},[],{"_3322":69764,"_29016":69699,"_20141":119184,"_5":13774,"_26412":118988,"_2810":119185},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3322":69765,"_29016":69699,"_20141":119187,"_5":13774,"_26412":118988,"_2810":119188},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3322":69766,"_29016":69699,"_20141":119190,"_5":13774,"_26412":118988,"_2810":119191},[],"Copiar los datos a los volúmenes nuevos",{"_3322":69767,"_29016":69699,"_20141":119193,"_5":13774,"_26412":118988,"_2810":119000},[],{"_3322":69768,"_29016":69699,"_20141":119195,"_5":13774,"_26412":118988,"_2810":119196},[],"Todas las releases de Helm",{"_3322":69769,"_29016":69699,"_20141":119198,"_5":13774,"_26412":118988,"_2810":119199},[],"Alta: `helm upgrade` falla",{"_3322":69770,"_29016":69699,"_20141":119201,"_5":13774,"_26412":118988,"_2810":119202},[],"Eliminar o renombrar las claves heredadas",{"_3322":69771,"_29016":69699,"_20141":119204,"_5":13774,"_26412":118988,"_2810":119004},[],{"_3322":69772,"_29016":69699,"_20141":119206,"_5":13774,"_26412":118988,"_2810":119207},[],"Todos los despliegues",{"_3322":69773,"_29016":69699,"_20141":119209,"_5":13774,"_26412":118988,"_2810":119210},[],"Alta: sin principal de bootstrap no hay administrador",{"_3322":69774,"_29016":69699,"_20141":119212,"_5":13774,"_26412":118988,"_2810":119213},[],"Configurar `services.authz`",{"_3322":69775,"_29016":69699,"_20141":119215,"_5":13774,"_26412":118988,"_2810":119008},[],{"_3322":69776,"_29016":69699,"_20141":119217,"_5":13774,"_26412":118988,"_2810":119196},[],{"_3322":69777,"_29016":69699,"_20141":119219,"_5":13774,"_26412":118988,"_2810":119220},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3322":69778,"_29016":69699,"_20141":119222,"_5":13774,"_26412":118988,"_2810":119223},[],"Mover JWKS y roles a `services.authz`",{"_3322":69779,"_29016":69699,"_20141":119225,"_5":13774,"_26412":118988,"_2810":119028},[],{"_3322":69780,"_29016":69699,"_20141":119227,"_5":13774,"_26412":118988,"_2810":119228},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3322":69781,"_29016":69699,"_20141":119230,"_5":13774,"_26412":118988,"_2810":119231},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3322":69782,"_29016":69699,"_20141":119233,"_5":13774,"_26412":118988,"_2810":119234},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3322":69783,"_29016":69699,"_20141":119236,"_5":13774,"_26412":118988,"_2810":119032},[],{"_3322":69784,"_29016":69699,"_20141":119238,"_5":13774,"_26412":118988,"_2810":119239},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3322":69785,"_29016":69699,"_20141":119241,"_5":13774,"_26412":118988,"_2810":119242},[],"Alta: el backend ya no arranca con ellos",{"_3322":69786,"_29016":69699,"_20141":119244,"_5":13774,"_26412":118988,"_2810":119245},[],"Pasar a PostgreSQL antes de actualizar",{"_3322":69787,"_29016":69699,"_20141":119247,"_5":13774,"_26412":118988,"_2810":119248},[],"Webhooks con referencias a archivos",{"_3322":69788,"_29016":69699,"_20141":119250,"_5":13774,"_26412":118988,"_2810":119251},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3322":69789,"_29016":69699,"_20141":119253,"_5":13774,"_26412":118988,"_2810":119254},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3322":69790,"_29016":69699,"_20141":119256,"_5":13774,"_26412":118988,"_2810":119257},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3322":69791,"_29016":69699,"_20141":119259,"_5":13774,"_26412":118988,"_2810":119012},[],{"_3322":69792,"_29016":69699,"_20141":119261,"_5":13774,"_26412":118988,"_2810":119262},[],"Releases con identidades por servicio o material de claves montado",{"_3322":69793,"_29016":69699,"_20141":119264,"_5":13774,"_26412":118988,"_2810":119265},[],"Media: los servicios no pueden leer sus archivos",{"_3322":69794,"_29016":69699,"_20141":119267,"_5":13774,"_26412":118988,"_2810":119268},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3322":69795,"_29016":69699,"_20141":119270,"_5":13774,"_26412":118988,"_2810":119016},[],{"_3322":69796,"_29016":69699,"_20141":119272,"_5":13774,"_26412":118988,"_2810":119273},[],"Releases que definen `amqp.tls`",{"_3322":69797,"_29016":69699,"_20141":119275,"_5":13774,"_26412":118988,"_2810":119276},[],"Media: los clientes se conectan al puerto equivocado",{"_3322":69798,"_29016":69699,"_20141":119278,"_5":13774,"_26412":118988,"_2810":119279},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3322":69799,"_29016":69699,"_20141":119281,"_5":13774,"_26412":118988,"_2810":119036},[],{"_3322":69800,"_29016":69699,"_20141":119283,"_5":13774,"_26412":118988,"_2810":119284},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3322":69801,"_29016":69699,"_20141":119286,"_5":13774,"_26412":118988,"_2810":119287},[],"Media: las claves de CA quedan sin gestionar",{"_3322":69802,"_29016":69699,"_20141":119289,"_5":13774,"_26412":118988,"_2810":119290},[],"Ejecutar la migración de CA a KMS",{"_3322":69803,"_29016":69699,"_20141":119292,"_5":13774,"_26412":118988,"_2810":119293},[],"Verificación del certificado del receptor",{"_3322":69804,"_29016":69699,"_20141":119295,"_5":13774,"_26412":118988,"_2810":119296},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3322":69805,"_29016":69699,"_20141":119298,"_5":13774,"_26412":118988,"_2810":119299},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3322":69806,"_29016":69699,"_20141":119301,"_5":13774,"_26412":118988,"_2810":119302},[],"Poner `insecure_skip_verify` a `false`",{"_3322":69807,"_29016":69699,"_20141":119304,"_5":13774,"_26412":118988,"_2810":119048},[],{"_3322":69808,"_29016":69699,"_20141":119306,"_5":13774,"_26412":118988,"_2810":119307},[],"Scripts y consolas que editan DMS por API",{"_3322":69809,"_29016":69699,"_20141":119309,"_5":13774,"_26412":118988,"_2810":119310},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3322":69810,"_29016":69699,"_20141":119312,"_5":13774,"_26412":118988,"_2810":119313},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3322":69811,"_29016":69699,"_20141":119315,"_5":13774,"_26412":118988,"_2810":119064},[],{"_3322":69812,"_29016":69699,"_20141":119317,"_5":13774,"_26412":118988,"_2810":119318},[],"Consumidores que leen el campo `events` del dispositivo",{"_3322":69813,"_29016":69699,"_20141":119320,"_5":13774,"_26412":118988,"_2810":119321},[],"Media: el campo desaparece",{"_3322":69814,"_29016":69699,"_20141":119323,"_5":13774,"_26412":118988,"_2810":119324},[],"Usar los nuevos endpoints de eventos",{"_3322":69815,"_29016":69699,"_20141":119326,"_5":13774,"_26412":118988,"_2810":119020},[],{"_3322":69816,"_29016":69699,"_20141":119328,"_5":13774,"_26412":118988,"_2810":119329},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3322":69817,"_29016":69699,"_20141":119331,"_5":13774,"_26412":118988,"_2810":119332},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3322":69818,"_29016":69699,"_20141":119334,"_5":13774,"_26412":118988,"_2810":119335},[],"Actualizar el archivo de values",{"_3322":69819,"_29016":69699,"_20141":119337,"_5":13774,"_26412":118988,"_2810":119056},[],{"_3322":69820,"_29016":69699,"_20141":119339,"_5":13774,"_26412":118988,"_2810":119340},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3322":69821,"_29016":69699,"_20141":119342,"_5":13774,"_26412":118988,"_2810":119343},[],"Baja: prevalece el ID de la URL",{"_3322":69822,"_29016":69699,"_20141":119345,"_5":13774,"_26412":118988,"_2810":119346},[],"Enviar el ID en la URL",{"_3322":69823,"_29016":69699,"_20141":119348,"_5":13774,"_26412":118988,"_2810":119060},[],{"_3322":69824,"_29016":69699,"_20141":119350,"_5":13774,"_26412":118988,"_2810":119351},[],"Consumidores que comparan el `type` del certificado",{"_3322":69825,"_29016":69699,"_20141":119353,"_5":13774,"_26412":118988,"_2810":119354},[],"Baja: dos valores cambian de nombre",{"_3322":69826,"_29016":69699,"_20141":119356,"_5":13774,"_26412":118988,"_2810":119357},[],"Adaptar los consumidores",{"_3322":69827,"_29016":69699,"_20141":119359,"_5":13774,"_26412":118988,"_2810":119052},[],{"_3322":69828,"_29016":69699,"_20141":119361,"_5":13774,"_26412":118988,"_2810":119362},[],"Cualquier DMS",{"_3322":69829,"_29016":69699,"_20141":119364,"_5":13774,"_26412":118988,"_2810":119365},[],"Baja: solo informativo",{"_3322":69830,"_29016":69699,"_20141":119367,"_5":13774,"_26412":118988,"_2810":119368},[],"Revisar ambos bloques antes de editar",{"_3322":69831,"_29016":69699,"_20141":119370,"_5":13774,"_26412":118995,"_2810":119371},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3322":69832,"_29016":69699,"_20141":119373,"_5":13774,"_26412":118995,"_2810":119374},[],"El paso 4 de la guía de migración copia los datos.",{"_3322":69833,"_29016":69699,"_20141":119376,"_5":13774,"_26412":118999,"_2810":119377},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3322":69834,"_29016":69699,"_20141":119379,"_5":13774,"_26412":119003,"_2810":119380},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3322":69835,"_29016":69699,"_20141":119382,"_5":13774,"_26412":119007,"_2810":119383},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3322":69836,"_29016":69699,"_20141":119385,"_5":13774,"_26412":119011,"_2810":119386},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3322":69837,"_29016":69699,"_20141":119388,"_5":13774,"_26412":119011,"_2810":119389},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3322":69838,"_29016":69699,"_20141":119391,"_5":13774,"_26412":119015,"_2810":119392},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3322":69839,"_29016":69699,"_20141":119394,"_5":13774,"_26412":119019,"_2810":119395},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3322":69840,"_29016":69699,"_20141":119397,"_5":13774,"_26412":119019,"_2810":119398},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3322":69841,"_29016":69699,"_20141":119400,"_5":13774,"_26412":119019,"_2810":119401},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3322":69842,"_29016":69699,"_20141":119403,"_5":13774,"_26412":119019,"_2810":119404},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3322":69843,"_29016":69699,"_20141":119406,"_5":13774,"_26412":119019,"_2810":119407},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3322":69844,"_29016":69699,"_20141":119409,"_5":13774,"_26412":119019,"_2810":119410},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3322":69845,"_29016":69699,"_20141":119412,"_5":13774,"_26412":119027,"_2810":119413},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3322":69846,"_29016":69699,"_20141":119415,"_5":13774,"_26412":119027,"_2810":119416},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3322":69847,"_29016":69699,"_20141":119418,"_5":13774,"_26412":119027,"_2810":119419},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3322":69848,"_29016":69699,"_20141":119421,"_5":13774,"_26412":119027,"_2810":119422},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3322":69849,"_29016":69699,"_20141":119424,"_5":13774,"_26412":119027,"_2810":119425},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3322":69850,"_29016":69699,"_20141":119427,"_5":13774,"_26412":119031,"_2810":119428},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3322":69851,"_29016":69699,"_20141":119430,"_5":13774,"_26412":119035,"_2810":119431},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3322":69852,"_29016":69699,"_20141":119433,"_5":13774,"_26412":119035,"_2810":119434},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3322":69853,"_29016":69699,"_20141":119436,"_5":13774,"_26412":119035,"_2810":119437},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3322":69854,"_29016":69699,"_20141":119439,"_5":13774,"_26412":119035,"_2810":119440},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3322":69855,"_29016":69699,"_20141":119442,"_5":13774,"_26412":119035,"_2810":119443},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3322":69856,"_29016":69699,"_20141":119445,"_5":13774,"_26412":119035,"_2810":119446},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3322":69857,"_29016":69699,"_20141":119448,"_5":13774,"_26412":119043,"_2810":119449},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3322":69858,"_29016":69699,"_20141":119451,"_5":13774,"_26412":119043,"_2810":119452},[],"Campo en 3.8.0",{"_3322":69859,"_29016":69699,"_20141":119454,"_5":13774,"_26412":119043,"_2810":119455},[],"Campo en 4.0.0",{"_3322":69860,"_29016":69699,"_20141":119457,"_5":13774,"_26412":119043,"_2810":55706},[],{"_3322":69861,"_29016":69699,"_20141":119459,"_5":13774,"_26412":119043,"_2810":119460},[],"`insecure_skip_verify` (con el valor negado)",{"_3322":69862,"_29016":69699,"_20141":119462,"_5":13774,"_26412":119043,"_2810":55712},[],{"_3322":69863,"_29016":69699,"_20141":119464,"_5":13774,"_26412":119043,"_2810":55715},[],{"_3322":69864,"_29016":69699,"_20141":119466,"_5":13774,"_26412":119043,"_2810":55718},[],{"_3322":69865,"_29016":69699,"_20141":119468,"_5":13774,"_26412":119043,"_2810":55721},[],{"_3322":69866,"_29016":69699,"_20141":119470,"_5":13774,"_26412":119043,"_2810":55724},[],{"_3322":69867,"_29016":69699,"_20141":119472,"_5":13774,"_26412":119043,"_2810":55727},[],{"_3322":69868,"_29016":69699,"_20141":119474,"_5":13774,"_26412":119043,"_2810":119475},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3322":69869,"_29016":69699,"_20141":119477,"_5":13774,"_26412":119043,"_2810":119478},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3322":69870,"_29016":69699,"_20141":119480,"_5":13774,"_26412":119043,"_2810":119481},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3322":69871,"_29016":69699,"_20141":119483,"_5":13774,"_26412":119047,"_2810":119484},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3322":69872,"_29016":69699,"_20141":119486,"_5":13774,"_26412":119047,"_2810":119487},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3322":69873,"_29016":69699,"_20141":119489,"_5":13774,"_26412":119047,"_2810":119490},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3322":69874,"_29016":69699,"_20141":119492,"_5":13774,"_26412":119051,"_2810":119493},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3322":69875,"_29016":69699,"_20141":119495,"_5":13774,"_26412":119055,"_2810":119496},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3322":69876,"_29016":69699,"_20141":119498,"_5":13774,"_26412":119059,"_2810":119499},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3322":69877,"_29016":69699,"_20141":119501,"_5":13774,"_26412":119063,"_2810":119502},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3322":69878,"_29016":69699,"_20141":119504,"_5":13774,"_26412":119063,"_2810":119505},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3322":69879,"_29016":69699,"_20141":119507,"_5":13774,"_26412":119063,"_2810":119508},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3322":69880,"_29016":69699,"_20141":119510,"_5":13774,"_26412":119063,"_2810":119511},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3322":69881,"_29016":69699,"_20141":119513,"_5":13774,"_26412":119067,"_2810":119514},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3322":69882,"_29016":69699,"_20141":119516,"_5":13774,"_26412":119071,"_2810":119517},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3322":69883,"_29016":69699,"_20141":119519,"_5":13774,"_26412":119071,"_2810":119520},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3322":69884,"_29016":69699,"_20141":119522,"_5":13774,"_26412":119071,"_2810":119523},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3322":69885,"_29016":69699,"_20141":119525,"_5":13774,"_26412":119071,"_2810":119526},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3322":69886,"_29016":69699,"_20141":119528,"_5":13774,"_26412":119071,"_2810":119529},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3322":69887,"_29016":69699,"_20141":119531,"_5":13774,"_26412":119075,"_2810":119532},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3322":69888,"_29016":69699,"_20141":119534,"_5":13774,"_26412":119075,"_2810":119535},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3322":69889,"_29016":69699,"_20141":119537,"_5":13774,"_26412":119075,"_2810":119538},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3322":69890,"_29016":69699,"_20141":119540,"_5":13774,"_26412":119075,"_2810":119541},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3322":69891,"_29016":69699,"_20141":119543,"_5":13774,"_26412":119075,"_2810":119544},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3322":69892,"_29016":69699,"_20141":119546,"_5":13774,"_26412":119075,"_2810":119547},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3322":69893,"_29016":69699,"_20141":119549,"_5":13774,"_26412":119075,"_2810":119550},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3322":69894,"_29016":69699,"_20141":119552,"_5":13774,"_26412":119075,"_2810":119553},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3322":69895,"_29016":69699,"_20141":119555,"_5":13774,"_26412":119075,"_2810":119556},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3322":69896,"_29016":69699,"_20141":119558,"_5":13774,"_26412":119075,"_2810":119559},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3322":69897,"_29016":69699,"_20141":119561,"_5":13774,"_26412":119075,"_2810":119562},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3322":69898,"_29016":69699,"_20141":119564,"_5":13774,"_26412":119075,"_2810":119565},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3322":69899,"_29016":69699,"_20141":119567,"_5":13774,"_26412":119079,"_2810":119568},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3322":69900,"_29016":69699,"_20141":119570,"_5":13774,"_26412":119079,"_2810":119571},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3322":69901,"_29016":69699,"_20141":119573,"_5":13774,"_26412":119083,"_2810":119574},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3322":69902,"_29016":69699,"_20141":119576,"_5":13774,"_26412":119083,"_2810":119577},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3322":69903,"_29016":69699,"_20141":119579,"_5":13774,"_26412":119083,"_2810":119580},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3322":69904,"_29016":69699,"_20141":119582,"_5":13774,"_26412":119083,"_2810":119583},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3322":69905,"_29016":69699,"_20141":119585,"_5":13774,"_26412":119083,"_2810":119586},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3322":69906,"_29016":69699,"_20141":119588,"_5":13774,"_26412":119083,"_2810":119589},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3322":69907,"_29016":69699,"_20141":119591,"_5":13774,"_26412":119083,"_2810":119592},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3322":69908,"_29016":69699,"_20141":119594,"_5":13774,"_26412":119083,"_2810":119595},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3322":69909,"_29016":69699,"_20141":119597,"_5":13774,"_26412":119083,"_2810":119598},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3322":69910,"_29016":69699,"_20141":119600,"_5":13774,"_26412":119083,"_2810":119601},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3322":69911,"_29016":69699,"_20141":119603,"_5":13774,"_26412":119083,"_2810":119604},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3322":69912,"_29016":69699,"_20141":119606,"_5":13774,"_26412":119087,"_2810":119607},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3322":69913,"_29016":69699,"_20141":119609,"_5":13774,"_26412":119087,"_2810":119610},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3322":69914,"_29016":69699,"_20141":119612,"_5":13774,"_26412":119091,"_2810":119613},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3322":69915,"_29016":69699,"_20141":119615,"_5":13774,"_26412":119091,"_2810":119616},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3322":69916,"_29016":69699,"_20141":119618,"_5":13774,"_26412":119091,"_2810":119619},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3322":69917,"_29016":69699,"_20141":119621,"_5":13774,"_26412":119091,"_2810":119622},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3322":69918,"_29016":69699,"_20141":119624,"_5":13774,"_26412":119091,"_2810":119625},[],"El README de `goose-lamassu` aún muestra ejemplos por base de datos (`dbname=ca`, `dbname=kms`) y afirma que la herramienta valida el nombre de la base de datos, y el README de `ca-to-kms-migration` sigue describiendo el modelo de dos bases anterior a 4.0.0. Sigue la forma con `dbname=pki` de esta página en lugar de sus ejemplos.",{"_3322":69919,"_29016":69699,"_20141":119627,"_5":13774,"_26412":119095,"_2810":119628},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3322":69920,"_29016":69699,"_20141":119630,"_5":13774,"_26412":119095,"_2810":119631},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3322":69921,"_29016":69699,"_20141":119633,"_5":13774,"_26412":119095,"_2810":119634},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3322":69922,"_29016":69699,"_20141":119636,"_5":13774,"_26412":119095,"_2810":119637},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3322":69923,"_29016":69699,"_20141":119639,"_5":13774,"_26412":119095,"_2810":119640},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3322":69924,"_29016":69699,"_20141":119642,"_5":13774,"_26412":119095,"_2810":119643},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3322":69925,"_29016":69699,"_20141":119645,"_5":13774,"_26412":119095,"_2810":119646},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3322":69926,"_29016":69699,"_20141":119648,"_5":13774,"_26412":119098,"_2810":119649},[],"Tras la actualización, comprueba en este orden:",{"_3322":69927,"_29016":69699,"_20141":119651,"_5":13774,"_26412":119098,"_2810":119652},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS.",{"_3322":69928,"_29016":69699,"_20141":119654,"_5":13774,"_26412":119098,"_2810":119655},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3322":69929,"_29016":69699,"_20141":119657,"_5":13774,"_26412":119098,"_2810":119658},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3322":69930,"_29016":69699,"_20141":119660,"_5":13774,"_26412":119098,"_2810":119661},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3322":69931,"_29016":69699,"_20141":119663,"_5":13774,"_26412":119098,"_2810":119664},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3322":69932,"_29016":69699,"_20141":119666,"_5":13774,"_26412":119098,"_2810":119667},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3322":69933,"_29016":69699,"_20141":119669,"_5":13774,"_26412":119098,"_2810":119670},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3322":69934,"_29016":69699,"_20141":119672,"_5":13774,"_26412":119098,"_2810":119673},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3322":69935,"_29016":69699,"_20141":119675,"_5":13774,"_26412":119098,"_2810":119676},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3322":69936,"_29016":69699,"_20141":119678,"_5":13774,"_26412":119098,"_2810":119679},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3322":69937,"_29016":69699,"_20141":119681,"_5":13774,"_26412":119098,"_2810":119682},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3322":69938,"_29016":69699,"_20141":119684,"_5":13774,"_26412":119098,"_2810":119685},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3322":69939,"_29016":69699,"_20141":119687,"_5":13774,"_26412":119098,"_2810":119688},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3322":69940,"_29016":69699,"_20141":119690,"_5":13774,"_26412":119098,"_2810":119691},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3322":69941,"_29016":69699,"_20141":119693,"_5":13774,"_26412":119102,"_2810":119694},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3322":69942,"_29016":69699,"_20141":119696,"_5":13774,"_26412":119102,"_2810":119697},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3322":69943,"_29016":69699,"_20141":119699,"_5":13774,"_26412":119102,"_2810":119700},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3322":69944,"_29016":69699,"_20141":119702,"_5":13774,"_26412":119102,"_2810":119703},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3322":69945,"_29016":69699,"_20141":119705,"_5":13774,"_26412":119102,"_2810":119706},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_55964":119708,"_55966":119709,"_55968":119710,"_55970":119711,"_17431":2832,"_67149":2832},"spanish",[2810,29016,5,26412],{"_2810":24054,"_29016":24054,"_5":24054,"_26412":24054},{"_2810":119712,"_29016":122505,"_5":125298,"_26412":128091},{"_4463":119713,"_55974":119714,"_5":24054},{"_13856":21944,"_14232":17506,"_14251":4306,"_12435":7310,"_14238":3888,"_19123":17505,"_13877":17289,"_13884":18690,"_27998":4686,"_28406":3684,"_28427":7148,"_28032":5515,"_33216":2920,"_28134":23888,"_28471":2850,"_33223":6233,"_33226":3830,"_33229":7155,"_33232":17219,"_28848":6645,"_33237":5461,"_33239":3997,"_28878":24059,"_14247":24615,"_33243":6860,"_33246":6634,"_33248":15366,"_28455":5508,"_28843":6679,"_28891":6677,"_33253":23472,"_33255":4852,"_33257":4238,"_28151":6698,"_33260":22883,"_33262":5700,"_33264":6642,"_33266":3302,"_33268":3366,"_28068":4858,"_33271":8820,"_33273":4554,"_28062":20626,"_28492":9993,"_33277":2992,"_33279":13575,"_33282":6173,"_28108":4538,"_33286":4970,"_27989":8652,"_33289":2895,"_28037":5743,"_33292":6282,"_33294":8262,"_33297":3112,"_14241":17452,"_33300":8676,"_33302":5761,"_33305":11681,"_33307":7237,"_33