6,"_41744":60439,"_41746":60442,"_41749":60445,"_41751":60448,"_41753":60451,"_41755":60454,"_41757":60457,"_41759":60460,"_41761":60463,"_41763":60466,"_41765":60469,"_41767":60472,"_41769":60475,"_41771":60478,"_41773":60481,"_41775":60484,"_41778":60487,"_41780":60490,"_41782":60493,"_41784":60496,"_41786":60499,"_41788":60502,"_41790":60505,"_41792":60508,"_41794":60511,"_41796":60514,"_41798":60517,"_41800":60520,"_41802":60523,"_41804":60526,"_41806":60529,"_41808":60532,"_41810":60535,"_41812":60538,"_41814":60541,"_41816":60544,"_41818":60547,"_41820":60550,"_41822":60553,"_41824":60556,"_41826":60559,"_41828":60562,"_41830":60565,"_41832":60568,"_41834":60571,"_41836":60574,"_41838":60577,"_41840":60580,"_41843":60583,"_41845":60586,"_41847":60589,"_41849":60592},{"_3699":15,"_31384":15,"_5":15283,"_3075":51092,"_31709":51093,"_21647":51097,"_28559":15},"Deploy from AWS Marketplace",[51094,51095,51096],"Docs","Deployment","Other models",[],{"_3699":16,"_31384":15,"_21647":51099,"_5":14929,"_28559":15,"_3075":51100},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3699":17,"_31384":15,"_5":31706,"_21647":51102,"_28559":51103,"_3075":51104},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3699":18,"_31384":15,"_5":31706,"_21647":51106,"_28559":51107,"_3075":51108},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3699":19,"_31384":15,"_5":31706,"_21647":51110,"_28559":51111,"_3075":51112},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3699":20,"_31384":15,"_5":31706,"_21647":51114,"_28559":51115,"_3075":51116},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3699":21,"_31384":15,"_5":31706,"_21647":51118,"_28559":51119,"_3075":51120},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3699":22,"_31384":15,"_5":31706,"_21647":51122,"_28559":51123,"_3075":51124},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3699":23,"_31384":15,"_5":31706,"_21647":51126,"_28559":51127,"_3075":51128},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3699":24,"_31384":15,"_21647":51130,"_5":14929,"_28559":15,"_3075":51131},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3699":25,"_31384":15,"_21647":51133,"_5":14929,"_28559":51103,"_3075":51134},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3699":26,"_31384":15,"_21647":51136,"_5":14929,"_28559":51103,"_3075":51137},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3699":27,"_31384":15,"_21647":51139,"_5":14929,"_28559":51103,"_3075":51140},[],"A security group allowing the necessary endpoints.",{"_3699":28,"_31384":15,"_21647":51142,"_5":14929,"_28559":51107,"_3075":51143},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3699":29,"_31384":15,"_21647":51145,"_5":14929,"_28559":51107,"_3075":51146},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3699":30,"_31384":15,"_21647":51148,"_5":14929,"_28559":51107,"_3075":51149},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3699":31,"_31384":15,"_21647":51151,"_5":14929,"_28559":51111,"_3075":51152},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3699":32,"_31384":15,"_21647":51154,"_5":14929,"_28559":51115,"_3075":51155},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3699":33,"_31384":15,"_21647":51157,"_5":14929,"_28559":51119,"_3075":51158},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3699":34,"_31384":15,"_21647":51160,"_5":14929,"_28559":51123,"_3075":51161},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3699":35,"_31384":15,"_21647":51163,"_5":14929,"_28559":51127,"_3075":51164},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3699":36,"_31384":36,"_5":15283,"_3075":51166,"_31709":51167,"_21647":51168,"_28559":36},"Deploy Lamassu",[51094,51095],[],{"_3699":37,"_31384":36,"_21647":51170,"_5":14929,"_28559":36,"_3075":51171},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3699":38,"_31384":36,"_5":31706,"_21647":51173,"_28559":51174,"_3075":51175},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3699":39,"_31384":36,"_5":31706,"_21647":51177,"_28559":51178,"_3075":51179},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3699":40,"_31384":36,"_5":31706,"_21647":51181,"_28559":51182,"_3075":51183},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3699":41,"_31384":36,"_21647":51185,"_5":14929,"_28559":36,"_3075":51186},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3699":42,"_31384":36,"_21647":51188,"_5":14929,"_28559":51174,"_3075":51189},[],"Model",{"_3699":43,"_31384":36,"_21647":51191,"_5":14929,"_28559":51174,"_3075":51192},[],"Recommended for",{"_3699":44,"_31384":36,"_21647":51194,"_5":14929,"_28559":51174,"_3075":51195},[],"Who operates the infrastructure",{"_3699":45,"_31384":36,"_21647":51197,"_5":14929,"_28559":51174,"_3075":51198},[],"Starting point",{"_3699":46,"_31384":36,"_21647":51200,"_5":14929,"_28559":51174,"_3075":51201},[],"Kubernetes self-managed",{"_3699":47,"_31384":36,"_21647":51203,"_5":14929,"_28559":51174,"_3075":51204},[],"Production, regulated environments and custom deployments",{"_3699":48,"_31384":36,"_21647":51206,"_5":14929,"_28559":51174,"_3075":51207},[],"Your team",{"_3699":49,"_31384":36,"_21647":51209,"_5":14929,"_28559":51174,"_3075":51210},[],"Helm or Fastlane",{"_3699":50,"_31384":36,"_21647":51212,"_5":14929,"_28559":51174,"_3075":51213},[],"AWS Marketplace",{"_3699":51,"_31384":36,"_21647":51215,"_5":14929,"_28559":51174,"_3075":51216},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3699":52,"_31384":36,"_21647":51218,"_5":14929,"_28559":51174,"_3075":51207},[],{"_3699":53,"_31384":36,"_21647":51220,"_5":14929,"_28559":51174,"_3075":51221},[],"Preconfigured image on EC2",{"_3699":54,"_31384":36,"_21647":51223,"_5":14929,"_28559":51174,"_3075":51224},[],"SaaS",{"_3699":55,"_31384":36,"_21647":51226,"_5":14929,"_28559":51174,"_3075":51227},[],"Teams that want to use the platform without operating it",{"_3699":56,"_31384":36,"_21647":51229,"_5":14929,"_28559":51174,"_3075":51230},[],"Lamassu",{"_3699":57,"_31384":36,"_21647":51232,"_5":14929,"_28559":51174,"_3075":51233},[],"Managed subscription",{"_3699":58,"_31384":36,"_21647":51235,"_5":14929,"_28559":51174,"_3075":51236},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3699":59,"_31384":36,"_21647":51238,"_5":14929,"_28559":51174,"_3075":51239},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3699":60,"_31384":36,"_21647":51241,"_5":14929,"_28559":51174,"_3075":51242},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3699":61,"_31384":36,"_21647":51244,"_5":14929,"_28559":51178,"_3075":51245},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3699":62,"_31384":36,"_21647":51247,"_5":14929,"_28559":51182,"_3075":51248},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3699":63,"_31384":63,"_5":15283,"_3075":51250,"_31709":51251,"_21647":51252,"_28559":63},"Use Lamassu as SaaS",[51094,51095,51096],[],{"_3699":64,"_31384":63,"_21647":51254,"_5":14929,"_28559":63,"_3075":51255},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3699":65,"_31384":63,"_5":31706,"_21647":51257,"_28559":51258,"_3075":51259},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3699":66,"_31384":63,"_5":31706,"_21647":51261,"_28559":51262,"_3075":51263},[],"/docs/deployment/saas#plans","Plans",{"_3699":67,"_31384":63,"_5":31706,"_21647":51265,"_28559":51266,"_3075":51267},[],"/docs/deployment/saas#request-access","Request access",{"_3699":68,"_31384":63,"_21647":51269,"_5":14929,"_28559":63,"_3075":51270},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3699":69,"_31384":63,"_21647":51272,"_5":14929,"_28559":51258,"_3075":51273},[],"Platform availability and maintenance.",{"_3699":70,"_31384":63,"_21647":51275,"_5":14929,"_28559":51258,"_3075":51276},[],"Automatic backups.",{"_3699":71,"_31384":63,"_21647":51278,"_5":14929,"_28559":51258,"_3075":51279},[],"Version upgrades.",{"_3699":72,"_31384":63,"_21647":51281,"_5":14929,"_28559":51258,"_3075":51282},[],"Technical support and SLA according to your plan.",{"_3699":73,"_31384":63,"_21647":51284,"_5":14929,"_28559":51262,"_3075":51285},[],"Plan",{"_3699":74,"_31384":63,"_21647":51287,"_5":14929,"_28559":51262,"_3075":51288},[],"Devices",{"_3699":75,"_31384":63,"_21647":51290,"_5":14929,"_28559":51262,"_3075":51291},[],"Support",{"_3699":76,"_31384":63,"_21647":51293,"_5":14929,"_28559":51262,"_3075":51294},[],"SLA",{"_3699":77,"_31384":63,"_21647":51296,"_5":14929,"_28559":51262,"_3075":51297},[],"Starter",{"_3699":78,"_31384":63,"_21647":51299,"_5":14929,"_28559":51262,"_3075":51300},[],"Up to 1,000",{"_3699":79,"_31384":63,"_21647":51302,"_5":14929,"_28559":51262,"_3075":51303},[],"Email",{"_3699":80,"_31384":63,"_21647":51305,"_5":14929,"_28559":51262,"_3075":51306},[],"99.5 %",{"_3699":81,"_31384":63,"_21647":51308,"_5":14929,"_28559":51262,"_3075":51309},[],"Professional",{"_3699":82,"_31384":63,"_21647":51311,"_5":14929,"_28559":51262,"_3075":51312},[],"Up to 10,000",{"_3699":83,"_31384":63,"_21647":51314,"_5":14929,"_28559":51262,"_3075":51315},[],"Email and chat",{"_3699":84,"_31384":63,"_21647":51317,"_5":14929,"_28559":51262,"_3075":51318},[],"99.9 %",{"_3699":85,"_31384":63,"_21647":51320,"_5":14929,"_28559":51262,"_3075":51321},[],"Enterprise",{"_3699":86,"_31384":63,"_21647":51323,"_5":14929,"_28559":51262,"_3075":51324},[],"Unlimited",{"_3699":87,"_31384":63,"_21647":51326,"_5":14929,"_28559":51262,"_3075":51327},[],"Dedicated",{"_3699":88,"_31384":63,"_21647":51329,"_5":14929,"_28559":51262,"_3075":51330},[],"99.99 %",{"_3699":89,"_31384":63,"_21647":51332,"_5":14929,"_28559":51266,"_3075":51333},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3699":90,"_31384":63,"_21647":51335,"_5":14929,"_28559":51266,"_3075":51336},[],"When you receive your instance's credentials, continue with Get started.",{"_3699":91,"_31384":91,"_5":15283,"_3075":51338,"_31709":51339,"_21647":51340,"_28559":91},"Fastlane",[51094,51095,51201],[],{"_3699":92,"_31384":91,"_21647":51342,"_5":14929,"_28559":91,"_3075":51343},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3699":93,"_31384":91,"_5":31706,"_21647":51345,"_28559":51346,"_3075":51347},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3699":94,"_31384":91,"_5":31706,"_21647":51349,"_28559":51350,"_3075":51351},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3699":95,"_31384":91,"_5":31706,"_21647":51353,"_28559":51354,"_3075":51104},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3699":96,"_31384":91,"_5":31706,"_21647":51356,"_28559":51357,"_3075":51358},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3699":97,"_31384":91,"_5":31706,"_21647":51360,"_28559":51361,"_3075":51362},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3699":98,"_31384":91,"_5":31706,"_21647":51364,"_28559":51365,"_3075":51366},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3699":99,"_31384":91,"_5":31706,"_21647":51368,"_28559":51369,"_3075":51370},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3699":100,"_31384":91,"_5":31706,"_21647":51372,"_28559":51373,"_3075":51374},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3699":101,"_31384":91,"_5":31706,"_21647":51376,"_28559":51377,"_3075":51378},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3699":102,"_31384":91,"_5":31706,"_21647":51380,"_28559":51381,"_3075":51382},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3699":103,"_31384":91,"_5":31706,"_21647":51384,"_28559":51385,"_3075":51386},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3699":104,"_31384":91,"_21647":51388,"_5":14929,"_28559":51346,"_3075":51389},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3699":105,"_31384":91,"_21647":51391,"_5":14929,"_28559":51346,"_3075":51392},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3699":106,"_31384":91,"_21647":51394,"_5":14929,"_28559":51350,"_3075":51395},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3699":107,"_31384":91,"_21647":51397,"_5":14929,"_28559":51350,"_3075":51398},[],"Fastlane installs or configures",{"_3699":108,"_31384":91,"_21647":51400,"_5":14929,"_28559":51350,"_3075":51401},[],"You still provide",{"_3699":109,"_31384":91,"_21647":51403,"_5":14929,"_28559":51350,"_3075":51404},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3699":110,"_31384":91,"_21647":51406,"_5":14929,"_28559":51350,"_3075":51407},[],"The Kubernetes cluster, nodes and persistent storage",{"_3699":111,"_31384":91,"_21647":51409,"_5":14929,"_28559":51350,"_3075":51410},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3699":112,"_31384":91,"_21647":51412,"_5":14929,"_28559":51350,"_3075":51413},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3699":113,"_31384":91,"_21647":51415,"_5":14929,"_28559":51350,"_3075":51416},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3699":114,"_31384":91,"_21647":51418,"_5":14929,"_28559":51350,"_3075":51419},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3699":115,"_31384":91,"_21647":51421,"_5":14929,"_28559":51350,"_3075":51422},[],"Optional observability and lab HSM components",{"_3699":116,"_31384":91,"_21647":51424,"_5":14929,"_28559":51350,"_3075":51425},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3699":117,"_31384":91,"_21647":51427,"_5":14929,"_28559":51350,"_3075":51428},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3699":118,"_31384":91,"_21647":51430,"_5":14929,"_28559":51354,"_3075":51431},[],"You need:",{"_3699":119,"_31384":91,"_21647":51433,"_5":14929,"_28559":51354,"_3075":51434},[],"an existing Kubernetes cluster",{"_3699":120,"_31384":91,"_21647":51436,"_5":14929,"_28559":51354,"_3075":51437},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3699":121,"_31384":91,"_21647":51439,"_5":14929,"_28559":51354,"_3075":51440},[],"`yq`",{"_3699":122,"_31384":91,"_21647":51442,"_5":14929,"_28559":51354,"_3075":24470},[],{"_3699":123,"_31384":91,"_21647":51444,"_5":14929,"_28559":51354,"_3075":51445},[],"`jq` only when using `--sample-data` or `--development`",{"_3699":124,"_31384":91,"_21647":51447,"_5":14929,"_28559":51354,"_3075":51448},[],"`ssh-keygen` only when using `--with-hsm`",{"_3699":125,"_31384":91,"_21647":51450,"_5":14929,"_28559":51354,"_3075":51451},[],"free external ports 80 and 443 on a single-node K3s host",{"_3699":126,"_31384":91,"_21647":51453,"_5":14929,"_28559":51354,"_3075":51454},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3699":127,"_31384":91,"_21647":51456,"_5":14929,"_28559":51354,"_3075":51457},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3699":128,"_31384":91,"_21647":51459,"_5":14929,"_28559":51357,"_3075":51460},[],"Run the script from a clone of the Helm repository:",{"_3699":129,"_31384":91,"_21647":51462,"_5":14929,"_28559":51357,"_3075":51463},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3699":130,"_31384":91,"_21647":51465,"_5":14929,"_28559":51361,"_3075":51466},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3699":131,"_31384":91,"_21647":51468,"_5":14929,"_28559":51361,"_3075":51469},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3699":132,"_31384":91,"_21647":51471,"_5":14929,"_28559":51361,"_3075":51472},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3699":133,"_31384":91,"_21647":51474,"_5":14929,"_28559":51361,"_3075":51475},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3699":134,"_31384":91,"_21647":51477,"_5":14929,"_28559":51365,"_3075":51478},[],"Option",{"_3699":135,"_31384":91,"_21647":51480,"_5":14929,"_28559":51365,"_3075":51481},[],"Default",{"_3699":136,"_31384":91,"_21647":51483,"_5":14929,"_28559":51365,"_3075":51484},[],"Purpose",{"_3699":137,"_31384":91,"_21647":51486,"_5":14929,"_28559":51365,"_3075":51487},[],"`-h`, `--help`",{"_3699":138,"_31384":91,"_21647":51489,"_5":14929,"_28559":51365,"_3075":51490},[],"—",{"_3699":139,"_31384":91,"_21647":51492,"_5":14929,"_28559":51365,"_3075":51493},[],"Show help",{"_3699":140,"_31384":91,"_21647":51495,"_5":14929,"_28559":51365,"_3075":51496},[],"`-c`, `--context`",{"_3699":141,"_31384":91,"_21647":51498,"_5":14929,"_28559":51365,"_3075":51499},[],"current context",{"_3699":142,"_31384":91,"_21647":51501,"_5":14929,"_28559":51365,"_3075":51502},[],"Select the kubeconfig context for kubectl and Helm",{"_3699":143,"_31384":91,"_21647":51504,"_5":14929,"_28559":51365,"_3075":51505},[],"`-n`, `--non-interactive`",{"_3699":144,"_31384":91,"_21647":51507,"_5":14929,"_28559":51365,"_3075":6825},[],{"_3699":145,"_31384":91,"_21647":51509,"_5":14929,"_28559":51365,"_3075":51510},[],"Skip prompts and generate dependency credentials",{"_3699":146,"_31384":91,"_21647":51512,"_5":14929,"_28559":51365,"_3075":51513},[],"`-ns`, `--namespace`",{"_3699":147,"_31384":91,"_21647":51515,"_5":14929,"_28559":51365,"_3075":51516},[],"`lamassu-dev`",{"_3699":148,"_31384":91,"_21647":51518,"_5":14929,"_28559":51365,"_3075":51519},[],"Namespace for the installation",{"_3699":149,"_31384":91,"_21647":51521,"_5":14929,"_28559":51365,"_3075":51522},[],"`-d`, `--domain`",{"_3699":150,"_31384":91,"_21647":51524,"_5":14929,"_28559":51365,"_3075":51525},[],"`dev.lamassu.io`",{"_3699":151,"_31384":91,"_21647":51527,"_5":14929,"_28559":51365,"_3075":51528},[],"Domain used by the UI, OIDC and certificate",{"_3699":152,"_31384":91,"_21647":51530,"_5":14929,"_28559":51365,"_3075":51531},[],"`-v`, `--version`",{"_3699":153,"_31384":91,"_21647":51533,"_5":14929,"_28559":51365,"_3075":15617},[],{"_3699":154,"_31384":91,"_21647":51535,"_5":14929,"_28559":51365,"_3075":51536},[],"Lamassu chart version",{"_3699":155,"_31384":91,"_21647":51538,"_5":14929,"_28559":51365,"_3075":51539},[],"`--https-port`",{"_3699":156,"_31384":91,"_21647":51541,"_5":14929,"_28559":51365,"_3075":51542},[],"`443`",{"_3699":157,"_31384":91,"_21647":51544,"_5":14929,"_28559":51365,"_3075":51545},[],"Gateway HTTPS listener port",{"_3699":158,"_31384":91,"_21647":51547,"_5":14929,"_28559":51365,"_3075":51548},[],"`--http-port`",{"_3699":159,"_31384":91,"_21647":51550,"_5":14929,"_28559":51365,"_3075":51551},[],"`80`",{"_3699":160,"_31384":91,"_21647":51553,"_5":14929,"_28559":51365,"_3075":51554},[],"Gateway HTTP listener port",{"_3699":161,"_31384":91,"_21647":51556,"_5":14929,"_28559":51365,"_3075":51557},[],"`--tls-crt`",{"_3699":162,"_31384":91,"_21647":51559,"_5":14929,"_28559":51365,"_3075":51490},[],{"_3699":163,"_31384":91,"_21647":51561,"_5":14929,"_28559":51365,"_3075":51562},[],"PEM certificate for downstream TLS",{"_3699":164,"_31384":91,"_21647":51564,"_5":14929,"_28559":51365,"_3075":51565},[],"`--tls-key`",{"_3699":165,"_31384":91,"_21647":51567,"_5":14929,"_28559":51365,"_3075":51490},[],{"_3699":166,"_31384":91,"_21647":51569,"_5":14929,"_28559":51365,"_3075":51570},[],"PEM private key for downstream TLS",{"_3699":167,"_31384":91,"_21647":51572,"_5":14929,"_28559":51365,"_3075":51573},[],"`-l`, `--local-chart-path`",{"_3699":168,"_31384":91,"_21647":51575,"_5":14929,"_28559":51365,"_3075":51576},[],"repository chart",{"_3699":169,"_31384":91,"_21647":51578,"_5":14929,"_28559":51365,"_3075":51579},[],"Use an unpacked local Lamassu chart",{"_3699":170,"_31384":91,"_21647":51581,"_5":14929,"_28559":51365,"_3075":51582},[],"`-ip`, `--gateway-ip`",{"_3699":171,"_31384":91,"_21647":51584,"_5":14929,"_28559":51365,"_3075":9102},[],{"_3699":172,"_31384":91,"_21647":51586,"_5":14929,"_28559":51365,"_3075":51587},[],"Override the address written to `gateway.addresses`",{"_3699":173,"_31384":91,"_21647":51589,"_5":14929,"_28559":51365,"_3075":51590},[],"`--otel`",{"_3699":174,"_31384":91,"_21647":51592,"_5":14929,"_28559":51365,"_3075":6825},[],{"_3699":175,"_31384":91,"_21647":51594,"_5":14929,"_28559":51365,"_3075":51595},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3699":176,"_31384":91,"_21647":51597,"_5":14929,"_28559":51365,"_3075":51598},[],"`--development`",{"_3699":177,"_31384":91,"_21647":51600,"_5":14929,"_28559":51365,"_3075":6825},[],{"_3699":178,"_31384":91,"_21647":51602,"_5":14929,"_28559":51365,"_3075":51603},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3699":179,"_31384":91,"_21647":51605,"_5":14929,"_28559":51365,"_3075":51606},[],"`--sample-data`",{"_3699":180,"_31384":91,"_21647":51608,"_5":14929,"_28559":51365,"_3075":6825},[],{"_3699":181,"_31384":91,"_21647":51610,"_5":14929,"_28559":51365,"_3075":51611},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3699":182,"_31384":91,"_21647":51613,"_5":14929,"_28559":51365,"_3075":51614},[],"`--with-hsm`",{"_3699":183,"_31384":91,"_21647":51616,"_5":14929,"_28559":51365,"_3075":6825},[],{"_3699":184,"_31384":91,"_21647":51618,"_5":14929,"_28559":51365,"_3075":51619},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3699":185,"_31384":91,"_21647":51621,"_5":14929,"_28559":51365,"_3075":51622},[],"`--softhsm-chart-path`",{"_3699":186,"_31384":91,"_21647":51624,"_5":14929,"_28559":51365,"_3075":51625},[],"`./charts/softhsm`",{"_3699":187,"_31384":91,"_21647":51627,"_5":14929,"_28559":51365,"_3075":51628},[],"Use a different local SoftHSM chart",{"_3699":188,"_31384":91,"_21647":51630,"_5":14929,"_28559":51365,"_3075":51631},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3699":189,"_31384":91,"_21647":51633,"_5":14929,"_28559":51369,"_3075":51634},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3699":190,"_31384":91,"_21647":51636,"_5":14929,"_28559":51369,"_3075":51637},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3699":191,"_31384":91,"_21647":51639,"_5":14929,"_28559":51369,"_3075":51640},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3699":192,"_31384":91,"_21647":51642,"_5":14929,"_28559":51369,"_3075":51643},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3699":193,"_31384":91,"_21647":51645,"_5":14929,"_28559":51369,"_3075":51646},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3699":194,"_31384":91,"_21647":51648,"_5":14929,"_28559":51369,"_3075":51649},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3699":195,"_31384":91,"_21647":51651,"_5":14929,"_28559":51373,"_3075":51652},[],"Fastlane:",{"_3699":196,"_31384":91,"_21647":51654,"_5":14929,"_28559":51373,"_3075":51655},[],"validates local tools and the selected cluster",{"_3699":197,"_31384":91,"_21647":51657,"_5":14929,"_28559":51373,"_3075":51658},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3699":198,"_31384":91,"_21647":51660,"_5":14929,"_28559":51373,"_3075":51661},[],"creates the namespace",{"_3699":199,"_31384":91,"_21647":51663,"_5":14929,"_28559":51373,"_3075":51664},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3699":200,"_31384":91,"_21647":51666,"_5":14929,"_28559":51373,"_3075":51667},[],"installs PostgreSQL and creates the required databases",{"_3699":201,"_31384":91,"_21647":51669,"_5":14929,"_28559":51373,"_3075":51670},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3699":202,"_31384":91,"_21647":51672,"_5":14929,"_28559":51373,"_3075":51673},[],"installs RabbitMQ",{"_3699":203,"_31384":91,"_21647":51675,"_5":14929,"_28559":51373,"_3075":51676},[],"optionally installs observability and lab HSM components",{"_3699":204,"_31384":91,"_21647":51678,"_5":14929,"_28559":51373,"_3075":51679},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3699":205,"_31384":91,"_21647":51681,"_5":14929,"_28559":51373,"_3075":51682},[],"optionally loads sample data",{"_3699":206,"_31384":91,"_21647":51684,"_5":14929,"_28559":51373,"_3075":51685},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3699":207,"_31384":91,"_21647":51687,"_5":14929,"_28559":51377,"_3075":51688},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3699":208,"_31384":91,"_21647":51690,"_5":14929,"_28559":51377,"_3075":51691},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3699":209,"_31384":91,"_21647":51693,"_5":14929,"_28559":51381,"_3075":51694},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3699":210,"_31384":91,"_21647":51696,"_5":14929,"_28559":51381,"_3075":51697},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3699":211,"_31384":91,"_21647":51699,"_5":14929,"_28559":51381,"_3075":51700},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3699":212,"_31384":91,"_21647":51702,"_5":14929,"_28559":51381,"_3075":51703},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3699":213,"_31384":91,"_21647":51705,"_5":14929,"_28559":51385,"_3075":51706},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3699":214,"_31384":214,"_5":15283,"_3075":51708,"_31709":51709,"_21647":51710,"_28559":214},"Install with Helm",[51094,51095,51201],[],{"_3699":215,"_31384":214,"_21647":51712,"_5":14929,"_28559":214,"_3075":51713},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3699":216,"_31384":214,"_5":31706,"_21647":51715,"_28559":51716,"_3075":51717},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3699":217,"_31384":214,"_5":31706,"_21647":51719,"_28559":51720,"_3075":51104},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3699":218,"_31384":214,"_5":31706,"_21647":51722,"_28559":51723,"_3075":51724},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3699":219,"_31384":214,"_5":31706,"_21647":51726,"_28559":51727,"_3075":51728},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3699":220,"_31384":214,"_5":31706,"_21647":51730,"_28559":51731,"_3075":51732},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3699":221,"_31384":214,"_5":31706,"_21647":51734,"_28559":51735,"_3075":51736},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3699":222,"_31384":214,"_5":31706,"_21647":51738,"_28559":51739,"_3075":51740},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3699":223,"_31384":214,"_5":31706,"_21647":51742,"_28559":51743,"_3075":51744},[],"/docs/deployment/self-hosted/helm#device-event-stream-sse","Device event stream (SSE)",{"_3699":224,"_31384":214,"_5":31706,"_21647":51746,"_28559":51747,"_3075":51748},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3699":225,"_31384":214,"_5":31706,"_21647":51750,"_28559":51751,"_3075":51752},[],"/docs/deployment/self-hosted/helm#experimental-dashboard-terminal-optional","Experimental dashboard terminal (optional)",{"_3699":226,"_31384":214,"_5":31706,"_21647":51754,"_28559":51755,"_3075":51756},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3699":227,"_31384":214,"_5":31706,"_21647":51758,"_28559":51759,"_3075":51760},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3699":228,"_31384":214,"_5":31706,"_21647":51762,"_28559":51763,"_3075":51764},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3699":229,"_31384":214,"_5":31706,"_21647":51766,"_28559":51767,"_3075":51768},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3699":230,"_31384":214,"_21647":51770,"_5":14929,"_28559":51716,"_3075":51771},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3699":231,"_31384":214,"_21647":51773,"_5":14929,"_28559":51720,"_3075":51774},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3699":232,"_31384":214,"_21647":51776,"_5":14929,"_28559":51720,"_3075":51777},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3699":233,"_31384":214,"_21647":51779,"_5":14929,"_28559":51720,"_3075":51780},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3699":234,"_31384":214,"_21647":51782,"_5":14929,"_28559":51720,"_3075":51783},[],"a reachable RabbitMQ broker and credentials",{"_3699":235,"_31384":214,"_21647":51785,"_5":14929,"_28559":51720,"_3075":51786},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3699":236,"_31384":214,"_21647":51788,"_5":14929,"_28559":51720,"_3075":51789},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3699":237,"_31384":214,"_21647":51791,"_5":14929,"_28559":51720,"_3075":51792},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3699":238,"_31384":214,"_21647":51794,"_5":14929,"_28559":51720,"_3075":51795},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3699":239,"_31384":214,"_21647":51797,"_5":14929,"_28559":51720,"_3075":51798},[],"a StorageClass and an external traffic design",{"_3699":240,"_31384":214,"_21647":51800,"_5":14929,"_28559":51720,"_3075":51801},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3699":241,"_31384":214,"_21647":51803,"_5":14929,"_28559":51720,"_3075":51804},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3699":242,"_31384":214,"_21647":51806,"_5":14929,"_28559":51720,"_3075":51807},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3699":243,"_31384":214,"_21647":51809,"_5":14929,"_28559":51723,"_3075":51810},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3699":244,"_31384":214,"_21647":51812,"_5":14929,"_28559":51723,"_3075":51813},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3699":245,"_31384":214,"_21647":51815,"_5":14929,"_28559":51723,"_3075":51816},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3699":246,"_31384":214,"_21647":51818,"_5":14929,"_28559":51727,"_3075":51819},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3699":247,"_31384":214,"_21647":51821,"_5":14929,"_28559":51727,"_3075":51822},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3699":248,"_31384":214,"_21647":51824,"_5":14929,"_28559":51727,"_3075":51825},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3699":249,"_31384":214,"_21647":51827,"_5":14929,"_28559":51727,"_3075":51828},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3699":250,"_31384":214,"_21647":51830,"_5":14929,"_28559":51727,"_3075":51831},[],"The chart runs workloads as `65532:65532` with the `RuntimeDefault` seccomp profile and no capabilities. It creates a dedicated ServiceAccount and does not mount its token by default. Ensure mounted volumes are accessible to that identity.",{"_3699":251,"_31384":214,"_21647":51833,"_5":14929,"_28559":51731,"_3075":51834},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3699":252,"_31384":214,"_21647":51836,"_5":14929,"_28559":51731,"_3075":51837},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3699":253,"_31384":214,"_21647":51839,"_5":14929,"_28559":51731,"_3075":51840},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3699":254,"_31384":214,"_21647":51842,"_5":14929,"_28559":51731,"_3075":51843},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3699":255,"_31384":214,"_21647":51845,"_5":14929,"_28559":51731,"_3075":51846},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3699":256,"_31384":214,"_21647":51848,"_5":14929,"_28559":51731,"_3075":51849},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3699":257,"_31384":214,"_21647":51851,"_5":14929,"_28559":51731,"_3075":51852},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3699":258,"_31384":214,"_21647":51854,"_5":14929,"_28559":51731,"_3075":51855},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3699":259,"_31384":214,"_21647":51857,"_5":14929,"_28559":51735,"_3075":51858},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3699":260,"_31384":214,"_21647":51860,"_5":14929,"_28559":51739,"_3075":51861},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3699":261,"_31384":214,"_21647":51863,"_5":14929,"_28559":51739,"_3075":51864},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3699":262,"_31384":214,"_21647":51866,"_5":14929,"_28559":51739,"_3075":51867},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3699":263,"_31384":214,"_21647":51869,"_5":14929,"_28559":51739,"_3075":51870},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3699":264,"_31384":214,"_21647":51872,"_5":14929,"_28559":51739,"_3075":51873},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3699":265,"_31384":214,"_21647":51875,"_5":14929,"_28559":51739,"_3075":51876},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3699":266,"_31384":214,"_21647":51878,"_5":14929,"_28559":51739,"_3075":51879},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3699":267,"_31384":214,"_21647":51881,"_5":14929,"_28559":51743,"_3075":51882},[],"`services.deviceManager.sseEnabled` (default `true`) controls whether Device Manager serves its device-event stream over Server-Sent Events (SSE). With the default, the chart renders a dedicated gateway rule for the device-events endpoint with an 11-minute request timeout, because the Gateway's default request timeout is too short for these streams, which the service keeps open for up to about ten minutes. Device Manager calls that are not SSE requests keep the Gateway's default timeout.",{"_3699":268,"_31384":214,"_21647":51884,"_5":14929,"_28559":51743,"_3075":51885},[],"Set it to `false` to disable the stream: the chart then renders `sse_enabled: false` in the Device Manager configuration and omits the gateway rule, and SSE requests to the device-events endpoint fail. See Device events in the 3.8.0 to 4.0.0 upgrade guide.",{"_3699":269,"_31384":214,"_21647":51887,"_5":14929,"_28559":51747,"_3075":51888},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3699":270,"_31384":214,"_21647":51890,"_5":14929,"_28559":51747,"_3075":51891},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3699":271,"_31384":214,"_21647":51893,"_5":14929,"_28559":51747,"_3075":51894},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3699":272,"_31384":214,"_21647":51896,"_5":14929,"_28559":51747,"_3075":51897},[],"See Access control for the principal and policy model.",{"_3699":273,"_31384":214,"_21647":51899,"_5":14929,"_28559":51751,"_3075":51900},[],"The dashboard includes an experimental browser terminal for working with devices. It is disabled by default; enable it in the values file:",{"_3699":274,"_31384":214,"_21647":51902,"_5":14929,"_28559":51751,"_3075":51903},[],"Enabling the terminal requires external authorization: set `auth.externalAuthorization.enabled: true` and `auth.externalAuthorization.failOpen: false`. The chart refuses to render the release otherwise, because the terminal's WebSocket endpoint would then be exposed through the Gateway without external authorization.",{"_3699":275,"_31384":214,"_21647":51905,"_5":14929,"_28559":51751,"_3075":51906},[],"Only identities granted the preloaded \"Terminal Network\" policy can open terminal sessions. See Access control for how policies are assigned.",{"_3699":276,"_31384":214,"_21647":51908,"_5":14929,"_28559":51751,"_3075":51909},[],"Note that even with the terminal enabled, pods inside the cluster can still reach the UI service directly unless network policies restrict that access — the external authorization applies to traffic entering through the Gateway.",{"_3699":277,"_31384":214,"_21647":51911,"_5":14929,"_28559":51755,"_3075":51912},[],"To install a local checkout instead:",{"_3699":278,"_31384":214,"_21647":51914,"_5":14929,"_28559":51759,"_3075":51915},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3699":279,"_31384":214,"_21647":51917,"_5":14929,"_28559":51759,"_3075":51918},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3699":280,"_31384":214,"_21647":51920,"_5":14929,"_28559":51763,"_3075":51921},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3699":281,"_31384":214,"_21647":51923,"_5":14929,"_28559":51763,"_3075":51924},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3699":282,"_31384":214,"_21647":51926,"_5":14929,"_28559":51763,"_3075":51927},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3699":283,"_31384":214,"_21647":51929,"_5":14929,"_28559":51763,"_3075":51930},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3699":284,"_31384":214,"_21647":51932,"_5":14929,"_28559":51763,"_3075":51933},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3699":285,"_31384":214,"_21647":51935,"_5":14929,"_28559":51767,"_3075":51936},[],"Before going live, review:",{"_3699":286,"_31384":214,"_21647":51938,"_5":14929,"_28559":51767,"_3075":51939},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3699":287,"_31384":214,"_21647":51941,"_5":14929,"_28559":51767,"_3075":51942},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3699":288,"_31384":214,"_21647":51944,"_5":14929,"_28559":51767,"_3075":51945},[],"shared VA storage before increasing VA replicas",{"_3699":289,"_31384":214,"_21647":51947,"_5":14929,"_28559":51767,"_3075":51948},[],"managed OIDC roles and removal of evaluation credentials",{"_3699":290,"_31384":214,"_21647":51950,"_5":14929,"_28559":51767,"_3075":51951},[],"a trusted TLS issuer or externally managed certificate",{"_3699":291,"_31384":214,"_21647":51953,"_5":14929,"_28559":51767,"_3075":51954},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3699":292,"_31384":214,"_21647":51956,"_5":14929,"_28559":51767,"_3075":51957},[],"SMTP, observability and alert delivery",{"_3699":293,"_31384":214,"_21647":51959,"_5":14929,"_28559":51767,"_3075":51960},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3699":294,"_31384":214,"_21647":51962,"_5":14929,"_28559":51767,"_3075":51963},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3699":295,"_31384":295,"_5":15283,"_3075":51965,"_31709":51966,"_21647":51967,"_28559":295},"Expose the Gateway",[51094,51095,51201],[],{"_3699":296,"_31384":295,"_21647":51969,"_5":14929,"_28559":295,"_3075":51970},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3699":297,"_31384":295,"_5":31706,"_21647":51972,"_28559":51973,"_3075":51974},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3699":298,"_31384":295,"_5":31706,"_21647":51976,"_28559":51977,"_3075":51978},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3699":299,"_31384":295,"_5":31706,"_21647":51980,"_28559":51981,"_3075":51982},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3699":300,"_31384":295,"_5":31706,"_21647":51984,"_28559":51985,"_3075":51986},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3699":301,"_31384":295,"_5":31706,"_21647":51988,"_28559":51989,"_3075":51990},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3699":302,"_31384":295,"_5":31706,"_21647":51992,"_28559":51993,"_3075":51994},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3699":303,"_31384":295,"_5":31706,"_21647":51996,"_28559":51997,"_3075":51998},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3699":304,"_31384":295,"_5":31706,"_21647":52000,"_28559":52001,"_3075":52002},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3699":305,"_31384":295,"_5":31706,"_21647":52004,"_28559":52005,"_3075":52006},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3699":306,"_31384":295,"_5":31706,"_21647":52008,"_28559":52009,"_3075":52010},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3699":307,"_31384":295,"_5":31706,"_21647":52012,"_28559":52013,"_3075":52014},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3699":308,"_31384":295,"_21647":52016,"_5":14929,"_28559":51973,"_3075":52017},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3699":309,"_31384":295,"_21647":52019,"_5":14929,"_28559":51973,"_3075":52020},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3699":310,"_31384":295,"_21647":52022,"_5":14929,"_28559":51977,"_3075":52023},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3699":311,"_31384":295,"_21647":52025,"_5":14929,"_28559":51977,"_3075":52026},[],"Set it only when:",{"_3699":312,"_31384":295,"_21647":52028,"_5":14929,"_28559":51977,"_3075":52029},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3699":313,"_31384":295,"_21647":52031,"_5":14929,"_28559":51977,"_3075":52032},[],"that address is allocated to this Gateway",{"_3699":314,"_31384":295,"_21647":52034,"_5":14929,"_28559":51977,"_3075":52035},[],"the surrounding network already routes traffic for it to the cluster",{"_3699":315,"_31384":295,"_21647":52037,"_5":14929,"_28559":51977,"_3075":52038},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3699":316,"_31384":295,"_21647":52040,"_5":14929,"_28559":51977,"_3075":52041},[],"Keep these two settings separate:",{"_3699":317,"_31384":295,"_21647":52043,"_5":14929,"_28559":51977,"_3075":52044},[],"`gateway.addresses` requests an address for the Gateway.",{"_3699":318,"_31384":295,"_21647":52046,"_5":14929,"_28559":51977,"_3075":52047},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3699":319,"_31384":295,"_21647":52049,"_5":14929,"_28559":51977,"_3075":52050},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3699":320,"_31384":295,"_21647":52052,"_5":14929,"_28559":51981,"_3075":52053},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3699":321,"_31384":295,"_21647":52055,"_5":14929,"_28559":51981,"_3075":52056},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3699":322,"_31384":295,"_21647":52058,"_5":14929,"_28559":51985,"_3075":52059},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3699":323,"_31384":295,"_21647":52061,"_5":14929,"_28559":51985,"_3075":52062},[],"For the recommended design:",{"_3699":324,"_31384":295,"_21647":52064,"_5":14929,"_28559":51985,"_3075":52065},[],"Use only one externally exposed Lamassu Gateway.",{"_3699":325,"_31384":295,"_21647":52067,"_5":14929,"_28559":51985,"_3075":52068},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3699":326,"_31384":295,"_21647":52070,"_5":14929,"_28559":51985,"_3075":52071},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3699":327,"_31384":295,"_21647":52073,"_5":14929,"_28559":51985,"_3075":52074},[],"Point DNS at the VM's reachable address.",{"_3699":328,"_31384":295,"_21647":52076,"_5":14929,"_28559":51985,"_3075":52077},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3699":329,"_31384":295,"_21647":52079,"_5":14929,"_28559":51989,"_3075":52080},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3699":330,"_31384":295,"_21647":52082,"_5":14929,"_28559":51993,"_3075":52083},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3699":331,"_31384":295,"_21647":52085,"_5":14929,"_28559":51993,"_3075":52086},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3699":332,"_31384":295,"_21647":52088,"_5":14929,"_28559":51997,"_3075":52089},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3699":333,"_31384":295,"_21647":52091,"_5":14929,"_28559":51997,"_3075":52092},[],"Requirement",{"_3699":334,"_31384":295,"_21647":52094,"_5":14929,"_28559":51997,"_3075":52095},[],"Recommended design",{"_3699":335,"_31384":295,"_21647":52097,"_5":14929,"_28559":51997,"_3075":52098},[],"Consequence",{"_3699":336,"_31384":295,"_21647":52100,"_5":14929,"_28559":51997,"_3075":52101},[],"Several Lamassu URLs or services",{"_3699":337,"_31384":295,"_21647":52103,"_5":14929,"_28559":51997,"_3075":52104},[],"One Gateway with multiple routes",{"_3699":338,"_31384":295,"_21647":52106,"_5":14929,"_28559":51997,"_3075":52107},[],"One IP and one proxy fleet; this is the chart default",{"_3699":339,"_31384":295,"_21647":52109,"_5":14929,"_28559":51997,"_3075":52110},[],"Independent Gateways and separate external IPs",{"_3699":340,"_31384":295,"_21647":52112,"_5":14929,"_28559":51997,"_3075":52113},[],"One VIP per Gateway",{"_3699":341,"_31384":295,"_21647":52115,"_5":14929,"_28559":51997,"_3075":52116},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3699":342,"_31384":295,"_21647":52118,"_5":14929,"_28559":51997,"_3075":52119},[],"Independent Gateways on one node and one IP",{"_3699":343,"_31384":295,"_21647":52121,"_5":14929,"_28559":51997,"_3075":52122},[],"Use different external ports",{"_3699":344,"_31384":295,"_21647":52124,"_5":14929,"_28559":51997,"_3075":52125},[],"Clients must include non-standard ports",{"_3699":345,"_31384":295,"_21647":52127,"_5":14929,"_28559":51997,"_3075":52128},[],"Separate TLS/mTLS termination behind one IP",{"_3699":346,"_31384":295,"_21647":52130,"_5":14929,"_28559":51997,"_3075":52131},[],"Front-door SNI routing to internal Gateways",{"_3699":347,"_31384":295,"_21647":52133,"_5":14929,"_28559":51997,"_3075":52134},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3699":348,"_31384":295,"_21647":52136,"_5":14929,"_28559":51997,"_3075":52137},[],"Separate Gateway resources but shared proxy infrastructure",{"_3699":349,"_31384":295,"_21647":52139,"_5":14929,"_28559":51997,"_3075":52140},[],"Envoy merged-Gateway mode",{"_3699":350,"_31384":295,"_21647":52142,"_5":14929,"_28559":51997,"_3075":52143},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3699":351,"_31384":295,"_21647":52145,"_5":14929,"_28559":51997,"_3075":52146},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3699":352,"_31384":295,"_21647":52148,"_5":14929,"_28559":51997,"_3075":52149},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3699":353,"_31384":295,"_21647":52151,"_5":14929,"_28559":51997,"_3075":52152},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3699":354,"_31384":295,"_21647":52154,"_5":14929,"_28559":51997,"_3075":52155},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3699":355,"_31384":295,"_21647":52157,"_5":14929,"_28559":52001,"_3075":52158},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3699":356,"_31384":295,"_21647":52160,"_5":14929,"_28559":52005,"_3075":52161},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3699":357,"_31384":295,"_21647":52163,"_5":14929,"_28559":52005,"_3075":52164},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3699":358,"_31384":295,"_21647":52166,"_5":14929,"_28559":52005,"_3075":52167},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3699":359,"_31384":295,"_21647":52169,"_5":14929,"_28559":52005,"_3075":52170},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3699":360,"_31384":295,"_21647":52172,"_5":14929,"_28559":52005,"_3075":52173},[],"If none of those are possible, use different external ports or change the external network design.",{"_3699":361,"_31384":295,"_21647":52175,"_5":14929,"_28559":52009,"_3075":52176},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3699":362,"_31384":295,"_21647":52178,"_5":14929,"_28559":52009,"_3075":52179},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3699":363,"_31384":295,"_21647":52181,"_5":14929,"_28559":52013,"_3075":52182},[],"Check, in order:",{"_3699":364,"_31384":295,"_21647":52184,"_5":14929,"_28559":52013,"_3075":52185},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3699":365,"_31384":295,"_21647":52187,"_5":14929,"_28559":52013,"_3075":52188},[],"Its status contains the expected address.",{"_3699":366,"_31384":295,"_21647":52190,"_5":14929,"_28559":52013,"_3075":52191},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3699":367,"_31384":295,"_21647":52193,"_5":14929,"_28559":52013,"_3075":52194},[],"Port 443 reaches that address from the client network.",{"_3699":368,"_31384":295,"_21647":52196,"_5":14929,"_28559":52013,"_3075":52197},[],"DNS resolves to the externally reachable endpoint.",{"_3699":369,"_31384":295,"_21647":52199,"_5":14929,"_28559":52013,"_3075":52200},[],"The certificate contains the DNS name or IP used by the client.",{"_3699":370,"_31384":295,"_21647":52202,"_5":14929,"_28559":52013,"_3075":52203},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3699":371,"_31384":371,"_5":15283,"_3075":51201,"_31709":52205,"_21647":52206,"_28559":371},[51094,51095,51201],[],{"_3699":372,"_31384":371,"_21647":52208,"_5":14929,"_28559":371,"_3075":52209},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3699":373,"_31384":371,"_5":31706,"_21647":52211,"_28559":52212,"_3075":52213},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3699":374,"_31384":371,"_5":31706,"_21647":52215,"_28559":52216,"_3075":52217},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3699":375,"_31384":371,"_5":31706,"_21647":52219,"_28559":52220,"_3075":52221},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3699":376,"_31384":371,"_5":31706,"_21647":52223,"_28559":52224,"_3075":52225},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3699":377,"_31384":371,"_5":31706,"_21647":52227,"_28559":52228,"_3075":52229},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3699":378,"_31384":371,"_5":31706,"_21647":52231,"_28559":52232,"_3075":52233},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3699":379,"_31384":371,"_21647":52235,"_5":14929,"_28559":52212,"_3075":52236},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3699":380,"_31384":371,"_21647":52238,"_5":14929,"_28559":52216,"_3075":52239},[],"Workflow",{"_3699":381,"_31384":371,"_21647":52241,"_5":14929,"_28559":52216,"_3075":52242},[],"Use it for",{"_3699":382,"_31384":371,"_21647":52244,"_5":14929,"_28559":52216,"_3075":52245},[],"What it installs",{"_3699":383,"_31384":371,"_21647":52247,"_5":14929,"_28559":52216,"_3075":52248},[],"Helm",{"_3699":384,"_31384":371,"_21647":52250,"_5":14929,"_28559":52216,"_3075":52251},[],"Production and controlled environments",{"_3699":385,"_31384":371,"_21647":52253,"_5":14929,"_28559":52216,"_3075":52254},[],"Lamassu services and Gateway API resources",{"_3699":386,"_31384":371,"_21647":52256,"_5":14929,"_28559":52216,"_3075":51338},[],{"_3699":387,"_31384":371,"_21647":52258,"_5":14929,"_28559":52216,"_3075":52259},[],"Evaluation, demos, CI and small lab clusters",{"_3699":388,"_31384":371,"_21647":52261,"_5":14929,"_28559":52216,"_3075":52262},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3699":389,"_31384":371,"_21647":52264,"_5":14929,"_28559":52220,"_3075":52265},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3699":390,"_31384":371,"_21647":52267,"_5":14929,"_28559":52220,"_3075":52268},[],"Area",{"_3699":391,"_31384":371,"_21647":52270,"_5":14929,"_28559":52220,"_3075":52271},[],"The Lamassu chart provides",{"_3699":392,"_31384":371,"_21647":52273,"_5":14929,"_28559":52220,"_3075":52274},[],"You provide",{"_3699":393,"_31384":371,"_21647":52276,"_5":14929,"_28559":52220,"_3075":52277},[],"Lamassu applications",{"_3699":394,"_31384":371,"_21647":52279,"_5":14929,"_28559":52220,"_3075":52280},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3699":395,"_31384":371,"_21647":52282,"_5":14929,"_28559":52220,"_3075":52283},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3699":396,"_31384":371,"_21647":52285,"_5":14929,"_28559":52220,"_3075":52286},[],"PostgreSQL data",{"_3699":397,"_31384":371,"_21647":52288,"_5":14929,"_28559":52220,"_3075":52289},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3699":398,"_31384":371,"_21647":52291,"_5":14929,"_28559":52220,"_3075":52292},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3699":399,"_31384":371,"_21647":52294,"_5":14929,"_28559":52220,"_3075":52295},[],"Messaging",{"_3699":400,"_31384":371,"_21647":52297,"_5":14929,"_28559":52220,"_3075":52298},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3699":401,"_31384":371,"_21647":52300,"_5":14929,"_28559":52220,"_3075":52301},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3699":402,"_31384":371,"_21647":52303,"_5":14929,"_28559":52220,"_3075":52304},[],"Identity",{"_3699":403,"_31384":371,"_21647":52306,"_5":14929,"_28559":52220,"_3075":52307},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3699":404,"_31384":371,"_21647":52309,"_5":14929,"_28559":52220,"_3075":52310},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3699":405,"_31384":371,"_21647":52312,"_5":14929,"_28559":52220,"_3075":52313},[],"External routing",{"_3699":406,"_31384":371,"_21647":52315,"_5":14929,"_28559":52220,"_3075":52316},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3699":407,"_31384":371,"_21647":52318,"_5":14929,"_28559":52220,"_3075":52319},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3699":408,"_31384":371,"_21647":52321,"_5":14929,"_28559":52220,"_3075":52322},[],"TLS",{"_3699":409,"_31384":371,"_21647":52324,"_5":14929,"_28559":52220,"_3075":52325},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3699":410,"_31384":371,"_21647":52327,"_5":14929,"_28559":52220,"_3075":52328},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3699":411,"_31384":371,"_21647":52330,"_5":14929,"_28559":52220,"_3075":52331},[],"Persistent application data",{"_3699":412,"_31384":371,"_21647":52333,"_5":14929,"_28559":52220,"_3075":52334},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3699":413,"_31384":371,"_21647":52336,"_5":14929,"_28559":52220,"_3075":52337},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3699":414,"_31384":371,"_21647":52339,"_5":14929,"_28559":52220,"_3075":52340},[],"Optional integrations",{"_3699":415,"_31384":371,"_21647":52342,"_5":14929,"_28559":52220,"_3075":52343},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3699":416,"_31384":371,"_21647":52345,"_5":14929,"_28559":52220,"_3075":52346},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3699":417,"_31384":371,"_21647":52348,"_5":14929,"_28559":52220,"_3075":52349},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3699":418,"_31384":371,"_21647":52351,"_5":14929,"_28559":52220,"_3075":52352},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3699":419,"_31384":371,"_21647":52354,"_5":14929,"_28559":52224,"_3075":52355},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3699":420,"_31384":371,"_21647":52357,"_5":14929,"_28559":52224,"_3075":52358},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3699":421,"_31384":371,"_21647":52360,"_5":14929,"_28559":52228,"_3075":52361},[],"Kubernetes 1.24 or newer",{"_3699":422,"_31384":371,"_21647":52363,"_5":14929,"_28559":52228,"_3075":52364},[],"Helm 3.2 or newer",{"_3699":423,"_31384":371,"_21647":52366,"_5":14929,"_28559":52228,"_3075":52367},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3699":424,"_31384":371,"_21647":52369,"_5":14929,"_28559":52228,"_3075":52370},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3699":425,"_31384":371,"_21647":52372,"_5":14929,"_28559":52228,"_3075":52373},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3699":426,"_31384":371,"_21647":52375,"_5":14929,"_28559":52228,"_3075":52376},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3699":427,"_31384":371,"_21647":52378,"_5":14929,"_28559":52228,"_3075":52379},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3699":428,"_31384":371,"_21647":52381,"_5":14929,"_28559":52232,"_3075":52382},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3699":429,"_31384":371,"_21647":52384,"_5":14929,"_28559":52232,"_3075":52385},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3699":430,"_31384":371,"_21647":52387,"_5":14929,"_28559":52232,"_3075":52388},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3699":431,"_31384":371,"_21647":52390,"_5":14929,"_28559":52232,"_3075":52391},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3699":432,"_31384":432,"_5":15283,"_3075":52393,"_31709":52394,"_21647":52396,"_28559":432},"Deployment troubleshooting",[51094,51095,52395],"Operations",[],{"_3699":433,"_31384":432,"_21647":52398,"_5":14929,"_28559":432,"_3075":52399},[],"Diagnose access, service health and infrastructure dependencies.",{"_3699":434,"_31384":432,"_5":31706,"_21647":52401,"_28559":52402,"_3075":52403},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3699":435,"_31384":432,"_5":31706,"_21647":52405,"_28559":52406,"_3075":52407},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3699":436,"_31384":432,"_5":31706,"_21647":52409,"_28559":52410,"_3075":52411},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3699":437,"_31384":432,"_5":31706,"_21647":52413,"_28559":52414,"_3075":52415},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3699":438,"_31384":432,"_5":31706,"_21647":52417,"_28559":52418,"_3075":52419},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3699":439,"_31384":432,"_5":31706,"_21647":52421,"_28559":52422,"_3075":52423},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3699":440,"_31384":432,"_5":31706,"_21647":52425,"_28559":52426,"_3075":52427},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3699":441,"_31384":432,"_5":31706,"_21647":52429,"_28559":52430,"_3075":52431},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3699":442,"_31384":432,"_5":31706,"_21647":52433,"_28559":52434,"_3075":52435},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3699":443,"_31384":432,"_5":31706,"_21647":52437,"_28559":52438,"_3075":52439},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3699":444,"_31384":432,"_5":31706,"_21647":52441,"_28559":52442,"_3075":52443},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3699":445,"_31384":432,"_5":31706,"_21647":52445,"_28559":52446,"_3075":52447},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3699":446,"_31384":432,"_5":31706,"_21647":52449,"_28559":52450,"_3075":52451},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3699":447,"_31384":432,"_21647":52453,"_5":14929,"_28559":432,"_3075":52454},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3699":448,"_31384":432,"_21647":52456,"_5":14929,"_28559":52406,"_3075":52457},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3699":449,"_31384":432,"_21647":52459,"_5":14929,"_28559":52410,"_3075":52460},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3699":450,"_31384":432,"_21647":52462,"_5":14929,"_28559":52414,"_3075":52463},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3699":451,"_31384":432,"_21647":52465,"_5":14929,"_28559":52418,"_3075":52466},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3699":452,"_31384":432,"_21647":52468,"_5":14929,"_28559":52422,"_3075":52469},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3699":453,"_31384":432,"_21647":52471,"_5":14929,"_28559":52426,"_3075":52472},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3699":454,"_31384":432,"_21647":52474,"_5":14929,"_28559":52426,"_3075":52475},[],"Also run the chart's connectivity test:",{"_3699":455,"_31384":432,"_21647":52477,"_5":14929,"_28559":52426,"_3075":52478},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3699":456,"_31384":432,"_21647":52480,"_5":14929,"_28559":52426,"_3075":52481},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3699":457,"_31384":432,"_21647":52483,"_5":14929,"_28559":52430,"_3075":52484},[],"If you receive a 401:",{"_3699":458,"_31384":432,"_21647":52486,"_5":14929,"_28559":52430,"_3075":52487},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3699":459,"_31384":432,"_21647":52489,"_5":14929,"_28559":52430,"_3075":52490},[],"verify issuer, audience and expiration of the token;",{"_3699":460,"_31384":432,"_21647":52492,"_5":14929,"_28559":52430,"_3075":52493},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3699":461,"_31384":432,"_21647":52495,"_5":14929,"_28559":52430,"_3075":52496},[],"check that the provider's public and internal routes point to the same realm.",{"_3699":462,"_31384":432,"_21647":52498,"_5":14929,"_28559":52430,"_3075":52499},[],"If login succeeds but the APIs return 403:",{"_3699":463,"_31384":432,"_21647":52501,"_5":14929,"_28559":52430,"_3075":52502},[],"inspect the token's real claims;",{"_3699":464,"_31384":432,"_21647":52504,"_5":14929,"_28559":52430,"_3075":52505},[],"confirm they match an active principal;",{"_3699":465,"_31384":432,"_21647":52507,"_5":14929,"_28559":52430,"_3075":52508},[],"review the policies granted to that principal;",{"_3699":466,"_31384":432,"_21647":52510,"_5":14929,"_28559":52430,"_3075":52511},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3699":467,"_31384":432,"_21647":52513,"_5":14929,"_28559":52430,"_3075":52514},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3699":468,"_31384":432,"_21647":52516,"_5":14929,"_28559":52434,"_3075":52517},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3699":469,"_31384":432,"_21647":52519,"_5":14929,"_28559":52434,"_3075":52520},[],"Locate the authz pod and Service.",{"_3699":470,"_31384":432,"_21647":52522,"_5":14929,"_28559":52434,"_3075":52523},[],"Check /health, logs and its database connection.",{"_3699":471,"_31384":432,"_21647":52525,"_5":14929,"_28559":52434,"_3075":52526},[],"Verify the DNS and port configured in externalAuthorization.",{"_3699":472,"_31384":432,"_21647":52528,"_5":14929,"_28559":52434,"_3075":52529},[],"Check the check route is /v1/ext\\_authz/check.",{"_3699":473,"_31384":432,"_21647":52531,"_5":14929,"_28559":52434,"_3075":52532},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3699":474,"_31384":432,"_21647":52534,"_5":14929,"_28559":52438,"_3075":52535},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3699":475,"_31384":432,"_21647":52537,"_5":14929,"_28559":52442,"_3075":52538},[],"Review kubectl describe pod first. Common causes are:",{"_3699":476,"_31384":432,"_21647":52540,"_5":14929,"_28559":52442,"_3075":52541},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3699":477,"_31384":432,"_21647":52543,"_5":14929,"_28559":52442,"_3075":52544},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3699":478,"_31384":432,"_21647":52546,"_5":14929,"_28559":52442,"_3075":52547},[],"unbound persistent volume;",{"_3699":479,"_31384":432,"_21647":52549,"_5":14929,"_28559":52442,"_3075":52550},[],"inaccessible image or incorrect pull policy;",{"_3699":480,"_31384":432,"_21647":52552,"_5":14929,"_28559":52442,"_3075":52553},[],"invalid cryptographic engine configuration;",{"_3699":481,"_31384":432,"_21647":52555,"_5":14929,"_28559":52442,"_3075":52556},[],"CPU or memory limits set too low;",{"_3699":482,"_31384":432,"_21647":52558,"_5":14929,"_28559":52442,"_3075":52559},[],"an incomplete prior migration.",{"_3699":483,"_31384":432,"_21647":52561,"_5":14929,"_28559":52442,"_3075":52562},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3699":484,"_31384":432,"_21647":52564,"_5":14929,"_28559":52442,"_3075":52565},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3699":485,"_31384":432,"_21647":52567,"_5":14929,"_28559":52442,"_3075":52568},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3699":486,"_31384":432,"_21647":52570,"_5":14929,"_28559":52446,"_3075":52571},[],"Domain and audit events depend on the bus publisher:",{"_3699":487,"_31384":432,"_21647":52573,"_5":14929,"_28559":52446,"_3075":52574},[],"verify it is enabled in the emitting service;",{"_3699":488,"_31384":432,"_21647":52576,"_5":14929,"_28559":52446,"_3075":52577},[],"check AMQP connectivity and credentials;",{"_3699":489,"_31384":432,"_21647":52579,"_5":14929,"_28559":52446,"_3075":52580},[],"review exchange, routing key, queues and consumers;",{"_3699":490,"_31384":432,"_21647":52582,"_5":14929,"_28559":52446,"_3075":52583},[],"inspect dead-letter queues;",{"_3699":491,"_31384":432,"_21647":52585,"_5":14929,"_28559":52446,"_3075":52586},[],"alert on orphan durable queues and backlog growth.",{"_3699":492,"_31384":432,"_21647":52588,"_5":14929,"_28559":52446,"_3075":52589},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3699":493,"_31384":432,"_21647":52591,"_5":14929,"_28559":52446,"_3075":52592},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3699":494,"_31384":432,"_21647":52594,"_5":14929,"_28559":52446,"_3075":52595},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3699":495,"_31384":432,"_21647":52597,"_5":14929,"_28559":52446,"_3075":52598},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3699":496,"_31384":432,"_21647":52600,"_5":14929,"_28559":52446,"_3075":52601},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3699":497,"_31384":432,"_21647":52603,"_5":14929,"_28559":52446,"_3075":52604},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3699":498,"_31384":432,"_21647":52606,"_5":14929,"_28559":52446,"_3075":52607},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3699":499,"_31384":432,"_21647":52609,"_5":14929,"_28559":52450,"_3075":52610},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3699":500,"_31384":432,"_21647":52612,"_5":14929,"_28559":52450,"_3075":52613},[],"Before closing an incident, record:",{"_3699":501,"_31384":432,"_21647":52615,"_5":14929,"_28559":52450,"_3075":52616},[],"the confirmed cause;",{"_3699":502,"_31384":432,"_21647":52618,"_5":14929,"_28559":52450,"_3075":52619},[],"the time scope and affected resources;",{"_3699":503,"_31384":432,"_21647":52621,"_5":14929,"_28559":52450,"_3075":52622},[],"the commands or queries used;",{"_3699":504,"_31384":432,"_21647":52624,"_5":14929,"_28559":52450,"_3075":52625},[],"the applied change and how to revert it;",{"_3699":505,"_31384":432,"_21647":52627,"_5":14929,"_28559":52450,"_3075":52628},[],"validation from a consumer;",{"_3699":506,"_31384":432,"_21647":52630,"_5":14929,"_28559":52450,"_3075":52631},[],"the preventive action and its owner.",{"_3699":507,"_31384":507,"_5":15283,"_3075":52633,"_31709":52634,"_21647":52638,"_28559":507},"Data model",[51094,52635,52636,52637],"Platform","Administration","Access control",[],{"_3699":508,"_31384":507,"_21647":52640,"_5":14929,"_28559":507,"_3075":52641},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3699":509,"_31384":507,"_5":31706,"_21647":52643,"_28559":52644,"_3075":52645},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3699":510,"_31384":507,"_5":31706,"_21647":52647,"_28559":52648,"_3075":52649},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3699":511,"_31384":507,"_21647":52651,"_5":14929,"_28559":507,"_3075":52652},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3699":512,"_31384":507,"_21647":52654,"_5":14929,"_28559":52644,"_3075":52655},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3699":513,"_31384":507,"_21647":52657,"_5":14929,"_28559":52644,"_3075":52658},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3699":514,"_31384":507,"_21647":52660,"_5":14929,"_28559":52644,"_3075":52661},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3699":515,"_31384":507,"_21647":52663,"_5":14929,"_28559":52648,"_3075":52664},[],"Entity (`schema_name.entity_type`)",{"_3699":516,"_31384":507,"_21647":52666,"_5":14929,"_28559":52648,"_3075":52667},[],"Table (`table_name`)",{"_3699":517,"_31384":507,"_21647":52669,"_5":14929,"_28559":52648,"_3075":52670},[],"Key (`primary_key`)",{"_3699":518,"_31384":507,"_21647":52672,"_5":14929,"_28559":52648,"_3075":52673},[],"`alerts.event`",{"_3699":519,"_31384":507,"_21647":52675,"_5":14929,"_28559":52648,"_3075":52676},[],"`events`",{"_3699":520,"_31384":507,"_21647":52678,"_5":14929,"_28559":52648,"_3075":52679},[],"`event_type`",{"_3699":521,"_31384":507,"_21647":52681,"_5":14929,"_28559":52648,"_3075":52682},[],"`alerts.subscription`",{"_3699":522,"_31384":507,"_21647":52684,"_5":14929,"_28559":52648,"_3075":52685},[],"`subscriptions`",{"_3699":523,"_31384":507,"_21647":52687,"_5":14929,"_28559":52648,"_3075":52688},[],"`id`",{"_3699":524,"_31384":507,"_21647":52690,"_5":14929,"_28559":52648,"_3075":52691},[],"`ca.ca_certificate`",{"_3699":525,"_31384":507,"_21647":52693,"_5":14929,"_28559":52648,"_3075":52694},[],"`ca_certificates`",{"_3699":526,"_31384":507,"_21647":52696,"_5":14929,"_28559":52648,"_3075":52688},[],{"_3699":527,"_31384":507,"_21647":52698,"_5":14929,"_28559":52648,"_3075":52699},[],"`ca.certificate`",{"_3699":528,"_31384":507,"_21647":52701,"_5":14929,"_28559":52648,"_3075":52702},[],"`certificates`",{"_3699":529,"_31384":507,"_21647":52704,"_5":14929,"_28559":52648,"_3075":52705},[],"`serial_number`",{"_3699":530,"_31384":507,"_21647":52707,"_5":14929,"_28559":52648,"_3075":52708},[],"`ca.issuance_profile`",{"_3699":531,"_31384":507,"_21647":52710,"_5":14929,"_28559":52648,"_3075":52711},[],"`issuance_profiles`",{"_3699":532,"_31384":507,"_21647":52713,"_5":14929,"_28559":52648,"_3075":52688},[],{"_3699":533,"_31384":507,"_21647":52715,"_5":14929,"_28559":52648,"_3075":52716},[],"`devicemanager.device_group`",{"_3699":534,"_31384":507,"_21647":52718,"_5":14929,"_28559":52648,"_3075":52719},[],"`device_groups`",{"_3699":535,"_31384":507,"_21647":52721,"_5":14929,"_28559":52648,"_3075":52688},[],{"_3699":536,"_31384":507,"_21647":52723,"_5":14929,"_28559":52648,"_3075":52724},[],"`devicemanager.device`",{"_3699":537,"_31384":507,"_21647":52726,"_5":14929,"_28559":52648,"_3075":52727},[],"`devices`",{"_3699":538,"_31384":507,"_21647":52729,"_5":14929,"_28559":52648,"_3075":52688},[],{"_3699":539,"_31384":507,"_21647":52731,"_5":14929,"_28559":52648,"_3075":52732},[],"`dmsmanager.dms`",{"_3699":540,"_31384":507,"_21647":52734,"_5":14929,"_28559":52648,"_3075":52735},[],"`dms`",{"_3699":541,"_31384":507,"_21647":52737,"_5":14929,"_28559":52648,"_3075":52688},[],{"_3699":542,"_31384":507,"_21647":52739,"_5":14929,"_28559":52648,"_3075":52740},[],"`kms.kms_key`",{"_3699":543,"_31384":507,"_21647":52742,"_5":14929,"_28559":52648,"_3075":52743},[],"`kms_keys`",{"_3699":544,"_31384":507,"_21647":52745,"_5":14929,"_28559":52648,"_3075":52746},[],"`key_id`, `engine_id`",{"_3699":545,"_31384":507,"_21647":52748,"_5":14929,"_28559":52648,"_3075":52749},[],"`va.crl_settings`",{"_3699":546,"_31384":507,"_21647":52751,"_5":14929,"_28559":52648,"_3075":52752},[],"`crl_settings`",{"_3699":547,"_31384":507,"_21647":52754,"_5":14929,"_28559":52648,"_3075":52755},[],"`ca_id`",{"_3699":548,"_31384":507,"_21647":52757,"_5":14929,"_28559":52648,"_3075":52758},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3699":549,"_31384":507,"_21647":52760,"_5":14929,"_28559":52648,"_3075":52761},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3699":550,"_31384":507,"_21647":52763,"_5":14929,"_28559":52648,"_3075":52764},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3699":551,"_31384":551,"_5":15283,"_3075":52766,"_31709":52767,"_21647":52768,"_28559":551},"Access control overview",[51094,52635,52636,52637],[],{"_3699":552,"_31384":551,"_21647":52770,"_5":14929,"_28559":551,"_3075":52771},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3699":553,"_31384":551,"_5":31706,"_21647":52773,"_28559":52774,"_3075":52775},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3699":554,"_31384":551,"_5":31706,"_21647":52777,"_28559":52778,"_3075":52779},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3699":555,"_31384":551,"_5":31706,"_21647":52781,"_28559":52782,"_3075":52783},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3699":556,"_31384":551,"_5":31706,"_21647":52785,"_28559":52786,"_3075":52787},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3699":557,"_31384":551,"_5":31706,"_21647":52789,"_28559":52790,"_3075":52791},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3699":558,"_31384":551,"_5":31706,"_21647":52793,"_28559":52794,"_3075":52795},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3699":559,"_31384":551,"_5":31706,"_21647":52797,"_28559":52798,"_3075":52799},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3699":560,"_31384":551,"_5":31706,"_21647":52801,"_28559":52802,"_3075":52803},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3699":561,"_31384":551,"_5":31706,"_21647":52805,"_28559":52806,"_3075":52807},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3699":562,"_31384":551,"_5":31706,"_21647":52809,"_28559":52810,"_3075":52811},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3699":563,"_31384":551,"_5":31706,"_21647":52813,"_28559":52814,"_3075":52815},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3699":564,"_31384":551,"_5":31706,"_21647":52817,"_28559":52818,"_3075":52819},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3699":565,"_31384":551,"_5":31706,"_21647":52821,"_28559":52822,"_3075":52823},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3699":566,"_31384":551,"_5":31706,"_21647":52825,"_28559":52826,"_3075":52827},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3699":567,"_31384":551,"_5":31706,"_21647":52829,"_28559":52830,"_3075":52831},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3699":568,"_31384":551,"_5":31706,"_21647":52833,"_28559":52834,"_3075":51748},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3699":569,"_31384":551,"_5":31706,"_21647":52836,"_28559":52837,"_3075":52838},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3699":570,"_31384":551,"_5":31706,"_21647":52840,"_28559":52841,"_3075":52842},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3699":571,"_31384":551,"_5":31706,"_21647":52844,"_28559":52845,"_3075":52846},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3699":572,"_31384":551,"_5":31706,"_21647":52848,"_28559":52849,"_3075":52850},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3699":573,"_31384":551,"_5":31706,"_21647":52852,"_28559":52853,"_3075":52854},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3699":574,"_31384":551,"_5":31706,"_21647":52856,"_28559":52857,"_3075":52858},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3699":575,"_31384":551,"_5":31706,"_21647":52860,"_28559":52861,"_3075":52862},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3699":576,"_31384":551,"_5":31706,"_21647":52864,"_28559":52865,"_3075":52866},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3699":577,"_31384":551,"_5":31706,"_21647":52868,"_28559":52869,"_3075":52870},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3699":578,"_31384":551,"_5":31706,"_21647":52872,"_28559":52873,"_3075":52874},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3699":579,"_31384":551,"_5":31706,"_21647":52876,"_28559":52877,"_3075":52878},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3699":580,"_31384":551,"_5":31706,"_21647":52880,"_28559":52881,"_3075":52882},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3699":581,"_31384":551,"_5":31706,"_21647":52884,"_28559":52885,"_3075":52886},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3699":582,"_31384":551,"_5":31706,"_21647":52888,"_28559":52889,"_3075":52890},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3699":583,"_31384":551,"_5":31706,"_21647":52892,"_28559":52893,"_3075":52894},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3699":584,"_31384":551,"_21647":52896,"_5":14929,"_28559":551,"_3075":52897},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3699":585,"_31384":551,"_21647":52899,"_5":14929,"_28559":551,"_3075":52900},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3699":586,"_31384":551,"_21647":52902,"_5":14929,"_28559":551,"_3075":52903},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3699":587,"_31384":551,"_21647":52905,"_5":14929,"_28559":52774,"_3075":52906},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3699":588,"_31384":551,"_21647":52908,"_5":14929,"_28559":52774,"_3075":52909},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3699":589,"_31384":551,"_21647":52911,"_5":14929,"_28559":52774,"_3075":52912},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3699":590,"_31384":551,"_21647":52914,"_5":14929,"_28559":52774,"_3075":52915},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3699":591,"_31384":551,"_21647":52917,"_5":14929,"_28559":52774,"_3075":52918},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3699":592,"_31384":551,"_21647":52920,"_5":14929,"_28559":52774,"_3075":52921},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3699":593,"_31384":551,"_21647":52923,"_5":14929,"_28559":52778,"_3075":52924},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3699":594,"_31384":551,"_21647":52926,"_5":14929,"_28559":52778,"_3075":52927},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3699":595,"_31384":551,"_21647":52929,"_5":14929,"_28559":52782,"_3075":52930},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3699":596,"_31384":551,"_21647":52932,"_5":14929,"_28559":52782,"_3075":52933},[],"The decision is made **before forwarding the request to the service**:",{"_3699":597,"_31384":551,"_21647":52935,"_5":14929,"_28559":52782,"_3075":52936},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3699":598,"_31384":551,"_21647":52938,"_5":14929,"_28559":52782,"_3075":52939},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3699":599,"_31384":551,"_21647":52941,"_5":14929,"_28559":52782,"_3075":52942},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3699":600,"_31384":551,"_21647":52944,"_5":14929,"_28559":52782,"_3075":52945},[],"It separately loads the policies granted to each principal.",{"_3699":601,"_31384":551,"_21647":52947,"_5":14929,"_28559":52782,"_3075":52948},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3699":602,"_31384":551,"_21647":52950,"_5":14929,"_28559":52782,"_3075":52951},[],"`authz` looks for an HTTP rule granting that action.",{"_3699":603,"_31384":551,"_21647":52953,"_5":14929,"_28559":52782,"_3075":52954},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3699":604,"_31384":551,"_21647":52956,"_5":14929,"_28559":52782,"_3075":52957},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3699":605,"_31384":551,"_21647":52959,"_5":14929,"_28559":52782,"_3075":52960},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3699":606,"_31384":551,"_21647":52962,"_5":14929,"_28559":52782,"_3075":52963},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3699":607,"_31384":551,"_21647":52965,"_5":14929,"_28559":52786,"_3075":52966},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3699":608,"_31384":551,"_21647":52968,"_5":14929,"_28559":52786,"_3075":52969},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3699":609,"_31384":551,"_21647":52971,"_5":14929,"_28559":52786,"_3075":52972},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3699":610,"_31384":551,"_21647":52974,"_5":14929,"_28559":52786,"_3075":52975},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3699":611,"_31384":551,"_21647":52977,"_5":14929,"_28559":52786,"_3075":52978},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3699":612,"_31384":551,"_21647":52980,"_5":14929,"_28559":52786,"_3075":52981},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3699":613,"_31384":551,"_21647":52983,"_5":14929,"_28559":52786,"_3075":52984},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3699":614,"_31384":551,"_21647":52986,"_5":14929,"_28559":52786,"_3075":52987},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3699":615,"_31384":551,"_21647":52989,"_5":14929,"_28559":52786,"_3075":52990},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3699":616,"_31384":551,"_21647":52992,"_5":14929,"_28559":52786,"_3075":52993},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3699":617,"_31384":551,"_21647":52995,"_5":14929,"_28559":52790,"_3075":52996},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3699":618,"_31384":551,"_21647":52998,"_5":14929,"_28559":52790,"_3075":52999},[],"The decision is made with the domain operation context:",{"_3699":619,"_31384":551,"_21647":53001,"_5":14929,"_28559":52790,"_3075":53002},[],"The middleware extracts the credential and resolves the matching principals.",{"_3699":620,"_31384":551,"_21647":53004,"_5":14929,"_28559":52790,"_3075":53005},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3699":621,"_31384":551,"_21647":53007,"_5":14929,"_28559":52790,"_3075":53008},[],"`authz` gathers the entity rules of the granted policies.",{"_3699":622,"_31384":551,"_21647":53010,"_5":14929,"_28559":52790,"_3075":53011},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3699":623,"_31384":551,"_21647":53013,"_5":14929,"_28559":52790,"_3075":53014},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3699":624,"_31384":551,"_21647":53016,"_5":14929,"_28559":52790,"_3075":53017},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3699":625,"_31384":551,"_21647":53019,"_5":14929,"_28559":52790,"_3075":53020},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3699":626,"_31384":551,"_21647":53022,"_5":14929,"_28559":52790,"_3075":53023},[],"Actions fall into two groups:",{"_3699":627,"_31384":551,"_21647":53025,"_5":14929,"_28559":52790,"_3075":53026},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3699":628,"_31384":551,"_21647":53028,"_5":14929,"_28559":52790,"_3075":53029},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3699":629,"_31384":551,"_21647":53031,"_5":14929,"_28559":52790,"_3075":53032},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3699":630,"_31384":551,"_21647":53034,"_5":14929,"_28559":52794,"_3075":53035},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3699":631,"_31384":551,"_21647":53037,"_5":14929,"_28559":52794,"_3075":53038},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3699":632,"_31384":551,"_21647":53040,"_5":14929,"_28559":52794,"_3075":53041},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3699":633,"_31384":551,"_21647":53043,"_5":14929,"_28559":52798,"_3075":53044},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3699":634,"_31384":551,"_21647":53046,"_5":14929,"_28559":52798,"_3075":53047},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3699":635,"_31384":551,"_21647":53049,"_5":14929,"_28559":52798,"_3075":53050},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3699":636,"_31384":551,"_21647":53052,"_5":14929,"_28559":52798,"_3075":53053},[],"The implemented operators are:",{"_3699":637,"_31384":551,"_21647":53055,"_5":14929,"_28559":52798,"_3075":53056},[],"`equals`, for exact equality;",{"_3699":638,"_31384":551,"_21647":53058,"_5":14929,"_28559":52798,"_3075":53059},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3699":639,"_31384":551,"_21647":53061,"_5":14929,"_28559":52798,"_3075":53062},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3699":640,"_31384":551,"_21647":53064,"_5":14929,"_28559":52798,"_3075":53065},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3699":641,"_31384":551,"_21647":53067,"_5":14929,"_28559":52802,"_3075":53068},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3699":642,"_31384":551,"_21647":53070,"_5":14929,"_28559":52802,"_3075":53071},[],"The available modes are:",{"_3699":643,"_31384":551,"_21647":53073,"_5":14929,"_28559":52802,"_3075":53074},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3699":644,"_31384":551,"_21647":53076,"_5":14929,"_28559":52802,"_3075":53077},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3699":645,"_31384":551,"_21647":53079,"_5":14929,"_28559":52802,"_3075":53080},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3699":646,"_31384":551,"_21647":53082,"_5":14929,"_28559":52802,"_3075":53083},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3699":647,"_31384":551,"_21647":53085,"_5":14929,"_28559":52802,"_3075":53086},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3699":648,"_31384":551,"_21647":53088,"_5":14929,"_28559":52802,"_3075":53089},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3699":649,"_31384":551,"_21647":53091,"_5":14929,"_28559":52806,"_3075":53092},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3699":650,"_31384":551,"_21647":53094,"_5":14929,"_28559":52806,"_3075":53095},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3699":651,"_31384":551,"_21647":53097,"_5":14929,"_28559":52806,"_3075":53098},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3699":652,"_31384":551,"_21647":53100,"_5":14929,"_28559":52806,"_3075":53101},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3699":653,"_31384":551,"_21647":53103,"_5":14929,"_28559":52814,"_3075":53104},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3699":654,"_31384":551,"_21647":53106,"_5":14929,"_28559":52814,"_3075":53107},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3699":655,"_31384":551,"_21647":53109,"_5":14929,"_28559":52818,"_3075":53110},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3699":656,"_31384":551,"_21647":53112,"_5":14929,"_28559":52818,"_3075":53113},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3699":657,"_31384":551,"_21647":53115,"_5":14929,"_28559":52818,"_3075":53116},[],"The data model shows how the resources used in entity rules are connected.",{"_3699":658,"_31384":551,"_21647":53118,"_5":14929,"_28559":52818,"_3075":53119},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3699":659,"_31384":551,"_21647":53121,"_5":14929,"_28559":52818,"_3075":53122},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3699":660,"_31384":551,"_21647":53124,"_5":14929,"_28559":52822,"_3075":53125},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3699":661,"_31384":551,"_21647":53127,"_5":14929,"_28559":52822,"_3075":53128},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3699":662,"_31384":551,"_21647":53130,"_5":14929,"_28559":52822,"_3075":53131},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3699":663,"_31384":551,"_21647":53133,"_5":14929,"_28559":52826,"_3075":53134},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3699":664,"_31384":551,"_21647":53136,"_5":14929,"_28559":52826,"_3075":53137},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3699":665,"_31384":551,"_21647":53139,"_5":14929,"_28559":52826,"_3075":53140},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3699":666,"_31384":551,"_21647":53142,"_5":14929,"_28559":52826,"_3075":53143},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3699":667,"_31384":551,"_21647":53145,"_5":14929,"_28559":52826,"_3075":53146},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3699":668,"_31384":551,"_21647":53148,"_5":14929,"_28559":52826,"_3075":53149},[],"Note that:",{"_3699":669,"_31384":551,"_21647":53151,"_5":14929,"_28559":52826,"_3075":53152},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3699":670,"_31384":551,"_21647":53154,"_5":14929,"_28559":52826,"_3075":53155},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3699":671,"_31384":551,"_21647":53157,"_5":14929,"_28559":52826,"_3075":53158},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3699":672,"_31384":551,"_21647":53160,"_5":14929,"_28559":52830,"_3075":53161},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3699":673,"_31384":551,"_21647":53163,"_5":14929,"_28559":52830,"_3075":53164},[],"full and read-only access to certificates and authorities;",{"_3699":674,"_31384":551,"_21647":53166,"_5":14929,"_28559":52830,"_3075":53167},[],"full and read-only access to the KMS;",{"_3699":675,"_31384":551,"_21647":53169,"_5":14929,"_28559":52830,"_3075":53170},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3699":676,"_31384":551,"_21647":53172,"_5":14929,"_28559":52830,"_3075":53173},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3699":677,"_31384":551,"_21647":53175,"_5":14929,"_28559":52830,"_3075":53176},[],"console access;",{"_3699":678,"_31384":551,"_21647":53178,"_5":14929,"_28559":52830,"_3075":53179},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3699":679,"_31384":551,"_21647":53181,"_5":14929,"_28559":52830,"_3075":53182},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3699":680,"_31384":551,"_21647":53184,"_5":14929,"_28559":52830,"_3075":53185},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3699":681,"_31384":551,"_21647":53187,"_5":14929,"_28559":52830,"_3075":53188},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3699":682,"_31384":551,"_21647":53190,"_5":14929,"_28559":52830,"_3075":53191},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3699":683,"_31384":551,"_21647":53193,"_5":14929,"_28559":52834,"_3075":53194},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3699":684,"_31384":551,"_21647":53196,"_5":14929,"_28559":52834,"_3075":53197},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3699":685,"_31384":551,"_21647":53199,"_5":14929,"_28559":52834,"_3075":53200},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3699":686,"_31384":551,"_21647":53202,"_5":14929,"_28559":52837,"_3075":53203},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3699":687,"_31384":551,"_21647":53205,"_5":14929,"_28559":52841,"_3075":53206},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3699":688,"_31384":551,"_21647":53208,"_5":14929,"_28559":52841,"_3075":53209},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3699":689,"_31384":551,"_21647":53211,"_5":14929,"_28559":52845,"_3075":53212},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3699":690,"_31384":551,"_21647":53214,"_5":14929,"_28559":52849,"_3075":53215},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3699":691,"_31384":551,"_21647":53217,"_5":14929,"_28559":52853,"_3075":53218},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3699":692,"_31384":551,"_21647":53220,"_5":14929,"_28559":52857,"_3075":53221},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3699":693,"_31384":551,"_21647":53223,"_5":14929,"_28559":52857,"_3075":53224},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3699":694,"_31384":551,"_21647":53226,"_5":14929,"_28559":52861,"_3075":53227},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3699":695,"_31384":551,"_21647":53229,"_5":14929,"_28559":52861,"_3075":53230},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3699":696,"_31384":551,"_21647":53232,"_5":14929,"_28559":52861,"_3075":53233},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3699":697,"_31384":551,"_21647":53235,"_5":14929,"_28559":52861,"_3075":53236},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3699":698,"_31384":551,"_21647":53238,"_5":14929,"_28559":52861,"_3075":53239},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3699":699,"_31384":551,"_21647":53241,"_5":14929,"_28559":52861,"_3075":53242},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3699":700,"_31384":551,"_21647":53244,"_5":14929,"_28559":52861,"_3075":53245},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3699":701,"_31384":551,"_21647":53247,"_5":14929,"_28559":52861,"_3075":53248},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3699":702,"_31384":551,"_21647":53250,"_5":14929,"_28559":52865,"_3075":53251},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3699":703,"_31384":551,"_21647":53253,"_5":14929,"_28559":52865,"_3075":53254},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3699":704,"_31384":551,"_21647":53256,"_5":14929,"_28559":52865,"_3075":53257},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3699":705,"_31384":551,"_21647":53259,"_5":14929,"_28559":52869,"_3075":53260},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3699":706,"_31384":551,"_21647":53262,"_5":14929,"_28559":52869,"_3075":53263},[],"Use groups or stable roles for people and independent identities for automations.",{"_3699":707,"_31384":551,"_21647":53265,"_5":14929,"_28559":52869,"_3075":53266},[],"Keep at least two recovery administrators and test their access periodically.",{"_3699":708,"_31384":551,"_21647":53268,"_5":14929,"_28559":52869,"_3075":53269},[],"Review active principals, their matches and their grants after IdP changes.",{"_3699":709,"_31384":551,"_21647":53271,"_5":14929,"_28559":52869,"_3075":53272},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3699":710,"_31384":551,"_21647":53274,"_5":14929,"_28559":52869,"_3075":53275},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3699":711,"_31384":551,"_21647":53277,"_5":14929,"_28559":52869,"_3075":53278},[],"Always test one allowed and one denied operation for each role.",{"_3699":712,"_31384":551,"_21647":53280,"_5":14929,"_28559":52869,"_3075":53281},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3699":713,"_31384":551,"_21647":53283,"_5":14929,"_28559":52877,"_3075":53284},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3699":714,"_31384":551,"_21647":53286,"_5":14929,"_28559":52881,"_3075":53287},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3699":715,"_31384":551,"_21647":53289,"_5":14929,"_28559":52881,"_3075":53290},[],"that an active principal of the correct type exists;",{"_3699":716,"_31384":551,"_21647":53292,"_5":14929,"_28559":52881,"_3075":53293},[],"that the claim paths and values match the real token exactly;",{"_3699":717,"_31384":551,"_21647":53295,"_5":14929,"_28559":52881,"_3075":53296},[],"that all of the principal's conditions hold;",{"_3699":718,"_31384":551,"_21647":53298,"_5":14929,"_28559":52881,"_3075":53299},[],"that the principal has the expected policy granted;",{"_3699":719,"_31384":551,"_21647":53301,"_5":14929,"_28559":52881,"_3075":53302},[],"that the policy includes the action and the requested resource type or route;",{"_3699":720,"_31384":551,"_21647":53304,"_5":14929,"_28559":52881,"_3075":53305},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3699":721,"_31384":551,"_21647":53307,"_5":14929,"_28559":52881,"_3075":53308},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3699":722,"_31384":551,"_21647":53310,"_5":14929,"_28559":52881,"_3075":53311},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3699":723,"_31384":551,"_21647":53313,"_5":14929,"_28559":52885,"_3075":53314},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3699":724,"_31384":551,"_21647":53316,"_5":14929,"_28559":52889,"_3075":53317},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3699":725,"_31384":551,"_21647":53319,"_5":14929,"_28559":52893,"_3075":53320},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3699":726,"_31384":551,"_21647":53322,"_5":14929,"_28559":52893,"_3075":53323},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3699":727,"_31384":727,"_5":15283,"_3075":53325,"_31709":53326,"_21647":53327,"_28559":727},"Alerts and subscriptions",[51094,52635,52636],[],{"_3699":728,"_31384":727,"_21647":53329,"_5":14929,"_28559":727,"_3075":53330},[],"Send PKI events to people and external systems.",{"_3699":729,"_31384":727,"_5":31706,"_21647":53332,"_28559":53333,"_3075":53334},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3699":730,"_31384":727,"_5":31706,"_21647":53336,"_28559":53337,"_3075":53338},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3699":731,"_31384":727,"_5":31706,"_21647":53340,"_28559":53341,"_3075":53342},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3699":732,"_31384":727,"_5":31706,"_21647":53344,"_28559":53345,"_3075":53346},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3699":733,"_31384":727,"_5":31706,"_21647":53348,"_28559":53349,"_3075":53350},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3699":734,"_31384":727,"_5":31706,"_21647":53352,"_28559":53353,"_3075":53354},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3699":735,"_31384":727,"_5":31706,"_21647":53356,"_28559":53357,"_3075":53358},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3699":736,"_31384":727,"_5":31706,"_21647":53360,"_28559":53361,"_3075":53362},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3699":737,"_31384":727,"_5":31706,"_21647":53364,"_28559":53365,"_3075":53366},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3699":738,"_31384":727,"_5":31706,"_21647":53368,"_28559":53369,"_3075":53370},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3699":739,"_31384":727,"_5":31706,"_21647":53372,"_28559":53373,"_3075":53374},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3699":740,"_31384":727,"_21647":53376,"_5":14929,"_28559":727,"_3075":53377},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3699":741,"_31384":727,"_21647":53379,"_5":14929,"_28559":53333,"_3075":53380},[],"A service publishes a domain event.",{"_3699":742,"_31384":727,"_21647":53382,"_5":14929,"_28559":53333,"_3075":53383},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3699":743,"_31384":727,"_21647":53385,"_5":14929,"_28559":53333,"_3075":53386},[],"Each subscription's filter decides whether it should be notified.",{"_3699":744,"_31384":727,"_21647":53388,"_5":14929,"_28559":53333,"_3075":53389},[],"Lamassu delivers the event to the configured channel.",{"_3699":745,"_31384":727,"_21647":53391,"_5":14929,"_28559":53333,"_3075":53392},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3699":746,"_31384":727,"_21647":53394,"_5":14929,"_28559":53337,"_3075":53395},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3699":747,"_31384":727,"_21647":53397,"_5":14929,"_28559":53337,"_3075":53398},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3699":748,"_31384":727,"_21647":53400,"_5":14929,"_28559":53337,"_3075":53401},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3699":749,"_31384":727,"_21647":53403,"_5":14929,"_28559":53337,"_3075":53404},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3699":750,"_31384":727,"_21647":53406,"_5":14929,"_28559":53337,"_3075":53407},[],"`apikey_options` requires `header` and `key`.",{"_3699":751,"_31384":727,"_21647":53409,"_5":14929,"_28559":53337,"_3075":53410},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3699":752,"_31384":727,"_21647":53412,"_5":14929,"_28559":53337,"_3075":53413},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3699":753,"_31384":727,"_21647":53415,"_5":14929,"_28559":53337,"_3075":53416},[],"The alerts API reference documents the full `http_client` schema.",{"_3699":754,"_31384":727,"_21647":53418,"_5":14929,"_28559":53345,"_3075":53419},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3699":755,"_31384":727,"_21647":53421,"_5":14929,"_28559":53349,"_3075":53422},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3699":756,"_31384":727,"_21647":53424,"_5":14929,"_28559":53353,"_3075":53425},[],"Add a filter if you don't want to receive every instance of the event.",{"_3699":757,"_31384":727,"_21647":53427,"_5":14929,"_28559":53353,"_3075":53428},[],"**None** notifies all instances of the event.",{"_3699":758,"_31384":727,"_21647":53430,"_5":14929,"_28559":53353,"_3075":53431},[],"**JSON Path** evaluates one or more specific fields.",{"_3699":759,"_31384":727,"_21647":53433,"_5":14929,"_28559":53353,"_3075":53434},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3699":760,"_31384":727,"_21647":53436,"_5":14929,"_28559":53353,"_3075":53437},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3699":761,"_31384":727,"_21647":53439,"_5":14929,"_28559":53353,"_3075":53440},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3699":762,"_31384":727,"_21647":53442,"_5":14929,"_28559":53353,"_3075":53443},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3699":763,"_31384":727,"_21647":53445,"_5":14929,"_28559":53357,"_3075":53446},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3699":764,"_31384":727,"_21647":53448,"_5":14929,"_28559":53361,"_3075":53449},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3699":765,"_31384":727,"_21647":53451,"_5":14929,"_28559":53361,"_3075":53452},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3699":766,"_31384":727,"_21647":53454,"_5":14929,"_28559":53361,"_3075":53455},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3699":767,"_31384":727,"_21647":53457,"_5":14929,"_28559":53361,"_3075":53458},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3699":768,"_31384":727,"_21647":53460,"_5":14929,"_28559":53361,"_3075":53461},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3699":769,"_31384":727,"_21647":53463,"_5":14929,"_28559":53361,"_3075":53464},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3699":770,"_31384":727,"_21647":53466,"_5":14929,"_28559":53361,"_3075":53467},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3699":771,"_31384":727,"_21647":53469,"_5":14929,"_28559":53361,"_3075":53470},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3699":772,"_31384":727,"_21647":53472,"_5":14929,"_28559":53365,"_3075":53473},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3699":773,"_31384":727,"_21647":53475,"_5":14929,"_28559":53365,"_3075":53476},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3699":774,"_31384":727,"_21647":53478,"_5":14929,"_28559":53365,"_3075":53479},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3699":775,"_31384":727,"_21647":53481,"_5":14929,"_28559":53365,"_3075":53482},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3699":776,"_31384":727,"_21647":53484,"_5":14929,"_28559":53365,"_3075":53485},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3699":777,"_31384":727,"_21647":53487,"_5":14929,"_28559":53365,"_3075":53488},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3699":778,"_31384":727,"_21647":53490,"_5":14929,"_28559":53365,"_3075":53491},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3699":779,"_31384":727,"_21647":53493,"_5":14929,"_28559":53365,"_3075":53494},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3699":780,"_31384":727,"_21647":53496,"_5":14929,"_28559":53369,"_3075":53497},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3699":781,"_31384":727,"_21647":53499,"_5":14929,"_28559":53369,"_3075":53500},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3699":782,"_31384":727,"_21647":53502,"_5":14929,"_28559":53373,"_3075":53503},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3699":783,"_31384":727,"_21647":53505,"_5":14929,"_28559":53373,"_3075":53506},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3699":784,"_31384":727,"_21647":53508,"_5":14929,"_28559":53373,"_3075":53509},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3699":785,"_31384":727,"_21647":53511,"_5":14929,"_28559":53373,"_3075":53512},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3699":786,"_31384":727,"_21647":53514,"_5":14929,"_28559":53373,"_3075":53515},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3699":787,"_31384":727,"_21647":53517,"_5":14929,"_28559":53373,"_3075":53518},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3699":788,"_31384":727,"_21647":53520,"_5":14929,"_28559":53373,"_3075":53521},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3699":789,"_31384":727,"_21647":53523,"_5":14929,"_28559":53373,"_3075":53524},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3699":790,"_31384":727,"_21647":53526,"_5":14929,"_28559":53373,"_3075":53527},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3699":791,"_31384":727,"_21647":53529,"_5":14929,"_28559":53373,"_3075":53530},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3699":792,"_31384":792,"_5":15283,"_3075":53532,"_31709":53533,"_21647":53534,"_28559":792},"Audit logs",[51094,52635,52636],[],{"_3699":793,"_31384":792,"_21647":53536,"_5":14929,"_28559":792,"_3075":53537},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3699":794,"_31384":792,"_5":31706,"_21647":53539,"_28559":53540,"_3075":53541},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3699":795,"_31384":792,"_5":31706,"_21647":53543,"_28559":53544,"_3075":53545},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3699":796,"_31384":792,"_5":31706,"_21647":53547,"_28559":53548,"_3075":53549},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3699":797,"_31384":792,"_5":31706,"_21647":53551,"_28559":53552,"_3075":53553},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3699":798,"_31384":792,"_5":31706,"_21647":53555,"_28559":53556,"_3075":53557},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3699":799,"_31384":792,"_5":31706,"_21647":53559,"_28559":53560,"_3075":53561},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3699":800,"_31384":792,"_5":31706,"_21647":53563,"_28559":53564,"_3075":53565},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3699":801,"_31384":792,"_5":31706,"_21647":53567,"_28559":53568,"_3075":53569},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3699":802,"_31384":792,"_5":31706,"_21647":53571,"_28559":53572,"_3075":53573},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3699":803,"_31384":792,"_5":31706,"_21647":53575,"_28559":53576,"_3075":53577},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3699":804,"_31384":792,"_5":31706,"_21647":53579,"_28559":53580,"_3075":53581},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3699":805,"_31384":792,"_21647":53583,"_5":14929,"_28559":792,"_3075":53584},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3699":806,"_31384":792,"_21647":53586,"_5":14929,"_28559":53540,"_3075":53587},[],"The audit body includes:",{"_3699":807,"_31384":792,"_21647":53589,"_5":14929,"_28559":53540,"_3075":53590},[],"input: data received by the operation;",{"_3699":808,"_31384":792,"_21647":53592,"_5":14929,"_28559":53540,"_3075":53593},[],"has\\_error: whether the service returned an error;",{"_3699":809,"_31384":792,"_21647":53595,"_5":14929,"_28559":53540,"_3075":53596},[],"output: produced result or error message;",{"_3699":810,"_31384":792,"_21647":53598,"_5":14929,"_28559":53540,"_3075":53599},[],"principals: identifiers of the principals that matched the request.",{"_3699":811,"_31384":792,"_21647":53601,"_5":14929,"_28559":53540,"_3075":53602},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3699":812,"_31384":792,"_21647":53604,"_5":14929,"_28559":53540,"_3075":53605},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3699":813,"_31384":792,"_21647":53607,"_5":14929,"_28559":53544,"_3075":53608},[],"The backend applies auditing to mutations of:",{"_3699":814,"_31384":792,"_21647":53610,"_5":14929,"_28559":53544,"_3075":53611},[],"authorities, certificates and issuance profiles;",{"_3699":815,"_31384":792,"_21647":53613,"_5":14929,"_28559":53544,"_3075":53614},[],"keys and KMS engines;",{"_3699":816,"_31384":792,"_21647":53616,"_5":14929,"_28559":53544,"_3075":53617},[],"devices and identities;",{"_3699":817,"_31384":792,"_21647":53619,"_5":14929,"_28559":53544,"_3075":53620},[],"DMSs and enrollment operations;",{"_3699":818,"_31384":792,"_21647":53622,"_5":14929,"_28559":53544,"_3075":53623},[],"validation functions and CRL;",{"_3699":819,"_31384":792,"_21647":53625,"_5":14929,"_28559":53544,"_3075":53626},[],"principals, policies and authorization grants.",{"_3699":820,"_31384":792,"_21647":53628,"_5":14929,"_28559":53544,"_3075":53629},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3699":821,"_31384":792,"_21647":53631,"_5":14929,"_28559":53548,"_3075":53632},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3699":822,"_31384":792,"_21647":53634,"_5":14929,"_28559":53548,"_3075":53635},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3699":823,"_31384":792,"_21647":53637,"_5":14929,"_28559":53548,"_3075":53638},[],"Design the consumer to:",{"_3699":824,"_31384":792,"_21647":53640,"_5":14929,"_28559":53548,"_3075":53641},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3699":825,"_31384":792,"_21647":53643,"_5":14929,"_28559":53548,"_3075":53644},[],"keep the complete CloudEvent unmodified;",{"_3699":826,"_31384":792,"_21647":53646,"_5":14929,"_28559":53548,"_3075":53647},[],"record the ingestion time and detect duplicates by ID;",{"_3699":827,"_31384":792,"_21647":53649,"_5":14929,"_28559":53548,"_3075":53650},[],"encrypt in transit and at rest;",{"_3699":828,"_31384":792,"_21647":53652,"_5":14929,"_28559":53548,"_3075":53653},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3699":829,"_31384":792,"_21647":53655,"_5":14929,"_28559":53548,"_3075":53656},[],"apply an explicit retention and legal hold policy;",{"_3699":830,"_31384":792,"_21647":53658,"_5":14929,"_28559":53548,"_3075":53659},[],"alert if it stops consuming or the pending queue grows.",{"_3699":831,"_31384":792,"_21647":53661,"_5":14929,"_28559":53552,"_3075":53662},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3699":832,"_31384":792,"_21647":53664,"_5":14929,"_28559":53552,"_3075":53665},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3699":833,"_31384":792,"_21647":53667,"_5":14929,"_28559":53560,"_3075":53668},[],"Start from the reported time and normalize every source to UTC.",{"_3699":834,"_31384":792,"_21647":53670,"_5":14929,"_28559":53564,"_3075":53671},[],"Filter by event type, service source and resource identifier.",{"_3699":835,"_31384":792,"_21647":53673,"_5":14929,"_28559":53568,"_3075":53674},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3699":836,"_31384":792,"_21647":53676,"_5":14929,"_28559":53572,"_3075":53677},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3699":837,"_31384":792,"_21647":53679,"_5":14929,"_28559":53576,"_3075":53680},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3699":838,"_31384":792,"_21647":53682,"_5":14929,"_28559":53580,"_3075":53683},[],"Generate a controlled mutation in a test environment and check that:",{"_3699":839,"_31384":792,"_21647":53685,"_5":14929,"_28559":53580,"_3075":53686},[],"a successful audit event appears;",{"_3699":840,"_31384":792,"_21647":53688,"_5":14929,"_28559":53580,"_3075":53689},[],"the principal matches the identity used;",{"_3699":841,"_31384":792,"_21647":53691,"_5":14929,"_28559":53580,"_3075":53692},[],"the consumer persists it exactly once;",{"_3699":842,"_31384":792,"_21647":53694,"_5":14929,"_28559":53580,"_3075":53695},[],"it can be retrieved by resource, actor and period;",{"_3699":843,"_31384":792,"_21647":53697,"_5":14929,"_28559":53580,"_3075":53698},[],"a consumer outage raises an alert.",{"_3699":844,"_31384":792,"_21647":53700,"_5":14929,"_28559":53580,"_3075":53701},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3699":845,"_31384":845,"_5":15283,"_3075":53703,"_31709":53704,"_21647":53705,"_28559":845},"Platform architecture",[51094,52635],[],{"_3699":846,"_31384":845,"_21647":53707,"_5":14929,"_28559":845,"_3075":53708},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3699":847,"_31384":845,"_5":31706,"_21647":53710,"_28559":53711,"_3075":53712},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3699":848,"_31384":845,"_5":31706,"_21647":53714,"_28559":53715,"_3075":53716},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3699":849,"_31384":845,"_5":31706,"_21647":53718,"_28559":53719,"_3075":53720},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3699":850,"_31384":845,"_5":31706,"_21647":53722,"_28559":53723,"_3075":53724},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3699":851,"_31384":845,"_5":31706,"_21647":53726,"_28559":53727,"_3075":53728},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3699":852,"_31384":845,"_21647":53730,"_5":14929,"_28559":845,"_3075":53731},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3699":853,"_31384":845,"_21647":53733,"_5":14929,"_28559":845,"_3075":53734},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3699":854,"_31384":845,"_21647":53736,"_5":14929,"_28559":53711,"_3075":53737},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3699":855,"_31384":845,"_21647":53739,"_5":14929,"_28559":53715,"_3075":53740},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3699":856,"_31384":845,"_21647":53742,"_5":14929,"_28559":53719,"_3075":53743},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3699":857,"_31384":845,"_21647":53745,"_5":14929,"_28559":53723,"_3075":53746},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3699":858,"_31384":845,"_21647":53748,"_5":14929,"_28559":53727,"_3075":53749},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3699":859,"_31384":859,"_5":15283,"_3075":53751,"_31709":53752,"_21647":53753,"_28559":859},"How Lamassu works",[51094,52635],[],{"_3699":860,"_31384":859,"_21647":53755,"_5":14929,"_28559":859,"_3075":53756},[],"The mental model of trust, keys, certificates and devices.",{"_3699":861,"_31384":859,"_5":31706,"_21647":53758,"_28559":53759,"_3075":53760},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3699":862,"_31384":859,"_5":31706,"_21647":53762,"_28559":53763,"_3075":53764},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3699":863,"_31384":859,"_21647":53766,"_5":14929,"_28559":859,"_3075":53767},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3699":864,"_31384":859,"_21647":53769,"_5":14929,"_28559":53759,"_3075":53770},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3699":865,"_31384":859,"_21647":53772,"_5":14929,"_28559":53759,"_3075":53773},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3699":866,"_31384":859,"_21647":53775,"_5":14929,"_28559":53759,"_3075":53776},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3699":867,"_31384":859,"_21647":53778,"_5":14929,"_28559":53759,"_3075":53779},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3699":868,"_31384":859,"_21647":53781,"_5":14929,"_28559":53759,"_3075":53782},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3699":869,"_31384":859,"_21647":53784,"_5":14929,"_28559":53763,"_3075":53785},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3699":870,"_31384":859,"_21647":53787,"_5":14929,"_28559":53763,"_3075":53788},[],"A DMS relates that CA to an enrollment policy.",{"_3699":871,"_31384":859,"_21647":53790,"_5":14929,"_28559":53763,"_3075":53791},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3699":872,"_31384":859,"_21647":53793,"_5":14929,"_28559":53763,"_3075":53794},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3699":873,"_31384":859,"_21647":53796,"_5":14929,"_28559":53763,"_3075":53797},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3699":874,"_31384":859,"_21647":53799,"_5":14929,"_28559":53763,"_3075":53800},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3699":875,"_31384":859,"_21647":53802,"_5":14929,"_28559":53763,"_3075":53803},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3699":876,"_31384":876,"_5":15283,"_3075":53805,"_31709":53806,"_21647":53808,"_28559":876},"Devices and identities",[51094,52635,53807,53805],"IoT Fleets",[],{"_3699":877,"_31384":876,"_21647":53810,"_5":14929,"_28559":876,"_3075":53811},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3699":878,"_31384":876,"_5":31706,"_21647":53813,"_28559":53814,"_3075":53815},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3699":879,"_31384":876,"_5":31706,"_21647":53817,"_28559":53818,"_3075":53819},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3699":880,"_31384":876,"_5":31706,"_21647":53821,"_28559":53822,"_3075":53823},[],"/docs/platform/iot-fleets/device-management#events-api-and-live-stream","Events API and live stream",{"_3699":881,"_31384":876,"_5":31706,"_21647":53825,"_28559":53826,"_3075":53827},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3699":882,"_31384":876,"_5":31706,"_21647":53829,"_28559":53830,"_3075":53831},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3699":883,"_31384":876,"_5":31706,"_21647":53833,"_28559":53834,"_3075":53835},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3699":884,"_31384":876,"_5":31706,"_21647":53837,"_28559":53838,"_3075":53839},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3699":885,"_31384":876,"_5":31706,"_21647":53841,"_28559":53842,"_3075":53843},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3699":886,"_31384":876,"_5":31706,"_21647":53845,"_28559":53846,"_3075":53847},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3699":887,"_31384":876,"_5":31706,"_21647":53849,"_28559":53850,"_3075":53851},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3699":888,"_31384":876,"_5":31706,"_21647":53853,"_28559":53854,"_3075":53855},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3699":889,"_31384":876,"_5":31706,"_21647":53857,"_28559":53858,"_3075":53859},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3699":890,"_31384":876,"_21647":53861,"_5":14929,"_28559":876,"_3075":53862},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3699":891,"_31384":876,"_21647":53864,"_5":14929,"_28559":876,"_3075":53865},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3699":892,"_31384":876,"_21647":53867,"_5":14929,"_28559":53814,"_3075":53868},[],"Operational view",{"_3699":893,"_31384":876,"_21647":53870,"_5":14929,"_28559":53814,"_3075":53871},[],"Meaning",{"_3699":894,"_31384":876,"_21647":53873,"_5":14929,"_28559":53814,"_3075":53874},[],"**No Identity**",{"_3699":895,"_31384":876,"_21647":53876,"_5":14929,"_28559":53814,"_3075":53877},[],"A record exists without an associated identity.",{"_3699":896,"_31384":876,"_21647":53879,"_5":14929,"_28559":53814,"_3075":53880},[],"**Active**",{"_3699":897,"_31384":876,"_21647":53882,"_5":14929,"_28559":53814,"_3075":53883},[],"The slot is active; also check certificate dates, status and usages.",{"_3699":898,"_31384":876,"_21647":53885,"_5":14929,"_28559":53814,"_3075":53886},[],"**Renewal Pending**",{"_3699":899,"_31384":876,"_21647":53888,"_5":14929,"_28559":53814,"_3075":53889},[],"The identity is in the operational renewal window.",{"_3699":900,"_31384":876,"_21647":53891,"_5":14929,"_28559":53814,"_3075":53892},[],"**Expiring Soon**",{"_3699":901,"_31384":876,"_21647":53894,"_5":14929,"_28559":53814,"_3075":53895},[],"Expiration is approaching according to configured thresholds.",{"_3699":902,"_31384":876,"_21647":53897,"_5":14929,"_28559":53814,"_3075":53898},[],"**Expired**",{"_3699":903,"_31384":876,"_21647":53900,"_5":14929,"_28559":53814,"_3075":53901},[],"The identity has expired.",{"_3699":904,"_31384":876,"_21647":53903,"_5":14929,"_28559":53814,"_3075":53904},[],"**Revoked**",{"_3699":905,"_31384":876,"_21647":53906,"_5":14929,"_28559":53814,"_3075":53907},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3699":906,"_31384":876,"_21647":53909,"_5":14929,"_28559":53814,"_3075":53910},[],"**Decommissioned**",{"_3699":907,"_31384":876,"_21647":53912,"_5":14929,"_28559":53814,"_3075":53913},[],"The record is retired and ordinary updates do not restore operation.",{"_3699":908,"_31384":876,"_21647":53915,"_5":14929,"_28559":53814,"_3075":53916},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3699":909,"_31384":876,"_21647":53918,"_5":14929,"_28559":53818,"_3075":53919},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3699":910,"_31384":876,"_21647":53921,"_5":14929,"_28559":53818,"_3075":53922},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3699":911,"_31384":876,"_21647":53924,"_5":14929,"_28559":53818,"_3075":53925},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. In **Live** mode it follows new events and device changes (such as status or owner) automatically without reloading the page, and shows a **Connected** or **Disconnected** indicator. After an interruption it reconnects and recovers without gaps or duplicates, so **Live** shows the same content a page reload would. When live updates cannot be used — no permission, device not found, or live updates not enabled on the server — the timeline shows `Live updates unavailable: ...` with the reason, while history browsing (**Load more**) still works. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3699":912,"_31384":876,"_21647":53927,"_5":14929,"_28559":53818,"_3075":53928},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3699":913,"_31384":876,"_21647":53930,"_5":14929,"_28559":53822,"_3075":53931},[],"`GET /v1/devices/:id/events` reads a device’s events and `POST /v1/devices/:id/events` creates one.",{"_3699":914,"_31384":876,"_21647":53933,"_5":14929,"_28559":53822,"_3075":53934},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Delivery is best effort: events emitted while no client is connected are not replayed on the next connection. The server closes each stream after a maximum lifetime, 10 minutes by default and configurable with the Device Manager `sse_max_stream_duration` setting, and the client reconnects to keep receiving events. When an instance has reached its subscriber limit, set by the Device Manager `sse_max_subscribers` setting (default 1000 and shared by all streams of the instance), new streams receive a `503` response with a `Retry-After` header. Each stream also re-checks the reader's permission to read the device, and closes it when the permission is revoked or cannot be verified; reconnecting goes through the regular authorization checks again. In a Helm deployment, set `services.deviceManager.sseEnabled` to `false` to disable SSE (default `true`); see Device event stream (SSE).",{"_3699":915,"_31384":876,"_21647":53936,"_5":14929,"_28559":53822,"_3075":53937},[],"On AMQP, each Device Manager instance binds a subscriber queue named after its service ID, `device-manager-sse-<uuid>`. The queue is durable and auto-delete, with a one-hour expiration (`x-expires`), so the broker removes it when the instance stops or its connection dies and no cleanup policy is needed. Only on event-bus providers without ephemeral-subscriber support can a per-process durable queue linger after its instance stops; check those providers if you observe leftover queues.",{"_3699":916,"_31384":876,"_21647":53939,"_5":14929,"_28559":53826,"_3075":53940},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3699":917,"_31384":876,"_21647":53942,"_5":14929,"_28559":53830,"_3075":53943},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3699":918,"_31384":876,"_21647":53945,"_5":14929,"_28559":53834,"_3075":53946},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3699":919,"_31384":876,"_21647":53948,"_5":14929,"_28559":53838,"_3075":53949},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3699":920,"_31384":876,"_21647":53951,"_5":14929,"_28559":53842,"_3075":53952},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3699":921,"_31384":876,"_21647":53954,"_5":14929,"_28559":53842,"_3075":53955},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3699":922,"_31384":876,"_21647":53957,"_5":14929,"_28559":53846,"_3075":53958},[],"From **No Identity**, use **Assign Identity**:",{"_3699":923,"_31384":876,"_21647":53960,"_5":14929,"_28559":53846,"_3075":53961},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3699":924,"_31384":876,"_21647":53963,"_5":14929,"_28559":53846,"_3075":53964},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3699":925,"_31384":876,"_21647":53966,"_5":14929,"_28559":53846,"_3075":53967},[],"Confirm and read the serial, active version and history again.",{"_3699":926,"_31384":876,"_21647":53969,"_5":14929,"_28559":53846,"_3075":53970},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3699":927,"_31384":876,"_21647":53972,"_5":14929,"_28559":53846,"_3075":53973},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3699":928,"_31384":876,"_21647":53975,"_5":14929,"_28559":53850,"_3075":53976},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3699":929,"_31384":876,"_21647":53978,"_5":14929,"_28559":53850,"_3075":53979},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3699":930,"_31384":876,"_21647":53981,"_5":14929,"_28559":53850,"_3075":53982},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3699":931,"_31384":876,"_21647":53984,"_5":14929,"_28559":53854,"_3075":53985},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3699":932,"_31384":876,"_21647":53987,"_5":14929,"_28559":53854,"_3075":53988},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3699":933,"_31384":876,"_21647":53990,"_5":14929,"_28559":53854,"_3075":53991},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3699":934,"_31384":876,"_21647":53993,"_5":14929,"_28559":53854,"_3075":53994},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3699":935,"_31384":876,"_21647":53996,"_5":14929,"_28559":53858,"_3075":53997},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3699":936,"_31384":876,"_21647":53999,"_5":14929,"_28559":53858,"_3075":54000},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/est/configuration\" />",{"_3699":937,"_31384":937,"_5":15283,"_3075":54002,"_31709":54003,"_21647":54005,"_28559":937},"Configure and operate the DMS",[51094,52635,53807,53805,54004],"Enrollment with PKI",[],{"_3699":938,"_31384":937,"_21647":54007,"_5":14929,"_28559":937,"_3075":54008},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3699":939,"_31384":937,"_5":31706,"_21647":54010,"_28559":54011,"_3075":51104},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3699":940,"_31384":937,"_5":31706,"_21647":54013,"_28559":54014,"_3075":54015},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3699":941,"_31384":937,"_5":31706,"_21647":54017,"_28559":54018,"_3075":54019},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3699":942,"_31384":937,"_5":31706,"_21647":54021,"_28559":54022,"_3075":54023},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3699":943,"_31384":937,"_5":31706,"_21647":54025,"_28559":54026,"_3075":54027},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3699":944,"_31384":937,"_5":31706,"_21647":54029,"_28559":54030,"_3075":54031},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3699":945,"_31384":937,"_5":31706,"_21647":54033,"_28559":54034,"_3075":54035},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3699":946,"_31384":937,"_5":31706,"_21647":54037,"_28559":54038,"_3075":54039},[],"/docs/platform/iot-fleets/enrollment/dms#protocol-configuration","Protocol configuration",{"_3699":947,"_31384":937,"_5":31706,"_21647":54041,"_28559":54042,"_3075":54043},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3699":948,"_31384":937,"_5":31706,"_21647":54045,"_28559":54046,"_3075":54047},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3699":949,"_31384":937,"_21647":54049,"_5":14929,"_28559":937,"_3075":54050},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3699":950,"_31384":937,"_21647":54052,"_5":14929,"_28559":54011,"_3075":54053},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3699":951,"_31384":937,"_21647":54055,"_5":14929,"_28559":54011,"_3075":54056},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3699":952,"_31384":937,"_21647":54058,"_5":14929,"_28559":54018,"_3075":54059},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3699":953,"_31384":937,"_21647":54061,"_5":14929,"_28559":54022,"_3075":54062},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3699":954,"_31384":937,"_21647":54064,"_5":14929,"_28559":54026,"_3075":54065},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3699":955,"_31384":937,"_21647":54067,"_5":14929,"_28559":54030,"_3075":54068},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3699":956,"_31384":937,"_21647":54070,"_5":14929,"_28559":54034,"_3075":54071},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3699":957,"_31384":937,"_21647":54073,"_5":14929,"_28559":54038,"_3075":54074},[],"See Configure EST in the DMS for registration, authentication, issuance, renewal, key generation and trust distribution.",{"_3699":958,"_31384":937,"_21647":54076,"_5":14929,"_28559":54042,"_3075":54077},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored. Authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it, including the AWS IoT connector’s JITP writeback. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3699":959,"_31384":937,"_21647":54079,"_5":14929,"_28559":54042,"_3075":54080},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3699":960,"_31384":937,"_21647":54082,"_5":14929,"_28559":54042,"_3075":54083},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3699":961,"_31384":937,"_21647":54085,"_5":14929,"_28559":54046,"_3075":54086},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3699":962,"_31384":962,"_5":15283,"_3075":54004,"_31709":54088,"_21647":54089,"_28559":962},[51094,52635,53807,53805,54004],[],{"_3699":963,"_31384":962,"_21647":54091,"_5":14929,"_28559":962,"_3075":54092},[],"Prepare device admission, registration policy and certificate issuance.",{"_3699":964,"_31384":962,"_5":31706,"_21647":54094,"_28559":54095,"_3075":54096},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3699":965,"_31384":962,"_5":31706,"_21647":54098,"_28559":54099,"_3075":54100},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3699":966,"_31384":962,"_5":31706,"_21647":54102,"_28559":54103,"_3075":54104},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3699":967,"_31384":962,"_21647":54106,"_5":14929,"_28559":962,"_3075":54107},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3699":968,"_31384":962,"_21647":54109,"_5":14929,"_28559":54095,"_3075":54110},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3699":969,"_31384":962,"_21647":54112,"_5":14929,"_28559":54095,"_3075":54113},[],"The integrator installs initial EST server trust and an admission credential.",{"_3699":970,"_31384":962,"_21647":54115,"_5":14929,"_28559":54095,"_3075":54116},[],"The client requests an identity for its `Device ID` through EST.",{"_3699":971,"_31384":962,"_21647":54118,"_5":14929,"_28559":54095,"_3075":54119},[],"Certificate, device binding and key/certificate installation are checked.",{"_3699":972,"_31384":962,"_21647":54121,"_5":14929,"_28559":54095,"_3075":54122},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3699":973,"_31384":962,"_21647":54124,"_5":14929,"_28559":54095,"_3075":54125},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3699":974,"_31384":962,"_21647":54127,"_5":14929,"_28559":54099,"_3075":54128},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3699":975,"_31384":962,"_21647":54130,"_5":14929,"_28559":54099,"_3075":54131},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3699":976,"_31384":962,"_21647":54133,"_5":14929,"_28559":54103,"_3075":54134},[],"See EST (RFC 7030) to prepare authentication and initial trust, integrate the client and maintain the device identity.",{"_3699":977,"_31384":962,"_21647":54136,"_5":14929,"_28559":54103,"_3075":54137},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3699":978,"_31384":978,"_5":15283,"_3075":54139,"_31709":54140,"_21647":54141,"_28559":978},"Provisioning strategies",[51094,52635,53807,53805,54004],[],{"_3699":979,"_31384":978,"_21647":54143,"_5":14929,"_28559":978,"_3075":54144},[],"Choose device registration, identity authorization and key generation.",{"_3699":980,"_31384":978,"_5":31706,"_21647":54146,"_28559":54147,"_3075":54148},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3699":981,"_31384":978,"_5":31706,"_21647":54150,"_28559":54151,"_3075":54152},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3699":982,"_31384":978,"_5":31706,"_21647":54154,"_28559":54155,"_3075":54156},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3699":983,"_31384":978,"_5":31706,"_21647":54158,"_28559":54159,"_3075":54160},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3699":984,"_31384":978,"_5":31706,"_21647":54162,"_28559":54163,"_3075":54164},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3699":985,"_31384":978,"_21647":54166,"_5":14929,"_28559":978,"_3075":54167},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3699":986,"_31384":978,"_21647":54169,"_5":14929,"_28559":54147,"_3075":54170},[],"Path",{"_3699":987,"_31384":978,"_21647":54172,"_5":14929,"_28559":54147,"_3075":54173},[],"When the device exists",{"_3699":988,"_31384":978,"_21647":54175,"_5":14929,"_28559":54147,"_3075":54176},[],"What to check",{"_3699":989,"_31384":978,"_21647":54178,"_5":14929,"_28559":54147,"_3075":54179},[],"Manual assignment",{"_3699":990,"_31384":978,"_21647":54181,"_5":14929,"_28559":54147,"_3075":54182},[],"An operator creates it before associating a certificate.",{"_3699":991,"_31384":978,"_21647":54184,"_5":14929,"_28559":54147,"_3075":54185},[],"ID, owning DMS, certificate CN and bound serial.",{"_3699":992,"_31384":978,"_21647":54187,"_5":14929,"_28559":54147,"_3075":54188},[],"EST with `JITP`",{"_3699":993,"_31384":978,"_21647":54190,"_5":14929,"_28559":54147,"_3075":54191},[],"Created for an unknown CN during `/simpleenroll`.",{"_3699":994,"_31384":978,"_21647":54193,"_5":14929,"_28559":54147,"_3075":54194},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3699":995,"_31384":978,"_21647":54196,"_5":14929,"_28559":54147,"_3075":54197},[],"EST with `PRE_REGISTRATION`",{"_3699":996,"_31384":978,"_21647":54199,"_5":14929,"_28559":54147,"_3075":54200},[],"Must exist before `/simpleenroll`.",{"_3699":997,"_31384":978,"_21647":54202,"_5":14929,"_28559":54147,"_3075":54203},[],"Approved record, same DMS and replacement conditions for your version.",{"_3699":998,"_31384":978,"_21647":54205,"_5":14929,"_28559":54147,"_3075":54206},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3699":999,"_31384":978,"_21647":54208,"_5":14929,"_28559":54147,"_3075":54209},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3699":1000,"_31384":978,"_21647":54211,"_5":14929,"_28559":54151,"_3075":54212},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3699":1001,"_31384":978,"_21647":54214,"_5":14929,"_28559":54151,"_3075":54215},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3699":1002,"_31384":978,"_21647":54217,"_5":14929,"_28559":54151,"_3075":54218},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3699":1003,"_31384":978,"_21647":54220,"_5":14929,"_28559":54155,"_3075":54221},[],"Decide initial enrollment and re-enrollment separately:",{"_3699":1004,"_31384":978,"_21647":54223,"_5":14929,"_28559":54155,"_3075":54224},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3699":1005,"_31384":978,"_21647":54226,"_5":14929,"_28559":54155,"_3075":54227},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3699":1006,"_31384":978,"_21647":54229,"_5":14929,"_28559":54155,"_3075":54230},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3699":1007,"_31384":978,"_21647":54232,"_5":14929,"_28559":54155,"_3075":54233},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3699":1008,"_31384":978,"_21647":54235,"_5":14929,"_28559":54155,"_3075":54236},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3699":1009,"_31384":978,"_21647":54238,"_5":14929,"_28559":54159,"_3075":51478},[],{"_3699":1010,"_31384":978,"_21647":54240,"_5":14929,"_28559":54159,"_3075":54241},[],"Material crossing EST",{"_3699":1011,"_31384":978,"_21647":54243,"_5":14929,"_28559":54159,"_3075":54244},[],"Device-generated key",{"_3699":1012,"_31384":978,"_21647":54246,"_5":14929,"_28559":54159,"_3075":54247},[],"Public CSR and certificate; the key stays on the client.",{"_3699":1013,"_31384":978,"_21647":54249,"_5":14929,"_28559":54159,"_3075":54250},[],"Existing device key",{"_3699":1014,"_31384":978,"_21647":54252,"_5":14929,"_28559":54159,"_3075":54253},[],"CSR signed with that key and a new certificate.",{"_3699":1015,"_31384":978,"_21647":54255,"_5":14929,"_28559":54159,"_3075":54256},[],"ServerKeyGen",{"_3699":1016,"_31384":978,"_21647":54258,"_5":14929,"_28559":54159,"_3075":54259},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3699":1017,"_31384":978,"_21647":54261,"_5":14929,"_28559":54159,"_3075":54262},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3699":1018,"_31384":978,"_21647":54264,"_5":14929,"_28559":54163,"_3075":54265},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3699":1019,"_31384":1019,"_5":15283,"_3075":54267,"_31709":54268,"_21647":54270,"_28559":1019},"Authentication and trust",[51094,52635,53807,54269],"EST (RFC 7030)",[],{"_3699":1020,"_31384":1019,"_21647":54272,"_5":14929,"_28559":1019,"_3075":54273},[],"Prepare credentials, authentication and trust distribution for EST.",{"_3699":1021,"_31384":1019,"_5":31706,"_21647":54275,"_28559":54276,"_3075":54277},[],"/docs/platform/iot-fleets/est/bootstrap-identity#initial-server-trust","Initial server trust",{"_3699":1022,"_31384":1019,"_5":31706,"_21647":54279,"_28559":54280,"_3075":54281},[],"/docs/platform/iot-fleets/est/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3699":1023,"_31384":1019,"_5":31706,"_21647":54283,"_28559":54284,"_3075":54285},[],"/docs/platform/iot-fleets/est/bootstrap-identity#modes-per-operation","Modes per operation",{"_3699":1024,"_31384":1019,"_5":31706,"_21647":54287,"_28559":54288,"_3075":54289},[],"/docs/platform/iot-fleets/est/bootstrap-identity#webhook-contract","Webhook contract",{"_3699":1025,"_31384":1019,"_5":31706,"_21647":54291,"_28559":54292,"_3075":54293},[],"/docs/platform/iot-fleets/est/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3699":1026,"_31384":1019,"_21647":54295,"_5":14929,"_28559":1019,"_3075":54296},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3699":1027,"_31384":1019,"_21647":54298,"_5":14929,"_28559":54276,"_3075":54299},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3699":1028,"_31384":1019,"_21647":54301,"_5":14929,"_28559":54276,"_3075":54302},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3699":1029,"_31384":1019,"_21647":54304,"_5":14929,"_28559":54280,"_3075":54305},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3699":1030,"_31384":1019,"_21647":54307,"_5":14929,"_28559":54280,"_3075":54308},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3699":1031,"_31384":1019,"_21647":54310,"_5":14929,"_28559":54280,"_3075":54311},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3699":1032,"_31384":1019,"_21647":54313,"_5":14929,"_28559":54284,"_3075":54314},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3699":1033,"_31384":1019,"_21647":54316,"_5":14929,"_28559":54284,"_3075":54317},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3699":1034,"_31384":1019,"_21647":54319,"_5":14929,"_28559":54288,"_3075":54320},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config (verification is on by default) and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3699":1035,"_31384":1019,"_21647":54322,"_5":14929,"_28559":54288,"_3075":54323},[],"Example body:",{"_3699":1036,"_31384":1019,"_21647":54325,"_5":14929,"_28559":54288,"_3075":54326},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3699":1037,"_31384":1019,"_21647":54328,"_5":14929,"_28559":54288,"_3075":54329},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3699":1038,"_31384":1019,"_21647":54331,"_5":14929,"_28559":54288,"_3075":54332},[],"Continuation requires a successful HTTP response and JSON:",{"_3699":1039,"_31384":1019,"_21647":54334,"_5":14929,"_28559":54288,"_3075":54335},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3699":1040,"_31384":1019,"_21647":54337,"_5":14929,"_28559":54292,"_3075":54338},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3699":1041,"_31384":1019,"_21647":54340,"_5":14929,"_28559":54292,"_3075":54341},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh (`thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old) and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3699":1042,"_31384":1019,"_21647":54343,"_5":14929,"_28559":54292,"_3075":54344},[],"Downloaded CRL distribution points are cached in memory by the DMS Manager, keyed by their URL, so concurrent enroll and re-enroll operations share a single download. A cached list is reused for at most `crl_cache.max_ttl` (1 hour by default) and never past its own `nextUpdate` — or, when the list has none, up to about 24 hours after `thisUpdate` under the freshness rule above. Reading a cached list does not extend its life, and its signature is verified against the certificate's issuer on every use. A list that is stale, larger than `crl_cache.max_size_mb` (256 MB by default) or that failed to download is not cached; the next operation downloads it again. The cache is a DMS Manager service configuration shared by all DMSs, not a per-DMS option, and it applies to CRL distribution points only — OCSP responses are never cached. Both settings are keys of the `crl_cache` section in the DMS Manager configuration file (`max_ttl` as a duration such as `10m`, `max_size_mb` as an integer); an unset or `0` value uses the default, and a negative value stops the service at startup. The cache cannot be switched off: to shorten the window in which a newly published revocation stays unseen, lower `max_ttl`. The Lamassu Helm chart does not expose `crl_cache` as a value, so a Helm deployment runs with the defaults unless you change the rendered DMS Manager configuration. Lamassu-managed certificates are unaffected: they are checked against their stored status and never reach the CRL path.",{"_3699":1043,"_31384":1019,"_21647":54346,"_5":14929,"_28559":54292,"_3075":54347},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). A revocation published in a newly issued external CRL can additionally take up to the caching window — `crl_cache.max_ttl`, 1 hour by default — to become visible, on top of the responders' own publication pace. Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3699":1044,"_31384":1019,"_21647":54349,"_5":14929,"_28559":54292,"_3075":54350},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3699":1045,"_31384":1045,"_5":15283,"_3075":54352,"_31709":54353,"_21647":54354,"_28559":1045},"EST in Lamassu",[51094,52635,53807,54269],[],{"_3699":1046,"_31384":1045,"_21647":54356,"_5":14929,"_28559":1045,"_3075":54357},[],"Configure EST operations, authentication and trust distribution.",{"_3699":1047,"_31384":1045,"_5":31706,"_21647":54359,"_28559":54360,"_3075":54361},[],"/docs/platform/iot-fleets/est/configuration#endpoint-reference","Endpoint reference",{"_3699":1048,"_31384":1045,"_5":31706,"_21647":54363,"_28559":54364,"_3075":54365},[],"/docs/platform/iot-fleets/est/configuration#authentication-per-operation","Authentication per operation",{"_3699":1049,"_31384":1045,"_5":31706,"_21647":54367,"_28559":54368,"_3075":54369},[],"/docs/platform/iot-fleets/est/configuration#client-certificate","Client certificate",{"_3699":1050,"_31384":1045,"_5":31706,"_21647":54371,"_28559":54372,"_3075":54373},[],"/docs/platform/iot-fleets/est/configuration#external-webhook-settings","External webhook settings",{"_3699":1051,"_31384":1045,"_5":31706,"_21647":54375,"_28559":54376,"_3075":51104},[],"/docs/platform/iot-fleets/est/configuration#before-you-begin",{"_3699":1052,"_31384":1045,"_5":31706,"_21647":54378,"_28559":54379,"_3075":54380},[],"/docs/platform/iot-fleets/est/configuration#cacerts","/cacerts",{"_3699":1053,"_31384":1045,"_5":31706,"_21647":54382,"_28559":54383,"_3075":54384},[],"/docs/platform/iot-fleets/est/configuration#trust-distribution","Configuration",{"_3699":1054,"_31384":1045,"_5":31706,"_21647":54386,"_28559":54387,"_3075":54388},[],"/docs/platform/iot-fleets/est/configuration#cacerts-request-and-response","Request and response",{"_3699":1055,"_31384":1045,"_5":31706,"_21647":54390,"_28559":54391,"_3075":54392},[],"/docs/platform/iot-fleets/est/configuration#download-and-inspect-cacerts","Example",{"_3699":1056,"_31384":1045,"_5":31706,"_21647":54394,"_28559":54395,"_3075":54396},[],"/docs/platform/iot-fleets/est/configuration#simpleenroll","/simpleenroll",{"_3699":1057,"_31384":1045,"_5":31706,"_21647":54398,"_28559":54399,"_3075":54384},[],"/docs/platform/iot-fleets/est/configuration#enrollment-configuration",{"_3699":1058,"_31384":1045,"_5":31706,"_21647":54401,"_28559":54402,"_3075":54388},[],"/docs/platform/iot-fleets/est/configuration#simpleenroll-request-and-response",{"_3699":1059,"_31384":1045,"_5":31706,"_21647":54404,"_28559":54405,"_3075":54392},[],"/docs/platform/iot-fleets/est/configuration#initial-enrollment-example",{"_3699":1060,"_31384":1045,"_5":31706,"_21647":54407,"_28559":54408,"_3075":54409},[],"/docs/platform/iot-fleets/est/configuration#simplereenroll","/simplereenroll",{"_3699":1061,"_31384":1045,"_5":31706,"_21647":54411,"_28559":54412,"_3075":54384},[],"/docs/platform/iot-fleets/est/configuration#re-enrollment-configuration",{"_3699":1062,"_31384":1045,"_5":31706,"_21647":54414,"_28559":54415,"_3075":54388},[],"/docs/platform/iot-fleets/est/configuration#simplereenroll-request-and-response",{"_3699":1063,"_31384":1045,"_5":31706,"_21647":54417,"_28559":54418,"_3075":54392},[],"/docs/platform/iot-fleets/est/configuration#renewal-example",{"_3699":1064,"_31384":1045,"_5":31706,"_21647":54420,"_28559":54421,"_3075":54422},[],"/docs/platform/iot-fleets/est/configuration#recover-according-to-state","Recover according to state",{"_3699":1065,"_31384":1045,"_5":31706,"_21647":54424,"_28559":54425,"_3075":54426},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen","/serverkeygen",{"_3699":1066,"_31384":1045,"_5":31706,"_21647":54428,"_28559":54429,"_3075":54384},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen-configuration",{"_3699":1067,"_31384":1045,"_5":31706,"_21647":54431,"_28559":54432,"_3075":54388},[],"/docs/platform/iot-fleets/est/configuration#serverkeygen-request-and-response",{"_3699":1068,"_31384":1045,"_5":31706,"_21647":54434,"_28559":54435,"_3075":54392},[],"/docs/platform/iot-fleets/est/configuration#request-and-extraction",{"_3699":1069,"_31384":1045,"_21647":54437,"_5":14929,"_28559":1045,"_3075":54438},[],"Each DMS exposes the EST operations its devices use to obtain and renew their identity. This page describes the routes, how each operation authenticates, the DMS settings that govern each endpoint and request examples with curl and OpenSSL. To create and manage the DMS, see the DMS guide; to prepare the device's credentials and initial trust, see Authentication and trust.",{"_3699":1070,"_31384":1045,"_21647":54440,"_5":14929,"_28559":54360,"_3075":54441},[],"Each DMS publishes its operations at `/.well-known/est/{APS}/{operation}`, where `APS` is the DMS ID, not its display name. Gateway configuration determines the public host and route. The router also admits routes without the `APS` segment, but the controller requires it, so do not use them.",{"_3699":1071,"_31384":1045,"_21647":54443,"_5":14929,"_28559":54360,"_3075":54444},[],"Operation",{"_3699":1072,"_31384":1045,"_21647":54446,"_5":14929,"_28559":54360,"_3075":54447},[],"Method",{"_3699":1073,"_31384":1045,"_21647":54449,"_5":14929,"_28559":54360,"_3075":54450},[],"Authentication and condition",{"_3699":1074,"_31384":1045,"_21647":54452,"_5":14929,"_28559":54360,"_3075":54453},[],"`/cacerts`",{"_3699":1075,"_31384":1045,"_21647":54455,"_5":14929,"_28559":54360,"_3075":54456},[],"GET",{"_3699":1076,"_31384":1045,"_21647":54458,"_5":14929,"_28559":54360,"_3075":54459},[],"No EST credential required; HTTPS and infrastructure controls still apply.",{"_3699":1077,"_31384":1045,"_21647":54461,"_5":14929,"_28559":54360,"_3075":54462},[],"`/simpleenroll`",{"_3699":1078,"_31384":1045,"_21647":54464,"_5":14929,"_28559":54360,"_3075":54465},[],"POST",{"_3699":1079,"_31384":1045,"_21647":54467,"_5":14929,"_28559":54360,"_3075":54468},[],"Initial authentication and DMS registration and replacement policy.",{"_3699":1080,"_31384":1045,"_21647":54470,"_5":14929,"_28559":54360,"_3075":54471},[],"`/simplereenroll`",{"_3699":1081,"_31384":1045,"_21647":54473,"_5":14929,"_28559":54360,"_3075":54465},[],{"_3699":1082,"_31384":1045,"_21647":54475,"_5":14929,"_28559":54360,"_3075":54476},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3699":1083,"_31384":1045,"_21647":54478,"_5":14929,"_28559":54360,"_3075":54479},[],"`/serverkeygen`",{"_3699":1084,"_31384":1045,"_21647":54481,"_5":14929,"_28559":54360,"_3075":54465},[],{"_3699":1085,"_31384":1045,"_21647":54483,"_5":14929,"_28559":54360,"_3075":54484},[],"Initial authentication and server-side key generation enabled.",{"_3699":1086,"_31384":1045,"_21647":54486,"_5":14929,"_28559":54360,"_3075":54487},[],"Lamassu does not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode either; a webhook can interpret a request credential according to its own contract.",{"_3699":1087,"_31384":1045,"_21647":54489,"_5":14929,"_28559":54364,"_3075":54490},[],"The DMS authenticates the request before it applies registration and issuance rules. Each operation reads its authentication from its own `est_rfc7030_settings` block:",{"_3699":1088,"_31384":1045,"_21647":54492,"_5":14929,"_28559":54364,"_3075":54493},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3699":1089,"_31384":1045,"_21647":54495,"_5":14929,"_28559":54364,"_3075":54496},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3699":1090,"_31384":1045,"_21647":54498,"_5":14929,"_28559":54364,"_3075":54499},[],"The two blocks are stored independently and neither inherits from the other, so read both before editing. `auth_mode` accepts these values:",{"_3699":1091,"_31384":1045,"_21647":54501,"_5":14929,"_28559":54364,"_3075":54502},[],"`auth_mode`",{"_3699":1092,"_31384":1045,"_21647":54504,"_5":14929,"_28559":54364,"_3075":54505},[],"Control applied in the configured operation",{"_3699":1093,"_31384":1045,"_21647":54507,"_5":14929,"_28559":54364,"_3075":54508},[],"`CLIENT_CERTIFICATE`",{"_3699":1094,"_31384":1045,"_21647":54510,"_5":14929,"_28559":54364,"_3075":54511},[],"Presented certificate validation.",{"_3699":1095,"_31384":1045,"_21647":54513,"_5":14929,"_28559":54364,"_3075":54514},[],"`EXTERNAL_WEBHOOK`",{"_3699":1096,"_31384":1045,"_21647":54516,"_5":14929,"_28559":54364,"_3075":54517},[],"Configured webhook authorization.",{"_3699":1097,"_31384":1045,"_21647":54519,"_5":14929,"_28559":54364,"_3075":54520},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3699":1098,"_31384":1045,"_21647":54522,"_5":14929,"_28559":54364,"_3075":54523},[],"Certificate validation followed by webhook approval.",{"_3699":1099,"_31384":1045,"_21647":54525,"_5":14929,"_28559":54364,"_3075":54526},[],"`NO_AUTH`",{"_3699":1100,"_31384":1045,"_21647":54528,"_5":14929,"_28559":54364,"_3075":54529},[],"No DMS requester authentication.",{"_3699":1101,"_31384":1045,"_21647":54531,"_5":14929,"_28559":54364,"_3075":54532},[],"Webhook modes also run during re-enrollment when configured in its block. An absent or unrecognized mode makes the operation fail: there is no implicit downgrade to `NO_AUTH`. `NO_AUTH` does not establish ownership of the requested ID.",{"_3699":1102,"_31384":1045,"_21647":54534,"_5":14929,"_28559":54368,"_3075":54535},[],"The certificate modes read `client_certificate_settings` in the same block:",{"_3699":1103,"_31384":1045,"_21647":54537,"_5":14929,"_28559":54368,"_3075":54538},[],"Field",{"_3699":1104,"_31384":1045,"_21647":54540,"_5":14929,"_28559":54368,"_3075":54541},[],"Description",{"_3699":1105,"_31384":1045,"_21647":54543,"_5":14929,"_28559":54368,"_3075":54544},[],"`validation_cas`",{"_3699":1106,"_31384":1045,"_21647":54546,"_5":14929,"_28559":54368,"_3075":54547},[],"IDs of the CAs the presented certificate is validated against. The first one that validates it is used.",{"_3699":1107,"_31384":1045,"_21647":54549,"_5":14929,"_28559":54368,"_3075":54550},[],"`allow_expired`",{"_3699":1108,"_31384":1045,"_21647":54552,"_5":14929,"_28559":54368,"_3075":54553},[],"**Allow expired certificates**: accepts expired certificates in initial enrollment.",{"_3699":1109,"_31384":1045,"_21647":54555,"_5":14929,"_28559":54368,"_3075":54556},[],"`chain_level_validation`",{"_3699":1110,"_31384":1045,"_21647":54558,"_5":14929,"_28559":54368,"_3075":54559},[],"When greater than 0, only that many certificates of the presented chain are validated.",{"_3699":1111,"_31384":1045,"_21647":54561,"_5":14929,"_28559":54368,"_3075":54562},[],"`allow_unverifiable_revocation`",{"_3699":1112,"_31384":1045,"_21647":54564,"_5":14929,"_28559":54368,"_3075":54565},[],"**Allow certificates without revocation information**: accepts certificates without revocation information; `false` by default.",{"_3699":1113,"_31384":1045,"_21647":54567,"_5":14929,"_28559":54368,"_3075":54568},[],"The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3699":1114,"_31384":1045,"_21647":54570,"_5":14929,"_28559":54368,"_3075":54571},[],"**Revocation.** In initial enrollment the client certificate and every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. Certificates managed by Lamassu are checked against their stored status, and external ones through their OCSP and CRL endpoints. The operation fails closed when revocation cannot be verified: unreachable endpoints, stale or invalid evidence and inconclusive statuses always reject the certificate. A validation CA that is revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. Revocation and checks details the evidence the endpoints must present. CRL lists fetched for these checks are reused for a limited time before being downloaded again; see Revocation and checks for the caching window and its effect on revocation visibility.",{"_3699":1115,"_31384":1045,"_21647":54573,"_5":14929,"_28559":54368,"_3075":54574},[],"`allow_unverifiable_revocation` relaxes a single case: a certificate, or an intermediate CA of the chain, that Lamassu does not manage and that lists no OCSP or CRL endpoint. With the option on, that certificate is accepted even if it is revoked, and the console shows the warning **Revocation will not be verified**. The option is set separately in the enrollment and re-enrollment blocks, and it is off in DMSs created before it existed.",{"_3699":1116,"_31384":1045,"_21647":54576,"_5":14929,"_28559":54368,"_3075":54577},[],"**Re-enrollment.** The validator tries the enrollment CA first and then the re-enrollment block's `validation_cas`. That list is optional because the enrollment CA is always trusted, and CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance: during a CA rotation, add the old issuance CA to the re-enrollment block's list. The validator compares only the presented TLS leaf against those CAs and checks only its revocation. In this block `chain_level_validation` and `allow_expired` are stored but not consulted; expiry is governed by `enable_expired_renewal`.",{"_3699":1117,"_31384":1045,"_21647":54579,"_5":14929,"_28559":54372,"_3075":54580},[],"The webhook modes read `external_webhook_settings` in the same `est_rfc7030_settings` block. These settings define the destination, method, timeout and how Lamassu authenticates to the receiver; the webhook contract describes the device credential, the request body and the expected response.",{"_3699":1118,"_31384":1045,"_21647":54582,"_5":14929,"_28559":54372,"_3075":54583},[],"`external_webhook_settings` field",{"_3699":1119,"_31384":1045,"_21647":54585,"_5":14929,"_28559":54372,"_3075":54586},[],"Decision",{"_3699":1120,"_31384":1045,"_21647":54588,"_5":14929,"_28559":54372,"_3075":54589},[],"`url`",{"_3699":1121,"_31384":1045,"_21647":54591,"_5":14929,"_28559":54372,"_3075":54592},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3699":1122,"_31384":1045,"_21647":54594,"_5":14929,"_28559":54372,"_3075":54595},[],"`method`",{"_3699":1123,"_31384":1045,"_21647":54597,"_5":14929,"_28559":54372,"_3075":54598},[],"`POST` or `PUT`; `POST` by default.",{"_3699":1124,"_31384":1045,"_21647":54600,"_5":14929,"_28559":54372,"_3075":54601},[],"`name`",{"_3699":1125,"_31384":1045,"_21647":54603,"_5":14929,"_28559":54372,"_3075":54604},[],"Label used in service logs.",{"_3699":1126,"_31384":1045,"_21647":54606,"_5":14929,"_28559":54372,"_3075":54607},[],"`config.auth_mode`",{"_3699":1127,"_31384":1045,"_21647":54609,"_5":14929,"_28559":54372,"_3075":54610},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3699":1128,"_31384":1045,"_21647":54612,"_5":14929,"_28559":54372,"_3075":54613},[],"`config.log_level`",{"_3699":1129,"_31384":1045,"_21647":54615,"_5":14929,"_28559":54372,"_3075":54616},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3699":1130,"_31384":1045,"_21647":54618,"_5":14929,"_28559":54372,"_3075":54619},[],"`config.apikey_options`",{"_3699":1131,"_31384":1045,"_21647":54621,"_5":14929,"_28559":54372,"_3075":54622},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3699":1132,"_31384":1045,"_21647":54624,"_5":14929,"_28559":54372,"_3075":54625},[],"`config.jwt_options`",{"_3699":1133,"_31384":1045,"_21647":54627,"_5":14929,"_28559":54372,"_3075":54628},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3699":1134,"_31384":1045,"_21647":54630,"_5":14929,"_28559":54372,"_3075":54631},[],"`config.mtls_options`",{"_3699":1135,"_31384":1045,"_21647":54633,"_5":14929,"_28559":54372,"_3075":54634},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3699":1136,"_31384":1045,"_21647":54636,"_5":14929,"_28559":54372,"_3075":54637},[],"`config.insecure_skip_verify`",{"_3699":1137,"_31384":1045,"_21647":54639,"_5":14929,"_28559":54372,"_3075":54640},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3699":1138,"_31384":1045,"_21647":54642,"_5":14929,"_28559":54372,"_3075":54643},[],"`config.call_timeout`",{"_3699":1139,"_31384":1045,"_21647":54645,"_5":14929,"_28559":54372,"_3075":54646},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3699":1140,"_31384":1045,"_21647":54648,"_5":14929,"_28559":54372,"_3075":54649},[],"Creating or updating a DMS that uses the webhook in any of its blocks validates this configuration. When it is invalid, the response is HTTP 400, with a body that starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config`. These rules apply:",{"_3699":1141,"_31384":1045,"_21647":54651,"_5":14929,"_28559":54372,"_3075":54652},[],"The URL, method and options must be valid, and `mtls_options.cert_content` and `key_content` must decode to a matching certificate and private key.",{"_3699":1142,"_31384":1045,"_21647":54654,"_5":14929,"_28559":54372,"_3075":54655},[],"File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid, because the service does not read files. Enter the certificate and key as PEM, Base64-encoded or plain, in `cert_content` and `key_content`.",{"_3699":1143,"_31384":1045,"_21647":54657,"_5":14929,"_28559":54372,"_3075":54658},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts (for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded`), and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas.",{"_3699":1144,"_31384":1045,"_21647":54660,"_5":14929,"_28559":54372,"_3075":54661},[],"With `config.auth_mode` set to `apikey`, `jwt` or `mtls`, the body must carry its option block (`apikey_options`, `jwt_options` or `mtls_options`) and no other. The legacy `apikey`, `oidc` and `mtls` names fail validation, and `validate_server_cert` is ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3699":1145,"_31384":1045,"_21647":54663,"_5":14929,"_28559":54372,"_3075":54664},[],"The `http_client` key belongs to alert channels; in a DMS body it is ignored. The DMS configuration goes in `external_webhook_settings.config`.",{"_3699":1146,"_31384":1045,"_21647":54666,"_5":14929,"_28559":54372,"_3075":54667},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3699":1147,"_31384":1045,"_21647":54669,"_5":14929,"_28559":54372,"_3075":54670},[],"The console exposes independent editors for the enrollment and re-enrollment authentication, with the same **Log Level**, **Call Timeout**, **HTTP Authentication** and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (`insecure_skip_verify`, off by default; the console warns when you enable it). The editor rejects file paths in the certificate and key fields, and saving rewrites `external_webhook_settings.config` with the current keys and the material Base64-encoded. Configurations migrated from 3.8.0 that referenced files or relied on `validate_server_cert: false` need fixing; see DMS webhooks.",{"_3699":1148,"_31384":1045,"_21647":54672,"_5":14929,"_28559":54376,"_3075":54673},[],"For an end-to-end first enrollment, follow Enroll and connect your first device.",{"_3699":1149,"_31384":1045,"_21647":54675,"_5":14929,"_28559":54376,"_3075":54676},[],"The examples on this page need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. They use Bash, curl with `--fail-with-body` and OpenSSL 3.x (openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal); work in a private directory. If you integrate a generic EST client, first check the Lamassu specifics described for each operation, such as the PEM response or the multipart format of `/serverkeygen`.",{"_3699":1150,"_31384":1045,"_21647":54678,"_5":14929,"_28559":54376,"_3075":54679},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Authentication and trust. Replace the host and `REPLACE_DMS_ID` with those of your installation:",{"_3699":1151,"_31384":1045,"_21647":54681,"_5":14929,"_28559":54376,"_3075":54682},[],"When a request fails, retain the HTTP code, headers and body before decoding anything. A 500 does not mean a transient failure: service denials return it too. Troubleshooting explains how to interpret them.",{"_3699":1152,"_31384":1045,"_21647":54684,"_5":14929,"_28559":54379,"_3075":54685},[],"`GET /cacerts` retrieves the certificates published by the DMS. The client can inspect the bundle and use approved certificates to build trust chains.",{"_3699":1153,"_31384":1045,"_21647":54687,"_5":14929,"_28559":54383,"_3075":54688},[],"`settings.ca_distribution_settings` determines which certificates `/cacerts` returns:",{"_3699":1154,"_31384":1045,"_21647":54690,"_5":14929,"_28559":54383,"_3075":54538},[],{"_3699":1155,"_31384":1045,"_21647":54692,"_5":14929,"_28559":54383,"_3075":54693},[],"Content it adds",{"_3699":1156,"_31384":1045,"_21647":54695,"_5":14929,"_28559":54383,"_3075":54696},[],"`include_system_ca` (**Include Lamassu System CA**)",{"_3699":1157,"_31384":1045,"_21647":54698,"_5":14929,"_28559":54383,"_3075":54699},[],"The available downstream TLS certificate. It can be a leaf, not an issuing CA.",{"_3699":1158,"_31384":1045,"_21647":54701,"_5":14929,"_28559":54383,"_3075":54702},[],"`include_enrollment_ca` (**Include Enrollment CA**)",{"_3699":1159,"_31384":1045,"_21647":54704,"_5":14929,"_28559":54383,"_3075":54705},[],"The selected enrollment CA certificate.",{"_3699":1160,"_31384":1045,"_21647":54707,"_5":14929,"_28559":54383,"_3075":54708},[],"`managed_cas` (**Managed CAs**)",{"_3699":1161,"_31384":1045,"_21647":54710,"_5":14929,"_28559":54383,"_3075":54711},[],"The explicitly selected CA certificates.",{"_3699":1162,"_31384":1045,"_21647":54713,"_5":14929,"_28559":54383,"_3075":54714},[],"The DMS does not add the ancestors of those CAs: selecting the enrollment CA does not publish its root or intermediates, which must be selected in **Managed CAs**. The set may contain leaves, roots and intermediates, including more than one hierarchy during a migration. A certificate's position does not define the chain: identify certificates by subject, issuer, AKI/SKI, signature and constraints.",{"_3699":1163,"_31384":1045,"_21647":54716,"_5":14929,"_28559":54387,"_3075":54717},[],"Send an HTTPS GET with an empty body and no EST credential. Gateway controls still apply.",{"_3699":1164,"_31384":1045,"_21647":54719,"_5":14929,"_28559":54387,"_3075":54720},[],"**Default response.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters.",{"_3699":1165,"_31384":1045,"_21647":54722,"_5":14929,"_28559":54387,"_3075":54723},[],"**PEM response.** Lamassu selects this format when `Accept` is exactly `application/x-pem-file` and returns the same value in `Content-Type`. The body contains the certificates in PEM.",{"_3699":1166,"_31384":1045,"_21647":54725,"_5":14929,"_28559":54391,"_3075":54726},[],"This example downloads the default response and converts it to PEM. It uses `EST_BASE` and `est-trust.pem` from Before you begin.",{"_3699":1167,"_31384":1045,"_21647":54728,"_5":14929,"_28559":54391,"_3075":54729},[],"Check fingerprints, issuers and dates against the distribution configuration. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3699":1168,"_31384":1045,"_21647":54731,"_5":14929,"_28559":54395,"_3075":54732},[],"`POST /simpleenroll` issues a device’s initial certificate from a CSR. Lamassu takes the device identifier from the CN and binds the issued certificate to the device identity. The private key stays on the client.",{"_3699":1169,"_31384":1045,"_21647":54734,"_5":14929,"_28559":54399,"_3075":54735},[],"The initial enrollment options are stored in `settings.enrollment_settings`:",{"_3699":1170,"_31384":1045,"_21647":54737,"_5":14929,"_28559":54399,"_3075":54538},[],{"_3699":1171,"_31384":1045,"_21647":54739,"_5":14929,"_28559":54399,"_3075":54541},[],{"_3699":1172,"_31384":1045,"_21647":54741,"_5":14929,"_28559":54399,"_3075":54742},[],"`protocol`",{"_3699":1173,"_31384":1045,"_21647":54744,"_5":14929,"_28559":54399,"_3075":54745},[],"`EST_RFC7030` for these operations.",{"_3699":1174,"_31384":1045,"_21647":54747,"_5":14929,"_28559":54399,"_3075":54748},[],"`enrollment_ca`",{"_3699":1175,"_31384":1045,"_21647":54750,"_5":14929,"_28559":54399,"_3075":54751},[],"ID of the CA that signs the certificates.",{"_3699":1176,"_31384":1045,"_21647":54753,"_5":14929,"_28559":54399,"_3075":54754},[],"`registration_mode`",{"_3699":1177,"_31384":1045,"_21647":54756,"_5":14929,"_28559":54399,"_3075":54757},[],"`JITP` creates an unknown device with the CSR CN as ID and the DMS as owner. `PRE_REGISTRATION` requires the ID to exist beforehand.",{"_3699":1178,"_31384":1045,"_21647":54759,"_5":14929,"_28559":54399,"_3075":54760},[],"`device_provisioning_profile`",{"_3699":1179,"_31384":1045,"_21647":54762,"_5":14929,"_28559":54399,"_3075":54763},[],"Tags, metadata and icon a device registered through JITP receives.",{"_3699":1180,"_31384":1045,"_21647":54765,"_5":14929,"_28559":54399,"_3075":54766},[],"`enable_replaceable_enrollment`",{"_3699":1181,"_31384":1045,"_21647":54768,"_5":14929,"_28559":54399,"_3075":54769},[],"Allows `/simpleenroll` for an existing ID in the same DMS.",{"_3699":1182,"_31384":1045,"_21647":54771,"_5":14929,"_28559":54399,"_3075":54772},[],"`verify_csr_signature` (**Verify CSR signature**)",{"_3699":1183,"_31384":1045,"_21647":54774,"_5":14929,"_28559":54399,"_3075":54775},[],"Verifies possession of the CSR key. Keep it `true`.",{"_3699":1184,"_31384":1045,"_21647":54777,"_5":14929,"_28559":54399,"_3075":54778},[],"`est_rfc7030_settings`",{"_3699":1185,"_31384":1045,"_21647":54780,"_5":14929,"_28559":54399,"_3075":54781},[],"Initial enrollment authentication; see Authentication per operation.",{"_3699":1186,"_31384":1045,"_21647":54783,"_5":14929,"_28559":54399,"_3075":54784},[],"**Registration and replacement.** With `PRE_REGISTRATION`, an existing device goes through the replacement check first, even without an identity; review the preregistration conditions before using this mode. Initial enrollment rejects an ID owned by another DMS. Replacement can attempt to revoke the previous certificate even if a later phase fails: it is not atomic. Do not enable it as an automatic response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3699":1187,"_31384":1045,"_21647":54786,"_5":14929,"_28559":54399,"_3075":54787},[],"**Issuance profile.** The profile is defined in `settings`, not in `enrollment_settings`, and applies to all three operations that issue certificates. `settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. The rules are documented in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3699":1188,"_31384":1045,"_21647":54789,"_5":14929,"_28559":54402,"_3075":54790},[],"Send `Content-Type: application/pkcs10` with a Base64-encoded DER PKCS#10 CSR in the body. Lamassu decodes the body directly as Base64, with no PEM or JSON wrapper.",{"_3699":1189,"_31384":1045,"_21647":54792,"_5":14929,"_28559":54402,"_3075":54793},[],"**Default response.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The PKCS#7 contains the issued certificate. Retrieve the CA certificates you need to validate its chain separately.",{"_3699":1190,"_31384":1045,"_21647":54795,"_5":14929,"_28559":54402,"_3075":54796},[],"**PEM response.** Send exactly `Accept: application/x-pem-file` to receive the certificate in PEM with `Content-Type: application/x-pem-file`.",{"_3699":1191,"_31384":1045,"_21647":54798,"_5":14929,"_28559":54405,"_3075":54799},[],"The example uses initial `CLIENT_CERTIFICATE` authentication and the files from Before you begin.",{"_3699":1192,"_31384":1045,"_21647":54801,"_5":14929,"_28559":54405,"_3075":54802},[],"**Prepare the CSR.** The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3699":1193,"_31384":1045,"_21647":54804,"_5":14929,"_28559":54405,"_3075":54805},[],"An implementation using hardware or its own store must produce the CSR through its resident key. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3699":1194,"_31384":1045,"_21647":54807,"_5":14929,"_28559":54405,"_3075":54808},[],"**Request the identity.** Send the CSR, authenticating with the bootstrap credential:",{"_3699":1195,"_31384":1045,"_21647":54810,"_5":14929,"_28559":54405,"_3075":54811},[],"If curl fails, the example stops before decoding: an error response is not a certificate. A timeout leaves the operation's result to be checked in Lamassu, so do not automatically repeat issuance.",{"_3699":1196,"_31384":1045,"_21647":54813,"_5":14929,"_28559":54405,"_3075":54814},[],"**Check and install the result.** For a root that issues directly:",{"_3699":1197,"_31384":1045,"_21647":54816,"_5":14929,"_28559":54405,"_3075":54817},[],"`cmp` must exit with code 0. Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3699":1198,"_31384":1045,"_21647":54819,"_5":14929,"_28559":54405,"_3075":54820},[],"Query the device in Lamassu: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism; association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3699":1199,"_31384":1045,"_21647":54822,"_5":14929,"_28559":54408,"_3075":54823},[],"`POST /simplereenroll` issues a successor certificate for an active identity. The client keeps the device identifier and can request the certificate with a new key.",{"_3699":1200,"_31384":1045,"_21647":54825,"_5":14929,"_28559":54412,"_3075":54826},[],"The renewal options are stored in `settings.reenrollment_settings`:",{"_3699":1201,"_31384":1045,"_21647":54828,"_5":14929,"_28559":54412,"_3075":54538},[],{"_3699":1202,"_31384":1045,"_21647":54830,"_5":14929,"_28559":54412,"_3075":54541},[],{"_3699":1203,"_31384":1045,"_21647":54832,"_5":14929,"_28559":54412,"_3075":54778},[],{"_3699":1204,"_31384":1045,"_21647":54834,"_5":14929,"_28559":54412,"_3075":54835},[],"Re-enrollment authentication, independent of the initial one; see Authentication per operation.",{"_3699":1205,"_31384":1045,"_21647":54837,"_5":14929,"_28559":54412,"_3075":54838},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3699":1206,"_31384":1045,"_21647":54840,"_5":14929,"_28559":54412,"_3075":54841},[],"Re-enrollment validation CAs, tried after the enrollment CA. Optional; typically populated during a CA rotation while devices with old-CA certificates renew.",{"_3699":1207,"_31384":1045,"_21647":54843,"_5":14929,"_28559":54412,"_3075":54844},[],"`reenrollment_delta`",{"_3699":1208,"_31384":1045,"_21647":54846,"_5":14929,"_28559":54412,"_3075":54847},[],"The renewal window opens at the active certificate’s `NotAfter` minus this delta.",{"_3699":1209,"_31384":1045,"_21647":54849,"_5":14929,"_28559":54412,"_3075":54850},[],"`preventive_delta`",{"_3699":1210,"_31384":1045,"_21647":54852,"_5":14929,"_28559":54412,"_3075":54853},[],"Preventive monitoring threshold. Produces states and notifications; it does not extend the window.",{"_3699":1211,"_31384":1045,"_21647":54855,"_5":14929,"_28559":54412,"_3075":54856},[],"`critical_delta`",{"_3699":1212,"_31384":1045,"_21647":54858,"_5":14929,"_28559":54412,"_3075":54859},[],"Critical monitoring threshold. Produces states and notifications; it does not extend the window.",{"_3699":1213,"_31384":1045,"_21647":54861,"_5":14929,"_28559":54412,"_3075":54862},[],"`enable_expired_renewal` (**Allow expired renewal**)",{"_3699":1214,"_31384":1045,"_21647":54864,"_5":14929,"_28559":54412,"_3075":54865},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3699":1215,"_31384":1045,"_21647":54867,"_5":14929,"_28559":54412,"_3075":54868},[],"`revoke_on_reenrollment` (**Revoke on Re-enrollment**)",{"_3699":1216,"_31384":1045,"_21647":54870,"_5":14929,"_28559":54412,"_3075":54871},[],"If the previous certificate is `ACTIVE`, attempts to revoke it with reason Superseded before binding its successor.",{"_3699":1217,"_31384":1045,"_21647":54873,"_5":14929,"_28559":54412,"_3075":54874},[],"The legacy flat field `reenrollment_settings.additional_validation_cas` is not part of the API: it is ignored without error, so an update body built with it empties `validation_cas`. Read the DMS before editing it through the API.",{"_3699":1218,"_31384":1045,"_21647":54876,"_5":14929,"_28559":54412,"_3075":54877},[],"Monitoring does not renew: the client must schedule the request and installation with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed; see Recover according to state.",{"_3699":1219,"_31384":1045,"_21647":54879,"_5":14929,"_28559":54415,"_3075":54880},[],"Use the same CSR format and headers as `simpleenroll`. The response contains the successor certificate in Base64-encoded DER PKCS#7, or in PEM if you send exactly `Accept: application/x-pem-file`.",{"_3699":1220,"_31384":1045,"_21647":54882,"_5":14929,"_28559":54415,"_3075":54883},[],"With certificate authentication, Lamassu requires the credential’s CN to match the CSR’s CN and compares the requested subject with the current certificate. The DMS rejects a revoked current certificate or a request made before the renewal window. Client certificate details accepted CAs, expiry and revocation checks.",{"_3699":1221,"_31384":1045,"_21647":54885,"_5":14929,"_28559":54418,"_3075":54886},[],"The example continues the initial enrollment in the same Bash session, with `device.crt` and `device.key` as the current identity.",{"_3699":1222,"_31384":1045,"_21647":54888,"_5":14929,"_28559":54418,"_3075":54889},[],"**Prepare renewal.** Before requesting the successor:",{"_3699":1223,"_31384":1045,"_21647":54891,"_5":14929,"_28559":54418,"_3075":54892},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3699":1224,"_31384":1045,"_21647":54894,"_5":14929,"_28559":54418,"_3075":54895},[],"Check the re-enrollment authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3699":1225,"_31384":1045,"_21647":54897,"_5":14929,"_28559":54418,"_3075":54898},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`.",{"_3699":1226,"_31384":1045,"_21647":54900,"_5":14929,"_28559":54418,"_3075":54901},[],"Review **Revoke on Re-enrollment**. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3699":1227,"_31384":1045,"_21647":54903,"_5":14929,"_28559":54418,"_3075":54904},[],"**Request the successor certificate.** The request authenticates with `device.crt` and `device.key`, and the CSR contains a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C, so rebuilding only the CN can lose required attributes.",{"_3699":1228,"_31384":1045,"_21647":54906,"_5":14929,"_28559":54418,"_3075":54907},[],"Also check extensions, dates and that the serial matches the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3699":1229,"_31384":1045,"_21647":54909,"_5":14929,"_28559":54418,"_3075":54910},[],"**Install and check the new pair.** Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3699":1230,"_31384":1045,"_21647":54912,"_5":14929,"_28559":54418,"_3075":54913},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3699":1231,"_31384":1045,"_21647":54915,"_5":14929,"_28559":54421,"_3075":54916},[],"Situation",{"_3699":1232,"_31384":1045,"_21647":54918,"_5":14929,"_28559":54421,"_3075":54919},[],"Procedure",{"_3699":1233,"_31384":1045,"_21647":54921,"_5":14929,"_28559":54421,"_3075":54922},[],"Valid certificate, outside the window",{"_3699":1234,"_31384":1045,"_21647":54924,"_5":14929,"_28559":54421,"_3075":54925},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3699":1235,"_31384":1045,"_21647":54927,"_5":14929,"_28559":54421,"_3075":54928},[],"Expired certificate, key available",{"_3699":1236,"_31384":1045,"_21647":54930,"_5":14929,"_28559":54421,"_3075":54931},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3699":1237,"_31384":1045,"_21647":54933,"_5":14929,"_28559":54421,"_3075":54934},[],"Renewal through webhook or `NO_AUTH`",{"_3699":1238,"_31384":1045,"_21647":54936,"_5":14929,"_28559":54421,"_3075":54937},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the webhook must explicitly authorize the recovery it permits.",{"_3699":1239,"_31384":1045,"_21647":54939,"_5":14929,"_28559":54421,"_3075":54940},[],"Lost or inaccessible key",{"_3699":1240,"_31384":1045,"_21647":54942,"_5":14929,"_28559":54421,"_3075":54943},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3699":1241,"_31384":1045,"_21647":54945,"_5":14929,"_28559":54421,"_3075":54946},[],"Current identity revoked",{"_3699":1242,"_31384":1045,"_21647":54948,"_5":14929,"_28559":54421,"_3075":54949},[],"`simplereenroll` rejects the revoked current certificate, and retaining its files does not restore a valid connection. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3699":1243,"_31384":1045,"_21647":54951,"_5":14929,"_28559":54421,"_3075":54952},[],"Device without an identity",{"_3699":1244,"_31384":1045,"_21647":54954,"_5":14929,"_28559":54421,"_3075":54955},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3699":1245,"_31384":1045,"_21647":54957,"_5":14929,"_28559":54421,"_3075":54958},[],"Retired device",{"_3699":1246,"_31384":1045,"_21647":54960,"_5":14929,"_28559":54421,"_3075":54961},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3699":1247,"_31384":1045,"_21647":54963,"_5":14929,"_28559":54421,"_3075":54964},[],"Timeout, HTTP 500 or installation failure",{"_3699":1248,"_31384":1045,"_21647":54966,"_5":14929,"_28559":54421,"_3075":54967},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3699":1249,"_31384":1045,"_21647":54969,"_5":14929,"_28559":54425,"_3075":54970},[],"`POST /serverkeygen` generates a software key in Lamassu, rebuilds the CSR with that key and performs initial enrollment. The client receives the private key and certificate.",{"_3699":1250,"_31384":1045,"_21647":54972,"_5":14929,"_28559":54429,"_3075":54973},[],"`settings.server_keygen_settings` controls key generation. The rest of the operation applies the initial enrollment configuration; before testing with a registered ID, check whether that configuration allows certificate replacement.",{"_3699":1251,"_31384":1045,"_21647":54975,"_5":14929,"_28559":54429,"_3075":54538},[],{"_3699":1252,"_31384":1045,"_21647":54977,"_5":14929,"_28559":54429,"_3075":54541},[],{"_3699":1253,"_31384":1045,"_21647":54979,"_5":14929,"_28559":54429,"_3075":54980},[],"`enabled` (**Enable server-side key generation**)",{"_3699":1254,"_31384":1045,"_21647":54982,"_5":14929,"_28559":54429,"_3075":54983},[],"Turns on the operation. With the operation disabled, the console omits the `key` field.",{"_3699":1255,"_31384":1045,"_21647":54985,"_5":14929,"_28559":54429,"_3075":54986},[],"`key.type` (**Key type**)",{"_3699":1256,"_31384":1045,"_21647":54988,"_5":14929,"_28559":54429,"_3075":54989},[],"RSA or ECDSA. The issuance profile must allow the selected algorithm and size.",{"_3699":1257,"_31384":1045,"_21647":54991,"_5":14929,"_28559":54429,"_3075":54992},[],"`key.bits`",{"_3699":1258,"_31384":1045,"_21647":54994,"_5":14929,"_28559":54429,"_3075":54995},[],"Modulus size for RSA or curve for ECDSA. The console offers 2048, 3072 or 4096 bits for RSA (default 4096) and P-256, P-384 or P-521 for ECDSA (default P-256).",{"_3699":1259,"_31384":1045,"_21647":54997,"_5":14929,"_28559":54429,"_3075":54998},[],"For ECDSA, the service also recognizes 224, 256, 384 and 521 as P-224, P-256, P-384 and P-521, and an unrecognized value selects P-256. Choose a compatible size and check the resulting key.",{"_3699":1260,"_31384":1045,"_21647":55000,"_5":14929,"_28559":54432,"_3075":55001},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The response uses this operation’s multipart format even if `Accept` asks for PEM. Lamassu generates the key in software even when the CA signs with an HSM-backed key.",{"_3699":1261,"_31384":1045,"_21647":55003,"_5":14929,"_28559":54432,"_3075":55004},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`, and contains two parts:",{"_3699":1262,"_31384":1045,"_21647":55006,"_5":14929,"_28559":54432,"_3075":55007},[],"Part",{"_3699":1263,"_31384":1045,"_21647":55009,"_5":14929,"_28559":54432,"_3075":55010},[],"Content after decoding its Base64",{"_3699":1264,"_31384":1045,"_21647":55012,"_5":14929,"_28559":54432,"_3075":55013},[],"`application/pkcs8`",{"_3699":1265,"_31384":1045,"_21647":55015,"_5":14929,"_28559":54432,"_3075":55016},[],"Unencrypted DER PKCS#8 private key.",{"_3699":1266,"_31384":1045,"_21647":55018,"_5":14929,"_28559":54432,"_3075":55019},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3699":1267,"_31384":1045,"_21647":55021,"_5":14929,"_28559":54432,"_3075":55022},[],"DER PKCS#7 containing the issued certificate.",{"_3699":1268,"_31384":1045,"_21647":55024,"_5":14929,"_28559":54432,"_3075":55025},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3699":1269,"_31384":1045,"_21647":55027,"_5":14929,"_28559":54435,"_3075":55028},[],"The example uses `EST_BASE` and the trust and bootstrap files from Before you begin. Choose an available and admitted ID, such as `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3699":1270,"_31384":1045,"_21647":55030,"_5":14929,"_28559":54435,"_3075":55031},[],"Process the MIME parts according to their headers and verify that the received key matches the certificate. Inspect the CN, serial, dates and uses, and check the association in Lamassu before installing. Protect files containing the key and remove temporary copies according to the device storage mechanism.",{"_3699":1271,"_31384":1045,"_21647":55033,"_5":14929,"_28559":54435,"_3075":55034},[],"<Card title=\"Authentication and trust\" description=\"Bootstrap credentials, the webhook contract and revocation checks.\" href=\"/docs/platform/iot-fleets/est/bootstrap-identity\" />",{"_3699":1272,"_31384":1045,"_21647":55036,"_5":14929,"_28559":54435,"_3075":55037},[],"<Card title=\"Devices and identities\" description=\"Check the slot, history and status of each issued identity.\" href=\"/docs/platform/iot-fleets/device-management\" />",{"_3699":1273,"_31384":1045,"_21647":55039,"_5":14929,"_28559":54435,"_3075":55040},[],"<Card title=\"Enrollment troubleshooting\" description=\"Locate transport, authentication, registration, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/est/troubleshooting\" />",{"_3699":1274,"_31384":1274,"_5":15283,"_3075":55042,"_31709":55043,"_21647":55044,"_28559":1274},"EST Reference",[51094,52635,53807,54269],[],{"_3699":1275,"_31384":1274,"_21647":55046,"_5":14929,"_28559":1274,"_3075":55047},[],"The Enrollment over Secure Transport protocol defined by RFC 7030.",{"_3699":1276,"_31384":1274,"_5":31706,"_21647":55049,"_28559":55050,"_3075":52395},[],"/docs/platform/iot-fleets/est#operations",{"_3699":1277,"_31384":1274,"_5":31706,"_21647":55052,"_28559":55053,"_3075":55054},[],"/docs/platform/iot-fleets/est#authentication-and-messages","Authentication and messages",{"_3699":1278,"_31384":1274,"_21647":55056,"_5":14929,"_28559":1274,"_3075":55057},[],"Enrollment over Secure Transport (EST) is a protocol for obtaining and renewing X.509 certificates over HTTPS. An EST client communicates with an EST server, which handles certificate requests and provides certification authority certificates. The standard defines messages, operations and authentication mechanisms. RFC 7030",{"_3699":1279,"_31384":1274,"_21647":55059,"_5":14929,"_28559":55050,"_3075":55060},[],"Operation paths are appended to the `/.well-known/est` prefix, which may include a label identifying the CA or service.",{"_3699":1280,"_31384":1274,"_21647":55062,"_5":14929,"_28559":55050,"_3075":54444},[],{"_3699":1281,"_31384":1274,"_21647":55064,"_5":14929,"_28559":55050,"_3075":54447},[],{"_3699":1282,"_31384":1274,"_21647":55066,"_5":14929,"_28559":55050,"_3075":51484},[],{"_3699":1283,"_31384":1274,"_21647":55068,"_5":14929,"_28559":55050,"_3075":55069},[],"Server support",{"_3699":1284,"_31384":1274,"_21647":55071,"_5":14929,"_28559":55050,"_3075":54453},[],{"_3699":1285,"_31384":1274,"_21647":55073,"_5":14929,"_28559":55050,"_3075":54456},[],{"_3699":1286,"_31384":1274,"_21647":55075,"_5":14929,"_28559":55050,"_3075":55076},[],"Retrieve CA certificates.",{"_3699":1287,"_31384":1274,"_21647":55078,"_5":14929,"_28559":55050,"_3075":55079},[],"Mandatory",{"_3699":1288,"_31384":1274,"_21647":55081,"_5":14929,"_28559":55050,"_3075":54462},[],{"_3699":1289,"_31384":1274,"_21647":55083,"_5":14929,"_28559":55050,"_3075":54465},[],{"_3699":1290,"_31384":1274,"_21647":55085,"_5":14929,"_28559":55050,"_3075":55086},[],"Request an initial certificate using a CSR.",{"_3699":1291,"_31384":1274,"_21647":55088,"_5":14929,"_28559":55050,"_3075":55079},[],{"_3699":1292,"_31384":1274,"_21647":55090,"_5":14929,"_28559":55050,"_3075":54471},[],{"_3699":1293,"_31384":1274,"_21647":55092,"_5":14929,"_28559":55050,"_3075":54465},[],{"_3699":1294,"_31384":1274,"_21647":55094,"_5":14929,"_28559":55050,"_3075":55095},[],"Request certificate renewal or rekeying.",{"_3699":1295,"_31384":1274,"_21647":55097,"_5":14929,"_28559":55050,"_3075":55079},[],{"_3699":1296,"_31384":1274,"_21647":55099,"_5":14929,"_28559":55050,"_3075":54479},[],{"_3699":1297,"_31384":1274,"_21647":55101,"_5":14929,"_28559":55050,"_3075":54465},[],{"_3699":1298,"_31384":1274,"_21647":55103,"_5":14929,"_28559":55050,"_3075":55104},[],"Request a server-generated key and its certificate.",{"_3699":1299,"_31384":1274,"_21647":55106,"_5":14929,"_28559":55050,"_3075":55107},[],"Optional",{"_3699":1300,"_31384":1274,"_21647":55109,"_5":14929,"_28559":55050,"_3075":55110},[],"`/csrattrs`",{"_3699":1301,"_31384":1274,"_21647":55112,"_5":14929,"_28559":55050,"_3075":54456},[],{"_3699":1302,"_31384":1274,"_21647":55114,"_5":14929,"_28559":55050,"_3075":55115},[],"Retrieve suggested CSR attributes.",{"_3699":1303,"_31384":1274,"_21647":55117,"_5":14929,"_28559":55050,"_3075":55107},[],{"_3699":1304,"_31384":1274,"_21647":55119,"_5":14929,"_28559":55050,"_3075":55120},[],"`/fullcmc`",{"_3699":1305,"_31384":1274,"_21647":55122,"_5":14929,"_28559":55050,"_3075":54465},[],{"_3699":1306,"_31384":1274,"_21647":55124,"_5":14929,"_28559":55050,"_3075":55125},[],"Submit a Full CMC request.",{"_3699":1307,"_31384":1274,"_21647":55127,"_5":14929,"_28559":55050,"_3075":55107},[],{"_3699":1308,"_31384":1274,"_21647":55129,"_5":14929,"_28559":55053,"_3075":55130},[],"EST uses TLS to protect the exchange. The client authenticates the server, and the server authenticates and authorizes the client using the mechanisms defined by the standard. Initial CA certificate distribution has specific conditions for establishing trust. RFC 7030, sections 3.3 and 4.1",{"_3699":1309,"_31384":1274,"_21647":55132,"_5":14929,"_28559":55053,"_3075":55133},[],"The `/simpleenroll` and `/simplereenroll` requests use a PKCS#10 CSR. The certificate response uses PKCS#7. The `/serverkeygen` response is `multipart/mixed` and contains the key and certificate. The standard also defines Full CMC requests and responses and the CSR attributes format. RFC 7030, section 3.2.4",{"_3699":1310,"_31384":1274,"_21647":55135,"_5":14929,"_28559":55053,"_3075":55136},[],"See EST in Lamassu for the available operations and their configuration.",{"_3699":1311,"_31384":1311,"_5":15283,"_3075":55138,"_31709":55139,"_21647":55140,"_28559":1311},"Enrollment troubleshooting",[51094,52635,53807,54269],[],{"_3699":1312,"_31384":1311,"_21647":55142,"_5":14929,"_28559":1311,"_3075":55143},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3699":1313,"_31384":1311,"_5":31706,"_21647":55145,"_28559":55146,"_3075":55147},[],"/docs/platform/iot-fleets/est/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3699":1314,"_31384":1311,"_5":31706,"_21647":55149,"_28559":55150,"_3075":55151},[],"/docs/platform/iot-fleets/est/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3699":1315,"_31384":1311,"_5":31706,"_21647":55153,"_28559":55154,"_3075":55155},[],"/docs/platform/iot-fleets/est/troubleshooting#compatibility-notes","Compatibility notes",{"_3699":1316,"_31384":1311,"_5":31706,"_21647":55157,"_28559":55158,"_3075":55159},[],"/docs/platform/iot-fleets/est/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3699":1317,"_31384":1311,"_21647":55161,"_5":14929,"_28559":1311,"_3075":55162},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3699":1318,"_31384":1311,"_21647":55164,"_5":14929,"_28559":55150,"_3075":55165},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3699":1319,"_31384":1311,"_21647":55167,"_5":14929,"_28559":55150,"_3075":55168},[],"Symptom or message",{"_3699":1320,"_31384":1311,"_21647":55170,"_5":14929,"_28559":55150,"_3075":54176},[],{"_3699":1321,"_31384":1311,"_21647":55172,"_5":14929,"_28559":55150,"_3075":55173},[],"curl rejects TLS, name or issuer",{"_3699":1322,"_31384":1311,"_21647":55175,"_5":14929,"_28559":55150,"_3075":55176},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3699":1323,"_31384":1311,"_21647":55178,"_5":14929,"_28559":55150,"_3075":55179},[],"404 or missing APS",{"_3699":1324,"_31384":1311,"_21647":55181,"_5":14929,"_28559":55150,"_3075":55182},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3699":1325,"_31384":1311,"_21647":55184,"_5":14929,"_28559":55150,"_3075":55185},[],"400, CSR or format error",{"_3699":1326,"_31384":1311,"_21647":55187,"_5":14929,"_28559":55150,"_3075":55188},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3699":1327,"_31384":1311,"_21647":55190,"_5":14929,"_28559":55150,"_3075":55191},[],"Missing credential or invalid certificate",{"_3699":1328,"_31384":1311,"_21647":55193,"_5":14929,"_28559":55150,"_3075":55194},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3699":1329,"_31384":1311,"_21647":55196,"_5":14929,"_28559":55150,"_3075":55197},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3699":1330,"_31384":1311,"_21647":55199,"_5":14929,"_28559":55150,"_3075":55200},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3699":1331,"_31384":1311,"_21647":55202,"_5":14929,"_28559":55150,"_3075":55203},[],"Webhook denies, times out or responds without authorization",{"_3699":1332,"_31384":1311,"_21647":55205,"_5":14929,"_28559":55150,"_3075":55206},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3699":1333,"_31384":1311,"_21647":55208,"_5":14929,"_28559":55150,"_3075":55209},[],"`unexpected status code: <n>: redirects are not followed`",{"_3699":1334,"_31384":1311,"_21647":55211,"_5":14929,"_28559":55150,"_3075":55212},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3699":1335,"_31384":1311,"_21647":55214,"_5":14929,"_28559":55150,"_3075":55215},[],"`webhook response exceeds 1048576 bytes`",{"_3699":1336,"_31384":1311,"_21647":55217,"_5":14929,"_28559":55150,"_3075":55218},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3699":1337,"_31384":1311,"_21647":55220,"_5":14929,"_28559":55150,"_3075":55221},[],"`webhook config must not reference files`",{"_3699":1338,"_31384":1311,"_21647":55223,"_5":14929,"_28559":55150,"_3075":55224},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3699":1339,"_31384":1311,"_21647":55226,"_5":14929,"_28559":55150,"_3075":55227},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3699":1340,"_31384":1311,"_21647":55229,"_5":14929,"_28559":55150,"_3075":55230},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3699":1341,"_31384":1311,"_21647":55232,"_5":14929,"_28559":55150,"_3075":55233},[],"`webhook mTLS certificate and key are invalid: …`",{"_3699":1342,"_31384":1311,"_21647":55235,"_5":14929,"_28559":55150,"_3075":55236},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3699":1343,"_31384":1311,"_21647":55238,"_5":14929,"_28559":55150,"_3075":55239},[],"400 `struct validation error` creating or updating a DMS",{"_3699":1344,"_31384":1311,"_21647":55241,"_5":14929,"_28559":55150,"_3075":55242},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3699":1345,"_31384":1311,"_21647":55244,"_5":14929,"_28559":55150,"_3075":55245},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3699":1346,"_31384":1311,"_21647":55247,"_5":14929,"_28559":55150,"_3075":55248},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3699":1347,"_31384":1311,"_21647":55250,"_5":14929,"_28559":55150,"_3075":55251},[],"`device not preregistered`",{"_3699":1348,"_31384":1311,"_21647":55253,"_5":14929,"_28559":55150,"_3075":55254},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3699":1349,"_31384":1311,"_21647":55256,"_5":14929,"_28559":55150,"_3075":55257},[],"`forbiddenNewEnrollment`",{"_3699":1350,"_31384":1311,"_21647":55259,"_5":14929,"_28559":55150,"_3075":55260},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3699":1351,"_31384":1311,"_21647":55262,"_5":14929,"_28559":55150,"_3075":55263},[],"Different owning DMS",{"_3699":1352,"_31384":1311,"_21647":55265,"_5":14929,"_28559":55150,"_3075":55266},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3699":1353,"_31384":1311,"_21647":55268,"_5":14929,"_28559":55150,"_3075":55269},[],"`invalid RawSubject bytes`",{"_3699":1354,"_31384":1311,"_21647":55271,"_5":14929,"_28559":55150,"_3075":55272},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3699":1355,"_31384":1311,"_21647":55274,"_5":14929,"_28559":55150,"_3075":55275},[],"`invalid reenroll window`",{"_3699":1356,"_31384":1311,"_21647":55277,"_5":14929,"_28559":55150,"_3075":55278},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3699":1357,"_31384":1311,"_21647":55280,"_5":14929,"_28559":55150,"_3075":55281},[],"Current certificate revoked",{"_3699":1358,"_31384":1311,"_21647":55283,"_5":14929,"_28559":55150,"_3075":55284},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3699":1359,"_31384":1311,"_21647":55286,"_5":14929,"_28559":55150,"_3075":55287},[],"CA, profile or signing error",{"_3699":1360,"_31384":1311,"_21647":55289,"_5":14929,"_28559":55150,"_3075":55290},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3699":1361,"_31384":1311,"_21647":55292,"_5":14929,"_28559":55150,"_3075":55293},[],"HTTP 200 without a device connection",{"_3699":1362,"_31384":1311,"_21647":55295,"_5":14929,"_28559":55150,"_3075":55296},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3699":1363,"_31384":1311,"_21647":55298,"_5":14929,"_28559":55150,"_3075":55299},[],"Timeout or error after issuance",{"_3699":1364,"_31384":1311,"_21647":55301,"_5":14929,"_28559":55150,"_3075":55302},[],"New certificates, current slot and previous identity's state before retrying.",{"_3699":1365,"_31384":1311,"_21647":55304,"_5":14929,"_28559":55154,"_3075":55305},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3699":1366,"_31384":1311,"_21647":55307,"_5":14929,"_28559":55154,"_3075":55308},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST in Lamassu.",{"_3699":1367,"_31384":1311,"_21647":55310,"_5":14929,"_28559":55158,"_3075":55311},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3699":1368,"_31384":1311,"_21647":55313,"_5":14929,"_28559":55158,"_3075":55314},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3699":1369,"_31384":1311,"_21647":55316,"_5":14929,"_28559":55158,"_3075":55317},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3699":1370,"_31384":1311,"_21647":55319,"_5":14929,"_28559":55158,"_3075":55320},[],"Make one request, save headers/body and query the device and certificates.",{"_3699":1371,"_31384":1311,"_21647":55322,"_5":14929,"_28559":55158,"_3075":55323},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3699":1372,"_31384":1311,"_21647":55325,"_5":14929,"_28559":55158,"_3075":55326},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified (including an OCSP Unknown status) is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3699":1373,"_31384":1311,"_21647":55328,"_5":14929,"_28559":55158,"_3075":55329},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3699":1374,"_31384":1374,"_5":15283,"_3075":55331,"_31709":55332,"_21647":55334,"_28559":1374},"AWS IoT Core",[51094,52635,53807,53805,55333],"Integrations",[],{"_3699":1375,"_31384":1374,"_21647":55336,"_5":14929,"_28559":1374,"_3075":55337},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3699":1376,"_31384":1374,"_5":31706,"_21647":55339,"_28559":55340,"_3075":55341},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3699":1377,"_31384":1374,"_5":31706,"_21647":55343,"_28559":55344,"_3075":55345},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3699":1378,"_31384":1374,"_5":31706,"_21647":55347,"_28559":55348,"_3075":55349},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3699":1379,"_31384":1374,"_5":31706,"_21647":55351,"_28559":55352,"_3075":55353},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3699":1380,"_31384":1374,"_5":31706,"_21647":55355,"_28559":55356,"_3075":55357},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3699":1381,"_31384":1374,"_5":31706,"_21647":55359,"_28559":55360,"_3075":55361},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3699":1382,"_31384":1374,"_5":31706,"_21647":55363,"_28559":55364,"_3075":55365},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3699":1383,"_31384":1374,"_5":31706,"_21647":55367,"_28559":55368,"_3075":55369},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3699":1384,"_31384":1374,"_5":31706,"_21647":55371,"_28559":55372,"_3075":55373},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3699":1385,"_31384":1374,"_5":31706,"_21647":55375,"_28559":55376,"_3075":55377},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3699":1386,"_31384":1374,"_5":31706,"_21647":55379,"_28559":55380,"_3075":55381},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3699":1387,"_31384":1374,"_5":31706,"_21647":55383,"_28559":55384,"_3075":55385},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3699":1388,"_31384":1374,"_5":31706,"_21647":55387,"_28559":55388,"_3075":55389},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3699":1389,"_31384":1374,"_5":31706,"_21647":55391,"_28559":55392,"_3075":55393},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3699":1390,"_31384":1374,"_5":31706,"_21647":55395,"_28559":55396,"_3075":55397},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3699":1391,"_31384":1374,"_5":31706,"_21647":55399,"_28559":55400,"_3075":55401},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3699":1392,"_31384":1374,"_5":31706,"_21647":55403,"_28559":55404,"_3075":55405},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3699":1393,"_31384":1374,"_5":31706,"_21647":55407,"_28559":55408,"_3075":55409},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3699":1394,"_31384":1374,"_5":31706,"_21647":55411,"_28559":55412,"_3075":55413},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3699":1395,"_31384":1374,"_5":31706,"_21647":55415,"_28559":55416,"_3075":55417},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3699":1396,"_31384":1374,"_5":31706,"_21647":55419,"_28559":55420,"_3075":55421},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3699":1397,"_31384":1374,"_5":31706,"_21647":55423,"_28559":55424,"_3075":55425},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3699":1398,"_31384":1374,"_5":31706,"_21647":55427,"_28559":55428,"_3075":55429},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3699":1399,"_31384":1374,"_5":31706,"_21647":55431,"_28559":55432,"_3075":55433},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3699":1400,"_31384":1374,"_5":31706,"_21647":55435,"_28559":55436,"_3075":55437},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3699":1401,"_31384":1374,"_21647":55439,"_5":14929,"_28559":1374,"_3075":55440},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3699":1402,"_31384":1374,"_21647":55442,"_5":14929,"_28559":1374,"_3075":55443},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3699":1403,"_31384":1374,"_21647":55445,"_5":14929,"_28559":1374,"_3075":55446},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3699":1404,"_31384":1374,"_21647":55448,"_5":14929,"_28559":55340,"_3075":55449},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3699":1405,"_31384":1374,"_21647":55451,"_5":14929,"_28559":55340,"_3075":55452},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3699":1406,"_31384":1374,"_21647":55454,"_5":14929,"_28559":55340,"_3075":55455},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3699":1407,"_31384":1374,"_21647":55457,"_5":14929,"_28559":55340,"_3075":55458},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3699":1408,"_31384":1374,"_21647":55460,"_5":14929,"_28559":55344,"_3075":55461},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3699":1409,"_31384":1374,"_21647":55463,"_5":14929,"_28559":55348,"_3075":55464},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3699":1410,"_31384":1374,"_21647":55466,"_5":14929,"_28559":55348,"_3075":55467},[],"IAM action",{"_3699":1411,"_31384":1374,"_21647":55469,"_5":14929,"_28559":55348,"_3075":51484},[],{"_3699":1412,"_31384":1374,"_21647":55471,"_5":14929,"_28559":55348,"_3075":55472},[],"`iot:GetRegistrationCode`",{"_3699":1413,"_31384":1374,"_21647":55474,"_5":14929,"_28559":55348,"_3075":55475},[],"Obtain the verification code for CA registration in the Primary Account",{"_3699":1414,"_31384":1374,"_21647":55477,"_5":14929,"_28559":55348,"_3075":55478},[],"`iot:RegisterCACertificate`",{"_3699":1415,"_31384":1374,"_21647":55480,"_5":14929,"_28559":55348,"_3075":55481},[],"Register the CA in AWS IoT",{"_3699":1416,"_31384":1374,"_21647":55483,"_5":14929,"_28559":55348,"_3075":55484},[],"`iot:DescribeCACertificate`",{"_3699":1417,"_31384":1374,"_21647":55486,"_5":14929,"_28559":55348,"_3075":55487},[],"Check the CA registration status",{"_3699":1418,"_31384":1374,"_21647":55489,"_5":14929,"_28559":55348,"_3075":55490},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3699":1419,"_31384":1374,"_21647":55492,"_5":14929,"_28559":55348,"_3075":55493},[],"Create or update Things in IoT Core",{"_3699":1420,"_31384":1374,"_21647":55495,"_5":14929,"_28559":55348,"_3075":55496},[],"`iot:RegisterThing`",{"_3699":1421,"_31384":1374,"_21647":55498,"_5":14929,"_28559":55348,"_3075":55499},[],"Provision Things through a template",{"_3699":1422,"_31384":1374,"_21647":55501,"_5":14929,"_28559":55348,"_3075":55502},[],"`iot:RegisterCertificate`",{"_3699":1423,"_31384":1374,"_21647":55504,"_5":14929,"_28559":55348,"_3075":55505},[],"Register device certificates",{"_3699":1424,"_31384":1374,"_21647":55507,"_5":14929,"_28559":55348,"_3075":55508},[],"`iot:UpdateCertificate`",{"_3699":1425,"_31384":1374,"_21647":55510,"_5":14929,"_28559":55348,"_3075":55511},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3699":1426,"_31384":1374,"_21647":55513,"_5":14929,"_28559":55348,"_3075":55514},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3699":1427,"_31384":1374,"_21647":55516,"_5":14929,"_28559":55348,"_3075":55517},[],"Create and attach IoT policies",{"_3699":1428,"_31384":1374,"_21647":55519,"_5":14929,"_28559":55348,"_3075":55520},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3699":1429,"_31384":1374,"_21647":55522,"_5":14929,"_28559":55348,"_3075":55523},[],"Manage Thing groups",{"_3699":1430,"_31384":1374,"_21647":55525,"_5":14929,"_28559":55348,"_3075":55526},[],"`iot:CreateProvisioningTemplate`",{"_3699":1431,"_31384":1374,"_21647":55528,"_5":14929,"_28559":55348,"_3075":55529},[],"Create JITP templates",{"_3699":1432,"_31384":1374,"_21647":55531,"_5":14929,"_28559":55348,"_3075":55532},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3699":1433,"_31384":1374,"_21647":55534,"_5":14929,"_28559":55348,"_3075":55535},[],"Read and write the Device Shadow",{"_3699":1434,"_31384":1374,"_21647":55537,"_5":14929,"_28559":55348,"_3075":55538},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3699":1435,"_31384":1374,"_21647":55540,"_5":14929,"_28559":55352,"_3075":55541},[],"Parameter",{"_3699":1436,"_31384":1374,"_21647":55543,"_5":14929,"_28559":55352,"_3075":55544},[],"Type",{"_3699":1437,"_31384":1374,"_21647":55546,"_5":14929,"_28559":55352,"_3075":55547},[],"Required",{"_3699":1438,"_31384":1374,"_21647":55549,"_5":14929,"_28559":55352,"_3075":54541},[],{"_3699":1439,"_31384":1374,"_21647":55551,"_5":14929,"_28559":55352,"_3075":55552},[],"`connector_id`",{"_3699":1440,"_31384":1374,"_21647":55554,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1441,"_31384":1374,"_21647":55556,"_5":14929,"_28559":55352,"_3075":55557},[],"Yes",{"_3699":1442,"_31384":1374,"_21647":55559,"_5":14929,"_28559":55352,"_3075":55560},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3699":1443,"_31384":1374,"_21647":55562,"_5":14929,"_28559":55352,"_3075":55563},[],"`aws_config.region`",{"_3699":1444,"_31384":1374,"_21647":55565,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1445,"_31384":1374,"_21647":55567,"_5":14929,"_28559":55352,"_3075":55557},[],{"_3699":1446,"_31384":1374,"_21647":55569,"_5":14929,"_28559":55352,"_3075":55570},[],"AWS region where the connector operates.",{"_3699":1447,"_31384":1374,"_21647":55572,"_5":14929,"_28559":55352,"_3075":55573},[],"`aws_config.auth_method`",{"_3699":1448,"_31384":1374,"_21647":55575,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1449,"_31384":1374,"_21647":55577,"_5":14929,"_28559":55352,"_3075":55557},[],{"_3699":1450,"_31384":1374,"_21647":55579,"_5":14929,"_28559":55352,"_3075":55580},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3699":1451,"_31384":1374,"_21647":55582,"_5":14929,"_28559":55352,"_3075":55583},[],"`aws_config.access_key_id`",{"_3699":1452,"_31384":1374,"_21647":55585,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1453,"_31384":1374,"_21647":55587,"_5":14929,"_28559":55352,"_3075":55588},[],"Only with `auth_method=static`",{"_3699":1454,"_31384":1374,"_21647":55590,"_5":14929,"_28559":55352,"_3075":55591},[],"AWS access key.",{"_3699":1455,"_31384":1374,"_21647":55593,"_5":14929,"_28559":55352,"_3075":55594},[],"`aws_config.secret_access_key`",{"_3699":1456,"_31384":1374,"_21647":55596,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1457,"_31384":1374,"_21647":55598,"_5":14929,"_28559":55352,"_3075":55588},[],{"_3699":1458,"_31384":1374,"_21647":55600,"_5":14929,"_28559":55352,"_3075":55601},[],"AWS secret key.",{"_3699":1459,"_31384":1374,"_21647":55603,"_5":14929,"_28559":55352,"_3075":55604},[],"`aws_config.session_token`",{"_3699":1460,"_31384":1374,"_21647":55606,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1461,"_31384":1374,"_21647":55608,"_5":14929,"_28559":55352,"_3075":55609},[],"No",{"_3699":1462,"_31384":1374,"_21647":55611,"_5":14929,"_28559":55352,"_3075":55612},[],"Session token (with `auth_method=static`).",{"_3699":1463,"_31384":1374,"_21647":55614,"_5":14929,"_28559":55352,"_3075":55615},[],"`aws_config.role_arn`",{"_3699":1464,"_31384":1374,"_21647":55617,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1465,"_31384":1374,"_21647":55619,"_5":14929,"_28559":55352,"_3075":55620},[],"Only with `auth_method=role`",{"_3699":1466,"_31384":1374,"_21647":55622,"_5":14929,"_28559":55352,"_3075":55623},[],"ARN of the role to assume.",{"_3699":1467,"_31384":1374,"_21647":55625,"_5":14929,"_28559":55352,"_3075":55626},[],"`aws_config.endpoint_url`",{"_3699":1468,"_31384":1374,"_21647":55628,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1469,"_31384":1374,"_21647":55630,"_5":14929,"_28559":55352,"_3075":55609},[],{"_3699":1470,"_31384":1374,"_21647":55632,"_5":14929,"_28559":55352,"_3075":55633},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3699":1471,"_31384":1374,"_21647":55635,"_5":14929,"_28559":55352,"_3075":55636},[],"`subscriber_event_bus`",{"_3699":1472,"_31384":1374,"_21647":55638,"_5":14929,"_28559":55352,"_3075":18259},[],{"_3699":1473,"_31384":1374,"_21647":55640,"_5":14929,"_28559":55352,"_3075":55557},[],{"_3699":1474,"_31384":1374,"_21647":55642,"_5":14929,"_28559":55352,"_3075":55643},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3699":1475,"_31384":1374,"_21647":55645,"_5":14929,"_28559":55352,"_3075":55646},[],"`dms_manager_client`",{"_3699":1476,"_31384":1374,"_21647":55648,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1477,"_31384":1374,"_21647":55650,"_5":14929,"_28559":55352,"_3075":55557},[],{"_3699":1478,"_31384":1374,"_21647":55652,"_5":14929,"_28559":55352,"_3075":55653},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3699":1479,"_31384":1374,"_21647":55655,"_5":14929,"_28559":55352,"_3075":55656},[],"`device_manager_client`",{"_3699":1480,"_31384":1374,"_21647":55658,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1481,"_31384":1374,"_21647":55660,"_5":14929,"_28559":55352,"_3075":55557},[],{"_3699":1482,"_31384":1374,"_21647":55662,"_5":14929,"_28559":55352,"_3075":55663},[],"HTTP URL of Lamassu's Device Manager.",{"_3699":1483,"_31384":1374,"_21647":55665,"_5":14929,"_28559":55352,"_3075":55666},[],"`ca_client`",{"_3699":1484,"_31384":1374,"_21647":55668,"_5":14929,"_28559":55352,"_3075":25872},[],{"_3699":1485,"_31384":1374,"_21647":55670,"_5":14929,"_28559":55352,"_3075":55557},[],{"_3699":1486,"_31384":1374,"_21647":55672,"_5":14929,"_28559":55352,"_3075":55673},[],"HTTP URL of Lamassu's CA service.",{"_3699":1487,"_31384":1374,"_21647":55675,"_5":14929,"_28559":55356,"_3075":55676},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3699":1488,"_31384":1374,"_21647":55678,"_5":14929,"_28559":55356,"_3075":55679},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3699":1489,"_31384":1374,"_21647":55681,"_5":14929,"_28559":55356,"_3075":55682},[],"CloudEvent type",{"_3699":1490,"_31384":1374,"_21647":55684,"_5":14929,"_28559":55356,"_3075":55685},[],"Lamassu resource",{"_3699":1491,"_31384":1374,"_21647":55687,"_5":14929,"_28559":55356,"_3075":55688},[],"AWS Resource",{"_3699":1492,"_31384":1374,"_21647":55690,"_5":14929,"_28559":55356,"_3075":55691},[],"IAM actions",{"_3699":1493,"_31384":1374,"_21647":55693,"_5":14929,"_28559":55356,"_3075":55694},[],"AWS calls and effect",{"_3699":1494,"_31384":1374,"_21647":55696,"_5":14929,"_28559":55356,"_3075":55697},[],"Where in this page",{"_3699":1495,"_31384":1374,"_21647":55699,"_5":14929,"_28559":55356,"_3075":55700},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3699":1496,"_31384":1374,"_21647":55702,"_5":14929,"_28559":55356,"_3075":55703},[],"CA",{"_3699":1497,"_31384":1374,"_21647":55705,"_5":14929,"_28559":55356,"_3075":55706},[],"`IoTCore/CACertificate`",{"_3699":1498,"_31384":1374,"_21647":55708,"_5":14929,"_28559":55356,"_3075":55709},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3699":1499,"_31384":1374,"_21647":55711,"_5":14929,"_28559":55356,"_3075":55712},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3699":1500,"_31384":1374,"_21647":55714,"_5":14929,"_28559":55356,"_3075":55369},[],{"_3699":1501,"_31384":1374,"_21647":55716,"_5":14929,"_28559":55356,"_3075":55717},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3699":1502,"_31384":1374,"_21647":55719,"_5":14929,"_28559":55356,"_3075":55720},[],"DMS",{"_3699":1503,"_31384":1374,"_21647":55722,"_5":14929,"_28559":55356,"_3075":55723},[],"`IoTCore/ProvisioningTemplate`",{"_3699":1504,"_31384":1374,"_21647":55725,"_5":14929,"_28559":55356,"_3075":55726},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3699":1505,"_31384":1374,"_21647":55728,"_5":14929,"_28559":55356,"_3075":55729},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3699":1506,"_31384":1374,"_21647":55731,"_5":14929,"_28559":55356,"_3075":55397},[],{"_3699":1507,"_31384":1374,"_21647":55733,"_5":14929,"_28559":55356,"_3075":55734},[],"`EventBindDeviceIdentityKey`",{"_3699":1508,"_31384":1374,"_21647":55736,"_5":14929,"_28559":55356,"_3075":55737},[],"Device",{"_3699":1509,"_31384":1374,"_21647":55739,"_5":14929,"_28559":55356,"_3075":55740},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3699":1510,"_31384":1374,"_21647":55742,"_5":14929,"_28559":55356,"_3075":55743},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3699":1511,"_31384":1374,"_21647":55745,"_5":14929,"_28559":55356,"_3075":55746},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3699":1512,"_31384":1374,"_21647":55748,"_5":14929,"_28559":55356,"_3075":55405},[],{"_3699":1513,"_31384":1374,"_21647":55750,"_5":14929,"_28559":55356,"_3075":55751},[],"`EventUpdateCertificateStatusKey`",{"_3699":1514,"_31384":1374,"_21647":55753,"_5":14929,"_28559":55356,"_3075":55754},[],"Certificate",{"_3699":1515,"_31384":1374,"_21647":55756,"_5":14929,"_28559":55356,"_3075":55757},[],"`IoTCore/Certificate`",{"_3699":1516,"_31384":1374,"_21647":55759,"_5":14929,"_28559":55356,"_3075":55760},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3699":1517,"_31384":1374,"_21647":55762,"_5":14929,"_28559":55356,"_3075":55763},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3699":1518,"_31384":1374,"_21647":55765,"_5":14929,"_28559":55356,"_3075":55417},[],{"_3699":1519,"_31384":1374,"_21647":55767,"_5":14929,"_28559":55356,"_3075":55768},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3699":1520,"_31384":1374,"_21647":55770,"_5":14929,"_28559":55356,"_3075":55771},[],"Certificate / Device",{"_3699":1521,"_31384":1374,"_21647":55773,"_5":14929,"_28559":55356,"_3075":55774},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3699":1522,"_31384":1374,"_21647":55776,"_5":14929,"_28559":55356,"_3075":51490},[],{"_3699":1523,"_31384":1374,"_21647":55778,"_5":14929,"_28559":55356,"_3075":55779},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3699":1524,"_31384":1374,"_21647":55781,"_5":14929,"_28559":55356,"_3075":55425},[],{"_3699":1525,"_31384":1374,"_21647":55783,"_5":14929,"_28559":55360,"_3075":55784},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3699":1526,"_31384":1374,"_21647":55786,"_5":14929,"_28559":55364,"_3075":55787},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3699":1527,"_31384":1374,"_21647":55789,"_5":14929,"_28559":55364,"_3075":55790},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3699":1528,"_31384":1374,"_21647":55792,"_5":14929,"_28559":55368,"_3075":55793},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3699":1529,"_31384":1374,"_21647":55795,"_5":14929,"_28559":55368,"_3075":55796},[],"Transition",{"_3699":1530,"_31384":1374,"_21647":55798,"_5":14929,"_28559":55368,"_3075":55799},[],"AWS calls",{"_3699":1531,"_31384":1374,"_21647":55801,"_5":14929,"_28559":55368,"_3075":55802},[],"`NotRegistered` → `Requested`",{"_3699":1532,"_31384":1374,"_21647":55804,"_5":14929,"_28559":55368,"_3075":55805},[],"none (metadata write only)",{"_3699":1533,"_31384":1374,"_21647":55807,"_5":14929,"_28559":55368,"_3075":55808},[],"`Requested` → `Registering`",{"_3699":1534,"_31384":1374,"_21647":55810,"_5":14929,"_28559":55368,"_3075":55811},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3699":1535,"_31384":1374,"_21647":55813,"_5":14929,"_28559":55368,"_3075":55814},[],"`Registering` → `Succeeded`",{"_3699":1536,"_31384":1374,"_21647":55816,"_5":14929,"_28559":55368,"_3075":55817},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3699":1537,"_31384":1374,"_21647":55819,"_5":14929,"_28559":55368,"_3075":55820},[],"`Registering` → `Failed`",{"_3699":1538,"_31384":1374,"_21647":55822,"_5":14929,"_28559":55368,"_3075":55823},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3699":1539,"_31384":1374,"_21647":55825,"_5":14929,"_28559":55368,"_3075":55826},[],"`Failed` / `Succeeded` → `Requested`",{"_3699":1540,"_31384":1374,"_21647":55828,"_5":14929,"_28559":55368,"_3075":55829},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3699":1541,"_31384":1374,"_21647":55831,"_5":14929,"_28559":55372,"_3075":55832},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3699":1542,"_31384":1374,"_21647":55834,"_5":14929,"_28559":55372,"_3075":55835},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3699":1543,"_31384":1374,"_21647":55837,"_5":14929,"_28559":55372,"_3075":55838},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3699":1544,"_31384":1374,"_21647":55840,"_5":14929,"_28559":55372,"_3075":55841},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3699":1545,"_31384":1374,"_21647":55843,"_5":14929,"_28559":55372,"_3075":55844},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3699":1546,"_31384":1374,"_21647":55846,"_5":14929,"_28559":55372,"_3075":55847},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3699":1547,"_31384":1374,"_21647":55849,"_5":14929,"_28559":55376,"_3075":55850},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3699":1548,"_31384":1374,"_21647":55852,"_5":14929,"_28559":55380,"_3075":55853},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3699":1549,"_31384":1374,"_21647":55855,"_5":14929,"_28559":55380,"_3075":55856},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3699":1550,"_31384":1374,"_21647":55858,"_5":14929,"_28559":55384,"_3075":55859},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3699":1551,"_31384":1374,"_21647":55861,"_5":14929,"_28559":55388,"_3075":55862},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3699":1552,"_31384":1374,"_21647":55864,"_5":14929,"_28559":55388,"_3075":55865},[],"Creates or updates the IoT policies configured in the DMS.",{"_3699":1553,"_31384":1374,"_21647":55867,"_5":14929,"_28559":55388,"_3075":55868},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3699":1554,"_31384":1374,"_21647":55870,"_5":14929,"_28559":55388,"_3075":55871},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3699":1555,"_31384":1374,"_21647":55873,"_5":14929,"_28559":55388,"_3075":55874},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3699":1556,"_31384":1374,"_21647":55876,"_5":14929,"_28559":55388,"_3075":55877},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3699":1557,"_31384":1374,"_21647":55879,"_5":14929,"_28559":55388,"_3075":55880},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3699":1558,"_31384":1374,"_21647":55882,"_5":14929,"_28559":55392,"_3075":55883},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3699":1559,"_31384":1374,"_21647":55885,"_5":14929,"_28559":55392,"_3075":55886},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3699":1560,"_31384":1374,"_21647":55888,"_5":14929,"_28559":55392,"_3075":55889},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3699":1561,"_31384":1374,"_21647":55891,"_5":14929,"_28559":55392,"_3075":55892},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3699":1562,"_31384":1374,"_21647":55894,"_5":14929,"_28559":55392,"_3075":55895},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3699":1563,"_31384":1374,"_21647":55897,"_5":14929,"_28559":55396,"_3075":55898},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3699":1564,"_31384":1374,"_21647":55900,"_5":14929,"_28559":55396,"_3075":55796},[],{"_3699":1565,"_31384":1374,"_21647":55902,"_5":14929,"_28559":55396,"_3075":55799},[],{"_3699":1566,"_31384":1374,"_21647":55904,"_5":14929,"_28559":55396,"_3075":55905},[],"`Unconfigured` → `None` / `Auto`",{"_3699":1567,"_31384":1374,"_21647":55907,"_5":14929,"_28559":55396,"_3075":55908},[],"none (configuration only)",{"_3699":1568,"_31384":1374,"_21647":55910,"_5":14929,"_28559":55396,"_3075":55911},[],"`None` ↔ `Auto`",{"_3699":1569,"_31384":1374,"_21647":55913,"_5":14929,"_28559":55396,"_3075":55908},[],{"_3699":1570,"_31384":1374,"_21647":55915,"_5":14929,"_28559":55396,"_3075":55916},[],"Any → `Jitp`",{"_3699":1571,"_31384":1374,"_21647":55918,"_5":14929,"_28559":55396,"_3075":55919},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3699":1572,"_31384":1374,"_21647":55921,"_5":14929,"_28559":55396,"_3075":55922},[],"`Jitp` → `None` / `Auto`",{"_3699":1573,"_31384":1374,"_21647":55924,"_5":14929,"_28559":55396,"_3075":55925},[],"none (the template stays in the AWS account)",{"_3699":1574,"_31384":1374,"_21647":55927,"_5":14929,"_28559":55400,"_3075":55928},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3699":1575,"_31384":1374,"_21647":55930,"_5":14929,"_28559":55400,"_3075":55931},[],"The full flow from the device's perspective is:",{"_3699":1576,"_31384":1374,"_21647":55933,"_5":14929,"_28559":55400,"_3075":55934},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3699":1577,"_31384":1374,"_21647":55936,"_5":14929,"_28559":55404,"_3075":55937},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3699":1578,"_31384":1374,"_21647":55939,"_5":14929,"_28559":55404,"_3075":55796},[],{"_3699":1579,"_31384":1374,"_21647":55941,"_5":14929,"_28559":55404,"_3075":55799},[],{"_3699":1580,"_31384":1374,"_21647":55943,"_5":14929,"_28559":55404,"_3075":55944},[],"`Absent` → `Provisioned`",{"_3699":1581,"_31384":1374,"_21647":55946,"_5":14929,"_28559":55404,"_3075":55947},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3699":1582,"_31384":1374,"_21647":55949,"_5":14929,"_28559":55404,"_3075":55950},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3699":1583,"_31384":1374,"_21647":55952,"_5":14929,"_28559":55404,"_3075":55953},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3699":1584,"_31384":1374,"_21647":55955,"_5":14929,"_28559":55404,"_3075":55956},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3699":1585,"_31384":1374,"_21647":55958,"_5":14929,"_28559":55408,"_3075":55959},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3699":1586,"_31384":1374,"_21647":55961,"_5":14929,"_28559":55408,"_3075":55962},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3699":1587,"_31384":1374,"_21647":55964,"_5":14929,"_28559":55408,"_3075":55965},[],"For the JITP flow to work correctly:",{"_3699":1588,"_31384":1374,"_21647":55967,"_5":14929,"_28559":55408,"_3075":55968},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3699":1589,"_31384":1374,"_21647":55970,"_5":14929,"_28559":55408,"_3075":55971},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3699":1590,"_31384":1374,"_21647":55973,"_5":14929,"_28559":55408,"_3075":55974},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3699":1591,"_31384":1374,"_21647":55976,"_5":14929,"_28559":55408,"_3075":55977},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3699":1592,"_31384":1374,"_21647":55979,"_5":14929,"_28559":55412,"_3075":55980},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3699":1593,"_31384":1374,"_21647":55982,"_5":14929,"_28559":55412,"_3075":55983},[],"Status in Lamassu",{"_3699":1594,"_31384":1374,"_21647":55985,"_5":14929,"_28559":55412,"_3075":55986},[],"Revocation reason",{"_3699":1595,"_31384":1374,"_21647":55988,"_5":14929,"_28559":55412,"_3075":55989},[],"Status in AWS IoT Core",{"_3699":1596,"_31384":1374,"_21647":55991,"_5":14929,"_28559":55412,"_3075":55992},[],"`Active`",{"_3699":1597,"_31384":1374,"_21647":55994,"_5":14929,"_28559":55412,"_3075":55995},[],"None",{"_3699":1598,"_31384":1374,"_21647":55997,"_5":14929,"_28559":55412,"_3075":55998},[],"`ACTIVE`",{"_3699":1599,"_31384":1374,"_21647":56000,"_5":14929,"_28559":55412,"_3075":56001},[],"`Revoked`",{"_3699":1600,"_31384":1374,"_21647":56003,"_5":14929,"_28559":55412,"_3075":56004},[],"`certificateHold`",{"_3699":1601,"_31384":1374,"_21647":56006,"_5":14929,"_28559":55412,"_3075":56007},[],"`INACTIVE`",{"_3699":1602,"_31384":1374,"_21647":56009,"_5":14929,"_28559":55412,"_3075":56001},[],{"_3699":1603,"_31384":1374,"_21647":56011,"_5":14929,"_28559":55412,"_3075":56012},[],"Any other reason",{"_3699":1604,"_31384":1374,"_21647":56014,"_5":14929,"_28559":55412,"_3075":56015},[],"`REVOKED`",{"_3699":1605,"_31384":1374,"_21647":56017,"_5":14929,"_28559":55412,"_3075":56018},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3699":1606,"_31384":1374,"_21647":56020,"_5":14929,"_28559":55416,"_3075":56021},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3699":1607,"_31384":1374,"_21647":56023,"_5":14929,"_28559":55416,"_3075":55796},[],{"_3699":1608,"_31384":1374,"_21647":56025,"_5":14929,"_28559":55416,"_3075":55799},[],{"_3699":1609,"_31384":1374,"_21647":56027,"_5":14929,"_28559":55416,"_3075":56028},[],"`NotSynced` → `Active`",{"_3699":1610,"_31384":1374,"_21647":56030,"_5":14929,"_28559":55416,"_3075":55508},[],{"_3699":1611,"_31384":1374,"_21647":56032,"_5":14929,"_28559":55416,"_3075":56033},[],"`Active` → `Inactive`",{"_3699":1612,"_31384":1374,"_21647":56035,"_5":14929,"_28559":55416,"_3075":56036},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3699":1613,"_31384":1374,"_21647":56038,"_5":14929,"_28559":55416,"_3075":56039},[],"`Active` → `Revoked`",{"_3699":1614,"_31384":1374,"_21647":56041,"_5":14929,"_28559":55416,"_3075":56036},[],{"_3699":1615,"_31384":1374,"_21647":56043,"_5":14929,"_28559":55416,"_3075":56044},[],"`Inactive` / `Revoked` → `Active`",{"_3699":1616,"_31384":1374,"_21647":56046,"_5":14929,"_28559":55416,"_3075":55508},[],{"_3699":1617,"_31384":1374,"_21647":56048,"_5":14929,"_28559":55416,"_3075":56049},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3699":1618,"_31384":1374,"_21647":56051,"_5":14929,"_28559":55416,"_3075":56052},[],"none (these states are not synced to AWS)",{"_3699":1619,"_31384":1374,"_21647":56054,"_5":14929,"_28559":55420,"_3075":56055},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3699":1620,"_31384":1374,"_21647":56057,"_5":14929,"_28559":55420,"_3075":56058},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3699":1621,"_31384":1374,"_21647":56060,"_5":14929,"_28559":55420,"_3075":56061},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3699":1622,"_31384":1374,"_21647":56063,"_5":14929,"_28559":55424,"_3075":56064},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3699":1623,"_31384":1374,"_21647":56066,"_5":14929,"_28559":55424,"_3075":56067},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3699":1624,"_31384":1374,"_21647":56069,"_5":14929,"_28559":55428,"_3075":56070},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3699":1625,"_31384":1374,"_21647":56072,"_5":14929,"_28559":55428,"_3075":56073},[],"There are two action types:",{"_3699":1626,"_31384":1374,"_21647":56075,"_5":14929,"_28559":55428,"_3075":56076},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3699":1627,"_31384":1374,"_21647":56078,"_5":14929,"_28559":55428,"_3075":56079},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3699":1628,"_31384":1374,"_21647":56081,"_5":14929,"_28559":55428,"_3075":56082},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3699":1629,"_31384":1374,"_21647":56084,"_5":14929,"_28559":55432,"_3075":56085},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3699":1630,"_31384":1374,"_21647":56087,"_5":14929,"_28559":55432,"_3075":56088},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3699":1631,"_31384":1374,"_21647":56090,"_5":14929,"_28559":55432,"_3075":56091},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3699":1632,"_31384":1374,"_21647":56093,"_5":14929,"_28559":55436,"_3075":56094},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3699":1633,"_31384":1374,"_21647":56096,"_5":14929,"_28559":55436,"_3075":56097},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3699":1634,"_31384":1374,"_21647":56099,"_5":14929,"_28559":55436,"_3075":56100},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3699":1635,"_31384":1374,"_21647":56102,"_5":14929,"_28559":55436,"_3075":56103},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3699":1636,"_31384":1374,"_21647":56105,"_5":14929,"_28559":55436,"_3075":56106},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3699":1637,"_31384":1374,"_21647":56108,"_5":14929,"_28559":55436,"_3075":56109},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3699":1638,"_31384":1374,"_21647":56111,"_5":14929,"_28559":55436,"_3075":56112},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3699":1639,"_31384":1374,"_21647":56114,"_5":14929,"_28559":55436,"_3075":56115},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3699":1640,"_31384":1374,"_21647":56117,"_5":14929,"_28559":55436,"_3075":56118},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3699":1641,"_31384":1374,"_21647":56120,"_5":14929,"_28559":55436,"_3075":56121},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3699":1642,"_31384":1374,"_21647":56123,"_5":14929,"_28559":55436,"_3075":56124},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3699":1643,"_31384":1374,"_21647":56126,"_5":14929,"_28559":55436,"_3075":56127},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3699":1644,"_31384":1374,"_21647":56129,"_5":14929,"_28559":55436,"_3075":56130},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3699":1645,"_31384":1374,"_21647":56132,"_5":14929,"_28559":55436,"_3075":56133},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3699":1646,"_31384":1374,"_21647":56135,"_5":14929,"_28559":55436,"_3075":56136},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3699":1647,"_31384":1374,"_21647":56138,"_5":14929,"_28559":55436,"_3075":56139},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3699":1648,"_31384":1374,"_21647":56141,"_5":14929,"_28559":55436,"_3075":56142},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3699":1649,"_31384":1374,"_21647":56144,"_5":14929,"_28559":55436,"_3075":56145},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3699":1650,"_31384":1374,"_21647":56147,"_5":14929,"_28559":55436,"_3075":56148},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3699":1651,"_31384":1374,"_21647":56150,"_5":14929,"_28559":55436,"_3075":56151},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3699":1652,"_31384":1374,"_21647":56153,"_5":14929,"_28559":55436,"_3075":56154},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3699":1653,"_31384":1374,"_21647":56156,"_5":14929,"_28559":55436,"_3075":56157},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3699":1654,"_31384":1374,"_21647":56159,"_5":14929,"_28559":55436,"_3075":56160},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/est\" />",{"_3699":1655,"_31384":1374,"_21647":56162,"_5":14929,"_28559":55436,"_3075":56163},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3699":1656,"_31384":1656,"_5":15283,"_3075":53807,"_31709":56165,"_21647":56166,"_28559":1656},[51094,52635,53807],[],{"_3699":1657,"_31384":1656,"_21647":56168,"_5":14929,"_28559":1656,"_3075":56169},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3699":1658,"_31384":1656,"_5":31706,"_21647":56171,"_28559":56172,"_3075":56173},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3699":1659,"_31384":1656,"_5":31706,"_21647":56175,"_28559":56176,"_3075":53805},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3699":1660,"_31384":1656,"_5":31706,"_21647":56178,"_28559":56179,"_3075":54004},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3699":1661,"_31384":1656,"_5":31706,"_21647":56181,"_28559":56182,"_3075":55333},[],"/docs/platform/iot-fleets/overview#integrations",{"_3699":1662,"_31384":1656,"_5":31706,"_21647":56184,"_28559":56185,"_3075":56186},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3699":1663,"_31384":1656,"_21647":56188,"_5":14929,"_28559":1656,"_3075":56189},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3699":1664,"_31384":1656,"_21647":56191,"_5":14929,"_28559":56172,"_3075":56192},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3699":1665,"_31384":1656,"_21647":56194,"_5":14929,"_28559":56172,"_3075":56195},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3699":1666,"_31384":1656,"_21647":56197,"_5":14929,"_28559":56176,"_3075":56198},[],"Resource",{"_3699":1667,"_31384":1656,"_21647":56200,"_5":14929,"_28559":56176,"_3075":56201},[],"What it represents",{"_3699":1668,"_31384":1656,"_21647":56203,"_5":14929,"_28559":56176,"_3075":56204},[],"**Device**",{"_3699":1669,"_31384":1656,"_21647":56206,"_5":14929,"_28559":56176,"_3075":56207},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3699":1670,"_31384":1656,"_21647":56209,"_5":14929,"_28559":56176,"_3075":56210},[],"**Identity**",{"_3699":1671,"_31384":1656,"_21647":56212,"_5":14929,"_28559":56176,"_3075":56213},[],"The device's association with its certificates: an active version and a history.",{"_3699":1672,"_31384":1656,"_21647":56215,"_5":14929,"_28559":56176,"_3075":56216},[],"**DMS**",{"_3699":1673,"_31384":1656,"_21647":56218,"_5":14929,"_28559":56176,"_3075":56219},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3699":1674,"_31384":1656,"_21647":56221,"_5":14929,"_28559":56176,"_3075":56222},[],"**Fleet**",{"_3699":1675,"_31384":1656,"_21647":56224,"_5":14929,"_28559":56176,"_3075":56225},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3699":1676,"_31384":1656,"_21647":56227,"_5":14929,"_28559":56176,"_3075":56228},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3699":1677,"_31384":1656,"_21647":56230,"_5":14929,"_28559":56176,"_3075":56231},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3699":1678,"_31384":1656,"_21647":56233,"_5":14929,"_28559":56179,"_3075":56234},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3699":1679,"_31384":1656,"_21647":56236,"_5":14929,"_28559":56179,"_3075":56237},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3699":1680,"_31384":1656,"_21647":56239,"_5":14929,"_28559":56179,"_3075":56240},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3699":1681,"_31384":1656,"_21647":56242,"_5":14929,"_28559":56179,"_3075":56243},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3699":1682,"_31384":1656,"_21647":56245,"_5":14929,"_28559":56179,"_3075":56246},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3699":1683,"_31384":1656,"_21647":56248,"_5":14929,"_28559":56179,"_3075":56249},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3699":1684,"_31384":1656,"_21647":56251,"_5":14929,"_28559":56179,"_3075":56252},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3699":1685,"_31384":1656,"_21647":56254,"_5":14929,"_28559":56179,"_3075":56255},[],"<Card title=\"EST (RFC 7030)\" description=\"Find the guides for authentication, client integration and renewal.\" href=\"/docs/platform/iot-fleets/est\" />",{"_3699":1686,"_31384":1656,"_21647":56257,"_5":14929,"_28559":56182,"_3075":56258},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3699":1687,"_31384":1656,"_21647":56260,"_5":14929,"_28559":56182,"_3075":56261},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3699":1688,"_31384":1656,"_21647":56263,"_5":14929,"_28559":56185,"_3075":56264},[],"Participant",{"_3699":1689,"_31384":1656,"_21647":56266,"_5":14929,"_28559":56185,"_3075":56267},[],"Responsibility",{"_3699":1690,"_31384":1656,"_21647":56269,"_5":14929,"_28559":56185,"_3075":56270},[],"PKI administrator",{"_3699":1691,"_31384":1656,"_21647":56272,"_5":14929,"_28559":56185,"_3075":56273},[],"CA, issuance profile, chain and revocation publication.",{"_3699":1692,"_31384":1656,"_21647":56275,"_5":14929,"_28559":56185,"_3075":56276},[],"Provisioning administrator",{"_3699":1693,"_31384":1656,"_21647":56278,"_5":14929,"_28559":56185,"_3075":56279},[],"DMS, admission, authentication per operation and inventory.",{"_3699":1694,"_31384":1656,"_21647":56281,"_5":14929,"_28559":56185,"_3075":56282},[],"Device integrator",{"_3699":1695,"_31384":1656,"_21647":56284,"_5":14929,"_28559":56185,"_3075":56285},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3699":1696,"_31384":1656,"_21647":56287,"_5":14929,"_28559":56185,"_3075":56288},[],"Consumer integrator",{"_3699":1697,"_31384":1656,"_21647":56290,"_5":14929,"_28559":56185,"_3075":56291},[],"Trusted issuers, validation and device permissions in the destination.",{"_3699":1698,"_31384":1656,"_21647":56293,"_5":14929,"_28559":56185,"_3075":56294},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3699":1699,"_31384":1699,"_5":15283,"_3075":56296,"_31709":56297,"_21647":56299,"_28559":1699},"Enroll and connect your first device",[51094,52635,53807,56298],"Getting started",[],{"_3699":1700,"_31384":1699,"_21647":56301,"_5":14929,"_28559":1699,"_3075":56302},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3699":1701,"_31384":1699,"_5":31706,"_21647":56304,"_28559":56305,"_3075":51104},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3699":1702,"_31384":1699,"_5":31706,"_21647":56307,"_28559":56308,"_3075":56309},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3699":1703,"_31384":1699,"_5":31706,"_21647":56311,"_28559":56312,"_3075":56313},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3699":1704,"_31384":1699,"_5":31706,"_21647":56315,"_28559":56316,"_3075":56317},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3699":1705,"_31384":1699,"_5":31706,"_21647":56319,"_28559":56320,"_3075":56321},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3699":1706,"_31384":1699,"_5":31706,"_21647":56323,"_28559":56324,"_3075":56325},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3699":1707,"_31384":1699,"_5":31706,"_21647":56327,"_28559":56328,"_3075":56329},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3699":1708,"_31384":1699,"_5":31706,"_21647":56331,"_28559":56332,"_3075":56333},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3699":1709,"_31384":1699,"_21647":56335,"_5":14929,"_28559":1699,"_3075":56336},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3699":1710,"_31384":1699,"_21647":56338,"_5":14929,"_28559":56305,"_3075":56339},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3699":1711,"_31384":1699,"_21647":56341,"_5":14929,"_28559":56305,"_3075":56342},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3699":1712,"_31384":1699,"_21647":56344,"_5":14929,"_28559":56305,"_3075":56345},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3699":1713,"_31384":1699,"_21647":56347,"_5":14929,"_28559":56305,"_3075":56348},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3699":1714,"_31384":1699,"_21647":56350,"_5":14929,"_28559":56305,"_3075":56351},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3699":1715,"_31384":1699,"_21647":56353,"_5":14929,"_28559":56308,"_3075":56354},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3699":1716,"_31384":1699,"_21647":56356,"_5":14929,"_28559":56308,"_3075":56357},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3699":1717,"_31384":1699,"_21647":56359,"_5":14929,"_28559":56312,"_3075":56360},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3699":1718,"_31384":1699,"_21647":56362,"_5":14929,"_28559":56312,"_3075":56363},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3699":1719,"_31384":1699,"_21647":56365,"_5":14929,"_28559":56312,"_3075":56366},[],"Setting",{"_3699":1720,"_31384":1699,"_21647":56368,"_5":14929,"_28559":56312,"_3075":56369},[],"Evaluation value",{"_3699":1721,"_31384":1699,"_21647":56371,"_5":14929,"_28559":56312,"_3075":56372},[],"Enrollment CA",{"_3699":1722,"_31384":1699,"_21647":56374,"_5":14929,"_28559":56312,"_3075":56375},[],"Issuing root from `device-root.pem`.",{"_3699":1723,"_31384":1699,"_21647":56377,"_5":14929,"_28559":56312,"_3075":56378},[],"Issuance profile",{"_3699":1724,"_31384":1699,"_21647":56380,"_5":14929,"_28559":56312,"_3075":56381},[],"The 1-hour leaf profile you just prepared.",{"_3699":1725,"_31384":1699,"_21647":56383,"_5":14929,"_28559":56312,"_3075":56384},[],"Protocol / Registration Mode",{"_3699":1726,"_31384":1699,"_21647":56386,"_5":14929,"_28559":56312,"_3075":56387},[],"`EST_RFC7030` / `JITP`.",{"_3699":1727,"_31384":1699,"_21647":56389,"_5":14929,"_28559":56312,"_3075":56390},[],"Verify CSR Signature",{"_3699":1728,"_31384":1699,"_21647":56392,"_5":14929,"_28559":56312,"_3075":56393},[],"Enabled.",{"_3699":1729,"_31384":1699,"_21647":56395,"_5":14929,"_28559":56312,"_3075":56396},[],"Enable Replaceable Enrollment",{"_3699":1730,"_31384":1699,"_21647":56398,"_5":14929,"_28559":56312,"_3075":56399},[],"Disabled; the ID must be new.",{"_3699":1731,"_31384":1699,"_21647":56401,"_5":14929,"_28559":56312,"_3075":56402},[],"Initial authentication",{"_3699":1732,"_31384":1699,"_21647":56404,"_5":14929,"_28559":56312,"_3075":56405},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3699":1733,"_31384":1699,"_21647":56407,"_5":14929,"_28559":56312,"_3075":56408},[],"Renewal authentication",{"_3699":1734,"_31384":1699,"_21647":56410,"_5":14929,"_28559":56312,"_3075":56411},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3699":1735,"_31384":1699,"_21647":56413,"_5":14929,"_28559":56312,"_3075":56414},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3699":1736,"_31384":1699,"_21647":56416,"_5":14929,"_28559":56312,"_3075":56417},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3699":1737,"_31384":1699,"_21647":56419,"_5":14929,"_28559":56312,"_3075":56420},[],"Re-enrollment Delta",{"_3699":1738,"_31384":1699,"_21647":56422,"_5":14929,"_28559":56312,"_3075":56423},[],"1 hour.",{"_3699":1739,"_31384":1699,"_21647":56425,"_5":14929,"_28559":56312,"_3075":56426},[],"Preventive / Critical Delta",{"_3699":1740,"_31384":1699,"_21647":56428,"_5":14929,"_28559":56312,"_3075":56429},[],"30 minutes / 10 minutes.",{"_3699":1741,"_31384":1699,"_21647":56431,"_5":14929,"_28559":56312,"_3075":56432},[],"Revoke on Re-enrollment",{"_3699":1742,"_31384":1699,"_21647":56434,"_5":14929,"_28559":56312,"_3075":56435},[],"Disabled to test the successor before retiring the previous identity.",{"_3699":1743,"_31384":1699,"_21647":56437,"_5":14929,"_28559":56312,"_3075":54256},[],{"_3699":1744,"_31384":1699,"_21647":56439,"_5":14929,"_28559":56312,"_3075":56440},[],"Disabled; the operational key is generated in the client.",{"_3699":1745,"_31384":1699,"_21647":56442,"_5":14929,"_28559":56312,"_3075":56443},[],"CA Distribution",{"_3699":1746,"_31384":1699,"_21647":56445,"_5":14929,"_28559":56312,"_3075":56446},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3699":1747,"_31384":1699,"_21647":56448,"_5":14929,"_28559":56312,"_3075":56449},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3699":1748,"_31384":1699,"_21647":56451,"_5":14929,"_28559":56316,"_3075":56452},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3699":1749,"_31384":1699,"_21647":56454,"_5":14929,"_28559":56316,"_3075":56455},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3699":1750,"_31384":1699,"_21647":56457,"_5":14929,"_28559":56320,"_3075":56458},[],"Generate a new key and CSR with the selected identifier:",{"_3699":1751,"_31384":1699,"_21647":56460,"_5":14929,"_28559":56320,"_3075":56461},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3699":1752,"_31384":1699,"_21647":56463,"_5":14929,"_28559":56320,"_3075":56464},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3699":1753,"_31384":1699,"_21647":56466,"_5":14929,"_28559":56324,"_3075":56467},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3699":1754,"_31384":1699,"_21647":56469,"_5":14929,"_28559":56324,"_3075":56470},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3699":1755,"_31384":1699,"_21647":56472,"_5":14929,"_28559":56328,"_3075":56473},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3699":1756,"_31384":1699,"_21647":56475,"_5":14929,"_28559":56328,"_3075":56476},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3699":1757,"_31384":1699,"_21647":56478,"_5":14929,"_28559":56328,"_3075":56479},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3699":1758,"_31384":1699,"_21647":56481,"_5":14929,"_28559":56328,"_3075":56482},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3699":1759,"_31384":1699,"_21647":56484,"_5":14929,"_28559":56328,"_3075":56485},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3699":1760,"_31384":1699,"_21647":56487,"_5":14929,"_28559":56332,"_3075":56488},[],"Check",{"_3699":1761,"_31384":1699,"_21647":56490,"_5":14929,"_28559":56332,"_3075":56491},[],"Expected result",{"_3699":1762,"_31384":1699,"_21647":56493,"_5":14929,"_28559":56332,"_3075":56494},[],"Registration",{"_3699":1763,"_31384":1699,"_21647":56496,"_5":14929,"_28559":56332,"_3075":56497},[],"ID created automatically and correct DMS.",{"_3699":1764,"_31384":1699,"_21647":56499,"_5":14929,"_28559":56332,"_3075":55754},[],{"_3699":1765,"_31384":1699,"_21647":56501,"_5":14929,"_28559":56332,"_3075":56502},[],"CN, profile, serial and key verified.",{"_3699":1766,"_31384":1699,"_21647":56504,"_5":14929,"_28559":56332,"_3075":56505},[],"Inventory",{"_3699":1767,"_31384":1699,"_21647":56507,"_5":14929,"_28559":56332,"_3075":56508},[],"Received serial visible as the current identity and in history.",{"_3699":1768,"_31384":1699,"_21647":56510,"_5":14929,"_28559":56332,"_3075":56511},[],"Consumer",{"_3699":1769,"_31384":1699,"_21647":56513,"_5":14929,"_28559":56332,"_3075":56514},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3699":1770,"_31384":1699,"_21647":56516,"_5":14929,"_28559":56332,"_3075":56517},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3699":1771,"_31384":1699,"_21647":56519,"_5":14929,"_28559":56332,"_3075":56520},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3699":1772,"_31384":1772,"_5":15283,"_3075":53827,"_31709":56522,"_21647":56523,"_28559":1772},[51094,52635,53807,56298],[],{"_3699":1773,"_31384":1772,"_21647":56525,"_5":14929,"_28559":1772,"_3075":56526},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3699":1774,"_31384":1772,"_5":31706,"_21647":56528,"_28559":56529,"_3075":51104},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3699":1775,"_31384":1772,"_5":31706,"_21647":56531,"_28559":56532,"_3075":56533},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3699":1776,"_31384":1772,"_5":31706,"_21647":56535,"_28559":56536,"_3075":56537},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3699":1777,"_31384":1772,"_5":31706,"_21647":56539,"_28559":56540,"_3075":56541},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3699":1778,"_31384":1772,"_5":31706,"_21647":56543,"_28559":56544,"_3075":56545},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3699":1779,"_31384":1772,"_5":31706,"_21647":56547,"_28559":56548,"_3075":56549},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3699":1780,"_31384":1772,"_5":31706,"_21647":56551,"_28559":56552,"_3075":56491},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3699":1781,"_31384":1772,"_5":31706,"_21647":56554,"_28559":56555,"_3075":56556},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3699":1782,"_31384":1772,"_5":31706,"_21647":56558,"_28559":56559,"_3075":56560},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3699":1783,"_31384":1772,"_21647":56562,"_5":14929,"_28559":1772,"_3075":56563},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3699":1784,"_31384":1772,"_21647":56565,"_5":14929,"_28559":1772,"_3075":56566},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3699":1785,"_31384":1772,"_21647":56568,"_5":14929,"_28559":56529,"_3075":56569},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3699":1786,"_31384":1772,"_21647":56571,"_5":14929,"_28559":56529,"_3075":56572},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3699":1787,"_31384":1772,"_21647":56574,"_5":14929,"_28559":56529,"_3075":56575},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3699":1788,"_31384":1772,"_21647":56577,"_5":14929,"_28559":56529,"_3075":56578},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3699":1789,"_31384":1772,"_21647":56580,"_5":14929,"_28559":56532,"_3075":56581},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3699":1790,"_31384":1772,"_21647":56583,"_5":14929,"_28559":56532,"_3075":56584},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3699":1791,"_31384":1772,"_21647":56586,"_5":14929,"_28559":56532,"_3075":56587},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3699":1792,"_31384":1772,"_21647":56589,"_5":14929,"_28559":56532,"_3075":56590},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3699":1793,"_31384":1772,"_21647":56592,"_5":14929,"_28559":56532,"_3075":56593},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3699":1794,"_31384":1772,"_21647":56595,"_5":14929,"_28559":56532,"_3075":56596},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3699":1795,"_31384":1772,"_21647":56598,"_5":14929,"_28559":56532,"_3075":56599},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3699":1796,"_31384":1772,"_21647":56601,"_5":14929,"_28559":56532,"_3075":56602},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3699":1797,"_31384":1772,"_21647":56604,"_5":14929,"_28559":56536,"_3075":56605},[],"Open **Managed Devices** and the registration action. Complete:",{"_3699":1798,"_31384":1772,"_21647":56607,"_5":14929,"_28559":56536,"_3075":56608},[],"**Device ID**: `device-001`.",{"_3699":1799,"_31384":1772,"_21647":56610,"_5":14929,"_28559":56536,"_3075":56611},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3699":1800,"_31384":1772,"_21647":56613,"_5":14929,"_28559":56536,"_3075":56614},[],"**Icon** and **Tags**: optional classification.",{"_3699":1801,"_31384":1772,"_21647":56616,"_5":14929,"_28559":56536,"_3075":56617},[],"Confirm registration.",{"_3699":1802,"_31384":1772,"_21647":56619,"_5":14929,"_28559":56540,"_3075":56620},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3699":1803,"_31384":1772,"_21647":56622,"_5":14929,"_28559":56540,"_3075":56623},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3699":1804,"_31384":1772,"_21647":56625,"_5":14929,"_28559":56544,"_3075":56626},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3699":1805,"_31384":1772,"_21647":56628,"_5":14929,"_28559":56544,"_3075":56629},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3699":1806,"_31384":1772,"_21647":56631,"_5":14929,"_28559":56548,"_3075":56632},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3699":1807,"_31384":1772,"_21647":56634,"_5":14929,"_28559":56548,"_3075":56635},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3699":1808,"_31384":1772,"_21647":56637,"_5":14929,"_28559":56552,"_3075":56488},[],{"_3699":1809,"_31384":1772,"_21647":56639,"_5":14929,"_28559":56552,"_3075":56640},[],"Result",{"_3699":1810,"_31384":1772,"_21647":56642,"_5":14929,"_28559":56552,"_3075":55737},[],{"_3699":1811,"_31384":1772,"_21647":56644,"_5":14929,"_28559":56552,"_3075":56645},[],"`device-001` appears in inventory with the expected DMS.",{"_3699":1812,"_31384":1772,"_21647":56647,"_5":14929,"_28559":56552,"_3075":56648},[],"Current identity",{"_3699":1813,"_31384":1772,"_21647":56650,"_5":14929,"_28559":56552,"_3075":56651},[],"The associated certificate matches the one you verified in PKI.",{"_3699":1814,"_31384":1772,"_21647":56653,"_5":14929,"_28559":56552,"_3075":56654},[],"History",{"_3699":1815,"_31384":1772,"_21647":56656,"_5":14929,"_28559":56552,"_3075":56657},[],"The associated issuance appears with its serial number and dates.",{"_3699":1816,"_31384":1772,"_21647":56659,"_5":14929,"_28559":56552,"_3075":56660},[],"Key and certificate",{"_3699":1817,"_31384":1772,"_21647":56662,"_5":14929,"_28559":56552,"_3075":56663},[],"You have the verified pair ready to install on the device.",{"_3699":1818,"_31384":1772,"_21647":56665,"_5":14929,"_28559":56555,"_3075":56666},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3699":1819,"_31384":1772,"_21647":56668,"_5":14929,"_28559":56555,"_3075":56669},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3699":1820,"_31384":1772,"_21647":56671,"_5":14929,"_28559":56555,"_3075":56672},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3699":1821,"_31384":1772,"_21647":56674,"_5":14929,"_28559":56555,"_3075":56675},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3699":1822,"_31384":1772,"_21647":56677,"_5":14929,"_28559":56559,"_3075":56678},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3699":1823,"_31384":1772,"_21647":56680,"_5":14929,"_28559":56559,"_3075":56681},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3699":1824,"_31384":1772,"_21647":56683,"_5":14929,"_28559":56559,"_3075":56684},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3699":1825,"_31384":1825,"_5":15283,"_3075":56686,"_31709":56687,"_21647":56688,"_28559":1825},"Lamassu IoT Platform",[51094,52635],[],{"_3699":1826,"_31384":1825,"_21647":56690,"_5":14929,"_28559":1825,"_3075":56691},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3699":1827,"_31384":1825,"_5":31706,"_21647":56693,"_28559":56694,"_3075":56173},[],"/docs/platform/overview#start-here",{"_3699":1828,"_31384":1825,"_5":31706,"_21647":56696,"_28559":56697,"_3075":56698},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3699":1829,"_31384":1825,"_5":31706,"_21647":56700,"_28559":56701,"_3075":56702},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3699":1830,"_31384":1825,"_5":31706,"_21647":56704,"_28559":56705,"_3075":56706},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3699":1831,"_31384":1825,"_5":31706,"_21647":56708,"_28559":56709,"_3075":56710},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3699":1832,"_31384":1825,"_5":31706,"_21647":56712,"_28559":56713,"_3075":56714},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3699":1833,"_31384":1825,"_5":31706,"_21647":56716,"_28559":56717,"_3075":56718},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3699":1834,"_31384":1825,"_5":31706,"_21647":56720,"_28559":56721,"_3075":56722},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3699":1835,"_31384":1825,"_5":31706,"_21647":56724,"_28559":56725,"_3075":56726},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3699":1836,"_31384":1825,"_5":31706,"_21647":56728,"_28559":56729,"_3075":56730},[],"/docs/platform/overview#react-to-events","React to events",{"_3699":1837,"_31384":1825,"_5":31706,"_21647":56732,"_28559":56733,"_3075":56734},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3699":1838,"_31384":1825,"_21647":56736,"_5":14929,"_28559":1825,"_3075":56737},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3699":1839,"_31384":1825,"_21647":56739,"_5":14929,"_28559":56694,"_3075":56740},[],"Choose the result you need:",{"_3699":1840,"_31384":1825,"_21647":56742,"_5":14929,"_28559":56694,"_3075":56743},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3699":1841,"_31384":1825,"_21647":56745,"_5":14929,"_28559":56694,"_3075":56746},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3699":1842,"_31384":1825,"_21647":56748,"_5":14929,"_28559":56694,"_3075":56749},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3699":1843,"_31384":1825,"_21647":56751,"_5":14929,"_28559":56697,"_3075":56752},[],"Section",{"_3699":1844,"_31384":1825,"_21647":56754,"_5":14929,"_28559":56697,"_3075":56755},[],"What you manage",{"_3699":1845,"_31384":1825,"_21647":56757,"_5":14929,"_28559":56697,"_3075":56758},[],"Entry point",{"_3699":1846,"_31384":1825,"_21647":56760,"_5":14929,"_28559":56697,"_3075":56761},[],"**PKI**",{"_3699":1847,"_31384":1825,"_21647":56763,"_5":14929,"_28559":56697,"_3075":56764},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3699":1848,"_31384":1825,"_21647":56766,"_5":14929,"_28559":56697,"_3075":56767},[],"PKI overview",{"_3699":1849,"_31384":1825,"_21647":56769,"_5":14929,"_28559":56697,"_3075":56770},[],"**IoT Fleets**",{"_3699":1850,"_31384":1825,"_21647":56772,"_5":14929,"_28559":56697,"_3075":56773},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3699":1851,"_31384":1825,"_21647":56775,"_5":14929,"_28559":56697,"_3075":56776},[],"IoT Fleets overview",{"_3699":1852,"_31384":1825,"_21647":56778,"_5":14929,"_28559":56697,"_3075":56779},[],"**Administration**",{"_3699":1853,"_31384":1825,"_21647":56781,"_5":14929,"_28559":56697,"_3075":56782},[],"Operator permissions, audit and event subscriptions.",{"_3699":1854,"_31384":1825,"_21647":56784,"_5":14929,"_28559":56697,"_3075":52637},[],{"_3699":1855,"_31384":1825,"_21647":56786,"_5":14929,"_28559":56697,"_3075":56787},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3699":1856,"_31384":1825,"_21647":56789,"_5":14929,"_28559":56701,"_3075":56790},[],"An identity's journey connects four responsibilities:",{"_3699":1857,"_31384":1825,"_21647":56792,"_5":14929,"_28559":56701,"_3075":56793},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3699":1858,"_31384":1825,"_21647":56795,"_5":14929,"_28559":56701,"_3075":56796},[],"The provisioning administrator configures the DMS and initial trust.",{"_3699":1859,"_31384":1825,"_21647":56798,"_5":14929,"_28559":56701,"_3075":56799},[],"The device client requests a certificate and installs it with the matching key.",{"_3699":1860,"_31384":1825,"_21647":56801,"_5":14929,"_28559":56701,"_3075":56802},[],"The consumer validates the identity and applies its access permissions.",{"_3699":1861,"_31384":1825,"_21647":56804,"_5":14929,"_28559":56701,"_3075":56805},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3699":1862,"_31384":1825,"_21647":56807,"_5":14929,"_28559":56709,"_3075":56808},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3699":1863,"_31384":1825,"_21647":56810,"_5":14929,"_28559":56713,"_3075":56811},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3699":1864,"_31384":1825,"_21647":56813,"_5":14929,"_28559":56717,"_3075":56814},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3699":1865,"_31384":1825,"_21647":56816,"_5":14929,"_28559":56721,"_3075":56817},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3699":1866,"_31384":1825,"_21647":56819,"_5":14929,"_28559":56725,"_3075":56820},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3699":1867,"_31384":1825,"_21647":56822,"_5":14929,"_28559":56729,"_3075":56823},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3699":1868,"_31384":1825,"_21647":56825,"_5":14929,"_28559":56733,"_3075":56267},[],{"_3699":1869,"_31384":1825,"_21647":56827,"_5":14929,"_28559":56733,"_3075":56828},[],"What it prepares or checks",{"_3699":1870,"_31384":1825,"_21647":56830,"_5":14929,"_28559":56733,"_3075":56270},[],{"_3699":1871,"_31384":1825,"_21647":56832,"_5":14929,"_28559":56733,"_3075":56833},[],"Key custody, CA hierarchy, profiles and validation.",{"_3699":1872,"_31384":1825,"_21647":56835,"_5":14929,"_28559":56733,"_3075":56836},[],"Fleet administrator",{"_3699":1873,"_31384":1825,"_21647":56838,"_5":14929,"_28559":56733,"_3075":56839},[],"DMS, device admission, renewal policy and inventory.",{"_3699":1874,"_31384":1825,"_21647":56841,"_5":14929,"_28559":56733,"_3075":56282},[],{"_3699":1875,"_31384":1825,"_21647":56843,"_5":14929,"_28559":56733,"_3075":56844},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3699":1876,"_31384":1825,"_21647":56846,"_5":14929,"_28559":56733,"_3075":56288},[],{"_3699":1877,"_31384":1825,"_21647":56848,"_5":14929,"_28559":56733,"_3075":56849},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3699":1878,"_31384":1825,"_21647":56851,"_5":14929,"_28559":56733,"_3075":56852},[],"Infrastructure operator",{"_3699":1879,"_31384":1825,"_21647":56854,"_5":14929,"_28559":56733,"_3075":56855},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3699":1880,"_31384":1825,"_21647":56857,"_5":14929,"_28559":56733,"_3075":56858},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3699":1881,"_31384":1881,"_5":15283,"_3075":56860,"_31709":56861,"_21647":56864,"_28559":1881},"CA hierarchy and rotation",[51094,52635,56862,56863],"PKI","Keys, authorities and certificates",[],{"_3699":1882,"_31384":1881,"_21647":56866,"_5":14929,"_28559":1881,"_3075":56867},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3699":1883,"_31384":1881,"_5":31706,"_21647":56869,"_28559":56870,"_3075":56871},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3699":1884,"_31384":1881,"_5":31706,"_21647":56873,"_28559":56874,"_3075":56875},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3699":1885,"_31384":1881,"_5":31706,"_21647":56877,"_28559":56878,"_3075":56879},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3699":1886,"_31384":1881,"_5":31706,"_21647":56881,"_28559":56882,"_3075":56883},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3699":1887,"_31384":1881,"_5":31706,"_21647":56885,"_28559":56886,"_3075":56887},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3699":1888,"_31384":1881,"_5":31706,"_21647":56889,"_28559":56890,"_3075":56891},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3699":1889,"_31384":1881,"_5":31706,"_21647":56893,"_28559":56894,"_3075":56895},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3699":1890,"_31384":1881,"_5":31706,"_21647":56897,"_28559":56898,"_3075":56899},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3699":1891,"_31384":1881,"_5":31706,"_21647":56901,"_28559":56902,"_3075":56903},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3699":1892,"_31384":1881,"_5":31706,"_21647":56905,"_28559":56906,"_3075":56907},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3699":1893,"_31384":1881,"_5":31706,"_21647":56909,"_28559":56910,"_3075":56911},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3699":1894,"_31384":1881,"_5":31706,"_21647":56913,"_28559":56914,"_3075":56915},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3699":1895,"_31384":1881,"_21647":56917,"_5":14929,"_28559":1881,"_3075":56918},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3699":1896,"_31384":1881,"_21647":56920,"_5":14929,"_28559":1881,"_3075":56921},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3699":1897,"_31384":1881,"_21647":56923,"_5":14929,"_28559":56870,"_3075":56924},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3699":1898,"_31384":1881,"_21647":56926,"_5":14929,"_28559":56870,"_3075":56927},[],"environment, such as production and preproduction;",{"_3699":1899,"_31384":1881,"_21647":56929,"_5":14929,"_28559":56870,"_3075":56930},[],"owner or operating team;",{"_3699":1900,"_31384":1881,"_21647":56932,"_5":14929,"_28559":56870,"_3075":56933},[],"device family or manufacturing process;",{"_3699":1901,"_31384":1881,"_21647":56935,"_5":14929,"_28559":56870,"_3075":56936},[],"region or regulatory requirement;",{"_3699":1902,"_31384":1881,"_21647":56938,"_5":14929,"_28559":56870,"_3075":56939},[],"cryptographic engine or key policy;",{"_3699":1903,"_31384":1881,"_21647":56941,"_5":14929,"_28559":56870,"_3075":56942},[],"maintenance window and renewal cadence.",{"_3699":1904,"_31384":1881,"_21647":56944,"_5":14929,"_28559":56870,"_3075":56945},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3699":1905,"_31384":1881,"_21647":56947,"_5":14929,"_28559":56870,"_3075":56948},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3699":1906,"_31384":1881,"_21647":56950,"_5":14929,"_28559":56874,"_3075":56951},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3699":1907,"_31384":1881,"_21647":56953,"_5":14929,"_28559":56874,"_3075":56954},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3699":1908,"_31384":1881,"_21647":56956,"_5":14929,"_28559":56874,"_3075":56957},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3699":1909,"_31384":1881,"_21647":56959,"_5":14929,"_28559":56874,"_3075":56960},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3699":1910,"_31384":1881,"_21647":56962,"_5":14929,"_28559":56878,"_3075":56963},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3699":1911,"_31384":1881,"_21647":56965,"_5":14929,"_28559":56878,"_3075":56966},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3699":1912,"_31384":1881,"_21647":56968,"_5":14929,"_28559":56878,"_3075":56969},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3699":1913,"_31384":1881,"_21647":56971,"_5":14929,"_28559":56878,"_3075":56972},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3699":1914,"_31384":1881,"_21647":56974,"_5":14929,"_28559":56886,"_3075":56975},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3699":1915,"_31384":1881,"_21647":56977,"_5":14929,"_28559":56890,"_3075":56978},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3699":1916,"_31384":1881,"_21647":56980,"_5":14929,"_28559":56894,"_3075":56981},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3699":1917,"_31384":1881,"_21647":56983,"_5":14929,"_28559":56898,"_3075":56984},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3699":1918,"_31384":1881,"_21647":56986,"_5":14929,"_28559":56902,"_3075":56987},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3699":1919,"_31384":1881,"_21647":56989,"_5":14929,"_28559":56906,"_3075":56990},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3699":1920,"_31384":1881,"_21647":56992,"_5":14929,"_28559":56910,"_3075":56993},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3699":1921,"_31384":1881,"_21647":56995,"_5":14929,"_28559":56910,"_3075":56996},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3699":1922,"_31384":1881,"_21647":56998,"_5":14929,"_28559":56910,"_3075":56999},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3699":1923,"_31384":1881,"_21647":57001,"_5":14929,"_28559":56910,"_3075":57002},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3699":1924,"_31384":1881,"_21647":57004,"_5":14929,"_28559":56914,"_3075":57005},[],"The new chain ends in an anchor installed by the consumer.",{"_3699":1925,"_31384":1881,"_21647":57007,"_5":14929,"_28559":56914,"_3075":57008},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3699":1926,"_31384":1881,"_21647":57010,"_5":14929,"_28559":56914,"_3075":57011},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3699":1927,"_31384":1881,"_21647":57013,"_5":14929,"_28559":56914,"_3075":57014},[],"Re-enrollment accepts the old identity during the planned period.",{"_3699":1928,"_31384":1881,"_21647":57016,"_5":14929,"_28559":56914,"_3075":57017},[],"OCSP and CRL respond for the authorities that remain active.",{"_3699":1929,"_31384":1881,"_21647":57019,"_5":14929,"_28559":56914,"_3075":57020},[],"No DMS is left accidentally issuing from the old CA.",{"_3699":1930,"_31384":1881,"_21647":57022,"_5":14929,"_28559":56914,"_3075":57023},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3699":1931,"_31384":1931,"_5":15283,"_3075":57025,"_31709":57026,"_21647":57027,"_28559":1931},"Certification authorities",[51094,52635,56862,56863],[],{"_3699":1932,"_31384":1931,"_21647":57029,"_5":14929,"_28559":1931,"_3075":57030},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3699":1933,"_31384":1931,"_5":31706,"_21647":57032,"_28559":57033,"_3075":57034},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3699":1934,"_31384":1931,"_5":31706,"_21647":57036,"_28559":57037,"_3075":57038},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3699":1935,"_31384":1931,"_5":31706,"_21647":57040,"_28559":57041,"_3075":51104},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3699":1936,"_31384":1931,"_5":31706,"_21647":57043,"_28559":57044,"_3075":57045},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3699":1937,"_31384":1931,"_5":31706,"_21647":57047,"_28559":57048,"_3075":57049},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3699":1938,"_31384":1931,"_5":31706,"_21647":57051,"_28559":57052,"_3075":57053},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3699":1939,"_31384":1931,"_5":31706,"_21647":57055,"_28559":57056,"_3075":57057},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3699":1940,"_31384":1931,"_5":31706,"_21647":57059,"_28559":57060,"_3075":57061},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3699":1941,"_31384":1931,"_5":31706,"_21647":57063,"_28559":57064,"_3075":57065},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3699":1942,"_31384":1931,"_5":31706,"_21647":57067,"_28559":57068,"_3075":57069},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3699":1943,"_31384":1931,"_5":31706,"_21647":57071,"_28559":57072,"_3075":57073},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3699":1944,"_31384":1931,"_5":31706,"_21647":57075,"_28559":57076,"_3075":57077},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3699":1945,"_31384":1931,"_5":31706,"_21647":57079,"_28559":57080,"_3075":57081},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3699":1946,"_31384":1931,"_5":31706,"_21647":57083,"_28559":57084,"_3075":57085},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3699":1947,"_31384":1931,"_5":31706,"_21647":57087,"_28559":57088,"_3075":57089},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3699":1948,"_31384":1931,"_5":31706,"_21647":57091,"_28559":57092,"_3075":57093},[],"/docs/platform/pki/certificate-authorities#ca-states","CA states",{"_3699":1949,"_31384":1931,"_5":31706,"_21647":57095,"_28559":57096,"_3075":57097},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3699":1950,"_31384":1931,"_5":31706,"_21647":57099,"_28559":57100,"_3075":57101},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3699":1951,"_31384":1931,"_5":31706,"_21647":57103,"_28559":57104,"_3075":57105},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3699":1952,"_31384":1931,"_5":31706,"_21647":57107,"_28559":57108,"_3075":57109},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3699":1953,"_31384":1931,"_5":31706,"_21647":57111,"_28559":57112,"_3075":57113},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3699":1954,"_31384":1931,"_5":31706,"_21647":57115,"_28559":57116,"_3075":57117},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3699":1955,"_31384":1931,"_5":31706,"_21647":57119,"_28559":57120,"_3075":57121},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3699":1956,"_31384":1931,"_5":31706,"_21647":57123,"_28559":57124,"_3075":57125},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3699":1957,"_31384":1931,"_21647":57127,"_5":14929,"_28559":1931,"_3075":57128},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3699":1958,"_31384":1931,"_21647":57130,"_5":14929,"_28559":1931,"_3075":57131},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3699":1959,"_31384":1931,"_21647":57133,"_5":14929,"_28559":1931,"_3075":57134},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3699":1960,"_31384":1931,"_21647":57136,"_5":14929,"_28559":57033,"_3075":57137},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3699":1961,"_31384":1931,"_21647":57139,"_5":14929,"_28559":57033,"_3075":57140},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3699":1962,"_31384":1931,"_21647":57142,"_5":14929,"_28559":57033,"_3075":57143},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3699":1963,"_31384":1931,"_21647":57145,"_5":14929,"_28559":57033,"_3075":57146},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3699":1964,"_31384":1931,"_21647":57148,"_5":14929,"_28559":57033,"_3075":57149},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3699":1965,"_31384":1931,"_21647":57151,"_5":14929,"_28559":57041,"_3075":57152},[],"Decide whether the CA will be a root or an intermediate.",{"_3699":1966,"_31384":1931,"_21647":57154,"_5":14929,"_28559":57041,"_3075":57155},[],"Choose the engine that will keep the key.",{"_3699":1967,"_31384":1931,"_21647":57157,"_5":14929,"_28559":57041,"_3075":57158},[],"Define a validity longer than that of the certificates it will issue.",{"_3699":1968,"_31384":1931,"_21647":57160,"_5":14929,"_28559":57041,"_3075":57161},[],"For an intermediate CA, make sure the parent CA is active.",{"_3699":1969,"_31384":1931,"_21647":57163,"_5":14929,"_28559":57044,"_3075":57164},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3699":1970,"_31384":1931,"_21647":57166,"_5":14929,"_28559":57048,"_3075":57167},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3699":1971,"_31384":1931,"_21647":57169,"_5":14929,"_28559":57048,"_3075":57170},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3699":1972,"_31384":1931,"_21647":57172,"_5":14929,"_28559":57052,"_3075":57173},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3699":1973,"_31384":1931,"_21647":57175,"_5":14929,"_28559":57056,"_3075":57176},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3699":1974,"_31384":1931,"_21647":57178,"_5":14929,"_28559":57056,"_3075":57179},[],"`C`: two-letter ISO 3166-1 country code.",{"_3699":1975,"_31384":1931,"_21647":57181,"_5":14929,"_28559":57056,"_3075":57182},[],"`ST`: state or province.",{"_3699":1976,"_31384":1931,"_21647":57184,"_5":14929,"_28559":57056,"_3075":57185},[],"`L`: locality.",{"_3699":1977,"_31384":1931,"_21647":57187,"_5":14929,"_28559":57056,"_3075":57188},[],"`O`: organization.",{"_3699":1978,"_31384":1931,"_21647":57190,"_5":14929,"_28559":57056,"_3075":57191},[],"`OU`: organizational unit.",{"_3699":1979,"_31384":1931,"_21647":57193,"_5":14929,"_28559":57056,"_3075":57194},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3699":1980,"_31384":1931,"_21647":57196,"_5":14929,"_28559":57060,"_3075":57197},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3699":1981,"_31384":1931,"_21647":57199,"_5":14929,"_28559":57060,"_3075":57200},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3699":1982,"_31384":1931,"_21647":57202,"_5":14929,"_28559":57064,"_3075":57203},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3699":1983,"_31384":1931,"_21647":57205,"_5":14929,"_28559":57064,"_3075":57206},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3699":1984,"_31384":1931,"_21647":57208,"_5":14929,"_28559":57068,"_3075":57209},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3699":1985,"_31384":1931,"_21647":57211,"_5":14929,"_28559":57068,"_3075":57212},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3699":1986,"_31384":1931,"_21647":57214,"_5":14929,"_28559":57072,"_3075":57215},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3699":1987,"_31384":1931,"_21647":57217,"_5":14929,"_28559":57072,"_3075":57218},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3699":1988,"_31384":1931,"_21647":57220,"_5":14929,"_28559":57072,"_3075":57221},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3699":1989,"_31384":1931,"_21647":57223,"_5":14929,"_28559":57072,"_3075":57224},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3699":1990,"_31384":1931,"_21647":57226,"_5":14929,"_28559":57076,"_3075":57227},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3699":1991,"_31384":1931,"_21647":57229,"_5":14929,"_28559":57080,"_3075":57230},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores. When the private key is imported together with the CA, it appears in the KMS key inventory as `Key For CA CN=<subject CN> (imported)`, following the same convention as keys generated when creating a CA (`Key For CA CN=<subject CN>`) plus the `(imported)` suffix.",{"_3699":1992,"_31384":1931,"_21647":57232,"_5":14929,"_28559":57080,"_3075":57233},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3699":1993,"_31384":1931,"_21647":57235,"_5":14929,"_28559":57084,"_3075":57236},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3699":1994,"_31384":1931,"_21647":57238,"_5":14929,"_28559":57088,"_3075":57239},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3699":1995,"_31384":1931,"_21647":57241,"_5":14929,"_28559":57088,"_3075":57242},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3699":1996,"_31384":1931,"_21647":57244,"_5":14929,"_28559":57088,"_3075":57245},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3699":1997,"_31384":1931,"_21647":57247,"_5":14929,"_28559":57092,"_3075":57248},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3699":1998,"_31384":1931,"_21647":57250,"_5":14929,"_28559":57092,"_3075":57251},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3699":1999,"_31384":1931,"_21647":57253,"_5":14929,"_28559":57092,"_3075":57254},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3699":2000,"_31384":1931,"_21647":57256,"_5":14929,"_28559":57092,"_3075":57257},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3699":2001,"_31384":1931,"_21647":57259,"_5":14929,"_28559":57096,"_3075":57260},[],"Open a CA from the inventory to review:",{"_3699":2002,"_31384":1931,"_21647":57262,"_5":14929,"_28559":57096,"_3075":57263},[],"Status and validity period.",{"_3699":2003,"_31384":1931,"_21647":57265,"_5":14929,"_28559":57096,"_3075":57266},[],"Certificate and chain in PEM format.",{"_3699":2004,"_31384":1931,"_21647":57268,"_5":14929,"_28559":57096,"_3075":57269},[],"Number of active, expired and revoked certificates.",{"_3699":2005,"_31384":1931,"_21647":57271,"_5":14929,"_28559":57096,"_3075":57272},[],"Certificates issued in **Issued Certificates**.",{"_3699":2006,"_31384":1931,"_21647":57274,"_5":14929,"_28559":57096,"_3075":57275},[],"The CRL linked to the authority.",{"_3699":2007,"_31384":1931,"_21647":57277,"_5":14929,"_28559":57096,"_3075":57278},[],"Metadata and the associated cryptographic engine.",{"_3699":2008,"_31384":1931,"_21647":57280,"_5":14929,"_28559":57096,"_3075":57281},[],"You can filter the inventory by name, status and CA type.",{"_3699":2009,"_31384":1931,"_21647":57283,"_5":14929,"_28559":57100,"_3075":57284},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3699":2010,"_31384":1931,"_21647":57286,"_5":14929,"_28559":57100,"_3075":57287},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3699":2011,"_31384":1931,"_21647":57289,"_5":14929,"_28559":57100,"_3075":57290},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3699":2012,"_31384":1931,"_21647":57292,"_5":14929,"_28559":57100,"_3075":57293},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3699":2013,"_31384":1931,"_21647":57295,"_5":14929,"_28559":57100,"_3075":57296},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3699":2014,"_31384":1931,"_21647":57298,"_5":14929,"_28559":57100,"_3075":57299},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3699":2015,"_31384":1931,"_21647":57301,"_5":14929,"_28559":57104,"_3075":57302},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3699":2016,"_31384":1931,"_21647":57304,"_5":14929,"_28559":57108,"_3075":57305},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3699":2017,"_31384":1931,"_21647":57307,"_5":14929,"_28559":57112,"_3075":57308},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3699":2018,"_31384":1931,"_21647":57310,"_5":14929,"_28559":57116,"_3075":57311},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3699":2019,"_31384":1931,"_21647":57313,"_5":14929,"_28559":57120,"_3075":57314},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3699":2020,"_31384":1931,"_21647":57316,"_5":14929,"_28559":57124,"_3075":57317},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3699":2021,"_31384":1931,"_21647":57319,"_5":14929,"_28559":57124,"_3075":57320},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3699":2022,"_31384":1931,"_21647":57322,"_5":14929,"_28559":57124,"_3075":57323},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3699":2023,"_31384":1931,"_21647":57325,"_5":14929,"_28559":57124,"_3075":57326},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3699":2024,"_31384":1931,"_21647":57328,"_5":14929,"_28559":57124,"_3075":57329},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3699":2025,"_31384":2025,"_5":15283,"_3075":57331,"_31709":57332,"_21647":57333,"_28559":2025},"Certificate profiles",[51094,52635,56862,56863],[],{"_3699":2026,"_31384":2025,"_21647":57335,"_5":14929,"_28559":2025,"_3075":57336},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3699":2027,"_31384":2025,"_5":31706,"_21647":57338,"_28559":57339,"_3075":57340},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3699":2028,"_31384":2025,"_5":31706,"_21647":57342,"_28559":57343,"_3075":57344},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3699":2029,"_31384":2025,"_5":31706,"_21647":57346,"_28559":57347,"_3075":57348},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3699":2030,"_31384":2025,"_5":31706,"_21647":57350,"_28559":57351,"_3075":57352},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3699":2031,"_31384":2025,"_5":31706,"_21647":57354,"_28559":57355,"_3075":57356},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3699":2032,"_31384":2025,"_5":31706,"_21647":57358,"_28559":57359,"_3075":57360},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3699":2033,"_31384":2025,"_5":31706,"_21647":57362,"_28559":57363,"_3075":57364},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3699":2034,"_31384":2025,"_5":31706,"_21647":57366,"_28559":57367,"_3075":57368},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3699":2035,"_31384":2025,"_5":31706,"_21647":57370,"_28559":57371,"_3075":57372},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3699":2036,"_31384":2025,"_5":31706,"_21647":57374,"_28559":57375,"_3075":57376},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3699":2037,"_31384":2025,"_5":31706,"_21647":57378,"_28559":57379,"_3075":57380},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3699":2038,"_31384":2025,"_5":31706,"_21647":57382,"_28559":57383,"_3075":57384},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3699":2039,"_31384":2025,"_5":31706,"_21647":57386,"_28559":57387,"_3075":57388},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3699":2040,"_31384":2025,"_5":31706,"_21647":57390,"_28559":57391,"_3075":57392},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3699":2041,"_31384":2025,"_5":31706,"_21647":57394,"_28559":57395,"_3075":57396},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3699":2042,"_31384":2025,"_5":31706,"_21647":57398,"_28559":57399,"_3075":57400},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3699":2043,"_31384":2025,"_21647":57402,"_5":14929,"_28559":2025,"_3075":57403},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3699":2044,"_31384":2025,"_21647":57405,"_5":14929,"_28559":2025,"_3075":57406},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3699":2045,"_31384":2025,"_21647":57408,"_5":14929,"_28559":57343,"_3075":57409},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3699":2046,"_31384":2025,"_21647":57411,"_5":14929,"_28559":57343,"_3075":57412},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3699":2047,"_31384":2025,"_21647":57414,"_5":14929,"_28559":57347,"_3075":57415},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3699":2048,"_31384":2025,"_21647":57417,"_5":14929,"_28559":57351,"_3075":57418},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3699":2049,"_31384":2025,"_21647":57420,"_5":14929,"_28559":57351,"_3075":57421},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3699":2050,"_31384":2025,"_21647":57423,"_5":14929,"_28559":57351,"_3075":57424},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3699":2051,"_31384":2025,"_21647":57426,"_5":14929,"_28559":57355,"_3075":57427},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3699":2052,"_31384":2025,"_21647":57429,"_5":14929,"_28559":57359,"_3075":57430},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3699":2053,"_31384":2025,"_21647":57432,"_5":14929,"_28559":57359,"_3075":57433},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3699":2054,"_31384":2025,"_21647":57435,"_5":14929,"_28559":57363,"_3075":57436},[],"The cryptographic enforcement can:",{"_3699":2055,"_31384":2025,"_21647":57438,"_5":14929,"_28559":57363,"_3075":57439},[],"allow or block RSA keys;",{"_3699":2056,"_31384":2025,"_21647":57441,"_5":14929,"_28559":57363,"_3075":57442},[],"limit the supported RSA sizes;",{"_3699":2057,"_31384":2025,"_21647":57444,"_5":14929,"_28559":57363,"_3075":57445},[],"allow or block ECDSA keys;",{"_3699":2058,"_31384":2025,"_21647":57447,"_5":14929,"_28559":57363,"_3075":57448},[],"limit the supported ECDSA sizes or curves.",{"_3699":2059,"_31384":2025,"_21647":57450,"_5":14929,"_28559":57363,"_3075":57451},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3699":2060,"_31384":2025,"_21647":57453,"_5":14929,"_28559":57367,"_3075":57454},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3699":2061,"_31384":2025,"_21647":57456,"_5":14929,"_28559":57367,"_3075":54444},[],{"_3699":2062,"_31384":2025,"_21647":57458,"_5":14929,"_28559":57367,"_3075":57459},[],"First choice",{"_3699":2063,"_31384":2025,"_21647":57461,"_5":14929,"_28559":57367,"_3075":57462},[],"Second choice",{"_3699":2064,"_31384":2025,"_21647":57464,"_5":14929,"_28559":57367,"_3075":57465},[],"If neither is supplied",{"_3699":2065,"_31384":2025,"_21647":57467,"_5":14929,"_28559":57367,"_3075":57468},[],"Direct signing with a CA",{"_3699":2066,"_31384":2025,"_21647":57470,"_5":14929,"_28559":57367,"_3075":57471},[],"`issuance_profile` embedded in the request",{"_3699":2067,"_31384":2025,"_21647":57473,"_5":14929,"_28559":57367,"_3075":57474},[],"Request `issuance_profile_id`",{"_3699":2068,"_31384":2025,"_21647":57476,"_5":14929,"_28559":57367,"_3075":57477},[],"CA default profile (`profile_id`).",{"_3699":2069,"_31384":2025,"_21647":57479,"_5":14929,"_28559":57367,"_3075":57480},[],"Issuance through a DMS",{"_3699":2070,"_31384":2025,"_21647":57482,"_5":14929,"_28559":57367,"_3075":57483},[],"`settings.issuance_profile_id`",{"_3699":2071,"_31384":2025,"_21647":57485,"_5":14929,"_28559":57367,"_3075":57486},[],"`settings.issuance_profile` embedded in the DMS",{"_3699":2072,"_31384":2025,"_21647":57488,"_5":14929,"_28559":57367,"_3075":57489},[],"Enrollment CA default profile.",{"_3699":2073,"_31384":2025,"_21647":57491,"_5":14929,"_28559":57367,"_3075":57492},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3699":2074,"_31384":2025,"_21647":57494,"_5":14929,"_28559":57367,"_3075":57495},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3699":2075,"_31384":2025,"_21647":57497,"_5":14929,"_28559":57375,"_3075":57498},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3699":2076,"_31384":2025,"_21647":57500,"_5":14929,"_28559":57379,"_3075":57501},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3699":2077,"_31384":2025,"_21647":57503,"_5":14929,"_28559":57383,"_3075":57504},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3699":2078,"_31384":2025,"_21647":57506,"_5":14929,"_28559":57387,"_3075":57507},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3699":2079,"_31384":2025,"_21647":57509,"_5":14929,"_28559":57391,"_3075":57510},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3699":2080,"_31384":2025,"_21647":57512,"_5":14929,"_28559":57391,"_3075":57513},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3699":2081,"_31384":2025,"_21647":57515,"_5":14929,"_28559":57395,"_3075":57516},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3699":2082,"_31384":2025,"_21647":57518,"_5":14929,"_28559":57395,"_3075":57519},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3699":2083,"_31384":2025,"_21647":57521,"_5":14929,"_28559":57395,"_3075":57522},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3699":2084,"_31384":2025,"_21647":57524,"_5":14929,"_28559":57395,"_3075":57525},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3699":2085,"_31384":2025,"_21647":57527,"_5":14929,"_28559":57399,"_3075":57528},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3699":2086,"_31384":2025,"_21647":57530,"_5":14929,"_28559":57399,"_3075":57531},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3699":2087,"_31384":2087,"_5":15283,"_3075":57533,"_31709":57534,"_21647":57536,"_28559":2087},"Certificate validation",[51094,52635,56862,57535],"Validation",[],{"_3699":2088,"_31384":2087,"_21647":57538,"_5":14929,"_28559":2087,"_3075":57539},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3699":2089,"_31384":2087,"_5":31706,"_21647":57541,"_28559":57542,"_3075":57543},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3699":2090,"_31384":2087,"_5":31706,"_21647":57545,"_28559":57546,"_3075":57547},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3699":2091,"_31384":2087,"_5":31706,"_21647":57549,"_28559":57550,"_3075":57551},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3699":2092,"_31384":2087,"_21647":57553,"_5":14929,"_28559":2087,"_3075":57554},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3699":2093,"_31384":2087,"_21647":57556,"_5":14929,"_28559":57542,"_3075":57557},[],"Verify these criteria together:",{"_3699":2094,"_31384":2087,"_21647":57559,"_5":14929,"_28559":57542,"_3075":56488},[],{"_3699":2095,"_31384":2087,"_21647":57561,"_5":14929,"_28559":57542,"_3075":57562},[],"Required result",{"_3699":2096,"_31384":2087,"_21647":57564,"_5":14929,"_28559":57542,"_3075":57565},[],"Chain and signature",{"_3699":2097,"_31384":2087,"_21647":57567,"_5":14929,"_28559":57542,"_3075":57568},[],"Valid chain to a root deliberately installed in the consumer.",{"_3699":2098,"_31384":2087,"_21647":57570,"_5":14929,"_28559":57542,"_3075":57571},[],"Dates",{"_3699":2099,"_31384":2087,"_21647":57573,"_5":14929,"_28559":57542,"_3075":57574},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3699":2100,"_31384":2087,"_21647":57576,"_5":14929,"_28559":57542,"_3075":52304},[],{"_3699":2101,"_31384":2087,"_21647":57578,"_5":14929,"_28559":57542,"_3075":57579},[],"Name, SAN or identifier matches the expected peer.",{"_3699":2102,"_31384":2087,"_21647":57581,"_5":14929,"_28559":57542,"_3075":51484},[],{"_3699":2103,"_31384":2087,"_21647":57583,"_5":14929,"_28559":57542,"_3075":57584},[],"KU, EKU and constraints permit the specific operation.",{"_3699":2104,"_31384":2087,"_21647":57586,"_5":14929,"_28559":57542,"_3075":57587},[],"Revocation",{"_3699":2105,"_31384":2087,"_21647":57589,"_5":14929,"_28559":57542,"_3075":57590},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3699":2106,"_31384":2087,"_21647":57592,"_5":14929,"_28559":57542,"_3075":57593},[],"Authorization",{"_3699":2107,"_31384":2087,"_21647":57595,"_5":14929,"_28559":57542,"_3075":57596},[],"The application permits that identity to perform the action.",{"_3699":2108,"_31384":2087,"_21647":57598,"_5":14929,"_28559":57542,"_3075":57599},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3699":2109,"_31384":2087,"_21647":57601,"_5":14929,"_28559":57546,"_3075":57602},[],"Mechanism",{"_3699":2110,"_31384":2087,"_21647":57604,"_5":14929,"_28559":57546,"_3075":57605},[],"When to use it",{"_3699":2111,"_31384":2087,"_21647":57607,"_5":14929,"_28559":57546,"_3075":57608},[],"What you must maintain",{"_3699":2112,"_31384":2087,"_21647":57610,"_5":14929,"_28559":57546,"_3075":57611},[],"OCSP",{"_3699":2113,"_31384":2087,"_21647":57613,"_5":14929,"_28559":57546,"_3075":57614},[],"Status query for a specific certificate.",{"_3699":2114,"_31384":2087,"_21647":57616,"_5":14929,"_28559":57546,"_3075":57617},[],"Responder access, signature verification and cache/freshness policy.",{"_3699":2115,"_31384":2087,"_21647":57619,"_5":14929,"_28559":57546,"_3075":57620},[],"CRL",{"_3699":2116,"_31384":2087,"_21647":57622,"_5":14929,"_28559":57546,"_3075":57623},[],"Local checks for many certificates or offline operation.",{"_3699":2117,"_31384":2087,"_21647":57625,"_5":14929,"_28559":57546,"_3075":57626},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3699":2118,"_31384":2087,"_21647":57628,"_5":14929,"_28559":57546,"_3075":57629},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3699":2119,"_31384":2087,"_21647":57631,"_5":14929,"_28559":57546,"_3075":57632},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3699":2120,"_31384":2087,"_21647":57634,"_5":14929,"_28559":57550,"_3075":57635},[],"Accept a current, authorized certificate with a known chain.",{"_3699":2121,"_31384":2087,"_21647":57637,"_5":14929,"_28559":57550,"_3075":57638},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3699":2122,"_31384":2087,"_21647":57640,"_5":14929,"_28559":57550,"_3075":57641},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3699":2123,"_31384":2087,"_21647":57643,"_5":14929,"_28559":57550,"_3075":57644},[],"Check that a new connection with that identity is rejected.",{"_3699":2124,"_31384":2087,"_21647":57646,"_5":14929,"_28559":57550,"_3075":57647},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3699":2125,"_31384":2087,"_21647":57649,"_5":14929,"_28559":57550,"_3075":57650},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3699":2126,"_31384":2087,"_21647":57652,"_5":14929,"_28559":57550,"_3075":57653},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3699":2127,"_31384":2087,"_21647":57655,"_5":14929,"_28559":57550,"_3075":57656},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3699":2128,"_31384":2087,"_21647":57658,"_5":14929,"_28559":57550,"_3075":57659},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3699":2129,"_31384":2129,"_5":15283,"_3075":57661,"_31709":57662,"_21647":57663,"_28559":2129},"Certificates",[51094,52635,56862,56863],[],{"_3699":2130,"_31384":2129,"_21647":57665,"_5":14929,"_28559":2129,"_3075":57666},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3699":2131,"_31384":2129,"_5":31706,"_21647":57668,"_28559":57669,"_3075":57670},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3699":2132,"_31384":2129,"_5":31706,"_21647":57672,"_28559":57673,"_3075":57674},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3699":2133,"_31384":2129,"_5":31706,"_21647":57676,"_28559":57677,"_3075":57678},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3699":2134,"_31384":2129,"_5":31706,"_21647":57680,"_28559":57681,"_3075":57682},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3699":2135,"_31384":2129,"_5":31706,"_21647":57684,"_28559":57685,"_3075":57686},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3699":2136,"_31384":2129,"_5":31706,"_21647":57688,"_28559":57689,"_3075":57690},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3699":2137,"_31384":2129,"_5":31706,"_21647":57692,"_28559":57693,"_3075":57694},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3699":2138,"_31384":2129,"_5":31706,"_21647":57696,"_28559":57697,"_3075":57698},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3699":2139,"_31384":2129,"_5":31706,"_21647":57700,"_28559":57701,"_3075":57702},[],"/docs/platform/pki/certificates#continue","Continue",{"_3699":2140,"_31384":2129,"_21647":57704,"_5":14929,"_28559":2129,"_3075":57705},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3699":2141,"_31384":2129,"_21647":57707,"_5":14929,"_28559":57669,"_3075":57708},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3699":2142,"_31384":2129,"_21647":57710,"_5":14929,"_28559":57669,"_3075":57711},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3699":2143,"_31384":2129,"_21647":57713,"_5":14929,"_28559":57669,"_3075":57714},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3699":2144,"_31384":2129,"_21647":57716,"_5":14929,"_28559":57669,"_3075":57717},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3699":2145,"_31384":2129,"_21647":57719,"_5":14929,"_28559":57669,"_3075":57720},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3699":2146,"_31384":2129,"_21647":57722,"_5":14929,"_28559":57669,"_3075":57723},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3699":2147,"_31384":2129,"_21647":57725,"_5":14929,"_28559":57669,"_3075":57726},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3699":2148,"_31384":2129,"_21647":57728,"_5":14929,"_28559":57673,"_3075":57729},[],"Download the PEM and inspect it:",{"_3699":2149,"_31384":2129,"_21647":57731,"_5":14929,"_28559":57673,"_3075":57732},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3699":2150,"_31384":2129,"_21647":57734,"_5":14929,"_28559":57677,"_3075":57735},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3699":2151,"_31384":2129,"_21647":57737,"_5":14929,"_28559":57677,"_3075":57738},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3699":2152,"_31384":2129,"_21647":57740,"_5":14929,"_28559":57677,"_3075":57741},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3699":2153,"_31384":2129,"_21647":57743,"_5":14929,"_28559":57677,"_3075":57744},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3699":2154,"_31384":2129,"_21647":57746,"_5":14929,"_28559":57677,"_3075":57747},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3699":2155,"_31384":2129,"_21647":57749,"_5":14929,"_28559":57677,"_3075":57750},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3699":2156,"_31384":2129,"_21647":57752,"_5":14929,"_28559":57677,"_3075":57753},[],"For browser key generation, follow Issue your first certificate.",{"_3699":2157,"_31384":2129,"_21647":57755,"_5":14929,"_28559":57681,"_3075":57756},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3699":2158,"_31384":2129,"_21647":57758,"_5":14929,"_28559":57685,"_3075":57759},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3699":2159,"_31384":2129,"_21647":57761,"_5":14929,"_28559":57689,"_3075":57762},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3699":2160,"_31384":2129,"_21647":57764,"_5":14929,"_28559":57693,"_3075":57765},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3699":2161,"_31384":2129,"_21647":57767,"_5":14929,"_28559":57693,"_3075":57768},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3699":2162,"_31384":2129,"_21647":57770,"_5":14929,"_28559":57693,"_3075":57771},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3699":2163,"_31384":2129,"_21647":57773,"_5":14929,"_28559":57697,"_3075":57774},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3699":2164,"_31384":2129,"_21647":57776,"_5":14929,"_28559":57697,"_3075":57777},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3699":2165,"_31384":2129,"_21647":57779,"_5":14929,"_28559":57697,"_3075":57780},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3699":2166,"_31384":2129,"_21647":57782,"_5":14929,"_28559":57701,"_3075":57783},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3699":2167,"_31384":2129,"_21647":57785,"_5":14929,"_28559":57701,"_3075":57786},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3699":2168,"_31384":2168,"_5":15283,"_3075":57788,"_31709":57789,"_21647":57791,"_28559":2168},"Certificate lifecycle",[51094,52635,56862,57790],"Concepts",[],{"_3699":2169,"_31384":2168,"_21647":57793,"_5":14929,"_28559":2168,"_3075":57794},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3699":2170,"_31384":2168,"_5":31706,"_21647":57796,"_28559":57797,"_3075":57798},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3699":2171,"_31384":2168,"_5":31706,"_21647":57800,"_28559":57801,"_3075":57802},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3699":2172,"_31384":2168,"_5":31706,"_21647":57804,"_28559":57805,"_3075":57806},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3699":2173,"_31384":2168,"_5":31706,"_21647":57808,"_28559":57809,"_3075":57810},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3699":2174,"_31384":2168,"_5":31706,"_21647":57812,"_28559":57813,"_3075":57814},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3699":2175,"_31384":2168,"_5":31706,"_21647":57816,"_28559":57817,"_3075":57818},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3699":2176,"_31384":2168,"_5":31706,"_21647":57820,"_28559":57821,"_3075":57822},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3699":2177,"_31384":2168,"_5":31706,"_21647":57824,"_28559":57825,"_3075":57826},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3699":2178,"_31384":2168,"_5":31706,"_21647":57828,"_28559":57829,"_3075":57830},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3699":2179,"_31384":2168,"_5":31706,"_21647":57832,"_28559":57833,"_3075":57834},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3699":2180,"_31384":2168,"_21647":57836,"_5":14929,"_28559":2168,"_3075":57837},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3699":2181,"_31384":2168,"_21647":57839,"_5":14929,"_28559":57801,"_3075":57840},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3699":2182,"_31384":2168,"_21647":57842,"_5":14929,"_28559":57805,"_3075":57843},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3699":2183,"_31384":2168,"_21647":57845,"_5":14929,"_28559":57809,"_3075":57846},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3699":2184,"_31384":2168,"_21647":57848,"_5":14929,"_28559":57813,"_3075":57849},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3699":2185,"_31384":2168,"_21647":57851,"_5":14929,"_28559":57817,"_3075":57852},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3699":2186,"_31384":2168,"_21647":57854,"_5":14929,"_28559":57821,"_3075":57855},[],"Lamassu persists four X.509 states:",{"_3699":2187,"_31384":2168,"_21647":57857,"_5":14929,"_28559":57821,"_3075":57858},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3699":2188,"_31384":2168,"_21647":57860,"_5":14929,"_28559":57821,"_3075":57861},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3699":2189,"_31384":2168,"_21647":57863,"_5":14929,"_28559":57821,"_3075":57864},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3699":2190,"_31384":2168,"_21647":57866,"_5":14929,"_28559":57821,"_3075":57867},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3699":2191,"_31384":2168,"_21647":57869,"_5":14929,"_28559":57821,"_3075":57870},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3699":2192,"_31384":2168,"_21647":57872,"_5":14929,"_28559":57825,"_3075":57873},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3699":2193,"_31384":2168,"_21647":57875,"_5":14929,"_28559":57825,"_3075":57876},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3699":2194,"_31384":2168,"_21647":57878,"_5":14929,"_28559":57825,"_3075":57879},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3699":2195,"_31384":2168,"_21647":57881,"_5":14929,"_28559":57829,"_3075":57882},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3699":2196,"_31384":2168,"_21647":57884,"_5":14929,"_28559":57829,"_3075":57885},[],"Before confirming:",{"_3699":2197,"_31384":2168,"_21647":57887,"_5":14929,"_28559":57829,"_3075":57888},[],"Identify DMSs, devices and services that trust that chain.",{"_3699":2198,"_31384":2168,"_21647":57890,"_5":14929,"_28559":57829,"_3075":57891},[],"Distribute the new chain of trust.",{"_3699":2199,"_31384":2168,"_21647":57893,"_5":14929,"_28559":57829,"_3075":57894},[],"Reissue the necessary identities.",{"_3699":2200,"_31384":2168,"_21647":57896,"_5":14929,"_28559":57829,"_3075":57897},[],"Check OCSP and CRL from a real consumer.",{"_3699":2201,"_31384":2168,"_21647":57899,"_5":14929,"_28559":57829,"_3075":57900},[],"Revoke the old CA once no legitimate traffic remains.",{"_3699":2202,"_31384":2168,"_21647":57902,"_5":14929,"_28559":57829,"_3075":57903},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3699":2203,"_31384":2168,"_21647":57905,"_5":14929,"_28559":57833,"_3075":57906},[],"Certificates entering the preventive or critical renewal window.",{"_3699":2204,"_31384":2168,"_21647":57908,"_5":14929,"_28559":57833,"_3075":57909},[],"Repeated enrollment or re-enrollment failures.",{"_3699":2205,"_31384":2168,"_21647":57911,"_5":14929,"_28559":57833,"_3075":57912},[],"Status changes and revocation reasons.",{"_3699":2206,"_31384":2168,"_21647":57914,"_5":14929,"_28559":57833,"_3075":57915},[],"OCSP and CRL publication and validity.",{"_3699":2207,"_31384":2168,"_21647":57917,"_5":14929,"_28559":57833,"_3075":57918},[],"Dependencies still presenting a replaced certificate.",{"_3699":2208,"_31384":2168,"_21647":57920,"_5":14929,"_28559":57833,"_3075":57921},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3699":2209,"_31384":2209,"_5":15283,"_3075":57923,"_31709":57924,"_21647":57925,"_28559":2209},"Trust model",[51094,52635,56862,57790],[],{"_3699":2210,"_31384":2209,"_21647":57927,"_5":14929,"_28559":2209,"_3075":57928},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3699":2211,"_31384":2209,"_5":31706,"_21647":57930,"_28559":57931,"_3075":57932},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3699":2212,"_31384":2209,"_5":31706,"_21647":57934,"_28559":57935,"_3075":57936},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3699":2213,"_31384":2209,"_5":31706,"_21647":57938,"_28559":57939,"_3075":57940},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3699":2214,"_31384":2209,"_5":31706,"_21647":57942,"_28559":57943,"_3075":57944},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3699":2215,"_31384":2209,"_5":31706,"_21647":57946,"_28559":57947,"_3075":57948},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3699":2216,"_31384":2209,"_5":31706,"_21647":57950,"_28559":57951,"_3075":57952},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3699":2217,"_31384":2209,"_5":31706,"_21647":57954,"_28559":57955,"_3075":57956},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3699":2218,"_31384":2209,"_5":31706,"_21647":57958,"_28559":57959,"_3075":57960},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3699":2219,"_31384":2209,"_5":31706,"_21647":57962,"_28559":57963,"_3075":57964},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3699":2220,"_31384":2209,"_5":31706,"_21647":57966,"_28559":57967,"_3075":57968},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3699":2221,"_31384":2209,"_21647":57970,"_5":14929,"_28559":2209,"_3075":57971},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3699":2222,"_31384":2209,"_21647":57973,"_5":14929,"_28559":57935,"_3075":57974},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3699":2223,"_31384":2209,"_21647":57976,"_5":14929,"_28559":57939,"_3075":57977},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3699":2224,"_31384":2209,"_21647":57979,"_5":14929,"_28559":57943,"_3075":57980},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3699":2225,"_31384":2209,"_21647":57982,"_5":14929,"_28559":57947,"_3075":57983},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3699":2226,"_31384":2209,"_21647":57985,"_5":14929,"_28559":57951,"_3075":57986},[],"The device proves it can enroll according to the DMS policy.",{"_3699":2227,"_31384":2209,"_21647":57988,"_5":14929,"_28559":57951,"_3075":57989},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3699":2228,"_31384":2209,"_21647":57991,"_5":14929,"_28559":57951,"_3075":57992},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3699":2229,"_31384":2209,"_21647":57994,"_5":14929,"_28559":57951,"_3075":57995},[],"The device installs the certificate and the chain it needs.",{"_3699":2230,"_31384":2209,"_21647":57997,"_5":14929,"_28559":57951,"_3075":57998},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3699":2231,"_31384":2209,"_21647":58000,"_5":14929,"_28559":57951,"_3075":58001},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3699":2232,"_31384":2209,"_21647":58003,"_5":14929,"_28559":57955,"_3075":58004},[],"A DMS relates three sets that are worth designing separately:",{"_3699":2233,"_31384":2209,"_21647":58006,"_5":14929,"_28559":57955,"_3075":58007},[],"**Enrollment CA:** signs the new identities.",{"_3699":2234,"_31384":2209,"_21647":58009,"_5":14929,"_28559":57955,"_3075":58010},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3699":2235,"_31384":2209,"_21647":58012,"_5":14929,"_28559":57955,"_3075":58013},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3699":2236,"_31384":2209,"_21647":58015,"_5":14929,"_28559":57955,"_3075":58016},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3699":2237,"_31384":2209,"_21647":58018,"_5":14929,"_28559":57959,"_3075":58019},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3699":2238,"_31384":2209,"_21647":58021,"_5":14929,"_28559":57959,"_3075":58022},[],"that the current date is between `Not Before` and `Not After`;",{"_3699":2239,"_31384":2209,"_21647":58024,"_5":14929,"_28559":57959,"_3075":58025},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3699":2240,"_31384":2209,"_21647":58027,"_5":14929,"_28559":57959,"_3075":58028},[],"that names, SANs and subject match the expected identity;",{"_3699":2241,"_31384":2209,"_21647":58030,"_5":14929,"_28559":57959,"_3075":58031},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3699":2242,"_31384":2209,"_21647":58033,"_5":14929,"_28559":57959,"_3075":58034},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3699":2243,"_31384":2209,"_21647":58036,"_5":14929,"_28559":57959,"_3075":58037},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3699":2244,"_31384":2209,"_21647":58039,"_5":14929,"_28559":57963,"_3075":58040},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3699":2245,"_31384":2209,"_21647":58042,"_5":14929,"_28559":57967,"_3075":58043},[],"Keep the root out of daily operations, or with very restricted access.",{"_3699":2246,"_31384":2209,"_21647":58045,"_5":14929,"_28559":57967,"_3075":58046},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3699":2247,"_31384":2209,"_21647":58048,"_5":14929,"_28559":57967,"_3075":58049},[],"Assign explicit profiles to every use case.",{"_3699":2248,"_31384":2209,"_21647":58051,"_5":14929,"_28559":57967,"_3075":58052},[],"Distribute the new trust before starting a rotation.",{"_3699":2249,"_31384":2209,"_21647":58054,"_5":14929,"_28559":57967,"_3075":58055},[],"Keep enough overlap to renew a disconnected fleet.",{"_3699":2250,"_31384":2209,"_21647":58057,"_5":14929,"_28559":57967,"_3075":58058},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3699":2251,"_31384":2209,"_21647":58060,"_5":14929,"_28559":57967,"_3075":58061},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3699":2252,"_31384":2252,"_5":15283,"_3075":58063,"_31709":58064,"_21647":58065,"_28559":2252},"Revocation lists (CRL)",[51094,52635,56862,57535],[],{"_3699":2253,"_31384":2252,"_21647":58067,"_5":14929,"_28559":2252,"_3075":58068},[],"Generate and distribute signed lists to validate certificates offline.",{"_3699":2254,"_31384":2252,"_5":31706,"_21647":58070,"_28559":58071,"_3075":58072},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3699":2255,"_31384":2252,"_5":31706,"_21647":58074,"_28559":58075,"_3075":58076},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3699":2256,"_31384":2252,"_5":31706,"_21647":58078,"_28559":58079,"_3075":58080},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3699":2257,"_31384":2252,"_5":31706,"_21647":58082,"_28559":58083,"_3075":58084},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3699":2258,"_31384":2252,"_5":31706,"_21647":58086,"_28559":58087,"_3075":58088},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3699":2259,"_31384":2252,"_5":31706,"_21647":58090,"_28559":58091,"_3075":58092},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3699":2260,"_31384":2252,"_5":31706,"_21647":58094,"_28559":58095,"_3075":58096},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3699":2261,"_31384":2252,"_5":31706,"_21647":58098,"_28559":58099,"_3075":58100},[],"/docs/platform/pki/crl#references","References",{"_3699":2262,"_31384":2252,"_21647":58102,"_5":14929,"_28559":2252,"_3075":58103},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3699":2263,"_31384":2252,"_21647":58105,"_5":14929,"_28559":58071,"_3075":58106},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3699":2264,"_31384":2252,"_21647":58108,"_5":14929,"_28559":58071,"_3075":54538},[],{"_3699":2265,"_31384":2252,"_21647":58110,"_5":14929,"_28559":58071,"_3075":51484},[],{"_3699":2266,"_31384":2252,"_21647":58112,"_5":14929,"_28559":58071,"_3075":52755},[],{"_3699":2267,"_31384":2252,"_21647":58114,"_5":14929,"_28559":58071,"_3075":58115},[],"ID of the CA the settings belong to.",{"_3699":2268,"_31384":2252,"_21647":58117,"_5":14929,"_28559":58071,"_3075":58118},[],"`status`",{"_3699":2269,"_31384":2252,"_21647":58120,"_5":14929,"_28559":58071,"_3075":58121},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3699":2270,"_31384":2252,"_21647":58123,"_5":14929,"_28559":58071,"_3075":58124},[],"`legacy_ski`",{"_3699":2271,"_31384":2252,"_21647":58126,"_5":14929,"_28559":58071,"_3075":58127},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3699":2272,"_31384":2252,"_21647":58129,"_5":14929,"_28559":58071,"_3075":58130},[],"`latest_crl`",{"_3699":2273,"_31384":2252,"_21647":58132,"_5":14929,"_28559":58071,"_3075":58133},[],"Version, validity start and end of the last published list. Read-only.",{"_3699":2274,"_31384":2252,"_21647":58135,"_5":14929,"_28559":58071,"_3075":58136},[],"`crl_options` field",{"_3699":2275,"_31384":2252,"_21647":58138,"_5":14929,"_28559":58071,"_3075":51484},[],{"_3699":2276,"_31384":2252,"_21647":58140,"_5":14929,"_28559":58071,"_3075":58141},[],"Initial value",{"_3699":2277,"_31384":2252,"_21647":58143,"_5":14929,"_28559":58071,"_3075":58144},[],"`validity`",{"_3699":2278,"_31384":2252,"_21647":58146,"_5":14929,"_28559":58071,"_3075":58147},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3699":2279,"_31384":2252,"_21647":58149,"_5":14929,"_28559":58071,"_3075":58150},[],"7 days.",{"_3699":2280,"_31384":2252,"_21647":58152,"_5":14929,"_28559":58071,"_3075":58153},[],"`refresh_interval`",{"_3699":2281,"_31384":2252,"_21647":58155,"_5":14929,"_28559":58071,"_3075":58156},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3699":2282,"_31384":2252,"_21647":58158,"_5":14929,"_28559":58071,"_3075":58159},[],"6 days and 23 hours.",{"_3699":2283,"_31384":2252,"_21647":58161,"_5":14929,"_28559":58071,"_3075":58162},[],"`regenerate_on_revoke`",{"_3699":2284,"_31384":2252,"_21647":58164,"_5":14929,"_28559":58071,"_3075":58165},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3699":2285,"_31384":2252,"_21647":58167,"_5":14929,"_28559":58071,"_3075":58168},[],"`true`.",{"_3699":2286,"_31384":2252,"_21647":58170,"_5":14929,"_28559":58071,"_3075":58171},[],"`signer_serial_number`",{"_3699":2287,"_31384":2252,"_21647":58173,"_5":14929,"_28559":58071,"_3075":58174},[],"Serial number of the existing certificate that signs the CRL.",{"_3699":2288,"_31384":2252,"_21647":58176,"_5":14929,"_28559":58071,"_3075":58177},[],"Serial number of the CA’s current certificate.",{"_3699":2289,"_31384":2252,"_21647":58179,"_5":14929,"_28559":58071,"_3075":58180},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3699":2290,"_31384":2252,"_21647":58182,"_5":14929,"_28559":58071,"_3075":58183},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3699":2291,"_31384":2252,"_21647":58185,"_5":14929,"_28559":58071,"_3075":58186},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3699":2292,"_31384":2252,"_21647":58188,"_5":14929,"_28559":58071,"_3075":58189},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3699":2293,"_31384":2252,"_21647":58191,"_5":14929,"_28559":58071,"_3075":58192},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3699":2294,"_31384":2252,"_21647":58194,"_5":14929,"_28559":58071,"_3075":58195},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3699":2295,"_31384":2252,"_21647":58197,"_5":14929,"_28559":58071,"_3075":58198},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3699":2296,"_31384":2252,"_21647":58200,"_5":14929,"_28559":58071,"_3075":58201},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3699":2297,"_31384":2252,"_21647":58203,"_5":14929,"_28559":58071,"_3075":58204},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3699":2298,"_31384":2252,"_21647":58206,"_5":14929,"_28559":58071,"_3075":58207},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3699":2299,"_31384":2252,"_21647":58209,"_5":14929,"_28559":58071,"_3075":58210},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3699":2300,"_31384":2252,"_21647":58212,"_5":14929,"_28559":58075,"_3075":58213},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3699":2301,"_31384":2252,"_21647":58215,"_5":14929,"_28559":58075,"_3075":58216},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3699":2302,"_31384":2252,"_21647":58218,"_5":14929,"_28559":58075,"_3075":58219},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3699":2303,"_31384":2252,"_21647":58221,"_5":14929,"_28559":58075,"_3075":58222},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3699":2304,"_31384":2252,"_21647":58224,"_5":14929,"_28559":58079,"_3075":58225},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3699":2305,"_31384":2252,"_21647":58227,"_5":14929,"_28559":58079,"_3075":58228},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3699":2306,"_31384":2252,"_21647":58230,"_5":14929,"_28559":58079,"_3075":58231},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3699":2307,"_31384":2252,"_21647":58233,"_5":14929,"_28559":58079,"_3075":58234},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3699":2308,"_31384":2252,"_21647":58236,"_5":14929,"_28559":58079,"_3075":58237},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3699":2309,"_31384":2252,"_21647":58239,"_5":14929,"_28559":58079,"_3075":58240},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3699":2310,"_31384":2252,"_21647":58242,"_5":14929,"_28559":58079,"_3075":58243},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3699":2311,"_31384":2252,"_21647":58245,"_5":14929,"_28559":58079,"_3075":58246},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3699":2312,"_31384":2252,"_21647":58248,"_5":14929,"_28559":58079,"_3075":58249},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3699":2313,"_31384":2252,"_21647":58251,"_5":14929,"_28559":58083,"_3075":58252},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3699":2314,"_31384":2252,"_21647":58254,"_5":14929,"_28559":58083,"_3075":58255},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3699":2315,"_31384":2252,"_21647":58257,"_5":14929,"_28559":58087,"_3075":58258},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3699":2316,"_31384":2252,"_21647":58260,"_5":14929,"_28559":58087,"_3075":58261},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3699":2317,"_31384":2252,"_21647":58263,"_5":14929,"_28559":58087,"_3075":58264},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3699":2318,"_31384":2252,"_21647":58266,"_5":14929,"_28559":58087,"_3075":58267},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3699":2319,"_31384":2252,"_21647":58269,"_5":14929,"_28559":58087,"_3075":58270},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3699":2320,"_31384":2252,"_21647":58272,"_5":14929,"_28559":58091,"_3075":58273},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3699":2321,"_31384":2252,"_21647":58275,"_5":14929,"_28559":58091,"_3075":54447},[],{"_3699":2322,"_31384":2252,"_21647":58277,"_5":14929,"_28559":58091,"_3075":58278},[],"Relative path",{"_3699":2323,"_31384":2252,"_21647":58280,"_5":14929,"_28559":58091,"_3075":54444},[],{"_3699":2324,"_31384":2252,"_21647":58282,"_5":14929,"_28559":58091,"_3075":58283},[],"`GET`",{"_3699":2325,"_31384":2252,"_21647":58285,"_5":14929,"_28559":58091,"_3075":58286},[],"`/v1/crl-settings`",{"_3699":2326,"_31384":2252,"_21647":58288,"_5":14929,"_28559":58091,"_3075":58289},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3699":2327,"_31384":2252,"_21647":58291,"_5":14929,"_28559":58091,"_3075":58283},[],{"_3699":2328,"_31384":2252,"_21647":58293,"_5":14929,"_28559":58091,"_3075":58294},[],"`/v1/crl-settings/{ca-id}`",{"_3699":2329,"_31384":2252,"_21647":58296,"_5":14929,"_28559":58091,"_3075":58297},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3699":2330,"_31384":2252,"_21647":58299,"_5":14929,"_28559":58091,"_3075":58300},[],"`PUT`",{"_3699":2331,"_31384":2252,"_21647":58302,"_5":14929,"_28559":58091,"_3075":58294},[],{"_3699":2332,"_31384":2252,"_21647":58304,"_5":14929,"_28559":58091,"_3075":58305},[],"Replace the CRL configuration of a CA.",{"_3699":2333,"_31384":2252,"_21647":58307,"_5":14929,"_28559":58091,"_3075":58308},[],"`DELETE`",{"_3699":2334,"_31384":2252,"_21647":58310,"_5":14929,"_28559":58091,"_3075":58294},[],{"_3699":2335,"_31384":2252,"_21647":58312,"_5":14929,"_28559":58091,"_3075":58313},[],"Remove the archived CRL settings of a CA.",{"_3699":2336,"_31384":2252,"_21647":58315,"_5":14929,"_28559":58091,"_3075":58316},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3699":2337,"_31384":2252,"_21647":58318,"_5":14929,"_28559":58091,"_3075":58319},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3699":2338,"_31384":2252,"_21647":58321,"_5":14929,"_28559":58091,"_3075":58322},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3699":2339,"_31384":2252,"_21647":58324,"_5":14929,"_28559":58095,"_3075":58325},[],"Symptom",{"_3699":2340,"_31384":2252,"_21647":58327,"_5":14929,"_28559":58095,"_3075":58328},[],"Cause",{"_3699":2341,"_31384":2252,"_21647":58330,"_5":14929,"_28559":58095,"_3075":58331},[],"Action",{"_3699":2342,"_31384":2252,"_21647":58333,"_5":14929,"_28559":58095,"_3075":58334},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3699":2343,"_31384":2252,"_21647":58336,"_5":14929,"_28559":58095,"_3075":58337},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3699":2344,"_31384":2252,"_21647":58339,"_5":14929,"_28559":58095,"_3075":58340},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3699":2345,"_31384":2252,"_21647":58342,"_5":14929,"_28559":58095,"_3075":58343},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3699":2346,"_31384":2252,"_21647":58345,"_5":14929,"_28559":58095,"_3075":58346},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3699":2347,"_31384":2252,"_21647":58348,"_5":14929,"_28559":58095,"_3075":58349},[],"Delete the CA first; deleting it archives its settings.",{"_3699":2348,"_31384":2252,"_21647":58351,"_5":14929,"_28559":58095,"_3075":58352},[],"`PUT` returns 400.",{"_3699":2349,"_31384":2252,"_21647":58354,"_5":14929,"_28559":58095,"_3075":58355},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3699":2350,"_31384":2252,"_21647":58357,"_5":14929,"_28559":58095,"_3075":58358},[],"Set the serial number of a valid certificate of that CA.",{"_3699":2351,"_31384":2252,"_21647":58360,"_5":14929,"_28559":58095,"_3075":58361},[],"`PUT` returns 404.",{"_3699":2352,"_31384":2252,"_21647":58363,"_5":14929,"_28559":58095,"_3075":58364},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3699":2353,"_31384":2252,"_21647":58366,"_5":14929,"_28559":58095,"_3075":58367},[],"Check the CA ID and the signer serial number.",{"_3699":2354,"_31384":2252,"_21647":58369,"_5":14929,"_28559":58095,"_3075":58370},[],"`PUT` returns 400 from a 3.x client.",{"_3699":2355,"_31384":2252,"_21647":58372,"_5":14929,"_28559":58095,"_3075":58373},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3699":2356,"_31384":2252,"_21647":58375,"_5":14929,"_28559":58095,"_3075":58376},[],"Update the client to send the new field.",{"_3699":2357,"_31384":2252,"_21647":58378,"_5":14929,"_28559":58095,"_3075":58379},[],"The CRL does not change after revoking a certificate.",{"_3699":2358,"_31384":2252,"_21647":58381,"_5":14929,"_28559":58095,"_3075":58382},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3699":2359,"_31384":2252,"_21647":58384,"_5":14929,"_28559":58095,"_3075":58385},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3699":2360,"_31384":2252,"_21647":58387,"_5":14929,"_28559":58095,"_3075":58388},[],"A verifier rejects the CRL because of the issuer.",{"_3699":2361,"_31384":2252,"_21647":58390,"_5":14929,"_28559":58095,"_3075":58391},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3699":2362,"_31384":2252,"_21647":58393,"_5":14929,"_28559":58095,"_3075":58394},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3699":2363,"_31384":2252,"_21647":58396,"_5":14929,"_28559":58099,"_3075":58397},[],"RFC 5280: X.509 and CRL profile.",{"_3699":2364,"_31384":2252,"_21647":58399,"_5":14929,"_28559":58099,"_3075":58400},[],"OpenSSL: openssl-crl.",{"_3699":2365,"_31384":2252,"_21647":58402,"_5":14929,"_28559":58099,"_3075":58403},[],"OpenSSL: openssl-verify.",{"_3699":2366,"_31384":2252,"_21647":58405,"_5":14929,"_28559":58099,"_3075":58406},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3699":2367,"_31384":2252,"_21647":58408,"_5":14929,"_28559":58099,"_3075":58409},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3699":2368,"_31384":2368,"_5":15283,"_3075":58411,"_31709":58412,"_21647":58413,"_28559":2368},"Enrollment protocols",[51094,52635,56862,56863],[],{"_3699":2369,"_31384":2368,"_21647":58415,"_5":14929,"_28559":2368,"_3075":58416},[],"Request and renew certificates from a Lamassu CA.",{"_3699":2370,"_31384":2368,"_21647":58418,"_5":14929,"_28559":2368,"_3075":58419},[],"Lamassu supports EST (Enrollment over Secure Transport), defined in RFC 7030. The DMS applies the enrollment policy and the configured CA issues the certificates.",{"_3699":2371,"_31384":2368,"_21647":58421,"_5":14929,"_28559":2368,"_3075":58422},[],"Core endpoint",{"_3699":2372,"_31384":2368,"_21647":58424,"_5":14929,"_28559":2368,"_3075":51484},[],{"_3699":2373,"_31384":2368,"_21647":58426,"_5":14929,"_28559":2368,"_3075":58427},[],"`GET /cacerts`",{"_3699":2374,"_31384":2368,"_21647":58429,"_5":14929,"_28559":2368,"_3075":58430},[],"Retrieve the CA certificates published by the DMS.",{"_3699":2375,"_31384":2368,"_21647":58432,"_5":14929,"_28559":2368,"_3075":58433},[],"`POST /simpleenroll`",{"_3699":2376,"_31384":2368,"_21647":58435,"_5":14929,"_28559":2368,"_3075":55086},[],{"_3699":2377,"_31384":2368,"_21647":58437,"_5":14929,"_28559":2368,"_3075":58438},[],"`POST /simplereenroll`",{"_3699":2378,"_31384":2368,"_21647":58440,"_5":14929,"_28559":2368,"_3075":58441},[],"Request a successor to an existing certificate.",{"_3699":2379,"_31384":2368,"_21647":58443,"_5":14929,"_28559":2368,"_3075":58444},[],"See EST (RFC 7030) for client setup, authentication, request formats and optional server-side key generation.",{"_3699":2380,"_31384":2380,"_5":15283,"_3075":58446,"_31709":58447,"_21647":58448,"_28559":2380},"Keys and cryptographic engines",[51094,52635,56862,56863],[],{"_3699":2381,"_31384":2380,"_21647":58450,"_5":14929,"_28559":2380,"_3075":58451},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3699":2382,"_31384":2380,"_5":31706,"_21647":58453,"_28559":58454,"_3075":58455},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3699":2383,"_31384":2380,"_5":31706,"_21647":58457,"_28559":58458,"_3075":58459},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3699":2384,"_31384":2380,"_5":31706,"_21647":58461,"_28559":58462,"_3075":58463},[],"/docs/platform/pki/key-management#file-system","File System",{"_3699":2385,"_31384":2380,"_5":31706,"_21647":58465,"_28559":58466,"_3075":58467},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3699":2386,"_31384":2380,"_5":31706,"_21647":58469,"_28559":58470,"_3075":58471},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3699":2387,"_31384":2380,"_5":31706,"_21647":58473,"_28559":58474,"_3075":58475},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3699":2388,"_31384":2380,"_5":31706,"_21647":58477,"_28559":58478,"_3075":58479},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3699":2389,"_31384":2380,"_5":31706,"_21647":58481,"_28559":58482,"_3075":58483},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3699":2390,"_31384":2380,"_5":31706,"_21647":58485,"_28559":58486,"_3075":58487},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3699":2391,"_31384":2380,"_5":31706,"_21647":58489,"_28559":58490,"_3075":58491},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3699":2392,"_31384":2380,"_5":31706,"_21647":58493,"_28559":58494,"_3075":58495},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3699":2393,"_31384":2380,"_5":31706,"_21647":58497,"_28559":58498,"_3075":58499},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3699":2394,"_31384":2380,"_5":31706,"_21647":58501,"_28559":58502,"_3075":58503},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3699":2395,"_31384":2380,"_5":31706,"_21647":58505,"_28559":58506,"_3075":58507},[],"/docs/platform/pki/key-management#view-details","View details",{"_3699":2396,"_31384":2380,"_5":31706,"_21647":58509,"_28559":58510,"_3075":58511},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3699":2397,"_31384":2380,"_5":31706,"_21647":58513,"_28559":58514,"_3075":58515},[],"/docs/platform/pki/key-management#sign","Sign",{"_3699":2398,"_31384":2380,"_5":31706,"_21647":58517,"_28559":58518,"_3075":58519},[],"/docs/platform/pki/key-management#verify","Verify",{"_3699":2399,"_31384":2380,"_5":31706,"_21647":58521,"_28559":58522,"_3075":58523},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3699":2400,"_31384":2380,"_5":31706,"_21647":58525,"_28559":58526,"_3075":58527},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3699":2401,"_31384":2380,"_5":31706,"_21647":58529,"_28559":58530,"_3075":58531},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3699":2402,"_31384":2380,"_21647":58533,"_5":14929,"_28559":2380,"_3075":58534},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3699":2403,"_31384":2380,"_21647":58536,"_5":14929,"_28559":2380,"_3075":58537},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3699":2404,"_31384":2380,"_21647":58539,"_5":14929,"_28559":58454,"_3075":58540},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3699":2405,"_31384":2380,"_21647":58542,"_5":14929,"_28559":58454,"_3075":58543},[],"In practice, it lets you:",{"_3699":2406,"_31384":2380,"_21647":58545,"_5":14929,"_28559":58454,"_3075":58546},[],"Generate new key pairs from Lamassu IoT.",{"_3699":2407,"_31384":2380,"_21647":58548,"_5":14929,"_28559":58454,"_3075":58549},[],"Import keys created externally.",{"_3699":2408,"_31384":2380,"_21647":58551,"_5":14929,"_28559":58454,"_3075":58552},[],"Delegate custody and cryptographic operations to external engines.",{"_3699":2409,"_31384":2380,"_21647":58554,"_5":14929,"_28559":58454,"_3075":58555},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3699":2410,"_31384":2380,"_21647":58557,"_5":14929,"_28559":58458,"_3075":58558},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3699":2411,"_31384":2380,"_21647":58560,"_5":14929,"_28559":58458,"_3075":58561},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3699":2412,"_31384":2380,"_21647":58563,"_5":14929,"_28559":58458,"_3075":58564},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3699":2413,"_31384":2380,"_21647":58566,"_5":14929,"_28559":58462,"_3075":58567},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3699":2414,"_31384":2380,"_21647":58569,"_5":14929,"_28559":58466,"_3075":58570},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3699":2415,"_31384":2380,"_21647":58572,"_5":14929,"_28559":58466,"_3075":58573},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3699":2416,"_31384":2380,"_21647":58575,"_5":14929,"_28559":58470,"_3075":58576},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3699":2417,"_31384":2380,"_21647":58578,"_5":14929,"_28559":58474,"_3075":58579},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3699":2418,"_31384":2380,"_21647":58581,"_5":14929,"_28559":58478,"_3075":58582},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3699":2419,"_31384":2380,"_21647":58584,"_5":14929,"_28559":58482,"_3075":58585},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3699":2420,"_31384":2380,"_21647":58587,"_5":14929,"_28559":58482,"_3075":58588},[],"Lamassu shows the enabled engines in the console.",{"_3699":2421,"_31384":2380,"_21647":58590,"_5":14929,"_28559":58482,"_3075":58591},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3699":2422,"_31384":2380,"_21647":58593,"_5":14929,"_28559":58482,"_3075":58594},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3699":2423,"_31384":2380,"_21647":58596,"_5":14929,"_28559":58486,"_3075":58597},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3699":2424,"_31384":2380,"_21647":58599,"_5":14929,"_28559":58486,"_3075":58600},[],"The table includes the following fields:",{"_3699":2425,"_31384":2380,"_21647":58602,"_5":14929,"_28559":58486,"_3075":58603},[],"**Name**: descriptive name of the key.",{"_3699":2426,"_31384":2380,"_21647":58605,"_5":14929,"_28559":58486,"_3075":58606},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3699":2427,"_31384":2380,"_21647":58608,"_5":14929,"_28559":58486,"_3075":58609},[],"**Strength**: visual indicator of cryptographic strength.",{"_3699":2428,"_31384":2380,"_21647":58611,"_5":14929,"_28559":58486,"_3075":58612},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3699":2429,"_31384":2380,"_21647":58614,"_5":14929,"_28559":58486,"_3075":58615},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3699":2430,"_31384":2380,"_21647":58617,"_5":14929,"_28559":58486,"_3075":58618},[],"**Aliases**: alternative names associated with the key.",{"_3699":2431,"_31384":2380,"_21647":58620,"_5":14929,"_28559":58486,"_3075":58621},[],"**Tags**: labels for classification and search.",{"_3699":2432,"_31384":2380,"_21647":58623,"_5":14929,"_28559":58486,"_3075":58624},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3699":2433,"_31384":2380,"_21647":58626,"_5":14929,"_28559":58486,"_3075":58627},[],"From this view you also reach the most common actions:",{"_3699":2434,"_31384":2380,"_21647":58629,"_5":14929,"_28559":58486,"_3075":58630},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3699":2435,"_31384":2380,"_21647":58632,"_5":14929,"_28559":58486,"_3075":58633},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3699":2436,"_31384":2380,"_21647":58635,"_5":14929,"_28559":58486,"_3075":58636},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3699":2437,"_31384":2380,"_21647":58638,"_5":14929,"_28559":58486,"_3075":58639},[],"**Delete Key** to remove the key from the system.",{"_3699":2438,"_31384":2380,"_21647":58641,"_5":14929,"_28559":58490,"_3075":58642},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3699":2439,"_31384":2380,"_21647":58644,"_5":14929,"_28559":58494,"_3075":58645},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3699":2440,"_31384":2380,"_21647":58647,"_5":14929,"_28559":58494,"_3075":58648},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3699":2441,"_31384":2380,"_21647":58650,"_5":14929,"_28559":58494,"_3075":58651},[],"**Key Name**: unique and descriptive name.",{"_3699":2442,"_31384":2380,"_21647":58653,"_5":14929,"_28559":58494,"_3075":58654},[],"**Crypto Engine**: engine that will keep the key.",{"_3699":2443,"_31384":2380,"_21647":58656,"_5":14929,"_28559":58494,"_3075":58657},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3699":2444,"_31384":2380,"_21647":58659,"_5":14929,"_28559":58494,"_3075":58660},[],"**Tags**: metadata to classify the key.",{"_3699":2445,"_31384":2380,"_21647":58662,"_5":14929,"_28559":58494,"_3075":58663},[],"**Metadata**: additional information for advanced uses.",{"_3699":2446,"_31384":2380,"_21647":58665,"_5":14929,"_28559":58498,"_3075":58666},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3699":2447,"_31384":2380,"_21647":58668,"_5":14929,"_28559":58498,"_3075":58669},[],"When you have an exportable private key and the destination engine supports import.",{"_3699":2448,"_31384":2380,"_21647":58671,"_5":14929,"_28559":58498,"_3075":58672},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3699":2449,"_31384":2380,"_21647":58674,"_5":14929,"_28559":58498,"_3075":58675},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3699":2450,"_31384":2380,"_21647":58677,"_5":14929,"_28559":58498,"_3075":58678},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3699":2451,"_31384":2380,"_21647":58680,"_5":14929,"_28559":58498,"_3075":58681},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3699":2452,"_31384":2380,"_21647":58683,"_5":14929,"_28559":58498,"_3075":58684},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3699":2453,"_31384":2380,"_21647":58686,"_5":14929,"_28559":58498,"_3075":58687},[],"**Tags**: labels for organization and search.",{"_3699":2454,"_31384":2380,"_21647":58689,"_5":14929,"_28559":58498,"_3075":58690},[],"**Metadata**: additional optional information.",{"_3699":2455,"_31384":2380,"_21647":58692,"_5":14929,"_28559":58498,"_3075":58693},[],"**Private Key (PEM)**: private key in PEM format.",{"_3699":2456,"_31384":2380,"_21647":58695,"_5":14929,"_28559":58498,"_3075":58696},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3699":2457,"_31384":2380,"_21647":58698,"_5":14929,"_28559":58502,"_3075":58699},[],"Each registered key has a detail view and several operational actions.",{"_3699":2458,"_31384":2380,"_21647":58701,"_5":14929,"_28559":58506,"_3075":58702},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3699":2459,"_31384":2380,"_21647":58704,"_5":14929,"_28559":58506,"_3075":58705},[],"The **Overview** tab shows, among others, these fields:",{"_3699":2460,"_31384":2380,"_21647":58707,"_5":14929,"_28559":58506,"_3075":58708},[],"**Key Name**: descriptive name.",{"_3699":2461,"_31384":2380,"_21647":58710,"_5":14929,"_28559":58506,"_3075":58711},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3699":2462,"_31384":2380,"_21647":58713,"_5":14929,"_28559":58506,"_3075":58714},[],"**Tags**: associated labels.",{"_3699":2463,"_31384":2380,"_21647":58716,"_5":14929,"_28559":58506,"_3075":58717},[],"**Aliases**: alternative names.",{"_3699":2464,"_31384":2380,"_21647":58719,"_5":14929,"_28559":58506,"_3075":58720},[],"**Crypto Engine**: engine where the key resides.",{"_3699":2465,"_31384":2380,"_21647":58722,"_5":14929,"_28559":58506,"_3075":58723},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3699":2466,"_31384":2380,"_21647":58725,"_5":14929,"_28559":58506,"_3075":58726},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3699":2467,"_31384":2380,"_21647":58728,"_5":14929,"_28559":58506,"_3075":58729},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3699":2468,"_31384":2380,"_21647":58731,"_5":14929,"_28559":58510,"_3075":58732},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3699":2469,"_31384":2380,"_21647":58734,"_5":14929,"_28559":58510,"_3075":58735},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3699":2470,"_31384":2380,"_21647":58737,"_5":14929,"_28559":58510,"_3075":58738},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3699":2471,"_31384":2380,"_21647":58740,"_5":14929,"_28559":58514,"_3075":58741},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3699":2472,"_31384":2380,"_21647":58743,"_5":14929,"_28559":58514,"_3075":58744},[],"Main fields:",{"_3699":2473,"_31384":2380,"_21647":58746,"_5":14929,"_28559":58514,"_3075":58747},[],"**Algorithm**: signing algorithm available for the key type.",{"_3699":2474,"_31384":2380,"_21647":58749,"_5":14929,"_28559":58514,"_3075":58750},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3699":2475,"_31384":2380,"_21647":58752,"_5":14929,"_28559":58514,"_3075":58753},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3699":2476,"_31384":2380,"_21647":58755,"_5":14929,"_28559":58514,"_3075":58756},[],"**Message**: content to sign.",{"_3699":2477,"_31384":2380,"_21647":58758,"_5":14929,"_28559":58514,"_3075":58759},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3699":2478,"_31384":2380,"_21647":58761,"_5":14929,"_28559":58518,"_3075":58762},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3699":2479,"_31384":2380,"_21647":58764,"_5":14929,"_28559":58518,"_3075":58744},[],{"_3699":2480,"_31384":2380,"_21647":58766,"_5":14929,"_28559":58518,"_3075":58767},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3699":2481,"_31384":2380,"_21647":58769,"_5":14929,"_28559":58518,"_3075":58770},[],"**Message Type**: `Raw` or `Digest`.",{"_3699":2482,"_31384":2380,"_21647":58772,"_5":14929,"_28559":58518,"_3075":58773},[],"**Payload Encoding**: encoding of the message.",{"_3699":2483,"_31384":2380,"_21647":58775,"_5":14929,"_28559":58518,"_3075":58776},[],"**Message**: original message or hash.",{"_3699":2484,"_31384":2380,"_21647":58778,"_5":14929,"_28559":58518,"_3075":58779},[],"**Signature**: signature to check.",{"_3699":2485,"_31384":2380,"_21647":58781,"_5":14929,"_28559":58518,"_3075":58782},[],"**Result**: indicator of the validation result.",{"_3699":2486,"_31384":2380,"_21647":58784,"_5":14929,"_28559":58522,"_3075":58785},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3699":2487,"_31384":2380,"_21647":58787,"_5":14929,"_28559":58522,"_3075":58788},[],"This flow is useful for:",{"_3699":2488,"_31384":2380,"_21647":58790,"_5":14929,"_28559":58522,"_3075":58791},[],"Requesting certificates from an external CA.",{"_3699":2489,"_31384":2380,"_21647":58793,"_5":14929,"_28559":58522,"_3075":58794},[],"Renewing an identity while keeping the same key.",{"_3699":2490,"_31384":2380,"_21647":58796,"_5":14929,"_28559":58522,"_3075":58797},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3699":2491,"_31384":2380,"_21647":58799,"_5":14929,"_28559":58522,"_3075":58800},[],"**Common Name (CN)**: main name of the identity.",{"_3699":2492,"_31384":2380,"_21647":58802,"_5":14929,"_28559":58522,"_3075":58803},[],"**Organization (O)**: organization or company.",{"_3699":2493,"_31384":2380,"_21647":58805,"_5":14929,"_28559":58522,"_3075":58806},[],"**Organizational Unit (OU)**: department or unit.",{"_3699":2494,"_31384":2380,"_21647":58808,"_5":14929,"_28559":58522,"_3075":58809},[],"**Country (C)**: two-letter country code.",{"_3699":2495,"_31384":2380,"_21647":58811,"_5":14929,"_28559":58522,"_3075":58812},[],"**State / Province (ST)**: state or province.",{"_3699":2496,"_31384":2380,"_21647":58814,"_5":14929,"_28559":58522,"_3075":58815},[],"**Locality (L)**: city or locality.",{"_3699":2497,"_31384":2380,"_21647":58817,"_5":14929,"_28559":58522,"_3075":58818},[],"**Email Address**: contact email.",{"_3699":2498,"_31384":2380,"_21647":58820,"_5":14929,"_28559":58522,"_3075":58821},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3699":2499,"_31384":2380,"_21647":58823,"_5":14929,"_28559":58522,"_3075":58824},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3699":2500,"_31384":2380,"_21647":58826,"_5":14929,"_28559":58526,"_3075":58827},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3699":2501,"_31384":2380,"_21647":58829,"_5":14929,"_28559":58526,"_3075":58830},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3699":2502,"_31384":2380,"_21647":58832,"_5":14929,"_28559":58530,"_3075":58833},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3699":2503,"_31384":2380,"_21647":58835,"_5":14929,"_28559":58530,"_3075":58836},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3699":2504,"_31384":2504,"_5":15283,"_3075":58838,"_31709":58839,"_21647":58840,"_28559":2504},"Online validation with OCSP",[51094,52635,56862,57535],[],{"_3699":2505,"_31384":2504,"_21647":58842,"_5":14929,"_28559":2504,"_3075":58843},[],"Query signed status and verify the responder’s response.",{"_3699":2506,"_31384":2504,"_5":31706,"_21647":58845,"_28559":58846,"_3075":58847},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3699":2507,"_31384":2504,"_5":31706,"_21647":58849,"_28559":58850,"_3075":58851},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3699":2508,"_31384":2504,"_5":31706,"_21647":58853,"_28559":58854,"_3075":58855},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3699":2509,"_31384":2504,"_5":31706,"_21647":58857,"_28559":58858,"_3075":58859},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3699":2510,"_31384":2504,"_5":31706,"_21647":58861,"_28559":58862,"_3075":58863},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3699":2511,"_31384":2504,"_5":31706,"_21647":58865,"_28559":58866,"_3075":58100},[],"/docs/platform/pki/ocsp#references",{"_3699":2512,"_31384":2504,"_21647":58868,"_5":14929,"_28559":2504,"_3075":58869},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3699":2513,"_31384":2504,"_21647":58871,"_5":14929,"_28559":58846,"_3075":58872},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3699":2514,"_31384":2504,"_21647":58874,"_5":14929,"_28559":58846,"_3075":58875},[],"Record status",{"_3699":2515,"_31384":2504,"_21647":58877,"_5":14929,"_28559":58846,"_3075":58878},[],"Signed response",{"_3699":2516,"_31384":2504,"_21647":58880,"_5":14929,"_28559":58846,"_3075":55998},[],{"_3699":2517,"_31384":2504,"_21647":58882,"_5":14929,"_28559":58846,"_3075":58883},[],"`Good`.",{"_3699":2518,"_31384":2504,"_21647":58885,"_5":14929,"_28559":58846,"_3075":56015},[],{"_3699":2519,"_31384":2504,"_21647":58887,"_5":14929,"_28559":58846,"_3075":58888},[],"`Revoked`, with revocation reason and timestamp.",{"_3699":2520,"_31384":2504,"_21647":58890,"_5":14929,"_28559":58846,"_3075":58891},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3699":2521,"_31384":2504,"_21647":58893,"_5":14929,"_28559":58846,"_3075":58894},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3699":2522,"_31384":2504,"_21647":58896,"_5":14929,"_28559":58846,"_3075":58897},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3699":2523,"_31384":2504,"_21647":58899,"_5":14929,"_28559":58846,"_3075":58900},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3699":2524,"_31384":2504,"_21647":58902,"_5":14929,"_28559":58846,"_3075":58903},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3699":2525,"_31384":2504,"_21647":58905,"_5":14929,"_28559":58850,"_3075":58906},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3699":2526,"_31384":2504,"_21647":58908,"_5":14929,"_28559":58850,"_3075":58909},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3699":2527,"_31384":2504,"_21647":58911,"_5":14929,"_28559":58854,"_3075":58912},[],"The service accepts:",{"_3699":2528,"_31384":2504,"_21647":58914,"_5":14929,"_28559":58854,"_3075":54447},[],{"_3699":2529,"_31384":2504,"_21647":58916,"_5":14929,"_28559":58854,"_3075":58917},[],"VA service path",{"_3699":2530,"_31384":2504,"_21647":58919,"_5":14929,"_28559":58854,"_3075":58920},[],"Format",{"_3699":2531,"_31384":2504,"_21647":58922,"_5":14929,"_28559":58854,"_3075":58923},[],"`POST`",{"_3699":2532,"_31384":2504,"_21647":58925,"_5":14929,"_28559":58854,"_3075":58926},[],"`/ocsp`",{"_3699":2533,"_31384":2504,"_21647":58928,"_5":14929,"_28559":58854,"_3075":58929},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3699":2534,"_31384":2504,"_21647":58931,"_5":14929,"_28559":58854,"_3075":58283},[],{"_3699":2535,"_31384":2504,"_21647":58933,"_5":14929,"_28559":58854,"_3075":58934},[],"`/ocsp/{ocsp_request}`",{"_3699":2536,"_31384":2504,"_21647":58936,"_5":14929,"_28559":58854,"_3075":58937},[],"DER request encoded using padded URL Base64.",{"_3699":2537,"_31384":2504,"_21647":58939,"_5":14929,"_28559":58854,"_3075":58940},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3699":2538,"_31384":2504,"_21647":58942,"_5":14929,"_28559":58858,"_3075":58943},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3699":2539,"_31384":2504,"_21647":58945,"_5":14929,"_28559":58858,"_3075":58946},[],"Generate the request:",{"_3699":2540,"_31384":2504,"_21647":58948,"_5":14929,"_28559":58858,"_3075":58949},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3699":2541,"_31384":2504,"_21647":58951,"_5":14929,"_28559":58858,"_3075":58952},[],"Replace the example URL with the inspected endpoint:",{"_3699":2542,"_31384":2504,"_21647":58954,"_5":14929,"_28559":58858,"_3075":58955},[],"Verify the returned DER:",{"_3699":2543,"_31384":2504,"_21647":58957,"_5":14929,"_28559":58858,"_3075":58958},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3699":2544,"_31384":2504,"_21647":58960,"_5":14929,"_28559":58862,"_3075":58961},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3699":2545,"_31384":2504,"_21647":58963,"_5":14929,"_28559":58862,"_3075":58964},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3699":2546,"_31384":2504,"_21647":58966,"_5":14929,"_28559":58866,"_3075":58967},[],"RFC 6960: OCSP.",{"_3699":2547,"_31384":2504,"_21647":58969,"_5":14929,"_28559":58866,"_3075":58970},[],"OpenSSL: openssl-ocsp.",{"_3699":2548,"_31384":2504,"_21647":58972,"_5":14929,"_28559":58866,"_3075":58973},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3699":2549,"_31384":2504,"_21647":58975,"_5":14929,"_28559":58866,"_3075":58409},[],{"_3699":2550,"_31384":2550,"_5":15283,"_3075":56862,"_31709":58977,"_21647":58978,"_28559":2550},[51094,52635,56862],[],{"_3699":2551,"_31384":2550,"_21647":58980,"_5":14929,"_28559":2550,"_3075":58981},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3699":2552,"_31384":2550,"_5":31706,"_21647":58983,"_28559":58984,"_3075":56173},[],"/docs/platform/pki/overview#start-here",{"_3699":2553,"_31384":2550,"_5":31706,"_21647":58986,"_28559":58987,"_3075":58988},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3699":2554,"_31384":2550,"_5":31706,"_21647":58990,"_28559":58991,"_3075":56706},[],"/docs/platform/pki/overview#core-capabilities",{"_3699":2555,"_31384":2550,"_5":31706,"_21647":58993,"_28559":58994,"_3075":56710},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3699":2556,"_31384":2550,"_5":31706,"_21647":58996,"_28559":58997,"_3075":56714},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3699":2557,"_31384":2550,"_5":31706,"_21647":58999,"_28559":59000,"_3075":56718},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3699":2558,"_31384":2550,"_5":31706,"_21647":59002,"_28559":59003,"_3075":56726},[],"/docs/platform/pki/overview#publish-validation-status",{"_3699":2559,"_31384":2550,"_5":31706,"_21647":59005,"_28559":59006,"_3075":59007},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3699":2560,"_31384":2550,"_5":31706,"_21647":59009,"_28559":59010,"_3075":57702},[],"/docs/platform/pki/overview#continue",{"_3699":2561,"_31384":2550,"_21647":59012,"_5":14929,"_28559":2550,"_3075":59013},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3699":2562,"_31384":2550,"_21647":59015,"_5":14929,"_28559":58984,"_3075":59016},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3699":2563,"_31384":2550,"_21647":59018,"_5":14929,"_28559":58984,"_3075":59019},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3699":2564,"_31384":2550,"_21647":59021,"_5":14929,"_28559":58987,"_3075":59022},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3699":2565,"_31384":2550,"_21647":59024,"_5":14929,"_28559":58987,"_3075":59025},[],"An available cryptographic engine to keep the authority's key.",{"_3699":2566,"_31384":2550,"_21647":59027,"_5":14929,"_28559":58987,"_3075":59028},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3699":2567,"_31384":2550,"_21647":59030,"_5":14929,"_28559":58987,"_3075":59031},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3699":2568,"_31384":2550,"_21647":59033,"_5":14929,"_28559":58987,"_3075":59034},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3699":2569,"_31384":2550,"_21647":59036,"_5":14929,"_28559":58994,"_3075":59037},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3699":2570,"_31384":2550,"_21647":59039,"_5":14929,"_28559":58997,"_3075":59040},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3699":2571,"_31384":2550,"_21647":59042,"_5":14929,"_28559":59000,"_3075":59043},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3699":2572,"_31384":2550,"_21647":59045,"_5":14929,"_28559":59000,"_3075":59046},[],"Enrollment protocols let clients obtain and renew certificates from a Lamassu CA.",{"_3699":2573,"_31384":2550,"_21647":59048,"_5":14929,"_28559":59003,"_3075":59049},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3699":2574,"_31384":2550,"_21647":59051,"_5":14929,"_28559":59006,"_3075":59052},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3699":2575,"_31384":2550,"_21647":59054,"_5":14929,"_28559":59006,"_3075":59055},[],"its subject and extensions identify the expected client;",{"_3699":2576,"_31384":2550,"_21647":59057,"_5":14929,"_28559":59006,"_3075":59058},[],"its public key matches the client's private key;",{"_3699":2577,"_31384":2550,"_21647":59060,"_5":14929,"_28559":59006,"_3075":59061},[],"its chain reaches a root trusted by the consumer;",{"_3699":2578,"_31384":2550,"_21647":59063,"_5":14929,"_28559":59006,"_3075":59064},[],"its dates and usages allow the operation;",{"_3699":2579,"_31384":2550,"_21647":59066,"_5":14929,"_28559":59006,"_3075":59067},[],"the consumer applies revocation checks and authorization.",{"_3699":2580,"_31384":2550,"_21647":59069,"_5":14929,"_28559":59006,"_3075":59070},[],"The issuance path includes the first independent checks.",{"_3699":2581,"_31384":2550,"_21647":59072,"_5":14929,"_28559":59010,"_3075":59073},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3699":2582,"_31384":2550,"_21647":59075,"_5":14929,"_28559":59010,"_3075":59076},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3699":2583,"_31384":2550,"_21647":59078,"_5":14929,"_28559":59010,"_3075":59079},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3699":2584,"_31384":2584,"_5":15283,"_3075":59081,"_31709":59082,"_21647":59083,"_28559":2584},"Create your first CA",[51094,52635,56862,56298],[],{"_3699":2585,"_31384":2584,"_21647":59085,"_5":14929,"_28559":2584,"_3075":59086},[],"Create an evaluation root and check its certificate before issuing.",{"_3699":2586,"_31384":2584,"_5":31706,"_21647":59088,"_28559":59089,"_3075":51104},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3699":2587,"_31384":2584,"_5":31706,"_21647":59091,"_28559":59092,"_3075":59093},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3699":2588,"_31384":2584,"_5":31706,"_21647":59095,"_28559":59096,"_3075":59097},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3699":2589,"_31384":2584,"_5":31706,"_21647":59099,"_28559":59100,"_3075":59101},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3699":2590,"_31384":2584,"_5":31706,"_21647":59103,"_28559":59104,"_3075":59105},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3699":2591,"_31384":2584,"_5":31706,"_21647":59107,"_28559":59108,"_3075":59109},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3699":2592,"_31384":2584,"_5":31706,"_21647":59111,"_28559":59112,"_3075":59113},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3699":2593,"_31384":2584,"_5":31706,"_21647":59115,"_28559":59116,"_3075":56556},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3699":2594,"_31384":2584,"_5":31706,"_21647":59118,"_28559":59119,"_3075":51128},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3699":2595,"_31384":2584,"_21647":59121,"_5":14929,"_28559":2584,"_3075":59122},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3699":2596,"_31384":2584,"_21647":59124,"_5":14929,"_28559":59089,"_3075":59125},[],"Console access and permission to create keys and authorities.",{"_3699":2597,"_31384":2584,"_21647":59127,"_5":14929,"_28559":59089,"_3075":59128},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3699":2598,"_31384":2584,"_21647":59130,"_5":14929,"_28559":59089,"_3075":59131},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3699":2599,"_31384":2584,"_21647":59133,"_5":14929,"_28559":59089,"_3075":59134},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3699":2600,"_31384":2584,"_21647":59136,"_5":14929,"_28559":59092,"_3075":59137},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3699":2601,"_31384":2584,"_21647":59139,"_5":14929,"_28559":59092,"_3075":59140},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3699":2602,"_31384":2584,"_21647":59142,"_5":14929,"_28559":59096,"_3075":59143},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3699":2603,"_31384":2584,"_21647":59145,"_5":14929,"_28559":59096,"_3075":59146},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3699":2604,"_31384":2584,"_21647":59148,"_5":14929,"_28559":59100,"_3075":59149},[],"Select **Root CA** and complete:",{"_3699":2605,"_31384":2584,"_21647":59151,"_5":14929,"_28559":59100,"_3075":59152},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3699":2606,"_31384":2584,"_21647":59154,"_5":14929,"_28559":59100,"_3075":59155},[],"**Subject**: organization and country details for your evaluation.",{"_3699":2607,"_31384":2584,"_21647":59157,"_5":14929,"_28559":59100,"_3075":59158},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3699":2608,"_31384":2584,"_21647":59160,"_5":14929,"_28559":59100,"_3075":59161},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3699":2609,"_31384":2584,"_21647":59163,"_5":14929,"_28559":59100,"_3075":59164},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3699":2610,"_31384":2584,"_21647":59166,"_5":14929,"_28559":59104,"_3075":59167},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3699":2611,"_31384":2584,"_21647":59169,"_5":14929,"_28559":59108,"_3075":59170},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3699":2612,"_31384":2584,"_21647":59172,"_5":14929,"_28559":59108,"_3075":59173},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3699":2613,"_31384":2584,"_21647":59175,"_5":14929,"_28559":59112,"_3075":59176},[],"Run from the directory where you saved `ca.pem`:",{"_3699":2614,"_31384":2584,"_21647":59178,"_5":14929,"_28559":59112,"_3075":59179},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3699":2615,"_31384":2584,"_21647":59181,"_5":14929,"_28559":59112,"_3075":59182},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3699":2616,"_31384":2584,"_21647":59184,"_5":14929,"_28559":59116,"_3075":59185},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3699":2617,"_31384":2584,"_21647":59187,"_5":14929,"_28559":59116,"_3075":59188},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3699":2618,"_31384":2584,"_21647":59190,"_5":14929,"_28559":59116,"_3075":59191},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3699":2619,"_31384":2584,"_21647":59193,"_5":14929,"_28559":59116,"_3075":59194},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3699":2620,"_31384":2584,"_21647":59196,"_5":14929,"_28559":59119,"_3075":59197},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3699":2621,"_31384":2621,"_5":15283,"_3075":59199,"_31709":59200,"_21647":59201,"_28559":2621},"Issue and verify a certificate",[51094,52635,56862,56298],[],{"_3699":2622,"_31384":2621,"_21647":59203,"_5":14929,"_28559":2621,"_3075":59204},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3699":2623,"_31384":2621,"_5":31706,"_21647":59206,"_28559":59207,"_3075":51104},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3699":2624,"_31384":2621,"_5":31706,"_21647":59209,"_28559":59210,"_3075":59211},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3699":2625,"_31384":2621,"_5":31706,"_21647":59213,"_28559":59214,"_3075":59215},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3699":2626,"_31384":2621,"_5":31706,"_21647":59217,"_28559":59218,"_3075":59219},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3699":2627,"_31384":2621,"_5":31706,"_21647":59221,"_28559":59222,"_3075":59223},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3699":2628,"_31384":2621,"_5":31706,"_21647":59225,"_28559":59226,"_3075":59227},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3699":2629,"_31384":2621,"_5":31706,"_21647":59229,"_28559":59230,"_3075":59231},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3699":2630,"_31384":2621,"_5":31706,"_21647":59233,"_28559":59234,"_3075":59235},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3699":2631,"_31384":2621,"_5":31706,"_21647":59237,"_28559":59238,"_3075":59239},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3699":2632,"_31384":2621,"_5":31706,"_21647":59241,"_28559":59242,"_3075":59243},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3699":2633,"_31384":2621,"_5":31706,"_21647":59245,"_28559":59246,"_3075":56556},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3699":2634,"_31384":2621,"_5":31706,"_21647":59248,"_28559":59249,"_3075":51128},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3699":2635,"_31384":2621,"_21647":59251,"_5":14929,"_28559":2621,"_3075":59252},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3699":2636,"_31384":2621,"_21647":59254,"_5":14929,"_28559":59207,"_3075":59255},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3699":2637,"_31384":2621,"_21647":59257,"_5":14929,"_28559":59207,"_3075":59258},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3699":2638,"_31384":2621,"_21647":59260,"_5":14929,"_28559":59207,"_3075":59261},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3699":2639,"_31384":2621,"_21647":59263,"_5":14929,"_28559":59207,"_3075":59264},[],"A client identifier: here we use `device-001`.",{"_3699":2640,"_31384":2621,"_21647":59266,"_5":14929,"_28559":59207,"_3075":59267},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3699":2641,"_31384":2621,"_21647":59269,"_5":14929,"_28559":59210,"_3075":59270},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3699":2642,"_31384":2621,"_21647":59272,"_5":14929,"_28559":59214,"_3075":59273},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3699":2643,"_31384":2621,"_21647":59275,"_5":14929,"_28559":59214,"_3075":59276},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3699":2644,"_31384":2621,"_21647":59278,"_5":14929,"_28559":59218,"_3075":59279},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3699":2645,"_31384":2621,"_21647":59281,"_5":14929,"_28559":59218,"_3075":59282},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3699":2646,"_31384":2621,"_21647":59284,"_5":14929,"_28559":59222,"_3075":59285},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3699":2647,"_31384":2621,"_21647":59287,"_5":14929,"_28559":59222,"_3075":59288},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3699":2648,"_31384":2621,"_21647":59290,"_5":14929,"_28559":59226,"_3075":59291},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3699":2649,"_31384":2621,"_21647":59293,"_5":14929,"_28559":59230,"_3075":59294},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3699":2650,"_31384":2621,"_21647":59296,"_5":14929,"_28559":59234,"_3075":59297},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3699":2651,"_31384":2621,"_21647":59299,"_5":14929,"_28559":59238,"_3075":59300},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3699":2652,"_31384":2621,"_21647":59302,"_5":14929,"_28559":59238,"_3075":59303},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3699":2653,"_31384":2621,"_21647":59305,"_5":14929,"_28559":59238,"_3075":59306},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3699":2654,"_31384":2621,"_21647":59308,"_5":14929,"_28559":59242,"_3075":59309},[],"In Bash, compare the two public-key digests:",{"_3699":2655,"_31384":2621,"_21647":59311,"_5":14929,"_28559":59242,"_3075":59312},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3699":2656,"_31384":2621,"_21647":59314,"_5":14929,"_28559":59242,"_3075":59315},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3699":2657,"_31384":2621,"_21647":59317,"_5":14929,"_28559":59246,"_3075":56640},[],{"_3699":2658,"_31384":2621,"_21647":59319,"_5":14929,"_28559":59246,"_3075":59320},[],"What to review",{"_3699":2659,"_31384":2621,"_21647":59322,"_5":14929,"_28559":59246,"_3075":59323},[],"The CA rejects issuance",{"_3699":2660,"_31384":2621,"_21647":59325,"_5":14929,"_28559":59246,"_3075":59326},[],"Permissions, CA state and key, algorithm and profile.",{"_3699":2661,"_31384":2621,"_21647":59328,"_5":14929,"_28559":59246,"_3075":59329},[],"Different subject or usages",{"_3699":2662,"_31384":2621,"_21647":59331,"_5":14929,"_28559":59246,"_3075":59332},[],"Applied profile and requested values.",{"_3699":2663,"_31384":2621,"_21647":59334,"_5":14929,"_28559":59246,"_3075":59335},[],"Issuer cannot be found",{"_3699":2664,"_31384":2621,"_21647":59337,"_5":14929,"_28559":59246,"_3075":59338},[],"Downloaded CA and required intermediate chain.",{"_3699":2665,"_31384":2621,"_21647":59340,"_5":14929,"_28559":59246,"_3075":59341},[],"Validity fails",{"_3699":2666,"_31384":2621,"_21647":59343,"_5":14929,"_28559":59246,"_3075":59344},[],"Certificate and CA dates, and the computer's clock.",{"_3699":2667,"_31384":2621,"_21647":59346,"_5":14929,"_28559":59246,"_3075":59347},[],"Public-key digests differ",{"_3699":2668,"_31384":2621,"_21647":59349,"_5":14929,"_28559":59246,"_3075":59350},[],"Certificate and key files from the same issuance.",{"_3699":2669,"_31384":2621,"_21647":59352,"_5":14929,"_28559":59246,"_3075":59353},[],"See PKI diagnostics to narrow an issuance failure.",{"_3699":2670,"_31384":2621,"_21647":59355,"_5":14929,"_28559":59249,"_3075":59356},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3699":2671,"_31384":2621,"_21647":59358,"_5":14929,"_28559":59249,"_3075":59359},[],"Manage certificates for inspection, status and revocation.",{"_3699":2672,"_31384":2621,"_21647":59361,"_5":14929,"_28559":59249,"_3075":59362},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3699":2673,"_31384":2621,"_21647":59364,"_5":14929,"_28559":59249,"_3075":59365},[],"Prepare EST for the device to request its next identities.",{"_3699":2674,"_31384":2621,"_21647":59367,"_5":14929,"_28559":59249,"_3075":59368},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3699":2675,"_31384":2675,"_5":15283,"_3075":59370,"_31709":59371,"_21647":59372,"_28559":2675},"PKI getting started",[51094,52635,56862,56298],[],{"_3699":2676,"_31384":2675,"_21647":59374,"_5":14929,"_28559":2675,"_3075":59375},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3699":2677,"_31384":2675,"_5":31706,"_21647":59377,"_28559":59378,"_3075":51104},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3699":2678,"_31384":2675,"_5":31706,"_21647":59380,"_28559":59381,"_3075":59382},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3699":2679,"_31384":2675,"_5":31706,"_21647":59384,"_28559":59385,"_3075":56491},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3699":2680,"_31384":2675,"_5":31706,"_21647":59387,"_28559":59388,"_3075":59389},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3699":2681,"_31384":2675,"_21647":59391,"_5":14929,"_28559":2675,"_3075":59392},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3699":2682,"_31384":2675,"_21647":59394,"_5":14929,"_28559":59378,"_3075":59395},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3699":2683,"_31384":2675,"_21647":59397,"_5":14929,"_28559":59378,"_3075":59398},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3699":2684,"_31384":2675,"_21647":59400,"_5":14929,"_28559":59378,"_3075":59401},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3699":2685,"_31384":2675,"_21647":59403,"_5":14929,"_28559":59378,"_3075":59404},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3699":2686,"_31384":2675,"_21647":59406,"_5":14929,"_28559":59378,"_3075":59407},[],"A working directory with restricted access for the downloaded key.",{"_3699":2687,"_31384":2675,"_21647":59409,"_5":14929,"_28559":59381,"_3075":59410},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3699":2688,"_31384":2675,"_21647":59412,"_5":14929,"_28559":59381,"_3075":59413},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3699":2689,"_31384":2675,"_21647":59415,"_5":14929,"_28559":59381,"_3075":59416},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3699":2690,"_31384":2675,"_21647":59418,"_5":14929,"_28559":59381,"_3075":59419},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3699":2691,"_31384":2675,"_21647":59421,"_5":14929,"_28559":59385,"_3075":59422},[],"File or resource",{"_3699":2692,"_31384":2675,"_21647":59424,"_5":14929,"_28559":59385,"_3075":56488},[],{"_3699":2693,"_31384":2675,"_21647":59426,"_5":14929,"_28559":59385,"_3075":59427},[],"Active root CA and `ca.pem`",{"_3699":2694,"_31384":2675,"_21647":59429,"_5":14929,"_28559":59385,"_3075":59430},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3699":2695,"_31384":2675,"_21647":59432,"_5":14929,"_28559":59385,"_3075":59433},[],"End-entity certificate and `device.crt`",{"_3699":2696,"_31384":2675,"_21647":59435,"_5":14929,"_28559":59385,"_3075":59436},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3699":2697,"_31384":2675,"_21647":59438,"_5":14929,"_28559":59385,"_3075":59439},[],"Private key `device.key`",{"_3699":2698,"_31384":2675,"_21647":59441,"_5":14929,"_28559":59385,"_3075":59442},[],"Its public key matches the one included in `device.crt`.",{"_3699":2699,"_31384":2675,"_21647":59444,"_5":14929,"_28559":59385,"_3075":59445},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3699":2700,"_31384":2675,"_21647":59447,"_5":14929,"_28559":59388,"_3075":59448},[],"To operate certificates, continue with Certificates and Validation.",{"_3699":2701,"_31384":2675,"_21647":59450,"_5":14929,"_28559":59388,"_3075":59451},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3699":2702,"_31384":2675,"_21647":59453,"_5":14929,"_28559":59388,"_3075":59454},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3699":2703,"_31384":2703,"_5":15283,"_3075":59456,"_31709":59457,"_21647":59458,"_28559":2703},"PKI troubleshooting",[51094,52635,56862,55437],[],{"_3699":2704,"_31384":2703,"_21647":59460,"_5":14929,"_28559":2703,"_3075":59461},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3699":2705,"_31384":2703,"_5":31706,"_21647":59463,"_28559":59464,"_3075":59465},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3699":2706,"_31384":2703,"_5":31706,"_21647":59467,"_28559":59468,"_3075":59469},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3699":2707,"_31384":2703,"_5":31706,"_21647":59471,"_28559":59472,"_3075":59473},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3699":2708,"_31384":2703,"_21647":59475,"_5":14929,"_28559":2703,"_3075":59476},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3699":2709,"_31384":2703,"_21647":59478,"_5":14929,"_28559":2703,"_3075":59479},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3699":2710,"_31384":2703,"_21647":59481,"_5":14929,"_28559":59464,"_3075":56488},[],{"_3699":2711,"_31384":2703,"_21647":59483,"_5":14929,"_28559":59464,"_3075":59484},[],"What to inspect",{"_3699":2712,"_31384":2703,"_21647":59486,"_5":14929,"_28559":59464,"_3075":51128},[],{"_3699":2713,"_31384":2703,"_21647":59488,"_5":14929,"_28559":59464,"_3075":55703},[],{"_3699":2714,"_31384":2703,"_21647":59490,"_5":14929,"_28559":59464,"_3075":59491},[],"Exists, is active and has usable dates.",{"_3699":2715,"_31384":2703,"_21647":59493,"_5":14929,"_28559":59464,"_3075":59494},[],"Authorities.",{"_3699":2716,"_31384":2703,"_21647":59496,"_5":14929,"_28559":59464,"_3075":59497},[],"Key",{"_3699":2717,"_31384":2703,"_21647":59499,"_5":14929,"_28559":59464,"_3075":59500},[],"The record has a usable private key and the engine can sign.",{"_3699":2718,"_31384":2703,"_21647":59502,"_5":14929,"_28559":59464,"_3075":59503},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3699":2719,"_31384":2703,"_21647":59505,"_5":14929,"_28559":59464,"_3075":59506},[],"CSR",{"_3699":2720,"_31384":2703,"_21647":59508,"_5":14929,"_28559":59464,"_3075":59509},[],"Correct PEM and verifiable signature.",{"_3699":2721,"_31384":2703,"_21647":59511,"_5":14929,"_28559":59464,"_3075":59512},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3699":2722,"_31384":2703,"_21647":59514,"_5":14929,"_28559":59464,"_3075":59515},[],"Profile",{"_3699":2723,"_31384":2703,"_21647":59517,"_5":14929,"_28559":59464,"_3075":59518},[],"Selected source, existing ID, allowed algorithm and size.",{"_3699":2724,"_31384":2703,"_21647":59520,"_5":14929,"_28559":59464,"_3075":59521},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3699":2725,"_31384":2703,"_21647":59523,"_5":14929,"_28559":59464,"_3075":56640},[],{"_3699":2726,"_31384":2703,"_21647":59525,"_5":14929,"_28559":59464,"_3075":59526},[],"Appropriate subject, SAN, usages and dates.",{"_3699":2727,"_31384":2703,"_21647":59528,"_5":14929,"_28559":59464,"_3075":59529},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3699":2728,"_31384":2703,"_21647":59531,"_5":14929,"_28559":59464,"_3075":59532},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3699":2729,"_31384":2703,"_21647":59534,"_5":14929,"_28559":59464,"_3075":59535},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3699":2730,"_31384":2703,"_21647":59537,"_5":14929,"_28559":59464,"_3075":59538},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3699":2731,"_31384":2703,"_21647":59540,"_5":14929,"_28559":59468,"_3075":59541},[],"Check each boundary independently:",{"_3699":2732,"_31384":2703,"_21647":59543,"_5":14929,"_28559":59468,"_3075":59544},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3699":2733,"_31384":2703,"_21647":59546,"_5":14929,"_28559":59468,"_3075":59547},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3699":2734,"_31384":2703,"_21647":59549,"_5":14929,"_28559":59468,"_3075":59550},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3699":2735,"_31384":2703,"_21647":59552,"_5":14929,"_28559":59468,"_3075":59553},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3699":2736,"_31384":2703,"_21647":59555,"_5":14929,"_28559":59468,"_3075":59556},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3699":2737,"_31384":2703,"_21647":59558,"_5":14929,"_28559":59468,"_3075":59559},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3699":2738,"_31384":2703,"_21647":59561,"_5":14929,"_28559":59472,"_3075":59562},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3699":2739,"_31384":2703,"_21647":59564,"_5":14929,"_28559":59472,"_3075":59565},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3699":2740,"_31384":2740,"_5":15283,"_3075":59567,"_31709":59568,"_21647":59569,"_28559":2740},"Security",[51094],[],{"_3699":2741,"_31384":2740,"_21647":59571,"_5":14929,"_28559":2740,"_3075":59572},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3699":2742,"_31384":2740,"_5":31706,"_21647":59574,"_28559":59575,"_3075":59576},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3699":2743,"_31384":2740,"_5":31706,"_21647":59578,"_28559":59579,"_3075":59580},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3699":2744,"_31384":2740,"_5":31706,"_21647":59582,"_28559":59583,"_3075":59584},[],"/docs/security#supported-versions","Supported versions",{"_3699":2745,"_31384":2740,"_5":31706,"_21647":59586,"_28559":59587,"_3075":59588},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3699":2746,"_31384":2740,"_21647":59590,"_5":14929,"_28559":2740,"_3075":59591},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3699":2747,"_31384":2740,"_21647":59593,"_5":14929,"_28559":59575,"_3075":59594},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3699":2748,"_31384":2740,"_21647":59596,"_5":14929,"_28559":59575,"_3075":59597},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3699":2749,"_31384":2740,"_21647":59599,"_5":14929,"_28559":59575,"_3075":15544},[],{"_3699":2750,"_31384":2740,"_21647":59601,"_5":14929,"_28559":59575,"_3075":15480},[],{"_3699":2751,"_31384":2740,"_21647":59603,"_5":14929,"_28559":59575,"_3075":15531},[],{"_3699":2752,"_31384":2740,"_21647":59605,"_5":14929,"_28559":59575,"_3075":59606},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3699":2753,"_31384":2740,"_21647":59608,"_5":14929,"_28559":59575,"_3075":59609},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3699":2754,"_31384":2740,"_21647":59611,"_5":14929,"_28559":59579,"_3075":59612},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3699":2755,"_31384":2740,"_21647":59614,"_5":14929,"_28559":59579,"_3075":59615},[],"Do not include in the report:",{"_3699":2756,"_31384":2740,"_21647":59617,"_5":14929,"_28559":59579,"_3075":59618},[],"Credentials, tokens, or private keys",{"_3699":2757,"_31384":2740,"_21647":59620,"_5":14929,"_28559":59579,"_3075":59621},[],"Customer data or customer-identifiable information",{"_3699":2758,"_31384":2740,"_21647":59623,"_5":14929,"_28559":59579,"_3075":59624},[],"Confidential architecture or internal infrastructure details",{"_3699":2759,"_31384":2740,"_21647":59626,"_5":14929,"_28559":59583,"_3075":59627},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3699":2760,"_31384":2740,"_21647":59629,"_5":14929,"_28559":59583,"_3075":59630},[],"For upgrade guidance, see Upgrades.",{"_3699":2761,"_31384":2740,"_21647":59632,"_5":14929,"_28559":59587,"_3075":59633},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3699":2762,"_31384":2740,"_21647":59635,"_5":14929,"_28559":59587,"_3075":59636},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3699":2763,"_31384":2740,"_21647":59638,"_5":14929,"_28559":59587,"_3075":59639},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3699":2764,"_31384":2740,"_21647":59641,"_5":14929,"_28559":59587,"_3075":59642},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3699":2765,"_31384":2740,"_21647":59644,"_5":14929,"_28559":59587,"_3075":59645},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3699":2766,"_31384":2766,"_5":15283,"_3075":59647,"_31709":59648,"_21647":59650,"_28559":2766},"3.8.0 to 4.0.0",[51094,59649],"Upgrades",[],{"_3699":2767,"_31384":2766,"_21647":59652,"_5":14929,"_28559":2766,"_3075":59653},[],"What changes in 4.0.0, which changes break 3.8.0 API clients, event consumers and devices, how to upgrade a Helm release step by step and how to validate the result.",{"_3699":2768,"_31384":2766,"_5":31706,"_21647":59655,"_28559":59656,"_3075":59657},[],"/docs/upgrades/3-8-0-to-4-0-0#changes","Changes",{"_3699":2769,"_31384":2766,"_5":31706,"_21647":59659,"_28559":59660,"_3075":59661},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3699":2770,"_31384":2766,"_5":31706,"_21647":59663,"_28559":59664,"_3075":59665},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-deployment","Helm chart and deployment",{"_3699":2771,"_31384":2766,"_5":31706,"_21647":59667,"_28559":59668,"_3075":59669},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3699":2772,"_31384":2766,"_5":31706,"_21647":59671,"_28559":59672,"_3075":59673},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3699":2773,"_31384":2766,"_5":31706,"_21647":59675,"_28559":59676,"_3075":59677},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3699":2774,"_31384":2766,"_5":31706,"_21647":59679,"_28559":59680,"_3075":59681},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3699":2775,"_31384":2766,"_5":31706,"_21647":59683,"_28559":59684,"_3075":51732},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3699":2776,"_31384":2766,"_5":31706,"_21647":59686,"_28559":59687,"_3075":59688},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3699":2777,"_31384":2766,"_5":31706,"_21647":59690,"_28559":59691,"_3075":59692},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3699":2778,"_31384":2766,"_5":31706,"_21647":59694,"_28559":59695,"_3075":57593},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization",{"_3699":2779,"_31384":2766,"_5":31706,"_21647":59697,"_28559":59698,"_3075":59699},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3699":2780,"_31384":2766,"_5":31706,"_21647":59701,"_28559":59702,"_3075":59703},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3699":2781,"_31384":2766,"_5":31706,"_21647":59705,"_28559":59706,"_3075":59707},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3699":2782,"_31384":2766,"_5":31706,"_21647":59709,"_28559":59710,"_3075":59711},[],"/docs/upgrades/3-8-0-to-4-0-0#storage-and-data","Storage and data",{"_3699":2783,"_31384":2766,"_5":31706,"_21647":59713,"_28559":59714,"_3075":59715},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3699":2784,"_31384":2766,"_5":31706,"_21647":59717,"_28559":59718,"_3075":59719},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3699":2785,"_31384":2766,"_5":31706,"_21647":59721,"_28559":59722,"_3075":59723},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3699":2786,"_31384":2766,"_5":31706,"_21647":59725,"_28559":59726,"_3075":59727},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3699":2787,"_31384":2766,"_5":31706,"_21647":59729,"_28559":59730,"_3075":59731},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-migration","CRL settings migration",{"_3699":2788,"_31384":2766,"_5":31706,"_21647":59733,"_28559":59734,"_3075":59735},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3699":2789,"_31384":2766,"_5":31706,"_21647":59737,"_28559":59738,"_3075":59739},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3699":2790,"_31384":2766,"_5":31706,"_21647":59741,"_28559":59742,"_3075":55381},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-configuration",{"_3699":2791,"_31384":2766,"_5":31706,"_21647":59744,"_28559":59745,"_3075":59746},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3699":2792,"_31384":2766,"_5":31706,"_21647":59748,"_28559":59749,"_3075":59750},[],"/docs/upgrades/3-8-0-to-4-0-0#webhook-receiver-certificate-verification","Webhook receiver certificate verification",{"_3699":2793,"_31384":2766,"_5":31706,"_21647":59752,"_28559":59753,"_3075":59754},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3699":2794,"_31384":2766,"_5":31706,"_21647":59756,"_28559":59757,"_3075":59758},[],"/docs/upgrades/3-8-0-to-4-0-0#api-and-sdk","API and SDK",{"_3699":2795,"_31384":2766,"_5":31706,"_21647":59760,"_28559":59761,"_3075":59762},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3699":2796,"_31384":2766,"_5":31706,"_21647":59764,"_28559":59765,"_3075":59766},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3699":2797,"_31384":2766,"_5":31706,"_21647":59768,"_28559":59769,"_3075":59770},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3699":2798,"_31384":2766,"_5":31706,"_21647":59772,"_28559":59773,"_3075":59774},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3699":2799,"_31384":2766,"_5":31706,"_21647":59776,"_28559":59777,"_3075":59778},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3699":2800,"_31384":2766,"_5":31706,"_21647":59780,"_28559":59781,"_3075":59782},[],"/docs/upgrades/3-8-0-to-4-0-0#conflicting-kms-key-aliases","Conflicting KMS key aliases",{"_3699":2801,"_31384":2766,"_5":31706,"_21647":59784,"_28559":59785,"_3075":59786},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3699":2802,"_31384":2766,"_5":31706,"_21647":59788,"_28559":59789,"_3075":59790},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3699":2803,"_31384":2766,"_5":31706,"_21647":59792,"_28559":59793,"_3075":59794},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3699":2804,"_31384":2766,"_5":31706,"_21647":59796,"_28559":59797,"_3075":59798},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3699":2805,"_31384":2766,"_5":31706,"_21647":59800,"_28559":59801,"_3075":59802},[],"/docs/upgrades/3-8-0-to-4-0-0#events","Events",{"_3699":2806,"_31384":2766,"_5":31706,"_21647":59804,"_28559":59805,"_3075":59806},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3699":2807,"_31384":2766,"_5":31706,"_21647":59808,"_28559":59809,"_3075":59810},[],"/docs/upgrades/3-8-0-to-4-0-0#enrollment-behavior","Enrollment behavior",{"_3699":2808,"_31384":2766,"_5":31706,"_21647":59812,"_28559":59813,"_3075":59814},[],"/docs/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3699":2809,"_31384":2766,"_5":31706,"_21647":59816,"_28559":59817,"_3075":59818},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3699":2810,"_31384":2766,"_5":31706,"_21647":59820,"_28559":59821,"_3075":59822},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3699":2811,"_31384":2766,"_5":31706,"_21647":59824,"_28559":59825,"_3075":59826},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3699":2812,"_31384":2766,"_5":31706,"_21647":59828,"_28559":59829,"_3075":59830},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3699":2813,"_31384":2766,"_5":31706,"_21647":59832,"_28559":59833,"_3075":59834},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3699":2814,"_31384":2766,"_5":31706,"_21647":59836,"_28559":59837,"_3075":59838},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3699":2815,"_31384":2766,"_5":31706,"_21647":59840,"_28559":59841,"_3075":59842},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3699":2816,"_31384":2766,"_5":31706,"_21647":59844,"_28559":59845,"_3075":59846},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3699":2817,"_31384":2766,"_5":31706,"_21647":59848,"_28559":59849,"_3075":55437},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3699":2818,"_31384":2766,"_5":31706,"_21647":59851,"_28559":59852,"_3075":59853},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3699":2819,"_31384":2766,"_5":31706,"_21647":59855,"_28559":59856,"_3075":59857},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3699":2820,"_31384":2766,"_21647":59859,"_5":14929,"_28559":2766,"_3075":59860},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3699":2821,"_31384":2766,"_21647":59862,"_5":14929,"_28559":2766,"_3075":59863},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3699":2822,"_31384":2766,"_21647":59865,"_5":14929,"_28559":2766,"_3075":59866},[],"Changes: what is different in the deployment, the storage and the stored data, what the upgrade migrates on its own and which of these changes need your action.",{"_3699":2823,"_31384":2766,"_21647":59868,"_5":14929,"_28559":2766,"_3075":59869},[],"Breaking changes: changes to the API, the events and the behavior that clients, integrations and devices rely on, who each one affects and what to do.",{"_3699":2824,"_31384":2766,"_21647":59871,"_5":14929,"_28559":2766,"_3075":59872},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3699":2825,"_31384":2766,"_21647":59874,"_5":14929,"_28559":2766,"_3075":59875},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3699":2826,"_31384":2766,"_21647":59877,"_5":14929,"_28559":2766,"_3075":59878},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3699":2827,"_31384":2766,"_21647":59880,"_5":14929,"_28559":59656,"_3075":59881},[],"These changes alter how Lamassu is deployed, where it stores its data and how that data is converted. They do not change the API or the events: what clients, integrations and devices have to adapt to is listed under Breaking changes. Most of these changes are applied by the upgrade itself; the ones that need operator action say so, and the Helm migration guide performs that action in order.",{"_3699":2828,"_31384":2766,"_21647":59883,"_5":14929,"_28559":59660,"_3075":59884},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3699":2829,"_31384":2766,"_21647":59886,"_5":14929,"_28559":59660,"_3075":59887},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3699":2830,"_31384":2766,"_21647":59889,"_5":14929,"_28559":59660,"_3075":59890},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3699":2831,"_31384":2766,"_21647":59892,"_5":14929,"_28559":59660,"_3075":59893},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata and the aliases that equal an existing key ID (see Conflicting KMS key aliases). The VA migration turns each VA role into the CRL settings of its CA and resolves its CRL signer (see CRL settings migration).",{"_3699":2832,"_31384":2766,"_21647":59895,"_5":14929,"_28559":59660,"_3075":59896},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3699":2833,"_31384":2766,"_21647":59898,"_5":14929,"_28559":59660,"_3075":59899},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3699":2834,"_31384":2766,"_21647":59901,"_5":14929,"_28559":59668,"_3075":59902},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3699":2835,"_31384":2766,"_21647":59904,"_5":14929,"_28559":59668,"_3075":59905},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3699":2836,"_31384":2766,"_21647":59907,"_5":14929,"_28559":59668,"_3075":59908},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` and existing volumes must be accessible to that identity.",{"_3699":2837,"_31384":2766,"_21647":59910,"_5":14929,"_28559":59668,"_3075":59911},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3699":2838,"_31384":2766,"_21647":59913,"_5":14929,"_28559":59668,"_3075":59914},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3699":2839,"_31384":2766,"_21647":59916,"_5":14929,"_28559":59672,"_3075":59917},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3699":2840,"_31384":2766,"_21647":59919,"_5":14929,"_28559":59672,"_3075":59920},[],"Step 4 of the migration guide copies the data.",{"_3699":2841,"_31384":2766,"_21647":59922,"_5":14929,"_28559":59676,"_3075":59923},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3699":2842,"_31384":2766,"_21647":59925,"_5":14929,"_28559":59676,"_3075":59926},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3699":2843,"_31384":2766,"_21647":59928,"_5":14929,"_28559":59676,"_3075":59929},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3699":2844,"_31384":2766,"_21647":59931,"_5":14929,"_28559":59680,"_3075":59932},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3699":2845,"_31384":2766,"_21647":59934,"_5":14929,"_28559":59684,"_3075":59935},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3699":2846,"_31384":2766,"_21647":59937,"_5":14929,"_28559":59684,"_3075":59938},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3699":2847,"_31384":2766,"_21647":59940,"_5":14929,"_28559":59687,"_3075":59941},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3699":2848,"_31384":2766,"_21647":59943,"_5":14929,"_28559":59687,"_3075":59944},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3699":2849,"_31384":2766,"_21647":59946,"_5":14929,"_28559":59687,"_3075":59947},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3699":2850,"_31384":2766,"_21647":59949,"_5":14929,"_28559":59687,"_3075":59950},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3699":2851,"_31384":2766,"_21647":59952,"_5":14929,"_28559":59687,"_3075":59953},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3699":2852,"_31384":2766,"_21647":59955,"_5":14929,"_28559":59687,"_3075":59956},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3699":2853,"_31384":2766,"_21647":59958,"_5":14929,"_28559":59691,"_3075":59959},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3699":2854,"_31384":2766,"_21647":59961,"_5":14929,"_28559":59698,"_3075":59962},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3699":2855,"_31384":2766,"_21647":59964,"_5":14929,"_28559":59698,"_3075":59965},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3699":2856,"_31384":2766,"_21647":59967,"_5":14929,"_28559":59702,"_3075":59968},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3699":2857,"_31384":2766,"_21647":59970,"_5":14929,"_28559":59706,"_3075":59971},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3699":2858,"_31384":2766,"_21647":59973,"_5":14929,"_28559":59714,"_3075":59974},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3699":2859,"_31384":2766,"_21647":59976,"_5":14929,"_28559":59714,"_3075":59977},[],"PostgreSQL is now the only storage engine. The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3699":2860,"_31384":2766,"_21647":59979,"_5":14929,"_28559":59718,"_3075":59980},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3699":2861,"_31384":2766,"_21647":59982,"_5":14929,"_28559":59718,"_3075":59983},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3699":2862,"_31384":2766,"_21647":59985,"_5":14929,"_28559":59718,"_3075":59986},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3699":2863,"_31384":2766,"_21647":59988,"_5":14929,"_28559":59718,"_3075":59989},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3699":2864,"_31384":2766,"_21647":59991,"_5":14929,"_28559":59722,"_3075":59992},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3699":2865,"_31384":2766,"_21647":59994,"_5":14929,"_28559":59722,"_3075":59995},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3699":2866,"_31384":2766,"_21647":59997,"_5":14929,"_28559":59722,"_3075":59998},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3699":2867,"_31384":2766,"_21647":60000,"_5":14929,"_28559":59722,"_3075":60001},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3699":2868,"_31384":2766,"_21647":60003,"_5":14929,"_28559":59722,"_3075":60004},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3699":2869,"_31384":2766,"_21647":60006,"_5":14929,"_28559":59722,"_3075":60007},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3699":2870,"_31384":2766,"_21647":60009,"_5":14929,"_28559":59722,"_3075":60010},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3699":2871,"_31384":2766,"_21647":60012,"_5":14929,"_28559":59722,"_3075":60013},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3699":2872,"_31384":2766,"_21647":60015,"_5":14929,"_28559":59726,"_3075":60016},[],"The migration removes the legacy `lamassu.io/kms/binded-resources` metadata and registers missing keys needed by retained certificate references in the KMS with their public key only. These entries do not recover the private key. See Key management and CRL for reference behavior.",{"_3699":2873,"_31384":2766,"_21647":60018,"_5":14929,"_28559":59730,"_3075":60019},[],"The VA migration turns each 3.8.0 VA role, keyed by the CA's SKI, into the CRL settings of a CA, keyed by its CA ID. Every CA gets its own settings, even when two CAs share a key. CRL settings keyed by CA ID describes what changes for API clients.",{"_3699":2874,"_31384":2766,"_21647":60021,"_5":14929,"_28559":59730,"_3075":60022},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3699":2875,"_31384":2766,"_21647":60024,"_5":14929,"_28559":59730,"_3075":60025},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3699":2876,"_31384":2766,"_21647":60027,"_5":14929,"_28559":59730,"_3075":60028},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3699":2877,"_31384":2766,"_21647":60030,"_5":14929,"_28559":59730,"_3075":60031},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3699":2878,"_31384":2766,"_21647":60033,"_5":14929,"_28559":59730,"_3075":60034},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3699":2879,"_31384":2766,"_21647":60036,"_5":14929,"_28559":59730,"_3075":60037},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3699":2880,"_31384":2766,"_21647":60039,"_5":14929,"_28559":59730,"_3075":60040},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3699":2881,"_31384":2766,"_21647":60042,"_5":14929,"_28559":59730,"_3075":60043},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3699":2882,"_31384":2766,"_21647":60045,"_5":14929,"_28559":59734,"_3075":60046},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3699":2883,"_31384":2766,"_21647":60048,"_5":14929,"_28559":59738,"_3075":60049},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. See Device events to adapt consumers.",{"_3699":2884,"_31384":2766,"_21647":60051,"_5":14929,"_28559":59745,"_3075":60052},[],"Re-enrollment authentication settings are independent of initial enrollment settings; no migration is required. See Authentication per operation.",{"_3699":2885,"_31384":2766,"_21647":60054,"_5":14929,"_28559":59749,"_3075":60055},[],"A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3699":2886,"_31384":2766,"_21647":60057,"_5":14929,"_28559":59753,"_3075":60058},[],"These changes alter the contract that 3.8.0 clients rely on: REST API endpoints and fields, Go SDK methods, the events the services publish, and the behavior devices see during enrollment. Clients, integrations and devices built against 3.8.0 have to adapt to them. Each one affects only the integrations that use what changed; check the “Who is affected” column. Changes to the deployment, the storage and the stored data are under Changes, even when they need action during the upgrade.",{"_3699":2887,"_31384":2766,"_21647":60060,"_5":14929,"_28559":59753,"_3075":60061},[],"Change",{"_3699":2888,"_31384":2766,"_21647":60063,"_5":14929,"_28559":59753,"_3075":60064},[],"Who is affected",{"_3699":2889,"_31384":2766,"_21647":60066,"_5":14929,"_28559":59753,"_3075":60067},[],"Severity",{"_3699":2890,"_31384":2766,"_21647":60069,"_5":14929,"_28559":59753,"_3075":58331},[],{"_3699":2891,"_31384":2766,"_21647":60071,"_5":14929,"_28559":59753,"_3075":59762},[],{"_3699":2892,"_31384":2766,"_21647":60073,"_5":14929,"_28559":59753,"_3075":60074},[],"Clients of `/v1/roles`, custom authorization policies on `va_role`, and verifiers of certificates issued after the upgrade",{"_3699":2893,"_31384":2766,"_21647":60076,"_5":14929,"_28559":59753,"_3075":60077},[],"High: the `/v1/roles` routes are removed",{"_3699":2894,"_31384":2766,"_21647":60079,"_5":14929,"_28559":59753,"_3075":60080},[],"Move clients to `/v1/crl-settings` with the CA ID and update the policies",{"_3699":2895,"_31384":2766,"_21647":60082,"_5":14929,"_28559":59753,"_3075":59786},[],{"_3699":2896,"_31384":2766,"_21647":60084,"_5":14929,"_28559":59753,"_3075":60085},[],"Clients that read or write webhook configs through the API, and DMSs whose webhook mTLS certificate or key were file paths",{"_3699":2897,"_31384":2766,"_21647":60087,"_5":14929,"_28559":59753,"_3075":60088},[],"High: enrollments calling a webhook with file references fail",{"_3699":2898,"_31384":2766,"_21647":60090,"_5":14929,"_28559":59753,"_3075":60091},[],"Use the new field names; re-enter certificate and key as PEM, or remove the file fields",{"_3699":2899,"_31384":2766,"_21647":60093,"_5":14929,"_28559":59753,"_3075":59814},[],{"_3699":2900,"_31384":2766,"_21647":60095,"_5":14929,"_28559":59753,"_3075":60096},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3699":2901,"_31384":2766,"_21647":60098,"_5":14929,"_28559":59753,"_3075":60099},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3699":2902,"_31384":2766,"_21647":60101,"_5":14929,"_28559":59753,"_3075":60102},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3699":2903,"_31384":2766,"_21647":60104,"_5":14929,"_28559":59753,"_3075":59790},[],{"_3699":2904,"_31384":2766,"_21647":60106,"_5":14929,"_28559":59753,"_3075":60107},[],"Scripts and consoles that edit DMSs through the API",{"_3699":2905,"_31384":2766,"_21647":60109,"_5":14929,"_28559":59753,"_3075":60110},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3699":2906,"_31384":2766,"_21647":60112,"_5":14929,"_28559":59753,"_3075":60113},[],"Read the DMS before editing and use the new field",{"_3699":2907,"_31384":2766,"_21647":60115,"_5":14929,"_28559":59753,"_3075":59766},[],{"_3699":2908,"_31384":2766,"_21647":60117,"_5":14929,"_28559":59753,"_3075":60118},[],"Clients that create or update CRL settings through the API",{"_3699":2909,"_31384":2766,"_21647":60120,"_5":14929,"_28559":59753,"_3075":60121},[],"Medium: requests with the old field return an error",{"_3699":2910,"_31384":2766,"_21647":60123,"_5":14929,"_28559":59753,"_3075":60124},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3699":2911,"_31384":2766,"_21647":60126,"_5":14929,"_28559":59753,"_3075":59806},[],{"_3699":2912,"_31384":2766,"_21647":60128,"_5":14929,"_28559":59753,"_3075":60129},[],"Alert subscriptions and consumers of the VA events",{"_3699":2913,"_31384":2766,"_21647":60131,"_5":14929,"_28559":59753,"_3075":60132},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3699":2914,"_31384":2766,"_21647":60134,"_5":14929,"_28559":59753,"_3075":60135},[],"Review conditions filtering on the old event payload or subject",{"_3699":2915,"_31384":2766,"_21647":60137,"_5":14929,"_28559":59753,"_3075":59770},[],{"_3699":2916,"_31384":2766,"_21647":60139,"_5":14929,"_28559":59753,"_3075":60140},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3699":2917,"_31384":2766,"_21647":60142,"_5":14929,"_28559":59753,"_3075":60143},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3699":2918,"_31384":2766,"_21647":60145,"_5":14929,"_28559":59753,"_3075":60146},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3699":2919,"_31384":2766,"_21647":60148,"_5":14929,"_28559":59753,"_3075":59798},[],{"_3699":2920,"_31384":2766,"_21647":60150,"_5":14929,"_28559":59753,"_3075":60151},[],"Consumers that read the device `events` field",{"_3699":2921,"_31384":2766,"_21647":60153,"_5":14929,"_28559":59753,"_3075":60154},[],"Medium: the field disappears",{"_3699":2922,"_31384":2766,"_21647":60156,"_5":14929,"_28559":59753,"_3075":60157},[],"Use the new event endpoints",{"_3699":2923,"_31384":2766,"_21647":60159,"_5":14929,"_28559":59753,"_3075":59782},[],{"_3699":2924,"_31384":2766,"_21647":60161,"_5":14929,"_28559":59753,"_3075":60162},[],"Clients using an alias equal to an existing key ID",{"_3699":2925,"_31384":2766,"_21647":60164,"_5":14929,"_28559":59753,"_3075":60165},[],"Medium: the alias is removed and the ID takes precedence",{"_3699":2926,"_31384":2766,"_21647":60167,"_5":14929,"_28559":59753,"_3075":60168},[],"Review and update affected references",{"_3699":2927,"_31384":2766,"_21647":60170,"_5":14929,"_28559":59753,"_3075":59794},[],{"_3699":2928,"_31384":2766,"_21647":60172,"_5":14929,"_28559":59753,"_3075":60173},[],"Clients that send the DMS ID in the update body",{"_3699":2929,"_31384":2766,"_21647":60175,"_5":14929,"_28559":59753,"_3075":60176},[],"Low: the ID in the URL wins",{"_3699":2930,"_31384":2766,"_21647":60178,"_5":14929,"_28559":59753,"_3075":60179},[],"Send the ID in the URL",{"_3699":2931,"_31384":2766,"_21647":60181,"_5":14929,"_28559":59753,"_3075":59774},[],{"_3699":2932,"_31384":2766,"_21647":60183,"_5":14929,"_28559":59753,"_3075":60184},[],"Clients that send an `id` when creating or importing CAs",{"_3699":2933,"_31384":2766,"_21647":60186,"_5":14929,"_28559":59753,"_3075":60187},[],"Low: the ID in the body is ignored, and the field is removed",{"_3699":2934,"_31384":2766,"_21647":60189,"_5":14929,"_28559":59753,"_3075":60190},[],"Let the backend assign the ID and use the returned one",{"_3699":2935,"_31384":2766,"_21647":60192,"_5":14929,"_28559":59753,"_3075":59778},[],{"_3699":2936,"_31384":2766,"_21647":60194,"_5":14929,"_28559":59753,"_3075":60195},[],"Consumers that match on certificate `type`",{"_3699":2937,"_31384":2766,"_21647":60197,"_5":14929,"_28559":59753,"_3075":60198},[],"Low: two values are renamed",{"_3699":2938,"_31384":2766,"_21647":60200,"_5":14929,"_28559":59753,"_3075":60201},[],"Adapt consumers",{"_3699":2939,"_31384":2766,"_21647":60203,"_5":14929,"_28559":59761,"_3075":60204},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key.",{"_3699":2940,"_31384":2766,"_21647":60206,"_5":14929,"_28559":59761,"_3075":60207},[],"Adapt clients of `/v1/roles` to `/v1/crl-settings` using the CA ID. The CRL guide describes the operations and options.",{"_3699":2941,"_31384":2766,"_21647":60209,"_5":14929,"_28559":59761,"_3075":60210},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3699":2942,"_31384":2766,"_21647":60212,"_5":14929,"_28559":59761,"_3075":60213},[],"CRL settings migration describes how the upgrade converts the stored roles, the data it aborts on and why it cannot be rolled back.",{"_3699":2943,"_31384":2766,"_21647":60215,"_5":14929,"_28559":59761,"_3075":60216},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3699":2944,"_31384":2766,"_21647":60218,"_5":14929,"_28559":59765,"_3075":60219},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3699":2945,"_31384":2766,"_21647":60221,"_5":14929,"_28559":59769,"_3075":60222},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3699":2946,"_31384":2766,"_21647":60224,"_5":14929,"_28559":59773,"_3075":60225},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3699":2947,"_31384":2766,"_21647":60227,"_5":14929,"_28559":59777,"_3075":60228},[],"The certificate `type` values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Stored values are converted by the upgrade; adapt consumers that read or match on those values.",{"_3699":2948,"_31384":2766,"_21647":60230,"_5":14929,"_28559":59781,"_3075":60231},[],"KMS identifiers now resolve as a key ID before an alias. The KMS migration therefore deletes, with a `NOTICE`, aliases that equal an existing key ID. Affected aliases are dropped, not redirected: a client that used one now reaches the key with that ID.",{"_3699":2949,"_31384":2766,"_21647":60233,"_5":14929,"_28559":59785,"_3075":60234},[],"Webhook configs change layout and their fields are renamed. Stored configs are rewritten by the upgrade; API clients that read or write them must use the new names:",{"_3699":2950,"_31384":2766,"_21647":60236,"_5":14929,"_28559":59785,"_3075":60237},[],"Field in 3.8.0",{"_3699":2951,"_31384":2766,"_21647":60239,"_5":14929,"_28559":59785,"_3075":60240},[],"Field in 4.0.0",{"_3699":2952,"_31384":2766,"_21647":60242,"_5":14929,"_28559":59785,"_3075":60243},[],"`validate_server_cert`",{"_3699":2953,"_31384":2766,"_21647":60245,"_5":14929,"_28559":59785,"_3075":60246},[],"`insecure_skip_verify` (value negated)",{"_3699":2954,"_31384":2766,"_21647":60248,"_5":14929,"_28559":59785,"_3075":60249},[],"`oidc`",{"_3699":2955,"_31384":2766,"_21647":60251,"_5":14929,"_28559":59785,"_3075":60252},[],"`jwt_options`",{"_3699":2956,"_31384":2766,"_21647":60254,"_5":14929,"_28559":59785,"_3075":60255},[],"`apikey`",{"_3699":2957,"_31384":2766,"_21647":60257,"_5":14929,"_28559":59785,"_3075":60258},[],"`apikey_options`",{"_3699":2958,"_31384":2766,"_21647":60260,"_5":14929,"_28559":59785,"_3075":60261},[],"`mtls`",{"_3699":2959,"_31384":2766,"_21647":60263,"_5":14929,"_28559":59785,"_3075":60264},[],"`mtls_options`",{"_3699":2960,"_31384":2766,"_21647":60266,"_5":14929,"_28559":59785,"_3075":60267},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. File references do require action; also review receiver verification.",{"_3699":2961,"_31384":2766,"_21647":60269,"_5":14929,"_28559":59785,"_3075":60270},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3699":2962,"_31384":2766,"_21647":60272,"_5":14929,"_28559":59789,"_3075":60273},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3699":2963,"_31384":2766,"_21647":60275,"_5":14929,"_28559":59789,"_3075":60276},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3699":2964,"_31384":2766,"_21647":60278,"_5":14929,"_28559":59789,"_3075":60279},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3699":2965,"_31384":2766,"_21647":60281,"_5":14929,"_28559":59793,"_3075":60282},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3699":2966,"_31384":2766,"_21647":60284,"_5":14929,"_28559":59797,"_3075":60285},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3699":2967,"_31384":2766,"_21647":60287,"_5":14929,"_28559":59797,"_3075":60288},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3699":2968,"_31384":2766,"_21647":60290,"_5":14929,"_28559":59797,"_3075":60291},[],"`POST /v1/devices/:id/events` creates an event.",{"_3699":2969,"_31384":2766,"_21647":60293,"_5":14929,"_28559":59797,"_3075":60294},[],"The endpoint also supports SSE. See Events API and live stream.",{"_3699":2970,"_31384":2766,"_21647":60296,"_5":14929,"_28559":59801,"_3075":60297},[],"Two changes affect alert subscriptions and event-bus consumers: the VA events are renamed and reshaped, and `ca.sign.signature` is no longer published because the CA no longer signs arbitrary data (see CA signature endpoints removed).",{"_3699":2971,"_31384":2766,"_21647":60299,"_5":14929,"_28559":59805,"_3075":60300},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3699":2972,"_31384":2766,"_21647":60302,"_5":14929,"_28559":59813,"_3075":60303},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3699":2973,"_31384":2766,"_21647":60305,"_5":14929,"_28559":59813,"_3075":60306},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3699":2974,"_31384":2766,"_21647":60308,"_5":14929,"_28559":59817,"_3075":60309},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3699":2975,"_31384":2766,"_21647":60311,"_5":14929,"_28559":59821,"_3075":60312},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings migration).",{"_3699":2976,"_31384":2766,"_21647":60314,"_5":14929,"_28559":59821,"_3075":60315},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3699":2977,"_31384":2766,"_21647":60317,"_5":14929,"_28559":59821,"_3075":60318},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3699":2978,"_31384":2766,"_21647":60320,"_5":14929,"_28559":59821,"_3075":60321},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3699":2979,"_31384":2766,"_21647":60323,"_5":14929,"_28559":59821,"_3075":60324},[],"Record the names of your local-storage PVCs:",{"_3699":2980,"_31384":2766,"_21647":60326,"_5":14929,"_28559":59821,"_3075":60327},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3699":2981,"_31384":2766,"_21647":60329,"_5":14929,"_28559":59825,"_3075":60330},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3699":2982,"_31384":2766,"_21647":60332,"_5":14929,"_28559":59825,"_3075":60333},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3699":2983,"_31384":2766,"_21647":60335,"_5":14929,"_28559":59825,"_3075":60336},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3699":2984,"_31384":2766,"_21647":60338,"_5":14929,"_28559":59825,"_3075":60339},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3699":2985,"_31384":2766,"_21647":60341,"_5":14929,"_28559":59825,"_3075":60342},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3699":2986,"_31384":2766,"_21647":60344,"_5":14929,"_28559":59829,"_3075":60345},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3699":2987,"_31384":2766,"_21647":60347,"_5":14929,"_28559":59829,"_3075":60348},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3699":2988,"_31384":2766,"_21647":60350,"_5":14929,"_28559":59829,"_3075":60351},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3699":2989,"_31384":2766,"_21647":60353,"_5":14929,"_28559":59829,"_3075":60354},[],"Secret (`existingSecret`)",{"_3699":2990,"_31384":2766,"_21647":60356,"_5":14929,"_28559":59829,"_3075":60357},[],"Required data keys",{"_3699":2991,"_31384":2766,"_21647":60359,"_5":14929,"_28559":59829,"_3075":60360},[],"When",{"_3699":2992,"_31384":2766,"_21647":60362,"_5":14929,"_28559":59829,"_3075":60363},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3699":2993,"_31384":2766,"_21647":60365,"_5":14929,"_28559":59829,"_3075":60366},[],"`username`, `password`",{"_3699":2994,"_31384":2766,"_21647":60368,"_5":14929,"_28559":59829,"_3075":60369},[],"Always",{"_3699":2995,"_31384":2766,"_21647":60371,"_5":14929,"_28559":59829,"_3075":60372},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3699":2996,"_31384":2766,"_21647":60374,"_5":14929,"_28559":59829,"_3075":60366},[],{"_3699":2997,"_31384":2766,"_21647":60376,"_5":14929,"_28559":59829,"_3075":60369},[],{"_3699":2998,"_31384":2766,"_21647":60378,"_5":14929,"_28559":59829,"_3075":60379},[],"`services.alerts.smtp_server.existingSecret`",{"_3699":2999,"_31384":2766,"_21647":60381,"_5":14929,"_28559":59829,"_3075":60366},[],{"_3699":3000,"_31384":2766,"_21647":60383,"_5":14929,"_28559":59829,"_3075":60384},[],"Only when SMTP authentication is enabled",{"_3699":3001,"_31384":2766,"_21647":60386,"_5":14929,"_28559":59829,"_3075":60387},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3699":3002,"_31384":2766,"_21647":60389,"_5":14929,"_28559":59829,"_3075":60390},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3699":3003,"_31384":2766,"_21647":60392,"_5":14929,"_28559":59829,"_3075":60393},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3699":3004,"_31384":2766,"_21647":60395,"_5":14929,"_28559":59829,"_3075":60396},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3699":3005,"_31384":2766,"_21647":60398,"_5":14929,"_28559":59829,"_3075":60399},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3699":3006,"_31384":2766,"_21647":60401,"_5":14929,"_28559":59829,"_3075":60402},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3699":3007,"_31384":2766,"_21647":60404,"_5":14929,"_28559":59829,"_3075":60405},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3699":3008,"_31384":2766,"_21647":60407,"_5":14929,"_28559":59829,"_3075":60408},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3699":3009,"_31384":2766,"_21647":60410,"_5":14929,"_28559":59829,"_3075":60411},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3699":3010,"_31384":2766,"_21647":60413,"_5":14929,"_28559":59829,"_3075":60414},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3699":3011,"_31384":2766,"_21647":60416,"_5":14929,"_28559":59829,"_3075":60417},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3699":3012,"_31384":2766,"_21647":60419,"_5":14929,"_28559":59829,"_3075":60420},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3699":3013,"_31384":2766,"_21647":60422,"_5":14929,"_28559":59829,"_3075":60423},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3699":3014,"_31384":2766,"_21647":60425,"_5":14929,"_28559":59829,"_3075":60426},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3699":3015,"_31384":2766,"_21647":60428,"_5":14929,"_28559":59829,"_3075":60429},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3699":3016,"_31384":2766,"_21647":60431,"_5":14929,"_28559":59833,"_3075":60432},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3699":3017,"_31384":2766,"_21647":60434,"_5":14929,"_28559":59833,"_3075":60435},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3699":3018,"_31384":2766,"_21647":60437,"_5":14929,"_28559":59837,"_3075":60438},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3699":3019,"_31384":2766,"_21647":60440,"_5":14929,"_28559":59837,"_3075":60441},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3699":3020,"_31384":2766,"_21647":60443,"_5":14929,"_28559":59837,"_3075":60444},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3699":3021,"_31384":2766,"_21647":60446,"_5":14929,"_28559":59837,"_3075":60447},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3699":3022,"_31384":2766,"_21647":60449,"_5":14929,"_28559":59837,"_3075":60450},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3699":3023,"_31384":2766,"_21647":60452,"_5":14929,"_28559":59837,"_3075":60453},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3699":3024,"_31384":2766,"_21647":60455,"_5":14929,"_28559":59837,"_3075":60456},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3699":3025,"_31384":2766,"_21647":60458,"_5":14929,"_28559":59837,"_3075":60459},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3699":3026,"_31384":2766,"_21647":60461,"_5":14929,"_28559":59837,"_3075":60462},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3699":3027,"_31384":2766,"_21647":60464,"_5":14929,"_28559":59837,"_3075":60465},[],"**Remove the helper and restore the recorded replica counts:**",{"_3699":3028,"_31384":2766,"_21647":60467,"_5":14929,"_28559":59837,"_3075":60468},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3699":3029,"_31384":2766,"_21647":60470,"_5":14929,"_28559":59841,"_3075":60471},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3699":3030,"_31384":2766,"_21647":60473,"_5":14929,"_28559":59841,"_3075":60474},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3699":3031,"_31384":2766,"_21647":60476,"_5":14929,"_28559":59845,"_3075":60477},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3699":3032,"_31384":2766,"_21647":60479,"_5":14929,"_28559":59845,"_3075":60480},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3699":3033,"_31384":2766,"_21647":60482,"_5":14929,"_28559":59845,"_3075":60483},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3699":3034,"_31384":2766,"_21647":60485,"_5":14929,"_28559":59845,"_3075":60486},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3699":3035,"_31384":2766,"_21647":60488,"_5":14929,"_28559":59845,"_3075":60489},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3699":3036,"_31384":2766,"_21647":60491,"_5":14929,"_28559":59845,"_3075":60492},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3699":3037,"_31384":2766,"_21647":60494,"_5":14929,"_28559":59845,"_3075":60495},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3699":3038,"_31384":2766,"_21647":60497,"_5":14929,"_28559":59845,"_3075":60498},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3699":3039,"_31384":2766,"_21647":60500,"_5":14929,"_28559":59849,"_3075":60501},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3699":3040,"_31384":2766,"_21647":60503,"_5":14929,"_28559":59849,"_3075":60504},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3699":3041,"_31384":2766,"_21647":60506,"_5":14929,"_28559":59849,"_3075":60507},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3699":3042,"_31384":2766,"_21647":60509,"_5":14929,"_28559":59849,"_3075":60510},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3699":3043,"_31384":2766,"_21647":60512,"_5":14929,"_28559":59849,"_3075":60513},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3699":3044,"_31384":2766,"_21647":60515,"_5":14929,"_28559":59849,"_3075":60516},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3699":3045,"_31384":2766,"_21647":60518,"_5":14929,"_28559":59849,"_3075":60519},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3699":3046,"_31384":2766,"_21647":60521,"_5":14929,"_28559":59849,"_3075":60522},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3699":3047,"_31384":2766,"_21647":60524,"_5":14929,"_28559":59849,"_3075":60525},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3699":3048,"_31384":2766,"_21647":60527,"_5":14929,"_28559":59849,"_3075":60528},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3699":3049,"_31384":2766,"_21647":60530,"_5":14929,"_28559":59849,"_3075":60531},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3699":3050,"_31384":2766,"_21647":60533,"_5":14929,"_28559":59852,"_3075":60534},[],"After the upgrade, check in this order:",{"_3699":3051,"_31384":2766,"_21647":60536,"_5":14929,"_28559":59852,"_3075":60537},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3699":3052,"_31384":2766,"_21647":60539,"_5":14929,"_28559":59852,"_3075":60540},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3699":3053,"_31384":2766,"_21647":60542,"_5":14929,"_28559":59852,"_3075":60543},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3699":3054,"_31384":2766,"_21647":60545,"_5":14929,"_28559":59852,"_3075":60546},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3699":3055,"_31384":2766,"_21647":60548,"_5":14929,"_28559":59852,"_3075":60549},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3699":3056,"_31384":2766,"_21647":60551,"_5":14929,"_28559":59852,"_3075":60552},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3699":3057,"_31384":2766,"_21647":60554,"_5":14929,"_28559":59852,"_3075":60555},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3699":3058,"_31384":2766,"_21647":60557,"_5":14929,"_28559":59852,"_3075":60558},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3699":3059,"_31384":2766,"_21647":60560,"_5":14929,"_28559":59852,"_3075":60561},[],"**AMQP.** The backend connects to the broker with the expected TLS settings. On AMQP the SSE subscriber queues are auto-delete and disappear when their instance stops; on event-bus providers without ephemeral-subscriber support, check that leftover per-process SSE queues are not accumulating.",{"_3699":3060,"_31384":2766,"_21647":60563,"_5":14929,"_28559":59852,"_3075":60564},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3699":3061,"_31384":2766,"_21647":60566,"_5":14929,"_28559":59852,"_3075":60567},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3699":3062,"_31384":2766,"_21647":60569,"_5":14929,"_28559":59852,"_3075":60570},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3699":3063,"_31384":2766,"_21647":60572,"_5":14929,"_28559":59852,"_3075":60573},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3699":3064,"_31384":2766,"_21647":60575,"_5":14929,"_28559":59852,"_3075":60576},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3699":3065,"_31384":2766,"_21647":60578,"_5":14929,"_28559":59852,"_3075":60579},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3699":3066,"_31384":2766,"_21647":60581,"_5":14929,"_28559":59856,"_3075":60582},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3699":3067,"_31384":2766,"_21647":60584,"_5":14929,"_28559":59856,"_3075":60585},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3699":3068,"_31384":2766,"_21647":60587,"_5":14929,"_28559":59856,"_3075":60588},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3699":3069,"_31384":2766,"_21647":60590,"_5":14929,"_28559":59856,"_3075":60591},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3699":3070,"_31384":2766,"_21647":60593,"_5":14929,"_28559":59856,"_3075":60594},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60597":60598,"_60599":60600,"_60601":60602,"_60603":60604,"_18816":3110,"_72842":3110},"language","english","sortableProperties",[3075,31384,5,28559],"sortablePropertiesWithTypes",{"_3075":25872,"_31384":25872,"_5":25872,"_28559":25872},"sorts",{"_3075":60605,"_31384":63665,"_5":66724,"_28559":69783},{"_4849":60606,"_60607":60608,"_5":25872},{"_15010":3396,"_15377":5804,"_15396":7903,"_30384":7934,"_15383":6496,"_20570":28805,"_15031":14975,"_15038":26048,"_30321":4822,"_30734":3514,"_30771":5265,"_30360":5746,"_35739":7235,"_30463":7623,"_30815":16353,"_35746":30972,"_35749":3565,"_35752":4973,"_35755":27024,"_31207":7084,"_35760":6758,"_35762":4812,"_31242":5492,"_15392":3649,"_35766":3466,"_35769":17139,"_35771":5195,"_30810":4792,"_31227":10869,"_31255":5212,"_35776":4132,"_35778":8770,"_35780":7285,"_30474":3176,"_35783":3424,"_35785":3197,"_35787":5373,"_35789":3834,"_35791":24404,"_30397":17839,"_35794":10504,"_35796":3476,"_30391":16525,"_30847":6303,"_35800":6886,"_35802":6208