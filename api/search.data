:129660,"_41629":129663,"_41631":129666,"_41633":129669,"_41635":129672,"_41637":129675,"_41639":129678,"_41641":129681,"_41643":129684,"_41645":129687,"_41647":129690,"_41649":129693,"_41652":129696,"_41654":129699,"_41656":129702,"_41658":129705,"_41660":129708,"_41662":129711,"_41664":129714,"_41666":129717,"_41668":129720,"_41670":129723,"_41672":129726,"_41674":129729,"_41676":129732,"_41678":129735,"_41680":129738,"_41682":129741,"_41684":129744,"_41686":129747,"_41688":129750,"_41690":129753,"_41692":129756,"_41694":129759,"_41696":129762,"_41698":129765,"_41700":129768,"_41702":129771,"_41704":129774,"_41706":129777,"_41708":129780,"_41710":129783,"_41712":129786,"_41714":129789,"_41717":129792,"_41719":129795,"_41721":129798},{"_3634":72839,"_31209":72839,"_5":15244,"_3085":120493,"_31547":120494,"_21628":120497,"_28401":72839},"Despliega desde AWS Marketplace",[50999,120495,120496],"Despliegue","Otros modelos",[],{"_3634":72840,"_31209":72839,"_21628":120499,"_5":14884,"_28401":72839,"_3085":120500},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3634":72841,"_31209":72839,"_5":31544,"_21628":120502,"_28401":120503,"_3085":120504},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3634":72842,"_31209":72839,"_5":31544,"_21628":120506,"_28401":120507,"_3085":120508},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3634":72843,"_31209":72839,"_5":31544,"_21628":120510,"_28401":120511,"_3085":120512},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3634":72844,"_31209":72839,"_5":31544,"_21628":120514,"_28401":120515,"_3085":120516},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3634":72845,"_31209":72839,"_5":31544,"_21628":120518,"_28401":120519,"_3085":120520},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3634":72846,"_31209":72839,"_5":31544,"_21628":120522,"_28401":120523,"_3085":120524},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3634":72847,"_31209":72839,"_5":31544,"_21628":120526,"_28401":120527,"_3085":120528},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3634":72848,"_31209":72839,"_21628":120530,"_5":14884,"_28401":72839,"_3085":120531},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3634":72849,"_31209":72839,"_21628":120533,"_5":14884,"_28401":120503,"_3085":120534},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3634":72850,"_31209":72839,"_21628":120536,"_5":14884,"_28401":120503,"_3085":120537},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3634":72851,"_31209":72839,"_21628":120539,"_5":14884,"_28401":120503,"_3085":120540},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3634":72852,"_31209":72839,"_21628":120542,"_5":14884,"_28401":120507,"_3085":120543},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3634":72853,"_31209":72839,"_21628":120545,"_5":14884,"_28401":120507,"_3085":120546},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3634":72854,"_31209":72839,"_21628":120548,"_5":14884,"_28401":120507,"_3085":120549},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3634":72855,"_31209":72839,"_21628":120551,"_5":14884,"_28401":120511,"_3085":120552},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3634":72856,"_31209":72839,"_21628":120554,"_5":14884,"_28401":120515,"_3085":120555},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3634":72857,"_31209":72839,"_21628":120557,"_5":14884,"_28401":120519,"_3085":120558},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3634":72858,"_31209":72839,"_21628":120560,"_5":14884,"_28401":120523,"_3085":120561},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3634":72859,"_31209":72839,"_21628":120563,"_5":14884,"_28401":120527,"_3085":120564},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3634":72860,"_31209":72860,"_5":15244,"_3085":120566,"_31547":120567,"_21628":120568,"_28401":72860},"Despliega Lamassu",[50999,120495],[],{"_3634":72861,"_31209":72860,"_21628":120570,"_5":14884,"_28401":72860,"_3085":120571},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3634":72862,"_31209":72860,"_5":31544,"_21628":120573,"_28401":120574,"_3085":120575},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3634":72863,"_31209":72860,"_5":31544,"_21628":120577,"_28401":120578,"_3085":120579},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3634":72864,"_31209":72860,"_5":31544,"_21628":120581,"_28401":120582,"_3085":120583},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3634":72865,"_31209":72860,"_21628":120585,"_5":14884,"_28401":72860,"_3085":120586},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3634":72866,"_31209":72860,"_21628":120588,"_5":14884,"_28401":120574,"_3085":120589},[],"Modelo",{"_3634":72867,"_31209":72860,"_21628":120591,"_5":14884,"_28401":120574,"_3085":120592},[],"Recomendado para",{"_3634":72868,"_31209":72860,"_21628":120594,"_5":14884,"_28401":120574,"_3085":120595},[],"Quién opera la infraestructura",{"_3634":72869,"_31209":72860,"_21628":120597,"_5":14884,"_28401":120574,"_3085":120598},[],"Punto de partida",{"_3634":72870,"_31209":72860,"_21628":120600,"_5":14884,"_28401":120574,"_3085":51106},[],{"_3634":72871,"_31209":72860,"_21628":120602,"_5":14884,"_28401":120574,"_3085":120603},[],"Producción, entornos regulados y despliegues personalizados",{"_3634":72872,"_31209":72860,"_21628":120605,"_5":14884,"_28401":120574,"_3085":120606},[],"Tu equipo",{"_3634":72873,"_31209":72860,"_21628":120608,"_5":14884,"_28401":120574,"_3085":120609},[],"Helm o Fastlane",{"_3634":72874,"_31209":72860,"_21628":120611,"_5":14884,"_28401":120574,"_3085":51118},[],{"_3634":72875,"_31209":72860,"_21628":120613,"_5":14884,"_28401":120574,"_3085":120614},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3634":72876,"_31209":72860,"_21628":120616,"_5":14884,"_28401":120574,"_3085":120606},[],{"_3634":72877,"_31209":72860,"_21628":120618,"_5":14884,"_28401":120574,"_3085":120619},[],"Imagen preconfigurada en EC2",{"_3634":72878,"_31209":72860,"_21628":120621,"_5":14884,"_28401":120574,"_3085":51129},[],{"_3634":72879,"_31209":72860,"_21628":120623,"_5":14884,"_28401":120574,"_3085":120624},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3634":72880,"_31209":72860,"_21628":120626,"_5":14884,"_28401":120574,"_3085":51135},[],{"_3634":72881,"_31209":72860,"_21628":120628,"_5":14884,"_28401":120574,"_3085":120629},[],"Suscripción gestionada",{"_3634":72882,"_31209":72860,"_21628":120631,"_5":14884,"_28401":120574,"_3085":120632},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3634":72883,"_31209":72860,"_21628":120634,"_5":14884,"_28401":120574,"_3085":120635},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3634":72884,"_31209":72860,"_21628":120637,"_5":14884,"_28401":120574,"_3085":120638},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3634":72885,"_31209":72860,"_21628":120640,"_5":14884,"_28401":120578,"_3085":120641},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3634":72886,"_31209":72860,"_21628":120643,"_5":14884,"_28401":120582,"_3085":120644},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3634":72887,"_31209":72887,"_5":15244,"_3085":120646,"_31547":120647,"_21628":120648,"_28401":72887},"Utiliza Lamassu como SaaS",[50999,120495,120496],[],{"_3634":72888,"_31209":72887,"_21628":120650,"_5":14884,"_28401":72887,"_3085":120651},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3634":72889,"_31209":72887,"_5":31544,"_21628":120653,"_28401":120654,"_3085":120655},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3634":72890,"_31209":72887,"_5":31544,"_21628":120657,"_28401":120658,"_3085":120659},[],"/docs/es/deployment/saas#planes","Planes",{"_3634":72891,"_31209":72887,"_5":31544,"_21628":120661,"_28401":120662,"_3085":120663},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3634":72892,"_31209":72887,"_21628":120665,"_5":14884,"_28401":72887,"_3085":120666},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3634":72893,"_31209":72887,"_21628":120668,"_5":14884,"_28401":120654,"_3085":120669},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3634":72894,"_31209":72887,"_21628":120671,"_5":14884,"_28401":120654,"_3085":120672},[],"Copias de seguridad automáticas.",{"_3634":72895,"_31209":72887,"_21628":120674,"_5":14884,"_28401":120654,"_3085":120675},[],"Actualizaciones de versión.",{"_3634":72896,"_31209":72887,"_21628":120677,"_5":14884,"_28401":120654,"_3085":120678},[],"Soporte técnico y SLA según el plan contratado.",{"_3634":72897,"_31209":72887,"_21628":120680,"_5":14884,"_28401":120658,"_3085":51190},[],{"_3634":72898,"_31209":72887,"_21628":120682,"_5":14884,"_28401":120658,"_3085":120683},[],"Dispositivos",{"_3634":72899,"_31209":72887,"_21628":120685,"_5":14884,"_28401":120658,"_3085":120686},[],"Soporte",{"_3634":72900,"_31209":72887,"_21628":120688,"_5":14884,"_28401":120658,"_3085":51199},[],{"_3634":72901,"_31209":72887,"_21628":120690,"_5":14884,"_28401":120658,"_3085":51202},[],{"_3634":72902,"_31209":72887,"_21628":120692,"_5":14884,"_28401":120658,"_3085":120693},[],"Hasta 1.000",{"_3634":72903,"_31209":72887,"_21628":120695,"_5":14884,"_28401":120658,"_3085":51208},[],{"_3634":72904,"_31209":72887,"_21628":120697,"_5":14884,"_28401":120658,"_3085":120698},[],"99,5 %",{"_3634":72905,"_31209":72887,"_21628":120700,"_5":14884,"_28401":120658,"_3085":51214},[],{"_3634":72906,"_31209":72887,"_21628":120702,"_5":14884,"_28401":120658,"_3085":120703},[],"Hasta 10.000",{"_3634":72907,"_31209":72887,"_21628":120705,"_5":14884,"_28401":120658,"_3085":120706},[],"Email y chat",{"_3634":72908,"_31209":72887,"_21628":120708,"_5":14884,"_28401":120658,"_3085":120709},[],"99,9 %",{"_3634":72909,"_31209":72887,"_21628":120711,"_5":14884,"_28401":120658,"_3085":51226},[],{"_3634":72910,"_31209":72887,"_21628":120713,"_5":14884,"_28401":120658,"_3085":120714},[],"Ilimitados",{"_3634":72911,"_31209":72887,"_21628":120716,"_5":14884,"_28401":120658,"_3085":120717},[],"Dedicado",{"_3634":72912,"_31209":72887,"_21628":120719,"_5":14884,"_28401":120658,"_3085":120720},[],"99,99 %",{"_3634":72913,"_31209":72887,"_21628":120722,"_5":14884,"_28401":120662,"_3085":120723},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3634":72914,"_31209":72887,"_21628":120725,"_5":14884,"_28401":120662,"_3085":120726},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3634":72915,"_31209":72915,"_5":15244,"_3085":51243,"_31547":120728,"_21628":120730,"_28401":72915},[50999,120495,120729],"Kubernetes autogestionado",[],{"_3634":72916,"_31209":72915,"_21628":120732,"_5":14884,"_28401":72915,"_3085":120733},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3634":72917,"_31209":72915,"_5":31544,"_21628":120735,"_28401":120736,"_3085":120737},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3634":72918,"_31209":72915,"_5":31544,"_21628":120739,"_28401":120740,"_3085":120741},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3634":72919,"_31209":72915,"_5":31544,"_21628":120743,"_28401":120744,"_3085":120745},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3634":72920,"_31209":72915,"_5":31544,"_21628":120747,"_28401":120748,"_3085":120749},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3634":72921,"_31209":72915,"_5":31544,"_21628":120751,"_28401":120752,"_3085":120753},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3634":72922,"_31209":72915,"_5":31544,"_21628":120755,"_28401":120756,"_3085":120757},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3634":72923,"_31209":72915,"_5":31544,"_21628":120759,"_28401":120760,"_3085":120761},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3634":72924,"_31209":72915,"_5":31544,"_21628":120763,"_28401":120764,"_3085":120765},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3634":72925,"_31209":72915,"_5":31544,"_21628":120767,"_28401":120768,"_3085":120769},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3634":72926,"_31209":72915,"_5":31544,"_21628":120771,"_28401":120772,"_3085":120773},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3634":72927,"_31209":72915,"_5":31544,"_21628":120775,"_28401":120776,"_3085":120777},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3634":72928,"_31209":72915,"_21628":120779,"_5":14884,"_28401":120736,"_3085":120780},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3634":72929,"_31209":72915,"_21628":120782,"_5":14884,"_28401":120736,"_3085":120783},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3634":72930,"_31209":72915,"_21628":120785,"_5":14884,"_28401":120740,"_3085":120786},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3634":72931,"_31209":72915,"_21628":120788,"_5":14884,"_28401":120740,"_3085":120789},[],"Fastlane instala o configura",{"_3634":72932,"_31209":72915,"_21628":120791,"_5":14884,"_28401":120740,"_3085":120792},[],"Tú sigues proporcionando",{"_3634":72933,"_31209":72915,"_21628":120794,"_5":14884,"_28401":120740,"_3085":120795},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3634":72934,"_31209":72915,"_21628":120797,"_5":14884,"_28401":120740,"_3085":120798},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3634":72935,"_31209":72915,"_21628":120800,"_5":14884,"_28401":120740,"_3085":120801},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3634":72936,"_31209":72915,"_21628":120803,"_5":14884,"_28401":120740,"_3085":120804},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3634":72937,"_31209":72915,"_21628":120806,"_5":14884,"_28401":120740,"_3085":120807},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3634":72938,"_31209":72915,"_21628":120809,"_5":14884,"_28401":120740,"_3085":120810},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3634":72939,"_31209":72915,"_21628":120812,"_5":14884,"_28401":120740,"_3085":120813},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3634":72940,"_31209":72915,"_21628":120815,"_5":14884,"_28401":120740,"_3085":120816},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3634":72941,"_31209":72915,"_21628":120818,"_5":14884,"_28401":120740,"_3085":120819},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3634":72942,"_31209":72915,"_21628":120821,"_5":14884,"_28401":120744,"_3085":120822},[],"Necesitas:",{"_3634":72943,"_31209":72915,"_21628":120824,"_5":14884,"_28401":120744,"_3085":120825},[],"un clúster Kubernetes existente",{"_3634":72944,"_31209":72915,"_21628":120827,"_5":14884,"_28401":120744,"_3085":120828},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3634":72945,"_31209":72915,"_21628":120830,"_5":14884,"_28401":120744,"_3085":51345},[],{"_3634":72946,"_31209":72915,"_21628":120832,"_5":14884,"_28401":120744,"_3085":24441},[],{"_3634":72947,"_31209":72915,"_21628":120834,"_5":14884,"_28401":120744,"_3085":120835},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3634":72948,"_31209":72915,"_21628":120837,"_5":14884,"_28401":120744,"_3085":120838},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3634":72949,"_31209":72915,"_21628":120840,"_5":14884,"_28401":120744,"_3085":120841},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3634":72950,"_31209":72915,"_21628":120843,"_5":14884,"_28401":120744,"_3085":120844},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3634":72951,"_31209":72915,"_21628":120846,"_5":14884,"_28401":120744,"_3085":120847},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3634":72952,"_31209":72915,"_21628":120849,"_5":14884,"_28401":120748,"_3085":120850},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3634":72953,"_31209":72915,"_21628":120852,"_5":14884,"_28401":120748,"_3085":120853},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3634":72954,"_31209":72915,"_21628":120855,"_5":14884,"_28401":120752,"_3085":120856},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3634":72955,"_31209":72915,"_21628":120858,"_5":14884,"_28401":120752,"_3085":120859},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3634":72956,"_31209":72915,"_21628":120861,"_5":14884,"_28401":120752,"_3085":120862},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3634":72957,"_31209":72915,"_21628":120864,"_5":14884,"_28401":120752,"_3085":120865},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3634":72958,"_31209":72915,"_21628":120867,"_5":14884,"_28401":120756,"_3085":120868},[],"Opción",{"_3634":72959,"_31209":72915,"_21628":120870,"_5":14884,"_28401":120756,"_3085":120871},[],"Valor predeterminado",{"_3634":72960,"_31209":72915,"_21628":120873,"_5":14884,"_28401":120756,"_3085":120874},[],"Propósito",{"_3634":72961,"_31209":72915,"_21628":120876,"_5":14884,"_28401":120756,"_3085":51392},[],{"_3634":72962,"_31209":72915,"_21628":120878,"_5":14884,"_28401":120756,"_3085":51395},[],{"_3634":72963,"_31209":72915,"_21628":120880,"_5":14884,"_28401":120756,"_3085":120881},[],"Muestra la ayuda",{"_3634":72964,"_31209":72915,"_21628":120883,"_5":14884,"_28401":120756,"_3085":51401},[],{"_3634":72965,"_31209":72915,"_21628":120885,"_5":14884,"_28401":120756,"_3085":120886},[],"contexto actual",{"_3634":72966,"_31209":72915,"_21628":120888,"_5":14884,"_28401":120756,"_3085":120889},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3634":72967,"_31209":72915,"_21628":120891,"_5":14884,"_28401":120756,"_3085":51410},[],{"_3634":72968,"_31209":72915,"_21628":120893,"_5":14884,"_28401":120756,"_3085":6806},[],{"_3634":72969,"_31209":72915,"_21628":120895,"_5":14884,"_28401":120756,"_3085":120896},[],"Omite prompts y genera credenciales para las dependencias",{"_3634":72970,"_31209":72915,"_21628":120898,"_5":14884,"_28401":120756,"_3085":51418},[],{"_3634":72971,"_31209":72915,"_21628":120900,"_5":14884,"_28401":120756,"_3085":51421},[],{"_3634":72972,"_31209":72915,"_21628":120902,"_5":14884,"_28401":120756,"_3085":120903},[],"Namespace de la instalación",{"_3634":72973,"_31209":72915,"_21628":120905,"_5":14884,"_28401":120756,"_3085":51427},[],{"_3634":72974,"_31209":72915,"_21628":120907,"_5":14884,"_28401":120756,"_3085":51430},[],{"_3634":72975,"_31209":72915,"_21628":120909,"_5":14884,"_28401":120756,"_3085":120910},[],"Dominio usado por la UI, OIDC y el certificado",{"_3634":72976,"_31209":72915,"_21628":120912,"_5":14884,"_28401":120756,"_3085":51436},[],{"_3634":72977,"_31209":72915,"_21628":120914,"_5":14884,"_28401":120756,"_3085":15596},[],{"_3634":72978,"_31209":72915,"_21628":120916,"_5":14884,"_28401":120756,"_3085":120917},[],"Versión del chart de Lamassu",{"_3634":72979,"_31209":72915,"_21628":120919,"_5":14884,"_28401":120756,"_3085":51444},[],{"_3634":72980,"_31209":72915,"_21628":120921,"_5":14884,"_28401":120756,"_3085":51447},[],{"_3634":72981,"_31209":72915,"_21628":120923,"_5":14884,"_28401":120756,"_3085":120924},[],"Puerto del listener HTTPS",{"_3634":72982,"_31209":72915,"_21628":120926,"_5":14884,"_28401":120756,"_3085":51453},[],{"_3634":72983,"_31209":72915,"_21628":120928,"_5":14884,"_28401":120756,"_3085":51456},[],{"_3634":72984,"_31209":72915,"_21628":120930,"_5":14884,"_28401":120756,"_3085":120931},[],"Puerto del listener HTTP",{"_3634":72985,"_31209":72915,"_21628":120933,"_5":14884,"_28401":120756,"_3085":51462},[],{"_3634":72986,"_31209":72915,"_21628":120935,"_5":14884,"_28401":120756,"_3085":51395},[],{"_3634":72987,"_31209":72915,"_21628":120937,"_5":14884,"_28401":120756,"_3085":120938},[],"Certificado PEM para TLS downstream",{"_3634":72988,"_31209":72915,"_21628":120940,"_5":14884,"_28401":120756,"_3085":51470},[],{"_3634":72989,"_31209":72915,"_21628":120942,"_5":14884,"_28401":120756,"_3085":51395},[],{"_3634":72990,"_31209":72915,"_21628":120944,"_5":14884,"_28401":120756,"_3085":120945},[],"Clave privada PEM para TLS downstream",{"_3634":72991,"_31209":72915,"_21628":120947,"_5":14884,"_28401":120756,"_3085":51478},[],{"_3634":72992,"_31209":72915,"_21628":120949,"_5":14884,"_28401":120756,"_3085":120950},[],"chart del repositorio",{"_3634":72993,"_31209":72915,"_21628":120952,"_5":14884,"_28401":120756,"_3085":120953},[],"Usa un chart local de Lamassu sin empaquetar",{"_3634":72994,"_31209":72915,"_21628":120955,"_5":14884,"_28401":120756,"_3085":51487},[],{"_3634":72995,"_31209":72915,"_21628":120957,"_5":14884,"_28401":120756,"_3085":120958},[],"detección automática",{"_3634":72996,"_31209":72915,"_21628":120960,"_5":14884,"_28401":120756,"_3085":120961},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3634":72997,"_31209":72915,"_21628":120963,"_5":14884,"_28401":120756,"_3085":51495},[],{"_3634":72998,"_31209":72915,"_21628":120965,"_5":14884,"_28401":120756,"_3085":6806},[],{"_3634":72999,"_31209":72915,"_21628":120967,"_5":14884,"_28401":120756,"_3085":120968},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3634":73000,"_31209":72915,"_21628":120970,"_5":14884,"_28401":120756,"_3085":51503},[],{"_3634":73001,"_31209":72915,"_21628":120972,"_5":14884,"_28401":120756,"_3085":6806},[],{"_3634":73002,"_31209":72915,"_21628":120974,"_5":14884,"_28401":120756,"_3085":120975},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3634":73003,"_31209":72915,"_21628":120977,"_5":14884,"_28401":120756,"_3085":51511},[],{"_3634":73004,"_31209":72915,"_21628":120979,"_5":14884,"_28401":120756,"_3085":6806},[],{"_3634":73005,"_31209":72915,"_21628":120981,"_5":14884,"_28401":120756,"_3085":120982},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3634":73006,"_31209":72915,"_21628":120984,"_5":14884,"_28401":120756,"_3085":51519},[],{"_3634":73007,"_31209":72915,"_21628":120986,"_5":14884,"_28401":120756,"_3085":6806},[],{"_3634":73008,"_31209":72915,"_21628":120988,"_5":14884,"_28401":120756,"_3085":120989},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3634":73009,"_31209":72915,"_21628":120991,"_5":14884,"_28401":120756,"_3085":51527},[],{"_3634":73010,"_31209":72915,"_21628":120993,"_5":14884,"_28401":120756,"_3085":51530},[],{"_3634":73011,"_31209":72915,"_21628":120995,"_5":14884,"_28401":120756,"_3085":120996},[],"Usa otro chart local de SoftHSM",{"_3634":73012,"_31209":72915,"_21628":120998,"_5":14884,"_28401":120756,"_3085":120999},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3634":73013,"_31209":72915,"_21628":121001,"_5":14884,"_28401":120760,"_3085":121002},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3634":73014,"_31209":72915,"_21628":121004,"_5":14884,"_28401":120760,"_3085":121005},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3634":73015,"_31209":72915,"_21628":121007,"_5":14884,"_28401":120760,"_3085":121008},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3634":73016,"_31209":72915,"_21628":121010,"_5":14884,"_28401":120760,"_3085":121011},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3634":73017,"_31209":72915,"_21628":121013,"_5":14884,"_28401":120760,"_3085":121014},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3634":73018,"_31209":72915,"_21628":121016,"_5":14884,"_28401":120760,"_3085":121017},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3634":73019,"_31209":72915,"_21628":121019,"_5":14884,"_28401":120764,"_3085":51557},[],{"_3634":73020,"_31209":72915,"_21628":121021,"_5":14884,"_28401":120764,"_3085":121022},[],"valida las herramientas locales y el clúster seleccionado",{"_3634":73021,"_31209":72915,"_21628":121024,"_5":14884,"_28401":120764,"_3085":121025},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3634":73022,"_31209":72915,"_21628":121027,"_5":14884,"_28401":120764,"_3085":121028},[],"crea el namespace",{"_3634":73023,"_31209":72915,"_21628":121030,"_5":14884,"_28401":120764,"_3085":121031},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3634":73024,"_31209":72915,"_21628":121033,"_5":14884,"_28401":120764,"_3085":121034},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3634":73025,"_31209":72915,"_21628":121036,"_5":14884,"_28401":120764,"_3085":121037},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3634":73026,"_31209":72915,"_21628":121039,"_5":14884,"_28401":120764,"_3085":121040},[],"instala RabbitMQ",{"_3634":73027,"_31209":72915,"_21628":121042,"_5":14884,"_28401":120764,"_3085":121043},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3634":73028,"_31209":72915,"_21628":121045,"_5":14884,"_28401":120764,"_3085":121046},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3634":73029,"_31209":72915,"_21628":121048,"_5":14884,"_28401":120764,"_3085":121049},[],"carga datos de ejemplo opcionalmente",{"_3634":73030,"_31209":72915,"_21628":121051,"_5":14884,"_28401":120764,"_3085":121052},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3634":73031,"_31209":72915,"_21628":121054,"_5":14884,"_28401":120768,"_3085":121055},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3634":73032,"_31209":72915,"_21628":121057,"_5":14884,"_28401":120768,"_3085":121058},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3634":73033,"_31209":72915,"_21628":121060,"_5":14884,"_28401":120772,"_3085":121061},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3634":73034,"_31209":72915,"_21628":121063,"_5":14884,"_28401":120772,"_3085":121064},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3634":73035,"_31209":72915,"_21628":121066,"_5":14884,"_28401":120772,"_3085":121067},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3634":73036,"_31209":72915,"_21628":121069,"_5":14884,"_28401":120772,"_3085":121070},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3634":73037,"_31209":72915,"_21628":121072,"_5":14884,"_28401":120776,"_3085":121073},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3634":73038,"_31209":73038,"_5":15244,"_3085":121075,"_31547":121076,"_21628":121077,"_28401":73038},"Instala con Helm",[50999,120495,120729],[],{"_3634":73039,"_31209":73038,"_21628":121079,"_5":14884,"_28401":73038,"_3085":121080},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3634":73040,"_31209":73038,"_5":31544,"_21628":121082,"_28401":121083,"_3085":121084},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3634":73041,"_31209":73038,"_5":31544,"_21628":121086,"_28401":121087,"_3085":120745},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3634":73042,"_31209":73038,"_5":31544,"_21628":121089,"_28401":121090,"_3085":121091},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3634":73043,"_31209":73038,"_5":31544,"_21628":121093,"_28401":121094,"_3085":121095},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3634":73044,"_31209":73038,"_5":31544,"_21628":121097,"_28401":121098,"_3085":121099},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3634":73045,"_31209":73038,"_5":31544,"_21628":121101,"_28401":121102,"_3085":121103},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3634":73046,"_31209":73038,"_5":31544,"_21628":121105,"_28401":121106,"_3085":121107},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3634":73047,"_31209":73038,"_5":31544,"_21628":121109,"_28401":121110,"_3085":121111},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3634":73048,"_31209":73038,"_5":31544,"_21628":121113,"_28401":121114,"_3085":121115},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3634":73049,"_31209":73038,"_5":31544,"_21628":121117,"_28401":121118,"_3085":121119},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3634":73050,"_31209":73038,"_5":31544,"_21628":121121,"_28401":121122,"_3085":121123},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3634":73051,"_31209":73038,"_5":31544,"_21628":121125,"_28401":121126,"_3085":121127},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3634":73052,"_31209":73038,"_21628":121129,"_5":14884,"_28401":121083,"_3085":121130},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3634":73053,"_31209":73038,"_21628":121132,"_5":14884,"_28401":121087,"_3085":121133},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3634":73054,"_31209":73038,"_21628":121135,"_5":14884,"_28401":121087,"_3085":121136},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3634":73055,"_31209":73038,"_21628":121138,"_5":14884,"_28401":121087,"_3085":121139},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3634":73056,"_31209":73038,"_21628":121141,"_5":14884,"_28401":121087,"_3085":121142},[],"un broker RabbitMQ accesible y sus credenciales",{"_3634":73057,"_31209":73038,"_21628":121144,"_5":14884,"_28401":121087,"_3085":121145},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3634":73058,"_31209":73038,"_21628":121147,"_5":14884,"_28401":121087,"_3085":121148},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3634":73059,"_31209":73038,"_21628":121150,"_5":14884,"_28401":121087,"_3085":121151},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3634":73060,"_31209":73038,"_21628":121153,"_5":14884,"_28401":121087,"_3085":121154},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3634":73061,"_31209":73038,"_21628":121156,"_5":14884,"_28401":121087,"_3085":121157},[],"una StorageClass y un diseño de tráfico externo",{"_3634":73062,"_31209":73038,"_21628":121159,"_5":14884,"_28401":121087,"_3085":121160},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3634":73063,"_31209":73038,"_21628":121162,"_5":14884,"_28401":121087,"_3085":121163},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3634":73064,"_31209":73038,"_21628":121165,"_5":14884,"_28401":121087,"_3085":121166},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3634":73065,"_31209":73038,"_21628":121168,"_5":14884,"_28401":121090,"_3085":121169},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3634":73066,"_31209":73038,"_21628":121171,"_5":14884,"_28401":121090,"_3085":121172},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3634":73067,"_31209":73038,"_21628":121174,"_5":14884,"_28401":121090,"_3085":121175},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3634":73068,"_31209":73038,"_21628":121177,"_5":14884,"_28401":121094,"_3085":121178},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3634":73069,"_31209":73038,"_21628":121180,"_5":14884,"_28401":121094,"_3085":121181},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3634":73070,"_31209":73038,"_21628":121183,"_5":14884,"_28401":121094,"_3085":121184},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3634":73071,"_31209":73038,"_21628":121186,"_5":14884,"_28401":121094,"_3085":121187},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3634":73072,"_31209":73038,"_21628":121189,"_5":14884,"_28401":121098,"_3085":121190},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3634":73073,"_31209":73038,"_21628":121192,"_5":14884,"_28401":121098,"_3085":121193},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3634":73074,"_31209":73038,"_21628":121195,"_5":14884,"_28401":121098,"_3085":121196},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3634":73075,"_31209":73038,"_21628":121198,"_5":14884,"_28401":121098,"_3085":121199},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3634":73076,"_31209":73038,"_21628":121201,"_5":14884,"_28401":121098,"_3085":121202},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3634":73077,"_31209":73038,"_21628":121204,"_5":14884,"_28401":121098,"_3085":121205},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3634":73078,"_31209":73038,"_21628":121207,"_5":14884,"_28401":121098,"_3085":121208},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3634":73079,"_31209":73038,"_21628":121210,"_5":14884,"_28401":121098,"_3085":121211},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3634":73080,"_31209":73038,"_21628":121213,"_5":14884,"_28401":121102,"_3085":121214},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3634":73081,"_31209":73038,"_21628":121216,"_5":14884,"_28401":121106,"_3085":121217},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3634":73082,"_31209":73038,"_21628":121219,"_5":14884,"_28401":121106,"_3085":121220},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3634":73083,"_31209":73038,"_21628":121222,"_5":14884,"_28401":121106,"_3085":121223},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3634":73084,"_31209":73038,"_21628":121225,"_5":14884,"_28401":121106,"_3085":121226},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3634":73085,"_31209":73038,"_21628":121228,"_5":14884,"_28401":121106,"_3085":121229},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3634":73086,"_31209":73038,"_21628":121231,"_5":14884,"_28401":121106,"_3085":121232},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3634":73087,"_31209":73038,"_21628":121234,"_5":14884,"_28401":121106,"_3085":121235},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3634":73088,"_31209":73038,"_21628":121237,"_5":14884,"_28401":121110,"_3085":121238},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3634":73089,"_31209":73038,"_21628":121240,"_5":14884,"_28401":121110,"_3085":121241},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3634":73090,"_31209":73038,"_21628":121243,"_5":14884,"_28401":121110,"_3085":121244},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3634":73091,"_31209":73038,"_21628":121246,"_5":14884,"_28401":121110,"_3085":121247},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3634":73092,"_31209":73038,"_21628":121249,"_5":14884,"_28401":121114,"_3085":121250},[],"Para instalar un checkout local:",{"_3634":73093,"_31209":73038,"_21628":121252,"_5":14884,"_28401":121118,"_3085":121253},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3634":73094,"_31209":73038,"_21628":121255,"_5":14884,"_28401":121118,"_3085":121256},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3634":73095,"_31209":73038,"_21628":121258,"_5":14884,"_28401":121122,"_3085":121259},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3634":73096,"_31209":73038,"_21628":121261,"_5":14884,"_28401":121122,"_3085":121262},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3634":73097,"_31209":73038,"_21628":121264,"_5":14884,"_28401":121122,"_3085":121265},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3634":73098,"_31209":73038,"_21628":121267,"_5":14884,"_28401":121122,"_3085":121268},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3634":73099,"_31209":73038,"_21628":121270,"_5":14884,"_28401":121122,"_3085":121271},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3634":73100,"_31209":73038,"_21628":121273,"_5":14884,"_28401":121126,"_3085":121274},[],"Antes de pasar a producción, revisa:",{"_3634":73101,"_31209":73038,"_21628":121276,"_5":14884,"_28401":121126,"_3085":121277},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3634":73102,"_31209":73038,"_21628":121279,"_5":14884,"_28401":121126,"_3085":121280},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3634":73103,"_31209":73038,"_21628":121282,"_5":14884,"_28401":121126,"_3085":121283},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3634":73104,"_31209":73038,"_21628":121285,"_5":14884,"_28401":121126,"_3085":121286},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3634":73105,"_31209":73038,"_21628":121288,"_5":14884,"_28401":121126,"_3085":121289},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3634":73106,"_31209":73038,"_21628":121291,"_5":14884,"_28401":121126,"_3085":121292},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3634":73107,"_31209":73038,"_21628":121294,"_5":14884,"_28401":121126,"_3085":121295},[],"SMTP, observabilidad y entrega de alertas",{"_3634":73108,"_31209":73038,"_21628":121297,"_5":14884,"_28401":121126,"_3085":121298},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3634":73109,"_31209":73038,"_21628":121300,"_5":14884,"_28401":121126,"_3085":121301},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3634":73110,"_31209":73110,"_5":15244,"_3085":121303,"_31547":121304,"_21628":121305,"_28401":73110},"Expón el Gateway",[50999,120495,120729],[],{"_3634":73111,"_31209":73110,"_21628":121307,"_5":14884,"_28401":73110,"_3085":121308},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3634":73112,"_31209":73110,"_5":31544,"_21628":121310,"_28401":121311,"_3085":121312},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3634":73113,"_31209":73110,"_5":31544,"_21628":121314,"_28401":121315,"_3085":121316},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3634":73114,"_31209":73110,"_5":31544,"_21628":121318,"_28401":121319,"_3085":121320},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3634":73115,"_31209":73110,"_5":31544,"_21628":121322,"_28401":121323,"_3085":51862},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3634":73116,"_31209":73110,"_5":31544,"_21628":121325,"_28401":121326,"_3085":121327},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3634":73117,"_31209":73110,"_5":31544,"_21628":121329,"_28401":121330,"_3085":121331},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3634":73118,"_31209":73110,"_5":31544,"_21628":121333,"_28401":121334,"_3085":121335},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3634":73119,"_31209":73110,"_5":31544,"_21628":121337,"_28401":121338,"_3085":121339},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3634":73120,"_31209":73110,"_5":31544,"_21628":121341,"_28401":121342,"_3085":121343},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3634":73121,"_31209":73110,"_5":31544,"_21628":121345,"_28401":121346,"_3085":121347},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3634":73122,"_31209":73110,"_5":31544,"_21628":121349,"_28401":121350,"_3085":121351},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3634":73123,"_31209":73110,"_21628":121353,"_5":14884,"_28401":121311,"_3085":121354},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3634":73124,"_31209":73110,"_21628":121356,"_5":14884,"_28401":121311,"_3085":121357},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3634":73125,"_31209":73110,"_21628":121359,"_5":14884,"_28401":121315,"_3085":121360},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3634":73126,"_31209":73110,"_21628":121362,"_5":14884,"_28401":121315,"_3085":121363},[],"Defínelo únicamente cuando:",{"_3634":73127,"_31209":73110,"_21628":121365,"_5":14884,"_28401":121315,"_3085":121366},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3634":73128,"_31209":73110,"_21628":121368,"_5":14884,"_28401":121315,"_3085":121369},[],"esa dirección está asignada a este Gateway",{"_3634":73129,"_31209":73110,"_21628":121371,"_5":14884,"_28401":121315,"_3085":121372},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3634":73130,"_31209":73110,"_21628":121374,"_5":14884,"_28401":121315,"_3085":121375},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3634":73131,"_31209":73110,"_21628":121377,"_5":14884,"_28401":121315,"_3085":121378},[],"No confundas estos valores:",{"_3634":73132,"_31209":73110,"_21628":121380,"_5":14884,"_28401":121315,"_3085":121381},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3634":73133,"_31209":73110,"_21628":121383,"_5":14884,"_28401":121315,"_3085":121384},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3634":73134,"_31209":73110,"_21628":121386,"_5":14884,"_28401":121315,"_3085":121387},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3634":73135,"_31209":73110,"_21628":121389,"_5":14884,"_28401":121319,"_3085":121390},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3634":73136,"_31209":73110,"_21628":121392,"_5":14884,"_28401":121319,"_3085":121393},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3634":73137,"_31209":73110,"_21628":121395,"_5":14884,"_28401":121323,"_3085":121396},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3634":73138,"_31209":73110,"_21628":121398,"_5":14884,"_28401":121323,"_3085":121399},[],"Para el diseño recomendado:",{"_3634":73139,"_31209":73110,"_21628":121401,"_5":14884,"_28401":121323,"_3085":121402},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3634":73140,"_31209":73110,"_21628":121404,"_5":14884,"_28401":121323,"_3085":121405},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3634":73141,"_31209":73110,"_21628":121407,"_5":14884,"_28401":121323,"_3085":121408},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3634":73142,"_31209":73110,"_21628":121410,"_5":14884,"_28401":121323,"_3085":121411},[],"Apunta DNS a la dirección accesible de la VM.",{"_3634":73143,"_31209":73110,"_21628":121413,"_5":14884,"_28401":121323,"_3085":121414},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3634":73144,"_31209":73110,"_21628":121416,"_5":14884,"_28401":121326,"_3085":121417},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3634":73145,"_31209":73110,"_21628":121419,"_5":14884,"_28401":121330,"_3085":121420},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3634":73146,"_31209":73110,"_21628":121422,"_5":14884,"_28401":121330,"_3085":121423},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3634":73147,"_31209":73110,"_21628":121425,"_5":14884,"_28401":121334,"_3085":121426},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3634":73148,"_31209":73110,"_21628":121428,"_5":14884,"_28401":121334,"_3085":121429},[],"Requisito",{"_3634":73149,"_31209":73110,"_21628":121431,"_5":14884,"_28401":121334,"_3085":121432},[],"Diseño recomendado",{"_3634":73150,"_31209":73110,"_21628":121434,"_5":14884,"_28401":121334,"_3085":121435},[],"Consecuencia",{"_3634":73151,"_31209":73110,"_21628":121437,"_5":14884,"_28401":121334,"_3085":121438},[],"Varias URL o servicios de Lamassu",{"_3634":73152,"_31209":73110,"_21628":121440,"_5":14884,"_28401":121334,"_3085":121441},[],"Un Gateway con varias rutas",{"_3634":73153,"_31209":73110,"_21628":121443,"_5":14884,"_28401":121334,"_3085":121444},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3634":73154,"_31209":73110,"_21628":121446,"_5":14884,"_28401":121334,"_3085":121447},[],"Gateways independientes e IP externas distintas",{"_3634":73155,"_31209":73110,"_21628":121449,"_5":14884,"_28401":121334,"_3085":121450},[],"Una VIP por Gateway",{"_3634":73156,"_31209":73110,"_21628":121452,"_5":14884,"_28401":121334,"_3085":121453},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3634":73157,"_31209":73110,"_21628":121455,"_5":14884,"_28401":121334,"_3085":121456},[],"Gateways independientes, un nodo y una IP",{"_3634":73158,"_31209":73110,"_21628":121458,"_5":14884,"_28401":121334,"_3085":121459},[],"Puertos externos diferentes",{"_3634":73159,"_31209":73110,"_21628":121461,"_5":14884,"_28401":121334,"_3085":121462},[],"Los clientes deben indicar puertos no estándar",{"_3634":73160,"_31209":73110,"_21628":121464,"_5":14884,"_28401":121334,"_3085":121465},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3634":73161,"_31209":73110,"_21628":121467,"_5":14884,"_28401":121334,"_3085":121468},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3634":73162,"_31209":73110,"_21628":121470,"_5":14884,"_28401":121334,"_3085":121471},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3634":73163,"_31209":73110,"_21628":121473,"_5":14884,"_28401":121334,"_3085":121474},[],"Recursos Gateway separados pero proxy compartido",{"_3634":73164,"_31209":73110,"_21628":121476,"_5":14884,"_28401":121334,"_3085":121477},[],"Modo merged Gateway de Envoy",{"_3634":73165,"_31209":73110,"_21628":121479,"_5":14884,"_28401":121334,"_3085":121480},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3634":73166,"_31209":73110,"_21628":121482,"_5":14884,"_28401":121334,"_3085":121483},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3634":73167,"_31209":73110,"_21628":121485,"_5":14884,"_28401":121334,"_3085":121486},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3634":73168,"_31209":73110,"_21628":121488,"_5":14884,"_28401":121334,"_3085":121489},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3634":73169,"_31209":73110,"_21628":121491,"_5":14884,"_28401":121334,"_3085":121492},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3634":73170,"_31209":73110,"_21628":121494,"_5":14884,"_28401":121338,"_3085":121495},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3634":73171,"_31209":73110,"_21628":121497,"_5":14884,"_28401":121342,"_3085":121498},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3634":73172,"_31209":73110,"_21628":121500,"_5":14884,"_28401":121342,"_3085":121501},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3634":73173,"_31209":73110,"_21628":121503,"_5":14884,"_28401":121342,"_3085":121504},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3634":73174,"_31209":73110,"_21628":121506,"_5":14884,"_28401":121342,"_3085":121507},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3634":73175,"_31209":73110,"_21628":121509,"_5":14884,"_28401":121342,"_3085":121510},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3634":73176,"_31209":73110,"_21628":121512,"_5":14884,"_28401":121346,"_3085":121513},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3634":73177,"_31209":73110,"_21628":121515,"_5":14884,"_28401":121346,"_3085":121516},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3634":73178,"_31209":73110,"_21628":121518,"_5":14884,"_28401":121350,"_3085":121519},[],"Comprueba, en orden:",{"_3634":73179,"_31209":73110,"_21628":121521,"_5":14884,"_28401":121350,"_3085":121522},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3634":73180,"_31209":73110,"_21628":121524,"_5":14884,"_28401":121350,"_3085":121525},[],"Su estado contiene la dirección esperada.",{"_3634":73181,"_31209":73110,"_21628":121527,"_5":14884,"_28401":121350,"_3085":121528},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3634":73182,"_31209":73110,"_21628":121530,"_5":14884,"_28401":121350,"_3085":121531},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3634":73183,"_31209":73110,"_21628":121533,"_5":14884,"_28401":121350,"_3085":121534},[],"DNS resuelve al endpoint accesible externamente.",{"_3634":73184,"_31209":73110,"_21628":121536,"_5":14884,"_28401":121350,"_3085":121537},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3634":73185,"_31209":73110,"_21628":121539,"_5":14884,"_28401":121350,"_3085":121540},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3634":73186,"_31209":73186,"_5":15244,"_3085":51106,"_31547":121542,"_21628":121543,"_28401":73186},[50999,120495,120729],[],{"_3634":73187,"_31209":73186,"_21628":121545,"_5":14884,"_28401":73186,"_3085":121546},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3634":73188,"_31209":73186,"_5":31544,"_21628":121548,"_28401":121549,"_3085":121550},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3634":73189,"_31209":73186,"_5":31544,"_21628":121552,"_28401":121553,"_3085":121554},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3634":73190,"_31209":73186,"_5":31544,"_21628":121556,"_28401":121557,"_3085":121558},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3634":73191,"_31209":73186,"_5":31544,"_21628":121560,"_28401":121561,"_3085":121562},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3634":73192,"_31209":73186,"_5":31544,"_21628":121564,"_28401":121565,"_3085":121566},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3634":73193,"_31209":73186,"_5":31544,"_21628":121568,"_28401":121569,"_3085":121570},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3634":73194,"_31209":73186,"_21628":121572,"_5":14884,"_28401":121549,"_3085":121573},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3634":73195,"_31209":73186,"_21628":121575,"_5":14884,"_28401":121553,"_3085":121576},[],"Flujo",{"_3634":73196,"_31209":73186,"_21628":121578,"_5":14884,"_28401":121553,"_3085":121579},[],"Úsalo para",{"_3634":73197,"_31209":73186,"_21628":121581,"_5":14884,"_28401":121553,"_3085":121582},[],"Qué instala",{"_3634":73198,"_31209":73186,"_21628":121584,"_5":14884,"_28401":121553,"_3085":52124},[],{"_3634":73199,"_31209":73186,"_21628":121586,"_5":14884,"_28401":121553,"_3085":121587},[],"Producción y entornos controlados",{"_3634":73200,"_31209":73186,"_21628":121589,"_5":14884,"_28401":121553,"_3085":121590},[],"Servicios de Lamassu y recursos de Gateway API",{"_3634":73201,"_31209":73186,"_21628":121592,"_5":14884,"_28401":121553,"_3085":51243},[],{"_3634":73202,"_31209":73186,"_21628":121594,"_5":14884,"_28401":121553,"_3085":121595},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3634":73203,"_31209":73186,"_21628":121597,"_5":14884,"_28401":121553,"_3085":121598},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3634":73204,"_31209":73186,"_21628":121600,"_5":14884,"_28401":121557,"_3085":121601},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3634":73205,"_31209":73186,"_21628":121603,"_5":14884,"_28401":121557,"_3085":121604},[],"Área",{"_3634":73206,"_31209":73186,"_21628":121606,"_5":14884,"_28401":121557,"_3085":121607},[],"El chart de Lamassu proporciona",{"_3634":73207,"_31209":73186,"_21628":121609,"_5":14884,"_28401":121557,"_3085":121610},[],"Tú proporcionas",{"_3634":73208,"_31209":73186,"_21628":121612,"_5":14884,"_28401":121557,"_3085":121613},[],"Aplicaciones Lamassu",{"_3634":73209,"_31209":73186,"_21628":121615,"_5":14884,"_28401":121557,"_3085":121616},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3634":73210,"_31209":73186,"_21628":121618,"_5":14884,"_28401":121557,"_3085":121619},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3634":73211,"_31209":73186,"_21628":121621,"_5":14884,"_28401":121557,"_3085":121622},[],"Datos PostgreSQL",{"_3634":73212,"_31209":73186,"_21628":121624,"_5":14884,"_28401":121557,"_3085":121625},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3634":73213,"_31209":73186,"_21628":121627,"_5":14884,"_28401":121557,"_3085":121628},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3634":73214,"_31209":73186,"_21628":121630,"_5":14884,"_28401":121557,"_3085":121631},[],"Mensajería",{"_3634":73215,"_31209":73186,"_21628":121633,"_5":14884,"_28401":121557,"_3085":121634},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3634":73216,"_31209":73186,"_21628":121636,"_5":14884,"_28401":121557,"_3085":121637},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3634":73217,"_31209":73186,"_21628":121639,"_5":14884,"_28401":121557,"_3085":121640},[],"Identidad",{"_3634":73218,"_31209":73186,"_21628":121642,"_5":14884,"_28401":121557,"_3085":121643},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3634":73219,"_31209":73186,"_21628":121645,"_5":14884,"_28401":121557,"_3085":121646},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3634":73220,"_31209":73186,"_21628":121648,"_5":14884,"_28401":121557,"_3085":121649},[],"Enrutamiento externo",{"_3634":73221,"_31209":73186,"_21628":121651,"_5":14884,"_28401":121557,"_3085":121652},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3634":73222,"_31209":73186,"_21628":121654,"_5":14884,"_28401":121557,"_3085":121655},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3634":73223,"_31209":73186,"_21628":121657,"_5":14884,"_28401":121557,"_3085":52198},[],{"_3634":73224,"_31209":73186,"_21628":121659,"_5":14884,"_28401":121557,"_3085":121660},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3634":73225,"_31209":73186,"_21628":121662,"_5":14884,"_28401":121557,"_3085":121663},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3634":73226,"_31209":73186,"_21628":121665,"_5":14884,"_28401":121557,"_3085":121666},[],"Datos persistentes de la aplicación",{"_3634":73227,"_31209":73186,"_21628":121668,"_5":14884,"_28401":121557,"_3085":121669},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3634":73228,"_31209":73186,"_21628":121671,"_5":14884,"_28401":121557,"_3085":121672},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3634":73229,"_31209":73186,"_21628":121674,"_5":14884,"_28401":121557,"_3085":121675},[],"Integraciones opcionales",{"_3634":73230,"_31209":73186,"_21628":121677,"_5":14884,"_28401":121557,"_3085":121678},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3634":73231,"_31209":73186,"_21628":121680,"_5":14884,"_28401":121557,"_3085":121681},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3634":73232,"_31209":73186,"_21628":121683,"_5":14884,"_28401":121557,"_3085":121684},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3634":73233,"_31209":73186,"_21628":121686,"_5":14884,"_28401":121557,"_3085":121687},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3634":73234,"_31209":73186,"_21628":121689,"_5":14884,"_28401":121561,"_3085":121690},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3634":73235,"_31209":73186,"_21628":121692,"_5":14884,"_28401":121561,"_3085":121693},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3634":73236,"_31209":73186,"_21628":121695,"_5":14884,"_28401":121565,"_3085":121696},[],"Kubernetes 1.24 o posterior",{"_3634":73237,"_31209":73186,"_21628":121698,"_5":14884,"_28401":121565,"_3085":121699},[],"Helm 3.2 o posterior",{"_3634":73238,"_31209":73186,"_21628":121701,"_5":14884,"_28401":121565,"_3085":121702},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3634":73239,"_31209":73186,"_21628":121704,"_5":14884,"_28401":121565,"_3085":121705},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3634":73240,"_31209":73186,"_21628":121707,"_5":14884,"_28401":121565,"_3085":121708},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3634":73241,"_31209":73186,"_21628":121710,"_5":14884,"_28401":121565,"_3085":121711},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3634":73242,"_31209":73186,"_21628":121713,"_5":14884,"_28401":121565,"_3085":121714},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3634":73243,"_31209":73186,"_21628":121716,"_5":14884,"_28401":121569,"_3085":121717},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3634":73244,"_31209":73186,"_21628":121719,"_5":14884,"_28401":121569,"_3085":121720},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3634":73245,"_31209":73186,"_21628":121722,"_5":14884,"_28401":121569,"_3085":121723},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3634":73246,"_31209":73186,"_21628":121725,"_5":14884,"_28401":121569,"_3085":121726},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3634":73247,"_31209":73247,"_5":15244,"_3085":121728,"_31547":121729,"_21628":121731,"_28401":73247},"Resolución de problemas de despliegue",[50999,120495,121730],"Operación",[],{"_3634":73248,"_31209":73247,"_21628":121733,"_5":14884,"_28401":73247,"_3085":121734},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3634":73249,"_31209":73247,"_5":31544,"_21628":121736,"_28401":121737,"_3085":121738},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3634":73250,"_31209":73247,"_5":31544,"_21628":121740,"_28401":121741,"_3085":121742},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3634":73251,"_31209":73247,"_5":31544,"_21628":121744,"_28401":121745,"_3085":121746},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3634":73252,"_31209":73247,"_5":31544,"_21628":121748,"_28401":121749,"_3085":121750},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3634":73253,"_31209":73247,"_5":31544,"_21628":121752,"_28401":121753,"_3085":121754},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3634":73254,"_31209":73247,"_5":31544,"_21628":121756,"_28401":121757,"_3085":121758},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3634":73255,"_31209":73247,"_5":31544,"_21628":121760,"_28401":121761,"_3085":121762},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3634":73256,"_31209":73247,"_5":31544,"_21628":121764,"_28401":121765,"_3085":121766},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3634":73257,"_31209":73247,"_5":31544,"_21628":121768,"_28401":121769,"_3085":121770},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3634":73258,"_31209":73247,"_5":31544,"_21628":121772,"_28401":121773,"_3085":121774},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3634":73259,"_31209":73247,"_5":31544,"_21628":121776,"_28401":121777,"_3085":121778},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3634":73260,"_31209":73247,"_5":31544,"_21628":121780,"_28401":121781,"_3085":121782},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3634":73261,"_31209":73247,"_5":31544,"_21628":121784,"_28401":121785,"_3085":121786},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3634":73262,"_31209":73247,"_21628":121788,"_5":14884,"_28401":73247,"_3085":121789},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3634":73263,"_31209":73247,"_21628":121791,"_5":14884,"_28401":121741,"_3085":121792},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3634":73264,"_31209":73247,"_21628":121794,"_5":14884,"_28401":121745,"_3085":121795},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3634":73265,"_31209":73247,"_21628":121797,"_5":14884,"_28401":121749,"_3085":121798},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3634":73266,"_31209":73247,"_21628":121800,"_5":14884,"_28401":121753,"_3085":121801},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3634":73267,"_31209":73247,"_21628":121803,"_5":14884,"_28401":121757,"_3085":121804},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3634":73268,"_31209":73247,"_21628":121806,"_5":14884,"_28401":121761,"_3085":121807},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3634":73269,"_31209":73247,"_21628":121809,"_5":14884,"_28401":121761,"_3085":121810},[],"Ejecuta también la prueba de conectividad del chart:",{"_3634":73270,"_31209":73247,"_21628":121812,"_5":14884,"_28401":121761,"_3085":121813},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3634":73271,"_31209":73247,"_21628":121815,"_5":14884,"_28401":121761,"_3085":121816},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3634":73272,"_31209":73247,"_21628":121818,"_5":14884,"_28401":121765,"_3085":121819},[],"Si recibes un 401:",{"_3634":73273,"_31209":73247,"_21628":121821,"_5":14884,"_28401":121765,"_3085":121822},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3634":73274,"_31209":73247,"_21628":121824,"_5":14884,"_28401":121765,"_3085":121825},[],"verifica emisor, audiencia y expiración del token;",{"_3634":73275,"_31209":73247,"_21628":121827,"_5":14884,"_28401":121765,"_3085":121828},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3634":73276,"_31209":73247,"_21628":121830,"_5":14884,"_28401":121765,"_3085":121831},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3634":73277,"_31209":73247,"_21628":121833,"_5":14884,"_28401":121765,"_3085":121834},[],"Si el login termina pero las APIs devuelven 403:",{"_3634":73278,"_31209":73247,"_21628":121836,"_5":14884,"_28401":121765,"_3085":121837},[],"inspecciona los claims reales del token;",{"_3634":73279,"_31209":73247,"_21628":121839,"_5":14884,"_28401":121765,"_3085":121840},[],"confirma que coinciden con un principal activo;",{"_3634":73280,"_31209":73247,"_21628":121842,"_5":14884,"_28401":121765,"_3085":121843},[],"revisa las políticas concedidas al principal;",{"_3634":73281,"_31209":73247,"_21628":121845,"_5":14884,"_28401":121765,"_3085":121846},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3634":73282,"_31209":73247,"_21628":121848,"_5":14884,"_28401":121765,"_3085":121849},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3634":73283,"_31209":73247,"_21628":121851,"_5":14884,"_28401":121769,"_3085":121852},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3634":73284,"_31209":73247,"_21628":121854,"_5":14884,"_28401":121769,"_3085":121855},[],"Localiza el pod y Service de authz.",{"_3634":73285,"_31209":73247,"_21628":121857,"_5":14884,"_28401":121769,"_3085":121858},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3634":73286,"_31209":73247,"_21628":121860,"_5":14884,"_28401":121769,"_3085":121861},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3634":73287,"_31209":73247,"_21628":121863,"_5":14884,"_28401":121769,"_3085":121864},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3634":73288,"_31209":73247,"_21628":121866,"_5":14884,"_28401":121769,"_3085":121867},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3634":73289,"_31209":73247,"_21628":121869,"_5":14884,"_28401":121773,"_3085":121870},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3634":73290,"_31209":73247,"_21628":121872,"_5":14884,"_28401":121777,"_3085":121873},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3634":73291,"_31209":73247,"_21628":121875,"_5":14884,"_28401":121777,"_3085":121876},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3634":73292,"_31209":73247,"_21628":121878,"_5":14884,"_28401":121777,"_3085":121879},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3634":73293,"_31209":73247,"_21628":121881,"_5":14884,"_28401":121777,"_3085":121882},[],"volumen persistente sin enlazar;",{"_3634":73294,"_31209":73247,"_21628":121884,"_5":14884,"_28401":121777,"_3085":121885},[],"imagen inaccesible o política de pull incorrecta;",{"_3634":73295,"_31209":73247,"_21628":121887,"_5":14884,"_28401":121777,"_3085":121888},[],"configuración inválida del motor criptográfico;",{"_3634":73296,"_31209":73247,"_21628":121890,"_5":14884,"_28401":121777,"_3085":121891},[],"límites de CPU o memoria demasiado bajos;",{"_3634":73297,"_31209":73247,"_21628":121893,"_5":14884,"_28401":121777,"_3085":121894},[],"migración previa incompleta.",{"_3634":73298,"_31209":73247,"_21628":121896,"_5":14884,"_28401":121777,"_3085":121897},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3634":73299,"_31209":73247,"_21628":121899,"_5":14884,"_28401":121777,"_3085":121900},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3634":73300,"_31209":73247,"_21628":121902,"_5":14884,"_28401":121777,"_3085":121903},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3634":73301,"_31209":73247,"_21628":121905,"_5":14884,"_28401":121781,"_3085":121906},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3634":73302,"_31209":73247,"_21628":121908,"_5":14884,"_28401":121781,"_3085":121909},[],"verifica que esté habilitado en el servicio emisor;",{"_3634":73303,"_31209":73247,"_21628":121911,"_5":14884,"_28401":121781,"_3085":121912},[],"comprueba conectividad y credenciales AMQP;",{"_3634":73304,"_31209":73247,"_21628":121914,"_5":14884,"_28401":121781,"_3085":121915},[],"revisa exchange, routing key, colas y consumidores;",{"_3634":73305,"_31209":73247,"_21628":121917,"_5":14884,"_28401":121781,"_3085":121918},[],"inspecciona dead-letter queues;",{"_3634":73306,"_31209":73247,"_21628":121920,"_5":14884,"_28401":121781,"_3085":121921},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3634":73307,"_31209":73247,"_21628":121923,"_5":14884,"_28401":121781,"_3085":121924},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3634":73308,"_31209":73247,"_21628":121926,"_5":14884,"_28401":121781,"_3085":121927},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3634":73309,"_31209":73247,"_21628":121929,"_5":14884,"_28401":121781,"_3085":121930},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3634":73310,"_31209":73247,"_21628":121932,"_5":14884,"_28401":121781,"_3085":121933},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3634":73311,"_31209":73247,"_21628":121935,"_5":14884,"_28401":121781,"_3085":121936},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3634":73312,"_31209":73247,"_21628":121938,"_5":14884,"_28401":121781,"_3085":121939},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3634":73313,"_31209":73247,"_21628":121941,"_5":14884,"_28401":121781,"_3085":121942},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3634":73314,"_31209":73247,"_21628":121944,"_5":14884,"_28401":121785,"_3085":121945},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3634":73315,"_31209":73247,"_21628":121947,"_5":14884,"_28401":121785,"_3085":121948},[],"Antes de cerrar una incidencia, guarda:",{"_3634":73316,"_31209":73247,"_21628":121950,"_5":14884,"_28401":121785,"_3085":121951},[],"causa confirmada;",{"_3634":73317,"_31209":73247,"_21628":121953,"_5":14884,"_28401":121785,"_3085":121954},[],"alcance temporal y recursos afectados;",{"_3634":73318,"_31209":73247,"_21628":121956,"_5":14884,"_28401":121785,"_3085":121957},[],"comandos o consultas utilizados;",{"_3634":73319,"_31209":73247,"_21628":121959,"_5":14884,"_28401":121785,"_3085":121960},[],"cambio aplicado y forma de revertirlo;",{"_3634":73320,"_31209":73247,"_21628":121962,"_5":14884,"_28401":121785,"_3085":121963},[],"validación desde un consumidor;",{"_3634":73321,"_31209":73247,"_21628":121965,"_5":14884,"_28401":121785,"_3085":121966},[],"acción preventiva y propietario.",{"_3634":73322,"_31209":73322,"_5":15244,"_3085":121968,"_31547":121969,"_21628":121973,"_28401":73322},"Modelo de datos",[50999,121970,121971,121972],"Plataforma","Administración","Control de acceso",[],{"_3634":73323,"_31209":73322,"_21628":121975,"_5":14884,"_28401":73322,"_3085":121976},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3634":73324,"_31209":73322,"_5":31544,"_21628":121978,"_28401":121979,"_3085":121980},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3634":73325,"_31209":73322,"_5":31544,"_21628":121982,"_28401":121983,"_3085":121984},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3634":73326,"_31209":73322,"_21628":121986,"_5":14884,"_28401":73322,"_3085":121987},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3634":73327,"_31209":73322,"_21628":121989,"_5":14884,"_28401":121979,"_3085":121990},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3634":73328,"_31209":73322,"_21628":121992,"_5":14884,"_28401":121979,"_3085":121993},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3634":73329,"_31209":73322,"_21628":121995,"_5":14884,"_28401":121979,"_3085":121996},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3634":73330,"_31209":73322,"_21628":121998,"_5":14884,"_28401":121983,"_3085":121999},[],"Entidad (`schema_name.entity_type`)",{"_3634":73331,"_31209":73322,"_21628":122001,"_5":14884,"_28401":121983,"_3085":122002},[],"Tabla (`table_name`)",{"_3634":73332,"_31209":73322,"_21628":122004,"_5":14884,"_28401":121983,"_3085":122005},[],"Clave (`primary_key`)",{"_3634":73333,"_31209":73322,"_21628":122007,"_5":14884,"_28401":121983,"_3085":52549},[],{"_3634":73334,"_31209":73322,"_21628":122009,"_5":14884,"_28401":121983,"_3085":52552},[],{"_3634":73335,"_31209":73322,"_21628":122011,"_5":14884,"_28401":121983,"_3085":52555},[],{"_3634":73336,"_31209":73322,"_21628":122013,"_5":14884,"_28401":121983,"_3085":52558},[],{"_3634":73337,"_31209":73322,"_21628":122015,"_5":14884,"_28401":121983,"_3085":52561},[],{"_3634":73338,"_31209":73322,"_21628":122017,"_5":14884,"_28401":121983,"_3085":52564},[],{"_3634":73339,"_31209":73322,"_21628":122019,"_5":14884,"_28401":121983,"_3085":52567},[],{"_3634":73340,"_31209":73322,"_21628":122021,"_5":14884,"_28401":121983,"_3085":52570},[],{"_3634":73341,"_31209":73322,"_21628":122023,"_5":14884,"_28401":121983,"_3085":52564},[],{"_3634":73342,"_31209":73322,"_21628":122025,"_5":14884,"_28401":121983,"_3085":52575},[],{"_3634":73343,"_31209":73322,"_21628":122027,"_5":14884,"_28401":121983,"_3085":52578},[],{"_3634":73344,"_31209":73322,"_21628":122029,"_5":14884,"_28401":121983,"_3085":52581},[],{"_3634":73345,"_31209":73322,"_21628":122031,"_5":14884,"_28401":121983,"_3085":52584},[],{"_3634":73346,"_31209":73322,"_21628":122033,"_5":14884,"_28401":121983,"_3085":52587},[],{"_3634":73347,"_31209":73322,"_21628":122035,"_5":14884,"_28401":121983,"_3085":52564},[],{"_3634":73348,"_31209":73322,"_21628":122037,"_5":14884,"_28401":121983,"_3085":52592},[],{"_3634":73349,"_31209":73322,"_21628":122039,"_5":14884,"_28401":121983,"_3085":52595},[],{"_3634":73350,"_31209":73322,"_21628":122041,"_5":14884,"_28401":121983,"_3085":52564},[],{"_3634":73351,"_31209":73322,"_21628":122043,"_5":14884,"_28401":121983,"_3085":52600},[],{"_3634":73352,"_31209":73322,"_21628":122045,"_5":14884,"_28401":121983,"_3085":52603},[],{"_3634":73353,"_31209":73322,"_21628":122047,"_5":14884,"_28401":121983,"_3085":52564},[],{"_3634":73354,"_31209":73322,"_21628":122049,"_5":14884,"_28401":121983,"_3085":52608},[],{"_3634":73355,"_31209":73322,"_21628":122051,"_5":14884,"_28401":121983,"_3085":52611},[],{"_3634":73356,"_31209":73322,"_21628":122053,"_5":14884,"_28401":121983,"_3085":52564},[],{"_3634":73357,"_31209":73322,"_21628":122055,"_5":14884,"_28401":121983,"_3085":52616},[],{"_3634":73358,"_31209":73322,"_21628":122057,"_5":14884,"_28401":121983,"_3085":52619},[],{"_3634":73359,"_31209":73322,"_21628":122059,"_5":14884,"_28401":121983,"_3085":52622},[],{"_3634":73360,"_31209":73322,"_21628":122061,"_5":14884,"_28401":121983,"_3085":52625},[],{"_3634":73361,"_31209":73322,"_21628":122063,"_5":14884,"_28401":121983,"_3085":52628},[],{"_3634":73362,"_31209":73322,"_21628":122065,"_5":14884,"_28401":121983,"_3085":52631},[],{"_3634":73363,"_31209":73322,"_21628":122067,"_5":14884,"_28401":121983,"_3085":122068},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3634":73364,"_31209":73322,"_21628":122070,"_5":14884,"_28401":121983,"_3085":122071},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3634":73365,"_31209":73322,"_21628":122073,"_5":14884,"_28401":121983,"_3085":122074},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3634":73366,"_31209":73366,"_5":15244,"_3085":122076,"_31547":122077,"_21628":122078,"_28401":73366},"Visión general del control de acceso",[50999,121970,121971,121972],[],{"_3634":73367,"_31209":73366,"_21628":122080,"_5":14884,"_28401":73366,"_3085":122081},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3634":73368,"_31209":73366,"_5":31544,"_21628":122083,"_28401":122084,"_3085":122085},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3634":73369,"_31209":73366,"_5":31544,"_21628":122087,"_28401":122088,"_3085":122089},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3634":73370,"_31209":73366,"_5":31544,"_21628":122091,"_28401":122092,"_3085":122093},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3634":73371,"_31209":73366,"_5":31544,"_21628":122095,"_28401":122096,"_3085":122097},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3634":73372,"_31209":73366,"_5":31544,"_21628":122099,"_28401":122100,"_3085":122101},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3634":73373,"_31209":73366,"_5":31544,"_21628":122103,"_28401":122104,"_3085":122105},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3634":73374,"_31209":73366,"_5":31544,"_21628":122107,"_28401":122108,"_3085":122109},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3634":73375,"_31209":73366,"_5":31544,"_21628":122111,"_28401":122112,"_3085":122113},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3634":73376,"_31209":73366,"_5":31544,"_21628":122115,"_28401":122116,"_3085":122117},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3634":73377,"_31209":73366,"_5":31544,"_21628":122119,"_28401":122120,"_3085":122121},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3634":73378,"_31209":73366,"_5":31544,"_21628":122123,"_28401":122124,"_3085":122125},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3634":73379,"_31209":73366,"_5":31544,"_21628":122127,"_28401":122128,"_3085":122129},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3634":73380,"_31209":73366,"_5":31544,"_21628":122131,"_28401":122132,"_3085":122133},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3634":73381,"_31209":73366,"_5":31544,"_21628":122135,"_28401":122136,"_3085":122137},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3634":73382,"_31209":73366,"_5":31544,"_21628":122139,"_28401":122140,"_3085":122141},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3634":73383,"_31209":73366,"_5":31544,"_21628":122143,"_28401":122144,"_3085":121111},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3634":73384,"_31209":73366,"_5":31544,"_21628":122146,"_28401":122147,"_3085":122148},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3634":73385,"_31209":73366,"_5":31544,"_21628":122150,"_28401":122151,"_3085":122152},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3634":73386,"_31209":73366,"_5":31544,"_21628":122154,"_28401":122155,"_3085":122156},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3634":73387,"_31209":73366,"_5":31544,"_21628":122158,"_28401":122159,"_3085":122160},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3634":73388,"_31209":73366,"_5":31544,"_21628":122162,"_28401":122163,"_3085":122164},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3634":73389,"_31209":73366,"_5":31544,"_21628":122166,"_28401":122167,"_3085":122168},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3634":73390,"_31209":73366,"_5":31544,"_21628":122170,"_28401":122171,"_3085":122172},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3634":73391,"_31209":73366,"_5":31544,"_21628":122174,"_28401":122175,"_3085":122176},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3634":73392,"_31209":73366,"_5":31544,"_21628":122178,"_28401":122179,"_3085":122180},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3634":73393,"_31209":73366,"_5":31544,"_21628":122182,"_28401":122183,"_3085":122184},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3634":73394,"_31209":73366,"_5":31544,"_21628":122186,"_28401":122187,"_3085":122188},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3634":73395,"_31209":73366,"_5":31544,"_21628":122190,"_28401":122191,"_3085":122192},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3634":73396,"_31209":73366,"_5":31544,"_21628":122194,"_28401":122195,"_3085":122196},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3634":73397,"_31209":73366,"_5":31544,"_21628":122198,"_28401":122199,"_3085":122200},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3634":73398,"_31209":73366,"_5":31544,"_21628":122202,"_28401":122203,"_3085":122204},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3634":73399,"_31209":73366,"_21628":122206,"_5":14884,"_28401":73366,"_3085":122207},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3634":73400,"_31209":73366,"_21628":122209,"_5":14884,"_28401":73366,"_3085":122210},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3634":73401,"_31209":73366,"_21628":122212,"_5":14884,"_28401":73366,"_3085":122213},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3634":73402,"_31209":73366,"_21628":122215,"_5":14884,"_28401":122084,"_3085":122216},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3634":73403,"_31209":73366,"_21628":122218,"_5":14884,"_28401":122084,"_3085":122219},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3634":73404,"_31209":73366,"_21628":122221,"_5":14884,"_28401":122084,"_3085":122222},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3634":73405,"_31209":73366,"_21628":122224,"_5":14884,"_28401":122084,"_3085":122225},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3634":73406,"_31209":73366,"_21628":122227,"_5":14884,"_28401":122084,"_3085":122228},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3634":73407,"_31209":73366,"_21628":122230,"_5":14884,"_28401":122084,"_3085":122231},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3634":73408,"_31209":73366,"_21628":122233,"_5":14884,"_28401":122088,"_3085":122234},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3634":73409,"_31209":73366,"_21628":122236,"_5":14884,"_28401":122088,"_3085":122237},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3634":73410,"_31209":73366,"_21628":122239,"_5":14884,"_28401":122092,"_3085":122240},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3634":73411,"_31209":73366,"_21628":122242,"_5":14884,"_28401":122092,"_3085":122243},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3634":73412,"_31209":73366,"_21628":122245,"_5":14884,"_28401":122092,"_3085":122246},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3634":73413,"_31209":73366,"_21628":122248,"_5":14884,"_28401":122092,"_3085":122249},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3634":73414,"_31209":73366,"_21628":122251,"_5":14884,"_28401":122092,"_3085":122252},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3634":73415,"_31209":73366,"_21628":122254,"_5":14884,"_28401":122092,"_3085":122255},[],"Carga por separado las políticas concedidas a cada principal.",{"_3634":73416,"_31209":73366,"_21628":122257,"_5":14884,"_28401":122092,"_3085":122258},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3634":73417,"_31209":73366,"_21628":122260,"_5":14884,"_28401":122092,"_3085":122261},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3634":73418,"_31209":73366,"_21628":122263,"_5":14884,"_28401":122092,"_3085":122264},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3634":73419,"_31209":73366,"_21628":122266,"_5":14884,"_28401":122092,"_3085":122267},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3634":73420,"_31209":73366,"_21628":122269,"_5":14884,"_28401":122092,"_3085":122270},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3634":73421,"_31209":73366,"_21628":122272,"_5":14884,"_28401":122092,"_3085":122273},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3634":73422,"_31209":73366,"_21628":122275,"_5":14884,"_28401":122096,"_3085":122276},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3634":73423,"_31209":73366,"_21628":122278,"_5":14884,"_28401":122096,"_3085":122279},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3634":73424,"_31209":73366,"_21628":122281,"_5":14884,"_28401":122096,"_3085":122282},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3634":73425,"_31209":73366,"_21628":122284,"_5":14884,"_28401":122096,"_3085":122285},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3634":73426,"_31209":73366,"_21628":122287,"_5":14884,"_28401":122096,"_3085":122288},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3634":73427,"_31209":73366,"_21628":122290,"_5":14884,"_28401":122096,"_3085":122291},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3634":73428,"_31209":73366,"_21628":122293,"_5":14884,"_28401":122096,"_3085":122294},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3634":73429,"_31209":73366,"_21628":122296,"_5":14884,"_28401":122096,"_3085":122297},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3634":73430,"_31209":73366,"_21628":122299,"_5":14884,"_28401":122096,"_3085":122300},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3634":73431,"_31209":73366,"_21628":122302,"_5":14884,"_28401":122096,"_3085":122303},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3634":73432,"_31209":73366,"_21628":122305,"_5":14884,"_28401":122100,"_3085":122306},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3634":73433,"_31209":73366,"_21628":122308,"_5":14884,"_28401":122100,"_3085":122309},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3634":73434,"_31209":73366,"_21628":122311,"_5":14884,"_28401":122100,"_3085":122312},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3634":73435,"_31209":73366,"_21628":122314,"_5":14884,"_28401":122100,"_3085":122315},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3634":73436,"_31209":73366,"_21628":122317,"_5":14884,"_28401":122100,"_3085":122318},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3634":73437,"_31209":73366,"_21628":122320,"_5":14884,"_28401":122100,"_3085":122321},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3634":73438,"_31209":73366,"_21628":122323,"_5":14884,"_28401":122100,"_3085":122324},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3634":73439,"_31209":73366,"_21628":122326,"_5":14884,"_28401":122100,"_3085":122327},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3634":73440,"_31209":73366,"_21628":122329,"_5":14884,"_28401":122100,"_3085":122330},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3634":73441,"_31209":73366,"_21628":122332,"_5":14884,"_28401":122100,"_3085":122333},[],"Las acciones se dividen en dos grupos:",{"_3634":73442,"_31209":73366,"_21628":122335,"_5":14884,"_28401":122100,"_3085":122336},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3634":73443,"_31209":73366,"_21628":122338,"_5":14884,"_28401":122100,"_3085":122339},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3634":73444,"_31209":73366,"_21628":122341,"_5":14884,"_28401":122100,"_3085":122342},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3634":73445,"_31209":73366,"_21628":122344,"_5":14884,"_28401":122104,"_3085":122345},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3634":73446,"_31209":73366,"_21628":122347,"_5":14884,"_28401":122104,"_3085":122348},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3634":73447,"_31209":73366,"_21628":122350,"_5":14884,"_28401":122104,"_3085":122351},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3634":73448,"_31209":73366,"_21628":122353,"_5":14884,"_28401":122108,"_3085":122354},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3634":73449,"_31209":73366,"_21628":122356,"_5":14884,"_28401":122108,"_3085":122357},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3634":73450,"_31209":73366,"_21628":122359,"_5":14884,"_28401":122108,"_3085":122360},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3634":73451,"_31209":73366,"_21628":122362,"_5":14884,"_28401":122108,"_3085":122363},[],"Los operadores implementados son:",{"_3634":73452,"_31209":73366,"_21628":122365,"_5":14884,"_28401":122108,"_3085":122366},[],"`equals`, para igualdad exacta;",{"_3634":73453,"_31209":73366,"_21628":122368,"_5":14884,"_28401":122108,"_3085":122369},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3634":73454,"_31209":73366,"_21628":122371,"_5":14884,"_28401":122108,"_3085":122372},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3634":73455,"_31209":73366,"_21628":122374,"_5":14884,"_28401":122108,"_3085":122375},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3634":73456,"_31209":73366,"_21628":122377,"_5":14884,"_28401":122112,"_3085":122378},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3634":73457,"_31209":73366,"_21628":122380,"_5":14884,"_28401":122112,"_3085":122381},[],"Los modos disponibles son:",{"_3634":73458,"_31209":73366,"_21628":122383,"_5":14884,"_28401":122112,"_3085":122384},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3634":73459,"_31209":73366,"_21628":122386,"_5":14884,"_28401":122112,"_3085":122387},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3634":73460,"_31209":73366,"_21628":122389,"_5":14884,"_28401":122112,"_3085":122390},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3634":73461,"_31209":73366,"_21628":122392,"_5":14884,"_28401":122112,"_3085":122393},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3634":73462,"_31209":73366,"_21628":122395,"_5":14884,"_28401":122112,"_3085":122396},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3634":73463,"_31209":73366,"_21628":122398,"_5":14884,"_28401":122112,"_3085":122399},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3634":73464,"_31209":73366,"_21628":122401,"_5":14884,"_28401":122116,"_3085":122402},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3634":73465,"_31209":73366,"_21628":122404,"_5":14884,"_28401":122116,"_3085":122405},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3634":73466,"_31209":73366,"_21628":122407,"_5":14884,"_28401":122116,"_3085":122408},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3634":73467,"_31209":73366,"_21628":122410,"_5":14884,"_28401":122116,"_3085":122411},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3634":73468,"_31209":73366,"_21628":122413,"_5":14884,"_28401":122124,"_3085":122414},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3634":73469,"_31209":73366,"_21628":122416,"_5":14884,"_28401":122124,"_3085":122417},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3634":73470,"_31209":73366,"_21628":122419,"_5":14884,"_28401":122128,"_3085":122420},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3634":73471,"_31209":73366,"_21628":122422,"_5":14884,"_28401":122128,"_3085":122423},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3634":73472,"_31209":73366,"_21628":122425,"_5":14884,"_28401":122128,"_3085":122426},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3634":73473,"_31209":73366,"_21628":122428,"_5":14884,"_28401":122128,"_3085":122429},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3634":73474,"_31209":73366,"_21628":122431,"_5":14884,"_28401":122128,"_3085":122432},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3634":73475,"_31209":73366,"_21628":122434,"_5":14884,"_28401":122132,"_3085":122435},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3634":73476,"_31209":73366,"_21628":122437,"_5":14884,"_28401":122132,"_3085":122438},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3634":73477,"_31209":73366,"_21628":122440,"_5":14884,"_28401":122132,"_3085":122441},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3634":73478,"_31209":73366,"_21628":122443,"_5":14884,"_28401":122136,"_3085":122444},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3634":73479,"_31209":73366,"_21628":122446,"_5":14884,"_28401":122136,"_3085":122447},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3634":73480,"_31209":73366,"_21628":122449,"_5":14884,"_28401":122136,"_3085":122450},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3634":73481,"_31209":73366,"_21628":122452,"_5":14884,"_28401":122136,"_3085":122453},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3634":73482,"_31209":73366,"_21628":122455,"_5":14884,"_28401":122136,"_3085":122456},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3634":73483,"_31209":73366,"_21628":122458,"_5":14884,"_28401":122136,"_3085":122459},[],"Ten en cuenta que:",{"_3634":73484,"_31209":73366,"_21628":122461,"_5":14884,"_28401":122136,"_3085":122462},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3634":73485,"_31209":73366,"_21628":122464,"_5":14884,"_28401":122136,"_3085":122465},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3634":73486,"_31209":73366,"_21628":122467,"_5":14884,"_28401":122136,"_3085":122468},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3634":73487,"_31209":73366,"_21628":122470,"_5":14884,"_28401":122140,"_3085":122471},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3634":73488,"_31209":73366,"_21628":122473,"_5":14884,"_28401":122140,"_3085":122474},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3634":73489,"_31209":73366,"_21628":122476,"_5":14884,"_28401":122140,"_3085":122477},[],"acceso completo y de solo lectura a KMS;",{"_3634":73490,"_31209":73366,"_21628":122479,"_5":14884,"_28401":122140,"_3085":122480},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3634":73491,"_31209":73366,"_21628":122482,"_5":14884,"_28401":122140,"_3085":122483},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3634":73492,"_31209":73366,"_21628":122485,"_5":14884,"_28401":122140,"_3085":122486},[],"acceso a la interfaz;",{"_3634":73493,"_31209":73366,"_21628":122488,"_5":14884,"_28401":122140,"_3085":122489},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3634":73494,"_31209":73366,"_21628":122491,"_5":14884,"_28401":122140,"_3085":122492},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3634":73495,"_31209":73366,"_21628":122494,"_5":14884,"_28401":122140,"_3085":122495},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3634":73496,"_31209":73366,"_21628":122497,"_5":14884,"_28401":122140,"_3085":122498},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3634":73497,"_31209":73366,"_21628":122500,"_5":14884,"_28401":122140,"_3085":122501},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3634":73498,"_31209":73366,"_21628":122503,"_5":14884,"_28401":122144,"_3085":122504},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3634":73499,"_31209":73366,"_21628":122506,"_5":14884,"_28401":122144,"_3085":122507},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3634":73500,"_31209":73366,"_21628":122509,"_5":14884,"_28401":122144,"_3085":122510},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3634":73501,"_31209":73366,"_21628":122512,"_5":14884,"_28401":122147,"_3085":122513},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3634":73502,"_31209":73366,"_21628":122515,"_5":14884,"_28401":122151,"_3085":122516},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3634":73503,"_31209":73366,"_21628":122518,"_5":14884,"_28401":122151,"_3085":122519},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3634":73504,"_31209":73366,"_21628":122521,"_5":14884,"_28401":122155,"_3085":122522},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3634":73505,"_31209":73366,"_21628":122524,"_5":14884,"_28401":122159,"_3085":122525},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3634":73506,"_31209":73366,"_21628":122527,"_5":14884,"_28401":122163,"_3085":122528},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3634":73507,"_31209":73366,"_21628":122530,"_5":14884,"_28401":122167,"_3085":122531},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3634":73508,"_31209":73366,"_21628":122533,"_5":14884,"_28401":122167,"_3085":122534},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3634":73509,"_31209":73366,"_21628":122536,"_5":14884,"_28401":122171,"_3085":122537},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3634":73510,"_31209":73366,"_21628":122539,"_5":14884,"_28401":122171,"_3085":122540},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3634":73511,"_31209":73366,"_21628":122542,"_5":14884,"_28401":122171,"_3085":122543},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3634":73512,"_31209":73366,"_21628":122545,"_5":14884,"_28401":122171,"_3085":122546},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3634":73513,"_31209":73366,"_21628":122548,"_5":14884,"_28401":122171,"_3085":122549},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3634":73514,"_31209":73366,"_21628":122551,"_5":14884,"_28401":122171,"_3085":122552},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3634":73515,"_31209":73366,"_21628":122554,"_5":14884,"_28401":122171,"_3085":122555},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3634":73516,"_31209":73366,"_21628":122557,"_5":14884,"_28401":122171,"_3085":122558},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3634":73517,"_31209":73366,"_21628":122560,"_5":14884,"_28401":122175,"_3085":122561},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3634":73518,"_31209":73366,"_21628":122563,"_5":14884,"_28401":122175,"_3085":122564},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3634":73519,"_31209":73366,"_21628":122566,"_5":14884,"_28401":122175,"_3085":122567},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3634":73520,"_31209":73366,"_21628":122569,"_5":14884,"_28401":122179,"_3085":122570},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3634":73521,"_31209":73366,"_21628":122572,"_5":14884,"_28401":122179,"_3085":122573},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3634":73522,"_31209":73366,"_21628":122575,"_5":14884,"_28401":122179,"_3085":122576},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3634":73523,"_31209":73366,"_21628":122578,"_5":14884,"_28401":122179,"_3085":122579},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3634":73524,"_31209":73366,"_21628":122581,"_5":14884,"_28401":122179,"_3085":122582},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3634":73525,"_31209":73366,"_21628":122584,"_5":14884,"_28401":122179,"_3085":122585},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3634":73526,"_31209":73366,"_21628":122587,"_5":14884,"_28401":122179,"_3085":122588},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3634":73527,"_31209":73366,"_21628":122590,"_5":14884,"_28401":122179,"_3085":122591},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3634":73528,"_31209":73366,"_21628":122593,"_5":14884,"_28401":122187,"_3085":122594},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3634":73529,"_31209":73366,"_21628":122596,"_5":14884,"_28401":122191,"_3085":122597},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3634":73530,"_31209":73366,"_21628":122599,"_5":14884,"_28401":122191,"_3085":122600},[],"que exista un principal activo del tipo correcto;",{"_3634":73531,"_31209":73366,"_21628":122602,"_5":14884,"_28401":122191,"_3085":122603},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3634":73532,"_31209":73366,"_21628":122605,"_5":14884,"_28401":122191,"_3085":122606},[],"que todas las condiciones del principal se cumplan;",{"_3634":73533,"_31209":73366,"_21628":122608,"_5":14884,"_28401":122191,"_3085":122609},[],"que el principal tenga concedida la política esperada;",{"_3634":73534,"_31209":73366,"_21628":122611,"_5":14884,"_28401":122191,"_3085":122612},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3634":73535,"_31209":73366,"_21628":122614,"_5":14884,"_28401":122191,"_3085":122615},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3634":73536,"_31209":73366,"_21628":122617,"_5":14884,"_28401":122191,"_3085":122618},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3634":73537,"_31209":73366,"_21628":122620,"_5":14884,"_28401":122191,"_3085":122621},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3634":73538,"_31209":73366,"_21628":122623,"_5":14884,"_28401":122195,"_3085":122624},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3634":73539,"_31209":73366,"_21628":122626,"_5":14884,"_28401":122199,"_3085":122627},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3634":73540,"_31209":73366,"_21628":122629,"_5":14884,"_28401":122203,"_3085":122630},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3634":73541,"_31209":73366,"_21628":122632,"_5":14884,"_28401":122203,"_3085":122633},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3634":73542,"_31209":73542,"_5":15244,"_3085":122635,"_31547":122636,"_21628":122637,"_28401":73542},"Alertas y suscripciones",[50999,121970,121971],[],{"_3634":73543,"_31209":73542,"_21628":122639,"_5":14884,"_28401":73542,"_3085":122640},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3634":73544,"_31209":73542,"_5":31544,"_21628":122642,"_28401":122643,"_3085":122644},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3634":73545,"_31209":73542,"_5":31544,"_21628":122646,"_28401":122647,"_3085":122648},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3634":73546,"_31209":73542,"_5":31544,"_21628":122650,"_28401":122651,"_3085":122652},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3634":73547,"_31209":73542,"_5":31544,"_21628":122654,"_28401":122655,"_3085":122656},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3634":73548,"_31209":73542,"_5":31544,"_21628":122658,"_28401":122659,"_3085":122660},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3634":73549,"_31209":73542,"_5":31544,"_21628":122662,"_28401":122663,"_3085":122664},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3634":73550,"_31209":73542,"_5":31544,"_21628":122666,"_28401":122667,"_3085":122668},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3634":73551,"_31209":73542,"_5":31544,"_21628":122670,"_28401":122671,"_3085":122672},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3634":73552,"_31209":73542,"_5":31544,"_21628":122674,"_28401":122675,"_3085":122676},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3634":73553,"_31209":73542,"_5":31544,"_21628":122678,"_28401":122679,"_3085":122680},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3634":73554,"_31209":73542,"_5":31544,"_21628":122682,"_28401":122683,"_3085":122684},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3634":73555,"_31209":73542,"_21628":122686,"_5":14884,"_28401":73542,"_3085":122687},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3634":73556,"_31209":73542,"_21628":122689,"_5":14884,"_28401":122643,"_3085":122690},[],"Un servicio publica un evento de dominio.",{"_3634":73557,"_31209":73542,"_21628":122692,"_5":14884,"_28401":122643,"_3085":122693},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3634":73558,"_31209":73542,"_21628":122695,"_5":14884,"_28401":122643,"_3085":122696},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3634":73559,"_31209":73542,"_21628":122698,"_5":14884,"_28401":122643,"_3085":122699},[],"Lamassu entrega el evento al canal configurado.",{"_3634":73560,"_31209":73542,"_21628":122701,"_5":14884,"_28401":122643,"_3085":122702},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3634":73561,"_31209":73542,"_21628":122704,"_5":14884,"_28401":122647,"_3085":122705},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3634":73562,"_31209":73542,"_21628":122707,"_5":14884,"_28401":122647,"_3085":122708},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3634":73563,"_31209":73542,"_21628":122710,"_5":14884,"_28401":122647,"_3085":122711},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3634":73564,"_31209":73542,"_21628":122713,"_5":14884,"_28401":122647,"_3085":122714},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3634":73565,"_31209":73542,"_21628":122716,"_5":14884,"_28401":122647,"_3085":122717},[],"`apikey_options` necesita `header` y `key`.",{"_3634":73566,"_31209":73542,"_21628":122719,"_5":14884,"_28401":122647,"_3085":122720},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3634":73567,"_31209":73542,"_21628":122722,"_5":14884,"_28401":122647,"_3085":122723},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3634":73568,"_31209":73542,"_21628":122725,"_5":14884,"_28401":122647,"_3085":122726},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3634":73569,"_31209":73542,"_21628":122728,"_5":14884,"_28401":122655,"_3085":122729},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3634":73570,"_31209":73542,"_21628":122731,"_5":14884,"_28401":122659,"_3085":122732},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3634":73571,"_31209":73542,"_21628":122734,"_5":14884,"_28401":122663,"_3085":122735},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3634":73572,"_31209":73542,"_21628":122737,"_5":14884,"_28401":122663,"_3085":122738},[],"**None** notifica todas las instancias del evento.",{"_3634":73573,"_31209":73542,"_21628":122740,"_5":14884,"_28401":122663,"_3085":122741},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3634":73574,"_31209":73542,"_21628":122743,"_5":14884,"_28401":122663,"_3085":122744},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3634":73575,"_31209":73542,"_21628":122746,"_5":14884,"_28401":122663,"_3085":122747},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3634":73576,"_31209":73542,"_21628":122749,"_5":14884,"_28401":122663,"_3085":122750},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3634":73577,"_31209":73542,"_21628":122752,"_5":14884,"_28401":122663,"_3085":122753},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3634":73578,"_31209":73542,"_21628":122755,"_5":14884,"_28401":122667,"_3085":122756},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3634":73579,"_31209":73542,"_21628":122758,"_5":14884,"_28401":122671,"_3085":122759},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3634":73580,"_31209":73542,"_21628":122761,"_5":14884,"_28401":122671,"_3085":122762},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3634":73581,"_31209":73542,"_21628":122764,"_5":14884,"_28401":122671,"_3085":122765},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3634":73582,"_31209":73542,"_21628":122767,"_5":14884,"_28401":122671,"_3085":122768},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3634":73583,"_31209":73542,"_21628":122770,"_5":14884,"_28401":122671,"_3085":122771},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3634":73584,"_31209":73542,"_21628":122773,"_5":14884,"_28401":122671,"_3085":122774},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3634":73585,"_31209":73542,"_21628":122776,"_5":14884,"_28401":122671,"_3085":122777},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3634":73586,"_31209":73542,"_21628":122779,"_5":14884,"_28401":122671,"_3085":122780},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3634":73587,"_31209":73542,"_21628":122782,"_5":14884,"_28401":122675,"_3085":122783},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3634":73588,"_31209":73542,"_21628":122785,"_5":14884,"_28401":122675,"_3085":122786},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3634":73589,"_31209":73542,"_21628":122788,"_5":14884,"_28401":122675,"_3085":122789},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3634":73590,"_31209":73542,"_21628":122791,"_5":14884,"_28401":122675,"_3085":122792},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3634":73591,"_31209":73542,"_21628":122794,"_5":14884,"_28401":122675,"_3085":122795},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3634":73592,"_31209":73542,"_21628":122797,"_5":14884,"_28401":122675,"_3085":122798},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3634":73593,"_31209":73542,"_21628":122800,"_5":14884,"_28401":122675,"_3085":122801},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3634":73594,"_31209":73542,"_21628":122803,"_5":14884,"_28401":122675,"_3085":122804},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3634":73595,"_31209":73542,"_21628":122806,"_5":14884,"_28401":122679,"_3085":122807},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3634":73596,"_31209":73542,"_21628":122809,"_5":14884,"_28401":122679,"_3085":122810},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3634":73597,"_31209":73542,"_21628":122812,"_5":14884,"_28401":122683,"_3085":122813},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3634":73598,"_31209":73542,"_21628":122815,"_5":14884,"_28401":122683,"_3085":122816},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3634":73599,"_31209":73542,"_21628":122818,"_5":14884,"_28401":122683,"_3085":122819},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3634":73600,"_31209":73542,"_21628":122821,"_5":14884,"_28401":122683,"_3085":122822},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3634":73601,"_31209":73542,"_21628":122824,"_5":14884,"_28401":122683,"_3085":122825},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3634":73602,"_31209":73542,"_21628":122827,"_5":14884,"_28401":122683,"_3085":122828},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3634":73603,"_31209":73542,"_21628":122830,"_5":14884,"_28401":122683,"_3085":122831},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3634":73604,"_31209":73542,"_21628":122833,"_5":14884,"_28401":122683,"_3085":122834},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3634":73605,"_31209":73542,"_21628":122836,"_5":14884,"_28401":122683,"_3085":122837},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3634":73606,"_31209":73542,"_21628":122839,"_5":14884,"_28401":122683,"_3085":122840},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3634":73607,"_31209":73607,"_5":15244,"_3085":122842,"_31547":122843,"_21628":122844,"_28401":73607},"Registros de auditoría",[50999,121970,121971],[],{"_3634":73608,"_31209":73607,"_21628":122846,"_5":14884,"_28401":73607,"_3085":122847},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3634":73609,"_31209":73607,"_5":31544,"_21628":122849,"_28401":122850,"_3085":122851},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3634":73610,"_31209":73607,"_5":31544,"_21628":122853,"_28401":122854,"_3085":122855},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3634":73611,"_31209":73607,"_5":31544,"_21628":122857,"_28401":122858,"_3085":122859},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3634":73612,"_31209":73607,"_5":31544,"_21628":122861,"_28401":122862,"_3085":122863},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3634":73613,"_31209":73607,"_5":31544,"_21628":122865,"_28401":122866,"_3085":122867},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3634":73614,"_31209":73607,"_5":31544,"_21628":122869,"_28401":122870,"_3085":122871},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3634":73615,"_31209":73607,"_5":31544,"_21628":122873,"_28401":122874,"_3085":122875},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3634":73616,"_31209":73607,"_5":31544,"_21628":122877,"_28401":122878,"_3085":122879},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3634":73617,"_31209":73607,"_5":31544,"_21628":122881,"_28401":122882,"_3085":122883},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3634":73618,"_31209":73607,"_5":31544,"_21628":122885,"_28401":122886,"_3085":122887},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3634":73619,"_31209":73607,"_5":31544,"_21628":122889,"_28401":122890,"_3085":122891},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3634":73620,"_31209":73607,"_21628":122893,"_5":14884,"_28401":73607,"_3085":122894},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3634":73621,"_31209":73607,"_21628":122896,"_5":14884,"_28401":122850,"_3085":122897},[],"El cuerpo de auditoría incluye:",{"_3634":73622,"_31209":73607,"_21628":122899,"_5":14884,"_28401":122850,"_3085":122900},[],"input: datos recibidos por la operación;",{"_3634":73623,"_31209":73607,"_21628":122902,"_5":14884,"_28401":122850,"_3085":122903},[],"has\\_error: indica si el servicio devolvió un error;",{"_3634":73624,"_31209":73607,"_21628":122905,"_5":14884,"_28401":122850,"_3085":122906},[],"output: resultado producido o mensaje de error;",{"_3634":73625,"_31209":73607,"_21628":122908,"_5":14884,"_28401":122850,"_3085":122909},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3634":73626,"_31209":73607,"_21628":122911,"_5":14884,"_28401":122850,"_3085":122912},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3634":73627,"_31209":73607,"_21628":122914,"_5":14884,"_28401":122850,"_3085":122915},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3634":73628,"_31209":73607,"_21628":122917,"_5":14884,"_28401":122854,"_3085":122918},[],"El backend aplica auditoría a mutaciones de:",{"_3634":73629,"_31209":73607,"_21628":122920,"_5":14884,"_28401":122854,"_3085":122921},[],"autoridades, certificados y perfiles de emisión;",{"_3634":73630,"_31209":73607,"_21628":122923,"_5":14884,"_28401":122854,"_3085":122924},[],"claves y motores KMS;",{"_3634":73631,"_31209":73607,"_21628":122926,"_5":14884,"_28401":122854,"_3085":122927},[],"dispositivos e identidades;",{"_3634":73632,"_31209":73607,"_21628":122929,"_5":14884,"_28401":122854,"_3085":122930},[],"DMS y operaciones de enrolamiento;",{"_3634":73633,"_31209":73607,"_21628":122932,"_5":14884,"_28401":122854,"_3085":122933},[],"funciones de validación y CRL;",{"_3634":73634,"_31209":73607,"_21628":122935,"_5":14884,"_28401":122854,"_3085":122936},[],"principales, políticas y concesiones de autorización.",{"_3634":73635,"_31209":73607,"_21628":122938,"_5":14884,"_28401":122854,"_3085":122939},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3634":73636,"_31209":73607,"_21628":122941,"_5":14884,"_28401":122858,"_3085":122942},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3634":73637,"_31209":73607,"_21628":122944,"_5":14884,"_28401":122858,"_3085":122945},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3634":73638,"_31209":73607,"_21628":122947,"_5":14884,"_28401":122858,"_3085":122948},[],"Diseña el consumidor para:",{"_3634":73639,"_31209":73607,"_21628":122950,"_5":14884,"_28401":122858,"_3085":122951},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3634":73640,"_31209":73607,"_21628":122953,"_5":14884,"_28401":122858,"_3085":122954},[],"conservar el CloudEvent completo sin modificar;",{"_3634":73641,"_31209":73607,"_21628":122956,"_5":14884,"_28401":122858,"_3085":122957},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3634":73642,"_31209":73607,"_21628":122959,"_5":14884,"_28401":122858,"_3085":122960},[],"cifrar en tránsito y en reposo;",{"_3634":73643,"_31209":73607,"_21628":122962,"_5":14884,"_28401":122858,"_3085":122963},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3634":73644,"_31209":73607,"_21628":122965,"_5":14884,"_28401":122858,"_3085":122966},[],"aplicar una política explícita de retención y legal hold;",{"_3634":73645,"_31209":73607,"_21628":122968,"_5":14884,"_28401":122858,"_3085":122969},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3634":73646,"_31209":73607,"_21628":122971,"_5":14884,"_28401":122862,"_3085":122972},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3634":73647,"_31209":73607,"_21628":122974,"_5":14884,"_28401":122862,"_3085":122975},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3634":73648,"_31209":73607,"_21628":122977,"_5":14884,"_28401":122870,"_3085":122978},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3634":73649,"_31209":73607,"_21628":122980,"_5":14884,"_28401":122874,"_3085":122981},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3634":73650,"_31209":73607,"_21628":122983,"_5":14884,"_28401":122878,"_3085":122984},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3634":73651,"_31209":73607,"_21628":122986,"_5":14884,"_28401":122882,"_3085":122987},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3634":73652,"_31209":73607,"_21628":122989,"_5":14884,"_28401":122886,"_3085":122990},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3634":73653,"_31209":73607,"_21628":122992,"_5":14884,"_28401":122890,"_3085":122993},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3634":73654,"_31209":73607,"_21628":122995,"_5":14884,"_28401":122890,"_3085":122996},[],"aparece un evento de auditoría correcto;",{"_3634":73655,"_31209":73607,"_21628":122998,"_5":14884,"_28401":122890,"_3085":122999},[],"el principal coincide con la identidad utilizada;",{"_3634":73656,"_31209":73607,"_21628":123001,"_5":14884,"_28401":122890,"_3085":123002},[],"el consumidor lo persiste una sola vez;",{"_3634":73657,"_31209":73607,"_21628":123004,"_5":14884,"_28401":122890,"_3085":123005},[],"puede recuperarse por recurso, actor y periodo;",{"_3634":73658,"_31209":73607,"_21628":123007,"_5":14884,"_28401":122890,"_3085":123008},[],"una interrupción del consumidor produce una alerta.",{"_3634":73659,"_31209":73607,"_21628":123010,"_5":14884,"_28401":122890,"_3085":123011},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3634":73660,"_31209":73660,"_5":15244,"_3085":123013,"_31547":123014,"_21628":123015,"_28401":73660},"Arquitectura de la plataforma",[50999,121970],[],{"_3634":73661,"_31209":73660,"_21628":123017,"_5":14884,"_28401":73660,"_3085":123018},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3634":73662,"_31209":73660,"_5":31544,"_21628":123020,"_28401":123021,"_3085":123022},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3634":73663,"_31209":73660,"_5":31544,"_21628":123024,"_28401":123025,"_3085":123026},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3634":73664,"_31209":73660,"_5":31544,"_21628":123028,"_28401":123029,"_3085":123030},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3634":73665,"_31209":73660,"_5":31544,"_21628":123032,"_28401":123033,"_3085":123034},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3634":73666,"_31209":73660,"_5":31544,"_21628":123036,"_28401":123037,"_3085":123038},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3634":73667,"_31209":73660,"_21628":123040,"_5":14884,"_28401":73660,"_3085":123041},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3634":73668,"_31209":73660,"_21628":123043,"_5":14884,"_28401":73660,"_3085":123044},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3634":73669,"_31209":73660,"_21628":123046,"_5":14884,"_28401":123021,"_3085":123047},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3634":73670,"_31209":73660,"_21628":123049,"_5":14884,"_28401":123025,"_3085":123050},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3634":73671,"_31209":73660,"_21628":123052,"_5":14884,"_28401":123029,"_3085":123053},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3634":73672,"_31209":73660,"_21628":123055,"_5":14884,"_28401":123033,"_3085":123056},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3634":73673,"_31209":73660,"_21628":123058,"_5":14884,"_28401":123037,"_3085":123059},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3634":73674,"_31209":73674,"_5":15244,"_3085":123061,"_31547":123062,"_21628":123063,"_28401":73674},"Cómo funciona Lamassu",[50999,121970],[],{"_3634":73675,"_31209":73674,"_21628":123065,"_5":14884,"_28401":73674,"_3085":123066},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3634":73676,"_31209":73674,"_5":31544,"_21628":123068,"_28401":123069,"_3085":123070},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3634":73677,"_31209":73674,"_5":31544,"_21628":123072,"_28401":123073,"_3085":123074},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3634":73678,"_31209":73674,"_21628":123076,"_5":14884,"_28401":73674,"_3085":123077},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3634":73679,"_31209":73674,"_21628":123079,"_5":14884,"_28401":123069,"_3085":123080},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3634":73680,"_31209":73674,"_21628":123082,"_5":14884,"_28401":123069,"_3085":123083},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3634":73681,"_31209":73674,"_21628":123085,"_5":14884,"_28401":123069,"_3085":123086},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3634":73682,"_31209":73674,"_21628":123088,"_5":14884,"_28401":123069,"_3085":123089},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3634":73683,"_31209":73674,"_21628":123091,"_5":14884,"_28401":123069,"_3085":123092},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3634":73684,"_31209":73674,"_21628":123094,"_5":14884,"_28401":123073,"_3085":123095},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3634":73685,"_31209":73674,"_21628":123097,"_5":14884,"_28401":123073,"_3085":123098},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3634":73686,"_31209":73674,"_21628":123100,"_5":14884,"_28401":123073,"_3085":123101},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3634":73687,"_31209":73674,"_21628":123103,"_5":14884,"_28401":123073,"_3085":123104},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3634":73688,"_31209":73674,"_21628":123106,"_5":14884,"_28401":123073,"_3085":123107},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3634":73689,"_31209":73674,"_21628":123109,"_5":14884,"_28401":123073,"_3085":123110},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3634":73690,"_31209":73674,"_21628":123112,"_5":14884,"_28401":123073,"_3085":123113},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3634":73691,"_31209":73691,"_5":15244,"_3085":123115,"_31547":123116,"_21628":123117,"_28401":73691},"Dispositivos e identidades",[50999,121970,53683,123115],[],{"_3634":73692,"_31209":73691,"_21628":123119,"_5":14884,"_28401":73691,"_3085":123120},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3634":73693,"_31209":73691,"_5":31544,"_21628":123122,"_28401":123123,"_3085":123124},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3634":73694,"_31209":73691,"_5":31544,"_21628":123126,"_28401":123127,"_3085":123128},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3634":73695,"_31209":73691,"_5":31544,"_21628":123130,"_28401":123131,"_3085":123132},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3634":73696,"_31209":73691,"_5":31544,"_21628":123134,"_28401":123135,"_3085":123136},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3634":73697,"_31209":73691,"_5":31544,"_21628":123138,"_28401":123139,"_3085":123140},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3634":73698,"_31209":73691,"_5":31544,"_21628":123142,"_28401":123143,"_3085":123144},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3634":73699,"_31209":73691,"_5":31544,"_21628":123146,"_28401":123147,"_3085":123148},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3634":73700,"_31209":73691,"_5":31544,"_21628":123150,"_28401":123151,"_3085":123152},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3634":73701,"_31209":73691,"_5":31544,"_21628":123154,"_28401":123155,"_3085":123156},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3634":73702,"_31209":73691,"_5":31544,"_21628":123158,"_28401":123159,"_3085":123160},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3634":73703,"_31209":73691,"_5":31544,"_21628":123162,"_28401":123163,"_3085":123164},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3634":73704,"_31209":73691,"_21628":123166,"_5":14884,"_28401":73691,"_3085":123167},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3634":73705,"_31209":73691,"_21628":123169,"_5":14884,"_28401":73691,"_3085":123170},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3634":73706,"_31209":73691,"_21628":123172,"_5":14884,"_28401":123123,"_3085":123173},[],"Vista operativa",{"_3634":73707,"_31209":73691,"_21628":123175,"_5":14884,"_28401":123123,"_3085":123176},[],"Interpretación",{"_3634":73708,"_31209":73691,"_21628":123178,"_5":14884,"_28401":123123,"_3085":53746},[],{"_3634":73709,"_31209":73691,"_21628":123180,"_5":14884,"_28401":123123,"_3085":123181},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3634":73710,"_31209":73691,"_21628":123183,"_5":14884,"_28401":123123,"_3085":53752},[],{"_3634":73711,"_31209":73691,"_21628":123185,"_5":14884,"_28401":123123,"_3085":123186},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3634":73712,"_31209":73691,"_21628":123188,"_5":14884,"_28401":123123,"_3085":53758},[],{"_3634":73713,"_31209":73691,"_21628":123190,"_5":14884,"_28401":123123,"_3085":123191},[],"La identidad está en la ventana operativa de renovación.",{"_3634":73714,"_31209":73691,"_21628":123193,"_5":14884,"_28401":123123,"_3085":53764},[],{"_3634":73715,"_31209":73691,"_21628":123195,"_5":14884,"_28401":123123,"_3085":123196},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3634":73716,"_31209":73691,"_21628":123198,"_5":14884,"_28401":123123,"_3085":53770},[],{"_3634":73717,"_31209":73691,"_21628":123200,"_5":14884,"_28401":123123,"_3085":123201},[],"La identidad ha vencido.",{"_3634":73718,"_31209":73691,"_21628":123203,"_5":14884,"_28401":123123,"_3085":53776},[],{"_3634":73719,"_31209":73691,"_21628":123205,"_5":14884,"_28401":123123,"_3085":123206},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3634":73720,"_31209":73691,"_21628":123208,"_5":14884,"_28401":123123,"_3085":53782},[],{"_3634":73721,"_31209":73691,"_21628":123210,"_5":14884,"_28401":123123,"_3085":123211},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3634":73722,"_31209":73691,"_21628":123213,"_5":14884,"_28401":123123,"_3085":123214},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3634":73723,"_31209":73691,"_21628":123216,"_5":14884,"_28401":123127,"_3085":123217},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3634":73724,"_31209":73691,"_21628":123219,"_5":14884,"_28401":123127,"_3085":123220},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3634":73725,"_31209":73691,"_21628":123222,"_5":14884,"_28401":123127,"_3085":123223},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3634":73726,"_31209":73691,"_21628":123225,"_5":14884,"_28401":123127,"_3085":123226},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3634":73727,"_31209":73691,"_21628":123228,"_5":14884,"_28401":123131,"_3085":123229},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3634":73728,"_31209":73691,"_21628":123231,"_5":14884,"_28401":123135,"_3085":123232},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3634":73729,"_31209":73691,"_21628":123234,"_5":14884,"_28401":123139,"_3085":123235},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3634":73730,"_31209":73691,"_21628":123237,"_5":14884,"_28401":123143,"_3085":123238},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3634":73731,"_31209":73691,"_21628":123240,"_5":14884,"_28401":123147,"_3085":123241},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3634":73732,"_31209":73691,"_21628":123243,"_5":14884,"_28401":123147,"_3085":123244},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3634":73733,"_31209":73691,"_21628":123246,"_5":14884,"_28401":123151,"_3085":123247},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3634":73734,"_31209":73691,"_21628":123249,"_5":14884,"_28401":123151,"_3085":123250},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3634":73735,"_31209":73691,"_21628":123252,"_5":14884,"_28401":123151,"_3085":123253},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3634":73736,"_31209":73691,"_21628":123255,"_5":14884,"_28401":123151,"_3085":123256},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3634":73737,"_31209":73691,"_21628":123258,"_5":14884,"_28401":123151,"_3085":123259},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3634":73738,"_31209":73691,"_21628":123261,"_5":14884,"_28401":123151,"_3085":123262},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3634":73739,"_31209":73691,"_21628":123264,"_5":14884,"_28401":123155,"_3085":123265},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3634":73740,"_31209":73691,"_21628":123267,"_5":14884,"_28401":123155,"_3085":123268},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3634":73741,"_31209":73691,"_21628":123270,"_5":14884,"_28401":123155,"_3085":123271},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3634":73742,"_31209":73691,"_21628":123273,"_5":14884,"_28401":123159,"_3085":123274},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3634":73743,"_31209":73691,"_21628":123276,"_5":14884,"_28401":123159,"_3085":123277},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3634":73744,"_31209":73691,"_21628":123279,"_5":14884,"_28401":123159,"_3085":123280},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3634":73745,"_31209":73691,"_21628":123282,"_5":14884,"_28401":123159,"_3085":123283},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3634":73746,"_31209":73691,"_21628":123285,"_5":14884,"_28401":123163,"_3085":123286},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3634":73747,"_31209":73691,"_21628":123288,"_5":14884,"_28401":123163,"_3085":123289},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3634":73748,"_31209":73748,"_5":15244,"_3085":123291,"_31547":123292,"_21628":123294,"_28401":73748},"Identidad inicial y autenticación",[50999,121970,53683,123115,123293],"Enrolamiento con PKI",[],{"_3634":73749,"_31209":73748,"_21628":123296,"_5":14884,"_28401":73748,"_3085":123297},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3634":73750,"_31209":73748,"_5":31544,"_21628":123299,"_28401":123300,"_3085":123301},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3634":73751,"_31209":73748,"_5":31544,"_21628":123303,"_28401":123304,"_3085":123305},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3634":73752,"_31209":73748,"_5":31544,"_21628":123307,"_28401":123308,"_3085":123309},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3634":73753,"_31209":73748,"_5":31544,"_21628":123311,"_28401":123312,"_3085":123313},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3634":73754,"_31209":73748,"_5":31544,"_21628":123315,"_28401":123316,"_3085":123317},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3634":73755,"_31209":73748,"_21628":123319,"_5":14884,"_28401":73748,"_3085":123320},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3634":73756,"_31209":73748,"_21628":123322,"_5":14884,"_28401":123300,"_3085":123323},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3634":73757,"_31209":73748,"_21628":123325,"_5":14884,"_28401":123300,"_3085":123326},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3634":73758,"_31209":73748,"_21628":123328,"_5":14884,"_28401":123304,"_3085":123329},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3634":73759,"_31209":73748,"_21628":123331,"_5":14884,"_28401":123304,"_3085":123332},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3634":73760,"_31209":73748,"_21628":123334,"_5":14884,"_28401":123304,"_3085":123335},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3634":73761,"_31209":73748,"_21628":123337,"_5":14884,"_28401":123308,"_3085":123338},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3634":73762,"_31209":73748,"_21628":123340,"_5":14884,"_28401":123308,"_3085":123341},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3634":73763,"_31209":73748,"_21628":123343,"_5":14884,"_28401":123312,"_3085":123344},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3634":73764,"_31209":73748,"_21628":123346,"_5":14884,"_28401":123312,"_3085":123347},[],"Ejemplo de cuerpo:",{"_3634":73765,"_31209":73748,"_21628":123349,"_5":14884,"_28401":123312,"_3085":123350},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3634":73766,"_31209":73748,"_21628":123352,"_5":14884,"_28401":123312,"_3085":123353},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3634":73767,"_31209":73748,"_21628":123355,"_5":14884,"_28401":123312,"_3085":123356},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3634":73768,"_31209":73748,"_21628":123358,"_5":14884,"_28401":123312,"_3085":123359},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3634":73769,"_31209":73748,"_21628":123361,"_5":14884,"_28401":123316,"_3085":123362},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3634":73770,"_31209":73748,"_21628":123364,"_5":14884,"_28401":123316,"_3085":123365},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca — `thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas — y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3634":73771,"_31209":73748,"_21628":123367,"_5":14884,"_28401":123316,"_3085":123368},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3634":73772,"_31209":73748,"_21628":123370,"_5":14884,"_28401":123316,"_3085":123371},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3634":73773,"_31209":73773,"_5":15244,"_3085":123373,"_31547":123374,"_21628":123375,"_28401":73773},"Configura y opera el DMS",[50999,121970,53683,123115,123293],[],{"_3634":73774,"_31209":73773,"_21628":123377,"_5":14884,"_28401":73773,"_3085":123378},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3634":73775,"_31209":73773,"_5":31544,"_21628":123380,"_28401":123381,"_3085":120504},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3634":73776,"_31209":73773,"_5":31544,"_21628":123383,"_28401":123384,"_3085":123385},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3634":73777,"_31209":73773,"_5":31544,"_21628":123387,"_28401":123388,"_3085":123389},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3634":73778,"_31209":73773,"_5":31544,"_21628":123391,"_28401":123392,"_3085":123393},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3634":73779,"_31209":73773,"_5":31544,"_21628":123395,"_28401":123396,"_3085":123397},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3634":73780,"_31209":73773,"_5":31544,"_21628":123399,"_28401":123400,"_3085":123401},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3634":73781,"_31209":73773,"_5":31544,"_21628":123403,"_28401":123404,"_3085":123405},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3634":73782,"_31209":73773,"_5":31544,"_21628":123407,"_28401":123408,"_3085":123409},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3634":73783,"_31209":73773,"_5":31544,"_21628":123411,"_28401":123412,"_3085":53987},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3634":73784,"_31209":73773,"_5":31544,"_21628":123414,"_28401":123415,"_3085":53991},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3634":73785,"_31209":73773,"_5":31544,"_21628":123417,"_28401":123418,"_3085":123419},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3634":73786,"_31209":73773,"_5":31544,"_21628":123421,"_28401":123422,"_3085":123423},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3634":73787,"_31209":73773,"_5":31544,"_21628":123425,"_28401":123426,"_3085":123427},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3634":73788,"_31209":73773,"_5":31544,"_21628":123429,"_28401":123430,"_3085":123431},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3634":73789,"_31209":73773,"_5":31544,"_21628":123433,"_28401":123434,"_3085":54011},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3634":73790,"_31209":73773,"_5":31544,"_21628":123436,"_28401":123437,"_3085":123438},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3634":73791,"_31209":73773,"_5":31544,"_21628":123440,"_28401":123441,"_3085":123442},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3634":73792,"_31209":73773,"_5":31544,"_21628":123444,"_28401":123445,"_3085":123446},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3634":73793,"_31209":73773,"_21628":123448,"_5":14884,"_28401":73773,"_3085":123449},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3634":73794,"_31209":73773,"_21628":123451,"_5":14884,"_28401":123381,"_3085":123452},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3634":73795,"_31209":73773,"_21628":123454,"_5":14884,"_28401":123381,"_3085":123455},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3634":73796,"_31209":73773,"_21628":123457,"_5":14884,"_28401":123388,"_3085":123458},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3634":73797,"_31209":73773,"_21628":123460,"_5":14884,"_28401":123392,"_3085":123461},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3634":73798,"_31209":73773,"_21628":123463,"_5":14884,"_28401":123396,"_3085":123464},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3634":73799,"_31209":73773,"_21628":123466,"_5":14884,"_28401":123400,"_3085":123467},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3634":73800,"_31209":73773,"_21628":123469,"_5":14884,"_28401":123404,"_3085":123470},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3634":73801,"_31209":73773,"_21628":123472,"_5":14884,"_28401":123412,"_3085":123473},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3634":73802,"_31209":73773,"_21628":123475,"_5":14884,"_28401":123412,"_3085":123476},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3634":73803,"_31209":73773,"_21628":123478,"_5":14884,"_28401":123415,"_3085":123479},[],"Campo de `settings.enrollment_settings`",{"_3634":73804,"_31209":73773,"_21628":123481,"_5":14884,"_28401":123415,"_3085":123482},[],"Decisión",{"_3634":73805,"_31209":73773,"_21628":123484,"_5":14884,"_28401":123415,"_3085":54062},[],{"_3634":73806,"_31209":73773,"_21628":123486,"_5":14884,"_28401":123415,"_3085":123487},[],"`EST_RFC7030` para estas operaciones.",{"_3634":73807,"_31209":73773,"_21628":123489,"_5":14884,"_28401":123415,"_3085":54068},[],{"_3634":73808,"_31209":73773,"_21628":123491,"_5":14884,"_28401":123415,"_3085":123492},[],"ID de la CA que firmará.",{"_3634":73809,"_31209":73773,"_21628":123494,"_5":14884,"_28401":123415,"_3085":54074},[],{"_3634":73810,"_31209":73773,"_21628":123496,"_5":14884,"_28401":123415,"_3085":123497},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3634":73811,"_31209":73773,"_21628":123499,"_5":14884,"_28401":123415,"_3085":54080},[],{"_3634":73812,"_31209":73773,"_21628":123501,"_5":14884,"_28401":123415,"_3085":123502},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3634":73813,"_31209":73773,"_21628":123504,"_5":14884,"_28401":123415,"_3085":54086},[],{"_3634":73814,"_31209":73773,"_21628":123506,"_5":14884,"_28401":123415,"_3085":123507},[],"Uno de los cuatro modos de autenticación.",{"_3634":73815,"_31209":73773,"_21628":123509,"_5":14884,"_28401":123415,"_3085":123510},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3634":73816,"_31209":73773,"_21628":123512,"_5":14884,"_28401":123418,"_3085":123513},[],"Los bloques son independientes:",{"_3634":73817,"_31209":73773,"_21628":123515,"_5":14884,"_28401":123418,"_3085":123516},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3634":73818,"_31209":73773,"_21628":123518,"_5":14884,"_28401":123418,"_3085":123519},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3634":73819,"_31209":73773,"_21628":123521,"_5":14884,"_28401":123418,"_3085":54104},[],{"_3634":73820,"_31209":73773,"_21628":123523,"_5":14884,"_28401":123418,"_3085":123524},[],"Control aplicado en la operación configurada",{"_3634":73821,"_31209":73773,"_21628":123526,"_5":14884,"_28401":123418,"_3085":54110},[],{"_3634":73822,"_31209":73773,"_21628":123528,"_5":14884,"_28401":123418,"_3085":123529},[],"Validación del certificado presentado.",{"_3634":73823,"_31209":73773,"_21628":123531,"_5":14884,"_28401":123418,"_3085":54116},[],{"_3634":73824,"_31209":73773,"_21628":123533,"_5":14884,"_28401":123418,"_3085":123534},[],"Autorización del webhook configurado.",{"_3634":73825,"_31209":73773,"_21628":123536,"_5":14884,"_28401":123418,"_3085":54122},[],{"_3634":73826,"_31209":73773,"_21628":123538,"_5":14884,"_28401":123418,"_3085":123539},[],"Validación del certificado y, después, aprobación del webhook.",{"_3634":73827,"_31209":73773,"_21628":123541,"_5":14884,"_28401":123418,"_3085":54128},[],{"_3634":73828,"_31209":73773,"_21628":123543,"_5":14884,"_28401":123418,"_3085":123544},[],"Sin autenticación del solicitante por el DMS.",{"_3634":73829,"_31209":73773,"_21628":123546,"_5":14884,"_28401":123418,"_3085":123547},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3634":73830,"_31209":73773,"_21628":123549,"_5":14884,"_28401":123418,"_3085":123550},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3634":73831,"_31209":73773,"_21628":123552,"_5":14884,"_28401":123418,"_3085":123553},[],"El editor de autenticación ofrece el interruptor **Allow certificates without revocation information** (`allow_unverifiable_revocation`, desactivado por defecto). Cuando está activado, se aceptan certificados — y CAs intermedias de la cadena — que Lamassu no gestiona y que no declaran ningún endpoint OCSP o CRL; las respuestas de revocación inaccesibles, obsoletas o no concluyentes se rechazan siempre. Mientras el interruptor esté activado, la consola muestra una alerta de aviso: **Revocation will not be verified** — un certificado revocado sin endpoint OCSP o CRL, y no gestionado por Lamassu, será aceptado, y esto se aplica también a las CAs intermedias de la cadena.",{"_3634":73832,"_31209":73773,"_21628":123555,"_5":14884,"_28401":123418,"_3085":123556},[],"El mismo interruptor se ofrece tanto en el editor de autenticación de enrolamiento como en el de reenrolamiento, y se almacena por bloque dentro de `est_rfc7030_settings.client_certificate_settings`; un DMS almacenado antes de que existiera el campo se carga con el interruptor desactivado. La consola también muestra una alerta de aviso siempre que una opción de autenticación esté en su estado inseguro — **Allow expired certificates** activado, **Allow expired renewal** activado o **Verify CSR signature** desactivado — y la nota de No authentication se presenta también como alerta de aviso.",{"_3634":73833,"_31209":73773,"_21628":123558,"_5":14884,"_28401":123418,"_3085":123559},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` — `false` por defecto en ambos bloques — relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3634":73834,"_31209":73773,"_21628":123561,"_5":14884,"_28401":123418,"_3085":123562},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3634":73835,"_31209":73773,"_21628":123564,"_5":14884,"_28401":123418,"_3085":123565},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3634":73836,"_31209":73773,"_21628":123567,"_5":14884,"_28401":123422,"_3085":123568},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3634":73837,"_31209":73773,"_21628":123570,"_5":14884,"_28401":123422,"_3085":123571},[],"Campo de `external_webhook_settings`",{"_3634":73838,"_31209":73773,"_21628":123573,"_5":14884,"_28401":123422,"_3085":123482},[],{"_3634":73839,"_31209":73773,"_21628":123575,"_5":14884,"_28401":123422,"_3085":54163},[],{"_3634":73840,"_31209":73773,"_21628":123577,"_5":14884,"_28401":123422,"_3085":123578},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3634":73841,"_31209":73773,"_21628":123580,"_5":14884,"_28401":123422,"_3085":54169},[],{"_3634":73842,"_31209":73773,"_21628":123582,"_5":14884,"_28401":123422,"_3085":123583},[],"`POST` o `PUT`; `POST` por defecto.",{"_3634":73843,"_31209":73773,"_21628":123585,"_5":14884,"_28401":123422,"_3085":54175},[],{"_3634":73844,"_31209":73773,"_21628":123587,"_5":14884,"_28401":123422,"_3085":123588},[],"Etiqueta usada en los logs del servicio.",{"_3634":73845,"_31209":73773,"_21628":123590,"_5":14884,"_28401":123422,"_3085":54181},[],{"_3634":73846,"_31209":73773,"_21628":123592,"_5":14884,"_28401":123422,"_3085":123593},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3634":73847,"_31209":73773,"_21628":123595,"_5":14884,"_28401":123422,"_3085":54187},[],{"_3634":73848,"_31209":73773,"_21628":123597,"_5":14884,"_28401":123422,"_3085":123598},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3634":73849,"_31209":73773,"_21628":123600,"_5":14884,"_28401":123422,"_3085":54193},[],{"_3634":73850,"_31209":73773,"_21628":123602,"_5":14884,"_28401":123422,"_3085":123603},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3634":73851,"_31209":73773,"_21628":123605,"_5":14884,"_28401":123422,"_3085":54199},[],{"_3634":73852,"_31209":73773,"_21628":123607,"_5":14884,"_28401":123422,"_3085":123608},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3634":73853,"_31209":73773,"_21628":123610,"_5":14884,"_28401":123422,"_3085":54205},[],{"_3634":73854,"_31209":73773,"_21628":123612,"_5":14884,"_28401":123422,"_3085":123613},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3634":73855,"_31209":73773,"_21628":123615,"_5":14884,"_28401":123422,"_3085":54211},[],{"_3634":73856,"_31209":73773,"_21628":123617,"_5":14884,"_28401":123422,"_3085":123618},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3634":73857,"_31209":73773,"_21628":123620,"_5":14884,"_28401":123422,"_3085":54217},[],{"_3634":73858,"_31209":73773,"_21628":123622,"_5":14884,"_28401":123422,"_3085":123623},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3634":73859,"_31209":73773,"_21628":123625,"_5":14884,"_28401":123422,"_3085":123626},[],"Reglas de esa configuración:",{"_3634":73860,"_31209":73773,"_21628":123628,"_5":14884,"_28401":123422,"_3085":123629},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3634":73861,"_31209":73773,"_21628":123631,"_5":14884,"_28401":123422,"_3085":123632},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3634":73862,"_31209":73773,"_21628":123634,"_5":14884,"_28401":123422,"_3085":123635},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3634":73863,"_31209":73773,"_21628":123637,"_5":14884,"_28401":123422,"_3085":123638},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3634":73864,"_31209":73773,"_21628":123640,"_5":14884,"_28401":123422,"_3085":123641},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3634":73865,"_31209":73773,"_21628":123643,"_5":14884,"_28401":123422,"_3085":123644},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3634":73866,"_31209":73773,"_21628":123646,"_5":14884,"_28401":123422,"_3085":123647},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3634":73867,"_31209":73773,"_21628":123649,"_5":14884,"_28401":123422,"_3085":123650},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3634":73868,"_31209":73773,"_21628":123652,"_5":14884,"_28401":123422,"_3085":123653},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3634":73869,"_31209":73773,"_21628":123655,"_5":14884,"_28401":123426,"_3085":123656},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto — incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno — debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3634":73870,"_31209":73773,"_21628":123658,"_5":14884,"_28401":123430,"_3085":123659},[],"Campo de `settings.reenrollment_settings`",{"_3634":73871,"_31209":73773,"_21628":123661,"_5":14884,"_28401":123430,"_3085":123662},[],"Función",{"_3634":73872,"_31209":73773,"_21628":123664,"_5":14884,"_28401":123430,"_3085":54261},[],{"_3634":73873,"_31209":73773,"_21628":123666,"_5":14884,"_28401":123430,"_3085":123667},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3634":73874,"_31209":73773,"_21628":123669,"_5":14884,"_28401":123430,"_3085":54267},[],{"_3634":73875,"_31209":73773,"_21628":123671,"_5":14884,"_28401":123430,"_3085":123672},[],"Umbral operativo preventivo de monitorización.",{"_3634":73876,"_31209":73773,"_21628":123674,"_5":14884,"_28401":123430,"_3085":54273},[],{"_3634":73877,"_31209":73773,"_21628":123676,"_5":14884,"_28401":123430,"_3085":123677},[],"Umbral operativo crítico de monitorización.",{"_3634":73878,"_31209":73773,"_21628":123679,"_5":14884,"_28401":123430,"_3085":54279},[],{"_3634":73879,"_31209":73773,"_21628":123681,"_5":14884,"_28401":123430,"_3085":123682},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3634":73880,"_31209":73773,"_21628":123684,"_5":14884,"_28401":123430,"_3085":54285},[],{"_3634":73881,"_31209":73773,"_21628":123686,"_5":14884,"_28401":123430,"_3085":123687},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3634":73882,"_31209":73773,"_21628":123689,"_5":14884,"_28401":123430,"_3085":54291},[],{"_3634":73883,"_31209":73773,"_21628":123691,"_5":14884,"_28401":123430,"_3085":123692},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3634":73884,"_31209":73773,"_21628":123694,"_5":14884,"_28401":123430,"_3085":123695},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3634":73885,"_31209":73773,"_21628":123697,"_5":14884,"_28401":123434,"_3085":123698},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3634":73886,"_31209":73773,"_21628":123700,"_5":14884,"_28401":123437,"_3085":120868},[],{"_3634":73887,"_31209":73773,"_21628":123702,"_5":14884,"_28401":123437,"_3085":123703},[],"Qué publica",{"_3634":73888,"_31209":73773,"_21628":123705,"_5":14884,"_28401":123437,"_3085":54308},[],{"_3634":73889,"_31209":73773,"_21628":123707,"_5":14884,"_28401":123437,"_3085":123708},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3634":73890,"_31209":73773,"_21628":123710,"_5":14884,"_28401":123437,"_3085":54314},[],{"_3634":73891,"_31209":73773,"_21628":123712,"_5":14884,"_28401":123437,"_3085":123713},[],"Certificado de la CA emisora seleccionada.",{"_3634":73892,"_31209":73773,"_21628":123715,"_5":14884,"_28401":123437,"_3085":54320},[],{"_3634":73893,"_31209":73773,"_21628":123717,"_5":14884,"_28401":123437,"_3085":123718},[],"Certificados de las CAs elegidas explícitamente.",{"_3634":73894,"_31209":73773,"_21628":123720,"_5":14884,"_28401":123437,"_3085":123721},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3634":73895,"_31209":73773,"_21628":123723,"_5":14884,"_28401":123441,"_3085":123724},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3634":73896,"_31209":73773,"_21628":123726,"_5":14884,"_28401":123441,"_3085":123727},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3634":73897,"_31209":73773,"_21628":123729,"_5":14884,"_28401":123441,"_3085":123730},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3634":73898,"_31209":73773,"_21628":123732,"_5":14884,"_28401":123445,"_3085":123733},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3634":73899,"_31209":73899,"_5":15244,"_3085":123735,"_31547":123736,"_21628":123737,"_28401":73899},"Integra el cliente EST",[50999,121970,53683,123115,123293],[],{"_3634":73900,"_31209":73899,"_21628":123739,"_5":14884,"_28401":73899,"_3085":123740},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3634":73901,"_31209":73899,"_5":31544,"_21628":123742,"_28401":123743,"_3085":120504},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3634":73902,"_31209":73899,"_5":31544,"_21628":123745,"_28401":123746,"_3085":123747},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3634":73903,"_31209":73899,"_5":31544,"_21628":123749,"_28401":123750,"_3085":123751},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3634":73904,"_31209":73899,"_5":31544,"_21628":123753,"_28401":123754,"_3085":123755},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3634":73905,"_31209":73899,"_5":31544,"_21628":123757,"_28401":123758,"_3085":123759},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3634":73906,"_31209":73899,"_5":31544,"_21628":123761,"_28401":123762,"_3085":123763},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3634":73907,"_31209":73899,"_21628":123765,"_5":14884,"_28401":73899,"_3085":123766},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3634":73908,"_31209":73899,"_21628":123768,"_5":14884,"_28401":123743,"_3085":123769},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3634":73909,"_31209":73899,"_21628":123771,"_5":14884,"_28401":123743,"_3085":123772},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3634":73910,"_31209":73899,"_21628":123774,"_5":14884,"_28401":123743,"_3085":123775},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3634":73911,"_31209":73899,"_21628":123777,"_5":14884,"_28401":123746,"_3085":123778},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3634":73912,"_31209":73899,"_21628":123780,"_5":14884,"_28401":123746,"_3085":123781},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3634":73913,"_31209":73899,"_21628":123783,"_5":14884,"_28401":123750,"_3085":123784},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3634":73914,"_31209":73899,"_21628":123786,"_5":14884,"_28401":123750,"_3085":123787},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3634":73915,"_31209":73899,"_21628":123789,"_5":14884,"_28401":123754,"_3085":123790},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3634":73916,"_31209":73899,"_21628":123792,"_5":14884,"_28401":123754,"_3085":123793},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3634":73917,"_31209":73899,"_21628":123795,"_5":14884,"_28401":123758,"_3085":123796},[],"Para el caso de una raíz que emite directamente:",{"_3634":73918,"_31209":73899,"_21628":123798,"_5":14884,"_28401":123758,"_3085":123799},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3634":73919,"_31209":73899,"_21628":123801,"_5":14884,"_28401":123758,"_3085":123802},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3634":73920,"_31209":73899,"_21628":123804,"_5":14884,"_28401":123762,"_3085":123805},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3634":73921,"_31209":73921,"_5":15244,"_3085":123807,"_31547":123808,"_21628":123809,"_28401":73921},"Referencia EST",[50999,121970,53683,123115,123293],[],{"_3634":73922,"_31209":73921,"_21628":123811,"_5":14884,"_28401":73921,"_3085":123812},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3634":73923,"_31209":73921,"_5":31544,"_21628":123814,"_28401":123815,"_3085":123816},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3634":73924,"_31209":73921,"_5":31544,"_21628":123818,"_28401":123819,"_3085":23431},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3634":73925,"_31209":73921,"_5":31544,"_21628":123821,"_28401":123822,"_3085":26946},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3634":73926,"_31209":73921,"_5":31544,"_21628":123824,"_28401":123825,"_3085":26953},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3634":73927,"_31209":73921,"_5":31544,"_21628":123827,"_28401":123828,"_3085":26215},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3634":73928,"_31209":73921,"_5":31544,"_21628":123830,"_28401":123831,"_3085":123832},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3634":73929,"_31209":73921,"_5":31544,"_21628":123834,"_28401":123835,"_3085":123836},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3634":73930,"_31209":73921,"_5":31544,"_21628":123838,"_28401":123839,"_3085":123840},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3634":73931,"_31209":73921,"_21628":123842,"_5":14884,"_28401":73921,"_3085":123843},[],"Referencia del servicio EST de Lamassu, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3634":73932,"_31209":73921,"_21628":123845,"_5":14884,"_28401":123815,"_3085":123846},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3634":73933,"_31209":73921,"_21628":123848,"_5":14884,"_28401":123815,"_3085":121730},[],{"_3634":73934,"_31209":73921,"_21628":123850,"_5":14884,"_28401":123815,"_3085":123851},[],"Método",{"_3634":73935,"_31209":73921,"_21628":123853,"_5":14884,"_28401":123815,"_3085":123854},[],"Autenticación y condición",{"_3634":73936,"_31209":73921,"_21628":123856,"_5":14884,"_28401":123815,"_3085":54463},[],{"_3634":73937,"_31209":73921,"_21628":123858,"_5":14884,"_28401":123815,"_3085":54466},[],{"_3634":73938,"_31209":73921,"_21628":123860,"_5":14884,"_28401":123815,"_3085":123861},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3634":73939,"_31209":73921,"_21628":123863,"_5":14884,"_28401":123815,"_3085":54472},[],{"_3634":73940,"_31209":73921,"_21628":123865,"_5":14884,"_28401":123815,"_3085":54475},[],{"_3634":73941,"_31209":73921,"_21628":123867,"_5":14884,"_28401":123815,"_3085":123868},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3634":73942,"_31209":73921,"_21628":123870,"_5":14884,"_28401":123815,"_3085":54481},[],{"_3634":73943,"_31209":73921,"_21628":123872,"_5":14884,"_28401":123815,"_3085":54475},[],{"_3634":73944,"_31209":73921,"_21628":123874,"_5":14884,"_28401":123815,"_3085":123875},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3634":73945,"_31209":73921,"_21628":123877,"_5":14884,"_28401":123815,"_3085":54489},[],{"_3634":73946,"_31209":73921,"_21628":123879,"_5":14884,"_28401":123815,"_3085":54475},[],{"_3634":73947,"_31209":73921,"_21628":123881,"_5":14884,"_28401":123815,"_3085":123882},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3634":73948,"_31209":73921,"_21628":123884,"_5":14884,"_28401":123815,"_3085":123885},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3634":73949,"_31209":73921,"_21628":123887,"_5":14884,"_28401":123819,"_3085":123888},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3634":73950,"_31209":73921,"_21628":123890,"_5":14884,"_28401":123819,"_3085":123891},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3634":73951,"_31209":73921,"_21628":123893,"_5":14884,"_28401":123822,"_3085":123894},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3634":73952,"_31209":73921,"_21628":123896,"_5":14884,"_28401":123822,"_3085":123897},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3634":73953,"_31209":73921,"_21628":123899,"_5":14884,"_28401":123825,"_3085":123900},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3634":73954,"_31209":73921,"_21628":123902,"_5":14884,"_28401":123825,"_3085":123903},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Con los valores por defecto, un certificado de cliente cuya revocación no puede verificarse también se rechaza; la guía de DMS describe `allow_unverifiable_revocation`. Consulta Renovación para instalación y recuperación.",{"_3634":73955,"_31209":73921,"_21628":123905,"_5":14884,"_28401":123828,"_3085":123906},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3634":73956,"_31209":73921,"_21628":123908,"_5":14884,"_28401":123828,"_3085":123909},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3634":73957,"_31209":73921,"_21628":123911,"_5":14884,"_28401":123831,"_3085":123912},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3634":73958,"_31209":73921,"_21628":123914,"_5":14884,"_28401":123831,"_3085":123915},[],"Parte",{"_3634":73959,"_31209":73921,"_21628":123917,"_5":14884,"_28401":123831,"_3085":123918},[],"Contenido tras decodificar su Base64",{"_3634":73960,"_31209":73921,"_21628":123920,"_5":14884,"_28401":123831,"_3085":54533},[],{"_3634":73961,"_31209":73921,"_21628":123922,"_5":14884,"_28401":123831,"_3085":123923},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3634":73962,"_31209":73921,"_21628":123925,"_5":14884,"_28401":123831,"_3085":54539},[],{"_3634":73963,"_31209":73921,"_21628":123927,"_5":14884,"_28401":123831,"_3085":123928},[],"PKCS#7 DER con el certificado emitido.",{"_3634":73964,"_31209":73921,"_21628":123930,"_5":14884,"_28401":123831,"_3085":123931},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3634":73965,"_31209":73921,"_21628":123933,"_5":14884,"_28401":123835,"_3085":123934},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3634":73966,"_31209":73921,"_21628":123936,"_5":14884,"_28401":123835,"_3085":123937},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3634":73967,"_31209":73921,"_21628":123939,"_5":14884,"_28401":123835,"_3085":123940},[],"Convierte y comprueba el resultado:",{"_3634":73968,"_31209":73921,"_21628":123942,"_5":14884,"_28401":123835,"_3085":123943},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3634":73969,"_31209":73921,"_21628":123945,"_5":14884,"_28401":123839,"_3085":123946},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3634":73970,"_31209":73921,"_21628":123948,"_5":14884,"_28401":123839,"_3085":123949},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3634":73971,"_31209":73971,"_5":15244,"_3085":123293,"_31547":123951,"_21628":123952,"_28401":73971},[50999,121970,53683,123115,123293],[],{"_3634":73972,"_31209":73971,"_21628":123954,"_5":14884,"_28401":73971,"_3085":123955},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3634":73973,"_31209":73971,"_5":31544,"_21628":123957,"_28401":123958,"_3085":123959},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3634":73974,"_31209":73971,"_5":31544,"_21628":123961,"_28401":123962,"_3085":123963},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3634":73975,"_31209":73971,"_5":31544,"_21628":123965,"_28401":123966,"_3085":123967},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3634":73976,"_31209":73971,"_21628":123969,"_5":14884,"_28401":73971,"_3085":123970},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3634":73977,"_31209":73971,"_21628":123972,"_5":14884,"_28401":123958,"_3085":123973},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3634":73978,"_31209":73971,"_21628":123975,"_5":14884,"_28401":123958,"_3085":123976},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3634":73979,"_31209":73971,"_21628":123978,"_5":14884,"_28401":123958,"_3085":123979},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3634":73980,"_31209":73971,"_21628":123981,"_5":14884,"_28401":123958,"_3085":123982},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3634":73981,"_31209":73971,"_21628":123984,"_5":14884,"_28401":123958,"_3085":123985},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3634":73982,"_31209":73971,"_21628":123987,"_5":14884,"_28401":123958,"_3085":123988},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3634":73983,"_31209":73971,"_21628":123990,"_5":14884,"_28401":123962,"_3085":123991},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3634":73984,"_31209":73971,"_21628":123993,"_5":14884,"_28401":123962,"_3085":123994},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":73985,"_31209":73971,"_21628":123996,"_5":14884,"_28401":123962,"_3085":123997},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3634":73986,"_31209":73971,"_21628":123999,"_5":14884,"_28401":123962,"_3085":124000},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3634":73987,"_31209":73971,"_21628":124002,"_5":14884,"_28401":123966,"_3085":124003},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3634":73988,"_31209":73971,"_21628":124005,"_5":14884,"_28401":123966,"_3085":124006},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3634":73989,"_31209":73971,"_21628":124008,"_5":14884,"_28401":123966,"_3085":124009},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3634":73990,"_31209":73971,"_21628":124011,"_5":14884,"_28401":123966,"_3085":124012},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3634":73991,"_31209":73971,"_21628":124014,"_5":14884,"_28401":123966,"_3085":124015},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3634":73992,"_31209":73992,"_5":15244,"_3085":124017,"_31547":124018,"_21628":124019,"_28401":73992},"Estrategias de aprovisionamiento",[50999,121970,53683,123115,123293],[],{"_3634":73993,"_31209":73992,"_21628":124021,"_5":14884,"_28401":73992,"_3085":124022},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3634":73994,"_31209":73992,"_5":31544,"_21628":124024,"_28401":124025,"_3085":124026},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3634":73995,"_31209":73992,"_5":31544,"_21628":124028,"_28401":124029,"_3085":124030},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3634":73996,"_31209":73992,"_5":31544,"_21628":124032,"_28401":124033,"_3085":124034},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3634":73997,"_31209":73992,"_5":31544,"_21628":124036,"_28401":124037,"_3085":124038},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3634":73998,"_31209":73992,"_5":31544,"_21628":124040,"_28401":124041,"_3085":124042},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3634":73999,"_31209":73992,"_21628":124044,"_5":14884,"_28401":73992,"_3085":124045},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3634":74000,"_31209":73992,"_21628":124047,"_5":14884,"_28401":124025,"_3085":124048},[],"Recorrido",{"_3634":74001,"_31209":73992,"_21628":124050,"_5":14884,"_28401":124025,"_3085":124051},[],"Cuándo existe el dispositivo",{"_3634":74002,"_31209":73992,"_21628":124053,"_5":14884,"_28401":124025,"_3085":124054},[],"Qué compruebas",{"_3634":74003,"_31209":73992,"_21628":124056,"_5":14884,"_28401":124025,"_3085":124057},[],"Asignación manual",{"_3634":74004,"_31209":73992,"_21628":124059,"_5":14884,"_28401":124025,"_3085":124060},[],"El operador lo crea antes de asociar un certificado.",{"_3634":74005,"_31209":73992,"_21628":124062,"_5":14884,"_28401":124025,"_3085":124063},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3634":74006,"_31209":73992,"_21628":124065,"_5":14884,"_28401":124025,"_3085":124066},[],"EST con `JITP`",{"_3634":74007,"_31209":73992,"_21628":124068,"_5":14884,"_28401":124025,"_3085":124069},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3634":74008,"_31209":73992,"_21628":124071,"_5":14884,"_28401":124025,"_3085":124072},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3634":74009,"_31209":73992,"_21628":124074,"_5":14884,"_28401":124025,"_3085":124075},[],"EST con `PRE_REGISTRATION`",{"_3634":74010,"_31209":73992,"_21628":124077,"_5":14884,"_28401":124025,"_3085":124078},[],"Debe existir antes de `/simpleenroll`.",{"_3634":74011,"_31209":73992,"_21628":124080,"_5":14884,"_28401":124025,"_3085":124081},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3634":74012,"_31209":73992,"_21628":124083,"_5":14884,"_28401":124025,"_3085":124084},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3634":74013,"_31209":73992,"_21628":124086,"_5":14884,"_28401":124025,"_3085":124087},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3634":74014,"_31209":73992,"_21628":124089,"_5":14884,"_28401":124029,"_3085":124090},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3634":74015,"_31209":73992,"_21628":124092,"_5":14884,"_28401":124029,"_3085":124093},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3634":74016,"_31209":73992,"_21628":124095,"_5":14884,"_28401":124029,"_3085":124096},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3634":74017,"_31209":73992,"_21628":124098,"_5":14884,"_28401":124033,"_3085":124099},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3634":74018,"_31209":73992,"_21628":124101,"_5":14884,"_28401":124033,"_3085":124102},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3634":74019,"_31209":73992,"_21628":124104,"_5":14884,"_28401":124033,"_3085":124105},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3634":74020,"_31209":73992,"_21628":124107,"_5":14884,"_28401":124033,"_3085":124108},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3634":74021,"_31209":73992,"_21628":124110,"_5":14884,"_28401":124033,"_3085":124111},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3634":74022,"_31209":73992,"_21628":124113,"_5":14884,"_28401":124033,"_3085":124114},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3634":74023,"_31209":73992,"_21628":124116,"_5":14884,"_28401":124037,"_3085":120868},[],{"_3634":74024,"_31209":73992,"_21628":124118,"_5":14884,"_28401":124037,"_3085":124119},[],"Material que atraviesa EST",{"_3634":74025,"_31209":73992,"_21628":124121,"_5":14884,"_28401":124037,"_3085":124122},[],"Clave generada por el dispositivo",{"_3634":74026,"_31209":73992,"_21628":124124,"_5":14884,"_28401":124037,"_3085":124125},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3634":74027,"_31209":73992,"_21628":124127,"_5":14884,"_28401":124037,"_3085":124128},[],"Clave ya disponible en el dispositivo",{"_3634":74028,"_31209":73992,"_21628":124130,"_5":14884,"_28401":124037,"_3085":124131},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3634":74029,"_31209":73992,"_21628":124133,"_5":14884,"_28401":124037,"_3085":54011},[],{"_3634":74030,"_31209":73992,"_21628":124135,"_5":14884,"_28401":124037,"_3085":124136},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3634":74031,"_31209":73992,"_21628":124138,"_5":14884,"_28401":124037,"_3085":124139},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3634":74032,"_31209":73992,"_21628":124141,"_5":14884,"_28401":124041,"_3085":124142},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3634":74033,"_31209":74033,"_5":15244,"_3085":124144,"_31547":124145,"_21628":124146,"_28401":74033},"Renovación y recuperación",[50999,121970,53683,123115,123293],[],{"_3634":74034,"_31209":74033,"_21628":124148,"_5":14884,"_28401":74033,"_3085":124149},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3634":74035,"_31209":74033,"_5":31544,"_21628":124151,"_28401":124152,"_3085":124153},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3634":74036,"_31209":74033,"_5":31544,"_21628":124155,"_28401":124156,"_3085":124157},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3634":74037,"_31209":74033,"_5":31544,"_21628":124159,"_28401":124160,"_3085":124161},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3634":74038,"_31209":74033,"_5":31544,"_21628":124163,"_28401":124164,"_3085":124165},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3634":74039,"_31209":74033,"_5":31544,"_21628":124167,"_28401":124168,"_3085":124169},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3634":74040,"_31209":74033,"_21628":124171,"_5":14884,"_28401":74033,"_3085":124172},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3634":74041,"_31209":74033,"_21628":124174,"_5":14884,"_28401":124152,"_3085":124175},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3634":74042,"_31209":74033,"_21628":124177,"_5":14884,"_28401":124152,"_3085":124178},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3634":74043,"_31209":74033,"_21628":124180,"_5":14884,"_28401":124152,"_3085":124181},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3634":74044,"_31209":74033,"_21628":124183,"_5":14884,"_28401":124152,"_3085":124184},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3634":74045,"_31209":74033,"_21628":124186,"_5":14884,"_28401":124156,"_3085":124187},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3634":74046,"_31209":74033,"_21628":124189,"_5":14884,"_28401":124156,"_3085":124190},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3634":74047,"_31209":74033,"_21628":124192,"_5":14884,"_28401":124160,"_3085":124193},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3634":74048,"_31209":74033,"_21628":124195,"_5":14884,"_28401":124160,"_3085":124196},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3634":74049,"_31209":74033,"_21628":124198,"_5":14884,"_28401":124160,"_3085":124199},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3634":74050,"_31209":74033,"_21628":124201,"_5":14884,"_28401":124164,"_3085":124202},[],"Situación",{"_3634":74051,"_31209":74033,"_21628":124204,"_5":14884,"_28401":124164,"_3085":124205},[],"Procedimiento",{"_3634":74052,"_31209":74033,"_21628":124207,"_5":14884,"_28401":124164,"_3085":124208},[],"Certificado vigente, fuera de ventana",{"_3634":74053,"_31209":74033,"_21628":124210,"_5":14884,"_28401":124164,"_3085":124211},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3634":74054,"_31209":74033,"_21628":124213,"_5":14884,"_28401":124164,"_3085":124214},[],"Certificado vencido, clave disponible",{"_3634":74055,"_31209":74033,"_21628":124216,"_5":14884,"_28401":124164,"_3085":124217},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3634":74056,"_31209":74033,"_21628":124219,"_5":14884,"_28401":124164,"_3085":124220},[],"Renovación por webhook o `NO_AUTH`",{"_3634":74057,"_31209":74033,"_21628":124222,"_5":14884,"_28401":124164,"_3085":124223},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3634":74058,"_31209":74033,"_21628":124225,"_5":14884,"_28401":124164,"_3085":124226},[],"Clave perdida o inaccesible",{"_3634":74059,"_31209":74033,"_21628":124228,"_5":14884,"_28401":124164,"_3085":124229},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3634":74060,"_31209":74033,"_21628":124231,"_5":14884,"_28401":124164,"_3085":124232},[],"Identidad actual revocada",{"_3634":74061,"_31209":74033,"_21628":124234,"_5":14884,"_28401":124164,"_3085":124235},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3634":74062,"_31209":74033,"_21628":124237,"_5":14884,"_28401":124164,"_3085":124238},[],"Dispositivo sin identidad",{"_3634":74063,"_31209":74033,"_21628":124240,"_5":14884,"_28401":124164,"_3085":124241},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3634":74064,"_31209":74033,"_21628":124243,"_5":14884,"_28401":124164,"_3085":124244},[],"Dispositivo retirado",{"_3634":74065,"_31209":74033,"_21628":124246,"_5":14884,"_28401":124164,"_3085":124247},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3634":74066,"_31209":74033,"_21628":124249,"_5":14884,"_28401":124164,"_3085":124250},[],"Timeout, HTTP 500 o fallo de instalación",{"_3634":74067,"_31209":74033,"_21628":124252,"_5":14884,"_28401":124164,"_3085":124253},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3634":74068,"_31209":74033,"_21628":124255,"_5":14884,"_28401":124168,"_3085":124256},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3634":74069,"_31209":74033,"_21628":124258,"_5":14884,"_28401":124168,"_3085":124259},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3634":74070,"_31209":74070,"_5":15244,"_3085":124261,"_31547":124262,"_21628":124263,"_28401":74070},"Diagnóstico de enrolamiento",[50999,121970,53683,123115,123293],[],{"_3634":74071,"_31209":74070,"_21628":124265,"_5":14884,"_28401":74070,"_3085":124266},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3634":74072,"_31209":74070,"_5":31544,"_21628":124268,"_28401":124269,"_3085":124270},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3634":74073,"_31209":74070,"_5":31544,"_21628":124272,"_28401":124273,"_3085":124274},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3634":74074,"_31209":74070,"_5":31544,"_21628":124276,"_28401":124277,"_3085":123840},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3634":74075,"_31209":74070,"_5":31544,"_21628":124279,"_28401":124280,"_3085":124281},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3634":74076,"_31209":74070,"_21628":124283,"_5":14884,"_28401":74070,"_3085":124284},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3634":74077,"_31209":74070,"_21628":124286,"_5":14884,"_28401":124273,"_3085":124287},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3634":74078,"_31209":74070,"_21628":124289,"_5":14884,"_28401":124273,"_3085":124290},[],"Síntoma o mensaje",{"_3634":74079,"_31209":74070,"_21628":124292,"_5":14884,"_28401":124273,"_3085":124293},[],"Qué revisar",{"_3634":74080,"_31209":74070,"_21628":124295,"_5":14884,"_28401":124273,"_3085":124296},[],"curl rechaza TLS, nombre o emisor",{"_3634":74081,"_31209":74070,"_21628":124298,"_5":14884,"_28401":124273,"_3085":124299},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3634":74082,"_31209":74070,"_21628":124301,"_5":14884,"_28401":124273,"_3085":124302},[],"404 o APS ausente",{"_3634":74083,"_31209":74070,"_21628":124304,"_5":14884,"_28401":124273,"_3085":124305},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3634":74084,"_31209":74070,"_21628":124307,"_5":14884,"_28401":124273,"_3085":124308},[],"400, error de CSR o formato",{"_3634":74085,"_31209":74070,"_21628":124310,"_5":14884,"_28401":124273,"_3085":124311},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3634":74086,"_31209":74070,"_21628":124313,"_5":14884,"_28401":124273,"_3085":124314},[],"Credencial ausente o certificado no válido",{"_3634":74087,"_31209":74070,"_21628":124316,"_5":14884,"_28401":124273,"_3085":124317},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3634":74088,"_31209":74070,"_21628":124319,"_5":14884,"_28401":124273,"_3085":124320},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3634":74089,"_31209":74070,"_21628":124322,"_5":14884,"_28401":124273,"_3085":124323},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3634":74090,"_31209":74070,"_21628":124325,"_5":14884,"_28401":124273,"_3085":124326},[],"Webhook deniega, expira o responde sin autorización",{"_3634":74091,"_31209":74070,"_21628":124328,"_5":14884,"_28401":124273,"_3085":124329},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3634":74092,"_31209":74070,"_21628":124331,"_5":14884,"_28401":124273,"_3085":54945},[],{"_3634":74093,"_31209":74070,"_21628":124333,"_5":14884,"_28401":124273,"_3085":124334},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3634":74094,"_31209":74070,"_21628":124336,"_5":14884,"_28401":124273,"_3085":54951},[],{"_3634":74095,"_31209":74070,"_21628":124338,"_5":14884,"_28401":124273,"_3085":124339},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3634":74096,"_31209":74070,"_21628":124341,"_5":14884,"_28401":124273,"_3085":54957},[],{"_3634":74097,"_31209":74070,"_21628":124343,"_5":14884,"_28401":124273,"_3085":124344},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3634":74098,"_31209":74070,"_21628":124346,"_5":14884,"_28401":124273,"_3085":54963},[],{"_3634":74099,"_31209":74070,"_21628":124348,"_5":14884,"_28401":124273,"_3085":124349},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3634":74100,"_31209":74070,"_21628":124351,"_5":14884,"_28401":124273,"_3085":54969},[],{"_3634":74101,"_31209":74070,"_21628":124353,"_5":14884,"_28401":124273,"_3085":124354},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3634":74102,"_31209":74070,"_21628":124356,"_5":14884,"_28401":124273,"_3085":124357},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3634":74103,"_31209":74070,"_21628":124359,"_5":14884,"_28401":124273,"_3085":124360},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3634":74104,"_31209":74070,"_21628":124362,"_5":14884,"_28401":124273,"_3085":124363},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3634":74105,"_31209":74070,"_21628":124365,"_5":14884,"_28401":124273,"_3085":124366},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3634":74106,"_31209":74070,"_21628":124368,"_5":14884,"_28401":124273,"_3085":54987},[],{"_3634":74107,"_31209":74070,"_21628":124370,"_5":14884,"_28401":124273,"_3085":124371},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3634":74108,"_31209":74070,"_21628":124373,"_5":14884,"_28401":124273,"_3085":54993},[],{"_3634":74109,"_31209":74070,"_21628":124375,"_5":14884,"_28401":124273,"_3085":124376},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3634":74110,"_31209":74070,"_21628":124378,"_5":14884,"_28401":124273,"_3085":124379},[],"DMS propietario distinto",{"_3634":74111,"_31209":74070,"_21628":124381,"_5":14884,"_28401":124273,"_3085":124382},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3634":74112,"_31209":74070,"_21628":124384,"_5":14884,"_28401":124273,"_3085":55005},[],{"_3634":74113,"_31209":74070,"_21628":124386,"_5":14884,"_28401":124273,"_3085":124387},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3634":74114,"_31209":74070,"_21628":124389,"_5":14884,"_28401":124273,"_3085":55011},[],{"_3634":74115,"_31209":74070,"_21628":124391,"_5":14884,"_28401":124273,"_3085":124392},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3634":74116,"_31209":74070,"_21628":124394,"_5":14884,"_28401":124273,"_3085":124395},[],"Certificado actual revocado",{"_3634":74117,"_31209":74070,"_21628":124397,"_5":14884,"_28401":124273,"_3085":124398},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3634":74118,"_31209":74070,"_21628":124400,"_5":14884,"_28401":124273,"_3085":124401},[],"Error de CA, perfil o firma",{"_3634":74119,"_31209":74070,"_21628":124403,"_5":14884,"_28401":124273,"_3085":124404},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3634":74120,"_31209":74070,"_21628":124406,"_5":14884,"_28401":124273,"_3085":124407},[],"HTTP 200 sin conexión del dispositivo",{"_3634":74121,"_31209":74070,"_21628":124409,"_5":14884,"_28401":124273,"_3085":124410},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3634":74122,"_31209":74070,"_21628":124412,"_5":14884,"_28401":124273,"_3085":124413},[],"Timeout o error después de emitir",{"_3634":74123,"_31209":74070,"_21628":124415,"_5":14884,"_28401":124273,"_3085":124416},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3634":74124,"_31209":74070,"_21628":124418,"_5":14884,"_28401":124277,"_3085":124419},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3634":74125,"_31209":74070,"_21628":124421,"_5":14884,"_28401":124277,"_3085":124422},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3634":74126,"_31209":74070,"_21628":124424,"_5":14884,"_28401":124280,"_3085":124425},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3634":74127,"_31209":74070,"_21628":124427,"_5":14884,"_28401":124280,"_3085":124428},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3634":74128,"_31209":74070,"_21628":124430,"_5":14884,"_28401":124280,"_3085":124431},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3634":74129,"_31209":74070,"_21628":124433,"_5":14884,"_28401":124280,"_3085":124434},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3634":74130,"_31209":74070,"_21628":124436,"_5":14884,"_28401":124280,"_3085":124437},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3634":74131,"_31209":74070,"_21628":124439,"_5":14884,"_28401":124280,"_3085":124440},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse — incluido un estado OCSP Unknown — se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3634":74132,"_31209":74070,"_21628":124442,"_5":14884,"_28401":124280,"_3085":124443},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3634":74133,"_31209":74133,"_5":15244,"_3085":124445,"_31547":124446,"_21628":124447,"_28401":74133},"Distribución y actualización de confianza",[50999,121970,53683,123115,123293],[],{"_3634":74134,"_31209":74133,"_21628":124449,"_5":14884,"_28401":74133,"_3085":124450},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3634":74135,"_31209":74133,"_5":31544,"_21628":124452,"_28401":124453,"_3085":124454},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3634":74136,"_31209":74133,"_5":31544,"_21628":124456,"_28401":124457,"_3085":124458},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3634":74137,"_31209":74133,"_5":31544,"_21628":124460,"_28401":124461,"_3085":124462},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3634":74138,"_31209":74133,"_5":31544,"_21628":124464,"_28401":124465,"_3085":124466},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3634":74139,"_31209":74133,"_5":31544,"_21628":124468,"_28401":124469,"_3085":124470},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3634":74140,"_31209":74133,"_21628":124472,"_5":14884,"_28401":74133,"_3085":124473},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3634":74141,"_31209":74133,"_21628":124475,"_5":14884,"_28401":124453,"_3085":124476},[],"Relación",{"_3634":74142,"_31209":74133,"_21628":124478,"_5":14884,"_28401":124453,"_3085":124479},[],"Material que prepara el responsable",{"_3634":74143,"_31209":74133,"_21628":124481,"_5":14884,"_28401":124453,"_3085":124482},[],"Dispositivo → servidor EST",{"_3634":74144,"_31209":74133,"_21628":124484,"_5":14884,"_28401":124453,"_3085":124485},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3634":74145,"_31209":74133,"_21628":124487,"_5":14884,"_28401":124453,"_3085":124488},[],"DMS → solicitante",{"_3634":74146,"_31209":74133,"_21628":124490,"_5":14884,"_28401":124453,"_3085":124491},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3634":74147,"_31209":74133,"_21628":124493,"_5":14884,"_28401":124453,"_3085":124494},[],"Consumidor → dispositivo",{"_3634":74148,"_31209":74133,"_21628":124496,"_5":14884,"_28401":124453,"_3085":124497},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3634":74149,"_31209":74133,"_21628":124499,"_5":14884,"_28401":124453,"_3085":124500},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3634":74150,"_31209":74133,"_21628":124502,"_5":14884,"_28401":124457,"_3085":124503},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3634":74151,"_31209":74133,"_21628":124505,"_5":14884,"_28401":124457,"_3085":124506},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3634":74152,"_31209":74133,"_21628":124508,"_5":14884,"_28401":124461,"_3085":124509},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3634":74153,"_31209":74133,"_21628":124511,"_5":14884,"_28401":124461,"_3085":124512},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3634":74154,"_31209":74133,"_21628":124514,"_5":14884,"_28401":124461,"_3085":124515},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3634":74155,"_31209":74133,"_21628":124517,"_5":14884,"_28401":124461,"_3085":124518},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3634":74156,"_31209":74133,"_21628":124520,"_5":14884,"_28401":124461,"_3085":124521},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3634":74157,"_31209":74133,"_21628":124523,"_5":14884,"_28401":124461,"_3085":124524},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3634":74158,"_31209":74133,"_21628":124526,"_5":14884,"_28401":124465,"_3085":124527},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3634":74159,"_31209":74133,"_21628":124529,"_5":14884,"_28401":124465,"_3085":124530},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3634":74160,"_31209":74133,"_21628":124532,"_5":14884,"_28401":124465,"_3085":124533},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3634":74161,"_31209":74133,"_21628":124535,"_5":14884,"_28401":124469,"_3085":124536},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3634":74162,"_31209":74162,"_5":15244,"_3085":55160,"_31547":124538,"_21628":124540,"_28401":74162},[50999,121970,53683,123115,124539],"Integraciones",[],{"_3634":74163,"_31209":74162,"_21628":124542,"_5":14884,"_28401":74162,"_3085":124543},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3634":74164,"_31209":74162,"_5":31544,"_21628":124545,"_28401":124546,"_3085":124547},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3634":74165,"_31209":74162,"_5":31544,"_21628":124549,"_28401":124550,"_3085":124551},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3634":74166,"_31209":74162,"_5":31544,"_21628":124553,"_28401":124554,"_3085":124555},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3634":74167,"_31209":74162,"_5":31544,"_21628":124557,"_28401":124558,"_3085":124559},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3634":74168,"_31209":74162,"_5":31544,"_21628":124561,"_28401":124562,"_3085":124563},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3634":74169,"_31209":74162,"_5":31544,"_21628":124565,"_28401":124566,"_3085":124567},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3634":74170,"_31209":74162,"_5":31544,"_21628":124569,"_28401":124570,"_3085":124571},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3634":74171,"_31209":74162,"_5":31544,"_21628":124573,"_28401":124574,"_3085":124575},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3634":74172,"_31209":74162,"_5":31544,"_21628":124577,"_28401":124578,"_3085":55202},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3634":74173,"_31209":74162,"_5":31544,"_21628":124580,"_28401":124581,"_3085":55206},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3634":74174,"_31209":74162,"_5":31544,"_21628":124583,"_28401":124584,"_3085":124585},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3634":74175,"_31209":74162,"_5":31544,"_21628":124587,"_28401":124588,"_3085":124589},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3634":74176,"_31209":74162,"_5":31544,"_21628":124591,"_28401":124592,"_3085":124593},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3634":74177,"_31209":74162,"_5":31544,"_21628":124595,"_28401":124596,"_3085":124597},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3634":74178,"_31209":74162,"_5":31544,"_21628":124599,"_28401":124600,"_3085":124601},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3634":74179,"_31209":74162,"_5":31544,"_21628":124603,"_28401":124604,"_3085":124605},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3634":74180,"_31209":74162,"_5":31544,"_21628":124607,"_28401":124608,"_3085":124609},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3634":74181,"_31209":74162,"_5":31544,"_21628":124611,"_28401":124612,"_3085":124613},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3634":74182,"_31209":74162,"_5":31544,"_21628":124615,"_28401":124616,"_3085":124617},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3634":74183,"_31209":74162,"_5":31544,"_21628":124619,"_28401":124620,"_3085":124621},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3634":74184,"_31209":74162,"_5":31544,"_21628":124623,"_28401":124624,"_3085":124625},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3634":74185,"_31209":74162,"_5":31544,"_21628":124627,"_28401":124628,"_3085":124629},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3634":74186,"_31209":74162,"_5":31544,"_21628":124631,"_28401":124632,"_3085":124633},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3634":74187,"_31209":74162,"_5":31544,"_21628":124635,"_28401":124636,"_3085":124637},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3634":74188,"_31209":74162,"_5":31544,"_21628":124639,"_28401":124640,"_3085":124641},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3634":74189,"_31209":74162,"_21628":124643,"_5":14884,"_28401":74162,"_3085":124644},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3634":74190,"_31209":74162,"_21628":124646,"_5":14884,"_28401":74162,"_3085":124647},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3634":74191,"_31209":74162,"_21628":124649,"_5":14884,"_28401":74162,"_3085":124650},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3634":74192,"_31209":74162,"_21628":124652,"_5":14884,"_28401":124546,"_3085":124653},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3634":74193,"_31209":74162,"_21628":124655,"_5":14884,"_28401":124546,"_3085":124656},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3634":74194,"_31209":74162,"_21628":124658,"_5":14884,"_28401":124546,"_3085":124659},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3634":74195,"_31209":74162,"_21628":124661,"_5":14884,"_28401":124546,"_3085":124662},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3634":74196,"_31209":74162,"_21628":124664,"_5":14884,"_28401":124550,"_3085":124665},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3634":74197,"_31209":74162,"_21628":124667,"_5":14884,"_28401":124554,"_3085":124668},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3634":74198,"_31209":74162,"_21628":124670,"_5":14884,"_28401":124554,"_3085":124671},[],"Acción IAM",{"_3634":74199,"_31209":74162,"_21628":124673,"_5":14884,"_28401":124554,"_3085":120874},[],{"_3634":74200,"_31209":74162,"_21628":124675,"_5":14884,"_28401":124554,"_3085":55301},[],{"_3634":74201,"_31209":74162,"_21628":124677,"_5":14884,"_28401":124554,"_3085":124678},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3634":74202,"_31209":74162,"_21628":124680,"_5":14884,"_28401":124554,"_3085":55307},[],{"_3634":74203,"_31209":74162,"_21628":124682,"_5":14884,"_28401":124554,"_3085":124683},[],"Registrar la CA en AWS IoT",{"_3634":74204,"_31209":74162,"_21628":124685,"_5":14884,"_28401":124554,"_3085":55313},[],{"_3634":74205,"_31209":74162,"_21628":124687,"_5":14884,"_28401":124554,"_3085":124688},[],"Consultar el estado del registro de la CA",{"_3634":74206,"_31209":74162,"_21628":124690,"_5":14884,"_28401":124554,"_3085":55319},[],{"_3634":74207,"_31209":74162,"_21628":124692,"_5":14884,"_28401":124554,"_3085":124693},[],"Crear o actualizar Things en IoT Core",{"_3634":74208,"_31209":74162,"_21628":124695,"_5":14884,"_28401":124554,"_3085":55325},[],{"_3634":74209,"_31209":74162,"_21628":124697,"_5":14884,"_28401":124554,"_3085":124698},[],"Aprovisionar Things mediante plantilla",{"_3634":74210,"_31209":74162,"_21628":124700,"_5":14884,"_28401":124554,"_3085":55331},[],{"_3634":74211,"_31209":74162,"_21628":124702,"_5":14884,"_28401":124554,"_3085":124703},[],"Registrar certificados de dispositivo",{"_3634":74212,"_31209":74162,"_21628":124705,"_5":14884,"_28401":124554,"_3085":55337},[],{"_3634":74213,"_31209":74162,"_21628":124707,"_5":14884,"_28401":124554,"_3085":124708},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3634":74214,"_31209":74162,"_21628":124710,"_5":14884,"_28401":124554,"_3085":55343},[],{"_3634":74215,"_31209":74162,"_21628":124712,"_5":14884,"_28401":124554,"_3085":124713},[],"Crear y adjuntar políticas IoT",{"_3634":74216,"_31209":74162,"_21628":124715,"_5":14884,"_28401":124554,"_3085":55349},[],{"_3634":74217,"_31209":74162,"_21628":124717,"_5":14884,"_28401":124554,"_3085":124718},[],"Gestionar grupos de Things",{"_3634":74218,"_31209":74162,"_21628":124720,"_5":14884,"_28401":124554,"_3085":55355},[],{"_3634":74219,"_31209":74162,"_21628":124722,"_5":14884,"_28401":124554,"_3085":124723},[],"Crear plantillas JITP",{"_3634":74220,"_31209":74162,"_21628":124725,"_5":14884,"_28401":124554,"_3085":55361},[],{"_3634":74221,"_31209":74162,"_21628":124727,"_5":14884,"_28401":124554,"_3085":124728},[],"Leer y escribir el Device Shadow",{"_3634":74222,"_31209":74162,"_21628":124730,"_5":14884,"_28401":124554,"_3085":124731},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3634":74223,"_31209":74162,"_21628":124733,"_5":14884,"_28401":124558,"_3085":124734},[],"Parámetro",{"_3634":74224,"_31209":74162,"_21628":124736,"_5":14884,"_28401":124558,"_3085":124737},[],"Tipo",{"_3634":74225,"_31209":74162,"_21628":124739,"_5":14884,"_28401":124558,"_3085":124740},[],"Requerido",{"_3634":74226,"_31209":74162,"_21628":124742,"_5":14884,"_28401":124558,"_3085":124743},[],"Descripción",{"_3634":74227,"_31209":74162,"_21628":124745,"_5":14884,"_28401":124558,"_3085":55382},[],{"_3634":74228,"_31209":74162,"_21628":124747,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74229,"_31209":74162,"_21628":124749,"_5":14884,"_28401":124558,"_3085":124750},[],"Sí",{"_3634":74230,"_31209":74162,"_21628":124752,"_5":14884,"_28401":124558,"_3085":124753},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3634":74231,"_31209":74162,"_21628":124755,"_5":14884,"_28401":124558,"_3085":55393},[],{"_3634":74232,"_31209":74162,"_21628":124757,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74233,"_31209":74162,"_21628":124759,"_5":14884,"_28401":124558,"_3085":124750},[],{"_3634":74234,"_31209":74162,"_21628":124761,"_5":14884,"_28401":124558,"_3085":124762},[],"Región AWS donde opera el conector.",{"_3634":74235,"_31209":74162,"_21628":124764,"_5":14884,"_28401":124558,"_3085":55403},[],{"_3634":74236,"_31209":74162,"_21628":124766,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74237,"_31209":74162,"_21628":124768,"_5":14884,"_28401":124558,"_3085":124750},[],{"_3634":74238,"_31209":74162,"_21628":124770,"_5":14884,"_28401":124558,"_3085":124771},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3634":74239,"_31209":74162,"_21628":124773,"_5":14884,"_28401":124558,"_3085":55413},[],{"_3634":74240,"_31209":74162,"_21628":124775,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74241,"_31209":74162,"_21628":124777,"_5":14884,"_28401":124558,"_3085":124778},[],"Solo con `auth_method=static`",{"_3634":74242,"_31209":74162,"_21628":124780,"_5":14884,"_28401":124558,"_3085":124781},[],"Clave de acceso AWS.",{"_3634":74243,"_31209":74162,"_21628":124783,"_5":14884,"_28401":124558,"_3085":55424},[],{"_3634":74244,"_31209":74162,"_21628":124785,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74245,"_31209":74162,"_21628":124787,"_5":14884,"_28401":124558,"_3085":124778},[],{"_3634":74246,"_31209":74162,"_21628":124789,"_5":14884,"_28401":124558,"_3085":124790},[],"Clave secreta AWS.",{"_3634":74247,"_31209":74162,"_21628":124792,"_5":14884,"_28401":124558,"_3085":55434},[],{"_3634":74248,"_31209":74162,"_21628":124794,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74249,"_31209":74162,"_21628":124796,"_5":14884,"_28401":124558,"_3085":55439},[],{"_3634":74250,"_31209":74162,"_21628":124798,"_5":14884,"_28401":124558,"_3085":124799},[],"Token de sesión (con `auth_method=static`).",{"_3634":74251,"_31209":74162,"_21628":124801,"_5":14884,"_28401":124558,"_3085":55445},[],{"_3634":74252,"_31209":74162,"_21628":124803,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74253,"_31209":74162,"_21628":124805,"_5":14884,"_28401":124558,"_3085":124806},[],"Solo con `auth_method=role`",{"_3634":74254,"_31209":74162,"_21628":124808,"_5":14884,"_28401":124558,"_3085":124809},[],"ARN del rol a asumir.",{"_3634":74255,"_31209":74162,"_21628":124811,"_5":14884,"_28401":124558,"_3085":55456},[],{"_3634":74256,"_31209":74162,"_21628":124813,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74257,"_31209":74162,"_21628":124815,"_5":14884,"_28401":124558,"_3085":55439},[],{"_3634":74258,"_31209":74162,"_21628":124817,"_5":14884,"_28401":124558,"_3085":124818},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3634":74259,"_31209":74162,"_21628":124820,"_5":14884,"_28401":124558,"_3085":55466},[],{"_3634":74260,"_31209":74162,"_21628":124822,"_5":14884,"_28401":124558,"_3085":93044},[],{"_3634":74261,"_31209":74162,"_21628":124824,"_5":14884,"_28401":124558,"_3085":124750},[],{"_3634":74262,"_31209":74162,"_21628":124826,"_5":14884,"_28401":124558,"_3085":124827},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3634":74263,"_31209":74162,"_21628":124829,"_5":14884,"_28401":124558,"_3085":55476},[],{"_3634":74264,"_31209":74162,"_21628":124831,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74265,"_31209":74162,"_21628":124833,"_5":14884,"_28401":124558,"_3085":124750},[],{"_3634":74266,"_31209":74162,"_21628":124835,"_5":14884,"_28401":124558,"_3085":124836},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3634":74267,"_31209":74162,"_21628":124838,"_5":14884,"_28401":124558,"_3085":55486},[],{"_3634":74268,"_31209":74162,"_21628":124840,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74269,"_31209":74162,"_21628":124842,"_5":14884,"_28401":124558,"_3085":124750},[],{"_3634":74270,"_31209":74162,"_21628":124844,"_5":14884,"_28401":124558,"_3085":124845},[],"URL HTTP del Device Manager de Lamassu.",{"_3634":74271,"_31209":74162,"_21628":124847,"_5":14884,"_28401":124558,"_3085":55496},[],{"_3634":74272,"_31209":74162,"_21628":124849,"_5":14884,"_28401":124558,"_3085":25815},[],{"_3634":74273,"_31209":74162,"_21628":124851,"_5":14884,"_28401":124558,"_3085":124750},[],{"_3634":74274,"_31209":74162,"_21628":124853,"_5":14884,"_28401":124558,"_3085":124854},[],"URL HTTP del servicio de CA de Lamassu.",{"_3634":74275,"_31209":74162,"_21628":124856,"_5":14884,"_28401":124562,"_3085":124857},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3634":74276,"_31209":74162,"_21628":124859,"_5":14884,"_28401":124562,"_3085":124860},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3634":74277,"_31209":74162,"_21628":124862,"_5":14884,"_28401":124562,"_3085":124863},[],"Tipo de CloudEvent",{"_3634":74278,"_31209":74162,"_21628":124865,"_5":14884,"_28401":124562,"_3085":124866},[],"Recurso en Lamassu",{"_3634":74279,"_31209":74162,"_21628":124868,"_5":14884,"_28401":124562,"_3085":124869},[],"Recurso AWS",{"_3634":74280,"_31209":74162,"_21628":124871,"_5":14884,"_28401":124562,"_3085":124872},[],"Acciones IAM",{"_3634":74281,"_31209":74162,"_21628":124874,"_5":14884,"_28401":124562,"_3085":124875},[],"Llamadas AWS y efecto",{"_3634":74282,"_31209":74162,"_21628":124877,"_5":14884,"_28401":124562,"_3085":124878},[],"Dónde en esta página",{"_3634":74283,"_31209":74162,"_21628":124880,"_5":14884,"_28401":124562,"_3085":55530},[],{"_3634":74284,"_31209":74162,"_21628":124882,"_5":14884,"_28401":124562,"_3085":55533},[],{"_3634":74285,"_31209":74162,"_21628":124884,"_5":14884,"_28401":124562,"_3085":55536},[],{"_3634":74286,"_31209":74162,"_21628":124886,"_5":14884,"_28401":124562,"_3085":55539},[],{"_3634":74287,"_31209":74162,"_21628":124888,"_5":14884,"_28401":124562,"_3085":124889},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3634":74288,"_31209":74162,"_21628":124891,"_5":14884,"_28401":124562,"_3085":124575},[],{"_3634":74289,"_31209":74162,"_21628":124893,"_5":14884,"_28401":124562,"_3085":55547},[],{"_3634":74290,"_31209":74162,"_21628":124895,"_5":14884,"_28401":124562,"_3085":55550},[],{"_3634":74291,"_31209":74162,"_21628":124897,"_5":14884,"_28401":124562,"_3085":55553},[],{"_3634":74292,"_31209":74162,"_21628":124899,"_5":14884,"_28401":124562,"_3085":55556},[],{"_3634":74293,"_31209":74162,"_21628":124901,"_5":14884,"_28401":124562,"_3085":124902},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3634":74294,"_31209":74162,"_21628":124904,"_5":14884,"_28401":124562,"_3085":124601},[],{"_3634":74295,"_31209":74162,"_21628":124906,"_5":14884,"_28401":124562,"_3085":55564},[],{"_3634":74296,"_31209":74162,"_21628":124908,"_5":14884,"_28401":124562,"_3085":124909},[],"Dispositivo",{"_3634":74297,"_31209":74162,"_21628":124911,"_5":14884,"_28401":124562,"_3085":55570},[],{"_3634":74298,"_31209":74162,"_21628":124913,"_5":14884,"_28401":124562,"_3085":55573},[],{"_3634":74299,"_31209":74162,"_21628":124915,"_5":14884,"_28401":124562,"_3085":124916},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3634":74300,"_31209":74162,"_21628":124918,"_5":14884,"_28401":124562,"_3085":124609},[],{"_3634":74301,"_31209":74162,"_21628":124920,"_5":14884,"_28401":124562,"_3085":55581},[],{"_3634":74302,"_31209":74162,"_21628":124922,"_5":14884,"_28401":124562,"_3085":124923},[],"Certificado",{"_3634":74303,"_31209":74162,"_21628":124925,"_5":14884,"_28401":124562,"_3085":55587},[],{"_3634":74304,"_31209":74162,"_21628":124927,"_5":14884,"_28401":124562,"_3085":124928},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3634":74305,"_31209":74162,"_21628":124930,"_5":14884,"_28401":124562,"_3085":124931},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3634":74306,"_31209":74162,"_21628":124933,"_5":14884,"_28401":124562,"_3085":124621},[],{"_3634":74307,"_31209":74162,"_21628":124935,"_5":14884,"_28401":124562,"_3085":55598},[],{"_3634":74308,"_31209":74162,"_21628":124937,"_5":14884,"_28401":124562,"_3085":124938},[],"Certificado / Dispositivo",{"_3634":74309,"_31209":74162,"_21628":124940,"_5":14884,"_28401":124562,"_3085":55604},[],{"_3634":74310,"_31209":74162,"_21628":124942,"_5":14884,"_28401":124562,"_3085":51395},[],{"_3634":74311,"_31209":74162,"_21628":124944,"_5":14884,"_28401":124562,"_3085":124945},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3634":74312,"_31209":74162,"_21628":124947,"_5":14884,"_28401":124562,"_3085":124629},[],{"_3634":74313,"_31209":74162,"_21628":124949,"_5":14884,"_28401":124566,"_3085":124950},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3634":74314,"_31209":74162,"_21628":124952,"_5":14884,"_28401":124570,"_3085":124953},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3634":74315,"_31209":74162,"_21628":124955,"_5":14884,"_28401":124570,"_3085":124956},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3634":74316,"_31209":74162,"_21628":124958,"_5":14884,"_28401":124574,"_3085":124959},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3634":74317,"_31209":74162,"_21628":124961,"_5":14884,"_28401":124574,"_3085":124962},[],"Transición",{"_3634":74318,"_31209":74162,"_21628":124964,"_5":14884,"_28401":124574,"_3085":124965},[],"Llamadas AWS",{"_3634":74319,"_31209":74162,"_21628":124967,"_5":14884,"_28401":124574,"_3085":124968},[],"`NoRegistrada` → `Solicitada`",{"_3634":74320,"_31209":74162,"_21628":124970,"_5":14884,"_28401":124574,"_3085":124971},[],"ninguna (solo escritura de metadatos)",{"_3634":74321,"_31209":74162,"_21628":124973,"_5":14884,"_28401":124574,"_3085":124974},[],"`Solicitada` → `Registrando`",{"_3634":74322,"_31209":74162,"_21628":124976,"_5":14884,"_28401":124574,"_3085":124977},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3634":74323,"_31209":74162,"_21628":124979,"_5":14884,"_28401":124574,"_3085":124980},[],"`Registrando` → `Completada`",{"_3634":74324,"_31209":74162,"_21628":124982,"_5":14884,"_28401":124574,"_3085":124983},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3634":74325,"_31209":74162,"_21628":124985,"_5":14884,"_28401":124574,"_3085":124986},[],"`Registrando` → `Fallida`",{"_3634":74326,"_31209":74162,"_21628":124988,"_5":14884,"_28401":124574,"_3085":124989},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3634":74327,"_31209":74162,"_21628":124991,"_5":14884,"_28401":124574,"_3085":124992},[],"`Fallida` / `Completada` → `Solicitada`",{"_3634":74328,"_31209":74162,"_21628":124994,"_5":14884,"_28401":124574,"_3085":124995},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3634":74329,"_31209":74162,"_21628":124997,"_5":14884,"_28401":124578,"_3085":124998},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3634":74330,"_31209":74162,"_21628":125000,"_5":14884,"_28401":124578,"_3085":125001},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3634":74331,"_31209":74162,"_21628":125003,"_5":14884,"_28401":124578,"_3085":125004},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3634":74332,"_31209":74162,"_21628":125006,"_5":14884,"_28401":124578,"_3085":125007},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3634":74333,"_31209":74162,"_21628":125009,"_5":14884,"_28401":124578,"_3085":125010},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3634":74334,"_31209":74162,"_21628":125012,"_5":14884,"_28401":124578,"_3085":125013},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3634":74335,"_31209":74162,"_21628":125015,"_5":14884,"_28401":124581,"_3085":125016},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3634":74336,"_31209":74162,"_21628":125018,"_5":14884,"_28401":124584,"_3085":125019},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3634":74337,"_31209":74162,"_21628":125021,"_5":14884,"_28401":124584,"_3085":125022},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3634":74338,"_31209":74162,"_21628":125024,"_5":14884,"_28401":124588,"_3085":125025},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3634":74339,"_31209":74162,"_21628":125027,"_5":14884,"_28401":124592,"_3085":125028},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3634":74340,"_31209":74162,"_21628":125030,"_5":14884,"_28401":124592,"_3085":125031},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3634":74341,"_31209":74162,"_21628":125033,"_5":14884,"_28401":124592,"_3085":125034},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3634":74342,"_31209":74162,"_21628":125036,"_5":14884,"_28401":124592,"_3085":125037},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3634":74343,"_31209":74162,"_21628":125039,"_5":14884,"_28401":124592,"_3085":125040},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3634":74344,"_31209":74162,"_21628":125042,"_5":14884,"_28401":124592,"_3085":125043},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3634":74345,"_31209":74162,"_21628":125045,"_5":14884,"_28401":124596,"_3085":125046},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3634":74346,"_31209":74162,"_21628":125048,"_5":14884,"_28401":124596,"_3085":125049},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3634":74347,"_31209":74162,"_21628":125051,"_5":14884,"_28401":124596,"_3085":125052},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3634":74348,"_31209":74162,"_21628":125054,"_5":14884,"_28401":124596,"_3085":125055},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3634":74349,"_31209":74162,"_21628":125057,"_5":14884,"_28401":124596,"_3085":125058},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3634":74350,"_31209":74162,"_21628":125060,"_5":14884,"_28401":124600,"_3085":125061},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3634":74351,"_31209":74162,"_21628":125063,"_5":14884,"_28401":124600,"_3085":124962},[],{"_3634":74352,"_31209":74162,"_21628":125065,"_5":14884,"_28401":124600,"_3085":124965},[],{"_3634":74353,"_31209":74162,"_21628":125067,"_5":14884,"_28401":124600,"_3085":125068},[],"`SinConfigurar` → `None` / `Auto`",{"_3634":74354,"_31209":74162,"_21628":125070,"_5":14884,"_28401":124600,"_3085":125071},[],"ninguna (solo configuración)",{"_3634":74355,"_31209":74162,"_21628":125073,"_5":14884,"_28401":124600,"_3085":55741},[],{"_3634":74356,"_31209":74162,"_21628":125075,"_5":14884,"_28401":124600,"_3085":125071},[],{"_3634":74357,"_31209":74162,"_21628":125077,"_5":14884,"_28401":124600,"_3085":125078},[],"Cualquiera → `Jitp`",{"_3634":74358,"_31209":74162,"_21628":125080,"_5":14884,"_28401":124600,"_3085":125081},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3634":74359,"_31209":74162,"_21628":125083,"_5":14884,"_28401":124600,"_3085":55752},[],{"_3634":74360,"_31209":74162,"_21628":125085,"_5":14884,"_28401":124600,"_3085":125086},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3634":74361,"_31209":74162,"_21628":125088,"_5":14884,"_28401":124604,"_3085":125089},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3634":74362,"_31209":74162,"_21628":125091,"_5":14884,"_28401":124604,"_3085":125092},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3634":74363,"_31209":74162,"_21628":125094,"_5":14884,"_28401":124604,"_3085":125095},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3634":74364,"_31209":74162,"_21628":125097,"_5":14884,"_28401":124608,"_3085":125098},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3634":74365,"_31209":74162,"_21628":125100,"_5":14884,"_28401":124608,"_3085":124962},[],{"_3634":74366,"_31209":74162,"_21628":125102,"_5":14884,"_28401":124608,"_3085":124965},[],{"_3634":74367,"_31209":74162,"_21628":125104,"_5":14884,"_28401":124608,"_3085":125105},[],"`Ausente` → `Aprovisionado`",{"_3634":74368,"_31209":74162,"_21628":125107,"_5":14884,"_28401":124608,"_3085":125108},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3634":74369,"_31209":74162,"_21628":125110,"_5":14884,"_28401":124608,"_3085":125111},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3634":74370,"_31209":74162,"_21628":125113,"_5":14884,"_28401":124608,"_3085":125114},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3634":74371,"_31209":74162,"_21628":125116,"_5":14884,"_28401":124608,"_3085":125117},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3634":74372,"_31209":74162,"_21628":125119,"_5":14884,"_28401":124612,"_3085":125120},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3634":74373,"_31209":74162,"_21628":125122,"_5":14884,"_28401":124612,"_3085":125123},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3634":74374,"_31209":74162,"_21628":125125,"_5":14884,"_28401":124612,"_3085":125126},[],"Para que el flujo JITP funcione correctamente:",{"_3634":74375,"_31209":74162,"_21628":125128,"_5":14884,"_28401":124612,"_3085":125129},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3634":74376,"_31209":74162,"_21628":125131,"_5":14884,"_28401":124612,"_3085":125132},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3634":74377,"_31209":74162,"_21628":125134,"_5":14884,"_28401":124612,"_3085":125135},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3634":74378,"_31209":74162,"_21628":125137,"_5":14884,"_28401":124612,"_3085":125138},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3634":74379,"_31209":74162,"_21628":125140,"_5":14884,"_28401":124616,"_3085":125141},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3634":74380,"_31209":74162,"_21628":125143,"_5":14884,"_28401":124616,"_3085":125144},[],"Estado en Lamassu",{"_3634":74381,"_31209":74162,"_21628":125146,"_5":14884,"_28401":124616,"_3085":125147},[],"Razón de revocación",{"_3634":74382,"_31209":74162,"_21628":125149,"_5":14884,"_28401":124616,"_3085":125150},[],"Estado en AWS IoT Core",{"_3634":74383,"_31209":74162,"_21628":125152,"_5":14884,"_28401":124616,"_3085":55822},[],{"_3634":74384,"_31209":74162,"_21628":125154,"_5":14884,"_28401":124616,"_3085":125155},[],"Ninguna",{"_3634":74385,"_31209":74162,"_21628":125157,"_5":14884,"_28401":124616,"_3085":55828},[],{"_3634":74386,"_31209":74162,"_21628":125159,"_5":14884,"_28401":124616,"_3085":55831},[],{"_3634":74387,"_31209":74162,"_21628":125161,"_5":14884,"_28401":124616,"_3085":55834},[],{"_3634":74388,"_31209":74162,"_21628":125163,"_5":14884,"_28401":124616,"_3085":55837},[],{"_3634":74389,"_31209":74162,"_21628":125165,"_5":14884,"_28401":124616,"_3085":55831},[],{"_3634":74390,"_31209":74162,"_21628":125167,"_5":14884,"_28401":124616,"_3085":125168},[],"Cualquier otra razón",{"_3634":74391,"_31209":74162,"_21628":125170,"_5":14884,"_28401":124616,"_3085":55845},[],{"_3634":74392,"_31209":74162,"_21628":125172,"_5":14884,"_28401":124616,"_3085":125173},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3634":74393,"_31209":74162,"_21628":125175,"_5":14884,"_28401":124620,"_3085":125176},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3634":74394,"_31209":74162,"_21628":125178,"_5":14884,"_28401":124620,"_3085":124962},[],{"_3634":74395,"_31209":74162,"_21628":125180,"_5":14884,"_28401":124620,"_3085":124965},[],{"_3634":74396,"_31209":74162,"_21628":125182,"_5":14884,"_28401":124620,"_3085":125183},[],"`NoSincronizado` → `Active`",{"_3634":74397,"_31209":74162,"_21628":125185,"_5":14884,"_28401":124620,"_3085":55337},[],{"_3634":74398,"_31209":74162,"_21628":125187,"_5":14884,"_28401":124620,"_3085":55863},[],{"_3634":74399,"_31209":74162,"_21628":125189,"_5":14884,"_28401":124620,"_3085":125190},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3634":74400,"_31209":74162,"_21628":125192,"_5":14884,"_28401":124620,"_3085":55869},[],{"_3634":74401,"_31209":74162,"_21628":125194,"_5":14884,"_28401":124620,"_3085":125190},[],{"_3634":74402,"_31209":74162,"_21628":125196,"_5":14884,"_28401":124620,"_3085":55874},[],{"_3634":74403,"_31209":74162,"_21628":125198,"_5":14884,"_28401":124620,"_3085":55337},[],{"_3634":74404,"_31209":74162,"_21628":125200,"_5":14884,"_28401":124620,"_3085":55879},[],{"_3634":74405,"_31209":74162,"_21628":125202,"_5":14884,"_28401":124620,"_3085":125203},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3634":74406,"_31209":74162,"_21628":125205,"_5":14884,"_28401":124624,"_3085":125206},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3634":74407,"_31209":74162,"_21628":125208,"_5":14884,"_28401":124624,"_3085":125209},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3634":74408,"_31209":74162,"_21628":125211,"_5":14884,"_28401":124624,"_3085":125212},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3634":74409,"_31209":74162,"_21628":125214,"_5":14884,"_28401":124628,"_3085":125215},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3634":74410,"_31209":74162,"_21628":125217,"_5":14884,"_28401":124628,"_3085":125218},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3634":74411,"_31209":74162,"_21628":125220,"_5":14884,"_28401":124632,"_3085":125221},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3634":74412,"_31209":74162,"_21628":125223,"_5":14884,"_28401":124632,"_3085":125224},[],"Existen dos tipos de acciones:",{"_3634":74413,"_31209":74162,"_21628":125226,"_5":14884,"_28401":124632,"_3085":125227},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3634":74414,"_31209":74162,"_21628":125229,"_5":14884,"_28401":124632,"_3085":125230},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3634":74415,"_31209":74162,"_21628":125232,"_5":14884,"_28401":124632,"_3085":125233},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3634":74416,"_31209":74162,"_21628":125235,"_5":14884,"_28401":124636,"_3085":125236},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3634":74417,"_31209":74162,"_21628":125238,"_5":14884,"_28401":124636,"_3085":125239},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3634":74418,"_31209":74162,"_21628":125241,"_5":14884,"_28401":124636,"_3085":125242},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3634":74419,"_31209":74162,"_21628":125244,"_5":14884,"_28401":124640,"_3085":125245},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3634":74420,"_31209":74162,"_21628":125247,"_5":14884,"_28401":124640,"_3085":125248},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3634":74421,"_31209":74162,"_21628":125250,"_5":14884,"_28401":124640,"_3085":125251},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3634":74422,"_31209":74162,"_21628":125253,"_5":14884,"_28401":124640,"_3085":125254},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3634":74423,"_31209":74162,"_21628":125256,"_5":14884,"_28401":124640,"_3085":125257},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3634":74424,"_31209":74162,"_21628":125259,"_5":14884,"_28401":124640,"_3085":125260},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3634":74425,"_31209":74162,"_21628":125262,"_5":14884,"_28401":124640,"_3085":125263},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3634":74426,"_31209":74162,"_21628":125265,"_5":14884,"_28401":124640,"_3085":125266},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3634":74427,"_31209":74162,"_21628":125268,"_5":14884,"_28401":124640,"_3085":125269},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3634":74428,"_31209":74162,"_21628":125271,"_5":14884,"_28401":124640,"_3085":125272},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3634":74429,"_31209":74162,"_21628":125274,"_5":14884,"_28401":124640,"_3085":125275},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3634":74430,"_31209":74162,"_21628":125277,"_5":14884,"_28401":124640,"_3085":125278},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3634":74431,"_31209":74162,"_21628":125280,"_5":14884,"_28401":124640,"_3085":125281},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3634":74432,"_31209":74162,"_21628":125283,"_5":14884,"_28401":124640,"_3085":125284},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3634":74433,"_31209":74162,"_21628":125286,"_5":14884,"_28401":124640,"_3085":125287},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3634":74434,"_31209":74162,"_21628":125289,"_5":14884,"_28401":124640,"_3085":125290},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3634":74435,"_31209":74162,"_21628":125292,"_5":14884,"_28401":124640,"_3085":125293},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3634":74436,"_31209":74162,"_21628":125295,"_5":14884,"_28401":124640,"_3085":125296},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3634":74437,"_31209":74162,"_21628":125298,"_5":14884,"_28401":124640,"_3085":125299},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3634":74438,"_31209":74162,"_21628":125301,"_5":14884,"_28401":124640,"_3085":125302},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3634":74439,"_31209":74162,"_21628":125304,"_5":14884,"_28401":124640,"_3085":125305},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3634":74440,"_31209":74162,"_21628":125307,"_5":14884,"_28401":124640,"_3085":125308},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":74441,"_31209":74162,"_21628":125310,"_5":14884,"_28401":124640,"_3085":125311},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3634":74442,"_31209":74162,"_21628":125313,"_5":14884,"_28401":124640,"_3085":125314},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3634":74443,"_31209":74443,"_5":15244,"_3085":53683,"_31547":125316,"_21628":125317,"_28401":74443},[50999,121970,53683],[],{"_3634":74444,"_31209":74443,"_21628":125319,"_5":14884,"_28401":74443,"_3085":125320},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3634":74445,"_31209":74443,"_5":31544,"_21628":125322,"_28401":125323,"_3085":125324},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3634":74446,"_31209":74443,"_5":31544,"_21628":125326,"_28401":125327,"_3085":123115},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3634":74447,"_31209":74443,"_5":31544,"_21628":125329,"_28401":125330,"_3085":123293},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3634":74448,"_31209":74443,"_5":31544,"_21628":125332,"_28401":125333,"_3085":124539},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3634":74449,"_31209":74443,"_5":31544,"_21628":125335,"_28401":125336,"_3085":125337},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3634":74450,"_31209":74443,"_21628":125339,"_5":14884,"_28401":74443,"_3085":125340},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3634":74451,"_31209":74443,"_21628":125342,"_5":14884,"_28401":125323,"_3085":125343},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3634":74452,"_31209":74443,"_21628":125345,"_5":14884,"_28401":125323,"_3085":125346},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3634":74453,"_31209":74443,"_21628":125348,"_5":14884,"_28401":125327,"_3085":125349},[],"Recurso",{"_3634":74454,"_31209":74443,"_21628":125351,"_5":14884,"_28401":125327,"_3085":125352},[],"Qué representa",{"_3634":74455,"_31209":74443,"_21628":125354,"_5":14884,"_28401":125327,"_3085":125355},[],"**Dispositivo**",{"_3634":74456,"_31209":74443,"_21628":125357,"_5":14884,"_28401":125327,"_3085":125358},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3634":74457,"_31209":74443,"_21628":125360,"_5":14884,"_28401":125327,"_3085":125361},[],"**Identidad**",{"_3634":74458,"_31209":74443,"_21628":125363,"_5":14884,"_28401":125327,"_3085":125364},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3634":74459,"_31209":74443,"_21628":125366,"_5":14884,"_28401":125327,"_3085":56046},[],{"_3634":74460,"_31209":74443,"_21628":125368,"_5":14884,"_28401":125327,"_3085":125369},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3634":74461,"_31209":74443,"_21628":125371,"_5":14884,"_28401":125327,"_3085":125372},[],"**Flota**",{"_3634":74462,"_31209":74443,"_21628":125374,"_5":14884,"_28401":125327,"_3085":125375},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3634":74463,"_31209":74443,"_21628":125377,"_5":14884,"_28401":125327,"_3085":125378},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3634":74464,"_31209":74443,"_21628":125380,"_5":14884,"_28401":125327,"_3085":125381},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3634":74465,"_31209":74443,"_21628":125383,"_5":14884,"_28401":125330,"_3085":125384},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3634":74466,"_31209":74443,"_21628":125386,"_5":14884,"_28401":125330,"_3085":125387},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3634":74467,"_31209":74443,"_21628":125389,"_5":14884,"_28401":125330,"_3085":125390},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3634":74468,"_31209":74443,"_21628":125392,"_5":14884,"_28401":125330,"_3085":125393},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3634":74469,"_31209":74443,"_21628":125395,"_5":14884,"_28401":125330,"_3085":125396},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3634":74470,"_31209":74443,"_21628":125398,"_5":14884,"_28401":125330,"_3085":125399},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3634":74471,"_31209":74443,"_21628":125401,"_5":14884,"_28401":125330,"_3085":125402},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":74472,"_31209":74443,"_21628":125404,"_5":14884,"_28401":125330,"_3085":125405},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3634":74473,"_31209":74443,"_21628":125407,"_5":14884,"_28401":125333,"_3085":125408},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3634":74474,"_31209":74443,"_21628":125410,"_5":14884,"_28401":125333,"_3085":125411},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3634":74475,"_31209":74443,"_21628":125413,"_5":14884,"_28401":125336,"_3085":125414},[],"Participante",{"_3634":74476,"_31209":74443,"_21628":125416,"_5":14884,"_28401":125336,"_3085":125417},[],"Responsabilidad",{"_3634":74477,"_31209":74443,"_21628":125419,"_5":14884,"_28401":125336,"_3085":125420},[],"Administrador PKI",{"_3634":74478,"_31209":74443,"_21628":125422,"_5":14884,"_28401":125336,"_3085":125423},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3634":74479,"_31209":74443,"_21628":125425,"_5":14884,"_28401":125336,"_3085":125426},[],"Administrador del aprovisionamiento",{"_3634":74480,"_31209":74443,"_21628":125428,"_5":14884,"_28401":125336,"_3085":125429},[],"DMS, admisión, autenticación por operación e inventario.",{"_3634":74481,"_31209":74443,"_21628":125431,"_5":14884,"_28401":125336,"_3085":125432},[],"Integrador del dispositivo",{"_3634":74482,"_31209":74443,"_21628":125434,"_5":14884,"_28401":125336,"_3085":125435},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3634":74483,"_31209":74443,"_21628":125437,"_5":14884,"_28401":125336,"_3085":125438},[],"Integrador del consumidor",{"_3634":74484,"_31209":74443,"_21628":125440,"_5":14884,"_28401":125336,"_3085":125441},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3634":74485,"_31209":74443,"_21628":125443,"_5":14884,"_28401":125336,"_3085":125444},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3634":74486,"_31209":74486,"_5":15244,"_3085":125446,"_31547":125447,"_21628":125449,"_28401":74486},"Enrola y conecta tu primer dispositivo",[50999,121970,53683,125448],"Primeros pasos",[],{"_3634":74487,"_31209":74486,"_21628":125451,"_5":14884,"_28401":74486,"_3085":125452},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3634":74488,"_31209":74486,"_5":31544,"_21628":125454,"_28401":125455,"_3085":120504},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3634":74489,"_31209":74486,"_5":31544,"_21628":125457,"_28401":125458,"_3085":125459},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3634":74490,"_31209":74486,"_5":31544,"_21628":125461,"_28401":125462,"_3085":125463},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3634":74491,"_31209":74486,"_5":31544,"_21628":125465,"_28401":125466,"_3085":125467},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3634":74492,"_31209":74486,"_5":31544,"_21628":125469,"_28401":125470,"_3085":125471},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3634":74493,"_31209":74486,"_5":31544,"_21628":125473,"_28401":125474,"_3085":125475},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3634":74494,"_31209":74486,"_5":31544,"_21628":125477,"_28401":125478,"_3085":125479},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3634":74495,"_31209":74486,"_5":31544,"_21628":125481,"_28401":125482,"_3085":125483},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3634":74496,"_31209":74486,"_21628":125485,"_5":14884,"_28401":74486,"_3085":125486},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3634":74497,"_31209":74486,"_21628":125488,"_5":14884,"_28401":125455,"_3085":125489},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3634":74498,"_31209":74486,"_21628":125491,"_5":14884,"_28401":125455,"_3085":125492},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3634":74499,"_31209":74486,"_21628":125494,"_5":14884,"_28401":125455,"_3085":125495},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3634":74500,"_31209":74486,"_21628":125497,"_5":14884,"_28401":125455,"_3085":125498},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3634":74501,"_31209":74486,"_21628":125500,"_5":14884,"_28401":125455,"_3085":125501},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3634":74502,"_31209":74486,"_21628":125503,"_5":14884,"_28401":125458,"_3085":125504},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3634":74503,"_31209":74486,"_21628":125506,"_5":14884,"_28401":125458,"_3085":125507},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3634":74504,"_31209":74486,"_21628":125509,"_5":14884,"_28401":125462,"_3085":125510},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3634":74505,"_31209":74486,"_21628":125512,"_5":14884,"_28401":125462,"_3085":125513},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3634":74506,"_31209":74486,"_21628":125515,"_5":14884,"_28401":125462,"_3085":125516},[],"Ajuste",{"_3634":74507,"_31209":74486,"_21628":125518,"_5":14884,"_28401":125462,"_3085":125519},[],"Valor de evaluación",{"_3634":74508,"_31209":74486,"_21628":125521,"_5":14884,"_28401":125462,"_3085":56202},[],{"_3634":74509,"_31209":74486,"_21628":125523,"_5":14884,"_28401":125462,"_3085":125524},[],"Raíz emisora de `device-root.pem`.",{"_3634":74510,"_31209":74486,"_21628":125526,"_5":14884,"_28401":125462,"_3085":123427},[],{"_3634":74511,"_31209":74486,"_21628":125528,"_5":14884,"_28401":125462,"_3085":125529},[],"Perfil final de 1 hora que acabas de preparar.",{"_3634":74512,"_31209":74486,"_21628":125531,"_5":14884,"_28401":125462,"_3085":56213},[],{"_3634":74513,"_31209":74486,"_21628":125533,"_5":14884,"_28401":125462,"_3085":56216},[],{"_3634":74514,"_31209":74486,"_21628":125535,"_5":14884,"_28401":125462,"_3085":56219},[],{"_3634":74515,"_31209":74486,"_21628":125537,"_5":14884,"_28401":125462,"_3085":125538},[],"Habilitado.",{"_3634":74516,"_31209":74486,"_21628":125540,"_5":14884,"_28401":125462,"_3085":56225},[],{"_3634":74517,"_31209":74486,"_21628":125542,"_5":14884,"_28401":125462,"_3085":125543},[],"Deshabilitado; el ID debe ser nuevo.",{"_3634":74518,"_31209":74486,"_21628":125545,"_5":14884,"_28401":125462,"_3085":125546},[],"Autenticación inicial",{"_3634":74519,"_31209":74486,"_21628":125548,"_5":14884,"_28401":125462,"_3085":125549},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3634":74520,"_31209":74486,"_21628":125551,"_5":14884,"_28401":125462,"_3085":125552},[],"Autenticación de renovación",{"_3634":74521,"_31209":74486,"_21628":125554,"_5":14884,"_28401":125462,"_3085":125555},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3634":74522,"_31209":74486,"_21628":125557,"_5":14884,"_28401":125462,"_3085":56243},[],{"_3634":74523,"_31209":74486,"_21628":125559,"_5":14884,"_28401":125462,"_3085":125560},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3634":74524,"_31209":74486,"_21628":125562,"_5":14884,"_28401":125462,"_3085":56249},[],{"_3634":74525,"_31209":74486,"_21628":125564,"_5":14884,"_28401":125462,"_3085":125565},[],"1 hora.",{"_3634":74526,"_31209":74486,"_21628":125567,"_5":14884,"_28401":125462,"_3085":56255},[],{"_3634":74527,"_31209":74486,"_21628":125569,"_5":14884,"_28401":125462,"_3085":125570},[],"30 minutos / 10 minutos.",{"_3634":74528,"_31209":74486,"_21628":125572,"_5":14884,"_28401":125462,"_3085":56261},[],{"_3634":74529,"_31209":74486,"_21628":125574,"_5":14884,"_28401":125462,"_3085":125575},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3634":74530,"_31209":74486,"_21628":125577,"_5":14884,"_28401":125462,"_3085":54011},[],{"_3634":74531,"_31209":74486,"_21628":125579,"_5":14884,"_28401":125462,"_3085":125580},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3634":74532,"_31209":74486,"_21628":125582,"_5":14884,"_28401":125462,"_3085":56272},[],{"_3634":74533,"_31209":74486,"_21628":125584,"_5":14884,"_28401":125462,"_3085":125585},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3634":74534,"_31209":74486,"_21628":125587,"_5":14884,"_28401":125462,"_3085":125588},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3634":74535,"_31209":74486,"_21628":125590,"_5":14884,"_28401":125466,"_3085":125591},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3634":74536,"_31209":74486,"_21628":125593,"_5":14884,"_28401":125466,"_3085":125594},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3634":74537,"_31209":74486,"_21628":125596,"_5":14884,"_28401":125470,"_3085":125597},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3634":74538,"_31209":74486,"_21628":125599,"_5":14884,"_28401":125470,"_3085":125600},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3634":74539,"_31209":74486,"_21628":125602,"_5":14884,"_28401":125470,"_3085":125603},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3634":74540,"_31209":74486,"_21628":125605,"_5":14884,"_28401":125474,"_3085":125606},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3634":74541,"_31209":74486,"_21628":125608,"_5":14884,"_28401":125474,"_3085":125609},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3634":74542,"_31209":74486,"_21628":125611,"_5":14884,"_28401":125478,"_3085":125612},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3634":74543,"_31209":74486,"_21628":125614,"_5":14884,"_28401":125478,"_3085":125615},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3634":74544,"_31209":74486,"_21628":125617,"_5":14884,"_28401":125478,"_3085":125618},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3634":74545,"_31209":74486,"_21628":125620,"_5":14884,"_28401":125478,"_3085":125621},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3634":74546,"_31209":74486,"_21628":125623,"_5":14884,"_28401":125478,"_3085":125624},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3634":74547,"_31209":74486,"_21628":125626,"_5":14884,"_28401":125482,"_3085":125627},[],"Comprobación",{"_3634":74548,"_31209":74486,"_21628":125629,"_5":14884,"_28401":125482,"_3085":125630},[],"Resultado esperado",{"_3634":74549,"_31209":74486,"_21628":125632,"_5":14884,"_28401":125482,"_3085":125633},[],"Registro",{"_3634":74550,"_31209":74486,"_21628":125635,"_5":14884,"_28401":125482,"_3085":125636},[],"ID creado automáticamente y DMS correcto.",{"_3634":74551,"_31209":74486,"_21628":125638,"_5":14884,"_28401":125482,"_3085":124923},[],{"_3634":74552,"_31209":74486,"_21628":125640,"_5":14884,"_28401":125482,"_3085":125641},[],"CN, perfil, serie y clave verificados.",{"_3634":74553,"_31209":74486,"_21628":125643,"_5":14884,"_28401":125482,"_3085":125644},[],"Inventario",{"_3634":74554,"_31209":74486,"_21628":125646,"_5":14884,"_28401":125482,"_3085":125647},[],"Serie recibida visible como identidad actual y en el historial.",{"_3634":74555,"_31209":74486,"_21628":125649,"_5":14884,"_28401":125482,"_3085":125650},[],"Consumidor",{"_3634":74556,"_31209":74486,"_21628":125652,"_5":14884,"_28401":125482,"_3085":125653},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3634":74557,"_31209":74486,"_21628":125655,"_5":14884,"_28401":125482,"_3085":125656},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3634":74558,"_31209":74486,"_21628":125658,"_5":14884,"_28401":125482,"_3085":125659},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3634":74559,"_31209":74559,"_5":15244,"_3085":123132,"_31547":125661,"_21628":125662,"_28401":74559},[50999,121970,53683,125448],[],{"_3634":74560,"_31209":74559,"_21628":125664,"_5":14884,"_28401":74559,"_3085":125665},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3634":74561,"_31209":74559,"_5":31544,"_21628":125667,"_28401":125668,"_3085":120504},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3634":74562,"_31209":74559,"_5":31544,"_21628":125670,"_28401":125671,"_3085":125672},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3634":74563,"_31209":74559,"_5":31544,"_21628":125674,"_28401":125675,"_3085":125676},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3634":74564,"_31209":74559,"_5":31544,"_21628":125678,"_28401":125679,"_3085":125680},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3634":74565,"_31209":74559,"_5":31544,"_21628":125682,"_28401":125683,"_3085":125684},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3634":74566,"_31209":74559,"_5":31544,"_21628":125686,"_28401":125687,"_3085":125688},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3634":74567,"_31209":74559,"_5":31544,"_21628":125690,"_28401":125691,"_3085":125630},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3634":74568,"_31209":74559,"_5":31544,"_21628":125693,"_28401":125694,"_3085":125695},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3634":74569,"_31209":74559,"_5":31544,"_21628":125697,"_28401":125698,"_3085":125699},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3634":74570,"_31209":74559,"_21628":125701,"_5":14884,"_28401":74559,"_3085":125702},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3634":74571,"_31209":74559,"_21628":125704,"_5":14884,"_28401":74559,"_3085":125705},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3634":74572,"_31209":74559,"_21628":125707,"_5":14884,"_28401":125668,"_3085":125708},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3634":74573,"_31209":74559,"_21628":125710,"_5":14884,"_28401":125668,"_3085":125711},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3634":74574,"_31209":74559,"_21628":125713,"_5":14884,"_28401":125668,"_3085":125714},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3634":74575,"_31209":74559,"_21628":125716,"_5":14884,"_28401":125668,"_3085":125717},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3634":74576,"_31209":74559,"_21628":125719,"_5":14884,"_28401":125671,"_3085":125720},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3634":74577,"_31209":74559,"_21628":125722,"_5":14884,"_28401":125671,"_3085":125723},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3634":74578,"_31209":74559,"_21628":125725,"_5":14884,"_28401":125671,"_3085":125726},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3634":74579,"_31209":74559,"_21628":125728,"_5":14884,"_28401":125671,"_3085":125729},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3634":74580,"_31209":74559,"_21628":125731,"_5":14884,"_28401":125671,"_3085":125732},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3634":74581,"_31209":74559,"_21628":125734,"_5":14884,"_28401":125671,"_3085":125735},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3634":74582,"_31209":74559,"_21628":125737,"_5":14884,"_28401":125671,"_3085":125738},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3634":74583,"_31209":74559,"_21628":125740,"_5":14884,"_28401":125671,"_3085":125741},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3634":74584,"_31209":74559,"_21628":125743,"_5":14884,"_28401":125675,"_3085":125744},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3634":74585,"_31209":74559,"_21628":125746,"_5":14884,"_28401":125675,"_3085":56437},[],{"_3634":74586,"_31209":74559,"_21628":125748,"_5":14884,"_28401":125675,"_3085":125749},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3634":74587,"_31209":74559,"_21628":125751,"_5":14884,"_28401":125675,"_3085":125752},[],"**Icon** y **Tags**: clasificación opcional.",{"_3634":74588,"_31209":74559,"_21628":125754,"_5":14884,"_28401":125675,"_3085":125755},[],"Confirma el registro.",{"_3634":74589,"_31209":74559,"_21628":125757,"_5":14884,"_28401":125679,"_3085":125758},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3634":74590,"_31209":74559,"_21628":125760,"_5":14884,"_28401":125679,"_3085":125761},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3634":74591,"_31209":74559,"_21628":125763,"_5":14884,"_28401":125683,"_3085":125764},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3634":74592,"_31209":74559,"_21628":125766,"_5":14884,"_28401":125683,"_3085":125767},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3634":74593,"_31209":74559,"_21628":125769,"_5":14884,"_28401":125687,"_3085":125770},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3634":74594,"_31209":74559,"_21628":125772,"_5":14884,"_28401":125687,"_3085":125773},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3634":74595,"_31209":74559,"_21628":125775,"_5":14884,"_28401":125691,"_3085":125627},[],{"_3634":74596,"_31209":74559,"_21628":125777,"_5":14884,"_28401":125691,"_3085":125778},[],"Resultado",{"_3634":74597,"_31209":74559,"_21628":125780,"_5":14884,"_28401":125691,"_3085":124909},[],{"_3634":74598,"_31209":74559,"_21628":125782,"_5":14884,"_28401":125691,"_3085":125783},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3634":74599,"_31209":74559,"_21628":125785,"_5":14884,"_28401":125691,"_3085":125786},[],"Identidad actual",{"_3634":74600,"_31209":74559,"_21628":125788,"_5":14884,"_28401":125691,"_3085":125789},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3634":74601,"_31209":74559,"_21628":125791,"_5":14884,"_28401":125691,"_3085":125792},[],"Historial",{"_3634":74602,"_31209":74559,"_21628":125794,"_5":14884,"_28401":125691,"_3085":125795},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3634":74603,"_31209":74559,"_21628":125797,"_5":14884,"_28401":125691,"_3085":125798},[],"Clave y certificado",{"_3634":74604,"_31209":74559,"_21628":125800,"_5":14884,"_28401":125691,"_3085":125801},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3634":74605,"_31209":74559,"_21628":125803,"_5":14884,"_28401":125694,"_3085":125804},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3634":74606,"_31209":74559,"_21628":125806,"_5":14884,"_28401":125694,"_3085":125807},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3634":74607,"_31209":74559,"_21628":125809,"_5":14884,"_28401":125694,"_3085":125810},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3634":74608,"_31209":74559,"_21628":125812,"_5":14884,"_28401":125694,"_3085":125813},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3634":74609,"_31209":74559,"_21628":125815,"_5":14884,"_28401":125698,"_3085":125816},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3634":74610,"_31209":74559,"_21628":125818,"_5":14884,"_28401":125698,"_3085":125819},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3634":74611,"_31209":74559,"_21628":125821,"_5":14884,"_28401":125698,"_3085":125822},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3634":74612,"_31209":74612,"_5":15244,"_3085":125824,"_31547":125825,"_21628":125826,"_28401":74612},"Plataforma Lamassu IoT",[50999,121970],[],{"_3634":74613,"_31209":74612,"_21628":125828,"_5":14884,"_28401":74612,"_3085":125829},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3634":74614,"_31209":74612,"_5":31544,"_21628":125831,"_28401":125832,"_3085":125324},[],"/docs/es/platform/overview#empieza-aquí",{"_3634":74615,"_31209":74612,"_5":31544,"_21628":125834,"_28401":125835,"_3085":125836},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3634":74616,"_31209":74612,"_5":31544,"_21628":125838,"_28401":125839,"_3085":125840},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3634":74617,"_31209":74612,"_5":31544,"_21628":125842,"_28401":125843,"_3085":125844},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3634":74618,"_31209":74612,"_5":31544,"_21628":125846,"_28401":125847,"_3085":125848},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3634":74619,"_31209":74612,"_5":31544,"_21628":125850,"_28401":125851,"_3085":125852},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3634":74620,"_31209":74612,"_5":31544,"_21628":125854,"_28401":125855,"_3085":125856},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3634":74621,"_31209":74612,"_5":31544,"_21628":125858,"_28401":125859,"_3085":125860},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3634":74622,"_31209":74612,"_5":31544,"_21628":125862,"_28401":125863,"_3085":125864},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3634":74623,"_31209":74612,"_5":31544,"_21628":125866,"_28401":125867,"_3085":125868},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3634":74624,"_31209":74612,"_5":31544,"_21628":125870,"_28401":125871,"_3085":125872},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3634":74625,"_31209":74612,"_21628":125874,"_5":14884,"_28401":74612,"_3085":125875},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3634":74626,"_31209":74612,"_21628":125877,"_5":14884,"_28401":125832,"_3085":125878},[],"Elige el resultado que necesitas obtener:",{"_3634":74627,"_31209":74612,"_21628":125880,"_5":14884,"_28401":125832,"_3085":125881},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3634":74628,"_31209":74612,"_21628":125883,"_5":14884,"_28401":125832,"_3085":125884},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3634":74629,"_31209":74612,"_21628":125886,"_5":14884,"_28401":125832,"_3085":125887},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3634":74630,"_31209":74612,"_21628":125889,"_5":14884,"_28401":125835,"_3085":125890},[],"Bloque",{"_3634":74631,"_31209":74612,"_21628":125892,"_5":14884,"_28401":125835,"_3085":125893},[],"Qué gestionas",{"_3634":74632,"_31209":74612,"_21628":125895,"_5":14884,"_28401":125835,"_3085":125896},[],"Punto de entrada",{"_3634":74633,"_31209":74612,"_21628":125898,"_5":14884,"_28401":125835,"_3085":56590},[],{"_3634":74634,"_31209":74612,"_21628":125900,"_5":14884,"_28401":125835,"_3085":125901},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3634":74635,"_31209":74612,"_21628":125903,"_5":14884,"_28401":125835,"_3085":125904},[],"Visión general de PKI",{"_3634":74636,"_31209":74612,"_21628":125906,"_5":14884,"_28401":125835,"_3085":56599},[],{"_3634":74637,"_31209":74612,"_21628":125908,"_5":14884,"_28401":125835,"_3085":125909},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3634":74638,"_31209":74612,"_21628":125911,"_5":14884,"_28401":125835,"_3085":125912},[],"Visión general de IoT Fleets",{"_3634":74639,"_31209":74612,"_21628":125914,"_5":14884,"_28401":125835,"_3085":125915},[],"**Administración**",{"_3634":74640,"_31209":74612,"_21628":125917,"_5":14884,"_28401":125835,"_3085":125918},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3634":74641,"_31209":74612,"_21628":125920,"_5":14884,"_28401":125835,"_3085":121972},[],{"_3634":74642,"_31209":74612,"_21628":125922,"_5":14884,"_28401":125835,"_3085":125923},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3634":74643,"_31209":74612,"_21628":125925,"_5":14884,"_28401":125839,"_3085":125926},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3634":74644,"_31209":74612,"_21628":125928,"_5":14884,"_28401":125839,"_3085":125929},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3634":74645,"_31209":74612,"_21628":125931,"_5":14884,"_28401":125839,"_3085":125932},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3634":74646,"_31209":74612,"_21628":125934,"_5":14884,"_28401":125839,"_3085":125935},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3634":74647,"_31209":74612,"_21628":125937,"_5":14884,"_28401":125839,"_3085":125938},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3634":74648,"_31209":74612,"_21628":125940,"_5":14884,"_28401":125839,"_3085":125941},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3634":74649,"_31209":74612,"_21628":125943,"_5":14884,"_28401":125847,"_3085":125944},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3634":74650,"_31209":74612,"_21628":125946,"_5":14884,"_28401":125851,"_3085":125947},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3634":74651,"_31209":74612,"_21628":125949,"_5":14884,"_28401":125855,"_3085":125950},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3634":74652,"_31209":74612,"_21628":125952,"_5":14884,"_28401":125859,"_3085":125953},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3634":74653,"_31209":74612,"_21628":125955,"_5":14884,"_28401":125863,"_3085":125956},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3634":74654,"_31209":74612,"_21628":125958,"_5":14884,"_28401":125867,"_3085":125959},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3634":74655,"_31209":74612,"_21628":125961,"_5":14884,"_28401":125871,"_3085":125417},[],{"_3634":74656,"_31209":74612,"_21628":125963,"_5":14884,"_28401":125871,"_3085":125964},[],"Qué prepara o comprueba",{"_3634":74657,"_31209":74612,"_21628":125966,"_5":14884,"_28401":125871,"_3085":125420},[],{"_3634":74658,"_31209":74612,"_21628":125968,"_5":14884,"_28401":125871,"_3085":125969},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3634":74659,"_31209":74612,"_21628":125971,"_5":14884,"_28401":125871,"_3085":125972},[],"Administrador de la flota",{"_3634":74660,"_31209":74612,"_21628":125974,"_5":14884,"_28401":125871,"_3085":125975},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3634":74661,"_31209":74612,"_21628":125977,"_5":14884,"_28401":125871,"_3085":125432},[],{"_3634":74662,"_31209":74612,"_21628":125979,"_5":14884,"_28401":125871,"_3085":125980},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3634":74663,"_31209":74612,"_21628":125982,"_5":14884,"_28401":125871,"_3085":125438},[],{"_3634":74664,"_31209":74612,"_21628":125984,"_5":14884,"_28401":125871,"_3085":125985},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3634":74665,"_31209":74612,"_21628":125987,"_5":14884,"_28401":125871,"_3085":125988},[],"Operador de infraestructura",{"_3634":74666,"_31209":74612,"_21628":125990,"_5":14884,"_28401":125871,"_3085":125991},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3634":74667,"_31209":74612,"_21628":125993,"_5":14884,"_28401":125871,"_3085":125994},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3634":74668,"_31209":74668,"_5":15244,"_3085":125996,"_31547":125997,"_21628":125999,"_28401":74668},"Jerarquía y rotación de CAs",[50999,121970,56691,125998],"Claves, autoridades y certificados",[],{"_3634":74669,"_31209":74668,"_21628":126001,"_5":14884,"_28401":74668,"_3085":126002},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3634":74670,"_31209":74668,"_5":31544,"_21628":126004,"_28401":126005,"_3085":126006},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3634":74671,"_31209":74668,"_5":31544,"_21628":126008,"_28401":126009,"_3085":126010},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3634":74672,"_31209":74668,"_5":31544,"_21628":126012,"_28401":126013,"_3085":126014},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3634":74673,"_31209":74668,"_5":31544,"_21628":126016,"_28401":126017,"_3085":126018},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3634":74674,"_31209":74668,"_5":31544,"_21628":126020,"_28401":126021,"_3085":126022},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3634":74675,"_31209":74668,"_5":31544,"_21628":126024,"_28401":126025,"_3085":126026},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3634":74676,"_31209":74668,"_5":31544,"_21628":126028,"_28401":126029,"_3085":126030},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3634":74677,"_31209":74668,"_5":31544,"_21628":126032,"_28401":126033,"_3085":126034},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3634":74678,"_31209":74668,"_5":31544,"_21628":126036,"_28401":126037,"_3085":126038},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3634":74679,"_31209":74668,"_5":31544,"_21628":126040,"_28401":126041,"_3085":126042},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3634":74680,"_31209":74668,"_5":31544,"_21628":126044,"_28401":126045,"_3085":126046},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3634":74681,"_31209":74668,"_5":31544,"_21628":126048,"_28401":126049,"_3085":126050},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3634":74682,"_31209":74668,"_21628":126052,"_5":14884,"_28401":74668,"_3085":126053},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3634":74683,"_31209":74668,"_21628":126055,"_5":14884,"_28401":74668,"_3085":126056},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3634":74684,"_31209":74668,"_21628":126058,"_5":14884,"_28401":126005,"_3085":126059},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3634":74685,"_31209":74668,"_21628":126061,"_5":14884,"_28401":126005,"_3085":126062},[],"entorno, como producción y preproducción;",{"_3634":74686,"_31209":74668,"_21628":126064,"_5":14884,"_28401":126005,"_3085":126065},[],"propietario o equipo operador;",{"_3634":74687,"_31209":74668,"_21628":126067,"_5":14884,"_28401":126005,"_3085":126068},[],"familia de dispositivos o proceso de fabricación;",{"_3634":74688,"_31209":74668,"_21628":126070,"_5":14884,"_28401":126005,"_3085":126071},[],"región o requisito regulatorio;",{"_3634":74689,"_31209":74668,"_21628":126073,"_5":14884,"_28401":126005,"_3085":126074},[],"motor criptográfico o política de clave;",{"_3634":74690,"_31209":74668,"_21628":126076,"_5":14884,"_28401":126005,"_3085":126077},[],"ventana de mantenimiento y ritmo de renovación.",{"_3634":74691,"_31209":74668,"_21628":126079,"_5":14884,"_28401":126005,"_3085":126080},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3634":74692,"_31209":74668,"_21628":126082,"_5":14884,"_28401":126005,"_3085":126083},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3634":74693,"_31209":74668,"_21628":126085,"_5":14884,"_28401":126009,"_3085":126086},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3634":74694,"_31209":74668,"_21628":126088,"_5":14884,"_28401":126009,"_3085":126089},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3634":74695,"_31209":74668,"_21628":126091,"_5":14884,"_28401":126009,"_3085":126092},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3634":74696,"_31209":74668,"_21628":126094,"_5":14884,"_28401":126009,"_3085":126095},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3634":74697,"_31209":74668,"_21628":126097,"_5":14884,"_28401":126013,"_3085":126098},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3634":74698,"_31209":74668,"_21628":126100,"_5":14884,"_28401":126013,"_3085":126101},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3634":74699,"_31209":74668,"_21628":126103,"_5":14884,"_28401":126013,"_3085":126104},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3634":74700,"_31209":74668,"_21628":126106,"_5":14884,"_28401":126013,"_3085":126107},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3634":74701,"_31209":74668,"_21628":126109,"_5":14884,"_28401":126021,"_3085":126110},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3634":74702,"_31209":74668,"_21628":126112,"_5":14884,"_28401":126025,"_3085":126113},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3634":74703,"_31209":74668,"_21628":126115,"_5":14884,"_28401":126029,"_3085":126116},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3634":74704,"_31209":74668,"_21628":126118,"_5":14884,"_28401":126033,"_3085":126119},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3634":74705,"_31209":74668,"_21628":126121,"_5":14884,"_28401":126037,"_3085":126122},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3634":74706,"_31209":74668,"_21628":126124,"_5":14884,"_28401":126041,"_3085":126125},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3634":74707,"_31209":74668,"_21628":126127,"_5":14884,"_28401":126045,"_3085":126128},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3634":74708,"_31209":74668,"_21628":126130,"_5":14884,"_28401":126045,"_3085":126131},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3634":74709,"_31209":74668,"_21628":126133,"_5":14884,"_28401":126045,"_3085":126134},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3634":74710,"_31209":74668,"_21628":126136,"_5":14884,"_28401":126045,"_3085":126137},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3634":74711,"_31209":74668,"_21628":126139,"_5":14884,"_28401":126049,"_3085":126140},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3634":74712,"_31209":74668,"_21628":126142,"_5":14884,"_28401":126049,"_3085":126143},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3634":74713,"_31209":74668,"_21628":126145,"_5":14884,"_28401":126049,"_3085":126146},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3634":74714,"_31209":74668,"_21628":126148,"_5":14884,"_28401":126049,"_3085":126149},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3634":74715,"_31209":74668,"_21628":126151,"_5":14884,"_28401":126049,"_3085":126152},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3634":74716,"_31209":74668,"_21628":126154,"_5":14884,"_28401":126049,"_3085":126155},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3634":74717,"_31209":74668,"_21628":126157,"_5":14884,"_28401":126049,"_3085":126158},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3634":74718,"_31209":74718,"_5":15244,"_3085":126160,"_31547":126161,"_21628":126162,"_28401":74718},"Autoridades de certificación",[50999,121970,56691,125998],[],{"_3634":74719,"_31209":74718,"_21628":126164,"_5":14884,"_28401":74718,"_3085":126165},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3634":74720,"_31209":74718,"_5":31544,"_21628":126167,"_28401":126168,"_3085":126169},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3634":74721,"_31209":74718,"_5":31544,"_21628":126171,"_28401":126172,"_3085":126173},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3634":74722,"_31209":74718,"_5":31544,"_21628":126175,"_28401":126176,"_3085":120504},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3634":74723,"_31209":74718,"_5":31544,"_21628":126178,"_28401":126179,"_3085":126180},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3634":74724,"_31209":74718,"_5":31544,"_21628":126182,"_28401":126183,"_3085":126184},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3634":74725,"_31209":74718,"_5":31544,"_21628":126186,"_28401":126187,"_3085":126188},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3634":74726,"_31209":74718,"_5":31544,"_21628":126190,"_28401":126191,"_3085":126192},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3634":74727,"_31209":74718,"_5":31544,"_21628":126194,"_28401":126195,"_3085":126196},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3634":74728,"_31209":74718,"_5":31544,"_21628":126198,"_28401":126199,"_3085":126200},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3634":74729,"_31209":74718,"_5":31544,"_21628":126202,"_28401":126203,"_3085":126204},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3634":74730,"_31209":74718,"_5":31544,"_21628":126206,"_28401":126207,"_3085":126208},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3634":74731,"_31209":74718,"_5":31544,"_21628":126210,"_28401":126211,"_3085":126212},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3634":74732,"_31209":74718,"_5":31544,"_21628":126214,"_28401":126215,"_3085":126216},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3634":74733,"_31209":74718,"_5":31544,"_21628":126218,"_28401":126219,"_3085":126220},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3634":74734,"_31209":74718,"_5":31544,"_21628":126222,"_28401":126223,"_3085":126224},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3634":74735,"_31209":74718,"_5":31544,"_21628":126226,"_28401":126227,"_3085":126228},[],"/docs/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3634":74736,"_31209":74718,"_5":31544,"_21628":126230,"_28401":126231,"_3085":126232},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3634":74737,"_31209":74718,"_5":31544,"_21628":126234,"_28401":126235,"_3085":126236},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3634":74738,"_31209":74718,"_5":31544,"_21628":126238,"_28401":126239,"_3085":126240},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3634":74739,"_31209":74718,"_5":31544,"_21628":126242,"_28401":126243,"_3085":126244},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3634":74740,"_31209":74718,"_5":31544,"_21628":126246,"_28401":126247,"_3085":126248},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3634":74741,"_31209":74718,"_5":31544,"_21628":126250,"_28401":126251,"_3085":126252},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3634":74742,"_31209":74718,"_5":31544,"_21628":126254,"_28401":126255,"_3085":126256},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3634":74743,"_31209":74718,"_5":31544,"_21628":126258,"_28401":126259,"_3085":126260},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3634":74744,"_31209":74718,"_21628":126262,"_5":14884,"_28401":74718,"_3085":126263},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3634":74745,"_31209":74718,"_21628":126265,"_5":14884,"_28401":74718,"_3085":126266},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3634":74746,"_31209":74718,"_21628":126268,"_5":14884,"_28401":74718,"_3085":126269},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3634":74747,"_31209":74718,"_21628":126271,"_5":14884,"_28401":126168,"_3085":126272},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3634":74748,"_31209":74718,"_21628":126274,"_5":14884,"_28401":126168,"_3085":126275},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3634":74749,"_31209":74718,"_21628":126277,"_5":14884,"_28401":126168,"_3085":126278},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3634":74750,"_31209":74718,"_21628":126280,"_5":14884,"_28401":126168,"_3085":126281},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3634":74751,"_31209":74718,"_21628":126283,"_5":14884,"_28401":126168,"_3085":126284},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3634":74752,"_31209":74718,"_21628":126286,"_5":14884,"_28401":126176,"_3085":126287},[],"Decide si la CA será raíz o intermedia.",{"_3634":74753,"_31209":74718,"_21628":126289,"_5":14884,"_28401":126176,"_3085":126290},[],"Elige el motor que custodiará la clave.",{"_3634":74754,"_31209":74718,"_21628":126292,"_5":14884,"_28401":126176,"_3085":126293},[],"Define una validez superior a la de los certificados que emitirá.",{"_3634":74755,"_31209":74718,"_21628":126295,"_5":14884,"_28401":126176,"_3085":126296},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3634":74756,"_31209":74718,"_21628":126298,"_5":14884,"_28401":126179,"_3085":126299},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3634":74757,"_31209":74718,"_21628":126301,"_5":14884,"_28401":126183,"_3085":126302},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3634":74758,"_31209":74718,"_21628":126304,"_5":14884,"_28401":126183,"_3085":126305},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3634":74759,"_31209":74718,"_21628":126307,"_5":14884,"_28401":126187,"_3085":126308},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3634":74760,"_31209":74718,"_21628":126310,"_5":14884,"_28401":126191,"_3085":126311},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3634":74761,"_31209":74718,"_21628":126313,"_5":14884,"_28401":126191,"_3085":126314},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3634":74762,"_31209":74718,"_21628":126316,"_5":14884,"_28401":126191,"_3085":126317},[],"`ST`: estado o provincia.",{"_3634":74763,"_31209":74718,"_21628":126319,"_5":14884,"_28401":126191,"_3085":126320},[],"`L`: localidad.",{"_3634":74764,"_31209":74718,"_21628":126322,"_5":14884,"_28401":126191,"_3085":126323},[],"`O`: organización.",{"_3634":74765,"_31209":74718,"_21628":126325,"_5":14884,"_28401":126191,"_3085":126326},[],"`OU`: unidad organizativa.",{"_3634":74766,"_31209":74718,"_21628":126328,"_5":14884,"_28401":126191,"_3085":126329},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3634":74767,"_31209":74718,"_21628":126331,"_5":14884,"_28401":126195,"_3085":126332},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3634":74768,"_31209":74718,"_21628":126334,"_5":14884,"_28401":126195,"_3085":126335},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3634":74769,"_31209":74718,"_21628":126337,"_5":14884,"_28401":126199,"_3085":126338},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3634":74770,"_31209":74718,"_21628":126340,"_5":14884,"_28401":126199,"_3085":126341},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3634":74771,"_31209":74718,"_21628":126343,"_5":14884,"_28401":126203,"_3085":126344},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3634":74772,"_31209":74718,"_21628":126346,"_5":14884,"_28401":126203,"_3085":126347},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3634":74773,"_31209":74718,"_21628":126349,"_5":14884,"_28401":126207,"_3085":126350},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3634":74774,"_31209":74718,"_21628":126352,"_5":14884,"_28401":126207,"_3085":126353},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3634":74775,"_31209":74718,"_21628":126355,"_5":14884,"_28401":126207,"_3085":126356},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3634":74776,"_31209":74718,"_21628":126358,"_5":14884,"_28401":126207,"_3085":126359},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3634":74777,"_31209":74718,"_21628":126361,"_5":14884,"_28401":126211,"_3085":126362},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3634":74778,"_31209":74718,"_21628":126364,"_5":14884,"_28401":126215,"_3085":126365},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3634":74779,"_31209":74718,"_21628":126367,"_5":14884,"_28401":126215,"_3085":126368},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3634":74780,"_31209":74718,"_21628":126370,"_5":14884,"_28401":126219,"_3085":126371},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3634":74781,"_31209":74718,"_21628":126373,"_5":14884,"_28401":126223,"_3085":126374},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3634":74782,"_31209":74718,"_21628":126376,"_5":14884,"_28401":126223,"_3085":126377},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3634":74783,"_31209":74718,"_21628":126379,"_5":14884,"_28401":126223,"_3085":126380},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3634":74784,"_31209":74718,"_21628":126382,"_5":14884,"_28401":126227,"_3085":126383},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3634":74785,"_31209":74718,"_21628":126385,"_5":14884,"_28401":126227,"_3085":126386},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3634":74786,"_31209":74718,"_21628":126388,"_5":14884,"_28401":126227,"_3085":126389},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3634":74787,"_31209":74718,"_21628":126391,"_5":14884,"_28401":126227,"_3085":126392},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3634":74788,"_31209":74718,"_21628":126394,"_5":14884,"_28401":126231,"_3085":126395},[],"Abre una CA desde el inventario para consultar:",{"_3634":74789,"_31209":74718,"_21628":126397,"_5":14884,"_28401":126231,"_3085":126398},[],"Estado y periodo de validez.",{"_3634":74790,"_31209":74718,"_21628":126400,"_5":14884,"_28401":126231,"_3085":126401},[],"Certificado y cadena en formato PEM.",{"_3634":74791,"_31209":74718,"_21628":126403,"_5":14884,"_28401":126231,"_3085":126404},[],"Número de certificados activos, expirados y revocados.",{"_3634":74792,"_31209":74718,"_21628":126406,"_5":14884,"_28401":126231,"_3085":126407},[],"Certificados emitidos en **Issued Certificates**.",{"_3634":74793,"_31209":74718,"_21628":126409,"_5":14884,"_28401":126231,"_3085":126410},[],"CRL vinculada a la autoridad.",{"_3634":74794,"_31209":74718,"_21628":126412,"_5":14884,"_28401":126231,"_3085":126413},[],"Metadatos y motor criptográfico asociado.",{"_3634":74795,"_31209":74718,"_21628":126415,"_5":14884,"_28401":126231,"_3085":126416},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3634":74796,"_31209":74718,"_21628":126418,"_5":14884,"_28401":126235,"_3085":126419},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3634":74797,"_31209":74718,"_21628":126421,"_5":14884,"_28401":126235,"_3085":126422},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3634":74798,"_31209":74718,"_21628":126424,"_5":14884,"_28401":126235,"_3085":126425},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3634":74799,"_31209":74718,"_21628":126427,"_5":14884,"_28401":126235,"_3085":126428},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3634":74800,"_31209":74718,"_21628":126430,"_5":14884,"_28401":126235,"_3085":126431},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3634":74801,"_31209":74718,"_21628":126433,"_5":14884,"_28401":126235,"_3085":126434},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3634":74802,"_31209":74718,"_21628":126436,"_5":14884,"_28401":126239,"_3085":126437},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3634":74803,"_31209":74718,"_21628":126439,"_5":14884,"_28401":126243,"_3085":126440},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3634":74804,"_31209":74718,"_21628":126442,"_5":14884,"_28401":126247,"_3085":126443},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3634":74805,"_31209":74718,"_21628":126445,"_5":14884,"_28401":126251,"_3085":126446},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3634":74806,"_31209":74718,"_21628":126448,"_5":14884,"_28401":126255,"_3085":126449},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3634":74807,"_31209":74718,"_21628":126451,"_5":14884,"_28401":126259,"_3085":126452},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3634":74808,"_31209":74718,"_21628":126454,"_5":14884,"_28401":126259,"_3085":126455},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3634":74809,"_31209":74718,"_21628":126457,"_5":14884,"_28401":126259,"_3085":126458},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3634":74810,"_31209":74718,"_21628":126460,"_5":14884,"_28401":126259,"_3085":126461},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3634":74811,"_31209":74718,"_21628":126463,"_5":14884,"_28401":126259,"_3085":126464},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3634":74812,"_31209":74812,"_5":15244,"_3085":126466,"_31547":126467,"_21628":126468,"_28401":74812},"Perfiles de certificado",[50999,121970,56691,125998],[],{"_3634":74813,"_31209":74812,"_21628":126470,"_5":14884,"_28401":74812,"_3085":126471},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3634":74814,"_31209":74812,"_5":31544,"_21628":126473,"_28401":126474,"_3085":126475},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3634":74815,"_31209":74812,"_5":31544,"_21628":126477,"_28401":126478,"_3085":126479},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3634":74816,"_31209":74812,"_5":31544,"_21628":126481,"_28401":126482,"_3085":126483},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3634":74817,"_31209":74812,"_5":31544,"_21628":126485,"_28401":126486,"_3085":126487},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3634":74818,"_31209":74812,"_5":31544,"_21628":126489,"_28401":126490,"_3085":126491},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3634":74819,"_31209":74812,"_5":31544,"_21628":126493,"_28401":126494,"_3085":126495},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3634":74820,"_31209":74812,"_5":31544,"_21628":126497,"_28401":126498,"_3085":126499},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3634":74821,"_31209":74812,"_5":31544,"_21628":126501,"_28401":126502,"_3085":126503},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3634":74822,"_31209":74812,"_5":31544,"_21628":126505,"_28401":126506,"_3085":126507},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3634":74823,"_31209":74812,"_5":31544,"_21628":126509,"_28401":126510,"_3085":126511},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3634":74824,"_31209":74812,"_5":31544,"_21628":126513,"_28401":126514,"_3085":126515},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3634":74825,"_31209":74812,"_5":31544,"_21628":126517,"_28401":126518,"_3085":126519},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3634":74826,"_31209":74812,"_5":31544,"_21628":126521,"_28401":126522,"_3085":126523},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3634":74827,"_31209":74812,"_5":31544,"_21628":126525,"_28401":126526,"_3085":126527},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3634":74828,"_31209":74812,"_5":31544,"_21628":126529,"_28401":126530,"_3085":126531},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3634":74829,"_31209":74812,"_5":31544,"_21628":126533,"_28401":126534,"_3085":126535},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3634":74830,"_31209":74812,"_21628":126537,"_5":14884,"_28401":74812,"_3085":126538},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3634":74831,"_31209":74812,"_21628":126540,"_5":14884,"_28401":74812,"_3085":126541},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3634":74832,"_31209":74812,"_21628":126543,"_5":14884,"_28401":126478,"_3085":126544},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3634":74833,"_31209":74812,"_21628":126546,"_5":14884,"_28401":126478,"_3085":126547},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3634":74834,"_31209":74812,"_21628":126549,"_5":14884,"_28401":126482,"_3085":126550},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3634":74835,"_31209":74812,"_21628":126552,"_5":14884,"_28401":126486,"_3085":126553},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3634":74836,"_31209":74812,"_21628":126555,"_5":14884,"_28401":126486,"_3085":126556},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3634":74837,"_31209":74812,"_21628":126558,"_5":14884,"_28401":126486,"_3085":126559},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3634":74838,"_31209":74812,"_21628":126561,"_5":14884,"_28401":126490,"_3085":126562},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3634":74839,"_31209":74812,"_21628":126564,"_5":14884,"_28401":126494,"_3085":126565},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3634":74840,"_31209":74812,"_21628":126567,"_5":14884,"_28401":126494,"_3085":126568},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3634":74841,"_31209":74812,"_21628":126570,"_5":14884,"_28401":126498,"_3085":126571},[],"La aplicación criptográfica puede:",{"_3634":74842,"_31209":74812,"_21628":126573,"_5":14884,"_28401":126498,"_3085":126574},[],"permitir o bloquear claves RSA;",{"_3634":74843,"_31209":74812,"_21628":126576,"_5":14884,"_28401":126498,"_3085":126577},[],"limitar los tamaños RSA admitidos;",{"_3634":74844,"_31209":74812,"_21628":126579,"_5":14884,"_28401":126498,"_3085":126580},[],"permitir o bloquear claves ECDSA;",{"_3634":74845,"_31209":74812,"_21628":126582,"_5":14884,"_28401":126498,"_3085":126583},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3634":74846,"_31209":74812,"_21628":126585,"_5":14884,"_28401":126498,"_3085":126586},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3634":74847,"_31209":74812,"_21628":126588,"_5":14884,"_28401":126502,"_3085":126589},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3634":74848,"_31209":74812,"_21628":126591,"_5":14884,"_28401":126502,"_3085":121730},[],{"_3634":74849,"_31209":74812,"_21628":126593,"_5":14884,"_28401":126502,"_3085":126594},[],"Primera opción",{"_3634":74850,"_31209":74812,"_21628":126596,"_5":14884,"_28401":126502,"_3085":126597},[],"Segunda opción",{"_3634":74851,"_31209":74812,"_21628":126599,"_5":14884,"_28401":126502,"_3085":126600},[],"Si no hay ninguna",{"_3634":74852,"_31209":74812,"_21628":126602,"_5":14884,"_28401":126502,"_3085":126603},[],"Firma directa con una CA",{"_3634":74853,"_31209":74812,"_21628":126605,"_5":14884,"_28401":126502,"_3085":126606},[],"`issuance_profile` incluido en la solicitud",{"_3634":74854,"_31209":74812,"_21628":126608,"_5":14884,"_28401":126502,"_3085":126609},[],"`issuance_profile_id` de la solicitud",{"_3634":74855,"_31209":74812,"_21628":126611,"_5":14884,"_28401":126502,"_3085":126612},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3634":74856,"_31209":74812,"_21628":126614,"_5":14884,"_28401":126502,"_3085":126615},[],"Emisión mediante DMS",{"_3634":74857,"_31209":74812,"_21628":126617,"_5":14884,"_28401":126502,"_3085":57312},[],{"_3634":74858,"_31209":74812,"_21628":126619,"_5":14884,"_28401":126502,"_3085":126620},[],"`settings.issuance_profile` incluido en el DMS",{"_3634":74859,"_31209":74812,"_21628":126622,"_5":14884,"_28401":126502,"_3085":126623},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3634":74860,"_31209":74812,"_21628":126625,"_5":14884,"_28401":126502,"_3085":126626},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3634":74861,"_31209":74812,"_21628":126628,"_5":14884,"_28401":126502,"_3085":126629},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3634":74862,"_31209":74812,"_21628":126631,"_5":14884,"_28401":126510,"_3085":126632},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3634":74863,"_31209":74812,"_21628":126634,"_5":14884,"_28401":126514,"_3085":126635},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3634":74864,"_31209":74812,"_21628":126637,"_5":14884,"_28401":126518,"_3085":126638},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3634":74865,"_31209":74812,"_21628":126640,"_5":14884,"_28401":126522,"_3085":126641},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3634":74866,"_31209":74812,"_21628":126643,"_5":14884,"_28401":126526,"_3085":126644},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3634":74867,"_31209":74812,"_21628":126646,"_5":14884,"_28401":126526,"_3085":126647},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3634":74868,"_31209":74812,"_21628":126649,"_5":14884,"_28401":126530,"_3085":126650},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3634":74869,"_31209":74812,"_21628":126652,"_5":14884,"_28401":126530,"_3085":126653},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3634":74870,"_31209":74812,"_21628":126655,"_5":14884,"_28401":126530,"_3085":126656},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3634":74871,"_31209":74812,"_21628":126658,"_5":14884,"_28401":126530,"_3085":126659},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3634":74872,"_31209":74812,"_21628":126661,"_5":14884,"_28401":126534,"_3085":126662},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3634":74873,"_31209":74812,"_21628":126664,"_5":14884,"_28401":126534,"_3085":126665},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3634":74874,"_31209":74874,"_5":15244,"_3085":126667,"_31547":126668,"_21628":126670,"_28401":74874},"Validación de certificados",[50999,121970,56691,126669],"Validación",[],{"_3634":74875,"_31209":74874,"_21628":126672,"_5":14884,"_28401":74874,"_3085":126673},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3634":74876,"_31209":74874,"_5":31544,"_21628":126675,"_28401":126676,"_3085":126677},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3634":74877,"_31209":74874,"_5":31544,"_21628":126679,"_28401":126680,"_3085":126681},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3634":74878,"_31209":74874,"_5":31544,"_21628":126683,"_28401":126684,"_3085":126685},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3634":74879,"_31209":74874,"_21628":126687,"_5":14884,"_28401":74874,"_3085":126688},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3634":74880,"_31209":74874,"_21628":126690,"_5":14884,"_28401":126676,"_3085":126691},[],"Verifica estos criterios juntos:",{"_3634":74881,"_31209":74874,"_21628":126693,"_5":14884,"_28401":126676,"_3085":125627},[],{"_3634":74882,"_31209":74874,"_21628":126695,"_5":14884,"_28401":126676,"_3085":126696},[],"Resultado necesario",{"_3634":74883,"_31209":74874,"_21628":126698,"_5":14884,"_28401":126676,"_3085":126699},[],"Cadena y firma",{"_3634":74884,"_31209":74874,"_21628":126701,"_5":14884,"_28401":126676,"_3085":126702},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3634":74885,"_31209":74874,"_21628":126704,"_5":14884,"_28401":126676,"_3085":126705},[],"Fechas",{"_3634":74886,"_31209":74874,"_21628":126707,"_5":14884,"_28401":126676,"_3085":126708},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3634":74887,"_31209":74874,"_21628":126710,"_5":14884,"_28401":126676,"_3085":121640},[],{"_3634":74888,"_31209":74874,"_21628":126712,"_5":14884,"_28401":126676,"_3085":126713},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3634":74889,"_31209":74874,"_21628":126715,"_5":14884,"_28401":126676,"_3085":126716},[],"Uso",{"_3634":74890,"_31209":74874,"_21628":126718,"_5":14884,"_28401":126676,"_3085":126719},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3634":74891,"_31209":74874,"_21628":126721,"_5":14884,"_28401":126676,"_3085":126722},[],"Revocación",{"_3634":74892,"_31209":74874,"_21628":126724,"_5":14884,"_28401":126676,"_3085":126725},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3634":74893,"_31209":74874,"_21628":126727,"_5":14884,"_28401":126676,"_3085":126728},[],"Autorización",{"_3634":74894,"_31209":74874,"_21628":126730,"_5":14884,"_28401":126676,"_3085":126731},[],"La aplicación permite la acción a esa identidad.",{"_3634":74895,"_31209":74874,"_21628":126733,"_5":14884,"_28401":126676,"_3085":126734},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3634":74896,"_31209":74874,"_21628":126736,"_5":14884,"_28401":126680,"_3085":126737},[],"Mecanismo",{"_3634":74897,"_31209":74874,"_21628":126739,"_5":14884,"_28401":126680,"_3085":126740},[],"Cuándo utilizarlo",{"_3634":74898,"_31209":74874,"_21628":126742,"_5":14884,"_28401":126680,"_3085":126743},[],"Qué debes mantener",{"_3634":74899,"_31209":74874,"_21628":126745,"_5":14884,"_28401":126680,"_3085":57440},[],{"_3634":74900,"_31209":74874,"_21628":126747,"_5":14884,"_28401":126680,"_3085":126748},[],"Consulta del estado de un certificado concreto.",{"_3634":74901,"_31209":74874,"_21628":126750,"_5":14884,"_28401":126680,"_3085":126751},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3634":74902,"_31209":74874,"_21628":126753,"_5":14884,"_28401":126680,"_3085":57449},[],{"_3634":74903,"_31209":74874,"_21628":126755,"_5":14884,"_28401":126680,"_3085":126756},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3634":74904,"_31209":74874,"_21628":126758,"_5":14884,"_28401":126680,"_3085":126759},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3634":74905,"_31209":74874,"_21628":126761,"_5":14884,"_28401":126680,"_3085":126762},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3634":74906,"_31209":74874,"_21628":126764,"_5":14884,"_28401":126680,"_3085":126765},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3634":74907,"_31209":74874,"_21628":126767,"_5":14884,"_28401":126684,"_3085":126768},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3634":74908,"_31209":74874,"_21628":126770,"_5":14884,"_28401":126684,"_3085":126771},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3634":74909,"_31209":74874,"_21628":126773,"_5":14884,"_28401":126684,"_3085":126774},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3634":74910,"_31209":74874,"_21628":126776,"_5":14884,"_28401":126684,"_3085":126777},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3634":74911,"_31209":74874,"_21628":126779,"_5":14884,"_28401":126684,"_3085":126780},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3634":74912,"_31209":74874,"_21628":126782,"_5":14884,"_28401":126684,"_3085":126783},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3634":74913,"_31209":74874,"_21628":126785,"_5":14884,"_28401":126684,"_3085":126786},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3634":74914,"_31209":74874,"_21628":126788,"_5":14884,"_28401":126684,"_3085":126789},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":74915,"_31209":74874,"_21628":126791,"_5":14884,"_28401":126684,"_3085":126792},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3634":74916,"_31209":74916,"_5":15244,"_3085":126794,"_31547":126795,"_21628":126796,"_28401":74916},"Certificados",[50999,121970,56691,125998],[],{"_3634":74917,"_31209":74916,"_21628":126798,"_5":14884,"_28401":74916,"_3085":126799},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3634":74918,"_31209":74916,"_5":31544,"_21628":126801,"_28401":126802,"_3085":126803},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3634":74919,"_31209":74916,"_5":31544,"_21628":126805,"_28401":126806,"_3085":126807},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3634":74920,"_31209":74916,"_5":31544,"_21628":126809,"_28401":126810,"_3085":126811},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3634":74921,"_31209":74916,"_5":31544,"_21628":126813,"_28401":126814,"_3085":126815},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3634":74922,"_31209":74916,"_5":31544,"_21628":126817,"_28401":126818,"_3085":126819},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3634":74923,"_31209":74916,"_5":31544,"_21628":126821,"_28401":126822,"_3085":126823},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3634":74924,"_31209":74916,"_5":31544,"_21628":126825,"_28401":126826,"_3085":126827},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3634":74925,"_31209":74916,"_5":31544,"_21628":126829,"_28401":126830,"_3085":126831},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3634":74926,"_31209":74916,"_5":31544,"_21628":126833,"_28401":126834,"_3085":126835},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3634":74927,"_31209":74916,"_21628":126837,"_5":14884,"_28401":74916,"_3085":126838},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3634":74928,"_31209":74916,"_21628":126840,"_5":14884,"_28401":126802,"_3085":126841},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3634":74929,"_31209":74916,"_21628":126843,"_5":14884,"_28401":126802,"_3085":126844},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3634":74930,"_31209":74916,"_21628":126846,"_5":14884,"_28401":126802,"_3085":126847},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3634":74931,"_31209":74916,"_21628":126849,"_5":14884,"_28401":126802,"_3085":126850},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3634":74932,"_31209":74916,"_21628":126852,"_5":14884,"_28401":126802,"_3085":126853},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3634":74933,"_31209":74916,"_21628":126855,"_5":14884,"_28401":126802,"_3085":126856},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3634":74934,"_31209":74916,"_21628":126858,"_5":14884,"_28401":126802,"_3085":126859},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3634":74935,"_31209":74916,"_21628":126861,"_5":14884,"_28401":126806,"_3085":126862},[],"Descarga el PEM e inspecciónalo:",{"_3634":74936,"_31209":74916,"_21628":126864,"_5":14884,"_28401":126806,"_3085":126865},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3634":74937,"_31209":74916,"_21628":126867,"_5":14884,"_28401":126810,"_3085":126868},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3634":74938,"_31209":74916,"_21628":126870,"_5":14884,"_28401":126810,"_3085":126871},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3634":74939,"_31209":74916,"_21628":126873,"_5":14884,"_28401":126810,"_3085":126874},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3634":74940,"_31209":74916,"_21628":126876,"_5":14884,"_28401":126810,"_3085":126877},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3634":74941,"_31209":74916,"_21628":126879,"_5":14884,"_28401":126810,"_3085":126880},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3634":74942,"_31209":74916,"_21628":126882,"_5":14884,"_28401":126810,"_3085":126883},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3634":74943,"_31209":74916,"_21628":126885,"_5":14884,"_28401":126810,"_3085":126886},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3634":74944,"_31209":74916,"_21628":126888,"_5":14884,"_28401":126814,"_3085":126889},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3634":74945,"_31209":74916,"_21628":126891,"_5":14884,"_28401":126818,"_3085":126892},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3634":74946,"_31209":74916,"_21628":126894,"_5":14884,"_28401":126822,"_3085":126895},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3634":74947,"_31209":74916,"_21628":126897,"_5":14884,"_28401":126826,"_3085":126898},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3634":74948,"_31209":74916,"_21628":126900,"_5":14884,"_28401":126826,"_3085":126901},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3634":74949,"_31209":74916,"_21628":126903,"_5":14884,"_28401":126826,"_3085":126904},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3634":74950,"_31209":74916,"_21628":126906,"_5":14884,"_28401":126830,"_3085":126907},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3634":74951,"_31209":74916,"_21628":126909,"_5":14884,"_28401":126830,"_3085":126910},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3634":74952,"_31209":74916,"_21628":126912,"_5":14884,"_28401":126830,"_3085":126913},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3634":74953,"_31209":74916,"_21628":126915,"_5":14884,"_28401":126834,"_3085":126916},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":74954,"_31209":74916,"_21628":126918,"_5":14884,"_28401":126834,"_3085":126919},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3634":74955,"_31209":74955,"_5":15244,"_3085":126921,"_31547":126922,"_21628":126924,"_28401":74955},"Ciclo de vida de un certificado",[50999,121970,56691,126923],"Conceptos",[],{"_3634":74956,"_31209":74955,"_21628":126926,"_5":14884,"_28401":74955,"_3085":126927},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3634":74957,"_31209":74955,"_5":31544,"_21628":126929,"_28401":126930,"_3085":126931},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3634":74958,"_31209":74955,"_5":31544,"_21628":126933,"_28401":126934,"_3085":126935},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3634":74959,"_31209":74955,"_5":31544,"_21628":126937,"_28401":126938,"_3085":126939},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3634":74960,"_31209":74955,"_5":31544,"_21628":126941,"_28401":126942,"_3085":126943},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3634":74961,"_31209":74955,"_5":31544,"_21628":126945,"_28401":126946,"_3085":126947},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3634":74962,"_31209":74955,"_5":31544,"_21628":126949,"_28401":126950,"_3085":126951},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3634":74963,"_31209":74955,"_5":31544,"_21628":126953,"_28401":126954,"_3085":124621},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3634":74964,"_31209":74955,"_5":31544,"_21628":126956,"_28401":126957,"_3085":126958},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3634":74965,"_31209":74955,"_5":31544,"_21628":126960,"_28401":126961,"_3085":126962},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3634":74966,"_31209":74955,"_5":31544,"_21628":126964,"_28401":126965,"_3085":126966},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3634":74967,"_31209":74955,"_21628":126968,"_5":14884,"_28401":74955,"_3085":126969},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3634":74968,"_31209":74955,"_21628":126971,"_5":14884,"_28401":126934,"_3085":126972},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3634":74969,"_31209":74955,"_21628":126974,"_5":14884,"_28401":126938,"_3085":126975},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3634":74970,"_31209":74955,"_21628":126977,"_5":14884,"_28401":126942,"_3085":126978},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3634":74971,"_31209":74955,"_21628":126980,"_5":14884,"_28401":126946,"_3085":126981},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3634":74972,"_31209":74955,"_21628":126983,"_5":14884,"_28401":126950,"_3085":126984},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3634":74973,"_31209":74955,"_21628":126986,"_5":14884,"_28401":126954,"_3085":126987},[],"Lamassu persiste cuatro estados X.509:",{"_3634":74974,"_31209":74955,"_21628":126989,"_5":14884,"_28401":126954,"_3085":126990},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3634":74975,"_31209":74955,"_21628":126992,"_5":14884,"_28401":126954,"_3085":126993},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3634":74976,"_31209":74955,"_21628":126995,"_5":14884,"_28401":126954,"_3085":126996},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3634":74977,"_31209":74955,"_21628":126998,"_5":14884,"_28401":126954,"_3085":126999},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3634":74978,"_31209":74955,"_21628":127001,"_5":14884,"_28401":126954,"_3085":127002},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3634":74979,"_31209":74955,"_21628":127004,"_5":14884,"_28401":126957,"_3085":127005},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3634":74980,"_31209":74955,"_21628":127007,"_5":14884,"_28401":126957,"_3085":127008},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3634":74981,"_31209":74955,"_21628":127010,"_5":14884,"_28401":126957,"_3085":127011},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3634":74982,"_31209":74955,"_21628":127013,"_5":14884,"_28401":126961,"_3085":127014},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3634":74983,"_31209":74955,"_21628":127016,"_5":14884,"_28401":126961,"_3085":127017},[],"Antes de confirmar:",{"_3634":74984,"_31209":74955,"_21628":127019,"_5":14884,"_28401":126961,"_3085":127020},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3634":74985,"_31209":74955,"_21628":127022,"_5":14884,"_28401":126961,"_3085":127023},[],"Distribuye la nueva cadena de confianza.",{"_3634":74986,"_31209":74955,"_21628":127025,"_5":14884,"_28401":126961,"_3085":127026},[],"Reemite las identidades necesarias.",{"_3634":74987,"_31209":74955,"_21628":127028,"_5":14884,"_28401":126961,"_3085":127029},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3634":74988,"_31209":74955,"_21628":127031,"_5":14884,"_28401":126961,"_3085":127032},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3634":74989,"_31209":74955,"_21628":127034,"_5":14884,"_28401":126961,"_3085":127035},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3634":74990,"_31209":74955,"_21628":127037,"_5":14884,"_28401":126965,"_3085":127038},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3634":74991,"_31209":74955,"_21628":127040,"_5":14884,"_28401":126965,"_3085":127041},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3634":74992,"_31209":74955,"_21628":127043,"_5":14884,"_28401":126965,"_3085":127044},[],"Cambios de estado y razones de revocación.",{"_3634":74993,"_31209":74955,"_21628":127046,"_5":14884,"_28401":126965,"_3085":127047},[],"Publicación y vigencia de OCSP y CRLs.",{"_3634":74994,"_31209":74955,"_21628":127049,"_5":14884,"_28401":126965,"_3085":127050},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3634":74995,"_31209":74955,"_21628":127052,"_5":14884,"_28401":126965,"_3085":127053},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3634":74996,"_31209":74996,"_5":15244,"_3085":127055,"_31547":127056,"_21628":127057,"_28401":74996},"Modelo de confianza",[50999,121970,56691,126923],[],{"_3634":74997,"_31209":74996,"_21628":127059,"_5":14884,"_28401":74996,"_3085":127060},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3634":74998,"_31209":74996,"_5":31544,"_21628":127062,"_28401":127063,"_3085":127064},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3634":74999,"_31209":74996,"_5":31544,"_21628":127066,"_28401":127067,"_3085":127068},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3634":75000,"_31209":74996,"_5":31544,"_21628":127070,"_28401":127071,"_3085":127072},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3634":75001,"_31209":74996,"_5":31544,"_21628":127074,"_28401":127075,"_3085":127076},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3634":75002,"_31209":74996,"_5":31544,"_21628":127078,"_28401":127079,"_3085":127080},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3634":75003,"_31209":74996,"_5":31544,"_21628":127082,"_28401":127083,"_3085":127084},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3634":75004,"_31209":74996,"_5":31544,"_21628":127086,"_28401":127087,"_3085":127088},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3634":75005,"_31209":74996,"_5":31544,"_21628":127090,"_28401":127091,"_3085":127092},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3634":75006,"_31209":74996,"_5":31544,"_21628":127094,"_28401":127095,"_3085":127096},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3634":75007,"_31209":74996,"_5":31544,"_21628":127098,"_28401":127099,"_3085":127100},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3634":75008,"_31209":74996,"_21628":127102,"_5":14884,"_28401":74996,"_3085":127103},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3634":75009,"_31209":74996,"_21628":127105,"_5":14884,"_28401":127067,"_3085":127106},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3634":75010,"_31209":74996,"_21628":127108,"_5":14884,"_28401":127071,"_3085":127109},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3634":75011,"_31209":74996,"_21628":127111,"_5":14884,"_28401":127075,"_3085":127112},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3634":75012,"_31209":74996,"_21628":127114,"_5":14884,"_28401":127079,"_3085":127115},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3634":75013,"_31209":74996,"_21628":127117,"_5":14884,"_28401":127083,"_3085":127118},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3634":75014,"_31209":74996,"_21628":127120,"_5":14884,"_28401":127083,"_3085":127121},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3634":75015,"_31209":74996,"_21628":127123,"_5":14884,"_28401":127083,"_3085":127124},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3634":75016,"_31209":74996,"_21628":127126,"_5":14884,"_28401":127083,"_3085":127127},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3634":75017,"_31209":74996,"_21628":127129,"_5":14884,"_28401":127083,"_3085":127130},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3634":75018,"_31209":74996,"_21628":127132,"_5":14884,"_28401":127083,"_3085":127133},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3634":75019,"_31209":74996,"_21628":127135,"_5":14884,"_28401":127087,"_3085":127136},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3634":75020,"_31209":74996,"_21628":127138,"_5":14884,"_28401":127087,"_3085":127139},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3634":75021,"_31209":74996,"_21628":127141,"_5":14884,"_28401":127087,"_3085":127142},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3634":75022,"_31209":74996,"_21628":127144,"_5":14884,"_28401":127087,"_3085":127145},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3634":75023,"_31209":74996,"_21628":127147,"_5":14884,"_28401":127087,"_3085":127148},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3634":75024,"_31209":74996,"_21628":127150,"_5":14884,"_28401":127091,"_3085":127151},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3634":75025,"_31209":74996,"_21628":127153,"_5":14884,"_28401":127091,"_3085":127154},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3634":75026,"_31209":74996,"_21628":127156,"_5":14884,"_28401":127091,"_3085":127157},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3634":75027,"_31209":74996,"_21628":127159,"_5":14884,"_28401":127091,"_3085":127160},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3634":75028,"_31209":74996,"_21628":127162,"_5":14884,"_28401":127091,"_3085":127163},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3634":75029,"_31209":74996,"_21628":127165,"_5":14884,"_28401":127091,"_3085":127166},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3634":75030,"_31209":74996,"_21628":127168,"_5":14884,"_28401":127091,"_3085":127169},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3634":75031,"_31209":74996,"_21628":127171,"_5":14884,"_28401":127095,"_3085":127172},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3634":75032,"_31209":74996,"_21628":127174,"_5":14884,"_28401":127099,"_3085":127175},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3634":75033,"_31209":74996,"_21628":127177,"_5":14884,"_28401":127099,"_3085":127178},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3634":75034,"_31209":74996,"_21628":127180,"_5":14884,"_28401":127099,"_3085":127181},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3634":75035,"_31209":74996,"_21628":127183,"_5":14884,"_28401":127099,"_3085":127184},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3634":75036,"_31209":74996,"_21628":127186,"_5":14884,"_28401":127099,"_3085":127187},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3634":75037,"_31209":74996,"_21628":127189,"_5":14884,"_28401":127099,"_3085":127190},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3634":75038,"_31209":74996,"_21628":127192,"_5":14884,"_28401":127099,"_3085":127193},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3634":75039,"_31209":75039,"_5":15244,"_3085":127195,"_31547":127196,"_21628":127197,"_28401":75039},"Listas de revocación (CRL)",[50999,121970,56691,126669],[],{"_3634":75040,"_31209":75039,"_21628":127199,"_5":14884,"_28401":75039,"_3085":127200},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3634":75041,"_31209":75039,"_5":31544,"_21628":127202,"_28401":127203,"_3085":127204},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3634":75042,"_31209":75039,"_5":31544,"_21628":127206,"_28401":127207,"_3085":127208},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3634":75043,"_31209":75039,"_5":31544,"_21628":127210,"_28401":127211,"_3085":127212},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3634":75044,"_31209":75039,"_5":31544,"_21628":127214,"_28401":127215,"_3085":127216},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3634":75045,"_31209":75039,"_5":31544,"_21628":127218,"_28401":127219,"_3085":127220},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3634":75046,"_31209":75039,"_5":31544,"_21628":127222,"_28401":127223,"_3085":127224},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3634":75047,"_31209":75039,"_5":31544,"_21628":127226,"_28401":127227,"_3085":127228},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3634":75048,"_31209":75039,"_5":31544,"_21628":127230,"_28401":127231,"_3085":127232},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3634":75049,"_31209":75039,"_21628":127234,"_5":14884,"_28401":75039,"_3085":127235},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3634":75050,"_31209":75039,"_21628":127237,"_5":14884,"_28401":127203,"_3085":127238},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3634":75051,"_31209":75039,"_21628":127240,"_5":14884,"_28401":127203,"_3085":127241},[],"Campo",{"_3634":75052,"_31209":75039,"_21628":127243,"_5":14884,"_28401":127203,"_3085":123662},[],{"_3634":75053,"_31209":75039,"_21628":127245,"_5":14884,"_28401":127203,"_3085":52631},[],{"_3634":75054,"_31209":75039,"_21628":127247,"_5":14884,"_28401":127203,"_3085":127248},[],"ID de la CA a la que pertenecen los ajustes.",{"_3634":75055,"_31209":75039,"_21628":127250,"_5":14884,"_28401":127203,"_3085":57948},[],{"_3634":75056,"_31209":75039,"_21628":127252,"_5":14884,"_28401":127203,"_3085":127253},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3634":75057,"_31209":75039,"_21628":127255,"_5":14884,"_28401":127203,"_3085":57954},[],{"_3634":75058,"_31209":75039,"_21628":127257,"_5":14884,"_28401":127203,"_3085":127258},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3634":75059,"_31209":75039,"_21628":127260,"_5":14884,"_28401":127203,"_3085":57960},[],{"_3634":75060,"_31209":75039,"_21628":127262,"_5":14884,"_28401":127203,"_3085":127263},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3634":75061,"_31209":75039,"_21628":127265,"_5":14884,"_28401":127203,"_3085":127266},[],"Campo de `crl_options`",{"_3634":75062,"_31209":75039,"_21628":127268,"_5":14884,"_28401":127203,"_3085":123662},[],{"_3634":75063,"_31209":75039,"_21628":127270,"_5":14884,"_28401":127203,"_3085":127271},[],"Valor inicial",{"_3634":75064,"_31209":75039,"_21628":127273,"_5":14884,"_28401":127203,"_3085":57974},[],{"_3634":75065,"_31209":75039,"_21628":127275,"_5":14884,"_28401":127203,"_3085":127276},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3634":75066,"_31209":75039,"_21628":127278,"_5":14884,"_28401":127203,"_3085":127279},[],"7 días.",{"_3634":75067,"_31209":75039,"_21628":127281,"_5":14884,"_28401":127203,"_3085":57983},[],{"_3634":75068,"_31209":75039,"_21628":127283,"_5":14884,"_28401":127203,"_3085":127284},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3634":75069,"_31209":75039,"_21628":127286,"_5":14884,"_28401":127203,"_3085":127287},[],"6 días y 23 horas.",{"_3634":75070,"_31209":75039,"_21628":127289,"_5":14884,"_28401":127203,"_3085":57992},[],{"_3634":75071,"_31209":75039,"_21628":127291,"_5":14884,"_28401":127203,"_3085":127292},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3634":75072,"_31209":75039,"_21628":127294,"_5":14884,"_28401":127203,"_3085":57998},[],{"_3634":75073,"_31209":75039,"_21628":127296,"_5":14884,"_28401":127203,"_3085":58001},[],{"_3634":75074,"_31209":75039,"_21628":127298,"_5":14884,"_28401":127203,"_3085":127299},[],"Número de serie del certificado existente que firma la CRL.",{"_3634":75075,"_31209":75039,"_21628":127301,"_5":14884,"_28401":127203,"_3085":127302},[],"Número de serie del certificado actual de la CA.",{"_3634":75076,"_31209":75039,"_21628":127304,"_5":14884,"_28401":127203,"_3085":127305},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3634":75077,"_31209":75039,"_21628":127307,"_5":14884,"_28401":127203,"_3085":127308},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3634":75078,"_31209":75039,"_21628":127310,"_5":14884,"_28401":127203,"_3085":127311},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3634":75079,"_31209":75039,"_21628":127313,"_5":14884,"_28401":127203,"_3085":127314},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3634":75080,"_31209":75039,"_21628":127316,"_5":14884,"_28401":127203,"_3085":127317},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3634":75081,"_31209":75039,"_21628":127319,"_5":14884,"_28401":127203,"_3085":127320},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3634":75082,"_31209":75039,"_21628":127322,"_5":14884,"_28401":127203,"_3085":127323},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3634":75083,"_31209":75039,"_21628":127325,"_5":14884,"_28401":127203,"_3085":127326},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3634":75084,"_31209":75039,"_21628":127328,"_5":14884,"_28401":127203,"_3085":127329},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3634":75085,"_31209":75039,"_21628":127331,"_5":14884,"_28401":127203,"_3085":127332},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3634":75086,"_31209":75039,"_21628":127334,"_5":14884,"_28401":127203,"_3085":127335},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3634":75087,"_31209":75039,"_21628":127337,"_5":14884,"_28401":127207,"_3085":127338},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3634":75088,"_31209":75039,"_21628":127340,"_5":14884,"_28401":127207,"_3085":127341},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3634":75089,"_31209":75039,"_21628":127343,"_5":14884,"_28401":127207,"_3085":127344},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3634":75090,"_31209":75039,"_21628":127346,"_5":14884,"_28401":127207,"_3085":127347},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3634":75091,"_31209":75039,"_21628":127349,"_5":14884,"_28401":127211,"_3085":127350},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3634":75092,"_31209":75039,"_21628":127352,"_5":14884,"_28401":127211,"_3085":127353},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3634":75093,"_31209":75039,"_21628":127355,"_5":14884,"_28401":127211,"_3085":127356},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3634":75094,"_31209":75039,"_21628":127358,"_5":14884,"_28401":127211,"_3085":127359},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3634":75095,"_31209":75039,"_21628":127361,"_5":14884,"_28401":127211,"_3085":127362},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3634":75096,"_31209":75039,"_21628":127364,"_5":14884,"_28401":127211,"_3085":127365},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3634":75097,"_31209":75039,"_21628":127367,"_5":14884,"_28401":127211,"_3085":127368},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3634":75098,"_31209":75039,"_21628":127370,"_5":14884,"_28401":127211,"_3085":127371},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3634":75099,"_31209":75039,"_21628":127373,"_5":14884,"_28401":127211,"_3085":127374},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3634":75100,"_31209":75039,"_21628":127376,"_5":14884,"_28401":127215,"_3085":127377},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3634":75101,"_31209":75039,"_21628":127379,"_5":14884,"_28401":127215,"_3085":127380},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3634":75102,"_31209":75039,"_21628":127382,"_5":14884,"_28401":127219,"_3085":127383},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3634":75103,"_31209":75039,"_21628":127385,"_5":14884,"_28401":127219,"_3085":127386},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3634":75104,"_31209":75039,"_21628":127388,"_5":14884,"_28401":127219,"_3085":127389},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3634":75105,"_31209":75039,"_21628":127391,"_5":14884,"_28401":127219,"_3085":127392},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3634":75106,"_31209":75039,"_21628":127394,"_5":14884,"_28401":127219,"_3085":127395},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3634":75107,"_31209":75039,"_21628":127397,"_5":14884,"_28401":127223,"_3085":127398},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3634":75108,"_31209":75039,"_21628":127400,"_5":14884,"_28401":127223,"_3085":123851},[],{"_3634":75109,"_31209":75039,"_21628":127402,"_5":14884,"_28401":127223,"_3085":127403},[],"Path relativo",{"_3634":75110,"_31209":75039,"_21628":127405,"_5":14884,"_28401":127223,"_3085":121730},[],{"_3634":75111,"_31209":75039,"_21628":127407,"_5":14884,"_28401":127223,"_3085":58113},[],{"_3634":75112,"_31209":75039,"_21628":127409,"_5":14884,"_28401":127223,"_3085":58116},[],{"_3634":75113,"_31209":75039,"_21628":127411,"_5":14884,"_28401":127223,"_3085":127412},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3634":75114,"_31209":75039,"_21628":127414,"_5":14884,"_28401":127223,"_3085":58113},[],{"_3634":75115,"_31209":75039,"_21628":127416,"_5":14884,"_28401":127223,"_3085":58124},[],{"_3634":75116,"_31209":75039,"_21628":127418,"_5":14884,"_28401":127223,"_3085":127419},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3634":75117,"_31209":75039,"_21628":127421,"_5":14884,"_28401":127223,"_3085":58130},[],{"_3634":75118,"_31209":75039,"_21628":127423,"_5":14884,"_28401":127223,"_3085":58124},[],{"_3634":75119,"_31209":75039,"_21628":127425,"_5":14884,"_28401":127223,"_3085":127426},[],"Sustituir la configuración de CRL de una CA.",{"_3634":75120,"_31209":75039,"_21628":127428,"_5":14884,"_28401":127223,"_3085":58138},[],{"_3634":75121,"_31209":75039,"_21628":127430,"_5":14884,"_28401":127223,"_3085":58124},[],{"_3634":75122,"_31209":75039,"_21628":127432,"_5":14884,"_28401":127223,"_3085":127433},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3634":75123,"_31209":75039,"_21628":127435,"_5":14884,"_28401":127223,"_3085":127436},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3634":75124,"_31209":75039,"_21628":127438,"_5":14884,"_28401":127223,"_3085":127439},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3634":75125,"_31209":75039,"_21628":127441,"_5":14884,"_28401":127223,"_3085":127442},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3634":75126,"_31209":75039,"_21628":127444,"_5":14884,"_28401":127227,"_3085":127445},[],"Síntoma",{"_3634":75127,"_31209":75039,"_21628":127447,"_5":14884,"_28401":127227,"_3085":127448},[],"Causa",{"_3634":75128,"_31209":75039,"_21628":127450,"_5":14884,"_28401":127227,"_3085":127451},[],"Acción",{"_3634":75129,"_31209":75039,"_21628":127453,"_5":14884,"_28401":127227,"_3085":127454},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3634":75130,"_31209":75039,"_21628":127456,"_5":14884,"_28401":127227,"_3085":127457},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3634":75131,"_31209":75039,"_21628":127459,"_5":14884,"_28401":127227,"_3085":127460},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3634":75132,"_31209":75039,"_21628":127462,"_5":14884,"_28401":127227,"_3085":127463},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3634":75133,"_31209":75039,"_21628":127465,"_5":14884,"_28401":127227,"_3085":127466},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3634":75134,"_31209":75039,"_21628":127468,"_5":14884,"_28401":127227,"_3085":127469},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3634":75135,"_31209":75039,"_21628":127471,"_5":14884,"_28401":127227,"_3085":127472},[],"`PUT` devuelve 400.",{"_3634":75136,"_31209":75039,"_21628":127474,"_5":14884,"_28401":127227,"_3085":127475},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3634":75137,"_31209":75039,"_21628":127477,"_5":14884,"_28401":127227,"_3085":127478},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3634":75138,"_31209":75039,"_21628":127480,"_5":14884,"_28401":127227,"_3085":127481},[],"`PUT` devuelve 404.",{"_3634":75139,"_31209":75039,"_21628":127483,"_5":14884,"_28401":127227,"_3085":127484},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3634":75140,"_31209":75039,"_21628":127486,"_5":14884,"_28401":127227,"_3085":127487},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3634":75141,"_31209":75039,"_21628":127489,"_5":14884,"_28401":127227,"_3085":127490},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3634":75142,"_31209":75039,"_21628":127492,"_5":14884,"_28401":127227,"_3085":127493},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3634":75143,"_31209":75039,"_21628":127495,"_5":14884,"_28401":127227,"_3085":127496},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3634":75144,"_31209":75039,"_21628":127498,"_5":14884,"_28401":127227,"_3085":127499},[],"La CRL no cambia tras revocar un certificado.",{"_3634":75145,"_31209":75039,"_21628":127501,"_5":14884,"_28401":127227,"_3085":127502},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3634":75146,"_31209":75039,"_21628":127504,"_5":14884,"_28401":127227,"_3085":127505},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3634":75147,"_31209":75039,"_21628":127507,"_5":14884,"_28401":127227,"_3085":127508},[],"Un verificador rechaza la CRL por el emisor.",{"_3634":75148,"_31209":75039,"_21628":127510,"_5":14884,"_28401":127227,"_3085":127511},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3634":75149,"_31209":75039,"_21628":127513,"_5":14884,"_28401":127227,"_3085":127514},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3634":75150,"_31209":75039,"_21628":127516,"_5":14884,"_28401":127231,"_3085":127517},[],"RFC 5280: perfil X.509 y CRL.",{"_3634":75151,"_31209":75039,"_21628":127519,"_5":14884,"_28401":127231,"_3085":58230},[],{"_3634":75152,"_31209":75039,"_21628":127521,"_5":14884,"_28401":127231,"_3085":58233},[],{"_3634":75153,"_31209":75039,"_21628":127523,"_5":14884,"_28401":127231,"_3085":127524},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":75154,"_31209":75039,"_21628":127526,"_5":14884,"_28401":127231,"_3085":127527},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3634":75155,"_31209":75155,"_5":15244,"_3085":127529,"_31547":127530,"_21628":127531,"_28401":75155},"Claves y motores criptográficos",[50999,121970,56691,125998],[],{"_3634":75156,"_31209":75155,"_21628":127533,"_5":14884,"_28401":75155,"_3085":127534},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3634":75157,"_31209":75155,"_5":31544,"_21628":127536,"_28401":127537,"_3085":127538},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3634":75158,"_31209":75155,"_5":31544,"_21628":127540,"_28401":127541,"_3085":127542},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3634":75159,"_31209":75155,"_5":31544,"_21628":127544,"_28401":127545,"_3085":58258},[],"/docs/es/platform/pki/key-management#file-system",{"_3634":75160,"_31209":75155,"_5":31544,"_21628":127547,"_28401":127548,"_3085":58262},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3634":75161,"_31209":75155,"_5":31544,"_21628":127550,"_28401":127551,"_3085":58266},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3634":75162,"_31209":75155,"_5":31544,"_21628":127553,"_28401":127554,"_3085":58270},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3634":75163,"_31209":75155,"_5":31544,"_21628":127556,"_28401":127557,"_3085":58274},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3634":75164,"_31209":75155,"_5":31544,"_21628":127559,"_28401":127560,"_3085":58278},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3634":75165,"_31209":75155,"_5":31544,"_21628":127562,"_28401":127563,"_3085":127564},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3634":75166,"_31209":75155,"_5":31544,"_21628":127566,"_28401":127567,"_3085":127568},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3634":75167,"_31209":75155,"_5":31544,"_21628":127570,"_28401":127571,"_3085":127572},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3634":75168,"_31209":75155,"_5":31544,"_21628":127574,"_28401":127575,"_3085":127576},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3634":75169,"_31209":75155,"_5":31544,"_21628":127578,"_28401":127579,"_3085":127580},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3634":75170,"_31209":75155,"_5":31544,"_21628":127582,"_28401":127583,"_3085":127584},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3634":75171,"_31209":75155,"_5":31544,"_21628":127586,"_28401":127587,"_3085":127588},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3634":75172,"_31209":75155,"_5":31544,"_21628":127590,"_28401":127591,"_3085":58310},[],"/docs/es/platform/pki/key-management#sign",{"_3634":75173,"_31209":75155,"_5":31544,"_21628":127593,"_28401":127594,"_3085":58314},[],"/docs/es/platform/pki/key-management#verify",{"_3634":75174,"_31209":75155,"_5":31544,"_21628":127596,"_28401":127597,"_3085":127598},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3634":75175,"_31209":75155,"_5":31544,"_21628":127600,"_28401":127601,"_3085":127602},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3634":75176,"_31209":75155,"_5":31544,"_21628":127604,"_28401":127605,"_3085":127606},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3634":75177,"_31209":75155,"_21628":127608,"_5":14884,"_28401":75155,"_3085":127609},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3634":75178,"_31209":75155,"_21628":127611,"_5":14884,"_28401":75155,"_3085":127612},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3634":75179,"_31209":75155,"_21628":127614,"_5":14884,"_28401":127537,"_3085":127615},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3634":75180,"_31209":75155,"_21628":127617,"_5":14884,"_28401":127537,"_3085":127618},[],"En la práctica, permite:",{"_3634":75181,"_31209":75155,"_21628":127620,"_5":14884,"_28401":127537,"_3085":127621},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3634":75182,"_31209":75155,"_21628":127623,"_5":14884,"_28401":127537,"_3085":127624},[],"Importar claves creadas externamente.",{"_3634":75183,"_31209":75155,"_21628":127626,"_5":14884,"_28401":127537,"_3085":127627},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3634":75184,"_31209":75155,"_21628":127629,"_5":14884,"_28401":127537,"_3085":127630},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3634":75185,"_31209":75155,"_21628":127632,"_5":14884,"_28401":127541,"_3085":127633},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3634":75186,"_31209":75155,"_21628":127635,"_5":14884,"_28401":127541,"_3085":127636},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3634":75187,"_31209":75155,"_21628":127638,"_5":14884,"_28401":127541,"_3085":127639},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3634":75188,"_31209":75155,"_21628":127641,"_5":14884,"_28401":127545,"_3085":127642},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3634":75189,"_31209":75155,"_21628":127644,"_5":14884,"_28401":127548,"_3085":127645},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3634":75190,"_31209":75155,"_21628":127647,"_5":14884,"_28401":127548,"_3085":127648},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3634":75191,"_31209":75155,"_21628":127650,"_5":14884,"_28401":127551,"_3085":127651},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3634":75192,"_31209":75155,"_21628":127653,"_5":14884,"_28401":127554,"_3085":127654},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3634":75193,"_31209":75155,"_21628":127656,"_5":14884,"_28401":127557,"_3085":127657},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3634":75194,"_31209":75155,"_21628":127659,"_5":14884,"_28401":127560,"_3085":127660},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3634":75195,"_31209":75155,"_21628":127662,"_5":14884,"_28401":127560,"_3085":127663},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3634":75196,"_31209":75155,"_21628":127665,"_5":14884,"_28401":127560,"_3085":127666},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3634":75197,"_31209":75155,"_21628":127668,"_5":14884,"_28401":127560,"_3085":127669},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3634":75198,"_31209":75155,"_21628":127671,"_5":14884,"_28401":127563,"_3085":127672},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3634":75199,"_31209":75155,"_21628":127674,"_5":14884,"_28401":127563,"_3085":127675},[],"La tabla incluye los siguientes campos:",{"_3634":75200,"_31209":75155,"_21628":127677,"_5":14884,"_28401":127563,"_3085":127678},[],"**Name**: nombre descriptivo de la clave.",{"_3634":75201,"_31209":75155,"_21628":127680,"_5":14884,"_28401":127563,"_3085":127681},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3634":75202,"_31209":75155,"_21628":127683,"_5":14884,"_28401":127563,"_3085":127684},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3634":75203,"_31209":75155,"_21628":127686,"_5":14884,"_28401":127563,"_3085":127687},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3634":75204,"_31209":75155,"_21628":127689,"_5":14884,"_28401":127563,"_3085":127690},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3634":75205,"_31209":75155,"_21628":127692,"_5":14884,"_28401":127563,"_3085":127693},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3634":75206,"_31209":75155,"_21628":127695,"_5":14884,"_28401":127563,"_3085":127696},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3634":75207,"_31209":75155,"_21628":127698,"_5":14884,"_28401":127563,"_3085":127699},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3634":75208,"_31209":75155,"_21628":127701,"_5":14884,"_28401":127563,"_3085":127702},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3634":75209,"_31209":75155,"_21628":127704,"_5":14884,"_28401":127563,"_3085":127705},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3634":75210,"_31209":75155,"_21628":127707,"_5":14884,"_28401":127563,"_3085":127708},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3634":75211,"_31209":75155,"_21628":127710,"_5":14884,"_28401":127563,"_3085":127711},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3634":75212,"_31209":75155,"_21628":127713,"_5":14884,"_28401":127563,"_3085":127714},[],"**Delete Key** para eliminar la clave del sistema.",{"_3634":75213,"_31209":75155,"_21628":127716,"_5":14884,"_28401":127567,"_3085":127717},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3634":75214,"_31209":75155,"_21628":127719,"_5":14884,"_28401":127571,"_3085":127720},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3634":75215,"_31209":75155,"_21628":127722,"_5":14884,"_28401":127571,"_3085":127723},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3634":75216,"_31209":75155,"_21628":127725,"_5":14884,"_28401":127571,"_3085":127726},[],"**Key Name**: nombre único y descriptivo.",{"_3634":75217,"_31209":75155,"_21628":127728,"_5":14884,"_28401":127571,"_3085":127729},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3634":75218,"_31209":75155,"_21628":127731,"_5":14884,"_28401":127571,"_3085":127732},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3634":75219,"_31209":75155,"_21628":127734,"_5":14884,"_28401":127571,"_3085":127735},[],"**Tags**: metadatos para clasificar la clave.",{"_3634":75220,"_31209":75155,"_21628":127737,"_5":14884,"_28401":127571,"_3085":127738},[],"**Metadata**: información adicional para usos avanzados.",{"_3634":75221,"_31209":75155,"_21628":127740,"_5":14884,"_28401":127575,"_3085":127741},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3634":75222,"_31209":75155,"_21628":127743,"_5":14884,"_28401":127575,"_3085":127744},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3634":75223,"_31209":75155,"_21628":127746,"_5":14884,"_28401":127575,"_3085":127747},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3634":75224,"_31209":75155,"_21628":127749,"_5":14884,"_28401":127575,"_3085":127750},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3634":75225,"_31209":75155,"_21628":127752,"_5":14884,"_28401":127575,"_3085":127753},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3634":75226,"_31209":75155,"_21628":127755,"_5":14884,"_28401":127575,"_3085":127756},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3634":75227,"_31209":75155,"_21628":127758,"_5":14884,"_28401":127575,"_3085":127759},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3634":75228,"_31209":75155,"_21628":127761,"_5":14884,"_28401":127575,"_3085":127762},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3634":75229,"_31209":75155,"_21628":127764,"_5":14884,"_28401":127575,"_3085":127765},[],"**Metadata**: información adicional opcional.",{"_3634":75230,"_31209":75155,"_21628":127767,"_5":14884,"_28401":127575,"_3085":127768},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3634":75231,"_31209":75155,"_21628":127770,"_5":14884,"_28401":127575,"_3085":127771},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3634":75232,"_31209":75155,"_21628":127773,"_5":14884,"_28401":127579,"_3085":127774},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3634":75233,"_31209":75155,"_21628":127776,"_5":14884,"_28401":127583,"_3085":127777},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3634":75234,"_31209":75155,"_21628":127779,"_5":14884,"_28401":127583,"_3085":127780},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3634":75235,"_31209":75155,"_21628":127782,"_5":14884,"_28401":127583,"_3085":127783},[],"**Key Name**: nombre descriptivo.",{"_3634":75236,"_31209":75155,"_21628":127785,"_5":14884,"_28401":127583,"_3085":127786},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3634":75237,"_31209":75155,"_21628":127788,"_5":14884,"_28401":127583,"_3085":127789},[],"**Tags**: etiquetas asociadas.",{"_3634":75238,"_31209":75155,"_21628":127791,"_5":14884,"_28401":127583,"_3085":127792},[],"**Aliases**: nombres alternativos.",{"_3634":75239,"_31209":75155,"_21628":127794,"_5":14884,"_28401":127583,"_3085":127795},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3634":75240,"_31209":75155,"_21628":127797,"_5":14884,"_28401":127583,"_3085":127798},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3634":75241,"_31209":75155,"_21628":127800,"_5":14884,"_28401":127583,"_3085":127801},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3634":75242,"_31209":75155,"_21628":127803,"_5":14884,"_28401":127583,"_3085":127804},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3634":75243,"_31209":75155,"_21628":127806,"_5":14884,"_28401":127587,"_3085":127807},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3634":75244,"_31209":75155,"_21628":127809,"_5":14884,"_28401":127587,"_3085":127810},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3634":75245,"_31209":75155,"_21628":127812,"_5":14884,"_28401":127587,"_3085":127813},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3634":75246,"_31209":75155,"_21628":127815,"_5":14884,"_28401":127591,"_3085":127816},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3634":75247,"_31209":75155,"_21628":127818,"_5":14884,"_28401":127591,"_3085":127819},[],"Campos principales:",{"_3634":75248,"_31209":75155,"_21628":127821,"_5":14884,"_28401":127591,"_3085":127822},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3634":75249,"_31209":75155,"_21628":127824,"_5":14884,"_28401":127591,"_3085":127825},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3634":75250,"_31209":75155,"_21628":127827,"_5":14884,"_28401":127591,"_3085":127828},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3634":75251,"_31209":75155,"_21628":127830,"_5":14884,"_28401":127591,"_3085":127831},[],"**Message**: contenido que se va a firmar.",{"_3634":75252,"_31209":75155,"_21628":127833,"_5":14884,"_28401":127591,"_3085":127834},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3634":75253,"_31209":75155,"_21628":127836,"_5":14884,"_28401":127594,"_3085":127837},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3634":75254,"_31209":75155,"_21628":127839,"_5":14884,"_28401":127594,"_3085":127819},[],{"_3634":75255,"_31209":75155,"_21628":127841,"_5":14884,"_28401":127594,"_3085":127842},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3634":75256,"_31209":75155,"_21628":127844,"_5":14884,"_28401":127594,"_3085":127845},[],"**Message Type**: `Raw` o `Digest`.",{"_3634":75257,"_31209":75155,"_21628":127847,"_5":14884,"_28401":127594,"_3085":127848},[],"**Payload Encoding**: codificación del mensaje.",{"_3634":75258,"_31209":75155,"_21628":127850,"_5":14884,"_28401":127594,"_3085":127851},[],"**Message**: mensaje original o hash.",{"_3634":75259,"_31209":75155,"_21628":127853,"_5":14884,"_28401":127594,"_3085":127854},[],"**Signature**: firma que se desea comprobar.",{"_3634":75260,"_31209":75155,"_21628":127856,"_5":14884,"_28401":127594,"_3085":127857},[],"**Result**: indicador del resultado de la validación.",{"_3634":75261,"_31209":75155,"_21628":127859,"_5":14884,"_28401":127597,"_3085":127860},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3634":75262,"_31209":75155,"_21628":127862,"_5":14884,"_28401":127597,"_3085":127863},[],"Este flujo es útil para:",{"_3634":75263,"_31209":75155,"_21628":127865,"_5":14884,"_28401":127597,"_3085":127866},[],"Solicitar certificados a una CA externa.",{"_3634":75264,"_31209":75155,"_21628":127868,"_5":14884,"_28401":127597,"_3085":127869},[],"Renovar una identidad manteniendo la misma clave.",{"_3634":75265,"_31209":75155,"_21628":127871,"_5":14884,"_28401":127597,"_3085":127872},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3634":75266,"_31209":75155,"_21628":127874,"_5":14884,"_28401":127597,"_3085":127875},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3634":75267,"_31209":75155,"_21628":127877,"_5":14884,"_28401":127597,"_3085":127878},[],"**Organization (O)**: organización o empresa.",{"_3634":75268,"_31209":75155,"_21628":127880,"_5":14884,"_28401":127597,"_3085":127881},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3634":75269,"_31209":75155,"_21628":127883,"_5":14884,"_28401":127597,"_3085":127884},[],"**Country (C)**: código de país de dos letras.",{"_3634":75270,"_31209":75155,"_21628":127886,"_5":14884,"_28401":127597,"_3085":127887},[],"**State / Province (ST)**: estado o provincia.",{"_3634":75271,"_31209":75155,"_21628":127889,"_5":14884,"_28401":127597,"_3085":127890},[],"**Locality (L)**: ciudad o localidad.",{"_3634":75272,"_31209":75155,"_21628":127892,"_5":14884,"_28401":127597,"_3085":127893},[],"**Email Address**: correo de contacto.",{"_3634":75273,"_31209":75155,"_21628":127895,"_5":14884,"_28401":127597,"_3085":127896},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3634":75274,"_31209":75155,"_21628":127898,"_5":14884,"_28401":127597,"_3085":127899},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3634":75275,"_31209":75155,"_21628":127901,"_5":14884,"_28401":127601,"_3085":127902},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3634":75276,"_31209":75155,"_21628":127904,"_5":14884,"_28401":127601,"_3085":127905},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3634":75277,"_31209":75155,"_21628":127907,"_5":14884,"_28401":127605,"_3085":127908},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3634":75278,"_31209":75155,"_21628":127910,"_5":14884,"_28401":127605,"_3085":127911},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3634":75279,"_31209":75279,"_5":15244,"_3085":127913,"_31547":127914,"_21628":127915,"_28401":75279},"Validación online con OCSP",[50999,121970,56691,126669],[],{"_3634":75280,"_31209":75279,"_21628":127917,"_5":14884,"_28401":75279,"_3085":127918},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3634":75281,"_31209":75279,"_5":31544,"_21628":127920,"_28401":127921,"_3085":127922},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3634":75282,"_31209":75279,"_5":31544,"_21628":127924,"_28401":127925,"_3085":127926},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3634":75283,"_31209":75279,"_5":31544,"_21628":127928,"_28401":127929,"_3085":127930},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3634":75284,"_31209":75279,"_5":31544,"_21628":127932,"_28401":127933,"_3085":127934},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3634":75285,"_31209":75279,"_5":31544,"_21628":127936,"_28401":127937,"_3085":127938},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3634":75286,"_31209":75279,"_5":31544,"_21628":127940,"_28401":127941,"_3085":127232},[],"/docs/es/platform/pki/ocsp#referencias",{"_3634":75287,"_31209":75279,"_21628":127943,"_5":14884,"_28401":75279,"_3085":127944},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3634":75288,"_31209":75279,"_21628":127946,"_5":14884,"_28401":127921,"_3085":127947},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3634":75289,"_31209":75279,"_21628":127949,"_5":14884,"_28401":127921,"_3085":127950},[],"Estado del registro",{"_3634":75290,"_31209":75279,"_21628":127952,"_5":14884,"_28401":127921,"_3085":127953},[],"Respuesta firmada",{"_3634":75291,"_31209":75279,"_21628":127955,"_5":14884,"_28401":127921,"_3085":55828},[],{"_3634":75292,"_31209":75279,"_21628":127957,"_5":14884,"_28401":127921,"_3085":58678},[],{"_3634":75293,"_31209":75279,"_21628":127959,"_5":14884,"_28401":127921,"_3085":55845},[],{"_3634":75294,"_31209":75279,"_21628":127961,"_5":14884,"_28401":127921,"_3085":127962},[],"`Revoked`, con razón y fecha de revocación.",{"_3634":75295,"_31209":75279,"_21628":127964,"_5":14884,"_28401":127921,"_3085":127965},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3634":75296,"_31209":75279,"_21628":127967,"_5":14884,"_28401":127921,"_3085":127968},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3634":75297,"_31209":75279,"_21628":127970,"_5":14884,"_28401":127921,"_3085":127971},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3634":75298,"_31209":75279,"_21628":127973,"_5":14884,"_28401":127921,"_3085":127974},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3634":75299,"_31209":75279,"_21628":127976,"_5":14884,"_28401":127921,"_3085":127977},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3634":75300,"_31209":75279,"_21628":127979,"_5":14884,"_28401":127925,"_3085":127980},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3634":75301,"_31209":75279,"_21628":127982,"_5":14884,"_28401":127925,"_3085":127983},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3634":75302,"_31209":75279,"_21628":127985,"_5":14884,"_28401":127929,"_3085":127986},[],"El servicio acepta:",{"_3634":75303,"_31209":75279,"_21628":127988,"_5":14884,"_28401":127929,"_3085":123851},[],{"_3634":75304,"_31209":75279,"_21628":127990,"_5":14884,"_28401":127929,"_3085":127991},[],"Ruta del servicio VA",{"_3634":75305,"_31209":75279,"_21628":127993,"_5":14884,"_28401":127929,"_3085":127994},[],"Formato",{"_3634":75306,"_31209":75279,"_21628":127996,"_5":14884,"_28401":127929,"_3085":58718},[],{"_3634":75307,"_31209":75279,"_21628":127998,"_5":14884,"_28401":127929,"_3085":58721},[],{"_3634":75308,"_31209":75279,"_21628":128000,"_5":14884,"_28401":127929,"_3085":128001},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3634":75309,"_31209":75279,"_21628":128003,"_5":14884,"_28401":127929,"_3085":58113},[],{"_3634":75310,"_31209":75279,"_21628":128005,"_5":14884,"_28401":127929,"_3085":58729},[],{"_3634":75311,"_31209":75279,"_21628":128007,"_5":14884,"_28401":127929,"_3085":128008},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3634":75312,"_31209":75279,"_21628":128010,"_5":14884,"_28401":127929,"_3085":128011},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3634":75313,"_31209":75279,"_21628":128013,"_5":14884,"_28401":127933,"_3085":128014},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3634":75314,"_31209":75279,"_21628":128016,"_5":14884,"_28401":127933,"_3085":128017},[],"Genera la solicitud:",{"_3634":75315,"_31209":75279,"_21628":128019,"_5":14884,"_28401":127933,"_3085":128020},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3634":75316,"_31209":75279,"_21628":128022,"_5":14884,"_28401":127933,"_3085":128023},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3634":75317,"_31209":75279,"_21628":128025,"_5":14884,"_28401":127933,"_3085":128026},[],"Verifica el DER recibido:",{"_3634":75318,"_31209":75279,"_21628":128028,"_5":14884,"_28401":127933,"_3085":128029},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3634":75319,"_31209":75279,"_21628":128031,"_5":14884,"_28401":127937,"_3085":128032},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3634":75320,"_31209":75279,"_21628":128034,"_5":14884,"_28401":127937,"_3085":128035},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3634":75321,"_31209":75279,"_21628":128037,"_5":14884,"_28401":127941,"_3085":58762},[],{"_3634":75322,"_31209":75279,"_21628":128039,"_5":14884,"_28401":127941,"_3085":58765},[],{"_3634":75323,"_31209":75279,"_21628":128041,"_5":14884,"_28401":127941,"_3085":128042},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3634":75324,"_31209":75279,"_21628":128044,"_5":14884,"_28401":127941,"_3085":127527},[],{"_3634":75325,"_31209":75325,"_5":15244,"_3085":56691,"_31547":128046,"_21628":128047,"_28401":75325},[50999,121970,56691],[],{"_3634":75326,"_31209":75325,"_21628":128049,"_5":14884,"_28401":75325,"_3085":128050},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3634":75327,"_31209":75325,"_5":31544,"_21628":128052,"_28401":128053,"_3085":125324},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3634":75328,"_31209":75325,"_5":31544,"_21628":128055,"_28401":128056,"_3085":128057},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3634":75329,"_31209":75325,"_5":31544,"_21628":128059,"_28401":128060,"_3085":125844},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3634":75330,"_31209":75325,"_5":31544,"_21628":128062,"_28401":128063,"_3085":125848},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3634":75331,"_31209":75325,"_5":31544,"_21628":128065,"_28401":128066,"_3085":125852},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3634":75332,"_31209":75325,"_5":31544,"_21628":128068,"_28401":128069,"_3085":125856},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3634":75333,"_31209":75325,"_5":31544,"_21628":128071,"_28401":128072,"_3085":125864},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3634":75334,"_31209":75325,"_5":31544,"_21628":128074,"_28401":128075,"_3085":128076},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3634":75335,"_31209":75325,"_5":31544,"_21628":128078,"_28401":128079,"_3085":126835},[],"/docs/es/platform/pki/overview#continúa",{"_3634":75336,"_31209":75325,"_21628":128081,"_5":14884,"_28401":75325,"_3085":128082},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3634":75337,"_31209":75325,"_21628":128084,"_5":14884,"_28401":128053,"_3085":128085},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3634":75338,"_31209":75325,"_21628":128087,"_5":14884,"_28401":128053,"_3085":128088},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3634":75339,"_31209":75325,"_21628":128090,"_5":14884,"_28401":128056,"_3085":128091},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3634":75340,"_31209":75325,"_21628":128093,"_5":14884,"_28401":128056,"_3085":128094},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3634":75341,"_31209":75325,"_21628":128096,"_5":14884,"_28401":128056,"_3085":128097},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3634":75342,"_31209":75325,"_21628":128099,"_5":14884,"_28401":128056,"_3085":128100},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3634":75343,"_31209":75325,"_21628":128102,"_5":14884,"_28401":128056,"_3085":128103},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3634":75344,"_31209":75325,"_21628":128105,"_5":14884,"_28401":128063,"_3085":128106},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3634":75345,"_31209":75325,"_21628":128108,"_5":14884,"_28401":128066,"_3085":128109},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3634":75346,"_31209":75325,"_21628":128111,"_5":14884,"_28401":128069,"_3085":128112},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3634":75347,"_31209":75325,"_21628":128114,"_5":14884,"_28401":128072,"_3085":128115},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3634":75348,"_31209":75325,"_21628":128117,"_5":14884,"_28401":128075,"_3085":128118},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3634":75349,"_31209":75325,"_21628":128120,"_5":14884,"_28401":128075,"_3085":128121},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3634":75350,"_31209":75325,"_21628":128123,"_5":14884,"_28401":128075,"_3085":128124},[],"su clave pública corresponda a la clave privada del cliente;",{"_3634":75351,"_31209":75325,"_21628":128126,"_5":14884,"_28401":128075,"_3085":128127},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3634":75352,"_31209":75325,"_21628":128129,"_5":14884,"_28401":128075,"_3085":128130},[],"sus fechas y usos permitan la operación;",{"_3634":75353,"_31209":75325,"_21628":128132,"_5":14884,"_28401":128075,"_3085":128133},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3634":75354,"_31209":75325,"_21628":128135,"_5":14884,"_28401":128075,"_3085":128136},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3634":75355,"_31209":75325,"_21628":128138,"_5":14884,"_28401":128079,"_3085":128139},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3634":75356,"_31209":75325,"_21628":128141,"_5":14884,"_28401":128079,"_3085":128142},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3634":75357,"_31209":75325,"_21628":128144,"_5":14884,"_28401":128079,"_3085":128145},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3634":75358,"_31209":75358,"_5":15244,"_3085":128147,"_31547":128148,"_21628":128149,"_28401":75358},"Crea tu primera CA",[50999,121970,56691,125448],[],{"_3634":75359,"_31209":75358,"_21628":128151,"_5":14884,"_28401":75358,"_3085":128152},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3634":75360,"_31209":75358,"_5":31544,"_21628":128154,"_28401":128155,"_3085":120504},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3634":75361,"_31209":75358,"_5":31544,"_21628":128157,"_28401":128158,"_3085":128159},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3634":75362,"_31209":75358,"_5":31544,"_21628":128161,"_28401":128162,"_3085":128163},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3634":75363,"_31209":75358,"_5":31544,"_21628":128165,"_28401":128166,"_3085":128167},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3634":75364,"_31209":75358,"_5":31544,"_21628":128169,"_28401":128170,"_3085":128171},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3634":75365,"_31209":75358,"_5":31544,"_21628":128173,"_28401":128174,"_3085":128175},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3634":75366,"_31209":75358,"_5":31544,"_21628":128177,"_28401":128178,"_3085":128179},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3634":75367,"_31209":75358,"_5":31544,"_21628":128181,"_28401":128182,"_3085":125695},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3634":75368,"_31209":75358,"_5":31544,"_21628":128184,"_28401":128185,"_3085":120528},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3634":75369,"_31209":75358,"_21628":128187,"_5":14884,"_28401":75358,"_3085":128188},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3634":75370,"_31209":75358,"_21628":128190,"_5":14884,"_28401":128155,"_3085":128191},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3634":75371,"_31209":75358,"_21628":128193,"_5":14884,"_28401":128155,"_3085":128194},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3634":75372,"_31209":75358,"_21628":128196,"_5":14884,"_28401":128155,"_3085":128197},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3634":75373,"_31209":75358,"_21628":128199,"_5":14884,"_28401":128155,"_3085":128200},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3634":75374,"_31209":75358,"_21628":128202,"_5":14884,"_28401":128158,"_3085":128203},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3634":75375,"_31209":75358,"_21628":128205,"_5":14884,"_28401":128158,"_3085":128206},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3634":75376,"_31209":75358,"_21628":128208,"_5":14884,"_28401":128162,"_3085":128209},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3634":75377,"_31209":75358,"_21628":128211,"_5":14884,"_28401":128162,"_3085":128212},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3634":75378,"_31209":75358,"_21628":128214,"_5":14884,"_28401":128166,"_3085":128215},[],"Selecciona **Root CA** y completa:",{"_3634":75379,"_31209":75358,"_21628":128217,"_5":14884,"_28401":128166,"_3085":58944},[],{"_3634":75380,"_31209":75358,"_21628":128219,"_5":14884,"_28401":128166,"_3085":128220},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3634":75381,"_31209":75358,"_21628":128222,"_5":14884,"_28401":128166,"_3085":128223},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3634":75382,"_31209":75358,"_21628":128225,"_5":14884,"_28401":128166,"_3085":128226},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3634":75383,"_31209":75358,"_21628":128228,"_5":14884,"_28401":128166,"_3085":128229},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3634":75384,"_31209":75358,"_21628":128231,"_5":14884,"_28401":128170,"_3085":128232},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3634":75385,"_31209":75358,"_21628":128234,"_5":14884,"_28401":128174,"_3085":128235},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3634":75386,"_31209":75358,"_21628":128237,"_5":14884,"_28401":128174,"_3085":128238},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3634":75387,"_31209":75358,"_21628":128240,"_5":14884,"_28401":128178,"_3085":128241},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3634":75388,"_31209":75358,"_21628":128243,"_5":14884,"_28401":128178,"_3085":128244},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3634":75389,"_31209":75358,"_21628":128246,"_5":14884,"_28401":128178,"_3085":128247},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3634":75390,"_31209":75358,"_21628":128249,"_5":14884,"_28401":128182,"_3085":128250},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3634":75391,"_31209":75358,"_21628":128252,"_5":14884,"_28401":128182,"_3085":128253},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3634":75392,"_31209":75358,"_21628":128255,"_5":14884,"_28401":128182,"_3085":128256},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3634":75393,"_31209":75358,"_21628":128258,"_5":14884,"_28401":128182,"_3085":128259},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3634":75394,"_31209":75358,"_21628":128261,"_5":14884,"_28401":128185,"_3085":128262},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3634":75395,"_31209":75395,"_5":15244,"_3085":128264,"_31547":128265,"_21628":128266,"_28401":75395},"Emite y verifica un certificado",[50999,121970,56691,125448],[],{"_3634":75396,"_31209":75395,"_21628":128268,"_5":14884,"_28401":75395,"_3085":128269},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3634":75397,"_31209":75395,"_5":31544,"_21628":128271,"_28401":128272,"_3085":120504},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3634":75398,"_31209":75395,"_5":31544,"_21628":128274,"_28401":128275,"_3085":128276},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3634":75399,"_31209":75395,"_5":31544,"_21628":128278,"_28401":128279,"_3085":128280},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3634":75400,"_31209":75395,"_5":31544,"_21628":128282,"_28401":128283,"_3085":128284},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3634":75401,"_31209":75395,"_5":31544,"_21628":128286,"_28401":128287,"_3085":128288},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3634":75402,"_31209":75395,"_5":31544,"_21628":128290,"_28401":128291,"_3085":128292},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3634":75403,"_31209":75395,"_5":31544,"_21628":128294,"_28401":128295,"_3085":128296},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3634":75404,"_31209":75395,"_5":31544,"_21628":128298,"_28401":128299,"_3085":128300},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3634":75405,"_31209":75395,"_5":31544,"_21628":128302,"_28401":128303,"_3085":128304},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3634":75406,"_31209":75395,"_5":31544,"_21628":128306,"_28401":128307,"_3085":128308},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3634":75407,"_31209":75395,"_5":31544,"_21628":128310,"_28401":128311,"_3085":125695},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3634":75408,"_31209":75395,"_5":31544,"_21628":128313,"_28401":128314,"_3085":120528},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3634":75409,"_31209":75395,"_21628":128316,"_5":14884,"_28401":75395,"_3085":128317},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3634":75410,"_31209":75395,"_21628":128319,"_5":14884,"_28401":128272,"_3085":128320},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3634":75411,"_31209":75395,"_21628":128322,"_5":14884,"_28401":128272,"_3085":128323},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3634":75412,"_31209":75395,"_21628":128325,"_5":14884,"_28401":128272,"_3085":128326},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3634":75413,"_31209":75395,"_21628":128328,"_5":14884,"_28401":128272,"_3085":128329},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3634":75414,"_31209":75395,"_21628":128331,"_5":14884,"_28401":128272,"_3085":128332},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3634":75415,"_31209":75395,"_21628":128334,"_5":14884,"_28401":128275,"_3085":128335},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3634":75416,"_31209":75395,"_21628":128337,"_5":14884,"_28401":128279,"_3085":128338},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3634":75417,"_31209":75395,"_21628":128340,"_5":14884,"_28401":128279,"_3085":128341},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3634":75418,"_31209":75395,"_21628":128343,"_5":14884,"_28401":128283,"_3085":128344},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3634":75419,"_31209":75395,"_21628":128346,"_5":14884,"_28401":128283,"_3085":128347},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3634":75420,"_31209":75395,"_21628":128349,"_5":14884,"_28401":128287,"_3085":128350},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3634":75421,"_31209":75395,"_21628":128352,"_5":14884,"_28401":128287,"_3085":128353},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3634":75422,"_31209":75395,"_21628":128355,"_5":14884,"_28401":128291,"_3085":128356},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3634":75423,"_31209":75395,"_21628":128358,"_5":14884,"_28401":128295,"_3085":128359},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3634":75424,"_31209":75395,"_21628":128361,"_5":14884,"_28401":128299,"_3085":128362},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3634":75425,"_31209":75395,"_21628":128364,"_5":14884,"_28401":128303,"_3085":128365},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3634":75426,"_31209":75395,"_21628":128367,"_5":14884,"_28401":128303,"_3085":128368},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3634":75427,"_31209":75395,"_21628":128370,"_5":14884,"_28401":128303,"_3085":128371},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3634":75428,"_31209":75395,"_21628":128373,"_5":14884,"_28401":128307,"_3085":128374},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3634":75429,"_31209":75395,"_21628":128376,"_5":14884,"_28401":128307,"_3085":128377},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3634":75430,"_31209":75395,"_21628":128379,"_5":14884,"_28401":128307,"_3085":128380},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3634":75431,"_31209":75395,"_21628":128382,"_5":14884,"_28401":128311,"_3085":125778},[],{"_3634":75432,"_31209":75395,"_21628":128384,"_5":14884,"_28401":128311,"_3085":124293},[],{"_3634":75433,"_31209":75395,"_21628":128386,"_5":14884,"_28401":128311,"_3085":128387},[],"La CA rechaza la emisión",{"_3634":75434,"_31209":75395,"_21628":128389,"_5":14884,"_28401":128311,"_3085":128390},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3634":75435,"_31209":75395,"_21628":128392,"_5":14884,"_28401":128311,"_3085":128393},[],"Sujeto o usos diferentes",{"_3634":75436,"_31209":75395,"_21628":128395,"_5":14884,"_28401":128311,"_3085":128396},[],"Perfil aplicado y valores solicitados.",{"_3634":75437,"_31209":75395,"_21628":128398,"_5":14884,"_28401":128311,"_3085":128399},[],"No se encuentra el emisor",{"_3634":75438,"_31209":75395,"_21628":128401,"_5":14884,"_28401":128311,"_3085":128402},[],"CA descargada y cadena intermedia necesaria.",{"_3634":75439,"_31209":75395,"_21628":128404,"_5":14884,"_28401":128311,"_3085":128405},[],"Falla la vigencia",{"_3634":75440,"_31209":75395,"_21628":128407,"_5":14884,"_28401":128311,"_3085":128408},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3634":75441,"_31209":75395,"_21628":128410,"_5":14884,"_28401":128311,"_3085":128411},[],"Los resúmenes de clave difieren",{"_3634":75442,"_31209":75395,"_21628":128413,"_5":14884,"_28401":128311,"_3085":128414},[],"Archivos de certificado y clave de la misma emisión.",{"_3634":75443,"_31209":75395,"_21628":128416,"_5":14884,"_28401":128311,"_3085":128417},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3634":75444,"_31209":75395,"_21628":128419,"_5":14884,"_28401":128314,"_3085":128420},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3634":75445,"_31209":75395,"_21628":128422,"_5":14884,"_28401":128314,"_3085":128423},[],"Gestionar certificados para inspección, estado y revocación.",{"_3634":75446,"_31209":75395,"_21628":128425,"_5":14884,"_28401":128314,"_3085":128426},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3634":75447,"_31209":75395,"_21628":128428,"_5":14884,"_28401":128314,"_3085":128429},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3634":75448,"_31209":75395,"_21628":128431,"_5":14884,"_28401":128314,"_3085":128432},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3634":75449,"_31209":75449,"_5":15244,"_3085":128434,"_31547":128435,"_21628":128436,"_28401":75449},"Primeros pasos de PKI",[50999,121970,56691,125448],[],{"_3634":75450,"_31209":75449,"_21628":128438,"_5":14884,"_28401":75449,"_3085":128439},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3634":75451,"_31209":75449,"_5":31544,"_21628":128441,"_28401":128442,"_3085":120504},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3634":75452,"_31209":75449,"_5":31544,"_21628":128444,"_28401":128445,"_3085":128446},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3634":75453,"_31209":75449,"_5":31544,"_21628":128448,"_28401":128449,"_3085":125630},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3634":75454,"_31209":75449,"_5":31544,"_21628":128451,"_28401":128452,"_3085":128453},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3634":75455,"_31209":75449,"_21628":128455,"_5":14884,"_28401":75449,"_3085":128456},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3634":75456,"_31209":75449,"_21628":128458,"_5":14884,"_28401":128442,"_3085":128459},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3634":75457,"_31209":75449,"_21628":128461,"_5":14884,"_28401":128442,"_3085":128462},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3634":75458,"_31209":75449,"_21628":128464,"_5":14884,"_28401":128442,"_3085":128465},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3634":75459,"_31209":75449,"_21628":128467,"_5":14884,"_28401":128442,"_3085":128468},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3634":75460,"_31209":75449,"_21628":128470,"_5":14884,"_28401":128442,"_3085":128471},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3634":75461,"_31209":75449,"_21628":128473,"_5":14884,"_28401":128445,"_3085":128474},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3634":75462,"_31209":75449,"_21628":128476,"_5":14884,"_28401":128445,"_3085":128477},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3634":75463,"_31209":75449,"_21628":128479,"_5":14884,"_28401":128445,"_3085":128480},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3634":75464,"_31209":75449,"_21628":128482,"_5":14884,"_28401":128445,"_3085":128483},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3634":75465,"_31209":75449,"_21628":128485,"_5":14884,"_28401":128449,"_3085":128486},[],"Archivo o recurso",{"_3634":75466,"_31209":75449,"_21628":128488,"_5":14884,"_28401":128449,"_3085":125627},[],{"_3634":75467,"_31209":75449,"_21628":128490,"_5":14884,"_28401":128449,"_3085":128491},[],"CA raíz activa y `ca.pem`",{"_3634":75468,"_31209":75449,"_21628":128493,"_5":14884,"_28401":128449,"_3085":128494},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3634":75469,"_31209":75449,"_21628":128496,"_5":14884,"_28401":128449,"_3085":128497},[],"Certificado final y `device.crt`",{"_3634":75470,"_31209":75449,"_21628":128499,"_5":14884,"_28401":128449,"_3085":128500},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3634":75471,"_31209":75449,"_21628":128502,"_5":14884,"_28401":128449,"_3085":128503},[],"Clave privada `device.key`",{"_3634":75472,"_31209":75449,"_21628":128505,"_5":14884,"_28401":128449,"_3085":128506},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3634":75473,"_31209":75449,"_21628":128508,"_5":14884,"_28401":128449,"_3085":128509},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3634":75474,"_31209":75449,"_21628":128511,"_5":14884,"_28401":128452,"_3085":128512},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3634":75475,"_31209":75449,"_21628":128514,"_5":14884,"_28401":128452,"_3085":128515},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3634":75476,"_31209":75449,"_21628":128517,"_5":14884,"_28401":128452,"_3085":128518},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3634":75477,"_31209":75477,"_5":15244,"_3085":128520,"_31547":128521,"_21628":128523,"_28401":75477},"Resolución de problemas PKI",[50999,121970,56691,128522],"Resolución de problemas",[],{"_3634":75478,"_31209":75477,"_21628":128525,"_5":14884,"_28401":75477,"_3085":128526},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3634":75479,"_31209":75477,"_5":31544,"_21628":128528,"_28401":128529,"_3085":128530},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3634":75480,"_31209":75477,"_5":31544,"_21628":128532,"_28401":128533,"_3085":128534},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3634":75481,"_31209":75477,"_5":31544,"_21628":128536,"_28401":128537,"_3085":128538},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3634":75482,"_31209":75477,"_21628":128540,"_5":14884,"_28401":75477,"_3085":128541},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3634":75483,"_31209":75477,"_21628":128543,"_5":14884,"_28401":75477,"_3085":128544},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3634":75484,"_31209":75477,"_21628":128546,"_5":14884,"_28401":128529,"_3085":125627},[],{"_3634":75485,"_31209":75477,"_21628":128548,"_5":14884,"_28401":128529,"_3085":124293},[],{"_3634":75486,"_31209":75477,"_21628":128550,"_5":14884,"_28401":128529,"_3085":120528},[],{"_3634":75487,"_31209":75477,"_21628":128552,"_5":14884,"_28401":128529,"_3085":55533},[],{"_3634":75488,"_31209":75477,"_21628":128554,"_5":14884,"_28401":128529,"_3085":128555},[],"Existe, está activa y sus fechas son utilizables.",{"_3634":75489,"_31209":75477,"_21628":128557,"_5":14884,"_28401":128529,"_3085":128558},[],"Autoridades.",{"_3634":75490,"_31209":75477,"_21628":128560,"_5":14884,"_28401":128529,"_3085":128561},[],"Clave",{"_3634":75491,"_31209":75477,"_21628":128563,"_5":14884,"_28401":128529,"_3085":128564},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3634":75492,"_31209":75477,"_21628":128566,"_5":14884,"_28401":128529,"_3085":128567},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3634":75493,"_31209":75477,"_21628":128569,"_5":14884,"_28401":128529,"_3085":59298},[],{"_3634":75494,"_31209":75477,"_21628":128571,"_5":14884,"_28401":128529,"_3085":128572},[],"PEM correcto y firma verificable.",{"_3634":75495,"_31209":75477,"_21628":128574,"_5":14884,"_28401":128529,"_3085":59304},[],{"_3634":75496,"_31209":75477,"_21628":128576,"_5":14884,"_28401":128529,"_3085":128577},[],"Perfil",{"_3634":75497,"_31209":75477,"_21628":128579,"_5":14884,"_28401":128529,"_3085":128580},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3634":75498,"_31209":75477,"_21628":128582,"_5":14884,"_28401":128529,"_3085":128583},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3634":75499,"_31209":75477,"_21628":128585,"_5":14884,"_28401":128529,"_3085":125778},[],{"_3634":75500,"_31209":75477,"_21628":128587,"_5":14884,"_28401":128529,"_3085":128588},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3634":75501,"_31209":75477,"_21628":128590,"_5":14884,"_28401":128529,"_3085":128591},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3634":75502,"_31209":75477,"_21628":128593,"_5":14884,"_28401":128529,"_3085":128594},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3634":75503,"_31209":75477,"_21628":128596,"_5":14884,"_28401":128529,"_3085":128597},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3634":75504,"_31209":75477,"_21628":128599,"_5":14884,"_28401":128529,"_3085":128600},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3634":75505,"_31209":75477,"_21628":128602,"_5":14884,"_28401":128533,"_3085":128603},[],"Revisa cada frontera por separado:",{"_3634":75506,"_31209":75477,"_21628":128605,"_5":14884,"_28401":128533,"_3085":128606},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3634":75507,"_31209":75477,"_21628":128608,"_5":14884,"_28401":128533,"_3085":128609},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3634":75508,"_31209":75477,"_21628":128611,"_5":14884,"_28401":128533,"_3085":128612},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3634":75509,"_31209":75477,"_21628":128614,"_5":14884,"_28401":128533,"_3085":128615},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3634":75510,"_31209":75477,"_21628":128617,"_5":14884,"_28401":128533,"_3085":128618},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3634":75511,"_31209":75477,"_21628":128620,"_5":14884,"_28401":128533,"_3085":128621},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3634":75512,"_31209":75477,"_21628":128623,"_5":14884,"_28401":128537,"_3085":128624},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3634":75513,"_31209":75477,"_21628":128626,"_5":14884,"_28401":128537,"_3085":128627},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3634":75514,"_31209":75514,"_5":15244,"_3085":128629,"_31547":128630,"_21628":128631,"_28401":75514},"Seguridad",[50999],[],{"_3634":75515,"_31209":75514,"_21628":128633,"_5":14884,"_28401":75514,"_3085":128634},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3634":75516,"_31209":75514,"_5":31544,"_21628":128636,"_28401":128637,"_3085":128638},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3634":75517,"_31209":75514,"_5":31544,"_21628":128640,"_28401":128641,"_3085":128642},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3634":75518,"_31209":75514,"_5":31544,"_21628":128644,"_28401":128645,"_3085":128646},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3634":75519,"_31209":75514,"_5":31544,"_21628":128648,"_28401":128649,"_3085":128650},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3634":75520,"_31209":75514,"_21628":128652,"_5":14884,"_28401":75514,"_3085":128653},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3634":75521,"_31209":75514,"_21628":128655,"_5":14884,"_28401":128637,"_3085":128656},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3634":75522,"_31209":75514,"_21628":128658,"_5":14884,"_28401":128637,"_3085":128659},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3634":75523,"_31209":75514,"_21628":128661,"_5":14884,"_28401":128637,"_3085":15523},[],{"_3634":75524,"_31209":75514,"_21628":128663,"_5":14884,"_28401":128637,"_3085":15452},[],{"_3634":75525,"_31209":75514,"_21628":128665,"_5":14884,"_28401":128637,"_3085":15510},[],{"_3634":75526,"_31209":75514,"_21628":128667,"_5":14884,"_28401":128637,"_3085":128668},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3634":75527,"_31209":75514,"_21628":128670,"_5":14884,"_28401":128637,"_3085":128671},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3634":75528,"_31209":75514,"_21628":128673,"_5":14884,"_28401":128641,"_3085":128674},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3634":75529,"_31209":75514,"_21628":128676,"_5":14884,"_28401":128641,"_3085":128677},[],"No incluyas en el reporte:",{"_3634":75530,"_31209":75514,"_21628":128679,"_5":14884,"_28401":128641,"_3085":128680},[],"Credenciales, tokens o claves privadas",{"_3634":75531,"_31209":75514,"_21628":128682,"_5":14884,"_28401":128641,"_3085":128683},[],"Datos de clientes o información identificable de clientes",{"_3634":75532,"_31209":75514,"_21628":128685,"_5":14884,"_28401":128641,"_3085":128686},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3634":75533,"_31209":75514,"_21628":128688,"_5":14884,"_28401":128645,"_3085":128689},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3634":75534,"_31209":75514,"_21628":128691,"_5":14884,"_28401":128645,"_3085":128692},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3634":75535,"_31209":75514,"_21628":128694,"_5":14884,"_28401":128649,"_3085":128695},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3634":75536,"_31209":75514,"_21628":128697,"_5":14884,"_28401":128649,"_3085":128698},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3634":75537,"_31209":75514,"_21628":128700,"_5":14884,"_28401":128649,"_3085":128701},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3634":75538,"_31209":75514,"_21628":128703,"_5":14884,"_28401":128649,"_3085":128704},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3634":75539,"_31209":75514,"_21628":128706,"_5":14884,"_28401":128649,"_3085":128707},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3634":75540,"_31209":75540,"_5":15244,"_3085":128709,"_31547":128710,"_21628":128712,"_28401":75540},"3.8.0 a 4.0.0",[50999,128711],"Actualizaciones",[],{"_3634":75541,"_31209":75540,"_21628":128714,"_5":14884,"_28401":75540,"_3085":128715},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3634":75542,"_31209":75540,"_5":31544,"_21628":128717,"_28401":128718,"_3085":128719},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3634":75543,"_31209":75540,"_5":31544,"_21628":128721,"_28401":128722,"_3085":128723},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3634":75544,"_31209":75540,"_5":31544,"_21628":128725,"_28401":128726,"_3085":128727},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3634":75545,"_31209":75540,"_5":31544,"_21628":128729,"_28401":128730,"_3085":128731},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3634":75546,"_31209":75540,"_5":31544,"_21628":128733,"_28401":128734,"_3085":128735},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3634":75547,"_31209":75540,"_5":31544,"_21628":128737,"_28401":128738,"_3085":128739},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3634":75548,"_31209":75540,"_5":31544,"_21628":128741,"_28401":128742,"_3085":59473},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3634":75549,"_31209":75540,"_5":31544,"_21628":128744,"_28401":128745,"_3085":128746},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3634":75550,"_31209":75540,"_5":31544,"_21628":128748,"_28401":128749,"_3085":128750},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3634":75551,"_31209":75540,"_5":31544,"_21628":128752,"_28401":128753,"_3085":128754},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3634":75552,"_31209":75540,"_5":31544,"_21628":128756,"_28401":128757,"_3085":121099},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3634":75553,"_31209":75540,"_5":31544,"_21628":128759,"_28401":128760,"_3085":128761},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3634":75554,"_31209":75540,"_5":31544,"_21628":128763,"_28401":128764,"_3085":128765},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3634":75555,"_31209":75540,"_5":31544,"_21628":128767,"_28401":128768,"_3085":128769},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3634":75556,"_31209":75540,"_5":31544,"_21628":128771,"_28401":128772,"_3085":128773},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3634":75557,"_31209":75540,"_5":31544,"_21628":128775,"_28401":128776,"_3085":128777},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3634":75558,"_31209":75540,"_5":31544,"_21628":128779,"_28401":128780,"_3085":128781},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3634":75559,"_31209":75540,"_5":31544,"_21628":128783,"_28401":128784,"_3085":128785},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3634":75560,"_31209":75540,"_5":31544,"_21628":128787,"_28401":128788,"_3085":128789},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3634":75561,"_31209":75540,"_5":31544,"_21628":128791,"_28401":128792,"_3085":128793},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3634":75562,"_31209":75540,"_5":31544,"_21628":128795,"_28401":128796,"_3085":128797},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3634":75563,"_31209":75540,"_5":31544,"_21628":128799,"_28401":128800,"_3085":128801},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3634":75564,"_31209":75540,"_5":31544,"_21628":128803,"_28401":128804,"_3085":128805},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3634":75565,"_31209":75540,"_5":31544,"_21628":128807,"_28401":128808,"_3085":128809},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3634":75566,"_31209":75540,"_5":31544,"_21628":128811,"_28401":128812,"_3085":128813},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3634":75567,"_31209":75540,"_5":31544,"_21628":128815,"_28401":128816,"_3085":128817},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3634":75568,"_31209":75540,"_5":31544,"_21628":128819,"_28401":128820,"_3085":128821},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3634":75569,"_31209":75540,"_5":31544,"_21628":128823,"_28401":128824,"_3085":128825},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3634":75570,"_31209":75540,"_5":31544,"_21628":128827,"_28401":128828,"_3085":128829},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3634":75571,"_31209":75540,"_5":31544,"_21628":128831,"_28401":128832,"_3085":128833},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3634":75572,"_31209":75540,"_5":31544,"_21628":128835,"_28401":128836,"_3085":128837},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3634":75573,"_31209":75540,"_5":31544,"_21628":128839,"_28401":128840,"_3085":128841},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3634":75574,"_31209":75540,"_5":31544,"_21628":128843,"_28401":128844,"_3085":128845},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3634":75575,"_31209":75540,"_5":31544,"_21628":128847,"_28401":128848,"_3085":128849},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3634":75576,"_31209":75540,"_5":31544,"_21628":128851,"_28401":128852,"_3085":128853},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3634":75577,"_31209":75540,"_5":31544,"_21628":128855,"_28401":128856,"_3085":128857},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3634":75578,"_31209":75540,"_5":31544,"_21628":128859,"_28401":128860,"_3085":128861},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3634":75579,"_31209":75540,"_5":31544,"_21628":128863,"_28401":128864,"_3085":128865},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3634":75580,"_31209":75540,"_5":31544,"_21628":128867,"_28401":128868,"_3085":128869},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3634":75581,"_31209":75540,"_5":31544,"_21628":128871,"_28401":128872,"_3085":128873},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3634":75582,"_31209":75540,"_5":31544,"_21628":128875,"_28401":128876,"_3085":128877},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3634":75583,"_31209":75540,"_5":31544,"_21628":128879,"_28401":128880,"_3085":128881},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3634":75584,"_31209":75540,"_5":31544,"_21628":128883,"_28401":128884,"_3085":128885},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3634":75585,"_31209":75540,"_5":31544,"_21628":128887,"_28401":128888,"_3085":128889},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3634":75586,"_31209":75540,"_5":31544,"_21628":128891,"_28401":128892,"_3085":124641},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3634":75587,"_31209":75540,"_5":31544,"_21628":128894,"_28401":128895,"_3085":128896},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3634":75588,"_31209":75540,"_5":31544,"_21628":128898,"_28401":128899,"_3085":128900},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3634":75589,"_31209":75540,"_21628":128902,"_5":14884,"_28401":75540,"_3085":128903},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3634":75590,"_31209":75540,"_21628":128905,"_5":14884,"_28401":75540,"_3085":128906},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3634":75591,"_31209":75540,"_21628":128908,"_5":14884,"_28401":75540,"_3085":128909},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3634":75592,"_31209":75540,"_21628":128911,"_5":14884,"_28401":75540,"_3085":128912},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3634":75593,"_31209":75540,"_21628":128914,"_5":14884,"_28401":75540,"_3085":128915},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3634":75594,"_31209":75540,"_21628":128917,"_5":14884,"_28401":75540,"_3085":128918},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3634":75595,"_31209":75540,"_21628":128920,"_5":14884,"_28401":75540,"_3085":128921},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3634":75596,"_31209":75540,"_21628":128923,"_5":14884,"_28401":128722,"_3085":128924},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3634":75597,"_31209":75540,"_21628":128926,"_5":14884,"_28401":128722,"_3085":128927},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3634":75598,"_31209":75540,"_21628":128929,"_5":14884,"_28401":128726,"_3085":128930},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3634":75599,"_31209":75540,"_21628":128932,"_5":14884,"_28401":128726,"_3085":128933},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3634":75600,"_31209":75540,"_21628":128935,"_5":14884,"_28401":128730,"_3085":128936},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3634":75601,"_31209":75540,"_21628":128938,"_5":14884,"_28401":128734,"_3085":128939},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3634":75602,"_31209":75540,"_21628":128941,"_5":14884,"_28401":128734,"_3085":128942},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3634":75603,"_31209":75540,"_21628":128944,"_5":14884,"_28401":128734,"_3085":128945},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3634":75604,"_31209":75540,"_21628":128947,"_5":14884,"_28401":128734,"_3085":128948},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3634":75605,"_31209":75540,"_21628":128950,"_5":14884,"_28401":128734,"_3085":128951},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3634":75606,"_31209":75540,"_21628":128953,"_5":14884,"_28401":128738,"_3085":128954},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3634":75607,"_31209":75540,"_21628":128956,"_5":14884,"_28401":128738,"_3085":128957},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3634":75608,"_31209":75540,"_21628":128959,"_5":14884,"_28401":128738,"_3085":128960},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3634":75609,"_31209":75540,"_21628":128962,"_5":14884,"_28401":128738,"_3085":128963},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3634":75610,"_31209":75540,"_21628":128965,"_5":14884,"_28401":128738,"_3085":128966},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3634":75611,"_31209":75540,"_21628":128968,"_5":14884,"_28401":128738,"_3085":128969},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3634":75612,"_31209":75540,"_21628":128971,"_5":14884,"_28401":128742,"_3085":128972},[],"Cambio",{"_3634":75613,"_31209":75540,"_21628":128974,"_5":14884,"_28401":128742,"_3085":128975},[],"A quién afecta",{"_3634":75614,"_31209":75540,"_21628":128977,"_5":14884,"_28401":128742,"_3085":128978},[],"Gravedad",{"_3634":75615,"_31209":75540,"_21628":128980,"_5":14884,"_28401":128742,"_3085":127451},[],{"_3634":75616,"_31209":75540,"_21628":128982,"_5":14884,"_28401":128742,"_3085":128750},[],{"_3634":75617,"_31209":75540,"_21628":128984,"_5":14884,"_28401":128742,"_3085":128985},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3634":75618,"_31209":75540,"_21628":128987,"_5":14884,"_28401":128742,"_3085":128988},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3634":75619,"_31209":75540,"_21628":128990,"_5":14884,"_28401":128742,"_3085":128991},[],"Copiar los datos a los volúmenes nuevos",{"_3634":75620,"_31209":75540,"_21628":128993,"_5":14884,"_28401":128742,"_3085":128754},[],{"_3634":75621,"_31209":75540,"_21628":128995,"_5":14884,"_28401":128742,"_3085":128996},[],"Todas las releases de Helm",{"_3634":75622,"_31209":75540,"_21628":128998,"_5":14884,"_28401":128742,"_3085":128999},[],"Alta: `helm upgrade` falla",{"_3634":75623,"_31209":75540,"_21628":129001,"_5":14884,"_28401":128742,"_3085":129002},[],"Eliminar o renombrar las claves heredadas",{"_3634":75624,"_31209":75540,"_21628":129004,"_5":14884,"_28401":128742,"_3085":121099},[],{"_3634":75625,"_31209":75540,"_21628":129006,"_5":14884,"_28401":128742,"_3085":128996},[],{"_3634":75626,"_31209":75540,"_21628":129008,"_5":14884,"_28401":128742,"_3085":129009},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3634":75627,"_31209":75540,"_21628":129011,"_5":14884,"_28401":128742,"_3085":129012},[],"Crear primero los Secrets; consulta el paso 2",{"_3634":75628,"_31209":75540,"_21628":129014,"_5":14884,"_28401":128742,"_3085":128761},[],{"_3634":75629,"_31209":75540,"_21628":129016,"_5":14884,"_28401":128742,"_3085":129017},[],"Todos los despliegues",{"_3634":75630,"_31209":75540,"_21628":129019,"_5":14884,"_28401":128742,"_3085":129020},[],"Alta: sin principal de bootstrap no hay administrador",{"_3634":75631,"_31209":75540,"_21628":129022,"_5":14884,"_28401":128742,"_3085":129023},[],"Configurar `services.authz`",{"_3634":75632,"_31209":75540,"_21628":129025,"_5":14884,"_28401":128742,"_3085":128765},[],{"_3634":75633,"_31209":75540,"_21628":129027,"_5":14884,"_28401":128742,"_3085":128996},[],{"_3634":75634,"_31209":75540,"_21628":129029,"_5":14884,"_28401":128742,"_3085":129030},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3634":75635,"_31209":75540,"_21628":129032,"_5":14884,"_28401":128742,"_3085":129033},[],"Mover JWKS y roles a `services.authz`",{"_3634":75636,"_31209":75540,"_21628":129035,"_5":14884,"_28401":128742,"_3085":128785},[],{"_3634":75637,"_31209":75540,"_21628":129037,"_5":14884,"_28401":128742,"_3085":129038},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3634":75638,"_31209":75540,"_21628":129040,"_5":14884,"_28401":128742,"_3085":129041},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3634":75639,"_31209":75540,"_21628":129043,"_5":14884,"_28401":128742,"_3085":129044},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3634":75640,"_31209":75540,"_21628":129046,"_5":14884,"_28401":128742,"_3085":128789},[],{"_3634":75641,"_31209":75540,"_21628":129048,"_5":14884,"_28401":128742,"_3085":129049},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3634":75642,"_31209":75540,"_21628":129051,"_5":14884,"_28401":128742,"_3085":129052},[],"Alta: el backend ya no arranca con ellos",{"_3634":75643,"_31209":75540,"_21628":129054,"_5":14884,"_28401":128742,"_3085":129055},[],"Pasar a PostgreSQL antes de actualizar",{"_3634":75644,"_31209":75540,"_21628":129057,"_5":14884,"_28401":128742,"_3085":128837},[],{"_3634":75645,"_31209":75540,"_21628":129059,"_5":14884,"_28401":128742,"_3085":129060},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3634":75646,"_31209":75540,"_21628":129062,"_5":14884,"_28401":128742,"_3085":129063},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3634":75647,"_31209":75540,"_21628":129065,"_5":14884,"_28401":128742,"_3085":129066},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3634":75648,"_31209":75540,"_21628":129068,"_5":14884,"_28401":128742,"_3085":129069},[],"Webhooks con referencias a archivos",{"_3634":75649,"_31209":75540,"_21628":129071,"_5":14884,"_28401":128742,"_3085":129072},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3634":75650,"_31209":75540,"_21628":129074,"_5":14884,"_28401":128742,"_3085":129075},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3634":75651,"_31209":75540,"_21628":129077,"_5":14884,"_28401":128742,"_3085":129078},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3634":75652,"_31209":75540,"_21628":129080,"_5":14884,"_28401":128742,"_3085":128769},[],{"_3634":75653,"_31209":75540,"_21628":129082,"_5":14884,"_28401":128742,"_3085":129083},[],"Releases con identidades por servicio o material de claves montado",{"_3634":75654,"_31209":75540,"_21628":129085,"_5":14884,"_28401":128742,"_3085":129086},[],"Media: los servicios no pueden leer sus archivos",{"_3634":75655,"_31209":75540,"_21628":129088,"_5":14884,"_28401":128742,"_3085":129089},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3634":75656,"_31209":75540,"_21628":129091,"_5":14884,"_28401":128742,"_3085":128773},[],{"_3634":75657,"_31209":75540,"_21628":129093,"_5":14884,"_28401":128742,"_3085":129094},[],"Releases que definen `amqp.tls`",{"_3634":75658,"_31209":75540,"_21628":129096,"_5":14884,"_28401":128742,"_3085":129097},[],"Media: los clientes se conectan al puerto equivocado",{"_3634":75659,"_31209":75540,"_21628":129099,"_5":14884,"_28401":128742,"_3085":129100},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3634":75660,"_31209":75540,"_21628":129102,"_5":14884,"_28401":128742,"_3085":128793},[],{"_3634":75661,"_31209":75540,"_21628":129104,"_5":14884,"_28401":128742,"_3085":129105},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3634":75662,"_31209":75540,"_21628":129107,"_5":14884,"_28401":128742,"_3085":129108},[],"Media: las claves de CA quedan sin gestionar",{"_3634":75663,"_31209":75540,"_21628":129110,"_5":14884,"_28401":128742,"_3085":129111},[],"Ejecutar la migración de CA a KMS",{"_3634":75664,"_31209":75540,"_21628":129113,"_5":14884,"_28401":128742,"_3085":129114},[],"Verificación del certificado del receptor",{"_3634":75665,"_31209":75540,"_21628":129116,"_5":14884,"_28401":128742,"_3085":129117},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3634":75666,"_31209":75540,"_21628":129119,"_5":14884,"_28401":128742,"_3085":129120},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3634":75667,"_31209":75540,"_21628":129122,"_5":14884,"_28401":128742,"_3085":129123},[],"Poner `insecure_skip_verify` a `false`",{"_3634":75668,"_31209":75540,"_21628":129125,"_5":14884,"_28401":128742,"_3085":128809},[],{"_3634":75669,"_31209":75540,"_21628":129127,"_5":14884,"_28401":128742,"_3085":129128},[],"Scripts y consolas que editan DMS por API",{"_3634":75670,"_31209":75540,"_21628":129130,"_5":14884,"_28401":128742,"_3085":129131},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3634":75671,"_31209":75540,"_21628":129133,"_5":14884,"_28401":128742,"_3085":129134},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3634":75672,"_31209":75540,"_21628":129136,"_5":14884,"_28401":128742,"_3085":128813},[],{"_3634":75673,"_31209":75540,"_21628":129138,"_5":14884,"_28401":128742,"_3085":129139},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3634":75674,"_31209":75540,"_21628":129141,"_5":14884,"_28401":128742,"_3085":129142},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3634":75675,"_31209":75540,"_21628":129144,"_5":14884,"_28401":128742,"_3085":129145},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3634":75676,"_31209":75540,"_21628":129147,"_5":14884,"_28401":128742,"_3085":128833},[],{"_3634":75677,"_31209":75540,"_21628":129149,"_5":14884,"_28401":128742,"_3085":129150},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3634":75678,"_31209":75540,"_21628":129152,"_5":14884,"_28401":128742,"_3085":129153},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3634":75679,"_31209":75540,"_21628":129155,"_5":14884,"_28401":128742,"_3085":129156},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3634":75680,"_31209":75540,"_21628":129158,"_5":14884,"_28401":128742,"_3085":128841},[],{"_3634":75681,"_31209":75540,"_21628":129160,"_5":14884,"_28401":128742,"_3085":129161},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3634":75682,"_31209":75540,"_21628":129163,"_5":14884,"_28401":128742,"_3085":129164},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3634":75683,"_31209":75540,"_21628":129166,"_5":14884,"_28401":128742,"_3085":129167},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3634":75684,"_31209":75540,"_21628":129169,"_5":14884,"_28401":128742,"_3085":128845},[],{"_3634":75685,"_31209":75540,"_21628":129171,"_5":14884,"_28401":128742,"_3085":129172},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3634":75686,"_31209":75540,"_21628":129174,"_5":14884,"_28401":128742,"_3085":129175},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3634":75687,"_31209":75540,"_21628":129177,"_5":14884,"_28401":128742,"_3085":129178},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3634":75688,"_31209":75540,"_21628":129180,"_5":14884,"_28401":128742,"_3085":128829},[],{"_3634":75689,"_31209":75540,"_21628":129182,"_5":14884,"_28401":128742,"_3085":129183},[],"Consumidores que leen el campo `events` del dispositivo",{"_3634":75690,"_31209":75540,"_21628":129185,"_5":14884,"_28401":128742,"_3085":129186},[],"Media: el campo desaparece",{"_3634":75691,"_31209":75540,"_21628":129188,"_5":14884,"_28401":128742,"_3085":129189},[],"Usar los nuevos endpoints de eventos",{"_3634":75692,"_31209":75540,"_21628":129191,"_5":14884,"_28401":128742,"_3085":128857},[],{"_3634":75693,"_31209":75540,"_21628":129193,"_5":14884,"_28401":128742,"_3085":129194},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3634":75694,"_31209":75540,"_21628":129196,"_5":14884,"_28401":128742,"_3085":129197},[],"Media: la migración de la VA aborta",{"_3634":75695,"_31209":75540,"_21628":129199,"_5":14884,"_28401":128742,"_3085":129200},[],"Corregir los roles afectados antes de actualizar",{"_3634":75696,"_31209":75540,"_21628":129202,"_5":14884,"_28401":128742,"_3085":128777},[],{"_3634":75697,"_31209":75540,"_21628":129204,"_5":14884,"_28401":128742,"_3085":129205},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3634":75698,"_31209":75540,"_21628":129207,"_5":14884,"_28401":128742,"_3085":129208},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3634":75699,"_31209":75540,"_21628":129210,"_5":14884,"_28401":128742,"_3085":129211},[],"Actualizar el archivo de values",{"_3634":75700,"_31209":75540,"_21628":129213,"_5":14884,"_28401":128742,"_3085":128821},[],{"_3634":75701,"_31209":75540,"_21628":129215,"_5":14884,"_28401":128742,"_3085":129216},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3634":75702,"_31209":75540,"_21628":129218,"_5":14884,"_28401":128742,"_3085":129219},[],"Baja: prevalece el ID de la URL",{"_3634":75703,"_31209":75540,"_21628":129221,"_5":14884,"_28401":128742,"_3085":129222},[],"Enviar el ID en la URL",{"_3634":75704,"_31209":75540,"_21628":129224,"_5":14884,"_28401":128742,"_3085":128849},[],{"_3634":75705,"_31209":75540,"_21628":129226,"_5":14884,"_28401":128742,"_3085":129227},[],"Clientes que envían un `id` al crear o importar CAs",{"_3634":75706,"_31209":75540,"_21628":129229,"_5":14884,"_28401":128742,"_3085":129230},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3634":75707,"_31209":75540,"_21628":129232,"_5":14884,"_28401":128742,"_3085":129233},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3634":75708,"_31209":75540,"_21628":129235,"_5":14884,"_28401":128742,"_3085":128853},[],{"_3634":75709,"_31209":75540,"_21628":129237,"_5":14884,"_28401":128742,"_3085":129238},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3634":75710,"_31209":75540,"_21628":129240,"_5":14884,"_28401":128742,"_3085":129241},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3634":75711,"_31209":75540,"_21628":129243,"_5":14884,"_28401":128742,"_3085":129244},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3634":75712,"_31209":75540,"_21628":129246,"_5":14884,"_28401":128742,"_3085":128825},[],{"_3634":75713,"_31209":75540,"_21628":129248,"_5":14884,"_28401":128742,"_3085":129249},[],"Consumidores que comparan el `type` del certificado",{"_3634":75714,"_31209":75540,"_21628":129251,"_5":14884,"_28401":128742,"_3085":129252},[],"Baja: dos valores cambian de nombre",{"_3634":75715,"_31209":75540,"_21628":129254,"_5":14884,"_28401":128742,"_3085":129255},[],"Adaptar los consumidores",{"_3634":75716,"_31209":75540,"_21628":129257,"_5":14884,"_28401":128742,"_3085":128817},[],{"_3634":75717,"_31209":75540,"_21628":129259,"_5":14884,"_28401":128742,"_3085":129260},[],"Cualquier DMS",{"_3634":75718,"_31209":75540,"_21628":129262,"_5":14884,"_28401":128742,"_3085":129263},[],"Baja: solo informativo",{"_3634":75719,"_31209":75540,"_21628":129265,"_5":14884,"_28401":128742,"_3085":129266},[],"Revisar ambos bloques antes de editar",{"_3634":75720,"_31209":75540,"_21628":129268,"_5":14884,"_28401":128749,"_3085":129269},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3634":75721,"_31209":75540,"_21628":129271,"_5":14884,"_28401":128749,"_3085":129272},[],"El paso 4 de la guía de migración copia los datos.",{"_3634":75722,"_31209":75540,"_21628":129274,"_5":14884,"_28401":128753,"_3085":129275},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3634":75723,"_31209":75540,"_21628":129277,"_5":14884,"_28401":128757,"_3085":129278},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3634":75724,"_31209":75540,"_21628":129280,"_5":14884,"_28401":128757,"_3085":129281},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3634":75725,"_31209":75540,"_21628":129283,"_5":14884,"_28401":128760,"_3085":129284},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3634":75726,"_31209":75540,"_21628":129286,"_5":14884,"_28401":128764,"_3085":129287},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3634":75727,"_31209":75540,"_21628":129289,"_5":14884,"_28401":128768,"_3085":129290},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3634":75728,"_31209":75540,"_21628":129292,"_5":14884,"_28401":128768,"_3085":129293},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3634":75729,"_31209":75540,"_21628":129295,"_5":14884,"_28401":128768,"_3085":129296},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3634":75730,"_31209":75540,"_21628":129298,"_5":14884,"_28401":128772,"_3085":129299},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3634":75731,"_31209":75540,"_21628":129301,"_5":14884,"_28401":128776,"_3085":129302},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3634":75732,"_31209":75540,"_21628":129304,"_5":14884,"_28401":128776,"_3085":129305},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3634":75733,"_31209":75540,"_21628":129307,"_5":14884,"_28401":128776,"_3085":129308},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3634":75734,"_31209":75540,"_21628":129310,"_5":14884,"_28401":128776,"_3085":129311},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3634":75735,"_31209":75540,"_21628":129313,"_5":14884,"_28401":128776,"_3085":129314},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3634":75736,"_31209":75540,"_21628":129316,"_5":14884,"_28401":128776,"_3085":129317},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3634":75737,"_31209":75540,"_21628":129319,"_5":14884,"_28401":128784,"_3085":129320},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3634":75738,"_31209":75540,"_21628":129322,"_5":14884,"_28401":128784,"_3085":129323},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3634":75739,"_31209":75540,"_21628":129325,"_5":14884,"_28401":128784,"_3085":129326},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3634":75740,"_31209":75540,"_21628":129328,"_5":14884,"_28401":128784,"_3085":129329},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3634":75741,"_31209":75540,"_21628":129331,"_5":14884,"_28401":128784,"_3085":129332},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3634":75742,"_31209":75540,"_21628":129334,"_5":14884,"_28401":128788,"_3085":129335},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3634":75743,"_31209":75540,"_21628":129337,"_5":14884,"_28401":128792,"_3085":129338},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3634":75744,"_31209":75540,"_21628":129340,"_5":14884,"_28401":128792,"_3085":129341},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3634":75745,"_31209":75540,"_21628":129343,"_5":14884,"_28401":128792,"_3085":129344},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3634":75746,"_31209":75540,"_21628":129346,"_5":14884,"_28401":128792,"_3085":129347},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3634":75747,"_31209":75540,"_21628":129349,"_5":14884,"_28401":128792,"_3085":129350},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3634":75748,"_31209":75540,"_21628":129352,"_5":14884,"_28401":128792,"_3085":129353},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3634":75749,"_31209":75540,"_21628":129355,"_5":14884,"_28401":128792,"_3085":129356},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3634":75750,"_31209":75540,"_21628":129358,"_5":14884,"_28401":128792,"_3085":129359},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3634":75751,"_31209":75540,"_21628":129361,"_5":14884,"_28401":128796,"_3085":129362},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3634":75752,"_31209":75540,"_21628":129364,"_5":14884,"_28401":128804,"_3085":129365},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3634":75753,"_31209":75540,"_21628":129367,"_5":14884,"_28401":128804,"_3085":129368},[],"Campo en 3.8.0",{"_3634":75754,"_31209":75540,"_21628":129370,"_5":14884,"_28401":128804,"_3085":129371},[],"Campo en 4.0.0",{"_3634":75755,"_31209":75540,"_21628":129373,"_5":14884,"_28401":128804,"_3085":60104},[],{"_3634":75756,"_31209":75540,"_21628":129375,"_5":14884,"_28401":128804,"_3085":129376},[],"`insecure_skip_verify` (con el valor negado)",{"_3634":75757,"_31209":75540,"_21628":129378,"_5":14884,"_28401":128804,"_3085":60110},[],{"_3634":75758,"_31209":75540,"_21628":129380,"_5":14884,"_28401":128804,"_3085":60113},[],{"_3634":75759,"_31209":75540,"_21628":129382,"_5":14884,"_28401":128804,"_3085":60116},[],{"_3634":75760,"_31209":75540,"_21628":129384,"_5":14884,"_28401":128804,"_3085":60119},[],{"_3634":75761,"_31209":75540,"_21628":129386,"_5":14884,"_28401":128804,"_3085":60122},[],{"_3634":75762,"_31209":75540,"_21628":129388,"_5":14884,"_28401":128804,"_3085":60125},[],{"_3634":75763,"_31209":75540,"_21628":129390,"_5":14884,"_28401":128804,"_3085":129391},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3634":75764,"_31209":75540,"_21628":129393,"_5":14884,"_28401":128804,"_3085":129394},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3634":75765,"_31209":75540,"_21628":129396,"_5":14884,"_28401":128804,"_3085":129397},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3634":75766,"_31209":75540,"_21628":129399,"_5":14884,"_28401":128808,"_3085":129400},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3634":75767,"_31209":75540,"_21628":129402,"_5":14884,"_28401":128808,"_3085":129403},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3634":75768,"_31209":75540,"_21628":129405,"_5":14884,"_28401":128808,"_3085":129406},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3634":75769,"_31209":75540,"_21628":129408,"_5":14884,"_28401":128812,"_3085":129409},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3634":75770,"_31209":75540,"_21628":129411,"_5":14884,"_28401":128812,"_3085":129412},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3634":75771,"_31209":75540,"_21628":129414,"_5":14884,"_28401":128816,"_3085":129415},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3634":75772,"_31209":75540,"_21628":129417,"_5":14884,"_28401":128820,"_3085":129418},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3634":75773,"_31209":75540,"_21628":129420,"_5":14884,"_28401":128824,"_3085":129421},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3634":75774,"_31209":75540,"_21628":129423,"_5":14884,"_28401":128828,"_3085":129424},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3634":75775,"_31209":75540,"_21628":129426,"_5":14884,"_28401":128828,"_3085":129427},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3634":75776,"_31209":75540,"_21628":129429,"_5":14884,"_28401":128828,"_3085":129430},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3634":75777,"_31209":75540,"_21628":129432,"_5":14884,"_28401":128828,"_3085":129433},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3634":75778,"_31209":75540,"_21628":129435,"_5":14884,"_28401":128832,"_3085":129436},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3634":75779,"_31209":75540,"_21628":129438,"_5":14884,"_28401":128836,"_3085":129439},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3634":75780,"_31209":75540,"_21628":129441,"_5":14884,"_28401":128836,"_3085":129442},[],"Ruta",{"_3634":75781,"_31209":75540,"_21628":129444,"_5":14884,"_28401":128836,"_3085":121730},[],{"_3634":75782,"_31209":75540,"_21628":129446,"_5":14884,"_28401":128836,"_3085":60184},[],{"_3634":75783,"_31209":75540,"_21628":129448,"_5":14884,"_28401":128836,"_3085":129449},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3634":75784,"_31209":75540,"_21628":129451,"_5":14884,"_28401":128836,"_3085":60190},[],{"_3634":75785,"_31209":75540,"_21628":129453,"_5":14884,"_28401":128836,"_3085":129454},[],"Lee los ajustes de una CA.",{"_3634":75786,"_31209":75540,"_21628":129456,"_5":14884,"_28401":128836,"_3085":60196},[],{"_3634":75787,"_31209":75540,"_21628":129458,"_5":14884,"_28401":128836,"_3085":129459},[],"Sustituye los `crl_options`.",{"_3634":75788,"_31209":75540,"_21628":129461,"_5":14884,"_28401":128836,"_3085":60202},[],{"_3634":75789,"_31209":75540,"_21628":129463,"_5":14884,"_28401":128836,"_3085":129464},[],"Elimina los ajustes archivados de una CA.",{"_3634":75790,"_31209":75540,"_21628":129466,"_5":14884,"_28401":128836,"_3085":129467},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3634":75791,"_31209":75540,"_21628":129469,"_5":14884,"_28401":128836,"_3085":129470},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3634":75792,"_31209":75540,"_21628":129472,"_5":14884,"_28401":128836,"_3085":129473},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3634":75793,"_31209":75540,"_21628":129475,"_5":14884,"_28401":128836,"_3085":129476},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3634":75794,"_31209":75540,"_21628":129478,"_5":14884,"_28401":128836,"_3085":129479},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3634":75795,"_31209":75540,"_21628":129481,"_5":14884,"_28401":128836,"_3085":129482},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3634":75796,"_31209":75540,"_21628":129484,"_5":14884,"_28401":128836,"_3085":129485},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3634":75797,"_31209":75540,"_21628":129487,"_5":14884,"_28401":128836,"_3085":129488},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3634":75798,"_31209":75540,"_21628":129490,"_5":14884,"_28401":128836,"_3085":129491},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3634":75799,"_31209":75540,"_21628":129493,"_5":14884,"_28401":128836,"_3085":129494},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3634":75800,"_31209":75540,"_21628":129496,"_5":14884,"_28401":128836,"_3085":129497},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3634":75801,"_31209":75540,"_21628":129499,"_5":14884,"_28401":128840,"_3085":129500},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3634":75802,"_31209":75540,"_21628":129502,"_5":14884,"_28401":128844,"_3085":129503},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3634":75803,"_31209":75540,"_21628":129505,"_5":14884,"_28401":128848,"_3085":129506},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3634":75804,"_31209":75540,"_21628":129508,"_5":14884,"_28401":128852,"_3085":129509},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3634":75805,"_31209":75540,"_21628":129511,"_5":14884,"_28401":128852,"_3085":129512},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3634":75806,"_31209":75540,"_21628":129514,"_5":14884,"_28401":128856,"_3085":129515},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3634":75807,"_31209":75540,"_21628":129517,"_5":14884,"_28401":128860,"_3085":129518},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3634":75808,"_31209":75540,"_21628":129520,"_5":14884,"_28401":128864,"_3085":129521},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3634":75809,"_31209":75540,"_21628":129523,"_5":14884,"_28401":128864,"_3085":129524},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3634":75810,"_31209":75540,"_21628":129526,"_5":14884,"_28401":128864,"_3085":129527},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3634":75811,"_31209":75540,"_21628":129529,"_5":14884,"_28401":128864,"_3085":129530},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3634":75812,"_31209":75540,"_21628":129532,"_5":14884,"_28401":128864,"_3085":129533},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3634":75813,"_31209":75540,"_21628":129535,"_5":14884,"_28401":128864,"_3085":129536},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3634":75814,"_31209":75540,"_21628":129538,"_5":14884,"_28401":128868,"_3085":129539},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3634":75815,"_31209":75540,"_21628":129541,"_5":14884,"_28401":128868,"_3085":129542},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3634":75816,"_31209":75540,"_21628":129544,"_5":14884,"_28401":128868,"_3085":129545},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3634":75817,"_31209":75540,"_21628":129547,"_5":14884,"_28401":128868,"_3085":129548},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3634":75818,"_31209":75540,"_21628":129550,"_5":14884,"_28401":128868,"_3085":129551},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3634":75819,"_31209":75540,"_21628":129553,"_5":14884,"_28401":128872,"_3085":129554},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3634":75820,"_31209":75540,"_21628":129556,"_5":14884,"_28401":128872,"_3085":129557},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3634":75821,"_31209":75540,"_21628":129559,"_5":14884,"_28401":128872,"_3085":129560},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3634":75822,"_31209":75540,"_21628":129562,"_5":14884,"_28401":128872,"_3085":60304},[],{"_3634":75823,"_31209":75540,"_21628":129564,"_5":14884,"_28401":128872,"_3085":129565},[],"Claves de datos obligatorias",{"_3634":75824,"_31209":75540,"_21628":129567,"_5":14884,"_28401":128872,"_3085":129568},[],"Cuándo",{"_3634":75825,"_31209":75540,"_21628":129570,"_5":14884,"_28401":128872,"_3085":129571},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3634":75826,"_31209":75540,"_21628":129573,"_5":14884,"_28401":128872,"_3085":60316},[],{"_3634":75827,"_31209":75540,"_21628":129575,"_5":14884,"_28401":128872,"_3085":129576},[],"Siempre",{"_3634":75828,"_31209":75540,"_21628":129578,"_5":14884,"_28401":128872,"_3085":129579},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3634":75829,"_31209":75540,"_21628":129581,"_5":14884,"_28401":128872,"_3085":60316},[],{"_3634":75830,"_31209":75540,"_21628":129583,"_5":14884,"_28401":128872,"_3085":129576},[],{"_3634":75831,"_31209":75540,"_21628":129585,"_5":14884,"_28401":128872,"_3085":60329},[],{"_3634":75832,"_31209":75540,"_21628":129587,"_5":14884,"_28401":128872,"_3085":60316},[],{"_3634":75833,"_31209":75540,"_21628":129589,"_5":14884,"_28401":128872,"_3085":129590},[],"Solo cuando hay autenticación SMTP",{"_3634":75834,"_31209":75540,"_21628":129592,"_5":14884,"_28401":128872,"_3085":129593},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3634":75835,"_31209":75540,"_21628":129595,"_5":14884,"_28401":128872,"_3085":129596},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3634":75836,"_31209":75540,"_21628":129598,"_5":14884,"_28401":128872,"_3085":129599},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3634":75837,"_31209":75540,"_21628":129601,"_5":14884,"_28401":128872,"_3085":129602},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3634":75838,"_31209":75540,"_21628":129604,"_5":14884,"_28401":128872,"_3085":129605},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3634":75839,"_31209":75540,"_21628":129607,"_5":14884,"_28401":128872,"_3085":129608},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3634":75840,"_31209":75540,"_21628":129610,"_5":14884,"_28401":128872,"_3085":129611},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3634":75841,"_31209":75540,"_21628":129613,"_5":14884,"_28401":128872,"_3085":129614},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3634":75842,"_31209":75540,"_21628":129616,"_5":14884,"_28401":128872,"_3085":129617},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3634":75843,"_31209":75540,"_21628":129619,"_5":14884,"_28401":128872,"_3085":129620},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3634":75844,"_31209":75540,"_21628":129622,"_5":14884,"_28401":128872,"_3085":129623},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3634":75845,"_31209":75540,"_21628":129625,"_5":14884,"_28401":128872,"_3085":129626},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3634":75846,"_31209":75540,"_21628":129628,"_5":14884,"_28401":128872,"_3085":129629},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3634":75847,"_31209":75540,"_21628":129631,"_5":14884,"_28401":128872,"_3085":129632},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3634":75848,"_31209":75540,"_21628":129634,"_5":14884,"_28401":128872,"_3085":129635},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3634":75849,"_31209":75540,"_21628":129637,"_5":14884,"_28401":128876,"_3085":129638},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3634":75850,"_31209":75540,"_21628":129640,"_5":14884,"_28401":128876,"_3085":129641},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3634":75851,"_31209":75540,"_21628":129643,"_5":14884,"_28401":128880,"_3085":129644},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3634":75852,"_31209":75540,"_21628":129646,"_5":14884,"_28401":128880,"_3085":129647},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3634":75853,"_31209":75540,"_21628":129649,"_5":14884,"_28401":128880,"_3085":129650},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3634":75854,"_31209":75540,"_21628":129652,"_5":14884,"_28401":128880,"_3085":129653},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3634":75855,"_31209":75540,"_21628":129655,"_5":14884,"_28401":128880,"_3085":129656},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3634":75856,"_31209":75540,"_21628":129658,"_5":14884,"_28401":128880,"_3085":129659},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3634":75857,"_31209":75540,"_21628":129661,"_5":14884,"_28401":128880,"_3085":129662},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3634":75858,"_31209":75540,"_21628":129664,"_5":14884,"_28401":128880,"_3085":129665},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3634":75859,"_31209":75540,"_21628":129667,"_5":14884,"_28401":128880,"_3085":129668},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3634":75860,"_31209":75540,"_21628":129670,"_5":14884,"_28401":128880,"_3085":129671},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3634":75861,"_31209":75540,"_21628":129673,"_5":14884,"_28401":128880,"_3085":129674},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3634":75862,"_31209":75540,"_21628":129676,"_5":14884,"_28401":128884,"_3085":129677},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3634":75863,"_31209":75540,"_21628":129679,"_5":14884,"_28401":128884,"_3085":129680},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3634":75864,"_31209":75540,"_21628":129682,"_5":14884,"_28401":128888,"_3085":129683},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3634":75865,"_31209":75540,"_21628":129685,"_5":14884,"_28401":128888,"_3085":129686},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3634":75866,"_31209":75540,"_21628":129688,"_5":14884,"_28401":128888,"_3085":129689},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3634":75867,"_31209":75540,"_21628":129691,"_5":14884,"_28401":128888,"_3085":129692},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3634":75868,"_31209":75540,"_21628":129694,"_5":14884,"_28401":128888,"_3085":129695},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3634":75869,"_31209":75540,"_21628":129697,"_5":14884,"_28401":128888,"_3085":129698},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3634":75870,"_31209":75540,"_21628":129700,"_5":14884,"_28401":128888,"_3085":129701},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3634":75871,"_31209":75540,"_21628":129703,"_5":14884,"_28401":128888,"_3085":129704},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3634":75872,"_31209":75540,"_21628":129706,"_5":14884,"_28401":128892,"_3085":129707},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3634":75873,"_31209":75540,"_21628":129709,"_5":14884,"_28401":128892,"_3085":129710},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3634":75874,"_31209":75540,"_21628":129712,"_5":14884,"_28401":128892,"_3085":129713},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3634":75875,"_31209":75540,"_21628":129715,"_5":14884,"_28401":128892,"_3085":129716},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3634":75876,"_31209":75540,"_21628":129718,"_5":14884,"_28401":128892,"_3085":129719},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3634":75877,"_31209":75540,"_21628":129721,"_5":14884,"_28401":128892,"_3085":129722},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3634":75878,"_31209":75540,"_21628":129724,"_5":14884,"_28401":128892,"_3085":129725},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3634":75879,"_31209":75540,"_21628":129727,"_5":14884,"_28401":128892,"_3085":129728},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3634":75880,"_31209":75540,"_21628":129730,"_5":14884,"_28401":128892,"_3085":129731},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3634":75881,"_31209":75540,"_21628":129733,"_5":14884,"_28401":128892,"_3085":129734},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3634":75882,"_31209":75540,"_21628":129736,"_5":14884,"_28401":128892,"_3085":129737},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3634":75883,"_31209":75540,"_21628":129739,"_5":14884,"_28401":128895,"_3085":129740},[],"Tras la actualización, comprueba en este orden:",{"_3634":75884,"_31209":75540,"_21628":129742,"_5":14884,"_28401":128895,"_3085":129743},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3634":75885,"_31209":75540,"_21628":129745,"_5":14884,"_28401":128895,"_3085":129746},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3634":75886,"_31209":75540,"_21628":129748,"_5":14884,"_28401":128895,"_3085":129749},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3634":75887,"_31209":75540,"_21628":129751,"_5":14884,"_28401":128895,"_3085":129752},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3634":75888,"_31209":75540,"_21628":129754,"_5":14884,"_28401":128895,"_3085":129755},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3634":75889,"_31209":75540,"_21628":129757,"_5":14884,"_28401":128895,"_3085":129758},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3634":75890,"_31209":75540,"_21628":129760,"_5":14884,"_28401":128895,"_3085":129761},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3634":75891,"_31209":75540,"_21628":129763,"_5":14884,"_28401":128895,"_3085":129764},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3634":75892,"_31209":75540,"_21628":129766,"_5":14884,"_28401":128895,"_3085":129767},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3634":75893,"_31209":75540,"_21628":129769,"_5":14884,"_28401":128895,"_3085":129770},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3634":75894,"_31209":75540,"_21628":129772,"_5":14884,"_28401":128895,"_3085":129773},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3634":75895,"_31209":75540,"_21628":129775,"_5":14884,"_28401":128895,"_3085":129776},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3634":75896,"_31209":75540,"_21628":129778,"_5":14884,"_28401":128895,"_3085":129779},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3634":75897,"_31209":75540,"_21628":129781,"_5":14884,"_28401":128895,"_3085":129782},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3634":75898,"_31209":75540,"_21628":129784,"_5":14884,"_28401":128895,"_3085":129785},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3634":75899,"_31209":75540,"_21628":129787,"_5":14884,"_28401":128899,"_3085":129788},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3634":75900,"_31209":75540,"_21628":129790,"_5":14884,"_28401":128899,"_3085":129791},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3634":75901,"_31209":75540,"_21628":129793,"_5":14884,"_28401":128899,"_3085":129794},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3634":75902,"_31209":75540,"_21628":129796,"_5":14884,"_28401":128899,"_3085":129797},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3634":75903,"_31209":75540,"_21628":129799,"_5":14884,"_28401":128899,"_3085":129800},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_60547":129802,"_60549":129803,"_60551":129804,"_60553":129805,"_18765":3120,"_72832":3120},"spanish",[3085,31209,5,28401],{"_3085":25815,"_31209":25815,"_5":25815,"_28401":25815},{"_3085":129806,"_31209":132874,"_5":135942,"_28401":139010},{"_4839":129807,"_60557":129808,"_5":25815},{"_14965":7907,"_15344":5348,"_15363":3928,"_30209":6082,"_15350":4225,"_20540":6208,"_14986":3503,"_14993":20845,"_30151":17407,"_30559":13868,"_30586":7293,"_30185":4582,"_35592":5168,"_30288":19716,"_30630":10236,"_35599":5596,"_35602":3556,"_35605":3534,"_35608":3379,"_31032":3160,"_35613":5969,"_35615":3568,"_31067":19168,"_15359":5111,"_35619":7834,"_35622":5259,"_35624":6080,"_30614":11722,"_31052":4847,"_31080":18397,"_35629":15402,"_35631":10810,"_35633":6763,"_30299":5166,"_35636":23528,"_35638":4489,"_35640":7926,"_35642":8009,"_35644":13912,"_30222":3174,"_35647":3720,"_35649":5264,"_30216":10323,"_30651":21043,"_35653":23406,"_35655":7507,"_35658":4584,"_30262":6060,"_35662":8517,"_30142":4494,"_35665":6425,"_30190":5804,"_35668":5476,"_35670":17973,"_35673":4335,"_15353":4918,"_35676":4905,"_35678":8005,"_35681":7976,"_35683":6901,"_35685":6567,"_35687":4580,"_35689":5162,"_20543":12013,"_35692":6989,"_35694":7676,"_30163":3827,"_30608":3483,"_35698":6990,"_35700":14189,"_35702":3443,"_31096":22851,"_35705":13837,"_35707":7219,"_35709":12899,"_31189":14927,"_30667":8894,"_35713":9212,"_35715"