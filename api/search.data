41821":130664,"_41823":130666,"_41825":130669,"_41827":130672,"_41829":130675,"_41831":130677,"_41833":130680,"_41835":130683,"_41837":130685,"_41839":130687,"_41841":130689,"_41843":130691,"_41845":130694,"_41847":130697,"_41849":130700,"_41851":130703,"_41853":130706,"_41855":130709,"_41857":130712,"_41859":130715,"_41861":130718,"_41863":130721,"_41865":130724,"_41867":130727,"_41869":130730,"_41871":130733,"_41873":130736,"_41875":130739,"_41877":130742,"_41879":130745,"_41881":130748,"_41883":130751,"_41885":130754,"_41888":130757,"_41890":130760,"_41892":130763,"_41894":130766,"_41896":130769,"_41898":130772,"_41900":130775,"_41902":130778,"_41904":130781,"_41906":130784,"_41908":130787,"_41910":130790,"_41912":130793,"_41914":130796,"_41917":130799,"_41919":130802,"_41921":130805,"_41923":130808,"_31371":130811,"_41926":130814,"_41928":130817,"_41930":130820,"_41932":130823,"_41934":130826,"_41936":130829,"_41938":130832,"_41940":130835,"_41942":130838,"_41944":130841,"_41946":130844,"_41948":130847,"_41950":130850,"_41952":130853,"_41954":130856,"_41956":130859,"_41958":130862,"_41960":130865,"_41962":130868,"_41964":130871,"_41966":130874,"_41968":130877,"_41970":130880,"_41972":130883,"_41974":130886,"_41976":130889,"_41978":130892,"_41981":130895,"_41983":130898,"_41985":130901},{"_3731":73446,"_31485":73446,"_5":15390,"_3122":121502,"_31812":121503,"_21804":121506,"_28646":73446},"Despliega desde AWS Marketplace",[51373,121504,121505],"Despliegue","Otros modelos",[],{"_3731":73447,"_31485":73446,"_21804":121508,"_5":15036,"_28646":73446,"_3122":121509},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3731":73448,"_31485":73446,"_5":31809,"_21804":121511,"_28646":121512,"_3122":121513},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3731":73449,"_31485":73446,"_5":31809,"_21804":121515,"_28646":121516,"_3122":121517},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3731":73450,"_31485":73446,"_5":31809,"_21804":121519,"_28646":121520,"_3122":121521},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3731":73451,"_31485":73446,"_5":31809,"_21804":121523,"_28646":121524,"_3122":121525},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3731":73452,"_31485":73446,"_5":31809,"_21804":121527,"_28646":121528,"_3122":121529},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3731":73453,"_31485":73446,"_5":31809,"_21804":121531,"_28646":121532,"_3122":121533},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3731":73454,"_31485":73446,"_5":31809,"_21804":121535,"_28646":121536,"_3122":121537},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3731":73455,"_31485":73446,"_21804":121539,"_5":15036,"_28646":73446,"_3122":121540},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3731":73456,"_31485":73446,"_21804":121542,"_5":15036,"_28646":121512,"_3122":121543},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3731":73457,"_31485":73446,"_21804":121545,"_5":15036,"_28646":121512,"_3122":121546},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3731":73458,"_31485":73446,"_21804":121548,"_5":15036,"_28646":121512,"_3122":121549},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3731":73459,"_31485":73446,"_21804":121551,"_5":15036,"_28646":121516,"_3122":121552},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3731":73460,"_31485":73446,"_21804":121554,"_5":15036,"_28646":121516,"_3122":121555},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3731":73461,"_31485":73446,"_21804":121557,"_5":15036,"_28646":121516,"_3122":121558},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3731":73462,"_31485":73446,"_21804":121560,"_5":15036,"_28646":121520,"_3122":121561},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3731":73463,"_31485":73446,"_21804":121563,"_5":15036,"_28646":121524,"_3122":121564},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3731":73464,"_31485":73446,"_21804":121566,"_5":15036,"_28646":121528,"_3122":121567},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3731":73465,"_31485":73446,"_21804":121569,"_5":15036,"_28646":121532,"_3122":121570},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3731":73466,"_31485":73446,"_21804":121572,"_5":15036,"_28646":121536,"_3122":121573},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3731":73467,"_31485":73467,"_5":15390,"_3122":121575,"_31812":121576,"_21804":121577,"_28646":73467},"Despliega Lamassu",[51373,121504],[],{"_3731":73468,"_31485":73467,"_21804":121579,"_5":15036,"_28646":73467,"_3122":121580},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3731":73469,"_31485":73467,"_5":31809,"_21804":121582,"_28646":121583,"_3122":121584},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3731":73470,"_31485":73467,"_5":31809,"_21804":121586,"_28646":121587,"_3122":121588},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3731":73471,"_31485":73467,"_5":31809,"_21804":121590,"_28646":121591,"_3122":121592},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3731":73472,"_31485":73467,"_21804":121594,"_5":15036,"_28646":73467,"_3122":121595},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3731":73473,"_31485":73467,"_21804":121597,"_5":15036,"_28646":121583,"_3122":121598},[],"Modelo",{"_3731":73474,"_31485":73467,"_21804":121600,"_5":15036,"_28646":121583,"_3122":121601},[],"Recomendado para",{"_3731":73475,"_31485":73467,"_21804":121603,"_5":15036,"_28646":121583,"_3122":121604},[],"Quién opera la infraestructura",{"_3731":73476,"_31485":73467,"_21804":121606,"_5":15036,"_28646":121583,"_3122":121607},[],"Punto de partida",{"_3731":73477,"_31485":73467,"_21804":121609,"_5":15036,"_28646":121583,"_3122":51480},[],{"_3731":73478,"_31485":73467,"_21804":121611,"_5":15036,"_28646":121583,"_3122":121612},[],"Producción, entornos regulados y despliegues personalizados",{"_3731":73479,"_31485":73467,"_21804":121614,"_5":15036,"_28646":121583,"_3122":121615},[],"Tu equipo",{"_3731":73480,"_31485":73467,"_21804":121617,"_5":15036,"_28646":121583,"_3122":121618},[],"Helm o Fastlane",{"_3731":73481,"_31485":73467,"_21804":121620,"_5":15036,"_28646":121583,"_3122":51492},[],{"_3731":73482,"_31485":73467,"_21804":121622,"_5":15036,"_28646":121583,"_3122":121623},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3731":73483,"_31485":73467,"_21804":121625,"_5":15036,"_28646":121583,"_3122":121615},[],{"_3731":73484,"_31485":73467,"_21804":121627,"_5":15036,"_28646":121583,"_3122":121628},[],"Imagen preconfigurada en EC2",{"_3731":73485,"_31485":73467,"_21804":121630,"_5":15036,"_28646":121583,"_3122":51503},[],{"_3731":73486,"_31485":73467,"_21804":121632,"_5":15036,"_28646":121583,"_3122":121633},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3731":73487,"_31485":73467,"_21804":121635,"_5":15036,"_28646":121583,"_3122":51509},[],{"_3731":73488,"_31485":73467,"_21804":121637,"_5":15036,"_28646":121583,"_3122":121638},[],"Suscripción gestionada",{"_3731":73489,"_31485":73467,"_21804":121640,"_5":15036,"_28646":121583,"_3122":121641},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3731":73490,"_31485":73467,"_21804":121643,"_5":15036,"_28646":121583,"_3122":121644},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3731":73491,"_31485":73467,"_21804":121646,"_5":15036,"_28646":121583,"_3122":121647},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3731":73492,"_31485":73467,"_21804":121649,"_5":15036,"_28646":121587,"_3122":121650},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3731":73493,"_31485":73467,"_21804":121652,"_5":15036,"_28646":121591,"_3122":121653},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3731":73494,"_31485":73494,"_5":15390,"_3122":121655,"_31812":121656,"_21804":121657,"_28646":73494},"Utiliza Lamassu como SaaS",[51373,121504,121505],[],{"_3731":73495,"_31485":73494,"_21804":121659,"_5":15036,"_28646":73494,"_3122":121660},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3731":73496,"_31485":73494,"_5":31809,"_21804":121662,"_28646":121663,"_3122":121664},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3731":73497,"_31485":73494,"_5":31809,"_21804":121666,"_28646":121667,"_3122":121668},[],"/docs/es/deployment/saas#planes","Planes",{"_3731":73498,"_31485":73494,"_5":31809,"_21804":121670,"_28646":121671,"_3122":121672},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3731":73499,"_31485":73494,"_21804":121674,"_5":15036,"_28646":73494,"_3122":121675},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3731":73500,"_31485":73494,"_21804":121677,"_5":15036,"_28646":121663,"_3122":121678},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3731":73501,"_31485":73494,"_21804":121680,"_5":15036,"_28646":121663,"_3122":121681},[],"Copias de seguridad automáticas.",{"_3731":73502,"_31485":73494,"_21804":121683,"_5":15036,"_28646":121663,"_3122":121684},[],"Actualizaciones de versión.",{"_3731":73503,"_31485":73494,"_21804":121686,"_5":15036,"_28646":121663,"_3122":121687},[],"Soporte técnico y SLA según el plan contratado.",{"_3731":73504,"_31485":73494,"_21804":121689,"_5":15036,"_28646":121667,"_3122":51564},[],{"_3731":73505,"_31485":73494,"_21804":121691,"_5":15036,"_28646":121667,"_3122":121692},[],"Dispositivos",{"_3731":73506,"_31485":73494,"_21804":121694,"_5":15036,"_28646":121667,"_3122":121695},[],"Soporte",{"_3731":73507,"_31485":73494,"_21804":121697,"_5":15036,"_28646":121667,"_3122":51573},[],{"_3731":73508,"_31485":73494,"_21804":121699,"_5":15036,"_28646":121667,"_3122":51576},[],{"_3731":73509,"_31485":73494,"_21804":121701,"_5":15036,"_28646":121667,"_3122":121702},[],"Hasta 1.000",{"_3731":73510,"_31485":73494,"_21804":121704,"_5":15036,"_28646":121667,"_3122":51582},[],{"_3731":73511,"_31485":73494,"_21804":121706,"_5":15036,"_28646":121667,"_3122":121707},[],"99,5 %",{"_3731":73512,"_31485":73494,"_21804":121709,"_5":15036,"_28646":121667,"_3122":51588},[],{"_3731":73513,"_31485":73494,"_21804":121711,"_5":15036,"_28646":121667,"_3122":121712},[],"Hasta 10.000",{"_3731":73514,"_31485":73494,"_21804":121714,"_5":15036,"_28646":121667,"_3122":121715},[],"Email y chat",{"_3731":73515,"_31485":73494,"_21804":121717,"_5":15036,"_28646":121667,"_3122":121718},[],"99,9 %",{"_3731":73516,"_31485":73494,"_21804":121720,"_5":15036,"_28646":121667,"_3122":51600},[],{"_3731":73517,"_31485":73494,"_21804":121722,"_5":15036,"_28646":121667,"_3122":121723},[],"Ilimitados",{"_3731":73518,"_31485":73494,"_21804":121725,"_5":15036,"_28646":121667,"_3122":121726},[],"Dedicado",{"_3731":73519,"_31485":73494,"_21804":121728,"_5":15036,"_28646":121667,"_3122":121729},[],"99,99 %",{"_3731":73520,"_31485":73494,"_21804":121731,"_5":15036,"_28646":121671,"_3122":121732},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3731":73521,"_31485":73494,"_21804":121734,"_5":15036,"_28646":121671,"_3122":121735},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3731":73522,"_31485":73522,"_5":15390,"_3122":51617,"_31812":121737,"_21804":121739,"_28646":73522},[51373,121504,121738],"Kubernetes autogestionado",[],{"_3731":73523,"_31485":73522,"_21804":121741,"_5":15036,"_28646":73522,"_3122":121742},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3731":73524,"_31485":73522,"_5":31809,"_21804":121744,"_28646":121745,"_3122":121746},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3731":73525,"_31485":73522,"_5":31809,"_21804":121748,"_28646":121749,"_3122":121750},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3731":73526,"_31485":73522,"_5":31809,"_21804":121752,"_28646":121753,"_3122":121754},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3731":73527,"_31485":73522,"_5":31809,"_21804":121756,"_28646":121757,"_3122":121758},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3731":73528,"_31485":73522,"_5":31809,"_21804":121760,"_28646":121761,"_3122":121762},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3731":73529,"_31485":73522,"_5":31809,"_21804":121764,"_28646":121765,"_3122":121766},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3731":73530,"_31485":73522,"_5":31809,"_21804":121768,"_28646":121769,"_3122":121770},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3731":73531,"_31485":73522,"_5":31809,"_21804":121772,"_28646":121773,"_3122":121774},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3731":73532,"_31485":73522,"_5":31809,"_21804":121776,"_28646":121777,"_3122":121778},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3731":73533,"_31485":73522,"_5":31809,"_21804":121780,"_28646":121781,"_3122":121782},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3731":73534,"_31485":73522,"_5":31809,"_21804":121784,"_28646":121785,"_3122":121786},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3731":73535,"_31485":73522,"_21804":121788,"_5":15036,"_28646":121745,"_3122":121789},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3731":73536,"_31485":73522,"_21804":121791,"_5":15036,"_28646":121745,"_3122":121792},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3731":73537,"_31485":73522,"_21804":121794,"_5":15036,"_28646":121749,"_3122":121795},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3731":73538,"_31485":73522,"_21804":121797,"_5":15036,"_28646":121749,"_3122":121798},[],"Fastlane instala o configura",{"_3731":73539,"_31485":73522,"_21804":121800,"_5":15036,"_28646":121749,"_3122":121801},[],"Tú sigues proporcionando",{"_3731":73540,"_31485":73522,"_21804":121803,"_5":15036,"_28646":121749,"_3122":121804},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3731":73541,"_31485":73522,"_21804":121806,"_5":15036,"_28646":121749,"_3122":121807},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3731":73542,"_31485":73522,"_21804":121809,"_5":15036,"_28646":121749,"_3122":121810},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3731":73543,"_31485":73522,"_21804":121812,"_5":15036,"_28646":121749,"_3122":121813},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3731":73544,"_31485":73522,"_21804":121815,"_5":15036,"_28646":121749,"_3122":121816},[],"Un flujo de certificado self-signed para Lamassu, credenciales de las dependencias almacenadas en Secrets de Kubernetes (mediante el External Secrets Operator) y un usuario inicial",{"_3731":73545,"_31485":73522,"_21804":121818,"_5":15036,"_28646":121749,"_3122":121819},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3731":73546,"_31485":73522,"_21804":121821,"_5":15036,"_28646":121749,"_3122":121822},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3731":73547,"_31485":73522,"_21804":121824,"_5":15036,"_28646":121749,"_3122":121825},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3731":73548,"_31485":73522,"_21804":121827,"_5":15036,"_28646":121749,"_3122":121828},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3731":73549,"_31485":73522,"_21804":121830,"_5":15036,"_28646":121753,"_3122":121831},[],"Necesitas:",{"_3731":73550,"_31485":73522,"_21804":121833,"_5":15036,"_28646":121753,"_3122":121834},[],"un clúster Kubernetes existente",{"_3731":73551,"_31485":73522,"_21804":121836,"_5":15036,"_28646":121753,"_3122":121837},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3731":73552,"_31485":73522,"_21804":121839,"_5":15036,"_28646":121753,"_3122":51719},[],{"_3731":73553,"_31485":73522,"_21804":121841,"_5":15036,"_28646":121753,"_3122":24618},[],{"_3731":73554,"_31485":73522,"_21804":121843,"_5":15036,"_28646":121753,"_3122":121844},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3731":73555,"_31485":73522,"_21804":121846,"_5":15036,"_28646":121753,"_3122":121847},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3731":73556,"_31485":73522,"_21804":121849,"_5":15036,"_28646":121753,"_3122":121850},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3731":73557,"_31485":73522,"_21804":121852,"_5":15036,"_28646":121753,"_3122":121853},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3731":73558,"_31485":73522,"_21804":121855,"_5":15036,"_28646":121753,"_3122":121856},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3731":73559,"_31485":73522,"_21804":121858,"_5":15036,"_28646":121757,"_3122":121859},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3731":73560,"_31485":73522,"_21804":121861,"_5":15036,"_28646":121757,"_3122":121862},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3731":73561,"_31485":73522,"_21804":121864,"_5":15036,"_28646":121761,"_3122":121865},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3731":73562,"_31485":73522,"_21804":121867,"_5":15036,"_28646":121761,"_3122":121868},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3731":73563,"_31485":73522,"_21804":121870,"_5":15036,"_28646":121761,"_3122":121871},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3731":73564,"_31485":73522,"_21804":121873,"_5":15036,"_28646":121761,"_3122":121874},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3731":73565,"_31485":73522,"_21804":121876,"_5":15036,"_28646":121765,"_3122":121877},[],"Opción",{"_3731":73566,"_31485":73522,"_21804":121879,"_5":15036,"_28646":121765,"_3122":121880},[],"Valor predeterminado",{"_3731":73567,"_31485":73522,"_21804":121882,"_5":15036,"_28646":121765,"_3122":121883},[],"Propósito",{"_3731":73568,"_31485":73522,"_21804":121885,"_5":15036,"_28646":121765,"_3122":51766},[],{"_3731":73569,"_31485":73522,"_21804":121887,"_5":15036,"_28646":121765,"_3122":51769},[],{"_3731":73570,"_31485":73522,"_21804":121889,"_5":15036,"_28646":121765,"_3122":121890},[],"Muestra la ayuda",{"_3731":73571,"_31485":73522,"_21804":121892,"_5":15036,"_28646":121765,"_3122":51775},[],{"_3731":73572,"_31485":73522,"_21804":121894,"_5":15036,"_28646":121765,"_3122":121895},[],"contexto actual",{"_3731":73573,"_31485":73522,"_21804":121897,"_5":15036,"_28646":121765,"_3122":121898},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3731":73574,"_31485":73522,"_21804":121900,"_5":15036,"_28646":121765,"_3122":51784},[],{"_3731":73575,"_31485":73522,"_21804":121902,"_5":15036,"_28646":121765,"_3122":6886},[],{"_3731":73576,"_31485":73522,"_21804":121904,"_5":15036,"_28646":121765,"_3122":121905},[],"Omite prompts y genera credenciales para las dependencias",{"_3731":73577,"_31485":73522,"_21804":121907,"_5":15036,"_28646":121765,"_3122":51792},[],{"_3731":73578,"_31485":73522,"_21804":121909,"_5":15036,"_28646":121765,"_3122":51795},[],{"_3731":73579,"_31485":73522,"_21804":121911,"_5":15036,"_28646":121765,"_3122":121912},[],"Namespace de la instalación",{"_3731":73580,"_31485":73522,"_21804":121914,"_5":15036,"_28646":121765,"_3122":51801},[],{"_3731":73581,"_31485":73522,"_21804":121916,"_5":15036,"_28646":121765,"_3122":51804},[],{"_3731":73582,"_31485":73522,"_21804":121918,"_5":15036,"_28646":121765,"_3122":121919},[],"Dominio usado por la UI, OIDC y el certificado",{"_3731":73583,"_31485":73522,"_21804":121921,"_5":15036,"_28646":121765,"_3122":51810},[],{"_3731":73584,"_31485":73522,"_21804":121923,"_5":15036,"_28646":121765,"_3122":15737},[],{"_3731":73585,"_31485":73522,"_21804":121925,"_5":15036,"_28646":121765,"_3122":121926},[],"Versión del chart de Lamassu",{"_3731":73586,"_31485":73522,"_21804":121928,"_5":15036,"_28646":121765,"_3122":51818},[],{"_3731":73587,"_31485":73522,"_21804":121930,"_5":15036,"_28646":121765,"_3122":51821},[],{"_3731":73588,"_31485":73522,"_21804":121932,"_5":15036,"_28646":121765,"_3122":121933},[],"Puerto del listener HTTPS",{"_3731":73589,"_31485":73522,"_21804":121935,"_5":15036,"_28646":121765,"_3122":51827},[],{"_3731":73590,"_31485":73522,"_21804":121937,"_5":15036,"_28646":121765,"_3122":51830},[],{"_3731":73591,"_31485":73522,"_21804":121939,"_5":15036,"_28646":121765,"_3122":121940},[],"Puerto del listener HTTP",{"_3731":73592,"_31485":73522,"_21804":121942,"_5":15036,"_28646":121765,"_3122":51836},[],{"_3731":73593,"_31485":73522,"_21804":121944,"_5":15036,"_28646":121765,"_3122":51769},[],{"_3731":73594,"_31485":73522,"_21804":121946,"_5":15036,"_28646":121765,"_3122":121947},[],"Certificado PEM para TLS downstream",{"_3731":73595,"_31485":73522,"_21804":121949,"_5":15036,"_28646":121765,"_3122":51844},[],{"_3731":73596,"_31485":73522,"_21804":121951,"_5":15036,"_28646":121765,"_3122":51769},[],{"_3731":73597,"_31485":73522,"_21804":121953,"_5":15036,"_28646":121765,"_3122":121954},[],"Clave privada PEM para TLS downstream",{"_3731":73598,"_31485":73522,"_21804":121956,"_5":15036,"_28646":121765,"_3122":51852},[],{"_3731":73599,"_31485":73522,"_21804":121958,"_5":15036,"_28646":121765,"_3122":121959},[],"chart del repositorio",{"_3731":73600,"_31485":73522,"_21804":121961,"_5":15036,"_28646":121765,"_3122":121962},[],"Usa un chart local de Lamassu sin empaquetar",{"_3731":73601,"_31485":73522,"_21804":121964,"_5":15036,"_28646":121765,"_3122":51861},[],{"_3731":73602,"_31485":73522,"_21804":121966,"_5":15036,"_28646":121765,"_3122":121967},[],"detección automática",{"_3731":73603,"_31485":73522,"_21804":121969,"_5":15036,"_28646":121765,"_3122":121970},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3731":73604,"_31485":73522,"_21804":121972,"_5":15036,"_28646":121765,"_3122":51869},[],{"_3731":73605,"_31485":73522,"_21804":121974,"_5":15036,"_28646":121765,"_3122":6886},[],{"_3731":73606,"_31485":73522,"_21804":121976,"_5":15036,"_28646":121765,"_3122":121977},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3731":73607,"_31485":73522,"_21804":121979,"_5":15036,"_28646":121765,"_3122":51877},[],{"_3731":73608,"_31485":73522,"_21804":121981,"_5":15036,"_28646":121765,"_3122":6886},[],{"_3731":73609,"_31485":73522,"_21804":121983,"_5":15036,"_28646":121765,"_3122":121984},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3731":73610,"_31485":73522,"_21804":121986,"_5":15036,"_28646":121765,"_3122":51885},[],{"_3731":73611,"_31485":73522,"_21804":121988,"_5":15036,"_28646":121765,"_3122":6886},[],{"_3731":73612,"_31485":73522,"_21804":121990,"_5":15036,"_28646":121765,"_3122":121991},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3731":73613,"_31485":73522,"_21804":121993,"_5":15036,"_28646":121765,"_3122":51893},[],{"_3731":73614,"_31485":73522,"_21804":121995,"_5":15036,"_28646":121765,"_3122":6886},[],{"_3731":73615,"_31485":73522,"_21804":121997,"_5":15036,"_28646":121765,"_3122":121998},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3731":73616,"_31485":73522,"_21804":122000,"_5":15036,"_28646":121765,"_3122":51901},[],{"_3731":73617,"_31485":73522,"_21804":122002,"_5":15036,"_28646":121765,"_3122":51904},[],{"_3731":73618,"_31485":73522,"_21804":122004,"_5":15036,"_28646":121765,"_3122":122005},[],"Usa otro chart local de SoftHSM",{"_3731":73619,"_31485":73522,"_21804":122007,"_5":15036,"_28646":121765,"_3122":122008},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3731":73620,"_31485":73522,"_21804":122010,"_5":15036,"_28646":121769,"_3122":122011},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3731":73621,"_31485":73522,"_21804":122013,"_5":15036,"_28646":121769,"_3122":122014},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3731":73622,"_31485":73522,"_21804":122016,"_5":15036,"_28646":121769,"_3122":122017},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3731":73623,"_31485":73522,"_21804":122019,"_5":15036,"_28646":121769,"_3122":122020},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3731":73624,"_31485":73522,"_21804":122022,"_5":15036,"_28646":121769,"_3122":122023},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3731":73625,"_31485":73522,"_21804":122025,"_5":15036,"_28646":121769,"_3122":122026},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3731":73626,"_31485":73522,"_21804":122028,"_5":15036,"_28646":121773,"_3122":51931},[],{"_3731":73627,"_31485":73522,"_21804":122030,"_5":15036,"_28646":121773,"_3122":122031},[],"valida las herramientas locales y el clúster seleccionado",{"_3731":73628,"_31485":73522,"_21804":122033,"_5":15036,"_28646":121773,"_3122":122034},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3731":73629,"_31485":73522,"_21804":122036,"_5":15036,"_28646":121773,"_3122":122037},[],"crea el namespace",{"_3731":73630,"_31485":73522,"_21804":122039,"_5":15036,"_28646":121773,"_3122":122040},[],"instala el External Secrets Operator y crea las credenciales de PostgreSQL, RabbitMQ y del administrador de Keycloak como Secrets a través de un `ClusterSecretStore` Fake",{"_3731":73631,"_31485":73522,"_21804":122042,"_5":15036,"_28646":121773,"_3122":122043},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3731":73632,"_31485":73522,"_21804":122045,"_5":15036,"_28646":121773,"_3122":122046},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3731":73633,"_31485":73522,"_21804":122048,"_5":15036,"_28646":121773,"_3122":122049},[],"instala RabbitMQ",{"_3731":73634,"_31485":73522,"_21804":122051,"_5":15036,"_28646":121773,"_3122":122052},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3731":73635,"_31485":73522,"_21804":122054,"_5":15036,"_28646":121773,"_3122":122055},[],"genera `lamassu.yaml`, que referencia los Secrets en lugar de credenciales inline, e instala el chart de Lamassu",{"_3731":73636,"_31485":73522,"_21804":122057,"_5":15036,"_28646":121773,"_3122":122058},[],"carga datos de ejemplo opcionalmente",{"_3731":73637,"_31485":73522,"_21804":122060,"_5":15036,"_28646":121773,"_3122":122061},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3731":73638,"_31485":73522,"_21804":122063,"_5":15036,"_28646":121777,"_3122":122064},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3731":73639,"_31485":73522,"_21804":122066,"_5":15036,"_28646":121777,"_3122":122067},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3731":73640,"_31485":73522,"_21804":122069,"_5":15036,"_28646":121781,"_3122":122070},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak y las almacena en Secrets de Kubernetes a través del `ClusterSecretStore` Fake del External Secrets Operator. Fastlane escribe `lamassu.yaml` en el directorio actual referenciando esos Secrets — el archivo de valores ya no contiene las credenciales.",{"_3731":73641,"_31485":73522,"_21804":122072,"_5":15036,"_28646":121781,"_3122":122073},[],"La contraseña del administrador de Keycloak ya no se imprime por pantalla. Recupérala del Secret cuando la necesites:",{"_3731":73642,"_31485":73522,"_21804":122075,"_5":15036,"_28646":121781,"_3122":122076},[],"El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3731":73643,"_31485":73522,"_21804":122078,"_5":15036,"_28646":121781,"_3122":122079},[],"El `ClusterSecretStore` Fake almacena las credenciales en texto plano y es solo para laboratorio: sustitúyelo por un proveedor ESO real para cualquier uso que vaya más allá de un entorno desechable. Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3731":73644,"_31485":73522,"_21804":122081,"_5":15036,"_28646":121785,"_3122":122082},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3731":73645,"_31485":73645,"_5":15390,"_3122":122084,"_31812":122085,"_21804":122086,"_28646":73645},"Instala con Helm",[51373,121504,121738],[],{"_3731":73646,"_31485":73645,"_21804":122088,"_5":15036,"_28646":73645,"_3122":122089},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3731":73647,"_31485":73645,"_5":31809,"_21804":122091,"_28646":122092,"_3122":122093},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3731":73648,"_31485":73645,"_5":31809,"_21804":122095,"_28646":122096,"_3122":121754},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3731":73649,"_31485":73645,"_5":31809,"_21804":122098,"_28646":122099,"_3122":122100},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3731":73650,"_31485":73645,"_5":31809,"_21804":122102,"_28646":122103,"_3122":122104},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3731":73651,"_31485":73645,"_5":31809,"_21804":122106,"_28646":122107,"_3122":122108},[],"/docs/es/deployment/self-hosted/helm#credenciales-en-secrets-de-kubernetes","Credenciales en Secrets de Kubernetes",{"_3731":73652,"_31485":73645,"_5":31809,"_21804":122110,"_28646":122111,"_3122":122112},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3731":73653,"_31485":73645,"_5":31809,"_21804":122114,"_28646":122115,"_3122":122116},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3731":73654,"_31485":73645,"_5":31809,"_21804":122118,"_28646":122119,"_3122":122120},[],"/docs/es/deployment/self-hosted/helm#flujo-de-eventos-de-dispositivo-sse","Flujo de eventos de dispositivo (SSE)",{"_3731":73655,"_31485":73645,"_5":31809,"_21804":122122,"_28646":122123,"_3122":122124},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3731":73656,"_31485":73645,"_5":31809,"_21804":122126,"_28646":122127,"_3122":122128},[],"/docs/es/deployment/self-hosted/helm#terminal-experimental-del-dashboard-opcional","Terminal experimental del dashboard (opcional)",{"_3731":73657,"_31485":73645,"_5":31809,"_21804":122130,"_28646":122131,"_3122":122132},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3731":73658,"_31485":73645,"_5":31809,"_21804":122134,"_28646":122135,"_3122":122136},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3731":73659,"_31485":73645,"_5":31809,"_21804":122138,"_28646":122139,"_3122":122140},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3731":73660,"_31485":73645,"_5":31809,"_21804":122142,"_28646":122143,"_3122":122144},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3731":73661,"_31485":73645,"_21804":122146,"_5":15036,"_28646":122092,"_3122":122147},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3731":73662,"_31485":73645,"_21804":122149,"_5":15036,"_28646":122096,"_3122":122150},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3731":73663,"_31485":73645,"_21804":122152,"_5":15036,"_28646":122096,"_3122":122153},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3731":73664,"_31485":73645,"_21804":122155,"_5":15036,"_28646":122096,"_3122":122156},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3731":73665,"_31485":73645,"_21804":122158,"_5":15036,"_28646":122096,"_3122":122159},[],"un broker RabbitMQ accesible y sus credenciales",{"_3731":73666,"_31485":73645,"_21804":122161,"_5":15036,"_28646":122096,"_3122":122162},[],"Secrets de Kubernetes en el namespace del release con las credenciales de PostgreSQL y RabbitMQ (y las credenciales SMTP cuando el SMTP exija autenticación) — el chart lee las credenciales de Secrets y rechaza los valores inline (consulta Credenciales en Secrets de Kubernetes)",{"_3731":73667,"_31485":73645,"_21804":122164,"_5":15036,"_28646":122096,"_3122":122165},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3731":73668,"_31485":73645,"_21804":122167,"_5":15036,"_28646":122096,"_3122":122168},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3731":73669,"_31485":73645,"_21804":122170,"_5":15036,"_28646":122096,"_3122":122171},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3731":73670,"_31485":73645,"_21804":122173,"_5":15036,"_28646":122096,"_3122":122174},[],"una StorageClass y un diseño de tráfico externo",{"_3731":73671,"_31485":73645,"_21804":122176,"_5":15036,"_28646":122096,"_3122":122177},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3731":73672,"_31485":73645,"_21804":122179,"_5":15036,"_28646":122096,"_3122":122180},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3731":73673,"_31485":73645,"_21804":122182,"_5":15036,"_28646":122096,"_3122":122183},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3731":73674,"_31485":73645,"_21804":122185,"_5":15036,"_28646":122099,"_3122":122186},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3731":73675,"_31485":73645,"_21804":122188,"_5":15036,"_28646":122099,"_3122":122189},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3731":73676,"_31485":73645,"_21804":122191,"_5":15036,"_28646":122099,"_3122":122192},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3731":73677,"_31485":73645,"_21804":122194,"_5":15036,"_28646":122103,"_3122":122195},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3731":73678,"_31485":73645,"_21804":122197,"_5":15036,"_28646":122103,"_3122":122198},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3731":73679,"_31485":73645,"_21804":122200,"_5":15036,"_28646":122103,"_3122":122201},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3731":73680,"_31485":73645,"_21804":122203,"_5":15036,"_28646":122103,"_3122":122204},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3731":73681,"_31485":73645,"_21804":122206,"_5":15036,"_28646":122107,"_3122":122207},[],"El chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release. Referéncialas con `existingSecret` más las claves de datos `usernameKey` y `passwordKey`; los valores inline `username` y `password` se han eliminado y `values.schema.json` los rechaza.",{"_3731":73682,"_31485":73645,"_21804":122209,"_5":15036,"_28646":122107,"_3122":122210},[],"Los Secrets deben existir antes de instalar o actualizar: el job de migración de pre-install y pre-upgrade se conecta a PostgreSQL con el Secret de PostgreSQL, y los contenedores de los servicios leen las credenciales de AMQP y SMTP cuando arrancan.",{"_3731":73683,"_31485":73645,"_21804":122212,"_5":15036,"_28646":122107,"_3122":122213},[],"`postgres.existingSecret` (por defecto `lamassu-postgres`) y `amqp.existingSecret` (por defecto `lamassu-amqp`) son obligatorios siempre.",{"_3731":73684,"_31485":73645,"_21804":122215,"_5":15036,"_28646":122107,"_3122":122216},[],"`services.alerts.smtp_server.existingSecret` está vacío por defecto, lo que significa SMTP sin autenticación. Defínelo, junto con sus nombres de clave, solo cuando tu servidor SMTP exija autenticación.",{"_3731":73685,"_31485":73645,"_21804":122218,"_5":15036,"_28646":122107,"_3122":122219},[],"Cada entrada de `services.authz.credentials` nombra su `database` y usa el Secret global de PostgreSQL — `postgres.existingSecret` con sus nombres de clave configurados — salvo que la entrada defina su propio `existingSecret`.",{"_3731":73686,"_31485":73645,"_21804":122221,"_5":15036,"_28646":122107,"_3122":122222},[],"Cambiar el contenido de un Secret no reinicia los pods que lo consumen: los servicios leen las credenciales cuando arrancan. Reinicia los pods afectados después de rotar una credencial.",{"_3731":73687,"_31485":73645,"_21804":122224,"_5":15036,"_28646":122107,"_3122":122225},[],"Para producción, gestiona los Secrets con el External Secrets Operator (ESO), que el chart no instala. El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` de prueba, los recursos `ExternalSecret` y la espera antes de instalar el chart. Su proveedor Fake es solo para pruebas — sustitúyelo por la configuración de tu proveedor para cualquier uso que vaya más allá de un entorno desechable; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager y otros proveedores están documentados en external-secrets.io.",{"_3731":73688,"_31485":73645,"_21804":122227,"_5":15036,"_28646":122107,"_3122":122228},[],"Solo estas credenciales pasan a Secrets: el resto de values, como la configuración de conectores o de motores criptográficos, sigue configurándose en el archivo de values.",{"_3731":73689,"_31485":73645,"_21804":122230,"_5":15036,"_28646":122111,"_3122":122231},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3731":73690,"_31485":73645,"_21804":122233,"_5":15036,"_28646":122115,"_3122":122234},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3731":73691,"_31485":73645,"_21804":122236,"_5":15036,"_28646":122115,"_3122":122237},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3731":73692,"_31485":73645,"_21804":122239,"_5":15036,"_28646":122115,"_3122":122240},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3731":73693,"_31485":73645,"_21804":122242,"_5":15036,"_28646":122115,"_3122":122243},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — el security context del pod por defecto del chart ya define `fsGroup: 65532` para todos los pods de servicio, por lo que este ajuste solo se aplica cuando se ha sobrescrito un `podSecurityContext` explícito sin `fsGroup` y hay un Secret de cliente AMQP configurado — y usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3731":73694,"_31485":73645,"_21804":122245,"_5":15036,"_28646":122115,"_3122":122246},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3731":73695,"_31485":73645,"_21804":122248,"_5":15036,"_28646":122115,"_3122":122249},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3731":73696,"_31485":73645,"_21804":122251,"_5":15036,"_28646":122115,"_3122":122252},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3731":73697,"_31485":73645,"_21804":122254,"_5":15036,"_28646":122119,"_3122":122255},[],"`services.deviceManager.sseEnabled` (por defecto `true`) controla si Device Manager sirve su flujo de eventos de dispositivo mediante Server-Sent Events (SSE). Con el valor por defecto, el chart renderiza una regla de gateway dedicada para el endpoint de eventos de dispositivo con un timeout de petición de 11 minutos, porque el timeout de petición por defecto del Gateway es demasiado corto para estos flujos, que el servicio mantiene abiertos hasta unos diez minutos. Las llamadas a Device Manager que no son peticiones SSE conservan el timeout por defecto del Gateway.",{"_3731":73698,"_31485":73645,"_21804":122257,"_5":15036,"_28646":122119,"_3122":122258},[],"Defínelo como `false` para deshabilitar el flujo: el chart renderiza entonces `sse_enabled: false` en la configuración de Device Manager y omite la regla de gateway, y las peticiones SSE al endpoint de eventos de dispositivo fallan. Consulta Eventos de dispositivo en la guía de actualización de 3.8.0 a 4.0.0.",{"_3731":73699,"_31485":73645,"_21804":122260,"_5":15036,"_28646":122123,"_3122":122261},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3731":73700,"_31485":73645,"_21804":122263,"_5":15036,"_28646":122123,"_3122":122264},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3731":73701,"_31485":73645,"_21804":122266,"_5":15036,"_28646":122123,"_3122":122267},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3731":73702,"_31485":73645,"_21804":122269,"_5":15036,"_28646":122123,"_3122":122270},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3731":73703,"_31485":73645,"_21804":122272,"_5":15036,"_28646":122127,"_3122":122273},[],"El dashboard incluye un terminal experimental en el navegador para trabajar con los dispositivos. Está deshabilitado por defecto; actívalo en el archivo de valores:",{"_3731":73704,"_31485":73645,"_21804":122275,"_5":15036,"_28646":122127,"_3122":122276},[],"Para habilitar el terminal se requiere la autorización externa: define `auth.externalAuthorization.enabled: true` y `auth.externalAuthorization.failOpen: false`. Si no, el chart se niega a renderizar el release, porque el endpoint WebSocket del terminal quedaría expuesto a través del Gateway sin autorización externa.",{"_3731":73705,"_31485":73645,"_21804":122278,"_5":15036,"_28646":122127,"_3122":122279},[],"Solo las identidades que tengan concedida la política precargada \"Terminal Network\" pueden abrir sesiones de terminal. Consulta Control de acceso para saber cómo se asignan las políticas.",{"_3731":73706,"_31485":73645,"_21804":122281,"_5":15036,"_28646":122127,"_3122":122282},[],"Ten en cuenta que, incluso con el terminal habilitado, los pods dentro del clúster pueden seguir llegando directamente al servicio de la UI salvo que las network policies restrinjan ese acceso: la autorización externa se aplica al tráfico que entra por el Gateway.",{"_3731":73707,"_31485":73645,"_21804":122284,"_5":15036,"_28646":122131,"_3122":122285},[],"Para instalar un checkout local:",{"_3731":73708,"_31485":73645,"_21804":122287,"_5":15036,"_28646":122135,"_3122":122288},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3731":73709,"_31485":73645,"_21804":122290,"_5":15036,"_28646":122135,"_3122":122291},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3731":73710,"_31485":73645,"_21804":122293,"_5":15036,"_28646":122139,"_3122":122294},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3731":73711,"_31485":73645,"_21804":122296,"_5":15036,"_28646":122139,"_3122":122297},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3731":73712,"_31485":73645,"_21804":122299,"_5":15036,"_28646":122139,"_3122":122300},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3731":73713,"_31485":73645,"_21804":122302,"_5":15036,"_28646":122139,"_3122":122303},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3731":73714,"_31485":73645,"_21804":122305,"_5":15036,"_28646":122139,"_3122":122306},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3731":73715,"_31485":73645,"_21804":122308,"_5":15036,"_28646":122143,"_3122":122309},[],"Antes de pasar a producción, revisa:",{"_3731":73716,"_31485":73645,"_21804":122311,"_5":15036,"_28646":122143,"_3122":122312},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3731":73717,"_31485":73645,"_21804":122314,"_5":15036,"_28646":122143,"_3122":122315},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3731":73718,"_31485":73645,"_21804":122317,"_5":15036,"_28646":122143,"_3122":122318},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3731":73719,"_31485":73645,"_21804":122320,"_5":15036,"_28646":122143,"_3122":122321},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3731":73720,"_31485":73645,"_21804":122323,"_5":15036,"_28646":122143,"_3122":122324},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3731":73721,"_31485":73645,"_21804":122326,"_5":15036,"_28646":122143,"_3122":122327},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3731":73722,"_31485":73645,"_21804":122329,"_5":15036,"_28646":122143,"_3122":122330},[],"SMTP, observabilidad y entrega de alertas",{"_3731":73723,"_31485":73645,"_21804":122332,"_5":15036,"_28646":122143,"_3122":122333},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3731":73724,"_31485":73645,"_21804":122335,"_5":15036,"_28646":122143,"_3122":122336},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3731":73725,"_31485":73725,"_5":15390,"_3122":122338,"_31812":122339,"_21804":122340,"_28646":73725},"Expón el Gateway",[51373,121504,121738],[],{"_3731":73726,"_31485":73725,"_21804":122342,"_5":15036,"_28646":73725,"_3122":122343},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3731":73727,"_31485":73725,"_5":31809,"_21804":122345,"_28646":122346,"_3122":122347},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3731":73728,"_31485":73725,"_5":31809,"_21804":122349,"_28646":122350,"_3122":122351},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3731":73729,"_31485":73725,"_5":31809,"_21804":122353,"_28646":122354,"_3122":122355},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3731":73730,"_31485":73725,"_5":31809,"_21804":122357,"_28646":122358,"_3122":52262},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3731":73731,"_31485":73725,"_5":31809,"_21804":122360,"_28646":122361,"_3122":122362},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3731":73732,"_31485":73725,"_5":31809,"_21804":122364,"_28646":122365,"_3122":122366},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3731":73733,"_31485":73725,"_5":31809,"_21804":122368,"_28646":122369,"_3122":122370},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3731":73734,"_31485":73725,"_5":31809,"_21804":122372,"_28646":122373,"_3122":122374},[],"/docs/es/deployment/self-hosted/networking#certificados-de-cliente-y-cabeceras-de-identidad","Certificados de cliente y cabeceras de identidad",{"_3731":73735,"_31485":73725,"_5":31809,"_21804":122376,"_28646":122377,"_3122":122378},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3731":73736,"_31485":73725,"_5":31809,"_21804":122380,"_28646":122381,"_3122":122382},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3731":73737,"_31485":73725,"_5":31809,"_21804":122384,"_28646":122385,"_3122":122386},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3731":73738,"_31485":73725,"_21804":122388,"_5":15036,"_28646":122346,"_3122":122389},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3731":73739,"_31485":73725,"_21804":122391,"_5":15036,"_28646":122346,"_3122":122392},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3731":73740,"_31485":73725,"_21804":122394,"_5":15036,"_28646":122350,"_3122":122395},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3731":73741,"_31485":73725,"_21804":122397,"_5":15036,"_28646":122350,"_3122":122398},[],"Defínelo únicamente cuando:",{"_3731":73742,"_31485":73725,"_21804":122400,"_5":15036,"_28646":122350,"_3122":122401},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3731":73743,"_31485":73725,"_21804":122403,"_5":15036,"_28646":122350,"_3122":122404},[],"esa dirección está asignada a este Gateway",{"_3731":73744,"_31485":73725,"_21804":122406,"_5":15036,"_28646":122350,"_3122":122407},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3731":73745,"_31485":73725,"_21804":122409,"_5":15036,"_28646":122350,"_3122":122410},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3731":73746,"_31485":73725,"_21804":122412,"_5":15036,"_28646":122350,"_3122":122413},[],"No confundas estos valores:",{"_3731":73747,"_31485":73725,"_21804":122415,"_5":15036,"_28646":122350,"_3122":122416},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3731":73748,"_31485":73725,"_21804":122418,"_5":15036,"_28646":122350,"_3122":122419},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3731":73749,"_31485":73725,"_21804":122421,"_5":15036,"_28646":122350,"_3122":122422},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3731":73750,"_31485":73725,"_21804":122424,"_5":15036,"_28646":122354,"_3122":122425},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3731":73751,"_31485":73725,"_21804":122427,"_5":15036,"_28646":122354,"_3122":122428},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3731":73752,"_31485":73725,"_21804":122430,"_5":15036,"_28646":122358,"_3122":122431},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3731":73753,"_31485":73725,"_21804":122433,"_5":15036,"_28646":122358,"_3122":122434},[],"Para el diseño recomendado:",{"_3731":73754,"_31485":73725,"_21804":122436,"_5":15036,"_28646":122358,"_3122":122437},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3731":73755,"_31485":73725,"_21804":122439,"_5":15036,"_28646":122358,"_3122":122440},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3731":73756,"_31485":73725,"_21804":122442,"_5":15036,"_28646":122358,"_3122":122443},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3731":73757,"_31485":73725,"_21804":122445,"_5":15036,"_28646":122358,"_3122":122446},[],"Apunta DNS a la dirección accesible de la VM.",{"_3731":73758,"_31485":73725,"_21804":122448,"_5":15036,"_28646":122358,"_3122":122449},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3731":73759,"_31485":73725,"_21804":122451,"_5":15036,"_28646":122361,"_3122":122452},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3731":73760,"_31485":73725,"_21804":122454,"_5":15036,"_28646":122365,"_3122":122455},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3731":73761,"_31485":73725,"_21804":122457,"_5":15036,"_28646":122365,"_3122":122458},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3731":73762,"_31485":73725,"_21804":122460,"_5":15036,"_28646":122369,"_3122":122461},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3731":73763,"_31485":73725,"_21804":122463,"_5":15036,"_28646":122369,"_3122":122464},[],"Requisito",{"_3731":73764,"_31485":73725,"_21804":122466,"_5":15036,"_28646":122369,"_3122":122467},[],"Diseño recomendado",{"_3731":73765,"_31485":73725,"_21804":122469,"_5":15036,"_28646":122369,"_3122":122470},[],"Consecuencia",{"_3731":73766,"_31485":73725,"_21804":122472,"_5":15036,"_28646":122369,"_3122":122473},[],"Varias URL o servicios de Lamassu",{"_3731":73767,"_31485":73725,"_21804":122475,"_5":15036,"_28646":122369,"_3122":122476},[],"Un Gateway con varias rutas",{"_3731":73768,"_31485":73725,"_21804":122478,"_5":15036,"_28646":122369,"_3122":122479},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3731":73769,"_31485":73725,"_21804":122481,"_5":15036,"_28646":122369,"_3122":122482},[],"Gateways independientes e IP externas distintas",{"_3731":73770,"_31485":73725,"_21804":122484,"_5":15036,"_28646":122369,"_3122":122485},[],"Una VIP por Gateway",{"_3731":73771,"_31485":73725,"_21804":122487,"_5":15036,"_28646":122369,"_3122":122488},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3731":73772,"_31485":73725,"_21804":122490,"_5":15036,"_28646":122369,"_3122":122491},[],"Gateways independientes, un nodo y una IP",{"_3731":73773,"_31485":73725,"_21804":122493,"_5":15036,"_28646":122369,"_3122":122494},[],"Puertos externos diferentes",{"_3731":73774,"_31485":73725,"_21804":122496,"_5":15036,"_28646":122369,"_3122":122497},[],"Los clientes deben indicar puertos no estándar",{"_3731":73775,"_31485":73725,"_21804":122499,"_5":15036,"_28646":122369,"_3122":122500},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3731":73776,"_31485":73725,"_21804":122502,"_5":15036,"_28646":122369,"_3122":122503},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3731":73777,"_31485":73725,"_21804":122505,"_5":15036,"_28646":122369,"_3122":122506},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3731":73778,"_31485":73725,"_21804":122508,"_5":15036,"_28646":122369,"_3122":122509},[],"Recursos Gateway separados pero proxy compartido",{"_3731":73779,"_31485":73725,"_21804":122511,"_5":15036,"_28646":122369,"_3122":122512},[],"Modo merged Gateway de Envoy",{"_3731":73780,"_31485":73725,"_21804":122514,"_5":15036,"_28646":122369,"_3122":122515},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3731":73781,"_31485":73725,"_21804":122517,"_5":15036,"_28646":122369,"_3122":122518},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3731":73782,"_31485":73725,"_21804":122520,"_5":15036,"_28646":122369,"_3122":122521},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3731":73783,"_31485":73725,"_21804":122523,"_5":15036,"_28646":122369,"_3122":122524},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3731":73784,"_31485":73725,"_21804":122526,"_5":15036,"_28646":122369,"_3122":122527},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3731":73785,"_31485":73725,"_21804":122529,"_5":15036,"_28646":122373,"_3122":122530},[],"El chart aplica automáticamente una `ClientTrafficPolicy` llamada `enable-mtls` a su Gateway compartido; ningún valor de Helm la activa ni la desactiva. La terminación TLS acepta peticiones con o sin certificado de cliente: los dispositivos pueden presentar uno, pero no están obligados a hacerlo. Antes de reenviar una petición, el Gateway elimina las cabeceras de identidad y de certificado que un cliente podría suministrarse por sí mismo: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (la grafía de Traefik), `Ssl-Client-Cert` y `X-Amzn-Mtls-Clientcert`. La grafía de Traefik se incluye porque los backends que aceptan `X-Forwarded-Tls-Client-Cert` directamente recibirían, si no, datos de identidad de certificado suministrados por el propio cliente sin haber presentado un certificado. Tras la eliminación, Envoy añade su propia cabecera `X-Forwarded-Client-Cert` con el certificado presentado y su cadena, de modo que los servicios que leen la identidad del certificado reciben solo valores generados por el Gateway. Ningún valor de Helm modifica la lista de cabeceras eliminadas. La página Control de acceso describe cómo aprovecha `authz` esta protección para mantener `X-Principal-ID` fuera del alcance de los clientes.",{"_3731":73786,"_31485":73725,"_21804":122532,"_5":15036,"_28646":122377,"_3122":122533},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3731":73787,"_31485":73725,"_21804":122535,"_5":15036,"_28646":122377,"_3122":122536},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3731":73788,"_31485":73725,"_21804":122538,"_5":15036,"_28646":122377,"_3122":122539},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3731":73789,"_31485":73725,"_21804":122541,"_5":15036,"_28646":122377,"_3122":122542},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3731":73790,"_31485":73725,"_21804":122544,"_5":15036,"_28646":122377,"_3122":122545},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3731":73791,"_31485":73725,"_21804":122547,"_5":15036,"_28646":122381,"_3122":122548},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3731":73792,"_31485":73725,"_21804":122550,"_5":15036,"_28646":122381,"_3122":122551},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3731":73793,"_31485":73725,"_21804":122553,"_5":15036,"_28646":122385,"_3122":122554},[],"Comprueba, en orden:",{"_3731":73794,"_31485":73725,"_21804":122556,"_5":15036,"_28646":122385,"_3122":122557},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3731":73795,"_31485":73725,"_21804":122559,"_5":15036,"_28646":122385,"_3122":122560},[],"Su estado contiene la dirección esperada.",{"_3731":73796,"_31485":73725,"_21804":122562,"_5":15036,"_28646":122385,"_3122":122563},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3731":73797,"_31485":73725,"_21804":122565,"_5":15036,"_28646":122385,"_3122":122566},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3731":73798,"_31485":73725,"_21804":122568,"_5":15036,"_28646":122385,"_3122":122569},[],"DNS resuelve al endpoint accesible externamente.",{"_3731":73799,"_31485":73725,"_21804":122571,"_5":15036,"_28646":122385,"_3122":122572},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3731":73800,"_31485":73725,"_21804":122574,"_5":15036,"_28646":122385,"_3122":122575},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3731":73801,"_31485":73801,"_5":15390,"_3122":51480,"_31812":122577,"_21804":122578,"_28646":73801},[51373,121504,121738],[],{"_3731":73802,"_31485":73801,"_21804":122580,"_5":15036,"_28646":73801,"_3122":122581},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3731":73803,"_31485":73801,"_5":31809,"_21804":122583,"_28646":122584,"_3122":122585},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3731":73804,"_31485":73801,"_5":31809,"_21804":122587,"_28646":122588,"_3122":122589},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3731":73805,"_31485":73801,"_5":31809,"_21804":122591,"_28646":122592,"_3122":122593},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3731":73806,"_31485":73801,"_5":31809,"_21804":122595,"_28646":122596,"_3122":122597},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3731":73807,"_31485":73801,"_5":31809,"_21804":122599,"_28646":122600,"_3122":122601},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3731":73808,"_31485":73801,"_5":31809,"_21804":122603,"_28646":122604,"_3122":122605},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3731":73809,"_31485":73801,"_21804":122607,"_5":15036,"_28646":122584,"_3122":122608},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3731":73810,"_31485":73801,"_21804":122610,"_5":15036,"_28646":122588,"_3122":122611},[],"Flujo",{"_3731":73811,"_31485":73801,"_21804":122613,"_5":15036,"_28646":122588,"_3122":122614},[],"Úsalo para",{"_3731":73812,"_31485":73801,"_21804":122616,"_5":15036,"_28646":122588,"_3122":122617},[],"Qué instala",{"_3731":73813,"_31485":73801,"_21804":122619,"_5":15036,"_28646":122588,"_3122":52524},[],{"_3731":73814,"_31485":73801,"_21804":122621,"_5":15036,"_28646":122588,"_3122":122622},[],"Producción y entornos controlados",{"_3731":73815,"_31485":73801,"_21804":122624,"_5":15036,"_28646":122588,"_3122":122625},[],"Servicios de Lamassu y recursos de Gateway API",{"_3731":73816,"_31485":73801,"_21804":122627,"_5":15036,"_28646":122588,"_3122":51617},[],{"_3731":73817,"_31485":73801,"_21804":122629,"_5":15036,"_28646":122588,"_3122":122630},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3731":73818,"_31485":73801,"_21804":122632,"_5":15036,"_28646":122588,"_3122":122633},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3731":73819,"_31485":73801,"_21804":122635,"_5":15036,"_28646":122592,"_3122":122636},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3731":73820,"_31485":73801,"_21804":122638,"_5":15036,"_28646":122592,"_3122":122639},[],"Área",{"_3731":73821,"_31485":73801,"_21804":122641,"_5":15036,"_28646":122592,"_3122":122642},[],"El chart de Lamassu proporciona",{"_3731":73822,"_31485":73801,"_21804":122644,"_5":15036,"_28646":122592,"_3122":122645},[],"Tú proporcionas",{"_3731":73823,"_31485":73801,"_21804":122647,"_5":15036,"_28646":122592,"_3122":122648},[],"Aplicaciones Lamassu",{"_3731":73824,"_31485":73801,"_21804":122650,"_5":15036,"_28646":122592,"_3122":122651},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3731":73825,"_31485":73801,"_21804":122653,"_5":15036,"_28646":122592,"_3122":122654},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3731":73826,"_31485":73801,"_21804":122656,"_5":15036,"_28646":122592,"_3122":122657},[],"Datos PostgreSQL",{"_3731":73827,"_31485":73801,"_21804":122659,"_5":15036,"_28646":122592,"_3122":122660},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3731":73828,"_31485":73801,"_21804":122662,"_5":15036,"_28646":122592,"_3122":122663},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3731":73829,"_31485":73801,"_21804":122665,"_5":15036,"_28646":122592,"_3122":122666},[],"Mensajería",{"_3731":73830,"_31485":73801,"_21804":122668,"_5":15036,"_28646":122592,"_3122":122669},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3731":73831,"_31485":73801,"_21804":122671,"_5":15036,"_28646":122592,"_3122":122672},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3731":73832,"_31485":73801,"_21804":122674,"_5":15036,"_28646":122592,"_3122":122675},[],"Identidad",{"_3731":73833,"_31485":73801,"_21804":122677,"_5":15036,"_28646":122592,"_3122":122678},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3731":73834,"_31485":73801,"_21804":122680,"_5":15036,"_28646":122592,"_3122":122681},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3731":73835,"_31485":73801,"_21804":122683,"_5":15036,"_28646":122592,"_3122":122684},[],"Enrutamiento externo",{"_3731":73836,"_31485":73801,"_21804":122686,"_5":15036,"_28646":122592,"_3122":122687},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3731":73837,"_31485":73801,"_21804":122689,"_5":15036,"_28646":122592,"_3122":122690},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3731":73838,"_31485":73801,"_21804":122692,"_5":15036,"_28646":122592,"_3122":52598},[],{"_3731":73839,"_31485":73801,"_21804":122694,"_5":15036,"_28646":122592,"_3122":122695},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3731":73840,"_31485":73801,"_21804":122697,"_5":15036,"_28646":122592,"_3122":122698},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3731":73841,"_31485":73801,"_21804":122700,"_5":15036,"_28646":122592,"_3122":122701},[],"Datos persistentes de la aplicación",{"_3731":73842,"_31485":73801,"_21804":122703,"_5":15036,"_28646":122592,"_3122":122704},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3731":73843,"_31485":73801,"_21804":122706,"_5":15036,"_28646":122592,"_3122":122707},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3731":73844,"_31485":73801,"_21804":122709,"_5":15036,"_28646":122592,"_3122":122710},[],"Integraciones opcionales",{"_3731":73845,"_31485":73801,"_21804":122712,"_5":15036,"_28646":122592,"_3122":122713},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3731":73846,"_31485":73801,"_21804":122715,"_5":15036,"_28646":122592,"_3122":122716},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3731":73847,"_31485":73801,"_21804":122718,"_5":15036,"_28646":122592,"_3122":122719},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3731":73848,"_31485":73801,"_21804":122721,"_5":15036,"_28646":122592,"_3122":122722},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3731":73849,"_31485":73801,"_21804":122724,"_5":15036,"_28646":122596,"_3122":122725},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3731":73850,"_31485":73801,"_21804":122727,"_5":15036,"_28646":122596,"_3122":122728},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3731":73851,"_31485":73801,"_21804":122730,"_5":15036,"_28646":122600,"_3122":122731},[],"Kubernetes 1.24 o posterior",{"_3731":73852,"_31485":73801,"_21804":122733,"_5":15036,"_28646":122600,"_3122":122734},[],"Helm 3.2 o posterior",{"_3731":73853,"_31485":73801,"_21804":122736,"_5":15036,"_28646":122600,"_3122":122737},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3731":73854,"_31485":73801,"_21804":122739,"_5":15036,"_28646":122600,"_3122":122740},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3731":73855,"_31485":73801,"_21804":122742,"_5":15036,"_28646":122600,"_3122":122743},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3731":73856,"_31485":73801,"_21804":122745,"_5":15036,"_28646":122600,"_3122":122746},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3731":73857,"_31485":73801,"_21804":122748,"_5":15036,"_28646":122600,"_3122":122749},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3731":73858,"_31485":73801,"_21804":122751,"_5":15036,"_28646":122604,"_3122":122752},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3731":73859,"_31485":73801,"_21804":122754,"_5":15036,"_28646":122604,"_3122":122755},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3731":73860,"_31485":73801,"_21804":122757,"_5":15036,"_28646":122604,"_3122":122758},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3731":73861,"_31485":73801,"_21804":122760,"_5":15036,"_28646":122604,"_3122":122761},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3731":73862,"_31485":73862,"_5":15390,"_3122":122763,"_31812":122764,"_21804":122766,"_28646":73862},"Resolución de problemas de despliegue",[51373,121504,122765],"Operación",[],{"_3731":73863,"_31485":73862,"_21804":122768,"_5":15036,"_28646":73862,"_3122":122769},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3731":73864,"_31485":73862,"_5":31809,"_21804":122771,"_28646":122772,"_3122":122773},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3731":73865,"_31485":73862,"_5":31809,"_21804":122775,"_28646":122776,"_3122":122777},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3731":73866,"_31485":73862,"_5":31809,"_21804":122779,"_28646":122780,"_3122":122781},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3731":73867,"_31485":73862,"_5":31809,"_21804":122783,"_28646":122784,"_3122":122785},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3731":73868,"_31485":73862,"_5":31809,"_21804":122787,"_28646":122788,"_3122":122789},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3731":73869,"_31485":73862,"_5":31809,"_21804":122791,"_28646":122792,"_3122":122793},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3731":73870,"_31485":73862,"_5":31809,"_21804":122795,"_28646":122796,"_3122":122797},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3731":73871,"_31485":73862,"_5":31809,"_21804":122799,"_28646":122800,"_3122":122801},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3731":73872,"_31485":73862,"_5":31809,"_21804":122803,"_28646":122804,"_3122":122805},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3731":73873,"_31485":73862,"_5":31809,"_21804":122807,"_28646":122808,"_3122":122809},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3731":73874,"_31485":73862,"_5":31809,"_21804":122811,"_28646":122812,"_3122":122813},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3731":73875,"_31485":73862,"_5":31809,"_21804":122815,"_28646":122816,"_3122":122817},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3731":73876,"_31485":73862,"_5":31809,"_21804":122819,"_28646":122820,"_3122":122821},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3731":73877,"_31485":73862,"_21804":122823,"_5":15036,"_28646":73862,"_3122":122824},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3731":73878,"_31485":73862,"_21804":122826,"_5":15036,"_28646":122776,"_3122":122827},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3731":73879,"_31485":73862,"_21804":122829,"_5":15036,"_28646":122780,"_3122":122830},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3731":73880,"_31485":73862,"_21804":122832,"_5":15036,"_28646":122784,"_3122":122833},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3731":73881,"_31485":73862,"_21804":122835,"_5":15036,"_28646":122788,"_3122":122836},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3731":73882,"_31485":73862,"_21804":122838,"_5":15036,"_28646":122792,"_3122":122839},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3731":73883,"_31485":73862,"_21804":122841,"_5":15036,"_28646":122796,"_3122":122842},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3731":73884,"_31485":73862,"_21804":122844,"_5":15036,"_28646":122796,"_3122":122845},[],"Ejecuta también la prueba de conectividad del chart:",{"_3731":73885,"_31485":73862,"_21804":122847,"_5":15036,"_28646":122796,"_3122":122848},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3731":73886,"_31485":73862,"_21804":122850,"_5":15036,"_28646":122796,"_3122":122851},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3731":73887,"_31485":73862,"_21804":122853,"_5":15036,"_28646":122800,"_3122":122854},[],"Si recibes un 401:",{"_3731":73888,"_31485":73862,"_21804":122856,"_5":15036,"_28646":122800,"_3122":122857},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3731":73889,"_31485":73862,"_21804":122859,"_5":15036,"_28646":122800,"_3122":122860},[],"verifica emisor, audiencia y expiración del token;",{"_3731":73890,"_31485":73862,"_21804":122862,"_5":15036,"_28646":122800,"_3122":122863},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3731":73891,"_31485":73862,"_21804":122865,"_5":15036,"_28646":122800,"_3122":122866},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3731":73892,"_31485":73862,"_21804":122868,"_5":15036,"_28646":122800,"_3122":122869},[],"Si el login termina pero las APIs devuelven 403:",{"_3731":73893,"_31485":73862,"_21804":122871,"_5":15036,"_28646":122800,"_3122":122872},[],"inspecciona los claims reales del token;",{"_3731":73894,"_31485":73862,"_21804":122874,"_5":15036,"_28646":122800,"_3122":122875},[],"confirma que coinciden con un principal activo;",{"_3731":73895,"_31485":73862,"_21804":122877,"_5":15036,"_28646":122800,"_3122":122878},[],"revisa las políticas concedidas al principal;",{"_3731":73896,"_31485":73862,"_21804":122880,"_5":15036,"_28646":122800,"_3122":122881},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3731":73897,"_31485":73862,"_21804":122883,"_5":15036,"_28646":122800,"_3122":122884},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3731":73898,"_31485":73862,"_21804":122886,"_5":15036,"_28646":122804,"_3122":122887},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3731":73899,"_31485":73862,"_21804":122889,"_5":15036,"_28646":122804,"_3122":122890},[],"Localiza el pod y Service de authz.",{"_3731":73900,"_31485":73862,"_21804":122892,"_5":15036,"_28646":122804,"_3122":122893},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3731":73901,"_31485":73862,"_21804":122895,"_5":15036,"_28646":122804,"_3122":122896},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3731":73902,"_31485":73862,"_21804":122898,"_5":15036,"_28646":122804,"_3122":122899},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3731":73903,"_31485":73862,"_21804":122901,"_5":15036,"_28646":122804,"_3122":122902},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3731":73904,"_31485":73862,"_21804":122904,"_5":15036,"_28646":122808,"_3122":122905},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3731":73905,"_31485":73862,"_21804":122907,"_5":15036,"_28646":122812,"_3122":122908},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3731":73906,"_31485":73862,"_21804":122910,"_5":15036,"_28646":122812,"_3122":122911},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3731":73907,"_31485":73862,"_21804":122913,"_5":15036,"_28646":122812,"_3122":122914},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3731":73908,"_31485":73862,"_21804":122916,"_5":15036,"_28646":122812,"_3122":122917},[],"volumen persistente sin enlazar;",{"_3731":73909,"_31485":73862,"_21804":122919,"_5":15036,"_28646":122812,"_3122":122920},[],"imagen inaccesible o política de pull incorrecta;",{"_3731":73910,"_31485":73862,"_21804":122922,"_5":15036,"_28646":122812,"_3122":122923},[],"configuración inválida del motor criptográfico;",{"_3731":73911,"_31485":73862,"_21804":122925,"_5":15036,"_28646":122812,"_3122":122926},[],"límites de CPU o memoria demasiado bajos;",{"_3731":73912,"_31485":73862,"_21804":122928,"_5":15036,"_28646":122812,"_3122":122929},[],"migración previa incompleta.",{"_3731":73913,"_31485":73862,"_21804":122931,"_5":15036,"_28646":122812,"_3122":122932},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3731":73914,"_31485":73862,"_21804":122934,"_5":15036,"_28646":122812,"_3122":122935},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3731":73915,"_31485":73862,"_21804":122937,"_5":15036,"_28646":122812,"_3122":122938},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3731":73916,"_31485":73862,"_21804":122940,"_5":15036,"_28646":122816,"_3122":122941},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3731":73917,"_31485":73862,"_21804":122943,"_5":15036,"_28646":122816,"_3122":122944},[],"verifica que esté habilitado en el servicio emisor;",{"_3731":73918,"_31485":73862,"_21804":122946,"_5":15036,"_28646":122816,"_3122":122947},[],"comprueba conectividad y credenciales AMQP;",{"_3731":73919,"_31485":73862,"_21804":122949,"_5":15036,"_28646":122816,"_3122":122950},[],"revisa exchange, routing key, colas y consumidores;",{"_3731":73920,"_31485":73862,"_21804":122952,"_5":15036,"_28646":122816,"_3122":122953},[],"inspecciona dead-letter queues;",{"_3731":73921,"_31485":73862,"_21804":122955,"_5":15036,"_28646":122816,"_3122":122956},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3731":73922,"_31485":73862,"_21804":122958,"_5":15036,"_28646":122816,"_3122":122959},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3731":73923,"_31485":73862,"_21804":122961,"_5":15036,"_28646":122816,"_3122":122962},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3731":73924,"_31485":73862,"_21804":122964,"_5":15036,"_28646":122816,"_3122":122965},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3731":73925,"_31485":73862,"_21804":122967,"_5":15036,"_28646":122816,"_3122":122968},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3731":73926,"_31485":73862,"_21804":122970,"_5":15036,"_28646":122816,"_3122":122971},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3731":73927,"_31485":73862,"_21804":122973,"_5":15036,"_28646":122816,"_3122":122974},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3731":73928,"_31485":73862,"_21804":122976,"_5":15036,"_28646":122816,"_3122":122977},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3731":73929,"_31485":73862,"_21804":122979,"_5":15036,"_28646":122820,"_3122":122980},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3731":73930,"_31485":73862,"_21804":122982,"_5":15036,"_28646":122820,"_3122":122983},[],"Antes de cerrar una incidencia, guarda:",{"_3731":73931,"_31485":73862,"_21804":122985,"_5":15036,"_28646":122820,"_3122":122986},[],"causa confirmada;",{"_3731":73932,"_31485":73862,"_21804":122988,"_5":15036,"_28646":122820,"_3122":122989},[],"alcance temporal y recursos afectados;",{"_3731":73933,"_31485":73862,"_21804":122991,"_5":15036,"_28646":122820,"_3122":122992},[],"comandos o consultas utilizados;",{"_3731":73934,"_31485":73862,"_21804":122994,"_5":15036,"_28646":122820,"_3122":122995},[],"cambio aplicado y forma de revertirlo;",{"_3731":73935,"_31485":73862,"_21804":122997,"_5":15036,"_28646":122820,"_3122":122998},[],"validación desde un consumidor;",{"_3731":73936,"_31485":73862,"_21804":123000,"_5":15036,"_28646":122820,"_3122":123001},[],"acción preventiva y propietario.",{"_3731":73937,"_31485":73937,"_5":15390,"_3122":123003,"_31812":123004,"_21804":123008,"_28646":73937},"Modelo de datos",[51373,123005,123006,123007],"Plataforma","Administración","Control de acceso",[],{"_3731":73938,"_31485":73937,"_21804":123010,"_5":15036,"_28646":73937,"_3122":123011},[],"Entidades y relaciones del esquema pki.json que utiliza authz para evaluar políticas de acceso.",{"_3731":73939,"_31485":73937,"_5":31809,"_21804":123013,"_28646":123014,"_3122":123015},[],"/docs/es/platform/administration/access-control/data-model#relaciones-del-esquema","Relaciones del esquema",{"_3731":73940,"_31485":73937,"_5":31809,"_21804":123017,"_28646":123018,"_3122":123019},[],"/docs/es/platform/administration/access-control/data-model#entidades-del-esquema","Entidades del esquema",{"_3731":73941,"_31485":73937,"_21804":123021,"_5":15036,"_28646":73937,"_3122":123022},[],"El esquema `connectors/authz/pki.json` define las entidades del dominio `pki` para el control de acceso. Una política identifica el tipo de recurso mediante `namespace: pki`, `schema_name` y `entity_type`. Por ejemplo, `ca.certificate` corresponde al esquema `ca` y al tipo de entidad `certificate`.",{"_3731":73942,"_31485":73937,"_21804":123024,"_5":15036,"_28646":123014,"_3122":123025},[],"Cada flecha sale de la entidad que declara la relación y apunta a su `target_entity`. Debajo de la etiqueta aparece el valor de `foreign_key`, la columna de origen. En `pki.json`, el `name` de cada relación coincide con esa columna. El diagrama se puede pulsar para ampliarlo y recorrerlo.",{"_3731":73943,"_31485":73937,"_21804":123027,"_5":15036,"_28646":123014,"_3122":123028},[],"Una política puede propagar acciones desde la entidad referenciada hacia la que declara la relación. Por ejemplo, para conceder lectura de los dispositivos de un DMS, la regla parte de `dmsmanager.dms`, apunta a `devicemanager.device` y especifica `via: dms_owner`.",{"_3731":73944,"_31485":73937,"_21804":123030,"_5":15036,"_28646":123014,"_3122":123031},[],"En los filtros de acceso heredado, `authz` compara la columna `foreign_key` con la primera columna de `primary_key` de la entidad referenciada. Así, `subject_common_name` se compara con `device.id`, `issuer_meta_serial_number` con `ca_certificate.id` y los enlaces hacia `kms_key` con `kms_key.key_id`.",{"_3731":73945,"_31485":73937,"_21804":123033,"_5":15036,"_28646":123018,"_3122":123034},[],"Entidad (`schema_name.entity_type`)",{"_3731":73946,"_31485":73937,"_21804":123036,"_5":15036,"_28646":123018,"_3122":123037},[],"Tabla (`table_name`)",{"_3731":73947,"_31485":73937,"_21804":123039,"_5":15036,"_28646":123018,"_3122":123040},[],"Clave (`primary_key`)",{"_3731":73948,"_31485":73937,"_21804":123042,"_5":15036,"_28646":123018,"_3122":52949},[],{"_3731":73949,"_31485":73937,"_21804":123044,"_5":15036,"_28646":123018,"_3122":52952},[],{"_3731":73950,"_31485":73937,"_21804":123046,"_5":15036,"_28646":123018,"_3122":52955},[],{"_3731":73951,"_31485":73937,"_21804":123048,"_5":15036,"_28646":123018,"_3122":52958},[],{"_3731":73952,"_31485":73937,"_21804":123050,"_5":15036,"_28646":123018,"_3122":52961},[],{"_3731":73953,"_31485":73937,"_21804":123052,"_5":15036,"_28646":123018,"_3122":52964},[],{"_3731":73954,"_31485":73937,"_21804":123054,"_5":15036,"_28646":123018,"_3122":52967},[],{"_3731":73955,"_31485":73937,"_21804":123056,"_5":15036,"_28646":123018,"_3122":52970},[],{"_3731":73956,"_31485":73937,"_21804":123058,"_5":15036,"_28646":123018,"_3122":52964},[],{"_3731":73957,"_31485":73937,"_21804":123060,"_5":15036,"_28646":123018,"_3122":52975},[],{"_3731":73958,"_31485":73937,"_21804":123062,"_5":15036,"_28646":123018,"_3122":52978},[],{"_3731":73959,"_31485":73937,"_21804":123064,"_5":15036,"_28646":123018,"_3122":52981},[],{"_3731":73960,"_31485":73937,"_21804":123066,"_5":15036,"_28646":123018,"_3122":52984},[],{"_3731":73961,"_31485":73937,"_21804":123068,"_5":15036,"_28646":123018,"_3122":52987},[],{"_3731":73962,"_31485":73937,"_21804":123070,"_5":15036,"_28646":123018,"_3122":52964},[],{"_3731":73963,"_31485":73937,"_21804":123072,"_5":15036,"_28646":123018,"_3122":52992},[],{"_3731":73964,"_31485":73937,"_21804":123074,"_5":15036,"_28646":123018,"_3122":52995},[],{"_3731":73965,"_31485":73937,"_21804":123076,"_5":15036,"_28646":123018,"_3122":52964},[],{"_3731":73966,"_31485":73937,"_21804":123078,"_5":15036,"_28646":123018,"_3122":53000},[],{"_3731":73967,"_31485":73937,"_21804":123080,"_5":15036,"_28646":123018,"_3122":53003},[],{"_3731":73968,"_31485":73937,"_21804":123082,"_5":15036,"_28646":123018,"_3122":52964},[],{"_3731":73969,"_31485":73937,"_21804":123084,"_5":15036,"_28646":123018,"_3122":53008},[],{"_3731":73970,"_31485":73937,"_21804":123086,"_5":15036,"_28646":123018,"_3122":53011},[],{"_3731":73971,"_31485":73937,"_21804":123088,"_5":15036,"_28646":123018,"_3122":52964},[],{"_3731":73972,"_31485":73937,"_21804":123090,"_5":15036,"_28646":123018,"_3122":53016},[],{"_3731":73973,"_31485":73937,"_21804":123092,"_5":15036,"_28646":123018,"_3122":53019},[],{"_3731":73974,"_31485":73937,"_21804":123094,"_5":15036,"_28646":123018,"_3122":53022},[],{"_3731":73975,"_31485":73937,"_21804":123096,"_5":15036,"_28646":123018,"_3122":53025},[],{"_3731":73976,"_31485":73937,"_21804":123098,"_5":15036,"_28646":123018,"_3122":53028},[],{"_3731":73977,"_31485":73937,"_21804":123100,"_5":15036,"_28646":123018,"_3122":53031},[],{"_3731":73978,"_31485":73937,"_21804":123102,"_5":15036,"_28646":123018,"_3122":123103},[],"Los eventos, las suscripciones y los grupos de dispositivos tienen acciones y filtros propios. Sus listas `relations` están vacías y tienen cero referencias entrantes en el esquema. Para `ca.certificate`, `view_tables` también registra `certificates_view`.",{"_3731":73979,"_31485":73937,"_21804":123105,"_5":15036,"_28646":123018,"_3122":123106},[],"Cada entidad declara sus acciones sobre instancias en `atomic_actions`, sus acciones sin identificador de recurso en `global_actions` y las columnas y tipos que admite en `column_filters` mediante `filterable`.",{"_3731":73980,"_31485":73937,"_21804":123108,"_5":15036,"_28646":123018,"_3122":123109},[],"<Card title=\"Acceso heredado por relaciones\" href=\"/docs/platform/administration/access-control#acceso-heredado-por-relaciones\" />",{"_3731":73981,"_31485":73981,"_5":15390,"_3122":123111,"_31812":123112,"_21804":123113,"_28646":73981},"Visión general del control de acceso",[51373,123005,123006,123007],[],{"_3731":73982,"_31485":73981,"_21804":123115,"_5":15036,"_28646":73981,"_3122":123116},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3731":73983,"_31485":73981,"_5":31809,"_21804":123118,"_28646":123119,"_3122":123120},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3731":73984,"_31485":73981,"_5":31809,"_21804":123122,"_28646":123123,"_3122":123124},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3731":73985,"_31485":73981,"_5":31809,"_21804":123126,"_28646":123127,"_3122":123128},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3731":73986,"_31485":73981,"_5":31809,"_21804":123130,"_28646":123131,"_3122":123132},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3731":73987,"_31485":73981,"_5":31809,"_21804":123134,"_28646":123135,"_3122":123136},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3731":73988,"_31485":73981,"_5":31809,"_21804":123138,"_28646":123139,"_3122":123140},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3731":73989,"_31485":73981,"_5":31809,"_21804":123142,"_28646":123143,"_3122":123144},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3731":73990,"_31485":73981,"_5":31809,"_21804":123146,"_28646":123147,"_3122":123148},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3731":73991,"_31485":73981,"_5":31809,"_21804":123150,"_28646":123151,"_3122":123152},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3731":73992,"_31485":73981,"_5":31809,"_21804":123154,"_28646":123155,"_3122":123156},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3731":73993,"_31485":73981,"_5":31809,"_21804":123158,"_28646":123159,"_3122":123160},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3731":73994,"_31485":73981,"_5":31809,"_21804":123162,"_28646":123163,"_3122":123164},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3731":73995,"_31485":73981,"_5":31809,"_21804":123166,"_28646":123167,"_3122":123168},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3731":73996,"_31485":73981,"_5":31809,"_21804":123170,"_28646":123171,"_3122":123172},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3731":73997,"_31485":73981,"_5":31809,"_21804":123174,"_28646":123175,"_3122":123176},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3731":73998,"_31485":73981,"_5":31809,"_21804":123178,"_28646":123179,"_3122":122124},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3731":73999,"_31485":73981,"_5":31809,"_21804":123181,"_28646":123182,"_3122":123183},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3731":74000,"_31485":73981,"_5":31809,"_21804":123185,"_28646":123186,"_3122":123187},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3731":74001,"_31485":73981,"_5":31809,"_21804":123189,"_28646":123190,"_3122":123191},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3731":74002,"_31485":73981,"_5":31809,"_21804":123193,"_28646":123194,"_3122":123195},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3731":74003,"_31485":73981,"_5":31809,"_21804":123197,"_28646":123198,"_3122":123199},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3731":74004,"_31485":73981,"_5":31809,"_21804":123201,"_28646":123202,"_3122":123203},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3731":74005,"_31485":73981,"_5":31809,"_21804":123205,"_28646":123206,"_3122":123207},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3731":74006,"_31485":73981,"_5":31809,"_21804":123209,"_28646":123210,"_3122":123211},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3731":74007,"_31485":73981,"_5":31809,"_21804":123213,"_28646":123214,"_3122":123215},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3731":74008,"_31485":73981,"_5":31809,"_21804":123217,"_28646":123218,"_3122":123219},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3731":74009,"_31485":73981,"_5":31809,"_21804":123221,"_28646":123222,"_3122":123223},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3731":74010,"_31485":73981,"_5":31809,"_21804":123225,"_28646":123226,"_3122":123227},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3731":74011,"_31485":73981,"_5":31809,"_21804":123229,"_28646":123230,"_3122":123231},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3731":74012,"_31485":73981,"_5":31809,"_21804":123233,"_28646":123234,"_3122":123235},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3731":74013,"_31485":73981,"_5":31809,"_21804":123237,"_28646":123238,"_3122":123239},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3731":74014,"_31485":73981,"_21804":123241,"_5":15036,"_28646":73981,"_3122":123242},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3731":74015,"_31485":73981,"_21804":123244,"_5":15036,"_28646":73981,"_3122":123245},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3731":74016,"_31485":73981,"_21804":123247,"_5":15036,"_28646":73981,"_3122":123248},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3731":74017,"_31485":73981,"_21804":123250,"_5":15036,"_28646":123119,"_3122":123251},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3731":74018,"_31485":73981,"_21804":123253,"_5":15036,"_28646":123119,"_3122":123254},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3731":74019,"_31485":73981,"_21804":123256,"_5":15036,"_28646":123119,"_3122":123257},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3731":74020,"_31485":73981,"_21804":123259,"_5":15036,"_28646":123119,"_3122":123260},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3731":74021,"_31485":73981,"_21804":123262,"_5":15036,"_28646":123119,"_3122":123263},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3731":74022,"_31485":73981,"_21804":123265,"_5":15036,"_28646":123119,"_3122":123266},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3731":74023,"_31485":73981,"_21804":123268,"_5":15036,"_28646":123123,"_3122":123269},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3731":74024,"_31485":73981,"_21804":123271,"_5":15036,"_28646":123123,"_3122":123272},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3731":74025,"_31485":73981,"_21804":123274,"_5":15036,"_28646":123127,"_3122":123275},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3731":74026,"_31485":73981,"_21804":123277,"_5":15036,"_28646":123127,"_3122":123278},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3731":74027,"_31485":73981,"_21804":123280,"_5":15036,"_28646":123127,"_3122":123281},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3731":74028,"_31485":73981,"_21804":123283,"_5":15036,"_28646":123127,"_3122":123284},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3731":74029,"_31485":73981,"_21804":123286,"_5":15036,"_28646":123127,"_3122":123287},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3731":74030,"_31485":73981,"_21804":123289,"_5":15036,"_28646":123127,"_3122":123290},[],"Carga por separado las políticas concedidas a cada principal.",{"_3731":74031,"_31485":73981,"_21804":123292,"_5":15036,"_28646":123127,"_3122":123293},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3731":74032,"_31485":73981,"_21804":123295,"_5":15036,"_28646":123127,"_3122":123296},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3731":74033,"_31485":73981,"_21804":123298,"_5":15036,"_28646":123127,"_3122":123299},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3731":74034,"_31485":73981,"_21804":123301,"_5":15036,"_28646":123127,"_3122":123302},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3731":74035,"_31485":73981,"_21804":123304,"_5":15036,"_28646":123127,"_3122":123305},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad. Los clientes no pueden falsificarla: el Gateway elimina la cabecera `X-Principal-Id` suministrada por el cliente (y las demás cabeceras de identidad y certificado reenviadas) antes de reenviar, de modo que solo `authz` puede establecerla. Consulta Expón el Gateway para ver la lista completa de cabeceras eliminadas.",{"_3731":74036,"_31485":73981,"_21804":123307,"_5":15036,"_28646":123127,"_3122":123308},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3731":74037,"_31485":73981,"_21804":123310,"_5":15036,"_28646":123131,"_3122":123311},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3731":74038,"_31485":73981,"_21804":123313,"_5":15036,"_28646":123131,"_3122":123314},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3731":74039,"_31485":73981,"_21804":123316,"_5":15036,"_28646":123131,"_3122":123317},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3731":74040,"_31485":73981,"_21804":123319,"_5":15036,"_28646":123131,"_3122":123320},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3731":74041,"_31485":73981,"_21804":123322,"_5":15036,"_28646":123131,"_3122":123323},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3731":74042,"_31485":73981,"_21804":123325,"_5":15036,"_28646":123131,"_3122":123326},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3731":74043,"_31485":73981,"_21804":123328,"_5":15036,"_28646":123131,"_3122":123329},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3731":74044,"_31485":73981,"_21804":123331,"_5":15036,"_28646":123131,"_3122":123332},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3731":74045,"_31485":73981,"_21804":123334,"_5":15036,"_28646":123131,"_3122":123335},[],"Un esquema también puede hacer que una ruta individual acepte la credencial por la URL. **`query_token: true` en una ruta** hace que acepte el token de acceso OIDC del parámetro de consulta `access_token`, pero solo cuando la petición no lleva ni una cabecera `Authorization: Bearer` ni una cabecera de certificado de cliente: la credencial en una cabecera siempre prevalece. El token se valida y autoriza exactamente igual que un token Bearer, así que la acción de la ruta sigue exigiendo un grant, y las rutas que no activan esta opción nunca leen el parámetro de consulta. La terminal experimental del dashboard usa este mecanismo, porque la conexión WebSocket que abre su cliente de navegador no puede establecer cabeceras de petición.",{"_3731":74046,"_31485":73981,"_21804":123337,"_5":15036,"_28646":123131,"_3122":123338},[],"Las cadenas de consulta suelen quedar registradas. `authz` sustituye el valor de `access_token` por `REDACTED` en sus propios logs de decisión, pero otros logs que capturan la URL —el access log del Gateway, los logs de petición de los servicios, el tracing— no la redactan. Reserva `query_token` para rutas WebSocket y tokens de corta duración.",{"_3731":74047,"_31485":73981,"_21804":123340,"_5":15036,"_28646":123135,"_3122":123341},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3731":74048,"_31485":73981,"_21804":123343,"_5":15036,"_28646":123135,"_3122":123344},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3731":74049,"_31485":73981,"_21804":123346,"_5":15036,"_28646":123135,"_3122":123347},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3731":74050,"_31485":73981,"_21804":123349,"_5":15036,"_28646":123135,"_3122":123350},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3731":74051,"_31485":73981,"_21804":123352,"_5":15036,"_28646":123135,"_3122":123353},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3731":74052,"_31485":73981,"_21804":123355,"_5":15036,"_28646":123135,"_3122":123356},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3731":74053,"_31485":73981,"_21804":123358,"_5":15036,"_28646":123135,"_3122":123359},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3731":74054,"_31485":73981,"_21804":123361,"_5":15036,"_28646":123135,"_3122":123362},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3731":74055,"_31485":73981,"_21804":123364,"_5":15036,"_28646":123135,"_3122":123365},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3731":74056,"_31485":73981,"_21804":123367,"_5":15036,"_28646":123135,"_3122":123368},[],"Las acciones se dividen en dos grupos:",{"_3731":74057,"_31485":73981,"_21804":123370,"_5":15036,"_28646":123135,"_3122":123371},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3731":74058,"_31485":73981,"_21804":123373,"_5":15036,"_28646":123135,"_3122":123374},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3731":74059,"_31485":73981,"_21804":123376,"_5":15036,"_28646":123135,"_3122":123377},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3731":74060,"_31485":73981,"_21804":123379,"_5":15036,"_28646":123139,"_3122":123380},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3731":74061,"_31485":73981,"_21804":123382,"_5":15036,"_28646":123139,"_3122":123383},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3731":74062,"_31485":73981,"_21804":123385,"_5":15036,"_28646":123139,"_3122":123386},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3731":74063,"_31485":73981,"_21804":123388,"_5":15036,"_28646":123143,"_3122":123389},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3731":74064,"_31485":73981,"_21804":123391,"_5":15036,"_28646":123143,"_3122":123392},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3731":74065,"_31485":73981,"_21804":123394,"_5":15036,"_28646":123143,"_3122":123395},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3731":74066,"_31485":73981,"_21804":123397,"_5":15036,"_28646":123143,"_3122":123398},[],"Los operadores implementados son:",{"_3731":74067,"_31485":73981,"_21804":123400,"_5":15036,"_28646":123143,"_3122":123401},[],"`equals`, para igualdad exacta;",{"_3731":74068,"_31485":73981,"_21804":123403,"_5":15036,"_28646":123143,"_3122":123404},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3731":74069,"_31485":73981,"_21804":123406,"_5":15036,"_28646":123143,"_3122":123407},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3731":74070,"_31485":73981,"_21804":123409,"_5":15036,"_28646":123143,"_3122":123410},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3731":74071,"_31485":73981,"_21804":123412,"_5":15036,"_28646":123147,"_3122":123413},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3731":74072,"_31485":73981,"_21804":123415,"_5":15036,"_28646":123147,"_3122":123416},[],"Los modos disponibles son:",{"_3731":74073,"_31485":73981,"_21804":123418,"_5":15036,"_28646":123147,"_3122":123419},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3731":74074,"_31485":73981,"_21804":123421,"_5":15036,"_28646":123147,"_3122":123422},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3731":74075,"_31485":73981,"_21804":123424,"_5":15036,"_28646":123147,"_3122":123425},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3731":74076,"_31485":73981,"_21804":123427,"_5":15036,"_28646":123147,"_3122":123428},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3731":74077,"_31485":73981,"_21804":123430,"_5":15036,"_28646":123147,"_3122":123431},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3731":74078,"_31485":73981,"_21804":123433,"_5":15036,"_28646":123147,"_3122":123434},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3731":74079,"_31485":73981,"_21804":123436,"_5":15036,"_28646":123151,"_3122":123437},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3731":74080,"_31485":73981,"_21804":123439,"_5":15036,"_28646":123151,"_3122":123440},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3731":74081,"_31485":73981,"_21804":123442,"_5":15036,"_28646":123151,"_3122":123443},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3731":74082,"_31485":73981,"_21804":123445,"_5":15036,"_28646":123151,"_3122":123446},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3731":74083,"_31485":73981,"_21804":123448,"_5":15036,"_28646":123159,"_3122":123449},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3731":74084,"_31485":73981,"_21804":123451,"_5":15036,"_28646":123159,"_3122":123452},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3731":74085,"_31485":73981,"_21804":123454,"_5":15036,"_28646":123163,"_3122":123455},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora, la de un dispositivo con su DMS y la de un certificado con la clave KMS que almacena su clave privada, de modo que un grant sobre la clave también cubre los certificados que la utilizan. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3731":74086,"_31485":73981,"_21804":123457,"_5":15036,"_28646":123163,"_3122":123458},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3731":74087,"_31485":73981,"_21804":123460,"_5":15036,"_28646":123163,"_3122":123461},[],"El modelo de datos muestra cómo se conectan los recursos sobre los que se aplican las reglas de entidad.",{"_3731":74088,"_31485":73981,"_21804":123463,"_5":15036,"_28646":123163,"_3122":123464},[],"Una regla solo puede seguir relaciones que el esquema de datos declare entre sus dos entidades. Puedes referenciar la relación por su nombre o por su columna de clave foránea —ambas formas son equivalentes— y es el esquema el que decide qué columna utiliza la consulta. Al guardar una política, `authz` comprueba cada relación contra los esquemas cargados: una que ningún esquema declare, o que apunte a una entidad no cargada, se rechaza en ese momento.",{"_3731":74089,"_31485":73981,"_21804":123466,"_5":15036,"_28646":123163,"_3122":123467},[],"Las políticas almacenadas antes de esta validación pueden contener todavía relaciones que los esquemas no declaran. Esa relación no concede nada: `authz` registra una advertencia, `skipping relation that grants nothing`, indicando la política y la relación, y continúa evaluando el resto de la política. La referencia siempre se resuelve contra el esquema antes de construir cualquier consulta, por lo que una relación no declarada nunca puede alterarla. Si el acceso heredado se reduce tras una actualización, busca esta advertencia en los logs de `authz` y corrige la relación de la política afectada.",{"_3731":74090,"_31485":73981,"_21804":123469,"_5":15036,"_28646":123167,"_3122":123470},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3731":74091,"_31485":73981,"_21804":123472,"_5":15036,"_28646":123167,"_3122":123473},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3731":74092,"_31485":73981,"_21804":123475,"_5":15036,"_28646":123167,"_3122":123476},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3731":74093,"_31485":73981,"_21804":123478,"_5":15036,"_28646":123171,"_3122":123479},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3731":74094,"_31485":73981,"_21804":123481,"_5":15036,"_28646":123171,"_3122":123482},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3731":74095,"_31485":73981,"_21804":123484,"_5":15036,"_28646":123171,"_3122":123485},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3731":74096,"_31485":73981,"_21804":123487,"_5":15036,"_28646":123171,"_3122":123488},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3731":74097,"_31485":73981,"_21804":123490,"_5":15036,"_28646":123171,"_3122":123491},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3731":74098,"_31485":73981,"_21804":123493,"_5":15036,"_28646":123171,"_3122":123494},[],"Ten en cuenta que:",{"_3731":74099,"_31485":73981,"_21804":123496,"_5":15036,"_28646":123171,"_3122":123497},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3731":74100,"_31485":73981,"_21804":123499,"_5":15036,"_28646":123171,"_3122":123500},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3731":74101,"_31485":73981,"_21804":123502,"_5":15036,"_28646":123171,"_3122":123503},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3731":74102,"_31485":73981,"_21804":123505,"_5":15036,"_28646":123175,"_3122":123506},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3731":74103,"_31485":73981,"_21804":123508,"_5":15036,"_28646":123175,"_3122":123509},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3731":74104,"_31485":73981,"_21804":123511,"_5":15036,"_28646":123175,"_3122":123512},[],"acceso completo y de solo lectura a KMS;",{"_3731":74105,"_31485":73981,"_21804":123514,"_5":15036,"_28646":123175,"_3122":123515},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3731":74106,"_31485":73981,"_21804":123517,"_5":15036,"_28646":123175,"_3122":123518},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3731":74107,"_31485":73981,"_21804":123520,"_5":15036,"_28646":123175,"_3122":123521},[],"acceso a la interfaz;",{"_3731":74108,"_31485":73981,"_21804":123523,"_5":15036,"_28646":123175,"_3122":123524},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3731":74109,"_31485":73981,"_21804":123526,"_5":15036,"_28646":123175,"_3122":123527},[],"acceso a la terminal experimental del dashboard (Terminal Network);",{"_3731":74110,"_31485":73981,"_21804":123529,"_5":15036,"_28646":123175,"_3122":123530},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3731":74111,"_31485":73981,"_21804":123532,"_5":15036,"_28646":123175,"_3122":123533},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3731":74112,"_31485":73981,"_21804":123535,"_5":15036,"_28646":123175,"_3122":123536},[],"La política de Terminal Network la crea la precarga de `authz` la próxima vez que `authz` arranque tras la actualización. Las políticas precargadas son políticas del sistema —sus identificadores empiezan por `lamassu.`— y no se pueden editar a través de la API.",{"_3731":74113,"_31485":73981,"_21804":123538,"_5":15036,"_28646":123179,"_3122":123539},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3731":74114,"_31485":73981,"_21804":123541,"_5":15036,"_28646":123179,"_3122":123542},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3731":74115,"_31485":73981,"_21804":123544,"_5":15036,"_28646":123179,"_3122":123545},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3731":74116,"_31485":73981,"_21804":123547,"_5":15036,"_28646":123182,"_3122":123548},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3731":74117,"_31485":73981,"_21804":123550,"_5":15036,"_28646":123186,"_3122":123551},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3731":74118,"_31485":73981,"_21804":123553,"_5":15036,"_28646":123186,"_3122":123554},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3731":74119,"_31485":73981,"_21804":123556,"_5":15036,"_28646":123190,"_3122":123557},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3731":74120,"_31485":73981,"_21804":123559,"_5":15036,"_28646":123194,"_3122":123560},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3731":74121,"_31485":73981,"_21804":123562,"_5":15036,"_28646":123198,"_3122":123563},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3731":74122,"_31485":73981,"_21804":123565,"_5":15036,"_28646":123202,"_3122":123566},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3731":74123,"_31485":73981,"_21804":123568,"_5":15036,"_28646":123202,"_3122":123569},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3731":74124,"_31485":73981,"_21804":123571,"_5":15036,"_28646":123206,"_3122":123572},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3731":74125,"_31485":73981,"_21804":123574,"_5":15036,"_28646":123206,"_3122":123575},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3731":74126,"_31485":73981,"_21804":123577,"_5":15036,"_28646":123206,"_3122":123578},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3731":74127,"_31485":73981,"_21804":123580,"_5":15036,"_28646":123206,"_3122":123581},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3731":74128,"_31485":73981,"_21804":123583,"_5":15036,"_28646":123206,"_3122":123584},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3731":74129,"_31485":73981,"_21804":123586,"_5":15036,"_28646":123206,"_3122":123587},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3731":74130,"_31485":73981,"_21804":123589,"_5":15036,"_28646":123206,"_3122":123590},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3731":74131,"_31485":73981,"_21804":123592,"_5":15036,"_28646":123206,"_3122":123593},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3731":74132,"_31485":73981,"_21804":123595,"_5":15036,"_28646":123210,"_3122":123596},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3731":74133,"_31485":73981,"_21804":123598,"_5":15036,"_28646":123210,"_3122":123599},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3731":74134,"_31485":73981,"_21804":123601,"_5":15036,"_28646":123210,"_3122":123602},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3731":74135,"_31485":73981,"_21804":123604,"_5":15036,"_28646":123214,"_3122":123605},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3731":74136,"_31485":73981,"_21804":123607,"_5":15036,"_28646":123214,"_3122":123608},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3731":74137,"_31485":73981,"_21804":123610,"_5":15036,"_28646":123214,"_3122":123611},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3731":74138,"_31485":73981,"_21804":123613,"_5":15036,"_28646":123214,"_3122":123614},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3731":74139,"_31485":73981,"_21804":123616,"_5":15036,"_28646":123214,"_3122":123617},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3731":74140,"_31485":73981,"_21804":123619,"_5":15036,"_28646":123214,"_3122":123620},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3731":74141,"_31485":73981,"_21804":123622,"_5":15036,"_28646":123214,"_3122":123623},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3731":74142,"_31485":73981,"_21804":123625,"_5":15036,"_28646":123214,"_3122":123626},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3731":74143,"_31485":73981,"_21804":123628,"_5":15036,"_28646":123222,"_3122":123629},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3731":74144,"_31485":73981,"_21804":123631,"_5":15036,"_28646":123226,"_3122":123632},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3731":74145,"_31485":73981,"_21804":123634,"_5":15036,"_28646":123226,"_3122":123635},[],"que exista un principal activo del tipo correcto;",{"_3731":74146,"_31485":73981,"_21804":123637,"_5":15036,"_28646":123226,"_3122":123638},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3731":74147,"_31485":73981,"_21804":123640,"_5":15036,"_28646":123226,"_3122":123641},[],"que todas las condiciones del principal se cumplan;",{"_3731":74148,"_31485":73981,"_21804":123643,"_5":15036,"_28646":123226,"_3122":123644},[],"que el principal tenga concedida la política esperada;",{"_3731":74149,"_31485":73981,"_21804":123646,"_5":15036,"_28646":123226,"_3122":123647},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3731":74150,"_31485":73981,"_21804":123649,"_5":15036,"_28646":123226,"_3122":123650},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3731":74151,"_31485":73981,"_21804":123652,"_5":15036,"_28646":123226,"_3122":123653},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3731":74152,"_31485":73981,"_21804":123655,"_5":15036,"_28646":123226,"_3122":123656},[],"Si una política que dependía de acceso heredado dejó de concederlo tras una actualización, busca en los logs de `authz` el mensaje `skipping relation that grants nothing`: la advertencia indica la política y la relación que los esquemas ya no declaran. Corrige la relación de esa política para que coincida con los esquemas actuales.",{"_3731":74153,"_31485":73981,"_21804":123658,"_5":15036,"_28646":123230,"_3122":123659},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3731":74154,"_31485":73981,"_21804":123661,"_5":15036,"_28646":123234,"_3122":123662},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3731":74155,"_31485":73981,"_21804":123664,"_5":15036,"_28646":123238,"_3122":123665},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3731":74156,"_31485":73981,"_21804":123667,"_5":15036,"_28646":123238,"_3122":123668},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3731":74157,"_31485":74157,"_5":15390,"_3122":123670,"_31812":123671,"_21804":123672,"_28646":74157},"Alertas y suscripciones",[51373,123005,123006],[],{"_3731":74158,"_31485":74157,"_21804":123674,"_5":15036,"_28646":74157,"_3122":123675},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3731":74159,"_31485":74157,"_5":31809,"_21804":123677,"_28646":123678,"_3122":123679},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3731":74160,"_31485":74157,"_5":31809,"_21804":123681,"_28646":123682,"_3122":123683},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3731":74161,"_31485":74157,"_5":31809,"_21804":123685,"_28646":123686,"_3122":123687},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3731":74162,"_31485":74157,"_5":31809,"_21804":123689,"_28646":123690,"_3122":123691},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3731":74163,"_31485":74157,"_5":31809,"_21804":123693,"_28646":123694,"_3122":123695},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3731":74164,"_31485":74157,"_5":31809,"_21804":123697,"_28646":123698,"_3122":123699},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3731":74165,"_31485":74157,"_5":31809,"_21804":123701,"_28646":123702,"_3122":123703},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3731":74166,"_31485":74157,"_5":31809,"_21804":123705,"_28646":123706,"_3122":123707},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3731":74167,"_31485":74157,"_5":31809,"_21804":123709,"_28646":123710,"_3122":123711},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3731":74168,"_31485":74157,"_5":31809,"_21804":123713,"_28646":123714,"_3122":123715},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3731":74169,"_31485":74157,"_5":31809,"_21804":123717,"_28646":123718,"_3122":123719},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3731":74170,"_31485":74157,"_21804":123721,"_5":15036,"_28646":74157,"_3122":123722},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3731":74171,"_31485":74157,"_21804":123724,"_5":15036,"_28646":123678,"_3122":123725},[],"Un servicio publica un evento de dominio.",{"_3731":74172,"_31485":74157,"_21804":123727,"_5":15036,"_28646":123678,"_3122":123728},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3731":74173,"_31485":74157,"_21804":123730,"_5":15036,"_28646":123678,"_3122":123731},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3731":74174,"_31485":74157,"_21804":123733,"_5":15036,"_28646":123678,"_3122":123734},[],"Lamassu entrega el evento al canal configurado.",{"_3731":74175,"_31485":74157,"_21804":123736,"_5":15036,"_28646":123678,"_3122":123737},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3731":74176,"_31485":74157,"_21804":123739,"_5":15036,"_28646":123682,"_3122":123740},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3731":74177,"_31485":74157,"_21804":123742,"_5":15036,"_28646":123682,"_3122":123743},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3731":74178,"_31485":74157,"_21804":123745,"_5":15036,"_28646":123682,"_3122":123746},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3731":74179,"_31485":74157,"_21804":123748,"_5":15036,"_28646":123682,"_3122":123749},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3731":74180,"_31485":74157,"_21804":123751,"_5":15036,"_28646":123682,"_3122":123752},[],"`apikey_options` necesita `header` y `key`.",{"_3731":74181,"_31485":74157,"_21804":123754,"_5":15036,"_28646":123682,"_3122":123755},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3731":74182,"_31485":74157,"_21804":123757,"_5":15036,"_28646":123682,"_3122":123758},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3731":74183,"_31485":74157,"_21804":123760,"_5":15036,"_28646":123682,"_3122":123761},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3731":74184,"_31485":74157,"_21804":123763,"_5":15036,"_28646":123690,"_3122":123764},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3731":74185,"_31485":74157,"_21804":123766,"_5":15036,"_28646":123694,"_3122":123767},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3731":74186,"_31485":74157,"_21804":123769,"_5":15036,"_28646":123698,"_3122":123770},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3731":74187,"_31485":74157,"_21804":123772,"_5":15036,"_28646":123698,"_3122":123773},[],"**None** notifica todas las instancias del evento.",{"_3731":74188,"_31485":74157,"_21804":123775,"_5":15036,"_28646":123698,"_3122":123776},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3731":74189,"_31485":74157,"_21804":123778,"_5":15036,"_28646":123698,"_3122":123779},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3731":74190,"_31485":74157,"_21804":123781,"_5":15036,"_28646":123698,"_3122":123782},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3731":74191,"_31485":74157,"_21804":123784,"_5":15036,"_28646":123698,"_3122":123785},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3731":74192,"_31485":74157,"_21804":123787,"_5":15036,"_28646":123698,"_3122":123788},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3731":74193,"_31485":74157,"_21804":123790,"_5":15036,"_28646":123702,"_3122":123791},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3731":74194,"_31485":74157,"_21804":123793,"_5":15036,"_28646":123706,"_3122":123794},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3731":74195,"_31485":74157,"_21804":123796,"_5":15036,"_28646":123706,"_3122":123797},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3731":74196,"_31485":74157,"_21804":123799,"_5":15036,"_28646":123706,"_3122":123800},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3731":74197,"_31485":74157,"_21804":123802,"_5":15036,"_28646":123706,"_3122":123803},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3731":74198,"_31485":74157,"_21804":123805,"_5":15036,"_28646":123706,"_3122":123806},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3731":74199,"_31485":74157,"_21804":123808,"_5":15036,"_28646":123706,"_3122":123809},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3731":74200,"_31485":74157,"_21804":123811,"_5":15036,"_28646":123706,"_3122":123812},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3731":74201,"_31485":74157,"_21804":123814,"_5":15036,"_28646":123706,"_3122":123815},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3731":74202,"_31485":74157,"_21804":123817,"_5":15036,"_28646":123710,"_3122":123818},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3731":74203,"_31485":74157,"_21804":123820,"_5":15036,"_28646":123710,"_3122":123821},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3731":74204,"_31485":74157,"_21804":123823,"_5":15036,"_28646":123710,"_3122":123824},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3731":74205,"_31485":74157,"_21804":123826,"_5":15036,"_28646":123710,"_3122":123827},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3731":74206,"_31485":74157,"_21804":123829,"_5":15036,"_28646":123710,"_3122":123830},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3731":74207,"_31485":74157,"_21804":123832,"_5":15036,"_28646":123710,"_3122":123833},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3731":74208,"_31485":74157,"_21804":123835,"_5":15036,"_28646":123710,"_3122":123836},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3731":74209,"_31485":74157,"_21804":123838,"_5":15036,"_28646":123710,"_3122":123839},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3731":74210,"_31485":74157,"_21804":123841,"_5":15036,"_28646":123714,"_3122":123842},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3731":74211,"_31485":74157,"_21804":123844,"_5":15036,"_28646":123714,"_3122":123845},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3731":74212,"_31485":74157,"_21804":123847,"_5":15036,"_28646":123718,"_3122":123848},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3731":74213,"_31485":74157,"_21804":123850,"_5":15036,"_28646":123718,"_3122":123851},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3731":74214,"_31485":74157,"_21804":123853,"_5":15036,"_28646":123718,"_3122":123854},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3731":74215,"_31485":74157,"_21804":123856,"_5":15036,"_28646":123718,"_3122":123857},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3731":74216,"_31485":74157,"_21804":123859,"_5":15036,"_28646":123718,"_3122":123860},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3731":74217,"_31485":74157,"_21804":123862,"_5":15036,"_28646":123718,"_3122":123863},[],"**Validación:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` y `va.crl-settings.delete`.",{"_3731":74218,"_31485":74157,"_21804":123865,"_5":15036,"_28646":123718,"_3122":123866},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3731":74219,"_31485":74157,"_21804":123868,"_5":15036,"_28646":123718,"_3122":123869},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3731":74220,"_31485":74157,"_21804":123871,"_5":15036,"_28646":123718,"_3122":123872},[],"Desde 4.0.0, `va.crl-settings.init` y `va.crl-settings.update` transportan los ajustes de CRL de una CA (`ca_id`) y sustituyen a `va.role.crl.init` y `va.role.update`. La migración de la actualización renombra automáticamente los tipos de las suscripciones existentes, pero no reescribe sus condiciones: revisa los filtros que lean el payload antiguo o el subject antiguo `crl/<ski>`, incluidos los de `va.role.crl.create` (consulta 3.8.0 a 4.0.0).",{"_3731":74221,"_31485":74157,"_21804":123874,"_5":15036,"_28646":123718,"_3122":123875},[],"La VA publica además `va.crl-settings.finalize` cuando una CA se revoca de forma permanente o caduca, `va.crl-settings.archive` cuando la CA se elimina, y `va.crl-settings.delete` cuando se eliminan ajustes archivados.",{"_3731":74222,"_31485":74222,"_5":15390,"_3122":123877,"_31812":123878,"_21804":123879,"_28646":74222},"Registros de auditoría",[51373,123005,123006],[],{"_3731":74223,"_31485":74222,"_21804":123881,"_5":15036,"_28646":74222,"_3122":123882},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3731":74224,"_31485":74222,"_5":31809,"_21804":123884,"_28646":123885,"_3122":123886},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3731":74225,"_31485":74222,"_5":31809,"_21804":123888,"_28646":123889,"_3122":123890},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3731":74226,"_31485":74222,"_5":31809,"_21804":123892,"_28646":123893,"_3122":123894},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3731":74227,"_31485":74222,"_5":31809,"_21804":123896,"_28646":123897,"_3122":123898},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3731":74228,"_31485":74222,"_5":31809,"_21804":123900,"_28646":123901,"_3122":123902},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3731":74229,"_31485":74222,"_5":31809,"_21804":123904,"_28646":123905,"_3122":123906},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3731":74230,"_31485":74222,"_5":31809,"_21804":123908,"_28646":123909,"_3122":123910},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3731":74231,"_31485":74222,"_5":31809,"_21804":123912,"_28646":123913,"_3122":123914},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3731":74232,"_31485":74222,"_5":31809,"_21804":123916,"_28646":123917,"_3122":123918},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3731":74233,"_31485":74222,"_5":31809,"_21804":123920,"_28646":123921,"_3122":123922},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3731":74234,"_31485":74222,"_5":31809,"_21804":123924,"_28646":123925,"_3122":123926},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3731":74235,"_31485":74222,"_21804":123928,"_5":15036,"_28646":74222,"_3122":123929},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3731":74236,"_31485":74222,"_21804":123931,"_5":15036,"_28646":123885,"_3122":123932},[],"El cuerpo de auditoría incluye:",{"_3731":74237,"_31485":74222,"_21804":123934,"_5":15036,"_28646":123885,"_3122":123935},[],"input: datos recibidos por la operación;",{"_3731":74238,"_31485":74222,"_21804":123937,"_5":15036,"_28646":123885,"_3122":123938},[],"has\\_error: indica si el servicio devolvió un error;",{"_3731":74239,"_31485":74222,"_21804":123940,"_5":15036,"_28646":123885,"_3122":123941},[],"output: resultado producido o mensaje de error;",{"_3731":74240,"_31485":74222,"_21804":123943,"_5":15036,"_28646":123885,"_3122":123944},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3731":74241,"_31485":74222,"_21804":123946,"_5":15036,"_28646":123885,"_3122":123947},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3731":74242,"_31485":74222,"_21804":123949,"_5":15036,"_28646":123885,"_3122":123950},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3731":74243,"_31485":74222,"_21804":123952,"_5":15036,"_28646":123889,"_3122":123953},[],"El backend aplica auditoría a mutaciones de:",{"_3731":74244,"_31485":74222,"_21804":123955,"_5":15036,"_28646":123889,"_3122":123956},[],"autoridades, certificados y perfiles de emisión;",{"_3731":74245,"_31485":74222,"_21804":123958,"_5":15036,"_28646":123889,"_3122":123959},[],"claves y motores KMS;",{"_3731":74246,"_31485":74222,"_21804":123961,"_5":15036,"_28646":123889,"_3122":123962},[],"dispositivos e identidades;",{"_3731":74247,"_31485":74222,"_21804":123964,"_5":15036,"_28646":123889,"_3122":123965},[],"DMS y operaciones de enrolamiento;",{"_3731":74248,"_31485":74222,"_21804":123967,"_5":15036,"_28646":123889,"_3122":123968},[],"funciones de validación y CRL;",{"_3731":74249,"_31485":74222,"_21804":123970,"_5":15036,"_28646":123889,"_3122":123971},[],"principales, políticas y concesiones de autorización.",{"_3731":74250,"_31485":74222,"_21804":123973,"_5":15036,"_28646":123889,"_3122":123974},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3731":74251,"_31485":74222,"_21804":123976,"_5":15036,"_28646":123893,"_3122":123977},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3731":74252,"_31485":74222,"_21804":123979,"_5":15036,"_28646":123893,"_3122":123980},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3731":74253,"_31485":74222,"_21804":123982,"_5":15036,"_28646":123893,"_3122":123983},[],"Diseña el consumidor para:",{"_3731":74254,"_31485":74222,"_21804":123985,"_5":15036,"_28646":123893,"_3122":123986},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3731":74255,"_31485":74222,"_21804":123988,"_5":15036,"_28646":123893,"_3122":123989},[],"conservar el CloudEvent completo sin modificar;",{"_3731":74256,"_31485":74222,"_21804":123991,"_5":15036,"_28646":123893,"_3122":123992},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3731":74257,"_31485":74222,"_21804":123994,"_5":15036,"_28646":123893,"_3122":123995},[],"cifrar en tránsito y en reposo;",{"_3731":74258,"_31485":74222,"_21804":123997,"_5":15036,"_28646":123893,"_3122":123998},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3731":74259,"_31485":74222,"_21804":124000,"_5":15036,"_28646":123893,"_3122":124001},[],"aplicar una política explícita de retención y legal hold;",{"_3731":74260,"_31485":74222,"_21804":124003,"_5":15036,"_28646":123893,"_3122":124004},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3731":74261,"_31485":74222,"_21804":124006,"_5":15036,"_28646":123897,"_3122":124007},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3731":74262,"_31485":74222,"_21804":124009,"_5":15036,"_28646":123897,"_3122":124010},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3731":74263,"_31485":74222,"_21804":124012,"_5":15036,"_28646":123905,"_3122":124013},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3731":74264,"_31485":74222,"_21804":124015,"_5":15036,"_28646":123909,"_3122":124016},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3731":74265,"_31485":74222,"_21804":124018,"_5":15036,"_28646":123913,"_3122":124019},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3731":74266,"_31485":74222,"_21804":124021,"_5":15036,"_28646":123917,"_3122":124022},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3731":74267,"_31485":74222,"_21804":124024,"_5":15036,"_28646":123921,"_3122":124025},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3731":74268,"_31485":74222,"_21804":124027,"_5":15036,"_28646":123925,"_3122":124028},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3731":74269,"_31485":74222,"_21804":124030,"_5":15036,"_28646":123925,"_3122":124031},[],"aparece un evento de auditoría correcto;",{"_3731":74270,"_31485":74222,"_21804":124033,"_5":15036,"_28646":123925,"_3122":124034},[],"el principal coincide con la identidad utilizada;",{"_3731":74271,"_31485":74222,"_21804":124036,"_5":15036,"_28646":123925,"_3122":124037},[],"el consumidor lo persiste una sola vez;",{"_3731":74272,"_31485":74222,"_21804":124039,"_5":15036,"_28646":123925,"_3122":124040},[],"puede recuperarse por recurso, actor y periodo;",{"_3731":74273,"_31485":74222,"_21804":124042,"_5":15036,"_28646":123925,"_3122":124043},[],"una interrupción del consumidor produce una alerta.",{"_3731":74274,"_31485":74222,"_21804":124045,"_5":15036,"_28646":123925,"_3122":124046},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3731":74275,"_31485":74275,"_5":15390,"_3122":124048,"_31812":124049,"_21804":124050,"_28646":74275},"Arquitectura de la plataforma",[51373,123005],[],{"_3731":74276,"_31485":74275,"_21804":124052,"_5":15036,"_28646":74275,"_3122":124053},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3731":74277,"_31485":74275,"_5":31809,"_21804":124055,"_28646":124056,"_3122":124057},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3731":74278,"_31485":74275,"_5":31809,"_21804":124059,"_28646":124060,"_3122":124061},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3731":74279,"_31485":74275,"_5":31809,"_21804":124063,"_28646":124064,"_3122":124065},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3731":74280,"_31485":74275,"_5":31809,"_21804":124067,"_28646":124068,"_3122":124069},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3731":74281,"_31485":74275,"_5":31809,"_21804":124071,"_28646":124072,"_3122":124073},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3731":74282,"_31485":74275,"_21804":124075,"_5":15036,"_28646":74275,"_3122":124076},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3731":74283,"_31485":74275,"_21804":124078,"_5":15036,"_28646":74275,"_3122":124079},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3731":74284,"_31485":74275,"_21804":124081,"_5":15036,"_28646":124056,"_3122":124082},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3731":74285,"_31485":74275,"_21804":124084,"_5":15036,"_28646":124060,"_3122":124085},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3731":74286,"_31485":74275,"_21804":124087,"_5":15036,"_28646":124064,"_3122":124088},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3731":74287,"_31485":74275,"_21804":124090,"_5":15036,"_28646":124068,"_3122":124091},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3731":74288,"_31485":74275,"_21804":124093,"_5":15036,"_28646":124072,"_3122":124094},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3731":74289,"_31485":74289,"_5":15390,"_3122":124096,"_31812":124097,"_21804":124098,"_28646":74289},"Cómo funciona Lamassu",[51373,123005],[],{"_3731":74290,"_31485":74289,"_21804":124100,"_5":15036,"_28646":74289,"_3122":124101},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3731":74291,"_31485":74289,"_5":31809,"_21804":124103,"_28646":124104,"_3122":124105},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3731":74292,"_31485":74289,"_5":31809,"_21804":124107,"_28646":124108,"_3122":124109},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3731":74293,"_31485":74289,"_21804":124111,"_5":15036,"_28646":74289,"_3122":124112},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3731":74294,"_31485":74289,"_21804":124114,"_5":15036,"_28646":124104,"_3122":124115},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3731":74295,"_31485":74289,"_21804":124117,"_5":15036,"_28646":124104,"_3122":124118},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3731":74296,"_31485":74289,"_21804":124120,"_5":15036,"_28646":124104,"_3122":124121},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3731":74297,"_31485":74289,"_21804":124123,"_5":15036,"_28646":124104,"_3122":124124},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3731":74298,"_31485":74289,"_21804":124126,"_5":15036,"_28646":124104,"_3122":124127},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3731":74299,"_31485":74289,"_21804":124129,"_5":15036,"_28646":124108,"_3122":124130},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3731":74300,"_31485":74289,"_21804":124132,"_5":15036,"_28646":124108,"_3122":124133},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3731":74301,"_31485":74289,"_21804":124135,"_5":15036,"_28646":124108,"_3122":124136},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3731":74302,"_31485":74289,"_21804":124138,"_5":15036,"_28646":124108,"_3122":124139},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3731":74303,"_31485":74289,"_21804":124141,"_5":15036,"_28646":124108,"_3122":124142},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3731":74304,"_31485":74289,"_21804":124144,"_5":15036,"_28646":124108,"_3122":124145},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3731":74305,"_31485":74289,"_21804":124147,"_5":15036,"_28646":124108,"_3122":124148},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3731":74306,"_31485":74306,"_5":15390,"_3122":124150,"_31812":124151,"_21804":124152,"_28646":74306},"Dispositivos e identidades",[51373,123005,54083,124150],[],{"_3731":74307,"_31485":74306,"_21804":124154,"_5":15036,"_28646":74306,"_3122":124155},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3731":74308,"_31485":74306,"_5":31809,"_21804":124157,"_28646":124158,"_3122":124159},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3731":74309,"_31485":74306,"_5":31809,"_21804":124161,"_28646":124162,"_3122":124163},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3731":74310,"_31485":74306,"_5":31809,"_21804":124165,"_28646":124166,"_3122":124167},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3731":74311,"_31485":74306,"_5":31809,"_21804":124169,"_28646":124170,"_3122":124171},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3731":74312,"_31485":74306,"_5":31809,"_21804":124173,"_28646":124174,"_3122":124175},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3731":74313,"_31485":74306,"_5":31809,"_21804":124177,"_28646":124178,"_3122":124179},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3731":74314,"_31485":74306,"_5":31809,"_21804":124181,"_28646":124182,"_3122":124183},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3731":74315,"_31485":74306,"_5":31809,"_21804":124185,"_28646":124186,"_3122":124187},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3731":74316,"_31485":74306,"_5":31809,"_21804":124189,"_28646":124190,"_3122":124191},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3731":74317,"_31485":74306,"_5":31809,"_21804":124193,"_28646":124194,"_3122":124195},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3731":74318,"_31485":74306,"_5":31809,"_21804":124197,"_28646":124198,"_3122":124199},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3731":74319,"_31485":74306,"_21804":124201,"_5":15036,"_28646":74306,"_3122":124202},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3731":74320,"_31485":74306,"_21804":124204,"_5":15036,"_28646":74306,"_3122":124205},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3731":74321,"_31485":74306,"_21804":124207,"_5":15036,"_28646":124158,"_3122":124208},[],"Vista operativa",{"_3731":74322,"_31485":74306,"_21804":124210,"_5":15036,"_28646":124158,"_3122":124211},[],"Interpretación",{"_3731":74323,"_31485":74306,"_21804":124213,"_5":15036,"_28646":124158,"_3122":54146},[],{"_3731":74324,"_31485":74306,"_21804":124215,"_5":15036,"_28646":124158,"_3122":124216},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3731":74325,"_31485":74306,"_21804":124218,"_5":15036,"_28646":124158,"_3122":54152},[],{"_3731":74326,"_31485":74306,"_21804":124220,"_5":15036,"_28646":124158,"_3122":124221},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3731":74327,"_31485":74306,"_21804":124223,"_5":15036,"_28646":124158,"_3122":54158},[],{"_3731":74328,"_31485":74306,"_21804":124225,"_5":15036,"_28646":124158,"_3122":124226},[],"La identidad está en la ventana operativa de renovación.",{"_3731":74329,"_31485":74306,"_21804":124228,"_5":15036,"_28646":124158,"_3122":54164},[],{"_3731":74330,"_31485":74306,"_21804":124230,"_5":15036,"_28646":124158,"_3122":124231},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3731":74331,"_31485":74306,"_21804":124233,"_5":15036,"_28646":124158,"_3122":54170},[],{"_3731":74332,"_31485":74306,"_21804":124235,"_5":15036,"_28646":124158,"_3122":124236},[],"La identidad ha vencido.",{"_3731":74333,"_31485":74306,"_21804":124238,"_5":15036,"_28646":124158,"_3122":54176},[],{"_3731":74334,"_31485":74306,"_21804":124240,"_5":15036,"_28646":124158,"_3122":124241},[],"La identidad está marcada como revocada. Una suspensión en cascada desde su CA se muestra aquí y se levanta al reactivar esa CA.",{"_3731":74335,"_31485":74306,"_21804":124243,"_5":15036,"_28646":124158,"_3122":54182},[],{"_3731":74336,"_31485":74306,"_21804":124245,"_5":15036,"_28646":124158,"_3122":124246},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3731":74337,"_31485":74306,"_21804":124248,"_5":15036,"_28646":124158,"_3122":124249},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3731":74338,"_31485":74306,"_21804":124251,"_5":15036,"_28646":124162,"_3122":124252},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3731":74339,"_31485":74306,"_21804":124254,"_5":15036,"_28646":124162,"_3122":124255},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3731":74340,"_31485":74306,"_21804":124257,"_5":15036,"_28646":124162,"_3122":124258},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. En el modo **Live**, sigue automáticamente los eventos nuevos y los cambios del dispositivo (como el estado o el propietario) sin recargar la página, y muestra un indicador **Connected** o **Disconnected**. Tras una interrupción se reconecta y recupera sin huecos ni duplicados, de modo que **Live** muestra el mismo contenido que una recarga de la página. Cuando las actualizaciones en vivo no pueden usarse — falta de permisos, dispositivo no encontrado o actualizaciones en vivo no habilitadas en el servidor —, la línea de tiempo muestra `Live updates unavailable: ...` con el motivo, y la navegación por el historial (**Load more**) sigue funcionando. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3731":74341,"_31485":74306,"_21804":124260,"_5":15036,"_28646":124162,"_3122":124261},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3731":74342,"_31485":74306,"_21804":124263,"_5":15036,"_28646":124166,"_3122":124264},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3731":74343,"_31485":74306,"_21804":124266,"_5":15036,"_28646":124170,"_3122":124267},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3731":74344,"_31485":74306,"_21804":124269,"_5":15036,"_28646":124174,"_3122":124270},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3731":74345,"_31485":74306,"_21804":124272,"_5":15036,"_28646":124178,"_3122":124273},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3731":74346,"_31485":74306,"_21804":124275,"_5":15036,"_28646":124182,"_3122":124276},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3731":74347,"_31485":74306,"_21804":124278,"_5":15036,"_28646":124182,"_3122":124279},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3731":74348,"_31485":74306,"_21804":124281,"_5":15036,"_28646":124186,"_3122":124282},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3731":74349,"_31485":74306,"_21804":124284,"_5":15036,"_28646":124186,"_3122":124285},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3731":74350,"_31485":74306,"_21804":124287,"_5":15036,"_28646":124186,"_3122":124288},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3731":74351,"_31485":74306,"_21804":124290,"_5":15036,"_28646":124186,"_3122":124291},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3731":74352,"_31485":74306,"_21804":124293,"_5":15036,"_28646":124186,"_3122":124294},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3731":74353,"_31485":74306,"_21804":124296,"_5":15036,"_28646":124186,"_3122":124297},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3731":74354,"_31485":74306,"_21804":124299,"_5":15036,"_28646":124190,"_3122":124300},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3731":74355,"_31485":74306,"_21804":124302,"_5":15036,"_28646":124190,"_3122":124303},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3731":74356,"_31485":74306,"_21804":124305,"_5":15036,"_28646":124190,"_3122":124306},[],"Un certificado suspendido por una cascada de suspensión de una CA se muestra como **Revoked** y vuelve a estar activo cuando se reactiva esa CA. Si su certificado caducó durante la suspensión, el trabajo de monitorización lo marca de nuevo como caducado tras la reactivación. Si tú revocas una identidad suspendida, esa revocación es permanente.",{"_3731":74357,"_31485":74306,"_21804":124308,"_5":15036,"_28646":124194,"_3122":124309},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3731":74358,"_31485":74306,"_21804":124311,"_5":15036,"_28646":124194,"_3122":124312},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3731":74359,"_31485":74306,"_21804":124314,"_5":15036,"_28646":124194,"_3122":124315},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3731":74360,"_31485":74306,"_21804":124317,"_5":15036,"_28646":124194,"_3122":124318},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3731":74361,"_31485":74306,"_21804":124320,"_5":15036,"_28646":124198,"_3122":124321},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3731":74362,"_31485":74306,"_21804":124323,"_5":15036,"_28646":124198,"_3122":124324},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/est/configuration\" />",{"_3731":74363,"_31485":74363,"_5":15390,"_3122":124326,"_31812":124327,"_21804":124329,"_28646":74363},"Configura y opera el DMS",[51373,123005,54083,124150,124328],"Enrolamiento con PKI",[],{"_3731":74364,"_31485":74363,"_21804":124331,"_5":15036,"_28646":74363,"_3122":124332},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3731":74365,"_31485":74363,"_5":31809,"_21804":124334,"_28646":124335,"_3122":121513},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3731":74366,"_31485":74363,"_5":31809,"_21804":124337,"_28646":124338,"_3122":124339},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3731":74367,"_31485":74363,"_5":31809,"_21804":124341,"_28646":124342,"_3122":124343},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3731":74368,"_31485":74363,"_5":31809,"_21804":124345,"_28646":124346,"_3122":124347},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3731":74369,"_31485":74363,"_5":31809,"_21804":124349,"_28646":124350,"_3122":124351},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3731":74370,"_31485":74363,"_5":31809,"_21804":124353,"_28646":124354,"_3122":124355},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3731":74371,"_31485":74363,"_5":31809,"_21804":124357,"_28646":124358,"_3122":124359},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3731":74372,"_31485":74363,"_5":31809,"_21804":124361,"_28646":124362,"_3122":124363},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-del-protocolo","Configuración del protocolo",{"_3731":74373,"_31485":74363,"_5":31809,"_21804":124365,"_28646":124366,"_3122":124367},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3731":74374,"_31485":74363,"_5":31809,"_21804":124369,"_28646":124370,"_3122":124371},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3731":74375,"_31485":74363,"_21804":124373,"_5":15036,"_28646":74363,"_3122":124374},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3731":74376,"_31485":74363,"_21804":124376,"_5":15036,"_28646":124335,"_3122":124377},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3731":74377,"_31485":74363,"_21804":124379,"_5":15036,"_28646":124335,"_3122":124380},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3731":74378,"_31485":74363,"_21804":124382,"_5":15036,"_28646":124342,"_3122":124383},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3731":74379,"_31485":74363,"_21804":124385,"_5":15036,"_28646":124346,"_3122":124386},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3731":74380,"_31485":74363,"_21804":124388,"_5":15036,"_28646":124350,"_3122":124389},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3731":74381,"_31485":74363,"_21804":124391,"_5":15036,"_28646":124354,"_3122":124392},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3731":74382,"_31485":74363,"_21804":124394,"_5":15036,"_28646":124358,"_3122":124395},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3731":74383,"_31485":74363,"_21804":124397,"_5":15036,"_28646":124362,"_3122":124398},[],"Consulta Configuración de EST en el DMS para definir registro, autenticación, emisión, renovación, generación de claves y distribución de confianza.",{"_3731":74384,"_31485":74363,"_21804":124400,"_5":15036,"_28646":124366,"_3122":124401},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3731":74385,"_31485":74363,"_21804":124403,"_5":15036,"_28646":124366,"_3122":124404},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3731":74386,"_31485":74363,"_21804":124406,"_5":15036,"_28646":124366,"_3122":124407},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3731":74387,"_31485":74363,"_21804":124409,"_5":15036,"_28646":124370,"_3122":124410},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3731":74388,"_31485":74388,"_5":15390,"_3122":124328,"_31812":124412,"_21804":124413,"_28646":74388},[51373,123005,54083,124150,124328],[],{"_3731":74389,"_31485":74388,"_21804":124415,"_5":15036,"_28646":74388,"_3122":124416},[],"Prepara la admisión, la política de registro y la emisión de certificados para los dispositivos.",{"_3731":74390,"_31485":74388,"_5":31809,"_21804":124418,"_28646":124419,"_3122":124420},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3731":74391,"_31485":74388,"_5":31809,"_21804":124422,"_28646":124423,"_3122":124424},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3731":74392,"_31485":74388,"_5":31809,"_21804":124426,"_28646":124427,"_3122":124428},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3731":74393,"_31485":74388,"_21804":124430,"_5":15036,"_28646":74388,"_3122":124431},[],"El enrolamiento con PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3731":74394,"_31485":74388,"_21804":124433,"_5":15036,"_28646":124419,"_3122":124434},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3731":74395,"_31485":74388,"_21804":124436,"_5":15036,"_28646":124419,"_3122":124437},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3731":74396,"_31485":74388,"_21804":124439,"_5":15036,"_28646":124419,"_3122":124440},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3731":74397,"_31485":74388,"_21804":124442,"_5":15036,"_28646":124419,"_3122":124443},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3731":74398,"_31485":74388,"_21804":124445,"_5":15036,"_28646":124419,"_3122":124446},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3731":74399,"_31485":74388,"_21804":124448,"_5":15036,"_28646":124419,"_3122":124449},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3731":74400,"_31485":74388,"_21804":124451,"_5":15036,"_28646":124423,"_3122":124452},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3731":74401,"_31485":74388,"_21804":124454,"_5":15036,"_28646":124423,"_3122":124455},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3731":74402,"_31485":74388,"_21804":124457,"_5":15036,"_28646":124427,"_3122":124458},[],"Consulta EST (RFC 7030) para preparar la autenticación y la confianza inicial, integrar el cliente y mantener la identidad.",{"_3731":74403,"_31485":74388,"_21804":124460,"_5":15036,"_28646":124427,"_3122":124461},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3731":74404,"_31485":74404,"_5":15390,"_3122":124463,"_31812":124464,"_21804":124465,"_28646":74404},"Estrategias de aprovisionamiento",[51373,123005,54083,124150,124328],[],{"_3731":74405,"_31485":74404,"_21804":124467,"_5":15036,"_28646":74404,"_3122":124468},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3731":74406,"_31485":74404,"_5":31809,"_21804":124470,"_28646":124471,"_3122":124472},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3731":74407,"_31485":74404,"_5":31809,"_21804":124474,"_28646":124475,"_3122":124476},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3731":74408,"_31485":74404,"_5":31809,"_21804":124478,"_28646":124479,"_3122":124480},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3731":74409,"_31485":74404,"_5":31809,"_21804":124482,"_28646":124483,"_3122":124484},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3731":74410,"_31485":74404,"_5":31809,"_21804":124486,"_28646":124487,"_3122":124488},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3731":74411,"_31485":74404,"_21804":124490,"_5":15036,"_28646":74404,"_3122":124491},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3731":74412,"_31485":74404,"_21804":124493,"_5":15036,"_28646":124471,"_3122":124494},[],"Recorrido",{"_3731":74413,"_31485":74404,"_21804":124496,"_5":15036,"_28646":124471,"_3122":124497},[],"Cuándo existe el dispositivo",{"_3731":74414,"_31485":74404,"_21804":124499,"_5":15036,"_28646":124471,"_3122":124500},[],"Qué compruebas",{"_3731":74415,"_31485":74404,"_21804":124502,"_5":15036,"_28646":124471,"_3122":124503},[],"Asignación manual",{"_3731":74416,"_31485":74404,"_21804":124505,"_5":15036,"_28646":124471,"_3122":124506},[],"El operador lo crea antes de asociar un certificado.",{"_3731":74417,"_31485":74404,"_21804":124508,"_5":15036,"_28646":124471,"_3122":124509},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3731":74418,"_31485":74404,"_21804":124511,"_5":15036,"_28646":124471,"_3122":124512},[],"EST con `JITP`",{"_3731":74419,"_31485":74404,"_21804":124514,"_5":15036,"_28646":124471,"_3122":124515},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3731":74420,"_31485":74404,"_21804":124517,"_5":15036,"_28646":124471,"_3122":124518},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3731":74421,"_31485":74404,"_21804":124520,"_5":15036,"_28646":124471,"_3122":124521},[],"EST con `PRE_REGISTRATION`",{"_3731":74422,"_31485":74404,"_21804":124523,"_5":15036,"_28646":124471,"_3122":124524},[],"Debe existir antes de `/simpleenroll`.",{"_3731":74423,"_31485":74404,"_21804":124526,"_5":15036,"_28646":124471,"_3122":124527},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3731":74424,"_31485":74404,"_21804":124529,"_5":15036,"_28646":124471,"_3122":124530},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3731":74425,"_31485":74404,"_21804":124532,"_5":15036,"_28646":124471,"_3122":124533},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3731":74426,"_31485":74404,"_21804":124535,"_5":15036,"_28646":124475,"_3122":124536},[],"Encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3731":74427,"_31485":74404,"_21804":124538,"_5":15036,"_28646":124475,"_3122":124539},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3731":74428,"_31485":74404,"_21804":124541,"_5":15036,"_28646":124475,"_3122":124542},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3731":74429,"_31485":74404,"_21804":124544,"_5":15036,"_28646":124479,"_3122":124545},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3731":74430,"_31485":74404,"_21804":124547,"_5":15036,"_28646":124479,"_3122":124548},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3731":74431,"_31485":74404,"_21804":124550,"_5":15036,"_28646":124479,"_3122":124551},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3731":74432,"_31485":74404,"_21804":124553,"_5":15036,"_28646":124479,"_3122":124554},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3731":74433,"_31485":74404,"_21804":124556,"_5":15036,"_28646":124479,"_3122":124557},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3731":74434,"_31485":74404,"_21804":124559,"_5":15036,"_28646":124479,"_3122":124560},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3731":74435,"_31485":74404,"_21804":124562,"_5":15036,"_28646":124483,"_3122":121877},[],{"_3731":74436,"_31485":74404,"_21804":124564,"_5":15036,"_28646":124483,"_3122":124565},[],"Material que atraviesa EST",{"_3731":74437,"_31485":74404,"_21804":124567,"_5":15036,"_28646":124483,"_3122":124568},[],"Clave generada por el dispositivo",{"_3731":74438,"_31485":74404,"_21804":124570,"_5":15036,"_28646":124483,"_3122":124571},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3731":74439,"_31485":74404,"_21804":124573,"_5":15036,"_28646":124483,"_3122":124574},[],"Clave ya disponible en el dispositivo",{"_3731":74440,"_31485":74404,"_21804":124576,"_5":15036,"_28646":124483,"_3122":124577},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3731":74441,"_31485":74404,"_21804":124579,"_5":15036,"_28646":124483,"_3122":54519},[],{"_3731":74442,"_31485":74404,"_21804":124581,"_5":15036,"_28646":124483,"_3122":124582},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3731":74443,"_31485":74404,"_21804":124584,"_5":15036,"_28646":124483,"_3122":124585},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3731":74444,"_31485":74404,"_21804":124587,"_5":15036,"_28646":124487,"_3122":124588},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3731":74445,"_31485":74445,"_5":15390,"_3122":124590,"_31812":124591,"_21804":124592,"_28646":74445},"Autenticación y confianza",[51373,123005,54083,54532],[],{"_3731":74446,"_31485":74445,"_21804":124594,"_5":15036,"_28646":74445,"_3122":124595},[],"Prepara las credenciales, la autenticación y la distribución de confianza para EST.",{"_3731":74447,"_31485":74445,"_5":31809,"_21804":124597,"_28646":124598,"_3122":124599},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3731":74448,"_31485":74445,"_5":31809,"_21804":124601,"_28646":124602,"_3122":124603},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3731":74449,"_31485":74445,"_5":31809,"_21804":124605,"_28646":124606,"_3122":124607},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#modos-por-operación","Modos por operación",{"_3731":74450,"_31485":74445,"_5":31809,"_21804":124609,"_28646":124610,"_3122":124611},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3731":74451,"_31485":74445,"_5":31809,"_21804":124613,"_28646":124614,"_3122":124615},[],"/docs/es/platform/iot-fleets/est/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3731":74452,"_31485":74445,"_21804":124617,"_5":15036,"_28646":74445,"_3122":124618},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3731":74453,"_31485":74445,"_21804":124620,"_5":15036,"_28646":124598,"_3122":124621},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3731":74454,"_31485":74445,"_21804":124623,"_5":15036,"_28646":124598,"_3122":124624},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3731":74455,"_31485":74445,"_21804":124626,"_5":15036,"_28646":124602,"_3122":124627},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. El validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3731":74456,"_31485":74445,"_21804":124629,"_5":15036,"_28646":124602,"_3122":124630},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3731":74457,"_31485":74445,"_21804":124632,"_5":15036,"_28646":124602,"_3122":124633},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3731":74458,"_31485":74445,"_21804":124635,"_5":15036,"_28646":124606,"_3122":124636},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3731":74459,"_31485":74445,"_21804":124638,"_5":15036,"_28646":124606,"_3122":124639},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3731":74460,"_31485":74445,"_21804":124641,"_5":15036,"_28646":124610,"_3122":124642},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook (por defecto se verifica) y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3731":74461,"_31485":74445,"_21804":124644,"_5":15036,"_28646":124610,"_3122":124645},[],"Ejemplo de cuerpo:",{"_3731":74462,"_31485":74445,"_21804":124647,"_5":15036,"_28646":124610,"_3122":124648},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3731":74463,"_31485":74445,"_21804":124650,"_5":15036,"_28646":124610,"_3122":124651},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3731":74464,"_31485":74445,"_21804":124653,"_5":15036,"_28646":124610,"_3122":124654},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3731":74465,"_31485":74445,"_21804":124656,"_5":15036,"_28646":124610,"_3122":124657},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3731":74466,"_31485":74445,"_21804":124659,"_5":15036,"_28646":124614,"_3122":124660},[],"El DMS busca primero el certificado presentado en Lamassu; los certificados que emitió y gestiona se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus servidores OCSP y, después, sus puntos de distribución CRL. Por defecto, una revocación no verificable es un rechazo, no una aceptación: un certificado que no gestiona Lamassu y no lista ningún endpoint OCSP o CRL se rechaza, salvo que se active `allow_unverifiable_revocation` en el bloque de esa operación (consulta Autenticación por operación).",{"_3731":74467,"_31485":74445,"_21804":124662,"_5":15036,"_28646":124614,"_3122":124663},[],"Un certificado que sí lista endpoints se exige con un estándar más estricto, con o sin la opción: los endpoints que no responden, la evidencia caducada o inválida o un estado no concluyente (desconocido) rechazan el certificado. La evidencia debe estar fresca (`thisUpdate` no en el futuro, `nextUpdate` no superado, y una respuesta sin `nextUpdate` solo se acepta mientras tenga menos de unas 24 horas) y las respuestas OCSP deben estar firmadas por el propio emisor del certificado o por un responder delegado que lleve el EKU `id-kp-OCSPSigning` y esté dentro de su validez. Un veredicto de revocado se respeta con independencia de su antigüedad. Cada solicitud OCSP o CRL tiene un timeout de 10 segundos.",{"_3731":74468,"_31485":74445,"_21804":124665,"_5":15036,"_28646":124614,"_3122":124666},[],"Queda un matiz: una respuesta OCSP Good o una CRL firmadas y capturadas antes de una revocación siguen validando hasta su `nextUpdate` (hasta unas 24 horas sin `nextUpdate`). La revocación se propaga a los dispositivos al ritmo con que los responders publican evidencia, no en el momento de la revocación.",{"_3731":74469,"_31485":74445,"_21804":124668,"_5":15036,"_28646":124614,"_3122":124669},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3731":74470,"_31485":74470,"_5":15390,"_3122":124671,"_31812":124672,"_21804":124673,"_28646":74470},"EST en Lamassu",[51373,123005,54083,54532],[],{"_3731":74471,"_31485":74470,"_21804":124675,"_5":15036,"_28646":74470,"_3122":124676},[],"Configura las operaciones EST, la autenticación y la distribución de confianza.",{"_3731":74472,"_31485":74470,"_5":31809,"_21804":124678,"_28646":124679,"_3122":124680},[],"/docs/es/platform/iot-fleets/est/configuration#referencia-de-endpoints","Referencia de endpoints",{"_3731":74473,"_31485":74470,"_5":31809,"_21804":124682,"_28646":124683,"_3122":124684},[],"/docs/es/platform/iot-fleets/est/configuration#autenticación-por-operación","Autenticación por operación",{"_3731":74474,"_31485":74470,"_5":31809,"_21804":124686,"_28646":124687,"_3122":124688},[],"/docs/es/platform/iot-fleets/est/configuration#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3731":74475,"_31485":74470,"_5":31809,"_21804":124690,"_28646":124691,"_3122":124692},[],"/docs/es/platform/iot-fleets/est/configuration#notas-de-compatibilidad","Notas de compatibilidad",{"_3731":74476,"_31485":74470,"_5":31809,"_21804":124694,"_28646":124695,"_3122":121513},[],"/docs/es/platform/iot-fleets/est/configuration#antes-de-empezar",{"_3731":74477,"_31485":74470,"_5":31809,"_21804":124697,"_28646":124698,"_3122":54640},[],"/docs/es/platform/iot-fleets/est/configuration#cacerts",{"_3731":74478,"_31485":74470,"_5":31809,"_21804":124700,"_28646":124701,"_3122":124702},[],"/docs/es/platform/iot-fleets/est/configuration#distribución-de-confianza","Configuración",{"_3731":74479,"_31485":74470,"_5":31809,"_21804":124704,"_28646":124705,"_3122":124706},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-cacerts","Petición y respuesta",{"_3731":74480,"_31485":74470,"_5":31809,"_21804":124708,"_28646":124709,"_3122":54652},[],"/docs/es/platform/iot-fleets/est/configuration#simpleenroll",{"_3731":74481,"_31485":74470,"_5":31809,"_21804":124711,"_28646":124712,"_3122":124702},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-enrollment",{"_3731":74482,"_31485":74470,"_5":31809,"_21804":124714,"_28646":124715,"_3122":124706},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-simpleenroll",{"_3731":74483,"_31485":74470,"_5":31809,"_21804":124717,"_28646":124718,"_3122":54662},[],"/docs/es/platform/iot-fleets/est/configuration#simplereenroll",{"_3731":74484,"_31485":74470,"_5":31809,"_21804":124720,"_28646":124721,"_3122":124702},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-re-enrollment",{"_3731":74485,"_31485":74470,"_5":31809,"_21804":124723,"_28646":124724,"_3122":124706},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-simplereenroll",{"_3731":74486,"_31485":74470,"_5":31809,"_21804":124726,"_28646":124727,"_3122":124728},[],"/docs/es/platform/iot-fleets/est/configuration#recupera-según-el-estado","Recupera según el estado",{"_3731":74487,"_31485":74470,"_5":31809,"_21804":124730,"_28646":124731,"_3122":124732},[],"/docs/es/platform/iot-fleets/est/configuration#operación-continua","Operación continua",{"_3731":74488,"_31485":74470,"_5":31809,"_21804":124734,"_28646":124735,"_3122":54680},[],"/docs/es/platform/iot-fleets/est/configuration#serverkeygen",{"_3731":74489,"_31485":74470,"_5":31809,"_21804":124737,"_28646":124738,"_3122":124702},[],"/docs/es/platform/iot-fleets/est/configuration#configuración-de-serverkeygen",{"_3731":74490,"_31485":74470,"_5":31809,"_21804":124740,"_28646":124741,"_3122":124706},[],"/docs/es/platform/iot-fleets/est/configuration#petición-y-respuesta-de-serverkeygen",{"_3731":74491,"_31485":74470,"_21804":124743,"_5":15036,"_28646":74470,"_3122":124744},[],"El DMS aplica el modo de autenticación configurado a las solicitudes de enrolamiento antes de ejecutar las reglas de registro y emisión. El enrolamiento inicial y el reenrolamiento tienen ajustes de autenticación independientes. Lamassu permite certificado de cliente, webhook, ambos o ausencia de autenticación por el DMS. La página de autenticación y confianza explica las credenciales, la confianza inicial y las comprobaciones.",{"_3731":74492,"_31485":74470,"_21804":124746,"_5":15036,"_28646":74470,"_3122":124747},[],"El DMS también controla la CA, el perfil, la ventana de renovación, las claves generadas en el servidor y los certificados distribuidos. Consulta la guía del DMS para administrarlo.",{"_3731":74493,"_31485":74470,"_21804":124749,"_5":15036,"_28646":124679,"_3122":124750},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3731":74494,"_31485":74470,"_21804":124752,"_5":15036,"_28646":124679,"_3122":122765},[],{"_3731":74495,"_31485":74470,"_21804":124754,"_5":15036,"_28646":124679,"_3122":124755},[],"Método",{"_3731":74496,"_31485":74470,"_21804":124757,"_5":15036,"_28646":124679,"_3122":124758},[],"Autenticación y condición",{"_3731":74497,"_31485":74470,"_21804":124760,"_5":15036,"_28646":124679,"_3122":54707},[],{"_3731":74498,"_31485":74470,"_21804":124762,"_5":15036,"_28646":124679,"_3122":54710},[],{"_3731":74499,"_31485":74470,"_21804":124764,"_5":15036,"_28646":124679,"_3122":124765},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3731":74500,"_31485":74470,"_21804":124767,"_5":15036,"_28646":124679,"_3122":54716},[],{"_3731":74501,"_31485":74470,"_21804":124769,"_5":15036,"_28646":124679,"_3122":54719},[],{"_3731":74502,"_31485":74470,"_21804":124771,"_5":15036,"_28646":124679,"_3122":124772},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3731":74503,"_31485":74470,"_21804":124774,"_5":15036,"_28646":124679,"_3122":54725},[],{"_3731":74504,"_31485":74470,"_21804":124776,"_5":15036,"_28646":124679,"_3122":54719},[],{"_3731":74505,"_31485":74470,"_21804":124778,"_5":15036,"_28646":124679,"_3122":124779},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3731":74506,"_31485":74470,"_21804":124781,"_5":15036,"_28646":124679,"_3122":54733},[],{"_3731":74507,"_31485":74470,"_21804":124783,"_5":15036,"_28646":124679,"_3122":54719},[],{"_3731":74508,"_31485":74470,"_21804":124785,"_5":15036,"_28646":124679,"_3122":124786},[],"Autenticación inicial y generación de claves habilitada.",{"_3731":74509,"_31485":74470,"_21804":124788,"_5":15036,"_28646":124679,"_3122":124789},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3731":74510,"_31485":74470,"_21804":124791,"_5":15036,"_28646":124683,"_3122":124792},[],"Los bloques son independientes:",{"_3731":74511,"_31485":74470,"_21804":124794,"_5":15036,"_28646":124683,"_3122":124795},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3731":74512,"_31485":74470,"_21804":124797,"_5":15036,"_28646":124683,"_3122":124798},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3731":74513,"_31485":74470,"_21804":124800,"_5":15036,"_28646":124683,"_3122":54753},[],{"_3731":74514,"_31485":74470,"_21804":124802,"_5":15036,"_28646":124683,"_3122":124803},[],"Control aplicado en la operación configurada",{"_3731":74515,"_31485":74470,"_21804":124805,"_5":15036,"_28646":124683,"_3122":54759},[],{"_3731":74516,"_31485":74470,"_21804":124807,"_5":15036,"_28646":124683,"_3122":124808},[],"Validación del certificado presentado.",{"_3731":74517,"_31485":74470,"_21804":124810,"_5":15036,"_28646":124683,"_3122":54765},[],{"_3731":74518,"_31485":74470,"_21804":124812,"_5":15036,"_28646":124683,"_3122":124813},[],"Autorización del webhook configurado.",{"_3731":74519,"_31485":74470,"_21804":124815,"_5":15036,"_28646":124683,"_3122":54771},[],{"_3731":74520,"_31485":74470,"_21804":124817,"_5":15036,"_28646":124683,"_3122":124818},[],"Validación del certificado y, después, aprobación del webhook.",{"_3731":74521,"_31485":74470,"_21804":124820,"_5":15036,"_28646":124683,"_3122":54777},[],{"_3731":74522,"_31485":74470,"_21804":124822,"_5":15036,"_28646":124683,"_3122":124823},[],"Sin autenticación del solicitante por el DMS.",{"_3731":74523,"_31485":74470,"_21804":124825,"_5":15036,"_28646":124683,"_3122":124826},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3731":74524,"_31485":74470,"_21804":124828,"_5":15036,"_28646":124683,"_3122":124829},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired`, `chain_level_validation` y `allow_unverifiable_revocation`. El validador recibe una credencial de certificado; el flujo no garantiza transportar hasta él todas las intermedias del handshake. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3731":74525,"_31485":74470,"_21804":124831,"_5":15036,"_28646":124683,"_3122":124832},[],"El editor de autenticación ofrece el interruptor **Allow certificates without revocation information** (`allow_unverifiable_revocation`, desactivado por defecto). Cuando está activado, se aceptan certificados (y CAs intermedias de la cadena) que Lamassu no gestiona y que no declaran ningún endpoint OCSP o CRL; las respuestas de revocación inaccesibles, obsoletas o no concluyentes se rechazan siempre. Mientras el interruptor esté activado, la consola muestra una alerta de aviso: **Revocation will not be verified**. Un certificado revocado sin endpoint OCSP o CRL, y no gestionado por Lamassu, será aceptado, y esto se aplica también a las CAs intermedias de la cadena.",{"_3731":74526,"_31485":74470,"_21804":124834,"_5":15036,"_28646":124683,"_3122":124835},[],"El mismo interruptor se ofrece tanto en el editor de autenticación de enrolamiento como en el de reenrolamiento, y se almacena por bloque dentro de `est_rfc7030_settings.client_certificate_settings`; un DMS almacenado antes de que existiera el campo se carga con el interruptor desactivado. La consola también muestra una alerta de aviso siempre que una opción de autenticación esté en su estado inseguro (**Allow expired certificates** activado, **Allow expired renewal** activado o **Verify CSR signature** desactivado) y la nota de No authentication se presenta también como alerta de aviso.",{"_3731":74527,"_31485":74470,"_21804":124837,"_5":15036,"_28646":124683,"_3122":124838},[],"La revocación se comprueba en cada certificado presentado. En el enrolamiento inicial se comprueban el certificado de cliente **y** todas las CAs intermedias entre él y la CA de validación, cada una frente a su emisor; los certificados adicionales que envíe el dispositivo en el handshake se ignoran. Una CA de validación revocada en Lamassu rechaza la operación: se usa la primera CA de validación que valide el certificado, y una revocada no se sustituye por las demás CAs de validación. Los certificados emitidos y gestionados por Lamassu se comprueban con su estado almacenado. Los certificados externos se comprueban mediante sus endpoints OCSP y CRL, y la operación falla cerrada cuando la revocación no puede verificarse: solo `allow_unverifiable_revocation` (`false` por defecto en ambos bloques) relaja el caso de un certificado externo que no lista ningún endpoint. Los endpoints que existen pero no responden, devuelven evidencia caducada o inválida, o reportan un estado no concluyente se rechazan siempre, lo que diga la opción. Los detalles y la evidencia que deben presentar los endpoints están en Revocación y comprobaciones.",{"_3731":74528,"_31485":74470,"_21804":124840,"_5":15036,"_28646":124683,"_3122":124841},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`. El reenrolamiento comprueba la revocación solo del certificado de cliente; esa comprobación la rige el `allow_unverifiable_revocation` propio del bloque de reenrolamiento.",{"_3731":74529,"_31485":74470,"_21804":124843,"_5":15036,"_28646":124683,"_3122":124844},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3731":74530,"_31485":74470,"_21804":124846,"_5":15036,"_28646":124687,"_3122":124847},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3731":74531,"_31485":74470,"_21804":124849,"_5":15036,"_28646":124687,"_3122":124850},[],"Campo de `external_webhook_settings`",{"_3731":74532,"_31485":74470,"_21804":124852,"_5":15036,"_28646":124687,"_3122":124853},[],"Decisión",{"_3731":74533,"_31485":74470,"_21804":124855,"_5":15036,"_28646":124687,"_3122":54813},[],{"_3731":74534,"_31485":74470,"_21804":124857,"_5":15036,"_28646":124687,"_3122":124858},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3731":74535,"_31485":74470,"_21804":124860,"_5":15036,"_28646":124687,"_3122":54819},[],{"_3731":74536,"_31485":74470,"_21804":124862,"_5":15036,"_28646":124687,"_3122":124863},[],"`POST` o `PUT`; `POST` por defecto.",{"_3731":74537,"_31485":74470,"_21804":124865,"_5":15036,"_28646":124687,"_3122":54825},[],{"_3731":74538,"_31485":74470,"_21804":124867,"_5":15036,"_28646":124687,"_3122":124868},[],"Etiqueta usada en los logs del servicio.",{"_3731":74539,"_31485":74470,"_21804":124870,"_5":15036,"_28646":124687,"_3122":54831},[],{"_3731":74540,"_31485":74470,"_21804":124872,"_5":15036,"_28646":124687,"_3122":124873},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3731":74541,"_31485":74470,"_21804":124875,"_5":15036,"_28646":124687,"_3122":54837},[],{"_3731":74542,"_31485":74470,"_21804":124877,"_5":15036,"_28646":124687,"_3122":124878},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3731":74543,"_31485":74470,"_21804":124880,"_5":15036,"_28646":124687,"_3122":54843},[],{"_3731":74544,"_31485":74470,"_21804":124882,"_5":15036,"_28646":124687,"_3122":124883},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3731":74545,"_31485":74470,"_21804":124885,"_5":15036,"_28646":124687,"_3122":54849},[],{"_3731":74546,"_31485":74470,"_21804":124887,"_5":15036,"_28646":124687,"_3122":124888},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3731":74547,"_31485":74470,"_21804":124890,"_5":15036,"_28646":124687,"_3122":54855},[],{"_3731":74548,"_31485":74470,"_21804":124892,"_5":15036,"_28646":124687,"_3122":124893},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3731":74549,"_31485":74470,"_21804":124895,"_5":15036,"_28646":124687,"_3122":54861},[],{"_3731":74550,"_31485":74470,"_21804":124897,"_5":15036,"_28646":124687,"_3122":124898},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3731":74551,"_31485":74470,"_21804":124900,"_5":15036,"_28646":124687,"_3122":54867},[],{"_3731":74552,"_31485":74470,"_21804":124902,"_5":15036,"_28646":124687,"_3122":124903},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3731":74553,"_31485":74470,"_21804":124905,"_5":15036,"_28646":124687,"_3122":124906},[],"Reglas de esa configuración:",{"_3731":74554,"_31485":74470,"_21804":124908,"_5":15036,"_28646":124687,"_3122":124909},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 (el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config`) cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3731":74555,"_31485":74470,"_21804":124911,"_5":15036,"_28646":124687,"_3122":124912},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían (por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded`) y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3731":74556,"_31485":74470,"_21804":124914,"_5":15036,"_28646":124687,"_3122":124915},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3731":74557,"_31485":74470,"_21804":124917,"_5":15036,"_28646":124687,"_3122":124918},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3731":74558,"_31485":74470,"_21804":124920,"_5":15036,"_28646":124687,"_3122":124921},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3731":74559,"_31485":74470,"_21804":124923,"_5":15036,"_28646":124687,"_3122":124924},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3731":74560,"_31485":74470,"_21804":124926,"_5":15036,"_28646":124687,"_3122":124927},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. El reenrolamiento consulta su propio bloque y un modo ausente o desconocido falla. Lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3731":74561,"_31485":74470,"_21804":124929,"_5":15036,"_28646":124687,"_3122":124930},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación (los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse) hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM (el editor rechaza las rutas de fichero con un error en el propio campo) y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3731":74562,"_31485":74470,"_21804":124932,"_5":15036,"_28646":124687,"_3122":124933},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio (los campos JSON desconocidos se descartan) y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3731":74563,"_31485":74470,"_21804":124935,"_5":15036,"_28646":124691,"_3122":124936},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3731":74564,"_31485":74470,"_21804":124938,"_5":15036,"_28646":124691,"_3122":124939},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3731":74565,"_31485":74470,"_21804":124941,"_5":15036,"_28646":124695,"_3122":124942},[],"Para recorrer todas las operaciones de un primer enrolamiento, sigue Enrola y conecta tu primer dispositivo.",{"_3731":74566,"_31485":74470,"_21804":124944,"_5":15036,"_28646":124695,"_3122":124945},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3731":74567,"_31485":74470,"_21804":124947,"_5":15036,"_28646":124695,"_3122":124948},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3731":74568,"_31485":74470,"_21804":124950,"_5":15036,"_28646":124695,"_3122":124951},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3731":74569,"_31485":74470,"_21804":124953,"_5":15036,"_28646":124698,"_3122":124954},[],"`GET /cacerts` descarga el conjunto de certificados que publica el DMS. El cliente puede inspeccionarlo y usar los certificados aprobados para construir cadenas de confianza.",{"_3731":74570,"_31485":74470,"_21804":124956,"_5":15036,"_28646":124701,"_3122":124957},[],"Las opciones se guardan en `settings.ca_distribution_settings` y determinan el contenido de `/cacerts`.",{"_3731":74571,"_31485":74470,"_21804":124959,"_5":15036,"_28646":124701,"_3122":124960},[],"**Certificado TLS de Lamassu**",{"_3731":74572,"_31485":74470,"_21804":124962,"_5":15036,"_28646":124701,"_3122":124963},[],"`include_system_ca` (**Include Lamassu System CA**). Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3731":74573,"_31485":74470,"_21804":124965,"_5":15036,"_28646":124701,"_3122":124966},[],"**CA de enrolamiento**",{"_3731":74574,"_31485":74470,"_21804":124968,"_5":15036,"_28646":124701,"_3122":124969},[],"`include_enrollment_ca` (**Include Enrollment CA**). Certificado de la CA emisora seleccionada.",{"_3731":74575,"_31485":74470,"_21804":124971,"_5":15036,"_28646":124701,"_3122":124972},[],"**CAs gestionadas**",{"_3731":74576,"_31485":74470,"_21804":124974,"_5":15036,"_28646":124701,"_3122":124975},[],"`managed_cas` (**Managed CAs**). Certificados de las CAs elegidas explícitamente.",{"_3731":74577,"_31485":74470,"_21804":124977,"_5":15036,"_28646":124701,"_3122":124978},[],"No se añaden todos los ascendientes automáticamente.",{"_3731":74578,"_31485":74470,"_21804":124980,"_5":15036,"_28646":124705,"_3122":124981},[],"Envía un GET por HTTPS sin cuerpo. El DMS permite consultar los certificados sin credencial EST. Siguen aplicándose los controles del Gateway.",{"_3731":74579,"_31485":74470,"_21804":124983,"_5":15036,"_28646":124705,"_3122":124984},[],"**Respuesta predeterminada.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres.",{"_3731":74580,"_31485":74470,"_21804":124986,"_5":15036,"_28646":124705,"_3122":124987},[],"**Respuesta PEM.** Lamassu selecciona este formato cuando `Accept` es exactamente `application/x-pem-file` y devuelve ese mismo valor en `Content-Type`. El cuerpo contiene los certificados en PEM.",{"_3731":74581,"_31485":74470,"_21804":124989,"_5":15036,"_28646":124705,"_3122":124990},[],"**Qué devuelve cacerts**",{"_3731":74582,"_31485":74470,"_21804":124992,"_5":15036,"_28646":124705,"_3122":124993},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3731":74583,"_31485":74470,"_21804":124995,"_5":15036,"_28646":124705,"_3122":124996},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3731":74584,"_31485":74470,"_21804":124998,"_5":15036,"_28646":124705,"_3122":124999},[],"**Descarga e inspecciona cacerts**",{"_3731":74585,"_31485":74470,"_21804":125001,"_5":15036,"_28646":124705,"_3122":125002},[],"El ejemplo descarga y convierte la respuesta predeterminada. Sigue la preparación del cliente para definir `EST_BASE` y preparar las credenciales.",{"_3731":74586,"_31485":74470,"_21804":125004,"_5":15036,"_28646":124705,"_3122":125005},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3731":74587,"_31485":74470,"_21804":125007,"_5":15036,"_28646":124709,"_3122":125008},[],"`POST /simpleenroll` emite el certificado inicial de un dispositivo a partir de una CSR. Lamassu toma el identificador del dispositivo del CN y vincula el certificado emitido a su identidad. La clave privada permanece en el cliente.",{"_3731":74588,"_31485":74470,"_21804":125010,"_5":15036,"_28646":124712,"_3122":125011},[],"Las siguientes opciones se guardan en `settings.enrollment_settings`.",{"_3731":74589,"_31485":74470,"_21804":125013,"_5":15036,"_28646":124712,"_3122":125014},[],"**Modo de registro**",{"_3731":74590,"_31485":74470,"_21804":125016,"_5":15036,"_28646":124712,"_3122":125017},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario.",{"_3731":74591,"_31485":74470,"_21804":125019,"_5":15036,"_28646":124712,"_3122":125020},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. Un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3731":74592,"_31485":74470,"_21804":125022,"_5":15036,"_28646":124712,"_3122":125023},[],"**Perfil de aprovisionamiento**",{"_3731":74593,"_31485":74470,"_21804":125025,"_5":15036,"_28646":124712,"_3122":125026},[],"`settings.enrollment_settings.device_provisioning_profile` aporta etiquetas, metadatos e icono en el alta por JITP.",{"_3731":74594,"_31485":74470,"_21804":125028,"_5":15036,"_28646":124712,"_3122":125029},[],"**Protocolo**",{"_3731":74595,"_31485":74470,"_21804":125031,"_5":15036,"_28646":124712,"_3122":125032},[],"`protocol`. `EST_RFC7030` para estas operaciones.",{"_3731":74596,"_31485":74470,"_21804":125034,"_5":15036,"_28646":124712,"_3122":125035},[],"**CA emisora**",{"_3731":74597,"_31485":74470,"_21804":125037,"_5":15036,"_28646":124712,"_3122":125038},[],"`enrollment_ca`. ID de la CA que firmará.",{"_3731":74598,"_31485":74470,"_21804":125040,"_5":15036,"_28646":124712,"_3122":125041},[],"**Verificación de la firma de la CSR**",{"_3731":74599,"_31485":74470,"_21804":125043,"_5":15036,"_28646":124712,"_3122":125044},[],"`verify_csr_signature`. Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3731":74600,"_31485":74470,"_21804":125046,"_5":15036,"_28646":124712,"_3122":125047},[],"**Sustitución del certificado**",{"_3731":74601,"_31485":74470,"_21804":125049,"_5":15036,"_28646":124712,"_3122":125050},[],"`enable_replaceable_enrollment`. Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3731":74602,"_31485":74470,"_21804":125052,"_5":15036,"_28646":124712,"_3122":125053},[],"**Modo de autenticación**",{"_3731":74603,"_31485":74470,"_21804":125055,"_5":15036,"_28646":124712,"_3122":125056},[],"`est_rfc7030_settings.auth_mode`. Selecciona un modo de autenticación para el enrolamiento inicial.",{"_3731":74604,"_31485":74470,"_21804":125058,"_5":15036,"_28646":124712,"_3122":125059},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3731":74605,"_31485":74470,"_21804":125061,"_5":15036,"_28646":124712,"_3122":125062},[],"**Perfil de emisión**",{"_3731":74606,"_31485":74470,"_21804":125064,"_5":15036,"_28646":124712,"_3122":125065},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. El perfil resuelto (incluido el perfil predeterminado de la CA, que se usa como alternativa cuando el DMS no define ninguno) debe definir un certificado final: un perfil con `Sign as CA` se rechaza en el enrolamiento y en el reenrolamiento. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3731":74607,"_31485":74470,"_21804":125067,"_5":15036,"_28646":124715,"_3122":125068},[],"Envía `Content-Type: application/pkcs10` y una CSR PKCS#10 DER codificada en Base64 en el cuerpo. Lamassu decodifica el cuerpo como Base64, sin envoltorio PEM ni JSON.",{"_3731":74608,"_31485":74470,"_21804":125070,"_5":15036,"_28646":124715,"_3122":125071},[],"**Respuesta predeterminada.** `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El PKCS#7 contiene el certificado emitido. Obtén por separado los certificados de CA que necesites para verificar su cadena.",{"_3731":74609,"_31485":74470,"_21804":125073,"_5":15036,"_28646":124715,"_3122":125074},[],"**Respuesta PEM.** Envía exactamente `Accept: application/x-pem-file` para recibir el certificado en PEM con `Content-Type: application/x-pem-file`.",{"_3731":74610,"_31485":74470,"_21804":125076,"_5":15036,"_28646":124715,"_3122":125077},[],"Sigue la preparación del cliente para definir `EST_BASE` y preparar las credenciales.",{"_3731":74611,"_31485":74470,"_21804":125079,"_5":15036,"_28646":124715,"_3122":125080},[],"**Prepara la CSR**",{"_3731":74612,"_31485":74470,"_21804":125082,"_5":15036,"_28646":124715,"_3122":125083},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3731":74613,"_31485":74470,"_21804":125085,"_5":15036,"_28646":124715,"_3122":125086},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3731":74614,"_31485":74470,"_21804":125088,"_5":15036,"_28646":124715,"_3122":125089},[],"**Solicita la identidad**",{"_3731":74615,"_31485":74470,"_21804":125091,"_5":15036,"_28646":124715,"_3122":125092},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3731":74616,"_31485":74470,"_21804":125094,"_5":15036,"_28646":124715,"_3122":125095},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3731":74617,"_31485":74470,"_21804":125097,"_5":15036,"_28646":124715,"_3122":125098},[],"Para el caso de una raíz que emite directamente:",{"_3731":74618,"_31485":74470,"_21804":125100,"_5":15036,"_28646":124715,"_3122":125101},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3731":74619,"_31485":74470,"_21804":125103,"_5":15036,"_28646":124715,"_3122":125104},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3731":74620,"_31485":74470,"_21804":125106,"_5":15036,"_28646":124718,"_3122":125107},[],"`POST /simplereenroll` emite un certificado sucesor para una identidad activa. El cliente conserva el identificador del dispositivo y puede solicitar el certificado con una clave nueva.",{"_3731":74621,"_31485":74470,"_21804":125109,"_5":15036,"_28646":124721,"_3122":125110},[],"Las siguientes opciones se guardan en `settings.reenrollment_settings`.",{"_3731":74622,"_31485":74470,"_21804":125112,"_5":15036,"_28646":124721,"_3122":125113},[],"**Autenticación de renovación**",{"_3731":74623,"_31485":74470,"_21804":125115,"_5":15036,"_28646":124721,"_3122":125116},[],"`est_rfc7030_settings.auth_mode` define cómo se autentica el cliente para renovar. Consulta Autenticación por operación.",{"_3731":74624,"_31485":74470,"_21804":125118,"_5":15036,"_28646":124721,"_3122":125119},[],"**Ventana de renovación**",{"_3731":74625,"_31485":74470,"_21804":125121,"_5":15036,"_28646":124721,"_3122":125122},[],"`reenrollment_delta`. La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3731":74626,"_31485":74470,"_21804":125124,"_5":15036,"_28646":124721,"_3122":125125},[],"**Umbral preventivo**",{"_3731":74627,"_31485":74470,"_21804":125127,"_5":15036,"_28646":124721,"_3122":125128},[],"`preventive_delta`. Umbral operativo preventivo de monitorización.",{"_3731":74628,"_31485":74470,"_21804":125130,"_5":15036,"_28646":124721,"_3122":125131},[],"**Umbral crítico**",{"_3731":74629,"_31485":74470,"_21804":125133,"_5":15036,"_28646":124721,"_3122":125134},[],"`critical_delta`. Umbral operativo crítico de monitorización.",{"_3731":74630,"_31485":74470,"_21804":125136,"_5":15036,"_28646":124721,"_3122":125137},[],"**Renovación con certificado vencido**",{"_3731":74631,"_31485":74470,"_21804":125139,"_5":15036,"_28646":124721,"_3122":125140},[],"`enable_expired_renewal`. Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3731":74632,"_31485":74470,"_21804":125142,"_5":15036,"_28646":124721,"_3122":125143},[],"**CAs de validación de renovación**",{"_3731":74633,"_31485":74470,"_21804":125145,"_5":15036,"_28646":124721,"_3122":125146},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`. CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3731":74634,"_31485":74470,"_21804":125148,"_5":15036,"_28646":124721,"_3122":125149},[],"**Revocación del certificado anterior**",{"_3731":74635,"_31485":74470,"_21804":125151,"_5":15036,"_28646":124721,"_3122":125152},[],"`revoke_on_reenrollment`. Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3731":74636,"_31485":74470,"_21804":125154,"_5":15036,"_28646":124721,"_3122":125155},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa renovación y recuperación para orden de operaciones y fallos parciales.",{"_3731":74637,"_31485":74470,"_21804":125157,"_5":15036,"_28646":124724,"_3122":125158},[],"Usa el mismo formato de CSR y cabeceras que en `simpleenroll`. La respuesta contiene el certificado sucesor en PKCS#7 DER codificado en Base64 o en PEM si envías exactamente `Accept: application/x-pem-file`.",{"_3731":74638,"_31485":74470,"_21804":125160,"_5":15036,"_28646":124724,"_3122":125161},[],"Con autenticación por certificado, Lamassu exige que el CN de la credencial coincida con el de la CSR y compara el sujeto solicitado con el del certificado actual. El DMS rechaza un certificado activo revocado o una solicitud anterior a la ventana de renovación. La autenticación por operación detalla las CAs admitidas, el vencimiento y las comprobaciones de revocación.",{"_3731":74639,"_31485":74470,"_21804":125163,"_5":15036,"_28646":124724,"_3122":125164},[],"**Prepara la renovación**",{"_3731":74640,"_31485":74470,"_21804":125166,"_5":15036,"_28646":124724,"_3122":125167},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3731":74641,"_31485":74470,"_21804":125169,"_5":15036,"_28646":124724,"_3122":125170},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3731":74642,"_31485":74470,"_21804":125172,"_5":15036,"_28646":124724,"_3122":125173},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3731":74643,"_31485":74470,"_21804":125175,"_5":15036,"_28646":124724,"_3122":125176},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3731":74644,"_31485":74470,"_21804":125178,"_5":15036,"_28646":124724,"_3122":125179},[],"**Solicita el certificado sucesor**",{"_3731":74645,"_31485":74470,"_21804":125181,"_5":15036,"_28646":124724,"_3122":125182},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3731":74646,"_31485":74470,"_21804":125184,"_5":15036,"_28646":124724,"_3122":125185},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3731":74647,"_31485":74470,"_21804":125187,"_5":15036,"_28646":124724,"_3122":125188},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3731":74648,"_31485":74470,"_21804":125190,"_5":15036,"_28646":124724,"_3122":125191},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3731":74649,"_31485":74470,"_21804":125193,"_5":15036,"_28646":124724,"_3122":125194},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3731":74650,"_31485":74470,"_21804":125196,"_5":15036,"_28646":124727,"_3122":125197},[],"Situación",{"_3731":74651,"_31485":74470,"_21804":125199,"_5":15036,"_28646":124727,"_3122":125200},[],"Procedimiento",{"_3731":74652,"_31485":74470,"_21804":125202,"_5":15036,"_28646":124727,"_3122":125203},[],"Certificado vigente, fuera de ventana",{"_3731":74653,"_31485":74470,"_21804":125205,"_5":15036,"_28646":124727,"_3122":125206},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3731":74654,"_31485":74470,"_21804":125208,"_5":15036,"_28646":124727,"_3122":125209},[],"Certificado vencido, clave disponible",{"_3731":74655,"_31485":74470,"_21804":125211,"_5":15036,"_28646":124727,"_3122":125212},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3731":74656,"_31485":74470,"_21804":125214,"_5":15036,"_28646":124727,"_3122":125215},[],"Renovación por webhook o `NO_AUTH`",{"_3731":74657,"_31485":74470,"_21804":125217,"_5":15036,"_28646":124727,"_3122":125218},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3731":74658,"_31485":74470,"_21804":125220,"_5":15036,"_28646":124727,"_3122":125221},[],"Clave perdida o inaccesible",{"_3731":74659,"_31485":74470,"_21804":125223,"_5":15036,"_28646":124727,"_3122":125224},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3731":74660,"_31485":74470,"_21804":125226,"_5":15036,"_28646":124727,"_3122":125227},[],"Identidad actual revocada",{"_3731":74661,"_31485":74470,"_21804":125229,"_5":15036,"_28646":124727,"_3122":125230},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3731":74662,"_31485":74470,"_21804":125232,"_5":15036,"_28646":124727,"_3122":125233},[],"Dispositivo sin identidad",{"_3731":74663,"_31485":74470,"_21804":125235,"_5":15036,"_28646":124727,"_3122":125236},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3731":74664,"_31485":74470,"_21804":125238,"_5":15036,"_28646":124727,"_3122":125239},[],"Dispositivo retirado",{"_3731":74665,"_31485":74470,"_21804":125241,"_5":15036,"_28646":124727,"_3122":125242},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3731":74666,"_31485":74470,"_21804":125244,"_5":15036,"_28646":124727,"_3122":125245},[],"Timeout, HTTP 500 o fallo de instalación",{"_3731":74667,"_31485":74470,"_21804":125247,"_5":15036,"_28646":124727,"_3122":125248},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3731":74668,"_31485":74470,"_21804":125250,"_5":15036,"_28646":124731,"_3122":125251},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3731":74669,"_31485":74470,"_21804":125253,"_5":15036,"_28646":124731,"_3122":125254},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3731":74670,"_31485":74470,"_21804":125256,"_5":15036,"_28646":124735,"_3122":125257},[],"`POST /serverkeygen` genera una clave software en Lamassu, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El cliente recibe la clave privada y el certificado.",{"_3731":74671,"_31485":74470,"_21804":125259,"_5":15036,"_28646":124738,"_3122":125260},[],"`settings.server_keygen_settings` controla la generación de claves. La operación aplica la política de enrolamiento inicial. Antes de probarla con un ID registrado, revisa si la política permite sustituir el certificado.",{"_3731":74672,"_31485":74470,"_21804":125262,"_5":15036,"_28646":124738,"_3122":125263},[],"**Habilitar la generación**",{"_3731":74673,"_31485":74470,"_21804":125265,"_5":15036,"_28646":124738,"_3122":125266},[],"`enabled` activa la operación. La consola muestra el interruptor **Enable server-side key generation**. Cuando está deshabilitada, la consola omite el campo `key`.",{"_3731":74674,"_31485":74470,"_21804":125268,"_5":15036,"_28646":124738,"_3122":125269},[],"**Tipo de clave**",{"_3731":74675,"_31485":74470,"_21804":125271,"_5":15036,"_28646":124738,"_3122":125272},[],"`key.type` selecciona RSA o ECDSA en **Key type**. El perfil de emisión debe permitir el algoritmo y tamaño elegidos.",{"_3731":74676,"_31485":74470,"_21804":125274,"_5":15036,"_28646":124738,"_3122":125275},[],"**Tamaño de clave**",{"_3731":74677,"_31485":74470,"_21804":125277,"_5":15036,"_28646":124738,"_3122":125278},[],"`key.bits` representa el tamaño del módulo para RSA o la curva para ECDSA. La consola ofrece RSA de 2048, 3072 y 4096 bits, con 4096 como valor predeterminado, y ECDSA P-256, P-384 y P-521, con P-256 como valor predeterminado.",{"_3731":74678,"_31485":74470,"_21804":125280,"_5":15036,"_28646":124738,"_3122":125281},[],"Para ECDSA, el servicio también reconoce los valores 224, 256, 384 y 521 como P-224, P-256, P-384 y P-521. Un valor desconocido selecciona P-256. Elige un tamaño compatible y comprueba la clave resultante.",{"_3731":74679,"_31485":74470,"_21804":125283,"_5":15036,"_28646":124741,"_3122":125284},[],"Envía una CSR PKCS#10 DER codificada en Base64 con `Content-Type: application/pkcs10`. La respuesta usa el formato multipart de esta operación incluso si se solicita PEM mediante `Accept`. La clave se genera en software aunque la CA firme con una clave alojada en HSM.",{"_3731":74680,"_31485":74470,"_21804":125286,"_5":15036,"_28646":124741,"_3122":125287},[],"**Formato de respuesta**",{"_3731":74681,"_31485":74470,"_21804":125289,"_5":15036,"_28646":124741,"_3122":125290},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3731":74682,"_31485":74470,"_21804":125292,"_5":15036,"_28646":124741,"_3122":125293},[],"Parte",{"_3731":74683,"_31485":74470,"_21804":125295,"_5":15036,"_28646":124741,"_3122":125296},[],"Contenido tras decodificar su Base64",{"_3731":74684,"_31485":74470,"_21804":125298,"_5":15036,"_28646":124741,"_3122":55266},[],{"_3731":74685,"_31485":74470,"_21804":125300,"_5":15036,"_28646":124741,"_3122":125301},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3731":74686,"_31485":74470,"_21804":125303,"_5":15036,"_28646":124741,"_3122":55272},[],{"_3731":74687,"_31485":74470,"_21804":125305,"_5":15036,"_28646":124741,"_3122":125306},[],"PKCS#7 DER con el certificado emitido.",{"_3731":74688,"_31485":74470,"_21804":125308,"_5":15036,"_28646":124741,"_3122":125309},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3731":74689,"_31485":74470,"_21804":125311,"_5":15036,"_28646":124741,"_3122":125312},[],"**Ejemplo de petición**",{"_3731":74690,"_31485":74470,"_21804":125314,"_5":15036,"_28646":124741,"_3122":125315},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de preparación del cliente. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3731":74691,"_31485":74470,"_21804":125317,"_5":15036,"_28646":124741,"_3122":125318},[],"Procesa las partes MIME según sus cabeceras y comprueba que la clave recibida corresponde al certificado. Inspecciona el CN, la serie, las fechas y los usos, y comprueba la asociación en Lamassu antes de instalar. Protege los archivos que contienen la clave y elimina las copias temporales según el almacenamiento del dispositivo.",{"_3731":74692,"_31485":74692,"_5":15390,"_3122":125320,"_31812":125321,"_21804":125322,"_28646":74692},"Referencia EST",[51373,123005,54083,54532],[],{"_3731":74693,"_31485":74692,"_21804":125324,"_5":15036,"_28646":74692,"_3122":125325},[],"El protocolo Enrollment over Secure Transport definido en RFC 7030.",{"_3731":74694,"_31485":74692,"_5":31809,"_21804":125327,"_28646":125328,"_3122":125329},[],"/docs/es/platform/iot-fleets/est#operaciones","Operaciones",{"_3731":74695,"_31485":74692,"_5":31809,"_21804":125331,"_28646":125332,"_3122":125333},[],"/docs/es/platform/iot-fleets/est#autenticación-y-mensajes","Autenticación y mensajes",{"_3731":74696,"_31485":74692,"_21804":125335,"_5":15036,"_28646":74692,"_3122":125336},[],"Enrollment over Secure Transport (EST) es un protocolo para obtener y renovar certificados X.509 mediante HTTPS. Un cliente EST se comunica con un servidor EST, que gestiona la solicitud de certificado y facilita los certificados de las autoridades de certificación. El estándar define mensajes, operaciones y mecanismos de autenticación. RFC 7030",{"_3731":74697,"_31485":74692,"_21804":125338,"_5":15036,"_28646":125328,"_3122":125339},[],"Las rutas de operación se añaden al prefijo `/.well-known/est`, que puede incluir una etiqueta para identificar la CA o el servicio.",{"_3731":74698,"_31485":74692,"_21804":125341,"_5":15036,"_28646":125328,"_3122":122765},[],{"_3731":74699,"_31485":74692,"_21804":125343,"_5":15036,"_28646":125328,"_3122":124755},[],{"_3731":74700,"_31485":74692,"_21804":125345,"_5":15036,"_28646":125328,"_3122":125346},[],"Función",{"_3731":74701,"_31485":74692,"_21804":125348,"_5":15036,"_28646":125328,"_3122":125349},[],"Soporte del servidor",{"_3731":74702,"_31485":74692,"_21804":125351,"_5":15036,"_28646":125328,"_3122":54707},[],{"_3731":74703,"_31485":74692,"_21804":125353,"_5":15036,"_28646":125328,"_3122":54710},[],{"_3731":74704,"_31485":74692,"_21804":125355,"_5":15036,"_28646":125328,"_3122":125356},[],"Obtener certificados de CA.",{"_3731":74705,"_31485":74692,"_21804":125358,"_5":15036,"_28646":125328,"_3122":125359},[],"Obligatorio",{"_3731":74706,"_31485":74692,"_21804":125361,"_5":15036,"_28646":125328,"_3122":54716},[],{"_3731":74707,"_31485":74692,"_21804":125363,"_5":15036,"_28646":125328,"_3122":54719},[],{"_3731":74708,"_31485":74692,"_21804":125365,"_5":15036,"_28646":125328,"_3122":125366},[],"Solicitar un certificado inicial mediante una CSR.",{"_3731":74709,"_31485":74692,"_21804":125368,"_5":15036,"_28646":125328,"_3122":125359},[],{"_3731":74710,"_31485":74692,"_21804":125370,"_5":15036,"_28646":125328,"_3122":54725},[],{"_3731":74711,"_31485":74692,"_21804":125372,"_5":15036,"_28646":125328,"_3122":54719},[],{"_3731":74712,"_31485":74692,"_21804":125374,"_5":15036,"_28646":125328,"_3122":125375},[],"Solicitar la renovación o sustitución de clave de un certificado.",{"_3731":74713,"_31485":74692,"_21804":125377,"_5":15036,"_28646":125328,"_3122":125359},[],{"_3731":74714,"_31485":74692,"_21804":125379,"_5":15036,"_28646":125328,"_3122":54733},[],{"_3731":74715,"_31485":74692,"_21804":125381,"_5":15036,"_28646":125328,"_3122":54719},[],{"_3731":74716,"_31485":74692,"_21804":125383,"_5":15036,"_28646":125328,"_3122":125384},[],"Solicitar una clave generada por el servidor y el certificado asociado.",{"_3731":74717,"_31485":74692,"_21804":125386,"_5":15036,"_28646":125328,"_3122":125387},[],"Opcional",{"_3731":74718,"_31485":74692,"_21804":125389,"_5":15036,"_28646":125328,"_3122":55357},[],{"_3731":74719,"_31485":74692,"_21804":125391,"_5":15036,"_28646":125328,"_3122":54710},[],{"_3731":74720,"_31485":74692,"_21804":125393,"_5":15036,"_28646":125328,"_3122":125394},[],"Consultar atributos sugeridos para la CSR.",{"_3731":74721,"_31485":74692,"_21804":125396,"_5":15036,"_28646":125328,"_3122":125387},[],{"_3731":74722,"_31485":74692,"_21804":125398,"_5":15036,"_28646":125328,"_3122":55367},[],{"_3731":74723,"_31485":74692,"_21804":125400,"_5":15036,"_28646":125328,"_3122":54719},[],{"_3731":74724,"_31485":74692,"_21804":125402,"_5":15036,"_28646":125328,"_3122":125403},[],"Enviar una solicitud Full CMC.",{"_3731":74725,"_31485":74692,"_21804":125405,"_5":15036,"_28646":125328,"_3122":125387},[],{"_3731":74726,"_31485":74692,"_21804":125407,"_5":15036,"_28646":125332,"_3122":125408},[],"EST utiliza TLS para proteger el intercambio. El cliente autentica al servidor y el servidor autentica y autoriza al cliente mediante los mecanismos definidos por el estándar. La distribución inicial de certificados de CA tiene condiciones particulares para establecer la confianza. RFC 7030, secciones 3.3 y 4.1",{"_3731":74727,"_31485":74692,"_21804":125410,"_5":15036,"_28646":125332,"_3122":125411},[],"Las solicitudes de `/simpleenroll` y `/simplereenroll` utilizan una CSR PKCS#10. La respuesta de certificado utiliza PKCS#7. La respuesta de `/serverkeygen` es `multipart/mixed` y contiene la clave y el certificado. El estándar también define la solicitud y la respuesta Full CMC y el formato de atributos de CSR. RFC 7030, sección 3.2.4",{"_3731":74728,"_31485":74692,"_21804":125413,"_5":15036,"_28646":125332,"_3122":125414},[],"Consulta EST en Lamassu para conocer las operaciones disponibles y su configuración.",{"_3731":74729,"_31485":74729,"_5":15390,"_3122":125416,"_31812":125417,"_21804":125418,"_28646":74729},"Diagnóstico de enrolamiento",[51373,123005,54083,54532],[],{"_3731":74730,"_31485":74729,"_21804":125420,"_5":15036,"_28646":74729,"_3122":125421},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3731":74731,"_31485":74729,"_5":31809,"_21804":125423,"_28646":125424,"_3122":125425},[],"/docs/es/platform/iot-fleets/est/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3731":74732,"_31485":74729,"_5":31809,"_21804":125427,"_28646":125428,"_3122":125429},[],"/docs/es/platform/iot-fleets/est/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3731":74733,"_31485":74729,"_5":31809,"_21804":125431,"_28646":125432,"_3122":124692},[],"/docs/es/platform/iot-fleets/est/troubleshooting#notas-de-compatibilidad",{"_3731":74734,"_31485":74729,"_5":31809,"_21804":125434,"_28646":125435,"_3122":125436},[],"/docs/es/platform/iot-fleets/est/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3731":74735,"_31485":74729,"_21804":125438,"_5":15036,"_28646":74729,"_3122":125439},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3731":74736,"_31485":74729,"_21804":125441,"_5":15036,"_28646":125428,"_3122":125442},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3731":74737,"_31485":74729,"_21804":125444,"_5":15036,"_28646":125428,"_3122":125445},[],"Síntoma o mensaje",{"_3731":74738,"_31485":74729,"_21804":125447,"_5":15036,"_28646":125428,"_3122":125448},[],"Qué revisar",{"_3731":74739,"_31485":74729,"_21804":125450,"_5":15036,"_28646":125428,"_3122":125451},[],"curl rechaza TLS, nombre o emisor",{"_3731":74740,"_31485":74729,"_21804":125453,"_5":15036,"_28646":125428,"_3122":125454},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3731":74741,"_31485":74729,"_21804":125456,"_5":15036,"_28646":125428,"_3122":125457},[],"404 o APS ausente",{"_3731":74742,"_31485":74729,"_21804":125459,"_5":15036,"_28646":125428,"_3122":125460},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3731":74743,"_31485":74729,"_21804":125462,"_5":15036,"_28646":125428,"_3122":125463},[],"400, error de CSR o formato",{"_3731":74744,"_31485":74729,"_21804":125465,"_5":15036,"_28646":125428,"_3122":125466},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3731":74745,"_31485":74729,"_21804":125468,"_5":15036,"_28646":125428,"_3122":125469},[],"Credencial ausente o certificado no válido",{"_3731":74746,"_31485":74729,"_21804":125471,"_5":15036,"_28646":125428,"_3122":125472},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3731":74747,"_31485":74729,"_21804":125474,"_5":15036,"_28646":125428,"_3122":125475},[],"El enrolamiento o el reenrolamiento rechaza un certificado por revocación no verificable",{"_3731":74748,"_31485":74729,"_21804":125477,"_5":15036,"_28646":125428,"_3122":125478},[],"Si el certificado lo gestiona Lamassu, si sus endpoints OCSP/CRL están configurados y son alcanzables desde el servicio, y si `allow_unverifiable_revocation` está activo en el bloque de esa operación. Consulta DMS y Revocación y comprobaciones.",{"_3731":74749,"_31485":74729,"_21804":125480,"_5":15036,"_28646":125428,"_3122":125481},[],"Webhook deniega, expira o responde sin autorización",{"_3731":74750,"_31485":74729,"_21804":125483,"_5":15036,"_28646":125428,"_3122":125484},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3731":74751,"_31485":74729,"_21804":125486,"_5":15036,"_28646":125428,"_3122":55455},[],{"_3731":74752,"_31485":74729,"_21804":125488,"_5":15036,"_28646":125428,"_3122":125489},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3731":74753,"_31485":74729,"_21804":125491,"_5":15036,"_28646":125428,"_3122":55461},[],{"_3731":74754,"_31485":74729,"_21804":125493,"_5":15036,"_28646":125428,"_3122":125494},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3731":74755,"_31485":74729,"_21804":125496,"_5":15036,"_28646":125428,"_3122":55467},[],{"_3731":74756,"_31485":74729,"_21804":125498,"_5":15036,"_28646":125428,"_3122":125499},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3731":74757,"_31485":74729,"_21804":125501,"_5":15036,"_28646":125428,"_3122":55473},[],{"_3731":74758,"_31485":74729,"_21804":125503,"_5":15036,"_28646":125428,"_3122":125504},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3731":74759,"_31485":74729,"_21804":125506,"_5":15036,"_28646":125428,"_3122":55479},[],{"_3731":74760,"_31485":74729,"_21804":125508,"_5":15036,"_28646":125428,"_3122":125509},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3731":74761,"_31485":74729,"_21804":125511,"_5":15036,"_28646":125428,"_3122":125512},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3731":74762,"_31485":74729,"_21804":125514,"_5":15036,"_28646":125428,"_3122":125515},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3731":74763,"_31485":74729,"_21804":125517,"_5":15036,"_28646":125428,"_3122":125518},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3731":74764,"_31485":74729,"_21804":125520,"_5":15036,"_28646":125428,"_3122":125521},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3731":74765,"_31485":74729,"_21804":125523,"_5":15036,"_28646":125428,"_3122":55497},[],{"_3731":74766,"_31485":74729,"_21804":125525,"_5":15036,"_28646":125428,"_3122":125526},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3731":74767,"_31485":74729,"_21804":125528,"_5":15036,"_28646":125428,"_3122":55503},[],{"_3731":74768,"_31485":74729,"_21804":125530,"_5":15036,"_28646":125428,"_3122":125531},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3731":74769,"_31485":74729,"_21804":125533,"_5":15036,"_28646":125428,"_3122":125534},[],"DMS propietario distinto",{"_3731":74770,"_31485":74729,"_21804":125536,"_5":15036,"_28646":125428,"_3122":125537},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3731":74771,"_31485":74729,"_21804":125539,"_5":15036,"_28646":125428,"_3122":55515},[],{"_3731":74772,"_31485":74729,"_21804":125541,"_5":15036,"_28646":125428,"_3122":125542},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3731":74773,"_31485":74729,"_21804":125544,"_5":15036,"_28646":125428,"_3122":55521},[],{"_3731":74774,"_31485":74729,"_21804":125546,"_5":15036,"_28646":125428,"_3122":125547},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3731":74775,"_31485":74729,"_21804":125549,"_5":15036,"_28646":125428,"_3122":125550},[],"Certificado actual revocado",{"_3731":74776,"_31485":74729,"_21804":125552,"_5":15036,"_28646":125428,"_3122":125553},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3731":74777,"_31485":74729,"_21804":125555,"_5":15036,"_28646":125428,"_3122":125556},[],"Error de CA, perfil o firma",{"_3731":74778,"_31485":74729,"_21804":125558,"_5":15036,"_28646":125428,"_3122":125559},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3731":74779,"_31485":74729,"_21804":125561,"_5":15036,"_28646":125428,"_3122":125562},[],"HTTP 200 sin conexión del dispositivo",{"_3731":74780,"_31485":74729,"_21804":125564,"_5":15036,"_28646":125428,"_3122":125565},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3731":74781,"_31485":74729,"_21804":125567,"_5":15036,"_28646":125428,"_3122":125568},[],"Timeout o error después de emitir",{"_3731":74782,"_31485":74729,"_21804":125570,"_5":15036,"_28646":125428,"_3122":125571},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3731":74783,"_31485":74729,"_21804":125573,"_5":15036,"_28646":125432,"_3122":125574},[],"Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3731":74784,"_31485":74729,"_21804":125576,"_5":15036,"_28646":125432,"_3122":125577},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la guía de EST en Lamassu.",{"_3731":74785,"_31485":74729,"_21804":125579,"_5":15036,"_28646":125435,"_3122":125580},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3731":74786,"_31485":74729,"_21804":125582,"_5":15036,"_28646":125435,"_3122":125583},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3731":74787,"_31485":74729,"_21804":125585,"_5":15036,"_28646":125435,"_3122":125586},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3731":74788,"_31485":74729,"_21804":125588,"_5":15036,"_28646":125435,"_3122":125589},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3731":74789,"_31485":74729,"_21804":125591,"_5":15036,"_28646":125435,"_3122":125592},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3731":74790,"_31485":74729,"_21804":125594,"_5":15036,"_28646":125435,"_3122":125595},[],"Las comprobaciones externas de revocación del bootstrap fallan cerradas: un certificado cuya revocación no puede verificarse (incluido un estado OCSP Unknown) se rechaza por defecto. Solo `allow_unverifiable_revocation` en el bloque de esa operación (consulta DMS) lo relaja, y solo para certificados que no llevan ningún endpoint OCSP/CRL; los endpoints que no responden, devuelven evidencia caducada o no concluyente se rechazan, lo que diga la opción. Consulta Revocación y comprobaciones. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3731":74791,"_31485":74729,"_21804":125597,"_5":15036,"_28646":125435,"_3122":125598},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3731":74792,"_31485":74792,"_5":15390,"_3122":55577,"_31812":125600,"_21804":125602,"_28646":74792},[51373,123005,54083,124150,125601],"Integraciones",[],{"_3731":74793,"_31485":74792,"_21804":125604,"_5":15036,"_28646":74792,"_3122":125605},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3731":74794,"_31485":74792,"_5":31809,"_21804":125607,"_28646":125608,"_3122":125609},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3731":74795,"_31485":74792,"_5":31809,"_21804":125611,"_28646":125612,"_3122":125613},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3731":74796,"_31485":74792,"_5":31809,"_21804":125615,"_28646":125616,"_3122":125617},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3731":74797,"_31485":74792,"_5":31809,"_21804":125619,"_28646":125620,"_3122":125621},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3731":74798,"_31485":74792,"_5":31809,"_21804":125623,"_28646":125624,"_3122":125625},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-y-recursos-de-aws","Eventos y recursos de AWS",{"_3731":74799,"_31485":74792,"_5":31809,"_21804":125627,"_28646":125628,"_3122":125629},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3731":74800,"_31485":74792,"_5":31809,"_21804":125631,"_28646":125632,"_3122":125633},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3731":74801,"_31485":74792,"_5":31809,"_21804":125635,"_28646":125636,"_3122":125637},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3731":74802,"_31485":74792,"_5":31809,"_21804":125639,"_28646":125640,"_3122":55619},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3731":74803,"_31485":74792,"_5":31809,"_21804":125642,"_28646":125643,"_3122":55623},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3731":74804,"_31485":74792,"_5":31809,"_21804":125645,"_28646":125646,"_3122":125647},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3731":74805,"_31485":74792,"_5":31809,"_21804":125649,"_28646":125650,"_3122":125651},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3731":74806,"_31485":74792,"_5":31809,"_21804":125653,"_28646":125654,"_3122":125655},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3731":74807,"_31485":74792,"_5":31809,"_21804":125657,"_28646":125658,"_3122":125659},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3731":74808,"_31485":74792,"_5":31809,"_21804":125661,"_28646":125662,"_3122":125663},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3731":74809,"_31485":74792,"_5":31809,"_21804":125665,"_28646":125666,"_3122":125667},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3731":74810,"_31485":74792,"_5":31809,"_21804":125669,"_28646":125670,"_3122":125671},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3731":74811,"_31485":74792,"_5":31809,"_21804":125673,"_28646":125674,"_3122":125675},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3731":74812,"_31485":74792,"_5":31809,"_21804":125677,"_28646":125678,"_3122":125679},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3731":74813,"_31485":74792,"_5":31809,"_21804":125681,"_28646":125682,"_3122":125683},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3731":74814,"_31485":74792,"_5":31809,"_21804":125685,"_28646":125686,"_3122":125687},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3731":74815,"_31485":74792,"_5":31809,"_21804":125689,"_28646":125690,"_3122":125691},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3731":74816,"_31485":74792,"_5":31809,"_21804":125693,"_28646":125694,"_3122":125695},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3731":74817,"_31485":74792,"_5":31809,"_21804":125697,"_28646":125698,"_3122":125699},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3731":74818,"_31485":74792,"_5":31809,"_21804":125701,"_28646":125702,"_3122":125703},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3731":74819,"_31485":74792,"_21804":125705,"_5":15036,"_28646":74792,"_3122":125706},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3731":74820,"_31485":74792,"_21804":125708,"_5":15036,"_28646":74792,"_3122":125709},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3731":74821,"_31485":74792,"_21804":125711,"_5":15036,"_28646":74792,"_3122":125712},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3731":74822,"_31485":74792,"_21804":125714,"_5":15036,"_28646":125608,"_3122":125715},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3731":74823,"_31485":74792,"_21804":125717,"_5":15036,"_28646":125608,"_3122":125718},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3731":74824,"_31485":74792,"_21804":125720,"_5":15036,"_28646":125608,"_3122":125721},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3731":74825,"_31485":74792,"_21804":125723,"_5":15036,"_28646":125608,"_3122":125724},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3731":74826,"_31485":74792,"_21804":125726,"_5":15036,"_28646":125612,"_3122":125727},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3731":74827,"_31485":74792,"_21804":125729,"_5":15036,"_28646":125616,"_3122":125730},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3731":74828,"_31485":74792,"_21804":125732,"_5":15036,"_28646":125616,"_3122":125733},[],"Acción IAM",{"_3731":74829,"_31485":74792,"_21804":125735,"_5":15036,"_28646":125616,"_3122":121883},[],{"_3731":74830,"_31485":74792,"_21804":125737,"_5":15036,"_28646":125616,"_3122":55718},[],{"_3731":74831,"_31485":74792,"_21804":125739,"_5":15036,"_28646":125616,"_3122":125740},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3731":74832,"_31485":74792,"_21804":125742,"_5":15036,"_28646":125616,"_3122":55724},[],{"_3731":74833,"_31485":74792,"_21804":125744,"_5":15036,"_28646":125616,"_3122":125745},[],"Registrar la CA en AWS IoT",{"_3731":74834,"_31485":74792,"_21804":125747,"_5":15036,"_28646":125616,"_3122":55730},[],{"_3731":74835,"_31485":74792,"_21804":125749,"_5":15036,"_28646":125616,"_3122":125750},[],"Consultar el estado del registro de la CA",{"_3731":74836,"_31485":74792,"_21804":125752,"_5":15036,"_28646":125616,"_3122":55736},[],{"_3731":74837,"_31485":74792,"_21804":125754,"_5":15036,"_28646":125616,"_3122":125755},[],"Crear o actualizar Things en IoT Core",{"_3731":74838,"_31485":74792,"_21804":125757,"_5":15036,"_28646":125616,"_3122":55742},[],{"_3731":74839,"_31485":74792,"_21804":125759,"_5":15036,"_28646":125616,"_3122":125760},[],"Aprovisionar Things mediante plantilla",{"_3731":74840,"_31485":74792,"_21804":125762,"_5":15036,"_28646":125616,"_3122":55748},[],{"_3731":74841,"_31485":74792,"_21804":125764,"_5":15036,"_28646":125616,"_3122":125765},[],"Registrar certificados de dispositivo",{"_3731":74842,"_31485":74792,"_21804":125767,"_5":15036,"_28646":125616,"_3122":55754},[],{"_3731":74843,"_31485":74792,"_21804":125769,"_5":15036,"_28646":125616,"_3122":125770},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3731":74844,"_31485":74792,"_21804":125772,"_5":15036,"_28646":125616,"_3122":55760},[],{"_3731":74845,"_31485":74792,"_21804":125774,"_5":15036,"_28646":125616,"_3122":125775},[],"Crear y adjuntar políticas IoT",{"_3731":74846,"_31485":74792,"_21804":125777,"_5":15036,"_28646":125616,"_3122":55766},[],{"_3731":74847,"_31485":74792,"_21804":125779,"_5":15036,"_28646":125616,"_3122":125780},[],"Gestionar grupos de Things",{"_3731":74848,"_31485":74792,"_21804":125782,"_5":15036,"_28646":125616,"_3122":55772},[],{"_3731":74849,"_31485":74792,"_21804":125784,"_5":15036,"_28646":125616,"_3122":125785},[],"Crear plantillas JITP",{"_3731":74850,"_31485":74792,"_21804":125787,"_5":15036,"_28646":125616,"_3122":55778},[],{"_3731":74851,"_31485":74792,"_21804":125789,"_5":15036,"_28646":125616,"_3122":125790},[],"Leer y escribir el Device Shadow",{"_3731":74852,"_31485":74792,"_21804":125792,"_5":15036,"_28646":125616,"_3122":125793},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3731":74853,"_31485":74792,"_21804":125795,"_5":15036,"_28646":125620,"_3122":125796},[],"Parámetro",{"_3731":74854,"_31485":74792,"_21804":125798,"_5":15036,"_28646":125620,"_3122":125799},[],"Tipo",{"_3731":74855,"_31485":74792,"_21804":125801,"_5":15036,"_28646":125620,"_3122":125802},[],"Requerido",{"_3731":74856,"_31485":74792,"_21804":125804,"_5":15036,"_28646":125620,"_3122":125805},[],"Descripción",{"_3731":74857,"_31485":74792,"_21804":125807,"_5":15036,"_28646":125620,"_3122":55799},[],{"_3731":74858,"_31485":74792,"_21804":125809,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74859,"_31485":74792,"_21804":125811,"_5":15036,"_28646":125620,"_3122":125812},[],"Sí",{"_3731":74860,"_31485":74792,"_21804":125814,"_5":15036,"_28646":125620,"_3122":125815},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3731":74861,"_31485":74792,"_21804":125817,"_5":15036,"_28646":125620,"_3122":55810},[],{"_3731":74862,"_31485":74792,"_21804":125819,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74863,"_31485":74792,"_21804":125821,"_5":15036,"_28646":125620,"_3122":125812},[],{"_3731":74864,"_31485":74792,"_21804":125823,"_5":15036,"_28646":125620,"_3122":125824},[],"Región AWS donde opera el conector.",{"_3731":74865,"_31485":74792,"_21804":125826,"_5":15036,"_28646":125620,"_3122":55820},[],{"_3731":74866,"_31485":74792,"_21804":125828,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74867,"_31485":74792,"_21804":125830,"_5":15036,"_28646":125620,"_3122":125812},[],{"_3731":74868,"_31485":74792,"_21804":125832,"_5":15036,"_28646":125620,"_3122":125833},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3731":74869,"_31485":74792,"_21804":125835,"_5":15036,"_28646":125620,"_3122":55830},[],{"_3731":74870,"_31485":74792,"_21804":125837,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74871,"_31485":74792,"_21804":125839,"_5":15036,"_28646":125620,"_3122":125840},[],"Solo con `auth_method=static`",{"_3731":74872,"_31485":74792,"_21804":125842,"_5":15036,"_28646":125620,"_3122":125843},[],"Clave de acceso AWS.",{"_3731":74873,"_31485":74792,"_21804":125845,"_5":15036,"_28646":125620,"_3122":55841},[],{"_3731":74874,"_31485":74792,"_21804":125847,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74875,"_31485":74792,"_21804":125849,"_5":15036,"_28646":125620,"_3122":125840},[],{"_3731":74876,"_31485":74792,"_21804":125851,"_5":15036,"_28646":125620,"_3122":125852},[],"Clave secreta AWS.",{"_3731":74877,"_31485":74792,"_21804":125854,"_5":15036,"_28646":125620,"_3122":55851},[],{"_3731":74878,"_31485":74792,"_21804":125856,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74879,"_31485":74792,"_21804":125858,"_5":15036,"_28646":125620,"_3122":55856},[],{"_3731":74880,"_31485":74792,"_21804":125860,"_5":15036,"_28646":125620,"_3122":125861},[],"Token de sesión (con `auth_method=static`).",{"_3731":74881,"_31485":74792,"_21804":125863,"_5":15036,"_28646":125620,"_3122":55862},[],{"_3731":74882,"_31485":74792,"_21804":125865,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74883,"_31485":74792,"_21804":125867,"_5":15036,"_28646":125620,"_3122":125868},[],"Solo con `auth_method=role`",{"_3731":74884,"_31485":74792,"_21804":125870,"_5":15036,"_28646":125620,"_3122":125871},[],"ARN del rol a asumir.",{"_3731":74885,"_31485":74792,"_21804":125873,"_5":15036,"_28646":125620,"_3122":55873},[],{"_3731":74886,"_31485":74792,"_21804":125875,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74887,"_31485":74792,"_21804":125877,"_5":15036,"_28646":125620,"_3122":55856},[],{"_3731":74888,"_31485":74792,"_21804":125879,"_5":15036,"_28646":125620,"_3122":125880},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3731":74889,"_31485":74792,"_21804":125882,"_5":15036,"_28646":125620,"_3122":55883},[],{"_3731":74890,"_31485":74792,"_21804":125884,"_5":15036,"_28646":125620,"_3122":93887},[],{"_3731":74891,"_31485":74792,"_21804":125886,"_5":15036,"_28646":125620,"_3122":125812},[],{"_3731":74892,"_31485":74792,"_21804":125888,"_5":15036,"_28646":125620,"_3122":125889},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3731":74893,"_31485":74792,"_21804":125891,"_5":15036,"_28646":125620,"_3122":55893},[],{"_3731":74894,"_31485":74792,"_21804":125893,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74895,"_31485":74792,"_21804":125895,"_5":15036,"_28646":125620,"_3122":125812},[],{"_3731":74896,"_31485":74792,"_21804":125897,"_5":15036,"_28646":125620,"_3122":125898},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3731":74897,"_31485":74792,"_21804":125900,"_5":15036,"_28646":125620,"_3122":55903},[],{"_3731":74898,"_31485":74792,"_21804":125902,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74899,"_31485":74792,"_21804":125904,"_5":15036,"_28646":125620,"_3122":125812},[],{"_3731":74900,"_31485":74792,"_21804":125906,"_5":15036,"_28646":125620,"_3122":125907},[],"URL HTTP del Device Manager de Lamassu.",{"_3731":74901,"_31485":74792,"_21804":125909,"_5":15036,"_28646":125620,"_3122":55913},[],{"_3731":74902,"_31485":74792,"_21804":125911,"_5":15036,"_28646":125620,"_3122":26006},[],{"_3731":74903,"_31485":74792,"_21804":125913,"_5":15036,"_28646":125620,"_3122":125812},[],{"_3731":74904,"_31485":74792,"_21804":125915,"_5":15036,"_28646":125620,"_3122":125916},[],"URL HTTP del servicio de CA de Lamassu.",{"_3731":74905,"_31485":74792,"_21804":125918,"_5":15036,"_28646":125624,"_3122":125919},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada flujo. La máquina de estados de cada recurso está junto a su explicación detallada; la última columna enlaza a ella. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3731":74906,"_31485":74792,"_21804":125921,"_5":15036,"_28646":125624,"_3122":125922},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3731":74907,"_31485":74792,"_21804":125924,"_5":15036,"_28646":125624,"_3122":125925},[],"Tipo de CloudEvent",{"_3731":74908,"_31485":74792,"_21804":125927,"_5":15036,"_28646":125624,"_3122":125928},[],"Recurso en Lamassu",{"_3731":74909,"_31485":74792,"_21804":125930,"_5":15036,"_28646":125624,"_3122":125931},[],"Recurso AWS",{"_3731":74910,"_31485":74792,"_21804":125933,"_5":15036,"_28646":125624,"_3122":125934},[],"Acciones IAM",{"_3731":74911,"_31485":74792,"_21804":125936,"_5":15036,"_28646":125624,"_3122":125937},[],"Llamadas AWS y efecto",{"_3731":74912,"_31485":74792,"_21804":125939,"_5":15036,"_28646":125624,"_3122":125940},[],"Dónde en esta página",{"_3731":74913,"_31485":74792,"_21804":125942,"_5":15036,"_28646":125624,"_3122":55947},[],{"_3731":74914,"_31485":74792,"_21804":125944,"_5":15036,"_28646":125624,"_3122":55950},[],{"_3731":74915,"_31485":74792,"_21804":125946,"_5":15036,"_28646":125624,"_3122":55953},[],{"_3731":74916,"_31485":74792,"_21804":125948,"_5":15036,"_28646":125624,"_3122":55956},[],{"_3731":74917,"_31485":74792,"_21804":125950,"_5":15036,"_28646":125624,"_3122":125951},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3731":74918,"_31485":74792,"_21804":125953,"_5":15036,"_28646":125624,"_3122":125637},[],{"_3731":74919,"_31485":74792,"_21804":125955,"_5":15036,"_28646":125624,"_3122":55964},[],{"_3731":74920,"_31485":74792,"_21804":125957,"_5":15036,"_28646":125624,"_3122":55967},[],{"_3731":74921,"_31485":74792,"_21804":125959,"_5":15036,"_28646":125624,"_3122":55970},[],{"_3731":74922,"_31485":74792,"_21804":125961,"_5":15036,"_28646":125624,"_3122":55973},[],{"_3731":74923,"_31485":74792,"_21804":125963,"_5":15036,"_28646":125624,"_3122":125964},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3731":74924,"_31485":74792,"_21804":125966,"_5":15036,"_28646":125624,"_3122":125663},[],{"_3731":74925,"_31485":74792,"_21804":125968,"_5":15036,"_28646":125624,"_3122":55981},[],{"_3731":74926,"_31485":74792,"_21804":125970,"_5":15036,"_28646":125624,"_3122":125971},[],"Dispositivo",{"_3731":74927,"_31485":74792,"_21804":125973,"_5":15036,"_28646":125624,"_3122":55987},[],{"_3731":74928,"_31485":74792,"_21804":125975,"_5":15036,"_28646":125624,"_3122":55990},[],{"_3731":74929,"_31485":74792,"_21804":125977,"_5":15036,"_28646":125624,"_3122":125978},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3731":74930,"_31485":74792,"_21804":125980,"_5":15036,"_28646":125624,"_3122":125671},[],{"_3731":74931,"_31485":74792,"_21804":125982,"_5":15036,"_28646":125624,"_3122":55998},[],{"_3731":74932,"_31485":74792,"_21804":125984,"_5":15036,"_28646":125624,"_3122":125985},[],"Certificado",{"_3731":74933,"_31485":74792,"_21804":125987,"_5":15036,"_28646":125624,"_3122":56004},[],{"_3731":74934,"_31485":74792,"_21804":125989,"_5":15036,"_28646":125624,"_3122":125990},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3731":74935,"_31485":74792,"_21804":125992,"_5":15036,"_28646":125624,"_3122":125993},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3731":74936,"_31485":74792,"_21804":125995,"_5":15036,"_28646":125624,"_3122":125683},[],{"_3731":74937,"_31485":74792,"_21804":125997,"_5":15036,"_28646":125624,"_3122":56015},[],{"_3731":74938,"_31485":74792,"_21804":125999,"_5":15036,"_28646":125624,"_3122":126000},[],"Certificado / Dispositivo",{"_3731":74939,"_31485":74792,"_21804":126002,"_5":15036,"_28646":125624,"_3122":56021},[],{"_3731":74940,"_31485":74792,"_21804":126004,"_5":15036,"_28646":125624,"_3122":51769},[],{"_3731":74941,"_31485":74792,"_21804":126006,"_5":15036,"_28646":125624,"_3122":126007},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3731":74942,"_31485":74792,"_21804":126009,"_5":15036,"_28646":125624,"_3122":125691},[],{"_3731":74943,"_31485":74792,"_21804":126011,"_5":15036,"_28646":125628,"_3122":126012},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3731":74944,"_31485":74792,"_21804":126014,"_5":15036,"_28646":125632,"_3122":126015},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3731":74945,"_31485":74792,"_21804":126017,"_5":15036,"_28646":125632,"_3122":126018},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3731":74946,"_31485":74792,"_21804":126020,"_5":15036,"_28646":125636,"_3122":126021},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3731":74947,"_31485":74792,"_21804":126023,"_5":15036,"_28646":125636,"_3122":126024},[],"Transición",{"_3731":74948,"_31485":74792,"_21804":126026,"_5":15036,"_28646":125636,"_3122":126027},[],"Llamadas AWS",{"_3731":74949,"_31485":74792,"_21804":126029,"_5":15036,"_28646":125636,"_3122":126030},[],"`NoRegistrada` → `Solicitada`",{"_3731":74950,"_31485":74792,"_21804":126032,"_5":15036,"_28646":125636,"_3122":126033},[],"ninguna (solo escritura de metadatos)",{"_3731":74951,"_31485":74792,"_21804":126035,"_5":15036,"_28646":125636,"_3122":126036},[],"`Solicitada` → `Registrando`",{"_3731":74952,"_31485":74792,"_21804":126038,"_5":15036,"_28646":125636,"_3122":126039},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3731":74953,"_31485":74792,"_21804":126041,"_5":15036,"_28646":125636,"_3122":126042},[],"`Registrando` → `Completada`",{"_3731":74954,"_31485":74792,"_21804":126044,"_5":15036,"_28646":125636,"_3122":126045},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3731":74955,"_31485":74792,"_21804":126047,"_5":15036,"_28646":125636,"_3122":126048},[],"`Registrando` → `Fallida`",{"_3731":74956,"_31485":74792,"_21804":126050,"_5":15036,"_28646":125636,"_3122":126051},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3731":74957,"_31485":74792,"_21804":126053,"_5":15036,"_28646":125636,"_3122":126054},[],"`Fallida` / `Completada` → `Solicitada`",{"_3731":74958,"_31485":74792,"_21804":126056,"_5":15036,"_28646":125636,"_3122":126057},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3731":74959,"_31485":74792,"_21804":126059,"_5":15036,"_28646":125640,"_3122":126060},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3731":74960,"_31485":74792,"_21804":126062,"_5":15036,"_28646":125640,"_3122":126063},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3731":74961,"_31485":74792,"_21804":126065,"_5":15036,"_28646":125640,"_3122":126066},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3731":74962,"_31485":74792,"_21804":126068,"_5":15036,"_28646":125640,"_3122":126069},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3731":74963,"_31485":74792,"_21804":126071,"_5":15036,"_28646":125640,"_3122":126072},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3731":74964,"_31485":74792,"_21804":126074,"_5":15036,"_28646":125640,"_3122":126075},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3731":74965,"_31485":74792,"_21804":126077,"_5":15036,"_28646":125643,"_3122":126078},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3731":74966,"_31485":74792,"_21804":126080,"_5":15036,"_28646":125646,"_3122":126081},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3731":74967,"_31485":74792,"_21804":126083,"_5":15036,"_28646":125646,"_3122":126084},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3731":74968,"_31485":74792,"_21804":126086,"_5":15036,"_28646":125650,"_3122":126087},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3731":74969,"_31485":74792,"_21804":126089,"_5":15036,"_28646":125654,"_3122":126090},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3731":74970,"_31485":74792,"_21804":126092,"_5":15036,"_28646":125654,"_3122":126093},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3731":74971,"_31485":74792,"_21804":126095,"_5":15036,"_28646":125654,"_3122":126096},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3731":74972,"_31485":74792,"_21804":126098,"_5":15036,"_28646":125654,"_3122":126099},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3731":74973,"_31485":74792,"_21804":126101,"_5":15036,"_28646":125654,"_3122":126102},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3731":74974,"_31485":74792,"_21804":126104,"_5":15036,"_28646":125654,"_3122":126105},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3731":74975,"_31485":74792,"_21804":126107,"_5":15036,"_28646":125658,"_3122":126108},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3731":74976,"_31485":74792,"_21804":126110,"_5":15036,"_28646":125658,"_3122":126111},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3731":74977,"_31485":74792,"_21804":126113,"_5":15036,"_28646":125658,"_3122":126114},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3731":74978,"_31485":74792,"_21804":126116,"_5":15036,"_28646":125658,"_3122":126117},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3731":74979,"_31485":74792,"_21804":126119,"_5":15036,"_28646":125658,"_3122":126120},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3731":74980,"_31485":74792,"_21804":126122,"_5":15036,"_28646":125662,"_3122":126123},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3731":74981,"_31485":74792,"_21804":126125,"_5":15036,"_28646":125662,"_3122":126024},[],{"_3731":74982,"_31485":74792,"_21804":126127,"_5":15036,"_28646":125662,"_3122":126027},[],{"_3731":74983,"_31485":74792,"_21804":126129,"_5":15036,"_28646":125662,"_3122":126130},[],"`SinConfigurar` → `None` / `Auto`",{"_3731":74984,"_31485":74792,"_21804":126132,"_5":15036,"_28646":125662,"_3122":126133},[],"ninguna (solo configuración)",{"_3731":74985,"_31485":74792,"_21804":126135,"_5":15036,"_28646":125662,"_3122":56158},[],{"_3731":74986,"_31485":74792,"_21804":126137,"_5":15036,"_28646":125662,"_3122":126133},[],{"_3731":74987,"_31485":74792,"_21804":126139,"_5":15036,"_28646":125662,"_3122":126140},[],"Cualquiera → `Jitp`",{"_3731":74988,"_31485":74792,"_21804":126142,"_5":15036,"_28646":125662,"_3122":126143},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3731":74989,"_31485":74792,"_21804":126145,"_5":15036,"_28646":125662,"_3122":56169},[],{"_3731":74990,"_31485":74792,"_21804":126147,"_5":15036,"_28646":125662,"_3122":126148},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3731":74991,"_31485":74792,"_21804":126150,"_5":15036,"_28646":125666,"_3122":126151},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3731":74992,"_31485":74792,"_21804":126153,"_5":15036,"_28646":125666,"_3122":126154},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3731":74993,"_31485":74792,"_21804":126156,"_5":15036,"_28646":125666,"_3122":126157},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3731":74994,"_31485":74792,"_21804":126159,"_5":15036,"_28646":125670,"_3122":126160},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3731":74995,"_31485":74792,"_21804":126162,"_5":15036,"_28646":125670,"_3122":126024},[],{"_3731":74996,"_31485":74792,"_21804":126164,"_5":15036,"_28646":125670,"_3122":126027},[],{"_3731":74997,"_31485":74792,"_21804":126166,"_5":15036,"_28646":125670,"_3122":126167},[],"`Ausente` → `Aprovisionado`",{"_3731":74998,"_31485":74792,"_21804":126169,"_5":15036,"_28646":125670,"_3122":126170},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3731":74999,"_31485":74792,"_21804":126172,"_5":15036,"_28646":125670,"_3122":126173},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3731":75000,"_31485":74792,"_21804":126175,"_5":15036,"_28646":125670,"_3122":126176},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3731":75001,"_31485":74792,"_21804":126178,"_5":15036,"_28646":125670,"_3122":126179},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3731":75002,"_31485":74792,"_21804":126181,"_5":15036,"_28646":125674,"_3122":126182},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3731":75003,"_31485":74792,"_21804":126184,"_5":15036,"_28646":125674,"_3122":126185},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3731":75004,"_31485":74792,"_21804":126187,"_5":15036,"_28646":125674,"_3122":126188},[],"Para que el flujo JITP funcione correctamente:",{"_3731":75005,"_31485":74792,"_21804":126190,"_5":15036,"_28646":125674,"_3122":126191},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3731":75006,"_31485":74792,"_21804":126193,"_5":15036,"_28646":125674,"_3122":126194},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3731":75007,"_31485":74792,"_21804":126196,"_5":15036,"_28646":125674,"_3122":126197},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3731":75008,"_31485":74792,"_21804":126199,"_5":15036,"_28646":125674,"_3122":126200},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3731":75009,"_31485":74792,"_21804":126202,"_5":15036,"_28646":125678,"_3122":126203},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3731":75010,"_31485":74792,"_21804":126205,"_5":15036,"_28646":125678,"_3122":126206},[],"Estado en Lamassu",{"_3731":75011,"_31485":74792,"_21804":126208,"_5":15036,"_28646":125678,"_3122":126209},[],"Razón de revocación",{"_3731":75012,"_31485":74792,"_21804":126211,"_5":15036,"_28646":125678,"_3122":126212},[],"Estado en AWS IoT Core",{"_3731":75013,"_31485":74792,"_21804":126214,"_5":15036,"_28646":125678,"_3122":56239},[],{"_3731":75014,"_31485":74792,"_21804":126216,"_5":15036,"_28646":125678,"_3122":126217},[],"Ninguna",{"_3731":75015,"_31485":74792,"_21804":126219,"_5":15036,"_28646":125678,"_3122":56245},[],{"_3731":75016,"_31485":74792,"_21804":126221,"_5":15036,"_28646":125678,"_3122":56248},[],{"_3731":75017,"_31485":74792,"_21804":126223,"_5":15036,"_28646":125678,"_3122":56251},[],{"_3731":75018,"_31485":74792,"_21804":126225,"_5":15036,"_28646":125678,"_3122":56254},[],{"_3731":75019,"_31485":74792,"_21804":126227,"_5":15036,"_28646":125678,"_3122":56248},[],{"_3731":75020,"_31485":74792,"_21804":126229,"_5":15036,"_28646":125678,"_3122":126230},[],"Cualquier otra razón",{"_3731":75021,"_31485":74792,"_21804":126232,"_5":15036,"_28646":125678,"_3122":56262},[],{"_3731":75022,"_31485":74792,"_21804":126234,"_5":15036,"_28646":125678,"_3122":126235},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3731":75023,"_31485":74792,"_21804":126237,"_5":15036,"_28646":125682,"_3122":126238},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3731":75024,"_31485":74792,"_21804":126240,"_5":15036,"_28646":125682,"_3122":126024},[],{"_3731":75025,"_31485":74792,"_21804":126242,"_5":15036,"_28646":125682,"_3122":126027},[],{"_3731":75026,"_31485":74792,"_21804":126244,"_5":15036,"_28646":125682,"_3122":126245},[],"`NoSincronizado` → `Active`",{"_3731":75027,"_31485":74792,"_21804":126247,"_5":15036,"_28646":125682,"_3122":55754},[],{"_3731":75028,"_31485":74792,"_21804":126249,"_5":15036,"_28646":125682,"_3122":56280},[],{"_3731":75029,"_31485":74792,"_21804":126251,"_5":15036,"_28646":125682,"_3122":126252},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3731":75030,"_31485":74792,"_21804":126254,"_5":15036,"_28646":125682,"_3122":56286},[],{"_3731":75031,"_31485":74792,"_21804":126256,"_5":15036,"_28646":125682,"_3122":126252},[],{"_3731":75032,"_31485":74792,"_21804":126258,"_5":15036,"_28646":125682,"_3122":56291},[],{"_3731":75033,"_31485":74792,"_21804":126260,"_5":15036,"_28646":125682,"_3122":55754},[],{"_3731":75034,"_31485":74792,"_21804":126262,"_5":15036,"_28646":125682,"_3122":56296},[],{"_3731":75035,"_31485":74792,"_21804":126264,"_5":15036,"_28646":125682,"_3122":126265},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3731":75036,"_31485":74792,"_21804":126267,"_5":15036,"_28646":125686,"_3122":126268},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3731":75037,"_31485":74792,"_21804":126270,"_5":15036,"_28646":125686,"_3122":126271},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3731":75038,"_31485":74792,"_21804":126273,"_5":15036,"_28646":125686,"_3122":126274},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3731":75039,"_31485":74792,"_21804":126276,"_5":15036,"_28646":125690,"_3122":126277},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3731":75040,"_31485":74792,"_21804":126279,"_5":15036,"_28646":125690,"_3122":126280},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3731":75041,"_31485":74792,"_21804":126282,"_5":15036,"_28646":125694,"_3122":126283},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3731":75042,"_31485":74792,"_21804":126285,"_5":15036,"_28646":125694,"_3122":126286},[],"Existen dos tipos de acciones:",{"_3731":75043,"_31485":74792,"_21804":126288,"_5":15036,"_28646":125694,"_3122":126289},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3731":75044,"_31485":74792,"_21804":126291,"_5":15036,"_28646":125694,"_3122":126292},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3731":75045,"_31485":74792,"_21804":126294,"_5":15036,"_28646":125694,"_3122":126295},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3731":75046,"_31485":74792,"_21804":126297,"_5":15036,"_28646":125698,"_3122":126298},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3731":75047,"_31485":74792,"_21804":126300,"_5":15036,"_28646":125698,"_3122":126301},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3731":75048,"_31485":74792,"_21804":126303,"_5":15036,"_28646":125698,"_3122":126304},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3731":75049,"_31485":74792,"_21804":126306,"_5":15036,"_28646":125702,"_3122":126307},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3731":75050,"_31485":74792,"_21804":126309,"_5":15036,"_28646":125702,"_3122":126310},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3731":75051,"_31485":74792,"_21804":126312,"_5":15036,"_28646":125702,"_3122":126313},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3731":75052,"_31485":74792,"_21804":126315,"_5":15036,"_28646":125702,"_3122":126316},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3731":75053,"_31485":74792,"_21804":126318,"_5":15036,"_28646":125702,"_3122":126319},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3731":75054,"_31485":74792,"_21804":126321,"_5":15036,"_28646":125702,"_3122":126322},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3731":75055,"_31485":74792,"_21804":126324,"_5":15036,"_28646":125702,"_3122":126325},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3731":75056,"_31485":74792,"_21804":126327,"_5":15036,"_28646":125702,"_3122":126328},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3731":75057,"_31485":74792,"_21804":126330,"_5":15036,"_28646":125702,"_3122":126331},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3731":75058,"_31485":74792,"_21804":126333,"_5":15036,"_28646":125702,"_3122":126334},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3731":75059,"_31485":74792,"_21804":126336,"_5":15036,"_28646":125702,"_3122":126337},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3731":75060,"_31485":74792,"_21804":126339,"_5":15036,"_28646":125702,"_3122":126340},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3731":75061,"_31485":74792,"_21804":126342,"_5":15036,"_28646":125702,"_3122":126343},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3731":75062,"_31485":74792,"_21804":126345,"_5":15036,"_28646":125702,"_3122":126346},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3731":75063,"_31485":74792,"_21804":126348,"_5":15036,"_28646":125702,"_3122":126349},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3731":75064,"_31485":74792,"_21804":126351,"_5":15036,"_28646":125702,"_3122":126352},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3731":75065,"_31485":74792,"_21804":126354,"_5":15036,"_28646":125702,"_3122":126355},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3731":75066,"_31485":74792,"_21804":126357,"_5":15036,"_28646":125702,"_3122":126358},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3731":75067,"_31485":74792,"_21804":126360,"_5":15036,"_28646":125702,"_3122":126361},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3731":75068,"_31485":74792,"_21804":126363,"_5":15036,"_28646":125702,"_3122":126364},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3731":75069,"_31485":74792,"_21804":126366,"_5":15036,"_28646":125702,"_3122":126367},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3731":75070,"_31485":74792,"_21804":126369,"_5":15036,"_28646":125702,"_3122":126370},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3731":75071,"_31485":74792,"_21804":126372,"_5":15036,"_28646":125702,"_3122":126373},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/est\" />",{"_3731":75072,"_31485":74792,"_21804":126375,"_5":15036,"_28646":125702,"_3122":126376},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3731":75073,"_31485":75073,"_5":15390,"_3122":54083,"_31812":126378,"_21804":126379,"_28646":75073},[51373,123005,54083],[],{"_3731":75074,"_31485":75073,"_21804":126381,"_5":15036,"_28646":75073,"_3122":126382},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3731":75075,"_31485":75073,"_5":31809,"_21804":126384,"_28646":126385,"_3122":126386},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3731":75076,"_31485":75073,"_5":31809,"_21804":126388,"_28646":126389,"_3122":124150},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3731":75077,"_31485":75073,"_5":31809,"_21804":126391,"_28646":126392,"_3122":124328},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3731":75078,"_31485":75073,"_5":31809,"_21804":126394,"_28646":126395,"_3122":125601},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3731":75079,"_31485":75073,"_5":31809,"_21804":126397,"_28646":126398,"_3122":126399},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3731":75080,"_31485":75073,"_21804":126401,"_5":15036,"_28646":75073,"_3122":126402},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3731":75081,"_31485":75073,"_21804":126404,"_5":15036,"_28646":126385,"_3122":126405},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3731":75082,"_31485":75073,"_21804":126407,"_5":15036,"_28646":126385,"_3122":126408},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3731":75083,"_31485":75073,"_21804":126410,"_5":15036,"_28646":126389,"_3122":126411},[],"Recurso",{"_3731":75084,"_31485":75073,"_21804":126413,"_5":15036,"_28646":126389,"_3122":126414},[],"Qué representa",{"_3731":75085,"_31485":75073,"_21804":126416,"_5":15036,"_28646":126389,"_3122":126417},[],"**Dispositivo**",{"_3731":75086,"_31485":75073,"_21804":126419,"_5":15036,"_28646":126389,"_3122":126420},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3731":75087,"_31485":75073,"_21804":126422,"_5":15036,"_28646":126389,"_3122":126423},[],"**Identidad**",{"_3731":75088,"_31485":75073,"_21804":126425,"_5":15036,"_28646":126389,"_3122":126426},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3731":75089,"_31485":75073,"_21804":126428,"_5":15036,"_28646":126389,"_3122":56463},[],{"_3731":75090,"_31485":75073,"_21804":126430,"_5":15036,"_28646":126389,"_3122":126431},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3731":75091,"_31485":75073,"_21804":126433,"_5":15036,"_28646":126389,"_3122":126434},[],"**Flota**",{"_3731":75092,"_31485":75073,"_21804":126436,"_5":15036,"_28646":126389,"_3122":126437},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3731":75093,"_31485":75073,"_21804":126439,"_5":15036,"_28646":126389,"_3122":126440},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3731":75094,"_31485":75073,"_21804":126442,"_5":15036,"_28646":126389,"_3122":126443},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3731":75095,"_31485":75073,"_21804":126445,"_5":15036,"_28646":126392,"_3122":126446},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3731":75096,"_31485":75073,"_21804":126448,"_5":15036,"_28646":126392,"_3122":126449},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3731":75097,"_31485":75073,"_21804":126451,"_5":15036,"_28646":126392,"_3122":126452},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3731":75098,"_31485":75073,"_21804":126454,"_5":15036,"_28646":126392,"_3122":126455},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3731":75099,"_31485":75073,"_21804":126457,"_5":15036,"_28646":126392,"_3122":126458},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3731":75100,"_31485":75073,"_21804":126460,"_5":15036,"_28646":126392,"_3122":126461},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3731":75101,"_31485":75073,"_21804":126463,"_5":15036,"_28646":126392,"_3122":126464},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3731":75102,"_31485":75073,"_21804":126466,"_5":15036,"_28646":126392,"_3122":126467},[],"<Card title=\"EST (RFC 7030)\" description=\"Consulta las guías de autenticación, cliente y renovación.\" href=\"/docs/platform/iot-fleets/est\" />",{"_3731":75103,"_31485":75073,"_21804":126469,"_5":15036,"_28646":126395,"_3122":126470},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3731":75104,"_31485":75073,"_21804":126472,"_5":15036,"_28646":126395,"_3122":126473},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3731":75105,"_31485":75073,"_21804":126475,"_5":15036,"_28646":126398,"_3122":126476},[],"Participante",{"_3731":75106,"_31485":75073,"_21804":126478,"_5":15036,"_28646":126398,"_3122":126479},[],"Responsabilidad",{"_3731":75107,"_31485":75073,"_21804":126481,"_5":15036,"_28646":126398,"_3122":126482},[],"Administrador PKI",{"_3731":75108,"_31485":75073,"_21804":126484,"_5":15036,"_28646":126398,"_3122":126485},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3731":75109,"_31485":75073,"_21804":126487,"_5":15036,"_28646":126398,"_3122":126488},[],"Administrador del aprovisionamiento",{"_3731":75110,"_31485":75073,"_21804":126490,"_5":15036,"_28646":126398,"_3122":126491},[],"DMS, admisión, autenticación por operación e inventario.",{"_3731":75111,"_31485":75073,"_21804":126493,"_5":15036,"_28646":126398,"_3122":126494},[],"Integrador del dispositivo",{"_3731":75112,"_31485":75073,"_21804":126496,"_5":15036,"_28646":126398,"_3122":126497},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3731":75113,"_31485":75073,"_21804":126499,"_5":15036,"_28646":126398,"_3122":126500},[],"Integrador del consumidor",{"_3731":75114,"_31485":75073,"_21804":126502,"_5":15036,"_28646":126398,"_3122":126503},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3731":75115,"_31485":75073,"_21804":126505,"_5":15036,"_28646":126398,"_3122":126506},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3731":75116,"_31485":75116,"_5":15390,"_3122":126508,"_31812":126509,"_21804":126511,"_28646":75116},"Enrola y conecta tu primer dispositivo",[51373,123005,54083,126510],"Primeros pasos",[],{"_3731":75117,"_31485":75116,"_21804":126513,"_5":15036,"_28646":75116,"_3122":126514},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3731":75118,"_31485":75116,"_5":31809,"_21804":126516,"_28646":126517,"_3122":121513},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3731":75119,"_31485":75116,"_5":31809,"_21804":126519,"_28646":126520,"_3122":126521},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3731":75120,"_31485":75116,"_5":31809,"_21804":126523,"_28646":126524,"_3122":126525},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3731":75121,"_31485":75116,"_5":31809,"_21804":126527,"_28646":126528,"_3122":126529},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3731":75122,"_31485":75116,"_5":31809,"_21804":126531,"_28646":126532,"_3122":126533},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3731":75123,"_31485":75116,"_5":31809,"_21804":126535,"_28646":126536,"_3122":126537},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3731":75124,"_31485":75116,"_5":31809,"_21804":126539,"_28646":126540,"_3122":126541},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3731":75125,"_31485":75116,"_5":31809,"_21804":126543,"_28646":126544,"_3122":126545},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3731":75126,"_31485":75116,"_21804":126547,"_5":15036,"_28646":75116,"_3122":126548},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3731":75127,"_31485":75116,"_21804":126550,"_5":15036,"_28646":126517,"_3122":126551},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3731":75128,"_31485":75116,"_21804":126553,"_5":15036,"_28646":126517,"_3122":126554},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3731":75129,"_31485":75116,"_21804":126556,"_5":15036,"_28646":126517,"_3122":126557},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3731":75130,"_31485":75116,"_21804":126559,"_5":15036,"_28646":126517,"_3122":126560},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3731":75131,"_31485":75116,"_21804":126562,"_5":15036,"_28646":126517,"_3122":126563},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3731":75132,"_31485":75116,"_21804":126565,"_5":15036,"_28646":126520,"_3122":126566},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3731":75133,"_31485":75116,"_21804":126568,"_5":15036,"_28646":126520,"_3122":126569},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3731":75134,"_31485":75116,"_21804":126571,"_5":15036,"_28646":126524,"_3122":126572},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3731":75135,"_31485":75116,"_21804":126574,"_5":15036,"_28646":126524,"_3122":126575},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3731":75136,"_31485":75116,"_21804":126577,"_5":15036,"_28646":126524,"_3122":126578},[],"Ajuste",{"_3731":75137,"_31485":75116,"_21804":126580,"_5":15036,"_28646":126524,"_3122":126581},[],"Valor de evaluación",{"_3731":75138,"_31485":75116,"_21804":126583,"_5":15036,"_28646":126524,"_3122":56619},[],{"_3731":75139,"_31485":75116,"_21804":126585,"_5":15036,"_28646":126524,"_3122":126586},[],"Raíz emisora de `device-root.pem`.",{"_3731":75140,"_31485":75116,"_21804":126588,"_5":15036,"_28646":126524,"_3122":126589},[],"Perfil de emisión",{"_3731":75141,"_31485":75116,"_21804":126591,"_5":15036,"_28646":126524,"_3122":126592},[],"Perfil final de 1 hora que acabas de preparar.",{"_3731":75142,"_31485":75116,"_21804":126594,"_5":15036,"_28646":126524,"_3122":56631},[],{"_3731":75143,"_31485":75116,"_21804":126596,"_5":15036,"_28646":126524,"_3122":56634},[],{"_3731":75144,"_31485":75116,"_21804":126598,"_5":15036,"_28646":126524,"_3122":56637},[],{"_3731":75145,"_31485":75116,"_21804":126600,"_5":15036,"_28646":126524,"_3122":126601},[],"Habilitado.",{"_3731":75146,"_31485":75116,"_21804":126603,"_5":15036,"_28646":126524,"_3122":56643},[],{"_3731":75147,"_31485":75116,"_21804":126605,"_5":15036,"_28646":126524,"_3122":126606},[],"Deshabilitado; el ID debe ser nuevo.",{"_3731":75148,"_31485":75116,"_21804":126608,"_5":15036,"_28646":126524,"_3122":126609},[],"Autenticación inicial",{"_3731":75149,"_31485":75116,"_21804":126611,"_5":15036,"_28646":126524,"_3122":126612},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3731":75150,"_31485":75116,"_21804":126614,"_5":15036,"_28646":126524,"_3122":126615},[],"Autenticación de renovación",{"_3731":75151,"_31485":75116,"_21804":126617,"_5":15036,"_28646":126524,"_3122":126618},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3731":75152,"_31485":75116,"_21804":126620,"_5":15036,"_28646":126524,"_3122":56661},[],{"_3731":75153,"_31485":75116,"_21804":126622,"_5":15036,"_28646":126524,"_3122":126623},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3731":75154,"_31485":75116,"_21804":126625,"_5":15036,"_28646":126524,"_3122":56667},[],{"_3731":75155,"_31485":75116,"_21804":126627,"_5":15036,"_28646":126524,"_3122":126628},[],"1 hora.",{"_3731":75156,"_31485":75116,"_21804":126630,"_5":15036,"_28646":126524,"_3122":56673},[],{"_3731":75157,"_31485":75116,"_21804":126632,"_5":15036,"_28646":126524,"_3122":126633},[],"30 minutos / 10 minutos.",{"_3731":75158,"_31485":75116,"_21804":126635,"_5":15036,"_28646":126524,"_3122":56679},[],{"_3731":75159,"_31485":75116,"_21804":126637,"_5":15036,"_28646":126524,"_3122":126638},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3731":75160,"_31485":75116,"_21804":126640,"_5":15036,"_28646":126524,"_3122":54519},[],{"_3731":75161,"_31485":75116,"_21804":126642,"_5":15036,"_28646":126524,"_3122":126643},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3731":75162,"_31485":75116,"_21804":126645,"_5":15036,"_28646":126524,"_3122":56690},[],{"_3731":75163,"_31485":75116,"_21804":126647,"_5":15036,"_28646":126524,"_3122":126648},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3731":75164,"_31485":75116,"_21804":126650,"_5":15036,"_28646":126524,"_3122":126651},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3731":75165,"_31485":75116,"_21804":126653,"_5":15036,"_28646":126528,"_3122":126654},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3731":75166,"_31485":75116,"_21804":126656,"_5":15036,"_28646":126528,"_3122":126657},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3731":75167,"_31485":75116,"_21804":126659,"_5":15036,"_28646":126532,"_3122":126660},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3731":75168,"_31485":75116,"_21804":126662,"_5":15036,"_28646":126532,"_3122":126663},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3731":75169,"_31485":75116,"_21804":126665,"_5":15036,"_28646":126532,"_3122":126666},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3731":75170,"_31485":75116,"_21804":126668,"_5":15036,"_28646":126536,"_3122":126669},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3731":75171,"_31485":75116,"_21804":126671,"_5":15036,"_28646":126536,"_3122":126672},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3731":75172,"_31485":75116,"_21804":126674,"_5":15036,"_28646":126540,"_3122":126675},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3731":75173,"_31485":75116,"_21804":126677,"_5":15036,"_28646":126540,"_3122":126678},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3731":75174,"_31485":75116,"_21804":126680,"_5":15036,"_28646":126540,"_3122":126681},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3731":75175,"_31485":75116,"_21804":126683,"_5":15036,"_28646":126540,"_3122":126684},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3731":75176,"_31485":75116,"_21804":126686,"_5":15036,"_28646":126540,"_3122":126687},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3731":75177,"_31485":75116,"_21804":126689,"_5":15036,"_28646":126544,"_3122":126690},[],"Comprobación",{"_3731":75178,"_31485":75116,"_21804":126692,"_5":15036,"_28646":126544,"_3122":126693},[],"Resultado esperado",{"_3731":75179,"_31485":75116,"_21804":126695,"_5":15036,"_28646":126544,"_3122":126696},[],"Registro",{"_3731":75180,"_31485":75116,"_21804":126698,"_5":15036,"_28646":126544,"_3122":126699},[],"ID creado automáticamente y DMS correcto.",{"_3731":75181,"_31485":75116,"_21804":126701,"_5":15036,"_28646":126544,"_3122":125985},[],{"_3731":75182,"_31485":75116,"_21804":126703,"_5":15036,"_28646":126544,"_3122":126704},[],"CN, perfil, serie y clave verificados.",{"_3731":75183,"_31485":75116,"_21804":126706,"_5":15036,"_28646":126544,"_3122":126707},[],"Inventario",{"_3731":75184,"_31485":75116,"_21804":126709,"_5":15036,"_28646":126544,"_3122":126710},[],"Serie recibida visible como identidad actual y en el historial.",{"_3731":75185,"_31485":75116,"_21804":126712,"_5":15036,"_28646":126544,"_3122":126713},[],"Consumidor",{"_3731":75186,"_31485":75116,"_21804":126715,"_5":15036,"_28646":126544,"_3122":126716},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3731":75187,"_31485":75116,"_21804":126718,"_5":15036,"_28646":126544,"_3122":126719},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3731":75188,"_31485":75116,"_21804":126721,"_5":15036,"_28646":126544,"_3122":126722},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3731":75189,"_31485":75189,"_5":15390,"_3122":124167,"_31812":126724,"_21804":126725,"_28646":75189},[51373,123005,54083,126510],[],{"_3731":75190,"_31485":75189,"_21804":126727,"_5":15036,"_28646":75189,"_3122":126728},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3731":75191,"_31485":75189,"_5":31809,"_21804":126730,"_28646":126731,"_3122":121513},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3731":75192,"_31485":75189,"_5":31809,"_21804":126733,"_28646":126734,"_3122":126735},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3731":75193,"_31485":75189,"_5":31809,"_21804":126737,"_28646":126738,"_3122":126739},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3731":75194,"_31485":75189,"_5":31809,"_21804":126741,"_28646":126742,"_3122":126743},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3731":75195,"_31485":75189,"_5":31809,"_21804":126745,"_28646":126746,"_3122":126747},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3731":75196,"_31485":75189,"_5":31809,"_21804":126749,"_28646":126750,"_3122":126751},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3731":75197,"_31485":75189,"_5":31809,"_21804":126753,"_28646":126754,"_3122":126693},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3731":75198,"_31485":75189,"_5":31809,"_21804":126756,"_28646":126757,"_3122":126758},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3731":75199,"_31485":75189,"_5":31809,"_21804":126760,"_28646":126761,"_3122":126762},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3731":75200,"_31485":75189,"_21804":126764,"_5":15036,"_28646":75189,"_3122":126765},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3731":75201,"_31485":75189,"_21804":126767,"_5":15036,"_28646":75189,"_3122":126768},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3731":75202,"_31485":75189,"_21804":126770,"_5":15036,"_28646":126731,"_3122":126771},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3731":75203,"_31485":75189,"_21804":126773,"_5":15036,"_28646":126731,"_3122":126774},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3731":75204,"_31485":75189,"_21804":126776,"_5":15036,"_28646":126731,"_3122":126777},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3731":75205,"_31485":75189,"_21804":126779,"_5":15036,"_28646":126731,"_3122":126780},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3731":75206,"_31485":75189,"_21804":126782,"_5":15036,"_28646":126734,"_3122":126783},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3731":75207,"_31485":75189,"_21804":126785,"_5":15036,"_28646":126734,"_3122":126786},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3731":75208,"_31485":75189,"_21804":126788,"_5":15036,"_28646":126734,"_3122":126789},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3731":75209,"_31485":75189,"_21804":126791,"_5":15036,"_28646":126734,"_3122":126792},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3731":75210,"_31485":75189,"_21804":126794,"_5":15036,"_28646":126734,"_3122":126795},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3731":75211,"_31485":75189,"_21804":126797,"_5":15036,"_28646":126734,"_3122":126798},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3731":75212,"_31485":75189,"_21804":126800,"_5":15036,"_28646":126734,"_3122":126801},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3731":75213,"_31485":75189,"_21804":126803,"_5":15036,"_28646":126734,"_3122":126804},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3731":75214,"_31485":75189,"_21804":126806,"_5":15036,"_28646":126738,"_3122":126807},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3731":75215,"_31485":75189,"_21804":126809,"_5":15036,"_28646":126738,"_3122":56855},[],{"_3731":75216,"_31485":75189,"_21804":126811,"_5":15036,"_28646":126738,"_3122":126812},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3731":75217,"_31485":75189,"_21804":126814,"_5":15036,"_28646":126738,"_3122":126815},[],"**Icon** y **Tags**: clasificación opcional.",{"_3731":75218,"_31485":75189,"_21804":126817,"_5":15036,"_28646":126738,"_3122":126818},[],"Confirma el registro.",{"_3731":75219,"_31485":75189,"_21804":126820,"_5":15036,"_28646":126742,"_3122":126821},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3731":75220,"_31485":75189,"_21804":126823,"_5":15036,"_28646":126742,"_3122":126824},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3731":75221,"_31485":75189,"_21804":126826,"_5":15036,"_28646":126746,"_3122":126827},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3731":75222,"_31485":75189,"_21804":126829,"_5":15036,"_28646":126746,"_3122":126830},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3731":75223,"_31485":75189,"_21804":126832,"_5":15036,"_28646":126750,"_3122":126833},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3731":75224,"_31485":75189,"_21804":126835,"_5":15036,"_28646":126750,"_3122":126836},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3731":75225,"_31485":75189,"_21804":126838,"_5":15036,"_28646":126754,"_3122":126690},[],{"_3731":75226,"_31485":75189,"_21804":126840,"_5":15036,"_28646":126754,"_3122":126841},[],"Resultado",{"_3731":75227,"_31485":75189,"_21804":126843,"_5":15036,"_28646":126754,"_3122":125971},[],{"_3731":75228,"_31485":75189,"_21804":126845,"_5":15036,"_28646":126754,"_3122":126846},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3731":75229,"_31485":75189,"_21804":126848,"_5":15036,"_28646":126754,"_3122":126849},[],"Identidad actual",{"_3731":75230,"_31485":75189,"_21804":126851,"_5":15036,"_28646":126754,"_3122":126852},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3731":75231,"_31485":75189,"_21804":126854,"_5":15036,"_28646":126754,"_3122":126855},[],"Historial",{"_3731":75232,"_31485":75189,"_21804":126857,"_5":15036,"_28646":126754,"_3122":126858},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3731":75233,"_31485":75189,"_21804":126860,"_5":15036,"_28646":126754,"_3122":126861},[],"Clave y certificado",{"_3731":75234,"_31485":75189,"_21804":126863,"_5":15036,"_28646":126754,"_3122":126864},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3731":75235,"_31485":75189,"_21804":126866,"_5":15036,"_28646":126757,"_3122":126867},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3731":75236,"_31485":75189,"_21804":126869,"_5":15036,"_28646":126757,"_3122":126870},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3731":75237,"_31485":75189,"_21804":126872,"_5":15036,"_28646":126757,"_3122":126873},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3731":75238,"_31485":75189,"_21804":126875,"_5":15036,"_28646":126757,"_3122":126876},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3731":75239,"_31485":75189,"_21804":126878,"_5":15036,"_28646":126761,"_3122":126879},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3731":75240,"_31485":75189,"_21804":126881,"_5":15036,"_28646":126761,"_3122":126882},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3731":75241,"_31485":75189,"_21804":126884,"_5":15036,"_28646":126761,"_3122":126885},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3731":75242,"_31485":75242,"_5":15390,"_3122":126887,"_31812":126888,"_21804":126889,"_28646":75242},"Plataforma Lamassu IoT",[51373,123005],[],{"_3731":75243,"_31485":75242,"_21804":126891,"_5":15036,"_28646":75242,"_3122":126892},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3731":75244,"_31485":75242,"_5":31809,"_21804":126894,"_28646":126895,"_3122":126386},[],"/docs/es/platform/overview#empieza-aquí",{"_3731":75245,"_31485":75242,"_5":31809,"_21804":126897,"_28646":126898,"_3122":126899},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3731":75246,"_31485":75242,"_5":31809,"_21804":126901,"_28646":126902,"_3122":126903},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3731":75247,"_31485":75242,"_5":31809,"_21804":126905,"_28646":126906,"_3122":126907},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3731":75248,"_31485":75242,"_5":31809,"_21804":126909,"_28646":126910,"_3122":126911},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3731":75249,"_31485":75242,"_5":31809,"_21804":126913,"_28646":126914,"_3122":126915},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3731":75250,"_31485":75242,"_5":31809,"_21804":126917,"_28646":126918,"_3122":126919},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3731":75251,"_31485":75242,"_5":31809,"_21804":126921,"_28646":126922,"_3122":126923},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3731":75252,"_31485":75242,"_5":31809,"_21804":126925,"_28646":126926,"_3122":126927},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3731":75253,"_31485":75242,"_5":31809,"_21804":126929,"_28646":126930,"_3122":126931},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3731":75254,"_31485":75242,"_5":31809,"_21804":126933,"_28646":126934,"_3122":126935},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3731":75255,"_31485":75242,"_21804":126937,"_5":15036,"_28646":75242,"_3122":126938},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3731":75256,"_31485":75242,"_21804":126940,"_5":15036,"_28646":126895,"_3122":126941},[],"Elige el resultado que necesitas obtener:",{"_3731":75257,"_31485":75242,"_21804":126943,"_5":15036,"_28646":126895,"_3122":126944},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3731":75258,"_31485":75242,"_21804":126946,"_5":15036,"_28646":126895,"_3122":126947},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3731":75259,"_31485":75242,"_21804":126949,"_5":15036,"_28646":126895,"_3122":126950},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3731":75260,"_31485":75242,"_21804":126952,"_5":15036,"_28646":126898,"_3122":126953},[],"Bloque",{"_3731":75261,"_31485":75242,"_21804":126955,"_5":15036,"_28646":126898,"_3122":126956},[],"Qué gestionas",{"_3731":75262,"_31485":75242,"_21804":126958,"_5":15036,"_28646":126898,"_3122":126959},[],"Punto de entrada",{"_3731":75263,"_31485":75242,"_21804":126961,"_5":15036,"_28646":126898,"_3122":57008},[],{"_3731":75264,"_31485":75242,"_21804":126963,"_5":15036,"_28646":126898,"_3122":126964},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3731":75265,"_31485":75242,"_21804":126966,"_5":15036,"_28646":126898,"_3122":126967},[],"Visión general de PKI",{"_3731":75266,"_31485":75242,"_21804":126969,"_5":15036,"_28646":126898,"_3122":57017},[],{"_3731":75267,"_31485":75242,"_21804":126971,"_5":15036,"_28646":126898,"_3122":126972},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3731":75268,"_31485":75242,"_21804":126974,"_5":15036,"_28646":126898,"_3122":126975},[],"Visión general de IoT Fleets",{"_3731":75269,"_31485":75242,"_21804":126977,"_5":15036,"_28646":126898,"_3122":126978},[],"**Administración**",{"_3731":75270,"_31485":75242,"_21804":126980,"_5":15036,"_28646":126898,"_3122":126981},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3731":75271,"_31485":75242,"_21804":126983,"_5":15036,"_28646":126898,"_3122":123007},[],{"_3731":75272,"_31485":75242,"_21804":126985,"_5":15036,"_28646":126898,"_3122":126986},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3731":75273,"_31485":75242,"_21804":126988,"_5":15036,"_28646":126902,"_3122":126989},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3731":75274,"_31485":75242,"_21804":126991,"_5":15036,"_28646":126902,"_3122":126992},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3731":75275,"_31485":75242,"_21804":126994,"_5":15036,"_28646":126902,"_3122":126995},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3731":75276,"_31485":75242,"_21804":126997,"_5":15036,"_28646":126902,"_3122":126998},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3731":75277,"_31485":75242,"_21804":127000,"_5":15036,"_28646":126902,"_3122":127001},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3731":75278,"_31485":75242,"_21804":127003,"_5":15036,"_28646":126902,"_3122":127004},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3731":75279,"_31485":75242,"_21804":127006,"_5":15036,"_28646":126910,"_3122":127007},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3731":75280,"_31485":75242,"_21804":127009,"_5":15036,"_28646":126914,"_3122":127010},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3731":75281,"_31485":75242,"_21804":127012,"_5":15036,"_28646":126918,"_3122":127013},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3731":75282,"_31485":75242,"_21804":127015,"_5":15036,"_28646":126922,"_3122":127016},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3731":75283,"_31485":75242,"_21804":127018,"_5":15036,"_28646":126926,"_3122":127019},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3731":75284,"_31485":75242,"_21804":127021,"_5":15036,"_28646":126930,"_3122":127022},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3731":75285,"_31485":75242,"_21804":127024,"_5":15036,"_28646":126934,"_3122":126479},[],{"_3731":75286,"_31485":75242,"_21804":127026,"_5":15036,"_28646":126934,"_3122":127027},[],"Qué prepara o comprueba",{"_3731":75287,"_31485":75242,"_21804":127029,"_5":15036,"_28646":126934,"_3122":126482},[],{"_3731":75288,"_31485":75242,"_21804":127031,"_5":15036,"_28646":126934,"_3122":127032},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3731":75289,"_31485":75242,"_21804":127034,"_5":15036,"_28646":126934,"_3122":127035},[],"Administrador de la flota",{"_3731":75290,"_31485":75242,"_21804":127037,"_5":15036,"_28646":126934,"_3122":127038},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3731":75291,"_31485":75242,"_21804":127040,"_5":15036,"_28646":126934,"_3122":126494},[],{"_3731":75292,"_31485":75242,"_21804":127042,"_5":15036,"_28646":126934,"_3122":127043},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3731":75293,"_31485":75242,"_21804":127045,"_5":15036,"_28646":126934,"_3122":126500},[],{"_3731":75294,"_31485":75242,"_21804":127047,"_5":15036,"_28646":126934,"_3122":127048},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3731":75295,"_31485":75242,"_21804":127050,"_5":15036,"_28646":126934,"_3122":127051},[],"Operador de infraestructura",{"_3731":75296,"_31485":75242,"_21804":127053,"_5":15036,"_28646":126934,"_3122":127054},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3731":75297,"_31485":75242,"_21804":127056,"_5":15036,"_28646":126934,"_3122":127057},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3731":75298,"_31485":75298,"_5":15390,"_3122":127059,"_31812":127060,"_21804":127062,"_28646":75298},"Jerarquía y rotación de CAs",[51373,123005,57109,127061],"Claves, autoridades y certificados",[],{"_3731":75299,"_31485":75298,"_21804":127064,"_5":15036,"_28646":75298,"_3122":127065},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3731":75300,"_31485":75298,"_5":31809,"_21804":127067,"_28646":127068,"_3122":127069},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3731":75301,"_31485":75298,"_5":31809,"_21804":127071,"_28646":127072,"_3122":127073},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3731":75302,"_31485":75298,"_5":31809,"_21804":127075,"_28646":127076,"_3122":127077},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3731":75303,"_31485":75298,"_5":31809,"_21804":127079,"_28646":127080,"_3122":127081},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3731":75304,"_31485":75298,"_5":31809,"_21804":127083,"_28646":127084,"_3122":127085},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3731":75305,"_31485":75298,"_5":31809,"_21804":127087,"_28646":127088,"_3122":127089},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3731":75306,"_31485":75298,"_5":31809,"_21804":127091,"_28646":127092,"_3122":127093},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3731":75307,"_31485":75298,"_5":31809,"_21804":127095,"_28646":127096,"_3122":127097},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3731":75308,"_31485":75298,"_5":31809,"_21804":127099,"_28646":127100,"_3122":127101},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3731":75309,"_31485":75298,"_5":31809,"_21804":127103,"_28646":127104,"_3122":127105},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3731":75310,"_31485":75298,"_5":31809,"_21804":127107,"_28646":127108,"_3122":127109},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3731":75311,"_31485":75298,"_5":31809,"_21804":127111,"_28646":127112,"_3122":127113},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3731":75312,"_31485":75298,"_21804":127115,"_5":15036,"_28646":75298,"_3122":127116},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3731":75313,"_31485":75298,"_21804":127118,"_5":15036,"_28646":75298,"_3122":127119},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3731":75314,"_31485":75298,"_21804":127121,"_5":15036,"_28646":127068,"_3122":127122},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3731":75315,"_31485":75298,"_21804":127124,"_5":15036,"_28646":127068,"_3122":127125},[],"entorno, como producción y preproducción;",{"_3731":75316,"_31485":75298,"_21804":127127,"_5":15036,"_28646":127068,"_3122":127128},[],"propietario o equipo operador;",{"_3731":75317,"_31485":75298,"_21804":127130,"_5":15036,"_28646":127068,"_3122":127131},[],"familia de dispositivos o proceso de fabricación;",{"_3731":75318,"_31485":75298,"_21804":127133,"_5":15036,"_28646":127068,"_3122":127134},[],"región o requisito regulatorio;",{"_3731":75319,"_31485":75298,"_21804":127136,"_5":15036,"_28646":127068,"_3122":127137},[],"motor criptográfico o política de clave;",{"_3731":75320,"_31485":75298,"_21804":127139,"_5":15036,"_28646":127068,"_3122":127140},[],"ventana de mantenimiento y ritmo de renovación.",{"_3731":75321,"_31485":75298,"_21804":127142,"_5":15036,"_28646":127068,"_3122":127143},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3731":75322,"_31485":75298,"_21804":127145,"_5":15036,"_28646":127068,"_3122":127146},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3731":75323,"_31485":75298,"_21804":127148,"_5":15036,"_28646":127072,"_3122":127149},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3731":75324,"_31485":75298,"_21804":127151,"_5":15036,"_28646":127072,"_3122":127152},[],"Si los ajustes de CRL de la CA están firmados por el certificado de la CA sustituido, al reemitir el firmante se mueve al certificado nuevo, siempre que incluya `cRLSign`, y se republica la CRL. En caso contrario, y para unos ajustes firmados por otro certificado, el firmante se conserva, así que comprueba el uso de clave del certificado nuevo tras reemitir. Una CA sin ajustes de CRL — por ejemplo, una importada sin su clave o sin `cRLSign` — obtiene los ajustes inicializados con la reemisión cuando el nuevo certificado incluye `cRLSign`; en caso contrario se queda sin ellos. Consulta la guía de CRL.",{"_3731":75325,"_31485":75298,"_21804":127154,"_5":15036,"_28646":127072,"_3122":127155},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3731":75326,"_31485":75298,"_21804":127157,"_5":15036,"_28646":127072,"_3122":127158},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Una CA subordinada la firma su CA padre, de modo que esta también debe estar `ACTIVE` y dentro de su periodo de validez; en caso contrario la reemisión falla con `400`. Anticípate a estas condiciones.",{"_3731":75327,"_31485":75298,"_21804":127160,"_5":15036,"_28646":127076,"_3122":127161},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3731":75328,"_31485":75298,"_21804":127163,"_5":15036,"_28646":127076,"_3122":127164},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3731":75329,"_31485":75298,"_21804":127166,"_5":15036,"_28646":127076,"_3122":127167},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3731":75330,"_31485":75298,"_21804":127169,"_5":15036,"_28646":127076,"_3122":127170},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3731":75331,"_31485":75298,"_21804":127172,"_5":15036,"_28646":127084,"_3122":127173},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3731":75332,"_31485":75298,"_21804":127175,"_5":15036,"_28646":127088,"_3122":127176},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3731":75333,"_31485":75298,"_21804":127178,"_5":15036,"_28646":127092,"_3122":127179},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3731":75334,"_31485":75298,"_21804":127181,"_5":15036,"_28646":127096,"_3122":127182},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3731":75335,"_31485":75298,"_21804":127184,"_5":15036,"_28646":127100,"_3122":127185},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3731":75336,"_31485":75298,"_21804":127187,"_5":15036,"_28646":127104,"_3122":127188},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3731":75337,"_31485":75298,"_21804":127190,"_5":15036,"_28646":127108,"_3122":127191},[],"Lamassu guarda la revocación de la CA y después aplica la misma revocación a sus CAs hijas y certificados emitidos. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3731":75338,"_31485":75298,"_21804":127193,"_5":15036,"_28646":127108,"_3122":127194},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3731":75339,"_31485":75298,"_21804":127196,"_5":15036,"_28646":127108,"_3122":127197},[],"`CertificateHold` es la excepción reversible. Suspender una CA suspende sus CAs hijas activas y sus certificados emitidos con `CertificateHold` y los marca como suspendidos por esa CA. Al reactivar la CA — a `ACTIVE` o a cualquier otro estado no revocado, como `EXPIRED` — se reactivan exactamente los descendientes que siguen suspendidos y conservan esa marca. Las suspensiones colocadas manualmente antes o después de la cascada no se tocan, y cualquier cambio de estado posterior de un descendiente elimina la marca. Revocar definitivamente una CA suspendida con cualquier otra razón sigue siendo permanente: los descendientes se revocan con `CessationOfOperation` y no pueden restaurarse.",{"_3731":75340,"_31485":75298,"_21804":127199,"_5":15036,"_28646":127108,"_3122":127200},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3731":75341,"_31485":75298,"_21804":127202,"_5":15036,"_28646":127112,"_3122":127203},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3731":75342,"_31485":75298,"_21804":127205,"_5":15036,"_28646":127112,"_3122":127206},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3731":75343,"_31485":75298,"_21804":127208,"_5":15036,"_28646":127112,"_3122":127209},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3731":75344,"_31485":75298,"_21804":127211,"_5":15036,"_28646":127112,"_3122":127212},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3731":75345,"_31485":75298,"_21804":127214,"_5":15036,"_28646":127112,"_3122":127215},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3731":75346,"_31485":75298,"_21804":127217,"_5":15036,"_28646":127112,"_3122":127218},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3731":75347,"_31485":75298,"_21804":127220,"_5":15036,"_28646":127112,"_3122":127221},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3731":75348,"_31485":75348,"_5":15390,"_3122":127223,"_31812":127224,"_21804":127225,"_28646":75348},"Autoridades de certificación",[51373,123005,57109,127061],[],{"_3731":75349,"_31485":75348,"_21804":127227,"_5":15036,"_28646":75348,"_3122":127228},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3731":75350,"_31485":75348,"_5":31809,"_21804":127230,"_28646":127231,"_3122":127232},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3731":75351,"_31485":75348,"_5":31809,"_21804":127234,"_28646":127235,"_3122":127236},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3731":75352,"_31485":75348,"_5":31809,"_21804":127238,"_28646":127239,"_3122":121513},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3731":75353,"_31485":75348,"_5":31809,"_21804":127241,"_28646":127242,"_3122":127243},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3731":75354,"_31485":75348,"_5":31809,"_21804":127245,"_28646":127246,"_3122":127247},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3731":75355,"_31485":75348,"_5":31809,"_21804":127249,"_28646":127250,"_3122":127251},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3731":75356,"_31485":75348,"_5":31809,"_21804":127253,"_28646":127254,"_3122":127255},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3731":75357,"_31485":75348,"_5":31809,"_21804":127257,"_28646":127258,"_3122":127259},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3731":75358,"_31485":75348,"_5":31809,"_21804":127261,"_28646":127262,"_3122":127263},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3731":75359,"_31485":75348,"_5":31809,"_21804":127265,"_28646":127266,"_3122":127267},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3731":75360,"_31485":75348,"_5":31809,"_21804":127269,"_28646":127270,"_3122":127271},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3731":75361,"_31485":75348,"_5":31809,"_21804":127273,"_28646":127274,"_3122":127275},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3731":75362,"_31485":75348,"_5":31809,"_21804":127277,"_28646":127278,"_3122":127279},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3731":75363,"_31485":75348,"_5":31809,"_21804":127281,"_28646":127282,"_3122":127283},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3731":75364,"_31485":75348,"_5":31809,"_21804":127285,"_28646":127286,"_3122":127287},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3731":75365,"_31485":75348,"_5":31809,"_21804":127289,"_28646":127290,"_3122":127291},[],"/docs/es/platform/pki/certificate-authorities#estados-de-una-ca","Estados de una CA",{"_3731":75366,"_31485":75348,"_5":31809,"_21804":127293,"_28646":127294,"_3122":127295},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3731":75367,"_31485":75348,"_5":31809,"_21804":127297,"_28646":127298,"_3122":127299},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3731":75368,"_31485":75348,"_5":31809,"_21804":127301,"_28646":127302,"_3122":127303},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3731":75369,"_31485":75348,"_5":31809,"_21804":127305,"_28646":127306,"_3122":127307},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3731":75370,"_31485":75348,"_5":31809,"_21804":127309,"_28646":127310,"_3122":127311},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3731":75371,"_31485":75348,"_5":31809,"_21804":127313,"_28646":127314,"_3122":127315},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3731":75372,"_31485":75348,"_5":31809,"_21804":127317,"_28646":127318,"_3122":127319},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3731":75373,"_31485":75348,"_5":31809,"_21804":127321,"_28646":127322,"_3122":127323},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3731":75374,"_31485":75348,"_21804":127325,"_5":15036,"_28646":75348,"_3122":127326},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3731":75375,"_31485":75348,"_21804":127328,"_5":15036,"_28646":75348,"_3122":127329},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3731":75376,"_31485":75348,"_21804":127331,"_5":15036,"_28646":75348,"_3122":127332},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3731":75377,"_31485":75348,"_21804":127334,"_5":15036,"_28646":127231,"_3122":127335},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3731":75378,"_31485":75348,"_21804":127337,"_5":15036,"_28646":127231,"_3122":127338},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3731":75379,"_31485":75348,"_21804":127340,"_5":15036,"_28646":127231,"_3122":127341},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3731":75380,"_31485":75348,"_21804":127343,"_5":15036,"_28646":127231,"_3122":127344},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3731":75381,"_31485":75348,"_21804":127346,"_5":15036,"_28646":127231,"_3122":127347},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3731":75382,"_31485":75348,"_21804":127349,"_5":15036,"_28646":127239,"_3122":127350},[],"Decide si la CA será raíz o intermedia.",{"_3731":75383,"_31485":75348,"_21804":127352,"_5":15036,"_28646":127239,"_3122":127353},[],"Elige el motor que custodiará la clave.",{"_3731":75384,"_31485":75348,"_21804":127355,"_5":15036,"_28646":127239,"_3122":127356},[],"Define una validez superior a la de los certificados que emitirá.",{"_3731":75385,"_31485":75348,"_21804":127358,"_5":15036,"_28646":127239,"_3122":127359},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3731":75386,"_31485":75348,"_21804":127361,"_5":15036,"_28646":127242,"_3122":127362},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3731":75387,"_31485":75348,"_21804":127364,"_5":15036,"_28646":127246,"_3122":127365},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3731":75388,"_31485":75348,"_21804":127367,"_5":15036,"_28646":127246,"_3122":127368},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3731":75389,"_31485":75348,"_21804":127370,"_5":15036,"_28646":127250,"_3122":127371},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3731":75390,"_31485":75348,"_21804":127373,"_5":15036,"_28646":127254,"_3122":127374},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3731":75391,"_31485":75348,"_21804":127376,"_5":15036,"_28646":127254,"_3122":127377},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3731":75392,"_31485":75348,"_21804":127379,"_5":15036,"_28646":127254,"_3122":127380},[],"`ST`: estado o provincia.",{"_3731":75393,"_31485":75348,"_21804":127382,"_5":15036,"_28646":127254,"_3122":127383},[],"`L`: localidad.",{"_3731":75394,"_31485":75348,"_21804":127385,"_5":15036,"_28646":127254,"_3122":127386},[],"`O`: organización.",{"_3731":75395,"_31485":75348,"_21804":127388,"_5":15036,"_28646":127254,"_3122":127389},[],"`OU`: unidad organizativa.",{"_3731":75396,"_31485":75348,"_21804":127391,"_5":15036,"_28646":127254,"_3122":127392},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3731":75397,"_31485":75348,"_21804":127394,"_5":15036,"_28646":127258,"_3122":127395},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3731":75398,"_31485":75348,"_21804":127397,"_5":15036,"_28646":127258,"_3122":127398},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3731":75399,"_31485":75348,"_21804":127400,"_5":15036,"_28646":127262,"_3122":127401},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3731":75400,"_31485":75348,"_21804":127403,"_5":15036,"_28646":127262,"_3122":127404},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3731":75401,"_31485":75348,"_21804":127406,"_5":15036,"_28646":127266,"_3122":127407},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3731":75402,"_31485":75348,"_21804":127409,"_5":15036,"_28646":127266,"_3122":127410},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3731":75403,"_31485":75348,"_21804":127412,"_5":15036,"_28646":127270,"_3122":127413},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3731":75404,"_31485":75348,"_21804":127415,"_5":15036,"_28646":127270,"_3122":127416},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3731":75405,"_31485":75348,"_21804":127418,"_5":15036,"_28646":127270,"_3122":127419},[],"Un certificado cuyo periodo de validez ya ha terminado, como el de una autoridad externa retirada, se acepta y, cuando Lamassu aún no tiene un registro de ese certificado, la CA se almacena como `EXPIRED` desde el principio, igual que al importar un certificado simple. Si la importación reutiliza el registro de una CA eliminada (véase arriba y Elimina una CA), se conserva el estado anterior aunque el certificado haya caducado entretanto. Una CA `EXPIRED` rechaza los cambios de estado; consulta el ciclo de vida del certificado.",{"_3731":75406,"_31485":75348,"_21804":127421,"_5":15036,"_28646":127270,"_3122":127422},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3731":75407,"_31485":75348,"_21804":127424,"_5":15036,"_28646":127274,"_3122":127425},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3731":75408,"_31485":75348,"_21804":127427,"_5":15036,"_28646":127278,"_3122":127428},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3731":75409,"_31485":75348,"_21804":127430,"_5":15036,"_28646":127278,"_3122":127431},[],"El backend valida antes de importar ninguna clave: se rechazan un ID de CA duplicado y un certificado que no es de CA (falta `basicConstraints` `cA=TRUE`), este último con `400` `certificate is not a CA: basicConstraints cA flag is not set`. Si ocurre un fallo después de haber importado la clave, la clave se conserva en el KMS y un aviso te pide eliminarla manualmente.",{"_3731":75410,"_31485":75348,"_21804":127433,"_5":15036,"_28646":127282,"_3122":127434},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3731":75411,"_31485":75348,"_21804":127436,"_5":15036,"_28646":127286,"_3122":127437},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3731":75412,"_31485":75348,"_21804":127439,"_5":15036,"_28646":127286,"_3122":127440},[],"Una CA importada cuya clave está en el KMS y cuyo certificado incluye `cRLSign` recibe automáticamente sus ajustes de CRL y su primera CRL; sin una clave en el KMS o sin `cRLSign` no los recibe, y esto no es un error de importación (consulta CRL).",{"_3731":75413,"_31485":75348,"_21804":127442,"_5":15036,"_28646":127286,"_3122":127443},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3731":75414,"_31485":75348,"_21804":127445,"_5":15036,"_28646":127290,"_3122":127446},[],"Una CA solo firma en `ACTIVE`. Desde ahí puede pasar a `EXPIRED` o a `REVOKED`, y de esos estados solo sale por la eliminación, salvo en un caso: la revocación con `CertificateHold` se puede deshacer.",{"_3731":75415,"_31485":75348,"_21804":127448,"_5":15036,"_28646":127290,"_3122":127449},[],"**Caducidad.** El monitor de expiración marca como `EXPIRED` las CAs `ACTIVE` cuyo periodo de validez ha terminado. Hasta que se ejecuta, la CA ya no firma, porque Lamassu comprueba las fechas (Emite certificados).",{"_3731":75416,"_31485":75348,"_21804":127451,"_5":15036,"_28646":127290,"_3122":127452},[],"**Revocación.** Revocar con la razón `CertificateHold` es reversible. Una revocación con cualquier otra razón, igual que `EXPIRED`, rechaza todo cambio de estado posterior. Revocar, también con `CertificateHold`, actúa además sobre las CAs subordinadas y los certificados que emitió: Revoca una CA.",{"_3731":75417,"_31485":75348,"_21804":127454,"_5":15036,"_28646":127290,"_3122":127455},[],"**Eliminación.** Solo una CA revocada con otra razón o caducada puede eliminarse; una importada sin clave, desde cualquier estado. Condiciones y efectos en Elimina una CA.",{"_3731":75418,"_31485":75348,"_21804":127457,"_5":15036,"_28646":127294,"_3122":127458},[],"Abre una CA desde el inventario para consultar:",{"_3731":75419,"_31485":75348,"_21804":127460,"_5":15036,"_28646":127294,"_3122":127461},[],"Estado y periodo de validez.",{"_3731":75420,"_31485":75348,"_21804":127463,"_5":15036,"_28646":127294,"_3122":127464},[],"Certificado y cadena en formato PEM.",{"_3731":75421,"_31485":75348,"_21804":127466,"_5":15036,"_28646":127294,"_3122":127467},[],"Número de certificados activos, expirados y revocados.",{"_3731":75422,"_31485":75348,"_21804":127469,"_5":15036,"_28646":127294,"_3122":127470},[],"Certificados emitidos en **Issued Certificates**.",{"_3731":75423,"_31485":75348,"_21804":127472,"_5":15036,"_28646":127294,"_3122":127473},[],"CRL vinculada a la autoridad.",{"_3731":75424,"_31485":75348,"_21804":127475,"_5":15036,"_28646":127294,"_3122":127476},[],"Metadatos y motor criptográfico asociado.",{"_3731":75425,"_31485":75348,"_21804":127478,"_5":15036,"_28646":127294,"_3122":127479},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3731":75426,"_31485":75348,"_21804":127481,"_5":15036,"_28646":127298,"_3122":127482},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3731":75427,"_31485":75348,"_21804":127484,"_5":15036,"_28646":127298,"_3122":127485},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3731":75428,"_31485":75348,"_21804":127487,"_5":15036,"_28646":127298,"_3122":127488},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3731":75429,"_31485":75348,"_21804":127490,"_5":15036,"_28646":127298,"_3122":127491},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3731":75430,"_31485":75348,"_21804":127493,"_5":15036,"_28646":127298,"_3122":127494},[],"La clave de una CA solo firma certificados. La API de CA no tiene ningún endpoint para firmar o verificar datos arbitrarios. Para firmar y verificar un mensaje con una clave, utiliza las operaciones del KMS descritas en Gestión de claves, sujetas a sus propios permisos.",{"_3731":75431,"_31485":75348,"_21804":127496,"_5":15036,"_28646":127298,"_3122":127497},[],"Una CA solo firma mientras su estado es `ACTIVE` y la hora actual está dentro del periodo de validez de su certificado. Lamassu comprueba ambas condiciones porque el estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración. En caso contrario, la petición falla con `400` y el mensaje `CA Status inconsistent`, antes de llamar al KMS. La misma comprobación se aplica cuando la CA firma el certificado de una CA subordinada, también al crearla o reemitirla.",{"_3731":75432,"_31485":75348,"_21804":127499,"_5":15036,"_28646":127302,"_3122":127500},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Con `CertificateHold` la cascada es reversible: los descendientes quedan suspendidos y se restauran al reactivar la CA. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Sigue las condiciones de revocación en cascada.",{"_3731":75433,"_31485":75348,"_21804":127502,"_5":15036,"_28646":127306,"_3122":127503},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3731":75434,"_31485":75348,"_21804":127505,"_5":15036,"_28646":127310,"_3122":127506},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3731":75435,"_31485":75348,"_21804":127508,"_5":15036,"_28646":127314,"_3122":127509},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3731":75436,"_31485":75348,"_21804":127511,"_5":15036,"_28646":127318,"_3122":127512},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3731":75437,"_31485":75348,"_21804":127514,"_5":15036,"_28646":127322,"_3122":127515},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3731":75438,"_31485":75348,"_21804":127517,"_5":15036,"_28646":127322,"_3122":127518},[],"Lo que la eliminación hace con lo emitido por la CA depende de su estado. Eliminar una CA activa importada sin clave cuyo periodo de validez no ha terminado solo elimina el registro de Lamassu: la CA, sus descendientes y los certificados que emitió conservan su estado, ya que la CA sigue operando fuera de Lamassu — su clave nunca estuvo en Lamassu. Pero si el periodo de validez ya terminó y el estado almacenado sigue siendo `ACTIVE` — el estado almacenado puede ir por detrás de las fechas hasta que se ejecute el monitor de expiración —, para la eliminación la CA cuenta como caducada. Eliminar una CA revocada o caducada revoca lo que emitió con `CessationOfOperation`, la misma cascada que al revocar una CA. Para retirar una CA activa sin clave junto con todo lo que emitió, revócala primero con `POST /v1/cas/:id/status` y después elimínala.",{"_3731":75439,"_31485":75348,"_21804":127520,"_5":15036,"_28646":127322,"_3122":127521},[],"Los ajustes de CRL de la CA se conservan. La eliminación se rechaza con un error `409` mientras sigan `ACTIVE`: la VA debe publicar primero la CRL final de la CA, lo que puede tardar hasta aproximadamente una hora después de la revocación con la programación predeterminada del trabajo, así que reintenta cuando se haya publicado la CRL final. Una CA caducada se finaliza sin CRL final, y una CA en retención (`CertificateHold`) se rechaza con un mensaje que te pide revocarla de forma permanente primero. La eliminación también se rechaza con un `409` cuando la clave de la CA firma las CRLs de otra CA: el error nombra a esa CA, así que cambia su firmante de CRL, o elimínala o revócala, antes de eliminar esta. La CA y todos sus descendientes se comprueban antes de eliminar nada; si alguno no puede eliminarse, no cambia nada.",{"_3731":75440,"_31485":75348,"_21804":127523,"_5":15036,"_28646":127322,"_3122":127524},[],"Tras la eliminación, los ajustes quedan archivados y la última CRL sigue sirviéndose pero nunca se regenera; puedes eliminarlos cuando ningún certificado emitido por la CA necesite ya evidencia de revocación, con `DELETE /v1/crl-settings/{ca-id}` o desde la página **Verification Authorities** de la consola. Borrarlos deja de servir la CRL y no puede deshacerse. Ajusta la validez y el firmante antes de revocar o eliminar la CA (consulta CRL). La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3731":75441,"_31485":75348,"_21804":127526,"_5":15036,"_28646":127322,"_3122":127527},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. La CA reimportada se registra con un ID de CA nuevo generado por el backend y no hereda los ajustes de CRL de la CA eliminada: hasta que se eliminen esos ajustes, estos siguen sirviendo su última CRL en la URL del ID de CA y, si los migró la actualización, en `/crl/<ski>` — la que llevan los certificados emitidos antes de la actualización a 4.0.0 —; cuando están archivados, dejan de poder editarse (consulta CRL).",{"_3731":75442,"_31485":75442,"_5":15390,"_3122":127529,"_31812":127530,"_21804":127531,"_28646":75442},"Perfiles de certificado",[51373,123005,57109,127061],[],{"_3731":75443,"_31485":75442,"_21804":127533,"_5":15036,"_28646":75442,"_3122":127534},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3731":75444,"_31485":75442,"_5":31809,"_21804":127536,"_28646":127537,"_3122":127538},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3731":75445,"_31485":75442,"_5":31809,"_21804":127540,"_28646":127541,"_3122":127542},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3731":75446,"_31485":75442,"_5":31809,"_21804":127544,"_28646":127545,"_3122":127546},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3731":75447,"_31485":75442,"_5":31809,"_21804":127548,"_28646":127549,"_3122":127550},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3731":75448,"_31485":75442,"_5":31809,"_21804":127552,"_28646":127553,"_3122":127554},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3731":75449,"_31485":75442,"_5":31809,"_21804":127556,"_28646":127557,"_3122":127558},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3731":75450,"_31485":75442,"_5":31809,"_21804":127560,"_28646":127561,"_3122":127562},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3731":75451,"_31485":75442,"_5":31809,"_21804":127564,"_28646":127565,"_3122":127566},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3731":75452,"_31485":75442,"_5":31809,"_21804":127568,"_28646":127569,"_3122":127570},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3731":75453,"_31485":75442,"_5":31809,"_21804":127572,"_28646":127573,"_3122":127574},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3731":75454,"_31485":75442,"_5":31809,"_21804":127576,"_28646":127577,"_3122":127578},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3731":75455,"_31485":75442,"_5":31809,"_21804":127580,"_28646":127581,"_3122":127582},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3731":75456,"_31485":75442,"_5":31809,"_21804":127584,"_28646":127585,"_3122":127586},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3731":75457,"_31485":75442,"_5":31809,"_21804":127588,"_28646":127589,"_3122":127590},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3731":75458,"_31485":75442,"_5":31809,"_21804":127592,"_28646":127593,"_3122":127594},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3731":75459,"_31485":75442,"_5":31809,"_21804":127596,"_28646":127597,"_3122":127598},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3731":75460,"_31485":75442,"_21804":127600,"_5":15036,"_28646":75442,"_3122":127601},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3731":75461,"_31485":75442,"_21804":127603,"_5":15036,"_28646":75442,"_3122":127604},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3731":75462,"_31485":75442,"_21804":127606,"_5":15036,"_28646":127541,"_3122":127607},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3731":75463,"_31485":75442,"_21804":127609,"_5":15036,"_28646":127541,"_3122":127610},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3731":75464,"_31485":75442,"_21804":127612,"_5":15036,"_28646":127545,"_3122":127613},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Lamassu lo aplica: un perfil con `Sign as CA` solo se consume al crear o reemitir una CA. Toda solicitud de firma que resuelva a un perfil así se rechaza — la firma directa con una CA, incluidas las solicitudes de emisión de certificados sobre ella, y el enrolamiento o reenrolamiento del DMS. Nada valida el perfil al guardarlo: si el perfil predeterminado de una CA o el perfil de un DMS lo tiene activado, el problema aparece en la primera solicitud de firma que lo resuelva — en el caso de un DMS, cuando un dispositivo intenta enrolarse o reenrolarse — y la renovación sigue bloqueada hasta que se cambia el perfil.",{"_3731":75465,"_31485":75442,"_21804":127615,"_5":15036,"_28646":127549,"_3122":127616},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3731":75466,"_31485":75442,"_21804":127618,"_5":15036,"_28646":127549,"_3122":127619},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3731":75467,"_31485":75442,"_21804":127621,"_5":15036,"_28646":127549,"_3122":127622},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3731":75468,"_31485":75442,"_21804":127624,"_5":15036,"_28646":127553,"_3122":127625},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3731":75469,"_31485":75442,"_21804":127627,"_5":15036,"_28646":127557,"_3122":127628},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3731":75470,"_31485":75442,"_21804":127630,"_5":15036,"_28646":127557,"_3122":127631},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3731":75471,"_31485":75442,"_21804":127633,"_5":15036,"_28646":127561,"_3122":127634},[],"La aplicación criptográfica puede:",{"_3731":75472,"_31485":75442,"_21804":127636,"_5":15036,"_28646":127561,"_3122":127637},[],"permitir o bloquear claves RSA;",{"_3731":75473,"_31485":75442,"_21804":127639,"_5":15036,"_28646":127561,"_3122":127640},[],"limitar los tamaños RSA admitidos;",{"_3731":75474,"_31485":75442,"_21804":127642,"_5":15036,"_28646":127561,"_3122":127643},[],"permitir o bloquear claves ECDSA;",{"_3731":75475,"_31485":75442,"_21804":127645,"_5":15036,"_28646":127561,"_3122":127646},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3731":75476,"_31485":75442,"_21804":127648,"_5":15036,"_28646":127561,"_3122":127649},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3731":75477,"_31485":75442,"_21804":127651,"_5":15036,"_28646":127565,"_3122":127652},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3731":75478,"_31485":75442,"_21804":127654,"_5":15036,"_28646":127565,"_3122":122765},[],{"_3731":75479,"_31485":75442,"_21804":127656,"_5":15036,"_28646":127565,"_3122":127657},[],"Primera opción",{"_3731":75480,"_31485":75442,"_21804":127659,"_5":15036,"_28646":127565,"_3122":127660},[],"Segunda opción",{"_3731":75481,"_31485":75442,"_21804":127662,"_5":15036,"_28646":127565,"_3122":127663},[],"Si no hay ninguna",{"_3731":75482,"_31485":75442,"_21804":127665,"_5":15036,"_28646":127565,"_3122":127666},[],"Firma directa con una CA",{"_3731":75483,"_31485":75442,"_21804":127668,"_5":15036,"_28646":127565,"_3122":127669},[],"`issuance_profile` incluido en la solicitud",{"_3731":75484,"_31485":75442,"_21804":127671,"_5":15036,"_28646":127565,"_3122":127672},[],"`issuance_profile_id` de la solicitud",{"_3731":75485,"_31485":75442,"_21804":127674,"_5":15036,"_28646":127565,"_3122":127675},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3731":75486,"_31485":75442,"_21804":127677,"_5":15036,"_28646":127565,"_3122":127678},[],"Emisión mediante DMS",{"_3731":75487,"_31485":75442,"_21804":127680,"_5":15036,"_28646":127565,"_3122":57730},[],{"_3731":75488,"_31485":75442,"_21804":127682,"_5":15036,"_28646":127565,"_3122":127683},[],"`settings.issuance_profile` incluido en el DMS",{"_3731":75489,"_31485":75442,"_21804":127685,"_5":15036,"_28646":127565,"_3122":127686},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3731":75490,"_31485":75442,"_21804":127688,"_5":15036,"_28646":127565,"_3122":127689},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3731":75491,"_31485":75442,"_21804":127691,"_5":15036,"_28646":127565,"_3122":127692},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3731":75492,"_31485":75442,"_21804":127694,"_5":15036,"_28646":127573,"_3122":127695},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3731":75493,"_31485":75442,"_21804":127697,"_5":15036,"_28646":127577,"_3122":127698},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3731":75494,"_31485":75442,"_21804":127700,"_5":15036,"_28646":127581,"_3122":127701},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3731":75495,"_31485":75442,"_21804":127703,"_5":15036,"_28646":127585,"_3122":127704},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3731":75496,"_31485":75442,"_21804":127706,"_5":15036,"_28646":127589,"_3122":127707},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3731":75497,"_31485":75442,"_21804":127709,"_5":15036,"_28646":127589,"_3122":127710},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3731":75498,"_31485":75442,"_21804":127712,"_5":15036,"_28646":127593,"_3122":127713},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3731":75499,"_31485":75442,"_21804":127715,"_5":15036,"_28646":127593,"_3122":127716},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3731":75500,"_31485":75442,"_21804":127718,"_5":15036,"_28646":127593,"_3122":127719},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3731":75501,"_31485":75442,"_21804":127721,"_5":15036,"_28646":127593,"_3122":127722},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3731":75502,"_31485":75442,"_21804":127724,"_5":15036,"_28646":127597,"_3122":127725},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3731":75503,"_31485":75442,"_21804":127727,"_5":15036,"_28646":127597,"_3122":127728},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3731":75504,"_31485":75504,"_5":15390,"_3122":127730,"_31812":127731,"_21804":127733,"_28646":75504},"Validación de certificados",[51373,123005,57109,127732],"Validación",[],{"_3731":75505,"_31485":75504,"_21804":127735,"_5":15036,"_28646":75504,"_3122":127736},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3731":75506,"_31485":75504,"_5":31809,"_21804":127738,"_28646":127739,"_3122":127740},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3731":75507,"_31485":75504,"_5":31809,"_21804":127742,"_28646":127743,"_3122":127744},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3731":75508,"_31485":75504,"_5":31809,"_21804":127746,"_28646":127747,"_3122":127748},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3731":75509,"_31485":75504,"_21804":127750,"_5":15036,"_28646":75504,"_3122":127751},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3731":75510,"_31485":75504,"_21804":127753,"_5":15036,"_28646":127739,"_3122":127754},[],"Verifica estos criterios juntos:",{"_3731":75511,"_31485":75504,"_21804":127756,"_5":15036,"_28646":127739,"_3122":126690},[],{"_3731":75512,"_31485":75504,"_21804":127758,"_5":15036,"_28646":127739,"_3122":127759},[],"Resultado necesario",{"_3731":75513,"_31485":75504,"_21804":127761,"_5":15036,"_28646":127739,"_3122":127762},[],"Cadena y firma",{"_3731":75514,"_31485":75504,"_21804":127764,"_5":15036,"_28646":127739,"_3122":127765},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3731":75515,"_31485":75504,"_21804":127767,"_5":15036,"_28646":127739,"_3122":127768},[],"Fechas",{"_3731":75516,"_31485":75504,"_21804":127770,"_5":15036,"_28646":127739,"_3122":127771},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3731":75517,"_31485":75504,"_21804":127773,"_5":15036,"_28646":127739,"_3122":122675},[],{"_3731":75518,"_31485":75504,"_21804":127775,"_5":15036,"_28646":127739,"_3122":127776},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3731":75519,"_31485":75504,"_21804":127778,"_5":15036,"_28646":127739,"_3122":127779},[],"Uso",{"_3731":75520,"_31485":75504,"_21804":127781,"_5":15036,"_28646":127739,"_3122":127782},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3731":75521,"_31485":75504,"_21804":127784,"_5":15036,"_28646":127739,"_3122":127785},[],"Revocación",{"_3731":75522,"_31485":75504,"_21804":127787,"_5":15036,"_28646":127739,"_3122":127788},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3731":75523,"_31485":75504,"_21804":127790,"_5":15036,"_28646":127739,"_3122":127791},[],"Autorización",{"_3731":75524,"_31485":75504,"_21804":127793,"_5":15036,"_28646":127739,"_3122":127794},[],"La aplicación permite la acción a esa identidad.",{"_3731":75525,"_31485":75504,"_21804":127796,"_5":15036,"_28646":127739,"_3122":127797},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3731":75526,"_31485":75504,"_21804":127799,"_5":15036,"_28646":127743,"_3122":127800},[],"Mecanismo",{"_3731":75527,"_31485":75504,"_21804":127802,"_5":15036,"_28646":127743,"_3122":127803},[],"Cuándo utilizarlo",{"_3731":75528,"_31485":75504,"_21804":127805,"_5":15036,"_28646":127743,"_3122":127806},[],"Qué debes mantener",{"_3731":75529,"_31485":75504,"_21804":127808,"_5":15036,"_28646":127743,"_3122":57858},[],{"_3731":75530,"_31485":75504,"_21804":127810,"_5":15036,"_28646":127743,"_3122":127811},[],"Consulta del estado de un certificado concreto.",{"_3731":75531,"_31485":75504,"_21804":127813,"_5":15036,"_28646":127743,"_3122":127814},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3731":75532,"_31485":75504,"_21804":127816,"_5":15036,"_28646":127743,"_3122":57867},[],{"_3731":75533,"_31485":75504,"_21804":127818,"_5":15036,"_28646":127743,"_3122":127819},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3731":75534,"_31485":75504,"_21804":127821,"_5":15036,"_28646":127743,"_3122":127822},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3731":75535,"_31485":75504,"_21804":127824,"_5":15036,"_28646":127743,"_3122":127825},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3731":75536,"_31485":75504,"_21804":127827,"_5":15036,"_28646":127743,"_3122":127828},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3731":75537,"_31485":75504,"_21804":127830,"_5":15036,"_28646":127747,"_3122":127831},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3731":75538,"_31485":75504,"_21804":127833,"_5":15036,"_28646":127747,"_3122":127834},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3731":75539,"_31485":75504,"_21804":127836,"_5":15036,"_28646":127747,"_3122":127837},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3731":75540,"_31485":75504,"_21804":127839,"_5":15036,"_28646":127747,"_3122":127840},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3731":75541,"_31485":75504,"_21804":127842,"_5":15036,"_28646":127747,"_3122":127843},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3731":75542,"_31485":75504,"_21804":127845,"_5":15036,"_28646":127747,"_3122":127846},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3731":75543,"_31485":75504,"_21804":127848,"_5":15036,"_28646":127747,"_3122":127849},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3731":75544,"_31485":75504,"_21804":127851,"_5":15036,"_28646":127747,"_3122":127852},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3731":75545,"_31485":75504,"_21804":127854,"_5":15036,"_28646":127747,"_3122":127855},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3731":75546,"_31485":75546,"_5":15390,"_3122":127857,"_31812":127858,"_21804":127859,"_28646":75546},"Certificados",[51373,123005,57109,127061],[],{"_3731":75547,"_31485":75546,"_21804":127861,"_5":15036,"_28646":75546,"_3122":127862},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3731":75548,"_31485":75546,"_5":31809,"_21804":127864,"_28646":127865,"_3122":127866},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3731":75549,"_31485":75546,"_5":31809,"_21804":127868,"_28646":127869,"_3122":127870},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3731":75550,"_31485":75546,"_5":31809,"_21804":127872,"_28646":127873,"_3122":127874},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3731":75551,"_31485":75546,"_5":31809,"_21804":127876,"_28646":127877,"_3122":127878},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3731":75552,"_31485":75546,"_5":31809,"_21804":127880,"_28646":127881,"_3122":127882},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3731":75553,"_31485":75546,"_5":31809,"_21804":127884,"_28646":127885,"_3122":127886},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3731":75554,"_31485":75546,"_5":31809,"_21804":127888,"_28646":127889,"_3122":127890},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3731":75555,"_31485":75546,"_5":31809,"_21804":127892,"_28646":127893,"_3122":127894},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3731":75556,"_31485":75546,"_5":31809,"_21804":127896,"_28646":127897,"_3122":127898},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3731":75557,"_31485":75546,"_21804":127900,"_5":15036,"_28646":75546,"_3122":127901},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3731":75558,"_31485":75546,"_21804":127903,"_5":15036,"_28646":127865,"_3122":127904},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Un certificado no contiene su clave privada, así que las superficies de clave privada responden qué certificados tienen su clave custodiada en el KMS de Lamassu:",{"_3731":75559,"_31485":75546,"_21804":127906,"_5":15036,"_28646":127865,"_3122":127907},[],"El filtro avanzado **Private Key**, disponible en la página Certificates y en la pestaña **Issued Certificates** de una CA, limita la lista a **All Certificates**, **With Private Key** o **Without Private Key**.",{"_3731":75560,"_31485":75546,"_21804":127909,"_5":15036,"_28646":127865,"_3122":127910},[],"La columna ordenable **Private Key** — visible por defecto y oculta en pantallas estrechas — marca con una marca de verificación verde la clave custodiada en el KMS y muestra `-` en los demás casos.",{"_3731":75561,"_31485":75546,"_21804":127912,"_5":15036,"_28646":127865,"_3122":127913},[],"En los detalles del certificado, la pestaña **Information** muestra una fila **Private Key** en la sección **Key & Signature**. Cuando el certificado indica que tiene clave privada y están disponibles los identificadores de la clave y del motor del KMS, la fila enlaza a la clave (tooltip: **Open private key in KMS**). En caso contrario, muestra **Present** si el certificado indica que tiene clave privada o **Not available** si no lo indica. Esto no determina si existe una clave fuera de Lamassu.",{"_3731":75562,"_31485":75546,"_21804":127915,"_5":15036,"_28646":127865,"_3122":127916},[],"Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos.",{"_3731":75563,"_31485":75546,"_21804":127918,"_5":15036,"_28646":127865,"_3122":127919},[],"Los registros de certificados exponen `key_id` (la clave del KMS que custodia la clave privada, vacía cuando el KMS no la custodia) y `has_private_key` (derivada al leerla desde el KMS). Los listados de certificados y CAs admiten un filtro `has_private_key`, útil, por ejemplo, para comprobar el resultado de la migración de CA a KMS de la actualización a 4.0.0.",{"_3731":75564,"_31485":75546,"_21804":127921,"_5":15036,"_28646":127865,"_3122":127922},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3731":75565,"_31485":75546,"_21804":127924,"_5":15036,"_28646":127869,"_3122":127925},[],"Descarga el PEM e inspecciónalo:",{"_3731":75566,"_31485":75546,"_21804":127927,"_5":15036,"_28646":127869,"_3122":127928},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3731":75567,"_31485":75546,"_21804":127930,"_5":15036,"_28646":127873,"_3122":127931},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3731":75568,"_31485":75546,"_21804":127933,"_5":15036,"_28646":127873,"_3122":127934},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3731":75569,"_31485":75546,"_21804":127936,"_5":15036,"_28646":127873,"_3122":127937},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3731":75570,"_31485":75546,"_21804":127939,"_5":15036,"_28646":127873,"_3122":127940},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3731":75571,"_31485":75546,"_21804":127942,"_5":15036,"_28646":127873,"_3122":127943},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3731":75572,"_31485":75546,"_21804":127945,"_5":15036,"_28646":127873,"_3122":127946},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3731":75573,"_31485":75546,"_21804":127948,"_5":15036,"_28646":127873,"_3122":127949},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3731":75574,"_31485":75546,"_21804":127951,"_5":15036,"_28646":127877,"_3122":127952},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3731":75575,"_31485":75546,"_21804":127954,"_5":15036,"_28646":127881,"_3122":127955},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3731":75576,"_31485":75546,"_21804":127957,"_5":15036,"_28646":127885,"_3122":127958},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3731":75577,"_31485":75546,"_21804":127960,"_5":15036,"_28646":127889,"_3122":127961},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3731":75578,"_31485":75546,"_21804":127963,"_5":15036,"_28646":127889,"_3122":127964},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3731":75579,"_31485":75546,"_21804":127966,"_5":15036,"_28646":127889,"_3122":127967},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3731":75580,"_31485":75546,"_21804":127969,"_5":15036,"_28646":127893,"_3122":127970},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3731":75581,"_31485":75546,"_21804":127972,"_5":15036,"_28646":127893,"_3122":127973},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3731":75582,"_31485":75546,"_21804":127975,"_5":15036,"_28646":127893,"_3122":127976},[],"Esto no revierte una revocación definitiva ni la cascada de una CA revocada para siempre; la suspensión en cascada desde una CA se levanta reactivando esa CA.",{"_3731":75583,"_31485":75546,"_21804":127978,"_5":15036,"_28646":127897,"_3122":127979},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3731":75584,"_31485":75546,"_21804":127981,"_5":15036,"_28646":127897,"_3122":127982},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3731":75585,"_31485":75585,"_5":15390,"_3122":127984,"_31812":127985,"_21804":127987,"_28646":75585},"Ciclo de vida de un certificado",[51373,123005,57109,127986],"Conceptos",[],{"_3731":75586,"_31485":75585,"_21804":127989,"_5":15036,"_28646":75585,"_3122":127990},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3731":75587,"_31485":75585,"_5":31809,"_21804":127992,"_28646":127993,"_3122":127994},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3731":75588,"_31485":75585,"_5":31809,"_21804":127996,"_28646":127997,"_3122":127998},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3731":75589,"_31485":75585,"_5":31809,"_21804":128000,"_28646":128001,"_3122":128002},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3731":75590,"_31485":75585,"_5":31809,"_21804":128004,"_28646":128005,"_3122":128006},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3731":75591,"_31485":75585,"_5":31809,"_21804":128008,"_28646":128009,"_3122":128010},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3731":75592,"_31485":75585,"_5":31809,"_21804":128012,"_28646":128013,"_3122":128014},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3731":75593,"_31485":75585,"_5":31809,"_21804":128016,"_28646":128017,"_3122":125683},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3731":75594,"_31485":75585,"_5":31809,"_21804":128019,"_28646":128020,"_3122":128021},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3731":75595,"_31485":75585,"_5":31809,"_21804":128023,"_28646":128024,"_3122":128025},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3731":75596,"_31485":75585,"_5":31809,"_21804":128027,"_28646":128028,"_3122":128029},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3731":75597,"_31485":75585,"_21804":128031,"_5":15036,"_28646":75585,"_3122":128032},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3731":75598,"_31485":75585,"_21804":128034,"_5":15036,"_28646":127997,"_3122":128035},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3731":75599,"_31485":75585,"_21804":128037,"_5":15036,"_28646":128001,"_3122":128038},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3731":75600,"_31485":75585,"_21804":128040,"_5":15036,"_28646":128005,"_3122":128041},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3731":75601,"_31485":75585,"_21804":128043,"_5":15036,"_28646":128009,"_3122":128044},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3731":75602,"_31485":75585,"_21804":128046,"_5":15036,"_28646":128013,"_3122":128047},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3731":75603,"_31485":75585,"_21804":128049,"_5":15036,"_28646":128017,"_3122":128050},[],"Lamassu persiste cuatro estados X.509:",{"_3731":75604,"_31485":75585,"_21804":128052,"_5":15036,"_28646":128017,"_3122":128053},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3731":75605,"_31485":75585,"_21804":128055,"_5":15036,"_28646":128017,"_3122":128056},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3731":75606,"_31485":75585,"_21804":128058,"_5":15036,"_28646":128017,"_3122":128059},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3731":75607,"_31485":75585,"_21804":128061,"_5":15036,"_28646":128017,"_3122":128062},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3731":75608,"_31485":75585,"_21804":128064,"_5":15036,"_28646":128017,"_3122":128065},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3731":75609,"_31485":75585,"_21804":128067,"_5":15036,"_28646":128020,"_3122":128068},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3731":75610,"_31485":75585,"_21804":128070,"_5":15036,"_28646":128020,"_3122":128071},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3731":75611,"_31485":75585,"_21804":128073,"_5":15036,"_28646":128020,"_3122":128074},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3731":75612,"_31485":75585,"_21804":128076,"_5":15036,"_28646":128024,"_3122":128077},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes. Una cascada con `CertificateHold` los suspende de forma reversible: al reactivar la CA se restauran los que sigan suspendidos. Cualquier otra razón de revocación revoca los descendientes definitivamente con `CessationOfOperation`. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3731":75613,"_31485":75585,"_21804":128079,"_5":15036,"_28646":128024,"_3122":128080},[],"Antes de confirmar:",{"_3731":75614,"_31485":75585,"_21804":128082,"_5":15036,"_28646":128024,"_3122":128083},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3731":75615,"_31485":75585,"_21804":128085,"_5":15036,"_28646":128024,"_3122":128086},[],"Distribuye la nueva cadena de confianza.",{"_3731":75616,"_31485":75585,"_21804":128088,"_5":15036,"_28646":128024,"_3122":128089},[],"Reemite las identidades necesarias.",{"_3731":75617,"_31485":75585,"_21804":128091,"_5":15036,"_28646":128024,"_3122":128092},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3731":75618,"_31485":75585,"_21804":128094,"_5":15036,"_28646":128024,"_3122":128095},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3731":75619,"_31485":75585,"_21804":128097,"_5":15036,"_28646":128024,"_3122":128098},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3731":75620,"_31485":75585,"_21804":128100,"_5":15036,"_28646":128028,"_3122":128101},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3731":75621,"_31485":75585,"_21804":128103,"_5":15036,"_28646":128028,"_3122":128104},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3731":75622,"_31485":75585,"_21804":128106,"_5":15036,"_28646":128028,"_3122":128107},[],"Cambios de estado y razones de revocación.",{"_3731":75623,"_31485":75585,"_21804":128109,"_5":15036,"_28646":128028,"_3122":128110},[],"Publicación y vigencia de OCSP y CRLs.",{"_3731":75624,"_31485":75585,"_21804":128112,"_5":15036,"_28646":128028,"_3122":128113},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3731":75625,"_31485":75585,"_21804":128115,"_5":15036,"_28646":128028,"_3122":128116},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3731":75626,"_31485":75626,"_5":15390,"_3122":128118,"_31812":128119,"_21804":128120,"_28646":75626},"Modelo de confianza",[51373,123005,57109,127986],[],{"_3731":75627,"_31485":75626,"_21804":128122,"_5":15036,"_28646":75626,"_3122":128123},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3731":75628,"_31485":75626,"_5":31809,"_21804":128125,"_28646":128126,"_3122":128127},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3731":75629,"_31485":75626,"_5":31809,"_21804":128129,"_28646":128130,"_3122":128131},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3731":75630,"_31485":75626,"_5":31809,"_21804":128133,"_28646":128134,"_3122":128135},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3731":75631,"_31485":75626,"_5":31809,"_21804":128137,"_28646":128138,"_3122":128139},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3731":75632,"_31485":75626,"_5":31809,"_21804":128141,"_28646":128142,"_3122":128143},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3731":75633,"_31485":75626,"_5":31809,"_21804":128145,"_28646":128146,"_3122":128147},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3731":75634,"_31485":75626,"_5":31809,"_21804":128149,"_28646":128150,"_3122":128151},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3731":75635,"_31485":75626,"_5":31809,"_21804":128153,"_28646":128154,"_3122":128155},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3731":75636,"_31485":75626,"_5":31809,"_21804":128157,"_28646":128158,"_3122":128159},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3731":75637,"_31485":75626,"_5":31809,"_21804":128161,"_28646":128162,"_3122":128163},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3731":75638,"_31485":75626,"_21804":128165,"_5":15036,"_28646":75626,"_3122":128166},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3731":75639,"_31485":75626,"_21804":128168,"_5":15036,"_28646":128130,"_3122":128169},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3731":75640,"_31485":75626,"_21804":128171,"_5":15036,"_28646":128134,"_3122":128172},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3731":75641,"_31485":75626,"_21804":128174,"_5":15036,"_28646":128138,"_3122":128175},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3731":75642,"_31485":75626,"_21804":128177,"_5":15036,"_28646":128142,"_3122":128178},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3731":75643,"_31485":75626,"_21804":128180,"_5":15036,"_28646":128146,"_3122":128181},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3731":75644,"_31485":75626,"_21804":128183,"_5":15036,"_28646":128146,"_3122":128184},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3731":75645,"_31485":75626,"_21804":128186,"_5":15036,"_28646":128146,"_3122":128187},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3731":75646,"_31485":75626,"_21804":128189,"_5":15036,"_28646":128146,"_3122":128190},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3731":75647,"_31485":75626,"_21804":128192,"_5":15036,"_28646":128146,"_3122":128193},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3731":75648,"_31485":75626,"_21804":128195,"_5":15036,"_28646":128146,"_3122":128196},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3731":75649,"_31485":75626,"_21804":128198,"_5":15036,"_28646":128150,"_3122":128199},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3731":75650,"_31485":75626,"_21804":128201,"_5":15036,"_28646":128150,"_3122":128202},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3731":75651,"_31485":75626,"_21804":128204,"_5":15036,"_28646":128150,"_3122":128205},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3731":75652,"_31485":75626,"_21804":128207,"_5":15036,"_28646":128150,"_3122":128208},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3731":75653,"_31485":75626,"_21804":128210,"_5":15036,"_28646":128150,"_3122":128211},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3731":75654,"_31485":75626,"_21804":128213,"_5":15036,"_28646":128154,"_3122":128214},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3731":75655,"_31485":75626,"_21804":128216,"_5":15036,"_28646":128154,"_3122":128217},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3731":75656,"_31485":75626,"_21804":128219,"_5":15036,"_28646":128154,"_3122":128220},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3731":75657,"_31485":75626,"_21804":128222,"_5":15036,"_28646":128154,"_3122":128223},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3731":75658,"_31485":75626,"_21804":128225,"_5":15036,"_28646":128154,"_3122":128226},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3731":75659,"_31485":75626,"_21804":128228,"_5":15036,"_28646":128154,"_3122":128229},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3731":75660,"_31485":75626,"_21804":128231,"_5":15036,"_28646":128154,"_3122":128232},[],"Durante la autenticación mTLS de un DMS, Lamassu comprueba la revocación y falla cerrada: un certificado cuya revocación no puede verificarse se rechaza por defecto. La opción `allow_unverifiable_revocation` del DMS (consulta DMS) es la excepción, y solo relaja los certificados que no llevan ningún endpoint OCSP/CRL. Diseña los perfiles y puntos de distribución para que la comprobación tenga éxito.",{"_3731":75661,"_31485":75626,"_21804":128234,"_5":15036,"_28646":128158,"_3122":128235},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3731":75662,"_31485":75626,"_21804":128237,"_5":15036,"_28646":128162,"_3122":128238},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3731":75663,"_31485":75626,"_21804":128240,"_5":15036,"_28646":128162,"_3122":128241},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3731":75664,"_31485":75626,"_21804":128243,"_5":15036,"_28646":128162,"_3122":128244},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3731":75665,"_31485":75626,"_21804":128246,"_5":15036,"_28646":128162,"_3122":128247},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3731":75666,"_31485":75626,"_21804":128249,"_5":15036,"_28646":128162,"_3122":128250},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3731":75667,"_31485":75626,"_21804":128252,"_5":15036,"_28646":128162,"_3122":128253},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3731":75668,"_31485":75626,"_21804":128255,"_5":15036,"_28646":128162,"_3122":128256},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3731":75669,"_31485":75669,"_5":15390,"_3122":128258,"_31812":128259,"_21804":128260,"_28646":75669},"Listas de revocación (CRL)",[51373,123005,57109,127732],[],{"_3731":75670,"_31485":75669,"_21804":128262,"_5":15036,"_28646":75669,"_3122":128263},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3731":75671,"_31485":75669,"_5":31809,"_21804":128265,"_28646":128266,"_3122":128267},[],"/docs/es/platform/pki/crl#ajustes-de-crl","Ajustes de CRL",{"_3731":75672,"_31485":75669,"_5":31809,"_21804":128269,"_28646":128270,"_3122":128271},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3731":75673,"_31485":75669,"_5":31809,"_21804":128273,"_28646":128274,"_3122":128275},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3731":75674,"_31485":75669,"_5":31809,"_21804":128277,"_28646":128278,"_3122":128279},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3731":75675,"_31485":75669,"_5":31809,"_21804":128281,"_28646":128282,"_3122":128283},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3731":75676,"_31485":75669,"_5":31809,"_21804":128285,"_28646":128286,"_3122":128287},[],"/docs/es/platform/pki/crl#api-de-gestión-de-los-ajustes-de-crl","API de gestión de los ajustes de CRL",{"_3731":75677,"_31485":75669,"_5":31809,"_21804":128289,"_28646":128290,"_3122":128291},[],"/docs/es/platform/pki/crl#errores-frecuentes-de-los-ajustes-de-crl","Errores frecuentes de los ajustes de CRL",{"_3731":75678,"_31485":75669,"_5":31809,"_21804":128293,"_28646":128294,"_3122":128295},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3731":75679,"_31485":75669,"_21804":128297,"_5":15036,"_28646":75669,"_3122":128298},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su ID de CA y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3731":75680,"_31485":75669,"_21804":128300,"_5":15036,"_28646":128266,"_3122":128301},[],"Los ajustes de CRL de una CA guardan la configuración y los metadatos de su última lista publicada. Cada CA tiene los suyos, indexados por su ID de CA — incluso cuando dos CAs comparten clave: comparten el SKI, no la CRL. La VA los crea al crear una CA; al importar una CA cuya clave está en el KMS — importada con la clave privada, o que el KMS ya tenía — y cuyo certificado incluye `cRLSign`: esa CA publica su primera CRL de inmediato, igual que una creada; y al reemitir una CA sin ajustes con un certificado que pueda firmar CRLs. Una CA importada cuya clave no está en el KMS, o cuyo certificado carece de `cRLSign`, no recibe ajustes: la importación termina sin error, y los endpoints de CRL de la CA informan de que faltan los ajustes. Los ajustes nunca se crean retroactivamente: una CA que no los tiene se queda sin ellos hasta que se reemita. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3731":75681,"_31485":75669,"_21804":128303,"_5":15036,"_28646":128266,"_3122":128304},[],"Campo",{"_3731":75682,"_31485":75669,"_21804":128306,"_5":15036,"_28646":128266,"_3122":125346},[],{"_3731":75683,"_31485":75669,"_21804":128308,"_5":15036,"_28646":128266,"_3122":53031},[],{"_3731":75684,"_31485":75669,"_21804":128310,"_5":15036,"_28646":128266,"_3122":128311},[],"ID de la CA a la que pertenecen los ajustes.",{"_3731":75685,"_31485":75669,"_21804":128313,"_5":15036,"_28646":128266,"_3122":58366},[],{"_3731":75686,"_31485":75669,"_21804":128315,"_5":15036,"_28646":128266,"_3122":128316},[],"Ciclo de vida de los ajustes. Los `ACTIVE` generan CRLs. Los `FINAL` pertenecen a una CA revocada de forma permanente o caducada: la primera publica una CRL final, válida hasta que expire el certificado actual de la CA, y la segunda pasa a `FINAL` sin CRL final. Los `ARCHIVED` pertenecen a una CA eliminada: su última CRL sigue sirviéndose, pero nunca se regenera.",{"_3731":75687,"_31485":75669,"_21804":128318,"_5":15036,"_28646":128266,"_3122":58372},[],{"_3731":75688,"_31485":75669,"_21804":128320,"_5":15036,"_28646":128266,"_3122":128321},[],"Solo lectura. SKI por el que los ajustes estaban indexados antes de la migración de 4.0.0; solo lo tienen los migrados, y `/crl/<ski>` sigue resolviendo a ellos.",{"_3731":75689,"_31485":75669,"_21804":128323,"_5":15036,"_28646":128266,"_3122":58378},[],{"_3731":75690,"_31485":75669,"_21804":128325,"_5":15036,"_28646":128266,"_3122":128326},[],"Versión, inicio y fin de validez de la última lista publicada. Solo lectura.",{"_3731":75691,"_31485":75669,"_21804":128328,"_5":15036,"_28646":128266,"_3122":128329},[],"Campo de `crl_options`",{"_3731":75692,"_31485":75669,"_21804":128331,"_5":15036,"_28646":128266,"_3122":125346},[],{"_3731":75693,"_31485":75669,"_21804":128333,"_5":15036,"_28646":128266,"_3122":128334},[],"Valor inicial",{"_3731":75694,"_31485":75669,"_21804":128336,"_5":15036,"_28646":128266,"_3122":58392},[],{"_3731":75695,"_31485":75669,"_21804":128338,"_5":15036,"_28646":128266,"_3122":128339},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3731":75696,"_31485":75669,"_21804":128341,"_5":15036,"_28646":128266,"_3122":128342},[],"7 días.",{"_3731":75697,"_31485":75669,"_21804":128344,"_5":15036,"_28646":128266,"_3122":58401},[],{"_3731":75698,"_31485":75669,"_21804":128346,"_5":15036,"_28646":128266,"_3122":128347},[],"Tiempo desde la emisión de la última CRL publicada que activa la renovación programada; `0` desactiva solo este disparador. La granularidad efectiva está limitada por la frecuencia del job (consulta Regeneración periódica y automática).",{"_3731":75699,"_31485":75669,"_21804":128349,"_5":15036,"_28646":128266,"_3122":128350},[],"6 días y 23 horas.",{"_3731":75700,"_31485":75669,"_21804":128352,"_5":15036,"_28646":128266,"_3122":58410},[],{"_3731":75701,"_31485":75669,"_21804":128354,"_5":15036,"_28646":128266,"_3122":128355},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3731":75702,"_31485":75669,"_21804":128357,"_5":15036,"_28646":128266,"_3122":58416},[],{"_3731":75703,"_31485":75669,"_21804":128359,"_5":15036,"_28646":128266,"_3122":58419},[],{"_3731":75704,"_31485":75669,"_21804":128361,"_5":15036,"_28646":128266,"_3122":128362},[],"Número de serie del certificado existente que firma la CRL.",{"_3731":75705,"_31485":75669,"_21804":128364,"_5":15036,"_28646":128266,"_3122":128365},[],"Número de serie del certificado actual de la CA.",{"_3731":75706,"_31485":75669,"_21804":128367,"_5":15036,"_28646":128266,"_3122":128368},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3731":75707,"_31485":75669,"_21804":128370,"_5":15036,"_28646":128266,"_3122":128371},[],"Al reemitir una CA, si el firmante es el certificado de la CA sustituido, la VA lo mueve al certificado nuevo — siempre que incluya `cRLSign` — y republica la CRL. Si el certificado nuevo carece de `cRLSign`, la VA mantiene el firmante anterior y registra un aviso. Si el firmante es cualquier otro certificado con el sujeto y la clave de la CA, se deja deliberadamente sin cambios; en ese caso el certificado anterior no puede eliminarse mientras los ajustes lo usen (la API devuelve `409` `certificate is in use`), y para retirarlo actualizas el firmante con `PUT`.",{"_3731":75708,"_31485":75669,"_21804":128373,"_5":15036,"_28646":128266,"_3122":128374},[],"Las decisiones del ciclo de vida de la CRL — cuándo deja de publicarse y cuándo expira la CRL final — usan únicamente el certificado actual de la CA. Si un certificado reemitido expira antes que un certificado antiguo que sigue vigente, la publicación de CRLs puede detenerse, o la CRL final puede expirar, mientras el certificado antiguo siga vigente. Es una limitación aceptada del comportamiento actual.",{"_3731":75709,"_31485":75669,"_21804":128376,"_5":15036,"_28646":128266,"_3122":128377},[],"Una CA cuyo firmante no tiene `cRLSign` no puede generar su CRL, y una actualización que seleccione un firmante sin `cRLSign` se rechaza (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y actualiza los ajustes para usarlo como firmante. Una CA que no tiene ajustes — por ejemplo, una importada sin `cRLSign` — no tiene nada que actualizar: la única vía para obtenerlos es reemitir la CA con un certificado que incluya `cRLSign`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original, y sin `cRLSign` los ajustes conservan su firmante anterior.",{"_3731":75710,"_31485":75669,"_21804":128379,"_5":15036,"_28646":128266,"_3122":128380},[],"Eliminar una CA conserva sus ajustes de CRL; permanecen hasta que borres los archivados por API o desde la página Verification Authorities de la consola (consulta API de gestión de los ajustes de CRL). Lo que ocurre con ellos depende de cómo terminó la CA:",{"_3731":75711,"_31485":75669,"_21804":128382,"_5":15036,"_28646":128266,"_3122":128383},[],"La migración de la actualización a 4.0.0 archiva los ajustes de las CAs que se habían eliminado antes de la actualización. Su `status` es `ARCHIVED` y su `ca_id` es `legacy-<ski>`: la última CRL sigue sirviéndose, pero nunca se regenera, cualquier `PUT` devuelve 409 y no hay forma de volver a `ACTIVE` por API.",{"_3731":75712,"_31485":75669,"_21804":128385,"_5":15036,"_28646":128266,"_3122":128386},[],"Revocar una CA de forma permanente o dejar que caduque finaliza sus ajustes: su `status` pasa a `FINAL`, cualquier `PUT` devuelve 409 y no se genera ninguna CRL nueva. Una CA revocada permanentemente publica una CRL final, válida hasta que expire el certificado actual de la CA; una CA caducada no recibe ninguna. Eliminar después la CA archiva sus ajustes, que pasan a comportarse como los archivados de la migración.",{"_3731":75713,"_31485":75669,"_21804":128388,"_5":15036,"_28646":128266,"_3122":128389},[],"Los ajustes dejan de poder editarse mientras su `status` no sea `ACTIVE`. Ajusta validez y firmante antes de revocar o eliminar una CA.",{"_3731":75714,"_31485":75669,"_21804":128391,"_5":15036,"_28646":128266,"_3122":128392},[],"El `PUT` valida el firmante solo cuando la petición lo cambia. Si el firmante guardado ya no es válido, las demás opciones siguen editándose, pero la CRL no puede regenerarse hasta asignar uno válido.",{"_3731":75715,"_31485":75669,"_21804":128394,"_5":15036,"_28646":128266,"_3122":128395},[],"Compartir una clave entre CAs bloquea la migración: la actualización a 4.0.0 aborta mientras un SKI pertenezca a más de una CA. Consulta CAs que comparten clave.",{"_3731":75716,"_31485":75669,"_21804":128397,"_5":15036,"_28646":128266,"_3122":128398},[],"Las versiones de las CRLs se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/<ca-id>/<version>.crl`; el endpoint público entrega DER. Las CRLs publicadas antes de la actualización a 4.0.0 permanecen bajo `pki/va/crl/<ski>/<version>.crl` y siguen sirviéndose.",{"_3731":75717,"_31485":75669,"_21804":128400,"_5":15036,"_28646":128270,"_3122":128401},[],"Desde 4.0.0, cada CA publica su propia CRL aunque comparta clave: dos CAs con la misma clave tienen el mismo SKI, pero cada una tiene sus propios ajustes de CRL y su propia lista, firmada por un certificado con la identidad de esa CA.",{"_3731":75718,"_31485":75669,"_21804":128403,"_5":15036,"_28646":128270,"_3122":128404},[],"Los certificados emitidos a partir de ahora llevan puntos de distribución `/crl/<ca-id>`, así que los certificados de cada CA resuelven a su propia lista. Los certificados emitidos antes de la actualización conservan sus puntos de distribución `/crl/<ski>`: esa URL sigue resolviendo a los ajustes que migró la actualización y sirve siempre la lista de la CA propietaria de ese SKI cuando se ejecutó la actualización. Nunca se reasigna a una CA creada después con la misma clave. Tras la regeneración, la lista migrada incluye ambas URLs en su *Issuing Distribution Point* (OID `2.5.29.28`), de modo que un verificador que compara el IDP con el CDP del certificado acepta cualquiera de las dos formas. Hasta que el job de CRL de la VA la regenere correctamente, la lista anterior a la actualización solo contiene el IDP heredado `/crl/<ski>`; los verificadores que comprueban el IDP no pueden validar los certificados recién emitidos con CDP `/crl/<ca-id>`. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora y los fallos pueden prolongar ese intervalo.",{"_3731":75719,"_31485":75669,"_21804":128406,"_5":15036,"_28646":128270,"_3122":128407},[],"Compartir un SKI entre CAs bloquea la actualización: la migración aborta y nombra los SKIs. Para detectar el problema antes de actualizar, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos.",{"_3731":75720,"_31485":75669,"_21804":128409,"_5":15036,"_28646":128270,"_3122":128410},[],"Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. Hasta que Lamassu rechace las importaciones cuyo SKI colisione con el de una CA existente — rechazo propuesto en lamassuiot#834, junto con la CRL por CA que 4.0.0 implementa —, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión de SKI, así que evita reutilizar claves entre CAs.",{"_3731":75721,"_31485":75669,"_21804":128412,"_5":15036,"_28646":128274,"_3122":128413},[],"El job de la VA revisa los ajustes de CRL de todas las CA en cada ejecución y solicita una lista nueva cuando se cumple alguna de estas condiciones:",{"_3731":75722,"_31485":75669,"_21804":128415,"_5":15036,"_28646":128274,"_3122":128416},[],"**La lista está a punto de vencer:** a `latest_crl` le queda menos validez que el intervalo entre ejecuciones del trabajo. Esta condición se aplica siempre y no puede desactivarse.",{"_3731":75723,"_31485":75669,"_21804":128418,"_5":15036,"_28646":128274,"_3122":128419},[],"**Ha transcurrido el intervalo de renovación:** el tiempo desde la emisión de la última CRL publicada alcanza `refresh_interval`. Con `refresh_interval` a `0` se desactiva solo esta condición; la lista se sigue regenerando cuando está a punto de vencer.",{"_3731":75724,"_31485":75669,"_21804":128421,"_5":15036,"_28646":128274,"_3122":128422},[],"Poner `refresh_interval` a `0` no congela, por tanto, la regeneración. Con la validez por defecto de 7 días y un trabajo cada hora, la CRL se renueva hasta una hora antes de vencer aunque `refresh_interval` sea `0`. Como el trabajo se ejecuta según su propia planificación, el `refresh_interval` se respeta solo con la precisión que permita la frecuencia del job.",{"_3731":75725,"_31485":75669,"_21804":128424,"_5":15036,"_28646":128274,"_3122":128425},[],"La frecuencia del trabajo se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. Mantén `validity` claramente por encima de ese intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3731":75726,"_31485":75669,"_21804":128427,"_5":15036,"_28646":128274,"_3122":128428},[],"Si la generación falla (por ejemplo, porque no puede resolver la CA o el firmante es inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ca-id>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3731":75727,"_31485":75669,"_21804":128430,"_5":15036,"_28646":128274,"_3122":128431},[],"Los ajustes con `status` distinto de `ACTIVE` — `FINAL` o `ARCHIVED` — se omiten: nada regenera su CRL.",{"_3731":75728,"_31485":75669,"_21804":128433,"_5":15036,"_28646":128274,"_3122":128434},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla la generación (por ejemplo, por un firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Si la CA emisora no tiene ajustes de CRL, no hay CRL que regenerar: el evento se da por atendido sin reintento, la VA registra un aviso y no aparece nada en la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3731":75729,"_31485":75669,"_21804":128436,"_5":15036,"_28646":128274,"_3122":128437},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3731":75730,"_31485":75669,"_21804":128439,"_5":15036,"_28646":128278,"_3122":128440},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3731":75731,"_31485":75669,"_21804":128442,"_5":15036,"_28646":128278,"_3122":128443},[],"Cuando la VA tiene dominios configurados, la lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con esas URLs de distribución; una VA sin dominios configurados publica la lista sin IDP, y una CRL sin IDP cubre todos los certificados de su CA. Cuando la extensión está presente, comprueba que tu cliente la interpreta y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3731":75732,"_31485":75669,"_21804":128445,"_5":15036,"_28646":128282,"_3122":128446},[],"El servicio VA expone `GET /crl/{id}` sin autorización de gestión. Usa el **ID de la CA emisora**, no el ID ni el número de serie del certificado final. Los certificados emitidos antes de la actualización a 4.0.0 llevan URLs `/crl/<ski>` con el SKI de la clave de la CA; esa forma sigue resolviendo. Inspecciona primero el CDP del certificado:",{"_3731":75733,"_31485":75669,"_21804":128448,"_5":15036,"_28646":128282,"_3122":128449},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3731":75734,"_31485":75669,"_21804":128451,"_5":15036,"_28646":128282,"_3122":128452},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Un certificado firmante aceptado tiene el mismo sujeto y la misma clave pública que la CA, por lo que esta comprobación de firma también funciona cuando los ajustes apuntan a un certificado anterior de esa CA y clave. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3731":75735,"_31485":75669,"_21804":128454,"_5":15036,"_28646":128282,"_3122":128455},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3731":75736,"_31485":75669,"_21804":128457,"_5":15036,"_28646":128282,"_3122":128458},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3731":75737,"_31485":75669,"_21804":128460,"_5":15036,"_28646":128286,"_3122":128461},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3731":75738,"_31485":75669,"_21804":128463,"_5":15036,"_28646":128286,"_3122":124755},[],{"_3731":75739,"_31485":75669,"_21804":128465,"_5":15036,"_28646":128286,"_3122":128466},[],"Path relativo",{"_3731":75740,"_31485":75669,"_21804":128468,"_5":15036,"_28646":128286,"_3122":122765},[],{"_3731":75741,"_31485":75669,"_21804":128470,"_5":15036,"_28646":128286,"_3122":58531},[],{"_3731":75742,"_31485":75669,"_21804":128472,"_5":15036,"_28646":128286,"_3122":58534},[],{"_3731":75743,"_31485":75669,"_21804":128474,"_5":15036,"_28646":128286,"_3122":128475},[],"Listar los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3731":75744,"_31485":75669,"_21804":128477,"_5":15036,"_28646":128286,"_3122":58531},[],{"_3731":75745,"_31485":75669,"_21804":128479,"_5":15036,"_28646":128286,"_3122":58542},[],{"_3731":75746,"_31485":75669,"_21804":128481,"_5":15036,"_28646":128286,"_3122":128482},[],"Consultar los `crl_options` y `latest_crl` de una CA.",{"_3731":75747,"_31485":75669,"_21804":128484,"_5":15036,"_28646":128286,"_3122":58548},[],{"_3731":75748,"_31485":75669,"_21804":128486,"_5":15036,"_28646":128286,"_3122":58542},[],{"_3731":75749,"_31485":75669,"_21804":128488,"_5":15036,"_28646":128286,"_3122":128489},[],"Sustituir la configuración de CRL de una CA.",{"_3731":75750,"_31485":75669,"_21804":128491,"_5":15036,"_28646":128286,"_3122":58556},[],{"_3731":75751,"_31485":75669,"_21804":128493,"_5":15036,"_28646":128286,"_3122":58542},[],{"_3731":75752,"_31485":75669,"_21804":128495,"_5":15036,"_28646":128286,"_3122":128496},[],"Eliminar los ajustes de CRL archivados de una CA.",{"_3731":75753,"_31485":75669,"_21804":128498,"_5":15036,"_28646":128286,"_3122":128499},[],"Necesitas autenticación y permisos de lectura, actualización o borrado de los ajustes de CRL. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato — `refresh_interval`, `validity`, `signer_serial_number` y `regenerate_on_revoke`: el backend sustituye los cuatro; no fusiona campos omitidos. `status`, `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` devuelve 409 cuando los ajustes no están `ACTIVE`, valida el firmante solo cuando cambia y no regenera la CRL.",{"_3731":75754,"_31485":75669,"_21804":128501,"_5":15036,"_28646":128286,"_3122":128502},[],"Los ajustes archivados, cuya CA ya no existe, pueden eliminarse con `DELETE`: la llamada devuelve 204 en caso de éxito, 404 cuando la CA no tiene ajustes y 409 mientras los ajustes no estén todavía archivados. Tras el borrado, el endpoint público `/crl/{id}` y cualquier endpoint heredado `/crl/<ski>` dejan de servir la lista de la CA, aunque los ficheros de CRL publicados permanecen en el bucket. Conserva los ajustes archivados mientras cualquier certificado emitido por la CA pueda necesitar evidencia de revocación: `DELETE` deja de servir la lista inmediatamente, independientemente de la validez de `latest_crl`. La acción no puede deshacerse.",{"_3731":75755,"_31485":75669,"_21804":128504,"_5":15036,"_28646":128286,"_3122":128505},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar los ajustes no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3731":75756,"_31485":75669,"_21804":128507,"_5":15036,"_28646":128290,"_3122":128508},[],"Síntoma",{"_3731":75757,"_31485":75669,"_21804":128510,"_5":15036,"_28646":128290,"_3122":128511},[],"Causa",{"_3731":75758,"_31485":75669,"_21804":128513,"_5":15036,"_28646":128290,"_3122":128514},[],"Acción",{"_3731":75759,"_31485":75669,"_21804":128516,"_5":15036,"_28646":128290,"_3122":128517},[],"`PUT /v1/crl-settings/{ca-id}` devuelve 409.",{"_3731":75760,"_31485":75669,"_21804":128519,"_5":15036,"_28646":128290,"_3122":128520},[],"Los ajustes no están `ACTIVE`: revocar la CA de forma permanente o dejar que caduque los finalizó, o la migración los archivó porque su CA se eliminó antes de la actualización.",{"_3731":75761,"_31485":75669,"_21804":128522,"_5":15036,"_28646":128290,"_3122":128523},[],"No hay vuelta a `ACTIVE` por API. La última CRL sigue sirviéndose.",{"_3731":75762,"_31485":75669,"_21804":128525,"_5":15036,"_28646":128290,"_3122":128526},[],"`DELETE /v1/crl-settings/{ca-id}` devuelve 409.",{"_3731":75763,"_31485":75669,"_21804":128528,"_5":15036,"_28646":128290,"_3122":128529},[],"Los ajustes no están todavía `ARCHIVED`: la CA no se ha eliminado.",{"_3731":75764,"_31485":75669,"_21804":128531,"_5":15036,"_28646":128290,"_3122":128532},[],"Elimina primero la CA; su eliminación archiva los ajustes.",{"_3731":75765,"_31485":75669,"_21804":128534,"_5":15036,"_28646":128290,"_3122":128535},[],"`PUT` devuelve 400.",{"_3731":75766,"_31485":75669,"_21804":128537,"_5":15036,"_28646":128290,"_3122":128538},[],"El firmante nuevo no tiene `cRLSign`, o su sujeto y su clave pública no coinciden con los de la CA.",{"_3731":75767,"_31485":75669,"_21804":128540,"_5":15036,"_28646":128290,"_3122":128541},[],"Asigna el número de serie de un certificado válido de esa CA.",{"_3731":75768,"_31485":75669,"_21804":128543,"_5":15036,"_28646":128290,"_3122":128544},[],"`PUT` devuelve 404.",{"_3731":75769,"_31485":75669,"_21804":128546,"_5":15036,"_28646":128290,"_3122":128547},[],"La CA o el certificado firmante nuevo no existen, o la CA no tiene ajustes de CRL, por ejemplo porque se importó sin su clave o su certificado carece de `cRLSign`.",{"_3731":75770,"_31485":75669,"_21804":128549,"_5":15036,"_28646":128290,"_3122":128550},[],"Revisa el ID de CA y el número de serie del firmante.",{"_3731":75771,"_31485":75669,"_21804":128552,"_5":15036,"_28646":128290,"_3122":128553},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3731":75772,"_31485":75669,"_21804":128555,"_5":15036,"_28646":128290,"_3122":128556},[],"`crl_options.subject_key_id_signer` se sustituyó por `crl_options.signer_serial_number`, que es obligatorio.",{"_3731":75773,"_31485":75669,"_21804":128558,"_5":15036,"_28646":128290,"_3122":128559},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3731":75774,"_31485":75669,"_21804":128561,"_5":15036,"_28646":128290,"_3122":128562},[],"La CRL no cambia tras revocar un certificado.",{"_3731":75775,"_31485":75669,"_21804":128564,"_5":15036,"_28646":128290,"_3122":128565},[],"`regenerate_on_revoke` es `false`, la CA emisora no tiene ajustes de CRL, o la generación falló por un firmante inválido.",{"_3731":75776,"_31485":75669,"_21804":128567,"_5":15036,"_28646":128290,"_3122":128568},[],"Revisa los logs de la VA. La falta de ajustes solo genera un aviso (sin reintento ni entrada en la cola de eventos fallidos); un firmante inválido además deja el evento en la cola de eventos fallidos, así que corrige el firmante.",{"_3731":75777,"_31485":75669,"_21804":128570,"_5":15036,"_28646":128290,"_3122":128571},[],"Un verificador rechaza la CRL por el emisor.",{"_3731":75778,"_31485":75669,"_21804":128573,"_5":15036,"_28646":128290,"_3122":128574},[],"La lista se descargó por una URL heredada `/crl/<ski>` y pertenece a la CA propietaria de ese SKI cuando se ejecutó la actualización.",{"_3731":75779,"_31485":75669,"_21804":128576,"_5":15036,"_28646":128290,"_3122":128577},[],"Usa el CDP del certificado que validas: los certificados emitidos en 4.0.0 llevan URLs `/crl/<ca-id>`.",{"_3731":75780,"_31485":75669,"_21804":128579,"_5":15036,"_28646":128294,"_3122":128580},[],"RFC 5280: perfil X.509 y CRL.",{"_3731":75781,"_31485":75669,"_21804":128582,"_5":15036,"_28646":128294,"_3122":58648},[],{"_3731":75782,"_31485":75669,"_21804":128584,"_5":15036,"_28646":128294,"_3122":58651},[],{"_3731":75783,"_31485":75669,"_21804":128586,"_5":15036,"_28646":128294,"_3122":128587},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3731":75784,"_31485":75669,"_21804":128589,"_5":15036,"_28646":128294,"_3122":128590},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3731":75785,"_31485":75785,"_5":15390,"_3122":128592,"_31812":128593,"_21804":128594,"_28646":75785},"Protocolos de enrolamiento",[51373,123005,57109,127061],[],{"_3731":75786,"_31485":75785,"_21804":128596,"_5":15036,"_28646":75785,"_3122":128597},[],"Solicita y renueva certificados de una CA de Lamassu.",{"_3731":75787,"_31485":75785,"_21804":128599,"_5":15036,"_28646":75785,"_3122":128600},[],"Lamassu admite EST (Enrollment over Secure Transport), definido en el RFC 7030. El DMS aplica la política de enrolamiento y la CA configurada emite los certificados.",{"_3731":75788,"_31485":75785,"_21804":128602,"_5":15036,"_28646":75785,"_3122":128603},[],"Endpoint principal",{"_3731":75789,"_31485":75785,"_21804":128605,"_5":15036,"_28646":75785,"_3122":128606},[],"Para qué sirve",{"_3731":75790,"_31485":75785,"_21804":128608,"_5":15036,"_28646":75785,"_3122":58675},[],{"_3731":75791,"_31485":75785,"_21804":128610,"_5":15036,"_28646":75785,"_3122":128611},[],"Obtiene los certificados de CA publicados por el DMS.",{"_3731":75792,"_31485":75785,"_21804":128613,"_5":15036,"_28646":75785,"_3122":58681},[],{"_3731":75793,"_31485":75785,"_21804":128615,"_5":15036,"_28646":75785,"_3122":128616},[],"Solicita un certificado inicial mediante una CSR.",{"_3731":75794,"_31485":75785,"_21804":128618,"_5":15036,"_28646":75785,"_3122":58686},[],{"_3731":75795,"_31485":75785,"_21804":128620,"_5":15036,"_28646":75785,"_3122":128621},[],"Solicita un certificado sucesor para una identidad existente.",{"_3731":75796,"_31485":75785,"_21804":128623,"_5":15036,"_28646":75785,"_3122":128624},[],"Consulta EST (RFC 7030) para configurar el cliente, preparar la autenticación, consultar los formatos y usar la generación opcional de claves en el servidor.",{"_3731":75797,"_31485":75797,"_5":15390,"_3122":128626,"_31812":128627,"_21804":128628,"_28646":75797},"Claves y motores criptográficos",[51373,123005,57109,127061],[],{"_3731":75798,"_31485":75797,"_21804":128630,"_5":15036,"_28646":75797,"_3122":128631},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3731":75799,"_31485":75797,"_5":31809,"_21804":128633,"_28646":128634,"_3122":128635},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3731":75800,"_31485":75797,"_5":31809,"_21804":128637,"_28646":128638,"_3122":128639},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3731":75801,"_31485":75797,"_5":31809,"_21804":128641,"_28646":128642,"_3122":58711},[],"/docs/es/platform/pki/key-management#file-system",{"_3731":75802,"_31485":75797,"_5":31809,"_21804":128644,"_28646":128645,"_3122":58715},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3731":75803,"_31485":75797,"_5":31809,"_21804":128647,"_28646":128648,"_3122":58719},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3731":75804,"_31485":75797,"_5":31809,"_21804":128650,"_28646":128651,"_3122":58723},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3731":75805,"_31485":75797,"_5":31809,"_21804":128653,"_28646":128654,"_3122":58727},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3731":75806,"_31485":75797,"_5":31809,"_21804":128656,"_28646":128657,"_3122":58731},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3731":75807,"_31485":75797,"_5":31809,"_21804":128659,"_28646":128660,"_3122":128661},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3731":75808,"_31485":75797,"_5":31809,"_21804":128663,"_28646":128664,"_3122":128665},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3731":75809,"_31485":75797,"_5":31809,"_21804":128667,"_28646":128668,"_3122":128669},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3731":75810,"_31485":75797,"_5":31809,"_21804":128671,"_28646":128672,"_3122":128673},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3731":75811,"_31485":75797,"_5":31809,"_21804":128675,"_28646":128676,"_3122":128677},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3731":75812,"_31485":75797,"_5":31809,"_21804":128679,"_28646":128680,"_3122":128681},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3731":75813,"_31485":75797,"_5":31809,"_21804":128683,"_28646":128684,"_3122":128685},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3731":75814,"_31485":75797,"_5":31809,"_21804":128687,"_28646":128688,"_3122":58763},[],"/docs/es/platform/pki/key-management#sign",{"_3731":75815,"_31485":75797,"_5":31809,"_21804":128690,"_28646":128691,"_3122":58767},[],"/docs/es/platform/pki/key-management#verify",{"_3731":75816,"_31485":75797,"_5":31809,"_21804":128693,"_28646":128694,"_3122":128695},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3731":75817,"_31485":75797,"_5":31809,"_21804":128697,"_28646":128698,"_3122":128699},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3731":75818,"_31485":75797,"_5":31809,"_21804":128701,"_28646":128702,"_3122":128703},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3731":75819,"_31485":75797,"_21804":128705,"_5":15036,"_28646":75797,"_3122":128706},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3731":75820,"_31485":75797,"_21804":128708,"_5":15036,"_28646":75797,"_3122":128709},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3731":75821,"_31485":75797,"_21804":128711,"_5":15036,"_28646":128634,"_3122":128712},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3731":75822,"_31485":75797,"_21804":128714,"_5":15036,"_28646":128634,"_3122":128715},[],"En la práctica, permite:",{"_3731":75823,"_31485":75797,"_21804":128717,"_5":15036,"_28646":128634,"_3122":128718},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3731":75824,"_31485":75797,"_21804":128720,"_5":15036,"_28646":128634,"_3122":128721},[],"Importar claves creadas externamente.",{"_3731":75825,"_31485":75797,"_21804":128723,"_5":15036,"_28646":128634,"_3122":128724},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3731":75826,"_31485":75797,"_21804":128726,"_5":15036,"_28646":128634,"_3122":128727},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3731":75827,"_31485":75797,"_21804":128729,"_5":15036,"_28646":128638,"_3122":128730},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3731":75828,"_31485":75797,"_21804":128732,"_5":15036,"_28646":128638,"_3122":128733},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3731":75829,"_31485":75797,"_21804":128735,"_5":15036,"_28646":128638,"_3122":128736},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3731":75830,"_31485":75797,"_21804":128738,"_5":15036,"_28646":128642,"_3122":128739},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3731":75831,"_31485":75797,"_21804":128741,"_5":15036,"_28646":128645,"_3122":128742},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3731":75832,"_31485":75797,"_21804":128744,"_5":15036,"_28646":128645,"_3122":128745},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3731":75833,"_31485":75797,"_21804":128747,"_5":15036,"_28646":128648,"_3122":128748},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3731":75834,"_31485":75797,"_21804":128750,"_5":15036,"_28646":128651,"_3122":128751},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3731":75835,"_31485":75797,"_21804":128753,"_5":15036,"_28646":128654,"_3122":128754},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3731":75836,"_31485":75797,"_21804":128756,"_5":15036,"_28646":128657,"_3122":128757},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3731":75837,"_31485":75797,"_21804":128759,"_5":15036,"_28646":128657,"_3122":128760},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3731":75838,"_31485":75797,"_21804":128762,"_5":15036,"_28646":128657,"_3122":128763},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3731":75839,"_31485":75797,"_21804":128765,"_5":15036,"_28646":128657,"_3122":128766},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3731":75840,"_31485":75797,"_21804":128768,"_5":15036,"_28646":128660,"_3122":128769},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3731":75841,"_31485":75797,"_21804":128771,"_5":15036,"_28646":128660,"_3122":128772},[],"La tabla incluye los siguientes campos:",{"_3731":75842,"_31485":75797,"_21804":128774,"_5":15036,"_28646":128660,"_3122":128775},[],"**Name**: nombre descriptivo de la clave.",{"_3731":75843,"_31485":75797,"_21804":128777,"_5":15036,"_28646":128660,"_3122":128778},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3731":75844,"_31485":75797,"_21804":128780,"_5":15036,"_28646":128660,"_3122":128781},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3731":75845,"_31485":75797,"_21804":128783,"_5":15036,"_28646":128660,"_3122":128784},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3731":75846,"_31485":75797,"_21804":128786,"_5":15036,"_28646":128660,"_3122":128787},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3731":75847,"_31485":75797,"_21804":128789,"_5":15036,"_28646":128660,"_3122":128790},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3731":75848,"_31485":75797,"_21804":128792,"_5":15036,"_28646":128660,"_3122":128793},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3731":75849,"_31485":75797,"_21804":128795,"_5":15036,"_28646":128660,"_3122":128796},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3731":75850,"_31485":75797,"_21804":128798,"_5":15036,"_28646":128660,"_3122":128799},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3731":75851,"_31485":75797,"_21804":128801,"_5":15036,"_28646":128660,"_3122":128802},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3731":75852,"_31485":75797,"_21804":128804,"_5":15036,"_28646":128660,"_3122":128805},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3731":75853,"_31485":75797,"_21804":128807,"_5":15036,"_28646":128660,"_3122":128808},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3731":75854,"_31485":75797,"_21804":128810,"_5":15036,"_28646":128660,"_3122":128811},[],"**Delete Key** para eliminar la clave del sistema.",{"_3731":75855,"_31485":75797,"_21804":128813,"_5":15036,"_28646":128664,"_3122":128814},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3731":75856,"_31485":75797,"_21804":128816,"_5":15036,"_28646":128668,"_3122":128817},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3731":75857,"_31485":75797,"_21804":128819,"_5":15036,"_28646":128668,"_3122":128820},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3731":75858,"_31485":75797,"_21804":128822,"_5":15036,"_28646":128668,"_3122":128823},[],"**Key Name**: nombre único y descriptivo.",{"_3731":75859,"_31485":75797,"_21804":128825,"_5":15036,"_28646":128668,"_3122":128826},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3731":75860,"_31485":75797,"_21804":128828,"_5":15036,"_28646":128668,"_3122":128829},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3731":75861,"_31485":75797,"_21804":128831,"_5":15036,"_28646":128668,"_3122":128832},[],"**Tags**: metadatos para clasificar la clave.",{"_3731":75862,"_31485":75797,"_21804":128834,"_5":15036,"_28646":128668,"_3122":128835},[],"**Metadata**: información adicional para usos avanzados.",{"_3731":75863,"_31485":75797,"_21804":128837,"_5":15036,"_28646":128672,"_3122":128838},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3731":75864,"_31485":75797,"_21804":128840,"_5":15036,"_28646":128672,"_3122":128841},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3731":75865,"_31485":75797,"_21804":128843,"_5":15036,"_28646":128672,"_3122":128844},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3731":75866,"_31485":75797,"_21804":128846,"_5":15036,"_28646":128672,"_3122":128847},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3731":75867,"_31485":75797,"_21804":128849,"_5":15036,"_28646":128672,"_3122":128850},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3731":75868,"_31485":75797,"_21804":128852,"_5":15036,"_28646":128672,"_3122":128853},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3731":75869,"_31485":75797,"_21804":128855,"_5":15036,"_28646":128672,"_3122":128856},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3731":75870,"_31485":75797,"_21804":128858,"_5":15036,"_28646":128672,"_3122":128859},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3731":75871,"_31485":75797,"_21804":128861,"_5":15036,"_28646":128672,"_3122":128862},[],"**Metadata**: información adicional opcional.",{"_3731":75872,"_31485":75797,"_21804":128864,"_5":15036,"_28646":128672,"_3122":128865},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3731":75873,"_31485":75797,"_21804":128867,"_5":15036,"_28646":128672,"_3122":128868},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3731":75874,"_31485":75797,"_21804":128870,"_5":15036,"_28646":128676,"_3122":128871},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3731":75875,"_31485":75797,"_21804":128873,"_5":15036,"_28646":128680,"_3122":128874},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3731":75876,"_31485":75797,"_21804":128876,"_5":15036,"_28646":128680,"_3122":128877},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3731":75877,"_31485":75797,"_21804":128879,"_5":15036,"_28646":128680,"_3122":128880},[],"**Key Name**: nombre descriptivo.",{"_3731":75878,"_31485":75797,"_21804":128882,"_5":15036,"_28646":128680,"_3122":128883},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3731":75879,"_31485":75797,"_21804":128885,"_5":15036,"_28646":128680,"_3122":128886},[],"**Tags**: etiquetas asociadas.",{"_3731":75880,"_31485":75797,"_21804":128888,"_5":15036,"_28646":128680,"_3122":128889},[],"**Aliases**: nombres alternativos.",{"_3731":75881,"_31485":75797,"_21804":128891,"_5":15036,"_28646":128680,"_3122":128892},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3731":75882,"_31485":75797,"_21804":128894,"_5":15036,"_28646":128680,"_3122":128895},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3731":75883,"_31485":75797,"_21804":128897,"_5":15036,"_28646":128680,"_3122":128898},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3731":75884,"_31485":75797,"_21804":128900,"_5":15036,"_28646":128680,"_3122":128901},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3731":75885,"_31485":75797,"_21804":128903,"_5":15036,"_28646":128684,"_3122":128904},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3731":75886,"_31485":75797,"_21804":128906,"_5":15036,"_28646":128684,"_3122":128907},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3731":75887,"_31485":75797,"_21804":128909,"_5":15036,"_28646":128684,"_3122":128910},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3731":75888,"_31485":75797,"_21804":128912,"_5":15036,"_28646":128688,"_3122":128913},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3731":75889,"_31485":75797,"_21804":128915,"_5":15036,"_28646":128688,"_3122":128916},[],"Campos principales:",{"_3731":75890,"_31485":75797,"_21804":128918,"_5":15036,"_28646":128688,"_3122":128919},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3731":75891,"_31485":75797,"_21804":128921,"_5":15036,"_28646":128688,"_3122":128922},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3731":75892,"_31485":75797,"_21804":128924,"_5":15036,"_28646":128688,"_3122":128925},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3731":75893,"_31485":75797,"_21804":128927,"_5":15036,"_28646":128688,"_3122":128928},[],"**Message**: contenido que se va a firmar.",{"_3731":75894,"_31485":75797,"_21804":128930,"_5":15036,"_28646":128688,"_3122":128931},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3731":75895,"_31485":75797,"_21804":128933,"_5":15036,"_28646":128691,"_3122":128934},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3731":75896,"_31485":75797,"_21804":128936,"_5":15036,"_28646":128691,"_3122":128916},[],{"_3731":75897,"_31485":75797,"_21804":128938,"_5":15036,"_28646":128691,"_3122":128939},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3731":75898,"_31485":75797,"_21804":128941,"_5":15036,"_28646":128691,"_3122":128942},[],"**Message Type**: `Raw` o `Digest`.",{"_3731":75899,"_31485":75797,"_21804":128944,"_5":15036,"_28646":128691,"_3122":128945},[],"**Payload Encoding**: codificación del mensaje.",{"_3731":75900,"_31485":75797,"_21804":128947,"_5":15036,"_28646":128691,"_3122":128948},[],"**Message**: mensaje original o hash.",{"_3731":75901,"_31485":75797,"_21804":128950,"_5":15036,"_28646":128691,"_3122":128951},[],"**Signature**: firma que se desea comprobar.",{"_3731":75902,"_31485":75797,"_21804":128953,"_5":15036,"_28646":128691,"_3122":128954},[],"**Result**: indicador del resultado de la validación.",{"_3731":75903,"_31485":75797,"_21804":128956,"_5":15036,"_28646":128694,"_3122":128957},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3731":75904,"_31485":75797,"_21804":128959,"_5":15036,"_28646":128694,"_3122":128960},[],"Este flujo es útil para:",{"_3731":75905,"_31485":75797,"_21804":128962,"_5":15036,"_28646":128694,"_3122":128963},[],"Solicitar certificados a una CA externa.",{"_3731":75906,"_31485":75797,"_21804":128965,"_5":15036,"_28646":128694,"_3122":128966},[],"Renovar una identidad manteniendo la misma clave.",{"_3731":75907,"_31485":75797,"_21804":128968,"_5":15036,"_28646":128694,"_3122":128969},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3731":75908,"_31485":75797,"_21804":128971,"_5":15036,"_28646":128694,"_3122":128972},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3731":75909,"_31485":75797,"_21804":128974,"_5":15036,"_28646":128694,"_3122":128975},[],"**Organization (O)**: organización o empresa.",{"_3731":75910,"_31485":75797,"_21804":128977,"_5":15036,"_28646":128694,"_3122":128978},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3731":75911,"_31485":75797,"_21804":128980,"_5":15036,"_28646":128694,"_3122":128981},[],"**Country (C)**: código de país de dos letras.",{"_3731":75912,"_31485":75797,"_21804":128983,"_5":15036,"_28646":128694,"_3122":128984},[],"**State / Province (ST)**: estado o provincia.",{"_3731":75913,"_31485":75797,"_21804":128986,"_5":15036,"_28646":128694,"_3122":128987},[],"**Locality (L)**: ciudad o localidad.",{"_3731":75914,"_31485":75797,"_21804":128989,"_5":15036,"_28646":128694,"_3122":128990},[],"**Email Address**: correo de contacto.",{"_3731":75915,"_31485":75797,"_21804":128992,"_5":15036,"_28646":128694,"_3122":128993},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3731":75916,"_31485":75797,"_21804":128995,"_5":15036,"_28646":128694,"_3122":128996},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3731":75917,"_31485":75797,"_21804":128998,"_5":15036,"_28646":128698,"_3122":128999},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3731":75918,"_31485":75797,"_21804":129001,"_5":15036,"_28646":128698,"_3122":129002},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3731":75919,"_31485":75797,"_21804":129004,"_5":15036,"_28646":128702,"_3122":129005},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3731":75920,"_31485":75797,"_21804":129007,"_5":15036,"_28646":128702,"_3122":129008},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados, con `409` `key is in use`. Revocar un certificado o dejar que caduque no libera su referencia a la clave. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, que se conservan para respaldar la CRL y OCSP, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Los certificados emitidos por la CA conservan sus propias referencias a claves, incluso revocados. La API solo permite eliminar uno de ellos cuando su CA emisora ya no existe, y eliminarlo lo quita de la CRL y de las respuestas OCSP, así que conserva los certificados revocados durante su periodo de retención y elimina solo los caducados o sustituidos. El KMS también se niega a eliminar una clave que firma la CRL de una CA cuyos ajustes de CRL siguen `ACTIVE`, con el mismo `409` `key is in use`; esa referencia se libera cuando los ajustes se finalizan, después de que la CA se revoca de forma permanente o caduca (consulta CRL). La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3731":75921,"_31485":75921,"_5":15390,"_3122":129010,"_31812":129011,"_21804":129012,"_28646":75921},"Validación online con OCSP",[51373,123005,57109,127732],[],{"_3731":75922,"_31485":75921,"_21804":129014,"_5":15036,"_28646":75921,"_3122":129015},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3731":75923,"_31485":75921,"_5":31809,"_21804":129017,"_28646":129018,"_3122":129019},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3731":75924,"_31485":75921,"_5":31809,"_21804":129021,"_28646":129022,"_3122":129023},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3731":75925,"_31485":75921,"_5":31809,"_21804":129025,"_28646":129026,"_3122":129027},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3731":75926,"_31485":75921,"_5":31809,"_21804":129029,"_28646":129030,"_3122":129031},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3731":75927,"_31485":75921,"_5":31809,"_21804":129033,"_28646":129034,"_3122":129035},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3731":75928,"_31485":75921,"_5":31809,"_21804":129037,"_28646":129038,"_3122":128295},[],"/docs/es/platform/pki/ocsp#referencias",{"_3731":75929,"_31485":75921,"_21804":129040,"_5":15036,"_28646":75921,"_3122":129041},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3731":75930,"_31485":75921,"_21804":129043,"_5":15036,"_28646":129018,"_3122":129044},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3731":75931,"_31485":75921,"_21804":129046,"_5":15036,"_28646":129018,"_3122":129047},[],"Estado del registro",{"_3731":75932,"_31485":75921,"_21804":129049,"_5":15036,"_28646":129018,"_3122":129050},[],"Respuesta firmada",{"_3731":75933,"_31485":75921,"_21804":129052,"_5":15036,"_28646":129018,"_3122":56245},[],{"_3731":75934,"_31485":75921,"_21804":129054,"_5":15036,"_28646":129018,"_3122":59131},[],{"_3731":75935,"_31485":75921,"_21804":129056,"_5":15036,"_28646":129018,"_3122":56262},[],{"_3731":75936,"_31485":75921,"_21804":129058,"_5":15036,"_28646":129018,"_3122":129059},[],"`Revoked`, con razón y fecha de revocación.",{"_3731":75937,"_31485":75921,"_21804":129061,"_5":15036,"_28646":129018,"_3122":129062},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3731":75938,"_31485":75921,"_21804":129064,"_5":15036,"_28646":129018,"_3122":129065},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3731":75939,"_31485":75921,"_21804":129067,"_5":15036,"_28646":129018,"_3122":129068},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3731":75940,"_31485":75921,"_21804":129070,"_5":15036,"_28646":129018,"_3122":129071},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3731":75941,"_31485":75921,"_21804":129073,"_5":15036,"_28646":129018,"_3122":129074},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3731":75942,"_31485":75921,"_21804":129076,"_5":15036,"_28646":129022,"_3122":129077},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3731":75943,"_31485":75921,"_21804":129079,"_5":15036,"_28646":129022,"_3122":129080},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3731":75944,"_31485":75921,"_21804":129082,"_5":15036,"_28646":129026,"_3122":129083},[],"El servicio acepta:",{"_3731":75945,"_31485":75921,"_21804":129085,"_5":15036,"_28646":129026,"_3122":124755},[],{"_3731":75946,"_31485":75921,"_21804":129087,"_5":15036,"_28646":129026,"_3122":129088},[],"Ruta del servicio VA",{"_3731":75947,"_31485":75921,"_21804":129090,"_5":15036,"_28646":129026,"_3122":129091},[],"Formato",{"_3731":75948,"_31485":75921,"_21804":129093,"_5":15036,"_28646":129026,"_3122":59171},[],{"_3731":75949,"_31485":75921,"_21804":129095,"_5":15036,"_28646":129026,"_3122":59174},[],{"_3731":75950,"_31485":75921,"_21804":129097,"_5":15036,"_28646":129026,"_3122":129098},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3731":75951,"_31485":75921,"_21804":129100,"_5":15036,"_28646":129026,"_3122":58531},[],{"_3731":75952,"_31485":75921,"_21804":129102,"_5":15036,"_28646":129026,"_3122":59182},[],{"_3731":75953,"_31485":75921,"_21804":129104,"_5":15036,"_28646":129026,"_3122":129105},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3731":75954,"_31485":75921,"_21804":129107,"_5":15036,"_28646":129026,"_3122":129108},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3731":75955,"_31485":75921,"_21804":129110,"_5":15036,"_28646":129030,"_3122":129111},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3731":75956,"_31485":75921,"_21804":129113,"_5":15036,"_28646":129030,"_3122":129114},[],"Genera la solicitud:",{"_3731":75957,"_31485":75921,"_21804":129116,"_5":15036,"_28646":129030,"_3122":129117},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3731":75958,"_31485":75921,"_21804":129119,"_5":15036,"_28646":129030,"_3122":129120},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3731":75959,"_31485":75921,"_21804":129122,"_5":15036,"_28646":129030,"_3122":129123},[],"Verifica el DER recibido:",{"_3731":75960,"_31485":75921,"_21804":129125,"_5":15036,"_28646":129030,"_3122":129126},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3731":75961,"_31485":75921,"_21804":129128,"_5":15036,"_28646":129034,"_3122":129129},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3731":75962,"_31485":75921,"_21804":129131,"_5":15036,"_28646":129034,"_3122":129132},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3731":75963,"_31485":75921,"_21804":129134,"_5":15036,"_28646":129038,"_3122":59215},[],{"_3731":75964,"_31485":75921,"_21804":129136,"_5":15036,"_28646":129038,"_3122":59218},[],{"_3731":75965,"_31485":75921,"_21804":129138,"_5":15036,"_28646":129038,"_3122":129139},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3731":75966,"_31485":75921,"_21804":129141,"_5":15036,"_28646":129038,"_3122":128590},[],{"_3731":75967,"_31485":75967,"_5":15390,"_3122":57109,"_31812":129143,"_21804":129144,"_28646":75967},[51373,123005,57109],[],{"_3731":75968,"_31485":75967,"_21804":129146,"_5":15036,"_28646":75967,"_3122":129147},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3731":75969,"_31485":75967,"_5":31809,"_21804":129149,"_28646":129150,"_3122":126386},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3731":75970,"_31485":75967,"_5":31809,"_21804":129152,"_28646":129153,"_3122":129154},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3731":75971,"_31485":75967,"_5":31809,"_21804":129156,"_28646":129157,"_3122":126907},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3731":75972,"_31485":75967,"_5":31809,"_21804":129159,"_28646":129160,"_3122":126911},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3731":75973,"_31485":75967,"_5":31809,"_21804":129162,"_28646":129163,"_3122":126915},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3731":75974,"_31485":75967,"_5":31809,"_21804":129165,"_28646":129166,"_3122":126919},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3731":75975,"_31485":75967,"_5":31809,"_21804":129168,"_28646":129169,"_3122":126927},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3731":75976,"_31485":75967,"_5":31809,"_21804":129171,"_28646":129172,"_3122":129173},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3731":75977,"_31485":75967,"_5":31809,"_21804":129175,"_28646":129176,"_3122":127898},[],"/docs/es/platform/pki/overview#continúa",{"_3731":75978,"_31485":75967,"_21804":129178,"_5":15036,"_28646":75967,"_3122":129179},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3731":75979,"_31485":75967,"_21804":129181,"_5":15036,"_28646":129150,"_3122":129182},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3731":75980,"_31485":75967,"_21804":129184,"_5":15036,"_28646":129150,"_3122":129185},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3731":75981,"_31485":75967,"_21804":129187,"_5":15036,"_28646":129153,"_3122":129188},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3731":75982,"_31485":75967,"_21804":129190,"_5":15036,"_28646":129153,"_3122":129191},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3731":75983,"_31485":75967,"_21804":129193,"_5":15036,"_28646":129153,"_3122":129194},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3731":75984,"_31485":75967,"_21804":129196,"_5":15036,"_28646":129153,"_3122":129197},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3731":75985,"_31485":75967,"_21804":129199,"_5":15036,"_28646":129153,"_3122":129200},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3731":75986,"_31485":75967,"_21804":129202,"_5":15036,"_28646":129160,"_3122":129203},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3731":75987,"_31485":75967,"_21804":129205,"_5":15036,"_28646":129163,"_3122":129206},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3731":75988,"_31485":75967,"_21804":129208,"_5":15036,"_28646":129166,"_3122":129209},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3731":75989,"_31485":75967,"_21804":129211,"_5":15036,"_28646":129166,"_3122":129212},[],"Los protocolos de enrolamiento permiten que los clientes obtengan y renueven certificados de una CA de Lamassu.",{"_3731":75990,"_31485":75967,"_21804":129214,"_5":15036,"_28646":129169,"_3122":129215},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3731":75991,"_31485":75967,"_21804":129217,"_5":15036,"_28646":129172,"_3122":129218},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3731":75992,"_31485":75967,"_21804":129220,"_5":15036,"_28646":129172,"_3122":129221},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3731":75993,"_31485":75967,"_21804":129223,"_5":15036,"_28646":129172,"_3122":129224},[],"su clave pública corresponda a la clave privada del cliente;",{"_3731":75994,"_31485":75967,"_21804":129226,"_5":15036,"_28646":129172,"_3122":129227},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3731":75995,"_31485":75967,"_21804":129229,"_5":15036,"_28646":129172,"_3122":129230},[],"sus fechas y usos permitan la operación;",{"_3731":75996,"_31485":75967,"_21804":129232,"_5":15036,"_28646":129172,"_3122":129233},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3731":75997,"_31485":75967,"_21804":129235,"_5":15036,"_28646":129172,"_3122":129236},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3731":75998,"_31485":75967,"_21804":129238,"_5":15036,"_28646":129176,"_3122":129239},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3731":75999,"_31485":75967,"_21804":129241,"_5":15036,"_28646":129176,"_3122":129242},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3731":76000,"_31485":75967,"_21804":129244,"_5":15036,"_28646":129176,"_3122":129245},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3731":76001,"_31485":76001,"_5":15390,"_3122":129247,"_31812":129248,"_21804":129249,"_28646":76001},"Crea tu primera CA",[51373,123005,57109,126510],[],{"_3731":76002,"_31485":76001,"_21804":129251,"_5":15036,"_28646":76001,"_3122":129252},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3731":76003,"_31485":76001,"_5":31809,"_21804":129254,"_28646":129255,"_3122":121513},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3731":76004,"_31485":76001,"_5":31809,"_21804":129257,"_28646":129258,"_3122":129259},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3731":76005,"_31485":76001,"_5":31809,"_21804":129261,"_28646":129262,"_3122":129263},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3731":76006,"_31485":76001,"_5":31809,"_21804":129265,"_28646":129266,"_3122":129267},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3731":76007,"_31485":76001,"_5":31809,"_21804":129269,"_28646":129270,"_3122":129271},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3731":76008,"_31485":76001,"_5":31809,"_21804":129273,"_28646":129274,"_3122":129275},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3731":76009,"_31485":76001,"_5":31809,"_21804":129277,"_28646":129278,"_3122":129279},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3731":76010,"_31485":76001,"_5":31809,"_21804":129281,"_28646":129282,"_3122":126758},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3731":76011,"_31485":76001,"_5":31809,"_21804":129284,"_28646":129285,"_3122":121537},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3731":76012,"_31485":76001,"_21804":129287,"_5":15036,"_28646":76001,"_3122":129288},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3731":76013,"_31485":76001,"_21804":129290,"_5":15036,"_28646":129255,"_3122":129291},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3731":76014,"_31485":76001,"_21804":129293,"_5":15036,"_28646":129255,"_3122":129294},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3731":76015,"_31485":76001,"_21804":129296,"_5":15036,"_28646":129255,"_3122":129297},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3731":76016,"_31485":76001,"_21804":129299,"_5":15036,"_28646":129255,"_3122":129300},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3731":76017,"_31485":76001,"_21804":129302,"_5":15036,"_28646":129258,"_3122":129303},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3731":76018,"_31485":76001,"_21804":129305,"_5":15036,"_28646":129258,"_3122":129306},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3731":76019,"_31485":76001,"_21804":129308,"_5":15036,"_28646":129262,"_3122":129309},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3731":76020,"_31485":76001,"_21804":129311,"_5":15036,"_28646":129262,"_3122":129312},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3731":76021,"_31485":76001,"_21804":129314,"_5":15036,"_28646":129266,"_3122":129315},[],"Selecciona **Root CA** y completa:",{"_3731":76022,"_31485":76001,"_21804":129317,"_5":15036,"_28646":129266,"_3122":59400},[],{"_3731":76023,"_31485":76001,"_21804":129319,"_5":15036,"_28646":129266,"_3122":129320},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3731":76024,"_31485":76001,"_21804":129322,"_5":15036,"_28646":129266,"_3122":129323},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3731":76025,"_31485":76001,"_21804":129325,"_5":15036,"_28646":129266,"_3122":129326},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3731":76026,"_31485":76001,"_21804":129328,"_5":15036,"_28646":129266,"_3122":129329},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3731":76027,"_31485":76001,"_21804":129331,"_5":15036,"_28646":129270,"_3122":129332},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3731":76028,"_31485":76001,"_21804":129334,"_5":15036,"_28646":129274,"_3122":129335},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3731":76029,"_31485":76001,"_21804":129337,"_5":15036,"_28646":129274,"_3122":129338},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3731":76030,"_31485":76001,"_21804":129340,"_5":15036,"_28646":129278,"_3122":129341},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3731":76031,"_31485":76001,"_21804":129343,"_5":15036,"_28646":129278,"_3122":129344},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3731":76032,"_31485":76001,"_21804":129346,"_5":15036,"_28646":129278,"_3122":129347},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3731":76033,"_31485":76001,"_21804":129349,"_5":15036,"_28646":129282,"_3122":129350},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3731":76034,"_31485":76001,"_21804":129352,"_5":15036,"_28646":129282,"_3122":129353},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3731":76035,"_31485":76001,"_21804":129355,"_5":15036,"_28646":129282,"_3122":129356},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3731":76036,"_31485":76001,"_21804":129358,"_5":15036,"_28646":129282,"_3122":129359},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3731":76037,"_31485":76001,"_21804":129361,"_5":15036,"_28646":129285,"_3122":129362},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3731":76038,"_31485":76038,"_5":15390,"_3122":129364,"_31812":129365,"_21804":129366,"_28646":76038},"Emite y verifica un certificado",[51373,123005,57109,126510],[],{"_3731":76039,"_31485":76038,"_21804":129368,"_5":15036,"_28646":76038,"_3122":129369},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3731":76040,"_31485":76038,"_5":31809,"_21804":129371,"_28646":129372,"_3122":121513},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3731":76041,"_31485":76038,"_5":31809,"_21804":129374,"_28646":129375,"_3122":129376},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3731":76042,"_31485":76038,"_5":31809,"_21804":129378,"_28646":129379,"_3122":129380},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3731":76043,"_31485":76038,"_5":31809,"_21804":129382,"_28646":129383,"_3122":129384},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3731":76044,"_31485":76038,"_5":31809,"_21804":129386,"_28646":129387,"_3122":129388},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3731":76045,"_31485":76038,"_5":31809,"_21804":129390,"_28646":129391,"_3122":129392},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3731":76046,"_31485":76038,"_5":31809,"_21804":129394,"_28646":129395,"_3122":129396},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3731":76047,"_31485":76038,"_5":31809,"_21804":129398,"_28646":129399,"_3122":129400},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3731":76048,"_31485":76038,"_5":31809,"_21804":129402,"_28646":129403,"_3122":129404},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3731":76049,"_31485":76038,"_5":31809,"_21804":129406,"_28646":129407,"_3122":129408},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3731":76050,"_31485":76038,"_5":31809,"_21804":129410,"_28646":129411,"_3122":126758},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3731":76051,"_31485":76038,"_5":31809,"_21804":129413,"_28646":129414,"_3122":121537},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3731":76052,"_31485":76038,"_21804":129416,"_5":15036,"_28646":76038,"_3122":129417},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3731":76053,"_31485":76038,"_21804":129419,"_5":15036,"_28646":129372,"_3122":129420},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3731":76054,"_31485":76038,"_21804":129422,"_5":15036,"_28646":129372,"_3122":129423},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3731":76055,"_31485":76038,"_21804":129425,"_5":15036,"_28646":129372,"_3122":129426},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3731":76056,"_31485":76038,"_21804":129428,"_5":15036,"_28646":129372,"_3122":129429},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3731":76057,"_31485":76038,"_21804":129431,"_5":15036,"_28646":129372,"_3122":129432},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3731":76058,"_31485":76038,"_21804":129434,"_5":15036,"_28646":129375,"_3122":129435},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3731":76059,"_31485":76038,"_21804":129437,"_5":15036,"_28646":129379,"_3122":129438},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3731":76060,"_31485":76038,"_21804":129440,"_5":15036,"_28646":129379,"_3122":129441},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3731":76061,"_31485":76038,"_21804":129443,"_5":15036,"_28646":129383,"_3122":129444},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3731":76062,"_31485":76038,"_21804":129446,"_5":15036,"_28646":129383,"_3122":129447},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3731":76063,"_31485":76038,"_21804":129449,"_5":15036,"_28646":129387,"_3122":129450},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3731":76064,"_31485":76038,"_21804":129452,"_5":15036,"_28646":129387,"_3122":129453},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3731":76065,"_31485":76038,"_21804":129455,"_5":15036,"_28646":129391,"_3122":129456},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3731":76066,"_31485":76038,"_21804":129458,"_5":15036,"_28646":129395,"_3122":129459},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3731":76067,"_31485":76038,"_21804":129461,"_5":15036,"_28646":129399,"_3122":129462},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3731":76068,"_31485":76038,"_21804":129464,"_5":15036,"_28646":129403,"_3122":129465},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3731":76069,"_31485":76038,"_21804":129467,"_5":15036,"_28646":129403,"_3122":129468},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3731":76070,"_31485":76038,"_21804":129470,"_5":15036,"_28646":129403,"_3122":129471},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3731":76071,"_31485":76038,"_21804":129473,"_5":15036,"_28646":129407,"_3122":129474},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3731":76072,"_31485":76038,"_21804":129476,"_5":15036,"_28646":129407,"_3122":129477},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3731":76073,"_31485":76038,"_21804":129479,"_5":15036,"_28646":129407,"_3122":129480},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3731":76074,"_31485":76038,"_21804":129482,"_5":15036,"_28646":129411,"_3122":126841},[],{"_3731":76075,"_31485":76038,"_21804":129484,"_5":15036,"_28646":129411,"_3122":125448},[],{"_3731":76076,"_31485":76038,"_21804":129486,"_5":15036,"_28646":129411,"_3122":129487},[],"La CA rechaza la emisión",{"_3731":76077,"_31485":76038,"_21804":129489,"_5":15036,"_28646":129411,"_3122":129490},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3731":76078,"_31485":76038,"_21804":129492,"_5":15036,"_28646":129411,"_3122":129493},[],"Sujeto o usos diferentes",{"_3731":76079,"_31485":76038,"_21804":129495,"_5":15036,"_28646":129411,"_3122":129496},[],"Perfil aplicado y valores solicitados.",{"_3731":76080,"_31485":76038,"_21804":129498,"_5":15036,"_28646":129411,"_3122":129499},[],"No se encuentra el emisor",{"_3731":76081,"_31485":76038,"_21804":129501,"_5":15036,"_28646":129411,"_3122":129502},[],"CA descargada y cadena intermedia necesaria.",{"_3731":76082,"_31485":76038,"_21804":129504,"_5":15036,"_28646":129411,"_3122":129505},[],"Falla la vigencia",{"_3731":76083,"_31485":76038,"_21804":129507,"_5":15036,"_28646":129411,"_3122":129508},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3731":76084,"_31485":76038,"_21804":129510,"_5":15036,"_28646":129411,"_3122":129511},[],"Los resúmenes de clave difieren",{"_3731":76085,"_31485":76038,"_21804":129513,"_5":15036,"_28646":129411,"_3122":129514},[],"Archivos de certificado y clave de la misma emisión.",{"_3731":76086,"_31485":76038,"_21804":129516,"_5":15036,"_28646":129411,"_3122":129517},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3731":76087,"_31485":76038,"_21804":129519,"_5":15036,"_28646":129414,"_3122":129520},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3731":76088,"_31485":76038,"_21804":129522,"_5":15036,"_28646":129414,"_3122":129523},[],"Gestionar certificados para inspección, estado y revocación.",{"_3731":76089,"_31485":76038,"_21804":129525,"_5":15036,"_28646":129414,"_3122":129526},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3731":76090,"_31485":76038,"_21804":129528,"_5":15036,"_28646":129414,"_3122":129529},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3731":76091,"_31485":76038,"_21804":129531,"_5":15036,"_28646":129414,"_3122":129532},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3731":76092,"_31485":76092,"_5":15390,"_3122":129534,"_31812":129535,"_21804":129536,"_28646":76092},"Primeros pasos de PKI",[51373,123005,57109,126510],[],{"_3731":76093,"_31485":76092,"_21804":129538,"_5":15036,"_28646":76092,"_3122":129539},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3731":76094,"_31485":76092,"_5":31809,"_21804":129541,"_28646":129542,"_3122":121513},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3731":76095,"_31485":76092,"_5":31809,"_21804":129544,"_28646":129545,"_3122":129546},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3731":76096,"_31485":76092,"_5":31809,"_21804":129548,"_28646":129549,"_3122":126693},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3731":76097,"_31485":76092,"_5":31809,"_21804":129551,"_28646":129552,"_3122":129553},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3731":76098,"_31485":76092,"_21804":129555,"_5":15036,"_28646":76092,"_3122":129556},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3731":76099,"_31485":76092,"_21804":129558,"_5":15036,"_28646":129542,"_3122":129559},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3731":76100,"_31485":76092,"_21804":129561,"_5":15036,"_28646":129542,"_3122":129562},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3731":76101,"_31485":76092,"_21804":129564,"_5":15036,"_28646":129542,"_3122":129565},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3731":76102,"_31485":76092,"_21804":129567,"_5":15036,"_28646":129542,"_3122":129568},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3731":76103,"_31485":76092,"_21804":129570,"_5":15036,"_28646":129542,"_3122":129571},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3731":76104,"_31485":76092,"_21804":129573,"_5":15036,"_28646":129545,"_3122":129574},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3731":76105,"_31485":76092,"_21804":129576,"_5":15036,"_28646":129545,"_3122":129577},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3731":76106,"_31485":76092,"_21804":129579,"_5":15036,"_28646":129545,"_3122":129580},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3731":76107,"_31485":76092,"_21804":129582,"_5":15036,"_28646":129545,"_3122":129583},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3731":76108,"_31485":76092,"_21804":129585,"_5":15036,"_28646":129549,"_3122":129586},[],"Archivo o recurso",{"_3731":76109,"_31485":76092,"_21804":129588,"_5":15036,"_28646":129549,"_3122":126690},[],{"_3731":76110,"_31485":76092,"_21804":129590,"_5":15036,"_28646":129549,"_3122":129591},[],"CA raíz activa y `ca.pem`",{"_3731":76111,"_31485":76092,"_21804":129593,"_5":15036,"_28646":129549,"_3122":129594},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3731":76112,"_31485":76092,"_21804":129596,"_5":15036,"_28646":129549,"_3122":129597},[],"Certificado final y `device.crt`",{"_3731":76113,"_31485":76092,"_21804":129599,"_5":15036,"_28646":129549,"_3122":129600},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3731":76114,"_31485":76092,"_21804":129602,"_5":15036,"_28646":129549,"_3122":129603},[],"Clave privada `device.key`",{"_3731":76115,"_31485":76092,"_21804":129605,"_5":15036,"_28646":129549,"_3122":129606},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3731":76116,"_31485":76092,"_21804":129608,"_5":15036,"_28646":129549,"_3122":129609},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3731":76117,"_31485":76092,"_21804":129611,"_5":15036,"_28646":129552,"_3122":129612},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3731":76118,"_31485":76092,"_21804":129614,"_5":15036,"_28646":129552,"_3122":129615},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3731":76119,"_31485":76092,"_21804":129617,"_5":15036,"_28646":129552,"_3122":129618},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3731":76120,"_31485":76120,"_5":15390,"_3122":129620,"_31812":129621,"_21804":129623,"_28646":76120},"Resolución de problemas PKI",[51373,123005,57109,129622],"Resolución de problemas",[],{"_3731":76121,"_31485":76120,"_21804":129625,"_5":15036,"_28646":76120,"_3122":129626},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3731":76122,"_31485":76120,"_5":31809,"_21804":129628,"_28646":129629,"_3122":129630},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3731":76123,"_31485":76120,"_5":31809,"_21804":129632,"_28646":129633,"_3122":129634},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3731":76124,"_31485":76120,"_5":31809,"_21804":129636,"_28646":129637,"_3122":129638},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3731":76125,"_31485":76120,"_21804":129640,"_5":15036,"_28646":76120,"_3122":129641},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3731":76126,"_31485":76120,"_21804":129643,"_5":15036,"_28646":76120,"_3122":129644},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3731":76127,"_31485":76120,"_21804":129646,"_5":15036,"_28646":129629,"_3122":126690},[],{"_3731":76128,"_31485":76120,"_21804":129648,"_5":15036,"_28646":129629,"_3122":125448},[],{"_3731":76129,"_31485":76120,"_21804":129650,"_5":15036,"_28646":129629,"_3122":121537},[],{"_3731":76130,"_31485":76120,"_21804":129652,"_5":15036,"_28646":129629,"_3122":55950},[],{"_3731":76131,"_31485":76120,"_21804":129654,"_5":15036,"_28646":129629,"_3122":129655},[],"Existe, está activa y sus fechas son utilizables.",{"_3731":76132,"_31485":76120,"_21804":129657,"_5":15036,"_28646":129629,"_3122":129658},[],"Autoridades.",{"_3731":76133,"_31485":76120,"_21804":129660,"_5":15036,"_28646":129629,"_3122":129661},[],"Clave",{"_3731":76134,"_31485":76120,"_21804":129663,"_5":15036,"_28646":129629,"_3122":129664},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3731":76135,"_31485":76120,"_21804":129666,"_5":15036,"_28646":129629,"_3122":129667},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3731":76136,"_31485":76120,"_21804":129669,"_5":15036,"_28646":129629,"_3122":59754},[],{"_3731":76137,"_31485":76120,"_21804":129671,"_5":15036,"_28646":129629,"_3122":129672},[],"PEM correcto y firma verificable.",{"_3731":76138,"_31485":76120,"_21804":129674,"_5":15036,"_28646":129629,"_3122":59760},[],{"_3731":76139,"_31485":76120,"_21804":129676,"_5":15036,"_28646":129629,"_3122":129677},[],"Perfil",{"_3731":76140,"_31485":76120,"_21804":129679,"_5":15036,"_28646":129629,"_3122":129680},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3731":76141,"_31485":76120,"_21804":129682,"_5":15036,"_28646":129629,"_3122":129683},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3731":76142,"_31485":76120,"_21804":129685,"_5":15036,"_28646":129629,"_3122":126841},[],{"_3731":76143,"_31485":76120,"_21804":129687,"_5":15036,"_28646":129629,"_3122":129688},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3731":76144,"_31485":76120,"_21804":129690,"_5":15036,"_28646":129629,"_3122":129691},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3731":76145,"_31485":76120,"_21804":129693,"_5":15036,"_28646":129629,"_3122":129694},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3731":76146,"_31485":76120,"_21804":129696,"_5":15036,"_28646":129629,"_3122":129697},[],"Si la emisión falla con `400` y `CA Status inconsistent`, la CA emisora no está `ACTIVE` o está fuera del periodo de validez de su certificado. El estado almacenado puede ir por detrás de las fechas hasta que se ejecuta el monitor de expiración, así que comprueba también las fechas. Reemite la CA mientras siga vigente o emite desde otra CA.",{"_3731":76147,"_31485":76120,"_21804":129699,"_5":15036,"_28646":129629,"_3122":129700},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Si es subordinada, comprueba también el estado y las fechas de su CA padre. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3731":76148,"_31485":76120,"_21804":129702,"_5":15036,"_28646":129633,"_3122":129703},[],"Revisa cada frontera por separado:",{"_3731":76149,"_31485":76120,"_21804":129705,"_5":15036,"_28646":129633,"_3122":129706},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3731":76150,"_31485":76120,"_21804":129708,"_5":15036,"_28646":129633,"_3122":129709},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3731":76151,"_31485":76120,"_21804":129711,"_5":15036,"_28646":129633,"_3122":129712},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3731":76152,"_31485":76120,"_21804":129714,"_5":15036,"_28646":129633,"_3122":129715},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3731":76153,"_31485":76120,"_21804":129717,"_5":15036,"_28646":129633,"_3122":129718},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3731":76154,"_31485":76120,"_21804":129720,"_5":15036,"_28646":129633,"_3122":129721},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Una suspensión en cascada desde una CA se levanta reactivando esa CA; la cascada de una CA revocada definitivamente no. Revisa todos los estados y los errores individuales de la operación.",{"_3731":76155,"_31485":76120,"_21804":129723,"_5":15036,"_28646":129637,"_3122":129724},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3731":76156,"_31485":76120,"_21804":129726,"_5":15036,"_28646":129637,"_3122":129727},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3731":76157,"_31485":76157,"_5":15390,"_3122":129729,"_31812":129730,"_21804":129731,"_28646":76157},"Seguridad",[51373],[],{"_3731":76158,"_31485":76157,"_21804":129733,"_5":15036,"_28646":76157,"_3122":129734},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3731":76159,"_31485":76157,"_5":31809,"_21804":129736,"_28646":129737,"_3122":129738},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3731":76160,"_31485":76157,"_5":31809,"_21804":129740,"_28646":129741,"_3122":129742},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3731":76161,"_31485":76157,"_5":31809,"_21804":129744,"_28646":129745,"_3122":129746},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3731":76162,"_31485":76157,"_5":31809,"_21804":129748,"_28646":129749,"_3122":129750},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3731":76163,"_31485":76157,"_21804":129752,"_5":15036,"_28646":76157,"_3122":129753},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3731":76164,"_31485":76157,"_21804":129755,"_5":15036,"_28646":129737,"_3122":129756},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3731":76165,"_31485":76157,"_21804":129758,"_5":15036,"_28646":129737,"_3122":129759},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3731":76166,"_31485":76157,"_21804":129761,"_5":15036,"_28646":129737,"_3122":15664},[],{"_3731":76167,"_31485":76157,"_21804":129763,"_5":15036,"_28646":129737,"_3122":15593},[],{"_3731":76168,"_31485":76157,"_21804":129765,"_5":15036,"_28646":129737,"_3122":15651},[],{"_3731":76169,"_31485":76157,"_21804":129767,"_5":15036,"_28646":129737,"_3122":129768},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3731":76170,"_31485":76157,"_21804":129770,"_5":15036,"_28646":129737,"_3122":129771},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3731":76171,"_31485":76157,"_21804":129773,"_5":15036,"_28646":129741,"_3122":129774},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3731":76172,"_31485":76157,"_21804":129776,"_5":15036,"_28646":129741,"_3122":129777},[],"No incluyas en el reporte:",{"_3731":76173,"_31485":76157,"_21804":129779,"_5":15036,"_28646":129741,"_3122":129780},[],"Credenciales, tokens o claves privadas",{"_3731":76174,"_31485":76157,"_21804":129782,"_5":15036,"_28646":129741,"_3122":129783},[],"Datos de clientes o información identificable de clientes",{"_3731":76175,"_31485":76157,"_21804":129785,"_5":15036,"_28646":129741,"_3122":129786},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3731":76176,"_31485":76157,"_21804":129788,"_5":15036,"_28646":129745,"_3122":129789},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3731":76177,"_31485":76157,"_21804":129791,"_5":15036,"_28646":129745,"_3122":129792},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3731":76178,"_31485":76157,"_21804":129794,"_5":15036,"_28646":129749,"_3122":129795},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3731":76179,"_31485":76157,"_21804":129797,"_5":15036,"_28646":129749,"_3122":129798},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3731":76180,"_31485":76157,"_21804":129800,"_5":15036,"_28646":129749,"_3122":129801},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3731":76181,"_31485":76157,"_21804":129803,"_5":15036,"_28646":129749,"_3122":129804},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3731":76182,"_31485":76157,"_21804":129806,"_5":15036,"_28646":129749,"_3122":129807},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3731":76183,"_31485":76183,"_5":15390,"_3122":129809,"_31812":129810,"_21804":129812,"_28646":76183},"3.8.0 a 4.0.0",[51373,129811],"Actualizaciones",[],{"_3731":76184,"_31485":76183,"_21804":129814,"_5":15036,"_28646":76183,"_3122":129815},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3731":76185,"_31485":76183,"_5":31809,"_21804":129817,"_28646":129818,"_3122":129819},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3731":76186,"_31485":76183,"_5":31809,"_21804":129821,"_28646":129822,"_3122":129823},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3731":76187,"_31485":76183,"_5":31809,"_21804":129825,"_28646":129826,"_3122":129827},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3731":76188,"_31485":76183,"_5":31809,"_21804":129829,"_28646":129830,"_3122":129831},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3731":76189,"_31485":76183,"_5":31809,"_21804":129833,"_28646":129834,"_3122":129835},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3731":76190,"_31485":76183,"_5":31809,"_21804":129837,"_28646":129838,"_3122":129839},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3731":76191,"_31485":76183,"_5":31809,"_21804":129841,"_28646":129842,"_3122":59929},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3731":76192,"_31485":76183,"_5":31809,"_21804":129844,"_28646":129845,"_3122":129846},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3731":76193,"_31485":76183,"_5":31809,"_21804":129848,"_28646":129849,"_3122":129850},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3731":76194,"_31485":76183,"_5":31809,"_21804":129852,"_28646":129853,"_3122":129854},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3731":76195,"_31485":76183,"_5":31809,"_21804":129856,"_28646":129857,"_3122":122108},[],"/docs/es/upgrades/3-8-0-to-4-0-0#credenciales-en-secrets-de-kubernetes",{"_3731":76196,"_31485":76183,"_5":31809,"_21804":129859,"_28646":129860,"_3122":129861},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3731":76197,"_31485":76183,"_5":31809,"_21804":129863,"_28646":129864,"_3122":129865},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3731":76198,"_31485":76183,"_5":31809,"_21804":129867,"_28646":129868,"_3122":129869},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3731":76199,"_31485":76183,"_5":31809,"_21804":129871,"_28646":129872,"_3122":129873},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3731":76200,"_31485":76183,"_5":31809,"_21804":129875,"_28646":129876,"_3122":129877},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3731":76201,"_31485":76183,"_5":31809,"_21804":129879,"_28646":129880,"_3122":129881},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3731":76202,"_31485":76183,"_5":31809,"_21804":129883,"_28646":129884,"_3122":129885},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3731":76203,"_31485":76183,"_5":31809,"_21804":129887,"_28646":129888,"_3122":129889},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3731":76204,"_31485":76183,"_5":31809,"_21804":129891,"_28646":129892,"_3122":129893},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3731":76205,"_31485":76183,"_5":31809,"_21804":129895,"_28646":129896,"_3122":129897},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-ajustes-de-crl","Referencias entre certificados, claves y ajustes de CRL",{"_3731":76206,"_31485":76183,"_5":31809,"_21804":129899,"_28646":129900,"_3122":129901},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3731":76207,"_31485":76183,"_5":31809,"_21804":129903,"_28646":129904,"_3122":129905},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3731":76208,"_31485":76183,"_5":31809,"_21804":129907,"_28646":129908,"_3122":129909},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3731":76209,"_31485":76183,"_5":31809,"_21804":129911,"_28646":129912,"_3122":129913},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobaciones-de-revocación-que-fallan-cerradas","Comprobaciones de revocación que fallan cerradas",{"_3731":76210,"_31485":76183,"_5":31809,"_21804":129915,"_28646":129916,"_3122":129917},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3731":76211,"_31485":76183,"_5":31809,"_21804":129919,"_28646":129920,"_3122":129921},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3731":76212,"_31485":76183,"_5":31809,"_21804":129923,"_28646":129924,"_3122":129925},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3731":76213,"_31485":76183,"_5":31809,"_21804":129927,"_28646":129928,"_3122":129929},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3731":76214,"_31485":76183,"_5":31809,"_21804":129931,"_28646":129932,"_3122":129933},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-de-la-crl","Campo firmante de la CRL",{"_3731":76215,"_31485":76183,"_5":31809,"_21804":129935,"_28646":129936,"_3122":129937},[],"/docs/es/upgrades/3-8-0-to-4-0-0#ajustes-de-crl-indexados-por-id-de-ca","Ajustes de CRL indexados por ID de CA",{"_3731":76216,"_31485":76183,"_5":31809,"_21804":129939,"_28646":129940,"_3122":129941},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-va-renombrados","Eventos de VA renombrados",{"_3731":76217,"_31485":76183,"_5":31809,"_21804":129943,"_28646":129944,"_3122":129945},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eliminación-de-los-endpoints-de-firma-arbitraria-de-la-ca","Eliminación de los endpoints de firma arbitraria de la CA",{"_3731":76218,"_31485":76183,"_5":31809,"_21804":129947,"_28646":129948,"_3122":129949},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-ids-de-ca-los-asigna-siempre-el-backend","Los IDs de CA los asigna siempre el backend",{"_3731":76219,"_31485":76183,"_5":31809,"_21804":129951,"_28646":129952,"_3122":129953},[],"/docs/es/upgrades/3-8-0-to-4-0-0#endpoints-de-firma-de-ca-eliminados","Endpoints de firma de CA eliminados",{"_3731":76220,"_31485":76183,"_5":31809,"_21804":129955,"_28646":129956,"_3122":129957},[],"/docs/es/upgrades/3-8-0-to-4-0-0#firmante-de-crl-de-la-va","Firmante de CRL de la VA",{"_3731":76221,"_31485":76183,"_5":31809,"_21804":129959,"_28646":129960,"_3122":129961},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3731":76222,"_31485":76183,"_5":31809,"_21804":129963,"_28646":129964,"_3122":129965},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3731":76223,"_31485":76183,"_5":31809,"_21804":129967,"_28646":129968,"_3122":129969},[],"/docs/es/upgrades/3-8-0-to-4-0-0#comprobación-previa-a-la-actualización","Comprobación previa a la actualización",{"_3731":76224,"_31485":76183,"_5":31809,"_21804":129971,"_28646":129972,"_3122":129973},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3731":76225,"_31485":76183,"_5":31809,"_21804":129975,"_28646":129976,"_3122":129977},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3731":76226,"_31485":76183,"_5":31809,"_21804":129979,"_28646":129980,"_3122":129981},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3731":76227,"_31485":76183,"_5":31809,"_21804":129983,"_28646":129984,"_3122":129985},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3731":76228,"_31485":76183,"_5":31809,"_21804":129987,"_28646":129988,"_3122":129989},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3731":76229,"_31485":76183,"_5":31809,"_21804":129991,"_28646":129992,"_3122":125703},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3731":76230,"_31485":76183,"_5":31809,"_21804":129994,"_28646":129995,"_3122":129996},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3731":76231,"_31485":76183,"_5":31809,"_21804":129998,"_28646":129999,"_3122":130000},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3731":76232,"_31485":76183,"_21804":130002,"_5":15036,"_28646":76183,"_3122":130003},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3731":76233,"_31485":76183,"_21804":130005,"_5":15036,"_28646":76183,"_3122":130006},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3731":76234,"_31485":76183,"_21804":130008,"_5":15036,"_28646":76183,"_3122":130009},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3731":76235,"_31485":76183,"_21804":130011,"_5":15036,"_28646":76183,"_3122":130012},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3731":76236,"_31485":76183,"_21804":130014,"_5":15036,"_28646":76183,"_3122":130015},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3731":76237,"_31485":76183,"_21804":130017,"_5":15036,"_28646":76183,"_3122":130018},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3731":76238,"_31485":76183,"_21804":130020,"_5":15036,"_28646":76183,"_3122":130021},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3731":76239,"_31485":76183,"_21804":130023,"_5":15036,"_28646":129822,"_3122":130024},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3731":76240,"_31485":76183,"_21804":130026,"_5":15036,"_28646":129822,"_3122":130027},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3731":76241,"_31485":76183,"_21804":130029,"_5":15036,"_28646":129826,"_3122":130030},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3731":76242,"_31485":76183,"_21804":130032,"_5":15036,"_28646":129826,"_3122":130033},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y ajustes de CRL. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3731":76243,"_31485":76183,"_21804":130035,"_5":15036,"_28646":129830,"_3122":130036},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP, que en AMQP el broker elimina automáticamente cuando la instancia se detiene (véase Eventos de dispositivo).",{"_3731":76244,"_31485":76183,"_21804":130038,"_5":15036,"_28646":129834,"_3122":130039},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3731":76245,"_31485":76183,"_21804":130041,"_5":15036,"_28646":129834,"_3122":130042},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3731":76246,"_31485":76183,"_21804":130044,"_5":15036,"_28646":129834,"_3122":130045},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3731":76247,"_31485":76183,"_21804":130047,"_5":15036,"_28646":129834,"_3122":130048},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3731":76248,"_31485":76183,"_21804":130050,"_5":15036,"_28646":129834,"_3122":130051},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3731":76249,"_31485":76183,"_21804":130053,"_5":15036,"_28646":129838,"_3122":130054},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3731":76250,"_31485":76183,"_21804":130056,"_5":15036,"_28646":129838,"_3122":130057},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3731":76251,"_31485":76183,"_21804":130059,"_5":15036,"_28646":129838,"_3122":130060},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3731":76252,"_31485":76183,"_21804":130062,"_5":15036,"_28646":129838,"_3122":130063},[],"La migración del KMS elimina los metadatos de clave obsoletos `lamassu.io/kms/binded-resources`, y la migración de la VA resuelve el firmante de CRL de cada rol (consulta Firmante de CRL de la VA).",{"_3731":76253,"_31485":76183,"_21804":130065,"_5":15036,"_28646":129838,"_3122":130066},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3731":76254,"_31485":76183,"_21804":130068,"_5":15036,"_28646":129838,"_3122":130069},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3731":76255,"_31485":76183,"_21804":130071,"_5":15036,"_28646":129842,"_3122":130072},[],"Cambio",{"_3731":76256,"_31485":76183,"_21804":130074,"_5":15036,"_28646":129842,"_3122":130075},[],"A quién afecta",{"_3731":76257,"_31485":76183,"_21804":130077,"_5":15036,"_28646":129842,"_3122":130078},[],"Gravedad",{"_3731":76258,"_31485":76183,"_21804":130080,"_5":15036,"_28646":129842,"_3122":128514},[],{"_3731":76259,"_31485":76183,"_21804":130082,"_5":15036,"_28646":129842,"_3122":129850},[],{"_3731":76260,"_31485":76183,"_21804":130084,"_5":15036,"_28646":129842,"_3122":130085},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3731":76261,"_31485":76183,"_21804":130087,"_5":15036,"_28646":129842,"_3122":130088},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3731":76262,"_31485":76183,"_21804":130090,"_5":15036,"_28646":129842,"_3122":130091},[],"Copiar los datos a los volúmenes nuevos",{"_3731":76263,"_31485":76183,"_21804":130093,"_5":15036,"_28646":129842,"_3122":129854},[],{"_3731":76264,"_31485":76183,"_21804":130095,"_5":15036,"_28646":129842,"_3122":130096},[],"Todas las releases de Helm",{"_3731":76265,"_31485":76183,"_21804":130098,"_5":15036,"_28646":129842,"_3122":130099},[],"Alta: `helm upgrade` falla",{"_3731":76266,"_31485":76183,"_21804":130101,"_5":15036,"_28646":129842,"_3122":130102},[],"Eliminar o renombrar las claves heredadas",{"_3731":76267,"_31485":76183,"_21804":130104,"_5":15036,"_28646":129842,"_3122":122108},[],{"_3731":76268,"_31485":76183,"_21804":130106,"_5":15036,"_28646":129842,"_3122":130096},[],{"_3731":76269,"_31485":76183,"_21804":130108,"_5":15036,"_28646":129842,"_3122":130109},[],"Alta: `helm upgrade` falla con credenciales inline",{"_3731":76270,"_31485":76183,"_21804":130111,"_5":15036,"_28646":129842,"_3122":130112},[],"Crear primero los Secrets; consulta el paso 2",{"_3731":76271,"_31485":76183,"_21804":130114,"_5":15036,"_28646":129842,"_3122":129861},[],{"_3731":76272,"_31485":76183,"_21804":130116,"_5":15036,"_28646":129842,"_3122":130117},[],"Todos los despliegues",{"_3731":76273,"_31485":76183,"_21804":130119,"_5":15036,"_28646":129842,"_3122":130120},[],"Alta: sin principal de bootstrap no hay administrador",{"_3731":76274,"_31485":76183,"_21804":130122,"_5":15036,"_28646":129842,"_3122":130123},[],"Configurar `services.authz`",{"_3731":76275,"_31485":76183,"_21804":130125,"_5":15036,"_28646":129842,"_3122":129865},[],{"_3731":76276,"_31485":76183,"_21804":130127,"_5":15036,"_28646":129842,"_3122":130096},[],{"_3731":76277,"_31485":76183,"_21804":130129,"_5":15036,"_28646":129842,"_3122":130130},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3731":76278,"_31485":76183,"_21804":130132,"_5":15036,"_28646":129842,"_3122":130133},[],"Mover JWKS y roles a `services.authz`",{"_3731":76279,"_31485":76183,"_21804":130135,"_5":15036,"_28646":129842,"_3122":129885},[],{"_3731":76280,"_31485":76183,"_21804":130137,"_5":15036,"_28646":129842,"_3122":130138},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3731":76281,"_31485":76183,"_21804":130140,"_5":15036,"_28646":129842,"_3122":130141},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3731":76282,"_31485":76183,"_21804":130143,"_5":15036,"_28646":129842,"_3122":130144},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3731":76283,"_31485":76183,"_21804":130146,"_5":15036,"_28646":129842,"_3122":129889},[],{"_3731":76284,"_31485":76183,"_21804":130148,"_5":15036,"_28646":129842,"_3122":130149},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3731":76285,"_31485":76183,"_21804":130151,"_5":15036,"_28646":129842,"_3122":130152},[],"Alta: el backend ya no arranca con ellos",{"_3731":76286,"_31485":76183,"_21804":130154,"_5":15036,"_28646":129842,"_3122":130155},[],"Pasar a PostgreSQL antes de actualizar",{"_3731":76287,"_31485":76183,"_21804":130157,"_5":15036,"_28646":129842,"_3122":129937},[],{"_3731":76288,"_31485":76183,"_21804":130159,"_5":15036,"_28646":129842,"_3122":130160},[],"Todos los despliegues; también afecta a clientes de API, políticas personalizadas y suscripciones de alertas",{"_3731":76289,"_31485":76183,"_21804":130162,"_5":15036,"_28646":129842,"_3122":130163},[],"Alta: se eliminan las rutas `/v1/roles` y la migración es irreversible",{"_3731":76290,"_31485":76183,"_21804":130165,"_5":15036,"_28646":129842,"_3122":130166},[],"Corregir los datos en los que aborta la migración y hacer copia de la base de datos y del bucket de CRLs",{"_3731":76291,"_31485":76183,"_21804":130168,"_5":15036,"_28646":129842,"_3122":130169},[],"Webhooks con referencias a archivos",{"_3731":76292,"_31485":76183,"_21804":130171,"_5":15036,"_28646":129842,"_3122":130172},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3731":76293,"_31485":76183,"_21804":130174,"_5":15036,"_28646":129842,"_3122":130175},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3731":76294,"_31485":76183,"_21804":130177,"_5":15036,"_28646":129842,"_3122":130178},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3731":76295,"_31485":76183,"_21804":130180,"_5":15036,"_28646":129842,"_3122":129869},[],{"_3731":76296,"_31485":76183,"_21804":130182,"_5":15036,"_28646":129842,"_3122":130183},[],"Releases con identidades por servicio o material de claves montado",{"_3731":76297,"_31485":76183,"_21804":130185,"_5":15036,"_28646":129842,"_3122":130186},[],"Media: los servicios no pueden leer sus archivos",{"_3731":76298,"_31485":76183,"_21804":130188,"_5":15036,"_28646":129842,"_3122":130189},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3731":76299,"_31485":76183,"_21804":130191,"_5":15036,"_28646":129842,"_3122":129873},[],{"_3731":76300,"_31485":76183,"_21804":130193,"_5":15036,"_28646":129842,"_3122":130194},[],"Releases que definen `amqp.tls`",{"_3731":76301,"_31485":76183,"_21804":130196,"_5":15036,"_28646":129842,"_3122":130197},[],"Media: los clientes se conectan al puerto equivocado",{"_3731":76302,"_31485":76183,"_21804":130199,"_5":15036,"_28646":129842,"_3122":130200},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3731":76303,"_31485":76183,"_21804":130202,"_5":15036,"_28646":129842,"_3122":129893},[],{"_3731":76304,"_31485":76183,"_21804":130204,"_5":15036,"_28646":129842,"_3122":130205},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3731":76305,"_31485":76183,"_21804":130207,"_5":15036,"_28646":129842,"_3122":130208},[],"Media: las claves de CA quedan sin gestionar",{"_3731":76306,"_31485":76183,"_21804":130210,"_5":15036,"_28646":129842,"_3122":130211},[],"Ejecutar la migración de CA a KMS",{"_3731":76307,"_31485":76183,"_21804":130213,"_5":15036,"_28646":129842,"_3122":130214},[],"Verificación del certificado del receptor",{"_3731":76308,"_31485":76183,"_21804":130216,"_5":15036,"_28646":129842,"_3122":130217},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3731":76309,"_31485":76183,"_21804":130219,"_5":15036,"_28646":129842,"_3122":130220},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3731":76310,"_31485":76183,"_21804":130222,"_5":15036,"_28646":129842,"_3122":130223},[],"Poner `insecure_skip_verify` a `false`",{"_3731":76311,"_31485":76183,"_21804":130225,"_5":15036,"_28646":129842,"_3122":129909},[],{"_3731":76312,"_31485":76183,"_21804":130227,"_5":15036,"_28646":129842,"_3122":130228},[],"Scripts y consolas que editan DMS por API",{"_3731":76313,"_31485":76183,"_21804":130230,"_5":15036,"_28646":129842,"_3122":130231},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3731":76314,"_31485":76183,"_21804":130233,"_5":15036,"_28646":129842,"_3122":130234},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3731":76315,"_31485":76183,"_21804":130236,"_5":15036,"_28646":129842,"_3122":129913},[],{"_3731":76316,"_31485":76183,"_21804":130238,"_5":15036,"_28646":129842,"_3122":130239},[],"Todos los despliegues con dispositivos que presentan certificados no gestionados por Lamassu",{"_3731":76317,"_31485":76183,"_21804":130241,"_5":15036,"_28646":129842,"_3122":130242},[],"Media: el enrolamiento o el reenrolamiento de esos dispositivos falla",{"_3731":76318,"_31485":76183,"_21804":130244,"_5":15036,"_28646":129842,"_3122":130245},[],"Poner `allow_unverifiable_revocation` a `true` en los bloques DMS afectados, o asegurarse de que los certificados llevan puntos de distribución OCSP/CRL alcanzables",{"_3731":76319,"_31485":76183,"_21804":130247,"_5":15036,"_28646":129842,"_3122":129933},[],{"_3731":76320,"_31485":76183,"_21804":130249,"_5":15036,"_28646":129842,"_3122":130250},[],"Clientes que crean o actualizan ajustes de CRL por API",{"_3731":76321,"_31485":76183,"_21804":130252,"_5":15036,"_28646":129842,"_3122":130253},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3731":76322,"_31485":76183,"_21804":130255,"_5":15036,"_28646":129842,"_3122":130256},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_serial_number`",{"_3731":76323,"_31485":76183,"_21804":130258,"_5":15036,"_28646":129842,"_3122":129941},[],{"_3731":76324,"_31485":76183,"_21804":130260,"_5":15036,"_28646":129842,"_3122":130261},[],"Suscripciones de alertas y consumidores de los eventos de la VA",{"_3731":76325,"_31485":76183,"_21804":130263,"_5":15036,"_28646":129842,"_3122":130264},[],"Media: los tipos de suscripción se renombran automáticamente, sus condiciones no",{"_3731":76326,"_31485":76183,"_21804":130266,"_5":15036,"_28646":129842,"_3122":130267},[],"Revisar las condiciones que filtran por el payload o el subject antiguo del evento",{"_3731":76327,"_31485":76183,"_21804":130269,"_5":15036,"_28646":129842,"_3122":129945},[],{"_3731":76328,"_31485":76183,"_21804":130271,"_5":15036,"_28646":129842,"_3122":130272},[],"Clientes que firman o verifican datos arbitrarios con la API o el SDK de Go de la CA, y suscripciones de alertas al evento `ca.sign.signature`",{"_3731":76329,"_31485":76183,"_21804":130274,"_5":15036,"_28646":129842,"_3122":130275},[],"Media: los endpoints, los métodos del SDK y el evento dejan de existir",{"_3731":76330,"_31485":76183,"_21804":130277,"_5":15036,"_28646":129842,"_3122":130278},[],"Firmar y verificar con claves del KMS; eliminar las suscripciones al evento",{"_3731":76331,"_31485":76183,"_21804":130280,"_5":15036,"_28646":129842,"_3122":129929},[],{"_3731":76332,"_31485":76183,"_21804":130282,"_5":15036,"_28646":129842,"_3122":130283},[],"Consumidores que leen el campo `events` del dispositivo",{"_3731":76333,"_31485":76183,"_21804":130285,"_5":15036,"_28646":129842,"_3122":130286},[],"Media: el campo desaparece",{"_3731":76334,"_31485":76183,"_21804":130288,"_5":15036,"_28646":129842,"_3122":130289},[],"Usar los nuevos endpoints de eventos",{"_3731":76335,"_31485":76183,"_21804":130291,"_5":15036,"_28646":129842,"_3122":129957},[],{"_3731":76336,"_31485":76183,"_21804":130293,"_5":15036,"_28646":129842,"_3122":130294},[],"Despliegues con roles VA cuyo firmante no puede resolverse de forma única",{"_3731":76337,"_31485":76183,"_21804":130296,"_5":15036,"_28646":129842,"_3122":130297},[],"Media: la migración de la VA aborta",{"_3731":76338,"_31485":76183,"_21804":130299,"_5":15036,"_28646":129842,"_3122":130300},[],"Corregir los roles afectados antes de actualizar",{"_3731":76339,"_31485":76183,"_21804":130302,"_5":15036,"_28646":129842,"_3122":129877},[],{"_3731":76340,"_31485":76183,"_21804":130304,"_5":15036,"_28646":129842,"_3122":130305},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3731":76341,"_31485":76183,"_21804":130307,"_5":15036,"_28646":129842,"_3122":130308},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3731":76342,"_31485":76183,"_21804":130310,"_5":15036,"_28646":129842,"_3122":130311},[],"Actualizar el archivo de values",{"_3731":76343,"_31485":76183,"_21804":130313,"_5":15036,"_28646":129842,"_3122":129921},[],{"_3731":76344,"_31485":76183,"_21804":130315,"_5":15036,"_28646":129842,"_3122":130316},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3731":76345,"_31485":76183,"_21804":130318,"_5":15036,"_28646":129842,"_3122":130319},[],"Baja: prevalece el ID de la URL",{"_3731":76346,"_31485":76183,"_21804":130321,"_5":15036,"_28646":129842,"_3122":130322},[],"Enviar el ID en la URL",{"_3731":76347,"_31485":76183,"_21804":130324,"_5":15036,"_28646":129842,"_3122":129949},[],{"_3731":76348,"_31485":76183,"_21804":130326,"_5":15036,"_28646":129842,"_3122":130327},[],"Clientes que envían un `id` al crear o importar CAs",{"_3731":76349,"_31485":76183,"_21804":130329,"_5":15036,"_28646":129842,"_3122":130330},[],"Baja: el ID del cuerpo se ignora y el campo desaparece",{"_3731":76350,"_31485":76183,"_21804":130332,"_5":15036,"_28646":129842,"_3122":130333},[],"Dejar que el backend asigne el ID y usar el que devuelve",{"_3731":76351,"_31485":76183,"_21804":130335,"_5":15036,"_28646":129842,"_3122":129953},[],{"_3731":76352,"_31485":76183,"_21804":130337,"_5":15036,"_28646":129842,"_3122":130338},[],"Clientes de API y SDK que llaman a `/v1/cas/{id}/signature/sign` o `/verify`, y suscripciones de alertas sobre `ca.sign.signature`",{"_3731":76353,"_31485":76183,"_21804":130340,"_5":15036,"_28646":129842,"_3122":130341},[],"Media: las llamadas devuelven `404` y las suscripciones no se disparan nunca",{"_3731":76354,"_31485":76183,"_21804":130343,"_5":15036,"_28646":129842,"_3122":130344},[],"Utilizar las operaciones `sign` y `verify` del KMS",{"_3731":76355,"_31485":76183,"_21804":130346,"_5":15036,"_28646":129842,"_3122":129925},[],{"_3731":76356,"_31485":76183,"_21804":130348,"_5":15036,"_28646":129842,"_3122":130349},[],"Consumidores que comparan el `type` del certificado",{"_3731":76357,"_31485":76183,"_21804":130351,"_5":15036,"_28646":129842,"_3122":130352},[],"Baja: dos valores cambian de nombre",{"_3731":76358,"_31485":76183,"_21804":130354,"_5":15036,"_28646":129842,"_3122":130355},[],"Adaptar los consumidores",{"_3731":76359,"_31485":76183,"_21804":130357,"_5":15036,"_28646":129842,"_3122":129917},[],{"_3731":76360,"_31485":76183,"_21804":130359,"_5":15036,"_28646":129842,"_3122":130360},[],"Cualquier DMS",{"_3731":76361,"_31485":76183,"_21804":130362,"_5":15036,"_28646":129842,"_3122":130363},[],"Baja: solo informativo",{"_3731":76362,"_31485":76183,"_21804":130365,"_5":15036,"_28646":129842,"_3122":130366},[],"Revisar ambos bloques antes de editar",{"_3731":76363,"_31485":76183,"_21804":130368,"_5":15036,"_28646":129849,"_3122":130369},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3731":76364,"_31485":76183,"_21804":130371,"_5":15036,"_28646":129849,"_3122":130372},[],"El paso 4 de la guía de migración copia los datos.",{"_3731":76365,"_31485":76183,"_21804":130374,"_5":15036,"_28646":129853,"_3122":130375},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3731":76366,"_31485":76183,"_21804":130377,"_5":15036,"_28646":129857,"_3122":130378},[],"En 4.0.0 el chart lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes en el namespace del release en lugar de valores inline: `postgres.existingSecret`, `amqp.existingSecret` y — cuando hay autenticación SMTP configurada — `services.alerts.smtp_server.existingSecret`, cada uno con `usernameKey` y `passwordKey` nombrando las claves de datos del Secret. Los valores inline `postgres.username`/`postgres.password` y `amqp.username`/`amqp.password` se eliminan y `values.schema.json` los rechaza, así que un archivo de values de 3.8.0 hace fallar `helm lint` y `helm upgrade` hasta que las credenciales pasen a Secrets.",{"_3731":76367,"_31485":76183,"_21804":130380,"_5":15036,"_28646":129857,"_3122":130381},[],"Los Secrets deben existir antes de ejecutar `helm upgrade`: el job de base de datos de pre-upgrade se conecta a PostgreSQL con ellos. El paso 2 los crea mediante el External Secrets Operator.",{"_3731":76368,"_31485":76183,"_21804":130383,"_5":15036,"_28646":129860,"_3122":130384},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3731":76369,"_31485":76183,"_21804":130386,"_5":15036,"_28646":129864,"_3122":130387},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3731":76370,"_31485":76183,"_21804":130389,"_5":15036,"_28646":129868,"_3122":130390},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3731":76371,"_31485":76183,"_21804":130392,"_5":15036,"_28646":129868,"_3122":130393},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3731":76372,"_31485":76183,"_21804":130395,"_5":15036,"_28646":129868,"_3122":130396},[],"Los pods llevan ahora un `fsGroup: 65532` a nivel de pod con `fsGroupChangePolicy: OnRootMismatch`, que se salta los cambios recursivos de propiedad cuando la raíz del volumen ya tiene el grupo esperado. Si tus herramientas de backup o jobs usan otro GID, verifica que sigan pudiendo acceder a los volúmenes que necesitan.",{"_3731":76373,"_31485":76183,"_21804":130398,"_5":15036,"_28646":129872,"_3122":130399},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3731":76374,"_31485":76183,"_21804":130401,"_5":15036,"_28646":129876,"_3122":130402},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3731":76375,"_31485":76183,"_21804":130404,"_5":15036,"_28646":129876,"_3122":130405},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3731":76376,"_31485":76183,"_21804":130407,"_5":15036,"_28646":129876,"_3122":130408},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3731":76377,"_31485":76183,"_21804":130410,"_5":15036,"_28646":129876,"_3122":130411},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3731":76378,"_31485":76183,"_21804":130413,"_5":15036,"_28646":129876,"_3122":130414},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3731":76379,"_31485":76183,"_21804":130416,"_5":15036,"_28646":129876,"_3122":130417},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3731":76380,"_31485":76183,"_21804":130419,"_5":15036,"_28646":129884,"_3122":130420},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3731":76381,"_31485":76183,"_21804":130422,"_5":15036,"_28646":129884,"_3122":130423},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3731":76382,"_31485":76183,"_21804":130425,"_5":15036,"_28646":129884,"_3122":130426},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3731":76383,"_31485":76183,"_21804":130428,"_5":15036,"_28646":129884,"_3122":130429},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3731":76384,"_31485":76183,"_21804":130431,"_5":15036,"_28646":129884,"_3122":130432},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3731":76385,"_31485":76183,"_21804":130434,"_5":15036,"_28646":129888,"_3122":130435},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3731":76386,"_31485":76183,"_21804":130437,"_5":15036,"_28646":129892,"_3122":130438},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3731":76387,"_31485":76183,"_21804":130440,"_5":15036,"_28646":129892,"_3122":130441},[],"El `key_id` es el `subject_key_id` del certificado; solo coincide con el resumen SHA-256 de la clave pública si el SKI se calculó de esa forma.",{"_3731":76388,"_31485":76183,"_21804":130443,"_5":15036,"_28646":129892,"_3122":130444},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3731":76389,"_31485":76183,"_21804":130446,"_5":15036,"_28646":129892,"_3122":130447},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3731":76390,"_31485":76183,"_21804":130449,"_5":15036,"_28646":129892,"_3122":130450},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3731":76391,"_31485":76183,"_21804":130452,"_5":15036,"_28646":129892,"_3122":130453},[],"Una vez registradas las claves, los certificados las referencian en la base de datos y el KMS se niega a eliminar una clave que un certificado aún usa (`409` `key is in use`). Eliminar el registro de un certificado lo quita de la CRL y de OCSP, así que lee Antes de eliminar una clave antes de liberar una clave.",{"_3731":76392,"_31485":76183,"_21804":130455,"_5":15036,"_28646":129892,"_3122":130456},[],"Opcionalmente, las instalaciones con CAs importadas anteriores a 3.7 pueden arrancar el KMS una vez con `crypto_engines.migrate_keys_format: true`: el KMS renombra esas claves heredadas con nombre de SKI al resumen SHA-256 de su clave pública (el nombre antiguo se conserva como alias, y las referencias de los certificados se actualizan solas). Ejecútalo una vez y vuelve a desactivar la opción; repetirla es seguro.",{"_3731":76393,"_31485":76183,"_21804":130458,"_5":15036,"_28646":129892,"_3122":130459},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3731":76394,"_31485":76183,"_21804":130461,"_5":15036,"_28646":129896,"_3122":130462},[],"Los certificados referencian ahora su clave del KMS, y los ajustes de CRL referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3731":76395,"_31485":76183,"_21804":130464,"_5":15036,"_28646":129904,"_3122":130465},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3731":76396,"_31485":76183,"_21804":130467,"_5":15036,"_28646":129904,"_3122":130468},[],"Campo en 3.8.0",{"_3731":76397,"_31485":76183,"_21804":130470,"_5":15036,"_28646":129904,"_3122":130471},[],"Campo en 4.0.0",{"_3731":76398,"_31485":76183,"_21804":130473,"_5":15036,"_28646":129904,"_3122":60560},[],{"_3731":76399,"_31485":76183,"_21804":130475,"_5":15036,"_28646":129904,"_3122":130476},[],"`insecure_skip_verify` (con el valor negado)",{"_3731":76400,"_31485":76183,"_21804":130478,"_5":15036,"_28646":129904,"_3122":60566},[],{"_3731":76401,"_31485":76183,"_21804":130480,"_5":15036,"_28646":129904,"_3122":60569},[],{"_3731":76402,"_31485":76183,"_21804":130482,"_5":15036,"_28646":129904,"_3122":60572},[],{"_3731":76403,"_31485":76183,"_21804":130484,"_5":15036,"_28646":129904,"_3122":60575},[],{"_3731":76404,"_31485":76183,"_21804":130486,"_5":15036,"_28646":129904,"_3122":60578},[],{"_3731":76405,"_31485":76183,"_21804":130488,"_5":15036,"_28646":129904,"_3122":60581},[],{"_3731":76406,"_31485":76183,"_21804":130490,"_5":15036,"_28646":129904,"_3122":130491},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3731":76407,"_31485":76183,"_21804":130493,"_5":15036,"_28646":129904,"_3122":130494},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3731":76408,"_31485":76183,"_21804":130496,"_5":15036,"_28646":129904,"_3122":130497},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3731":76409,"_31485":76183,"_21804":130499,"_5":15036,"_28646":129908,"_3122":130500},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3731":76410,"_31485":76183,"_21804":130502,"_5":15036,"_28646":129908,"_3122":130503},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3731":76411,"_31485":76183,"_21804":130505,"_5":15036,"_28646":129908,"_3122":130506},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3731":76412,"_31485":76183,"_21804":130508,"_5":15036,"_28646":129912,"_3122":130509},[],"El enrolamiento y el reenrolamiento comprueban ahora la revocación de los certificados presentados y fallan cerrados cuando no puede verificarse. No hay migración: todo DMS preexistente tiene la nueva opción `allow_unverifiable_revocation` con su valor por defecto `false`, así que un certificado que no gestiona Lamassu y no lleva puntos de distribución OCSP o CRL se rechaza hasta que la opción se ponga a `true` en el bloque afectado, de forma independiente en el bloque de enrolamiento y en el de reenrolamiento.",{"_3731":76413,"_31485":76183,"_21804":130511,"_5":15036,"_28646":129912,"_3122":130512},[],"Los certificados que sí llevan endpoints siguen comprobándose con rigor: los endpoints que no responden o devuelven respuestas caducadas o no concluyentes rechazan el certificado aunque `allow_unverifiable_revocation` esté activo, y los certificados gestionados por Lamassu no se ven afectados porque se usa su estado almacenado. Una CA de validación revocada en Lamassu también rechaza la operación, sin recurrir a las demás CAs de validación. Consulta la guía de DMS y Revocación y comprobaciones.",{"_3731":76414,"_31485":76183,"_21804":130514,"_5":15036,"_28646":129916,"_3122":130515},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3731":76415,"_31485":76183,"_21804":130517,"_5":15036,"_28646":129920,"_3122":130518},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3731":76416,"_31485":76183,"_21804":130520,"_5":15036,"_28646":129924,"_3122":130521},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3731":76417,"_31485":76183,"_21804":130523,"_5":15036,"_28646":129928,"_3122":130524},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3731":76418,"_31485":76183,"_21804":130526,"_5":15036,"_28646":129928,"_3122":130527},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3731":76419,"_31485":76183,"_21804":130529,"_5":15036,"_28646":129928,"_3122":130530},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3731":76420,"_31485":76183,"_21804":130532,"_5":15036,"_28646":129928,"_3122":130533},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. La entrega es de tipo best effort: los eventos emitidos mientras no hay ningún cliente conectado no se reenvían en la siguiente conexión. El servidor cierra cada stream tras un tiempo de vida máximo, 10 minutos por omisión y configurable con la opción `sse_max_stream_duration` de Device Manager, y el cliente se reconecta para seguir recibiendo eventos. Cuando una instancia alcanza su límite de suscriptores, configurado con la opción `sse_max_subscribers` de Device Manager (1000 por omisión y compartido por todos los streams de la instancia), los nuevos streams reciben una respuesta `503` con una cabecera `Retry-After`. Cada stream vuelve a comprobar el permiso de lectura del dispositivo mientras está activo, y lo cierra cuando el permiso se revoca o no se puede verificar; la reconexión vuelve a pasar por las comprobaciones de autorización habituales. En un despliegue con Helm, define `services.deviceManager.sseEnabled` como `false` para deshabilitar SSE (por defecto `true`); consulta Flujo de eventos de dispositivo (SSE).",{"_3731":76421,"_31485":76183,"_21804":130535,"_5":15036,"_28646":129928,"_3122":130536},[],"En AMQP, cada instancia de Device Manager enlaza una cola de suscriptores con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. La cola es duradera y auto-delete, con una expiración de una hora (`x-expires`), de modo que el broker la elimina cuando la instancia se detiene o su conexión muere, y no hace falta ninguna política de limpieza. Solo en proveedores de event bus sin soporte de suscriptores efímeros puede quedar una cola duradera por proceso tras detenerse su instancia; revisa esos proveedores si observas colas residuales.",{"_3731":76422,"_31485":76183,"_21804":130538,"_5":15036,"_28646":129932,"_3122":130539},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de una CA nueva es el número de serie de su certificado actual. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. La entidad de autorización que guarda estos ajustes también cambia de nombre; consulta Ajustes de CRL indexados por ID de CA.",{"_3731":76423,"_31485":76183,"_21804":130541,"_5":15036,"_28646":129936,"_3122":130542},[],"En 3.8.0 la VA indexaba cada CRL por el SKI de la CA, y `GET`/`PUT /v1/roles/{ca-ski}` la leían y actualizaban. En 4.0.0 los ajustes de CRL de una CA se indexan por su ID de CA, y cada CA tiene los suyos, incluso cuando dos CAs comparten clave:",{"_3731":76424,"_31485":76183,"_21804":130544,"_5":15036,"_28646":129936,"_3122":130545},[],"Ruta",{"_3731":76425,"_31485":76183,"_21804":130547,"_5":15036,"_28646":129936,"_3122":122765},[],{"_3731":76426,"_31485":76183,"_21804":130549,"_5":15036,"_28646":129936,"_3122":60643},[],{"_3731":76427,"_31485":76183,"_21804":130551,"_5":15036,"_28646":129936,"_3122":130552},[],"Lista los ajustes de CRL; filtrable al menos por `ca_id`, `status` y `legacy_ski`.",{"_3731":76428,"_31485":76183,"_21804":130554,"_5":15036,"_28646":129936,"_3122":60649},[],{"_3731":76429,"_31485":76183,"_21804":130556,"_5":15036,"_28646":129936,"_3122":130557},[],"Lee los ajustes de una CA.",{"_3731":76430,"_31485":76183,"_21804":130559,"_5":15036,"_28646":129936,"_3122":60655},[],{"_3731":76431,"_31485":76183,"_21804":130561,"_5":15036,"_28646":129936,"_3122":130562},[],"Sustituye los `crl_options`.",{"_3731":76432,"_31485":76183,"_21804":130564,"_5":15036,"_28646":129936,"_3122":60661},[],{"_3731":76433,"_31485":76183,"_21804":130566,"_5":15036,"_28646":129936,"_3122":130567},[],"Elimina los ajustes archivados de una CA.",{"_3731":76434,"_31485":76183,"_21804":130569,"_5":15036,"_28646":129936,"_3122":130570},[],"Las opciones conservan su significado y sus valores por defecto: 7 días de `validity`, 6 días y 23 horas de `refresh_interval`, y `regenerate_on_revoke` a `true`. `status` (`ACTIVE`, `FINAL` o `ARCHIVED`), `legacy_ski` y `latest_crl` son de solo lectura. Un `PUT` valida el firmante solo cuando cambia, no regenera la CRL y devuelve `409` cuando los ajustes no están `ACTIVE`.",{"_3731":76435,"_31485":76183,"_21804":130572,"_5":15036,"_28646":129936,"_3122":130573},[],"El endpoint público `GET /crl/{id}` toma el ID de la CA — la forma que usan los CDP de los certificados emitidos a partir de ahora — y sigue resolviendo la forma por SKI de los certificados emitidos antes de la actualización. Los certificados anteriores a la actualización conservan sus puntos de distribución `/crl/<ski>`; los recién emitidos llevan `/crl/<ca-id>`, y ambos resuelven a los mismos ajustes. El job de CRL de la VA solicita una lista nueva en su primera ejecución, y esta incluye ambas URLs en su *Issuing Distribution Point*. Hasta que lo consiga, la lista antigua solo contiene el IDP heredado `/crl/<ski>`: los verificadores que lo comparan con el CDP de certificados recién emitidos no pueden validar esos certificados. Con la frecuencia predeterminada, la primera ejecución puede tardar hasta aproximadamente una hora; los fallos pueden prolongar ese intervalo.",{"_3731":76436,"_31485":76183,"_21804":130575,"_5":15036,"_28646":129936,"_3122":130576},[],"La migración que convierte los roles de VA en ajustes de CRL no puede revertirse: su rollback no hace nada. Las CRLs generadas después de la actualización se guardan bajo el ID de CA, donde 3.8.0 no las busca, y los ajustes archivados de las CAs eliminadas antes de la actualización no tienen firmante al que volver. Volver a 3.8.0 exige restaurar tanto la base de datos como el bucket de CRLs — el almacenamiento de objetos que contiene las listas publicadas — a partir de las copias de seguridad tomadas antes de la actualización.",{"_3731":76437,"_31485":76183,"_21804":130578,"_5":15036,"_28646":129936,"_3122":130579},[],"La migración aborta, y con ella la actualización, con cinco tipos de datos:",{"_3731":76438,"_31485":76183,"_21804":130581,"_5":15036,"_28646":129936,"_3122":130582},[],"IDs de CA que contienen `/`: no pueden usarse en URLs de CRL. Recrea esas CAs con otro ID.",{"_3731":76439,"_31485":76183,"_21804":130584,"_5":15036,"_28646":129936,"_3122":130585},[],"Un SKI compartido por más de una CA: el error nombra los SKIs y pide recrear todas menos una con otra clave.",{"_3731":76440,"_31485":76183,"_21804":130587,"_5":15036,"_28646":129936,"_3122":130588},[],"Un rol de VA cuyo certificado firmante no tiene clave: apunta el rol a un firmante con clave, o corrige la referencia de clave del certificado, antes de actualizar.",{"_3731":76441,"_31485":76183,"_21804":130590,"_5":15036,"_28646":129936,"_3122":130591},[],"Una CA cuyo ID coincide con el ID `legacy-<ski>` que la migración reserva para los ajustes archivados de otro rol cuya CA se eliminó: recrea esa CA con otro ID.",{"_3731":76442,"_31485":76183,"_21804":130593,"_5":15036,"_28646":129936,"_3122":130594},[],"Un ID de CA igual al SKI de otro rol de VA: sus URLs de CRL serían ambiguas.",{"_3731":76443,"_31485":76183,"_21804":130596,"_5":15036,"_28646":129936,"_3122":130597},[],"Los ajustes de una CA eliminada antes de la actualización se migran como `ARCHIVED`, con un ID `legacy-<ski>` y sin firmante: su última CRL sigue sirviéndose, pero nunca se regenera, y `PUT` devuelve `409`. No hay forma de volver a `ACTIVE` por API. La guía de CRL describe el comportamiento completo.",{"_3731":76444,"_31485":76183,"_21804":130599,"_5":15036,"_28646":129936,"_3122":130600},[],"**Políticas de autorización personalizadas.** La entidad `va_role` se renombra a `crl_settings`, con `ca_id` como clave primaria y `signer_serial_number` como su relación con certificados. Actualiza las políticas que referencien la entidad antigua. La entidad incorpora la acción atómica `delete`, una relación `signer_key_id` con las claves del KMS y las columnas filtrables `signer_engine_id` y `signer_key_id`; concede la acción nueva a quien pueda borrar ajustes de CRL archivados. Sustituye el filtro de firmante de 3.8.0 `crl_subject_key_id_signer` (o `crl_signer_certificate_serial_number` si se usa en una versión intermedia) por `signer_serial_number`. Sustituye los valores SKI del filtro por los números de serie de los certificados correspondientes; cambiar solo el nombre del filtro no basta.",{"_3731":76445,"_31485":76183,"_21804":130602,"_5":15036,"_28646":129940,"_3122":130603},[],"`va.role.update` pasa a `va.crl-settings.update` y `va.role.crl.init` pasa a `va.crl-settings.init`; `va.role.crl.create` conserva su nombre y su payload. Todos los subjects cambian de `crl/<ski>` a `crl/<ca-id>`, y el payload de los eventos renombrados pasa del rol de VA antiguo a los ajustes de CRL de la CA, con `ca_id` en lugar de `ca_ski`. La migración de alerts renombra automáticamente los tipos de evento de las suscripciones existentes, pero no reescribe sus condiciones — JSON Path, JSON Schema o JavaScript: revisa las condiciones que filtren por el payload antiguo o por el subject antiguo `crl/<ski>`, incluidas las de `va.role.crl.create`. Los consumidores directos del bus de eventos y las búsquedas de auditoría deben adoptar por su cuenta los nombres y el payload nuevos.",{"_3731":76446,"_31485":76183,"_21804":130605,"_5":15036,"_28646":129944,"_3122":130606},[],"`POST /v1/cas/{id}/signature/sign` y `POST /v1/cas/{id}/signature/verify` ya no existen: el servicio de CA ya no firma ni verifica datos arbitrarios, de modo que la clave privada de una CA solo firma certificados. Los métodos `CAService.SignatureSign` y `CAService.SignatureVerify` del SDK de Go también se eliminan, y el evento `ca.sign.signature` deja de publicarse, así que las suscripciones de alertas y los consumidores del bus de eventos que se basen en él nunca vuelven a dispararse — elimina esas suscripciones y redirige a los consumidores. Firma y verifica datos arbitrarios con una clave del KMS, mediante `POST /api/kms/v1/keys/{id}/sign` y `POST /api/kms/v1/keys/{id}/verify` (en el SDK de Go, `KMSService.SignMessage` y `KMSService.VerifySignature`); el equivalente en la consola se describe en Firmar y verificar. Una CA además solo se acepta para firmar cuando su ventana de validez incluye el momento actual, aunque su estado almacenado siga mostrando `ACTIVE`.",{"_3731":76447,"_31485":76183,"_21804":130608,"_5":15036,"_28646":129948,"_3122":130609},[],"Crear o importar una CA la registra con un UUID generado por el backend. Cualquier `id` enviado en el cuerpo de la petición se ignora, y el campo desaparece de los cuerpos de creación e importación. Los scripts que enviaban su propio ID y se dirigían a la CA con él deben leer el ID que devuelve el backend.",{"_3731":76448,"_31485":76183,"_21804":130611,"_5":15036,"_28646":129952,"_3122":130612},[],"La clave de una CA ahora solo firma certificados. 3.8.0 permitía firmar datos arbitrarios con la clave de una CA mediante `POST /v1/cas/{id}/signature/sign` y comprobar el resultado con `POST /v1/cas/{id}/signature/verify`. 4.0.0 elimina ambos endpoints, los métodos `SignatureSign` y `SignatureVerify` de `CAService` en el SDK de Go y el evento `ca.sign.signature`. Una suscripción de alertas a ese evento deja de dispararse: elimínala o muévela a otro evento.",{"_3731":76449,"_31485":76183,"_21804":130614,"_5":15036,"_28646":129952,"_3122":130615},[],"Para firmar y verificar datos, utiliza las operaciones del KMS `POST /v1/keys/{id}/sign` y `POST /v1/keys/{id}/verify`, que tienen su propia autorización. Firmar un certificado con una CA que no está `ACTIVE`, o cuyo periodo de validez no incluye la hora actual, falla ahora con `400`, aunque el estado almacenado aún no haya pasado a `EXPIRED`: consulta Autoridades de certificación.",{"_3731":76450,"_31485":76183,"_21804":130617,"_5":15036,"_28646":129956,"_3122":130618},[],"La migración de la VA resuelve el firmante de cada rol a partir de su SKI guardado. Primero busca certificados de CA con ese SKI; si coinciden varios, selecciona la CA más antigua y registra un aviso. Si no coincide ningún certificado de CA, busca entre todos los certificados con ese SKI. La migración aborta con `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` si esa búsqueda encuentra cero o varios candidatos. Corrige los roles afectados antes de actualizar.",{"_3731":76451,"_31485":76183,"_21804":130620,"_5":15036,"_28646":129960,"_3122":130621},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3731":76452,"_31485":76183,"_21804":130623,"_5":15036,"_28646":129964,"_3122":130624},[],"Haz una copia de seguridad verificable de PostgreSQL y del almacenamiento de objetos de las CRLs — el bucket de la VA, o el volumen local que contiene las CRLs — y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`, y la migración de la VA es irreversible: volver a 3.8.0 requiere ambas copias (consulta Ajustes de CRL indexados por ID de CA).",{"_3731":76453,"_31485":76183,"_21804":130626,"_5":15036,"_28646":129964,"_3122":130627},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3731":76454,"_31485":76183,"_21804":130629,"_5":15036,"_28646":129964,"_3122":130630},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3731":76455,"_31485":76183,"_21804":130632,"_5":15036,"_28646":129964,"_3122":130633},[],"Opcionalmente, ejecuta la comprobación previa a la actualización sobre los datos de 3.8.0 consolidados antes de aplicar las migraciones.",{"_3731":76456,"_31485":76183,"_21804":130635,"_5":15036,"_28646":129964,"_3122":130636},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3731":76457,"_31485":76183,"_21804":130638,"_5":15036,"_28646":129964,"_3122":130639},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3731":76458,"_31485":76183,"_21804":130641,"_5":15036,"_28646":129968,"_3122":130642},[],"Las migraciones de base de datos de 4.0.0 se niegan a ejecutarse con datos que no pueden migrar de forma segura: abortan y nombran los objetos conflictivos. La herramienta `upgrade-check` informa de todos esos problemas antes de la actualización, en una única ejecución y con el mismo texto que usaría la migración. Es de solo lectura: nunca escribe filas en la base de datos ni claves.",{"_3731":76459,"_31485":76183,"_21804":130644,"_5":15036,"_28646":129968,"_3122":130645},[],"Imagen: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Se configura con un archivo YAML al estilo del KMS pasado por `LAMASSU_CONFIG_FILE`; solo admite el proveedor de almacenamiento `postgres`.",{"_3731":76460,"_31485":76183,"_21804":130647,"_5":15036,"_28646":129968,"_3122":130648},[],"Ejecútala sobre los datos de 3.8.0 una vez consolidados en los esquemas de `pki`, y antes de que se ejecute cualquier migración de 4.0.0 o arranque cualquier servicio de 4.0.0.",{"_3731":76461,"_31485":76183,"_21804":130650,"_5":15036,"_28646":129968,"_3122":130651},[],"Códigos de salida: `0` significa que no se encontraron problemas, `1` que se encontró al menos uno y `2` que la orden no pudo ejecutarse (configuración incorrecta, base de datos inalcanzable o una base de datos que no es de 3.8.0), o que alguna comprobación no pudo ejecutarse.",{"_3731":76462,"_31485":76183,"_21804":130653,"_5":15036,"_28646":129968,"_3122":130654},[],"Cubre solo las migraciones de la VA: un resultado limpio no demuestra que las comprobaciones de las migraciones de CA y del KMS vayan a pasar, así que no sustituye a las verificaciones de IDs de CA duplicados y de `engine_id` descritas en Consolidación en PostgreSQL.",{"_3731":76463,"_31485":76183,"_21804":130656,"_5":15036,"_28646":129972,"_3122":130657},[],"**Crea los Secrets de credenciales.** El chart de 4.0.0 lee las credenciales de PostgreSQL, AMQP y SMTP de Secrets de Kubernetes, y el job de base de datos de pre-upgrade las necesita antes de que se ejecute la actualización. Copia las credenciales de 3.8.0 a tu proveedor de gestión de secretos y crea los Secrets con el External Secrets Operator (ESO), que el chart no instala:",{"_3731":76464,"_31485":76183,"_21804":130659,"_5":15036,"_28646":129972,"_3122":130660},[],"Configura ESO y su proveedor (`SecretStore` o `ClusterSecretStore`).",{"_3731":76465,"_31485":76183,"_21804":130662,"_5":15036,"_28646":129972,"_3122":130663},[],"Crea un `ExternalSecret` por cada conjunto de credenciales que uses. Su Secret de destino debe vivir en el namespace de la release, llamarse como el valor `existingSecret` correspondiente y contener estas claves:",{"_3731":76466,"_31485":76183,"_21804":130665,"_5":15036,"_28646":129972,"_3122":60763},[],{"_3731":76467,"_31485":76183,"_21804":130667,"_5":15036,"_28646":129972,"_3122":130668},[],"Claves de datos obligatorias",{"_3731":76468,"_31485":76183,"_21804":130670,"_5":15036,"_28646":129972,"_3122":130671},[],"Cuándo",{"_3731":76469,"_31485":76183,"_21804":130673,"_5":15036,"_28646":129972,"_3122":130674},[],"`lamassu-postgres` (por defecto de `postgres.existingSecret`)",{"_3731":76470,"_31485":76183,"_21804":130676,"_5":15036,"_28646":129972,"_3122":60775},[],{"_3731":76471,"_31485":76183,"_21804":130678,"_5":15036,"_28646":129972,"_3122":130679},[],"Siempre",{"_3731":76472,"_31485":76183,"_21804":130681,"_5":15036,"_28646":129972,"_3122":130682},[],"`lamassu-amqp` (por defecto de `amqp.existingSecret`)",{"_3731":76473,"_31485":76183,"_21804":130684,"_5":15036,"_28646":129972,"_3122":60775},[],{"_3731":76474,"_31485":76183,"_21804":130686,"_5":15036,"_28646":129972,"_3122":130679},[],{"_3731":76475,"_31485":76183,"_21804":130688,"_5":15036,"_28646":129972,"_3122":60788},[],{"_3731":76476,"_31485":76183,"_21804":130690,"_5":15036,"_28646":129972,"_3122":60775},[],{"_3731":76477,"_31485":76183,"_21804":130692,"_5":15036,"_28646":129972,"_3122":130693},[],"Solo cuando hay autenticación SMTP",{"_3731":76478,"_31485":76183,"_21804":130695,"_5":15036,"_28646":129972,"_3122":130696},[],"Espera a que cada `ExternalSecret` esté Ready y verifica los Secrets generados antes de ejecutar la actualización.",{"_3731":76479,"_31485":76183,"_21804":130698,"_5":15036,"_28646":129972,"_3122":130699},[],"No cambies las contraseñas de la base de datos ni del broker como parte de esta migración: ESO sincroniza credenciales en Secrets, pero no actualiza los usuarios configurados en el servidor PostgreSQL ni en el broker. Quitar credenciales del archivo de values no deshace la exposición previa — si se llegaron a subir a Git, rotarlas cuando la migración se haya completado.",{"_3731":76480,"_31485":76183,"_21804":130701,"_5":15036,"_28646":129972,"_3122":130702},[],"El `charts/lamassu/README.md` del repositorio Helm documenta en su sección *Secret management* un ejemplo completo y funcional: instalar external-secrets 0.20.2, un `ClusterSecretStore` Fake de prueba, los recursos `ExternalSecret` y la espera de la sincronización. Su proveedor Fake es solo para pruebas; para producción, sustitúyelo por la configuración de tu proveedor.",{"_3731":76481,"_31485":76183,"_21804":130704,"_5":15036,"_28646":129972,"_3122":130705},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3731":76482,"_31485":76183,"_21804":130707,"_5":15036,"_28646":129972,"_3122":130708},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3731":76483,"_31485":76183,"_21804":130710,"_5":15036,"_28646":129972,"_3122":130711},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se exige el campo `database` de cada entrada; los `hostname` y `port` por esquema se siguen aceptando pero se ignoran — la conexión usa siempre los `postgres.hostname` y `postgres.port` globales con el Secret de credenciales de PostgreSQL global, `postgres.existingSecret` con sus nombres de clave configurados, salvo que la entrada defina su propio `existingSecret` (con `usernameKey` y `passwordKey` opcionales).",{"_3731":76484,"_31485":76183,"_21804":130713,"_5":15036,"_28646":129972,"_3122":130714},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3731":76485,"_31485":76183,"_21804":130716,"_5":15036,"_28646":129972,"_3122":130717},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3731":76486,"_31485":76183,"_21804":130719,"_5":15036,"_28646":129972,"_3122":130720},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3731":76487,"_31485":76183,"_21804":130722,"_5":15036,"_28646":129972,"_3122":130723},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3731":76488,"_31485":76183,"_21804":130725,"_5":15036,"_28646":129972,"_3122":130726},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3731":76489,"_31485":76183,"_21804":130728,"_5":15036,"_28646":129972,"_3122":130729},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3731":76490,"_31485":76183,"_21804":130731,"_5":15036,"_28646":129972,"_3122":130732},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3731":76491,"_31485":76183,"_21804":130734,"_5":15036,"_28646":129972,"_3122":130735},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3731":76492,"_31485":76183,"_21804":130737,"_5":15036,"_28646":129972,"_3122":130738},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida. Antes de ejecutar el paso 3, confirma que cada `ExternalSecret` de credenciales esté Ready y que los Secrets generados contengan las claves esperadas.",{"_3731":76493,"_31485":76183,"_21804":130740,"_5":15036,"_28646":129976,"_3122":130741},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3731":76494,"_31485":76183,"_21804":130743,"_5":15036,"_28646":129976,"_3122":130744},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3731":76495,"_31485":76183,"_21804":130746,"_5":15036,"_28646":129980,"_3122":130747},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3731":76496,"_31485":76183,"_21804":130749,"_5":15036,"_28646":129980,"_3122":130750},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3731":76497,"_31485":76183,"_21804":130752,"_5":15036,"_28646":129980,"_3122":130753},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3731":76498,"_31485":76183,"_21804":130755,"_5":15036,"_28646":129980,"_3122":130756},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3731":76499,"_31485":76183,"_21804":130758,"_5":15036,"_28646":129980,"_3122":130759},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3731":76500,"_31485":76183,"_21804":130761,"_5":15036,"_28646":129980,"_3122":130762},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3731":76501,"_31485":76183,"_21804":130764,"_5":15036,"_28646":129980,"_3122":130765},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3731":76502,"_31485":76183,"_21804":130767,"_5":15036,"_28646":129980,"_3122":130768},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3731":76503,"_31485":76183,"_21804":130770,"_5":15036,"_28646":129980,"_3122":130771},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3731":76504,"_31485":76183,"_21804":130773,"_5":15036,"_28646":129980,"_3122":130774},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3731":76505,"_31485":76183,"_21804":130776,"_5":15036,"_28646":129980,"_3122":130777},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3731":76506,"_31485":76183,"_21804":130779,"_5":15036,"_28646":129984,"_3122":130780},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3731":76507,"_31485":76183,"_21804":130782,"_5":15036,"_28646":129984,"_3122":130783},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3731":76508,"_31485":76183,"_21804":130785,"_5":15036,"_28646":129988,"_3122":130786},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3731":76509,"_31485":76183,"_21804":130788,"_5":15036,"_28646":129988,"_3122":130789},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3731":76510,"_31485":76183,"_21804":130791,"_5":15036,"_28646":129988,"_3122":130792},[],"Si `kms` no se ha migrado, la migración de `ca` falla con `kms schema not found: migrate the kms schema before the ca schema`. La migración de `va` requiere que `ca` y `kms` se hayan migrado primero: falla con `ca schema not found: migrate the ca schema before the va schema` o `kms schema not found: migrate the kms schema before the va schema` si falta alguno de los dos.",{"_3731":76511,"_31485":76183,"_21804":130794,"_5":15036,"_28646":129988,"_3122":130795},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates`, `SELECT` sobre `ca.ca_certificates`, y `USAGE` sobre `kms` más `SELECT` y `REFERENCES` sobre `kms.kms_keys`. Sin ellos la migración aborta; concede los privilegios que falten y vuelve a ejecutar el esquema fallido. Tras migrar `ca`, si el servicio de CA corre con un usuario distinto del usuario de migración, concédele `SELECT` sobre `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Sin ese permiso, las lecturas de certificados y CAs fallan con `permission denied for table certificates_view`. Tras migrar `va`, si el servicio de CA corre con un usuario distinto, concédele `USAGE` sobre el esquema `va` y `SELECT` sobre `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): el servicio de CA lee `va.crl_settings` cuando elimina una CA, y sin estos permisos toda eliminación de una CA que tenga motor criptográfico falla con `permission denied for schema va` (o `for table crl_settings`).",{"_3731":76512,"_31485":76183,"_21804":130797,"_5":15036,"_28646":129988,"_3122":130798},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3731":76513,"_31485":76183,"_21804":130800,"_5":15036,"_28646":129988,"_3122":130801},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3731":76514,"_31485":76183,"_21804":130803,"_5":15036,"_28646":129988,"_3122":130804},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3731":76515,"_31485":76183,"_21804":130806,"_5":15036,"_28646":129988,"_3122":130807},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3731":76516,"_31485":76183,"_21804":130809,"_5":15036,"_28646":129992,"_3122":130810},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3731":76517,"_31485":76183,"_21804":130812,"_5":15036,"_28646":129992,"_3122":130813},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3731":76518,"_31485":76183,"_21804":130815,"_5":15036,"_28646":129992,"_3122":130816},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3731":76519,"_31485":76183,"_21804":130818,"_5":15036,"_28646":129992,"_3122":130819},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3731":76520,"_31485":76183,"_21804":130821,"_5":15036,"_28646":129992,"_3122":130822},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó: por IDs de CA duplicados o por valores de `engine_id` vacíos, o en el esquema de la VA por un ID de CA que contiene `/`, un SKI compartido por más de una CA (el error pide recrear todas menos una con otra clave), un rol cuyo certificado firmante no tiene clave, un ID de CA reservado para los ajustes archivados de otro rol, o un ID de CA igual al SKI de otro rol. El mensaje de aborto nombra los objetos conflictivos; corrígelos y vuelve a ejecutar la actualización.",{"_3731":76521,"_31485":76183,"_21804":130824,"_5":15036,"_28646":129992,"_3122":130825},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3731":76522,"_31485":76183,"_21804":130827,"_5":15036,"_28646":129992,"_3122":130828},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3731":76523,"_31485":76183,"_21804":130830,"_5":15036,"_28646":129992,"_3122":130831},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que las migraciones de los esquemas `ca` y `va`.",{"_3731":76524,"_31485":76183,"_21804":130833,"_5":15036,"_28646":129992,"_3122":130834},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3731":76525,"_31485":76183,"_21804":130836,"_5":15036,"_28646":129992,"_3122":130837},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3731":76526,"_31485":76183,"_21804":130839,"_5":15036,"_28646":129992,"_3122":130840},[],"**Una migración o un servicio falla con `permission denied for table ...` o `permission denied for schema ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración, y `permission denied for schema va` (o `for table crl_settings`) al eliminar una CA sin los permisos de `va`. Concede los privilegios que falten y vuelve a ejecutar.",{"_3731":76527,"_31485":76183,"_21804":130842,"_5":15036,"_28646":129995,"_3122":130843},[],"Tras la actualización, comprueba en este orden:",{"_3731":76528,"_31485":76183,"_21804":130845,"_5":15036,"_28646":129995,"_3122":130846},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3731":76529,"_31485":76183,"_21804":130848,"_5":15036,"_28646":129995,"_3122":130849},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3731":76530,"_31485":76183,"_21804":130851,"_5":15036,"_28646":129995,"_3122":130852},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3731":76531,"_31485":76183,"_21804":130854,"_5":15036,"_28646":129995,"_3122":130855},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-id>` sobre la VA devuelve una CRL emitida anteriormente, y `GET /crl/<ca-ski>` con el SKI heredado de un certificado emitido antes de la actualización también resuelve. El job de CRL de la VA ha emitido una lista nueva bajo el ID de CA con ambas URLs en su IDP; revisa sus logs si la regeneración aún no ha terminado correctamente.",{"_3731":76532,"_31485":76183,"_21804":130857,"_5":15036,"_28646":129995,"_3122":130858},[],"**Eventos de VA renombrados.** Las suscripciones de alertas a `va.role.update` y `va.role.crl.init` se suscriben ahora a `va.crl-settings.update` y `va.crl-settings.init`, y se han revisado las condiciones de todos los eventos de la VA, incluido `va.role.crl.create`, frente al payload nuevo (`ca_id` en lugar de `ca_ski`) y al subject nuevo (`crl/<ca-id>` en lugar de `crl/<ski>`). Los consumidores directos y las búsquedas de auditoría usan los nombres de evento nuevos.",{"_3731":76533,"_31485":76183,"_21804":130860,"_5":15036,"_28646":129995,"_3122":130861},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS. Los certificados de CA migrados informan ahora de `key_id` y `has_private_key`, que permiten confirmar el registro.",{"_3731":76534,"_31485":76183,"_21804":130863,"_5":15036,"_28646":129995,"_3122":130864},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3731":76535,"_31485":76183,"_21804":130866,"_5":15036,"_28646":129995,"_3122":130867},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3731":76536,"_31485":76183,"_21804":130869,"_5":15036,"_28646":129995,"_3122":130870},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada. En AMQP las colas de suscriptores de SSE son auto-delete y desaparecen cuando su instancia se detiene; en proveedores de event bus sin soporte de suscriptores efímeros, comprueba que no se acumulen colas de SSE por proceso.",{"_3731":76537,"_31485":76183,"_21804":130872,"_5":15036,"_28646":129995,"_3122":130873},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3731":76538,"_31485":76183,"_21804":130875,"_5":15036,"_28646":129995,"_3122":130876},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3731":76539,"_31485":76183,"_21804":130878,"_5":15036,"_28646":129995,"_3122":130879},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3731":76540,"_31485":76183,"_21804":130881,"_5":15036,"_28646":129995,"_3122":130882},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3731":76541,"_31485":76183,"_21804":130884,"_5":15036,"_28646":129995,"_3122":130885},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3731":76542,"_31485":76183,"_21804":130887,"_5":15036,"_28646":129995,"_3122":130888},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3731":76543,"_31485":76183,"_21804":130890,"_5":15036,"_28646":129999,"_3122":130891},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3731":76544,"_31485":76183,"_21804":130893,"_5":15036,"_28646":129999,"_3122":130894},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3731":76545,"_31485":76183,"_21804":130896,"_5":15036,"_28646":129999,"_3122":130897},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3731":76546,"_31485":76183,"_21804":130899,"_5":15036,"_28646":129999,"_3122":130900},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3731":76547,"_31485":76183,"_21804":130902,"_5":15036,"_28646":129999,"_3122":130903},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_61006":130905,"_61008":130906,"_61010":130907,"_61012":130908,"_18932":3157,"_73439":3157},"spanish",[3122,31485,5,28646],{"_3122":26006,"_31485":26006,"_5":26006,"_28646":26006},{"_3122":130909,"_31485":134014,"_5":137119,"_28646":140224},{"_4898":130910,"_61016":130911,"_5":26006},{"_15117":15281,"_15490":6640,"_15509":7310,"_30479":5330,"_15496":5890,"_20727":7996,"_15138":6145,"_15145":4998,"_30416":8603,"_30829":4651,"_30861":8070,"_30455":3898,"_35785":6181,"_30558":18829,"_30916":10345,"_35792":7942,"_35795":5209,"_35798":3212,"_35801":16722,"_31308":5447,"_35806":4388,"_35808":4494,"_31343":3609,"_15505":6306,"_35812":7930,"_35815":6138,"_35