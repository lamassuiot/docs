5":55895,"_38747":55898,"_38749":55901,"_38751":55904,"_38753":55907,"_38755":55910,"_38757":55913,"_38759":55916,"_38761":55919,"_38763":55922,"_38765":55925,"_38767":55928,"_38769":55931,"_38771":55934,"_38773":55937,"_38775":55940,"_38777":55943,"_38779":55946,"_38781":55949,"_38783":55952,"_38785":55955,"_38787":55958,"_38790":55961,"_38792":55964,"_38794":55967,"_38796":55970},{"_3322":15,"_29027":15,"_5":14137,"_2810":47243,"_29350":47244,"_20151":47248,"_26422":15},"Deploy from AWS Marketplace",[47245,47246,47247],"Docs","Deployment","Other models",[],{"_3322":16,"_29027":15,"_20151":47250,"_5":13779,"_26422":15,"_2810":47251},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3322":17,"_29027":15,"_5":29347,"_20151":47253,"_26422":47254,"_2810":47255},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3322":18,"_29027":15,"_5":29347,"_20151":47257,"_26422":47258,"_2810":47259},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3322":19,"_29027":15,"_5":29347,"_20151":47261,"_26422":47262,"_2810":47263},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3322":20,"_29027":15,"_5":29347,"_20151":47265,"_26422":47266,"_2810":47267},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3322":21,"_29027":15,"_5":29347,"_20151":47269,"_26422":47270,"_2810":47271},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3322":22,"_29027":15,"_5":29347,"_20151":47273,"_26422":47274,"_2810":47275},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3322":23,"_29027":15,"_5":29347,"_20151":47277,"_26422":47278,"_2810":47279},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3322":24,"_29027":15,"_20151":47281,"_5":13779,"_26422":15,"_2810":47282},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3322":25,"_29027":15,"_20151":47284,"_5":13779,"_26422":47254,"_2810":47285},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3322":26,"_29027":15,"_20151":47287,"_5":13779,"_26422":47254,"_2810":47288},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3322":27,"_29027":15,"_20151":47290,"_5":13779,"_26422":47254,"_2810":47291},[],"A security group allowing the necessary endpoints.",{"_3322":28,"_29027":15,"_20151":47293,"_5":13779,"_26422":47258,"_2810":47294},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3322":29,"_29027":15,"_20151":47296,"_5":13779,"_26422":47258,"_2810":47297},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3322":30,"_29027":15,"_20151":47299,"_5":13779,"_26422":47258,"_2810":47300},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3322":31,"_29027":15,"_20151":47302,"_5":13779,"_26422":47262,"_2810":47303},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3322":32,"_29027":15,"_20151":47305,"_5":13779,"_26422":47266,"_2810":47306},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3322":33,"_29027":15,"_20151":47308,"_5":13779,"_26422":47270,"_2810":47309},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3322":34,"_29027":15,"_20151":47311,"_5":13779,"_26422":47274,"_2810":47312},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3322":35,"_29027":15,"_20151":47314,"_5":13779,"_26422":47278,"_2810":47315},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3322":36,"_29027":36,"_5":14137,"_2810":47317,"_29350":47318,"_20151":47319,"_26422":36},"Deploy Lamassu",[47245,47246],[],{"_3322":37,"_29027":36,"_20151":47321,"_5":13779,"_26422":36,"_2810":47322},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3322":38,"_29027":36,"_5":29347,"_20151":47324,"_26422":47325,"_2810":47326},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3322":39,"_29027":36,"_5":29347,"_20151":47328,"_26422":47329,"_2810":47330},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3322":40,"_29027":36,"_5":29347,"_20151":47332,"_26422":47333,"_2810":47334},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3322":41,"_29027":36,"_20151":47336,"_5":13779,"_26422":36,"_2810":47337},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3322":42,"_29027":36,"_20151":47339,"_5":13779,"_26422":47325,"_2810":47340},[],"Model",{"_3322":43,"_29027":36,"_20151":47342,"_5":13779,"_26422":47325,"_2810":47343},[],"Recommended for",{"_3322":44,"_29027":36,"_20151":47345,"_5":13779,"_26422":47325,"_2810":47346},[],"Who operates the infrastructure",{"_3322":45,"_29027":36,"_20151":47348,"_5":13779,"_26422":47325,"_2810":47349},[],"Starting point",{"_3322":46,"_29027":36,"_20151":47351,"_5":13779,"_26422":47325,"_2810":47352},[],"Kubernetes self-managed",{"_3322":47,"_29027":36,"_20151":47354,"_5":13779,"_26422":47325,"_2810":47355},[],"Production, regulated environments and custom deployments",{"_3322":48,"_29027":36,"_20151":47357,"_5":13779,"_26422":47325,"_2810":47358},[],"Your team",{"_3322":49,"_29027":36,"_20151":47360,"_5":13779,"_26422":47325,"_2810":47361},[],"Helm or Fastlane",{"_3322":50,"_29027":36,"_20151":47363,"_5":13779,"_26422":47325,"_2810":47364},[],"AWS Marketplace",{"_3322":51,"_29027":36,"_20151":47366,"_5":13779,"_26422":47325,"_2810":47367},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3322":52,"_29027":36,"_20151":47369,"_5":13779,"_26422":47325,"_2810":47358},[],{"_3322":53,"_29027":36,"_20151":47371,"_5":13779,"_26422":47325,"_2810":47372},[],"Preconfigured image on EC2",{"_3322":54,"_29027":36,"_20151":47374,"_5":13779,"_26422":47325,"_2810":47375},[],"SaaS",{"_3322":55,"_29027":36,"_20151":47377,"_5":13779,"_26422":47325,"_2810":47378},[],"Teams that want to use the platform without operating it",{"_3322":56,"_29027":36,"_20151":47380,"_5":13779,"_26422":47325,"_2810":47381},[],"Lamassu",{"_3322":57,"_29027":36,"_20151":47383,"_5":13779,"_26422":47325,"_2810":47384},[],"Managed subscription",{"_3322":58,"_29027":36,"_20151":47386,"_5":13779,"_26422":47325,"_2810":47387},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3322":59,"_29027":36,"_20151":47389,"_5":13779,"_26422":47325,"_2810":47390},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3322":60,"_29027":36,"_20151":47392,"_5":13779,"_26422":47325,"_2810":47393},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3322":61,"_29027":36,"_20151":47395,"_5":13779,"_26422":47329,"_2810":47396},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3322":62,"_29027":36,"_20151":47398,"_5":13779,"_26422":47333,"_2810":47399},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3322":63,"_29027":63,"_5":14137,"_2810":47401,"_29350":47402,"_20151":47403,"_26422":63},"Use Lamassu as SaaS",[47245,47246,47247],[],{"_3322":64,"_29027":63,"_20151":47405,"_5":13779,"_26422":63,"_2810":47406},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3322":65,"_29027":63,"_5":29347,"_20151":47408,"_26422":47409,"_2810":47410},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3322":66,"_29027":63,"_5":29347,"_20151":47412,"_26422":47413,"_2810":47414},[],"/docs/deployment/saas#plans","Plans",{"_3322":67,"_29027":63,"_5":29347,"_20151":47416,"_26422":47417,"_2810":47418},[],"/docs/deployment/saas#request-access","Request access",{"_3322":68,"_29027":63,"_20151":47420,"_5":13779,"_26422":63,"_2810":47421},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3322":69,"_29027":63,"_20151":47423,"_5":13779,"_26422":47409,"_2810":47424},[],"Platform availability and maintenance.",{"_3322":70,"_29027":63,"_20151":47426,"_5":13779,"_26422":47409,"_2810":47427},[],"Automatic backups.",{"_3322":71,"_29027":63,"_20151":47429,"_5":13779,"_26422":47409,"_2810":47430},[],"Version upgrades.",{"_3322":72,"_29027":63,"_20151":47432,"_5":13779,"_26422":47409,"_2810":47433},[],"Technical support and SLA according to your plan.",{"_3322":73,"_29027":63,"_20151":47435,"_5":13779,"_26422":47413,"_2810":47436},[],"Plan",{"_3322":74,"_29027":63,"_20151":47438,"_5":13779,"_26422":47413,"_2810":47439},[],"Devices",{"_3322":75,"_29027":63,"_20151":47441,"_5":13779,"_26422":47413,"_2810":47442},[],"Support",{"_3322":76,"_29027":63,"_20151":47444,"_5":13779,"_26422":47413,"_2810":47445},[],"SLA",{"_3322":77,"_29027":63,"_20151":47447,"_5":13779,"_26422":47413,"_2810":47448},[],"Starter",{"_3322":78,"_29027":63,"_20151":47450,"_5":13779,"_26422":47413,"_2810":47451},[],"Up to 1,000",{"_3322":79,"_29027":63,"_20151":47453,"_5":13779,"_26422":47413,"_2810":47454},[],"Email",{"_3322":80,"_29027":63,"_20151":47456,"_5":13779,"_26422":47413,"_2810":47457},[],"99.5 %",{"_3322":81,"_29027":63,"_20151":47459,"_5":13779,"_26422":47413,"_2810":47460},[],"Professional",{"_3322":82,"_29027":63,"_20151":47462,"_5":13779,"_26422":47413,"_2810":47463},[],"Up to 10,000",{"_3322":83,"_29027":63,"_20151":47465,"_5":13779,"_26422":47413,"_2810":47466},[],"Email and chat",{"_3322":84,"_29027":63,"_20151":47468,"_5":13779,"_26422":47413,"_2810":47469},[],"99.9 %",{"_3322":85,"_29027":63,"_20151":47471,"_5":13779,"_26422":47413,"_2810":47472},[],"Enterprise",{"_3322":86,"_29027":63,"_20151":47474,"_5":13779,"_26422":47413,"_2810":47475},[],"Unlimited",{"_3322":87,"_29027":63,"_20151":47477,"_5":13779,"_26422":47413,"_2810":47478},[],"Dedicated",{"_3322":88,"_29027":63,"_20151":47480,"_5":13779,"_26422":47413,"_2810":47481},[],"99.99 %",{"_3322":89,"_29027":63,"_20151":47483,"_5":13779,"_26422":47417,"_2810":47484},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3322":90,"_29027":63,"_20151":47486,"_5":13779,"_26422":47417,"_2810":47487},[],"When you receive your instance's credentials, continue with Get started.",{"_3322":91,"_29027":91,"_5":14137,"_2810":47489,"_29350":47490,"_20151":47491,"_26422":91},"Fastlane",[47245,47246,47352],[],{"_3322":92,"_29027":91,"_20151":47493,"_5":13779,"_26422":91,"_2810":47494},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3322":93,"_29027":91,"_5":29347,"_20151":47496,"_26422":47497,"_2810":47498},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3322":94,"_29027":91,"_5":29347,"_20151":47500,"_26422":47501,"_2810":47502},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3322":95,"_29027":91,"_5":29347,"_20151":47504,"_26422":47505,"_2810":47255},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3322":96,"_29027":91,"_5":29347,"_20151":47507,"_26422":47508,"_2810":47509},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3322":97,"_29027":91,"_5":29347,"_20151":47511,"_26422":47512,"_2810":47513},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3322":98,"_29027":91,"_5":29347,"_20151":47515,"_26422":47516,"_2810":47517},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3322":99,"_29027":91,"_5":29347,"_20151":47519,"_26422":47520,"_2810":47521},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3322":100,"_29027":91,"_5":29347,"_20151":47523,"_26422":47524,"_2810":47525},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3322":101,"_29027":91,"_5":29347,"_20151":47527,"_26422":47528,"_2810":47529},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3322":102,"_29027":91,"_5":29347,"_20151":47531,"_26422":47532,"_2810":47533},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3322":103,"_29027":91,"_5":29347,"_20151":47535,"_26422":47536,"_2810":47537},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3322":104,"_29027":91,"_20151":47539,"_5":13779,"_26422":47497,"_2810":47540},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3322":105,"_29027":91,"_20151":47542,"_5":13779,"_26422":47497,"_2810":47543},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3322":106,"_29027":91,"_20151":47545,"_5":13779,"_26422":47501,"_2810":47546},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3322":107,"_29027":91,"_20151":47548,"_5":13779,"_26422":47501,"_2810":47549},[],"Fastlane installs or configures",{"_3322":108,"_29027":91,"_20151":47551,"_5":13779,"_26422":47501,"_2810":47552},[],"You still provide",{"_3322":109,"_29027":91,"_20151":47554,"_5":13779,"_26422":47501,"_2810":47555},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3322":110,"_29027":91,"_20151":47557,"_5":13779,"_26422":47501,"_2810":47558},[],"The Kubernetes cluster, nodes and persistent storage",{"_3322":111,"_29027":91,"_20151":47560,"_5":13779,"_26422":47501,"_2810":47561},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3322":112,"_29027":91,"_20151":47563,"_5":13779,"_26422":47501,"_2810":47564},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3322":113,"_29027":91,"_20151":47566,"_5":13779,"_26422":47501,"_2810":47567},[],"A self-signed Lamassu certificate flow, generated dependency credentials and an initial user",{"_3322":114,"_29027":91,"_20151":47569,"_5":13779,"_26422":47501,"_2810":47570},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3322":115,"_29027":91,"_20151":47572,"_5":13779,"_26422":47501,"_2810":47573},[],"Optional observability and lab HSM components",{"_3322":116,"_29027":91,"_20151":47575,"_5":13779,"_26422":47501,"_2810":47576},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3322":117,"_29027":91,"_20151":47578,"_5":13779,"_26422":47501,"_2810":47579},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3322":118,"_29027":91,"_20151":47581,"_5":13779,"_26422":47505,"_2810":47582},[],"You need:",{"_3322":119,"_29027":91,"_20151":47584,"_5":13779,"_26422":47505,"_2810":47585},[],"an existing Kubernetes cluster",{"_3322":120,"_29027":91,"_20151":47587,"_5":13779,"_26422":47505,"_2810":47588},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3322":121,"_29027":91,"_20151":47590,"_5":13779,"_26422":47505,"_2810":47591},[],"`yq`",{"_3322":122,"_29027":91,"_20151":47593,"_5":13779,"_26422":47505,"_2810":22800},[],{"_3322":123,"_29027":91,"_20151":47595,"_5":13779,"_26422":47505,"_2810":47596},[],"`jq` only when using `--sample-data` or `--development`",{"_3322":124,"_29027":91,"_20151":47598,"_5":13779,"_26422":47505,"_2810":47599},[],"`ssh-keygen` only when using `--with-hsm`",{"_3322":125,"_29027":91,"_20151":47601,"_5":13779,"_26422":47505,"_2810":47602},[],"free external ports 80 and 443 on a single-node K3s host",{"_3322":126,"_29027":91,"_20151":47604,"_5":13779,"_26422":47505,"_2810":47605},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3322":127,"_29027":91,"_20151":47607,"_5":13779,"_26422":47505,"_2810":47608},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3322":128,"_29027":91,"_20151":47610,"_5":13779,"_26422":47508,"_2810":47611},[],"Run the script from a clone of the Helm repository:",{"_3322":129,"_29027":91,"_20151":47613,"_5":13779,"_26422":47508,"_2810":47614},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3322":130,"_29027":91,"_20151":47616,"_5":13779,"_26422":47512,"_2810":47617},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3322":131,"_29027":91,"_20151":47619,"_5":13779,"_26422":47512,"_2810":47620},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3322":132,"_29027":91,"_20151":47622,"_5":13779,"_26422":47512,"_2810":47623},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3322":133,"_29027":91,"_20151":47625,"_5":13779,"_26422":47512,"_2810":47626},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3322":134,"_29027":91,"_20151":47628,"_5":13779,"_26422":47516,"_2810":47629},[],"Option",{"_3322":135,"_29027":91,"_20151":47631,"_5":13779,"_26422":47516,"_2810":47632},[],"Default",{"_3322":136,"_29027":91,"_20151":47634,"_5":13779,"_26422":47516,"_2810":47635},[],"Purpose",{"_3322":137,"_29027":91,"_20151":47637,"_5":13779,"_26422":47516,"_2810":47638},[],"`-h`, `--help`",{"_3322":138,"_29027":91,"_20151":47640,"_5":13779,"_26422":47516,"_2810":47641},[],"—",{"_3322":139,"_29027":91,"_20151":47643,"_5":13779,"_26422":47516,"_2810":47644},[],"Show help",{"_3322":140,"_29027":91,"_20151":47646,"_5":13779,"_26422":47516,"_2810":47647},[],"`-c`, `--context`",{"_3322":141,"_29027":91,"_20151":47649,"_5":13779,"_26422":47516,"_2810":47650},[],"current context",{"_3322":142,"_29027":91,"_20151":47652,"_5":13779,"_26422":47516,"_2810":47653},[],"Select the kubeconfig context for kubectl and Helm",{"_3322":143,"_29027":91,"_20151":47655,"_5":13779,"_26422":47516,"_2810":47656},[],"`-n`, `--non-interactive`",{"_3322":144,"_29027":91,"_20151":47658,"_5":13779,"_26422":47516,"_2810":6227},[],{"_3322":145,"_29027":91,"_20151":47660,"_5":13779,"_26422":47516,"_2810":47661},[],"Skip prompts and generate dependency credentials",{"_3322":146,"_29027":91,"_20151":47663,"_5":13779,"_26422":47516,"_2810":47664},[],"`-ns`, `--namespace`",{"_3322":147,"_29027":91,"_20151":47666,"_5":13779,"_26422":47516,"_2810":47667},[],"`lamassu-dev`",{"_3322":148,"_29027":91,"_20151":47669,"_5":13779,"_26422":47516,"_2810":47670},[],"Namespace for the installation",{"_3322":149,"_29027":91,"_20151":47672,"_5":13779,"_26422":47516,"_2810":47673},[],"`-d`, `--domain`",{"_3322":150,"_29027":91,"_20151":47675,"_5":13779,"_26422":47516,"_2810":47676},[],"`dev.lamassu.io`",{"_3322":151,"_29027":91,"_20151":47678,"_5":13779,"_26422":47516,"_2810":47679},[],"Domain used by the UI, OIDC and certificate",{"_3322":152,"_29027":91,"_20151":47681,"_5":13779,"_26422":47516,"_2810":47682},[],"`-v`, `--version`",{"_3322":153,"_29027":91,"_20151":47684,"_5":13779,"_26422":47516,"_2810":14438},[],{"_3322":154,"_29027":91,"_20151":47686,"_5":13779,"_26422":47516,"_2810":47687},[],"Lamassu chart version",{"_3322":155,"_29027":91,"_20151":47689,"_5":13779,"_26422":47516,"_2810":47690},[],"`--https-port`",{"_3322":156,"_29027":91,"_20151":47692,"_5":13779,"_26422":47516,"_2810":47693},[],"`443`",{"_3322":157,"_29027":91,"_20151":47695,"_5":13779,"_26422":47516,"_2810":47696},[],"Gateway HTTPS listener port",{"_3322":158,"_29027":91,"_20151":47698,"_5":13779,"_26422":47516,"_2810":47699},[],"`--http-port`",{"_3322":159,"_29027":91,"_20151":47701,"_5":13779,"_26422":47516,"_2810":47702},[],"`80`",{"_3322":160,"_29027":91,"_20151":47704,"_5":13779,"_26422":47516,"_2810":47705},[],"Gateway HTTP listener port",{"_3322":161,"_29027":91,"_20151":47707,"_5":13779,"_26422":47516,"_2810":47708},[],"`--tls-crt`",{"_3322":162,"_29027":91,"_20151":47710,"_5":13779,"_26422":47516,"_2810":47641},[],{"_3322":163,"_29027":91,"_20151":47712,"_5":13779,"_26422":47516,"_2810":47713},[],"PEM certificate for downstream TLS",{"_3322":164,"_29027":91,"_20151":47715,"_5":13779,"_26422":47516,"_2810":47716},[],"`--tls-key`",{"_3322":165,"_29027":91,"_20151":47718,"_5":13779,"_26422":47516,"_2810":47641},[],{"_3322":166,"_29027":91,"_20151":47720,"_5":13779,"_26422":47516,"_2810":47721},[],"PEM private key for downstream TLS",{"_3322":167,"_29027":91,"_20151":47723,"_5":13779,"_26422":47516,"_2810":47724},[],"`-l`, `--local-chart-path`",{"_3322":168,"_29027":91,"_20151":47726,"_5":13779,"_26422":47516,"_2810":47727},[],"repository chart",{"_3322":169,"_29027":91,"_20151":47729,"_5":13779,"_26422":47516,"_2810":47730},[],"Use an unpacked local Lamassu chart",{"_3322":170,"_29027":91,"_20151":47732,"_5":13779,"_26422":47516,"_2810":47733},[],"`-ip`, `--gateway-ip`",{"_3322":171,"_29027":91,"_20151":47735,"_5":13779,"_26422":47516,"_2810":8366},[],{"_3322":172,"_29027":91,"_20151":47737,"_5":13779,"_26422":47516,"_2810":47738},[],"Override the address written to `gateway.addresses`",{"_3322":173,"_29027":91,"_20151":47740,"_5":13779,"_26422":47516,"_2810":47741},[],"`--otel`",{"_3322":174,"_29027":91,"_20151":47743,"_5":13779,"_26422":47516,"_2810":6227},[],{"_3322":175,"_29027":91,"_20151":47745,"_5":13779,"_26422":47516,"_2810":47746},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3322":176,"_29027":91,"_20151":47748,"_5":13779,"_26422":47516,"_2810":47749},[],"`--development`",{"_3322":177,"_29027":91,"_20151":47751,"_5":13779,"_26422":47516,"_2810":6227},[],{"_3322":178,"_29027":91,"_20151":47753,"_5":13779,"_26422":47516,"_2810":47754},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3322":179,"_29027":91,"_20151":47756,"_5":13779,"_26422":47516,"_2810":47757},[],"`--sample-data`",{"_3322":180,"_29027":91,"_20151":47759,"_5":13779,"_26422":47516,"_2810":6227},[],{"_3322":181,"_29027":91,"_20151":47761,"_5":13779,"_26422":47516,"_2810":47762},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3322":182,"_29027":91,"_20151":47764,"_5":13779,"_26422":47516,"_2810":47765},[],"`--with-hsm`",{"_3322":183,"_29027":91,"_20151":47767,"_5":13779,"_26422":47516,"_2810":6227},[],{"_3322":184,"_29027":91,"_20151":47769,"_5":13779,"_26422":47516,"_2810":47770},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3322":185,"_29027":91,"_20151":47772,"_5":13779,"_26422":47516,"_2810":47773},[],"`--softhsm-chart-path`",{"_3322":186,"_29027":91,"_20151":47775,"_5":13779,"_26422":47516,"_2810":47776},[],"`./charts/softhsm`",{"_3322":187,"_29027":91,"_20151":47778,"_5":13779,"_26422":47516,"_2810":47779},[],"Use a different local SoftHSM chart",{"_3322":188,"_29027":91,"_20151":47781,"_5":13779,"_26422":47516,"_2810":47782},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3322":189,"_29027":91,"_20151":47784,"_5":13779,"_26422":47520,"_2810":47785},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3322":190,"_29027":91,"_20151":47787,"_5":13779,"_26422":47520,"_2810":47788},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3322":191,"_29027":91,"_20151":47790,"_5":13779,"_26422":47520,"_2810":47791},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3322":192,"_29027":91,"_20151":47793,"_5":13779,"_26422":47520,"_2810":47794},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3322":193,"_29027":91,"_20151":47796,"_5":13779,"_26422":47520,"_2810":47797},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3322":194,"_29027":91,"_20151":47799,"_5":13779,"_26422":47520,"_2810":47800},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3322":195,"_29027":91,"_20151":47802,"_5":13779,"_26422":47524,"_2810":47803},[],"Fastlane:",{"_3322":196,"_29027":91,"_20151":47805,"_5":13779,"_26422":47524,"_2810":47806},[],"validates local tools and the selected cluster",{"_3322":197,"_29027":91,"_20151":47808,"_5":13779,"_26422":47524,"_2810":47809},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3322":198,"_29027":91,"_20151":47811,"_5":13779,"_26422":47524,"_2810":47812},[],"creates the namespace",{"_3322":199,"_29027":91,"_20151":47814,"_5":13779,"_26422":47524,"_2810":47815},[],"installs PostgreSQL and creates the required databases",{"_3322":200,"_29027":91,"_20151":47817,"_5":13779,"_26422":47524,"_2810":47818},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3322":201,"_29027":91,"_20151":47820,"_5":13779,"_26422":47524,"_2810":47821},[],"installs RabbitMQ",{"_3322":202,"_29027":91,"_20151":47823,"_5":13779,"_26422":47524,"_2810":47824},[],"optionally installs observability and lab HSM components",{"_3322":203,"_29027":91,"_20151":47826,"_5":13779,"_26422":47524,"_2810":47827},[],"generates `lamassu.yaml` and installs the Lamassu chart",{"_3322":204,"_29027":91,"_20151":47829,"_5":13779,"_26422":47524,"_2810":47830},[],"optionally loads sample data",{"_3322":205,"_29027":91,"_20151":47832,"_5":13779,"_26422":47524,"_2810":47833},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3322":206,"_29027":91,"_20151":47835,"_5":13779,"_26422":47528,"_2810":47836},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3322":207,"_29027":91,"_20151":47838,"_5":13779,"_26422":47528,"_2810":47839},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3322":208,"_29027":91,"_20151":47841,"_5":13779,"_26422":47532,"_2810":47842},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords. The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3322":209,"_29027":91,"_20151":47844,"_5":13779,"_26422":47532,"_2810":47845},[],"Fastlane writes `lamassu.yaml` in the current directory and injects credentials into it.",{"_3322":210,"_29027":91,"_20151":47847,"_5":13779,"_26422":47532,"_2810":47848},[],"Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3322":211,"_29027":91,"_20151":47850,"_5":13779,"_26422":47536,"_2810":47851},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3322":212,"_29027":212,"_5":14137,"_2810":47853,"_29350":47854,"_20151":47855,"_26422":212},"Install with Helm",[47245,47246,47352],[],{"_3322":213,"_29027":212,"_20151":47857,"_5":13779,"_26422":212,"_2810":47858},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3322":214,"_29027":212,"_5":29347,"_20151":47860,"_26422":47861,"_2810":47862},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3322":215,"_29027":212,"_5":29347,"_20151":47864,"_26422":47865,"_2810":47255},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3322":216,"_29027":212,"_5":29347,"_20151":47867,"_26422":47868,"_2810":47869},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3322":217,"_29027":212,"_5":29347,"_20151":47871,"_26422":47872,"_2810":47873},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3322":218,"_29027":212,"_5":29347,"_20151":47875,"_26422":47876,"_2810":47877},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3322":219,"_29027":212,"_5":29347,"_20151":47879,"_26422":47880,"_2810":47881},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3322":220,"_29027":212,"_5":29347,"_20151":47883,"_26422":47884,"_2810":47885},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3322":221,"_29027":212,"_5":29347,"_20151":47887,"_26422":47888,"_2810":47889},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3322":222,"_29027":212,"_5":29347,"_20151":47891,"_26422":47892,"_2810":47893},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3322":223,"_29027":212,"_5":29347,"_20151":47895,"_26422":47896,"_2810":47897},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3322":224,"_29027":212,"_20151":47899,"_5":13779,"_26422":47861,"_2810":47900},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3322":225,"_29027":212,"_20151":47902,"_5":13779,"_26422":47865,"_2810":47903},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3322":226,"_29027":212,"_20151":47905,"_5":13779,"_26422":47865,"_2810":47906},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3322":227,"_29027":212,"_20151":47908,"_5":13779,"_26422":47865,"_2810":47909},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3322":228,"_29027":212,"_20151":47911,"_5":13779,"_26422":47865,"_2810":47912},[],"a reachable RabbitMQ broker and credentials",{"_3322":229,"_29027":212,"_20151":47914,"_5":13779,"_26422":47865,"_2810":47915},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3322":230,"_29027":212,"_20151":47917,"_5":13779,"_26422":47865,"_2810":47918},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3322":231,"_29027":212,"_20151":47920,"_5":13779,"_26422":47865,"_2810":47921},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3322":232,"_29027":212,"_20151":47923,"_5":13779,"_26422":47865,"_2810":47924},[],"a StorageClass and an external traffic design",{"_3322":233,"_29027":212,"_20151":47926,"_5":13779,"_26422":47865,"_2810":47927},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3322":234,"_29027":212,"_20151":47929,"_5":13779,"_26422":47865,"_2810":47930},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3322":235,"_29027":212,"_20151":47932,"_5":13779,"_26422":47865,"_2810":47933},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3322":236,"_29027":212,"_20151":47935,"_5":13779,"_26422":47868,"_2810":47936},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3322":237,"_29027":212,"_20151":47938,"_5":13779,"_26422":47868,"_2810":47939},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3322":238,"_29027":212,"_20151":47941,"_5":13779,"_26422":47868,"_2810":47942},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3322":239,"_29027":212,"_20151":47944,"_5":13779,"_26422":47872,"_2810":47945},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3322":240,"_29027":212,"_20151":47947,"_5":13779,"_26422":47872,"_2810":47948},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3322":241,"_29027":212,"_20151":47950,"_5":13779,"_26422":47872,"_2810":47951},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3322":242,"_29027":212,"_20151":47953,"_5":13779,"_26422":47872,"_2810":47954},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3322":243,"_29027":212,"_20151":47956,"_5":13779,"_26422":47876,"_2810":47957},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3322":244,"_29027":212,"_20151":47959,"_5":13779,"_26422":47880,"_2810":47960},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3322":245,"_29027":212,"_20151":47962,"_5":13779,"_26422":47880,"_2810":47963},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3322":246,"_29027":212,"_20151":47965,"_5":13779,"_26422":47880,"_2810":47966},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3322":247,"_29027":212,"_20151":47968,"_5":13779,"_26422":47880,"_2810":47969},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3322":248,"_29027":212,"_20151":47971,"_5":13779,"_26422":47880,"_2810":47972},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3322":249,"_29027":212,"_20151":47974,"_5":13779,"_26422":47880,"_2810":47975},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3322":250,"_29027":212,"_20151":47977,"_5":13779,"_26422":47880,"_2810":47978},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3322":251,"_29027":212,"_20151":47980,"_5":13779,"_26422":47884,"_2810":47981},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3322":252,"_29027":212,"_20151":47983,"_5":13779,"_26422":47884,"_2810":47984},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3322":253,"_29027":212,"_20151":47986,"_5":13779,"_26422":47884,"_2810":47987},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3322":254,"_29027":212,"_20151":47989,"_5":13779,"_26422":47884,"_2810":47990},[],"See Access control for the principal and policy model.",{"_3322":255,"_29027":212,"_20151":47992,"_5":13779,"_26422":47888,"_2810":47993},[],"To install a local checkout instead:",{"_3322":256,"_29027":212,"_20151":47995,"_5":13779,"_26422":47892,"_2810":47996},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3322":257,"_29027":212,"_20151":47998,"_5":13779,"_26422":47892,"_2810":47999},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3322":258,"_29027":212,"_20151":48001,"_5":13779,"_26422":47896,"_2810":48002},[],"Before going live, review:",{"_3322":259,"_29027":212,"_20151":48004,"_5":13779,"_26422":47896,"_2810":48005},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3322":260,"_29027":212,"_20151":48007,"_5":13779,"_26422":47896,"_2810":48008},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3322":261,"_29027":212,"_20151":48010,"_5":13779,"_26422":47896,"_2810":48011},[],"shared VA storage before increasing VA replicas",{"_3322":262,"_29027":212,"_20151":48013,"_5":13779,"_26422":47896,"_2810":48014},[],"managed OIDC roles and removal of evaluation credentials",{"_3322":263,"_29027":212,"_20151":48016,"_5":13779,"_26422":47896,"_2810":48017},[],"a trusted TLS issuer or externally managed certificate",{"_3322":264,"_29027":212,"_20151":48019,"_5":13779,"_26422":47896,"_2810":48020},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3322":265,"_29027":212,"_20151":48022,"_5":13779,"_26422":47896,"_2810":48023},[],"SMTP, observability and alert delivery",{"_3322":266,"_29027":212,"_20151":48025,"_5":13779,"_26422":47896,"_2810":48026},[],"the version upgrade guides and the notes in `charts/lamassu/CHANGELOG/` before every upgrade",{"_3322":267,"_29027":212,"_20151":48028,"_5":13779,"_26422":47896,"_2810":48029},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3322":268,"_29027":268,"_5":14137,"_2810":48031,"_29350":48032,"_20151":48033,"_26422":268},"Expose the Gateway",[47245,47246,47352],[],{"_3322":269,"_29027":268,"_20151":48035,"_5":13779,"_26422":268,"_2810":48036},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3322":270,"_29027":268,"_5":29347,"_20151":48038,"_26422":48039,"_2810":48040},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3322":271,"_29027":268,"_5":29347,"_20151":48042,"_26422":48043,"_2810":48044},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3322":272,"_29027":268,"_5":29347,"_20151":48046,"_26422":48047,"_2810":48048},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3322":273,"_29027":268,"_5":29347,"_20151":48050,"_26422":48051,"_2810":48052},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3322":274,"_29027":268,"_5":29347,"_20151":48054,"_26422":48055,"_2810":48056},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3322":275,"_29027":268,"_5":29347,"_20151":48058,"_26422":48059,"_2810":48060},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3322":276,"_29027":268,"_5":29347,"_20151":48062,"_26422":48063,"_2810":48064},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3322":277,"_29027":268,"_5":29347,"_20151":48066,"_26422":48067,"_2810":48068},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3322":278,"_29027":268,"_5":29347,"_20151":48070,"_26422":48071,"_2810":48072},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3322":279,"_29027":268,"_5":29347,"_20151":48074,"_26422":48075,"_2810":48076},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3322":280,"_29027":268,"_20151":48078,"_5":13779,"_26422":48039,"_2810":48079},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3322":281,"_29027":268,"_20151":48081,"_5":13779,"_26422":48039,"_2810":48082},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3322":282,"_29027":268,"_20151":48084,"_5":13779,"_26422":48043,"_2810":48085},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3322":283,"_29027":268,"_20151":48087,"_5":13779,"_26422":48043,"_2810":48088},[],"Set it only when:",{"_3322":284,"_29027":268,"_20151":48090,"_5":13779,"_26422":48043,"_2810":48091},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3322":285,"_29027":268,"_20151":48093,"_5":13779,"_26422":48043,"_2810":48094},[],"that address is allocated to this Gateway",{"_3322":286,"_29027":268,"_20151":48096,"_5":13779,"_26422":48043,"_2810":48097},[],"the surrounding network already routes traffic for it to the cluster",{"_3322":287,"_29027":268,"_20151":48099,"_5":13779,"_26422":48043,"_2810":48100},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3322":288,"_29027":268,"_20151":48102,"_5":13779,"_26422":48043,"_2810":48103},[],"Keep these two settings separate:",{"_3322":289,"_29027":268,"_20151":48105,"_5":13779,"_26422":48043,"_2810":48106},[],"`gateway.addresses` requests an address for the Gateway.",{"_3322":290,"_29027":268,"_20151":48108,"_5":13779,"_26422":48043,"_2810":48109},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3322":291,"_29027":268,"_20151":48111,"_5":13779,"_26422":48043,"_2810":48112},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3322":292,"_29027":268,"_20151":48114,"_5":13779,"_26422":48047,"_2810":48115},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3322":293,"_29027":268,"_20151":48117,"_5":13779,"_26422":48047,"_2810":48118},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3322":294,"_29027":268,"_20151":48120,"_5":13779,"_26422":48051,"_2810":48121},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3322":295,"_29027":268,"_20151":48123,"_5":13779,"_26422":48051,"_2810":48124},[],"For the recommended design:",{"_3322":296,"_29027":268,"_20151":48126,"_5":13779,"_26422":48051,"_2810":48127},[],"Use only one externally exposed Lamassu Gateway.",{"_3322":297,"_29027":268,"_20151":48129,"_5":13779,"_26422":48051,"_2810":48130},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3322":298,"_29027":268,"_20151":48132,"_5":13779,"_26422":48051,"_2810":48133},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3322":299,"_29027":268,"_20151":48135,"_5":13779,"_26422":48051,"_2810":48136},[],"Point DNS at the VM's reachable address.",{"_3322":300,"_29027":268,"_20151":48138,"_5":13779,"_26422":48051,"_2810":48139},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3322":301,"_29027":268,"_20151":48141,"_5":13779,"_26422":48055,"_2810":48142},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3322":302,"_29027":268,"_20151":48144,"_5":13779,"_26422":48059,"_2810":48145},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3322":303,"_29027":268,"_20151":48147,"_5":13779,"_26422":48059,"_2810":48148},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3322":304,"_29027":268,"_20151":48150,"_5":13779,"_26422":48063,"_2810":48151},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3322":305,"_29027":268,"_20151":48153,"_5":13779,"_26422":48063,"_2810":48154},[],"Requirement",{"_3322":306,"_29027":268,"_20151":48156,"_5":13779,"_26422":48063,"_2810":48157},[],"Recommended design",{"_3322":307,"_29027":268,"_20151":48159,"_5":13779,"_26422":48063,"_2810":48160},[],"Consequence",{"_3322":308,"_29027":268,"_20151":48162,"_5":13779,"_26422":48063,"_2810":48163},[],"Several Lamassu URLs or services",{"_3322":309,"_29027":268,"_20151":48165,"_5":13779,"_26422":48063,"_2810":48166},[],"One Gateway with multiple routes",{"_3322":310,"_29027":268,"_20151":48168,"_5":13779,"_26422":48063,"_2810":48169},[],"One IP and one proxy fleet; this is the chart default",{"_3322":311,"_29027":268,"_20151":48171,"_5":13779,"_26422":48063,"_2810":48172},[],"Independent Gateways and separate external IPs",{"_3322":312,"_29027":268,"_20151":48174,"_5":13779,"_26422":48063,"_2810":48175},[],"One VIP per Gateway",{"_3322":313,"_29027":268,"_20151":48177,"_5":13779,"_26422":48063,"_2810":48178},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3322":314,"_29027":268,"_20151":48180,"_5":13779,"_26422":48063,"_2810":48181},[],"Independent Gateways on one node and one IP",{"_3322":315,"_29027":268,"_20151":48183,"_5":13779,"_26422":48063,"_2810":48184},[],"Use different external ports",{"_3322":316,"_29027":268,"_20151":48186,"_5":13779,"_26422":48063,"_2810":48187},[],"Clients must include non-standard ports",{"_3322":317,"_29027":268,"_20151":48189,"_5":13779,"_26422":48063,"_2810":48190},[],"Separate TLS/mTLS termination behind one IP",{"_3322":318,"_29027":268,"_20151":48192,"_5":13779,"_26422":48063,"_2810":48193},[],"Front-door SNI routing to internal Gateways",{"_3322":319,"_29027":268,"_20151":48195,"_5":13779,"_26422":48063,"_2810":48196},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3322":320,"_29027":268,"_20151":48198,"_5":13779,"_26422":48063,"_2810":48199},[],"Separate Gateway resources but shared proxy infrastructure",{"_3322":321,"_29027":268,"_20151":48201,"_5":13779,"_26422":48063,"_2810":48202},[],"Envoy merged-Gateway mode",{"_3322":322,"_29027":268,"_20151":48204,"_5":13779,"_26422":48063,"_2810":48205},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3322":323,"_29027":268,"_20151":48207,"_5":13779,"_26422":48063,"_2810":48208},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3322":324,"_29027":268,"_20151":48210,"_5":13779,"_26422":48063,"_2810":48211},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3322":325,"_29027":268,"_20151":48213,"_5":13779,"_26422":48063,"_2810":48214},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3322":326,"_29027":268,"_20151":48216,"_5":13779,"_26422":48063,"_2810":48217},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3322":327,"_29027":268,"_20151":48219,"_5":13779,"_26422":48067,"_2810":48220},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3322":328,"_29027":268,"_20151":48222,"_5":13779,"_26422":48067,"_2810":48223},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3322":329,"_29027":268,"_20151":48225,"_5":13779,"_26422":48067,"_2810":48226},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3322":330,"_29027":268,"_20151":48228,"_5":13779,"_26422":48067,"_2810":48229},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3322":331,"_29027":268,"_20151":48231,"_5":13779,"_26422":48067,"_2810":48232},[],"If none of those are possible, use different external ports or change the external network design.",{"_3322":332,"_29027":268,"_20151":48234,"_5":13779,"_26422":48071,"_2810":48235},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3322":333,"_29027":268,"_20151":48237,"_5":13779,"_26422":48071,"_2810":48238},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3322":334,"_29027":268,"_20151":48240,"_5":13779,"_26422":48075,"_2810":48241},[],"Check, in order:",{"_3322":335,"_29027":268,"_20151":48243,"_5":13779,"_26422":48075,"_2810":48244},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3322":336,"_29027":268,"_20151":48246,"_5":13779,"_26422":48075,"_2810":48247},[],"Its status contains the expected address.",{"_3322":337,"_29027":268,"_20151":48249,"_5":13779,"_26422":48075,"_2810":48250},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3322":338,"_29027":268,"_20151":48252,"_5":13779,"_26422":48075,"_2810":48253},[],"Port 443 reaches that address from the client network.",{"_3322":339,"_29027":268,"_20151":48255,"_5":13779,"_26422":48075,"_2810":48256},[],"DNS resolves to the externally reachable endpoint.",{"_3322":340,"_29027":268,"_20151":48258,"_5":13779,"_26422":48075,"_2810":48259},[],"The certificate contains the DNS name or IP used by the client.",{"_3322":341,"_29027":268,"_20151":48261,"_5":13779,"_26422":48075,"_2810":48262},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3322":342,"_29027":342,"_5":14137,"_2810":47352,"_29350":48264,"_20151":48265,"_26422":342},[47245,47246,47352],[],{"_3322":343,"_29027":342,"_20151":48267,"_5":13779,"_26422":342,"_2810":48268},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3322":344,"_29027":342,"_5":29347,"_20151":48270,"_26422":48271,"_2810":48272},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3322":345,"_29027":342,"_5":29347,"_20151":48274,"_26422":48275,"_2810":48276},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3322":346,"_29027":342,"_5":29347,"_20151":48278,"_26422":48279,"_2810":48280},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3322":347,"_29027":342,"_5":29347,"_20151":48282,"_26422":48283,"_2810":48284},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3322":348,"_29027":342,"_5":29347,"_20151":48286,"_26422":48287,"_2810":48288},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3322":349,"_29027":342,"_5":29347,"_20151":48290,"_26422":48291,"_2810":48292},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3322":350,"_29027":342,"_20151":48294,"_5":13779,"_26422":48271,"_2810":48295},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3322":351,"_29027":342,"_20151":48297,"_5":13779,"_26422":48275,"_2810":48298},[],"Workflow",{"_3322":352,"_29027":342,"_20151":48300,"_5":13779,"_26422":48275,"_2810":48301},[],"Use it for",{"_3322":353,"_29027":342,"_20151":48303,"_5":13779,"_26422":48275,"_2810":48304},[],"What it installs",{"_3322":354,"_29027":342,"_20151":48306,"_5":13779,"_26422":48275,"_2810":48307},[],"Helm",{"_3322":355,"_29027":342,"_20151":48309,"_5":13779,"_26422":48275,"_2810":48310},[],"Production and controlled environments",{"_3322":356,"_29027":342,"_20151":48312,"_5":13779,"_26422":48275,"_2810":48313},[],"Lamassu services and Gateway API resources",{"_3322":357,"_29027":342,"_20151":48315,"_5":13779,"_26422":48275,"_2810":47489},[],{"_3322":358,"_29027":342,"_20151":48317,"_5":13779,"_26422":48275,"_2810":48318},[],"Evaluation, demos, CI and small lab clusters",{"_3322":359,"_29027":342,"_20151":48320,"_5":13779,"_26422":48275,"_2810":48321},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3322":360,"_29027":342,"_20151":48323,"_5":13779,"_26422":48279,"_2810":48324},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3322":361,"_29027":342,"_20151":48326,"_5":13779,"_26422":48279,"_2810":48327},[],"Area",{"_3322":362,"_29027":342,"_20151":48329,"_5":13779,"_26422":48279,"_2810":48330},[],"The Lamassu chart provides",{"_3322":363,"_29027":342,"_20151":48332,"_5":13779,"_26422":48279,"_2810":48333},[],"You provide",{"_3322":364,"_29027":342,"_20151":48335,"_5":13779,"_26422":48279,"_2810":48336},[],"Lamassu applications",{"_3322":365,"_29027":342,"_20151":48338,"_5":13779,"_26422":48279,"_2810":48339},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3322":366,"_29027":342,"_20151":48341,"_5":13779,"_26422":48279,"_2810":48342},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3322":367,"_29027":342,"_20151":48344,"_5":13779,"_26422":48279,"_2810":48345},[],"PostgreSQL data",{"_3322":368,"_29027":342,"_20151":48347,"_5":13779,"_26422":48279,"_2810":48348},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3322":369,"_29027":342,"_20151":48350,"_5":13779,"_26422":48279,"_2810":48351},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3322":370,"_29027":342,"_20151":48353,"_5":13779,"_26422":48279,"_2810":48354},[],"Messaging",{"_3322":371,"_29027":342,"_20151":48356,"_5":13779,"_26422":48279,"_2810":48357},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3322":372,"_29027":342,"_20151":48359,"_5":13779,"_26422":48279,"_2810":48360},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3322":373,"_29027":342,"_20151":48362,"_5":13779,"_26422":48279,"_2810":48363},[],"Identity",{"_3322":374,"_29027":342,"_20151":48365,"_5":13779,"_26422":48279,"_2810":48366},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3322":375,"_29027":342,"_20151":48368,"_5":13779,"_26422":48279,"_2810":48369},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3322":376,"_29027":342,"_20151":48371,"_5":13779,"_26422":48279,"_2810":48372},[],"External routing",{"_3322":377,"_29027":342,"_20151":48374,"_5":13779,"_26422":48279,"_2810":48375},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3322":378,"_29027":342,"_20151":48377,"_5":13779,"_26422":48279,"_2810":48378},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3322":379,"_29027":342,"_20151":48380,"_5":13779,"_26422":48279,"_2810":48381},[],"TLS",{"_3322":380,"_29027":342,"_20151":48383,"_5":13779,"_26422":48279,"_2810":48384},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3322":381,"_29027":342,"_20151":48386,"_5":13779,"_26422":48279,"_2810":48387},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3322":382,"_29027":342,"_20151":48389,"_5":13779,"_26422":48279,"_2810":48390},[],"Persistent application data",{"_3322":383,"_29027":342,"_20151":48392,"_5":13779,"_26422":48279,"_2810":48393},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3322":384,"_29027":342,"_20151":48395,"_5":13779,"_26422":48279,"_2810":48396},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3322":385,"_29027":342,"_20151":48398,"_5":13779,"_26422":48279,"_2810":48399},[],"Optional integrations",{"_3322":386,"_29027":342,"_20151":48401,"_5":13779,"_26422":48279,"_2810":48402},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3322":387,"_29027":342,"_20151":48404,"_5":13779,"_26422":48279,"_2810":48405},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3322":388,"_29027":342,"_20151":48407,"_5":13779,"_26422":48279,"_2810":48408},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3322":389,"_29027":342,"_20151":48410,"_5":13779,"_26422":48279,"_2810":48411},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3322":390,"_29027":342,"_20151":48413,"_5":13779,"_26422":48283,"_2810":48414},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3322":391,"_29027":342,"_20151":48416,"_5":13779,"_26422":48283,"_2810":48417},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3322":392,"_29027":342,"_20151":48419,"_5":13779,"_26422":48287,"_2810":48420},[],"Kubernetes 1.24 or newer",{"_3322":393,"_29027":342,"_20151":48422,"_5":13779,"_26422":48287,"_2810":48423},[],"Helm 3.2 or newer",{"_3322":394,"_29027":342,"_20151":48425,"_5":13779,"_26422":48287,"_2810":48426},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3322":395,"_29027":342,"_20151":48428,"_5":13779,"_26422":48287,"_2810":48429},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3322":396,"_29027":342,"_20151":48431,"_5":13779,"_26422":48287,"_2810":48432},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3322":397,"_29027":342,"_20151":48434,"_5":13779,"_26422":48287,"_2810":48435},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3322":398,"_29027":342,"_20151":48437,"_5":13779,"_26422":48287,"_2810":48438},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3322":399,"_29027":342,"_20151":48440,"_5":13779,"_26422":48291,"_2810":48441},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3322":400,"_29027":342,"_20151":48443,"_5":13779,"_26422":48291,"_2810":48444},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3322":401,"_29027":342,"_20151":48446,"_5":13779,"_26422":48291,"_2810":48447},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3322":402,"_29027":342,"_20151":48449,"_5":13779,"_26422":48291,"_2810":48450},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3322":403,"_29027":403,"_5":14137,"_2810":48452,"_29350":48453,"_20151":48455,"_26422":403},"Deployment troubleshooting",[47245,47246,48454],"Operations",[],{"_3322":404,"_29027":403,"_20151":48457,"_5":13779,"_26422":403,"_2810":48458},[],"Diagnose access, service health and infrastructure dependencies.",{"_3322":405,"_29027":403,"_5":29347,"_20151":48460,"_26422":48461,"_2810":48462},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3322":406,"_29027":403,"_5":29347,"_20151":48464,"_26422":48465,"_2810":48466},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3322":407,"_29027":403,"_5":29347,"_20151":48468,"_26422":48469,"_2810":48470},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3322":408,"_29027":403,"_5":29347,"_20151":48472,"_26422":48473,"_2810":48474},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3322":409,"_29027":403,"_5":29347,"_20151":48476,"_26422":48477,"_2810":48478},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3322":410,"_29027":403,"_5":29347,"_20151":48480,"_26422":48481,"_2810":48482},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3322":411,"_29027":403,"_5":29347,"_20151":48484,"_26422":48485,"_2810":48486},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3322":412,"_29027":403,"_5":29347,"_20151":48488,"_26422":48489,"_2810":48490},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3322":413,"_29027":403,"_5":29347,"_20151":48492,"_26422":48493,"_2810":48494},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3322":414,"_29027":403,"_5":29347,"_20151":48496,"_26422":48497,"_2810":48498},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3322":415,"_29027":403,"_5":29347,"_20151":48500,"_26422":48501,"_2810":48502},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3322":416,"_29027":403,"_5":29347,"_20151":48504,"_26422":48505,"_2810":48506},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3322":417,"_29027":403,"_5":29347,"_20151":48508,"_26422":48509,"_2810":48510},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3322":418,"_29027":403,"_20151":48512,"_5":13779,"_26422":403,"_2810":48513},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3322":419,"_29027":403,"_20151":48515,"_5":13779,"_26422":48465,"_2810":48516},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3322":420,"_29027":403,"_20151":48518,"_5":13779,"_26422":48469,"_2810":48519},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3322":421,"_29027":403,"_20151":48521,"_5":13779,"_26422":48473,"_2810":48522},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3322":422,"_29027":403,"_20151":48524,"_5":13779,"_26422":48477,"_2810":48525},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3322":423,"_29027":403,"_20151":48527,"_5":13779,"_26422":48481,"_2810":48528},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3322":424,"_29027":403,"_20151":48530,"_5":13779,"_26422":48485,"_2810":48531},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3322":425,"_29027":403,"_20151":48533,"_5":13779,"_26422":48485,"_2810":48534},[],"Also run the chart's connectivity test:",{"_3322":426,"_29027":403,"_20151":48536,"_5":13779,"_26422":48485,"_2810":48537},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3322":427,"_29027":403,"_20151":48539,"_5":13779,"_26422":48485,"_2810":48540},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3322":428,"_29027":403,"_20151":48542,"_5":13779,"_26422":48489,"_2810":48543},[],"If you receive a 401:",{"_3322":429,"_29027":403,"_20151":48545,"_5":13779,"_26422":48489,"_2810":48546},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3322":430,"_29027":403,"_20151":48548,"_5":13779,"_26422":48489,"_2810":48549},[],"verify issuer, audience and expiration of the token;",{"_3322":431,"_29027":403,"_20151":48551,"_5":13779,"_26422":48489,"_2810":48552},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3322":432,"_29027":403,"_20151":48554,"_5":13779,"_26422":48489,"_2810":48555},[],"check that the provider's public and internal routes point to the same realm.",{"_3322":433,"_29027":403,"_20151":48557,"_5":13779,"_26422":48489,"_2810":48558},[],"If login succeeds but the APIs return 403:",{"_3322":434,"_29027":403,"_20151":48560,"_5":13779,"_26422":48489,"_2810":48561},[],"inspect the token's real claims;",{"_3322":435,"_29027":403,"_20151":48563,"_5":13779,"_26422":48489,"_2810":48564},[],"confirm they match an active principal;",{"_3322":436,"_29027":403,"_20151":48566,"_5":13779,"_26422":48489,"_2810":48567},[],"review the policies granted to that principal;",{"_3322":437,"_29027":403,"_20151":48569,"_5":13779,"_26422":48489,"_2810":48570},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3322":438,"_29027":403,"_20151":48572,"_5":13779,"_26422":48489,"_2810":48573},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3322":439,"_29027":403,"_20151":48575,"_5":13779,"_26422":48493,"_2810":48576},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3322":440,"_29027":403,"_20151":48578,"_5":13779,"_26422":48493,"_2810":48579},[],"Locate the authz pod and Service.",{"_3322":441,"_29027":403,"_20151":48581,"_5":13779,"_26422":48493,"_2810":48582},[],"Check /health, logs and its database connection.",{"_3322":442,"_29027":403,"_20151":48584,"_5":13779,"_26422":48493,"_2810":48585},[],"Verify the DNS and port configured in externalAuthorization.",{"_3322":443,"_29027":403,"_20151":48587,"_5":13779,"_26422":48493,"_2810":48588},[],"Check the check route is /v1/ext\\_authz/check.",{"_3322":444,"_29027":403,"_20151":48590,"_5":13779,"_26422":48493,"_2810":48591},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3322":445,"_29027":403,"_20151":48593,"_5":13779,"_26422":48497,"_2810":48594},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3322":446,"_29027":403,"_20151":48596,"_5":13779,"_26422":48501,"_2810":48597},[],"Review kubectl describe pod first. Common causes are:",{"_3322":447,"_29027":403,"_20151":48599,"_5":13779,"_26422":48501,"_2810":48600},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3322":448,"_29027":403,"_20151":48602,"_5":13779,"_26422":48501,"_2810":48603},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3322":449,"_29027":403,"_20151":48605,"_5":13779,"_26422":48501,"_2810":48606},[],"unbound persistent volume;",{"_3322":450,"_29027":403,"_20151":48608,"_5":13779,"_26422":48501,"_2810":48609},[],"inaccessible image or incorrect pull policy;",{"_3322":451,"_29027":403,"_20151":48611,"_5":13779,"_26422":48501,"_2810":48612},[],"invalid cryptographic engine configuration;",{"_3322":452,"_29027":403,"_20151":48614,"_5":13779,"_26422":48501,"_2810":48615},[],"CPU or memory limits set too low;",{"_3322":453,"_29027":403,"_20151":48617,"_5":13779,"_26422":48501,"_2810":48618},[],"an incomplete prior migration.",{"_3322":454,"_29027":403,"_20151":48620,"_5":13779,"_26422":48501,"_2810":48621},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3322":455,"_29027":403,"_20151":48623,"_5":13779,"_26422":48501,"_2810":48624},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3322":456,"_29027":403,"_20151":48626,"_5":13779,"_26422":48501,"_2810":48627},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3322":457,"_29027":403,"_20151":48629,"_5":13779,"_26422":48505,"_2810":48630},[],"Domain and audit events depend on the bus publisher:",{"_3322":458,"_29027":403,"_20151":48632,"_5":13779,"_26422":48505,"_2810":48633},[],"verify it is enabled in the emitting service;",{"_3322":459,"_29027":403,"_20151":48635,"_5":13779,"_26422":48505,"_2810":48636},[],"check AMQP connectivity and credentials;",{"_3322":460,"_29027":403,"_20151":48638,"_5":13779,"_26422":48505,"_2810":48639},[],"review exchange, routing key, queues and consumers;",{"_3322":461,"_29027":403,"_20151":48641,"_5":13779,"_26422":48505,"_2810":48642},[],"inspect dead-letter queues;",{"_3322":462,"_29027":403,"_20151":48644,"_5":13779,"_26422":48505,"_2810":48645},[],"alert on orphan durable queues and backlog growth.",{"_3322":463,"_29027":403,"_20151":48647,"_5":13779,"_26422":48505,"_2810":48648},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3322":464,"_29027":403,"_20151":48650,"_5":13779,"_26422":48505,"_2810":48651},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3322":465,"_29027":403,"_20151":48653,"_5":13779,"_26422":48505,"_2810":48654},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3322":466,"_29027":403,"_20151":48656,"_5":13779,"_26422":48505,"_2810":48657},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3322":467,"_29027":403,"_20151":48659,"_5":13779,"_26422":48505,"_2810":48660},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3322":468,"_29027":403,"_20151":48662,"_5":13779,"_26422":48505,"_2810":48663},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3322":469,"_29027":403,"_20151":48665,"_5":13779,"_26422":48505,"_2810":48666},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3322":470,"_29027":403,"_20151":48668,"_5":13779,"_26422":48509,"_2810":48669},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3322":471,"_29027":403,"_20151":48671,"_5":13779,"_26422":48509,"_2810":48672},[],"Before closing an incident, record:",{"_3322":472,"_29027":403,"_20151":48674,"_5":13779,"_26422":48509,"_2810":48675},[],"the confirmed cause;",{"_3322":473,"_29027":403,"_20151":48677,"_5":13779,"_26422":48509,"_2810":48678},[],"the time scope and affected resources;",{"_3322":474,"_29027":403,"_20151":48680,"_5":13779,"_26422":48509,"_2810":48681},[],"the commands or queries used;",{"_3322":475,"_29027":403,"_20151":48683,"_5":13779,"_26422":48509,"_2810":48684},[],"the applied change and how to revert it;",{"_3322":476,"_29027":403,"_20151":48686,"_5":13779,"_26422":48509,"_2810":48687},[],"validation from a consumer;",{"_3322":477,"_29027":403,"_20151":48689,"_5":13779,"_26422":48509,"_2810":48690},[],"the preventive action and its owner.",{"_3322":478,"_29027":478,"_5":14137,"_2810":48692,"_29350":48693,"_20151":48696,"_26422":478},"Access control",[47245,48694,48695],"Platform","Administration",[],{"_3322":479,"_29027":478,"_20151":48698,"_5":13779,"_26422":478,"_2810":48699},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3322":480,"_29027":478,"_5":29347,"_20151":48701,"_26422":48702,"_2810":48703},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3322":481,"_29027":478,"_5":29347,"_20151":48705,"_26422":48706,"_2810":48707},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3322":482,"_29027":478,"_5":29347,"_20151":48709,"_26422":48710,"_2810":48711},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3322":483,"_29027":478,"_5":29347,"_20151":48713,"_26422":48714,"_2810":48715},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3322":484,"_29027":478,"_5":29347,"_20151":48717,"_26422":48718,"_2810":48719},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3322":485,"_29027":478,"_5":29347,"_20151":48721,"_26422":48722,"_2810":48723},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3322":486,"_29027":478,"_5":29347,"_20151":48725,"_26422":48726,"_2810":48727},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3322":487,"_29027":478,"_5":29347,"_20151":48729,"_26422":48730,"_2810":48731},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3322":488,"_29027":478,"_5":29347,"_20151":48733,"_26422":48734,"_2810":48735},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3322":489,"_29027":478,"_5":29347,"_20151":48737,"_26422":48738,"_2810":48739},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3322":490,"_29027":478,"_5":29347,"_20151":48741,"_26422":48742,"_2810":48743},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3322":491,"_29027":478,"_5":29347,"_20151":48745,"_26422":48746,"_2810":48747},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3322":492,"_29027":478,"_5":29347,"_20151":48749,"_26422":48750,"_2810":48751},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3322":493,"_29027":478,"_5":29347,"_20151":48753,"_26422":48754,"_2810":48755},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3322":494,"_29027":478,"_5":29347,"_20151":48757,"_26422":48758,"_2810":48759},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3322":495,"_29027":478,"_5":29347,"_20151":48761,"_26422":48762,"_2810":47885},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3322":496,"_29027":478,"_5":29347,"_20151":48764,"_26422":48765,"_2810":48766},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3322":497,"_29027":478,"_5":29347,"_20151":48768,"_26422":48769,"_2810":48770},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3322":498,"_29027":478,"_5":29347,"_20151":48772,"_26422":48773,"_2810":48774},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3322":499,"_29027":478,"_5":29347,"_20151":48776,"_26422":48777,"_2810":48778},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3322":500,"_29027":478,"_5":29347,"_20151":48780,"_26422":48781,"_2810":48782},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3322":501,"_29027":478,"_5":29347,"_20151":48784,"_26422":48785,"_2810":48786},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3322":502,"_29027":478,"_5":29347,"_20151":48788,"_26422":48789,"_2810":48790},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3322":503,"_29027":478,"_5":29347,"_20151":48792,"_26422":48793,"_2810":48794},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3322":504,"_29027":478,"_5":29347,"_20151":48796,"_26422":48797,"_2810":48798},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3322":505,"_29027":478,"_5":29347,"_20151":48800,"_26422":48801,"_2810":48802},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3322":506,"_29027":478,"_5":29347,"_20151":48804,"_26422":48805,"_2810":48806},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3322":507,"_29027":478,"_5":29347,"_20151":48808,"_26422":48809,"_2810":48810},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3322":508,"_29027":478,"_5":29347,"_20151":48812,"_26422":48813,"_2810":48814},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3322":509,"_29027":478,"_5":29347,"_20151":48816,"_26422":48817,"_2810":48818},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3322":510,"_29027":478,"_5":29347,"_20151":48820,"_26422":48821,"_2810":48822},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3322":511,"_29027":478,"_20151":48824,"_5":13779,"_26422":478,"_2810":48825},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3322":512,"_29027":478,"_20151":48827,"_5":13779,"_26422":478,"_2810":48828},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3322":513,"_29027":478,"_20151":48830,"_5":13779,"_26422":478,"_2810":48831},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3322":514,"_29027":478,"_20151":48833,"_5":13779,"_26422":48702,"_2810":48834},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3322":515,"_29027":478,"_20151":48836,"_5":13779,"_26422":48702,"_2810":48837},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3322":516,"_29027":478,"_20151":48839,"_5":13779,"_26422":48702,"_2810":48840},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3322":517,"_29027":478,"_20151":48842,"_5":13779,"_26422":48702,"_2810":48843},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3322":518,"_29027":478,"_20151":48845,"_5":13779,"_26422":48702,"_2810":48846},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3322":519,"_29027":478,"_20151":48848,"_5":13779,"_26422":48702,"_2810":48849},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3322":520,"_29027":478,"_20151":48851,"_5":13779,"_26422":48706,"_2810":48852},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3322":521,"_29027":478,"_20151":48854,"_5":13779,"_26422":48706,"_2810":48855},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3322":522,"_29027":478,"_20151":48857,"_5":13779,"_26422":48710,"_2810":48858},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3322":523,"_29027":478,"_20151":48860,"_5":13779,"_26422":48710,"_2810":48861},[],"The decision is made **before forwarding the request to the service**:",{"_3322":524,"_29027":478,"_20151":48863,"_5":13779,"_26422":48710,"_2810":48864},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3322":525,"_29027":478,"_20151":48866,"_5":13779,"_26422":48710,"_2810":48867},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3322":526,"_29027":478,"_20151":48869,"_5":13779,"_26422":48710,"_2810":48870},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3322":527,"_29027":478,"_20151":48872,"_5":13779,"_26422":48710,"_2810":48873},[],"It separately loads the policies granted to each principal.",{"_3322":528,"_29027":478,"_20151":48875,"_5":13779,"_26422":48710,"_2810":48876},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3322":529,"_29027":478,"_20151":48878,"_5":13779,"_26422":48710,"_2810":48879},[],"`authz` looks for an HTTP rule granting that action.",{"_3322":530,"_29027":478,"_20151":48881,"_5":13779,"_26422":48710,"_2810":48882},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3322":531,"_29027":478,"_20151":48884,"_5":13779,"_26422":48710,"_2810":48885},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3322":532,"_29027":478,"_20151":48887,"_5":13779,"_26422":48710,"_2810":48888},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context.",{"_3322":533,"_29027":478,"_20151":48890,"_5":13779,"_26422":48710,"_2810":48891},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3322":534,"_29027":478,"_20151":48893,"_5":13779,"_26422":48714,"_2810":48894},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3322":535,"_29027":478,"_20151":48896,"_5":13779,"_26422":48714,"_2810":48897},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3322":536,"_29027":478,"_20151":48899,"_5":13779,"_26422":48714,"_2810":48900},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3322":537,"_29027":478,"_20151":48902,"_5":13779,"_26422":48714,"_2810":48903},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3322":538,"_29027":478,"_20151":48905,"_5":13779,"_26422":48714,"_2810":48906},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3322":539,"_29027":478,"_20151":48908,"_5":13779,"_26422":48714,"_2810":48909},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3322":540,"_29027":478,"_20151":48911,"_5":13779,"_26422":48714,"_2810":48912},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3322":541,"_29027":478,"_20151":48914,"_5":13779,"_26422":48714,"_2810":48915},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3322":542,"_29027":478,"_20151":48917,"_5":13779,"_26422":48718,"_2810":48918},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3322":543,"_29027":478,"_20151":48920,"_5":13779,"_26422":48718,"_2810":48921},[],"The decision is made with the domain operation context:",{"_3322":544,"_29027":478,"_20151":48923,"_5":13779,"_26422":48718,"_2810":48924},[],"The middleware extracts the credential and resolves the matching principals.",{"_3322":545,"_29027":478,"_20151":48926,"_5":13779,"_26422":48718,"_2810":48927},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3322":546,"_29027":478,"_20151":48929,"_5":13779,"_26422":48718,"_2810":48930},[],"`authz` gathers the entity rules of the granted policies.",{"_3322":547,"_29027":478,"_20151":48932,"_5":13779,"_26422":48718,"_2810":48933},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3322":548,"_29027":478,"_20151":48935,"_5":13779,"_26422":48718,"_2810":48936},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3322":549,"_29027":478,"_20151":48938,"_5":13779,"_26422":48718,"_2810":48939},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3322":550,"_29027":478,"_20151":48941,"_5":13779,"_26422":48718,"_2810":48942},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3322":551,"_29027":478,"_20151":48944,"_5":13779,"_26422":48718,"_2810":48945},[],"Actions fall into two groups:",{"_3322":552,"_29027":478,"_20151":48947,"_5":13779,"_26422":48718,"_2810":48948},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3322":553,"_29027":478,"_20151":48950,"_5":13779,"_26422":48718,"_2810":48951},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3322":554,"_29027":478,"_20151":48953,"_5":13779,"_26422":48718,"_2810":48954},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3322":555,"_29027":478,"_20151":48956,"_5":13779,"_26422":48722,"_2810":48957},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3322":556,"_29027":478,"_20151":48959,"_5":13779,"_26422":48722,"_2810":48960},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3322":557,"_29027":478,"_20151":48962,"_5":13779,"_26422":48722,"_2810":48963},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3322":558,"_29027":478,"_20151":48965,"_5":13779,"_26422":48726,"_2810":48966},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3322":559,"_29027":478,"_20151":48968,"_5":13779,"_26422":48726,"_2810":48969},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3322":560,"_29027":478,"_20151":48971,"_5":13779,"_26422":48726,"_2810":48972},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3322":561,"_29027":478,"_20151":48974,"_5":13779,"_26422":48726,"_2810":48975},[],"The implemented operators are:",{"_3322":562,"_29027":478,"_20151":48977,"_5":13779,"_26422":48726,"_2810":48978},[],"`equals`, for exact equality;",{"_3322":563,"_29027":478,"_20151":48980,"_5":13779,"_26422":48726,"_2810":48981},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3322":564,"_29027":478,"_20151":48983,"_5":13779,"_26422":48726,"_2810":48984},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3322":565,"_29027":478,"_20151":48986,"_5":13779,"_26422":48726,"_2810":48987},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3322":566,"_29027":478,"_20151":48989,"_5":13779,"_26422":48730,"_2810":48990},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3322":567,"_29027":478,"_20151":48992,"_5":13779,"_26422":48730,"_2810":48993},[],"The available modes are:",{"_3322":568,"_29027":478,"_20151":48995,"_5":13779,"_26422":48730,"_2810":48996},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3322":569,"_29027":478,"_20151":48998,"_5":13779,"_26422":48730,"_2810":48999},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3322":570,"_29027":478,"_20151":49001,"_5":13779,"_26422":48730,"_2810":49002},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3322":571,"_29027":478,"_20151":49004,"_5":13779,"_26422":48730,"_2810":49005},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3322":572,"_29027":478,"_20151":49007,"_5":13779,"_26422":48730,"_2810":49008},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3322":573,"_29027":478,"_20151":49010,"_5":13779,"_26422":48730,"_2810":49011},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3322":574,"_29027":478,"_20151":49013,"_5":13779,"_26422":48734,"_2810":49014},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3322":575,"_29027":478,"_20151":49016,"_5":13779,"_26422":48734,"_2810":49017},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3322":576,"_29027":478,"_20151":49019,"_5":13779,"_26422":48734,"_2810":49020},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3322":577,"_29027":478,"_20151":49022,"_5":13779,"_26422":48734,"_2810":49023},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3322":578,"_29027":478,"_20151":49025,"_5":13779,"_26422":48742,"_2810":49026},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3322":579,"_29027":478,"_20151":49028,"_5":13779,"_26422":48742,"_2810":49029},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3322":580,"_29027":478,"_20151":49031,"_5":13779,"_26422":48746,"_2810":49032},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA and of a device to its DMS. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3322":581,"_29027":478,"_20151":49034,"_5":13779,"_26422":48746,"_2810":49035},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3322":582,"_29027":478,"_20151":49037,"_5":13779,"_26422":48750,"_2810":49038},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3322":583,"_29027":478,"_20151":49040,"_5":13779,"_26422":48750,"_2810":49041},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3322":584,"_29027":478,"_20151":49043,"_5":13779,"_26422":48750,"_2810":49044},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3322":585,"_29027":478,"_20151":49046,"_5":13779,"_26422":48754,"_2810":49047},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3322":586,"_29027":478,"_20151":49049,"_5":13779,"_26422":48754,"_2810":49050},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3322":587,"_29027":478,"_20151":49052,"_5":13779,"_26422":48754,"_2810":49053},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3322":588,"_29027":478,"_20151":49055,"_5":13779,"_26422":48754,"_2810":49056},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3322":589,"_29027":478,"_20151":49058,"_5":13779,"_26422":48754,"_2810":49059},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3322":590,"_29027":478,"_20151":49061,"_5":13779,"_26422":48754,"_2810":49062},[],"Note that:",{"_3322":591,"_29027":478,"_20151":49064,"_5":13779,"_26422":48754,"_2810":49065},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3322":592,"_29027":478,"_20151":49067,"_5":13779,"_26422":48754,"_2810":49068},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3322":593,"_29027":478,"_20151":49070,"_5":13779,"_26422":48754,"_2810":49071},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3322":594,"_29027":478,"_20151":49073,"_5":13779,"_26422":48758,"_2810":49074},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3322":595,"_29027":478,"_20151":49076,"_5":13779,"_26422":48758,"_2810":49077},[],"full and read-only access to certificates and authorities;",{"_3322":596,"_29027":478,"_20151":49079,"_5":13779,"_26422":48758,"_2810":49080},[],"full and read-only access to the KMS;",{"_3322":597,"_29027":478,"_20151":49082,"_5":13779,"_26422":48758,"_2810":49083},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3322":598,"_29027":478,"_20151":49085,"_5":13779,"_26422":48758,"_2810":49086},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3322":599,"_29027":478,"_20151":49088,"_5":13779,"_26422":48758,"_2810":49089},[],"console access;",{"_3322":600,"_29027":478,"_20151":49091,"_5":13779,"_26422":48758,"_2810":49092},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3322":601,"_29027":478,"_20151":49094,"_5":13779,"_26422":48758,"_2810":49095},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3322":602,"_29027":478,"_20151":49097,"_5":13779,"_26422":48758,"_2810":49098},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3322":603,"_29027":478,"_20151":49100,"_5":13779,"_26422":48762,"_2810":49101},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3322":604,"_29027":478,"_20151":49103,"_5":13779,"_26422":48762,"_2810":49104},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3322":605,"_29027":478,"_20151":49106,"_5":13779,"_26422":48762,"_2810":49107},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3322":606,"_29027":478,"_20151":49109,"_5":13779,"_26422":48765,"_2810":49110},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3322":607,"_29027":478,"_20151":49112,"_5":13779,"_26422":48769,"_2810":49113},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3322":608,"_29027":478,"_20151":49115,"_5":13779,"_26422":48769,"_2810":49116},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3322":609,"_29027":478,"_20151":49118,"_5":13779,"_26422":48773,"_2810":49119},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3322":610,"_29027":478,"_20151":49121,"_5":13779,"_26422":48777,"_2810":49122},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3322":611,"_29027":478,"_20151":49124,"_5":13779,"_26422":48781,"_2810":49125},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3322":612,"_29027":478,"_20151":49127,"_5":13779,"_26422":48785,"_2810":49128},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3322":613,"_29027":478,"_20151":49130,"_5":13779,"_26422":48785,"_2810":49131},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3322":614,"_29027":478,"_20151":49133,"_5":13779,"_26422":48789,"_2810":49134},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3322":615,"_29027":478,"_20151":49136,"_5":13779,"_26422":48789,"_2810":49137},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3322":616,"_29027":478,"_20151":49139,"_5":13779,"_26422":48789,"_2810":49140},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3322":617,"_29027":478,"_20151":49142,"_5":13779,"_26422":48789,"_2810":49143},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3322":618,"_29027":478,"_20151":49145,"_5":13779,"_26422":48789,"_2810":49146},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3322":619,"_29027":478,"_20151":49148,"_5":13779,"_26422":48789,"_2810":49149},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3322":620,"_29027":478,"_20151":49151,"_5":13779,"_26422":48789,"_2810":49152},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3322":621,"_29027":478,"_20151":49154,"_5":13779,"_26422":48789,"_2810":49155},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3322":622,"_29027":478,"_20151":49157,"_5":13779,"_26422":48793,"_2810":49158},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3322":623,"_29027":478,"_20151":49160,"_5":13779,"_26422":48793,"_2810":49161},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3322":624,"_29027":478,"_20151":49163,"_5":13779,"_26422":48793,"_2810":49164},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3322":625,"_29027":478,"_20151":49166,"_5":13779,"_26422":48797,"_2810":49167},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3322":626,"_29027":478,"_20151":49169,"_5":13779,"_26422":48797,"_2810":49170},[],"Use groups or stable roles for people and independent identities for automations.",{"_3322":627,"_29027":478,"_20151":49172,"_5":13779,"_26422":48797,"_2810":49173},[],"Keep at least two recovery administrators and test their access periodically.",{"_3322":628,"_29027":478,"_20151":49175,"_5":13779,"_26422":48797,"_2810":49176},[],"Review active principals, their matches and their grants after IdP changes.",{"_3322":629,"_29027":478,"_20151":49178,"_5":13779,"_26422":48797,"_2810":49179},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3322":630,"_29027":478,"_20151":49181,"_5":13779,"_26422":48797,"_2810":49182},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3322":631,"_29027":478,"_20151":49184,"_5":13779,"_26422":48797,"_2810":49185},[],"Always test one allowed and one denied operation for each role.",{"_3322":632,"_29027":478,"_20151":49187,"_5":13779,"_26422":48797,"_2810":49188},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3322":633,"_29027":478,"_20151":49190,"_5":13779,"_26422":48805,"_2810":49191},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3322":634,"_29027":478,"_20151":49193,"_5":13779,"_26422":48809,"_2810":49194},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3322":635,"_29027":478,"_20151":49196,"_5":13779,"_26422":48809,"_2810":49197},[],"that an active principal of the correct type exists;",{"_3322":636,"_29027":478,"_20151":49199,"_5":13779,"_26422":48809,"_2810":49200},[],"that the claim paths and values match the real token exactly;",{"_3322":637,"_29027":478,"_20151":49202,"_5":13779,"_26422":48809,"_2810":49203},[],"that all of the principal's conditions hold;",{"_3322":638,"_29027":478,"_20151":49205,"_5":13779,"_26422":48809,"_2810":49206},[],"that the principal has the expected policy granted;",{"_3322":639,"_29027":478,"_20151":49208,"_5":13779,"_26422":48809,"_2810":49209},[],"that the policy includes the action and the requested resource type or route;",{"_3322":640,"_29027":478,"_20151":49211,"_5":13779,"_26422":48809,"_2810":49212},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3322":641,"_29027":478,"_20151":49214,"_5":13779,"_26422":48809,"_2810":49215},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3322":642,"_29027":478,"_20151":49217,"_5":13779,"_26422":48813,"_2810":49218},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3322":643,"_29027":478,"_20151":49220,"_5":13779,"_26422":48817,"_2810":49221},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3322":644,"_29027":478,"_20151":49223,"_5":13779,"_26422":48821,"_2810":49224},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3322":645,"_29027":478,"_20151":49226,"_5":13779,"_26422":48821,"_2810":49227},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3322":646,"_29027":646,"_5":14137,"_2810":49229,"_29350":49230,"_20151":49231,"_26422":646},"Alerts and subscriptions",[47245,48694,48695],[],{"_3322":647,"_29027":646,"_20151":49233,"_5":13779,"_26422":646,"_2810":49234},[],"Send PKI events to people and external systems.",{"_3322":648,"_29027":646,"_5":29347,"_20151":49236,"_26422":49237,"_2810":49238},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3322":649,"_29027":646,"_5":29347,"_20151":49240,"_26422":49241,"_2810":49242},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3322":650,"_29027":646,"_5":29347,"_20151":49244,"_26422":49245,"_2810":49246},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3322":651,"_29027":646,"_5":29347,"_20151":49248,"_26422":49249,"_2810":49250},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3322":652,"_29027":646,"_5":29347,"_20151":49252,"_26422":49253,"_2810":49254},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3322":653,"_29027":646,"_5":29347,"_20151":49256,"_26422":49257,"_2810":49258},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3322":654,"_29027":646,"_5":29347,"_20151":49260,"_26422":49261,"_2810":49262},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3322":655,"_29027":646,"_5":29347,"_20151":49264,"_26422":49265,"_2810":49266},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3322":656,"_29027":646,"_5":29347,"_20151":49268,"_26422":49269,"_2810":49270},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3322":657,"_29027":646,"_5":29347,"_20151":49272,"_26422":49273,"_2810":49274},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3322":658,"_29027":646,"_5":29347,"_20151":49276,"_26422":49277,"_2810":49278},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3322":659,"_29027":646,"_20151":49280,"_5":13779,"_26422":646,"_2810":49281},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3322":660,"_29027":646,"_20151":49283,"_5":13779,"_26422":49237,"_2810":49284},[],"A service publishes a domain event.",{"_3322":661,"_29027":646,"_20151":49286,"_5":13779,"_26422":49237,"_2810":49287},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3322":662,"_29027":646,"_20151":49289,"_5":13779,"_26422":49237,"_2810":49290},[],"Each subscription's filter decides whether it should be notified.",{"_3322":663,"_29027":646,"_20151":49292,"_5":13779,"_26422":49237,"_2810":49293},[],"Lamassu delivers the event to the configured channel.",{"_3322":664,"_29027":646,"_20151":49295,"_5":13779,"_26422":49237,"_2810":49296},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3322":665,"_29027":646,"_20151":49298,"_5":13779,"_26422":49241,"_2810":49299},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3322":666,"_29027":646,"_20151":49301,"_5":13779,"_26422":49241,"_2810":49302},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3322":667,"_29027":646,"_20151":49304,"_5":13779,"_26422":49241,"_2810":49305},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3322":668,"_29027":646,"_20151":49307,"_5":13779,"_26422":49241,"_2810":49308},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3322":669,"_29027":646,"_20151":49310,"_5":13779,"_26422":49241,"_2810":49311},[],"`apikey_options` requires `header` and `key`.",{"_3322":670,"_29027":646,"_20151":49313,"_5":13779,"_26422":49241,"_2810":49314},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3322":671,"_29027":646,"_20151":49316,"_5":13779,"_26422":49241,"_2810":49317},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3322":672,"_29027":646,"_20151":49319,"_5":13779,"_26422":49241,"_2810":49320},[],"The alerts API reference documents the full `http_client` schema.",{"_3322":673,"_29027":646,"_20151":49322,"_5":13779,"_26422":49249,"_2810":49323},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3322":674,"_29027":646,"_20151":49325,"_5":13779,"_26422":49253,"_2810":49326},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3322":675,"_29027":646,"_20151":49328,"_5":13779,"_26422":49257,"_2810":49329},[],"Add a filter if you don't want to receive every instance of the event.",{"_3322":676,"_29027":646,"_20151":49331,"_5":13779,"_26422":49257,"_2810":49332},[],"**None** notifies all instances of the event.",{"_3322":677,"_29027":646,"_20151":49334,"_5":13779,"_26422":49257,"_2810":49335},[],"**JSON Path** evaluates one or more specific fields.",{"_3322":678,"_29027":646,"_20151":49337,"_5":13779,"_26422":49257,"_2810":49338},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3322":679,"_29027":646,"_20151":49340,"_5":13779,"_26422":49257,"_2810":49341},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3322":680,"_29027":646,"_20151":49343,"_5":13779,"_26422":49257,"_2810":49344},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3322":681,"_29027":646,"_20151":49346,"_5":13779,"_26422":49261,"_2810":49347},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3322":682,"_29027":646,"_20151":49349,"_5":13779,"_26422":49265,"_2810":49350},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3322":683,"_29027":646,"_20151":49352,"_5":13779,"_26422":49265,"_2810":49353},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3322":684,"_29027":646,"_20151":49355,"_5":13779,"_26422":49265,"_2810":49356},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3322":685,"_29027":646,"_20151":49358,"_5":13779,"_26422":49265,"_2810":49359},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3322":686,"_29027":646,"_20151":49361,"_5":13779,"_26422":49265,"_2810":49362},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3322":687,"_29027":646,"_20151":49364,"_5":13779,"_26422":49265,"_2810":49365},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3322":688,"_29027":646,"_20151":49367,"_5":13779,"_26422":49265,"_2810":49368},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3322":689,"_29027":646,"_20151":49370,"_5":13779,"_26422":49265,"_2810":49371},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3322":690,"_29027":646,"_20151":49373,"_5":13779,"_26422":49269,"_2810":49374},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3322":691,"_29027":646,"_20151":49376,"_5":13779,"_26422":49269,"_2810":49377},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3322":692,"_29027":646,"_20151":49379,"_5":13779,"_26422":49269,"_2810":49380},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3322":693,"_29027":646,"_20151":49382,"_5":13779,"_26422":49269,"_2810":49383},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3322":694,"_29027":646,"_20151":49385,"_5":13779,"_26422":49269,"_2810":49386},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3322":695,"_29027":646,"_20151":49388,"_5":13779,"_26422":49269,"_2810":49389},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3322":696,"_29027":646,"_20151":49391,"_5":13779,"_26422":49269,"_2810":49392},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3322":697,"_29027":646,"_20151":49394,"_5":13779,"_26422":49269,"_2810":49395},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3322":698,"_29027":646,"_20151":49397,"_5":13779,"_26422":49273,"_2810":49398},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3322":699,"_29027":646,"_20151":49400,"_5":13779,"_26422":49273,"_2810":49401},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3322":700,"_29027":646,"_20151":49403,"_5":13779,"_26422":49277,"_2810":49404},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3322":701,"_29027":646,"_20151":49406,"_5":13779,"_26422":49277,"_2810":49407},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3322":702,"_29027":646,"_20151":49409,"_5":13779,"_26422":49277,"_2810":49410},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3322":703,"_29027":646,"_20151":49412,"_5":13779,"_26422":49277,"_2810":49413},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3322":704,"_29027":646,"_20151":49415,"_5":13779,"_26422":49277,"_2810":49416},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3322":705,"_29027":646,"_20151":49418,"_5":13779,"_26422":49277,"_2810":49419},[],"**Validation:** `va.role.crl.create`.",{"_3322":706,"_29027":646,"_20151":49421,"_5":13779,"_26422":49277,"_2810":49422},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3322":707,"_29027":646,"_20151":49424,"_5":13779,"_26422":49277,"_2810":49425},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3322":708,"_29027":708,"_5":14137,"_2810":49427,"_29350":49428,"_20151":49429,"_26422":708},"Audit logs",[47245,48694,48695],[],{"_3322":709,"_29027":708,"_20151":49431,"_5":13779,"_26422":708,"_2810":49432},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3322":710,"_29027":708,"_5":29347,"_20151":49434,"_26422":49435,"_2810":49436},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3322":711,"_29027":708,"_5":29347,"_20151":49438,"_26422":49439,"_2810":49440},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3322":712,"_29027":708,"_5":29347,"_20151":49442,"_26422":49443,"_2810":49444},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3322":713,"_29027":708,"_5":29347,"_20151":49446,"_26422":49447,"_2810":49448},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3322":714,"_29027":708,"_5":29347,"_20151":49450,"_26422":49451,"_2810":49452},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3322":715,"_29027":708,"_5":29347,"_20151":49454,"_26422":49455,"_2810":49456},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3322":716,"_29027":708,"_5":29347,"_20151":49458,"_26422":49459,"_2810":49460},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3322":717,"_29027":708,"_5":29347,"_20151":49462,"_26422":49463,"_2810":49464},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3322":718,"_29027":708,"_5":29347,"_20151":49466,"_26422":49467,"_2810":49468},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3322":719,"_29027":708,"_5":29347,"_20151":49470,"_26422":49471,"_2810":49472},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3322":720,"_29027":708,"_5":29347,"_20151":49474,"_26422":49475,"_2810":49476},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3322":721,"_29027":708,"_20151":49478,"_5":13779,"_26422":708,"_2810":49479},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3322":722,"_29027":708,"_20151":49481,"_5":13779,"_26422":49435,"_2810":49482},[],"The audit body includes:",{"_3322":723,"_29027":708,"_20151":49484,"_5":13779,"_26422":49435,"_2810":49485},[],"input: data received by the operation;",{"_3322":724,"_29027":708,"_20151":49487,"_5":13779,"_26422":49435,"_2810":49488},[],"has\\_error: whether the service returned an error;",{"_3322":725,"_29027":708,"_20151":49490,"_5":13779,"_26422":49435,"_2810":49491},[],"output: produced result or error message;",{"_3322":726,"_29027":708,"_20151":49493,"_5":13779,"_26422":49435,"_2810":49494},[],"principals: identifiers of the principals that matched the request.",{"_3322":727,"_29027":708,"_20151":49496,"_5":13779,"_26422":49435,"_2810":49497},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3322":728,"_29027":708,"_20151":49499,"_5":13779,"_26422":49435,"_2810":49500},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3322":729,"_29027":708,"_20151":49502,"_5":13779,"_26422":49439,"_2810":49503},[],"The backend applies auditing to mutations of:",{"_3322":730,"_29027":708,"_20151":49505,"_5":13779,"_26422":49439,"_2810":49506},[],"authorities, certificates and issuance profiles;",{"_3322":731,"_29027":708,"_20151":49508,"_5":13779,"_26422":49439,"_2810":49509},[],"keys and KMS engines;",{"_3322":732,"_29027":708,"_20151":49511,"_5":13779,"_26422":49439,"_2810":49512},[],"devices and identities;",{"_3322":733,"_29027":708,"_20151":49514,"_5":13779,"_26422":49439,"_2810":49515},[],"DMSs and enrollment operations;",{"_3322":734,"_29027":708,"_20151":49517,"_5":13779,"_26422":49439,"_2810":49518},[],"validation functions and CRL;",{"_3322":735,"_29027":708,"_20151":49520,"_5":13779,"_26422":49439,"_2810":49521},[],"principals, policies and authorization grants.",{"_3322":736,"_29027":708,"_20151":49523,"_5":13779,"_26422":49439,"_2810":49524},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3322":737,"_29027":708,"_20151":49526,"_5":13779,"_26422":49443,"_2810":49527},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3322":738,"_29027":708,"_20151":49529,"_5":13779,"_26422":49443,"_2810":49530},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3322":739,"_29027":708,"_20151":49532,"_5":13779,"_26422":49443,"_2810":49533},[],"Design the consumer to:",{"_3322":740,"_29027":708,"_20151":49535,"_5":13779,"_26422":49443,"_2810":49536},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3322":741,"_29027":708,"_20151":49538,"_5":13779,"_26422":49443,"_2810":49539},[],"keep the complete CloudEvent unmodified;",{"_3322":742,"_29027":708,"_20151":49541,"_5":13779,"_26422":49443,"_2810":49542},[],"record the ingestion time and detect duplicates by ID;",{"_3322":743,"_29027":708,"_20151":49544,"_5":13779,"_26422":49443,"_2810":49545},[],"encrypt in transit and at rest;",{"_3322":744,"_29027":708,"_20151":49547,"_5":13779,"_26422":49443,"_2810":49548},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3322":745,"_29027":708,"_20151":49550,"_5":13779,"_26422":49443,"_2810":49551},[],"apply an explicit retention and legal hold policy;",{"_3322":746,"_29027":708,"_20151":49553,"_5":13779,"_26422":49443,"_2810":49554},[],"alert if it stops consuming or the pending queue grows.",{"_3322":747,"_29027":708,"_20151":49556,"_5":13779,"_26422":49447,"_2810":49557},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3322":748,"_29027":708,"_20151":49559,"_5":13779,"_26422":49447,"_2810":49560},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3322":749,"_29027":708,"_20151":49562,"_5":13779,"_26422":49455,"_2810":49563},[],"Start from the reported time and normalize every source to UTC.",{"_3322":750,"_29027":708,"_20151":49565,"_5":13779,"_26422":49459,"_2810":49566},[],"Filter by event type, service source and resource identifier.",{"_3322":751,"_29027":708,"_20151":49568,"_5":13779,"_26422":49463,"_2810":49569},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3322":752,"_29027":708,"_20151":49571,"_5":13779,"_26422":49467,"_2810":49572},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3322":753,"_29027":708,"_20151":49574,"_5":13779,"_26422":49471,"_2810":49575},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3322":754,"_29027":708,"_20151":49577,"_5":13779,"_26422":49475,"_2810":49578},[],"Generate a controlled mutation in a test environment and check that:",{"_3322":755,"_29027":708,"_20151":49580,"_5":13779,"_26422":49475,"_2810":49581},[],"a successful audit event appears;",{"_3322":756,"_29027":708,"_20151":49583,"_5":13779,"_26422":49475,"_2810":49584},[],"the principal matches the identity used;",{"_3322":757,"_29027":708,"_20151":49586,"_5":13779,"_26422":49475,"_2810":49587},[],"the consumer persists it exactly once;",{"_3322":758,"_29027":708,"_20151":49589,"_5":13779,"_26422":49475,"_2810":49590},[],"it can be retrieved by resource, actor and period;",{"_3322":759,"_29027":708,"_20151":49592,"_5":13779,"_26422":49475,"_2810":49593},[],"a consumer outage raises an alert.",{"_3322":760,"_29027":708,"_20151":49595,"_5":13779,"_26422":49475,"_2810":49596},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3322":761,"_29027":761,"_5":14137,"_2810":49598,"_29350":49599,"_20151":49600,"_26422":761},"Platform architecture",[47245,48694],[],{"_3322":762,"_29027":761,"_20151":49602,"_5":13779,"_26422":761,"_2810":49603},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3322":763,"_29027":761,"_5":29347,"_20151":49605,"_26422":49606,"_2810":49607},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3322":764,"_29027":761,"_5":29347,"_20151":49609,"_26422":49610,"_2810":49611},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3322":765,"_29027":761,"_5":29347,"_20151":49613,"_26422":49614,"_2810":49615},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3322":766,"_29027":761,"_5":29347,"_20151":49617,"_26422":49618,"_2810":49619},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3322":767,"_29027":761,"_5":29347,"_20151":49621,"_26422":49622,"_2810":49623},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3322":768,"_29027":761,"_20151":49625,"_5":13779,"_26422":761,"_2810":49626},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3322":769,"_29027":761,"_20151":49628,"_5":13779,"_26422":761,"_2810":49629},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3322":770,"_29027":761,"_20151":49631,"_5":13779,"_26422":49606,"_2810":49632},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3322":771,"_29027":761,"_20151":49634,"_5":13779,"_26422":49610,"_2810":49635},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3322":772,"_29027":761,"_20151":49637,"_5":13779,"_26422":49614,"_2810":49638},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3322":773,"_29027":761,"_20151":49640,"_5":13779,"_26422":49618,"_2810":49641},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3322":774,"_29027":761,"_20151":49643,"_5":13779,"_26422":49622,"_2810":49644},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3322":775,"_29027":775,"_5":14137,"_2810":49646,"_29350":49647,"_20151":49648,"_26422":775},"How Lamassu works",[47245,48694],[],{"_3322":776,"_29027":775,"_20151":49650,"_5":13779,"_26422":775,"_2810":49651},[],"The mental model of trust, keys, certificates and devices.",{"_3322":777,"_29027":775,"_5":29347,"_20151":49653,"_26422":49654,"_2810":49655},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3322":778,"_29027":775,"_5":29347,"_20151":49657,"_26422":49658,"_2810":49659},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3322":779,"_29027":775,"_20151":49661,"_5":13779,"_26422":775,"_2810":49662},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3322":780,"_29027":775,"_20151":49664,"_5":13779,"_26422":49654,"_2810":49665},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3322":781,"_29027":775,"_20151":49667,"_5":13779,"_26422":49654,"_2810":49668},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3322":782,"_29027":775,"_20151":49670,"_5":13779,"_26422":49654,"_2810":49671},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3322":783,"_29027":775,"_20151":49673,"_5":13779,"_26422":49654,"_2810":49674},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3322":784,"_29027":775,"_20151":49676,"_5":13779,"_26422":49654,"_2810":49677},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3322":785,"_29027":775,"_20151":49679,"_5":13779,"_26422":49658,"_2810":49680},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3322":786,"_29027":775,"_20151":49682,"_5":13779,"_26422":49658,"_2810":49683},[],"A DMS relates that CA to an enrollment policy.",{"_3322":787,"_29027":775,"_20151":49685,"_5":13779,"_26422":49658,"_2810":49686},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3322":788,"_29027":775,"_20151":49688,"_5":13779,"_26422":49658,"_2810":49689},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3322":789,"_29027":775,"_20151":49691,"_5":13779,"_26422":49658,"_2810":49692},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3322":790,"_29027":775,"_20151":49694,"_5":13779,"_26422":49658,"_2810":49695},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3322":791,"_29027":775,"_20151":49697,"_5":13779,"_26422":49658,"_2810":49698},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3322":792,"_29027":792,"_5":14137,"_2810":49700,"_29350":49701,"_20151":49703,"_26422":792},"Devices and identities",[47245,48694,49702,49700],"IoT Fleets",[],{"_3322":793,"_29027":792,"_20151":49705,"_5":13779,"_26422":792,"_2810":49706},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3322":794,"_29027":792,"_5":29347,"_20151":49708,"_26422":49709,"_2810":49710},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3322":795,"_29027":792,"_5":29347,"_20151":49712,"_26422":49713,"_2810":49714},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3322":796,"_29027":792,"_5":29347,"_20151":49716,"_26422":49717,"_2810":49718},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3322":797,"_29027":792,"_5":29347,"_20151":49720,"_26422":49721,"_2810":49722},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3322":798,"_29027":792,"_5":29347,"_20151":49724,"_26422":49725,"_2810":49726},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3322":799,"_29027":792,"_5":29347,"_20151":49728,"_26422":49729,"_2810":49730},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3322":800,"_29027":792,"_5":29347,"_20151":49732,"_26422":49733,"_2810":49734},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3322":801,"_29027":792,"_5":29347,"_20151":49736,"_26422":49737,"_2810":49738},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3322":802,"_29027":792,"_5":29347,"_20151":49740,"_26422":49741,"_2810":49742},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3322":803,"_29027":792,"_5":29347,"_20151":49744,"_26422":49745,"_2810":49746},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3322":804,"_29027":792,"_5":29347,"_20151":49748,"_26422":49749,"_2810":49750},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3322":805,"_29027":792,"_20151":49752,"_5":13779,"_26422":792,"_2810":49753},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3322":806,"_29027":792,"_20151":49755,"_5":13779,"_26422":792,"_2810":49756},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3322":807,"_29027":792,"_20151":49758,"_5":13779,"_26422":49709,"_2810":49759},[],"Operational view",{"_3322":808,"_29027":792,"_20151":49761,"_5":13779,"_26422":49709,"_2810":49762},[],"Meaning",{"_3322":809,"_29027":792,"_20151":49764,"_5":13779,"_26422":49709,"_2810":49765},[],"**No Identity**",{"_3322":810,"_29027":792,"_20151":49767,"_5":13779,"_26422":49709,"_2810":49768},[],"A record exists without an associated identity.",{"_3322":811,"_29027":792,"_20151":49770,"_5":13779,"_26422":49709,"_2810":49771},[],"**Active**",{"_3322":812,"_29027":792,"_20151":49773,"_5":13779,"_26422":49709,"_2810":49774},[],"The slot is active; also check certificate dates, status and usages.",{"_3322":813,"_29027":792,"_20151":49776,"_5":13779,"_26422":49709,"_2810":49777},[],"**Renewal Pending**",{"_3322":814,"_29027":792,"_20151":49779,"_5":13779,"_26422":49709,"_2810":49780},[],"The identity is in the operational renewal window.",{"_3322":815,"_29027":792,"_20151":49782,"_5":13779,"_26422":49709,"_2810":49783},[],"**Expiring Soon**",{"_3322":816,"_29027":792,"_20151":49785,"_5":13779,"_26422":49709,"_2810":49786},[],"Expiration is approaching according to configured thresholds.",{"_3322":817,"_29027":792,"_20151":49788,"_5":13779,"_26422":49709,"_2810":49789},[],"**Expired**",{"_3322":818,"_29027":792,"_20151":49791,"_5":13779,"_26422":49709,"_2810":49792},[],"The identity has expired.",{"_3322":819,"_29027":792,"_20151":49794,"_5":13779,"_26422":49709,"_2810":49795},[],"**Revoked**",{"_3322":820,"_29027":792,"_20151":49797,"_5":13779,"_26422":49709,"_2810":49798},[],"The identity is marked revoked.",{"_3322":821,"_29027":792,"_20151":49800,"_5":13779,"_26422":49709,"_2810":49801},[],"**Decommissioned**",{"_3322":822,"_29027":792,"_20151":49803,"_5":13779,"_26422":49709,"_2810":49804},[],"The record is retired and ordinary updates do not restore operation.",{"_3322":823,"_29027":792,"_20151":49806,"_5":13779,"_26422":49709,"_2810":49807},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3322":824,"_29027":792,"_20151":49809,"_5":13779,"_26422":49713,"_2810":49810},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3322":825,"_29027":792,"_20151":49812,"_5":13779,"_26422":49713,"_2810":49813},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3322":826,"_29027":792,"_20151":49815,"_5":13779,"_26422":49713,"_2810":49816},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3322":827,"_29027":792,"_20151":49818,"_5":13779,"_26422":49713,"_2810":49819},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3322":828,"_29027":792,"_20151":49821,"_5":13779,"_26422":49717,"_2810":49822},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3322":829,"_29027":792,"_20151":49824,"_5":13779,"_26422":49721,"_2810":49825},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3322":830,"_29027":792,"_20151":49827,"_5":13779,"_26422":49725,"_2810":49828},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3322":831,"_29027":792,"_20151":49830,"_5":13779,"_26422":49729,"_2810":49831},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3322":832,"_29027":792,"_20151":49833,"_5":13779,"_26422":49733,"_2810":49834},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3322":833,"_29027":792,"_20151":49836,"_5":13779,"_26422":49733,"_2810":49837},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3322":834,"_29027":792,"_20151":49839,"_5":13779,"_26422":49737,"_2810":49840},[],"From **No Identity**, use **Assign Identity**:",{"_3322":835,"_29027":792,"_20151":49842,"_5":13779,"_26422":49737,"_2810":49843},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3322":836,"_29027":792,"_20151":49845,"_5":13779,"_26422":49737,"_2810":49846},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3322":837,"_29027":792,"_20151":49848,"_5":13779,"_26422":49737,"_2810":49849},[],"Confirm and read the serial, active version and history again.",{"_3322":838,"_29027":792,"_20151":49851,"_5":13779,"_26422":49737,"_2810":49852},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3322":839,"_29027":792,"_20151":49854,"_5":13779,"_26422":49737,"_2810":49855},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3322":840,"_29027":792,"_20151":49857,"_5":13779,"_26422":49741,"_2810":49858},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3322":841,"_29027":792,"_20151":49860,"_5":13779,"_26422":49741,"_2810":49861},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3322":842,"_29027":792,"_20151":49863,"_5":13779,"_26422":49745,"_2810":49864},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3322":843,"_29027":792,"_20151":49866,"_5":13779,"_26422":49745,"_2810":49867},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3322":844,"_29027":792,"_20151":49869,"_5":13779,"_26422":49745,"_2810":49870},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3322":845,"_29027":792,"_20151":49872,"_5":13779,"_26422":49745,"_2810":49873},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3322":846,"_29027":792,"_20151":49875,"_5":13779,"_26422":49749,"_2810":49876},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3322":847,"_29027":792,"_20151":49878,"_5":13779,"_26422":49749,"_2810":49879},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3322":848,"_29027":848,"_5":14137,"_2810":49881,"_29350":49882,"_20151":49884,"_26422":848},"Bootstrap identity and authentication",[47245,48694,49702,49700,49883],"Enrollment with PKI",[],{"_3322":849,"_29027":848,"_20151":49886,"_5":13779,"_26422":848,"_2810":49887},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3322":850,"_29027":848,"_5":29347,"_20151":49889,"_26422":49890,"_2810":49891},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3322":851,"_29027":848,"_5":29347,"_20151":49893,"_26422":49894,"_2810":49895},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3322":852,"_29027":848,"_5":29347,"_20151":49897,"_26422":49898,"_2810":49899},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3322":853,"_29027":848,"_5":29347,"_20151":49901,"_26422":49902,"_2810":49903},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3322":854,"_29027":848,"_5":29347,"_20151":49905,"_26422":49906,"_2810":49907},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3322":855,"_29027":848,"_20151":49909,"_5":13779,"_26422":848,"_2810":49910},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3322":856,"_29027":848,"_20151":49912,"_5":13779,"_26422":49890,"_2810":49913},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3322":857,"_29027":848,"_20151":49915,"_5":13779,"_26422":49890,"_2810":49916},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3322":858,"_29027":848,"_20151":49918,"_5":13779,"_26422":49894,"_2810":49919},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3322":859,"_29027":848,"_20151":49921,"_5":13779,"_26422":49894,"_2810":49922},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3322":860,"_29027":848,"_20151":49924,"_5":13779,"_26422":49894,"_2810":49925},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3322":861,"_29027":848,"_20151":49927,"_5":13779,"_26422":49898,"_2810":49928},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3322":862,"_29027":848,"_20151":49930,"_5":13779,"_26422":49898,"_2810":49931},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3322":863,"_29027":848,"_20151":49933,"_5":13779,"_26422":49902,"_2810":49934},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3322":864,"_29027":848,"_20151":49936,"_5":13779,"_26422":49902,"_2810":49937},[],"Example body:",{"_3322":865,"_29027":848,"_20151":49939,"_5":13779,"_26422":49902,"_2810":49940},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3322":866,"_29027":848,"_20151":49942,"_5":13779,"_26422":49902,"_2810":49943},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3322":867,"_29027":848,"_20151":49945,"_5":13779,"_26422":49902,"_2810":49946},[],"Continuation requires a successful HTTP response and JSON:",{"_3322":868,"_29027":848,"_20151":49948,"_5":13779,"_26422":49902,"_2810":49949},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3322":869,"_29027":848,"_20151":49951,"_5":13779,"_26422":49906,"_2810":49952},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3322":870,"_29027":848,"_20151":49954,"_5":13779,"_26422":49906,"_2810":49955},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3322":871,"_29027":871,"_5":14137,"_2810":49957,"_29350":49958,"_20151":49959,"_26422":871},"Configure and operate the DMS",[47245,48694,49702,49700,49883],[],{"_3322":872,"_29027":871,"_20151":49961,"_5":13779,"_26422":871,"_2810":49962},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3322":873,"_29027":871,"_5":29347,"_20151":49964,"_26422":49965,"_2810":47255},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3322":874,"_29027":871,"_5":29347,"_20151":49967,"_26422":49968,"_2810":49969},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3322":875,"_29027":871,"_5":29347,"_20151":49971,"_26422":49972,"_2810":49973},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3322":876,"_29027":871,"_5":29347,"_20151":49975,"_26422":49976,"_2810":49977},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3322":877,"_29027":871,"_5":29347,"_20151":49979,"_26422":49980,"_2810":49981},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3322":878,"_29027":871,"_5":29347,"_20151":49983,"_26422":49984,"_2810":49985},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3322":879,"_29027":871,"_5":29347,"_20151":49987,"_26422":49988,"_2810":49989},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3322":880,"_29027":871,"_5":29347,"_20151":49991,"_26422":49992,"_2810":49993},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3322":881,"_29027":871,"_5":29347,"_20151":49995,"_26422":49996,"_2810":49997},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3322":882,"_29027":871,"_5":29347,"_20151":49999,"_26422":50000,"_2810":50001},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3322":883,"_29027":871,"_5":29347,"_20151":50003,"_26422":50004,"_2810":50005},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3322":884,"_29027":871,"_5":29347,"_20151":50007,"_26422":50008,"_2810":50009},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3322":885,"_29027":871,"_5":29347,"_20151":50011,"_26422":50012,"_2810":50013},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3322":886,"_29027":871,"_5":29347,"_20151":50015,"_26422":50016,"_2810":50017},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3322":887,"_29027":871,"_5":29347,"_20151":50019,"_26422":50020,"_2810":50021},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3322":888,"_29027":871,"_5":29347,"_20151":50023,"_26422":50024,"_2810":50025},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3322":889,"_29027":871,"_5":29347,"_20151":50027,"_26422":50028,"_2810":50029},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3322":890,"_29027":871,"_5":29347,"_20151":50031,"_26422":50032,"_2810":50033},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3322":891,"_29027":871,"_20151":50035,"_5":13779,"_26422":871,"_2810":50036},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3322":892,"_29027":871,"_20151":50038,"_5":13779,"_26422":49965,"_2810":50039},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3322":893,"_29027":871,"_20151":50041,"_5":13779,"_26422":49965,"_2810":50042},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3322":894,"_29027":871,"_20151":50044,"_5":13779,"_26422":49972,"_2810":50045},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3322":895,"_29027":871,"_20151":50047,"_5":13779,"_26422":49976,"_2810":50048},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3322":896,"_29027":871,"_20151":50050,"_5":13779,"_26422":49980,"_2810":50051},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3322":897,"_29027":871,"_20151":50053,"_5":13779,"_26422":49984,"_2810":50054},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3322":898,"_29027":871,"_20151":50056,"_5":13779,"_26422":49988,"_2810":50057},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3322":899,"_29027":871,"_20151":50059,"_5":13779,"_26422":49996,"_2810":50060},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3322":900,"_29027":871,"_20151":50062,"_5":13779,"_26422":49996,"_2810":50063},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3322":901,"_29027":871,"_20151":50065,"_5":13779,"_26422":50000,"_2810":50066},[],"`settings.enrollment_settings` field",{"_3322":902,"_29027":871,"_20151":50068,"_5":13779,"_26422":50000,"_2810":50069},[],"Decision",{"_3322":903,"_29027":871,"_20151":50071,"_5":13779,"_26422":50000,"_2810":50072},[],"`protocol`",{"_3322":904,"_29027":871,"_20151":50074,"_5":13779,"_26422":50000,"_2810":50075},[],"`EST_RFC7030` for these operations.",{"_3322":905,"_29027":871,"_20151":50077,"_5":13779,"_26422":50000,"_2810":50078},[],"`enrollment_ca`",{"_3322":906,"_29027":871,"_20151":50080,"_5":13779,"_26422":50000,"_2810":50081},[],"ID of the signing CA.",{"_3322":907,"_29027":871,"_20151":50083,"_5":13779,"_26422":50000,"_2810":50084},[],"`verify_csr_signature`",{"_3322":908,"_29027":871,"_20151":50086,"_5":13779,"_26422":50000,"_2810":50087},[],"Keep `true` to verify CSR key possession.",{"_3322":909,"_29027":871,"_20151":50089,"_5":13779,"_26422":50000,"_2810":50090},[],"`enable_replaceable_enrollment`",{"_3322":910,"_29027":871,"_20151":50092,"_5":13779,"_26422":50000,"_2810":50093},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3322":911,"_29027":871,"_20151":50095,"_5":13779,"_26422":50000,"_2810":50096},[],"`est_rfc7030_settings.auth_mode`",{"_3322":912,"_29027":871,"_20151":50098,"_5":13779,"_26422":50000,"_2810":50099},[],"One of the four authentication modes.",{"_3322":913,"_29027":871,"_20151":50101,"_5":13779,"_26422":50000,"_2810":50102},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3322":914,"_29027":871,"_20151":50104,"_5":13779,"_26422":50004,"_2810":50105},[],"The blocks are independent:",{"_3322":915,"_29027":871,"_20151":50107,"_5":13779,"_26422":50004,"_2810":50108},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3322":916,"_29027":871,"_20151":50110,"_5":13779,"_26422":50004,"_2810":50111},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3322":917,"_29027":871,"_20151":50113,"_5":13779,"_26422":50004,"_2810":50114},[],"`auth_mode`",{"_3322":918,"_29027":871,"_20151":50116,"_5":13779,"_26422":50004,"_2810":50117},[],"Control applied in the configured operation",{"_3322":919,"_29027":871,"_20151":50119,"_5":13779,"_26422":50004,"_2810":50120},[],"`CLIENT_CERTIFICATE`",{"_3322":920,"_29027":871,"_20151":50122,"_5":13779,"_26422":50004,"_2810":50123},[],"Presented certificate validation.",{"_3322":921,"_29027":871,"_20151":50125,"_5":13779,"_26422":50004,"_2810":50126},[],"`EXTERNAL_WEBHOOK`",{"_3322":922,"_29027":871,"_20151":50128,"_5":13779,"_26422":50004,"_2810":50129},[],"Configured webhook authorization.",{"_3322":923,"_29027":871,"_20151":50131,"_5":13779,"_26422":50004,"_2810":50132},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3322":924,"_29027":871,"_20151":50134,"_5":13779,"_26422":50004,"_2810":50135},[],"Certificate validation followed by webhook approval.",{"_3322":925,"_29027":871,"_20151":50137,"_5":13779,"_26422":50004,"_2810":50138},[],"`NO_AUTH`",{"_3322":926,"_29027":871,"_20151":50140,"_5":13779,"_26422":50004,"_2810":50141},[],"No DMS requester authentication.",{"_3322":927,"_29027":871,"_20151":50143,"_5":13779,"_26422":50004,"_2810":50144},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3322":928,"_29027":871,"_20151":50146,"_5":13779,"_26422":50004,"_2810":50147},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3322":929,"_29027":871,"_20151":50149,"_5":13779,"_26422":50004,"_2810":50150},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3322":930,"_29027":871,"_20151":50152,"_5":13779,"_26422":50004,"_2810":50153},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3322":931,"_29027":871,"_20151":50155,"_5":13779,"_26422":50008,"_2810":50156},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3322":932,"_29027":871,"_20151":50158,"_5":13779,"_26422":50008,"_2810":50159},[],"`external_webhook_settings` field",{"_3322":933,"_29027":871,"_20151":50161,"_5":13779,"_26422":50008,"_2810":50069},[],{"_3322":934,"_29027":871,"_20151":50163,"_5":13779,"_26422":50008,"_2810":50164},[],"`url`",{"_3322":935,"_29027":871,"_20151":50166,"_5":13779,"_26422":50008,"_2810":50167},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3322":936,"_29027":871,"_20151":50169,"_5":13779,"_26422":50008,"_2810":50170},[],"`method`",{"_3322":937,"_29027":871,"_20151":50172,"_5":13779,"_26422":50008,"_2810":50173},[],"`POST` or `PUT`; `POST` by default.",{"_3322":938,"_29027":871,"_20151":50175,"_5":13779,"_26422":50008,"_2810":50176},[],"`name`",{"_3322":939,"_29027":871,"_20151":50178,"_5":13779,"_26422":50008,"_2810":50179},[],"Label used in service logs.",{"_3322":940,"_29027":871,"_20151":50181,"_5":13779,"_26422":50008,"_2810":50182},[],"`config.auth_mode`",{"_3322":941,"_29027":871,"_20151":50184,"_5":13779,"_26422":50008,"_2810":50185},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3322":942,"_29027":871,"_20151":50187,"_5":13779,"_26422":50008,"_2810":50188},[],"`config.log_level`",{"_3322":943,"_29027":871,"_20151":50190,"_5":13779,"_26422":50008,"_2810":50191},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3322":944,"_29027":871,"_20151":50193,"_5":13779,"_26422":50008,"_2810":50194},[],"`config.apikey_options`",{"_3322":945,"_29027":871,"_20151":50196,"_5":13779,"_26422":50008,"_2810":50197},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3322":946,"_29027":871,"_20151":50199,"_5":13779,"_26422":50008,"_2810":50200},[],"`config.jwt_options`",{"_3322":947,"_29027":871,"_20151":50202,"_5":13779,"_26422":50008,"_2810":50203},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3322":948,"_29027":871,"_20151":50205,"_5":13779,"_26422":50008,"_2810":50206},[],"`config.mtls_options`",{"_3322":949,"_29027":871,"_20151":50208,"_5":13779,"_26422":50008,"_2810":50209},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3322":950,"_29027":871,"_20151":50211,"_5":13779,"_26422":50008,"_2810":50212},[],"`config.insecure_skip_verify`",{"_3322":951,"_29027":871,"_20151":50214,"_5":13779,"_26422":50008,"_2810":50215},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3322":952,"_29027":871,"_20151":50217,"_5":13779,"_26422":50008,"_2810":50218},[],"`config.call_timeout`",{"_3322":953,"_29027":871,"_20151":50220,"_5":13779,"_26422":50008,"_2810":50221},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3322":954,"_29027":871,"_20151":50223,"_5":13779,"_26422":50008,"_2810":50224},[],"Rules for that configuration:",{"_3322":955,"_29027":871,"_20151":50226,"_5":13779,"_26422":50008,"_2810":50227},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3322":956,"_29027":871,"_20151":50229,"_5":13779,"_26422":50008,"_2810":50230},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3322":957,"_29027":871,"_20151":50232,"_5":13779,"_26422":50008,"_2810":50233},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3322":958,"_29027":871,"_20151":50235,"_5":13779,"_26422":50008,"_2810":50236},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3322":959,"_29027":871,"_20151":50238,"_5":13779,"_26422":50008,"_2810":50239},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3322":960,"_29027":871,"_20151":50241,"_5":13779,"_26422":50008,"_2810":50242},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3322":961,"_29027":871,"_20151":50244,"_5":13779,"_26422":50008,"_2810":50245},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3322":962,"_29027":871,"_20151":50247,"_5":13779,"_26422":50008,"_2810":50248},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3322":963,"_29027":871,"_20151":50250,"_5":13779,"_26422":50008,"_2810":50251},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3322":964,"_29027":871,"_20151":50253,"_5":13779,"_26422":50012,"_2810":50254},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3322":965,"_29027":871,"_20151":50256,"_5":13779,"_26422":50016,"_2810":50257},[],"`settings.reenrollment_settings` field",{"_3322":966,"_29027":871,"_20151":50259,"_5":13779,"_26422":50016,"_2810":47635},[],{"_3322":967,"_29027":871,"_20151":50261,"_5":13779,"_26422":50016,"_2810":50262},[],"`reenrollment_delta`",{"_3322":968,"_29027":871,"_20151":50264,"_5":13779,"_26422":50016,"_2810":50265},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3322":969,"_29027":871,"_20151":50267,"_5":13779,"_26422":50016,"_2810":50268},[],"`preventive_delta`",{"_3322":970,"_29027":871,"_20151":50270,"_5":13779,"_26422":50016,"_2810":50271},[],"Preventive operational monitoring threshold.",{"_3322":971,"_29027":871,"_20151":50273,"_5":13779,"_26422":50016,"_2810":50274},[],"`critical_delta`",{"_3322":972,"_29027":871,"_20151":50276,"_5":13779,"_26422":50016,"_2810":50277},[],"Critical operational monitoring threshold.",{"_3322":973,"_29027":871,"_20151":50279,"_5":13779,"_26422":50016,"_2810":50280},[],"`enable_expired_renewal`",{"_3322":974,"_29027":871,"_20151":50282,"_5":13779,"_26422":50016,"_2810":50283},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3322":975,"_29027":871,"_20151":50285,"_5":13779,"_26422":50016,"_2810":50286},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3322":976,"_29027":871,"_20151":50288,"_5":13779,"_26422":50016,"_2810":50289},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3322":977,"_29027":871,"_20151":50291,"_5":13779,"_26422":50016,"_2810":50292},[],"`revoke_on_reenrollment`",{"_3322":978,"_29027":871,"_20151":50294,"_5":13779,"_26422":50016,"_2810":50295},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3322":979,"_29027":871,"_20151":50297,"_5":13779,"_26422":50016,"_2810":50298},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3322":980,"_29027":871,"_20151":50300,"_5":13779,"_26422":50020,"_2810":50301},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3322":981,"_29027":871,"_20151":50303,"_5":13779,"_26422":50024,"_2810":47629},[],{"_3322":982,"_29027":871,"_20151":50305,"_5":13779,"_26422":50024,"_2810":50306},[],"Published material",{"_3322":983,"_29027":871,"_20151":50308,"_5":13779,"_26422":50024,"_2810":50309},[],"**Include Lamassu System CA**",{"_3322":984,"_29027":871,"_20151":50311,"_5":13779,"_26422":50024,"_2810":50312},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3322":985,"_29027":871,"_20151":50314,"_5":13779,"_26422":50024,"_2810":50315},[],"**Include Enrollment CA**",{"_3322":986,"_29027":871,"_20151":50317,"_5":13779,"_26422":50024,"_2810":50318},[],"Selected issuing CA certificate.",{"_3322":987,"_29027":871,"_20151":50320,"_5":13779,"_26422":50024,"_2810":50321},[],"**Managed CAs**",{"_3322":988,"_29027":871,"_20151":50323,"_5":13779,"_26422":50024,"_2810":50324},[],"Explicitly selected CA certificates.",{"_3322":989,"_29027":871,"_20151":50326,"_5":13779,"_26422":50024,"_2810":50327},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3322":990,"_29027":871,"_20151":50329,"_5":13779,"_26422":50028,"_2810":50330},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3322":991,"_29027":871,"_20151":50332,"_5":13779,"_26422":50028,"_2810":50333},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3322":992,"_29027":871,"_20151":50335,"_5":13779,"_26422":50028,"_2810":50336},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3322":993,"_29027":871,"_20151":50338,"_5":13779,"_26422":50032,"_2810":50339},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3322":994,"_29027":994,"_5":14137,"_2810":50341,"_29350":50342,"_20151":50343,"_26422":994},"Integrate the EST client",[47245,48694,49702,49700,49883],[],{"_3322":995,"_29027":994,"_20151":50345,"_5":13779,"_26422":994,"_2810":50346},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3322":996,"_29027":994,"_5":29347,"_20151":50348,"_26422":50349,"_2810":47255},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3322":997,"_29027":994,"_5":29347,"_20151":50351,"_26422":50352,"_2810":50353},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3322":998,"_29027":994,"_5":29347,"_20151":50355,"_26422":50356,"_2810":50357},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3322":999,"_29027":994,"_5":29347,"_20151":50359,"_26422":50360,"_2810":50361},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3322":1000,"_29027":994,"_5":29347,"_20151":50363,"_26422":50364,"_2810":50365},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3322":1001,"_29027":994,"_5":29347,"_20151":50367,"_26422":50368,"_2810":50369},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3322":1002,"_29027":994,"_20151":50371,"_5":13779,"_26422":994,"_2810":50372},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3322":1003,"_29027":994,"_20151":50374,"_5":13779,"_26422":50349,"_2810":50375},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3322":1004,"_29027":994,"_20151":50377,"_5":13779,"_26422":50349,"_2810":50378},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3322":1005,"_29027":994,"_20151":50380,"_5":13779,"_26422":50349,"_2810":50381},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3322":1006,"_29027":994,"_20151":50383,"_5":13779,"_26422":50352,"_2810":50384},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3322":1007,"_29027":994,"_20151":50386,"_5":13779,"_26422":50352,"_2810":50387},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3322":1008,"_29027":994,"_20151":50389,"_5":13779,"_26422":50356,"_2810":50390},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3322":1009,"_29027":994,"_20151":50392,"_5":13779,"_26422":50356,"_2810":50393},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3322":1010,"_29027":994,"_20151":50395,"_5":13779,"_26422":50360,"_2810":50396},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3322":1011,"_29027":994,"_20151":50398,"_5":13779,"_26422":50360,"_2810":50399},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3322":1012,"_29027":994,"_20151":50401,"_5":13779,"_26422":50364,"_2810":50402},[],"For a root that issues directly:",{"_3322":1013,"_29027":994,"_20151":50404,"_5":13779,"_26422":50364,"_2810":50405},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3322":1014,"_29027":994,"_20151":50407,"_5":13779,"_26422":50364,"_2810":50408},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3322":1015,"_29027":994,"_20151":50410,"_5":13779,"_26422":50368,"_2810":50411},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3322":1016,"_29027":1016,"_5":14137,"_2810":50413,"_29350":50414,"_20151":50415,"_26422":1016},"EST reference",[47245,48694,49702,49700,49883],[],{"_3322":1017,"_29027":1016,"_20151":50417,"_5":13779,"_26422":1016,"_2810":50418},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3322":1018,"_29027":1016,"_5":29347,"_20151":50420,"_26422":50421,"_2810":50422},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3322":1019,"_29027":1016,"_5":29347,"_20151":50424,"_26422":50425,"_2810":21875},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3322":1020,"_29027":1016,"_5":29347,"_20151":50427,"_26422":50428,"_2810":25067},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3322":1021,"_29027":1016,"_5":29347,"_20151":50430,"_26422":50431,"_2810":25074},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3322":1022,"_29027":1016,"_5":29347,"_20151":50433,"_26422":50434,"_2810":24407},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3322":1023,"_29027":1016,"_5":29347,"_20151":50436,"_26422":50437,"_2810":50438},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3322":1024,"_29027":1016,"_5":29347,"_20151":50440,"_26422":50441,"_2810":50442},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3322":1025,"_29027":1016,"_5":29347,"_20151":50444,"_26422":50445,"_2810":50446},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3322":1026,"_29027":1016,"_20151":50448,"_5":13779,"_26422":1016,"_2810":50449},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3322":1027,"_29027":1016,"_20151":50451,"_5":13779,"_26422":50421,"_2810":50452},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3322":1028,"_29027":1016,"_20151":50454,"_5":13779,"_26422":50421,"_2810":50455},[],"Operation",{"_3322":1029,"_29027":1016,"_20151":50457,"_5":13779,"_26422":50421,"_2810":50458},[],"Method",{"_3322":1030,"_29027":1016,"_20151":50460,"_5":13779,"_26422":50421,"_2810":50461},[],"Authentication and condition",{"_3322":1031,"_29027":1016,"_20151":50463,"_5":13779,"_26422":50421,"_2810":50464},[],"`/cacerts`",{"_3322":1032,"_29027":1016,"_20151":50466,"_5":13779,"_26422":50421,"_2810":50467},[],"GET",{"_3322":1033,"_29027":1016,"_20151":50469,"_5":13779,"_26422":50421,"_2810":50470},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3322":1034,"_29027":1016,"_20151":50472,"_5":13779,"_26422":50421,"_2810":50473},[],"`/simpleenroll`",{"_3322":1035,"_29027":1016,"_20151":50475,"_5":13779,"_26422":50421,"_2810":50476},[],"POST",{"_3322":1036,"_29027":1016,"_20151":50478,"_5":13779,"_26422":50421,"_2810":50479},[],"Initial authentication and DMS registration/replacement policy.",{"_3322":1037,"_29027":1016,"_20151":50481,"_5":13779,"_26422":50421,"_2810":50482},[],"`/simplereenroll`",{"_3322":1038,"_29027":1016,"_20151":50484,"_5":13779,"_26422":50421,"_2810":50476},[],{"_3322":1039,"_29027":1016,"_20151":50486,"_5":13779,"_26422":50421,"_2810":50487},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3322":1040,"_29027":1016,"_20151":50489,"_5":13779,"_26422":50421,"_2810":50490},[],"`/serverkeygen`",{"_3322":1041,"_29027":1016,"_20151":50492,"_5":13779,"_26422":50421,"_2810":50476},[],{"_3322":1042,"_29027":1016,"_20151":50494,"_5":13779,"_26422":50421,"_2810":50495},[],"Initial authentication and admission; server generation enabled.",{"_3322":1043,"_29027":1016,"_20151":50497,"_5":13779,"_26422":50421,"_2810":50498},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3322":1044,"_29027":1016,"_20151":50500,"_5":13779,"_26422":50425,"_2810":50501},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3322":1045,"_29027":1016,"_20151":50503,"_5":13779,"_26422":50425,"_2810":50504},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3322":1046,"_29027":1016,"_20151":50506,"_5":13779,"_26422":50428,"_2810":50507},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3322":1047,"_29027":1016,"_20151":50509,"_5":13779,"_26422":50428,"_2810":50510},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3322":1048,"_29027":1016,"_20151":50512,"_5":13779,"_26422":50431,"_2810":50513},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3322":1049,"_29027":1016,"_20151":50515,"_5":13779,"_26422":50431,"_2810":50516},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3322":1050,"_29027":1016,"_20151":50518,"_5":13779,"_26422":50434,"_2810":50519},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3322":1051,"_29027":1016,"_20151":50521,"_5":13779,"_26422":50434,"_2810":50522},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3322":1052,"_29027":1016,"_20151":50524,"_5":13779,"_26422":50437,"_2810":50525},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3322":1053,"_29027":1016,"_20151":50527,"_5":13779,"_26422":50437,"_2810":50528},[],"Part",{"_3322":1054,"_29027":1016,"_20151":50530,"_5":13779,"_26422":50437,"_2810":50531},[],"Content after decoding its Base64",{"_3322":1055,"_29027":1016,"_20151":50533,"_5":13779,"_26422":50437,"_2810":50534},[],"`application/pkcs8`",{"_3322":1056,"_29027":1016,"_20151":50536,"_5":13779,"_26422":50437,"_2810":50537},[],"Unencrypted DER PKCS#8 private key.",{"_3322":1057,"_29027":1016,"_20151":50539,"_5":13779,"_26422":50437,"_2810":50540},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3322":1058,"_29027":1016,"_20151":50542,"_5":13779,"_26422":50437,"_2810":50543},[],"DER PKCS#7 containing the issued certificate.",{"_3322":1059,"_29027":1016,"_20151":50545,"_5":13779,"_26422":50437,"_2810":50546},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3322":1060,"_29027":1016,"_20151":50548,"_5":13779,"_26422":50441,"_2810":50549},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3322":1061,"_29027":1016,"_20151":50551,"_5":13779,"_26422":50441,"_2810":50552},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3322":1062,"_29027":1016,"_20151":50554,"_5":13779,"_26422":50441,"_2810":50555},[],"Convert and check the result:",{"_3322":1063,"_29027":1016,"_20151":50557,"_5":13779,"_26422":50441,"_2810":50558},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3322":1064,"_29027":1016,"_20151":50560,"_5":13779,"_26422":50445,"_2810":50561},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3322":1065,"_29027":1016,"_20151":50563,"_5":13779,"_26422":50445,"_2810":50564},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3322":1066,"_29027":1066,"_5":14137,"_2810":49883,"_29350":50566,"_20151":50567,"_26422":1066},[47245,48694,49702,49700,49883],[],{"_3322":1067,"_29027":1066,"_20151":50569,"_5":13779,"_26422":1066,"_2810":50570},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3322":1068,"_29027":1066,"_5":29347,"_20151":50572,"_26422":50573,"_2810":50574},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3322":1069,"_29027":1066,"_5":29347,"_20151":50576,"_26422":50577,"_2810":50578},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3322":1070,"_29027":1066,"_5":29347,"_20151":50580,"_26422":50581,"_2810":50582},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3322":1071,"_29027":1066,"_5":29347,"_20151":50584,"_26422":50585,"_2810":50586},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3322":1072,"_29027":1066,"_20151":50588,"_5":13779,"_26422":1066,"_2810":50589},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3322":1073,"_29027":1066,"_20151":50591,"_5":13779,"_26422":50573,"_2810":50592},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3322":1074,"_29027":1066,"_20151":50594,"_5":13779,"_26422":50573,"_2810":50595},[],"The integrator installs initial EST server trust and an admission credential.",{"_3322":1075,"_29027":1066,"_20151":50597,"_5":13779,"_26422":50573,"_2810":50598},[],"The client requests an identity for its `Device ID` through EST.",{"_3322":1076,"_29027":1066,"_20151":50600,"_5":13779,"_26422":50573,"_2810":50601},[],"Certificate, device binding and key/certificate installation are checked.",{"_3322":1077,"_29027":1066,"_20151":50603,"_5":13779,"_26422":50573,"_2810":50604},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3322":1078,"_29027":1066,"_20151":50606,"_5":13779,"_26422":50573,"_2810":50607},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3322":1079,"_29027":1066,"_20151":50609,"_5":13779,"_26422":50577,"_2810":50610},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3322":1080,"_29027":1066,"_20151":50612,"_5":13779,"_26422":50577,"_2810":50613},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3322":1081,"_29027":1066,"_20151":50615,"_5":13779,"_26422":50577,"_2810":50616},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3322":1082,"_29027":1066,"_20151":50618,"_5":13779,"_26422":50577,"_2810":50619},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3322":1083,"_29027":1066,"_20151":50621,"_5":13779,"_26422":50581,"_2810":50622},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3322":1084,"_29027":1066,"_20151":50624,"_5":13779,"_26422":50581,"_2810":50625},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3322":1085,"_29027":1066,"_20151":50627,"_5":13779,"_26422":50581,"_2810":50628},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3322":1086,"_29027":1066,"_20151":50630,"_5":13779,"_26422":50581,"_2810":50631},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3322":1087,"_29027":1066,"_20151":50633,"_5":13779,"_26422":50585,"_2810":50634},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3322":1088,"_29027":1066,"_20151":50636,"_5":13779,"_26422":50585,"_2810":50637},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3322":1089,"_29027":1089,"_5":14137,"_2810":50639,"_29350":50640,"_20151":50641,"_26422":1089},"Provisioning strategies",[47245,48694,49702,49700,49883],[],{"_3322":1090,"_29027":1089,"_20151":50643,"_5":13779,"_26422":1089,"_2810":50644},[],"Choose device registration, identity authorization and key generation.",{"_3322":1091,"_29027":1089,"_5":29347,"_20151":50646,"_26422":50647,"_2810":50648},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3322":1092,"_29027":1089,"_5":29347,"_20151":50650,"_26422":50651,"_2810":50652},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3322":1093,"_29027":1089,"_5":29347,"_20151":50654,"_26422":50655,"_2810":50656},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3322":1094,"_29027":1089,"_5":29347,"_20151":50658,"_26422":50659,"_2810":50660},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3322":1095,"_29027":1089,"_5":29347,"_20151":50662,"_26422":50663,"_2810":50664},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3322":1096,"_29027":1089,"_20151":50666,"_5":13779,"_26422":1089,"_2810":50667},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3322":1097,"_29027":1089,"_20151":50669,"_5":13779,"_26422":50647,"_2810":50670},[],"Path",{"_3322":1098,"_29027":1089,"_20151":50672,"_5":13779,"_26422":50647,"_2810":50673},[],"When the device exists",{"_3322":1099,"_29027":1089,"_20151":50675,"_5":13779,"_26422":50647,"_2810":50676},[],"What to check",{"_3322":1100,"_29027":1089,"_20151":50678,"_5":13779,"_26422":50647,"_2810":50679},[],"Manual assignment",{"_3322":1101,"_29027":1089,"_20151":50681,"_5":13779,"_26422":50647,"_2810":50682},[],"An operator creates it before associating a certificate.",{"_3322":1102,"_29027":1089,"_20151":50684,"_5":13779,"_26422":50647,"_2810":50685},[],"ID, owning DMS, certificate CN and bound serial.",{"_3322":1103,"_29027":1089,"_20151":50687,"_5":13779,"_26422":50647,"_2810":50688},[],"EST with `JITP`",{"_3322":1104,"_29027":1089,"_20151":50690,"_5":13779,"_26422":50647,"_2810":50691},[],"Created for an unknown CN during `/simpleenroll`.",{"_3322":1105,"_29027":1089,"_20151":50693,"_5":13779,"_26422":50647,"_2810":50694},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3322":1106,"_29027":1089,"_20151":50696,"_5":13779,"_26422":50647,"_2810":50697},[],"EST with `PRE_REGISTRATION`",{"_3322":1107,"_29027":1089,"_20151":50699,"_5":13779,"_26422":50647,"_2810":50700},[],"Must exist before `/simpleenroll`.",{"_3322":1108,"_29027":1089,"_20151":50702,"_5":13779,"_26422":50647,"_2810":50703},[],"Approved record, same DMS and replacement conditions for your version.",{"_3322":1109,"_29027":1089,"_20151":50705,"_5":13779,"_26422":50647,"_2810":50706},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3322":1110,"_29027":1089,"_20151":50708,"_5":13779,"_26422":50647,"_2810":50709},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3322":1111,"_29027":1089,"_20151":50711,"_5":13779,"_26422":50651,"_2810":50712},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3322":1112,"_29027":1089,"_20151":50714,"_5":13779,"_26422":50651,"_2810":50715},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3322":1113,"_29027":1089,"_20151":50717,"_5":13779,"_26422":50651,"_2810":50718},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3322":1114,"_29027":1089,"_20151":50720,"_5":13779,"_26422":50655,"_2810":50721},[],"Decide initial enrollment and re-enrollment separately:",{"_3322":1115,"_29027":1089,"_20151":50723,"_5":13779,"_26422":50655,"_2810":50724},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3322":1116,"_29027":1089,"_20151":50726,"_5":13779,"_26422":50655,"_2810":50727},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3322":1117,"_29027":1089,"_20151":50729,"_5":13779,"_26422":50655,"_2810":50730},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3322":1118,"_29027":1089,"_20151":50732,"_5":13779,"_26422":50655,"_2810":50733},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3322":1119,"_29027":1089,"_20151":50735,"_5":13779,"_26422":50655,"_2810":50736},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3322":1120,"_29027":1089,"_20151":50738,"_5":13779,"_26422":50659,"_2810":47629},[],{"_3322":1121,"_29027":1089,"_20151":50740,"_5":13779,"_26422":50659,"_2810":50741},[],"Material crossing EST",{"_3322":1122,"_29027":1089,"_20151":50743,"_5":13779,"_26422":50659,"_2810":50744},[],"Device-generated key",{"_3322":1123,"_29027":1089,"_20151":50746,"_5":13779,"_26422":50659,"_2810":50747},[],"Public CSR and certificate; the key stays on the client.",{"_3322":1124,"_29027":1089,"_20151":50749,"_5":13779,"_26422":50659,"_2810":50750},[],"Existing device key",{"_3322":1125,"_29027":1089,"_20151":50752,"_5":13779,"_26422":50659,"_2810":50753},[],"CSR signed with that key and a new certificate.",{"_3322":1126,"_29027":1089,"_20151":50755,"_5":13779,"_26422":50659,"_2810":50021},[],{"_3322":1127,"_29027":1089,"_20151":50757,"_5":13779,"_26422":50659,"_2810":50758},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3322":1128,"_29027":1089,"_20151":50760,"_5":13779,"_26422":50659,"_2810":50761},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3322":1129,"_29027":1089,"_20151":50763,"_5":13779,"_26422":50663,"_2810":50764},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3322":1130,"_29027":1130,"_5":14137,"_2810":50766,"_29350":50767,"_20151":50768,"_26422":1130},"Renewal and recovery",[47245,48694,49702,49700,49883],[],{"_3322":1131,"_29027":1130,"_20151":50770,"_5":13779,"_26422":1130,"_2810":50771},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3322":1132,"_29027":1130,"_5":29347,"_20151":50773,"_26422":50774,"_2810":50775},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3322":1133,"_29027":1130,"_5":29347,"_20151":50777,"_26422":50778,"_2810":50779},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3322":1134,"_29027":1130,"_5":29347,"_20151":50781,"_26422":50782,"_2810":50783},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3322":1135,"_29027":1130,"_5":29347,"_20151":50785,"_26422":50786,"_2810":50787},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3322":1136,"_29027":1130,"_5":29347,"_20151":50789,"_26422":50790,"_2810":50791},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3322":1137,"_29027":1130,"_20151":50793,"_5":13779,"_26422":1130,"_2810":50794},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3322":1138,"_29027":1130,"_20151":50796,"_5":13779,"_26422":50774,"_2810":50797},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3322":1139,"_29027":1130,"_20151":50799,"_5":13779,"_26422":50774,"_2810":50800},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3322":1140,"_29027":1130,"_20151":50802,"_5":13779,"_26422":50774,"_2810":50803},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3322":1141,"_29027":1130,"_20151":50805,"_5":13779,"_26422":50774,"_2810":50806},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3322":1142,"_29027":1130,"_20151":50808,"_5":13779,"_26422":50778,"_2810":50809},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3322":1143,"_29027":1130,"_20151":50811,"_5":13779,"_26422":50778,"_2810":50812},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3322":1144,"_29027":1130,"_20151":50814,"_5":13779,"_26422":50782,"_2810":50815},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3322":1145,"_29027":1130,"_20151":50817,"_5":13779,"_26422":50782,"_2810":50818},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3322":1146,"_29027":1130,"_20151":50820,"_5":13779,"_26422":50782,"_2810":50821},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3322":1147,"_29027":1130,"_20151":50823,"_5":13779,"_26422":50786,"_2810":50824},[],"Situation",{"_3322":1148,"_29027":1130,"_20151":50826,"_5":13779,"_26422":50786,"_2810":50827},[],"Procedure",{"_3322":1149,"_29027":1130,"_20151":50829,"_5":13779,"_26422":50786,"_2810":50830},[],"Valid certificate, outside the window",{"_3322":1150,"_29027":1130,"_20151":50832,"_5":13779,"_26422":50786,"_2810":50833},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3322":1151,"_29027":1130,"_20151":50835,"_5":13779,"_26422":50786,"_2810":50836},[],"Expired certificate, key available",{"_3322":1152,"_29027":1130,"_20151":50838,"_5":13779,"_26422":50786,"_2810":50839},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3322":1153,"_29027":1130,"_20151":50841,"_5":13779,"_26422":50786,"_2810":50842},[],"Renewal through webhook or `NO_AUTH`",{"_3322":1154,"_29027":1130,"_20151":50844,"_5":13779,"_26422":50786,"_2810":50845},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3322":1155,"_29027":1130,"_20151":50847,"_5":13779,"_26422":50786,"_2810":50848},[],"Lost or inaccessible key",{"_3322":1156,"_29027":1130,"_20151":50850,"_5":13779,"_26422":50786,"_2810":50851},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3322":1157,"_29027":1130,"_20151":50853,"_5":13779,"_26422":50786,"_2810":50854},[],"Current identity revoked",{"_3322":1158,"_29027":1130,"_20151":50856,"_5":13779,"_26422":50786,"_2810":50857},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3322":1159,"_29027":1130,"_20151":50859,"_5":13779,"_26422":50786,"_2810":50860},[],"Device without an identity",{"_3322":1160,"_29027":1130,"_20151":50862,"_5":13779,"_26422":50786,"_2810":50863},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3322":1161,"_29027":1130,"_20151":50865,"_5":13779,"_26422":50786,"_2810":50866},[],"Retired device",{"_3322":1162,"_29027":1130,"_20151":50868,"_5":13779,"_26422":50786,"_2810":50869},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3322":1163,"_29027":1130,"_20151":50871,"_5":13779,"_26422":50786,"_2810":50872},[],"Timeout, HTTP 500 or installation failure",{"_3322":1164,"_29027":1130,"_20151":50874,"_5":13779,"_26422":50786,"_2810":50875},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3322":1165,"_29027":1130,"_20151":50877,"_5":13779,"_26422":50790,"_2810":50878},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3322":1166,"_29027":1130,"_20151":50880,"_5":13779,"_26422":50790,"_2810":50881},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3322":1167,"_29027":1167,"_5":14137,"_2810":50883,"_29350":50884,"_20151":50885,"_26422":1167},"Enrollment troubleshooting",[47245,48694,49702,49700,49883],[],{"_3322":1168,"_29027":1167,"_20151":50887,"_5":13779,"_26422":1167,"_2810":50888},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3322":1169,"_29027":1167,"_5":29347,"_20151":50890,"_26422":50891,"_2810":50892},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3322":1170,"_29027":1167,"_5":29347,"_20151":50894,"_26422":50895,"_2810":50896},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3322":1171,"_29027":1167,"_5":29347,"_20151":50898,"_26422":50899,"_2810":50446},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3322":1172,"_29027":1167,"_5":29347,"_20151":50901,"_26422":50902,"_2810":50903},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3322":1173,"_29027":1167,"_20151":50905,"_5":13779,"_26422":1167,"_2810":50906},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3322":1174,"_29027":1167,"_20151":50908,"_5":13779,"_26422":50895,"_2810":50909},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3322":1175,"_29027":1167,"_20151":50911,"_5":13779,"_26422":50895,"_2810":50912},[],"Symptom or message",{"_3322":1176,"_29027":1167,"_20151":50914,"_5":13779,"_26422":50895,"_2810":50676},[],{"_3322":1177,"_29027":1167,"_20151":50916,"_5":13779,"_26422":50895,"_2810":50917},[],"curl rejects TLS, name or issuer",{"_3322":1178,"_29027":1167,"_20151":50919,"_5":13779,"_26422":50895,"_2810":50920},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3322":1179,"_29027":1167,"_20151":50922,"_5":13779,"_26422":50895,"_2810":50923},[],"404 or missing APS",{"_3322":1180,"_29027":1167,"_20151":50925,"_5":13779,"_26422":50895,"_2810":50926},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3322":1181,"_29027":1167,"_20151":50928,"_5":13779,"_26422":50895,"_2810":50929},[],"400, CSR or format error",{"_3322":1182,"_29027":1167,"_20151":50931,"_5":13779,"_26422":50895,"_2810":50932},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3322":1183,"_29027":1167,"_20151":50934,"_5":13779,"_26422":50895,"_2810":50935},[],"Missing credential or invalid certificate",{"_3322":1184,"_29027":1167,"_20151":50937,"_5":13779,"_26422":50895,"_2810":50938},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3322":1185,"_29027":1167,"_20151":50940,"_5":13779,"_26422":50895,"_2810":50941},[],"Webhook denies, times out or responds without authorization",{"_3322":1186,"_29027":1167,"_20151":50943,"_5":13779,"_26422":50895,"_2810":50944},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3322":1187,"_29027":1167,"_20151":50946,"_5":13779,"_26422":50895,"_2810":50947},[],"`unexpected status code: <n>: redirects are not followed`",{"_3322":1188,"_29027":1167,"_20151":50949,"_5":13779,"_26422":50895,"_2810":50950},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3322":1189,"_29027":1167,"_20151":50952,"_5":13779,"_26422":50895,"_2810":50953},[],"`webhook response exceeds 1048576 bytes`",{"_3322":1190,"_29027":1167,"_20151":50955,"_5":13779,"_26422":50895,"_2810":50956},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3322":1191,"_29027":1167,"_20151":50958,"_5":13779,"_26422":50895,"_2810":50959},[],"`webhook config must not reference files`",{"_3322":1192,"_29027":1167,"_20151":50961,"_5":13779,"_26422":50895,"_2810":50962},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3322":1193,"_29027":1167,"_20151":50964,"_5":13779,"_26422":50895,"_2810":50965},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3322":1194,"_29027":1167,"_20151":50967,"_5":13779,"_26422":50895,"_2810":50968},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3322":1195,"_29027":1167,"_20151":50970,"_5":13779,"_26422":50895,"_2810":50971},[],"`webhook mTLS certificate and key are invalid: …`",{"_3322":1196,"_29027":1167,"_20151":50973,"_5":13779,"_26422":50895,"_2810":50974},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3322":1197,"_29027":1167,"_20151":50976,"_5":13779,"_26422":50895,"_2810":50977},[],"400 `struct validation error` creating or updating a DMS",{"_3322":1198,"_29027":1167,"_20151":50979,"_5":13779,"_26422":50895,"_2810":50980},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3322":1199,"_29027":1167,"_20151":50982,"_5":13779,"_26422":50895,"_2810":50983},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3322":1200,"_29027":1167,"_20151":50985,"_5":13779,"_26422":50895,"_2810":50986},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3322":1201,"_29027":1167,"_20151":50988,"_5":13779,"_26422":50895,"_2810":50989},[],"`device not preregistered`",{"_3322":1202,"_29027":1167,"_20151":50991,"_5":13779,"_26422":50895,"_2810":50992},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3322":1203,"_29027":1167,"_20151":50994,"_5":13779,"_26422":50895,"_2810":50995},[],"`forbiddenNewEnrollment`",{"_3322":1204,"_29027":1167,"_20151":50997,"_5":13779,"_26422":50895,"_2810":50998},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3322":1205,"_29027":1167,"_20151":51000,"_5":13779,"_26422":50895,"_2810":51001},[],"Different owning DMS",{"_3322":1206,"_29027":1167,"_20151":51003,"_5":13779,"_26422":50895,"_2810":51004},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3322":1207,"_29027":1167,"_20151":51006,"_5":13779,"_26422":50895,"_2810":51007},[],"`invalid RawSubject bytes`",{"_3322":1208,"_29027":1167,"_20151":51009,"_5":13779,"_26422":50895,"_2810":51010},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3322":1209,"_29027":1167,"_20151":51012,"_5":13779,"_26422":50895,"_2810":51013},[],"`invalid reenroll window`",{"_3322":1210,"_29027":1167,"_20151":51015,"_5":13779,"_26422":50895,"_2810":51016},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3322":1211,"_29027":1167,"_20151":51018,"_5":13779,"_26422":50895,"_2810":51019},[],"Current certificate revoked",{"_3322":1212,"_29027":1167,"_20151":51021,"_5":13779,"_26422":50895,"_2810":51022},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3322":1213,"_29027":1167,"_20151":51024,"_5":13779,"_26422":50895,"_2810":51025},[],"CA, profile or signing error",{"_3322":1214,"_29027":1167,"_20151":51027,"_5":13779,"_26422":50895,"_2810":51028},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3322":1215,"_29027":1167,"_20151":51030,"_5":13779,"_26422":50895,"_2810":51031},[],"HTTP 200 without a device connection",{"_3322":1216,"_29027":1167,"_20151":51033,"_5":13779,"_26422":50895,"_2810":51034},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3322":1217,"_29027":1167,"_20151":51036,"_5":13779,"_26422":50895,"_2810":51037},[],"Timeout or error after issuance",{"_3322":1218,"_29027":1167,"_20151":51039,"_5":13779,"_26422":50895,"_2810":51040},[],"New certificates, current slot and previous identity's state before retrying.",{"_3322":1219,"_29027":1167,"_20151":51042,"_5":13779,"_26422":50899,"_2810":51043},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3322":1220,"_29027":1167,"_20151":51045,"_5":13779,"_26422":50899,"_2810":51046},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3322":1221,"_29027":1167,"_20151":51048,"_5":13779,"_26422":50902,"_2810":51049},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3322":1222,"_29027":1167,"_20151":51051,"_5":13779,"_26422":50902,"_2810":51052},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3322":1223,"_29027":1167,"_20151":51054,"_5":13779,"_26422":50902,"_2810":51055},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3322":1224,"_29027":1167,"_20151":51057,"_5":13779,"_26422":50902,"_2810":51058},[],"Make one request, save headers/body and query the device and certificates.",{"_3322":1225,"_29027":1167,"_20151":51060,"_5":13779,"_26422":50902,"_2810":51061},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3322":1226,"_29027":1167,"_20151":51063,"_5":13779,"_26422":50902,"_2810":51064},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3322":1227,"_29027":1167,"_20151":51066,"_5":13779,"_26422":50902,"_2810":51067},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3322":1228,"_29027":1228,"_5":14137,"_2810":51069,"_29350":51070,"_20151":51071,"_26422":1228},"Trust distribution and updates",[47245,48694,49702,49700,49883],[],{"_3322":1229,"_29027":1228,"_20151":51073,"_5":13779,"_26422":1228,"_2810":51074},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3322":1230,"_29027":1228,"_5":29347,"_20151":51076,"_26422":51077,"_2810":51078},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3322":1231,"_29027":1228,"_5":29347,"_20151":51080,"_26422":51081,"_2810":51082},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3322":1232,"_29027":1228,"_5":29347,"_20151":51084,"_26422":51085,"_2810":51086},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3322":1233,"_29027":1228,"_5":29347,"_20151":51088,"_26422":51089,"_2810":51090},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3322":1234,"_29027":1228,"_5":29347,"_20151":51092,"_26422":51093,"_2810":51094},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3322":1235,"_29027":1228,"_20151":51096,"_5":13779,"_26422":1228,"_2810":51097},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3322":1236,"_29027":1228,"_20151":51099,"_5":13779,"_26422":51077,"_2810":51100},[],"Relationship",{"_3322":1237,"_29027":1228,"_20151":51102,"_5":13779,"_26422":51077,"_2810":51103},[],"Material prepared by its owner",{"_3322":1238,"_29027":1228,"_20151":51105,"_5":13779,"_26422":51077,"_2810":51106},[],"Device → EST server",{"_3322":1239,"_29027":1228,"_20151":51108,"_5":13779,"_26422":51077,"_2810":51109},[],"Previously verified server root, chain or pin and TLS name.",{"_3322":1240,"_29027":1228,"_20151":51111,"_5":13779,"_26422":51077,"_2810":51112},[],"DMS → requester",{"_3322":1241,"_29027":1228,"_20151":51114,"_5":13779,"_26422":51077,"_2810":51115},[],"CAs and rules authorizing initial or renewal credentials.",{"_3322":1242,"_29027":1228,"_20151":51117,"_5":13779,"_26422":51077,"_2810":51118},[],"Consumer → device",{"_3322":1243,"_29027":1228,"_20151":51120,"_5":13779,"_26422":51077,"_2810":51121},[],"Operational identity roots, intermediates, validation and permissions.",{"_3322":1244,"_29027":1228,"_20151":51123,"_5":13779,"_26422":51077,"_2810":51124},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3322":1245,"_29027":1228,"_20151":51126,"_5":13779,"_26422":51081,"_2810":51127},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3322":1246,"_29027":1228,"_20151":51129,"_5":13779,"_26422":51081,"_2810":51130},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3322":1247,"_29027":1228,"_20151":51132,"_5":13779,"_26422":51085,"_2810":51133},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3322":1248,"_29027":1228,"_20151":51135,"_5":13779,"_26422":51085,"_2810":51136},[],"Select policy-approved roots as anchors.",{"_3322":1249,"_29027":1228,"_20151":51138,"_5":13779,"_26422":51085,"_2810":51139},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3322":1250,"_29027":1228,"_20151":51141,"_5":13779,"_26422":51085,"_2810":51142},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3322":1251,"_29027":1228,"_20151":51144,"_5":13779,"_26422":51085,"_2810":51145},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3322":1252,"_29027":1228,"_20151":51147,"_5":13779,"_26422":51085,"_2810":51148},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3322":1253,"_29027":1228,"_20151":51150,"_5":13779,"_26422":51089,"_2810":51151},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3322":1254,"_29027":1228,"_20151":51153,"_5":13779,"_26422":51089,"_2810":51154},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3322":1255,"_29027":1228,"_20151":51156,"_5":13779,"_26422":51089,"_2810":51157},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3322":1256,"_29027":1228,"_20151":51159,"_5":13779,"_26422":51093,"_2810":51160},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3322":1257,"_29027":1257,"_5":14137,"_2810":51162,"_29350":51163,"_20151":51165,"_26422":1257},"AWS IoT Core",[47245,48694,49702,49700,51164],"Integrations",[],{"_3322":1258,"_29027":1257,"_20151":51167,"_5":13779,"_26422":1257,"_2810":51168},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3322":1259,"_29027":1257,"_5":29347,"_20151":51170,"_26422":51171,"_2810":51172},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3322":1260,"_29027":1257,"_5":29347,"_20151":51174,"_26422":51175,"_2810":51176},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3322":1261,"_29027":1257,"_5":29347,"_20151":51178,"_26422":51179,"_2810":51180},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3322":1262,"_29027":1257,"_5":29347,"_20151":51182,"_26422":51183,"_2810":51184},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3322":1263,"_29027":1257,"_5":29347,"_20151":51186,"_26422":51187,"_2810":51188},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#resource-state-machine","Resource state machine",{"_3322":1264,"_29027":1257,"_5":29347,"_20151":51190,"_26422":51191,"_2810":51192},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-the-connector-handles","Events the connector handles",{"_3322":1265,"_29027":1257,"_5":29347,"_20151":51194,"_26422":51195,"_2810":51196},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3322":1266,"_29027":1257,"_5":29347,"_20151":51198,"_26422":51199,"_2810":51200},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3322":1267,"_29027":1257,"_5":29347,"_20151":51202,"_26422":51203,"_2810":51204},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3322":1268,"_29027":1257,"_5":29347,"_20151":51206,"_26422":51207,"_2810":51208},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3322":1269,"_29027":1257,"_5":29347,"_20151":51210,"_26422":51211,"_2810":51212},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3322":1270,"_29027":1257,"_5":29347,"_20151":51214,"_26422":51215,"_2810":51216},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3322":1271,"_29027":1257,"_5":29347,"_20151":51218,"_26422":51219,"_2810":51220},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3322":1272,"_29027":1257,"_5":29347,"_20151":51222,"_26422":51223,"_2810":51224},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3322":1273,"_29027":1257,"_5":29347,"_20151":51226,"_26422":51227,"_2810":51228},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3322":1274,"_29027":1257,"_5":29347,"_20151":51230,"_26422":51231,"_2810":51232},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3322":1275,"_29027":1257,"_5":29347,"_20151":51234,"_26422":51235,"_2810":51236},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3322":1276,"_29027":1257,"_5":29347,"_20151":51238,"_26422":51239,"_2810":51240},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3322":1277,"_29027":1257,"_5":29347,"_20151":51242,"_26422":51243,"_2810":51244},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3322":1278,"_29027":1257,"_5":29347,"_20151":51246,"_26422":51247,"_2810":51248},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3322":1279,"_29027":1257,"_5":29347,"_20151":51250,"_26422":51251,"_2810":51252},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3322":1280,"_29027":1257,"_5":29347,"_20151":51254,"_26422":51255,"_2810":51256},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3322":1281,"_29027":1257,"_5":29347,"_20151":51258,"_26422":51259,"_2810":51260},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3322":1282,"_29027":1257,"_5":29347,"_20151":51262,"_26422":51263,"_2810":51264},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3322":1283,"_29027":1257,"_5":29347,"_20151":51266,"_26422":51267,"_2810":51268},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3322":1284,"_29027":1257,"_5":29347,"_20151":51270,"_26422":51271,"_2810":51272},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3322":1285,"_29027":1257,"_20151":51274,"_5":13779,"_26422":1257,"_2810":51275},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3322":1286,"_29027":1257,"_20151":51277,"_5":13779,"_26422":1257,"_2810":51278},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3322":1287,"_29027":1257,"_20151":51280,"_5":13779,"_26422":1257,"_2810":51281},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3322":1288,"_29027":1257,"_20151":51283,"_5":13779,"_26422":51171,"_2810":51284},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3322":1289,"_29027":1257,"_20151":51286,"_5":13779,"_26422":51171,"_2810":51287},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3322":1290,"_29027":1257,"_20151":51289,"_5":13779,"_26422":51171,"_2810":51290},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3322":1291,"_29027":1257,"_20151":51292,"_5":13779,"_26422":51171,"_2810":51293},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3322":1292,"_29027":1257,"_20151":51295,"_5":13779,"_26422":51175,"_2810":51296},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3322":1293,"_29027":1257,"_20151":51298,"_5":13779,"_26422":51179,"_2810":51299},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3322":1294,"_29027":1257,"_20151":51301,"_5":13779,"_26422":51179,"_2810":51302},[],"IAM action",{"_3322":1295,"_29027":1257,"_20151":51304,"_5":13779,"_26422":51179,"_2810":47635},[],{"_3322":1296,"_29027":1257,"_20151":51306,"_5":13779,"_26422":51179,"_2810":51307},[],"`iot:GetRegistrationCode`",{"_3322":1297,"_29027":1257,"_20151":51309,"_5":13779,"_26422":51179,"_2810":51310},[],"Obtain the verification code for CA registration in the Primary Account",{"_3322":1298,"_29027":1257,"_20151":51312,"_5":13779,"_26422":51179,"_2810":51313},[],"`iot:RegisterCACertificate`",{"_3322":1299,"_29027":1257,"_20151":51315,"_5":13779,"_26422":51179,"_2810":51316},[],"Register the CA in AWS IoT",{"_3322":1300,"_29027":1257,"_20151":51318,"_5":13779,"_26422":51179,"_2810":51319},[],"`iot:DescribeCACertificate`",{"_3322":1301,"_29027":1257,"_20151":51321,"_5":13779,"_26422":51179,"_2810":51322},[],"Check the CA registration status",{"_3322":1302,"_29027":1257,"_20151":51324,"_5":13779,"_26422":51179,"_2810":51325},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3322":1303,"_29027":1257,"_20151":51327,"_5":13779,"_26422":51179,"_2810":51328},[],"Create or update Things in IoT Core",{"_3322":1304,"_29027":1257,"_20151":51330,"_5":13779,"_26422":51179,"_2810":51331},[],"`iot:RegisterThing`",{"_3322":1305,"_29027":1257,"_20151":51333,"_5":13779,"_26422":51179,"_2810":51334},[],"Provision Things through a template",{"_3322":1306,"_29027":1257,"_20151":51336,"_5":13779,"_26422":51179,"_2810":51337},[],"`iot:RegisterCertificate`",{"_3322":1307,"_29027":1257,"_20151":51339,"_5":13779,"_26422":51179,"_2810":51340},[],"Register device certificates",{"_3322":1308,"_29027":1257,"_20151":51342,"_5":13779,"_26422":51179,"_2810":51343},[],"`iot:UpdateCertificate`",{"_3322":1309,"_29027":1257,"_20151":51345,"_5":13779,"_26422":51179,"_2810":51346},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3322":1310,"_29027":1257,"_20151":51348,"_5":13779,"_26422":51179,"_2810":51349},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3322":1311,"_29027":1257,"_20151":51351,"_5":13779,"_26422":51179,"_2810":51352},[],"Create and attach IoT policies",{"_3322":1312,"_29027":1257,"_20151":51354,"_5":13779,"_26422":51179,"_2810":51355},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3322":1313,"_29027":1257,"_20151":51357,"_5":13779,"_26422":51179,"_2810":51358},[],"Manage Thing groups",{"_3322":1314,"_29027":1257,"_20151":51360,"_5":13779,"_26422":51179,"_2810":51361},[],"`iot:CreateProvisioningTemplate`",{"_3322":1315,"_29027":1257,"_20151":51363,"_5":13779,"_26422":51179,"_2810":51364},[],"Create JITP templates",{"_3322":1316,"_29027":1257,"_20151":51366,"_5":13779,"_26422":51179,"_2810":51367},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3322":1317,"_29027":1257,"_20151":51369,"_5":13779,"_26422":51179,"_2810":51370},[],"Read and write the Device Shadow",{"_3322":1318,"_29027":1257,"_20151":51372,"_5":13779,"_26422":51179,"_2810":51373},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3322":1319,"_29027":1257,"_20151":51375,"_5":13779,"_26422":51183,"_2810":51376},[],"Parameter",{"_3322":1320,"_29027":1257,"_20151":51378,"_5":13779,"_26422":51183,"_2810":51379},[],"Type",{"_3322":1321,"_29027":1257,"_20151":51381,"_5":13779,"_26422":51183,"_2810":51382},[],"Required",{"_3322":1322,"_29027":1257,"_20151":51384,"_5":13779,"_26422":51183,"_2810":51385},[],"Description",{"_3322":1323,"_29027":1257,"_20151":51387,"_5":13779,"_26422":51183,"_2810":51388},[],"`connector_id`",{"_3322":1324,"_29027":1257,"_20151":51390,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1325,"_29027":1257,"_20151":51392,"_5":13779,"_26422":51183,"_2810":51393},[],"Yes",{"_3322":1326,"_29027":1257,"_20151":51395,"_5":13779,"_26422":51183,"_2810":51396},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3322":1327,"_29027":1257,"_20151":51398,"_5":13779,"_26422":51183,"_2810":51399},[],"`aws_config.region`",{"_3322":1328,"_29027":1257,"_20151":51401,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1329,"_29027":1257,"_20151":51403,"_5":13779,"_26422":51183,"_2810":51393},[],{"_3322":1330,"_29027":1257,"_20151":51405,"_5":13779,"_26422":51183,"_2810":51406},[],"AWS region where the connector operates.",{"_3322":1331,"_29027":1257,"_20151":51408,"_5":13779,"_26422":51183,"_2810":51409},[],"`aws_config.auth_method`",{"_3322":1332,"_29027":1257,"_20151":51411,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1333,"_29027":1257,"_20151":51413,"_5":13779,"_26422":51183,"_2810":51393},[],{"_3322":1334,"_29027":1257,"_20151":51415,"_5":13779,"_26422":51183,"_2810":51416},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3322":1335,"_29027":1257,"_20151":51418,"_5":13779,"_26422":51183,"_2810":51419},[],"`aws_config.access_key_id`",{"_3322":1336,"_29027":1257,"_20151":51421,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1337,"_29027":1257,"_20151":51423,"_5":13779,"_26422":51183,"_2810":51424},[],"Only with `auth_method=static`",{"_3322":1338,"_29027":1257,"_20151":51426,"_5":13779,"_26422":51183,"_2810":51427},[],"AWS access key.",{"_3322":1339,"_29027":1257,"_20151":51429,"_5":13779,"_26422":51183,"_2810":51430},[],"`aws_config.secret_access_key`",{"_3322":1340,"_29027":1257,"_20151":51432,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1341,"_29027":1257,"_20151":51434,"_5":13779,"_26422":51183,"_2810":51424},[],{"_3322":1342,"_29027":1257,"_20151":51436,"_5":13779,"_26422":51183,"_2810":51437},[],"AWS secret key.",{"_3322":1343,"_29027":1257,"_20151":51439,"_5":13779,"_26422":51183,"_2810":51440},[],"`aws_config.session_token`",{"_3322":1344,"_29027":1257,"_20151":51442,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1345,"_29027":1257,"_20151":51444,"_5":13779,"_26422":51183,"_2810":51445},[],"No",{"_3322":1346,"_29027":1257,"_20151":51447,"_5":13779,"_26422":51183,"_2810":51448},[],"Session token (with `auth_method=static`).",{"_3322":1347,"_29027":1257,"_20151":51450,"_5":13779,"_26422":51183,"_2810":51451},[],"`aws_config.role_arn`",{"_3322":1348,"_29027":1257,"_20151":51453,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1349,"_29027":1257,"_20151":51455,"_5":13779,"_26422":51183,"_2810":51456},[],"Only with `auth_method=role`",{"_3322":1350,"_29027":1257,"_20151":51458,"_5":13779,"_26422":51183,"_2810":51459},[],"ARN of the role to assume.",{"_3322":1351,"_29027":1257,"_20151":51461,"_5":13779,"_26422":51183,"_2810":51462},[],"`aws_config.endpoint_url`",{"_3322":1352,"_29027":1257,"_20151":51464,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1353,"_29027":1257,"_20151":51466,"_5":13779,"_26422":51183,"_2810":51445},[],{"_3322":1354,"_29027":1257,"_20151":51468,"_5":13779,"_26422":51183,"_2810":51469},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3322":1355,"_29027":1257,"_20151":51471,"_5":13779,"_26422":51183,"_2810":51472},[],"`subscriber_event_bus`",{"_3322":1356,"_29027":1257,"_20151":51474,"_5":13779,"_26422":51183,"_2810":16923},[],{"_3322":1357,"_29027":1257,"_20151":51476,"_5":13779,"_26422":51183,"_2810":51393},[],{"_3322":1358,"_29027":1257,"_20151":51478,"_5":13779,"_26422":51183,"_2810":51479},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3322":1359,"_29027":1257,"_20151":51481,"_5":13779,"_26422":51183,"_2810":51482},[],"`dms_manager_client`",{"_3322":1360,"_29027":1257,"_20151":51484,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1361,"_29027":1257,"_20151":51486,"_5":13779,"_26422":51183,"_2810":51393},[],{"_3322":1362,"_29027":1257,"_20151":51488,"_5":13779,"_26422":51183,"_2810":51489},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3322":1363,"_29027":1257,"_20151":51491,"_5":13779,"_26422":51183,"_2810":51492},[],"`device_manager_client`",{"_3322":1364,"_29027":1257,"_20151":51494,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1365,"_29027":1257,"_20151":51496,"_5":13779,"_26422":51183,"_2810":51393},[],{"_3322":1366,"_29027":1257,"_20151":51498,"_5":13779,"_26422":51183,"_2810":51499},[],"HTTP URL of Lamassu's Device Manager.",{"_3322":1367,"_29027":1257,"_20151":51501,"_5":13779,"_26422":51183,"_2810":51502},[],"`ca_client`",{"_3322":1368,"_29027":1257,"_20151":51504,"_5":13779,"_26422":51183,"_2810":24064},[],{"_3322":1369,"_29027":1257,"_20151":51506,"_5":13779,"_26422":51183,"_2810":51393},[],{"_3322":1370,"_29027":1257,"_20151":51508,"_5":13779,"_26422":51183,"_2810":51509},[],"HTTP URL of Lamassu's CA service.",{"_3322":1371,"_29027":1257,"_20151":51511,"_5":13779,"_26422":51187,"_2810":51512},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each transition performs. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3322":1372,"_29027":1257,"_20151":51514,"_5":13779,"_26422":51191,"_2810":51515},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3322":1373,"_29027":1257,"_20151":51517,"_5":13779,"_26422":51191,"_2810":51518},[],"CloudEvent type",{"_3322":1374,"_29027":1257,"_20151":51520,"_5":13779,"_26422":51191,"_2810":51521},[],"Lamassu resource",{"_3322":1375,"_29027":1257,"_20151":51523,"_5":13779,"_26422":51191,"_2810":51524},[],"AWS Resource",{"_3322":1376,"_29027":1257,"_20151":51526,"_5":13779,"_26422":51191,"_2810":51527},[],"IAM actions",{"_3322":1377,"_29027":1257,"_20151":51529,"_5":13779,"_26422":51191,"_2810":51530},[],"AWS calls and effect",{"_3322":1378,"_29027":1257,"_20151":51532,"_5":13779,"_26422":51191,"_2810":51533},[],"Where in this page",{"_3322":1379,"_29027":1257,"_20151":51535,"_5":13779,"_26422":51191,"_2810":51536},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3322":1380,"_29027":1257,"_20151":51538,"_5":13779,"_26422":51191,"_2810":51539},[],"CA",{"_3322":1381,"_29027":1257,"_20151":51541,"_5":13779,"_26422":51191,"_2810":51542},[],"`IoTCore/CACertificate`",{"_3322":1382,"_29027":1257,"_20151":51544,"_5":13779,"_26422":51191,"_2810":51545},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3322":1383,"_29027":1257,"_20151":51547,"_5":13779,"_26422":51191,"_2810":51548},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3322":1384,"_29027":1257,"_20151":51550,"_5":13779,"_26422":51191,"_2810":51196},[],{"_3322":1385,"_29027":1257,"_20151":51552,"_5":13779,"_26422":51191,"_2810":51553},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3322":1386,"_29027":1257,"_20151":51555,"_5":13779,"_26422":51191,"_2810":51556},[],"DMS",{"_3322":1387,"_29027":1257,"_20151":51558,"_5":13779,"_26422":51191,"_2810":51559},[],"`IoTCore/ProvisioningTemplate`",{"_3322":1388,"_29027":1257,"_20151":51561,"_5":13779,"_26422":51191,"_2810":51562},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3322":1389,"_29027":1257,"_20151":51564,"_5":13779,"_26422":51191,"_2810":51565},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3322":1390,"_29027":1257,"_20151":51567,"_5":13779,"_26422":51191,"_2810":51200},[],{"_3322":1391,"_29027":1257,"_20151":51569,"_5":13779,"_26422":51191,"_2810":51570},[],"`EventBindDeviceIdentityKey`",{"_3322":1392,"_29027":1257,"_20151":51572,"_5":13779,"_26422":51191,"_2810":51573},[],"Device",{"_3322":1393,"_29027":1257,"_20151":51575,"_5":13779,"_26422":51191,"_2810":51576},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3322":1394,"_29027":1257,"_20151":51578,"_5":13779,"_26422":51191,"_2810":51579},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3322":1395,"_29027":1257,"_20151":51581,"_5":13779,"_26422":51191,"_2810":51582},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3322":1396,"_29027":1257,"_20151":51584,"_5":13779,"_26422":51191,"_2810":51208},[],{"_3322":1397,"_29027":1257,"_20151":51586,"_5":13779,"_26422":51191,"_2810":51587},[],"`EventUpdateCertificateStatusKey`",{"_3322":1398,"_29027":1257,"_20151":51589,"_5":13779,"_26422":51191,"_2810":51590},[],"Certificate",{"_3322":1399,"_29027":1257,"_20151":51592,"_5":13779,"_26422":51191,"_2810":51593},[],"`IoTCore/Certificate`",{"_3322":1400,"_29027":1257,"_20151":51595,"_5":13779,"_26422":51191,"_2810":51596},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3322":1401,"_29027":1257,"_20151":51598,"_5":13779,"_26422":51191,"_2810":51599},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3322":1402,"_29027":1257,"_20151":51601,"_5":13779,"_26422":51191,"_2810":51204},[],{"_3322":1403,"_29027":1257,"_20151":51603,"_5":13779,"_26422":51191,"_2810":51604},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3322":1404,"_29027":1257,"_20151":51606,"_5":13779,"_26422":51191,"_2810":51607},[],"Certificate / Device",{"_3322":1405,"_29027":1257,"_20151":51609,"_5":13779,"_26422":51191,"_2810":51610},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3322":1406,"_29027":1257,"_20151":51612,"_5":13779,"_26422":51191,"_2810":47641},[],{"_3322":1407,"_29027":1257,"_20151":51614,"_5":13779,"_26422":51191,"_2810":51615},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3322":1408,"_29027":1257,"_20151":51617,"_5":13779,"_26422":51191,"_2810":51260},[],{"_3322":1409,"_29027":1257,"_20151":51619,"_5":13779,"_26422":51195,"_2810":51620},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3322":1410,"_29027":1257,"_20151":51622,"_5":13779,"_26422":51195,"_2810":51623},[],"by the `registration.status` field of the CA's connector metadata:",{"_3322":1411,"_29027":1257,"_20151":51625,"_5":13779,"_26422":51195,"_2810":51626},[],"Transition",{"_3322":1412,"_29027":1257,"_20151":51628,"_5":13779,"_26422":51195,"_2810":51629},[],"AWS calls",{"_3322":1413,"_29027":1257,"_20151":51631,"_5":13779,"_26422":51195,"_2810":51632},[],"`NotRegistered` → `Requested`",{"_3322":1414,"_29027":1257,"_20151":51634,"_5":13779,"_26422":51195,"_2810":51635},[],"none (metadata write only)",{"_3322":1415,"_29027":1257,"_20151":51637,"_5":13779,"_26422":51195,"_2810":51638},[],"`Requested` → `Registering`",{"_3322":1416,"_29027":1257,"_20151":51640,"_5":13779,"_26422":51195,"_2810":51641},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3322":1417,"_29027":1257,"_20151":51643,"_5":13779,"_26422":51195,"_2810":51644},[],"`Registering` → `Succeeded`",{"_3322":1418,"_29027":1257,"_20151":51646,"_5":13779,"_26422":51195,"_2810":51647},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3322":1419,"_29027":1257,"_20151":51649,"_5":13779,"_26422":51195,"_2810":51650},[],"`Registering` → `Failed`",{"_3322":1420,"_29027":1257,"_20151":51652,"_5":13779,"_26422":51195,"_2810":51653},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3322":1421,"_29027":1257,"_20151":51655,"_5":13779,"_26422":51195,"_2810":51656},[],"`Failed` / `Succeeded` → `Requested`",{"_3322":1422,"_29027":1257,"_20151":51658,"_5":13779,"_26422":51195,"_2810":51659},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3322":1423,"_29027":1257,"_20151":51661,"_5":13779,"_26422":51199,"_2810":51662},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3322":1424,"_29027":1257,"_20151":51664,"_5":13779,"_26422":51199,"_2810":51626},[],{"_3322":1425,"_29027":1257,"_20151":51666,"_5":13779,"_26422":51199,"_2810":51629},[],{"_3322":1426,"_29027":1257,"_20151":51668,"_5":13779,"_26422":51199,"_2810":51669},[],"`Unconfigured` → `None` / `Auto`",{"_3322":1427,"_29027":1257,"_20151":51671,"_5":13779,"_26422":51199,"_2810":51672},[],"none (configuration only)",{"_3322":1428,"_29027":1257,"_20151":51674,"_5":13779,"_26422":51199,"_2810":51675},[],"`None` ↔ `Auto`",{"_3322":1429,"_29027":1257,"_20151":51677,"_5":13779,"_26422":51199,"_2810":51672},[],{"_3322":1430,"_29027":1257,"_20151":51679,"_5":13779,"_26422":51199,"_2810":51680},[],"Any → `Jitp`",{"_3322":1431,"_29027":1257,"_20151":51682,"_5":13779,"_26422":51199,"_2810":51683},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3322":1432,"_29027":1257,"_20151":51685,"_5":13779,"_26422":51199,"_2810":51686},[],"`Jitp` → `None` / `Auto`",{"_3322":1433,"_29027":1257,"_20151":51688,"_5":13779,"_26422":51199,"_2810":51689},[],"none (the template stays in the AWS account)",{"_3322":1434,"_29027":1257,"_20151":51691,"_5":13779,"_26422":51203,"_2810":51692},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3322":1435,"_29027":1257,"_20151":51694,"_5":13779,"_26422":51203,"_2810":51626},[],{"_3322":1436,"_29027":1257,"_20151":51696,"_5":13779,"_26422":51203,"_2810":51629},[],{"_3322":1437,"_29027":1257,"_20151":51698,"_5":13779,"_26422":51203,"_2810":51699},[],"`NotSynced` → `Active`",{"_3322":1438,"_29027":1257,"_20151":51701,"_5":13779,"_26422":51203,"_2810":51343},[],{"_3322":1439,"_29027":1257,"_20151":51703,"_5":13779,"_26422":51203,"_2810":51704},[],"`Active` → `Inactive`",{"_3322":1440,"_29027":1257,"_20151":51706,"_5":13779,"_26422":51203,"_2810":51707},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3322":1441,"_29027":1257,"_20151":51709,"_5":13779,"_26422":51203,"_2810":51710},[],"`Active` → `Revoked`",{"_3322":1442,"_29027":1257,"_20151":51712,"_5":13779,"_26422":51203,"_2810":51707},[],{"_3322":1443,"_29027":1257,"_20151":51714,"_5":13779,"_26422":51203,"_2810":51715},[],"`Inactive` / `Revoked` → `Active`",{"_3322":1444,"_29027":1257,"_20151":51717,"_5":13779,"_26422":51203,"_2810":51343},[],{"_3322":1445,"_29027":1257,"_20151":51719,"_5":13779,"_26422":51203,"_2810":51720},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3322":1446,"_29027":1257,"_20151":51722,"_5":13779,"_26422":51203,"_2810":51723},[],"none (these states are not synced to AWS)",{"_3322":1447,"_29027":1257,"_20151":51725,"_5":13779,"_26422":51207,"_2810":51726},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3322":1448,"_29027":1257,"_20151":51728,"_5":13779,"_26422":51207,"_2810":51626},[],{"_3322":1449,"_29027":1257,"_20151":51730,"_5":13779,"_26422":51207,"_2810":51629},[],{"_3322":1450,"_29027":1257,"_20151":51732,"_5":13779,"_26422":51207,"_2810":51733},[],"`Absent` → `Provisioned`",{"_3322":1451,"_29027":1257,"_20151":51735,"_5":13779,"_26422":51207,"_2810":51736},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3322":1452,"_29027":1257,"_20151":51738,"_5":13779,"_26422":51207,"_2810":51739},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3322":1453,"_29027":1257,"_20151":51741,"_5":13779,"_26422":51207,"_2810":51742},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3322":1454,"_29027":1257,"_20151":51744,"_5":13779,"_26422":51207,"_2810":51745},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3322":1455,"_29027":1257,"_20151":51747,"_5":13779,"_26422":51211,"_2810":51748},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3322":1456,"_29027":1257,"_20151":51750,"_5":13779,"_26422":51215,"_2810":51751},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3322":1457,"_29027":1257,"_20151":51753,"_5":13779,"_26422":51215,"_2810":51754},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3322":1458,"_29027":1257,"_20151":51756,"_5":13779,"_26422":51219,"_2810":51757},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3322":1459,"_29027":1257,"_20151":51759,"_5":13779,"_26422":51219,"_2810":51760},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3322":1460,"_29027":1257,"_20151":51762,"_5":13779,"_26422":51219,"_2810":51763},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3322":1461,"_29027":1257,"_20151":51765,"_5":13779,"_26422":51219,"_2810":51766},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3322":1462,"_29027":1257,"_20151":51768,"_5":13779,"_26422":51219,"_2810":51769},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3322":1463,"_29027":1257,"_20151":51771,"_5":13779,"_26422":51219,"_2810":51772},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3322":1464,"_29027":1257,"_20151":51774,"_5":13779,"_26422":51223,"_2810":51775},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3322":1465,"_29027":1257,"_20151":51777,"_5":13779,"_26422":51227,"_2810":51778},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3322":1466,"_29027":1257,"_20151":51780,"_5":13779,"_26422":51227,"_2810":51781},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3322":1467,"_29027":1257,"_20151":51783,"_5":13779,"_26422":51231,"_2810":51784},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3322":1468,"_29027":1257,"_20151":51786,"_5":13779,"_26422":51235,"_2810":51787},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3322":1469,"_29027":1257,"_20151":51789,"_5":13779,"_26422":51235,"_2810":51790},[],"Creates or updates the IoT policies configured in the DMS.",{"_3322":1470,"_29027":1257,"_20151":51792,"_5":13779,"_26422":51235,"_2810":51793},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3322":1471,"_29027":1257,"_20151":51795,"_5":13779,"_26422":51235,"_2810":51796},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3322":1472,"_29027":1257,"_20151":51798,"_5":13779,"_26422":51235,"_2810":51799},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3322":1473,"_29027":1257,"_20151":51801,"_5":13779,"_26422":51235,"_2810":51802},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3322":1474,"_29027":1257,"_20151":51804,"_5":13779,"_26422":51235,"_2810":51805},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3322":1475,"_29027":1257,"_20151":51807,"_5":13779,"_26422":51239,"_2810":51808},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3322":1476,"_29027":1257,"_20151":51810,"_5":13779,"_26422":51239,"_2810":51811},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3322":1477,"_29027":1257,"_20151":51813,"_5":13779,"_26422":51239,"_2810":51814},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3322":1478,"_29027":1257,"_20151":51816,"_5":13779,"_26422":51239,"_2810":51817},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3322":1479,"_29027":1257,"_20151":51819,"_5":13779,"_26422":51239,"_2810":51820},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3322":1480,"_29027":1257,"_20151":51822,"_5":13779,"_26422":51243,"_2810":51823},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3322":1481,"_29027":1257,"_20151":51825,"_5":13779,"_26422":51243,"_2810":51826},[],"The full flow from the device's perspective is:",{"_3322":1482,"_29027":1257,"_20151":51828,"_5":13779,"_26422":51243,"_2810":51829},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3322":1483,"_29027":1257,"_20151":51831,"_5":13779,"_26422":51247,"_2810":51832},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3322":1484,"_29027":1257,"_20151":51834,"_5":13779,"_26422":51247,"_2810":51835},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3322":1485,"_29027":1257,"_20151":51837,"_5":13779,"_26422":51247,"_2810":51838},[],"For the JITP flow to work correctly:",{"_3322":1486,"_29027":1257,"_20151":51840,"_5":13779,"_26422":51247,"_2810":51841},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3322":1487,"_29027":1257,"_20151":51843,"_5":13779,"_26422":51247,"_2810":51844},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3322":1488,"_29027":1257,"_20151":51846,"_5":13779,"_26422":51247,"_2810":51847},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3322":1489,"_29027":1257,"_20151":51849,"_5":13779,"_26422":51247,"_2810":51850},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3322":1490,"_29027":1257,"_20151":51852,"_5":13779,"_26422":51251,"_2810":51853},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3322":1491,"_29027":1257,"_20151":51855,"_5":13779,"_26422":51251,"_2810":51856},[],"Status in Lamassu",{"_3322":1492,"_29027":1257,"_20151":51858,"_5":13779,"_26422":51251,"_2810":51859},[],"Revocation reason",{"_3322":1493,"_29027":1257,"_20151":51861,"_5":13779,"_26422":51251,"_2810":51862},[],"Status in AWS IoT Core",{"_3322":1494,"_29027":1257,"_20151":51864,"_5":13779,"_26422":51251,"_2810":51865},[],"`Active`",{"_3322":1495,"_29027":1257,"_20151":51867,"_5":13779,"_26422":51251,"_2810":51868},[],"None",{"_3322":1496,"_29027":1257,"_20151":51870,"_5":13779,"_26422":51251,"_2810":51871},[],"`ACTIVE`",{"_3322":1497,"_29027":1257,"_20151":51873,"_5":13779,"_26422":51251,"_2810":51874},[],"`Revoked`",{"_3322":1498,"_29027":1257,"_20151":51876,"_5":13779,"_26422":51251,"_2810":51877},[],"`certificateHold`",{"_3322":1499,"_29027":1257,"_20151":51879,"_5":13779,"_26422":51251,"_2810":51880},[],"`INACTIVE`",{"_3322":1500,"_29027":1257,"_20151":51882,"_5":13779,"_26422":51251,"_2810":51874},[],{"_3322":1501,"_29027":1257,"_20151":51884,"_5":13779,"_26422":51251,"_2810":51885},[],"Any other reason",{"_3322":1502,"_29027":1257,"_20151":51887,"_5":13779,"_26422":51251,"_2810":51888},[],"`REVOKED`",{"_3322":1503,"_29027":1257,"_20151":51890,"_5":13779,"_26422":51251,"_2810":51891},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3322":1504,"_29027":1257,"_20151":51893,"_5":13779,"_26422":51255,"_2810":51894},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3322":1505,"_29027":1257,"_20151":51896,"_5":13779,"_26422":51255,"_2810":51897},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3322":1506,"_29027":1257,"_20151":51899,"_5":13779,"_26422":51255,"_2810":51900},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3322":1507,"_29027":1257,"_20151":51902,"_5":13779,"_26422":51259,"_2810":51903},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3322":1508,"_29027":1257,"_20151":51905,"_5":13779,"_26422":51259,"_2810":51906},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3322":1509,"_29027":1257,"_20151":51908,"_5":13779,"_26422":51263,"_2810":51909},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3322":1510,"_29027":1257,"_20151":51911,"_5":13779,"_26422":51263,"_2810":51912},[],"There are two action types:",{"_3322":1511,"_29027":1257,"_20151":51914,"_5":13779,"_26422":51263,"_2810":51915},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3322":1512,"_29027":1257,"_20151":51917,"_5":13779,"_26422":51263,"_2810":51918},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3322":1513,"_29027":1257,"_20151":51920,"_5":13779,"_26422":51263,"_2810":51921},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3322":1514,"_29027":1257,"_20151":51923,"_5":13779,"_26422":51267,"_2810":51924},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3322":1515,"_29027":1257,"_20151":51926,"_5":13779,"_26422":51267,"_2810":51927},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3322":1516,"_29027":1257,"_20151":51929,"_5":13779,"_26422":51267,"_2810":51930},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3322":1517,"_29027":1257,"_20151":51932,"_5":13779,"_26422":51271,"_2810":51933},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3322":1518,"_29027":1257,"_20151":51935,"_5":13779,"_26422":51271,"_2810":51936},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3322":1519,"_29027":1257,"_20151":51938,"_5":13779,"_26422":51271,"_2810":51939},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3322":1520,"_29027":1257,"_20151":51941,"_5":13779,"_26422":51271,"_2810":51942},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3322":1521,"_29027":1257,"_20151":51944,"_5":13779,"_26422":51271,"_2810":51945},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3322":1522,"_29027":1257,"_20151":51947,"_5":13779,"_26422":51271,"_2810":51948},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3322":1523,"_29027":1257,"_20151":51950,"_5":13779,"_26422":51271,"_2810":51951},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3322":1524,"_29027":1257,"_20151":51953,"_5":13779,"_26422":51271,"_2810":51954},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3322":1525,"_29027":1257,"_20151":51956,"_5":13779,"_26422":51271,"_2810":51957},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3322":1526,"_29027":1257,"_20151":51959,"_5":13779,"_26422":51271,"_2810":51960},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3322":1527,"_29027":1257,"_20151":51962,"_5":13779,"_26422":51271,"_2810":51963},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3322":1528,"_29027":1257,"_20151":51965,"_5":13779,"_26422":51271,"_2810":51966},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3322":1529,"_29027":1257,"_20151":51968,"_5":13779,"_26422":51271,"_2810":51969},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3322":1530,"_29027":1257,"_20151":51971,"_5":13779,"_26422":51271,"_2810":51972},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3322":1531,"_29027":1257,"_20151":51974,"_5":13779,"_26422":51271,"_2810":51975},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3322":1532,"_29027":1257,"_20151":51977,"_5":13779,"_26422":51271,"_2810":51978},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3322":1533,"_29027":1257,"_20151":51980,"_5":13779,"_26422":51271,"_2810":51981},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3322":1534,"_29027":1257,"_20151":51983,"_5":13779,"_26422":51271,"_2810":51984},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3322":1535,"_29027":1257,"_20151":51986,"_5":13779,"_26422":51271,"_2810":51987},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3322":1536,"_29027":1257,"_20151":51989,"_5":13779,"_26422":51271,"_2810":51990},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3322":1537,"_29027":1257,"_20151":51992,"_5":13779,"_26422":51271,"_2810":51993},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3322":1538,"_29027":1257,"_20151":51995,"_5":13779,"_26422":51271,"_2810":51996},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3322":1539,"_29027":1257,"_20151":51998,"_5":13779,"_26422":51271,"_2810":51999},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3322":1540,"_29027":1257,"_20151":52001,"_5":13779,"_26422":51271,"_2810":52002},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3322":1541,"_29027":1541,"_5":14137,"_2810":49702,"_29350":52004,"_20151":52005,"_26422":1541},[47245,48694,49702],[],{"_3322":1542,"_29027":1541,"_20151":52007,"_5":13779,"_26422":1541,"_2810":52008},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3322":1543,"_29027":1541,"_5":29347,"_20151":52010,"_26422":52011,"_2810":52012},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3322":1544,"_29027":1541,"_5":29347,"_20151":52014,"_26422":52015,"_2810":49700},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3322":1545,"_29027":1541,"_5":29347,"_20151":52017,"_26422":52018,"_2810":49883},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3322":1546,"_29027":1541,"_5":29347,"_20151":52020,"_26422":52021,"_2810":51164},[],"/docs/platform/iot-fleets/overview#integrations",{"_3322":1547,"_29027":1541,"_5":29347,"_20151":52023,"_26422":52024,"_2810":52025},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3322":1548,"_29027":1541,"_20151":52027,"_5":13779,"_26422":1541,"_2810":52028},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3322":1549,"_29027":1541,"_20151":52030,"_5":13779,"_26422":52011,"_2810":52031},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3322":1550,"_29027":1541,"_20151":52033,"_5":13779,"_26422":52011,"_2810":52034},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3322":1551,"_29027":1541,"_20151":52036,"_5":13779,"_26422":52015,"_2810":52037},[],"Resource",{"_3322":1552,"_29027":1541,"_20151":52039,"_5":13779,"_26422":52015,"_2810":52040},[],"What it represents",{"_3322":1553,"_29027":1541,"_20151":52042,"_5":13779,"_26422":52015,"_2810":52043},[],"**Device**",{"_3322":1554,"_29027":1541,"_20151":52045,"_5":13779,"_26422":52015,"_2810":52046},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3322":1555,"_29027":1541,"_20151":52048,"_5":13779,"_26422":52015,"_2810":52049},[],"**Identity**",{"_3322":1556,"_29027":1541,"_20151":52051,"_5":13779,"_26422":52015,"_2810":52052},[],"The device's association with its certificates: an active version and a history.",{"_3322":1557,"_29027":1541,"_20151":52054,"_5":13779,"_26422":52015,"_2810":52055},[],"**DMS**",{"_3322":1558,"_29027":1541,"_20151":52057,"_5":13779,"_26422":52015,"_2810":52058},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3322":1559,"_29027":1541,"_20151":52060,"_5":13779,"_26422":52015,"_2810":52061},[],"**Fleet**",{"_3322":1560,"_29027":1541,"_20151":52063,"_5":13779,"_26422":52015,"_2810":52064},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3322":1561,"_29027":1541,"_20151":52066,"_5":13779,"_26422":52015,"_2810":52067},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3322":1562,"_29027":1541,"_20151":52069,"_5":13779,"_26422":52015,"_2810":52070},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3322":1563,"_29027":1541,"_20151":52072,"_5":13779,"_26422":52018,"_2810":52073},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3322":1564,"_29027":1541,"_20151":52075,"_5":13779,"_26422":52018,"_2810":52076},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3322":1565,"_29027":1541,"_20151":52078,"_5":13779,"_26422":52018,"_2810":52079},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3322":1566,"_29027":1541,"_20151":52081,"_5":13779,"_26422":52018,"_2810":52082},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3322":1567,"_29027":1541,"_20151":52084,"_5":13779,"_26422":52018,"_2810":52085},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3322":1568,"_29027":1541,"_20151":52087,"_5":13779,"_26422":52018,"_2810":52088},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3322":1569,"_29027":1541,"_20151":52090,"_5":13779,"_26422":52018,"_2810":52091},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3322":1570,"_29027":1541,"_20151":52093,"_5":13779,"_26422":52018,"_2810":52094},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3322":1571,"_29027":1541,"_20151":52096,"_5":13779,"_26422":52021,"_2810":52097},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3322":1572,"_29027":1541,"_20151":52099,"_5":13779,"_26422":52021,"_2810":52100},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3322":1573,"_29027":1541,"_20151":52102,"_5":13779,"_26422":52024,"_2810":52103},[],"Participant",{"_3322":1574,"_29027":1541,"_20151":52105,"_5":13779,"_26422":52024,"_2810":52106},[],"Responsibility",{"_3322":1575,"_29027":1541,"_20151":52108,"_5":13779,"_26422":52024,"_2810":52109},[],"PKI administrator",{"_3322":1576,"_29027":1541,"_20151":52111,"_5":13779,"_26422":52024,"_2810":52112},[],"CA, issuance profile, chain and revocation publication.",{"_3322":1577,"_29027":1541,"_20151":52114,"_5":13779,"_26422":52024,"_2810":52115},[],"Provisioning administrator",{"_3322":1578,"_29027":1541,"_20151":52117,"_5":13779,"_26422":52024,"_2810":52118},[],"DMS, admission, authentication per operation and inventory.",{"_3322":1579,"_29027":1541,"_20151":52120,"_5":13779,"_26422":52024,"_2810":52121},[],"Device integrator",{"_3322":1580,"_29027":1541,"_20151":52123,"_5":13779,"_26422":52024,"_2810":52124},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3322":1581,"_29027":1541,"_20151":52126,"_5":13779,"_26422":52024,"_2810":52127},[],"Consumer integrator",{"_3322":1582,"_29027":1541,"_20151":52129,"_5":13779,"_26422":52024,"_2810":52130},[],"Trusted issuers, validation and device permissions in the destination.",{"_3322":1583,"_29027":1541,"_20151":52132,"_5":13779,"_26422":52024,"_2810":52133},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3322":1584,"_29027":1584,"_5":14137,"_2810":52135,"_29350":52136,"_20151":52138,"_26422":1584},"Enroll and connect your first device",[47245,48694,49702,52137],"Getting started",[],{"_3322":1585,"_29027":1584,"_20151":52140,"_5":13779,"_26422":1584,"_2810":52141},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3322":1586,"_29027":1584,"_5":29347,"_20151":52143,"_26422":52144,"_2810":47255},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3322":1587,"_29027":1584,"_5":29347,"_20151":52146,"_26422":52147,"_2810":52148},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3322":1588,"_29027":1584,"_5":29347,"_20151":52150,"_26422":52151,"_2810":52152},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3322":1589,"_29027":1584,"_5":29347,"_20151":52154,"_26422":52155,"_2810":52156},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3322":1590,"_29027":1584,"_5":29347,"_20151":52158,"_26422":52159,"_2810":52160},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3322":1591,"_29027":1584,"_5":29347,"_20151":52162,"_26422":52163,"_2810":52164},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3322":1592,"_29027":1584,"_5":29347,"_20151":52166,"_26422":52167,"_2810":52168},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3322":1593,"_29027":1584,"_5":29347,"_20151":52170,"_26422":52171,"_2810":52172},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3322":1594,"_29027":1584,"_20151":52174,"_5":13779,"_26422":1584,"_2810":52175},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3322":1595,"_29027":1584,"_20151":52177,"_5":13779,"_26422":52144,"_2810":52178},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3322":1596,"_29027":1584,"_20151":52180,"_5":13779,"_26422":52144,"_2810":52181},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3322":1597,"_29027":1584,"_20151":52183,"_5":13779,"_26422":52144,"_2810":52184},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3322":1598,"_29027":1584,"_20151":52186,"_5":13779,"_26422":52144,"_2810":52187},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3322":1599,"_29027":1584,"_20151":52189,"_5":13779,"_26422":52144,"_2810":52190},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3322":1600,"_29027":1584,"_20151":52192,"_5":13779,"_26422":52147,"_2810":52193},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3322":1601,"_29027":1584,"_20151":52195,"_5":13779,"_26422":52147,"_2810":52196},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3322":1602,"_29027":1584,"_20151":52198,"_5":13779,"_26422":52151,"_2810":52199},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3322":1603,"_29027":1584,"_20151":52201,"_5":13779,"_26422":52151,"_2810":52202},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3322":1604,"_29027":1584,"_20151":52204,"_5":13779,"_26422":52151,"_2810":52205},[],"Setting",{"_3322":1605,"_29027":1584,"_20151":52207,"_5":13779,"_26422":52151,"_2810":52208},[],"Evaluation value",{"_3322":1606,"_29027":1584,"_20151":52210,"_5":13779,"_26422":52151,"_2810":52211},[],"Enrollment CA",{"_3322":1607,"_29027":1584,"_20151":52213,"_5":13779,"_26422":52151,"_2810":52214},[],"Issuing root from `device-root.pem`.",{"_3322":1608,"_29027":1584,"_20151":52216,"_5":13779,"_26422":52151,"_2810":50013},[],{"_3322":1609,"_29027":1584,"_20151":52218,"_5":13779,"_26422":52151,"_2810":52219},[],"The 1-hour leaf profile you just prepared.",{"_3322":1610,"_29027":1584,"_20151":52221,"_5":13779,"_26422":52151,"_2810":52222},[],"Protocol / Registration Mode",{"_3322":1611,"_29027":1584,"_20151":52224,"_5":13779,"_26422":52151,"_2810":52225},[],"`EST_RFC7030` / `JITP`.",{"_3322":1612,"_29027":1584,"_20151":52227,"_5":13779,"_26422":52151,"_2810":52228},[],"Verify CSR Signature",{"_3322":1613,"_29027":1584,"_20151":52230,"_5":13779,"_26422":52151,"_2810":52231},[],"Enabled.",{"_3322":1614,"_29027":1584,"_20151":52233,"_5":13779,"_26422":52151,"_2810":52234},[],"Enable Replaceable Enrollment",{"_3322":1615,"_29027":1584,"_20151":52236,"_5":13779,"_26422":52151,"_2810":52237},[],"Disabled; the ID must be new.",{"_3322":1616,"_29027":1584,"_20151":52239,"_5":13779,"_26422":52151,"_2810":52240},[],"Initial authentication",{"_3322":1617,"_29027":1584,"_20151":52242,"_5":13779,"_26422":52151,"_2810":52243},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3322":1618,"_29027":1584,"_20151":52245,"_5":13779,"_26422":52151,"_2810":52246},[],"Renewal authentication",{"_3322":1619,"_29027":1584,"_20151":52248,"_5":13779,"_26422":52151,"_2810":52249},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3322":1620,"_29027":1584,"_20151":52251,"_5":13779,"_26422":52151,"_2810":52252},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3322":1621,"_29027":1584,"_20151":52254,"_5":13779,"_26422":52151,"_2810":52255},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3322":1622,"_29027":1584,"_20151":52257,"_5":13779,"_26422":52151,"_2810":52258},[],"Re-enrollment Delta",{"_3322":1623,"_29027":1584,"_20151":52260,"_5":13779,"_26422":52151,"_2810":52261},[],"1 hour.",{"_3322":1624,"_29027":1584,"_20151":52263,"_5":13779,"_26422":52151,"_2810":52264},[],"Preventive / Critical Delta",{"_3322":1625,"_29027":1584,"_20151":52266,"_5":13779,"_26422":52151,"_2810":52267},[],"30 minutes / 10 minutes.",{"_3322":1626,"_29027":1584,"_20151":52269,"_5":13779,"_26422":52151,"_2810":52270},[],"Revoke on Re-enrollment",{"_3322":1627,"_29027":1584,"_20151":52272,"_5":13779,"_26422":52151,"_2810":52273},[],"Disabled to test the successor before retiring the previous identity.",{"_3322":1628,"_29027":1584,"_20151":52275,"_5":13779,"_26422":52151,"_2810":50021},[],{"_3322":1629,"_29027":1584,"_20151":52277,"_5":13779,"_26422":52151,"_2810":52278},[],"Disabled; the operational key is generated in the client.",{"_3322":1630,"_29027":1584,"_20151":52280,"_5":13779,"_26422":52151,"_2810":52281},[],"CA Distribution",{"_3322":1631,"_29027":1584,"_20151":52283,"_5":13779,"_26422":52151,"_2810":52284},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3322":1632,"_29027":1584,"_20151":52286,"_5":13779,"_26422":52151,"_2810":52287},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3322":1633,"_29027":1584,"_20151":52289,"_5":13779,"_26422":52155,"_2810":52290},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3322":1634,"_29027":1584,"_20151":52292,"_5":13779,"_26422":52155,"_2810":52293},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3322":1635,"_29027":1584,"_20151":52295,"_5":13779,"_26422":52159,"_2810":52296},[],"Generate a new key and CSR with the selected identifier:",{"_3322":1636,"_29027":1584,"_20151":52298,"_5":13779,"_26422":52159,"_2810":52299},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3322":1637,"_29027":1584,"_20151":52301,"_5":13779,"_26422":52159,"_2810":52302},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3322":1638,"_29027":1584,"_20151":52304,"_5":13779,"_26422":52163,"_2810":52305},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3322":1639,"_29027":1584,"_20151":52307,"_5":13779,"_26422":52163,"_2810":52308},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3322":1640,"_29027":1584,"_20151":52310,"_5":13779,"_26422":52167,"_2810":52311},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3322":1641,"_29027":1584,"_20151":52313,"_5":13779,"_26422":52167,"_2810":52314},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3322":1642,"_29027":1584,"_20151":52316,"_5":13779,"_26422":52167,"_2810":52317},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3322":1643,"_29027":1584,"_20151":52319,"_5":13779,"_26422":52167,"_2810":52320},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3322":1644,"_29027":1584,"_20151":52322,"_5":13779,"_26422":52167,"_2810":52323},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3322":1645,"_29027":1584,"_20151":52325,"_5":13779,"_26422":52171,"_2810":52326},[],"Check",{"_3322":1646,"_29027":1584,"_20151":52328,"_5":13779,"_26422":52171,"_2810":52329},[],"Expected result",{"_3322":1647,"_29027":1584,"_20151":52331,"_5":13779,"_26422":52171,"_2810":52332},[],"Registration",{"_3322":1648,"_29027":1584,"_20151":52334,"_5":13779,"_26422":52171,"_2810":52335},[],"ID created automatically and correct DMS.",{"_3322":1649,"_29027":1584,"_20151":52337,"_5":13779,"_26422":52171,"_2810":51590},[],{"_3322":1650,"_29027":1584,"_20151":52339,"_5":13779,"_26422":52171,"_2810":52340},[],"CN, profile, serial and key verified.",{"_3322":1651,"_29027":1584,"_20151":52342,"_5":13779,"_26422":52171,"_2810":52343},[],"Inventory",{"_3322":1652,"_29027":1584,"_20151":52345,"_5":13779,"_26422":52171,"_2810":52346},[],"Received serial visible as the current identity and in history.",{"_3322":1653,"_29027":1584,"_20151":52348,"_5":13779,"_26422":52171,"_2810":52349},[],"Consumer",{"_3322":1654,"_29027":1584,"_20151":52351,"_5":13779,"_26422":52171,"_2810":52352},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3322":1655,"_29027":1584,"_20151":52354,"_5":13779,"_26422":52171,"_2810":52355},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3322":1656,"_29027":1584,"_20151":52357,"_5":13779,"_26422":52171,"_2810":52358},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3322":1657,"_29027":1657,"_5":14137,"_2810":49718,"_29350":52360,"_20151":52361,"_26422":1657},[47245,48694,49702,52137],[],{"_3322":1658,"_29027":1657,"_20151":52363,"_5":13779,"_26422":1657,"_2810":52364},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3322":1659,"_29027":1657,"_5":29347,"_20151":52366,"_26422":52367,"_2810":47255},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3322":1660,"_29027":1657,"_5":29347,"_20151":52369,"_26422":52370,"_2810":52371},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3322":1661,"_29027":1657,"_5":29347,"_20151":52373,"_26422":52374,"_2810":52375},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3322":1662,"_29027":1657,"_5":29347,"_20151":52377,"_26422":52378,"_2810":52379},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3322":1663,"_29027":1657,"_5":29347,"_20151":52381,"_26422":52382,"_2810":52383},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3322":1664,"_29027":1657,"_5":29347,"_20151":52385,"_26422":52386,"_2810":52387},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3322":1665,"_29027":1657,"_5":29347,"_20151":52389,"_26422":52390,"_2810":52329},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3322":1666,"_29027":1657,"_5":29347,"_20151":52392,"_26422":52393,"_2810":52394},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3322":1667,"_29027":1657,"_5":29347,"_20151":52396,"_26422":52397,"_2810":52398},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3322":1668,"_29027":1657,"_20151":52400,"_5":13779,"_26422":1657,"_2810":52401},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3322":1669,"_29027":1657,"_20151":52403,"_5":13779,"_26422":1657,"_2810":52404},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3322":1670,"_29027":1657,"_20151":52406,"_5":13779,"_26422":52367,"_2810":52407},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3322":1671,"_29027":1657,"_20151":52409,"_5":13779,"_26422":52367,"_2810":52410},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3322":1672,"_29027":1657,"_20151":52412,"_5":13779,"_26422":52367,"_2810":52413},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3322":1673,"_29027":1657,"_20151":52415,"_5":13779,"_26422":52367,"_2810":52416},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3322":1674,"_29027":1657,"_20151":52418,"_5":13779,"_26422":52370,"_2810":52419},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3322":1675,"_29027":1657,"_20151":52421,"_5":13779,"_26422":52370,"_2810":52422},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3322":1676,"_29027":1657,"_20151":52424,"_5":13779,"_26422":52370,"_2810":52425},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3322":1677,"_29027":1657,"_20151":52427,"_5":13779,"_26422":52370,"_2810":52428},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3322":1678,"_29027":1657,"_20151":52430,"_5":13779,"_26422":52370,"_2810":52431},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3322":1679,"_29027":1657,"_20151":52433,"_5":13779,"_26422":52370,"_2810":52434},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3322":1680,"_29027":1657,"_20151":52436,"_5":13779,"_26422":52370,"_2810":52437},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3322":1681,"_29027":1657,"_20151":52439,"_5":13779,"_26422":52370,"_2810":52440},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3322":1682,"_29027":1657,"_20151":52442,"_5":13779,"_26422":52374,"_2810":52443},[],"Open **Managed Devices** and the registration action. Complete:",{"_3322":1683,"_29027":1657,"_20151":52445,"_5":13779,"_26422":52374,"_2810":52446},[],"**Device ID**: `device-001`.",{"_3322":1684,"_29027":1657,"_20151":52448,"_5":13779,"_26422":52374,"_2810":52449},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3322":1685,"_29027":1657,"_20151":52451,"_5":13779,"_26422":52374,"_2810":52452},[],"**Icon** and **Tags**: optional classification.",{"_3322":1686,"_29027":1657,"_20151":52454,"_5":13779,"_26422":52374,"_2810":52455},[],"Confirm registration.",{"_3322":1687,"_29027":1657,"_20151":52457,"_5":13779,"_26422":52378,"_2810":52458},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3322":1688,"_29027":1657,"_20151":52460,"_5":13779,"_26422":52378,"_2810":52461},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3322":1689,"_29027":1657,"_20151":52463,"_5":13779,"_26422":52382,"_2810":52464},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3322":1690,"_29027":1657,"_20151":52466,"_5":13779,"_26422":52382,"_2810":52467},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3322":1691,"_29027":1657,"_20151":52469,"_5":13779,"_26422":52386,"_2810":52470},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3322":1692,"_29027":1657,"_20151":52472,"_5":13779,"_26422":52386,"_2810":52473},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3322":1693,"_29027":1657,"_20151":52475,"_5":13779,"_26422":52390,"_2810":52326},[],{"_3322":1694,"_29027":1657,"_20151":52477,"_5":13779,"_26422":52390,"_2810":52478},[],"Result",{"_3322":1695,"_29027":1657,"_20151":52480,"_5":13779,"_26422":52390,"_2810":51573},[],{"_3322":1696,"_29027":1657,"_20151":52482,"_5":13779,"_26422":52390,"_2810":52483},[],"`device-001` appears in inventory with the expected DMS.",{"_3322":1697,"_29027":1657,"_20151":52485,"_5":13779,"_26422":52390,"_2810":52486},[],"Current identity",{"_3322":1698,"_29027":1657,"_20151":52488,"_5":13779,"_26422":52390,"_2810":52489},[],"The associated certificate matches the one you verified in PKI.",{"_3322":1699,"_29027":1657,"_20151":52491,"_5":13779,"_26422":52390,"_2810":52492},[],"History",{"_3322":1700,"_29027":1657,"_20151":52494,"_5":13779,"_26422":52390,"_2810":52495},[],"The associated issuance appears with its serial number and dates.",{"_3322":1701,"_29027":1657,"_20151":52497,"_5":13779,"_26422":52390,"_2810":52498},[],"Key and certificate",{"_3322":1702,"_29027":1657,"_20151":52500,"_5":13779,"_26422":52390,"_2810":52501},[],"You have the verified pair ready to install on the device.",{"_3322":1703,"_29027":1657,"_20151":52503,"_5":13779,"_26422":52393,"_2810":52504},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3322":1704,"_29027":1657,"_20151":52506,"_5":13779,"_26422":52393,"_2810":52507},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3322":1705,"_29027":1657,"_20151":52509,"_5":13779,"_26422":52393,"_2810":52510},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3322":1706,"_29027":1657,"_20151":52512,"_5":13779,"_26422":52393,"_2810":52513},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3322":1707,"_29027":1657,"_20151":52515,"_5":13779,"_26422":52397,"_2810":52516},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3322":1708,"_29027":1657,"_20151":52518,"_5":13779,"_26422":52397,"_2810":52519},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3322":1709,"_29027":1657,"_20151":52521,"_5":13779,"_26422":52397,"_2810":52522},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3322":1710,"_29027":1710,"_5":14137,"_2810":52524,"_29350":52525,"_20151":52526,"_26422":1710},"Lamassu IoT Platform",[47245,48694],[],{"_3322":1711,"_29027":1710,"_20151":52528,"_5":13779,"_26422":1710,"_2810":52529},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3322":1712,"_29027":1710,"_5":29347,"_20151":52531,"_26422":52532,"_2810":52012},[],"/docs/platform/overview#start-here",{"_3322":1713,"_29027":1710,"_5":29347,"_20151":52534,"_26422":52535,"_2810":52536},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3322":1714,"_29027":1710,"_5":29347,"_20151":52538,"_26422":52539,"_2810":52540},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3322":1715,"_29027":1710,"_5":29347,"_20151":52542,"_26422":52543,"_2810":52544},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3322":1716,"_29027":1710,"_5":29347,"_20151":52546,"_26422":52547,"_2810":52548},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3322":1717,"_29027":1710,"_5":29347,"_20151":52550,"_26422":52551,"_2810":52552},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3322":1718,"_29027":1710,"_5":29347,"_20151":52554,"_26422":52555,"_2810":52556},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3322":1719,"_29027":1710,"_5":29347,"_20151":52558,"_26422":52559,"_2810":52560},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3322":1720,"_29027":1710,"_5":29347,"_20151":52562,"_26422":52563,"_2810":52564},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3322":1721,"_29027":1710,"_5":29347,"_20151":52566,"_26422":52567,"_2810":52568},[],"/docs/platform/overview#react-to-events","React to events",{"_3322":1722,"_29027":1710,"_5":29347,"_20151":52570,"_26422":52571,"_2810":52572},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3322":1723,"_29027":1710,"_20151":52574,"_5":13779,"_26422":1710,"_2810":52575},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3322":1724,"_29027":1710,"_20151":52577,"_5":13779,"_26422":52532,"_2810":52578},[],"Choose the result you need:",{"_3322":1725,"_29027":1710,"_20151":52580,"_5":13779,"_26422":52532,"_2810":52581},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3322":1726,"_29027":1710,"_20151":52583,"_5":13779,"_26422":52532,"_2810":52584},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3322":1727,"_29027":1710,"_20151":52586,"_5":13779,"_26422":52532,"_2810":52587},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3322":1728,"_29027":1710,"_20151":52589,"_5":13779,"_26422":52535,"_2810":52590},[],"Section",{"_3322":1729,"_29027":1710,"_20151":52592,"_5":13779,"_26422":52535,"_2810":52593},[],"What you manage",{"_3322":1730,"_29027":1710,"_20151":52595,"_5":13779,"_26422":52535,"_2810":52596},[],"Entry point",{"_3322":1731,"_29027":1710,"_20151":52598,"_5":13779,"_26422":52535,"_2810":52599},[],"**PKI**",{"_3322":1732,"_29027":1710,"_20151":52601,"_5":13779,"_26422":52535,"_2810":52602},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3322":1733,"_29027":1710,"_20151":52604,"_5":13779,"_26422":52535,"_2810":52605},[],"PKI overview",{"_3322":1734,"_29027":1710,"_20151":52607,"_5":13779,"_26422":52535,"_2810":52608},[],"**IoT Fleets**",{"_3322":1735,"_29027":1710,"_20151":52610,"_5":13779,"_26422":52535,"_2810":52611},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3322":1736,"_29027":1710,"_20151":52613,"_5":13779,"_26422":52535,"_2810":52614},[],"IoT Fleets overview",{"_3322":1737,"_29027":1710,"_20151":52616,"_5":13779,"_26422":52535,"_2810":52617},[],"**Administration**",{"_3322":1738,"_29027":1710,"_20151":52619,"_5":13779,"_26422":52535,"_2810":52620},[],"Operator permissions, audit and event subscriptions.",{"_3322":1739,"_29027":1710,"_20151":52622,"_5":13779,"_26422":52535,"_2810":48692},[],{"_3322":1740,"_29027":1710,"_20151":52624,"_5":13779,"_26422":52535,"_2810":52625},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3322":1741,"_29027":1710,"_20151":52627,"_5":13779,"_26422":52539,"_2810":52628},[],"An identity's journey connects four responsibilities:",{"_3322":1742,"_29027":1710,"_20151":52630,"_5":13779,"_26422":52539,"_2810":52631},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3322":1743,"_29027":1710,"_20151":52633,"_5":13779,"_26422":52539,"_2810":52634},[],"The provisioning administrator configures the DMS and initial trust.",{"_3322":1744,"_29027":1710,"_20151":52636,"_5":13779,"_26422":52539,"_2810":52637},[],"The device client requests a certificate and installs it with the matching key.",{"_3322":1745,"_29027":1710,"_20151":52639,"_5":13779,"_26422":52539,"_2810":52640},[],"The consumer validates the identity and applies its access permissions.",{"_3322":1746,"_29027":1710,"_20151":52642,"_5":13779,"_26422":52539,"_2810":52643},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3322":1747,"_29027":1710,"_20151":52645,"_5":13779,"_26422":52547,"_2810":52646},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3322":1748,"_29027":1710,"_20151":52648,"_5":13779,"_26422":52551,"_2810":52649},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3322":1749,"_29027":1710,"_20151":52651,"_5":13779,"_26422":52555,"_2810":52652},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3322":1750,"_29027":1710,"_20151":52654,"_5":13779,"_26422":52559,"_2810":52655},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3322":1751,"_29027":1710,"_20151":52657,"_5":13779,"_26422":52563,"_2810":52658},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3322":1752,"_29027":1710,"_20151":52660,"_5":13779,"_26422":52567,"_2810":52661},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3322":1753,"_29027":1710,"_20151":52663,"_5":13779,"_26422":52571,"_2810":52106},[],{"_3322":1754,"_29027":1710,"_20151":52665,"_5":13779,"_26422":52571,"_2810":52666},[],"What it prepares or checks",{"_3322":1755,"_29027":1710,"_20151":52668,"_5":13779,"_26422":52571,"_2810":52109},[],{"_3322":1756,"_29027":1710,"_20151":52670,"_5":13779,"_26422":52571,"_2810":52671},[],"Key custody, CA hierarchy, profiles and validation.",{"_3322":1757,"_29027":1710,"_20151":52673,"_5":13779,"_26422":52571,"_2810":52674},[],"Fleet administrator",{"_3322":1758,"_29027":1710,"_20151":52676,"_5":13779,"_26422":52571,"_2810":52677},[],"DMS, device admission, renewal policy and inventory.",{"_3322":1759,"_29027":1710,"_20151":52679,"_5":13779,"_26422":52571,"_2810":52121},[],{"_3322":1760,"_29027":1710,"_20151":52681,"_5":13779,"_26422":52571,"_2810":52682},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3322":1761,"_29027":1710,"_20151":52684,"_5":13779,"_26422":52571,"_2810":52127},[],{"_3322":1762,"_29027":1710,"_20151":52686,"_5":13779,"_26422":52571,"_2810":52687},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3322":1763,"_29027":1710,"_20151":52689,"_5":13779,"_26422":52571,"_2810":52690},[],"Infrastructure operator",{"_3322":1764,"_29027":1710,"_20151":52692,"_5":13779,"_26422":52571,"_2810":52693},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3322":1765,"_29027":1710,"_20151":52695,"_5":13779,"_26422":52571,"_2810":52696},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3322":1766,"_29027":1766,"_5":14137,"_2810":52698,"_29350":52699,"_20151":52702,"_26422":1766},"CA hierarchy and rotation",[47245,48694,52700,52701],"PKI","Keys, authorities and certificates",[],{"_3322":1767,"_29027":1766,"_20151":52704,"_5":13779,"_26422":1766,"_2810":52705},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3322":1768,"_29027":1766,"_5":29347,"_20151":52707,"_26422":52708,"_2810":52709},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3322":1769,"_29027":1766,"_5":29347,"_20151":52711,"_26422":52712,"_2810":52713},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3322":1770,"_29027":1766,"_5":29347,"_20151":52715,"_26422":52716,"_2810":52717},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3322":1771,"_29027":1766,"_5":29347,"_20151":52719,"_26422":52720,"_2810":52721},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3322":1772,"_29027":1766,"_5":29347,"_20151":52723,"_26422":52724,"_2810":52725},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3322":1773,"_29027":1766,"_5":29347,"_20151":52727,"_26422":52728,"_2810":52729},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3322":1774,"_29027":1766,"_5":29347,"_20151":52731,"_26422":52732,"_2810":52733},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3322":1775,"_29027":1766,"_5":29347,"_20151":52735,"_26422":52736,"_2810":52737},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3322":1776,"_29027":1766,"_5":29347,"_20151":52739,"_26422":52740,"_2810":52741},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3322":1777,"_29027":1766,"_5":29347,"_20151":52743,"_26422":52744,"_2810":52745},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3322":1778,"_29027":1766,"_5":29347,"_20151":52747,"_26422":52748,"_2810":52749},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3322":1779,"_29027":1766,"_5":29347,"_20151":52751,"_26422":52752,"_2810":52753},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3322":1780,"_29027":1766,"_20151":52755,"_5":13779,"_26422":1766,"_2810":52756},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3322":1781,"_29027":1766,"_20151":52758,"_5":13779,"_26422":1766,"_2810":52759},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3322":1782,"_29027":1766,"_20151":52761,"_5":13779,"_26422":52708,"_2810":52762},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3322":1783,"_29027":1766,"_20151":52764,"_5":13779,"_26422":52708,"_2810":52765},[],"environment, such as production and preproduction;",{"_3322":1784,"_29027":1766,"_20151":52767,"_5":13779,"_26422":52708,"_2810":52768},[],"owner or operating team;",{"_3322":1785,"_29027":1766,"_20151":52770,"_5":13779,"_26422":52708,"_2810":52771},[],"device family or manufacturing process;",{"_3322":1786,"_29027":1766,"_20151":52773,"_5":13779,"_26422":52708,"_2810":52774},[],"region or regulatory requirement;",{"_3322":1787,"_29027":1766,"_20151":52776,"_5":13779,"_26422":52708,"_2810":52777},[],"cryptographic engine or key policy;",{"_3322":1788,"_29027":1766,"_20151":52779,"_5":13779,"_26422":52708,"_2810":52780},[],"maintenance window and renewal cadence.",{"_3322":1789,"_29027":1766,"_20151":52782,"_5":13779,"_26422":52708,"_2810":52783},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3322":1790,"_29027":1766,"_20151":52785,"_5":13779,"_26422":52708,"_2810":52786},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3322":1791,"_29027":1766,"_20151":52788,"_5":13779,"_26422":52712,"_2810":52789},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3322":1792,"_29027":1766,"_20151":52791,"_5":13779,"_26422":52712,"_2810":52792},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3322":1793,"_29027":1766,"_20151":52794,"_5":13779,"_26422":52712,"_2810":52795},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. Plan ahead for both conditions.",{"_3322":1794,"_29027":1766,"_20151":52797,"_5":13779,"_26422":52716,"_2810":52798},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3322":1795,"_29027":1766,"_20151":52800,"_5":13779,"_26422":52716,"_2810":52801},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3322":1796,"_29027":1766,"_20151":52803,"_5":13779,"_26422":52716,"_2810":52804},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3322":1797,"_29027":1766,"_20151":52806,"_5":13779,"_26422":52716,"_2810":52807},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3322":1798,"_29027":1766,"_20151":52809,"_5":13779,"_26422":52724,"_2810":52810},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3322":1799,"_29027":1766,"_20151":52812,"_5":13779,"_26422":52728,"_2810":52813},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3322":1800,"_29027":1766,"_20151":52815,"_5":13779,"_26422":52732,"_2810":52816},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3322":1801,"_29027":1766,"_20151":52818,"_5":13779,"_26422":52736,"_2810":52819},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3322":1802,"_29027":1766,"_20151":52821,"_5":13779,"_26422":52740,"_2810":52822},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3322":1803,"_29027":1766,"_20151":52824,"_5":13779,"_26422":52744,"_2810":52825},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3322":1804,"_29027":1766,"_20151":52827,"_5":13779,"_26422":52748,"_2810":52828},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3322":1805,"_29027":1766,"_20151":52830,"_5":13779,"_26422":52748,"_2810":52831},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3322":1806,"_29027":1766,"_20151":52833,"_5":13779,"_26422":52748,"_2810":52834},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3322":1807,"_29027":1766,"_20151":52836,"_5":13779,"_26422":52748,"_2810":52837},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3322":1808,"_29027":1766,"_20151":52839,"_5":13779,"_26422":52752,"_2810":52840},[],"The new chain ends in an anchor installed by the consumer.",{"_3322":1809,"_29027":1766,"_20151":52842,"_5":13779,"_26422":52752,"_2810":52843},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3322":1810,"_29027":1766,"_20151":52845,"_5":13779,"_26422":52752,"_2810":52846},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3322":1811,"_29027":1766,"_20151":52848,"_5":13779,"_26422":52752,"_2810":52849},[],"Re-enrollment accepts the old identity during the planned period.",{"_3322":1812,"_29027":1766,"_20151":52851,"_5":13779,"_26422":52752,"_2810":52852},[],"OCSP and CRL respond for the authorities that remain active.",{"_3322":1813,"_29027":1766,"_20151":52854,"_5":13779,"_26422":52752,"_2810":52855},[],"No DMS is left accidentally issuing from the old CA.",{"_3322":1814,"_29027":1766,"_20151":52857,"_5":13779,"_26422":52752,"_2810":52858},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3322":1815,"_29027":1815,"_5":14137,"_2810":52860,"_29350":52861,"_20151":52862,"_26422":1815},"Certification authorities",[47245,48694,52700,52701],[],{"_3322":1816,"_29027":1815,"_20151":52864,"_5":13779,"_26422":1815,"_2810":52865},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3322":1817,"_29027":1815,"_5":29347,"_20151":52867,"_26422":52868,"_2810":52869},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3322":1818,"_29027":1815,"_5":29347,"_20151":52871,"_26422":52872,"_2810":52873},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3322":1819,"_29027":1815,"_5":29347,"_20151":52875,"_26422":52876,"_2810":47255},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3322":1820,"_29027":1815,"_5":29347,"_20151":52878,"_26422":52879,"_2810":52880},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3322":1821,"_29027":1815,"_5":29347,"_20151":52882,"_26422":52883,"_2810":52884},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3322":1822,"_29027":1815,"_5":29347,"_20151":52886,"_26422":52887,"_2810":52888},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3322":1823,"_29027":1815,"_5":29347,"_20151":52890,"_26422":52891,"_2810":52892},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3322":1824,"_29027":1815,"_5":29347,"_20151":52894,"_26422":52895,"_2810":52896},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3322":1825,"_29027":1815,"_5":29347,"_20151":52898,"_26422":52899,"_2810":52900},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3322":1826,"_29027":1815,"_5":29347,"_20151":52902,"_26422":52903,"_2810":52904},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3322":1827,"_29027":1815,"_5":29347,"_20151":52906,"_26422":52907,"_2810":52908},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3322":1828,"_29027":1815,"_5":29347,"_20151":52910,"_26422":52911,"_2810":52912},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3322":1829,"_29027":1815,"_5":29347,"_20151":52914,"_26422":52915,"_2810":52916},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3322":1830,"_29027":1815,"_5":29347,"_20151":52918,"_26422":52919,"_2810":52920},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3322":1831,"_29027":1815,"_5":29347,"_20151":52922,"_26422":52923,"_2810":52924},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3322":1832,"_29027":1815,"_5":29347,"_20151":52926,"_26422":52927,"_2810":52928},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3322":1833,"_29027":1815,"_5":29347,"_20151":52930,"_26422":52931,"_2810":52932},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3322":1834,"_29027":1815,"_5":29347,"_20151":52934,"_26422":52935,"_2810":52936},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3322":1835,"_29027":1815,"_5":29347,"_20151":52938,"_26422":52939,"_2810":52940},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3322":1836,"_29027":1815,"_5":29347,"_20151":52942,"_26422":52943,"_2810":52944},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3322":1837,"_29027":1815,"_5":29347,"_20151":52946,"_26422":52947,"_2810":52948},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3322":1838,"_29027":1815,"_5":29347,"_20151":52950,"_26422":52951,"_2810":52952},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3322":1839,"_29027":1815,"_5":29347,"_20151":52954,"_26422":52955,"_2810":52956},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3322":1840,"_29027":1815,"_20151":52958,"_5":13779,"_26422":1815,"_2810":52959},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3322":1841,"_29027":1815,"_20151":52961,"_5":13779,"_26422":1815,"_2810":52962},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3322":1842,"_29027":1815,"_20151":52964,"_5":13779,"_26422":1815,"_2810":52965},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3322":1843,"_29027":1815,"_20151":52967,"_5":13779,"_26422":52868,"_2810":52968},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3322":1844,"_29027":1815,"_20151":52970,"_5":13779,"_26422":52868,"_2810":52971},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3322":1845,"_29027":1815,"_20151":52973,"_5":13779,"_26422":52868,"_2810":52974},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3322":1846,"_29027":1815,"_20151":52976,"_5":13779,"_26422":52868,"_2810":52977},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3322":1847,"_29027":1815,"_20151":52979,"_5":13779,"_26422":52868,"_2810":52980},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3322":1848,"_29027":1815,"_20151":52982,"_5":13779,"_26422":52876,"_2810":52983},[],"Decide whether the CA will be a root or an intermediate.",{"_3322":1849,"_29027":1815,"_20151":52985,"_5":13779,"_26422":52876,"_2810":52986},[],"Choose the engine that will keep the key.",{"_3322":1850,"_29027":1815,"_20151":52988,"_5":13779,"_26422":52876,"_2810":52989},[],"Define a validity longer than that of the certificates it will issue.",{"_3322":1851,"_29027":1815,"_20151":52991,"_5":13779,"_26422":52876,"_2810":52992},[],"For an intermediate CA, make sure the parent CA is active.",{"_3322":1852,"_29027":1815,"_20151":52994,"_5":13779,"_26422":52879,"_2810":52995},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3322":1853,"_29027":1815,"_20151":52997,"_5":13779,"_26422":52883,"_2810":52998},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3322":1854,"_29027":1815,"_20151":53000,"_5":13779,"_26422":52883,"_2810":53001},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3322":1855,"_29027":1815,"_20151":53003,"_5":13779,"_26422":52887,"_2810":53004},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3322":1856,"_29027":1815,"_20151":53006,"_5":13779,"_26422":52891,"_2810":53007},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3322":1857,"_29027":1815,"_20151":53009,"_5":13779,"_26422":52891,"_2810":53010},[],"`C`: two-letter ISO 3166-1 country code.",{"_3322":1858,"_29027":1815,"_20151":53012,"_5":13779,"_26422":52891,"_2810":53013},[],"`ST`: state or province.",{"_3322":1859,"_29027":1815,"_20151":53015,"_5":13779,"_26422":52891,"_2810":53016},[],"`L`: locality.",{"_3322":1860,"_29027":1815,"_20151":53018,"_5":13779,"_26422":52891,"_2810":53019},[],"`O`: organization.",{"_3322":1861,"_29027":1815,"_20151":53021,"_5":13779,"_26422":52891,"_2810":53022},[],"`OU`: organizational unit.",{"_3322":1862,"_29027":1815,"_20151":53024,"_5":13779,"_26422":52891,"_2810":53025},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3322":1863,"_29027":1815,"_20151":53027,"_5":13779,"_26422":52895,"_2810":53028},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3322":1864,"_29027":1815,"_20151":53030,"_5":13779,"_26422":52895,"_2810":53031},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3322":1865,"_29027":1815,"_20151":53033,"_5":13779,"_26422":52899,"_2810":53034},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3322":1866,"_29027":1815,"_20151":53036,"_5":13779,"_26422":52899,"_2810":53037},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3322":1867,"_29027":1815,"_20151":53039,"_5":13779,"_26422":52903,"_2810":53040},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3322":1868,"_29027":1815,"_20151":53042,"_5":13779,"_26422":52903,"_2810":53043},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3322":1869,"_29027":1815,"_20151":53045,"_5":13779,"_26422":52907,"_2810":53046},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3322":1870,"_29027":1815,"_20151":53048,"_5":13779,"_26422":52911,"_2810":53049},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3322":1871,"_29027":1815,"_20151":53051,"_5":13779,"_26422":52915,"_2810":53052},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3322":1872,"_29027":1815,"_20151":53054,"_5":13779,"_26422":52919,"_2810":53055},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3322":1873,"_29027":1815,"_20151":53057,"_5":13779,"_26422":52923,"_2810":53058},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3322":1874,"_29027":1815,"_20151":53060,"_5":13779,"_26422":52923,"_2810":53061},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3322":1875,"_29027":1815,"_20151":53063,"_5":13779,"_26422":52927,"_2810":53064},[],"Open a CA from the inventory to review:",{"_3322":1876,"_29027":1815,"_20151":53066,"_5":13779,"_26422":52927,"_2810":53067},[],"Status and validity period.",{"_3322":1877,"_29027":1815,"_20151":53069,"_5":13779,"_26422":52927,"_2810":53070},[],"Certificate and chain in PEM format.",{"_3322":1878,"_29027":1815,"_20151":53072,"_5":13779,"_26422":52927,"_2810":53073},[],"Number of active, expired and revoked certificates.",{"_3322":1879,"_29027":1815,"_20151":53075,"_5":13779,"_26422":52927,"_2810":53076},[],"Certificates issued in **Issued Certificates**.",{"_3322":1880,"_29027":1815,"_20151":53078,"_5":13779,"_26422":52927,"_2810":53079},[],"The CRL linked to the authority.",{"_3322":1881,"_29027":1815,"_20151":53081,"_5":13779,"_26422":52927,"_2810":53082},[],"Metadata and the associated cryptographic engine.",{"_3322":1882,"_29027":1815,"_20151":53084,"_5":13779,"_26422":52927,"_2810":53085},[],"You can filter the inventory by name, status and CA type.",{"_3322":1883,"_29027":1815,"_20151":53087,"_5":13779,"_26422":52931,"_2810":53088},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3322":1884,"_29027":1815,"_20151":53090,"_5":13779,"_26422":52931,"_2810":53091},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3322":1885,"_29027":1815,"_20151":53093,"_5":13779,"_26422":52931,"_2810":53094},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3322":1886,"_29027":1815,"_20151":53096,"_5":13779,"_26422":52931,"_2810":53097},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3322":1887,"_29027":1815,"_20151":53099,"_5":13779,"_26422":52935,"_2810":53100},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3322":1888,"_29027":1815,"_20151":53102,"_5":13779,"_26422":52939,"_2810":53103},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3322":1889,"_29027":1815,"_20151":53105,"_5":13779,"_26422":52943,"_2810":53106},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3322":1890,"_29027":1815,"_20151":53108,"_5":13779,"_26422":52947,"_2810":53109},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3322":1891,"_29027":1815,"_20151":53111,"_5":13779,"_26422":52951,"_2810":53112},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3322":1892,"_29027":1815,"_20151":53114,"_5":13779,"_26422":52955,"_2810":53115},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3322":1893,"_29027":1815,"_20151":53117,"_5":13779,"_26422":52955,"_2810":53118},[],"The CA’s VA role is kept. If no other CA with the same SKI remains, it can no longer be edited (see CRL), so adjust its validity and signer beforehand. The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3322":1894,"_29027":1815,"_20151":53120,"_5":13779,"_26422":52955,"_2810":53121},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. If the new certificate uses the same key, it shares the SKI with the retained VA role of the deleted CA, whose signer is the old certificate: check that the CRL is generated and, if it is not, use `PUT` to set a signer of the new CA (see CRL).",{"_3322":1895,"_29027":1895,"_5":14137,"_2810":53123,"_29350":53124,"_20151":53125,"_26422":1895},"Certificate profiles",[47245,48694,52700,52701],[],{"_3322":1896,"_29027":1895,"_20151":53127,"_5":13779,"_26422":1895,"_2810":53128},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3322":1897,"_29027":1895,"_5":29347,"_20151":53130,"_26422":53131,"_2810":53132},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3322":1898,"_29027":1895,"_5":29347,"_20151":53134,"_26422":53135,"_2810":53136},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3322":1899,"_29027":1895,"_5":29347,"_20151":53138,"_26422":53139,"_2810":53140},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3322":1900,"_29027":1895,"_5":29347,"_20151":53142,"_26422":53143,"_2810":53144},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3322":1901,"_29027":1895,"_5":29347,"_20151":53146,"_26422":53147,"_2810":53148},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3322":1902,"_29027":1895,"_5":29347,"_20151":53150,"_26422":53151,"_2810":53152},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3322":1903,"_29027":1895,"_5":29347,"_20151":53154,"_26422":53155,"_2810":53156},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3322":1904,"_29027":1895,"_5":29347,"_20151":53158,"_26422":53159,"_2810":53160},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3322":1905,"_29027":1895,"_5":29347,"_20151":53162,"_26422":53163,"_2810":53164},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3322":1906,"_29027":1895,"_5":29347,"_20151":53166,"_26422":53167,"_2810":53168},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3322":1907,"_29027":1895,"_5":29347,"_20151":53170,"_26422":53171,"_2810":53172},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3322":1908,"_29027":1895,"_5":29347,"_20151":53174,"_26422":53175,"_2810":53176},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3322":1909,"_29027":1895,"_5":29347,"_20151":53178,"_26422":53179,"_2810":53180},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3322":1910,"_29027":1895,"_5":29347,"_20151":53182,"_26422":53183,"_2810":53184},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3322":1911,"_29027":1895,"_5":29347,"_20151":53186,"_26422":53187,"_2810":53188},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3322":1912,"_29027":1895,"_5":29347,"_20151":53190,"_26422":53191,"_2810":53192},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3322":1913,"_29027":1895,"_20151":53194,"_5":13779,"_26422":1895,"_2810":53195},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3322":1914,"_29027":1895,"_20151":53197,"_5":13779,"_26422":1895,"_2810":53198},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3322":1915,"_29027":1895,"_20151":53200,"_5":13779,"_26422":53135,"_2810":53201},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3322":1916,"_29027":1895,"_20151":53203,"_5":13779,"_26422":53135,"_2810":53204},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3322":1917,"_29027":1895,"_20151":53206,"_5":13779,"_26422":53139,"_2810":53207},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Enable it only in profiles intended to create or reissue subordinate CAs.",{"_3322":1918,"_29027":1895,"_20151":53209,"_5":13779,"_26422":53143,"_2810":53210},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3322":1919,"_29027":1895,"_20151":53212,"_5":13779,"_26422":53143,"_2810":53213},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3322":1920,"_29027":1895,"_20151":53215,"_5":13779,"_26422":53143,"_2810":53216},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3322":1921,"_29027":1895,"_20151":53218,"_5":13779,"_26422":53147,"_2810":53219},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3322":1922,"_29027":1895,"_20151":53221,"_5":13779,"_26422":53151,"_2810":53222},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3322":1923,"_29027":1895,"_20151":53224,"_5":13779,"_26422":53151,"_2810":53225},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3322":1924,"_29027":1895,"_20151":53227,"_5":13779,"_26422":53155,"_2810":53228},[],"The cryptographic enforcement can:",{"_3322":1925,"_29027":1895,"_20151":53230,"_5":13779,"_26422":53155,"_2810":53231},[],"allow or block RSA keys;",{"_3322":1926,"_29027":1895,"_20151":53233,"_5":13779,"_26422":53155,"_2810":53234},[],"limit the supported RSA sizes;",{"_3322":1927,"_29027":1895,"_20151":53236,"_5":13779,"_26422":53155,"_2810":53237},[],"allow or block ECDSA keys;",{"_3322":1928,"_29027":1895,"_20151":53239,"_5":13779,"_26422":53155,"_2810":53240},[],"limit the supported ECDSA sizes or curves.",{"_3322":1929,"_29027":1895,"_20151":53242,"_5":13779,"_26422":53155,"_2810":53243},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3322":1930,"_29027":1895,"_20151":53245,"_5":13779,"_26422":53159,"_2810":53246},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3322":1931,"_29027":1895,"_20151":53248,"_5":13779,"_26422":53159,"_2810":50455},[],{"_3322":1932,"_29027":1895,"_20151":53250,"_5":13779,"_26422":53159,"_2810":53251},[],"First choice",{"_3322":1933,"_29027":1895,"_20151":53253,"_5":13779,"_26422":53159,"_2810":53254},[],"Second choice",{"_3322":1934,"_29027":1895,"_20151":53256,"_5":13779,"_26422":53159,"_2810":53257},[],"If neither is supplied",{"_3322":1935,"_29027":1895,"_20151":53259,"_5":13779,"_26422":53159,"_2810":53260},[],"Direct signing with a CA",{"_3322":1936,"_29027":1895,"_20151":53262,"_5":13779,"_26422":53159,"_2810":53263},[],"`issuance_profile` embedded in the request",{"_3322":1937,"_29027":1895,"_20151":53265,"_5":13779,"_26422":53159,"_2810":53266},[],"Request `issuance_profile_id`",{"_3322":1938,"_29027":1895,"_20151":53268,"_5":13779,"_26422":53159,"_2810":53269},[],"CA default profile (`profile_id`).",{"_3322":1939,"_29027":1895,"_20151":53271,"_5":13779,"_26422":53159,"_2810":53272},[],"Issuance through a DMS",{"_3322":1940,"_29027":1895,"_20151":53274,"_5":13779,"_26422":53159,"_2810":53275},[],"`settings.issuance_profile_id`",{"_3322":1941,"_29027":1895,"_20151":53277,"_5":13779,"_26422":53159,"_2810":53278},[],"`settings.issuance_profile` embedded in the DMS",{"_3322":1942,"_29027":1895,"_20151":53280,"_5":13779,"_26422":53159,"_2810":53281},[],"Enrollment CA default profile.",{"_3322":1943,"_29027":1895,"_20151":53283,"_5":13779,"_26422":53159,"_2810":53284},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3322":1944,"_29027":1895,"_20151":53286,"_5":13779,"_26422":53159,"_2810":53287},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3322":1945,"_29027":1895,"_20151":53289,"_5":13779,"_26422":53167,"_2810":53290},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3322":1946,"_29027":1895,"_20151":53292,"_5":13779,"_26422":53171,"_2810":53293},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3322":1947,"_29027":1895,"_20151":53295,"_5":13779,"_26422":53175,"_2810":53296},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3322":1948,"_29027":1895,"_20151":53298,"_5":13779,"_26422":53179,"_2810":53299},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3322":1949,"_29027":1895,"_20151":53301,"_5":13779,"_26422":53183,"_2810":53302},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3322":1950,"_29027":1895,"_20151":53304,"_5":13779,"_26422":53183,"_2810":53305},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3322":1951,"_29027":1895,"_20151":53307,"_5":13779,"_26422":53187,"_2810":53308},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3322":1952,"_29027":1895,"_20151":53310,"_5":13779,"_26422":53187,"_2810":53311},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3322":1953,"_29027":1895,"_20151":53313,"_5":13779,"_26422":53187,"_2810":53314},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3322":1954,"_29027":1895,"_20151":53316,"_5":13779,"_26422":53187,"_2810":53317},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3322":1955,"_29027":1895,"_20151":53319,"_5":13779,"_26422":53191,"_2810":53320},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3322":1956,"_29027":1895,"_20151":53322,"_5":13779,"_26422":53191,"_2810":53323},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3322":1957,"_29027":1957,"_5":14137,"_2810":53325,"_29350":53326,"_20151":53328,"_26422":1957},"Certificate validation",[47245,48694,52700,53327],"Validation",[],{"_3322":1958,"_29027":1957,"_20151":53330,"_5":13779,"_26422":1957,"_2810":53331},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3322":1959,"_29027":1957,"_5":29347,"_20151":53333,"_26422":53334,"_2810":53335},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3322":1960,"_29027":1957,"_5":29347,"_20151":53337,"_26422":53338,"_2810":53339},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3322":1961,"_29027":1957,"_5":29347,"_20151":53341,"_26422":53342,"_2810":53343},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3322":1962,"_29027":1957,"_20151":53345,"_5":13779,"_26422":1957,"_2810":53346},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3322":1963,"_29027":1957,"_20151":53348,"_5":13779,"_26422":53334,"_2810":53349},[],"Verify these criteria together:",{"_3322":1964,"_29027":1957,"_20151":53351,"_5":13779,"_26422":53334,"_2810":52326},[],{"_3322":1965,"_29027":1957,"_20151":53353,"_5":13779,"_26422":53334,"_2810":53354},[],"Required result",{"_3322":1966,"_29027":1957,"_20151":53356,"_5":13779,"_26422":53334,"_2810":53357},[],"Chain and signature",{"_3322":1967,"_29027":1957,"_20151":53359,"_5":13779,"_26422":53334,"_2810":53360},[],"Valid chain to a root deliberately installed in the consumer.",{"_3322":1968,"_29027":1957,"_20151":53362,"_5":13779,"_26422":53334,"_2810":53363},[],"Dates",{"_3322":1969,"_29027":1957,"_20151":53365,"_5":13779,"_26422":53334,"_2810":53366},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3322":1970,"_29027":1957,"_20151":53368,"_5":13779,"_26422":53334,"_2810":48363},[],{"_3322":1971,"_29027":1957,"_20151":53370,"_5":13779,"_26422":53334,"_2810":53371},[],"Name, SAN or identifier matches the expected peer.",{"_3322":1972,"_29027":1957,"_20151":53373,"_5":13779,"_26422":53334,"_2810":47635},[],{"_3322":1973,"_29027":1957,"_20151":53375,"_5":13779,"_26422":53334,"_2810":53376},[],"KU, EKU and constraints permit the specific operation.",{"_3322":1974,"_29027":1957,"_20151":53378,"_5":13779,"_26422":53334,"_2810":53379},[],"Revocation",{"_3322":1975,"_29027":1957,"_20151":53381,"_5":13779,"_26422":53334,"_2810":53382},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3322":1976,"_29027":1957,"_20151":53384,"_5":13779,"_26422":53334,"_2810":53385},[],"Authorization",{"_3322":1977,"_29027":1957,"_20151":53387,"_5":13779,"_26422":53334,"_2810":53388},[],"The application permits that identity to perform the action.",{"_3322":1978,"_29027":1957,"_20151":53390,"_5":13779,"_26422":53334,"_2810":53391},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3322":1979,"_29027":1957,"_20151":53393,"_5":13779,"_26422":53338,"_2810":53394},[],"Mechanism",{"_3322":1980,"_29027":1957,"_20151":53396,"_5":13779,"_26422":53338,"_2810":53397},[],"When to use it",{"_3322":1981,"_29027":1957,"_20151":53399,"_5":13779,"_26422":53338,"_2810":53400},[],"What you must maintain",{"_3322":1982,"_29027":1957,"_20151":53402,"_5":13779,"_26422":53338,"_2810":53403},[],"OCSP",{"_3322":1983,"_29027":1957,"_20151":53405,"_5":13779,"_26422":53338,"_2810":53406},[],"Status query for a specific certificate.",{"_3322":1984,"_29027":1957,"_20151":53408,"_5":13779,"_26422":53338,"_2810":53409},[],"Responder access, signature verification and cache/freshness policy.",{"_3322":1985,"_29027":1957,"_20151":53411,"_5":13779,"_26422":53338,"_2810":53412},[],"CRL",{"_3322":1986,"_29027":1957,"_20151":53414,"_5":13779,"_26422":53338,"_2810":53415},[],"Local checks for many certificates or offline operation.",{"_3322":1987,"_29027":1957,"_20151":53417,"_5":13779,"_26422":53338,"_2810":53418},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3322":1988,"_29027":1957,"_20151":53420,"_5":13779,"_26422":53338,"_2810":53421},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3322":1989,"_29027":1957,"_20151":53423,"_5":13779,"_26422":53338,"_2810":53424},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3322":1990,"_29027":1957,"_20151":53426,"_5":13779,"_26422":53342,"_2810":53427},[],"Accept a current, authorized certificate with a known chain.",{"_3322":1991,"_29027":1957,"_20151":53429,"_5":13779,"_26422":53342,"_2810":53430},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3322":1992,"_29027":1957,"_20151":53432,"_5":13779,"_26422":53342,"_2810":53433},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3322":1993,"_29027":1957,"_20151":53435,"_5":13779,"_26422":53342,"_2810":53436},[],"Check that a new connection with that identity is rejected.",{"_3322":1994,"_29027":1957,"_20151":53438,"_5":13779,"_26422":53342,"_2810":53439},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3322":1995,"_29027":1957,"_20151":53441,"_5":13779,"_26422":53342,"_2810":53442},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3322":1996,"_29027":1957,"_20151":53444,"_5":13779,"_26422":53342,"_2810":53445},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3322":1997,"_29027":1957,"_20151":53447,"_5":13779,"_26422":53342,"_2810":53448},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3322":1998,"_29027":1957,"_20151":53450,"_5":13779,"_26422":53342,"_2810":53451},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3322":1999,"_29027":1999,"_5":14137,"_2810":53453,"_29350":53454,"_20151":53455,"_26422":1999},"Certificates",[47245,48694,52700,52701],[],{"_3322":2000,"_29027":1999,"_20151":53457,"_5":13779,"_26422":1999,"_2810":53458},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3322":2001,"_29027":1999,"_5":29347,"_20151":53460,"_26422":53461,"_2810":53462},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3322":2002,"_29027":1999,"_5":29347,"_20151":53464,"_26422":53465,"_2810":53466},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3322":2003,"_29027":1999,"_5":29347,"_20151":53468,"_26422":53469,"_2810":53470},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3322":2004,"_29027":1999,"_5":29347,"_20151":53472,"_26422":53473,"_2810":53474},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3322":2005,"_29027":1999,"_5":29347,"_20151":53476,"_26422":53477,"_2810":53478},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3322":2006,"_29027":1999,"_5":29347,"_20151":53480,"_26422":53481,"_2810":53482},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3322":2007,"_29027":1999,"_5":29347,"_20151":53484,"_26422":53485,"_2810":53486},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3322":2008,"_29027":1999,"_5":29347,"_20151":53488,"_26422":53489,"_2810":53490},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3322":2009,"_29027":1999,"_5":29347,"_20151":53492,"_26422":53493,"_2810":53494},[],"/docs/platform/pki/certificates#continue","Continue",{"_3322":2010,"_29027":1999,"_20151":53496,"_5":13779,"_26422":1999,"_2810":53497},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3322":2011,"_29027":1999,"_20151":53499,"_5":13779,"_26422":53461,"_2810":53500},[],"Filter by `Common Name`, serial, status and issuer. Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3322":2012,"_29027":1999,"_20151":53502,"_5":13779,"_26422":53461,"_2810":53503},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3322":2013,"_29027":1999,"_20151":53505,"_5":13779,"_26422":53465,"_2810":53506},[],"Download the PEM and inspect it:",{"_3322":2014,"_29027":1999,"_20151":53508,"_5":13779,"_26422":53465,"_2810":53509},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3322":2015,"_29027":1999,"_20151":53511,"_5":13779,"_26422":53469,"_2810":53512},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3322":2016,"_29027":1999,"_20151":53514,"_5":13779,"_26422":53469,"_2810":53515},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3322":2017,"_29027":1999,"_20151":53517,"_5":13779,"_26422":53469,"_2810":53518},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3322":2018,"_29027":1999,"_20151":53520,"_5":13779,"_26422":53469,"_2810":53521},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3322":2019,"_29027":1999,"_20151":53523,"_5":13779,"_26422":53469,"_2810":53524},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3322":2020,"_29027":1999,"_20151":53526,"_5":13779,"_26422":53469,"_2810":53527},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3322":2021,"_29027":1999,"_20151":53529,"_5":13779,"_26422":53469,"_2810":53530},[],"For browser key generation, follow Issue your first certificate.",{"_3322":2022,"_29027":1999,"_20151":53532,"_5":13779,"_26422":53473,"_2810":53533},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3322":2023,"_29027":1999,"_20151":53535,"_5":13779,"_26422":53477,"_2810":53536},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3322":2024,"_29027":1999,"_20151":53538,"_5":13779,"_26422":53481,"_2810":53539},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3322":2025,"_29027":1999,"_20151":53541,"_5":13779,"_26422":53485,"_2810":53542},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3322":2026,"_29027":1999,"_20151":53544,"_5":13779,"_26422":53485,"_2810":53545},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3322":2027,"_29027":1999,"_20151":53547,"_5":13779,"_26422":53485,"_2810":53548},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3322":2028,"_29027":1999,"_20151":53550,"_5":13779,"_26422":53489,"_2810":53551},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3322":2029,"_29027":1999,"_20151":53553,"_5":13779,"_26422":53489,"_2810":53554},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3322":2030,"_29027":1999,"_20151":53556,"_5":13779,"_26422":53489,"_2810":53557},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3322":2031,"_29027":1999,"_20151":53559,"_5":13779,"_26422":53493,"_2810":53560},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3322":2032,"_29027":1999,"_20151":53562,"_5":13779,"_26422":53493,"_2810":53563},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3322":2033,"_29027":2033,"_5":14137,"_2810":53565,"_29350":53566,"_20151":53568,"_26422":2033},"Certificate lifecycle",[47245,48694,52700,53567],"Concepts",[],{"_3322":2034,"_29027":2033,"_20151":53570,"_5":13779,"_26422":2033,"_2810":53571},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3322":2035,"_29027":2033,"_5":29347,"_20151":53573,"_26422":53574,"_2810":53575},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3322":2036,"_29027":2033,"_5":29347,"_20151":53577,"_26422":53578,"_2810":53579},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3322":2037,"_29027":2033,"_5":29347,"_20151":53581,"_26422":53582,"_2810":53583},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3322":2038,"_29027":2033,"_5":29347,"_20151":53585,"_26422":53586,"_2810":53587},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3322":2039,"_29027":2033,"_5":29347,"_20151":53589,"_26422":53590,"_2810":53591},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3322":2040,"_29027":2033,"_5":29347,"_20151":53593,"_26422":53594,"_2810":53595},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3322":2041,"_29027":2033,"_5":29347,"_20151":53597,"_26422":53598,"_2810":53599},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3322":2042,"_29027":2033,"_5":29347,"_20151":53601,"_26422":53602,"_2810":53603},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3322":2043,"_29027":2033,"_5":29347,"_20151":53605,"_26422":53606,"_2810":53607},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3322":2044,"_29027":2033,"_5":29347,"_20151":53609,"_26422":53610,"_2810":53611},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3322":2045,"_29027":2033,"_20151":53613,"_5":13779,"_26422":2033,"_2810":53614},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3322":2046,"_29027":2033,"_20151":53616,"_5":13779,"_26422":53578,"_2810":53617},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3322":2047,"_29027":2033,"_20151":53619,"_5":13779,"_26422":53582,"_2810":53620},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3322":2048,"_29027":2033,"_20151":53622,"_5":13779,"_26422":53586,"_2810":53623},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3322":2049,"_29027":2033,"_20151":53625,"_5":13779,"_26422":53590,"_2810":53626},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3322":2050,"_29027":2033,"_20151":53628,"_5":13779,"_26422":53594,"_2810":53629},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3322":2051,"_29027":2033,"_20151":53631,"_5":13779,"_26422":53598,"_2810":53632},[],"Lamassu persists four X.509 states:",{"_3322":2052,"_29027":2033,"_20151":53634,"_5":13779,"_26422":53598,"_2810":53635},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3322":2053,"_29027":2033,"_20151":53637,"_5":13779,"_26422":53598,"_2810":53638},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3322":2054,"_29027":2033,"_20151":53640,"_5":13779,"_26422":53598,"_2810":53641},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3322":2055,"_29027":2033,"_20151":53643,"_5":13779,"_26422":53598,"_2810":53644},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3322":2056,"_29027":2033,"_20151":53646,"_5":13779,"_26422":53598,"_2810":53647},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3322":2057,"_29027":2033,"_20151":53649,"_5":13779,"_26422":53602,"_2810":53650},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3322":2058,"_29027":2033,"_20151":53652,"_5":13779,"_26422":53602,"_2810":53653},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3322":2059,"_29027":2033,"_20151":53655,"_5":13779,"_26422":53602,"_2810":53656},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3322":2060,"_29027":2033,"_20151":53658,"_5":13779,"_26422":53606,"_2810":53659},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3322":2061,"_29027":2033,"_20151":53661,"_5":13779,"_26422":53606,"_2810":53662},[],"Before confirming:",{"_3322":2062,"_29027":2033,"_20151":53664,"_5":13779,"_26422":53606,"_2810":53665},[],"Identify DMSs, devices and services that trust that chain.",{"_3322":2063,"_29027":2033,"_20151":53667,"_5":13779,"_26422":53606,"_2810":53668},[],"Distribute the new chain of trust.",{"_3322":2064,"_29027":2033,"_20151":53670,"_5":13779,"_26422":53606,"_2810":53671},[],"Reissue the necessary identities.",{"_3322":2065,"_29027":2033,"_20151":53673,"_5":13779,"_26422":53606,"_2810":53674},[],"Check OCSP and CRL from a real consumer.",{"_3322":2066,"_29027":2033,"_20151":53676,"_5":13779,"_26422":53606,"_2810":53677},[],"Revoke the old CA once no legitimate traffic remains.",{"_3322":2067,"_29027":2033,"_20151":53679,"_5":13779,"_26422":53606,"_2810":53680},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3322":2068,"_29027":2033,"_20151":53682,"_5":13779,"_26422":53610,"_2810":53683},[],"Certificates entering the preventive or critical renewal window.",{"_3322":2069,"_29027":2033,"_20151":53685,"_5":13779,"_26422":53610,"_2810":53686},[],"Repeated enrollment or re-enrollment failures.",{"_3322":2070,"_29027":2033,"_20151":53688,"_5":13779,"_26422":53610,"_2810":53689},[],"Status changes and revocation reasons.",{"_3322":2071,"_29027":2033,"_20151":53691,"_5":13779,"_26422":53610,"_2810":53692},[],"OCSP and CRL publication and validity.",{"_3322":2072,"_29027":2033,"_20151":53694,"_5":13779,"_26422":53610,"_2810":53695},[],"Dependencies still presenting a replaced certificate.",{"_3322":2073,"_29027":2033,"_20151":53697,"_5":13779,"_26422":53610,"_2810":53698},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3322":2074,"_29027":2074,"_5":14137,"_2810":53700,"_29350":53701,"_20151":53702,"_26422":2074},"Trust model",[47245,48694,52700,53567],[],{"_3322":2075,"_29027":2074,"_20151":53704,"_5":13779,"_26422":2074,"_2810":53705},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3322":2076,"_29027":2074,"_5":29347,"_20151":53707,"_26422":53708,"_2810":53709},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3322":2077,"_29027":2074,"_5":29347,"_20151":53711,"_26422":53712,"_2810":53713},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3322":2078,"_29027":2074,"_5":29347,"_20151":53715,"_26422":53716,"_2810":53717},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3322":2079,"_29027":2074,"_5":29347,"_20151":53719,"_26422":53720,"_2810":53721},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3322":2080,"_29027":2074,"_5":29347,"_20151":53723,"_26422":53724,"_2810":53725},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3322":2081,"_29027":2074,"_5":29347,"_20151":53727,"_26422":53728,"_2810":53729},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3322":2082,"_29027":2074,"_5":29347,"_20151":53731,"_26422":53732,"_2810":53733},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3322":2083,"_29027":2074,"_5":29347,"_20151":53735,"_26422":53736,"_2810":53737},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3322":2084,"_29027":2074,"_5":29347,"_20151":53739,"_26422":53740,"_2810":53741},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3322":2085,"_29027":2074,"_5":29347,"_20151":53743,"_26422":53744,"_2810":53745},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3322":2086,"_29027":2074,"_20151":53747,"_5":13779,"_26422":2074,"_2810":53748},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3322":2087,"_29027":2074,"_20151":53750,"_5":13779,"_26422":53712,"_2810":53751},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3322":2088,"_29027":2074,"_20151":53753,"_5":13779,"_26422":53716,"_2810":53754},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3322":2089,"_29027":2074,"_20151":53756,"_5":13779,"_26422":53720,"_2810":53757},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3322":2090,"_29027":2074,"_20151":53759,"_5":13779,"_26422":53724,"_2810":53760},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3322":2091,"_29027":2074,"_20151":53762,"_5":13779,"_26422":53728,"_2810":53763},[],"The device proves it can enroll according to the DMS policy.",{"_3322":2092,"_29027":2074,"_20151":53765,"_5":13779,"_26422":53728,"_2810":53766},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3322":2093,"_29027":2074,"_20151":53768,"_5":13779,"_26422":53728,"_2810":53769},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3322":2094,"_29027":2074,"_20151":53771,"_5":13779,"_26422":53728,"_2810":53772},[],"The device installs the certificate and the chain it needs.",{"_3322":2095,"_29027":2074,"_20151":53774,"_5":13779,"_26422":53728,"_2810":53775},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3322":2096,"_29027":2074,"_20151":53777,"_5":13779,"_26422":53728,"_2810":53778},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3322":2097,"_29027":2074,"_20151":53780,"_5":13779,"_26422":53732,"_2810":53781},[],"A DMS relates three sets that are worth designing separately:",{"_3322":2098,"_29027":2074,"_20151":53783,"_5":13779,"_26422":53732,"_2810":53784},[],"**Enrollment CA:** signs the new identities.",{"_3322":2099,"_29027":2074,"_20151":53786,"_5":13779,"_26422":53732,"_2810":53787},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3322":2100,"_29027":2074,"_20151":53789,"_5":13779,"_26422":53732,"_2810":53790},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3322":2101,"_29027":2074,"_20151":53792,"_5":13779,"_26422":53732,"_2810":53793},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3322":2102,"_29027":2074,"_20151":53795,"_5":13779,"_26422":53736,"_2810":53796},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3322":2103,"_29027":2074,"_20151":53798,"_5":13779,"_26422":53736,"_2810":53799},[],"that the current date is between `Not Before` and `Not After`;",{"_3322":2104,"_29027":2074,"_20151":53801,"_5":13779,"_26422":53736,"_2810":53802},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3322":2105,"_29027":2074,"_20151":53804,"_5":13779,"_26422":53736,"_2810":53805},[],"that names, SANs and subject match the expected identity;",{"_3322":2106,"_29027":2074,"_20151":53807,"_5":13779,"_26422":53736,"_2810":53808},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3322":2107,"_29027":2074,"_20151":53810,"_5":13779,"_26422":53736,"_2810":53811},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3322":2108,"_29027":2074,"_20151":53813,"_5":13779,"_26422":53736,"_2810":53814},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3322":2109,"_29027":2074,"_20151":53816,"_5":13779,"_26422":53740,"_2810":53817},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3322":2110,"_29027":2074,"_20151":53819,"_5":13779,"_26422":53744,"_2810":53820},[],"Keep the root out of daily operations, or with very restricted access.",{"_3322":2111,"_29027":2074,"_20151":53822,"_5":13779,"_26422":53744,"_2810":53823},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3322":2112,"_29027":2074,"_20151":53825,"_5":13779,"_26422":53744,"_2810":53826},[],"Assign explicit profiles to every use case.",{"_3322":2113,"_29027":2074,"_20151":53828,"_5":13779,"_26422":53744,"_2810":53829},[],"Distribute the new trust before starting a rotation.",{"_3322":2114,"_29027":2074,"_20151":53831,"_5":13779,"_26422":53744,"_2810":53832},[],"Keep enough overlap to renew a disconnected fleet.",{"_3322":2115,"_29027":2074,"_20151":53834,"_5":13779,"_26422":53744,"_2810":53835},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3322":2116,"_29027":2074,"_20151":53837,"_5":13779,"_26422":53744,"_2810":53838},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3322":2117,"_29027":2117,"_5":14137,"_2810":53840,"_29350":53841,"_20151":53842,"_26422":2117},"Revocation lists (CRL)",[47245,48694,52700,53327],[],{"_3322":2118,"_29027":2117,"_20151":53844,"_5":13779,"_26422":2117,"_2810":53845},[],"Generate and distribute signed lists to validate certificates offline.",{"_3322":2119,"_29027":2117,"_5":29347,"_20151":53847,"_26422":53848,"_2810":53849},[],"/docs/platform/pki/crl#va-role-and-per-ca-configuration","VA role and per-CA configuration",{"_3322":2120,"_29027":2117,"_5":29347,"_20151":53851,"_26422":53852,"_2810":53853},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3322":2121,"_29027":2117,"_5":29347,"_20151":53855,"_26422":53856,"_2810":53857},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3322":2122,"_29027":2117,"_5":29347,"_20151":53859,"_26422":53860,"_2810":53861},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3322":2123,"_29027":2117,"_5":29347,"_20151":53863,"_26422":53864,"_2810":53865},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3322":2124,"_29027":2117,"_5":29347,"_20151":53867,"_26422":53868,"_2810":53869},[],"/docs/platform/pki/crl#va-role-management-api","VA role management API",{"_3322":2125,"_29027":2117,"_5":29347,"_20151":53871,"_26422":53872,"_2810":53873},[],"/docs/platform/pki/crl#common-va-role-errors","Common VA role errors",{"_3322":2126,"_29027":2117,"_5":29347,"_20151":53875,"_26422":53876,"_2810":53877},[],"/docs/platform/pki/crl#from-the-interface","From the interface",{"_3322":2127,"_29027":2117,"_5":29347,"_20151":53879,"_26422":53880,"_2810":53881},[],"/docs/platform/pki/crl#references","References",{"_3322":2128,"_29027":2117,"_20151":53883,"_5":13779,"_26422":2117,"_2810":53884},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its SKI and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3322":2129,"_29027":2117,"_20151":53886,"_5":13779,"_26422":53848,"_2810":53887},[],"The VA role stores configuration and metadata for the latest list published for a CA’s SKI. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3322":2130,"_29027":2117,"_20151":53889,"_5":13779,"_26422":53848,"_2810":53890},[],"`crl_options` field",{"_3322":2131,"_29027":2117,"_20151":53892,"_5":13779,"_26422":53848,"_2810":47635},[],{"_3322":2132,"_29027":2117,"_20151":53894,"_5":13779,"_26422":53848,"_2810":53895},[],"Backend initial value",{"_3322":2133,"_29027":2117,"_20151":53897,"_5":13779,"_26422":53848,"_2810":53898},[],"`validity`",{"_3322":2134,"_29027":2117,"_20151":53900,"_5":13779,"_26422":53848,"_2810":53901},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3322":2135,"_29027":2117,"_20151":53903,"_5":13779,"_26422":53848,"_2810":53904},[],"7 days.",{"_3322":2136,"_29027":2117,"_20151":53906,"_5":13779,"_26422":53848,"_2810":53907},[],"`refresh_interval`",{"_3322":2137,"_29027":2117,"_20151":53909,"_5":13779,"_26422":53848,"_2810":53910},[],"Stored and returned by the API, but the VA does not use it: scheduled renewal does not depend on it (see Periodic and automatic regeneration).",{"_3322":2138,"_29027":2117,"_20151":53912,"_5":13779,"_26422":53848,"_2810":53913},[],"6 days and 23 hours.",{"_3322":2139,"_29027":2117,"_20151":53915,"_5":13779,"_26422":53848,"_2810":53916},[],"`regenerate_on_revoke`",{"_3322":2140,"_29027":2117,"_20151":53918,"_5":13779,"_26422":53848,"_2810":53919},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3322":2141,"_29027":2117,"_20151":53921,"_5":13779,"_26422":53848,"_2810":53922},[],"`true`.",{"_3322":2142,"_29027":2117,"_20151":53924,"_5":13779,"_26422":53848,"_2810":53925},[],"`signer_certificate_serial_number`",{"_3322":2143,"_29027":2117,"_20151":53927,"_5":13779,"_26422":53848,"_2810":53928},[],"Serial number of the existing certificate that signs the CRL.",{"_3322":2144,"_29027":2117,"_20151":53930,"_5":13779,"_26422":53848,"_2810":53931},[],"Serial number of the CA’s current certificate.",{"_3322":2145,"_29027":2117,"_20151":53933,"_5":13779,"_26422":53848,"_2810":53934},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3322":2146,"_29027":2117,"_20151":53936,"_5":13779,"_26422":53848,"_2810":53937},[],"When a CA is reissued, the role keeps pointing at the previous certificate. CRLs remain valid because both certificates share subject and key, but the previous certificate cannot be deleted while the role uses it. To retire it, update the role’s signer.",{"_3322":2147,"_29027":2117,"_20151":53939,"_5":13779,"_26422":53848,"_2810":53940},[],"When a CA is deleted, its VA role is kept and cannot be removed through the API. If no other CA with the same SKI remains, the role can be read but any `PUT` returns 404, and the renewal job logs a warning on every cycle because it no longer finds the CA. The API offers no way out; it can only be fixed by editing the database. If another CA with that SKI remains, the role is still editable (see CAs that share a key). Adjust validity and signer before deleting the CA.",{"_3322":2148,"_29027":2117,"_20151":53942,"_5":13779,"_26422":53848,"_2810":53943},[],"A CA whose certificate lacks `cRLSign` cannot generate its CRL or edit its role (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and set it as the signer with `PUT`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages.",{"_3322":2149,"_29027":2117,"_20151":53945,"_5":13779,"_26422":53848,"_2810":53946},[],"`PUT` always validates the signer, even when the request does not change it. If the stored signer is no longer valid, no field of the role can be modified, not even the validity, until a valid one is set.",{"_3322":2150,"_29027":2117,"_20151":53948,"_5":13779,"_26422":53848,"_2810":53949},[],"`latest_crl` contains version, validity start and end. Versions are kept as PEM in object storage at `pki/va/crl/{subject_key_id}/{version}.crl`; the public endpoint returns DER.",{"_3322":2151,"_29027":2117,"_20151":53951,"_5":13779,"_26422":53852,"_2810":53952},[],"The VA identifies each CRL by the CA’s SKI, and the SKI is derived from its key. Two CAs with the same key have the same SKI and share a single VA role and a single CRL. This happens when a CA is created on an existing KMS key, or when a CA is imported whose certificate declares an SKI already in use. Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. The first CA creates the role and the others keep it.",{"_3322":2152,"_29027":2117,"_20151":53954,"_5":13779,"_26422":53852,"_2810":53955},[],"The certificates of all of them point to `/crl/{ski}`, but the published list has the first CA as issuer and only includes its revocations. A verifier compares the CRL issuer with the issuer of the certificate it validates (RFC 5280, §6.3.2) and rejects the list if they differ. Depending on its policy, the certificate is blocked (*hard-fail*) or accepted even though it is revoked (*soft-fail*). Revocations of the secondary CAs do not appear in any list.",{"_3322":2153,"_29027":2117,"_20151":53957,"_5":13779,"_26422":53852,"_2810":53958},[],"If the first CA is deleted, CRL generation for the remaining one fails because the configured signer no longer matches a CA with that name. Until the role’s signer is updated to a certificate of the remaining CA, the last published list keeps being served until it expires (7 days by default).",{"_3322":2154,"_29027":2117,"_20151":53960,"_5":13779,"_26422":53852,"_2810":53961},[],"To detect the problem, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued. A CA imported with an SKI already in use does not replace the existing one as CRL issuer, because the issuer is resolved from the role’s signer. However, its own certificates point to that same URL and its revocations are not published. Until Lamassu rejects these imports, restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same collision, so also avoid reusing keys across CAs. A per-CA CRL and the rejection of imports whose SKI collides with an existing CA are both proposed in lamassuiot#834, and neither is implemented yet.",{"_3322":2155,"_29027":2117,"_20151":53963,"_5":13779,"_26422":53856,"_2810":53964},[],"The VA scheduled job checks every role on each run and requests another list when the remaining validity of `latest_crl` is less than the interval between runs. The frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. `refresh_interval` plays no part. Keep `validity` well above the interval: with a shorter validity, the list is regenerated on every cycle.",{"_3322":2156,"_29027":2117,"_20151":53966,"_5":13779,"_26422":53856,"_2810":53967},[],"If generation fails (for example, because of a role without a CA or an invalid signer), the job logs the warning `something went wrong while calculating CRL for CA <ski>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3322":2157,"_29027":2117,"_20151":53969,"_5":13779,"_26422":53856,"_2810":53970},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if it fails (missing role, invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3322":2158,"_29027":2117,"_20151":53972,"_5":13779,"_26422":53856,"_2810":53973},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3322":2159,"_29027":2117,"_20151":53975,"_5":13779,"_26422":53860,"_2810":53976},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3322":2160,"_29027":2117,"_20151":53978,"_5":13779,"_26422":53860,"_2810":53979},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3322":2161,"_29027":2117,"_20151":53981,"_5":13779,"_26422":53864,"_2810":53982},[],"The VA service exposes `GET /crl/{subject_key_id}` without management authorization. Use the **issuing CA’s** SKI, not the end-entity certificate’s SKI or serial. First inspect the certificate’s CDP:",{"_3322":2162,"_29027":2117,"_20151":53984,"_5":13779,"_26422":53864,"_2810":53985},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3322":2163,"_29027":2117,"_20151":53987,"_5":13779,"_26422":53864,"_2810":53988},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3322":2164,"_29027":2117,"_20151":53990,"_5":13779,"_26422":53864,"_2810":53991},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3322":2165,"_29027":2117,"_20151":53993,"_5":13779,"_26422":53864,"_2810":53994},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3322":2166,"_29027":2117,"_20151":53996,"_5":13779,"_26422":53868,"_2810":53997},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3322":2167,"_29027":2117,"_20151":53999,"_5":13779,"_26422":53868,"_2810":50458},[],{"_3322":2168,"_29027":2117,"_20151":54001,"_5":13779,"_26422":53868,"_2810":54002},[],"Relative path",{"_3322":2169,"_29027":2117,"_20151":54004,"_5":13779,"_26422":53868,"_2810":50455},[],{"_3322":2170,"_29027":2117,"_20151":54006,"_5":13779,"_26422":53868,"_2810":54007},[],"`GET`",{"_3322":2171,"_29027":2117,"_20151":54009,"_5":13779,"_26422":53868,"_2810":54010},[],"`/v1/roles/{ca-ski}`",{"_3322":2172,"_29027":2117,"_20151":54012,"_5":13779,"_26422":53868,"_2810":54013},[],"Read `crl_options` and `latest_crl`.",{"_3322":2173,"_29027":2117,"_20151":54015,"_5":13779,"_26422":53868,"_2810":54016},[],"`PUT`",{"_3322":2174,"_29027":2117,"_20151":54018,"_5":13779,"_26422":53868,"_2810":54010},[],{"_3322":2175,"_29027":2117,"_20151":54020,"_5":13779,"_26422":53868,"_2810":54021},[],"Replace CRL configuration.",{"_3322":2176,"_29027":2117,"_20151":54023,"_5":13779,"_26422":53868,"_2810":54024},[],"You need authentication and role read or update permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract: the backend replaces `crl_options`; it does not merge omitted fields.",{"_3322":2177,"_29027":2117,"_20151":54026,"_5":13779,"_26422":53868,"_2810":54027},[],"After a change, check saved configuration and the next list actually published. Updating the role alone does not establish regeneration or client acceptance.",{"_3322":2178,"_29027":2117,"_20151":54029,"_5":13779,"_26422":53872,"_2810":54030},[],"Symptom",{"_3322":2179,"_29027":2117,"_20151":54032,"_5":13779,"_26422":53872,"_2810":54033},[],"Cause",{"_3322":2180,"_29027":2117,"_20151":54035,"_5":13779,"_26422":53872,"_2810":54036},[],"Action",{"_3322":2181,"_29027":2117,"_20151":54038,"_5":13779,"_26422":53872,"_2810":54039},[],"`PUT /v1/roles/{ca-ski}` returns 404 and `GET` returns 200.",{"_3322":2182,"_29027":2117,"_20151":54041,"_5":13779,"_26422":53872,"_2810":54042},[],"The role’s CA was deleted and no other CA with the same SKI remains.",{"_3322":2183,"_29027":2117,"_20151":54044,"_5":13779,"_26422":53872,"_2810":54045},[],"There is no API way out; it requires database intervention. Avoid it by adjusting the role before deleting the CA.",{"_3322":2184,"_29027":2117,"_20151":54047,"_5":13779,"_26422":53872,"_2810":54048},[],"`PUT` returns 400.",{"_3322":2185,"_29027":2117,"_20151":54050,"_5":13779,"_26422":53872,"_2810":54051},[],"The signer lacks `cRLSign`, or its subject and key match no CA with that SKI (for example, after deleting the first of two CAs that share a key).",{"_3322":2186,"_29027":2117,"_20151":54053,"_5":13779,"_26422":53872,"_2810":54054},[],"Use `PUT` to set the serial number of a valid certificate of the remaining CA.",{"_3322":2187,"_29027":2117,"_20151":54056,"_5":13779,"_26422":53872,"_2810":54057},[],"`PUT` returns 400 from a 3.x client.",{"_3322":2188,"_29027":2117,"_20151":54059,"_5":13779,"_26422":53872,"_2810":54060},[],"`crl_options.subject_key_id_signer` was replaced by `signer_certificate_serial_number`, which is required.",{"_3322":2189,"_29027":2117,"_20151":54062,"_5":13779,"_26422":53872,"_2810":54063},[],"Update the client to send the new field.",{"_3322":2190,"_29027":2117,"_20151":54065,"_5":13779,"_26422":53872,"_2810":54066},[],"The CRL does not change after revoking a certificate.",{"_3322":2191,"_29027":2117,"_20151":54068,"_5":13779,"_26422":53872,"_2810":54069},[],"`regenerate_on_revoke` is `false`, or the event failed because of a missing role or an invalid signer.",{"_3322":2192,"_29027":2117,"_20151":54071,"_5":13779,"_26422":53872,"_2810":54072},[],"Check the VA logs and the failed-events queue; fix the signer.",{"_3322":2193,"_29027":2117,"_20151":54074,"_5":13779,"_26422":53872,"_2810":54075},[],"A verifier rejects the CRL because of the issuer.",{"_3322":2194,"_29027":2117,"_20151":54077,"_5":13779,"_26422":53872,"_2810":54078},[],"Several CAs share an SKI.",{"_3322":2195,"_29027":2117,"_20151":54080,"_5":13779,"_26422":53872,"_2810":54081},[],"See CAs that share a key.",{"_3322":2196,"_29027":2117,"_20151":54083,"_5":13779,"_26422":53876,"_2810":54084},[],"The CA view lets you inspect and download the available list. Compare version, issuer and timestamps with the copy downloaded from the public endpoint. Diagnose differences using PKI troubleshooting.",{"_3322":2197,"_29027":2117,"_20151":54086,"_5":13779,"_26422":53880,"_2810":54087},[],"RFC 5280: X.509 and CRL profile.",{"_3322":2198,"_29027":2117,"_20151":54089,"_5":13779,"_26422":53880,"_2810":54090},[],"OpenSSL: openssl-crl.",{"_3322":2199,"_29027":2117,"_20151":54092,"_5":13779,"_26422":53880,"_2810":54093},[],"OpenSSL: openssl-verify.",{"_3322":2200,"_29027":2117,"_20151":54095,"_5":13779,"_26422":53880,"_2810":54096},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3322":2201,"_29027":2117,"_20151":54098,"_5":13779,"_26422":53880,"_2810":54099},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3322":2202,"_29027":2202,"_5":14137,"_2810":54101,"_29350":54102,"_20151":54103,"_26422":2202},"Keys and cryptographic engines",[47245,48694,52700,52701],[],{"_3322":2203,"_29027":2202,"_20151":54105,"_5":13779,"_26422":2202,"_2810":54106},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3322":2204,"_29027":2202,"_5":29347,"_20151":54108,"_26422":54109,"_2810":54110},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3322":2205,"_29027":2202,"_5":29347,"_20151":54112,"_26422":54113,"_2810":54114},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3322":2206,"_29027":2202,"_5":29347,"_20151":54116,"_26422":54117,"_2810":54118},[],"/docs/platform/pki/key-management#file-system","File System",{"_3322":2207,"_29027":2202,"_5":29347,"_20151":54120,"_26422":54121,"_2810":54122},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3322":2208,"_29027":2202,"_5":29347,"_20151":54124,"_26422":54125,"_2810":54126},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3322":2209,"_29027":2202,"_5":29347,"_20151":54128,"_26422":54129,"_2810":54130},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3322":2210,"_29027":2202,"_5":29347,"_20151":54132,"_26422":54133,"_2810":54134},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3322":2211,"_29027":2202,"_5":29347,"_20151":54136,"_26422":54137,"_2810":54138},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3322":2212,"_29027":2202,"_5":29347,"_20151":54140,"_26422":54141,"_2810":54142},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3322":2213,"_29027":2202,"_5":29347,"_20151":54144,"_26422":54145,"_2810":54146},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3322":2214,"_29027":2202,"_5":29347,"_20151":54148,"_26422":54149,"_2810":54150},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3322":2215,"_29027":2202,"_5":29347,"_20151":54152,"_26422":54153,"_2810":54154},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3322":2216,"_29027":2202,"_5":29347,"_20151":54156,"_26422":54157,"_2810":54158},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3322":2217,"_29027":2202,"_5":29347,"_20151":54160,"_26422":54161,"_2810":54162},[],"/docs/platform/pki/key-management#view-details","View details",{"_3322":2218,"_29027":2202,"_5":29347,"_20151":54164,"_26422":54165,"_2810":54166},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3322":2219,"_29027":2202,"_5":29347,"_20151":54168,"_26422":54169,"_2810":54170},[],"/docs/platform/pki/key-management#sign","Sign",{"_3322":2220,"_29027":2202,"_5":29347,"_20151":54172,"_26422":54173,"_2810":54174},[],"/docs/platform/pki/key-management#verify","Verify",{"_3322":2221,"_29027":2202,"_5":29347,"_20151":54176,"_26422":54177,"_2810":54178},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3322":2222,"_29027":2202,"_5":29347,"_20151":54180,"_26422":54181,"_2810":54182},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3322":2223,"_29027":2202,"_5":29347,"_20151":54184,"_26422":54185,"_2810":54186},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3322":2224,"_29027":2202,"_20151":54188,"_5":13779,"_26422":2202,"_2810":54189},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3322":2225,"_29027":2202,"_20151":54191,"_5":13779,"_26422":2202,"_2810":54192},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3322":2226,"_29027":2202,"_20151":54194,"_5":13779,"_26422":54109,"_2810":54195},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3322":2227,"_29027":2202,"_20151":54197,"_5":13779,"_26422":54109,"_2810":54198},[],"In practice, it lets you:",{"_3322":2228,"_29027":2202,"_20151":54200,"_5":13779,"_26422":54109,"_2810":54201},[],"Generate new key pairs from Lamassu IoT.",{"_3322":2229,"_29027":2202,"_20151":54203,"_5":13779,"_26422":54109,"_2810":54204},[],"Import keys created externally.",{"_3322":2230,"_29027":2202,"_20151":54206,"_5":13779,"_26422":54109,"_2810":54207},[],"Delegate custody and cryptographic operations to external engines.",{"_3322":2231,"_29027":2202,"_20151":54209,"_5":13779,"_26422":54109,"_2810":54210},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3322":2232,"_29027":2202,"_20151":54212,"_5":13779,"_26422":54113,"_2810":54213},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3322":2233,"_29027":2202,"_20151":54215,"_5":13779,"_26422":54113,"_2810":54216},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3322":2234,"_29027":2202,"_20151":54218,"_5":13779,"_26422":54113,"_2810":54219},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3322":2235,"_29027":2202,"_20151":54221,"_5":13779,"_26422":54117,"_2810":54222},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3322":2236,"_29027":2202,"_20151":54224,"_5":13779,"_26422":54121,"_2810":54225},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3322":2237,"_29027":2202,"_20151":54227,"_5":13779,"_26422":54121,"_2810":54228},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3322":2238,"_29027":2202,"_20151":54230,"_5":13779,"_26422":54125,"_2810":54231},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3322":2239,"_29027":2202,"_20151":54233,"_5":13779,"_26422":54129,"_2810":54234},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3322":2240,"_29027":2202,"_20151":54236,"_5":13779,"_26422":54133,"_2810":54237},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3322":2241,"_29027":2202,"_20151":54239,"_5":13779,"_26422":54137,"_2810":54240},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3322":2242,"_29027":2202,"_20151":54242,"_5":13779,"_26422":54137,"_2810":54243},[],"Lamassu shows the enabled engines in the console.",{"_3322":2243,"_29027":2202,"_20151":54245,"_5":13779,"_26422":54137,"_2810":54246},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3322":2244,"_29027":2202,"_20151":54248,"_5":13779,"_26422":54137,"_2810":54249},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3322":2245,"_29027":2202,"_20151":54251,"_5":13779,"_26422":54141,"_2810":54252},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3322":2246,"_29027":2202,"_20151":54254,"_5":13779,"_26422":54141,"_2810":54255},[],"The table includes the following fields:",{"_3322":2247,"_29027":2202,"_20151":54257,"_5":13779,"_26422":54141,"_2810":54258},[],"**Name**: descriptive name of the key.",{"_3322":2248,"_29027":2202,"_20151":54260,"_5":13779,"_26422":54141,"_2810":54261},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3322":2249,"_29027":2202,"_20151":54263,"_5":13779,"_26422":54141,"_2810":54264},[],"**Strength**: visual indicator of cryptographic strength.",{"_3322":2250,"_29027":2202,"_20151":54266,"_5":13779,"_26422":54141,"_2810":54267},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3322":2251,"_29027":2202,"_20151":54269,"_5":13779,"_26422":54141,"_2810":54270},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3322":2252,"_29027":2202,"_20151":54272,"_5":13779,"_26422":54141,"_2810":54273},[],"**Aliases**: alternative names associated with the key.",{"_3322":2253,"_29027":2202,"_20151":54275,"_5":13779,"_26422":54141,"_2810":54276},[],"**Tags**: labels for classification and search.",{"_3322":2254,"_29027":2202,"_20151":54278,"_5":13779,"_26422":54141,"_2810":54279},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3322":2255,"_29027":2202,"_20151":54281,"_5":13779,"_26422":54141,"_2810":54282},[],"From this view you also reach the most common actions:",{"_3322":2256,"_29027":2202,"_20151":54284,"_5":13779,"_26422":54141,"_2810":54285},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3322":2257,"_29027":2202,"_20151":54287,"_5":13779,"_26422":54141,"_2810":54288},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3322":2258,"_29027":2202,"_20151":54290,"_5":13779,"_26422":54141,"_2810":54291},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3322":2259,"_29027":2202,"_20151":54293,"_5":13779,"_26422":54141,"_2810":54294},[],"**Delete Key** to remove the key from the system.",{"_3322":2260,"_29027":2202,"_20151":54296,"_5":13779,"_26422":54145,"_2810":54297},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3322":2261,"_29027":2202,"_20151":54299,"_5":13779,"_26422":54149,"_2810":54300},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3322":2262,"_29027":2202,"_20151":54302,"_5":13779,"_26422":54149,"_2810":54303},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3322":2263,"_29027":2202,"_20151":54305,"_5":13779,"_26422":54149,"_2810":54306},[],"**Key Name**: unique and descriptive name.",{"_3322":2264,"_29027":2202,"_20151":54308,"_5":13779,"_26422":54149,"_2810":54309},[],"**Crypto Engine**: engine that will keep the key.",{"_3322":2265,"_29027":2202,"_20151":54311,"_5":13779,"_26422":54149,"_2810":54312},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3322":2266,"_29027":2202,"_20151":54314,"_5":13779,"_26422":54149,"_2810":54315},[],"**Tags**: metadata to classify the key.",{"_3322":2267,"_29027":2202,"_20151":54317,"_5":13779,"_26422":54149,"_2810":54318},[],"**Metadata**: additional information for advanced uses.",{"_3322":2268,"_29027":2202,"_20151":54320,"_5":13779,"_26422":54153,"_2810":54321},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3322":2269,"_29027":2202,"_20151":54323,"_5":13779,"_26422":54153,"_2810":54324},[],"When you have an exportable private key and the destination engine supports import.",{"_3322":2270,"_29027":2202,"_20151":54326,"_5":13779,"_26422":54153,"_2810":54327},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3322":2271,"_29027":2202,"_20151":54329,"_5":13779,"_26422":54153,"_2810":54330},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3322":2272,"_29027":2202,"_20151":54332,"_5":13779,"_26422":54153,"_2810":54333},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3322":2273,"_29027":2202,"_20151":54335,"_5":13779,"_26422":54153,"_2810":54336},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3322":2274,"_29027":2202,"_20151":54338,"_5":13779,"_26422":54153,"_2810":54339},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3322":2275,"_29027":2202,"_20151":54341,"_5":13779,"_26422":54153,"_2810":54342},[],"**Tags**: labels for organization and search.",{"_3322":2276,"_29027":2202,"_20151":54344,"_5":13779,"_26422":54153,"_2810":54345},[],"**Metadata**: additional optional information.",{"_3322":2277,"_29027":2202,"_20151":54347,"_5":13779,"_26422":54153,"_2810":54348},[],"**Private Key (PEM)**: private key in PEM format.",{"_3322":2278,"_29027":2202,"_20151":54350,"_5":13779,"_26422":54153,"_2810":54351},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3322":2279,"_29027":2202,"_20151":54353,"_5":13779,"_26422":54157,"_2810":54354},[],"Each registered key has a detail view and several operational actions.",{"_3322":2280,"_29027":2202,"_20151":54356,"_5":13779,"_26422":54161,"_2810":54357},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3322":2281,"_29027":2202,"_20151":54359,"_5":13779,"_26422":54161,"_2810":54360},[],"The **Overview** tab shows, among others, these fields:",{"_3322":2282,"_29027":2202,"_20151":54362,"_5":13779,"_26422":54161,"_2810":54363},[],"**Key Name**: descriptive name.",{"_3322":2283,"_29027":2202,"_20151":54365,"_5":13779,"_26422":54161,"_2810":54366},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3322":2284,"_29027":2202,"_20151":54368,"_5":13779,"_26422":54161,"_2810":54369},[],"**Tags**: associated labels.",{"_3322":2285,"_29027":2202,"_20151":54371,"_5":13779,"_26422":54161,"_2810":54372},[],"**Aliases**: alternative names.",{"_3322":2286,"_29027":2202,"_20151":54374,"_5":13779,"_26422":54161,"_2810":54375},[],"**Crypto Engine**: engine where the key resides.",{"_3322":2287,"_29027":2202,"_20151":54377,"_5":13779,"_26422":54161,"_2810":54378},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3322":2288,"_29027":2202,"_20151":54380,"_5":13779,"_26422":54161,"_2810":54381},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3322":2289,"_29027":2202,"_20151":54383,"_5":13779,"_26422":54161,"_2810":54384},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3322":2290,"_29027":2202,"_20151":54386,"_5":13779,"_26422":54165,"_2810":54387},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3322":2291,"_29027":2202,"_20151":54389,"_5":13779,"_26422":54165,"_2810":54390},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3322":2292,"_29027":2202,"_20151":54392,"_5":13779,"_26422":54165,"_2810":54393},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3322":2293,"_29027":2202,"_20151":54395,"_5":13779,"_26422":54169,"_2810":54396},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3322":2294,"_29027":2202,"_20151":54398,"_5":13779,"_26422":54169,"_2810":54399},[],"Main fields:",{"_3322":2295,"_29027":2202,"_20151":54401,"_5":13779,"_26422":54169,"_2810":54402},[],"**Algorithm**: signing algorithm available for the key type.",{"_3322":2296,"_29027":2202,"_20151":54404,"_5":13779,"_26422":54169,"_2810":54405},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3322":2297,"_29027":2202,"_20151":54407,"_5":13779,"_26422":54169,"_2810":54408},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3322":2298,"_29027":2202,"_20151":54410,"_5":13779,"_26422":54169,"_2810":54411},[],"**Message**: content to sign.",{"_3322":2299,"_29027":2202,"_20151":54413,"_5":13779,"_26422":54169,"_2810":54414},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3322":2300,"_29027":2202,"_20151":54416,"_5":13779,"_26422":54173,"_2810":54417},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3322":2301,"_29027":2202,"_20151":54419,"_5":13779,"_26422":54173,"_2810":54399},[],{"_3322":2302,"_29027":2202,"_20151":54421,"_5":13779,"_26422":54173,"_2810":54422},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3322":2303,"_29027":2202,"_20151":54424,"_5":13779,"_26422":54173,"_2810":54425},[],"**Message Type**: `Raw` or `Digest`.",{"_3322":2304,"_29027":2202,"_20151":54427,"_5":13779,"_26422":54173,"_2810":54428},[],"**Payload Encoding**: encoding of the message.",{"_3322":2305,"_29027":2202,"_20151":54430,"_5":13779,"_26422":54173,"_2810":54431},[],"**Message**: original message or hash.",{"_3322":2306,"_29027":2202,"_20151":54433,"_5":13779,"_26422":54173,"_2810":54434},[],"**Signature**: signature to check.",{"_3322":2307,"_29027":2202,"_20151":54436,"_5":13779,"_26422":54173,"_2810":54437},[],"**Result**: indicator of the validation result.",{"_3322":2308,"_29027":2202,"_20151":54439,"_5":13779,"_26422":54177,"_2810":54440},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3322":2309,"_29027":2202,"_20151":54442,"_5":13779,"_26422":54177,"_2810":54443},[],"This flow is useful for:",{"_3322":2310,"_29027":2202,"_20151":54445,"_5":13779,"_26422":54177,"_2810":54446},[],"Requesting certificates from an external CA.",{"_3322":2311,"_29027":2202,"_20151":54448,"_5":13779,"_26422":54177,"_2810":54449},[],"Renewing an identity while keeping the same key.",{"_3322":2312,"_29027":2202,"_20151":54451,"_5":13779,"_26422":54177,"_2810":54452},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3322":2313,"_29027":2202,"_20151":54454,"_5":13779,"_26422":54177,"_2810":54455},[],"**Common Name (CN)**: main name of the identity.",{"_3322":2314,"_29027":2202,"_20151":54457,"_5":13779,"_26422":54177,"_2810":54458},[],"**Organization (O)**: organization or company.",{"_3322":2315,"_29027":2202,"_20151":54460,"_5":13779,"_26422":54177,"_2810":54461},[],"**Organizational Unit (OU)**: department or unit.",{"_3322":2316,"_29027":2202,"_20151":54463,"_5":13779,"_26422":54177,"_2810":54464},[],"**Country (C)**: two-letter country code.",{"_3322":2317,"_29027":2202,"_20151":54466,"_5":13779,"_26422":54177,"_2810":54467},[],"**State / Province (ST)**: state or province.",{"_3322":2318,"_29027":2202,"_20151":54469,"_5":13779,"_26422":54177,"_2810":54470},[],"**Locality (L)**: city or locality.",{"_3322":2319,"_29027":2202,"_20151":54472,"_5":13779,"_26422":54177,"_2810":54473},[],"**Email Address**: contact email.",{"_3322":2320,"_29027":2202,"_20151":54475,"_5":13779,"_26422":54177,"_2810":54476},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3322":2321,"_29027":2202,"_20151":54478,"_5":13779,"_26422":54177,"_2810":54479},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3322":2322,"_29027":2202,"_20151":54481,"_5":13779,"_26422":54181,"_2810":54482},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3322":2323,"_29027":2202,"_20151":54484,"_5":13779,"_26422":54181,"_2810":54485},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3322":2324,"_29027":2202,"_20151":54487,"_5":13779,"_26422":54185,"_2810":54488},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3322":2325,"_29027":2325,"_5":14137,"_2810":54490,"_29350":54491,"_20151":54492,"_26422":2325},"Online validation with OCSP",[47245,48694,52700,53327],[],{"_3322":2326,"_29027":2325,"_20151":54494,"_5":13779,"_26422":2325,"_2810":54495},[],"Query signed status and verify the responder’s response.",{"_3322":2327,"_29027":2325,"_5":29347,"_20151":54497,"_26422":54498,"_2810":54499},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3322":2328,"_29027":2325,"_5":29347,"_20151":54501,"_26422":54502,"_2810":54503},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3322":2329,"_29027":2325,"_5":29347,"_20151":54505,"_26422":54506,"_2810":54507},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3322":2330,"_29027":2325,"_5":29347,"_20151":54509,"_26422":54510,"_2810":54511},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3322":2331,"_29027":2325,"_5":29347,"_20151":54513,"_26422":54514,"_2810":54515},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3322":2332,"_29027":2325,"_5":29347,"_20151":54517,"_26422":54518,"_2810":53881},[],"/docs/platform/pki/ocsp#references",{"_3322":2333,"_29027":2325,"_20151":54520,"_5":13779,"_26422":2325,"_2810":54521},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3322":2334,"_29027":2325,"_20151":54523,"_5":13779,"_26422":54498,"_2810":54524},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3322":2335,"_29027":2325,"_20151":54526,"_5":13779,"_26422":54498,"_2810":54527},[],"Record status",{"_3322":2336,"_29027":2325,"_20151":54529,"_5":13779,"_26422":54498,"_2810":54530},[],"Signed response",{"_3322":2337,"_29027":2325,"_20151":54532,"_5":13779,"_26422":54498,"_2810":51871},[],{"_3322":2338,"_29027":2325,"_20151":54534,"_5":13779,"_26422":54498,"_2810":54535},[],"`Good`.",{"_3322":2339,"_29027":2325,"_20151":54537,"_5":13779,"_26422":54498,"_2810":51888},[],{"_3322":2340,"_29027":2325,"_20151":54539,"_5":13779,"_26422":54498,"_2810":54540},[],"`Revoked`, with revocation reason and timestamp.",{"_3322":2341,"_29027":2325,"_20151":54542,"_5":13779,"_26422":54498,"_2810":54543},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3322":2342,"_29027":2325,"_20151":54545,"_5":13779,"_26422":54498,"_2810":54546},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3322":2343,"_29027":2325,"_20151":54548,"_5":13779,"_26422":54498,"_2810":54549},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3322":2344,"_29027":2325,"_20151":54551,"_5":13779,"_26422":54498,"_2810":54552},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3322":2345,"_29027":2325,"_20151":54554,"_5":13779,"_26422":54498,"_2810":54555},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3322":2346,"_29027":2325,"_20151":54557,"_5":13779,"_26422":54502,"_2810":54558},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3322":2347,"_29027":2325,"_20151":54560,"_5":13779,"_26422":54502,"_2810":54561},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3322":2348,"_29027":2325,"_20151":54563,"_5":13779,"_26422":54506,"_2810":54564},[],"The service accepts:",{"_3322":2349,"_29027":2325,"_20151":54566,"_5":13779,"_26422":54506,"_2810":50458},[],{"_3322":2350,"_29027":2325,"_20151":54568,"_5":13779,"_26422":54506,"_2810":54569},[],"VA service path",{"_3322":2351,"_29027":2325,"_20151":54571,"_5":13779,"_26422":54506,"_2810":54572},[],"Format",{"_3322":2352,"_29027":2325,"_20151":54574,"_5":13779,"_26422":54506,"_2810":54575},[],"`POST`",{"_3322":2353,"_29027":2325,"_20151":54577,"_5":13779,"_26422":54506,"_2810":54578},[],"`/ocsp`",{"_3322":2354,"_29027":2325,"_20151":54580,"_5":13779,"_26422":54506,"_2810":54581},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3322":2355,"_29027":2325,"_20151":54583,"_5":13779,"_26422":54506,"_2810":54007},[],{"_3322":2356,"_29027":2325,"_20151":54585,"_5":13779,"_26422":54506,"_2810":54586},[],"`/ocsp/{ocsp_request}`",{"_3322":2357,"_29027":2325,"_20151":54588,"_5":13779,"_26422":54506,"_2810":54589},[],"DER request encoded using padded URL Base64.",{"_3322":2358,"_29027":2325,"_20151":54591,"_5":13779,"_26422":54506,"_2810":54592},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3322":2359,"_29027":2325,"_20151":54594,"_5":13779,"_26422":54510,"_2810":54595},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3322":2360,"_29027":2325,"_20151":54597,"_5":13779,"_26422":54510,"_2810":54598},[],"Generate the request:",{"_3322":2361,"_29027":2325,"_20151":54600,"_5":13779,"_26422":54510,"_2810":54601},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3322":2362,"_29027":2325,"_20151":54603,"_5":13779,"_26422":54510,"_2810":54604},[],"Replace the example URL with the inspected endpoint:",{"_3322":2363,"_29027":2325,"_20151":54606,"_5":13779,"_26422":54510,"_2810":54607},[],"Verify the returned DER:",{"_3322":2364,"_29027":2325,"_20151":54609,"_5":13779,"_26422":54510,"_2810":54610},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3322":2365,"_29027":2325,"_20151":54612,"_5":13779,"_26422":54514,"_2810":54613},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3322":2366,"_29027":2325,"_20151":54615,"_5":13779,"_26422":54514,"_2810":54616},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3322":2367,"_29027":2325,"_20151":54618,"_5":13779,"_26422":54518,"_2810":54619},[],"RFC 6960: OCSP.",{"_3322":2368,"_29027":2325,"_20151":54621,"_5":13779,"_26422":54518,"_2810":54622},[],"OpenSSL: openssl-ocsp.",{"_3322":2369,"_29027":2325,"_20151":54624,"_5":13779,"_26422":54518,"_2810":54625},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3322":2370,"_29027":2325,"_20151":54627,"_5":13779,"_26422":54518,"_2810":54099},[],{"_3322":2371,"_29027":2371,"_5":14137,"_2810":52700,"_29350":54629,"_20151":54630,"_26422":2371},[47245,48694,52700],[],{"_3322":2372,"_29027":2371,"_20151":54632,"_5":13779,"_26422":2371,"_2810":54633},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3322":2373,"_29027":2371,"_5":29347,"_20151":54635,"_26422":54636,"_2810":52012},[],"/docs/platform/pki/overview#start-here",{"_3322":2374,"_29027":2371,"_5":29347,"_20151":54638,"_26422":54639,"_2810":54640},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3322":2375,"_29027":2371,"_5":29347,"_20151":54642,"_26422":54643,"_2810":52544},[],"/docs/platform/pki/overview#core-capabilities",{"_3322":2376,"_29027":2371,"_5":29347,"_20151":54645,"_26422":54646,"_2810":52548},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3322":2377,"_29027":2371,"_5":29347,"_20151":54648,"_26422":54649,"_2810":52552},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3322":2378,"_29027":2371,"_5":29347,"_20151":54651,"_26422":54652,"_2810":52556},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3322":2379,"_29027":2371,"_5":29347,"_20151":54654,"_26422":54655,"_2810":52564},[],"/docs/platform/pki/overview#publish-validation-status",{"_3322":2380,"_29027":2371,"_5":29347,"_20151":54657,"_26422":54658,"_2810":54659},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3322":2381,"_29027":2371,"_5":29347,"_20151":54661,"_26422":54662,"_2810":53494},[],"/docs/platform/pki/overview#continue",{"_3322":2382,"_29027":2371,"_20151":54664,"_5":13779,"_26422":2371,"_2810":54665},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3322":2383,"_29027":2371,"_20151":54667,"_5":13779,"_26422":54636,"_2810":54668},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3322":2384,"_29027":2371,"_20151":54670,"_5":13779,"_26422":54636,"_2810":54671},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3322":2385,"_29027":2371,"_20151":54673,"_5":13779,"_26422":54639,"_2810":54674},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3322":2386,"_29027":2371,"_20151":54676,"_5":13779,"_26422":54639,"_2810":54677},[],"An available cryptographic engine to keep the authority's key.",{"_3322":2387,"_29027":2371,"_20151":54679,"_5":13779,"_26422":54639,"_2810":54680},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3322":2388,"_29027":2371,"_20151":54682,"_5":13779,"_26422":54639,"_2810":54683},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3322":2389,"_29027":2371,"_20151":54685,"_5":13779,"_26422":54639,"_2810":54686},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3322":2390,"_29027":2371,"_20151":54688,"_5":13779,"_26422":54646,"_2810":54689},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3322":2391,"_29027":2371,"_20151":54691,"_5":13779,"_26422":54649,"_2810":54692},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3322":2392,"_29027":2371,"_20151":54694,"_5":13779,"_26422":54652,"_2810":54695},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3322":2393,"_29027":2371,"_20151":54697,"_5":13779,"_26422":54655,"_2810":54698},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3322":2394,"_29027":2371,"_20151":54700,"_5":13779,"_26422":54658,"_2810":54701},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3322":2395,"_29027":2371,"_20151":54703,"_5":13779,"_26422":54658,"_2810":54704},[],"its subject and extensions identify the expected client;",{"_3322":2396,"_29027":2371,"_20151":54706,"_5":13779,"_26422":54658,"_2810":54707},[],"its public key matches the client's private key;",{"_3322":2397,"_29027":2371,"_20151":54709,"_5":13779,"_26422":54658,"_2810":54710},[],"its chain reaches a root trusted by the consumer;",{"_3322":2398,"_29027":2371,"_20151":54712,"_5":13779,"_26422":54658,"_2810":54713},[],"its dates and usages allow the operation;",{"_3322":2399,"_29027":2371,"_20151":54715,"_5":13779,"_26422":54658,"_2810":54716},[],"the consumer applies revocation checks and authorization.",{"_3322":2400,"_29027":2371,"_20151":54718,"_5":13779,"_26422":54658,"_2810":54719},[],"The issuance path includes the first independent checks.",{"_3322":2401,"_29027":2371,"_20151":54721,"_5":13779,"_26422":54662,"_2810":54722},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3322":2402,"_29027":2371,"_20151":54724,"_5":13779,"_26422":54662,"_2810":54725},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3322":2403,"_29027":2371,"_20151":54727,"_5":13779,"_26422":54662,"_2810":54728},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3322":2404,"_29027":2404,"_5":14137,"_2810":54730,"_29350":54731,"_20151":54732,"_26422":2404},"Create your first CA",[47245,48694,52700,52137],[],{"_3322":2405,"_29027":2404,"_20151":54734,"_5":13779,"_26422":2404,"_2810":54735},[],"Create an evaluation root and check its certificate before issuing.",{"_3322":2406,"_29027":2404,"_5":29347,"_20151":54737,"_26422":54738,"_2810":47255},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3322":2407,"_29027":2404,"_5":29347,"_20151":54740,"_26422":54741,"_2810":54742},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3322":2408,"_29027":2404,"_5":29347,"_20151":54744,"_26422":54745,"_2810":54746},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3322":2409,"_29027":2404,"_5":29347,"_20151":54748,"_26422":54749,"_2810":54750},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3322":2410,"_29027":2404,"_5":29347,"_20151":54752,"_26422":54753,"_2810":54754},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3322":2411,"_29027":2404,"_5":29347,"_20151":54756,"_26422":54757,"_2810":54758},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3322":2412,"_29027":2404,"_5":29347,"_20151":54760,"_26422":54761,"_2810":54762},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3322":2413,"_29027":2404,"_5":29347,"_20151":54764,"_26422":54765,"_2810":52394},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3322":2414,"_29027":2404,"_5":29347,"_20151":54767,"_26422":54768,"_2810":47279},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3322":2415,"_29027":2404,"_20151":54770,"_5":13779,"_26422":2404,"_2810":54771},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3322":2416,"_29027":2404,"_20151":54773,"_5":13779,"_26422":54738,"_2810":54774},[],"Console access and permission to create keys and authorities.",{"_3322":2417,"_29027":2404,"_20151":54776,"_5":13779,"_26422":54738,"_2810":54777},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3322":2418,"_29027":2404,"_20151":54779,"_5":13779,"_26422":54738,"_2810":54780},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3322":2419,"_29027":2404,"_20151":54782,"_5":13779,"_26422":54738,"_2810":54783},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3322":2420,"_29027":2404,"_20151":54785,"_5":13779,"_26422":54741,"_2810":54786},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3322":2421,"_29027":2404,"_20151":54788,"_5":13779,"_26422":54741,"_2810":54789},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3322":2422,"_29027":2404,"_20151":54791,"_5":13779,"_26422":54745,"_2810":54792},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3322":2423,"_29027":2404,"_20151":54794,"_5":13779,"_26422":54745,"_2810":54795},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3322":2424,"_29027":2404,"_20151":54797,"_5":13779,"_26422":54749,"_2810":54798},[],"Select **Root CA** and complete:",{"_3322":2425,"_29027":2404,"_20151":54800,"_5":13779,"_26422":54749,"_2810":54801},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3322":2426,"_29027":2404,"_20151":54803,"_5":13779,"_26422":54749,"_2810":54804},[],"**Subject**: organization and country details for your evaluation.",{"_3322":2427,"_29027":2404,"_20151":54806,"_5":13779,"_26422":54749,"_2810":54807},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3322":2428,"_29027":2404,"_20151":54809,"_5":13779,"_26422":54749,"_2810":54810},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3322":2429,"_29027":2404,"_20151":54812,"_5":13779,"_26422":54749,"_2810":54813},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3322":2430,"_29027":2404,"_20151":54815,"_5":13779,"_26422":54753,"_2810":54816},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3322":2431,"_29027":2404,"_20151":54818,"_5":13779,"_26422":54757,"_2810":54819},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3322":2432,"_29027":2404,"_20151":54821,"_5":13779,"_26422":54757,"_2810":54822},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3322":2433,"_29027":2404,"_20151":54824,"_5":13779,"_26422":54761,"_2810":54825},[],"Run from the directory where you saved `ca.pem`:",{"_3322":2434,"_29027":2404,"_20151":54827,"_5":13779,"_26422":54761,"_2810":54828},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3322":2435,"_29027":2404,"_20151":54830,"_5":13779,"_26422":54761,"_2810":54831},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3322":2436,"_29027":2404,"_20151":54833,"_5":13779,"_26422":54765,"_2810":54834},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3322":2437,"_29027":2404,"_20151":54836,"_5":13779,"_26422":54765,"_2810":54837},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3322":2438,"_29027":2404,"_20151":54839,"_5":13779,"_26422":54765,"_2810":54840},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3322":2439,"_29027":2404,"_20151":54842,"_5":13779,"_26422":54765,"_2810":54843},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3322":2440,"_29027":2404,"_20151":54845,"_5":13779,"_26422":54768,"_2810":54846},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3322":2441,"_29027":2441,"_5":14137,"_2810":54848,"_29350":54849,"_20151":54850,"_26422":2441},"Issue and verify a certificate",[47245,48694,52700,52137],[],{"_3322":2442,"_29027":2441,"_20151":54852,"_5":13779,"_26422":2441,"_2810":54853},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3322":2443,"_29027":2441,"_5":29347,"_20151":54855,"_26422":54856,"_2810":47255},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3322":2444,"_29027":2441,"_5":29347,"_20151":54858,"_26422":54859,"_2810":54860},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3322":2445,"_29027":2441,"_5":29347,"_20151":54862,"_26422":54863,"_2810":54864},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3322":2446,"_29027":2441,"_5":29347,"_20151":54866,"_26422":54867,"_2810":54868},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3322":2447,"_29027":2441,"_5":29347,"_20151":54870,"_26422":54871,"_2810":54872},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3322":2448,"_29027":2441,"_5":29347,"_20151":54874,"_26422":54875,"_2810":54876},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3322":2449,"_29027":2441,"_5":29347,"_20151":54878,"_26422":54879,"_2810":54880},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3322":2450,"_29027":2441,"_5":29347,"_20151":54882,"_26422":54883,"_2810":54884},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3322":2451,"_29027":2441,"_5":29347,"_20151":54886,"_26422":54887,"_2810":54888},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3322":2452,"_29027":2441,"_5":29347,"_20151":54890,"_26422":54891,"_2810":54892},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3322":2453,"_29027":2441,"_5":29347,"_20151":54894,"_26422":54895,"_2810":52394},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3322":2454,"_29027":2441,"_5":29347,"_20151":54897,"_26422":54898,"_2810":47279},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3322":2455,"_29027":2441,"_20151":54900,"_5":13779,"_26422":2441,"_2810":54901},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3322":2456,"_29027":2441,"_20151":54903,"_5":13779,"_26422":54856,"_2810":54904},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3322":2457,"_29027":2441,"_20151":54906,"_5":13779,"_26422":54856,"_2810":54907},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3322":2458,"_29027":2441,"_20151":54909,"_5":13779,"_26422":54856,"_2810":54910},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3322":2459,"_29027":2441,"_20151":54912,"_5":13779,"_26422":54856,"_2810":54913},[],"A client identifier: here we use `device-001`.",{"_3322":2460,"_29027":2441,"_20151":54915,"_5":13779,"_26422":54856,"_2810":54916},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3322":2461,"_29027":2441,"_20151":54918,"_5":13779,"_26422":54859,"_2810":54919},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3322":2462,"_29027":2441,"_20151":54921,"_5":13779,"_26422":54863,"_2810":54922},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3322":2463,"_29027":2441,"_20151":54924,"_5":13779,"_26422":54863,"_2810":54925},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3322":2464,"_29027":2441,"_20151":54927,"_5":13779,"_26422":54867,"_2810":54928},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3322":2465,"_29027":2441,"_20151":54930,"_5":13779,"_26422":54867,"_2810":54931},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3322":2466,"_29027":2441,"_20151":54933,"_5":13779,"_26422":54871,"_2810":54934},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3322":2467,"_29027":2441,"_20151":54936,"_5":13779,"_26422":54871,"_2810":54937},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3322":2468,"_29027":2441,"_20151":54939,"_5":13779,"_26422":54875,"_2810":54940},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3322":2469,"_29027":2441,"_20151":54942,"_5":13779,"_26422":54879,"_2810":54943},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3322":2470,"_29027":2441,"_20151":54945,"_5":13779,"_26422":54883,"_2810":54946},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3322":2471,"_29027":2441,"_20151":54948,"_5":13779,"_26422":54887,"_2810":54949},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3322":2472,"_29027":2441,"_20151":54951,"_5":13779,"_26422":54887,"_2810":54952},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3322":2473,"_29027":2441,"_20151":54954,"_5":13779,"_26422":54887,"_2810":54955},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3322":2474,"_29027":2441,"_20151":54957,"_5":13779,"_26422":54891,"_2810":54958},[],"In Bash, compare the two public-key digests:",{"_3322":2475,"_29027":2441,"_20151":54960,"_5":13779,"_26422":54891,"_2810":54961},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3322":2476,"_29027":2441,"_20151":54963,"_5":13779,"_26422":54891,"_2810":54964},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3322":2477,"_29027":2441,"_20151":54966,"_5":13779,"_26422":54895,"_2810":52478},[],{"_3322":2478,"_29027":2441,"_20151":54968,"_5":13779,"_26422":54895,"_2810":54969},[],"What to review",{"_3322":2479,"_29027":2441,"_20151":54971,"_5":13779,"_26422":54895,"_2810":54972},[],"The CA rejects issuance",{"_3322":2480,"_29027":2441,"_20151":54974,"_5":13779,"_26422":54895,"_2810":54975},[],"Permissions, CA state and key, algorithm and profile.",{"_3322":2481,"_29027":2441,"_20151":54977,"_5":13779,"_26422":54895,"_2810":54978},[],"Different subject or usages",{"_3322":2482,"_29027":2441,"_20151":54980,"_5":13779,"_26422":54895,"_2810":54981},[],"Applied profile and requested values.",{"_3322":2483,"_29027":2441,"_20151":54983,"_5":13779,"_26422":54895,"_2810":54984},[],"Issuer cannot be found",{"_3322":2484,"_29027":2441,"_20151":54986,"_5":13779,"_26422":54895,"_2810":54987},[],"Downloaded CA and required intermediate chain.",{"_3322":2485,"_29027":2441,"_20151":54989,"_5":13779,"_26422":54895,"_2810":54990},[],"Validity fails",{"_3322":2486,"_29027":2441,"_20151":54992,"_5":13779,"_26422":54895,"_2810":54993},[],"Certificate and CA dates, and the computer's clock.",{"_3322":2487,"_29027":2441,"_20151":54995,"_5":13779,"_26422":54895,"_2810":54996},[],"Public-key digests differ",{"_3322":2488,"_29027":2441,"_20151":54998,"_5":13779,"_26422":54895,"_2810":54999},[],"Certificate and key files from the same issuance.",{"_3322":2489,"_29027":2441,"_20151":55001,"_5":13779,"_26422":54895,"_2810":55002},[],"See PKI diagnostics to narrow an issuance failure.",{"_3322":2490,"_29027":2441,"_20151":55004,"_5":13779,"_26422":54898,"_2810":55005},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3322":2491,"_29027":2441,"_20151":55007,"_5":13779,"_26422":54898,"_2810":55008},[],"Manage certificates for inspection, status and revocation.",{"_3322":2492,"_29027":2441,"_20151":55010,"_5":13779,"_26422":54898,"_2810":55011},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3322":2493,"_29027":2441,"_20151":55013,"_5":13779,"_26422":54898,"_2810":55014},[],"Prepare EST for the device to request its next identities.",{"_3322":2494,"_29027":2441,"_20151":55016,"_5":13779,"_26422":54898,"_2810":55017},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3322":2495,"_29027":2495,"_5":14137,"_2810":55019,"_29350":55020,"_20151":55021,"_26422":2495},"PKI getting started",[47245,48694,52700,52137],[],{"_3322":2496,"_29027":2495,"_20151":55023,"_5":13779,"_26422":2495,"_2810":55024},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3322":2497,"_29027":2495,"_5":29347,"_20151":55026,"_26422":55027,"_2810":47255},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3322":2498,"_29027":2495,"_5":29347,"_20151":55029,"_26422":55030,"_2810":55031},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3322":2499,"_29027":2495,"_5":29347,"_20151":55033,"_26422":55034,"_2810":52329},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3322":2500,"_29027":2495,"_5":29347,"_20151":55036,"_26422":55037,"_2810":55038},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3322":2501,"_29027":2495,"_20151":55040,"_5":13779,"_26422":2495,"_2810":55041},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3322":2502,"_29027":2495,"_20151":55043,"_5":13779,"_26422":55027,"_2810":55044},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3322":2503,"_29027":2495,"_20151":55046,"_5":13779,"_26422":55027,"_2810":55047},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3322":2504,"_29027":2495,"_20151":55049,"_5":13779,"_26422":55027,"_2810":55050},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3322":2505,"_29027":2495,"_20151":55052,"_5":13779,"_26422":55027,"_2810":55053},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3322":2506,"_29027":2495,"_20151":55055,"_5":13779,"_26422":55027,"_2810":55056},[],"A working directory with restricted access for the downloaded key.",{"_3322":2507,"_29027":2495,"_20151":55058,"_5":13779,"_26422":55030,"_2810":55059},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3322":2508,"_29027":2495,"_20151":55061,"_5":13779,"_26422":55030,"_2810":55062},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3322":2509,"_29027":2495,"_20151":55064,"_5":13779,"_26422":55030,"_2810":55065},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3322":2510,"_29027":2495,"_20151":55067,"_5":13779,"_26422":55030,"_2810":55068},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3322":2511,"_29027":2495,"_20151":55070,"_5":13779,"_26422":55034,"_2810":55071},[],"File or resource",{"_3322":2512,"_29027":2495,"_20151":55073,"_5":13779,"_26422":55034,"_2810":52326},[],{"_3322":2513,"_29027":2495,"_20151":55075,"_5":13779,"_26422":55034,"_2810":55076},[],"Active root CA and `ca.pem`",{"_3322":2514,"_29027":2495,"_20151":55078,"_5":13779,"_26422":55034,"_2810":55079},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3322":2515,"_29027":2495,"_20151":55081,"_5":13779,"_26422":55034,"_2810":55082},[],"End-entity certificate and `device.crt`",{"_3322":2516,"_29027":2495,"_20151":55084,"_5":13779,"_26422":55034,"_2810":55085},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3322":2517,"_29027":2495,"_20151":55087,"_5":13779,"_26422":55034,"_2810":55088},[],"Private key `device.key`",{"_3322":2518,"_29027":2495,"_20151":55090,"_5":13779,"_26422":55034,"_2810":55091},[],"Its public key matches the one included in `device.crt`.",{"_3322":2519,"_29027":2495,"_20151":55093,"_5":13779,"_26422":55034,"_2810":55094},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3322":2520,"_29027":2495,"_20151":55096,"_5":13779,"_26422":55037,"_2810":55097},[],"To operate certificates, continue with Certificates and Validation.",{"_3322":2521,"_29027":2495,"_20151":55099,"_5":13779,"_26422":55037,"_2810":55100},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3322":2522,"_29027":2495,"_20151":55102,"_5":13779,"_26422":55037,"_2810":55103},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3322":2523,"_29027":2523,"_5":14137,"_2810":55105,"_29350":55106,"_20151":55107,"_26422":2523},"PKI troubleshooting",[47245,48694,52700,51272],[],{"_3322":2524,"_29027":2523,"_20151":55109,"_5":13779,"_26422":2523,"_2810":55110},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3322":2525,"_29027":2523,"_5":29347,"_20151":55112,"_26422":55113,"_2810":55114},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3322":2526,"_29027":2523,"_5":29347,"_20151":55116,"_26422":55117,"_2810":55118},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3322":2527,"_29027":2523,"_5":29347,"_20151":55120,"_26422":55121,"_2810":55122},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3322":2528,"_29027":2523,"_20151":55124,"_5":13779,"_26422":2523,"_2810":55125},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3322":2529,"_29027":2523,"_20151":55127,"_5":13779,"_26422":2523,"_2810":55128},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3322":2530,"_29027":2523,"_20151":55130,"_5":13779,"_26422":55113,"_2810":52326},[],{"_3322":2531,"_29027":2523,"_20151":55132,"_5":13779,"_26422":55113,"_2810":55133},[],"What to inspect",{"_3322":2532,"_29027":2523,"_20151":55135,"_5":13779,"_26422":55113,"_2810":47279},[],{"_3322":2533,"_29027":2523,"_20151":55137,"_5":13779,"_26422":55113,"_2810":51539},[],{"_3322":2534,"_29027":2523,"_20151":55139,"_5":13779,"_26422":55113,"_2810":55140},[],"Exists, is active and has usable dates.",{"_3322":2535,"_29027":2523,"_20151":55142,"_5":13779,"_26422":55113,"_2810":55143},[],"Authorities.",{"_3322":2536,"_29027":2523,"_20151":55145,"_5":13779,"_26422":55113,"_2810":55146},[],"Key",{"_3322":2537,"_29027":2523,"_20151":55148,"_5":13779,"_26422":55113,"_2810":55149},[],"The record has a usable private key and the engine can sign.",{"_3322":2538,"_29027":2523,"_20151":55151,"_5":13779,"_26422":55113,"_2810":55152},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3322":2539,"_29027":2523,"_20151":55154,"_5":13779,"_26422":55113,"_2810":55155},[],"CSR",{"_3322":2540,"_29027":2523,"_20151":55157,"_5":13779,"_26422":55113,"_2810":55158},[],"Correct PEM and verifiable signature.",{"_3322":2541,"_29027":2523,"_20151":55160,"_5":13779,"_26422":55113,"_2810":55161},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3322":2542,"_29027":2523,"_20151":55163,"_5":13779,"_26422":55113,"_2810":55164},[],"Profile",{"_3322":2543,"_29027":2523,"_20151":55166,"_5":13779,"_26422":55113,"_2810":55167},[],"Selected source, existing ID, allowed algorithm and size.",{"_3322":2544,"_29027":2523,"_20151":55169,"_5":13779,"_26422":55113,"_2810":55170},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3322":2545,"_29027":2523,"_20151":55172,"_5":13779,"_26422":55113,"_2810":52478},[],{"_3322":2546,"_29027":2523,"_20151":55174,"_5":13779,"_26422":55113,"_2810":55175},[],"Appropriate subject, SAN, usages and dates.",{"_3322":2547,"_29027":2523,"_20151":55177,"_5":13779,"_26422":55113,"_2810":55178},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3322":2548,"_29027":2523,"_20151":55180,"_5":13779,"_26422":55113,"_2810":55181},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3322":2549,"_29027":2523,"_20151":55183,"_5":13779,"_26422":55113,"_2810":55184},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. To change its key, use Hierarchy and rotation.",{"_3322":2550,"_29027":2523,"_20151":55186,"_5":13779,"_26422":55117,"_2810":55187},[],"Check each boundary independently:",{"_3322":2551,"_29027":2523,"_20151":55189,"_5":13779,"_26422":55117,"_2810":55190},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3322":2552,"_29027":2523,"_20151":55192,"_5":13779,"_26422":55117,"_2810":55193},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3322":2553,"_29027":2523,"_20151":55195,"_5":13779,"_26422":55117,"_2810":55196},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3322":2554,"_29027":2523,"_20151":55198,"_5":13779,"_26422":55117,"_2810":55199},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3322":2555,"_29027":2523,"_20151":55201,"_5":13779,"_26422":55117,"_2810":55202},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3322":2556,"_29027":2523,"_20151":55204,"_5":13779,"_26422":55117,"_2810":55205},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3322":2557,"_29027":2523,"_20151":55207,"_5":13779,"_26422":55121,"_2810":55208},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3322":2558,"_29027":2523,"_20151":55210,"_5":13779,"_26422":55121,"_2810":55211},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3322":2559,"_29027":2559,"_5":14137,"_2810":55213,"_29350":55214,"_20151":55216,"_26422":2559},"3.8.0 to 4.0.0",[47245,55215],"Upgrades",[],{"_3322":2560,"_29027":2559,"_20151":55218,"_5":13779,"_26422":2559,"_2810":55219},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3322":2561,"_29027":2559,"_5":29347,"_20151":55221,"_26422":55222,"_2810":55223},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3322":2562,"_29027":2559,"_5":29347,"_20151":55225,"_26422":55226,"_2810":55227},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3322":2563,"_29027":2559,"_5":29347,"_20151":55229,"_26422":55230,"_2810":55231},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3322":2564,"_29027":2559,"_5":29347,"_20151":55233,"_26422":55234,"_2810":55235},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3322":2565,"_29027":2559,"_5":29347,"_20151":55237,"_26422":55238,"_2810":55239},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3322":2566,"_29027":2559,"_5":29347,"_20151":55241,"_26422":55242,"_2810":55243},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3322":2567,"_29027":2559,"_5":29347,"_20151":55245,"_26422":55246,"_2810":55247},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3322":2568,"_29027":2559,"_5":29347,"_20151":55249,"_26422":55250,"_2810":55251},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3322":2569,"_29027":2559,"_5":29347,"_20151":55253,"_26422":55254,"_2810":55255},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3322":2570,"_29027":2559,"_5":29347,"_20151":55257,"_26422":55258,"_2810":55259},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3322":2571,"_29027":2559,"_5":29347,"_20151":55261,"_26422":55262,"_2810":55263},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3322":2572,"_29027":2559,"_5":29347,"_20151":55265,"_26422":55266,"_2810":55267},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3322":2573,"_29027":2559,"_5":29347,"_20151":55269,"_26422":55270,"_2810":55271},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3322":2574,"_29027":2559,"_5":29347,"_20151":55273,"_26422":55274,"_2810":55275},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3322":2575,"_29027":2559,"_5":29347,"_20151":55277,"_26422":55278,"_2810":55279},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3322":2576,"_29027":2559,"_5":29347,"_20151":55281,"_26422":55282,"_2810":55283},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3322":2577,"_29027":2559,"_5":29347,"_20151":55285,"_26422":55286,"_2810":55287},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3322":2578,"_29027":2559,"_5":29347,"_20151":55289,"_26422":55290,"_2810":55291},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3322":2579,"_29027":2559,"_5":29347,"_20151":55293,"_26422":55294,"_2810":55295},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3322":2580,"_29027":2559,"_5":29347,"_20151":55297,"_26422":55298,"_2810":55299},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3322":2581,"_29027":2559,"_5":29347,"_20151":55301,"_26422":55302,"_2810":55303},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3322":2582,"_29027":2559,"_5":29347,"_20151":55305,"_26422":55306,"_2810":55307},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3322":2583,"_29027":2559,"_5":29347,"_20151":55309,"_26422":55310,"_2810":55311},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3322":2584,"_29027":2559,"_5":29347,"_20151":55313,"_26422":55314,"_2810":55315},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3322":2585,"_29027":2559,"_5":29347,"_20151":55317,"_26422":55318,"_2810":55319},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3322":2586,"_29027":2559,"_5":29347,"_20151":55321,"_26422":55322,"_2810":55323},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3322":2587,"_29027":2559,"_5":29347,"_20151":55325,"_26422":55326,"_2810":55327},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3322":2588,"_29027":2559,"_5":29347,"_20151":55329,"_26422":55330,"_2810":55331},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3322":2589,"_29027":2559,"_5":29347,"_20151":55333,"_26422":55334,"_2810":55335},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3322":2590,"_29027":2559,"_5":29347,"_20151":55337,"_26422":55338,"_2810":55339},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3322":2591,"_29027":2559,"_5":29347,"_20151":55341,"_26422":55342,"_2810":55343},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3322":2592,"_29027":2559,"_5":29347,"_20151":55345,"_26422":55346,"_2810":55347},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3322":2593,"_29027":2559,"_5":29347,"_20151":55349,"_26422":55350,"_2810":55351},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3322":2594,"_29027":2559,"_5":29347,"_20151":55353,"_26422":55354,"_2810":51272},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3322":2595,"_29027":2559,"_5":29347,"_20151":55356,"_26422":55357,"_2810":55358},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3322":2596,"_29027":2559,"_5":29347,"_20151":55360,"_26422":55361,"_2810":55362},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3322":2597,"_29027":2559,"_20151":55364,"_5":13779,"_26422":2559,"_2810":55365},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3322":2598,"_29027":2559,"_20151":55367,"_5":13779,"_26422":2559,"_2810":55368},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3322":2599,"_29027":2559,"_20151":55370,"_5":13779,"_26422":2559,"_2810":55371},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3322":2600,"_29027":2559,"_20151":55373,"_5":13779,"_26422":2559,"_2810":55374},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3322":2601,"_29027":2559,"_20151":55376,"_5":13779,"_26422":2559,"_2810":55377},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3322":2602,"_29027":2559,"_20151":55379,"_5":13779,"_26422":2559,"_2810":55380},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3322":2603,"_29027":2559,"_20151":55382,"_5":13779,"_26422":2559,"_2810":55383},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3322":2604,"_29027":2559,"_20151":55385,"_5":13779,"_26422":55226,"_2810":55386},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3322":2605,"_29027":2559,"_20151":55388,"_5":13779,"_26422":55226,"_2810":55389},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3322":2606,"_29027":2559,"_20151":55391,"_5":13779,"_26422":55230,"_2810":55392},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3322":2607,"_29027":2559,"_20151":55394,"_5":13779,"_26422":55230,"_2810":55395},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and VA roles. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3322":2608,"_29027":2559,"_20151":55397,"_5":13779,"_26422":55234,"_2810":55398},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3322":2609,"_29027":2559,"_20151":55400,"_5":13779,"_26422":55238,"_2810":55401},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3322":2610,"_29027":2559,"_20151":55403,"_5":13779,"_26422":55238,"_2810":55404},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3322":2611,"_29027":2559,"_20151":55406,"_5":13779,"_26422":55238,"_2810":55407},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3322":2612,"_29027":2559,"_20151":55409,"_5":13779,"_26422":55238,"_2810":55410},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3322":2613,"_29027":2559,"_20151":55412,"_5":13779,"_26422":55238,"_2810":55413},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3322":2614,"_29027":2559,"_20151":55415,"_5":13779,"_26422":55242,"_2810":55416},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3322":2615,"_29027":2559,"_20151":55418,"_5":13779,"_26422":55242,"_2810":55419},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3322":2616,"_29027":2559,"_20151":55421,"_5":13779,"_26422":55242,"_2810":55422},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3322":2617,"_29027":2559,"_20151":55424,"_5":13779,"_26422":55242,"_2810":55425},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3322":2618,"_29027":2559,"_20151":55427,"_5":13779,"_26422":55242,"_2810":55428},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3322":2619,"_29027":2559,"_20151":55430,"_5":13779,"_26422":55246,"_2810":55431},[],"Change",{"_3322":2620,"_29027":2559,"_20151":55433,"_5":13779,"_26422":55246,"_2810":55434},[],"Who is affected",{"_3322":2621,"_29027":2559,"_20151":55436,"_5":13779,"_26422":55246,"_2810":55437},[],"Severity",{"_3322":2622,"_29027":2559,"_20151":55439,"_5":13779,"_26422":55246,"_2810":54036},[],{"_3322":2623,"_29027":2559,"_20151":55441,"_5":13779,"_26422":55246,"_2810":55255},[],{"_3322":2624,"_29027":2559,"_20151":55443,"_5":13779,"_26422":55246,"_2810":55444},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3322":2625,"_29027":2559,"_20151":55446,"_5":13779,"_26422":55246,"_2810":55447},[],"High: KMS and VA start on empty volumes",{"_3322":2626,"_29027":2559,"_20151":55449,"_5":13779,"_26422":55246,"_2810":55450},[],"Copy the data into the new volumes",{"_3322":2627,"_29027":2559,"_20151":55452,"_5":13779,"_26422":55246,"_2810":55259},[],{"_3322":2628,"_29027":2559,"_20151":55454,"_5":13779,"_26422":55246,"_2810":55455},[],"Every Helm release",{"_3322":2629,"_29027":2559,"_20151":55457,"_5":13779,"_26422":55246,"_2810":55458},[],"High: `helm upgrade` fails",{"_3322":2630,"_29027":2559,"_20151":55460,"_5":13779,"_26422":55246,"_2810":55461},[],"Remove or rename legacy keys",{"_3322":2631,"_29027":2559,"_20151":55463,"_5":13779,"_26422":55246,"_2810":55263},[],{"_3322":2632,"_29027":2559,"_20151":55465,"_5":13779,"_26422":55246,"_2810":55466},[],"Every deployment",{"_3322":2633,"_29027":2559,"_20151":55468,"_5":13779,"_26422":55246,"_2810":55469},[],"High: without a bootstrap principal there is no administrator",{"_3322":2634,"_29027":2559,"_20151":55471,"_5":13779,"_26422":55246,"_2810":55472},[],"Configure `services.authz`",{"_3322":2635,"_29027":2559,"_20151":55474,"_5":13779,"_26422":55246,"_2810":55267},[],{"_3322":2636,"_29027":2559,"_20151":55476,"_5":13779,"_26422":55246,"_2810":55455},[],{"_3322":2637,"_29027":2559,"_20151":55478,"_5":13779,"_26422":55246,"_2810":55479},[],"High: `helm upgrade` fails on the old keys",{"_3322":2638,"_29027":2559,"_20151":55481,"_5":13779,"_26422":55246,"_2810":55482},[],"Move JWKS and roles into `services.authz`",{"_3322":2639,"_29027":2559,"_20151":55484,"_5":13779,"_26422":55246,"_2810":55287},[],{"_3322":2640,"_29027":2559,"_20151":55486,"_5":13779,"_26422":55246,"_2810":55487},[],"3.8.0 deployments with per-service databases",{"_3322":2641,"_29027":2559,"_20151":55489,"_5":13779,"_26422":55246,"_2810":55490},[],"High: services find no data, or a migration aborts",{"_3322":2642,"_29027":2559,"_20151":55492,"_5":13779,"_26422":55246,"_2810":55493},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3322":2643,"_29027":2559,"_20151":55495,"_5":13779,"_26422":55246,"_2810":55291},[],{"_3322":2644,"_29027":2559,"_20151":55497,"_5":13779,"_26422":55246,"_2810":55498},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3322":2645,"_29027":2559,"_20151":55500,"_5":13779,"_26422":55246,"_2810":55501},[],"High: the backend no longer starts with them",{"_3322":2646,"_29027":2559,"_20151":55503,"_5":13779,"_26422":55246,"_2810":55504},[],"Move to PostgreSQL before upgrading",{"_3322":2647,"_29027":2559,"_20151":55506,"_5":13779,"_26422":55246,"_2810":55507},[],"Webhooks with file references",{"_3322":2648,"_29027":2559,"_20151":55509,"_5":13779,"_26422":55246,"_2810":55510},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3322":2649,"_29027":2559,"_20151":55512,"_5":13779,"_26422":55246,"_2810":55513},[],"High: enrollments calling the webhook fail",{"_3322":2650,"_29027":2559,"_20151":55515,"_5":13779,"_26422":55246,"_2810":55516},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3322":2651,"_29027":2559,"_20151":55518,"_5":13779,"_26422":55246,"_2810":55271},[],{"_3322":2652,"_29027":2559,"_20151":55520,"_5":13779,"_26422":55246,"_2810":55521},[],"Releases with per-service identity overrides or mounted key material",{"_3322":2653,"_29027":2559,"_20151":55523,"_5":13779,"_26422":55246,"_2810":55524},[],"Medium: services cannot read their files",{"_3322":2654,"_29027":2559,"_20151":55526,"_5":13779,"_26422":55246,"_2810":55527},[],"Remove the overrides and fix volume ownership",{"_3322":2655,"_29027":2559,"_20151":55529,"_5":13779,"_26422":55246,"_2810":55275},[],{"_3322":2656,"_29027":2559,"_20151":55531,"_5":13779,"_26422":55246,"_2810":55532},[],"Releases that set `amqp.tls`",{"_3322":2657,"_29027":2559,"_20151":55534,"_5":13779,"_26422":55246,"_2810":55535},[],"Medium: clients connect to the wrong port",{"_3322":2658,"_29027":2559,"_20151":55537,"_5":13779,"_26422":55246,"_2810":55538},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3322":2659,"_29027":2559,"_20151":55540,"_5":13779,"_26422":55246,"_2810":55295},[],{"_3322":2660,"_29027":2559,"_20151":55542,"_5":13779,"_26422":55246,"_2810":55543},[],"Installations whose CA keys predate the KMS",{"_3322":2661,"_29027":2559,"_20151":55545,"_5":13779,"_26422":55246,"_2810":55546},[],"Medium: CA keys stay unmanaged",{"_3322":2662,"_29027":2559,"_20151":55548,"_5":13779,"_26422":55246,"_2810":55549},[],"Run the CA-to-KMS migration",{"_3322":2663,"_29027":2559,"_20151":55551,"_5":13779,"_26422":55246,"_2810":55552},[],"Receiver certificate verification",{"_3322":2664,"_29027":2559,"_20151":55554,"_5":13779,"_26422":55246,"_2810":55555},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3322":2665,"_29027":2559,"_20151":55557,"_5":13779,"_26422":55246,"_2810":55558},[],"Medium: credentials go to an unverified receiver",{"_3322":2666,"_29027":2559,"_20151":55560,"_5":13779,"_26422":55246,"_2810":55561},[],"Set `insecure_skip_verify` to `false`",{"_3322":2667,"_29027":2559,"_20151":55563,"_5":13779,"_26422":55246,"_2810":55307},[],{"_3322":2668,"_29027":2559,"_20151":55565,"_5":13779,"_26422":55246,"_2810":55566},[],"Scripts and consoles that edit DMSs through the API",{"_3322":2669,"_29027":2559,"_20151":55568,"_5":13779,"_26422":55246,"_2810":55569},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3322":2670,"_29027":2559,"_20151":55571,"_5":13779,"_26422":55246,"_2810":55572},[],"Read the DMS before editing and use the new field",{"_3322":2671,"_29027":2559,"_20151":55574,"_5":13779,"_26422":55246,"_2810":55323},[],{"_3322":2672,"_29027":2559,"_20151":55576,"_5":13779,"_26422":55246,"_2810":55577},[],"Consumers that read the device `events` field",{"_3322":2673,"_29027":2559,"_20151":55579,"_5":13779,"_26422":55246,"_2810":55580},[],"Medium: the field disappears",{"_3322":2674,"_29027":2559,"_20151":55582,"_5":13779,"_26422":55246,"_2810":55583},[],"Use the new event endpoints",{"_3322":2675,"_29027":2559,"_20151":55585,"_5":13779,"_26422":55246,"_2810":55279},[],{"_3322":2676,"_29027":2559,"_20151":55587,"_5":13779,"_26422":55246,"_2810":55588},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3322":2677,"_29027":2559,"_20151":55590,"_5":13779,"_26422":55246,"_2810":55591},[],"Low to medium: validation errors or changed defaults",{"_3322":2678,"_29027":2559,"_20151":55593,"_5":13779,"_26422":55246,"_2810":55594},[],"Update the values file",{"_3322":2679,"_29027":2559,"_20151":55596,"_5":13779,"_26422":55246,"_2810":55315},[],{"_3322":2680,"_29027":2559,"_20151":55598,"_5":13779,"_26422":55246,"_2810":55599},[],"Clients that send the DMS ID in the update body",{"_3322":2681,"_29027":2559,"_20151":55601,"_5":13779,"_26422":55246,"_2810":55602},[],"Low: the ID in the URL wins",{"_3322":2682,"_29027":2559,"_20151":55604,"_5":13779,"_26422":55246,"_2810":55605},[],"Send the ID in the URL",{"_3322":2683,"_29027":2559,"_20151":55607,"_5":13779,"_26422":55246,"_2810":55319},[],{"_3322":2684,"_29027":2559,"_20151":55609,"_5":13779,"_26422":55246,"_2810":55610},[],"Consumers that match on certificate `type`",{"_3322":2685,"_29027":2559,"_20151":55612,"_5":13779,"_26422":55246,"_2810":55613},[],"Low: two values are renamed",{"_3322":2686,"_29027":2559,"_20151":55615,"_5":13779,"_26422":55246,"_2810":55616},[],"Adapt consumers",{"_3322":2687,"_29027":2559,"_20151":55618,"_5":13779,"_26422":55246,"_2810":55311},[],{"_3322":2688,"_29027":2559,"_20151":55620,"_5":13779,"_26422":55246,"_2810":55621},[],"Any DMS",{"_3322":2689,"_29027":2559,"_20151":55623,"_5":13779,"_26422":55246,"_2810":55624},[],"Low: informational",{"_3322":2690,"_29027":2559,"_20151":55626,"_5":13779,"_26422":55246,"_2810":55627},[],"Read both blocks before editing",{"_3322":2691,"_29027":2559,"_20151":55629,"_5":13779,"_26422":55254,"_2810":55630},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3322":2692,"_29027":2559,"_20151":55632,"_5":13779,"_26422":55254,"_2810":55633},[],"Step 4 of the migration guide copies the data.",{"_3322":2693,"_29027":2559,"_20151":55635,"_5":13779,"_26422":55258,"_2810":55636},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3322":2694,"_29027":2559,"_20151":55638,"_5":13779,"_26422":55262,"_2810":55639},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3322":2695,"_29027":2559,"_20151":55641,"_5":13779,"_26422":55266,"_2810":55642},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3322":2696,"_29027":2559,"_20151":55644,"_5":13779,"_26422":55270,"_2810":55645},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3322":2697,"_29027":2559,"_20151":55647,"_5":13779,"_26422":55270,"_2810":55648},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3322":2698,"_29027":2559,"_20151":55650,"_5":13779,"_26422":55274,"_2810":55651},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3322":2699,"_29027":2559,"_20151":55653,"_5":13779,"_26422":55278,"_2810":55654},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3322":2700,"_29027":2559,"_20151":55656,"_5":13779,"_26422":55278,"_2810":55657},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3322":2701,"_29027":2559,"_20151":55659,"_5":13779,"_26422":55278,"_2810":55660},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3322":2702,"_29027":2559,"_20151":55662,"_5":13779,"_26422":55278,"_2810":55663},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3322":2703,"_29027":2559,"_20151":55665,"_5":13779,"_26422":55278,"_2810":55666},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3322":2704,"_29027":2559,"_20151":55668,"_5":13779,"_26422":55278,"_2810":55669},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3322":2705,"_29027":2559,"_20151":55671,"_5":13779,"_26422":55286,"_2810":55672},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3322":2706,"_29027":2559,"_20151":55674,"_5":13779,"_26422":55286,"_2810":55675},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3322":2707,"_29027":2559,"_20151":55677,"_5":13779,"_26422":55286,"_2810":55678},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3322":2708,"_29027":2559,"_20151":55680,"_5":13779,"_26422":55286,"_2810":55681},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3322":2709,"_29027":2559,"_20151":55683,"_5":13779,"_26422":55286,"_2810":55684},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3322":2710,"_29027":2559,"_20151":55686,"_5":13779,"_26422":55290,"_2810":55687},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3322":2711,"_29027":2559,"_20151":55689,"_5":13779,"_26422":55294,"_2810":55690},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3322":2712,"_29027":2559,"_20151":55692,"_5":13779,"_26422":55294,"_2810":55693},[],"The `key_id` is the certificate's `subject_key_id` (SHA-256 of the public key).",{"_3322":2713,"_29027":2559,"_20151":55695,"_5":13779,"_26422":55294,"_2810":55696},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3322":2714,"_29027":2559,"_20151":55698,"_5":13779,"_26422":55294,"_2810":55699},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3322":2715,"_29027":2559,"_20151":55701,"_5":13779,"_26422":55294,"_2810":55702},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3322":2716,"_29027":2559,"_20151":55704,"_5":13779,"_26422":55294,"_2810":55705},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3322":2717,"_29027":2559,"_20151":55707,"_5":13779,"_26422":55302,"_2810":55708},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3322":2718,"_29027":2559,"_20151":55710,"_5":13779,"_26422":55302,"_2810":55711},[],"Field in 3.8.0",{"_3322":2719,"_29027":2559,"_20151":55713,"_5":13779,"_26422":55302,"_2810":55714},[],"Field in 4.0.0",{"_3322":2720,"_29027":2559,"_20151":55716,"_5":13779,"_26422":55302,"_2810":55717},[],"`validate_server_cert`",{"_3322":2721,"_29027":2559,"_20151":55719,"_5":13779,"_26422":55302,"_2810":55720},[],"`insecure_skip_verify` (value negated)",{"_3322":2722,"_29027":2559,"_20151":55722,"_5":13779,"_26422":55302,"_2810":55723},[],"`oidc`",{"_3322":2723,"_29027":2559,"_20151":55725,"_5":13779,"_26422":55302,"_2810":55726},[],"`jwt_options`",{"_3322":2724,"_29027":2559,"_20151":55728,"_5":13779,"_26422":55302,"_2810":55729},[],"`apikey`",{"_3322":2725,"_29027":2559,"_20151":55731,"_5":13779,"_26422":55302,"_2810":55732},[],"`apikey_options`",{"_3322":2726,"_29027":2559,"_20151":55734,"_5":13779,"_26422":55302,"_2810":55735},[],"`mtls`",{"_3322":2727,"_29027":2559,"_20151":55737,"_5":13779,"_26422":55302,"_2810":55738},[],"`mtls_options`",{"_3322":2728,"_29027":2559,"_20151":55740,"_5":13779,"_26422":55302,"_2810":55741},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3322":2729,"_29027":2559,"_20151":55743,"_5":13779,"_26422":55302,"_2810":55744},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3322":2730,"_29027":2559,"_20151":55746,"_5":13779,"_26422":55302,"_2810":55747},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3322":2731,"_29027":2559,"_20151":55749,"_5":13779,"_26422":55306,"_2810":55750},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3322":2732,"_29027":2559,"_20151":55752,"_5":13779,"_26422":55306,"_2810":55753},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3322":2733,"_29027":2559,"_20151":55755,"_5":13779,"_26422":55306,"_2810":55756},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3322":2734,"_29027":2559,"_20151":55758,"_5":13779,"_26422":55310,"_2810":55759},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3322":2735,"_29027":2559,"_20151":55761,"_5":13779,"_26422":55314,"_2810":55762},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3322":2736,"_29027":2559,"_20151":55764,"_5":13779,"_26422":55318,"_2810":55765},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3322":2737,"_29027":2559,"_20151":55767,"_5":13779,"_26422":55322,"_2810":55768},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3322":2738,"_29027":2559,"_20151":55770,"_5":13779,"_26422":55322,"_2810":55771},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3322":2739,"_29027":2559,"_20151":55773,"_5":13779,"_26422":55322,"_2810":55774},[],"`POST /v1/devices/:id/events` creates an event.",{"_3322":2740,"_29027":2559,"_20151":55776,"_5":13779,"_26422":55322,"_2810":55777},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3322":2741,"_29027":2559,"_20151":55779,"_5":13779,"_26422":55326,"_2810":55780},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3322":2742,"_29027":2559,"_20151":55782,"_5":13779,"_26422":55330,"_2810":55783},[],"Take a verifiable backup of PostgreSQL and schedule downtime. The upgrade moves every service's data into `pki`.",{"_3322":2743,"_29027":2559,"_20151":55785,"_5":13779,"_26422":55330,"_2810":55786},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3322":2744,"_29027":2559,"_20151":55788,"_5":13779,"_26422":55330,"_2810":55789},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3322":2745,"_29027":2559,"_20151":55791,"_5":13779,"_26422":55330,"_2810":55792},[],"Record the names of your local-storage PVCs:",{"_3322":2746,"_29027":2559,"_20151":55794,"_5":13779,"_26422":55330,"_2810":55795},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3322":2747,"_29027":2559,"_20151":55797,"_5":13779,"_26422":55334,"_2810":55798},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3322":2748,"_29027":2559,"_20151":55800,"_5":13779,"_26422":55334,"_2810":55801},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3322":2749,"_29027":2559,"_20151":55803,"_5":13779,"_26422":55334,"_2810":55804},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is read; the connection always uses the global `postgres.hostname`, `postgres.port`, `postgres.username` and `postgres.password` values.",{"_3322":2750,"_29027":2559,"_20151":55806,"_5":13779,"_26422":55334,"_2810":55807},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3322":2751,"_29027":2559,"_20151":55809,"_5":13779,"_26422":55334,"_2810":55810},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3322":2752,"_29027":2559,"_20151":55812,"_5":13779,"_26422":55334,"_2810":55813},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3322":2753,"_29027":2559,"_20151":55815,"_5":13779,"_26422":55334,"_2810":55816},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3322":2754,"_29027":2559,"_20151":55818,"_5":13779,"_26422":55334,"_2810":55819},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3322":2755,"_29027":2559,"_20151":55821,"_5":13779,"_26422":55334,"_2810":55822},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3322":2756,"_29027":2559,"_20151":55824,"_5":13779,"_26422":55334,"_2810":55825},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3322":2757,"_29027":2559,"_20151":55827,"_5":13779,"_26422":55334,"_2810":55828},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3322":2758,"_29027":2559,"_20151":55830,"_5":13779,"_26422":55334,"_2810":55831},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown.",{"_3322":2759,"_29027":2559,"_20151":55833,"_5":13779,"_26422":55338,"_2810":55834},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3322":2760,"_29027":2559,"_20151":55836,"_5":13779,"_26422":55338,"_2810":55837},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3322":2761,"_29027":2559,"_20151":55839,"_5":13779,"_26422":55342,"_2810":55840},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3322":2762,"_29027":2559,"_20151":55842,"_5":13779,"_26422":55342,"_2810":55843},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3322":2763,"_29027":2559,"_20151":55845,"_5":13779,"_26422":55342,"_2810":55846},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3322":2764,"_29027":2559,"_20151":55848,"_5":13779,"_26422":55342,"_2810":55849},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3322":2765,"_29027":2559,"_20151":55851,"_5":13779,"_26422":55342,"_2810":55852},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3322":2766,"_29027":2559,"_20151":55854,"_5":13779,"_26422":55342,"_2810":55855},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3322":2767,"_29027":2559,"_20151":55857,"_5":13779,"_26422":55342,"_2810":55858},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3322":2768,"_29027":2559,"_20151":55860,"_5":13779,"_26422":55342,"_2810":55861},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3322":2769,"_29027":2559,"_20151":55863,"_5":13779,"_26422":55342,"_2810":55864},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3322":2770,"_29027":2559,"_20151":55866,"_5":13779,"_26422":55342,"_2810":55867},[],"**Remove the helper and restore the recorded replica counts:**",{"_3322":2771,"_29027":2559,"_20151":55869,"_5":13779,"_26422":55342,"_2810":55870},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3322":2772,"_29027":2559,"_20151":55872,"_5":13779,"_26422":55346,"_2810":55873},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3322":2773,"_29027":2559,"_20151":55875,"_5":13779,"_26422":55346,"_2810":55876},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3322":2774,"_29027":2559,"_20151":55878,"_5":13779,"_26422":55350,"_2810":55879},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3322":2775,"_29027":2559,"_20151":55881,"_5":13779,"_26422":55350,"_2810":55882},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3322":2776,"_29027":2559,"_20151":55884,"_5":13779,"_26422":55350,"_2810":55885},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3322":2777,"_29027":2559,"_20151":55887,"_5":13779,"_26422":55350,"_2810":55888},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3322":2778,"_29027":2559,"_20151":55890,"_5":13779,"_26422":55350,"_2810":55891},[],"The `goose-lamassu` README still shows per-database examples (`dbname=ca`, `dbname=kms`) and claims the tool validates the database name, and the `ca-to-kms-migration` README still describes the pre-4.0.0 two-database layout. Follow the `dbname=pki` form on this page instead of their examples.",{"_3322":2779,"_29027":2559,"_20151":55893,"_5":13779,"_26422":55354,"_2810":55894},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3322":2780,"_29027":2559,"_20151":55896,"_5":13779,"_26422":55354,"_2810":55897},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3322":2781,"_29027":2559,"_20151":55899,"_5":13779,"_26422":55354,"_2810":55900},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3322":2782,"_29027":2559,"_20151":55902,"_5":13779,"_26422":55354,"_2810":55903},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3322":2783,"_29027":2559,"_20151":55905,"_5":13779,"_26422":55354,"_2810":55906},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted on duplicate CA IDs or missing `engine_id` values. Check the job logs, fix the privileges or the data, and re-run the upgrade.",{"_3322":2784,"_29027":2559,"_20151":55908,"_5":13779,"_26422":55354,"_2810":55909},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3322":2785,"_29027":2559,"_20151":55911,"_5":13779,"_26422":55354,"_2810":55912},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3322":2786,"_29027":2559,"_20151":55914,"_5":13779,"_26422":55357,"_2810":55915},[],"After the upgrade, check in this order:",{"_3322":2787,"_29027":2559,"_20151":55917,"_5":13779,"_26422":55357,"_2810":55918},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations.",{"_3322":2788,"_29027":2559,"_20151":55920,"_5":13779,"_26422":55357,"_2810":55921},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3322":2789,"_29027":2559,"_20151":55923,"_5":13779,"_26422":55357,"_2810":55924},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3322":2790,"_29027":2559,"_20151":55926,"_5":13779,"_26422":55357,"_2810":55927},[],"**Existing CRLs are served.** `GET /crl/<ca-ski>` on VA returns a previously issued CRL, and new CRLs are issued.",{"_3322":2791,"_29027":2559,"_20151":55929,"_5":13779,"_26422":55357,"_2810":55930},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS.",{"_3322":2792,"_29027":2559,"_20151":55932,"_5":13779,"_26422":55357,"_2810":55933},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3322":2793,"_29027":2559,"_20151":55935,"_5":13779,"_26422":55357,"_2810":55936},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3322":2794,"_29027":2559,"_20151":55938,"_5":13779,"_26422":55357,"_2810":55939},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3322":2795,"_29027":2559,"_20151":55941,"_5":13779,"_26422":55357,"_2810":55942},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3322":2796,"_29027":2559,"_20151":55944,"_5":13779,"_26422":55357,"_2810":55945},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3322":2797,"_29027":2559,"_20151":55947,"_5":13779,"_26422":55357,"_2810":55948},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3322":2798,"_29027":2559,"_20151":55950,"_5":13779,"_26422":55357,"_2810":55951},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3322":2799,"_29027":2559,"_20151":55953,"_5":13779,"_26422":55357,"_2810":55954},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3322":2800,"_29027":2559,"_20151":55956,"_5":13779,"_26422":55357,"_2810":55957},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3322":2801,"_29027":2559,"_20151":55959,"_5":13779,"_26422":55361,"_2810":55960},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3322":2802,"_29027":2559,"_20151":55962,"_5":13779,"_26422":55361,"_2810":55963},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3322":2803,"_29027":2559,"_20151":55965,"_5":13779,"_26422":55361,"_2810":55966},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3322":2804,"_29027":2559,"_20151":55968,"_5":13779,"_26422":55361,"_2810":55969},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3322":2805,"_29027":2559,"_20151":55971,"_5":13779,"_26422":55361,"_2810":55972},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_55975":55976,"_55977":55978,"_55979":55980,"_55981":55982,"_17436":2832,"_67160":2832},"language","english","sortableProperties",[2810,29027,5,26422],"sortablePropertiesWithTypes",{"_2810":24064,"_29027":24064,"_5":24064,"_26422":24064},"sorts",{"_2810":55983,"_29027":58778,"_5":61572,"_26422":64366},{"_4463":55984,"_55985":55986,"_5":24064},{"_13861":4919,"_14237":4259,"_14256":4604,"_12435":3157,"_14243":7141,"_19128":9756,"_13882":3288,"_13889":7257,"_28009":13662,"_28417":14295,"_28438":4219,"_28043":3017,"_33227":4525,"_28145":13753,"_28482":4800,"_33234":14334,"_33237":19362,"_33240":4884,"_33243":23379,"_28859":15371,"_33248":10885,"_33250":7134,"_28889":6166,"_14252":8163,"_33254":7254,"_33257":3617,"_33259":4593,"_28466":3207,"_28854":7284,"_28902":4224,"_33264":7305,"_33266":8167,"_33268":4196,"_28162":2909,"_33271":19364,"_33273":7212,"_33275":3844,"_33277":3512,"_33279":7031,"_28079":5100,"_33282":5343,"_33284":5286,"_28073":11148,"_28503":6866,"_33288":5563,"_33290":7125,"_33293":2904,"_28119":7268,"_33297":11745,"_28000":5712,"_33300":8989,"_28048":5251,"_33303":4569,"_33305":6645,"_33308":12812,"_14246":16229,"_33311":8169,"_33313":3917,"_33316":6969,"_33318":5715,"_33320":11785,"_33322":4467,"_33324":3796,"_1913