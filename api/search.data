5":59788,"_41227":59791,"_41229":59794,"_41231":59797,"_41233":59800,"_41235":59803,"_41237":59806,"_41240":59809,"_41242":59812,"_41244":59815,"_41246":59818,"_41248":59821,"_41250":59824,"_41252":59827,"_41254":59830,"_41256":59833,"_41258":59836,"_41260":59839,"_41262":59842,"_41264":59845,"_41266":59848,"_41268":59851,"_41270":59854,"_41272":59857,"_41274":59860,"_41276":59863,"_41278":59866,"_41280":59869,"_41282":59872,"_41284":59875,"_41286":59878,"_41288":59881,"_41290":59884,"_41292":59887,"_41294":59890,"_41296":59892,"_41298":59894,"_41300":59897,"_41302":59899,"_41304":59902,"_41306":59905,"_41308":59908,"_41310":59911,"_41312":59914,"_41314":59917,"_41316":59920,"_41318":59923,"_41320":59926,"_41322":59929,"_41324":59932,"_41326":59935,"_41328":59938,"_41330":59941,"_41332":59944,"_41334":59947,"_41336":59950,"_41338":59953,"_41340":59956,"_41342":59959,"_41345":59962,"_41347":59965,"_41349":59968,"_41351":59971,"_41353":59974,"_41355":59977,"_41357":59980,"_41359":59983,"_41361":59986,"_41363":59989,"_41365":59992,"_41367":59995,"_41369":59998,"_41371":60001,"_41374":60004,"_41376":60007,"_41378":60010,"_41380":60013,"_41382":60016,"_41384":60019,"_41386":60022,"_41388":60025,"_41390":60028,"_41392":60031,"_41394":60034,"_41396":60037,"_41398":60040,"_41400":60043,"_41402":60046,"_41404":60049,"_41406":60052,"_41408":60055,"_41410":60058,"_41412":60061,"_41414":60064,"_41416":60067,"_41418":60070,"_41420":60073,"_41422":60076,"_41424":60079,"_41426":60082,"_41428":60085,"_41430":60088,"_41432":60091,"_41434":60094,"_41436":60097,"_41439":60100,"_41441":60103,"_41443":60106,"_41445":60109},{"_3603":15,"_31001":15,"_5":15118,"_3059":50641,"_31339":50642,"_21481":50646,"_28188":15},"Deploy from AWS Marketplace",[50643,50644,50645],"Docs","Deployment","Other models",[],{"_3603":16,"_31001":15,"_21481":50648,"_5":14758,"_28188":15,"_3059":50649},[],"Run a preconfigured Lamassu IoT instance on Amazon EC2.",{"_3603":17,"_31001":15,"_5":31336,"_21481":50651,"_28188":50652,"_3059":50653},[],"/docs/deployment/aws-marketplace#before-you-begin","Before you begin",{"_3603":18,"_31001":15,"_5":31336,"_21481":50655,"_28188":50656,"_3059":50657},[],"/docs/deployment/aws-marketplace#infrastructure-requirements","Infrastructure requirements",{"_3603":19,"_31001":15,"_5":31336,"_21481":50659,"_28188":50660,"_3059":50661},[],"/docs/deployment/aws-marketplace#open-the-offer","Open the offer",{"_3603":20,"_31001":15,"_5":31336,"_21481":50663,"_28188":50664,"_3059":50665},[],"/docs/deployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3603":21,"_31001":15,"_5":31336,"_21481":50667,"_28188":50668,"_3059":50669},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3603":22,"_31001":15,"_5":31336,"_21481":50671,"_28188":50672,"_3059":50673},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3603":23,"_31001":15,"_5":31336,"_21481":50675,"_28188":50676,"_3059":50677},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3603":24,"_31001":15,"_21481":50679,"_5":14758,"_28188":15,"_3059":50680},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3603":25,"_31001":15,"_21481":50682,"_5":14758,"_28188":50652,"_3059":50683},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3603":26,"_31001":15,"_21481":50685,"_5":14758,"_28188":50652,"_3059":50686},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3603":27,"_31001":15,"_21481":50688,"_5":14758,"_28188":50652,"_3059":50689},[],"A security group allowing the necessary endpoints.",{"_3603":28,"_31001":15,"_21481":50691,"_5":14758,"_28188":50656,"_3059":50692},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3603":29,"_31001":15,"_21481":50694,"_5":14758,"_28188":50656,"_3059":50695},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3603":30,"_31001":15,"_21481":50697,"_5":14758,"_28188":50656,"_3059":50698},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3603":31,"_31001":15,"_21481":50700,"_5":14758,"_28188":50660,"_3059":50701},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3603":32,"_31001":15,"_21481":50703,"_5":14758,"_28188":50664,"_3059":50704},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3603":33,"_31001":15,"_21481":50706,"_5":14758,"_28188":50668,"_3059":50707},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3603":34,"_31001":15,"_21481":50709,"_5":14758,"_28188":50672,"_3059":50710},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3603":35,"_31001":15,"_21481":50712,"_5":14758,"_28188":50676,"_3059":50713},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3603":36,"_31001":36,"_5":15118,"_3059":50715,"_31339":50716,"_21481":50717,"_28188":36},"Deploy Lamassu",[50643,50644],[],{"_3603":37,"_31001":36,"_21481":50719,"_5":14758,"_28188":36,"_3059":50720},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3603":38,"_31001":36,"_5":31336,"_21481":50722,"_28188":50723,"_3059":50724},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3603":39,"_31001":36,"_5":31336,"_21481":50726,"_28188":50727,"_3059":50728},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3603":40,"_31001":36,"_5":31336,"_21481":50730,"_28188":50731,"_3059":50732},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3603":41,"_31001":36,"_21481":50734,"_5":14758,"_28188":36,"_3059":50735},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3603":42,"_31001":36,"_21481":50737,"_5":14758,"_28188":50723,"_3059":50738},[],"Model",{"_3603":43,"_31001":36,"_21481":50740,"_5":14758,"_28188":50723,"_3059":50741},[],"Recommended for",{"_3603":44,"_31001":36,"_21481":50743,"_5":14758,"_28188":50723,"_3059":50744},[],"Who operates the infrastructure",{"_3603":45,"_31001":36,"_21481":50746,"_5":14758,"_28188":50723,"_3059":50747},[],"Starting point",{"_3603":46,"_31001":36,"_21481":50749,"_5":14758,"_28188":50723,"_3059":50750},[],"Kubernetes self-managed",{"_3603":47,"_31001":36,"_21481":50752,"_5":14758,"_28188":50723,"_3059":50753},[],"Production, regulated environments and custom deployments",{"_3603":48,"_31001":36,"_21481":50755,"_5":14758,"_28188":50723,"_3059":50756},[],"Your team",{"_3603":49,"_31001":36,"_21481":50758,"_5":14758,"_28188":50723,"_3059":50759},[],"Helm or Fastlane",{"_3603":50,"_31001":36,"_21481":50761,"_5":14758,"_28188":50723,"_3059":50762},[],"AWS Marketplace",{"_3603":51,"_31001":36,"_21481":50764,"_5":14758,"_28188":50723,"_3059":50765},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3603":52,"_31001":36,"_21481":50767,"_5":14758,"_28188":50723,"_3059":50756},[],{"_3603":53,"_31001":36,"_21481":50769,"_5":14758,"_28188":50723,"_3059":50770},[],"Preconfigured image on EC2",{"_3603":54,"_31001":36,"_21481":50772,"_5":14758,"_28188":50723,"_3059":50773},[],"SaaS",{"_3603":55,"_31001":36,"_21481":50775,"_5":14758,"_28188":50723,"_3059":50776},[],"Teams that want to use the platform without operating it",{"_3603":56,"_31001":36,"_21481":50778,"_5":14758,"_28188":50723,"_3059":50779},[],"Lamassu",{"_3603":57,"_31001":36,"_21481":50781,"_5":14758,"_28188":50723,"_3059":50782},[],"Managed subscription",{"_3603":58,"_31001":36,"_21481":50784,"_5":14758,"_28188":50723,"_3059":50785},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3603":59,"_31001":36,"_21481":50787,"_5":14758,"_28188":50723,"_3059":50788},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3603":60,"_31001":36,"_21481":50790,"_5":14758,"_28188":50723,"_3059":50791},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3603":61,"_31001":36,"_21481":50793,"_5":14758,"_28188":50727,"_3059":50794},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3603":62,"_31001":36,"_21481":50796,"_5":14758,"_28188":50731,"_3059":50797},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3603":63,"_31001":63,"_5":15118,"_3059":50799,"_31339":50800,"_21481":50801,"_28188":63},"Use Lamassu as SaaS",[50643,50644,50645],[],{"_3603":64,"_31001":63,"_21481":50803,"_5":14758,"_28188":63,"_3059":50804},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3603":65,"_31001":63,"_5":31336,"_21481":50806,"_28188":50807,"_3059":50808},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3603":66,"_31001":63,"_5":31336,"_21481":50810,"_28188":50811,"_3059":50812},[],"/docs/deployment/saas#plans","Plans",{"_3603":67,"_31001":63,"_5":31336,"_21481":50814,"_28188":50815,"_3059":50816},[],"/docs/deployment/saas#request-access","Request access",{"_3603":68,"_31001":63,"_21481":50818,"_5":14758,"_28188":63,"_3059":50819},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3603":69,"_31001":63,"_21481":50821,"_5":14758,"_28188":50807,"_3059":50822},[],"Platform availability and maintenance.",{"_3603":70,"_31001":63,"_21481":50824,"_5":14758,"_28188":50807,"_3059":50825},[],"Automatic backups.",{"_3603":71,"_31001":63,"_21481":50827,"_5":14758,"_28188":50807,"_3059":50828},[],"Version upgrades.",{"_3603":72,"_31001":63,"_21481":50830,"_5":14758,"_28188":50807,"_3059":50831},[],"Technical support and SLA according to your plan.",{"_3603":73,"_31001":63,"_21481":50833,"_5":14758,"_28188":50811,"_3059":50834},[],"Plan",{"_3603":74,"_31001":63,"_21481":50836,"_5":14758,"_28188":50811,"_3059":50837},[],"Devices",{"_3603":75,"_31001":63,"_21481":50839,"_5":14758,"_28188":50811,"_3059":50840},[],"Support",{"_3603":76,"_31001":63,"_21481":50842,"_5":14758,"_28188":50811,"_3059":50843},[],"SLA",{"_3603":77,"_31001":63,"_21481":50845,"_5":14758,"_28188":50811,"_3059":50846},[],"Starter",{"_3603":78,"_31001":63,"_21481":50848,"_5":14758,"_28188":50811,"_3059":50849},[],"Up to 1,000",{"_3603":79,"_31001":63,"_21481":50851,"_5":14758,"_28188":50811,"_3059":50852},[],"Email",{"_3603":80,"_31001":63,"_21481":50854,"_5":14758,"_28188":50811,"_3059":50855},[],"99.5 %",{"_3603":81,"_31001":63,"_21481":50857,"_5":14758,"_28188":50811,"_3059":50858},[],"Professional",{"_3603":82,"_31001":63,"_21481":50860,"_5":14758,"_28188":50811,"_3059":50861},[],"Up to 10,000",{"_3603":83,"_31001":63,"_21481":50863,"_5":14758,"_28188":50811,"_3059":50864},[],"Email and chat",{"_3603":84,"_31001":63,"_21481":50866,"_5":14758,"_28188":50811,"_3059":50867},[],"99.9 %",{"_3603":85,"_31001":63,"_21481":50869,"_5":14758,"_28188":50811,"_3059":50870},[],"Enterprise",{"_3603":86,"_31001":63,"_21481":50872,"_5":14758,"_28188":50811,"_3059":50873},[],"Unlimited",{"_3603":87,"_31001":63,"_21481":50875,"_5":14758,"_28188":50811,"_3059":50876},[],"Dedicated",{"_3603":88,"_31001":63,"_21481":50878,"_5":14758,"_28188":50811,"_3059":50879},[],"99.99 %",{"_3603":89,"_31001":63,"_21481":50881,"_5":14758,"_28188":50815,"_3059":50882},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3603":90,"_31001":63,"_21481":50884,"_5":14758,"_28188":50815,"_3059":50885},[],"When you receive your instance's credentials, continue with Get started.",{"_3603":91,"_31001":91,"_5":15118,"_3059":50887,"_31339":50888,"_21481":50889,"_28188":91},"Fastlane",[50643,50644,50750],[],{"_3603":92,"_31001":91,"_21481":50891,"_5":14758,"_28188":91,"_3059":50892},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3603":93,"_31001":91,"_5":31336,"_21481":50894,"_28188":50895,"_3059":50896},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3603":94,"_31001":91,"_5":31336,"_21481":50898,"_28188":50899,"_3059":50900},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3603":95,"_31001":91,"_5":31336,"_21481":50902,"_28188":50903,"_3059":50653},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3603":96,"_31001":91,"_5":31336,"_21481":50905,"_28188":50906,"_3059":50907},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3603":97,"_31001":91,"_5":31336,"_21481":50909,"_28188":50910,"_3059":50911},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3603":98,"_31001":91,"_5":31336,"_21481":50913,"_28188":50914,"_3059":50915},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3603":99,"_31001":91,"_5":31336,"_21481":50917,"_28188":50918,"_3059":50919},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3603":100,"_31001":91,"_5":31336,"_21481":50921,"_28188":50922,"_3059":50923},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3603":101,"_31001":91,"_5":31336,"_21481":50925,"_28188":50926,"_3059":50927},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3603":102,"_31001":91,"_5":31336,"_21481":50929,"_28188":50930,"_3059":50931},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3603":103,"_31001":91,"_5":31336,"_21481":50933,"_28188":50934,"_3059":50935},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3603":104,"_31001":91,"_21481":50937,"_5":14758,"_28188":50895,"_3059":50938},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3603":105,"_31001":91,"_21481":50940,"_5":14758,"_28188":50895,"_3059":50941},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3603":106,"_31001":91,"_21481":50943,"_5":14758,"_28188":50899,"_3059":50944},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3603":107,"_31001":91,"_21481":50946,"_5":14758,"_28188":50899,"_3059":50947},[],"Fastlane installs or configures",{"_3603":108,"_31001":91,"_21481":50949,"_5":14758,"_28188":50899,"_3059":50950},[],"You still provide",{"_3603":109,"_31001":91,"_21481":50952,"_5":14758,"_28188":50899,"_3059":50953},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3603":110,"_31001":91,"_21481":50955,"_5":14758,"_28188":50899,"_3059":50956},[],"The Kubernetes cluster, nodes and persistent storage",{"_3603":111,"_31001":91,"_21481":50958,"_5":14758,"_28188":50899,"_3059":50959},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3603":112,"_31001":91,"_21481":50961,"_5":14758,"_28188":50899,"_3059":50962},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3603":113,"_31001":91,"_21481":50964,"_5":14758,"_28188":50899,"_3059":50965},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3603":114,"_31001":91,"_21481":50967,"_5":14758,"_28188":50899,"_3059":50968},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3603":115,"_31001":91,"_21481":50970,"_5":14758,"_28188":50899,"_3059":50971},[],"Optional observability and lab HSM components",{"_3603":116,"_31001":91,"_21481":50973,"_5":14758,"_28188":50899,"_3059":50974},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3603":117,"_31001":91,"_21481":50976,"_5":14758,"_28188":50899,"_3059":50977},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3603":118,"_31001":91,"_21481":50979,"_5":14758,"_28188":50903,"_3059":50980},[],"You need:",{"_3603":119,"_31001":91,"_21481":50982,"_5":14758,"_28188":50903,"_3059":50983},[],"an existing Kubernetes cluster",{"_3603":120,"_31001":91,"_21481":50985,"_5":14758,"_28188":50903,"_3059":50986},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3603":121,"_31001":91,"_21481":50988,"_5":14758,"_28188":50903,"_3059":50989},[],"`yq`",{"_3603":122,"_31001":91,"_21481":50991,"_5":14758,"_28188":50903,"_3059":24282},[],{"_3603":123,"_31001":91,"_21481":50993,"_5":14758,"_28188":50903,"_3059":50994},[],"`jq` only when using `--sample-data` or `--development`",{"_3603":124,"_31001":91,"_21481":50996,"_5":14758,"_28188":50903,"_3059":50997},[],"`ssh-keygen` only when using `--with-hsm`",{"_3603":125,"_31001":91,"_21481":50999,"_5":14758,"_28188":50903,"_3059":51000},[],"free external ports 80 and 443 on a single-node K3s host",{"_3603":126,"_31001":91,"_21481":51002,"_5":14758,"_28188":50903,"_3059":51003},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3603":127,"_31001":91,"_21481":51005,"_5":14758,"_28188":50903,"_3059":51006},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3603":128,"_31001":91,"_21481":51008,"_5":14758,"_28188":50906,"_3059":51009},[],"Run the script from a clone of the Helm repository:",{"_3603":129,"_31001":91,"_21481":51011,"_5":14758,"_28188":50906,"_3059":51012},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3603":130,"_31001":91,"_21481":51014,"_5":14758,"_28188":50910,"_3059":51015},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3603":131,"_31001":91,"_21481":51017,"_5":14758,"_28188":50910,"_3059":51018},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3603":132,"_31001":91,"_21481":51020,"_5":14758,"_28188":50910,"_3059":51021},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3603":133,"_31001":91,"_21481":51023,"_5":14758,"_28188":50910,"_3059":51024},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3603":134,"_31001":91,"_21481":51026,"_5":14758,"_28188":50914,"_3059":51027},[],"Option",{"_3603":135,"_31001":91,"_21481":51029,"_5":14758,"_28188":50914,"_3059":51030},[],"Default",{"_3603":136,"_31001":91,"_21481":51032,"_5":14758,"_28188":50914,"_3059":51033},[],"Purpose",{"_3603":137,"_31001":91,"_21481":51035,"_5":14758,"_28188":50914,"_3059":51036},[],"`-h`, `--help`",{"_3603":138,"_31001":91,"_21481":51038,"_5":14758,"_28188":50914,"_3059":51039},[],"—",{"_3603":139,"_31001":91,"_21481":51041,"_5":14758,"_28188":50914,"_3059":51042},[],"Show help",{"_3603":140,"_31001":91,"_21481":51044,"_5":14758,"_28188":50914,"_3059":51045},[],"`-c`, `--context`",{"_3603":141,"_31001":91,"_21481":51047,"_5":14758,"_28188":50914,"_3059":51048},[],"current context",{"_3603":142,"_31001":91,"_21481":51050,"_5":14758,"_28188":50914,"_3059":51051},[],"Select the kubeconfig context for kubectl and Helm",{"_3603":143,"_31001":91,"_21481":51053,"_5":14758,"_28188":50914,"_3059":51054},[],"`-n`, `--non-interactive`",{"_3603":144,"_31001":91,"_21481":51056,"_5":14758,"_28188":50914,"_3059":6761},[],{"_3603":145,"_31001":91,"_21481":51058,"_5":14758,"_28188":50914,"_3059":51059},[],"Skip prompts and generate dependency credentials",{"_3603":146,"_31001":91,"_21481":51061,"_5":14758,"_28188":50914,"_3059":51062},[],"`-ns`, `--namespace`",{"_3603":147,"_31001":91,"_21481":51064,"_5":14758,"_28188":50914,"_3059":51065},[],"`lamassu-dev`",{"_3603":148,"_31001":91,"_21481":51067,"_5":14758,"_28188":50914,"_3059":51068},[],"Namespace for the installation",{"_3603":149,"_31001":91,"_21481":51070,"_5":14758,"_28188":50914,"_3059":51071},[],"`-d`, `--domain`",{"_3603":150,"_31001":91,"_21481":51073,"_5":14758,"_28188":50914,"_3059":51074},[],"`dev.lamassu.io`",{"_3603":151,"_31001":91,"_21481":51076,"_5":14758,"_28188":50914,"_3059":51077},[],"Domain used by the UI, OIDC and certificate",{"_3603":152,"_31001":91,"_21481":51079,"_5":14758,"_28188":50914,"_3059":51080},[],"`-v`, `--version`",{"_3603":153,"_31001":91,"_21481":51082,"_5":14758,"_28188":50914,"_3059":15469},[],{"_3603":154,"_31001":91,"_21481":51084,"_5":14758,"_28188":50914,"_3059":51085},[],"Lamassu chart version",{"_3603":155,"_31001":91,"_21481":51087,"_5":14758,"_28188":50914,"_3059":51088},[],"`--https-port`",{"_3603":156,"_31001":91,"_21481":51090,"_5":14758,"_28188":50914,"_3059":51091},[],"`443`",{"_3603":157,"_31001":91,"_21481":51093,"_5":14758,"_28188":50914,"_3059":51094},[],"Gateway HTTPS listener port",{"_3603":158,"_31001":91,"_21481":51096,"_5":14758,"_28188":50914,"_3059":51097},[],"`--http-port`",{"_3603":159,"_31001":91,"_21481":51099,"_5":14758,"_28188":50914,"_3059":51100},[],"`80`",{"_3603":160,"_31001":91,"_21481":51102,"_5":14758,"_28188":50914,"_3059":51103},[],"Gateway HTTP listener port",{"_3603":161,"_31001":91,"_21481":51105,"_5":14758,"_28188":50914,"_3059":51106},[],"`--tls-crt`",{"_3603":162,"_31001":91,"_21481":51108,"_5":14758,"_28188":50914,"_3059":51039},[],{"_3603":163,"_31001":91,"_21481":51110,"_5":14758,"_28188":50914,"_3059":51111},[],"PEM certificate for downstream TLS",{"_3603":164,"_31001":91,"_21481":51113,"_5":14758,"_28188":50914,"_3059":51114},[],"`--tls-key`",{"_3603":165,"_31001":91,"_21481":51116,"_5":14758,"_28188":50914,"_3059":51039},[],{"_3603":166,"_31001":91,"_21481":51118,"_5":14758,"_28188":50914,"_3059":51119},[],"PEM private key for downstream TLS",{"_3603":167,"_31001":91,"_21481":51121,"_5":14758,"_28188":50914,"_3059":51122},[],"`-l`, `--local-chart-path`",{"_3603":168,"_31001":91,"_21481":51124,"_5":14758,"_28188":50914,"_3059":51125},[],"repository chart",{"_3603":169,"_31001":91,"_21481":51127,"_5":14758,"_28188":50914,"_3059":51128},[],"Use an unpacked local Lamassu chart",{"_3603":170,"_31001":91,"_21481":51130,"_5":14758,"_28188":50914,"_3059":51131},[],"`-ip`, `--gateway-ip`",{"_3603":171,"_31001":91,"_21481":51133,"_5":14758,"_28188":50914,"_3059":9029},[],{"_3603":172,"_31001":91,"_21481":51135,"_5":14758,"_28188":50914,"_3059":51136},[],"Override the address written to `gateway.addresses`",{"_3603":173,"_31001":91,"_21481":51138,"_5":14758,"_28188":50914,"_3059":51139},[],"`--otel`",{"_3603":174,"_31001":91,"_21481":51141,"_5":14758,"_28188":50914,"_3059":6761},[],{"_3603":175,"_31001":91,"_21481":51143,"_5":14758,"_28188":50914,"_3059":51144},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3603":176,"_31001":91,"_21481":51146,"_5":14758,"_28188":50914,"_3059":51147},[],"`--development`",{"_3603":177,"_31001":91,"_21481":51149,"_5":14758,"_28188":50914,"_3059":6761},[],{"_3603":178,"_31001":91,"_21481":51151,"_5":14758,"_28188":50914,"_3059":51152},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3603":179,"_31001":91,"_21481":51154,"_5":14758,"_28188":50914,"_3059":51155},[],"`--sample-data`",{"_3603":180,"_31001":91,"_21481":51157,"_5":14758,"_28188":50914,"_3059":6761},[],{"_3603":181,"_31001":91,"_21481":51159,"_5":14758,"_28188":50914,"_3059":51160},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3603":182,"_31001":91,"_21481":51162,"_5":14758,"_28188":50914,"_3059":51163},[],"`--with-hsm`",{"_3603":183,"_31001":91,"_21481":51165,"_5":14758,"_28188":50914,"_3059":6761},[],{"_3603":184,"_31001":91,"_21481":51167,"_5":14758,"_28188":50914,"_3059":51168},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3603":185,"_31001":91,"_21481":51170,"_5":14758,"_28188":50914,"_3059":51171},[],"`--softhsm-chart-path`",{"_3603":186,"_31001":91,"_21481":51173,"_5":14758,"_28188":50914,"_3059":51174},[],"`./charts/softhsm`",{"_3603":187,"_31001":91,"_21481":51176,"_5":14758,"_28188":50914,"_3059":51177},[],"Use a different local SoftHSM chart",{"_3603":188,"_31001":91,"_21481":51179,"_5":14758,"_28188":50914,"_3059":51180},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3603":189,"_31001":91,"_21481":51182,"_5":14758,"_28188":50918,"_3059":51183},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3603":190,"_31001":91,"_21481":51185,"_5":14758,"_28188":50918,"_3059":51186},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3603":191,"_31001":91,"_21481":51188,"_5":14758,"_28188":50918,"_3059":51189},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3603":192,"_31001":91,"_21481":51191,"_5":14758,"_28188":50918,"_3059":51192},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3603":193,"_31001":91,"_21481":51194,"_5":14758,"_28188":50918,"_3059":51195},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3603":194,"_31001":91,"_21481":51197,"_5":14758,"_28188":50918,"_3059":51198},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3603":195,"_31001":91,"_21481":51200,"_5":14758,"_28188":50922,"_3059":51201},[],"Fastlane:",{"_3603":196,"_31001":91,"_21481":51203,"_5":14758,"_28188":50922,"_3059":51204},[],"validates local tools and the selected cluster",{"_3603":197,"_31001":91,"_21481":51206,"_5":14758,"_28188":50922,"_3059":51207},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3603":198,"_31001":91,"_21481":51209,"_5":14758,"_28188":50922,"_3059":51210},[],"creates the namespace",{"_3603":199,"_31001":91,"_21481":51212,"_5":14758,"_28188":50922,"_3059":51213},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3603":200,"_31001":91,"_21481":51215,"_5":14758,"_28188":50922,"_3059":51216},[],"installs PostgreSQL and creates the required databases",{"_3603":201,"_31001":91,"_21481":51218,"_5":14758,"_28188":50922,"_3059":51219},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3603":202,"_31001":91,"_21481":51221,"_5":14758,"_28188":50922,"_3059":51222},[],"installs RabbitMQ",{"_3603":203,"_31001":91,"_21481":51224,"_5":14758,"_28188":50922,"_3059":51225},[],"optionally installs observability and lab HSM components",{"_3603":204,"_31001":91,"_21481":51227,"_5":14758,"_28188":50922,"_3059":51228},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3603":205,"_31001":91,"_21481":51230,"_5":14758,"_28188":50922,"_3059":51231},[],"optionally loads sample data",{"_3603":206,"_31001":91,"_21481":51233,"_5":14758,"_28188":50922,"_3059":51234},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3603":207,"_31001":91,"_21481":51236,"_5":14758,"_28188":50926,"_3059":51237},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3603":208,"_31001":91,"_21481":51239,"_5":14758,"_28188":50926,"_3059":51240},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3603":209,"_31001":91,"_21481":51242,"_5":14758,"_28188":50930,"_3059":51243},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3603":210,"_31001":91,"_21481":51245,"_5":14758,"_28188":50930,"_3059":51246},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3603":211,"_31001":91,"_21481":51248,"_5":14758,"_28188":50930,"_3059":51249},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3603":212,"_31001":91,"_21481":51251,"_5":14758,"_28188":50930,"_3059":51252},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3603":213,"_31001":91,"_21481":51254,"_5":14758,"_28188":50934,"_3059":51255},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3603":214,"_31001":214,"_5":15118,"_3059":51257,"_31339":51258,"_21481":51259,"_28188":214},"Install with Helm",[50643,50644,50750],[],{"_3603":215,"_31001":214,"_21481":51261,"_5":14758,"_28188":214,"_3059":51262},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3603":216,"_31001":214,"_5":31336,"_21481":51264,"_28188":51265,"_3059":51266},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3603":217,"_31001":214,"_5":31336,"_21481":51268,"_28188":51269,"_3059":50653},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3603":218,"_31001":214,"_5":31336,"_21481":51271,"_28188":51272,"_3059":51273},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3603":219,"_31001":214,"_5":31336,"_21481":51275,"_28188":51276,"_3059":51277},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3603":220,"_31001":214,"_5":31336,"_21481":51279,"_28188":51280,"_3059":51281},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3603":221,"_31001":214,"_5":31336,"_21481":51283,"_28188":51284,"_3059":51285},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3603":222,"_31001":214,"_5":31336,"_21481":51287,"_28188":51288,"_3059":51289},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3603":223,"_31001":214,"_5":31336,"_21481":51291,"_28188":51292,"_3059":51293},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3603":224,"_31001":214,"_5":31336,"_21481":51295,"_28188":51296,"_3059":51297},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3603":225,"_31001":214,"_5":31336,"_21481":51299,"_28188":51300,"_3059":51301},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3603":226,"_31001":214,"_5":31336,"_21481":51303,"_28188":51304,"_3059":51305},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3603":227,"_31001":214,"_5":31336,"_21481":51307,"_28188":51308,"_3059":51309},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3603":228,"_31001":214,"_21481":51311,"_5":14758,"_28188":51265,"_3059":51312},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3603":229,"_31001":214,"_21481":51314,"_5":14758,"_28188":51269,"_3059":51315},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3603":230,"_31001":214,"_21481":51317,"_5":14758,"_28188":51269,"_3059":51318},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3603":231,"_31001":214,"_21481":51320,"_5":14758,"_28188":51269,"_3059":51321},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3603":232,"_31001":214,"_21481":51323,"_5":14758,"_28188":51269,"_3059":51324},[],"a reachable RabbitMQ broker and credentials",{"_3603":233,"_31001":214,"_21481":51326,"_5":14758,"_28188":51269,"_3059":51327},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3603":234,"_31001":214,"_21481":51329,"_5":14758,"_28188":51269,"_3059":51330},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3603":235,"_31001":214,"_21481":51332,"_5":14758,"_28188":51269,"_3059":51333},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3603":236,"_31001":214,"_21481":51335,"_5":14758,"_28188":51269,"_3059":51336},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3603":237,"_31001":214,"_21481":51338,"_5":14758,"_28188":51269,"_3059":51339},[],"a StorageClass and an external traffic design",{"_3603":238,"_31001":214,"_21481":51341,"_5":14758,"_28188":51269,"_3059":51342},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3603":239,"_31001":214,"_21481":51344,"_5":14758,"_28188":51269,"_3059":51345},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3603":240,"_31001":214,"_21481":51347,"_5":14758,"_28188":51269,"_3059":51348},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3603":241,"_31001":214,"_21481":51350,"_5":14758,"_28188":51272,"_3059":51351},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3603":242,"_31001":214,"_21481":51353,"_5":14758,"_28188":51272,"_3059":51354},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3603":243,"_31001":214,"_21481":51356,"_5":14758,"_28188":51272,"_3059":51357},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3603":244,"_31001":214,"_21481":51359,"_5":14758,"_28188":51276,"_3059":51360},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3603":245,"_31001":214,"_21481":51362,"_5":14758,"_28188":51276,"_3059":51363},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3603":246,"_31001":214,"_21481":51365,"_5":14758,"_28188":51276,"_3059":51366},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3603":247,"_31001":214,"_21481":51368,"_5":14758,"_28188":51276,"_3059":51369},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3603":248,"_31001":214,"_21481":51371,"_5":14758,"_28188":51280,"_3059":51372},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3603":249,"_31001":214,"_21481":51374,"_5":14758,"_28188":51280,"_3059":51375},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3603":250,"_31001":214,"_21481":51377,"_5":14758,"_28188":51280,"_3059":51378},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3603":251,"_31001":214,"_21481":51380,"_5":14758,"_28188":51280,"_3059":51381},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3603":252,"_31001":214,"_21481":51383,"_5":14758,"_28188":51280,"_3059":51384},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3603":253,"_31001":214,"_21481":51386,"_5":14758,"_28188":51280,"_3059":51387},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3603":254,"_31001":214,"_21481":51389,"_5":14758,"_28188":51280,"_3059":51390},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3603":255,"_31001":214,"_21481":51392,"_5":14758,"_28188":51280,"_3059":51393},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3603":256,"_31001":214,"_21481":51395,"_5":14758,"_28188":51284,"_3059":51396},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3603":257,"_31001":214,"_21481":51398,"_5":14758,"_28188":51288,"_3059":51399},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3603":258,"_31001":214,"_21481":51401,"_5":14758,"_28188":51288,"_3059":51402},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3603":259,"_31001":214,"_21481":51404,"_5":14758,"_28188":51288,"_3059":51405},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3603":260,"_31001":214,"_21481":51407,"_5":14758,"_28188":51288,"_3059":51408},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3603":261,"_31001":214,"_21481":51410,"_5":14758,"_28188":51288,"_3059":51411},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3603":262,"_31001":214,"_21481":51413,"_5":14758,"_28188":51288,"_3059":51414},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3603":263,"_31001":214,"_21481":51416,"_5":14758,"_28188":51288,"_3059":51417},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3603":264,"_31001":214,"_21481":51419,"_5":14758,"_28188":51292,"_3059":51420},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3603":265,"_31001":214,"_21481":51422,"_5":14758,"_28188":51292,"_3059":51423},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3603":266,"_31001":214,"_21481":51425,"_5":14758,"_28188":51292,"_3059":51426},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3603":267,"_31001":214,"_21481":51428,"_5":14758,"_28188":51292,"_3059":51429},[],"See Access control for the principal and policy model.",{"_3603":268,"_31001":214,"_21481":51431,"_5":14758,"_28188":51296,"_3059":51432},[],"To install a local checkout instead:",{"_3603":269,"_31001":214,"_21481":51434,"_5":14758,"_28188":51300,"_3059":51435},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3603":270,"_31001":214,"_21481":51437,"_5":14758,"_28188":51300,"_3059":51438},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3603":271,"_31001":214,"_21481":51440,"_5":14758,"_28188":51304,"_3059":51441},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3603":272,"_31001":214,"_21481":51443,"_5":14758,"_28188":51304,"_3059":51444},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3603":273,"_31001":214,"_21481":51446,"_5":14758,"_28188":51304,"_3059":51447},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3603":274,"_31001":214,"_21481":51449,"_5":14758,"_28188":51304,"_3059":51450},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3603":275,"_31001":214,"_21481":51452,"_5":14758,"_28188":51304,"_3059":51453},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3603":276,"_31001":214,"_21481":51455,"_5":14758,"_28188":51308,"_3059":51456},[],"Before going live, review:",{"_3603":277,"_31001":214,"_21481":51458,"_5":14758,"_28188":51308,"_3059":51459},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3603":278,"_31001":214,"_21481":51461,"_5":14758,"_28188":51308,"_3059":51462},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3603":279,"_31001":214,"_21481":51464,"_5":14758,"_28188":51308,"_3059":51465},[],"shared VA storage before increasing VA replicas",{"_3603":280,"_31001":214,"_21481":51467,"_5":14758,"_28188":51308,"_3059":51468},[],"managed OIDC roles and removal of evaluation credentials",{"_3603":281,"_31001":214,"_21481":51470,"_5":14758,"_28188":51308,"_3059":51471},[],"a trusted TLS issuer or externally managed certificate",{"_3603":282,"_31001":214,"_21481":51473,"_5":14758,"_28188":51308,"_3059":51474},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3603":283,"_31001":214,"_21481":51476,"_5":14758,"_28188":51308,"_3059":51477},[],"SMTP, observability and alert delivery",{"_3603":284,"_31001":214,"_21481":51479,"_5":14758,"_28188":51308,"_3059":51480},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3603":285,"_31001":214,"_21481":51482,"_5":14758,"_28188":51308,"_3059":51483},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3603":286,"_31001":286,"_5":15118,"_3059":51485,"_31339":51486,"_21481":51487,"_28188":286},"Expose the Gateway",[50643,50644,50750],[],{"_3603":287,"_31001":286,"_21481":51489,"_5":14758,"_28188":286,"_3059":51490},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3603":288,"_31001":286,"_5":31336,"_21481":51492,"_28188":51493,"_3059":51494},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3603":289,"_31001":286,"_5":31336,"_21481":51496,"_28188":51497,"_3059":51498},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3603":290,"_31001":286,"_5":31336,"_21481":51500,"_28188":51501,"_3059":51502},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3603":291,"_31001":286,"_5":31336,"_21481":51504,"_28188":51505,"_3059":51506},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3603":292,"_31001":286,"_5":31336,"_21481":51508,"_28188":51509,"_3059":51510},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3603":293,"_31001":286,"_5":31336,"_21481":51512,"_28188":51513,"_3059":51514},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3603":294,"_31001":286,"_5":31336,"_21481":51516,"_28188":51517,"_3059":51518},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3603":295,"_31001":286,"_5":31336,"_21481":51520,"_28188":51521,"_3059":51522},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3603":296,"_31001":286,"_5":31336,"_21481":51524,"_28188":51525,"_3059":51526},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3603":297,"_31001":286,"_5":31336,"_21481":51528,"_28188":51529,"_3059":51530},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3603":298,"_31001":286,"_5":31336,"_21481":51532,"_28188":51533,"_3059":51534},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3603":299,"_31001":286,"_21481":51536,"_5":14758,"_28188":51493,"_3059":51537},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3603":300,"_31001":286,"_21481":51539,"_5":14758,"_28188":51493,"_3059":51540},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3603":301,"_31001":286,"_21481":51542,"_5":14758,"_28188":51497,"_3059":51543},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3603":302,"_31001":286,"_21481":51545,"_5":14758,"_28188":51497,"_3059":51546},[],"Set it only when:",{"_3603":303,"_31001":286,"_21481":51548,"_5":14758,"_28188":51497,"_3059":51549},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3603":304,"_31001":286,"_21481":51551,"_5":14758,"_28188":51497,"_3059":51552},[],"that address is allocated to this Gateway",{"_3603":305,"_31001":286,"_21481":51554,"_5":14758,"_28188":51497,"_3059":51555},[],"the surrounding network already routes traffic for it to the cluster",{"_3603":306,"_31001":286,"_21481":51557,"_5":14758,"_28188":51497,"_3059":51558},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3603":307,"_31001":286,"_21481":51560,"_5":14758,"_28188":51497,"_3059":51561},[],"Keep these two settings separate:",{"_3603":308,"_31001":286,"_21481":51563,"_5":14758,"_28188":51497,"_3059":51564},[],"`gateway.addresses` requests an address for the Gateway.",{"_3603":309,"_31001":286,"_21481":51566,"_5":14758,"_28188":51497,"_3059":51567},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3603":310,"_31001":286,"_21481":51569,"_5":14758,"_28188":51497,"_3059":51570},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3603":311,"_31001":286,"_21481":51572,"_5":14758,"_28188":51501,"_3059":51573},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3603":312,"_31001":286,"_21481":51575,"_5":14758,"_28188":51501,"_3059":51576},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3603":313,"_31001":286,"_21481":51578,"_5":14758,"_28188":51505,"_3059":51579},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3603":314,"_31001":286,"_21481":51581,"_5":14758,"_28188":51505,"_3059":51582},[],"For the recommended design:",{"_3603":315,"_31001":286,"_21481":51584,"_5":14758,"_28188":51505,"_3059":51585},[],"Use only one externally exposed Lamassu Gateway.",{"_3603":316,"_31001":286,"_21481":51587,"_5":14758,"_28188":51505,"_3059":51588},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3603":317,"_31001":286,"_21481":51590,"_5":14758,"_28188":51505,"_3059":51591},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3603":318,"_31001":286,"_21481":51593,"_5":14758,"_28188":51505,"_3059":51594},[],"Point DNS at the VM's reachable address.",{"_3603":319,"_31001":286,"_21481":51596,"_5":14758,"_28188":51505,"_3059":51597},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3603":320,"_31001":286,"_21481":51599,"_5":14758,"_28188":51509,"_3059":51600},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3603":321,"_31001":286,"_21481":51602,"_5":14758,"_28188":51513,"_3059":51603},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3603":322,"_31001":286,"_21481":51605,"_5":14758,"_28188":51513,"_3059":51606},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3603":323,"_31001":286,"_21481":51608,"_5":14758,"_28188":51517,"_3059":51609},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3603":324,"_31001":286,"_21481":51611,"_5":14758,"_28188":51517,"_3059":51612},[],"Requirement",{"_3603":325,"_31001":286,"_21481":51614,"_5":14758,"_28188":51517,"_3059":51615},[],"Recommended design",{"_3603":326,"_31001":286,"_21481":51617,"_5":14758,"_28188":51517,"_3059":51618},[],"Consequence",{"_3603":327,"_31001":286,"_21481":51620,"_5":14758,"_28188":51517,"_3059":51621},[],"Several Lamassu URLs or services",{"_3603":328,"_31001":286,"_21481":51623,"_5":14758,"_28188":51517,"_3059":51624},[],"One Gateway with multiple routes",{"_3603":329,"_31001":286,"_21481":51626,"_5":14758,"_28188":51517,"_3059":51627},[],"One IP and one proxy fleet; this is the chart default",{"_3603":330,"_31001":286,"_21481":51629,"_5":14758,"_28188":51517,"_3059":51630},[],"Independent Gateways and separate external IPs",{"_3603":331,"_31001":286,"_21481":51632,"_5":14758,"_28188":51517,"_3059":51633},[],"One VIP per Gateway",{"_3603":332,"_31001":286,"_21481":51635,"_5":14758,"_28188":51517,"_3059":51636},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3603":333,"_31001":286,"_21481":51638,"_5":14758,"_28188":51517,"_3059":51639},[],"Independent Gateways on one node and one IP",{"_3603":334,"_31001":286,"_21481":51641,"_5":14758,"_28188":51517,"_3059":51642},[],"Use different external ports",{"_3603":335,"_31001":286,"_21481":51644,"_5":14758,"_28188":51517,"_3059":51645},[],"Clients must include non-standard ports",{"_3603":336,"_31001":286,"_21481":51647,"_5":14758,"_28188":51517,"_3059":51648},[],"Separate TLS/mTLS termination behind one IP",{"_3603":337,"_31001":286,"_21481":51650,"_5":14758,"_28188":51517,"_3059":51651},[],"Front-door SNI routing to internal Gateways",{"_3603":338,"_31001":286,"_21481":51653,"_5":14758,"_28188":51517,"_3059":51654},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3603":339,"_31001":286,"_21481":51656,"_5":14758,"_28188":51517,"_3059":51657},[],"Separate Gateway resources but shared proxy infrastructure",{"_3603":340,"_31001":286,"_21481":51659,"_5":14758,"_28188":51517,"_3059":51660},[],"Envoy merged-Gateway mode",{"_3603":341,"_31001":286,"_21481":51662,"_5":14758,"_28188":51517,"_3059":51663},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3603":342,"_31001":286,"_21481":51665,"_5":14758,"_28188":51517,"_3059":51666},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3603":343,"_31001":286,"_21481":51668,"_5":14758,"_28188":51517,"_3059":51669},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3603":344,"_31001":286,"_21481":51671,"_5":14758,"_28188":51517,"_3059":51672},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3603":345,"_31001":286,"_21481":51674,"_5":14758,"_28188":51517,"_3059":51675},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3603":346,"_31001":286,"_21481":51677,"_5":14758,"_28188":51521,"_3059":51678},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3603":347,"_31001":286,"_21481":51680,"_5":14758,"_28188":51525,"_3059":51681},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3603":348,"_31001":286,"_21481":51683,"_5":14758,"_28188":51525,"_3059":51684},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3603":349,"_31001":286,"_21481":51686,"_5":14758,"_28188":51525,"_3059":51687},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3603":350,"_31001":286,"_21481":51689,"_5":14758,"_28188":51525,"_3059":51690},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3603":351,"_31001":286,"_21481":51692,"_5":14758,"_28188":51525,"_3059":51693},[],"If none of those are possible, use different external ports or change the external network design.",{"_3603":352,"_31001":286,"_21481":51695,"_5":14758,"_28188":51529,"_3059":51696},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3603":353,"_31001":286,"_21481":51698,"_5":14758,"_28188":51529,"_3059":51699},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3603":354,"_31001":286,"_21481":51701,"_5":14758,"_28188":51533,"_3059":51702},[],"Check, in order:",{"_3603":355,"_31001":286,"_21481":51704,"_5":14758,"_28188":51533,"_3059":51705},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3603":356,"_31001":286,"_21481":51707,"_5":14758,"_28188":51533,"_3059":51708},[],"Its status contains the expected address.",{"_3603":357,"_31001":286,"_21481":51710,"_5":14758,"_28188":51533,"_3059":51711},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3603":358,"_31001":286,"_21481":51713,"_5":14758,"_28188":51533,"_3059":51714},[],"Port 443 reaches that address from the client network.",{"_3603":359,"_31001":286,"_21481":51716,"_5":14758,"_28188":51533,"_3059":51717},[],"DNS resolves to the externally reachable endpoint.",{"_3603":360,"_31001":286,"_21481":51719,"_5":14758,"_28188":51533,"_3059":51720},[],"The certificate contains the DNS name or IP used by the client.",{"_3603":361,"_31001":286,"_21481":51722,"_5":14758,"_28188":51533,"_3059":51723},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3603":362,"_31001":362,"_5":15118,"_3059":50750,"_31339":51725,"_21481":51726,"_28188":362},[50643,50644,50750],[],{"_3603":363,"_31001":362,"_21481":51728,"_5":14758,"_28188":362,"_3059":51729},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3603":364,"_31001":362,"_5":31336,"_21481":51731,"_28188":51732,"_3059":51733},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3603":365,"_31001":362,"_5":31336,"_21481":51735,"_28188":51736,"_3059":51737},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3603":366,"_31001":362,"_5":31336,"_21481":51739,"_28188":51740,"_3059":51741},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3603":367,"_31001":362,"_5":31336,"_21481":51743,"_28188":51744,"_3059":51745},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3603":368,"_31001":362,"_5":31336,"_21481":51747,"_28188":51748,"_3059":51749},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3603":369,"_31001":362,"_5":31336,"_21481":51751,"_28188":51752,"_3059":51753},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3603":370,"_31001":362,"_21481":51755,"_5":14758,"_28188":51732,"_3059":51756},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3603":371,"_31001":362,"_21481":51758,"_5":14758,"_28188":51736,"_3059":51759},[],"Workflow",{"_3603":372,"_31001":362,"_21481":51761,"_5":14758,"_28188":51736,"_3059":51762},[],"Use it for",{"_3603":373,"_31001":362,"_21481":51764,"_5":14758,"_28188":51736,"_3059":51765},[],"What it installs",{"_3603":374,"_31001":362,"_21481":51767,"_5":14758,"_28188":51736,"_3059":51768},[],"Helm",{"_3603":375,"_31001":362,"_21481":51770,"_5":14758,"_28188":51736,"_3059":51771},[],"Production and controlled environments",{"_3603":376,"_31001":362,"_21481":51773,"_5":14758,"_28188":51736,"_3059":51774},[],"Lamassu services and Gateway API resources",{"_3603":377,"_31001":362,"_21481":51776,"_5":14758,"_28188":51736,"_3059":50887},[],{"_3603":378,"_31001":362,"_21481":51778,"_5":14758,"_28188":51736,"_3059":51779},[],"Evaluation, demos, CI and small lab clusters",{"_3603":379,"_31001":362,"_21481":51781,"_5":14758,"_28188":51736,"_3059":51782},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3603":380,"_31001":362,"_21481":51784,"_5":14758,"_28188":51740,"_3059":51785},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3603":381,"_31001":362,"_21481":51787,"_5":14758,"_28188":51740,"_3059":51788},[],"Area",{"_3603":382,"_31001":362,"_21481":51790,"_5":14758,"_28188":51740,"_3059":51791},[],"The Lamassu chart provides",{"_3603":383,"_31001":362,"_21481":51793,"_5":14758,"_28188":51740,"_3059":51794},[],"You provide",{"_3603":384,"_31001":362,"_21481":51796,"_5":14758,"_28188":51740,"_3059":51797},[],"Lamassu applications",{"_3603":385,"_31001":362,"_21481":51799,"_5":14758,"_28188":51740,"_3059":51800},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3603":386,"_31001":362,"_21481":51802,"_5":14758,"_28188":51740,"_3059":51803},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3603":387,"_31001":362,"_21481":51805,"_5":14758,"_28188":51740,"_3059":51806},[],"PostgreSQL data",{"_3603":388,"_31001":362,"_21481":51808,"_5":14758,"_28188":51740,"_3059":51809},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3603":389,"_31001":362,"_21481":51811,"_5":14758,"_28188":51740,"_3059":51812},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3603":390,"_31001":362,"_21481":51814,"_5":14758,"_28188":51740,"_3059":51815},[],"Messaging",{"_3603":391,"_31001":362,"_21481":51817,"_5":14758,"_28188":51740,"_3059":51818},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3603":392,"_31001":362,"_21481":51820,"_5":14758,"_28188":51740,"_3059":51821},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3603":393,"_31001":362,"_21481":51823,"_5":14758,"_28188":51740,"_3059":51824},[],"Identity",{"_3603":394,"_31001":362,"_21481":51826,"_5":14758,"_28188":51740,"_3059":51827},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3603":395,"_31001":362,"_21481":51829,"_5":14758,"_28188":51740,"_3059":51830},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3603":396,"_31001":362,"_21481":51832,"_5":14758,"_28188":51740,"_3059":51833},[],"External routing",{"_3603":397,"_31001":362,"_21481":51835,"_5":14758,"_28188":51740,"_3059":51836},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3603":398,"_31001":362,"_21481":51838,"_5":14758,"_28188":51740,"_3059":51839},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3603":399,"_31001":362,"_21481":51841,"_5":14758,"_28188":51740,"_3059":51842},[],"TLS",{"_3603":400,"_31001":362,"_21481":51844,"_5":14758,"_28188":51740,"_3059":51845},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3603":401,"_31001":362,"_21481":51847,"_5":14758,"_28188":51740,"_3059":51848},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3603":402,"_31001":362,"_21481":51850,"_5":14758,"_28188":51740,"_3059":51851},[],"Persistent application data",{"_3603":403,"_31001":362,"_21481":51853,"_5":14758,"_28188":51740,"_3059":51854},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3603":404,"_31001":362,"_21481":51856,"_5":14758,"_28188":51740,"_3059":51857},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3603":405,"_31001":362,"_21481":51859,"_5":14758,"_28188":51740,"_3059":51860},[],"Optional integrations",{"_3603":406,"_31001":362,"_21481":51862,"_5":14758,"_28188":51740,"_3059":51863},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3603":407,"_31001":362,"_21481":51865,"_5":14758,"_28188":51740,"_3059":51866},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3603":408,"_31001":362,"_21481":51868,"_5":14758,"_28188":51740,"_3059":51869},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3603":409,"_31001":362,"_21481":51871,"_5":14758,"_28188":51740,"_3059":51872},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3603":410,"_31001":362,"_21481":51874,"_5":14758,"_28188":51744,"_3059":51875},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3603":411,"_31001":362,"_21481":51877,"_5":14758,"_28188":51744,"_3059":51878},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3603":412,"_31001":362,"_21481":51880,"_5":14758,"_28188":51748,"_3059":51881},[],"Kubernetes 1.24 or newer",{"_3603":413,"_31001":362,"_21481":51883,"_5":14758,"_28188":51748,"_3059":51884},[],"Helm 3.2 or newer",{"_3603":414,"_31001":362,"_21481":51886,"_5":14758,"_28188":51748,"_3059":51887},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3603":415,"_31001":362,"_21481":51889,"_5":14758,"_28188":51748,"_3059":51890},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3603":416,"_31001":362,"_21481":51892,"_5":14758,"_28188":51748,"_3059":51893},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3603":417,"_31001":362,"_21481":51895,"_5":14758,"_28188":51748,"_3059":51896},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3603":418,"_31001":362,"_21481":51898,"_5":14758,"_28188":51748,"_3059":51899},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3603":419,"_31001":362,"_21481":51901,"_5":14758,"_28188":51752,"_3059":51902},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3603":420,"_31001":362,"_21481":51904,"_5":14758,"_28188":51752,"_3059":51905},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3603":421,"_31001":362,"_21481":51907,"_5":14758,"_28188":51752,"_3059":51908},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3603":422,"_31001":362,"_21481":51910,"_5":14758,"_28188":51752,"_3059":51911},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3603":423,"_31001":423,"_5":15118,"_3059":51913,"_31339":51914,"_21481":51916,"_28188":423},"Deployment troubleshooting",[50643,50644,51915],"Operations",[],{"_3603":424,"_31001":423,"_21481":51918,"_5":14758,"_28188":423,"_3059":51919},[],"Diagnose access, service health and infrastructure dependencies.",{"_3603":425,"_31001":423,"_5":31336,"_21481":51921,"_28188":51922,"_3059":51923},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3603":426,"_31001":423,"_5":31336,"_21481":51925,"_28188":51926,"_3059":51927},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3603":427,"_31001":423,"_5":31336,"_21481":51929,"_28188":51930,"_3059":51931},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3603":428,"_31001":423,"_5":31336,"_21481":51933,"_28188":51934,"_3059":51935},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3603":429,"_31001":423,"_5":31336,"_21481":51937,"_28188":51938,"_3059":51939},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3603":430,"_31001":423,"_5":31336,"_21481":51941,"_28188":51942,"_3059":51943},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3603":431,"_31001":423,"_5":31336,"_21481":51945,"_28188":51946,"_3059":51947},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3603":432,"_31001":423,"_5":31336,"_21481":51949,"_28188":51950,"_3059":51951},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3603":433,"_31001":423,"_5":31336,"_21481":51953,"_28188":51954,"_3059":51955},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3603":434,"_31001":423,"_5":31336,"_21481":51957,"_28188":51958,"_3059":51959},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3603":435,"_31001":423,"_5":31336,"_21481":51961,"_28188":51962,"_3059":51963},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3603":436,"_31001":423,"_5":31336,"_21481":51965,"_28188":51966,"_3059":51967},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3603":437,"_31001":423,"_5":31336,"_21481":51969,"_28188":51970,"_3059":51971},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3603":438,"_31001":423,"_21481":51973,"_5":14758,"_28188":423,"_3059":51974},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3603":439,"_31001":423,"_21481":51976,"_5":14758,"_28188":51926,"_3059":51977},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3603":440,"_31001":423,"_21481":51979,"_5":14758,"_28188":51930,"_3059":51980},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3603":441,"_31001":423,"_21481":51982,"_5":14758,"_28188":51934,"_3059":51983},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3603":442,"_31001":423,"_21481":51985,"_5":14758,"_28188":51938,"_3059":51986},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3603":443,"_31001":423,"_21481":51988,"_5":14758,"_28188":51942,"_3059":51989},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3603":444,"_31001":423,"_21481":51991,"_5":14758,"_28188":51946,"_3059":51992},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3603":445,"_31001":423,"_21481":51994,"_5":14758,"_28188":51946,"_3059":51995},[],"Also run the chart's connectivity test:",{"_3603":446,"_31001":423,"_21481":51997,"_5":14758,"_28188":51946,"_3059":51998},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3603":447,"_31001":423,"_21481":52000,"_5":14758,"_28188":51946,"_3059":52001},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3603":448,"_31001":423,"_21481":52003,"_5":14758,"_28188":51950,"_3059":52004},[],"If you receive a 401:",{"_3603":449,"_31001":423,"_21481":52006,"_5":14758,"_28188":51950,"_3059":52007},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3603":450,"_31001":423,"_21481":52009,"_5":14758,"_28188":51950,"_3059":52010},[],"verify issuer, audience and expiration of the token;",{"_3603":451,"_31001":423,"_21481":52012,"_5":14758,"_28188":51950,"_3059":52013},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3603":452,"_31001":423,"_21481":52015,"_5":14758,"_28188":51950,"_3059":52016},[],"check that the provider's public and internal routes point to the same realm.",{"_3603":453,"_31001":423,"_21481":52018,"_5":14758,"_28188":51950,"_3059":52019},[],"If login succeeds but the APIs return 403:",{"_3603":454,"_31001":423,"_21481":52021,"_5":14758,"_28188":51950,"_3059":52022},[],"inspect the token's real claims;",{"_3603":455,"_31001":423,"_21481":52024,"_5":14758,"_28188":51950,"_3059":52025},[],"confirm they match an active principal;",{"_3603":456,"_31001":423,"_21481":52027,"_5":14758,"_28188":51950,"_3059":52028},[],"review the policies granted to that principal;",{"_3603":457,"_31001":423,"_21481":52030,"_5":14758,"_28188":51950,"_3059":52031},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3603":458,"_31001":423,"_21481":52033,"_5":14758,"_28188":51950,"_3059":52034},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3603":459,"_31001":423,"_21481":52036,"_5":14758,"_28188":51954,"_3059":52037},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3603":460,"_31001":423,"_21481":52039,"_5":14758,"_28188":51954,"_3059":52040},[],"Locate the authz pod and Service.",{"_3603":461,"_31001":423,"_21481":52042,"_5":14758,"_28188":51954,"_3059":52043},[],"Check /health, logs and its database connection.",{"_3603":462,"_31001":423,"_21481":52045,"_5":14758,"_28188":51954,"_3059":52046},[],"Verify the DNS and port configured in externalAuthorization.",{"_3603":463,"_31001":423,"_21481":52048,"_5":14758,"_28188":51954,"_3059":52049},[],"Check the check route is /v1/ext\\_authz/check.",{"_3603":464,"_31001":423,"_21481":52051,"_5":14758,"_28188":51954,"_3059":52052},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3603":465,"_31001":423,"_21481":52054,"_5":14758,"_28188":51958,"_3059":52055},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3603":466,"_31001":423,"_21481":52057,"_5":14758,"_28188":51962,"_3059":52058},[],"Review kubectl describe pod first. Common causes are:",{"_3603":467,"_31001":423,"_21481":52060,"_5":14758,"_28188":51962,"_3059":52061},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3603":468,"_31001":423,"_21481":52063,"_5":14758,"_28188":51962,"_3059":52064},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3603":469,"_31001":423,"_21481":52066,"_5":14758,"_28188":51962,"_3059":52067},[],"unbound persistent volume;",{"_3603":470,"_31001":423,"_21481":52069,"_5":14758,"_28188":51962,"_3059":52070},[],"inaccessible image or incorrect pull policy;",{"_3603":471,"_31001":423,"_21481":52072,"_5":14758,"_28188":51962,"_3059":52073},[],"invalid cryptographic engine configuration;",{"_3603":472,"_31001":423,"_21481":52075,"_5":14758,"_28188":51962,"_3059":52076},[],"CPU or memory limits set too low;",{"_3603":473,"_31001":423,"_21481":52078,"_5":14758,"_28188":51962,"_3059":52079},[],"an incomplete prior migration.",{"_3603":474,"_31001":423,"_21481":52081,"_5":14758,"_28188":51962,"_3059":52082},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3603":475,"_31001":423,"_21481":52084,"_5":14758,"_28188":51962,"_3059":52085},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3603":476,"_31001":423,"_21481":52087,"_5":14758,"_28188":51962,"_3059":52088},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3603":477,"_31001":423,"_21481":52090,"_5":14758,"_28188":51966,"_3059":52091},[],"Domain and audit events depend on the bus publisher:",{"_3603":478,"_31001":423,"_21481":52093,"_5":14758,"_28188":51966,"_3059":52094},[],"verify it is enabled in the emitting service;",{"_3603":479,"_31001":423,"_21481":52096,"_5":14758,"_28188":51966,"_3059":52097},[],"check AMQP connectivity and credentials;",{"_3603":480,"_31001":423,"_21481":52099,"_5":14758,"_28188":51966,"_3059":52100},[],"review exchange, routing key, queues and consumers;",{"_3603":481,"_31001":423,"_21481":52102,"_5":14758,"_28188":51966,"_3059":52103},[],"inspect dead-letter queues;",{"_3603":482,"_31001":423,"_21481":52105,"_5":14758,"_28188":51966,"_3059":52106},[],"alert on orphan durable queues and backlog growth.",{"_3603":483,"_31001":423,"_21481":52108,"_5":14758,"_28188":51966,"_3059":52109},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3603":484,"_31001":423,"_21481":52111,"_5":14758,"_28188":51966,"_3059":52112},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3603":485,"_31001":423,"_21481":52114,"_5":14758,"_28188":51966,"_3059":52115},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3603":486,"_31001":423,"_21481":52117,"_5":14758,"_28188":51966,"_3059":52118},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3603":487,"_31001":423,"_21481":52120,"_5":14758,"_28188":51966,"_3059":52121},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3603":488,"_31001":423,"_21481":52123,"_5":14758,"_28188":51966,"_3059":52124},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3603":489,"_31001":423,"_21481":52126,"_5":14758,"_28188":51966,"_3059":52127},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3603":490,"_31001":423,"_21481":52129,"_5":14758,"_28188":51970,"_3059":52130},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3603":491,"_31001":423,"_21481":52132,"_5":14758,"_28188":51970,"_3059":52133},[],"Before closing an incident, record:",{"_3603":492,"_31001":423,"_21481":52135,"_5":14758,"_28188":51970,"_3059":52136},[],"the confirmed cause;",{"_3603":493,"_31001":423,"_21481":52138,"_5":14758,"_28188":51970,"_3059":52139},[],"the time scope and affected resources;",{"_3603":494,"_31001":423,"_21481":52141,"_5":14758,"_28188":51970,"_3059":52142},[],"the commands or queries used;",{"_3603":495,"_31001":423,"_21481":52144,"_5":14758,"_28188":51970,"_3059":52145},[],"the applied change and how to revert it;",{"_3603":496,"_31001":423,"_21481":52147,"_5":14758,"_28188":51970,"_3059":52148},[],"validation from a consumer;",{"_3603":497,"_31001":423,"_21481":52150,"_5":14758,"_28188":51970,"_3059":52151},[],"the preventive action and its owner.",{"_3603":498,"_31001":498,"_5":15118,"_3059":52153,"_31339":52154,"_21481":52158,"_28188":498},"Data model",[50643,52155,52156,52157],"Platform","Administration","Access control",[],{"_3603":499,"_31001":498,"_21481":52160,"_5":14758,"_28188":498,"_3059":52161},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3603":500,"_31001":498,"_5":31336,"_21481":52163,"_28188":52164,"_3059":52165},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3603":501,"_31001":498,"_5":31336,"_21481":52167,"_28188":52168,"_3059":52169},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3603":502,"_31001":498,"_21481":52171,"_5":14758,"_28188":498,"_3059":52172},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3603":503,"_31001":498,"_21481":52174,"_5":14758,"_28188":52164,"_3059":52175},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3603":504,"_31001":498,"_21481":52177,"_5":14758,"_28188":52164,"_3059":52178},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3603":505,"_31001":498,"_21481":52180,"_5":14758,"_28188":52164,"_3059":52181},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3603":506,"_31001":498,"_21481":52183,"_5":14758,"_28188":52168,"_3059":52184},[],"Entity (`schema_name.entity_type`)",{"_3603":507,"_31001":498,"_21481":52186,"_5":14758,"_28188":52168,"_3059":52187},[],"Table (`table_name`)",{"_3603":508,"_31001":498,"_21481":52189,"_5":14758,"_28188":52168,"_3059":52190},[],"Key (`primary_key`)",{"_3603":509,"_31001":498,"_21481":52192,"_5":14758,"_28188":52168,"_3059":52193},[],"`alerts.event`",{"_3603":510,"_31001":498,"_21481":52195,"_5":14758,"_28188":52168,"_3059":52196},[],"`events`",{"_3603":511,"_31001":498,"_21481":52198,"_5":14758,"_28188":52168,"_3059":52199},[],"`event_type`",{"_3603":512,"_31001":498,"_21481":52201,"_5":14758,"_28188":52168,"_3059":52202},[],"`alerts.subscription`",{"_3603":513,"_31001":498,"_21481":52204,"_5":14758,"_28188":52168,"_3059":52205},[],"`subscriptions`",{"_3603":514,"_31001":498,"_21481":52207,"_5":14758,"_28188":52168,"_3059":52208},[],"`id`",{"_3603":515,"_31001":498,"_21481":52210,"_5":14758,"_28188":52168,"_3059":52211},[],"`ca.ca_certificate`",{"_3603":516,"_31001":498,"_21481":52213,"_5":14758,"_28188":52168,"_3059":52214},[],"`ca_certificates`",{"_3603":517,"_31001":498,"_21481":52216,"_5":14758,"_28188":52168,"_3059":52208},[],{"_3603":518,"_31001":498,"_21481":52218,"_5":14758,"_28188":52168,"_3059":52219},[],"`ca.certificate`",{"_3603":519,"_31001":498,"_21481":52221,"_5":14758,"_28188":52168,"_3059":52222},[],"`certificates`",{"_3603":520,"_31001":498,"_21481":52224,"_5":14758,"_28188":52168,"_3059":52225},[],"`serial_number`",{"_3603":521,"_31001":498,"_21481":52227,"_5":14758,"_28188":52168,"_3059":52228},[],"`ca.issuance_profile`",{"_3603":522,"_31001":498,"_21481":52230,"_5":14758,"_28188":52168,"_3059":52231},[],"`issuance_profiles`",{"_3603":523,"_31001":498,"_21481":52233,"_5":14758,"_28188":52168,"_3059":52208},[],{"_3603":524,"_31001":498,"_21481":52235,"_5":14758,"_28188":52168,"_3059":52236},[],"`devicemanager.device_group`",{"_3603":525,"_31001":498,"_21481":52238,"_5":14758,"_28188":52168,"_3059":52239},[],"`device_groups`",{"_3603":526,"_31001":498,"_21481":52241,"_5":14758,"_28188":52168,"_3059":52208},[],{"_3603":527,"_31001":498,"_21481":52243,"_5":14758,"_28188":52168,"_3059":52244},[],"`devicemanager.device`",{"_3603":528,"_31001":498,"_21481":52246,"_5":14758,"_28188":52168,"_3059":52247},[],"`devices`",{"_3603":529,"_31001":498,"_21481":52249,"_5":14758,"_28188":52168,"_3059":52208},[],{"_3603":530,"_31001":498,"_21481":52251,"_5":14758,"_28188":52168,"_3059":52252},[],"`dmsmanager.dms`",{"_3603":531,"_31001":498,"_21481":52254,"_5":14758,"_28188":52168,"_3059":52255},[],"`dms`",{"_3603":532,"_31001":498,"_21481":52257,"_5":14758,"_28188":52168,"_3059":52208},[],{"_3603":533,"_31001":498,"_21481":52259,"_5":14758,"_28188":52168,"_3059":52260},[],"`kms.kms_key`",{"_3603":534,"_31001":498,"_21481":52262,"_5":14758,"_28188":52168,"_3059":52263},[],"`kms_keys`",{"_3603":535,"_31001":498,"_21481":52265,"_5":14758,"_28188":52168,"_3059":52266},[],"`key_id`, `engine_id`",{"_3603":536,"_31001":498,"_21481":52268,"_5":14758,"_28188":52168,"_3059":52269},[],"`va.crl_settings`",{"_3603":537,"_31001":498,"_21481":52271,"_5":14758,"_28188":52168,"_3059":52272},[],"`crl_settings`",{"_3603":538,"_31001":498,"_21481":52274,"_5":14758,"_28188":52168,"_3059":52275},[],"`ca_id`",{"_3603":539,"_31001":498,"_21481":52277,"_5":14758,"_28188":52168,"_3059":52278},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3603":540,"_31001":498,"_21481":52280,"_5":14758,"_28188":52168,"_3059":52281},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3603":541,"_31001":498,"_21481":52283,"_5":14758,"_28188":52168,"_3059":52284},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3603":542,"_31001":542,"_5":15118,"_3059":52286,"_31339":52287,"_21481":52288,"_28188":542},"Access control overview",[50643,52155,52156,52157],[],{"_3603":543,"_31001":542,"_21481":52290,"_5":14758,"_28188":542,"_3059":52291},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3603":544,"_31001":542,"_5":31336,"_21481":52293,"_28188":52294,"_3059":52295},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3603":545,"_31001":542,"_5":31336,"_21481":52297,"_28188":52298,"_3059":52299},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3603":546,"_31001":542,"_5":31336,"_21481":52301,"_28188":52302,"_3059":52303},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3603":547,"_31001":542,"_5":31336,"_21481":52305,"_28188":52306,"_3059":52307},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3603":548,"_31001":542,"_5":31336,"_21481":52309,"_28188":52310,"_3059":52311},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3603":549,"_31001":542,"_5":31336,"_21481":52313,"_28188":52314,"_3059":52315},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3603":550,"_31001":542,"_5":31336,"_21481":52317,"_28188":52318,"_3059":52319},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3603":551,"_31001":542,"_5":31336,"_21481":52321,"_28188":52322,"_3059":52323},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3603":552,"_31001":542,"_5":31336,"_21481":52325,"_28188":52326,"_3059":52327},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3603":553,"_31001":542,"_5":31336,"_21481":52329,"_28188":52330,"_3059":52331},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3603":554,"_31001":542,"_5":31336,"_21481":52333,"_28188":52334,"_3059":52335},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3603":555,"_31001":542,"_5":31336,"_21481":52337,"_28188":52338,"_3059":52339},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3603":556,"_31001":542,"_5":31336,"_21481":52341,"_28188":52342,"_3059":52343},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3603":557,"_31001":542,"_5":31336,"_21481":52345,"_28188":52346,"_3059":52347},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3603":558,"_31001":542,"_5":31336,"_21481":52349,"_28188":52350,"_3059":52351},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3603":559,"_31001":542,"_5":31336,"_21481":52353,"_28188":52354,"_3059":51293},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3603":560,"_31001":542,"_5":31336,"_21481":52356,"_28188":52357,"_3059":52358},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3603":561,"_31001":542,"_5":31336,"_21481":52360,"_28188":52361,"_3059":52362},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3603":562,"_31001":542,"_5":31336,"_21481":52364,"_28188":52365,"_3059":52366},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3603":563,"_31001":542,"_5":31336,"_21481":52368,"_28188":52369,"_3059":52370},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3603":564,"_31001":542,"_5":31336,"_21481":52372,"_28188":52373,"_3059":52374},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3603":565,"_31001":542,"_5":31336,"_21481":52376,"_28188":52377,"_3059":52378},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3603":566,"_31001":542,"_5":31336,"_21481":52380,"_28188":52381,"_3059":52382},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3603":567,"_31001":542,"_5":31336,"_21481":52384,"_28188":52385,"_3059":52386},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3603":568,"_31001":542,"_5":31336,"_21481":52388,"_28188":52389,"_3059":52390},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3603":569,"_31001":542,"_5":31336,"_21481":52392,"_28188":52393,"_3059":52394},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3603":570,"_31001":542,"_5":31336,"_21481":52396,"_28188":52397,"_3059":52398},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3603":571,"_31001":542,"_5":31336,"_21481":52400,"_28188":52401,"_3059":52402},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3603":572,"_31001":542,"_5":31336,"_21481":52404,"_28188":52405,"_3059":52406},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3603":573,"_31001":542,"_5":31336,"_21481":52408,"_28188":52409,"_3059":52410},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3603":574,"_31001":542,"_5":31336,"_21481":52412,"_28188":52413,"_3059":52414},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3603":575,"_31001":542,"_21481":52416,"_5":14758,"_28188":542,"_3059":52417},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3603":576,"_31001":542,"_21481":52419,"_5":14758,"_28188":542,"_3059":52420},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3603":577,"_31001":542,"_21481":52422,"_5":14758,"_28188":542,"_3059":52423},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3603":578,"_31001":542,"_21481":52425,"_5":14758,"_28188":52294,"_3059":52426},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3603":579,"_31001":542,"_21481":52428,"_5":14758,"_28188":52294,"_3059":52429},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3603":580,"_31001":542,"_21481":52431,"_5":14758,"_28188":52294,"_3059":52432},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3603":581,"_31001":542,"_21481":52434,"_5":14758,"_28188":52294,"_3059":52435},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3603":582,"_31001":542,"_21481":52437,"_5":14758,"_28188":52294,"_3059":52438},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3603":583,"_31001":542,"_21481":52440,"_5":14758,"_28188":52294,"_3059":52441},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3603":584,"_31001":542,"_21481":52443,"_5":14758,"_28188":52298,"_3059":52444},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3603":585,"_31001":542,"_21481":52446,"_5":14758,"_28188":52298,"_3059":52447},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3603":586,"_31001":542,"_21481":52449,"_5":14758,"_28188":52302,"_3059":52450},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3603":587,"_31001":542,"_21481":52452,"_5":14758,"_28188":52302,"_3059":52453},[],"The decision is made **before forwarding the request to the service**:",{"_3603":588,"_31001":542,"_21481":52455,"_5":14758,"_28188":52302,"_3059":52456},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3603":589,"_31001":542,"_21481":52458,"_5":14758,"_28188":52302,"_3059":52459},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3603":590,"_31001":542,"_21481":52461,"_5":14758,"_28188":52302,"_3059":52462},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3603":591,"_31001":542,"_21481":52464,"_5":14758,"_28188":52302,"_3059":52465},[],"It separately loads the policies granted to each principal.",{"_3603":592,"_31001":542,"_21481":52467,"_5":14758,"_28188":52302,"_3059":52468},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3603":593,"_31001":542,"_21481":52470,"_5":14758,"_28188":52302,"_3059":52471},[],"`authz` looks for an HTTP rule granting that action.",{"_3603":594,"_31001":542,"_21481":52473,"_5":14758,"_28188":52302,"_3059":52474},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3603":595,"_31001":542,"_21481":52476,"_5":14758,"_28188":52302,"_3059":52477},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3603":596,"_31001":542,"_21481":52479,"_5":14758,"_28188":52302,"_3059":52480},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3603":597,"_31001":542,"_21481":52482,"_5":14758,"_28188":52302,"_3059":52483},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3603":598,"_31001":542,"_21481":52485,"_5":14758,"_28188":52306,"_3059":52486},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3603":599,"_31001":542,"_21481":52488,"_5":14758,"_28188":52306,"_3059":52489},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3603":600,"_31001":542,"_21481":52491,"_5":14758,"_28188":52306,"_3059":52492},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3603":601,"_31001":542,"_21481":52494,"_5":14758,"_28188":52306,"_3059":52495},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3603":602,"_31001":542,"_21481":52497,"_5":14758,"_28188":52306,"_3059":52498},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3603":603,"_31001":542,"_21481":52500,"_5":14758,"_28188":52306,"_3059":52501},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3603":604,"_31001":542,"_21481":52503,"_5":14758,"_28188":52306,"_3059":52504},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3603":605,"_31001":542,"_21481":52506,"_5":14758,"_28188":52306,"_3059":52507},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3603":606,"_31001":542,"_21481":52509,"_5":14758,"_28188":52306,"_3059":52510},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3603":607,"_31001":542,"_21481":52512,"_5":14758,"_28188":52306,"_3059":52513},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3603":608,"_31001":542,"_21481":52515,"_5":14758,"_28188":52310,"_3059":52516},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3603":609,"_31001":542,"_21481":52518,"_5":14758,"_28188":52310,"_3059":52519},[],"The decision is made with the domain operation context:",{"_3603":610,"_31001":542,"_21481":52521,"_5":14758,"_28188":52310,"_3059":52522},[],"The middleware extracts the credential and resolves the matching principals.",{"_3603":611,"_31001":542,"_21481":52524,"_5":14758,"_28188":52310,"_3059":52525},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3603":612,"_31001":542,"_21481":52527,"_5":14758,"_28188":52310,"_3059":52528},[],"`authz` gathers the entity rules of the granted policies.",{"_3603":613,"_31001":542,"_21481":52530,"_5":14758,"_28188":52310,"_3059":52531},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3603":614,"_31001":542,"_21481":52533,"_5":14758,"_28188":52310,"_3059":52534},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3603":615,"_31001":542,"_21481":52536,"_5":14758,"_28188":52310,"_3059":52537},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3603":616,"_31001":542,"_21481":52539,"_5":14758,"_28188":52310,"_3059":52540},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3603":617,"_31001":542,"_21481":52542,"_5":14758,"_28188":52310,"_3059":52543},[],"Actions fall into two groups:",{"_3603":618,"_31001":542,"_21481":52545,"_5":14758,"_28188":52310,"_3059":52546},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3603":619,"_31001":542,"_21481":52548,"_5":14758,"_28188":52310,"_3059":52549},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3603":620,"_31001":542,"_21481":52551,"_5":14758,"_28188":52310,"_3059":52552},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3603":621,"_31001":542,"_21481":52554,"_5":14758,"_28188":52314,"_3059":52555},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3603":622,"_31001":542,"_21481":52557,"_5":14758,"_28188":52314,"_3059":52558},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3603":623,"_31001":542,"_21481":52560,"_5":14758,"_28188":52314,"_3059":52561},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3603":624,"_31001":542,"_21481":52563,"_5":14758,"_28188":52318,"_3059":52564},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3603":625,"_31001":542,"_21481":52566,"_5":14758,"_28188":52318,"_3059":52567},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3603":626,"_31001":542,"_21481":52569,"_5":14758,"_28188":52318,"_3059":52570},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3603":627,"_31001":542,"_21481":52572,"_5":14758,"_28188":52318,"_3059":52573},[],"The implemented operators are:",{"_3603":628,"_31001":542,"_21481":52575,"_5":14758,"_28188":52318,"_3059":52576},[],"`equals`, for exact equality;",{"_3603":629,"_31001":542,"_21481":52578,"_5":14758,"_28188":52318,"_3059":52579},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3603":630,"_31001":542,"_21481":52581,"_5":14758,"_28188":52318,"_3059":52582},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3603":631,"_31001":542,"_21481":52584,"_5":14758,"_28188":52318,"_3059":52585},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3603":632,"_31001":542,"_21481":52587,"_5":14758,"_28188":52322,"_3059":52588},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3603":633,"_31001":542,"_21481":52590,"_5":14758,"_28188":52322,"_3059":52591},[],"The available modes are:",{"_3603":634,"_31001":542,"_21481":52593,"_5":14758,"_28188":52322,"_3059":52594},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3603":635,"_31001":542,"_21481":52596,"_5":14758,"_28188":52322,"_3059":52597},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3603":636,"_31001":542,"_21481":52599,"_5":14758,"_28188":52322,"_3059":52600},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3603":637,"_31001":542,"_21481":52602,"_5":14758,"_28188":52322,"_3059":52603},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3603":638,"_31001":542,"_21481":52605,"_5":14758,"_28188":52322,"_3059":52606},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3603":639,"_31001":542,"_21481":52608,"_5":14758,"_28188":52322,"_3059":52609},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3603":640,"_31001":542,"_21481":52611,"_5":14758,"_28188":52326,"_3059":52612},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3603":641,"_31001":542,"_21481":52614,"_5":14758,"_28188":52326,"_3059":52615},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3603":642,"_31001":542,"_21481":52617,"_5":14758,"_28188":52326,"_3059":52618},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3603":643,"_31001":542,"_21481":52620,"_5":14758,"_28188":52326,"_3059":52621},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3603":644,"_31001":542,"_21481":52623,"_5":14758,"_28188":52334,"_3059":52624},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3603":645,"_31001":542,"_21481":52626,"_5":14758,"_28188":52334,"_3059":52627},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3603":646,"_31001":542,"_21481":52629,"_5":14758,"_28188":52338,"_3059":52630},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3603":647,"_31001":542,"_21481":52632,"_5":14758,"_28188":52338,"_3059":52633},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3603":648,"_31001":542,"_21481":52635,"_5":14758,"_28188":52338,"_3059":52636},[],"The data model shows how the resources used in entity rules are connected.",{"_3603":649,"_31001":542,"_21481":52638,"_5":14758,"_28188":52338,"_3059":52639},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3603":650,"_31001":542,"_21481":52641,"_5":14758,"_28188":52338,"_3059":52642},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3603":651,"_31001":542,"_21481":52644,"_5":14758,"_28188":52342,"_3059":52645},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3603":652,"_31001":542,"_21481":52647,"_5":14758,"_28188":52342,"_3059":52648},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3603":653,"_31001":542,"_21481":52650,"_5":14758,"_28188":52342,"_3059":52651},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3603":654,"_31001":542,"_21481":52653,"_5":14758,"_28188":52346,"_3059":52654},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3603":655,"_31001":542,"_21481":52656,"_5":14758,"_28188":52346,"_3059":52657},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3603":656,"_31001":542,"_21481":52659,"_5":14758,"_28188":52346,"_3059":52660},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3603":657,"_31001":542,"_21481":52662,"_5":14758,"_28188":52346,"_3059":52663},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3603":658,"_31001":542,"_21481":52665,"_5":14758,"_28188":52346,"_3059":52666},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3603":659,"_31001":542,"_21481":52668,"_5":14758,"_28188":52346,"_3059":52669},[],"Note that:",{"_3603":660,"_31001":542,"_21481":52671,"_5":14758,"_28188":52346,"_3059":52672},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3603":661,"_31001":542,"_21481":52674,"_5":14758,"_28188":52346,"_3059":52675},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3603":662,"_31001":542,"_21481":52677,"_5":14758,"_28188":52346,"_3059":52678},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3603":663,"_31001":542,"_21481":52680,"_5":14758,"_28188":52350,"_3059":52681},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3603":664,"_31001":542,"_21481":52683,"_5":14758,"_28188":52350,"_3059":52684},[],"full and read-only access to certificates and authorities;",{"_3603":665,"_31001":542,"_21481":52686,"_5":14758,"_28188":52350,"_3059":52687},[],"full and read-only access to the KMS;",{"_3603":666,"_31001":542,"_21481":52689,"_5":14758,"_28188":52350,"_3059":52690},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3603":667,"_31001":542,"_21481":52692,"_5":14758,"_28188":52350,"_3059":52693},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3603":668,"_31001":542,"_21481":52695,"_5":14758,"_28188":52350,"_3059":52696},[],"console access;",{"_3603":669,"_31001":542,"_21481":52698,"_5":14758,"_28188":52350,"_3059":52699},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3603":670,"_31001":542,"_21481":52701,"_5":14758,"_28188":52350,"_3059":52702},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3603":671,"_31001":542,"_21481":52704,"_5":14758,"_28188":52350,"_3059":52705},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3603":672,"_31001":542,"_21481":52707,"_5":14758,"_28188":52350,"_3059":52708},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3603":673,"_31001":542,"_21481":52710,"_5":14758,"_28188":52350,"_3059":52711},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3603":674,"_31001":542,"_21481":52713,"_5":14758,"_28188":52354,"_3059":52714},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3603":675,"_31001":542,"_21481":52716,"_5":14758,"_28188":52354,"_3059":52717},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3603":676,"_31001":542,"_21481":52719,"_5":14758,"_28188":52354,"_3059":52720},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3603":677,"_31001":542,"_21481":52722,"_5":14758,"_28188":52357,"_3059":52723},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3603":678,"_31001":542,"_21481":52725,"_5":14758,"_28188":52361,"_3059":52726},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3603":679,"_31001":542,"_21481":52728,"_5":14758,"_28188":52361,"_3059":52729},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3603":680,"_31001":542,"_21481":52731,"_5":14758,"_28188":52365,"_3059":52732},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3603":681,"_31001":542,"_21481":52734,"_5":14758,"_28188":52369,"_3059":52735},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3603":682,"_31001":542,"_21481":52737,"_5":14758,"_28188":52373,"_3059":52738},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3603":683,"_31001":542,"_21481":52740,"_5":14758,"_28188":52377,"_3059":52741},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3603":684,"_31001":542,"_21481":52743,"_5":14758,"_28188":52377,"_3059":52744},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3603":685,"_31001":542,"_21481":52746,"_5":14758,"_28188":52381,"_3059":52747},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3603":686,"_31001":542,"_21481":52749,"_5":14758,"_28188":52381,"_3059":52750},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3603":687,"_31001":542,"_21481":52752,"_5":14758,"_28188":52381,"_3059":52753},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3603":688,"_31001":542,"_21481":52755,"_5":14758,"_28188":52381,"_3059":52756},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3603":689,"_31001":542,"_21481":52758,"_5":14758,"_28188":52381,"_3059":52759},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3603":690,"_31001":542,"_21481":52761,"_5":14758,"_28188":52381,"_3059":52762},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3603":691,"_31001":542,"_21481":52764,"_5":14758,"_28188":52381,"_3059":52765},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3603":692,"_31001":542,"_21481":52767,"_5":14758,"_28188":52381,"_3059":52768},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3603":693,"_31001":542,"_21481":52770,"_5":14758,"_28188":52385,"_3059":52771},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3603":694,"_31001":542,"_21481":52773,"_5":14758,"_28188":52385,"_3059":52774},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3603":695,"_31001":542,"_21481":52776,"_5":14758,"_28188":52385,"_3059":52777},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3603":696,"_31001":542,"_21481":52779,"_5":14758,"_28188":52389,"_3059":52780},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3603":697,"_31001":542,"_21481":52782,"_5":14758,"_28188":52389,"_3059":52783},[],"Use groups or stable roles for people and independent identities for automations.",{"_3603":698,"_31001":542,"_21481":52785,"_5":14758,"_28188":52389,"_3059":52786},[],"Keep at least two recovery administrators and test their access periodically.",{"_3603":699,"_31001":542,"_21481":52788,"_5":14758,"_28188":52389,"_3059":52789},[],"Review active principals, their matches and their grants after IdP changes.",{"_3603":700,"_31001":542,"_21481":52791,"_5":14758,"_28188":52389,"_3059":52792},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3603":701,"_31001":542,"_21481":52794,"_5":14758,"_28188":52389,"_3059":52795},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3603":702,"_31001":542,"_21481":52797,"_5":14758,"_28188":52389,"_3059":52798},[],"Always test one allowed and one denied operation for each role.",{"_3603":703,"_31001":542,"_21481":52800,"_5":14758,"_28188":52389,"_3059":52801},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3603":704,"_31001":542,"_21481":52803,"_5":14758,"_28188":52397,"_3059":52804},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3603":705,"_31001":542,"_21481":52806,"_5":14758,"_28188":52401,"_3059":52807},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3603":706,"_31001":542,"_21481":52809,"_5":14758,"_28188":52401,"_3059":52810},[],"that an active principal of the correct type exists;",{"_3603":707,"_31001":542,"_21481":52812,"_5":14758,"_28188":52401,"_3059":52813},[],"that the claim paths and values match the real token exactly;",{"_3603":708,"_31001":542,"_21481":52815,"_5":14758,"_28188":52401,"_3059":52816},[],"that all of the principal's conditions hold;",{"_3603":709,"_31001":542,"_21481":52818,"_5":14758,"_28188":52401,"_3059":52819},[],"that the principal has the expected policy granted;",{"_3603":710,"_31001":542,"_21481":52821,"_5":14758,"_28188":52401,"_3059":52822},[],"that the policy includes the action and the requested resource type or route;",{"_3603":711,"_31001":542,"_21481":52824,"_5":14758,"_28188":52401,"_3059":52825},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3603":712,"_31001":542,"_21481":52827,"_5":14758,"_28188":52401,"_3059":52828},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3603":713,"_31001":542,"_21481":52830,"_5":14758,"_28188":52401,"_3059":52831},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3603":714,"_31001":542,"_21481":52833,"_5":14758,"_28188":52405,"_3059":52834},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3603":715,"_31001":542,"_21481":52836,"_5":14758,"_28188":52409,"_3059":52837},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3603":716,"_31001":542,"_21481":52839,"_5":14758,"_28188":52413,"_3059":52840},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3603":717,"_31001":542,"_21481":52842,"_5":14758,"_28188":52413,"_3059":52843},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3603":718,"_31001":718,"_5":15118,"_3059":52845,"_31339":52846,"_21481":52847,"_28188":718},"Alerts and subscriptions",[50643,52155,52156],[],{"_3603":719,"_31001":718,"_21481":52849,"_5":14758,"_28188":718,"_3059":52850},[],"Send PKI events to people and external systems.",{"_3603":720,"_31001":718,"_5":31336,"_21481":52852,"_28188":52853,"_3059":52854},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3603":721,"_31001":718,"_5":31336,"_21481":52856,"_28188":52857,"_3059":52858},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3603":722,"_31001":718,"_5":31336,"_21481":52860,"_28188":52861,"_3059":52862},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3603":723,"_31001":718,"_5":31336,"_21481":52864,"_28188":52865,"_3059":52866},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3603":724,"_31001":718,"_5":31336,"_21481":52868,"_28188":52869,"_3059":52870},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3603":725,"_31001":718,"_5":31336,"_21481":52872,"_28188":52873,"_3059":52874},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3603":726,"_31001":718,"_5":31336,"_21481":52876,"_28188":52877,"_3059":52878},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3603":727,"_31001":718,"_5":31336,"_21481":52880,"_28188":52881,"_3059":52882},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3603":728,"_31001":718,"_5":31336,"_21481":52884,"_28188":52885,"_3059":52886},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3603":729,"_31001":718,"_5":31336,"_21481":52888,"_28188":52889,"_3059":52890},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3603":730,"_31001":718,"_5":31336,"_21481":52892,"_28188":52893,"_3059":52894},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3603":731,"_31001":718,"_21481":52896,"_5":14758,"_28188":718,"_3059":52897},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3603":732,"_31001":718,"_21481":52899,"_5":14758,"_28188":52853,"_3059":52900},[],"A service publishes a domain event.",{"_3603":733,"_31001":718,"_21481":52902,"_5":14758,"_28188":52853,"_3059":52903},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3603":734,"_31001":718,"_21481":52905,"_5":14758,"_28188":52853,"_3059":52906},[],"Each subscription's filter decides whether it should be notified.",{"_3603":735,"_31001":718,"_21481":52908,"_5":14758,"_28188":52853,"_3059":52909},[],"Lamassu delivers the event to the configured channel.",{"_3603":736,"_31001":718,"_21481":52911,"_5":14758,"_28188":52853,"_3059":52912},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3603":737,"_31001":718,"_21481":52914,"_5":14758,"_28188":52857,"_3059":52915},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3603":738,"_31001":718,"_21481":52917,"_5":14758,"_28188":52857,"_3059":52918},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3603":739,"_31001":718,"_21481":52920,"_5":14758,"_28188":52857,"_3059":52921},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3603":740,"_31001":718,"_21481":52923,"_5":14758,"_28188":52857,"_3059":52924},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3603":741,"_31001":718,"_21481":52926,"_5":14758,"_28188":52857,"_3059":52927},[],"`apikey_options` requires `header` and `key`.",{"_3603":742,"_31001":718,"_21481":52929,"_5":14758,"_28188":52857,"_3059":52930},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3603":743,"_31001":718,"_21481":52932,"_5":14758,"_28188":52857,"_3059":52933},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3603":744,"_31001":718,"_21481":52935,"_5":14758,"_28188":52857,"_3059":52936},[],"The alerts API reference documents the full `http_client` schema.",{"_3603":745,"_31001":718,"_21481":52938,"_5":14758,"_28188":52865,"_3059":52939},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3603":746,"_31001":718,"_21481":52941,"_5":14758,"_28188":52869,"_3059":52942},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3603":747,"_31001":718,"_21481":52944,"_5":14758,"_28188":52873,"_3059":52945},[],"Add a filter if you don't want to receive every instance of the event.",{"_3603":748,"_31001":718,"_21481":52947,"_5":14758,"_28188":52873,"_3059":52948},[],"**None** notifies all instances of the event.",{"_3603":749,"_31001":718,"_21481":52950,"_5":14758,"_28188":52873,"_3059":52951},[],"**JSON Path** evaluates one or more specific fields.",{"_3603":750,"_31001":718,"_21481":52953,"_5":14758,"_28188":52873,"_3059":52954},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3603":751,"_31001":718,"_21481":52956,"_5":14758,"_28188":52873,"_3059":52957},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3603":752,"_31001":718,"_21481":52959,"_5":14758,"_28188":52873,"_3059":52960},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3603":753,"_31001":718,"_21481":52962,"_5":14758,"_28188":52873,"_3059":52963},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3603":754,"_31001":718,"_21481":52965,"_5":14758,"_28188":52877,"_3059":52966},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3603":755,"_31001":718,"_21481":52968,"_5":14758,"_28188":52881,"_3059":52969},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3603":756,"_31001":718,"_21481":52971,"_5":14758,"_28188":52881,"_3059":52972},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3603":757,"_31001":718,"_21481":52974,"_5":14758,"_28188":52881,"_3059":52975},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3603":758,"_31001":718,"_21481":52977,"_5":14758,"_28188":52881,"_3059":52978},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3603":759,"_31001":718,"_21481":52980,"_5":14758,"_28188":52881,"_3059":52981},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3603":760,"_31001":718,"_21481":52983,"_5":14758,"_28188":52881,"_3059":52984},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3603":761,"_31001":718,"_21481":52986,"_5":14758,"_28188":52881,"_3059":52987},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3603":762,"_31001":718,"_21481":52989,"_5":14758,"_28188":52881,"_3059":52990},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3603":763,"_31001":718,"_21481":52992,"_5":14758,"_28188":52885,"_3059":52993},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3603":764,"_31001":718,"_21481":52995,"_5":14758,"_28188":52885,"_3059":52996},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3603":765,"_31001":718,"_21481":52998,"_5":14758,"_28188":52885,"_3059":52999},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3603":766,"_31001":718,"_21481":53001,"_5":14758,"_28188":52885,"_3059":53002},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3603":767,"_31001":718,"_21481":53004,"_5":14758,"_28188":52885,"_3059":53005},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3603":768,"_31001":718,"_21481":53007,"_5":14758,"_28188":52885,"_3059":53008},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3603":769,"_31001":718,"_21481":53010,"_5":14758,"_28188":52885,"_3059":53011},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3603":770,"_31001":718,"_21481":53013,"_5":14758,"_28188":52885,"_3059":53014},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3603":771,"_31001":718,"_21481":53016,"_5":14758,"_28188":52889,"_3059":53017},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3603":772,"_31001":718,"_21481":53019,"_5":14758,"_28188":52889,"_3059":53020},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3603":773,"_31001":718,"_21481":53022,"_5":14758,"_28188":52893,"_3059":53023},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3603":774,"_31001":718,"_21481":53025,"_5":14758,"_28188":52893,"_3059":53026},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3603":775,"_31001":718,"_21481":53028,"_5":14758,"_28188":52893,"_3059":53029},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3603":776,"_31001":718,"_21481":53031,"_5":14758,"_28188":52893,"_3059":53032},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3603":777,"_31001":718,"_21481":53034,"_5":14758,"_28188":52893,"_3059":53035},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3603":778,"_31001":718,"_21481":53037,"_5":14758,"_28188":52893,"_3059":53038},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3603":779,"_31001":718,"_21481":53040,"_5":14758,"_28188":52893,"_3059":53041},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3603":780,"_31001":718,"_21481":53043,"_5":14758,"_28188":52893,"_3059":53044},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3603":781,"_31001":718,"_21481":53046,"_5":14758,"_28188":52893,"_3059":53047},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3603":782,"_31001":718,"_21481":53049,"_5":14758,"_28188":52893,"_3059":53050},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3603":783,"_31001":783,"_5":15118,"_3059":53052,"_31339":53053,"_21481":53054,"_28188":783},"Audit logs",[50643,52155,52156],[],{"_3603":784,"_31001":783,"_21481":53056,"_5":14758,"_28188":783,"_3059":53057},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3603":785,"_31001":783,"_5":31336,"_21481":53059,"_28188":53060,"_3059":53061},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3603":786,"_31001":783,"_5":31336,"_21481":53063,"_28188":53064,"_3059":53065},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3603":787,"_31001":783,"_5":31336,"_21481":53067,"_28188":53068,"_3059":53069},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3603":788,"_31001":783,"_5":31336,"_21481":53071,"_28188":53072,"_3059":53073},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3603":789,"_31001":783,"_5":31336,"_21481":53075,"_28188":53076,"_3059":53077},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3603":790,"_31001":783,"_5":31336,"_21481":53079,"_28188":53080,"_3059":53081},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3603":791,"_31001":783,"_5":31336,"_21481":53083,"_28188":53084,"_3059":53085},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3603":792,"_31001":783,"_5":31336,"_21481":53087,"_28188":53088,"_3059":53089},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3603":793,"_31001":783,"_5":31336,"_21481":53091,"_28188":53092,"_3059":53093},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3603":794,"_31001":783,"_5":31336,"_21481":53095,"_28188":53096,"_3059":53097},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3603":795,"_31001":783,"_5":31336,"_21481":53099,"_28188":53100,"_3059":53101},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3603":796,"_31001":783,"_21481":53103,"_5":14758,"_28188":783,"_3059":53104},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3603":797,"_31001":783,"_21481":53106,"_5":14758,"_28188":53060,"_3059":53107},[],"The audit body includes:",{"_3603":798,"_31001":783,"_21481":53109,"_5":14758,"_28188":53060,"_3059":53110},[],"input: data received by the operation;",{"_3603":799,"_31001":783,"_21481":53112,"_5":14758,"_28188":53060,"_3059":53113},[],"has\\_error: whether the service returned an error;",{"_3603":800,"_31001":783,"_21481":53115,"_5":14758,"_28188":53060,"_3059":53116},[],"output: produced result or error message;",{"_3603":801,"_31001":783,"_21481":53118,"_5":14758,"_28188":53060,"_3059":53119},[],"principals: identifiers of the principals that matched the request.",{"_3603":802,"_31001":783,"_21481":53121,"_5":14758,"_28188":53060,"_3059":53122},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3603":803,"_31001":783,"_21481":53124,"_5":14758,"_28188":53060,"_3059":53125},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3603":804,"_31001":783,"_21481":53127,"_5":14758,"_28188":53064,"_3059":53128},[],"The backend applies auditing to mutations of:",{"_3603":805,"_31001":783,"_21481":53130,"_5":14758,"_28188":53064,"_3059":53131},[],"authorities, certificates and issuance profiles;",{"_3603":806,"_31001":783,"_21481":53133,"_5":14758,"_28188":53064,"_3059":53134},[],"keys and KMS engines;",{"_3603":807,"_31001":783,"_21481":53136,"_5":14758,"_28188":53064,"_3059":53137},[],"devices and identities;",{"_3603":808,"_31001":783,"_21481":53139,"_5":14758,"_28188":53064,"_3059":53140},[],"DMSs and enrollment operations;",{"_3603":809,"_31001":783,"_21481":53142,"_5":14758,"_28188":53064,"_3059":53143},[],"validation functions and CRL;",{"_3603":810,"_31001":783,"_21481":53145,"_5":14758,"_28188":53064,"_3059":53146},[],"principals, policies and authorization grants.",{"_3603":811,"_31001":783,"_21481":53148,"_5":14758,"_28188":53064,"_3059":53149},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3603":812,"_31001":783,"_21481":53151,"_5":14758,"_28188":53068,"_3059":53152},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3603":813,"_31001":783,"_21481":53154,"_5":14758,"_28188":53068,"_3059":53155},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3603":814,"_31001":783,"_21481":53157,"_5":14758,"_28188":53068,"_3059":53158},[],"Design the consumer to:",{"_3603":815,"_31001":783,"_21481":53160,"_5":14758,"_28188":53068,"_3059":53161},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3603":816,"_31001":783,"_21481":53163,"_5":14758,"_28188":53068,"_3059":53164},[],"keep the complete CloudEvent unmodified;",{"_3603":817,"_31001":783,"_21481":53166,"_5":14758,"_28188":53068,"_3059":53167},[],"record the ingestion time and detect duplicates by ID;",{"_3603":818,"_31001":783,"_21481":53169,"_5":14758,"_28188":53068,"_3059":53170},[],"encrypt in transit and at rest;",{"_3603":819,"_31001":783,"_21481":53172,"_5":14758,"_28188":53068,"_3059":53173},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3603":820,"_31001":783,"_21481":53175,"_5":14758,"_28188":53068,"_3059":53176},[],"apply an explicit retention and legal hold policy;",{"_3603":821,"_31001":783,"_21481":53178,"_5":14758,"_28188":53068,"_3059":53179},[],"alert if it stops consuming or the pending queue grows.",{"_3603":822,"_31001":783,"_21481":53181,"_5":14758,"_28188":53072,"_3059":53182},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3603":823,"_31001":783,"_21481":53184,"_5":14758,"_28188":53072,"_3059":53185},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3603":824,"_31001":783,"_21481":53187,"_5":14758,"_28188":53080,"_3059":53188},[],"Start from the reported time and normalize every source to UTC.",{"_3603":825,"_31001":783,"_21481":53190,"_5":14758,"_28188":53084,"_3059":53191},[],"Filter by event type, service source and resource identifier.",{"_3603":826,"_31001":783,"_21481":53193,"_5":14758,"_28188":53088,"_3059":53194},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3603":827,"_31001":783,"_21481":53196,"_5":14758,"_28188":53092,"_3059":53197},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3603":828,"_31001":783,"_21481":53199,"_5":14758,"_28188":53096,"_3059":53200},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3603":829,"_31001":783,"_21481":53202,"_5":14758,"_28188":53100,"_3059":53203},[],"Generate a controlled mutation in a test environment and check that:",{"_3603":830,"_31001":783,"_21481":53205,"_5":14758,"_28188":53100,"_3059":53206},[],"a successful audit event appears;",{"_3603":831,"_31001":783,"_21481":53208,"_5":14758,"_28188":53100,"_3059":53209},[],"the principal matches the identity used;",{"_3603":832,"_31001":783,"_21481":53211,"_5":14758,"_28188":53100,"_3059":53212},[],"the consumer persists it exactly once;",{"_3603":833,"_31001":783,"_21481":53214,"_5":14758,"_28188":53100,"_3059":53215},[],"it can be retrieved by resource, actor and period;",{"_3603":834,"_31001":783,"_21481":53217,"_5":14758,"_28188":53100,"_3059":53218},[],"a consumer outage raises an alert.",{"_3603":835,"_31001":783,"_21481":53220,"_5":14758,"_28188":53100,"_3059":53221},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3603":836,"_31001":836,"_5":15118,"_3059":53223,"_31339":53224,"_21481":53225,"_28188":836},"Platform architecture",[50643,52155],[],{"_3603":837,"_31001":836,"_21481":53227,"_5":14758,"_28188":836,"_3059":53228},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3603":838,"_31001":836,"_5":31336,"_21481":53230,"_28188":53231,"_3059":53232},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3603":839,"_31001":836,"_5":31336,"_21481":53234,"_28188":53235,"_3059":53236},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3603":840,"_31001":836,"_5":31336,"_21481":53238,"_28188":53239,"_3059":53240},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3603":841,"_31001":836,"_5":31336,"_21481":53242,"_28188":53243,"_3059":53244},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3603":842,"_31001":836,"_5":31336,"_21481":53246,"_28188":53247,"_3059":53248},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3603":843,"_31001":836,"_21481":53250,"_5":14758,"_28188":836,"_3059":53251},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3603":844,"_31001":836,"_21481":53253,"_5":14758,"_28188":836,"_3059":53254},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3603":845,"_31001":836,"_21481":53256,"_5":14758,"_28188":53231,"_3059":53257},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3603":846,"_31001":836,"_21481":53259,"_5":14758,"_28188":53235,"_3059":53260},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3603":847,"_31001":836,"_21481":53262,"_5":14758,"_28188":53239,"_3059":53263},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3603":848,"_31001":836,"_21481":53265,"_5":14758,"_28188":53243,"_3059":53266},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3603":849,"_31001":836,"_21481":53268,"_5":14758,"_28188":53247,"_3059":53269},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3603":850,"_31001":850,"_5":15118,"_3059":53271,"_31339":53272,"_21481":53273,"_28188":850},"How Lamassu works",[50643,52155],[],{"_3603":851,"_31001":850,"_21481":53275,"_5":14758,"_28188":850,"_3059":53276},[],"The mental model of trust, keys, certificates and devices.",{"_3603":852,"_31001":850,"_5":31336,"_21481":53278,"_28188":53279,"_3059":53280},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3603":853,"_31001":850,"_5":31336,"_21481":53282,"_28188":53283,"_3059":53284},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3603":854,"_31001":850,"_21481":53286,"_5":14758,"_28188":850,"_3059":53287},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3603":855,"_31001":850,"_21481":53289,"_5":14758,"_28188":53279,"_3059":53290},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3603":856,"_31001":850,"_21481":53292,"_5":14758,"_28188":53279,"_3059":53293},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3603":857,"_31001":850,"_21481":53295,"_5":14758,"_28188":53279,"_3059":53296},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3603":858,"_31001":850,"_21481":53298,"_5":14758,"_28188":53279,"_3059":53299},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3603":859,"_31001":850,"_21481":53301,"_5":14758,"_28188":53279,"_3059":53302},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3603":860,"_31001":850,"_21481":53304,"_5":14758,"_28188":53283,"_3059":53305},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3603":861,"_31001":850,"_21481":53307,"_5":14758,"_28188":53283,"_3059":53308},[],"A DMS relates that CA to an enrollment policy.",{"_3603":862,"_31001":850,"_21481":53310,"_5":14758,"_28188":53283,"_3059":53311},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3603":863,"_31001":850,"_21481":53313,"_5":14758,"_28188":53283,"_3059":53314},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3603":864,"_31001":850,"_21481":53316,"_5":14758,"_28188":53283,"_3059":53317},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3603":865,"_31001":850,"_21481":53319,"_5":14758,"_28188":53283,"_3059":53320},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3603":866,"_31001":850,"_21481":53322,"_5":14758,"_28188":53283,"_3059":53323},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3603":867,"_31001":867,"_5":15118,"_3059":53325,"_31339":53326,"_21481":53328,"_28188":867},"Devices and identities",[50643,52155,53327,53325],"IoT Fleets",[],{"_3603":868,"_31001":867,"_21481":53330,"_5":14758,"_28188":867,"_3059":53331},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3603":869,"_31001":867,"_5":31336,"_21481":53333,"_28188":53334,"_3059":53335},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3603":870,"_31001":867,"_5":31336,"_21481":53337,"_28188":53338,"_3059":53339},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3603":871,"_31001":867,"_5":31336,"_21481":53341,"_28188":53342,"_3059":53343},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3603":872,"_31001":867,"_5":31336,"_21481":53345,"_28188":53346,"_3059":53347},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3603":873,"_31001":867,"_5":31336,"_21481":53349,"_28188":53350,"_3059":53351},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3603":874,"_31001":867,"_5":31336,"_21481":53353,"_28188":53354,"_3059":53355},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3603":875,"_31001":867,"_5":31336,"_21481":53357,"_28188":53358,"_3059":53359},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3603":876,"_31001":867,"_5":31336,"_21481":53361,"_28188":53362,"_3059":53363},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3603":877,"_31001":867,"_5":31336,"_21481":53365,"_28188":53366,"_3059":53367},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3603":878,"_31001":867,"_5":31336,"_21481":53369,"_28188":53370,"_3059":53371},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3603":879,"_31001":867,"_5":31336,"_21481":53373,"_28188":53374,"_3059":53375},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3603":880,"_31001":867,"_21481":53377,"_5":14758,"_28188":867,"_3059":53378},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3603":881,"_31001":867,"_21481":53380,"_5":14758,"_28188":867,"_3059":53381},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3603":882,"_31001":867,"_21481":53383,"_5":14758,"_28188":53334,"_3059":53384},[],"Operational view",{"_3603":883,"_31001":867,"_21481":53386,"_5":14758,"_28188":53334,"_3059":53387},[],"Meaning",{"_3603":884,"_31001":867,"_21481":53389,"_5":14758,"_28188":53334,"_3059":53390},[],"**No Identity**",{"_3603":885,"_31001":867,"_21481":53392,"_5":14758,"_28188":53334,"_3059":53393},[],"A record exists without an associated identity.",{"_3603":886,"_31001":867,"_21481":53395,"_5":14758,"_28188":53334,"_3059":53396},[],"**Active**",{"_3603":887,"_31001":867,"_21481":53398,"_5":14758,"_28188":53334,"_3059":53399},[],"The slot is active; also check certificate dates, status and usages.",{"_3603":888,"_31001":867,"_21481":53401,"_5":14758,"_28188":53334,"_3059":53402},[],"**Renewal Pending**",{"_3603":889,"_31001":867,"_21481":53404,"_5":14758,"_28188":53334,"_3059":53405},[],"The identity is in the operational renewal window.",{"_3603":890,"_31001":867,"_21481":53407,"_5":14758,"_28188":53334,"_3059":53408},[],"**Expiring Soon**",{"_3603":891,"_31001":867,"_21481":53410,"_5":14758,"_28188":53334,"_3059":53411},[],"Expiration is approaching according to configured thresholds.",{"_3603":892,"_31001":867,"_21481":53413,"_5":14758,"_28188":53334,"_3059":53414},[],"**Expired**",{"_3603":893,"_31001":867,"_21481":53416,"_5":14758,"_28188":53334,"_3059":53417},[],"The identity has expired.",{"_3603":894,"_31001":867,"_21481":53419,"_5":14758,"_28188":53334,"_3059":53420},[],"**Revoked**",{"_3603":895,"_31001":867,"_21481":53422,"_5":14758,"_28188":53334,"_3059":53423},[],"The identity is marked revoked.",{"_3603":896,"_31001":867,"_21481":53425,"_5":14758,"_28188":53334,"_3059":53426},[],"**Decommissioned**",{"_3603":897,"_31001":867,"_21481":53428,"_5":14758,"_28188":53334,"_3059":53429},[],"The record is retired and ordinary updates do not restore operation.",{"_3603":898,"_31001":867,"_21481":53431,"_5":14758,"_28188":53334,"_3059":53432},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3603":899,"_31001":867,"_21481":53434,"_5":14758,"_28188":53338,"_3059":53435},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3603":900,"_31001":867,"_21481":53437,"_5":14758,"_28188":53338,"_3059":53438},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3603":901,"_31001":867,"_21481":53440,"_5":14758,"_28188":53338,"_3059":53441},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3603":902,"_31001":867,"_21481":53443,"_5":14758,"_28188":53338,"_3059":53444},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3603":903,"_31001":867,"_21481":53446,"_5":14758,"_28188":53342,"_3059":53447},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3603":904,"_31001":867,"_21481":53449,"_5":14758,"_28188":53346,"_3059":53450},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3603":905,"_31001":867,"_21481":53452,"_5":14758,"_28188":53350,"_3059":53453},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3603":906,"_31001":867,"_21481":53455,"_5":14758,"_28188":53354,"_3059":53456},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3603":907,"_31001":867,"_21481":53458,"_5":14758,"_28188":53358,"_3059":53459},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3603":908,"_31001":867,"_21481":53461,"_5":14758,"_28188":53358,"_3059":53462},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3603":909,"_31001":867,"_21481":53464,"_5":14758,"_28188":53362,"_3059":53465},[],"From **No Identity**, use **Assign Identity**:",{"_3603":910,"_31001":867,"_21481":53467,"_5":14758,"_28188":53362,"_3059":53468},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3603":911,"_31001":867,"_21481":53470,"_5":14758,"_28188":53362,"_3059":53471},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3603":912,"_31001":867,"_21481":53473,"_5":14758,"_28188":53362,"_3059":53474},[],"Confirm and read the serial, active version and history again.",{"_3603":913,"_31001":867,"_21481":53476,"_5":14758,"_28188":53362,"_3059":53477},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3603":914,"_31001":867,"_21481":53479,"_5":14758,"_28188":53362,"_3059":53480},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3603":915,"_31001":867,"_21481":53482,"_5":14758,"_28188":53366,"_3059":53483},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3603":916,"_31001":867,"_21481":53485,"_5":14758,"_28188":53366,"_3059":53486},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3603":917,"_31001":867,"_21481":53488,"_5":14758,"_28188":53370,"_3059":53489},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3603":918,"_31001":867,"_21481":53491,"_5":14758,"_28188":53370,"_3059":53492},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3603":919,"_31001":867,"_21481":53494,"_5":14758,"_28188":53370,"_3059":53495},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3603":920,"_31001":867,"_21481":53497,"_5":14758,"_28188":53370,"_3059":53498},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3603":921,"_31001":867,"_21481":53500,"_5":14758,"_28188":53374,"_3059":53501},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3603":922,"_31001":867,"_21481":53503,"_5":14758,"_28188":53374,"_3059":53504},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3603":923,"_31001":923,"_5":15118,"_3059":53506,"_31339":53507,"_21481":53509,"_28188":923},"Bootstrap identity and authentication",[50643,52155,53327,53325,53508],"Enrollment with PKI",[],{"_3603":924,"_31001":923,"_21481":53511,"_5":14758,"_28188":923,"_3059":53512},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3603":925,"_31001":923,"_5":31336,"_21481":53514,"_28188":53515,"_3059":53516},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3603":926,"_31001":923,"_5":31336,"_21481":53518,"_28188":53519,"_3059":53520},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3603":927,"_31001":923,"_5":31336,"_21481":53522,"_28188":53523,"_3059":53524},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3603":928,"_31001":923,"_5":31336,"_21481":53526,"_28188":53527,"_3059":53528},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3603":929,"_31001":923,"_5":31336,"_21481":53530,"_28188":53531,"_3059":53532},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3603":930,"_31001":923,"_21481":53534,"_5":14758,"_28188":923,"_3059":53535},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3603":931,"_31001":923,"_21481":53537,"_5":14758,"_28188":53515,"_3059":53538},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3603":932,"_31001":923,"_21481":53540,"_5":14758,"_28188":53515,"_3059":53541},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3603":933,"_31001":923,"_21481":53543,"_5":14758,"_28188":53519,"_3059":53544},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. In the inspected flow, the validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3603":934,"_31001":923,"_21481":53546,"_5":14758,"_28188":53519,"_3059":53547},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3603":935,"_31001":923,"_21481":53549,"_5":14758,"_28188":53519,"_3059":53550},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3603":936,"_31001":923,"_21481":53552,"_5":14758,"_28188":53523,"_3059":53553},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3603":937,"_31001":923,"_21481":53555,"_5":14758,"_28188":53523,"_3059":53556},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3603":938,"_31001":923,"_21481":53558,"_5":14758,"_28188":53527,"_3059":53559},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3603":939,"_31001":923,"_21481":53561,"_5":14758,"_28188":53527,"_3059":53562},[],"Example body:",{"_3603":940,"_31001":923,"_21481":53564,"_5":14758,"_28188":53527,"_3059":53565},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3603":941,"_31001":923,"_21481":53567,"_5":14758,"_28188":53527,"_3059":53568},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3603":942,"_31001":923,"_21481":53570,"_5":14758,"_28188":53527,"_3059":53571},[],"Continuation requires a successful HTTP response and JSON:",{"_3603":943,"_31001":923,"_21481":53573,"_5":14758,"_28188":53527,"_3059":53574},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3603":944,"_31001":923,"_21481":53576,"_5":14758,"_28188":53531,"_3059":53577},[],"The DMS first looks up the certificate in Lamassu; for external certificates it attempts OCSP and CRL. If revocation cannot be checked, validators can continue treating it as not revoked. The code also does not establish rejection of every external status other than Good. Test required behavior with your actual credential and endpoint; do not present this as guaranteed strict enforcement across every source.",{"_3603":945,"_31001":923,"_21481":53579,"_5":14758,"_28188":53531,"_3059":53580},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3603":946,"_31001":946,"_5":15118,"_3059":53582,"_31339":53583,"_21481":53584,"_28188":946},"Configure and operate the DMS",[50643,52155,53327,53325,53508],[],{"_3603":947,"_31001":946,"_21481":53586,"_5":14758,"_28188":946,"_3059":53587},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3603":948,"_31001":946,"_5":31336,"_21481":53589,"_28188":53590,"_3059":50653},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3603":949,"_31001":946,"_5":31336,"_21481":53592,"_28188":53593,"_3059":53594},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3603":950,"_31001":946,"_5":31336,"_21481":53596,"_28188":53597,"_3059":53598},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3603":951,"_31001":946,"_5":31336,"_21481":53600,"_28188":53601,"_3059":53602},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3603":952,"_31001":946,"_5":31336,"_21481":53604,"_28188":53605,"_3059":53606},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3603":953,"_31001":946,"_5":31336,"_21481":53608,"_28188":53609,"_3059":53610},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3603":954,"_31001":946,"_5":31336,"_21481":53612,"_28188":53613,"_3059":53614},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3603":955,"_31001":946,"_5":31336,"_21481":53616,"_28188":53617,"_3059":53618},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3603":956,"_31001":946,"_5":31336,"_21481":53620,"_28188":53621,"_3059":53622},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3603":957,"_31001":946,"_5":31336,"_21481":53624,"_28188":53625,"_3059":53626},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3603":958,"_31001":946,"_5":31336,"_21481":53628,"_28188":53629,"_3059":53630},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3603":959,"_31001":946,"_5":31336,"_21481":53632,"_28188":53633,"_3059":53634},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3603":960,"_31001":946,"_5":31336,"_21481":53636,"_28188":53637,"_3059":53638},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3603":961,"_31001":946,"_5":31336,"_21481":53640,"_28188":53641,"_3059":53642},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3603":962,"_31001":946,"_5":31336,"_21481":53644,"_28188":53645,"_3059":53646},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3603":963,"_31001":946,"_5":31336,"_21481":53648,"_28188":53649,"_3059":53650},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3603":964,"_31001":946,"_5":31336,"_21481":53652,"_28188":53653,"_3059":53654},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3603":965,"_31001":946,"_5":31336,"_21481":53656,"_28188":53657,"_3059":53658},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3603":966,"_31001":946,"_21481":53660,"_5":14758,"_28188":946,"_3059":53661},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3603":967,"_31001":946,"_21481":53663,"_5":14758,"_28188":53590,"_3059":53664},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3603":968,"_31001":946,"_21481":53666,"_5":14758,"_28188":53590,"_3059":53667},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3603":969,"_31001":946,"_21481":53669,"_5":14758,"_28188":53597,"_3059":53670},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3603":970,"_31001":946,"_21481":53672,"_5":14758,"_28188":53601,"_3059":53673},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3603":971,"_31001":946,"_21481":53675,"_5":14758,"_28188":53605,"_3059":53676},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3603":972,"_31001":946,"_21481":53678,"_5":14758,"_28188":53609,"_3059":53679},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3603":973,"_31001":946,"_21481":53681,"_5":14758,"_28188":53613,"_3059":53682},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3603":974,"_31001":946,"_21481":53684,"_5":14758,"_28188":53621,"_3059":53685},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3603":975,"_31001":946,"_21481":53687,"_5":14758,"_28188":53621,"_3059":53688},[],"PRE\\_REGISTRATION requires an existing ID. In the inspected code, an existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3603":976,"_31001":946,"_21481":53690,"_5":14758,"_28188":53625,"_3059":53691},[],"`settings.enrollment_settings` field",{"_3603":977,"_31001":946,"_21481":53693,"_5":14758,"_28188":53625,"_3059":53694},[],"Decision",{"_3603":978,"_31001":946,"_21481":53696,"_5":14758,"_28188":53625,"_3059":53697},[],"`protocol`",{"_3603":979,"_31001":946,"_21481":53699,"_5":14758,"_28188":53625,"_3059":53700},[],"`EST_RFC7030` for these operations.",{"_3603":980,"_31001":946,"_21481":53702,"_5":14758,"_28188":53625,"_3059":53703},[],"`enrollment_ca`",{"_3603":981,"_31001":946,"_21481":53705,"_5":14758,"_28188":53625,"_3059":53706},[],"ID of the signing CA.",{"_3603":982,"_31001":946,"_21481":53708,"_5":14758,"_28188":53625,"_3059":53709},[],"`verify_csr_signature`",{"_3603":983,"_31001":946,"_21481":53711,"_5":14758,"_28188":53625,"_3059":53712},[],"Keep `true` to verify CSR key possession.",{"_3603":984,"_31001":946,"_21481":53714,"_5":14758,"_28188":53625,"_3059":53715},[],"`enable_replaceable_enrollment`",{"_3603":985,"_31001":946,"_21481":53717,"_5":14758,"_28188":53625,"_3059":53718},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3603":986,"_31001":946,"_21481":53720,"_5":14758,"_28188":53625,"_3059":53721},[],"`est_rfc7030_settings.auth_mode`",{"_3603":987,"_31001":946,"_21481":53723,"_5":14758,"_28188":53625,"_3059":53724},[],"One of the four authentication modes.",{"_3603":988,"_31001":946,"_21481":53726,"_5":14758,"_28188":53625,"_3059":53727},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3603":989,"_31001":946,"_21481":53729,"_5":14758,"_28188":53629,"_3059":53730},[],"The blocks are independent:",{"_3603":990,"_31001":946,"_21481":53732,"_5":14758,"_28188":53629,"_3059":53733},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3603":991,"_31001":946,"_21481":53735,"_5":14758,"_28188":53629,"_3059":53736},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3603":992,"_31001":946,"_21481":53738,"_5":14758,"_28188":53629,"_3059":53739},[],"`auth_mode`",{"_3603":993,"_31001":946,"_21481":53741,"_5":14758,"_28188":53629,"_3059":53742},[],"Control applied in the configured operation",{"_3603":994,"_31001":946,"_21481":53744,"_5":14758,"_28188":53629,"_3059":53745},[],"`CLIENT_CERTIFICATE`",{"_3603":995,"_31001":946,"_21481":53747,"_5":14758,"_28188":53629,"_3059":53748},[],"Presented certificate validation.",{"_3603":996,"_31001":946,"_21481":53750,"_5":14758,"_28188":53629,"_3059":53751},[],"`EXTERNAL_WEBHOOK`",{"_3603":997,"_31001":946,"_21481":53753,"_5":14758,"_28188":53629,"_3059":53754},[],"Configured webhook authorization.",{"_3603":998,"_31001":946,"_21481":53756,"_5":14758,"_28188":53629,"_3059":53757},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3603":999,"_31001":946,"_21481":53759,"_5":14758,"_28188":53629,"_3059":53760},[],"Certificate validation followed by webhook approval.",{"_3603":1000,"_31001":946,"_21481":53762,"_5":14758,"_28188":53629,"_3059":53763},[],"`NO_AUTH`",{"_3603":1001,"_31001":946,"_21481":53765,"_5":14758,"_28188":53629,"_3059":53766},[],"No DMS requester authentication.",{"_3603":1002,"_31001":946,"_21481":53768,"_5":14758,"_28188":53629,"_3059":53769},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3603":1003,"_31001":946,"_21481":53771,"_5":14758,"_28188":53629,"_3059":53772},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired` and `chain_level_validation`. The inspected flow receives one certificate credential; it does not guarantee forwarding every handshake intermediate to the validator. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3603":1004,"_31001":946,"_21481":53774,"_5":14758,"_28188":53629,"_3059":53775},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`.",{"_3603":1005,"_31001":946,"_21481":53777,"_5":14758,"_28188":53629,"_3059":53778},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3603":1006,"_31001":946,"_21481":53780,"_5":14758,"_28188":53633,"_3059":53781},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3603":1007,"_31001":946,"_21481":53783,"_5":14758,"_28188":53633,"_3059":53784},[],"`external_webhook_settings` field",{"_3603":1008,"_31001":946,"_21481":53786,"_5":14758,"_28188":53633,"_3059":53694},[],{"_3603":1009,"_31001":946,"_21481":53788,"_5":14758,"_28188":53633,"_3059":53789},[],"`url`",{"_3603":1010,"_31001":946,"_21481":53791,"_5":14758,"_28188":53633,"_3059":53792},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3603":1011,"_31001":946,"_21481":53794,"_5":14758,"_28188":53633,"_3059":53795},[],"`method`",{"_3603":1012,"_31001":946,"_21481":53797,"_5":14758,"_28188":53633,"_3059":53798},[],"`POST` or `PUT`; `POST` by default.",{"_3603":1013,"_31001":946,"_21481":53800,"_5":14758,"_28188":53633,"_3059":53801},[],"`name`",{"_3603":1014,"_31001":946,"_21481":53803,"_5":14758,"_28188":53633,"_3059":53804},[],"Label used in service logs.",{"_3603":1015,"_31001":946,"_21481":53806,"_5":14758,"_28188":53633,"_3059":53807},[],"`config.auth_mode`",{"_3603":1016,"_31001":946,"_21481":53809,"_5":14758,"_28188":53633,"_3059":53810},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3603":1017,"_31001":946,"_21481":53812,"_5":14758,"_28188":53633,"_3059":53813},[],"`config.log_level`",{"_3603":1018,"_31001":946,"_21481":53815,"_5":14758,"_28188":53633,"_3059":53816},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3603":1019,"_31001":946,"_21481":53818,"_5":14758,"_28188":53633,"_3059":53819},[],"`config.apikey_options`",{"_3603":1020,"_31001":946,"_21481":53821,"_5":14758,"_28188":53633,"_3059":53822},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3603":1021,"_31001":946,"_21481":53824,"_5":14758,"_28188":53633,"_3059":53825},[],"`config.jwt_options`",{"_3603":1022,"_31001":946,"_21481":53827,"_5":14758,"_28188":53633,"_3059":53828},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3603":1023,"_31001":946,"_21481":53830,"_5":14758,"_28188":53633,"_3059":53831},[],"`config.mtls_options`",{"_3603":1024,"_31001":946,"_21481":53833,"_5":14758,"_28188":53633,"_3059":53834},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3603":1025,"_31001":946,"_21481":53836,"_5":14758,"_28188":53633,"_3059":53837},[],"`config.insecure_skip_verify`",{"_3603":1026,"_31001":946,"_21481":53839,"_5":14758,"_28188":53633,"_3059":53840},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3603":1027,"_31001":946,"_21481":53842,"_5":14758,"_28188":53633,"_3059":53843},[],"`config.call_timeout`",{"_3603":1028,"_31001":946,"_21481":53845,"_5":14758,"_28188":53633,"_3059":53846},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3603":1029,"_31001":946,"_21481":53848,"_5":14758,"_28188":53633,"_3059":53849},[],"Rules for that configuration:",{"_3603":1030,"_31001":946,"_21481":53851,"_5":14758,"_28188":53633,"_3059":53852},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3603":1031,"_31001":946,"_21481":53854,"_5":14758,"_28188":53633,"_3059":53855},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3603":1032,"_31001":946,"_21481":53857,"_5":14758,"_28188":53633,"_3059":53858},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3603":1033,"_31001":946,"_21481":53860,"_5":14758,"_28188":53633,"_3059":53861},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3603":1034,"_31001":946,"_21481":53863,"_5":14758,"_28188":53633,"_3059":53864},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3603":1035,"_31001":946,"_21481":53866,"_5":14758,"_28188":53633,"_3059":53867},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3603":1036,"_31001":946,"_21481":53869,"_5":14758,"_28188":53633,"_3059":53870},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3603":1037,"_31001":946,"_21481":53872,"_5":14758,"_28188":53633,"_3059":53873},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3603":1038,"_31001":946,"_21481":53875,"_5":14758,"_28188":53633,"_3059":53876},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3603":1039,"_31001":946,"_21481":53878,"_5":14758,"_28188":53637,"_3059":53879},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3603":1040,"_31001":946,"_21481":53881,"_5":14758,"_28188":53641,"_3059":53882},[],"`settings.reenrollment_settings` field",{"_3603":1041,"_31001":946,"_21481":53884,"_5":14758,"_28188":53641,"_3059":51033},[],{"_3603":1042,"_31001":946,"_21481":53886,"_5":14758,"_28188":53641,"_3059":53887},[],"`reenrollment_delta`",{"_3603":1043,"_31001":946,"_21481":53889,"_5":14758,"_28188":53641,"_3059":53890},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3603":1044,"_31001":946,"_21481":53892,"_5":14758,"_28188":53641,"_3059":53893},[],"`preventive_delta`",{"_3603":1045,"_31001":946,"_21481":53895,"_5":14758,"_28188":53641,"_3059":53896},[],"Preventive operational monitoring threshold.",{"_3603":1046,"_31001":946,"_21481":53898,"_5":14758,"_28188":53641,"_3059":53899},[],"`critical_delta`",{"_3603":1047,"_31001":946,"_21481":53901,"_5":14758,"_28188":53641,"_3059":53902},[],"Critical operational monitoring threshold.",{"_3603":1048,"_31001":946,"_21481":53904,"_5":14758,"_28188":53641,"_3059":53905},[],"`enable_expired_renewal`",{"_3603":1049,"_31001":946,"_21481":53907,"_5":14758,"_28188":53641,"_3059":53908},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3603":1050,"_31001":946,"_21481":53910,"_5":14758,"_28188":53641,"_3059":53911},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3603":1051,"_31001":946,"_21481":53913,"_5":14758,"_28188":53641,"_3059":53914},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3603":1052,"_31001":946,"_21481":53916,"_5":14758,"_28188":53641,"_3059":53917},[],"`revoke_on_reenrollment`",{"_3603":1053,"_31001":946,"_21481":53919,"_5":14758,"_28188":53641,"_3059":53920},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3603":1054,"_31001":946,"_21481":53922,"_5":14758,"_28188":53641,"_3059":53923},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3603":1055,"_31001":946,"_21481":53925,"_5":14758,"_28188":53645,"_3059":53926},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3603":1056,"_31001":946,"_21481":53928,"_5":14758,"_28188":53649,"_3059":51027},[],{"_3603":1057,"_31001":946,"_21481":53930,"_5":14758,"_28188":53649,"_3059":53931},[],"Published material",{"_3603":1058,"_31001":946,"_21481":53933,"_5":14758,"_28188":53649,"_3059":53934},[],"**Include Lamassu System CA**",{"_3603":1059,"_31001":946,"_21481":53936,"_5":14758,"_28188":53649,"_3059":53937},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3603":1060,"_31001":946,"_21481":53939,"_5":14758,"_28188":53649,"_3059":53940},[],"**Include Enrollment CA**",{"_3603":1061,"_31001":946,"_21481":53942,"_5":14758,"_28188":53649,"_3059":53943},[],"Selected issuing CA certificate.",{"_3603":1062,"_31001":946,"_21481":53945,"_5":14758,"_28188":53649,"_3059":53946},[],"**Managed CAs**",{"_3603":1063,"_31001":946,"_21481":53948,"_5":14758,"_28188":53649,"_3059":53949},[],"Explicitly selected CA certificates.",{"_3603":1064,"_31001":946,"_21481":53951,"_5":14758,"_28188":53649,"_3059":53952},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3603":1065,"_31001":946,"_21481":53954,"_5":14758,"_28188":53653,"_3059":53955},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3603":1066,"_31001":946,"_21481":53957,"_5":14758,"_28188":53653,"_3059":53958},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3603":1067,"_31001":946,"_21481":53960,"_5":14758,"_28188":53653,"_3059":53961},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3603":1068,"_31001":946,"_21481":53963,"_5":14758,"_28188":53657,"_3059":53964},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3603":1069,"_31001":1069,"_5":15118,"_3059":53966,"_31339":53967,"_21481":53968,"_28188":1069},"Integrate the EST client",[50643,52155,53327,53325,53508],[],{"_3603":1070,"_31001":1069,"_21481":53970,"_5":14758,"_28188":1069,"_3059":53971},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3603":1071,"_31001":1069,"_5":31336,"_21481":53973,"_28188":53974,"_3059":50653},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3603":1072,"_31001":1069,"_5":31336,"_21481":53976,"_28188":53977,"_3059":53978},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3603":1073,"_31001":1069,"_5":31336,"_21481":53980,"_28188":53981,"_3059":53982},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3603":1074,"_31001":1069,"_5":31336,"_21481":53984,"_28188":53985,"_3059":53986},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3603":1075,"_31001":1069,"_5":31336,"_21481":53988,"_28188":53989,"_3059":53990},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3603":1076,"_31001":1069,"_5":31336,"_21481":53992,"_28188":53993,"_3059":53994},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3603":1077,"_31001":1069,"_21481":53996,"_5":14758,"_28188":1069,"_3059":53997},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3603":1078,"_31001":1069,"_21481":53999,"_5":14758,"_28188":53974,"_3059":54000},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3603":1079,"_31001":1069,"_21481":54002,"_5":14758,"_28188":53974,"_3059":54003},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3603":1080,"_31001":1069,"_21481":54005,"_5":14758,"_28188":53974,"_3059":54006},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3603":1081,"_31001":1069,"_21481":54008,"_5":14758,"_28188":53977,"_3059":54009},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3603":1082,"_31001":1069,"_21481":54011,"_5":14758,"_28188":53977,"_3059":54012},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3603":1083,"_31001":1069,"_21481":54014,"_5":14758,"_28188":53981,"_3059":54015},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3603":1084,"_31001":1069,"_21481":54017,"_5":14758,"_28188":53981,"_3059":54018},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3603":1085,"_31001":1069,"_21481":54020,"_5":14758,"_28188":53985,"_3059":54021},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3603":1086,"_31001":1069,"_21481":54023,"_5":14758,"_28188":53985,"_3059":54024},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3603":1087,"_31001":1069,"_21481":54026,"_5":14758,"_28188":53989,"_3059":54027},[],"For a root that issues directly:",{"_3603":1088,"_31001":1069,"_21481":54029,"_5":14758,"_28188":53989,"_3059":54030},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3603":1089,"_31001":1069,"_21481":54032,"_5":14758,"_28188":53989,"_3059":54033},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3603":1090,"_31001":1069,"_21481":54035,"_5":14758,"_28188":53993,"_3059":54036},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3603":1091,"_31001":1091,"_5":15118,"_3059":54038,"_31339":54039,"_21481":54040,"_28188":1091},"EST reference",[50643,52155,53327,53325,53508],[],{"_3603":1092,"_31001":1091,"_21481":54042,"_5":14758,"_28188":1091,"_3059":54043},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3603":1093,"_31001":1091,"_5":31336,"_21481":54045,"_28188":54046,"_3059":54047},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3603":1094,"_31001":1091,"_5":31336,"_21481":54049,"_28188":54050,"_3059":23278},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3603":1095,"_31001":1091,"_5":31336,"_21481":54052,"_28188":54053,"_3059":26744},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3603":1096,"_31001":1091,"_5":31336,"_21481":54055,"_28188":54056,"_3059":26751},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3603":1097,"_31001":1091,"_5":31336,"_21481":54058,"_28188":54059,"_3059":26029},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3603":1098,"_31001":1091,"_5":31336,"_21481":54061,"_28188":54062,"_3059":54063},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3603":1099,"_31001":1091,"_5":31336,"_21481":54065,"_28188":54066,"_3059":54067},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3603":1100,"_31001":1091,"_5":31336,"_21481":54069,"_28188":54070,"_3059":54071},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3603":1101,"_31001":1091,"_21481":54073,"_5":14758,"_28188":1091,"_3059":54074},[],"Reference for the examined backend, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3603":1102,"_31001":1091,"_21481":54076,"_5":14758,"_28188":54046,"_3059":54077},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3603":1103,"_31001":1091,"_21481":54079,"_5":14758,"_28188":54046,"_3059":54080},[],"Operation",{"_3603":1104,"_31001":1091,"_21481":54082,"_5":14758,"_28188":54046,"_3059":54083},[],"Method",{"_3603":1105,"_31001":1091,"_21481":54085,"_5":14758,"_28188":54046,"_3059":54086},[],"Authentication and condition",{"_3603":1106,"_31001":1091,"_21481":54088,"_5":14758,"_28188":54046,"_3059":54089},[],"`/cacerts`",{"_3603":1107,"_31001":1091,"_21481":54091,"_5":14758,"_28188":54046,"_3059":54092},[],"GET",{"_3603":1108,"_31001":1091,"_21481":54094,"_5":14758,"_28188":54046,"_3059":54095},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3603":1109,"_31001":1091,"_21481":54097,"_5":14758,"_28188":54046,"_3059":54098},[],"`/simpleenroll`",{"_3603":1110,"_31001":1091,"_21481":54100,"_5":14758,"_28188":54046,"_3059":54101},[],"POST",{"_3603":1111,"_31001":1091,"_21481":54103,"_5":14758,"_28188":54046,"_3059":54104},[],"Initial authentication and DMS registration/replacement policy.",{"_3603":1112,"_31001":1091,"_21481":54106,"_5":14758,"_28188":54046,"_3059":54107},[],"`/simplereenroll`",{"_3603":1113,"_31001":1091,"_21481":54109,"_5":14758,"_28188":54046,"_3059":54101},[],{"_3603":1114,"_31001":1091,"_21481":54111,"_5":14758,"_28188":54046,"_3059":54112},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3603":1115,"_31001":1091,"_21481":54114,"_5":14758,"_28188":54046,"_3059":54115},[],"`/serverkeygen`",{"_3603":1116,"_31001":1091,"_21481":54117,"_5":14758,"_28188":54046,"_3059":54101},[],{"_3603":1117,"_31001":1091,"_21481":54119,"_5":14758,"_28188":54046,"_3059":54120},[],"Initial authentication and admission; server generation enabled.",{"_3603":1118,"_31001":1091,"_21481":54122,"_5":14758,"_28188":54046,"_3059":54123},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3603":1119,"_31001":1091,"_21481":54125,"_5":14758,"_28188":54050,"_3059":54126},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3603":1120,"_31001":1091,"_21481":54128,"_5":14758,"_28188":54050,"_3059":54129},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3603":1121,"_31001":1091,"_21481":54131,"_5":14758,"_28188":54053,"_3059":54132},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The examined controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3603":1122,"_31001":1091,"_21481":54134,"_5":14758,"_28188":54053,"_3059":54135},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3603":1123,"_31001":1091,"_21481":54137,"_5":14758,"_28188":54056,"_3059":54138},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3603":1124,"_31001":1091,"_21481":54140,"_5":14758,"_28188":54056,"_3059":54141},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. See Renewal for installation and recovery.",{"_3603":1125,"_31001":1091,"_21481":54143,"_5":14758,"_28188":54059,"_3059":54144},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3603":1126,"_31001":1091,"_21481":54146,"_5":14758,"_28188":54059,"_3059":54147},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3603":1127,"_31001":1091,"_21481":54149,"_5":14758,"_28188":54062,"_3059":54150},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3603":1128,"_31001":1091,"_21481":54152,"_5":14758,"_28188":54062,"_3059":54153},[],"Part",{"_3603":1129,"_31001":1091,"_21481":54155,"_5":14758,"_28188":54062,"_3059":54156},[],"Content after decoding its Base64",{"_3603":1130,"_31001":1091,"_21481":54158,"_5":14758,"_28188":54062,"_3059":54159},[],"`application/pkcs8`",{"_3603":1131,"_31001":1091,"_21481":54161,"_5":14758,"_28188":54062,"_3059":54162},[],"Unencrypted DER PKCS#8 private key.",{"_3603":1132,"_31001":1091,"_21481":54164,"_5":14758,"_28188":54062,"_3059":54165},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3603":1133,"_31001":1091,"_21481":54167,"_5":14758,"_28188":54062,"_3059":54168},[],"DER PKCS#7 containing the issued certificate.",{"_3603":1134,"_31001":1091,"_21481":54170,"_5":14758,"_28188":54062,"_3059":54171},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3603":1135,"_31001":1091,"_21481":54173,"_5":14758,"_28188":54066,"_3059":54174},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3603":1136,"_31001":1091,"_21481":54176,"_5":14758,"_28188":54066,"_3059":54177},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3603":1137,"_31001":1091,"_21481":54179,"_5":14758,"_28188":54066,"_3059":54180},[],"Convert and check the result:",{"_3603":1138,"_31001":1091,"_21481":54182,"_5":14758,"_28188":54066,"_3059":54183},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3603":1139,"_31001":1091,"_21481":54185,"_5":14758,"_28188":54070,"_3059":54186},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3603":1140,"_31001":1091,"_21481":54188,"_5":14758,"_28188":54070,"_3059":54189},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3603":1141,"_31001":1141,"_5":15118,"_3059":53508,"_31339":54191,"_21481":54192,"_28188":1141},[50643,52155,53327,53325,53508],[],{"_3603":1142,"_31001":1141,"_21481":54194,"_5":14758,"_28188":1141,"_3059":54195},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3603":1143,"_31001":1141,"_5":31336,"_21481":54197,"_28188":54198,"_3059":54199},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3603":1144,"_31001":1141,"_5":31336,"_21481":54201,"_28188":54202,"_3059":54203},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3603":1145,"_31001":1141,"_5":31336,"_21481":54205,"_28188":54206,"_3059":54207},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3603":1146,"_31001":1141,"_5":31336,"_21481":54209,"_28188":54210,"_3059":54211},[],"/docs/platform/iot-fleets/enrollment/overview#contract-version","Contract version",{"_3603":1147,"_31001":1141,"_21481":54213,"_5":14758,"_28188":1141,"_3059":54214},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3603":1148,"_31001":1141,"_21481":54216,"_5":14758,"_28188":54198,"_3059":54217},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3603":1149,"_31001":1141,"_21481":54219,"_5":14758,"_28188":54198,"_3059":54220},[],"The integrator installs initial EST server trust and an admission credential.",{"_3603":1150,"_31001":1141,"_21481":54222,"_5":14758,"_28188":54198,"_3059":54223},[],"The client requests an identity for its `Device ID` through EST.",{"_3603":1151,"_31001":1141,"_21481":54225,"_5":14758,"_28188":54198,"_3059":54226},[],"Certificate, device binding and key/certificate installation are checked.",{"_3603":1152,"_31001":1141,"_21481":54228,"_5":14758,"_28188":54198,"_3059":54229},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3603":1153,"_31001":1141,"_21481":54231,"_5":14758,"_28188":54198,"_3059":54232},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3603":1154,"_31001":1141,"_21481":54234,"_5":14758,"_28188":54202,"_3059":54235},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3603":1155,"_31001":1141,"_21481":54237,"_5":14758,"_28188":54202,"_3059":54238},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":1156,"_31001":1141,"_21481":54240,"_5":14758,"_28188":54202,"_3059":54241},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3603":1157,"_31001":1141,"_21481":54243,"_5":14758,"_28188":54202,"_3059":54244},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3603":1158,"_31001":1141,"_21481":54246,"_5":14758,"_28188":54206,"_3059":54247},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3603":1159,"_31001":1141,"_21481":54249,"_5":14758,"_28188":54206,"_3059":54250},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3603":1160,"_31001":1141,"_21481":54252,"_5":14758,"_28188":54206,"_3059":54253},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3603":1161,"_31001":1141,"_21481":54255,"_5":14758,"_28188":54206,"_3059":54256},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3603":1162,"_31001":1141,"_21481":54258,"_5":14758,"_28188":54210,"_3059":54259},[],"This block describes `main` code inspected at commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. The site catalog publishes `main (unstable)`; this behavior is not attributed to a stable release. Before using another version, check its contract, particularly independent re-enrollment authentication. Client checks and live-instance tests are distinguished in the revision plan.",{"_3603":1163,"_31001":1141,"_21481":54261,"_5":14758,"_28188":54210,"_3059":54262},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3603":1164,"_31001":1164,"_5":15118,"_3059":54264,"_31339":54265,"_21481":54266,"_28188":1164},"Provisioning strategies",[50643,52155,53327,53325,53508],[],{"_3603":1165,"_31001":1164,"_21481":54268,"_5":14758,"_28188":1164,"_3059":54269},[],"Choose device registration, identity authorization and key generation.",{"_3603":1166,"_31001":1164,"_5":31336,"_21481":54271,"_28188":54272,"_3059":54273},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3603":1167,"_31001":1164,"_5":31336,"_21481":54275,"_28188":54276,"_3059":54277},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3603":1168,"_31001":1164,"_5":31336,"_21481":54279,"_28188":54280,"_3059":54281},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3603":1169,"_31001":1164,"_5":31336,"_21481":54283,"_28188":54284,"_3059":54285},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3603":1170,"_31001":1164,"_5":31336,"_21481":54287,"_28188":54288,"_3059":54289},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3603":1171,"_31001":1164,"_21481":54291,"_5":14758,"_28188":1164,"_3059":54292},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3603":1172,"_31001":1164,"_21481":54294,"_5":14758,"_28188":54272,"_3059":54295},[],"Path",{"_3603":1173,"_31001":1164,"_21481":54297,"_5":14758,"_28188":54272,"_3059":54298},[],"When the device exists",{"_3603":1174,"_31001":1164,"_21481":54300,"_5":14758,"_28188":54272,"_3059":54301},[],"What to check",{"_3603":1175,"_31001":1164,"_21481":54303,"_5":14758,"_28188":54272,"_3059":54304},[],"Manual assignment",{"_3603":1176,"_31001":1164,"_21481":54306,"_5":14758,"_28188":54272,"_3059":54307},[],"An operator creates it before associating a certificate.",{"_3603":1177,"_31001":1164,"_21481":54309,"_5":14758,"_28188":54272,"_3059":54310},[],"ID, owning DMS, certificate CN and bound serial.",{"_3603":1178,"_31001":1164,"_21481":54312,"_5":14758,"_28188":54272,"_3059":54313},[],"EST with `JITP`",{"_3603":1179,"_31001":1164,"_21481":54315,"_5":14758,"_28188":54272,"_3059":54316},[],"Created for an unknown CN during `/simpleenroll`.",{"_3603":1180,"_31001":1164,"_21481":54318,"_5":14758,"_28188":54272,"_3059":54319},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3603":1181,"_31001":1164,"_21481":54321,"_5":14758,"_28188":54272,"_3059":54322},[],"EST with `PRE_REGISTRATION`",{"_3603":1182,"_31001":1164,"_21481":54324,"_5":14758,"_28188":54272,"_3059":54325},[],"Must exist before `/simpleenroll`.",{"_3603":1183,"_31001":1164,"_21481":54327,"_5":14758,"_28188":54272,"_3059":54328},[],"Approved record, same DMS and replacement conditions for your version.",{"_3603":1184,"_31001":1164,"_21481":54330,"_5":14758,"_28188":54272,"_3059":54331},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3603":1185,"_31001":1164,"_21481":54333,"_5":14758,"_28188":54272,"_3059":54334},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3603":1186,"_31001":1164,"_21481":54336,"_5":14758,"_28188":54276,"_3059":54337},[],"In the inspected code, finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3603":1187,"_31001":1164,"_21481":54339,"_5":14758,"_28188":54276,"_3059":54340},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3603":1188,"_31001":1164,"_21481":54342,"_5":14758,"_28188":54276,"_3059":54343},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3603":1189,"_31001":1164,"_21481":54345,"_5":14758,"_28188":54280,"_3059":54346},[],"Decide initial enrollment and re-enrollment separately:",{"_3603":1190,"_31001":1164,"_21481":54348,"_5":14758,"_28188":54280,"_3059":54349},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3603":1191,"_31001":1164,"_21481":54351,"_5":14758,"_28188":54280,"_3059":54352},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3603":1192,"_31001":1164,"_21481":54354,"_5":14758,"_28188":54280,"_3059":54355},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3603":1193,"_31001":1164,"_21481":54357,"_5":14758,"_28188":54280,"_3059":54358},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3603":1194,"_31001":1164,"_21481":54360,"_5":14758,"_28188":54280,"_3059":54361},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3603":1195,"_31001":1164,"_21481":54363,"_5":14758,"_28188":54284,"_3059":51027},[],{"_3603":1196,"_31001":1164,"_21481":54365,"_5":14758,"_28188":54284,"_3059":54366},[],"Material crossing EST",{"_3603":1197,"_31001":1164,"_21481":54368,"_5":14758,"_28188":54284,"_3059":54369},[],"Device-generated key",{"_3603":1198,"_31001":1164,"_21481":54371,"_5":14758,"_28188":54284,"_3059":54372},[],"Public CSR and certificate; the key stays on the client.",{"_3603":1199,"_31001":1164,"_21481":54374,"_5":14758,"_28188":54284,"_3059":54375},[],"Existing device key",{"_3603":1200,"_31001":1164,"_21481":54377,"_5":14758,"_28188":54284,"_3059":54378},[],"CSR signed with that key and a new certificate.",{"_3603":1201,"_31001":1164,"_21481":54380,"_5":14758,"_28188":54284,"_3059":53646},[],{"_3603":1202,"_31001":1164,"_21481":54382,"_5":14758,"_28188":54284,"_3059":54383},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3603":1203,"_31001":1164,"_21481":54385,"_5":14758,"_28188":54284,"_3059":54386},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3603":1204,"_31001":1164,"_21481":54388,"_5":14758,"_28188":54288,"_3059":54389},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3603":1205,"_31001":1205,"_5":15118,"_3059":54391,"_31339":54392,"_21481":54393,"_28188":1205},"Renewal and recovery",[50643,52155,53327,53325,53508],[],{"_3603":1206,"_31001":1205,"_21481":54395,"_5":14758,"_28188":1205,"_3059":54396},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3603":1207,"_31001":1205,"_5":31336,"_21481":54398,"_28188":54399,"_3059":54400},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3603":1208,"_31001":1205,"_5":31336,"_21481":54402,"_28188":54403,"_3059":54404},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3603":1209,"_31001":1205,"_5":31336,"_21481":54406,"_28188":54407,"_3059":54408},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3603":1210,"_31001":1205,"_5":31336,"_21481":54410,"_28188":54411,"_3059":54412},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3603":1211,"_31001":1205,"_5":31336,"_21481":54414,"_28188":54415,"_3059":54416},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3603":1212,"_31001":1205,"_21481":54418,"_5":14758,"_28188":1205,"_3059":54419},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3603":1213,"_31001":1205,"_21481":54421,"_5":14758,"_28188":54399,"_3059":54422},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3603":1214,"_31001":1205,"_21481":54424,"_5":14758,"_28188":54399,"_3059":54425},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3603":1215,"_31001":1205,"_21481":54427,"_5":14758,"_28188":54399,"_3059":54428},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3603":1216,"_31001":1205,"_21481":54430,"_5":14758,"_28188":54399,"_3059":54431},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3603":1217,"_31001":1205,"_21481":54433,"_5":14758,"_28188":54403,"_3059":54434},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3603":1218,"_31001":1205,"_21481":54436,"_5":14758,"_28188":54403,"_3059":54437},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3603":1219,"_31001":1205,"_21481":54439,"_5":14758,"_28188":54407,"_3059":54440},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3603":1220,"_31001":1205,"_21481":54442,"_5":14758,"_28188":54407,"_3059":54443},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3603":1221,"_31001":1205,"_21481":54445,"_5":14758,"_28188":54407,"_3059":54446},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3603":1222,"_31001":1205,"_21481":54448,"_5":14758,"_28188":54411,"_3059":54449},[],"Situation",{"_3603":1223,"_31001":1205,"_21481":54451,"_5":14758,"_28188":54411,"_3059":54452},[],"Procedure",{"_3603":1224,"_31001":1205,"_21481":54454,"_5":14758,"_28188":54411,"_3059":54455},[],"Valid certificate, outside the window",{"_3603":1225,"_31001":1205,"_21481":54457,"_5":14758,"_28188":54411,"_3059":54458},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3603":1226,"_31001":1205,"_21481":54460,"_5":14758,"_28188":54411,"_3059":54461},[],"Expired certificate, key available",{"_3603":1227,"_31001":1205,"_21481":54463,"_5":14758,"_28188":54411,"_3059":54464},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3603":1228,"_31001":1205,"_21481":54466,"_5":14758,"_28188":54411,"_3059":54467},[],"Renewal through webhook or `NO_AUTH`",{"_3603":1229,"_31001":1205,"_21481":54469,"_5":14758,"_28188":54411,"_3059":54470},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3603":1230,"_31001":1205,"_21481":54472,"_5":14758,"_28188":54411,"_3059":54473},[],"Lost or inaccessible key",{"_3603":1231,"_31001":1205,"_21481":54475,"_5":14758,"_28188":54411,"_3059":54476},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3603":1232,"_31001":1205,"_21481":54478,"_5":14758,"_28188":54411,"_3059":54479},[],"Current identity revoked",{"_3603":1233,"_31001":1205,"_21481":54481,"_5":14758,"_28188":54411,"_3059":54482},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3603":1234,"_31001":1205,"_21481":54484,"_5":14758,"_28188":54411,"_3059":54485},[],"Device without an identity",{"_3603":1235,"_31001":1205,"_21481":54487,"_5":14758,"_28188":54411,"_3059":54488},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3603":1236,"_31001":1205,"_21481":54490,"_5":14758,"_28188":54411,"_3059":54491},[],"Retired device",{"_3603":1237,"_31001":1205,"_21481":54493,"_5":14758,"_28188":54411,"_3059":54494},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3603":1238,"_31001":1205,"_21481":54496,"_5":14758,"_28188":54411,"_3059":54497},[],"Timeout, HTTP 500 or installation failure",{"_3603":1239,"_31001":1205,"_21481":54499,"_5":14758,"_28188":54411,"_3059":54500},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3603":1240,"_31001":1205,"_21481":54502,"_5":14758,"_28188":54415,"_3059":54503},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3603":1241,"_31001":1205,"_21481":54505,"_5":14758,"_28188":54415,"_3059":54506},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3603":1242,"_31001":1242,"_5":15118,"_3059":54508,"_31339":54509,"_21481":54510,"_28188":1242},"Enrollment troubleshooting",[50643,52155,53327,53325,53508],[],{"_3603":1243,"_31001":1242,"_21481":54512,"_5":14758,"_28188":1242,"_3059":54513},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3603":1244,"_31001":1242,"_5":31336,"_21481":54515,"_28188":54516,"_3059":54517},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3603":1245,"_31001":1242,"_5":31336,"_21481":54519,"_28188":54520,"_3059":54521},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3603":1246,"_31001":1242,"_5":31336,"_21481":54523,"_28188":54524,"_3059":54071},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3603":1247,"_31001":1242,"_5":31336,"_21481":54526,"_28188":54527,"_3059":54528},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3603":1248,"_31001":1242,"_21481":54530,"_5":14758,"_28188":1242,"_3059":54531},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3603":1249,"_31001":1242,"_21481":54533,"_5":14758,"_28188":54520,"_3059":54534},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3603":1250,"_31001":1242,"_21481":54536,"_5":14758,"_28188":54520,"_3059":54537},[],"Symptom or message",{"_3603":1251,"_31001":1242,"_21481":54539,"_5":14758,"_28188":54520,"_3059":54301},[],{"_3603":1252,"_31001":1242,"_21481":54541,"_5":14758,"_28188":54520,"_3059":54542},[],"curl rejects TLS, name or issuer",{"_3603":1253,"_31001":1242,"_21481":54544,"_5":14758,"_28188":54520,"_3059":54545},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3603":1254,"_31001":1242,"_21481":54547,"_5":14758,"_28188":54520,"_3059":54548},[],"404 or missing APS",{"_3603":1255,"_31001":1242,"_21481":54550,"_5":14758,"_28188":54520,"_3059":54551},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3603":1256,"_31001":1242,"_21481":54553,"_5":14758,"_28188":54520,"_3059":54554},[],"400, CSR or format error",{"_3603":1257,"_31001":1242,"_21481":54556,"_5":14758,"_28188":54520,"_3059":54557},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3603":1258,"_31001":1242,"_21481":54559,"_5":14758,"_28188":54520,"_3059":54560},[],"Missing credential or invalid certificate",{"_3603":1259,"_31001":1242,"_21481":54562,"_5":14758,"_28188":54520,"_3059":54563},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3603":1260,"_31001":1242,"_21481":54565,"_5":14758,"_28188":54520,"_3059":54566},[],"Webhook denies, times out or responds without authorization",{"_3603":1261,"_31001":1242,"_21481":54568,"_5":14758,"_28188":54520,"_3059":54569},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3603":1262,"_31001":1242,"_21481":54571,"_5":14758,"_28188":54520,"_3059":54572},[],"`unexpected status code: <n>: redirects are not followed`",{"_3603":1263,"_31001":1242,"_21481":54574,"_5":14758,"_28188":54520,"_3059":54575},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3603":1264,"_31001":1242,"_21481":54577,"_5":14758,"_28188":54520,"_3059":54578},[],"`webhook response exceeds 1048576 bytes`",{"_3603":1265,"_31001":1242,"_21481":54580,"_5":14758,"_28188":54520,"_3059":54581},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3603":1266,"_31001":1242,"_21481":54583,"_5":14758,"_28188":54520,"_3059":54584},[],"`webhook config must not reference files`",{"_3603":1267,"_31001":1242,"_21481":54586,"_5":14758,"_28188":54520,"_3059":54587},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3603":1268,"_31001":1242,"_21481":54589,"_5":14758,"_28188":54520,"_3059":54590},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3603":1269,"_31001":1242,"_21481":54592,"_5":14758,"_28188":54520,"_3059":54593},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3603":1270,"_31001":1242,"_21481":54595,"_5":14758,"_28188":54520,"_3059":54596},[],"`webhook mTLS certificate and key are invalid: …`",{"_3603":1271,"_31001":1242,"_21481":54598,"_5":14758,"_28188":54520,"_3059":54599},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3603":1272,"_31001":1242,"_21481":54601,"_5":14758,"_28188":54520,"_3059":54602},[],"400 `struct validation error` creating or updating a DMS",{"_3603":1273,"_31001":1242,"_21481":54604,"_5":14758,"_28188":54520,"_3059":54605},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3603":1274,"_31001":1242,"_21481":54607,"_5":14758,"_28188":54520,"_3059":54608},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3603":1275,"_31001":1242,"_21481":54610,"_5":14758,"_28188":54520,"_3059":54611},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3603":1276,"_31001":1242,"_21481":54613,"_5":14758,"_28188":54520,"_3059":54614},[],"`device not preregistered`",{"_3603":1277,"_31001":1242,"_21481":54616,"_5":14758,"_28188":54520,"_3059":54617},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3603":1278,"_31001":1242,"_21481":54619,"_5":14758,"_28188":54520,"_3059":54620},[],"`forbiddenNewEnrollment`",{"_3603":1279,"_31001":1242,"_21481":54622,"_5":14758,"_28188":54520,"_3059":54623},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3603":1280,"_31001":1242,"_21481":54625,"_5":14758,"_28188":54520,"_3059":54626},[],"Different owning DMS",{"_3603":1281,"_31001":1242,"_21481":54628,"_5":14758,"_28188":54520,"_3059":54629},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3603":1282,"_31001":1242,"_21481":54631,"_5":14758,"_28188":54520,"_3059":54632},[],"`invalid RawSubject bytes`",{"_3603":1283,"_31001":1242,"_21481":54634,"_5":14758,"_28188":54520,"_3059":54635},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3603":1284,"_31001":1242,"_21481":54637,"_5":14758,"_28188":54520,"_3059":54638},[],"`invalid reenroll window`",{"_3603":1285,"_31001":1242,"_21481":54640,"_5":14758,"_28188":54520,"_3059":54641},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3603":1286,"_31001":1242,"_21481":54643,"_5":14758,"_28188":54520,"_3059":54644},[],"Current certificate revoked",{"_3603":1287,"_31001":1242,"_21481":54646,"_5":14758,"_28188":54520,"_3059":54647},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3603":1288,"_31001":1242,"_21481":54649,"_5":14758,"_28188":54520,"_3059":54650},[],"CA, profile or signing error",{"_3603":1289,"_31001":1242,"_21481":54652,"_5":14758,"_28188":54520,"_3059":54653},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3603":1290,"_31001":1242,"_21481":54655,"_5":14758,"_28188":54520,"_3059":54656},[],"HTTP 200 without a device connection",{"_3603":1291,"_31001":1242,"_21481":54658,"_5":14758,"_28188":54520,"_3059":54659},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3603":1292,"_31001":1242,"_21481":54661,"_5":14758,"_28188":54520,"_3059":54662},[],"Timeout or error after issuance",{"_3603":1293,"_31001":1242,"_21481":54664,"_5":14758,"_28188":54520,"_3059":54665},[],"New certificates, current slot and previous identity's state before retrying.",{"_3603":1294,"_31001":1242,"_21481":54667,"_5":14758,"_28188":54524,"_3059":54668},[],"The examples use the contract of the examined backend. Do not automatically attribute that behavior to another release. Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3603":1295,"_31001":1242,"_21481":54670,"_5":14758,"_28188":54524,"_3059":54671},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3603":1296,"_31001":1242,"_21481":54673,"_5":14758,"_28188":54527,"_3059":54674},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3603":1297,"_31001":1242,"_21481":54676,"_5":14758,"_28188":54527,"_3059":54677},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3603":1298,"_31001":1242,"_21481":54679,"_5":14758,"_28188":54527,"_3059":54680},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3603":1299,"_31001":1242,"_21481":54682,"_5":14758,"_28188":54527,"_3059":54683},[],"Make one request, save headers/body and query the device and certificates.",{"_3603":1300,"_31001":1242,"_21481":54685,"_5":14758,"_28188":54527,"_3059":54686},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3603":1301,"_31001":1242,"_21481":54688,"_5":14758,"_28188":54527,"_3059":54689},[],"External bootstrap revocation checks have limitations: absence of evidence can be accepted, and OCSP Unknown does not cause the same rejection as Revoked. Do not assume a policy that rejects every uncertainty. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3603":1302,"_31001":1242,"_21481":54691,"_5":14758,"_28188":54527,"_3059":54692},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3603":1303,"_31001":1303,"_5":15118,"_3059":54694,"_31339":54695,"_21481":54696,"_28188":1303},"Trust distribution and updates",[50643,52155,53327,53325,53508],[],{"_3603":1304,"_31001":1303,"_21481":54698,"_5":14758,"_28188":1303,"_3059":54699},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3603":1305,"_31001":1303,"_5":31336,"_21481":54701,"_28188":54702,"_3059":54703},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3603":1306,"_31001":1303,"_5":31336,"_21481":54705,"_28188":54706,"_3059":54707},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3603":1307,"_31001":1303,"_5":31336,"_21481":54709,"_28188":54710,"_3059":54711},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3603":1308,"_31001":1303,"_5":31336,"_21481":54713,"_28188":54714,"_3059":54715},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3603":1309,"_31001":1303,"_5":31336,"_21481":54717,"_28188":54718,"_3059":54719},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3603":1310,"_31001":1303,"_21481":54721,"_5":14758,"_28188":1303,"_3059":54722},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3603":1311,"_31001":1303,"_21481":54724,"_5":14758,"_28188":54702,"_3059":54725},[],"Relationship",{"_3603":1312,"_31001":1303,"_21481":54727,"_5":14758,"_28188":54702,"_3059":54728},[],"Material prepared by its owner",{"_3603":1313,"_31001":1303,"_21481":54730,"_5":14758,"_28188":54702,"_3059":54731},[],"Device → EST server",{"_3603":1314,"_31001":1303,"_21481":54733,"_5":14758,"_28188":54702,"_3059":54734},[],"Previously verified server root, chain or pin and TLS name.",{"_3603":1315,"_31001":1303,"_21481":54736,"_5":14758,"_28188":54702,"_3059":54737},[],"DMS → requester",{"_3603":1316,"_31001":1303,"_21481":54739,"_5":14758,"_28188":54702,"_3059":54740},[],"CAs and rules authorizing initial or renewal credentials.",{"_3603":1317,"_31001":1303,"_21481":54742,"_5":14758,"_28188":54702,"_3059":54743},[],"Consumer → device",{"_3603":1318,"_31001":1303,"_21481":54745,"_5":14758,"_28188":54702,"_3059":54746},[],"Operational identity roots, intermediates, validation and permissions.",{"_3603":1319,"_31001":1303,"_21481":54748,"_5":14758,"_28188":54702,"_3059":54749},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3603":1320,"_31001":1303,"_21481":54751,"_5":14758,"_28188":54706,"_3059":54752},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3603":1321,"_31001":1303,"_21481":54754,"_5":14758,"_28188":54706,"_3059":54755},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3603":1322,"_31001":1303,"_21481":54757,"_5":14758,"_28188":54710,"_3059":54758},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3603":1323,"_31001":1303,"_21481":54760,"_5":14758,"_28188":54710,"_3059":54761},[],"Select policy-approved roots as anchors.",{"_3603":1324,"_31001":1303,"_21481":54763,"_5":14758,"_28188":54710,"_3059":54764},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3603":1325,"_31001":1303,"_21481":54766,"_5":14758,"_28188":54710,"_3059":54767},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3603":1326,"_31001":1303,"_21481":54769,"_5":14758,"_28188":54710,"_3059":54770},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3603":1327,"_31001":1303,"_21481":54772,"_5":14758,"_28188":54710,"_3059":54773},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3603":1328,"_31001":1303,"_21481":54775,"_5":14758,"_28188":54714,"_3059":54776},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3603":1329,"_31001":1303,"_21481":54778,"_5":14758,"_28188":54714,"_3059":54779},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The inspected validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3603":1330,"_31001":1303,"_21481":54781,"_5":14758,"_28188":54714,"_3059":54782},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3603":1331,"_31001":1303,"_21481":54784,"_5":14758,"_28188":54718,"_3059":54785},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3603":1332,"_31001":1332,"_5":15118,"_3059":54787,"_31339":54788,"_21481":54790,"_28188":1332},"AWS IoT Core",[50643,52155,53327,53325,54789],"Integrations",[],{"_3603":1333,"_31001":1332,"_21481":54792,"_5":14758,"_28188":1332,"_3059":54793},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3603":1334,"_31001":1332,"_5":31336,"_21481":54795,"_28188":54796,"_3059":54797},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3603":1335,"_31001":1332,"_5":31336,"_21481":54799,"_28188":54800,"_3059":54801},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3603":1336,"_31001":1332,"_5":31336,"_21481":54803,"_28188":54804,"_3059":54805},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3603":1337,"_31001":1332,"_5":31336,"_21481":54807,"_28188":54808,"_3059":54809},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3603":1338,"_31001":1332,"_5":31336,"_21481":54811,"_28188":54812,"_3059":54813},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3603":1339,"_31001":1332,"_5":31336,"_21481":54815,"_28188":54816,"_3059":54817},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3603":1340,"_31001":1332,"_5":31336,"_21481":54819,"_28188":54820,"_3059":54821},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3603":1341,"_31001":1332,"_5":31336,"_21481":54823,"_28188":54824,"_3059":54825},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3603":1342,"_31001":1332,"_5":31336,"_21481":54827,"_28188":54828,"_3059":54829},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3603":1343,"_31001":1332,"_5":31336,"_21481":54831,"_28188":54832,"_3059":54833},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3603":1344,"_31001":1332,"_5":31336,"_21481":54835,"_28188":54836,"_3059":54837},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3603":1345,"_31001":1332,"_5":31336,"_21481":54839,"_28188":54840,"_3059":54841},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3603":1346,"_31001":1332,"_5":31336,"_21481":54843,"_28188":54844,"_3059":54845},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3603":1347,"_31001":1332,"_5":31336,"_21481":54847,"_28188":54848,"_3059":54849},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3603":1348,"_31001":1332,"_5":31336,"_21481":54851,"_28188":54852,"_3059":54853},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3603":1349,"_31001":1332,"_5":31336,"_21481":54855,"_28188":54856,"_3059":54857},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3603":1350,"_31001":1332,"_5":31336,"_21481":54859,"_28188":54860,"_3059":54861},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3603":1351,"_31001":1332,"_5":31336,"_21481":54863,"_28188":54864,"_3059":54865},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3603":1352,"_31001":1332,"_5":31336,"_21481":54867,"_28188":54868,"_3059":54869},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3603":1353,"_31001":1332,"_5":31336,"_21481":54871,"_28188":54872,"_3059":54873},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3603":1354,"_31001":1332,"_5":31336,"_21481":54875,"_28188":54876,"_3059":54877},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3603":1355,"_31001":1332,"_5":31336,"_21481":54879,"_28188":54880,"_3059":54881},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3603":1356,"_31001":1332,"_5":31336,"_21481":54883,"_28188":54884,"_3059":54885},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3603":1357,"_31001":1332,"_5":31336,"_21481":54887,"_28188":54888,"_3059":54889},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3603":1358,"_31001":1332,"_5":31336,"_21481":54891,"_28188":54892,"_3059":54893},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3603":1359,"_31001":1332,"_21481":54895,"_5":14758,"_28188":1332,"_3059":54896},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3603":1360,"_31001":1332,"_21481":54898,"_5":14758,"_28188":1332,"_3059":54899},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3603":1361,"_31001":1332,"_21481":54901,"_5":14758,"_28188":1332,"_3059":54902},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3603":1362,"_31001":1332,"_21481":54904,"_5":14758,"_28188":54796,"_3059":54905},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3603":1363,"_31001":1332,"_21481":54907,"_5":14758,"_28188":54796,"_3059":54908},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3603":1364,"_31001":1332,"_21481":54910,"_5":14758,"_28188":54796,"_3059":54911},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3603":1365,"_31001":1332,"_21481":54913,"_5":14758,"_28188":54796,"_3059":54914},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3603":1366,"_31001":1332,"_21481":54916,"_5":14758,"_28188":54800,"_3059":54917},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3603":1367,"_31001":1332,"_21481":54919,"_5":14758,"_28188":54804,"_3059":54920},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3603":1368,"_31001":1332,"_21481":54922,"_5":14758,"_28188":54804,"_3059":54923},[],"IAM action",{"_3603":1369,"_31001":1332,"_21481":54925,"_5":14758,"_28188":54804,"_3059":51033},[],{"_3603":1370,"_31001":1332,"_21481":54927,"_5":14758,"_28188":54804,"_3059":54928},[],"`iot:GetRegistrationCode`",{"_3603":1371,"_31001":1332,"_21481":54930,"_5":14758,"_28188":54804,"_3059":54931},[],"Obtain the verification code for CA registration in the Primary Account",{"_3603":1372,"_31001":1332,"_21481":54933,"_5":14758,"_28188":54804,"_3059":54934},[],"`iot:RegisterCACertificate`",{"_3603":1373,"_31001":1332,"_21481":54936,"_5":14758,"_28188":54804,"_3059":54937},[],"Register the CA in AWS IoT",{"_3603":1374,"_31001":1332,"_21481":54939,"_5":14758,"_28188":54804,"_3059":54940},[],"`iot:DescribeCACertificate`",{"_3603":1375,"_31001":1332,"_21481":54942,"_5":14758,"_28188":54804,"_3059":54943},[],"Check the CA registration status",{"_3603":1376,"_31001":1332,"_21481":54945,"_5":14758,"_28188":54804,"_3059":54946},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3603":1377,"_31001":1332,"_21481":54948,"_5":14758,"_28188":54804,"_3059":54949},[],"Create or update Things in IoT Core",{"_3603":1378,"_31001":1332,"_21481":54951,"_5":14758,"_28188":54804,"_3059":54952},[],"`iot:RegisterThing`",{"_3603":1379,"_31001":1332,"_21481":54954,"_5":14758,"_28188":54804,"_3059":54955},[],"Provision Things through a template",{"_3603":1380,"_31001":1332,"_21481":54957,"_5":14758,"_28188":54804,"_3059":54958},[],"`iot:RegisterCertificate`",{"_3603":1381,"_31001":1332,"_21481":54960,"_5":14758,"_28188":54804,"_3059":54961},[],"Register device certificates",{"_3603":1382,"_31001":1332,"_21481":54963,"_5":14758,"_28188":54804,"_3059":54964},[],"`iot:UpdateCertificate`",{"_3603":1383,"_31001":1332,"_21481":54966,"_5":14758,"_28188":54804,"_3059":54967},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3603":1384,"_31001":1332,"_21481":54969,"_5":14758,"_28188":54804,"_3059":54970},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3603":1385,"_31001":1332,"_21481":54972,"_5":14758,"_28188":54804,"_3059":54973},[],"Create and attach IoT policies",{"_3603":1386,"_31001":1332,"_21481":54975,"_5":14758,"_28188":54804,"_3059":54976},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3603":1387,"_31001":1332,"_21481":54978,"_5":14758,"_28188":54804,"_3059":54979},[],"Manage Thing groups",{"_3603":1388,"_31001":1332,"_21481":54981,"_5":14758,"_28188":54804,"_3059":54982},[],"`iot:CreateProvisioningTemplate`",{"_3603":1389,"_31001":1332,"_21481":54984,"_5":14758,"_28188":54804,"_3059":54985},[],"Create JITP templates",{"_3603":1390,"_31001":1332,"_21481":54987,"_5":14758,"_28188":54804,"_3059":54988},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3603":1391,"_31001":1332,"_21481":54990,"_5":14758,"_28188":54804,"_3059":54991},[],"Read and write the Device Shadow",{"_3603":1392,"_31001":1332,"_21481":54993,"_5":14758,"_28188":54804,"_3059":54994},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3603":1393,"_31001":1332,"_21481":54996,"_5":14758,"_28188":54808,"_3059":54997},[],"Parameter",{"_3603":1394,"_31001":1332,"_21481":54999,"_5":14758,"_28188":54808,"_3059":55000},[],"Type",{"_3603":1395,"_31001":1332,"_21481":55002,"_5":14758,"_28188":54808,"_3059":55003},[],"Required",{"_3603":1396,"_31001":1332,"_21481":55005,"_5":14758,"_28188":54808,"_3059":55006},[],"Description",{"_3603":1397,"_31001":1332,"_21481":55008,"_5":14758,"_28188":54808,"_3059":55009},[],"`connector_id`",{"_3603":1398,"_31001":1332,"_21481":55011,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1399,"_31001":1332,"_21481":55013,"_5":14758,"_28188":54808,"_3059":55014},[],"Yes",{"_3603":1400,"_31001":1332,"_21481":55016,"_5":14758,"_28188":54808,"_3059":55017},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3603":1401,"_31001":1332,"_21481":55019,"_5":14758,"_28188":54808,"_3059":55020},[],"`aws_config.region`",{"_3603":1402,"_31001":1332,"_21481":55022,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1403,"_31001":1332,"_21481":55024,"_5":14758,"_28188":54808,"_3059":55014},[],{"_3603":1404,"_31001":1332,"_21481":55026,"_5":14758,"_28188":54808,"_3059":55027},[],"AWS region where the connector operates.",{"_3603":1405,"_31001":1332,"_21481":55029,"_5":14758,"_28188":54808,"_3059":55030},[],"`aws_config.auth_method`",{"_3603":1406,"_31001":1332,"_21481":55032,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1407,"_31001":1332,"_21481":55034,"_5":14758,"_28188":54808,"_3059":55014},[],{"_3603":1408,"_31001":1332,"_21481":55036,"_5":14758,"_28188":54808,"_3059":55037},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3603":1409,"_31001":1332,"_21481":55039,"_5":14758,"_28188":54808,"_3059":55040},[],"`aws_config.access_key_id`",{"_3603":1410,"_31001":1332,"_21481":55042,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1411,"_31001":1332,"_21481":55044,"_5":14758,"_28188":54808,"_3059":55045},[],"Only with `auth_method=static`",{"_3603":1412,"_31001":1332,"_21481":55047,"_5":14758,"_28188":54808,"_3059":55048},[],"AWS access key.",{"_3603":1413,"_31001":1332,"_21481":55050,"_5":14758,"_28188":54808,"_3059":55051},[],"`aws_config.secret_access_key`",{"_3603":1414,"_31001":1332,"_21481":55053,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1415,"_31001":1332,"_21481":55055,"_5":14758,"_28188":54808,"_3059":55045},[],{"_3603":1416,"_31001":1332,"_21481":55057,"_5":14758,"_28188":54808,"_3059":55058},[],"AWS secret key.",{"_3603":1417,"_31001":1332,"_21481":55060,"_5":14758,"_28188":54808,"_3059":55061},[],"`aws_config.session_token`",{"_3603":1418,"_31001":1332,"_21481":55063,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1419,"_31001":1332,"_21481":55065,"_5":14758,"_28188":54808,"_3059":55066},[],"No",{"_3603":1420,"_31001":1332,"_21481":55068,"_5":14758,"_28188":54808,"_3059":55069},[],"Session token (with `auth_method=static`).",{"_3603":1421,"_31001":1332,"_21481":55071,"_5":14758,"_28188":54808,"_3059":55072},[],"`aws_config.role_arn`",{"_3603":1422,"_31001":1332,"_21481":55074,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1423,"_31001":1332,"_21481":55076,"_5":14758,"_28188":54808,"_3059":55077},[],"Only with `auth_method=role`",{"_3603":1424,"_31001":1332,"_21481":55079,"_5":14758,"_28188":54808,"_3059":55080},[],"ARN of the role to assume.",{"_3603":1425,"_31001":1332,"_21481":55082,"_5":14758,"_28188":54808,"_3059":55083},[],"`aws_config.endpoint_url`",{"_3603":1426,"_31001":1332,"_21481":55085,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1427,"_31001":1332,"_21481":55087,"_5":14758,"_28188":54808,"_3059":55066},[],{"_3603":1428,"_31001":1332,"_21481":55089,"_5":14758,"_28188":54808,"_3059":55090},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3603":1429,"_31001":1332,"_21481":55092,"_5":14758,"_28188":54808,"_3059":55093},[],"`subscriber_event_bus`",{"_3603":1430,"_31001":1332,"_21481":55095,"_5":14758,"_28188":54808,"_3059":18082},[],{"_3603":1431,"_31001":1332,"_21481":55097,"_5":14758,"_28188":54808,"_3059":55014},[],{"_3603":1432,"_31001":1332,"_21481":55099,"_5":14758,"_28188":54808,"_3059":55100},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3603":1433,"_31001":1332,"_21481":55102,"_5":14758,"_28188":54808,"_3059":55103},[],"`dms_manager_client`",{"_3603":1434,"_31001":1332,"_21481":55105,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1435,"_31001":1332,"_21481":55107,"_5":14758,"_28188":54808,"_3059":55014},[],{"_3603":1436,"_31001":1332,"_21481":55109,"_5":14758,"_28188":54808,"_3059":55110},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3603":1437,"_31001":1332,"_21481":55112,"_5":14758,"_28188":54808,"_3059":55113},[],"`device_manager_client`",{"_3603":1438,"_31001":1332,"_21481":55115,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1439,"_31001":1332,"_21481":55117,"_5":14758,"_28188":54808,"_3059":55014},[],{"_3603":1440,"_31001":1332,"_21481":55119,"_5":14758,"_28188":54808,"_3059":55120},[],"HTTP URL of Lamassu's Device Manager.",{"_3603":1441,"_31001":1332,"_21481":55122,"_5":14758,"_28188":54808,"_3059":55123},[],"`ca_client`",{"_3603":1442,"_31001":1332,"_21481":55125,"_5":14758,"_28188":54808,"_3059":25639},[],{"_3603":1443,"_31001":1332,"_21481":55127,"_5":14758,"_28188":54808,"_3059":55014},[],{"_3603":1444,"_31001":1332,"_21481":55129,"_5":14758,"_28188":54808,"_3059":55130},[],"HTTP URL of Lamassu's CA service.",{"_3603":1445,"_31001":1332,"_21481":55132,"_5":14758,"_28188":54812,"_3059":55133},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3603":1446,"_31001":1332,"_21481":55135,"_5":14758,"_28188":54812,"_3059":55136},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3603":1447,"_31001":1332,"_21481":55138,"_5":14758,"_28188":54812,"_3059":55139},[],"CloudEvent type",{"_3603":1448,"_31001":1332,"_21481":55141,"_5":14758,"_28188":54812,"_3059":55142},[],"Lamassu resource",{"_3603":1449,"_31001":1332,"_21481":55144,"_5":14758,"_28188":54812,"_3059":55145},[],"AWS Resource",{"_3603":1450,"_31001":1332,"_21481":55147,"_5":14758,"_28188":54812,"_3059":55148},[],"IAM actions",{"_3603":1451,"_31001":1332,"_21481":55150,"_5":14758,"_28188":54812,"_3059":55151},[],"AWS calls and effect",{"_3603":1452,"_31001":1332,"_21481":55153,"_5":14758,"_28188":54812,"_3059":55154},[],"Where in this page",{"_3603":1453,"_31001":1332,"_21481":55156,"_5":14758,"_28188":54812,"_3059":55157},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3603":1454,"_31001":1332,"_21481":55159,"_5":14758,"_28188":54812,"_3059":55160},[],"CA",{"_3603":1455,"_31001":1332,"_21481":55162,"_5":14758,"_28188":54812,"_3059":55163},[],"`IoTCore/CACertificate`",{"_3603":1456,"_31001":1332,"_21481":55165,"_5":14758,"_28188":54812,"_3059":55166},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3603":1457,"_31001":1332,"_21481":55168,"_5":14758,"_28188":54812,"_3059":55169},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3603":1458,"_31001":1332,"_21481":55171,"_5":14758,"_28188":54812,"_3059":54825},[],{"_3603":1459,"_31001":1332,"_21481":55173,"_5":14758,"_28188":54812,"_3059":55174},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3603":1460,"_31001":1332,"_21481":55176,"_5":14758,"_28188":54812,"_3059":55177},[],"DMS",{"_3603":1461,"_31001":1332,"_21481":55179,"_5":14758,"_28188":54812,"_3059":55180},[],"`IoTCore/ProvisioningTemplate`",{"_3603":1462,"_31001":1332,"_21481":55182,"_5":14758,"_28188":54812,"_3059":55183},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3603":1463,"_31001":1332,"_21481":55185,"_5":14758,"_28188":54812,"_3059":55186},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3603":1464,"_31001":1332,"_21481":55188,"_5":14758,"_28188":54812,"_3059":54853},[],{"_3603":1465,"_31001":1332,"_21481":55190,"_5":14758,"_28188":54812,"_3059":55191},[],"`EventBindDeviceIdentityKey`",{"_3603":1466,"_31001":1332,"_21481":55193,"_5":14758,"_28188":54812,"_3059":55194},[],"Device",{"_3603":1467,"_31001":1332,"_21481":55196,"_5":14758,"_28188":54812,"_3059":55197},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3603":1468,"_31001":1332,"_21481":55199,"_5":14758,"_28188":54812,"_3059":55200},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3603":1469,"_31001":1332,"_21481":55202,"_5":14758,"_28188":54812,"_3059":55203},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3603":1470,"_31001":1332,"_21481":55205,"_5":14758,"_28188":54812,"_3059":54861},[],{"_3603":1471,"_31001":1332,"_21481":55207,"_5":14758,"_28188":54812,"_3059":55208},[],"`EventUpdateCertificateStatusKey`",{"_3603":1472,"_31001":1332,"_21481":55210,"_5":14758,"_28188":54812,"_3059":55211},[],"Certificate",{"_3603":1473,"_31001":1332,"_21481":55213,"_5":14758,"_28188":54812,"_3059":55214},[],"`IoTCore/Certificate`",{"_3603":1474,"_31001":1332,"_21481":55216,"_5":14758,"_28188":54812,"_3059":55217},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3603":1475,"_31001":1332,"_21481":55219,"_5":14758,"_28188":54812,"_3059":55220},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3603":1476,"_31001":1332,"_21481":55222,"_5":14758,"_28188":54812,"_3059":54873},[],{"_3603":1477,"_31001":1332,"_21481":55224,"_5":14758,"_28188":54812,"_3059":55225},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3603":1478,"_31001":1332,"_21481":55227,"_5":14758,"_28188":54812,"_3059":55228},[],"Certificate / Device",{"_3603":1479,"_31001":1332,"_21481":55230,"_5":14758,"_28188":54812,"_3059":55231},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3603":1480,"_31001":1332,"_21481":55233,"_5":14758,"_28188":54812,"_3059":51039},[],{"_3603":1481,"_31001":1332,"_21481":55235,"_5":14758,"_28188":54812,"_3059":55236},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3603":1482,"_31001":1332,"_21481":55238,"_5":14758,"_28188":54812,"_3059":54881},[],{"_3603":1483,"_31001":1332,"_21481":55240,"_5":14758,"_28188":54816,"_3059":55241},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3603":1484,"_31001":1332,"_21481":55243,"_5":14758,"_28188":54820,"_3059":55244},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3603":1485,"_31001":1332,"_21481":55246,"_5":14758,"_28188":54820,"_3059":55247},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3603":1486,"_31001":1332,"_21481":55249,"_5":14758,"_28188":54824,"_3059":55250},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3603":1487,"_31001":1332,"_21481":55252,"_5":14758,"_28188":54824,"_3059":55253},[],"Transition",{"_3603":1488,"_31001":1332,"_21481":55255,"_5":14758,"_28188":54824,"_3059":55256},[],"AWS calls",{"_3603":1489,"_31001":1332,"_21481":55258,"_5":14758,"_28188":54824,"_3059":55259},[],"`NotRegistered` → `Requested`",{"_3603":1490,"_31001":1332,"_21481":55261,"_5":14758,"_28188":54824,"_3059":55262},[],"none (metadata write only)",{"_3603":1491,"_31001":1332,"_21481":55264,"_5":14758,"_28188":54824,"_3059":55265},[],"`Requested` → `Registering`",{"_3603":1492,"_31001":1332,"_21481":55267,"_5":14758,"_28188":54824,"_3059":55268},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3603":1493,"_31001":1332,"_21481":55270,"_5":14758,"_28188":54824,"_3059":55271},[],"`Registering` → `Succeeded`",{"_3603":1494,"_31001":1332,"_21481":55273,"_5":14758,"_28188":54824,"_3059":55274},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3603":1495,"_31001":1332,"_21481":55276,"_5":14758,"_28188":54824,"_3059":55277},[],"`Registering` → `Failed`",{"_3603":1496,"_31001":1332,"_21481":55279,"_5":14758,"_28188":54824,"_3059":55280},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3603":1497,"_31001":1332,"_21481":55282,"_5":14758,"_28188":54824,"_3059":55283},[],"`Failed` / `Succeeded` → `Requested`",{"_3603":1498,"_31001":1332,"_21481":55285,"_5":14758,"_28188":54824,"_3059":55286},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3603":1499,"_31001":1332,"_21481":55288,"_5":14758,"_28188":54828,"_3059":55289},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3603":1500,"_31001":1332,"_21481":55291,"_5":14758,"_28188":54828,"_3059":55292},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3603":1501,"_31001":1332,"_21481":55294,"_5":14758,"_28188":54828,"_3059":55295},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3603":1502,"_31001":1332,"_21481":55297,"_5":14758,"_28188":54828,"_3059":55298},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3603":1503,"_31001":1332,"_21481":55300,"_5":14758,"_28188":54828,"_3059":55301},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3603":1504,"_31001":1332,"_21481":55303,"_5":14758,"_28188":54828,"_3059":55304},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3603":1505,"_31001":1332,"_21481":55306,"_5":14758,"_28188":54832,"_3059":55307},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3603":1506,"_31001":1332,"_21481":55309,"_5":14758,"_28188":54836,"_3059":55310},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3603":1507,"_31001":1332,"_21481":55312,"_5":14758,"_28188":54836,"_3059":55313},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3603":1508,"_31001":1332,"_21481":55315,"_5":14758,"_28188":54840,"_3059":55316},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3603":1509,"_31001":1332,"_21481":55318,"_5":14758,"_28188":54844,"_3059":55319},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3603":1510,"_31001":1332,"_21481":55321,"_5":14758,"_28188":54844,"_3059":55322},[],"Creates or updates the IoT policies configured in the DMS.",{"_3603":1511,"_31001":1332,"_21481":55324,"_5":14758,"_28188":54844,"_3059":55325},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3603":1512,"_31001":1332,"_21481":55327,"_5":14758,"_28188":54844,"_3059":55328},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3603":1513,"_31001":1332,"_21481":55330,"_5":14758,"_28188":54844,"_3059":55331},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3603":1514,"_31001":1332,"_21481":55333,"_5":14758,"_28188":54844,"_3059":55334},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3603":1515,"_31001":1332,"_21481":55336,"_5":14758,"_28188":54844,"_3059":55337},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3603":1516,"_31001":1332,"_21481":55339,"_5":14758,"_28188":54848,"_3059":55340},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3603":1517,"_31001":1332,"_21481":55342,"_5":14758,"_28188":54848,"_3059":55343},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3603":1518,"_31001":1332,"_21481":55345,"_5":14758,"_28188":54848,"_3059":55346},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3603":1519,"_31001":1332,"_21481":55348,"_5":14758,"_28188":54848,"_3059":55349},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3603":1520,"_31001":1332,"_21481":55351,"_5":14758,"_28188":54848,"_3059":55352},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3603":1521,"_31001":1332,"_21481":55354,"_5":14758,"_28188":54852,"_3059":55355},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3603":1522,"_31001":1332,"_21481":55357,"_5":14758,"_28188":54852,"_3059":55253},[],{"_3603":1523,"_31001":1332,"_21481":55359,"_5":14758,"_28188":54852,"_3059":55256},[],{"_3603":1524,"_31001":1332,"_21481":55361,"_5":14758,"_28188":54852,"_3059":55362},[],"`Unconfigured` → `None` / `Auto`",{"_3603":1525,"_31001":1332,"_21481":55364,"_5":14758,"_28188":54852,"_3059":55365},[],"none (configuration only)",{"_3603":1526,"_31001":1332,"_21481":55367,"_5":14758,"_28188":54852,"_3059":55368},[],"`None` ↔ `Auto`",{"_3603":1527,"_31001":1332,"_21481":55370,"_5":14758,"_28188":54852,"_3059":55365},[],{"_3603":1528,"_31001":1332,"_21481":55372,"_5":14758,"_28188":54852,"_3059":55373},[],"Any → `Jitp`",{"_3603":1529,"_31001":1332,"_21481":55375,"_5":14758,"_28188":54852,"_3059":55376},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3603":1530,"_31001":1332,"_21481":55378,"_5":14758,"_28188":54852,"_3059":55379},[],"`Jitp` → `None` / `Auto`",{"_3603":1531,"_31001":1332,"_21481":55381,"_5":14758,"_28188":54852,"_3059":55382},[],"none (the template stays in the AWS account)",{"_3603":1532,"_31001":1332,"_21481":55384,"_5":14758,"_28188":54856,"_3059":55385},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3603":1533,"_31001":1332,"_21481":55387,"_5":14758,"_28188":54856,"_3059":55388},[],"The full flow from the device's perspective is:",{"_3603":1534,"_31001":1332,"_21481":55390,"_5":14758,"_28188":54856,"_3059":55391},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3603":1535,"_31001":1332,"_21481":55393,"_5":14758,"_28188":54860,"_3059":55394},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3603":1536,"_31001":1332,"_21481":55396,"_5":14758,"_28188":54860,"_3059":55253},[],{"_3603":1537,"_31001":1332,"_21481":55398,"_5":14758,"_28188":54860,"_3059":55256},[],{"_3603":1538,"_31001":1332,"_21481":55400,"_5":14758,"_28188":54860,"_3059":55401},[],"`Absent` → `Provisioned`",{"_3603":1539,"_31001":1332,"_21481":55403,"_5":14758,"_28188":54860,"_3059":55404},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3603":1540,"_31001":1332,"_21481":55406,"_5":14758,"_28188":54860,"_3059":55407},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3603":1541,"_31001":1332,"_21481":55409,"_5":14758,"_28188":54860,"_3059":55410},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3603":1542,"_31001":1332,"_21481":55412,"_5":14758,"_28188":54860,"_3059":55413},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3603":1543,"_31001":1332,"_21481":55415,"_5":14758,"_28188":54864,"_3059":55416},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3603":1544,"_31001":1332,"_21481":55418,"_5":14758,"_28188":54864,"_3059":55419},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3603":1545,"_31001":1332,"_21481":55421,"_5":14758,"_28188":54864,"_3059":55422},[],"For the JITP flow to work correctly:",{"_3603":1546,"_31001":1332,"_21481":55424,"_5":14758,"_28188":54864,"_3059":55425},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3603":1547,"_31001":1332,"_21481":55427,"_5":14758,"_28188":54864,"_3059":55428},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3603":1548,"_31001":1332,"_21481":55430,"_5":14758,"_28188":54864,"_3059":55431},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3603":1549,"_31001":1332,"_21481":55433,"_5":14758,"_28188":54864,"_3059":55434},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3603":1550,"_31001":1332,"_21481":55436,"_5":14758,"_28188":54868,"_3059":55437},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3603":1551,"_31001":1332,"_21481":55439,"_5":14758,"_28188":54868,"_3059":55440},[],"Status in Lamassu",{"_3603":1552,"_31001":1332,"_21481":55442,"_5":14758,"_28188":54868,"_3059":55443},[],"Revocation reason",{"_3603":1553,"_31001":1332,"_21481":55445,"_5":14758,"_28188":54868,"_3059":55446},[],"Status in AWS IoT Core",{"_3603":1554,"_31001":1332,"_21481":55448,"_5":14758,"_28188":54868,"_3059":55449},[],"`Active`",{"_3603":1555,"_31001":1332,"_21481":55451,"_5":14758,"_28188":54868,"_3059":55452},[],"None",{"_3603":1556,"_31001":1332,"_21481":55454,"_5":14758,"_28188":54868,"_3059":55455},[],"`ACTIVE`",{"_3603":1557,"_31001":1332,"_21481":55457,"_5":14758,"_28188":54868,"_3059":55458},[],"`Revoked`",{"_3603":1558,"_31001":1332,"_21481":55460,"_5":14758,"_28188":54868,"_3059":55461},[],"`certificateHold`",{"_3603":1559,"_31001":1332,"_21481":55463,"_5":14758,"_28188":54868,"_3059":55464},[],"`INACTIVE`",{"_3603":1560,"_31001":1332,"_21481":55466,"_5":14758,"_28188":54868,"_3059":55458},[],{"_3603":1561,"_31001":1332,"_21481":55468,"_5":14758,"_28188":54868,"_3059":55469},[],"Any other reason",{"_3603":1562,"_31001":1332,"_21481":55471,"_5":14758,"_28188":54868,"_3059":55472},[],"`REVOKED`",{"_3603":1563,"_31001":1332,"_21481":55474,"_5":14758,"_28188":54868,"_3059":55475},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3603":1564,"_31001":1332,"_21481":55477,"_5":14758,"_28188":54872,"_3059":55478},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3603":1565,"_31001":1332,"_21481":55480,"_5":14758,"_28188":54872,"_3059":55253},[],{"_3603":1566,"_31001":1332,"_21481":55482,"_5":14758,"_28188":54872,"_3059":55256},[],{"_3603":1567,"_31001":1332,"_21481":55484,"_5":14758,"_28188":54872,"_3059":55485},[],"`NotSynced` → `Active`",{"_3603":1568,"_31001":1332,"_21481":55487,"_5":14758,"_28188":54872,"_3059":54964},[],{"_3603":1569,"_31001":1332,"_21481":55489,"_5":14758,"_28188":54872,"_3059":55490},[],"`Active` → `Inactive`",{"_3603":1570,"_31001":1332,"_21481":55492,"_5":14758,"_28188":54872,"_3059":55493},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3603":1571,"_31001":1332,"_21481":55495,"_5":14758,"_28188":54872,"_3059":55496},[],"`Active` → `Revoked`",{"_3603":1572,"_31001":1332,"_21481":55498,"_5":14758,"_28188":54872,"_3059":55493},[],{"_3603":1573,"_31001":1332,"_21481":55500,"_5":14758,"_28188":54872,"_3059":55501},[],"`Inactive` / `Revoked` → `Active`",{"_3603":1574,"_31001":1332,"_21481":55503,"_5":14758,"_28188":54872,"_3059":54964},[],{"_3603":1575,"_31001":1332,"_21481":55505,"_5":14758,"_28188":54872,"_3059":55506},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3603":1576,"_31001":1332,"_21481":55508,"_5":14758,"_28188":54872,"_3059":55509},[],"none (these states are not synced to AWS)",{"_3603":1577,"_31001":1332,"_21481":55511,"_5":14758,"_28188":54876,"_3059":55512},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3603":1578,"_31001":1332,"_21481":55514,"_5":14758,"_28188":54876,"_3059":55515},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3603":1579,"_31001":1332,"_21481":55517,"_5":14758,"_28188":54876,"_3059":55518},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3603":1580,"_31001":1332,"_21481":55520,"_5":14758,"_28188":54880,"_3059":55521},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3603":1581,"_31001":1332,"_21481":55523,"_5":14758,"_28188":54880,"_3059":55524},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3603":1582,"_31001":1332,"_21481":55526,"_5":14758,"_28188":54884,"_3059":55527},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3603":1583,"_31001":1332,"_21481":55529,"_5":14758,"_28188":54884,"_3059":55530},[],"There are two action types:",{"_3603":1584,"_31001":1332,"_21481":55532,"_5":14758,"_28188":54884,"_3059":55533},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3603":1585,"_31001":1332,"_21481":55535,"_5":14758,"_28188":54884,"_3059":55536},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3603":1586,"_31001":1332,"_21481":55538,"_5":14758,"_28188":54884,"_3059":55539},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3603":1587,"_31001":1332,"_21481":55541,"_5":14758,"_28188":54888,"_3059":55542},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3603":1588,"_31001":1332,"_21481":55544,"_5":14758,"_28188":54888,"_3059":55545},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3603":1589,"_31001":1332,"_21481":55547,"_5":14758,"_28188":54888,"_3059":55548},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3603":1590,"_31001":1332,"_21481":55550,"_5":14758,"_28188":54892,"_3059":55551},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3603":1591,"_31001":1332,"_21481":55553,"_5":14758,"_28188":54892,"_3059":55554},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3603":1592,"_31001":1332,"_21481":55556,"_5":14758,"_28188":54892,"_3059":55557},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3603":1593,"_31001":1332,"_21481":55559,"_5":14758,"_28188":54892,"_3059":55560},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3603":1594,"_31001":1332,"_21481":55562,"_5":14758,"_28188":54892,"_3059":55563},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3603":1595,"_31001":1332,"_21481":55565,"_5":14758,"_28188":54892,"_3059":55566},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3603":1596,"_31001":1332,"_21481":55568,"_5":14758,"_28188":54892,"_3059":55569},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3603":1597,"_31001":1332,"_21481":55571,"_5":14758,"_28188":54892,"_3059":55572},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3603":1598,"_31001":1332,"_21481":55574,"_5":14758,"_28188":54892,"_3059":55575},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3603":1599,"_31001":1332,"_21481":55577,"_5":14758,"_28188":54892,"_3059":55578},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3603":1600,"_31001":1332,"_21481":55580,"_5":14758,"_28188":54892,"_3059":55581},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3603":1601,"_31001":1332,"_21481":55583,"_5":14758,"_28188":54892,"_3059":55584},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3603":1602,"_31001":1332,"_21481":55586,"_5":14758,"_28188":54892,"_3059":55587},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3603":1603,"_31001":1332,"_21481":55589,"_5":14758,"_28188":54892,"_3059":55590},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3603":1604,"_31001":1332,"_21481":55592,"_5":14758,"_28188":54892,"_3059":55593},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3603":1605,"_31001":1332,"_21481":55595,"_5":14758,"_28188":54892,"_3059":55596},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3603":1606,"_31001":1332,"_21481":55598,"_5":14758,"_28188":54892,"_3059":55599},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3603":1607,"_31001":1332,"_21481":55601,"_5":14758,"_28188":54892,"_3059":55602},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3603":1608,"_31001":1332,"_21481":55604,"_5":14758,"_28188":54892,"_3059":55605},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3603":1609,"_31001":1332,"_21481":55607,"_5":14758,"_28188":54892,"_3059":55608},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3603":1610,"_31001":1332,"_21481":55610,"_5":14758,"_28188":54892,"_3059":55611},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3603":1611,"_31001":1332,"_21481":55613,"_5":14758,"_28188":54892,"_3059":55614},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":1612,"_31001":1332,"_21481":55616,"_5":14758,"_28188":54892,"_3059":55617},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3603":1613,"_31001":1332,"_21481":55619,"_5":14758,"_28188":54892,"_3059":55620},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3603":1614,"_31001":1614,"_5":15118,"_3059":53327,"_31339":55622,"_21481":55623,"_28188":1614},[50643,52155,53327],[],{"_3603":1615,"_31001":1614,"_21481":55625,"_5":14758,"_28188":1614,"_3059":55626},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3603":1616,"_31001":1614,"_5":31336,"_21481":55628,"_28188":55629,"_3059":55630},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3603":1617,"_31001":1614,"_5":31336,"_21481":55632,"_28188":55633,"_3059":53325},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3603":1618,"_31001":1614,"_5":31336,"_21481":55635,"_28188":55636,"_3059":53508},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3603":1619,"_31001":1614,"_5":31336,"_21481":55638,"_28188":55639,"_3059":54789},[],"/docs/platform/iot-fleets/overview#integrations",{"_3603":1620,"_31001":1614,"_5":31336,"_21481":55641,"_28188":55642,"_3059":55643},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3603":1621,"_31001":1614,"_21481":55645,"_5":14758,"_28188":1614,"_3059":55646},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3603":1622,"_31001":1614,"_21481":55648,"_5":14758,"_28188":55629,"_3059":55649},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3603":1623,"_31001":1614,"_21481":55651,"_5":14758,"_28188":55629,"_3059":55652},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3603":1624,"_31001":1614,"_21481":55654,"_5":14758,"_28188":55633,"_3059":55655},[],"Resource",{"_3603":1625,"_31001":1614,"_21481":55657,"_5":14758,"_28188":55633,"_3059":55658},[],"What it represents",{"_3603":1626,"_31001":1614,"_21481":55660,"_5":14758,"_28188":55633,"_3059":55661},[],"**Device**",{"_3603":1627,"_31001":1614,"_21481":55663,"_5":14758,"_28188":55633,"_3059":55664},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3603":1628,"_31001":1614,"_21481":55666,"_5":14758,"_28188":55633,"_3059":55667},[],"**Identity**",{"_3603":1629,"_31001":1614,"_21481":55669,"_5":14758,"_28188":55633,"_3059":55670},[],"The device's association with its certificates: an active version and a history.",{"_3603":1630,"_31001":1614,"_21481":55672,"_5":14758,"_28188":55633,"_3059":55673},[],"**DMS**",{"_3603":1631,"_31001":1614,"_21481":55675,"_5":14758,"_28188":55633,"_3059":55676},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3603":1632,"_31001":1614,"_21481":55678,"_5":14758,"_28188":55633,"_3059":55679},[],"**Fleet**",{"_3603":1633,"_31001":1614,"_21481":55681,"_5":14758,"_28188":55633,"_3059":55682},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3603":1634,"_31001":1614,"_21481":55684,"_5":14758,"_28188":55633,"_3059":55685},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3603":1635,"_31001":1614,"_21481":55687,"_5":14758,"_28188":55633,"_3059":55688},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3603":1636,"_31001":1614,"_21481":55690,"_5":14758,"_28188":55636,"_3059":55691},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3603":1637,"_31001":1614,"_21481":55693,"_5":14758,"_28188":55636,"_3059":55694},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3603":1638,"_31001":1614,"_21481":55696,"_5":14758,"_28188":55636,"_3059":55697},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3603":1639,"_31001":1614,"_21481":55699,"_5":14758,"_28188":55636,"_3059":55700},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3603":1640,"_31001":1614,"_21481":55702,"_5":14758,"_28188":55636,"_3059":55703},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3603":1641,"_31001":1614,"_21481":55705,"_5":14758,"_28188":55636,"_3059":55706},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3603":1642,"_31001":1614,"_21481":55708,"_5":14758,"_28188":55636,"_3059":55709},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3603":1643,"_31001":1614,"_21481":55711,"_5":14758,"_28188":55636,"_3059":55712},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3603":1644,"_31001":1614,"_21481":55714,"_5":14758,"_28188":55639,"_3059":55715},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3603":1645,"_31001":1614,"_21481":55717,"_5":14758,"_28188":55639,"_3059":55718},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3603":1646,"_31001":1614,"_21481":55720,"_5":14758,"_28188":55642,"_3059":55721},[],"Participant",{"_3603":1647,"_31001":1614,"_21481":55723,"_5":14758,"_28188":55642,"_3059":55724},[],"Responsibility",{"_3603":1648,"_31001":1614,"_21481":55726,"_5":14758,"_28188":55642,"_3059":55727},[],"PKI administrator",{"_3603":1649,"_31001":1614,"_21481":55729,"_5":14758,"_28188":55642,"_3059":55730},[],"CA, issuance profile, chain and revocation publication.",{"_3603":1650,"_31001":1614,"_21481":55732,"_5":14758,"_28188":55642,"_3059":55733},[],"Provisioning administrator",{"_3603":1651,"_31001":1614,"_21481":55735,"_5":14758,"_28188":55642,"_3059":55736},[],"DMS, admission, authentication per operation and inventory.",{"_3603":1652,"_31001":1614,"_21481":55738,"_5":14758,"_28188":55642,"_3059":55739},[],"Device integrator",{"_3603":1653,"_31001":1614,"_21481":55741,"_5":14758,"_28188":55642,"_3059":55742},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3603":1654,"_31001":1614,"_21481":55744,"_5":14758,"_28188":55642,"_3059":55745},[],"Consumer integrator",{"_3603":1655,"_31001":1614,"_21481":55747,"_5":14758,"_28188":55642,"_3059":55748},[],"Trusted issuers, validation and device permissions in the destination.",{"_3603":1656,"_31001":1614,"_21481":55750,"_5":14758,"_28188":55642,"_3059":55751},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3603":1657,"_31001":1657,"_5":15118,"_3059":55753,"_31339":55754,"_21481":55756,"_28188":1657},"Enroll and connect your first device",[50643,52155,53327,55755],"Getting started",[],{"_3603":1658,"_31001":1657,"_21481":55758,"_5":14758,"_28188":1657,"_3059":55759},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3603":1659,"_31001":1657,"_5":31336,"_21481":55761,"_28188":55762,"_3059":50653},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3603":1660,"_31001":1657,"_5":31336,"_21481":55764,"_28188":55765,"_3059":55766},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3603":1661,"_31001":1657,"_5":31336,"_21481":55768,"_28188":55769,"_3059":55770},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3603":1662,"_31001":1657,"_5":31336,"_21481":55772,"_28188":55773,"_3059":55774},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3603":1663,"_31001":1657,"_5":31336,"_21481":55776,"_28188":55777,"_3059":55778},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3603":1664,"_31001":1657,"_5":31336,"_21481":55780,"_28188":55781,"_3059":55782},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3603":1665,"_31001":1657,"_5":31336,"_21481":55784,"_28188":55785,"_3059":55786},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3603":1666,"_31001":1657,"_5":31336,"_21481":55788,"_28188":55789,"_3059":55790},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3603":1667,"_31001":1657,"_21481":55792,"_5":14758,"_28188":1657,"_3059":55793},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3603":1668,"_31001":1657,"_21481":55795,"_5":14758,"_28188":55762,"_3059":55796},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3603":1669,"_31001":1657,"_21481":55798,"_5":14758,"_28188":55762,"_3059":55799},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3603":1670,"_31001":1657,"_21481":55801,"_5":14758,"_28188":55762,"_3059":55802},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3603":1671,"_31001":1657,"_21481":55804,"_5":14758,"_28188":55762,"_3059":55805},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3603":1672,"_31001":1657,"_21481":55807,"_5":14758,"_28188":55762,"_3059":55808},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3603":1673,"_31001":1657,"_21481":55810,"_5":14758,"_28188":55765,"_3059":55811},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3603":1674,"_31001":1657,"_21481":55813,"_5":14758,"_28188":55765,"_3059":55814},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3603":1675,"_31001":1657,"_21481":55816,"_5":14758,"_28188":55769,"_3059":55817},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3603":1676,"_31001":1657,"_21481":55819,"_5":14758,"_28188":55769,"_3059":55820},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3603":1677,"_31001":1657,"_21481":55822,"_5":14758,"_28188":55769,"_3059":55823},[],"Setting",{"_3603":1678,"_31001":1657,"_21481":55825,"_5":14758,"_28188":55769,"_3059":55826},[],"Evaluation value",{"_3603":1679,"_31001":1657,"_21481":55828,"_5":14758,"_28188":55769,"_3059":55829},[],"Enrollment CA",{"_3603":1680,"_31001":1657,"_21481":55831,"_5":14758,"_28188":55769,"_3059":55832},[],"Issuing root from `device-root.pem`.",{"_3603":1681,"_31001":1657,"_21481":55834,"_5":14758,"_28188":55769,"_3059":53638},[],{"_3603":1682,"_31001":1657,"_21481":55836,"_5":14758,"_28188":55769,"_3059":55837},[],"The 1-hour leaf profile you just prepared.",{"_3603":1683,"_31001":1657,"_21481":55839,"_5":14758,"_28188":55769,"_3059":55840},[],"Protocol / Registration Mode",{"_3603":1684,"_31001":1657,"_21481":55842,"_5":14758,"_28188":55769,"_3059":55843},[],"`EST_RFC7030` / `JITP`.",{"_3603":1685,"_31001":1657,"_21481":55845,"_5":14758,"_28188":55769,"_3059":55846},[],"Verify CSR Signature",{"_3603":1686,"_31001":1657,"_21481":55848,"_5":14758,"_28188":55769,"_3059":55849},[],"Enabled.",{"_3603":1687,"_31001":1657,"_21481":55851,"_5":14758,"_28188":55769,"_3059":55852},[],"Enable Replaceable Enrollment",{"_3603":1688,"_31001":1657,"_21481":55854,"_5":14758,"_28188":55769,"_3059":55855},[],"Disabled; the ID must be new.",{"_3603":1689,"_31001":1657,"_21481":55857,"_5":14758,"_28188":55769,"_3059":55858},[],"Initial authentication",{"_3603":1690,"_31001":1657,"_21481":55860,"_5":14758,"_28188":55769,"_3059":55861},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3603":1691,"_31001":1657,"_21481":55863,"_5":14758,"_28188":55769,"_3059":55864},[],"Renewal authentication",{"_3603":1692,"_31001":1657,"_21481":55866,"_5":14758,"_28188":55769,"_3059":55867},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3603":1693,"_31001":1657,"_21481":55869,"_5":14758,"_28188":55769,"_3059":55870},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3603":1694,"_31001":1657,"_21481":55872,"_5":14758,"_28188":55769,"_3059":55873},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3603":1695,"_31001":1657,"_21481":55875,"_5":14758,"_28188":55769,"_3059":55876},[],"Re-enrollment Delta",{"_3603":1696,"_31001":1657,"_21481":55878,"_5":14758,"_28188":55769,"_3059":55879},[],"1 hour.",{"_3603":1697,"_31001":1657,"_21481":55881,"_5":14758,"_28188":55769,"_3059":55882},[],"Preventive / Critical Delta",{"_3603":1698,"_31001":1657,"_21481":55884,"_5":14758,"_28188":55769,"_3059":55885},[],"30 minutes / 10 minutes.",{"_3603":1699,"_31001":1657,"_21481":55887,"_5":14758,"_28188":55769,"_3059":55888},[],"Revoke on Re-enrollment",{"_3603":1700,"_31001":1657,"_21481":55890,"_5":14758,"_28188":55769,"_3059":55891},[],"Disabled to test the successor before retiring the previous identity.",{"_3603":1701,"_31001":1657,"_21481":55893,"_5":14758,"_28188":55769,"_3059":53646},[],{"_3603":1702,"_31001":1657,"_21481":55895,"_5":14758,"_28188":55769,"_3059":55896},[],"Disabled; the operational key is generated in the client.",{"_3603":1703,"_31001":1657,"_21481":55898,"_5":14758,"_28188":55769,"_3059":55899},[],"CA Distribution",{"_3603":1704,"_31001":1657,"_21481":55901,"_5":14758,"_28188":55769,"_3059":55902},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3603":1705,"_31001":1657,"_21481":55904,"_5":14758,"_28188":55769,"_3059":55905},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3603":1706,"_31001":1657,"_21481":55907,"_5":14758,"_28188":55773,"_3059":55908},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3603":1707,"_31001":1657,"_21481":55910,"_5":14758,"_28188":55773,"_3059":55911},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3603":1708,"_31001":1657,"_21481":55913,"_5":14758,"_28188":55777,"_3059":55914},[],"Generate a new key and CSR with the selected identifier:",{"_3603":1709,"_31001":1657,"_21481":55916,"_5":14758,"_28188":55777,"_3059":55917},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3603":1710,"_31001":1657,"_21481":55919,"_5":14758,"_28188":55777,"_3059":55920},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3603":1711,"_31001":1657,"_21481":55922,"_5":14758,"_28188":55781,"_3059":55923},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3603":1712,"_31001":1657,"_21481":55925,"_5":14758,"_28188":55781,"_3059":55926},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3603":1713,"_31001":1657,"_21481":55928,"_5":14758,"_28188":55785,"_3059":55929},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3603":1714,"_31001":1657,"_21481":55931,"_5":14758,"_28188":55785,"_3059":55932},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3603":1715,"_31001":1657,"_21481":55934,"_5":14758,"_28188":55785,"_3059":55935},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3603":1716,"_31001":1657,"_21481":55937,"_5":14758,"_28188":55785,"_3059":55938},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3603":1717,"_31001":1657,"_21481":55940,"_5":14758,"_28188":55785,"_3059":55941},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3603":1718,"_31001":1657,"_21481":55943,"_5":14758,"_28188":55789,"_3059":55944},[],"Check",{"_3603":1719,"_31001":1657,"_21481":55946,"_5":14758,"_28188":55789,"_3059":55947},[],"Expected result",{"_3603":1720,"_31001":1657,"_21481":55949,"_5":14758,"_28188":55789,"_3059":55950},[],"Registration",{"_3603":1721,"_31001":1657,"_21481":55952,"_5":14758,"_28188":55789,"_3059":55953},[],"ID created automatically and correct DMS.",{"_3603":1722,"_31001":1657,"_21481":55955,"_5":14758,"_28188":55789,"_3059":55211},[],{"_3603":1723,"_31001":1657,"_21481":55957,"_5":14758,"_28188":55789,"_3059":55958},[],"CN, profile, serial and key verified.",{"_3603":1724,"_31001":1657,"_21481":55960,"_5":14758,"_28188":55789,"_3059":55961},[],"Inventory",{"_3603":1725,"_31001":1657,"_21481":55963,"_5":14758,"_28188":55789,"_3059":55964},[],"Received serial visible as the current identity and in history.",{"_3603":1726,"_31001":1657,"_21481":55966,"_5":14758,"_28188":55789,"_3059":55967},[],"Consumer",{"_3603":1727,"_31001":1657,"_21481":55969,"_5":14758,"_28188":55789,"_3059":55970},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3603":1728,"_31001":1657,"_21481":55972,"_5":14758,"_28188":55789,"_3059":55973},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3603":1729,"_31001":1657,"_21481":55975,"_5":14758,"_28188":55789,"_3059":55976},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3603":1730,"_31001":1730,"_5":15118,"_3059":53343,"_31339":55978,"_21481":55979,"_28188":1730},[50643,52155,53327,55755],[],{"_3603":1731,"_31001":1730,"_21481":55981,"_5":14758,"_28188":1730,"_3059":55982},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3603":1732,"_31001":1730,"_5":31336,"_21481":55984,"_28188":55985,"_3059":50653},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3603":1733,"_31001":1730,"_5":31336,"_21481":55987,"_28188":55988,"_3059":55989},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3603":1734,"_31001":1730,"_5":31336,"_21481":55991,"_28188":55992,"_3059":55993},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3603":1735,"_31001":1730,"_5":31336,"_21481":55995,"_28188":55996,"_3059":55997},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3603":1736,"_31001":1730,"_5":31336,"_21481":55999,"_28188":56000,"_3059":56001},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3603":1737,"_31001":1730,"_5":31336,"_21481":56003,"_28188":56004,"_3059":56005},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3603":1738,"_31001":1730,"_5":31336,"_21481":56007,"_28188":56008,"_3059":55947},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3603":1739,"_31001":1730,"_5":31336,"_21481":56010,"_28188":56011,"_3059":56012},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3603":1740,"_31001":1730,"_5":31336,"_21481":56014,"_28188":56015,"_3059":56016},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3603":1741,"_31001":1730,"_21481":56018,"_5":14758,"_28188":1730,"_3059":56019},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3603":1742,"_31001":1730,"_21481":56021,"_5":14758,"_28188":1730,"_3059":56022},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3603":1743,"_31001":1730,"_21481":56024,"_5":14758,"_28188":55985,"_3059":56025},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3603":1744,"_31001":1730,"_21481":56027,"_5":14758,"_28188":55985,"_3059":56028},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3603":1745,"_31001":1730,"_21481":56030,"_5":14758,"_28188":55985,"_3059":56031},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3603":1746,"_31001":1730,"_21481":56033,"_5":14758,"_28188":55985,"_3059":56034},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3603":1747,"_31001":1730,"_21481":56036,"_5":14758,"_28188":55988,"_3059":56037},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3603":1748,"_31001":1730,"_21481":56039,"_5":14758,"_28188":55988,"_3059":56040},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3603":1749,"_31001":1730,"_21481":56042,"_5":14758,"_28188":55988,"_3059":56043},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3603":1750,"_31001":1730,"_21481":56045,"_5":14758,"_28188":55988,"_3059":56046},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3603":1751,"_31001":1730,"_21481":56048,"_5":14758,"_28188":55988,"_3059":56049},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3603":1752,"_31001":1730,"_21481":56051,"_5":14758,"_28188":55988,"_3059":56052},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3603":1753,"_31001":1730,"_21481":56054,"_5":14758,"_28188":55988,"_3059":56055},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3603":1754,"_31001":1730,"_21481":56057,"_5":14758,"_28188":55988,"_3059":56058},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3603":1755,"_31001":1730,"_21481":56060,"_5":14758,"_28188":55992,"_3059":56061},[],"Open **Managed Devices** and the registration action. Complete:",{"_3603":1756,"_31001":1730,"_21481":56063,"_5":14758,"_28188":55992,"_3059":56064},[],"**Device ID**: `device-001`.",{"_3603":1757,"_31001":1730,"_21481":56066,"_5":14758,"_28188":55992,"_3059":56067},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3603":1758,"_31001":1730,"_21481":56069,"_5":14758,"_28188":55992,"_3059":56070},[],"**Icon** and **Tags**: optional classification.",{"_3603":1759,"_31001":1730,"_21481":56072,"_5":14758,"_28188":55992,"_3059":56073},[],"Confirm registration.",{"_3603":1760,"_31001":1730,"_21481":56075,"_5":14758,"_28188":55996,"_3059":56076},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3603":1761,"_31001":1730,"_21481":56078,"_5":14758,"_28188":55996,"_3059":56079},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3603":1762,"_31001":1730,"_21481":56081,"_5":14758,"_28188":56000,"_3059":56082},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3603":1763,"_31001":1730,"_21481":56084,"_5":14758,"_28188":56000,"_3059":56085},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3603":1764,"_31001":1730,"_21481":56087,"_5":14758,"_28188":56004,"_3059":56088},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3603":1765,"_31001":1730,"_21481":56090,"_5":14758,"_28188":56004,"_3059":56091},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3603":1766,"_31001":1730,"_21481":56093,"_5":14758,"_28188":56008,"_3059":55944},[],{"_3603":1767,"_31001":1730,"_21481":56095,"_5":14758,"_28188":56008,"_3059":56096},[],"Result",{"_3603":1768,"_31001":1730,"_21481":56098,"_5":14758,"_28188":56008,"_3059":55194},[],{"_3603":1769,"_31001":1730,"_21481":56100,"_5":14758,"_28188":56008,"_3059":56101},[],"`device-001` appears in inventory with the expected DMS.",{"_3603":1770,"_31001":1730,"_21481":56103,"_5":14758,"_28188":56008,"_3059":56104},[],"Current identity",{"_3603":1771,"_31001":1730,"_21481":56106,"_5":14758,"_28188":56008,"_3059":56107},[],"The associated certificate matches the one you verified in PKI.",{"_3603":1772,"_31001":1730,"_21481":56109,"_5":14758,"_28188":56008,"_3059":56110},[],"History",{"_3603":1773,"_31001":1730,"_21481":56112,"_5":14758,"_28188":56008,"_3059":56113},[],"The associated issuance appears with its serial number and dates.",{"_3603":1774,"_31001":1730,"_21481":56115,"_5":14758,"_28188":56008,"_3059":56116},[],"Key and certificate",{"_3603":1775,"_31001":1730,"_21481":56118,"_5":14758,"_28188":56008,"_3059":56119},[],"You have the verified pair ready to install on the device.",{"_3603":1776,"_31001":1730,"_21481":56121,"_5":14758,"_28188":56011,"_3059":56122},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3603":1777,"_31001":1730,"_21481":56124,"_5":14758,"_28188":56011,"_3059":56125},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3603":1778,"_31001":1730,"_21481":56127,"_5":14758,"_28188":56011,"_3059":56128},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3603":1779,"_31001":1730,"_21481":56130,"_5":14758,"_28188":56011,"_3059":56131},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3603":1780,"_31001":1730,"_21481":56133,"_5":14758,"_28188":56015,"_3059":56134},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3603":1781,"_31001":1730,"_21481":56136,"_5":14758,"_28188":56015,"_3059":56137},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3603":1782,"_31001":1730,"_21481":56139,"_5":14758,"_28188":56015,"_3059":56140},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3603":1783,"_31001":1783,"_5":15118,"_3059":56142,"_31339":56143,"_21481":56144,"_28188":1783},"Lamassu IoT Platform",[50643,52155],[],{"_3603":1784,"_31001":1783,"_21481":56146,"_5":14758,"_28188":1783,"_3059":56147},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3603":1785,"_31001":1783,"_5":31336,"_21481":56149,"_28188":56150,"_3059":55630},[],"/docs/platform/overview#start-here",{"_3603":1786,"_31001":1783,"_5":31336,"_21481":56152,"_28188":56153,"_3059":56154},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3603":1787,"_31001":1783,"_5":31336,"_21481":56156,"_28188":56157,"_3059":56158},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3603":1788,"_31001":1783,"_5":31336,"_21481":56160,"_28188":56161,"_3059":56162},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3603":1789,"_31001":1783,"_5":31336,"_21481":56164,"_28188":56165,"_3059":56166},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3603":1790,"_31001":1783,"_5":31336,"_21481":56168,"_28188":56169,"_3059":56170},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3603":1791,"_31001":1783,"_5":31336,"_21481":56172,"_28188":56173,"_3059":56174},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3603":1792,"_31001":1783,"_5":31336,"_21481":56176,"_28188":56177,"_3059":56178},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3603":1793,"_31001":1783,"_5":31336,"_21481":56180,"_28188":56181,"_3059":56182},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3603":1794,"_31001":1783,"_5":31336,"_21481":56184,"_28188":56185,"_3059":56186},[],"/docs/platform/overview#react-to-events","React to events",{"_3603":1795,"_31001":1783,"_5":31336,"_21481":56188,"_28188":56189,"_3059":56190},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3603":1796,"_31001":1783,"_21481":56192,"_5":14758,"_28188":1783,"_3059":56193},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3603":1797,"_31001":1783,"_21481":56195,"_5":14758,"_28188":56150,"_3059":56196},[],"Choose the result you need:",{"_3603":1798,"_31001":1783,"_21481":56198,"_5":14758,"_28188":56150,"_3059":56199},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3603":1799,"_31001":1783,"_21481":56201,"_5":14758,"_28188":56150,"_3059":56202},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3603":1800,"_31001":1783,"_21481":56204,"_5":14758,"_28188":56150,"_3059":56205},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3603":1801,"_31001":1783,"_21481":56207,"_5":14758,"_28188":56153,"_3059":56208},[],"Section",{"_3603":1802,"_31001":1783,"_21481":56210,"_5":14758,"_28188":56153,"_3059":56211},[],"What you manage",{"_3603":1803,"_31001":1783,"_21481":56213,"_5":14758,"_28188":56153,"_3059":56214},[],"Entry point",{"_3603":1804,"_31001":1783,"_21481":56216,"_5":14758,"_28188":56153,"_3059":56217},[],"**PKI**",{"_3603":1805,"_31001":1783,"_21481":56219,"_5":14758,"_28188":56153,"_3059":56220},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3603":1806,"_31001":1783,"_21481":56222,"_5":14758,"_28188":56153,"_3059":56223},[],"PKI overview",{"_3603":1807,"_31001":1783,"_21481":56225,"_5":14758,"_28188":56153,"_3059":56226},[],"**IoT Fleets**",{"_3603":1808,"_31001":1783,"_21481":56228,"_5":14758,"_28188":56153,"_3059":56229},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3603":1809,"_31001":1783,"_21481":56231,"_5":14758,"_28188":56153,"_3059":56232},[],"IoT Fleets overview",{"_3603":1810,"_31001":1783,"_21481":56234,"_5":14758,"_28188":56153,"_3059":56235},[],"**Administration**",{"_3603":1811,"_31001":1783,"_21481":56237,"_5":14758,"_28188":56153,"_3059":56238},[],"Operator permissions, audit and event subscriptions.",{"_3603":1812,"_31001":1783,"_21481":56240,"_5":14758,"_28188":56153,"_3059":52157},[],{"_3603":1813,"_31001":1783,"_21481":56242,"_5":14758,"_28188":56153,"_3059":56243},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3603":1814,"_31001":1783,"_21481":56245,"_5":14758,"_28188":56157,"_3059":56246},[],"An identity's journey connects four responsibilities:",{"_3603":1815,"_31001":1783,"_21481":56248,"_5":14758,"_28188":56157,"_3059":56249},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3603":1816,"_31001":1783,"_21481":56251,"_5":14758,"_28188":56157,"_3059":56252},[],"The provisioning administrator configures the DMS and initial trust.",{"_3603":1817,"_31001":1783,"_21481":56254,"_5":14758,"_28188":56157,"_3059":56255},[],"The device client requests a certificate and installs it with the matching key.",{"_3603":1818,"_31001":1783,"_21481":56257,"_5":14758,"_28188":56157,"_3059":56258},[],"The consumer validates the identity and applies its access permissions.",{"_3603":1819,"_31001":1783,"_21481":56260,"_5":14758,"_28188":56157,"_3059":56261},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3603":1820,"_31001":1783,"_21481":56263,"_5":14758,"_28188":56165,"_3059":56264},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3603":1821,"_31001":1783,"_21481":56266,"_5":14758,"_28188":56169,"_3059":56267},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3603":1822,"_31001":1783,"_21481":56269,"_5":14758,"_28188":56173,"_3059":56270},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3603":1823,"_31001":1783,"_21481":56272,"_5":14758,"_28188":56177,"_3059":56273},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3603":1824,"_31001":1783,"_21481":56275,"_5":14758,"_28188":56181,"_3059":56276},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3603":1825,"_31001":1783,"_21481":56278,"_5":14758,"_28188":56185,"_3059":56279},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3603":1826,"_31001":1783,"_21481":56281,"_5":14758,"_28188":56189,"_3059":55724},[],{"_3603":1827,"_31001":1783,"_21481":56283,"_5":14758,"_28188":56189,"_3059":56284},[],"What it prepares or checks",{"_3603":1828,"_31001":1783,"_21481":56286,"_5":14758,"_28188":56189,"_3059":55727},[],{"_3603":1829,"_31001":1783,"_21481":56288,"_5":14758,"_28188":56189,"_3059":56289},[],"Key custody, CA hierarchy, profiles and validation.",{"_3603":1830,"_31001":1783,"_21481":56291,"_5":14758,"_28188":56189,"_3059":56292},[],"Fleet administrator",{"_3603":1831,"_31001":1783,"_21481":56294,"_5":14758,"_28188":56189,"_3059":56295},[],"DMS, device admission, renewal policy and inventory.",{"_3603":1832,"_31001":1783,"_21481":56297,"_5":14758,"_28188":56189,"_3059":55739},[],{"_3603":1833,"_31001":1783,"_21481":56299,"_5":14758,"_28188":56189,"_3059":56300},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3603":1834,"_31001":1783,"_21481":56302,"_5":14758,"_28188":56189,"_3059":55745},[],{"_3603":1835,"_31001":1783,"_21481":56304,"_5":14758,"_28188":56189,"_3059":56305},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3603":1836,"_31001":1783,"_21481":56307,"_5":14758,"_28188":56189,"_3059":56308},[],"Infrastructure operator",{"_3603":1837,"_31001":1783,"_21481":56310,"_5":14758,"_28188":56189,"_3059":56311},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3603":1838,"_31001":1783,"_21481":56313,"_5":14758,"_28188":56189,"_3059":56314},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3603":1839,"_31001":1839,"_5":15118,"_3059":56316,"_31339":56317,"_21481":56320,"_28188":1839},"CA hierarchy and rotation",[50643,52155,56318,56319],"PKI","Keys, authorities and certificates",[],{"_3603":1840,"_31001":1839,"_21481":56322,"_5":14758,"_28188":1839,"_3059":56323},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3603":1841,"_31001":1839,"_5":31336,"_21481":56325,"_28188":56326,"_3059":56327},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3603":1842,"_31001":1839,"_5":31336,"_21481":56329,"_28188":56330,"_3059":56331},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3603":1843,"_31001":1839,"_5":31336,"_21481":56333,"_28188":56334,"_3059":56335},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3603":1844,"_31001":1839,"_5":31336,"_21481":56337,"_28188":56338,"_3059":56339},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3603":1845,"_31001":1839,"_5":31336,"_21481":56341,"_28188":56342,"_3059":56343},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3603":1846,"_31001":1839,"_5":31336,"_21481":56345,"_28188":56346,"_3059":56347},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3603":1847,"_31001":1839,"_5":31336,"_21481":56349,"_28188":56350,"_3059":56351},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3603":1848,"_31001":1839,"_5":31336,"_21481":56353,"_28188":56354,"_3059":56355},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3603":1849,"_31001":1839,"_5":31336,"_21481":56357,"_28188":56358,"_3059":56359},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3603":1850,"_31001":1839,"_5":31336,"_21481":56361,"_28188":56362,"_3059":56363},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3603":1851,"_31001":1839,"_5":31336,"_21481":56365,"_28188":56366,"_3059":56367},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3603":1852,"_31001":1839,"_5":31336,"_21481":56369,"_28188":56370,"_3059":56371},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3603":1853,"_31001":1839,"_21481":56373,"_5":14758,"_28188":1839,"_3059":56374},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3603":1854,"_31001":1839,"_21481":56376,"_5":14758,"_28188":1839,"_3059":56377},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3603":1855,"_31001":1839,"_21481":56379,"_5":14758,"_28188":56326,"_3059":56380},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3603":1856,"_31001":1839,"_21481":56382,"_5":14758,"_28188":56326,"_3059":56383},[],"environment, such as production and preproduction;",{"_3603":1857,"_31001":1839,"_21481":56385,"_5":14758,"_28188":56326,"_3059":56386},[],"owner or operating team;",{"_3603":1858,"_31001":1839,"_21481":56388,"_5":14758,"_28188":56326,"_3059":56389},[],"device family or manufacturing process;",{"_3603":1859,"_31001":1839,"_21481":56391,"_5":14758,"_28188":56326,"_3059":56392},[],"region or regulatory requirement;",{"_3603":1860,"_31001":1839,"_21481":56394,"_5":14758,"_28188":56326,"_3059":56395},[],"cryptographic engine or key policy;",{"_3603":1861,"_31001":1839,"_21481":56397,"_5":14758,"_28188":56326,"_3059":56398},[],"maintenance window and renewal cadence.",{"_3603":1862,"_31001":1839,"_21481":56400,"_5":14758,"_28188":56326,"_3059":56401},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3603":1863,"_31001":1839,"_21481":56403,"_5":14758,"_28188":56326,"_3059":56404},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3603":1864,"_31001":1839,"_21481":56406,"_5":14758,"_28188":56330,"_3059":56407},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3603":1865,"_31001":1839,"_21481":56409,"_5":14758,"_28188":56330,"_3059":56410},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3603":1866,"_31001":1839,"_21481":56412,"_5":14758,"_28188":56330,"_3059":56413},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3603":1867,"_31001":1839,"_21481":56415,"_5":14758,"_28188":56330,"_3059":56416},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3603":1868,"_31001":1839,"_21481":56418,"_5":14758,"_28188":56334,"_3059":56419},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3603":1869,"_31001":1839,"_21481":56421,"_5":14758,"_28188":56334,"_3059":56422},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3603":1870,"_31001":1839,"_21481":56424,"_5":14758,"_28188":56334,"_3059":56425},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3603":1871,"_31001":1839,"_21481":56427,"_5":14758,"_28188":56334,"_3059":56428},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3603":1872,"_31001":1839,"_21481":56430,"_5":14758,"_28188":56342,"_3059":56431},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3603":1873,"_31001":1839,"_21481":56433,"_5":14758,"_28188":56346,"_3059":56434},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3603":1874,"_31001":1839,"_21481":56436,"_5":14758,"_28188":56350,"_3059":56437},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3603":1875,"_31001":1839,"_21481":56439,"_5":14758,"_28188":56354,"_3059":56440},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3603":1876,"_31001":1839,"_21481":56442,"_5":14758,"_28188":56358,"_3059":56443},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3603":1877,"_31001":1839,"_21481":56445,"_5":14758,"_28188":56362,"_3059":56446},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3603":1878,"_31001":1839,"_21481":56448,"_5":14758,"_28188":56366,"_3059":56449},[],"Lamassu saves the CA’s revocation, then attempts to revoke child CAs and issued certificates with `CessationOfOperation`. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3603":1879,"_31001":1839,"_21481":56451,"_5":14758,"_28188":56366,"_3059":56452},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3603":1880,"_31001":1839,"_21481":56454,"_5":14758,"_28188":56366,"_3059":56455},[],"`CertificateHold` allows reactivating the parent while it is not expired, but does not restore child CAs or certificates permanently revoked during the cascade. Holding a CA therefore does not provide a reversible pause for its entire branch.",{"_3603":1881,"_31001":1839,"_21481":56457,"_5":14758,"_28188":56366,"_3059":56458},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3603":1882,"_31001":1839,"_21481":56460,"_5":14758,"_28188":56370,"_3059":56461},[],"The new chain ends in an anchor installed by the consumer.",{"_3603":1883,"_31001":1839,"_21481":56463,"_5":14758,"_28188":56370,"_3059":56464},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3603":1884,"_31001":1839,"_21481":56466,"_5":14758,"_28188":56370,"_3059":56467},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3603":1885,"_31001":1839,"_21481":56469,"_5":14758,"_28188":56370,"_3059":56470},[],"Re-enrollment accepts the old identity during the planned period.",{"_3603":1886,"_31001":1839,"_21481":56472,"_5":14758,"_28188":56370,"_3059":56473},[],"OCSP and CRL respond for the authorities that remain active.",{"_3603":1887,"_31001":1839,"_21481":56475,"_5":14758,"_28188":56370,"_3059":56476},[],"No DMS is left accidentally issuing from the old CA.",{"_3603":1888,"_31001":1839,"_21481":56478,"_5":14758,"_28188":56370,"_3059":56479},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3603":1889,"_31001":1889,"_5":15118,"_3059":56481,"_31339":56482,"_21481":56483,"_28188":1889},"Certification authorities",[50643,52155,56318,56319],[],{"_3603":1890,"_31001":1889,"_21481":56485,"_5":14758,"_28188":1889,"_3059":56486},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3603":1891,"_31001":1889,"_5":31336,"_21481":56488,"_28188":56489,"_3059":56490},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3603":1892,"_31001":1889,"_5":31336,"_21481":56492,"_28188":56493,"_3059":56494},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3603":1893,"_31001":1889,"_5":31336,"_21481":56496,"_28188":56497,"_3059":50653},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3603":1894,"_31001":1889,"_5":31336,"_21481":56499,"_28188":56500,"_3059":56501},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3603":1895,"_31001":1889,"_5":31336,"_21481":56503,"_28188":56504,"_3059":56505},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3603":1896,"_31001":1889,"_5":31336,"_21481":56507,"_28188":56508,"_3059":56509},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3603":1897,"_31001":1889,"_5":31336,"_21481":56511,"_28188":56512,"_3059":56513},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3603":1898,"_31001":1889,"_5":31336,"_21481":56515,"_28188":56516,"_3059":56517},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3603":1899,"_31001":1889,"_5":31336,"_21481":56519,"_28188":56520,"_3059":56521},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3603":1900,"_31001":1889,"_5":31336,"_21481":56523,"_28188":56524,"_3059":56525},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3603":1901,"_31001":1889,"_5":31336,"_21481":56527,"_28188":56528,"_3059":56529},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3603":1902,"_31001":1889,"_5":31336,"_21481":56531,"_28188":56532,"_3059":56533},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3603":1903,"_31001":1889,"_5":31336,"_21481":56535,"_28188":56536,"_3059":56537},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3603":1904,"_31001":1889,"_5":31336,"_21481":56539,"_28188":56540,"_3059":56541},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3603":1905,"_31001":1889,"_5":31336,"_21481":56543,"_28188":56544,"_3059":56545},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3603":1906,"_31001":1889,"_5":31336,"_21481":56547,"_28188":56548,"_3059":56549},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3603":1907,"_31001":1889,"_5":31336,"_21481":56551,"_28188":56552,"_3059":56553},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3603":1908,"_31001":1889,"_5":31336,"_21481":56555,"_28188":56556,"_3059":56557},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3603":1909,"_31001":1889,"_5":31336,"_21481":56559,"_28188":56560,"_3059":56561},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3603":1910,"_31001":1889,"_5":31336,"_21481":56563,"_28188":56564,"_3059":56565},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3603":1911,"_31001":1889,"_5":31336,"_21481":56567,"_28188":56568,"_3059":56569},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3603":1912,"_31001":1889,"_5":31336,"_21481":56571,"_28188":56572,"_3059":56573},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3603":1913,"_31001":1889,"_5":31336,"_21481":56575,"_28188":56576,"_3059":56577},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3603":1914,"_31001":1889,"_21481":56579,"_5":14758,"_28188":1889,"_3059":56580},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3603":1915,"_31001":1889,"_21481":56582,"_5":14758,"_28188":1889,"_3059":56583},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3603":1916,"_31001":1889,"_21481":56585,"_5":14758,"_28188":1889,"_3059":56586},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3603":1917,"_31001":1889,"_21481":56588,"_5":14758,"_28188":56489,"_3059":56589},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3603":1918,"_31001":1889,"_21481":56591,"_5":14758,"_28188":56489,"_3059":56592},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3603":1919,"_31001":1889,"_21481":56594,"_5":14758,"_28188":56489,"_3059":56595},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3603":1920,"_31001":1889,"_21481":56597,"_5":14758,"_28188":56489,"_3059":56598},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3603":1921,"_31001":1889,"_21481":56600,"_5":14758,"_28188":56489,"_3059":56601},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3603":1922,"_31001":1889,"_21481":56603,"_5":14758,"_28188":56497,"_3059":56604},[],"Decide whether the CA will be a root or an intermediate.",{"_3603":1923,"_31001":1889,"_21481":56606,"_5":14758,"_28188":56497,"_3059":56607},[],"Choose the engine that will keep the key.",{"_3603":1924,"_31001":1889,"_21481":56609,"_5":14758,"_28188":56497,"_3059":56610},[],"Define a validity longer than that of the certificates it will issue.",{"_3603":1925,"_31001":1889,"_21481":56612,"_5":14758,"_28188":56497,"_3059":56613},[],"For an intermediate CA, make sure the parent CA is active.",{"_3603":1926,"_31001":1889,"_21481":56615,"_5":14758,"_28188":56500,"_3059":56616},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3603":1927,"_31001":1889,"_21481":56618,"_5":14758,"_28188":56504,"_3059":56619},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3603":1928,"_31001":1889,"_21481":56621,"_5":14758,"_28188":56504,"_3059":56622},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3603":1929,"_31001":1889,"_21481":56624,"_5":14758,"_28188":56508,"_3059":56625},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3603":1930,"_31001":1889,"_21481":56627,"_5":14758,"_28188":56512,"_3059":56628},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3603":1931,"_31001":1889,"_21481":56630,"_5":14758,"_28188":56512,"_3059":56631},[],"`C`: two-letter ISO 3166-1 country code.",{"_3603":1932,"_31001":1889,"_21481":56633,"_5":14758,"_28188":56512,"_3059":56634},[],"`ST`: state or province.",{"_3603":1933,"_31001":1889,"_21481":56636,"_5":14758,"_28188":56512,"_3059":56637},[],"`L`: locality.",{"_3603":1934,"_31001":1889,"_21481":56639,"_5":14758,"_28188":56512,"_3059":56640},[],"`O`: organization.",{"_3603":1935,"_31001":1889,"_21481":56642,"_5":14758,"_28188":56512,"_3059":56643},[],"`OU`: organizational unit.",{"_3603":1936,"_31001":1889,"_21481":56645,"_5":14758,"_28188":56512,"_3059":56646},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3603":1937,"_31001":1889,"_21481":56648,"_5":14758,"_28188":56516,"_3059":56649},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3603":1938,"_31001":1889,"_21481":56651,"_5":14758,"_28188":56516,"_3059":56652},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3603":1939,"_31001":1889,"_21481":56654,"_5":14758,"_28188":56520,"_3059":56655},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3603":1940,"_31001":1889,"_21481":56657,"_5":14758,"_28188":56520,"_3059":56658},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3603":1941,"_31001":1889,"_21481":56660,"_5":14758,"_28188":56524,"_3059":56661},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3603":1942,"_31001":1889,"_21481":56663,"_5":14758,"_28188":56524,"_3059":56664},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3603":1943,"_31001":1889,"_21481":56666,"_5":14758,"_28188":56528,"_3059":56667},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3603":1944,"_31001":1889,"_21481":56669,"_5":14758,"_28188":56528,"_3059":56670},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3603":1945,"_31001":1889,"_21481":56672,"_5":14758,"_28188":56528,"_3059":56673},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3603":1946,"_31001":1889,"_21481":56675,"_5":14758,"_28188":56532,"_3059":56676},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3603":1947,"_31001":1889,"_21481":56678,"_5":14758,"_28188":56536,"_3059":56679},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3603":1948,"_31001":1889,"_21481":56681,"_5":14758,"_28188":56536,"_3059":56682},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3603":1949,"_31001":1889,"_21481":56684,"_5":14758,"_28188":56540,"_3059":56685},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3603":1950,"_31001":1889,"_21481":56687,"_5":14758,"_28188":56544,"_3059":56688},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3603":1951,"_31001":1889,"_21481":56690,"_5":14758,"_28188":56544,"_3059":56691},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3603":1952,"_31001":1889,"_21481":56693,"_5":14758,"_28188":56544,"_3059":56694},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3603":1953,"_31001":1889,"_21481":56696,"_5":14758,"_28188":56548,"_3059":56697},[],"Open a CA from the inventory to review:",{"_3603":1954,"_31001":1889,"_21481":56699,"_5":14758,"_28188":56548,"_3059":56700},[],"Status and validity period.",{"_3603":1955,"_31001":1889,"_21481":56702,"_5":14758,"_28188":56548,"_3059":56703},[],"Certificate and chain in PEM format.",{"_3603":1956,"_31001":1889,"_21481":56705,"_5":14758,"_28188":56548,"_3059":56706},[],"Number of active, expired and revoked certificates.",{"_3603":1957,"_31001":1889,"_21481":56708,"_5":14758,"_28188":56548,"_3059":56709},[],"Certificates issued in **Issued Certificates**.",{"_3603":1958,"_31001":1889,"_21481":56711,"_5":14758,"_28188":56548,"_3059":56712},[],"The CRL linked to the authority.",{"_3603":1959,"_31001":1889,"_21481":56714,"_5":14758,"_28188":56548,"_3059":56715},[],"Metadata and the associated cryptographic engine.",{"_3603":1960,"_31001":1889,"_21481":56717,"_5":14758,"_28188":56548,"_3059":56718},[],"You can filter the inventory by name, status and CA type.",{"_3603":1961,"_31001":1889,"_21481":56720,"_5":14758,"_28188":56552,"_3059":56721},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3603":1962,"_31001":1889,"_21481":56723,"_5":14758,"_28188":56552,"_3059":56724},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3603":1963,"_31001":1889,"_21481":56726,"_5":14758,"_28188":56552,"_3059":56727},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3603":1964,"_31001":1889,"_21481":56729,"_5":14758,"_28188":56552,"_3059":56730},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3603":1965,"_31001":1889,"_21481":56732,"_5":14758,"_28188":56552,"_3059":56733},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3603":1966,"_31001":1889,"_21481":56735,"_5":14758,"_28188":56552,"_3059":56736},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3603":1967,"_31001":1889,"_21481":56738,"_5":14758,"_28188":56556,"_3059":56739},[],"Revoking a CA prevents issuance and may interrupt its entire branch. Only `CertificateHold` allows reactivating the CA itself if it is not expired. Descendant revocation is attempted with `CessationOfOperation`; reactivating the parent does not restore those descendants. Follow the cascading revocation conditions.",{"_3603":1968,"_31001":1889,"_21481":56741,"_5":14758,"_28188":56560,"_3059":56742},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3603":1969,"_31001":1889,"_21481":56744,"_5":14758,"_28188":56564,"_3059":56745},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3603":1970,"_31001":1889,"_21481":56747,"_5":14758,"_28188":56568,"_3059":56748},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3603":1971,"_31001":1889,"_21481":56750,"_5":14758,"_28188":56572,"_3059":56751},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3603":1972,"_31001":1889,"_21481":56753,"_5":14758,"_28188":56576,"_3059":56754},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3603":1973,"_31001":1889,"_21481":56756,"_5":14758,"_28188":56576,"_3059":56757},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3603":1974,"_31001":1889,"_21481":56759,"_5":14758,"_28188":56576,"_3059":56760},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3603":1975,"_31001":1889,"_21481":56762,"_5":14758,"_28188":56576,"_3059":56763},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3603":1976,"_31001":1976,"_5":15118,"_3059":56765,"_31339":56766,"_21481":56767,"_28188":1976},"Certificate profiles",[50643,52155,56318,56319],[],{"_3603":1977,"_31001":1976,"_21481":56769,"_5":14758,"_28188":1976,"_3059":56770},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3603":1978,"_31001":1976,"_5":31336,"_21481":56772,"_28188":56773,"_3059":56774},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3603":1979,"_31001":1976,"_5":31336,"_21481":56776,"_28188":56777,"_3059":56778},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3603":1980,"_31001":1976,"_5":31336,"_21481":56780,"_28188":56781,"_3059":56782},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3603":1981,"_31001":1976,"_5":31336,"_21481":56784,"_28188":56785,"_3059":56786},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3603":1982,"_31001":1976,"_5":31336,"_21481":56788,"_28188":56789,"_3059":56790},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3603":1983,"_31001":1976,"_5":31336,"_21481":56792,"_28188":56793,"_3059":56794},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3603":1984,"_31001":1976,"_5":31336,"_21481":56796,"_28188":56797,"_3059":56798},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3603":1985,"_31001":1976,"_5":31336,"_21481":56800,"_28188":56801,"_3059":56802},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3603":1986,"_31001":1976,"_5":31336,"_21481":56804,"_28188":56805,"_3059":56806},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3603":1987,"_31001":1976,"_5":31336,"_21481":56808,"_28188":56809,"_3059":56810},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3603":1988,"_31001":1976,"_5":31336,"_21481":56812,"_28188":56813,"_3059":56814},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3603":1989,"_31001":1976,"_5":31336,"_21481":56816,"_28188":56817,"_3059":56818},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3603":1990,"_31001":1976,"_5":31336,"_21481":56820,"_28188":56821,"_3059":56822},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3603":1991,"_31001":1976,"_5":31336,"_21481":56824,"_28188":56825,"_3059":56826},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3603":1992,"_31001":1976,"_5":31336,"_21481":56828,"_28188":56829,"_3059":56830},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3603":1993,"_31001":1976,"_5":31336,"_21481":56832,"_28188":56833,"_3059":56834},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3603":1994,"_31001":1976,"_21481":56836,"_5":14758,"_28188":1976,"_3059":56837},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3603":1995,"_31001":1976,"_21481":56839,"_5":14758,"_28188":1976,"_3059":56840},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3603":1996,"_31001":1976,"_21481":56842,"_5":14758,"_28188":56777,"_3059":56843},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3603":1997,"_31001":1976,"_21481":56845,"_5":14758,"_28188":56777,"_3059":56846},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3603":1998,"_31001":1976,"_21481":56848,"_5":14758,"_28188":56781,"_3059":56849},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3603":1999,"_31001":1976,"_21481":56851,"_5":14758,"_28188":56785,"_3059":56852},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3603":2000,"_31001":1976,"_21481":56854,"_5":14758,"_28188":56785,"_3059":56855},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3603":2001,"_31001":1976,"_21481":56857,"_5":14758,"_28188":56785,"_3059":56858},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3603":2002,"_31001":1976,"_21481":56860,"_5":14758,"_28188":56789,"_3059":56861},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3603":2003,"_31001":1976,"_21481":56863,"_5":14758,"_28188":56793,"_3059":56864},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3603":2004,"_31001":1976,"_21481":56866,"_5":14758,"_28188":56793,"_3059":56867},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3603":2005,"_31001":1976,"_21481":56869,"_5":14758,"_28188":56797,"_3059":56870},[],"The cryptographic enforcement can:",{"_3603":2006,"_31001":1976,"_21481":56872,"_5":14758,"_28188":56797,"_3059":56873},[],"allow or block RSA keys;",{"_3603":2007,"_31001":1976,"_21481":56875,"_5":14758,"_28188":56797,"_3059":56876},[],"limit the supported RSA sizes;",{"_3603":2008,"_31001":1976,"_21481":56878,"_5":14758,"_28188":56797,"_3059":56879},[],"allow or block ECDSA keys;",{"_3603":2009,"_31001":1976,"_21481":56881,"_5":14758,"_28188":56797,"_3059":56882},[],"limit the supported ECDSA sizes or curves.",{"_3603":2010,"_31001":1976,"_21481":56884,"_5":14758,"_28188":56797,"_3059":56885},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3603":2011,"_31001":1976,"_21481":56887,"_5":14758,"_28188":56801,"_3059":56888},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3603":2012,"_31001":1976,"_21481":56890,"_5":14758,"_28188":56801,"_3059":54080},[],{"_3603":2013,"_31001":1976,"_21481":56892,"_5":14758,"_28188":56801,"_3059":56893},[],"First choice",{"_3603":2014,"_31001":1976,"_21481":56895,"_5":14758,"_28188":56801,"_3059":56896},[],"Second choice",{"_3603":2015,"_31001":1976,"_21481":56898,"_5":14758,"_28188":56801,"_3059":56899},[],"If neither is supplied",{"_3603":2016,"_31001":1976,"_21481":56901,"_5":14758,"_28188":56801,"_3059":56902},[],"Direct signing with a CA",{"_3603":2017,"_31001":1976,"_21481":56904,"_5":14758,"_28188":56801,"_3059":56905},[],"`issuance_profile` embedded in the request",{"_3603":2018,"_31001":1976,"_21481":56907,"_5":14758,"_28188":56801,"_3059":56908},[],"Request `issuance_profile_id`",{"_3603":2019,"_31001":1976,"_21481":56910,"_5":14758,"_28188":56801,"_3059":56911},[],"CA default profile (`profile_id`).",{"_3603":2020,"_31001":1976,"_21481":56913,"_5":14758,"_28188":56801,"_3059":56914},[],"Issuance through a DMS",{"_3603":2021,"_31001":1976,"_21481":56916,"_5":14758,"_28188":56801,"_3059":56917},[],"`settings.issuance_profile_id`",{"_3603":2022,"_31001":1976,"_21481":56919,"_5":14758,"_28188":56801,"_3059":56920},[],"`settings.issuance_profile` embedded in the DMS",{"_3603":2023,"_31001":1976,"_21481":56922,"_5":14758,"_28188":56801,"_3059":56923},[],"Enrollment CA default profile.",{"_3603":2024,"_31001":1976,"_21481":56925,"_5":14758,"_28188":56801,"_3059":56926},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3603":2025,"_31001":1976,"_21481":56928,"_5":14758,"_28188":56801,"_3059":56929},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3603":2026,"_31001":1976,"_21481":56931,"_5":14758,"_28188":56809,"_3059":56932},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3603":2027,"_31001":1976,"_21481":56934,"_5":14758,"_28188":56813,"_3059":56935},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3603":2028,"_31001":1976,"_21481":56937,"_5":14758,"_28188":56817,"_3059":56938},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3603":2029,"_31001":1976,"_21481":56940,"_5":14758,"_28188":56821,"_3059":56941},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3603":2030,"_31001":1976,"_21481":56943,"_5":14758,"_28188":56825,"_3059":56944},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3603":2031,"_31001":1976,"_21481":56946,"_5":14758,"_28188":56825,"_3059":56947},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3603":2032,"_31001":1976,"_21481":56949,"_5":14758,"_28188":56829,"_3059":56950},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3603":2033,"_31001":1976,"_21481":56952,"_5":14758,"_28188":56829,"_3059":56953},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3603":2034,"_31001":1976,"_21481":56955,"_5":14758,"_28188":56829,"_3059":56956},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3603":2035,"_31001":1976,"_21481":56958,"_5":14758,"_28188":56829,"_3059":56959},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3603":2036,"_31001":1976,"_21481":56961,"_5":14758,"_28188":56833,"_3059":56962},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3603":2037,"_31001":1976,"_21481":56964,"_5":14758,"_28188":56833,"_3059":56965},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3603":2038,"_31001":2038,"_5":15118,"_3059":56967,"_31339":56968,"_21481":56970,"_28188":2038},"Certificate validation",[50643,52155,56318,56969],"Validation",[],{"_3603":2039,"_31001":2038,"_21481":56972,"_5":14758,"_28188":2038,"_3059":56973},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3603":2040,"_31001":2038,"_5":31336,"_21481":56975,"_28188":56976,"_3059":56977},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3603":2041,"_31001":2038,"_5":31336,"_21481":56979,"_28188":56980,"_3059":56981},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3603":2042,"_31001":2038,"_5":31336,"_21481":56983,"_28188":56984,"_3059":56985},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3603":2043,"_31001":2038,"_21481":56987,"_5":14758,"_28188":2038,"_3059":56988},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3603":2044,"_31001":2038,"_21481":56990,"_5":14758,"_28188":56976,"_3059":56991},[],"Verify these criteria together:",{"_3603":2045,"_31001":2038,"_21481":56993,"_5":14758,"_28188":56976,"_3059":55944},[],{"_3603":2046,"_31001":2038,"_21481":56995,"_5":14758,"_28188":56976,"_3059":56996},[],"Required result",{"_3603":2047,"_31001":2038,"_21481":56998,"_5":14758,"_28188":56976,"_3059":56999},[],"Chain and signature",{"_3603":2048,"_31001":2038,"_21481":57001,"_5":14758,"_28188":56976,"_3059":57002},[],"Valid chain to a root deliberately installed in the consumer.",{"_3603":2049,"_31001":2038,"_21481":57004,"_5":14758,"_28188":56976,"_3059":57005},[],"Dates",{"_3603":2050,"_31001":2038,"_21481":57007,"_5":14758,"_28188":56976,"_3059":57008},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3603":2051,"_31001":2038,"_21481":57010,"_5":14758,"_28188":56976,"_3059":51824},[],{"_3603":2052,"_31001":2038,"_21481":57012,"_5":14758,"_28188":56976,"_3059":57013},[],"Name, SAN or identifier matches the expected peer.",{"_3603":2053,"_31001":2038,"_21481":57015,"_5":14758,"_28188":56976,"_3059":51033},[],{"_3603":2054,"_31001":2038,"_21481":57017,"_5":14758,"_28188":56976,"_3059":57018},[],"KU, EKU and constraints permit the specific operation.",{"_3603":2055,"_31001":2038,"_21481":57020,"_5":14758,"_28188":56976,"_3059":57021},[],"Revocation",{"_3603":2056,"_31001":2038,"_21481":57023,"_5":14758,"_28188":56976,"_3059":57024},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3603":2057,"_31001":2038,"_21481":57026,"_5":14758,"_28188":56976,"_3059":57027},[],"Authorization",{"_3603":2058,"_31001":2038,"_21481":57029,"_5":14758,"_28188":56976,"_3059":57030},[],"The application permits that identity to perform the action.",{"_3603":2059,"_31001":2038,"_21481":57032,"_5":14758,"_28188":56976,"_3059":57033},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3603":2060,"_31001":2038,"_21481":57035,"_5":14758,"_28188":56980,"_3059":57036},[],"Mechanism",{"_3603":2061,"_31001":2038,"_21481":57038,"_5":14758,"_28188":56980,"_3059":57039},[],"When to use it",{"_3603":2062,"_31001":2038,"_21481":57041,"_5":14758,"_28188":56980,"_3059":57042},[],"What you must maintain",{"_3603":2063,"_31001":2038,"_21481":57044,"_5":14758,"_28188":56980,"_3059":57045},[],"OCSP",{"_3603":2064,"_31001":2038,"_21481":57047,"_5":14758,"_28188":56980,"_3059":57048},[],"Status query for a specific certificate.",{"_3603":2065,"_31001":2038,"_21481":57050,"_5":14758,"_28188":56980,"_3059":57051},[],"Responder access, signature verification and cache/freshness policy.",{"_3603":2066,"_31001":2038,"_21481":57053,"_5":14758,"_28188":56980,"_3059":57054},[],"CRL",{"_3603":2067,"_31001":2038,"_21481":57056,"_5":14758,"_28188":56980,"_3059":57057},[],"Local checks for many certificates or offline operation.",{"_3603":2068,"_31001":2038,"_21481":57059,"_5":14758,"_28188":56980,"_3059":57060},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3603":2069,"_31001":2038,"_21481":57062,"_5":14758,"_28188":56980,"_3059":57063},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3603":2070,"_31001":2038,"_21481":57065,"_5":14758,"_28188":56980,"_3059":57066},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3603":2071,"_31001":2038,"_21481":57068,"_5":14758,"_28188":56984,"_3059":57069},[],"Accept a current, authorized certificate with a known chain.",{"_3603":2072,"_31001":2038,"_21481":57071,"_5":14758,"_28188":56984,"_3059":57072},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3603":2073,"_31001":2038,"_21481":57074,"_5":14758,"_28188":56984,"_3059":57075},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3603":2074,"_31001":2038,"_21481":57077,"_5":14758,"_28188":56984,"_3059":57078},[],"Check that a new connection with that identity is rejected.",{"_3603":2075,"_31001":2038,"_21481":57080,"_5":14758,"_28188":56984,"_3059":57081},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3603":2076,"_31001":2038,"_21481":57083,"_5":14758,"_28188":56984,"_3059":57084},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3603":2077,"_31001":2038,"_21481":57086,"_5":14758,"_28188":56984,"_3059":57087},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3603":2078,"_31001":2038,"_21481":57089,"_5":14758,"_28188":56984,"_3059":57090},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":2079,"_31001":2038,"_21481":57092,"_5":14758,"_28188":56984,"_3059":57093},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3603":2080,"_31001":2080,"_5":15118,"_3059":57095,"_31339":57096,"_21481":57097,"_28188":2080},"Certificates",[50643,52155,56318,56319],[],{"_3603":2081,"_31001":2080,"_21481":57099,"_5":14758,"_28188":2080,"_3059":57100},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3603":2082,"_31001":2080,"_5":31336,"_21481":57102,"_28188":57103,"_3059":57104},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3603":2083,"_31001":2080,"_5":31336,"_21481":57106,"_28188":57107,"_3059":57108},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3603":2084,"_31001":2080,"_5":31336,"_21481":57110,"_28188":57111,"_3059":57112},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3603":2085,"_31001":2080,"_5":31336,"_21481":57114,"_28188":57115,"_3059":57116},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3603":2086,"_31001":2080,"_5":31336,"_21481":57118,"_28188":57119,"_3059":57120},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3603":2087,"_31001":2080,"_5":31336,"_21481":57122,"_28188":57123,"_3059":57124},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3603":2088,"_31001":2080,"_5":31336,"_21481":57126,"_28188":57127,"_3059":57128},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3603":2089,"_31001":2080,"_5":31336,"_21481":57130,"_28188":57131,"_3059":57132},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3603":2090,"_31001":2080,"_5":31336,"_21481":57134,"_28188":57135,"_3059":57136},[],"/docs/platform/pki/certificates#continue","Continue",{"_3603":2091,"_31001":2080,"_21481":57138,"_5":14758,"_28188":2080,"_3059":57139},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3603":2092,"_31001":2080,"_21481":57141,"_5":14758,"_28188":57103,"_3059":57142},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3603":2093,"_31001":2080,"_21481":57144,"_5":14758,"_28188":57103,"_3059":57145},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3603":2094,"_31001":2080,"_21481":57147,"_5":14758,"_28188":57103,"_3059":57148},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3603":2095,"_31001":2080,"_21481":57150,"_5":14758,"_28188":57103,"_3059":57151},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3603":2096,"_31001":2080,"_21481":57153,"_5":14758,"_28188":57103,"_3059":57154},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3603":2097,"_31001":2080,"_21481":57156,"_5":14758,"_28188":57103,"_3059":57157},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3603":2098,"_31001":2080,"_21481":57159,"_5":14758,"_28188":57103,"_3059":57160},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3603":2099,"_31001":2080,"_21481":57162,"_5":14758,"_28188":57107,"_3059":57163},[],"Download the PEM and inspect it:",{"_3603":2100,"_31001":2080,"_21481":57165,"_5":14758,"_28188":57107,"_3059":57166},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3603":2101,"_31001":2080,"_21481":57168,"_5":14758,"_28188":57111,"_3059":57169},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3603":2102,"_31001":2080,"_21481":57171,"_5":14758,"_28188":57111,"_3059":57172},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3603":2103,"_31001":2080,"_21481":57174,"_5":14758,"_28188":57111,"_3059":57175},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3603":2104,"_31001":2080,"_21481":57177,"_5":14758,"_28188":57111,"_3059":57178},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3603":2105,"_31001":2080,"_21481":57180,"_5":14758,"_28188":57111,"_3059":57181},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3603":2106,"_31001":2080,"_21481":57183,"_5":14758,"_28188":57111,"_3059":57184},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3603":2107,"_31001":2080,"_21481":57186,"_5":14758,"_28188":57111,"_3059":57187},[],"For browser key generation, follow Issue your first certificate.",{"_3603":2108,"_31001":2080,"_21481":57189,"_5":14758,"_28188":57115,"_3059":57190},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3603":2109,"_31001":2080,"_21481":57192,"_5":14758,"_28188":57119,"_3059":57193},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3603":2110,"_31001":2080,"_21481":57195,"_5":14758,"_28188":57123,"_3059":57196},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3603":2111,"_31001":2080,"_21481":57198,"_5":14758,"_28188":57127,"_3059":57199},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3603":2112,"_31001":2080,"_21481":57201,"_5":14758,"_28188":57127,"_3059":57202},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3603":2113,"_31001":2080,"_21481":57204,"_5":14758,"_28188":57127,"_3059":57205},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3603":2114,"_31001":2080,"_21481":57207,"_5":14758,"_28188":57131,"_3059":57208},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3603":2115,"_31001":2080,"_21481":57210,"_5":14758,"_28188":57131,"_3059":57211},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3603":2116,"_31001":2080,"_21481":57213,"_5":14758,"_28188":57131,"_3059":57214},[],"This does not undo permanent revocation or a cascade started by revoking a CA.",{"_3603":2117,"_31001":2080,"_21481":57216,"_5":14758,"_28188":57135,"_3059":57217},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":2118,"_31001":2080,"_21481":57219,"_5":14758,"_28188":57135,"_3059":57220},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3603":2119,"_31001":2119,"_5":15118,"_3059":57222,"_31339":57223,"_21481":57225,"_28188":2119},"Certificate lifecycle",[50643,52155,56318,57224],"Concepts",[],{"_3603":2120,"_31001":2119,"_21481":57227,"_5":14758,"_28188":2119,"_3059":57228},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3603":2121,"_31001":2119,"_5":31336,"_21481":57230,"_28188":57231,"_3059":57232},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3603":2122,"_31001":2119,"_5":31336,"_21481":57234,"_28188":57235,"_3059":57236},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3603":2123,"_31001":2119,"_5":31336,"_21481":57238,"_28188":57239,"_3059":57240},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3603":2124,"_31001":2119,"_5":31336,"_21481":57242,"_28188":57243,"_3059":57244},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3603":2125,"_31001":2119,"_5":31336,"_21481":57246,"_28188":57247,"_3059":57248},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3603":2126,"_31001":2119,"_5":31336,"_21481":57250,"_28188":57251,"_3059":57252},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3603":2127,"_31001":2119,"_5":31336,"_21481":57254,"_28188":57255,"_3059":57256},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3603":2128,"_31001":2119,"_5":31336,"_21481":57258,"_28188":57259,"_3059":57260},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3603":2129,"_31001":2119,"_5":31336,"_21481":57262,"_28188":57263,"_3059":57264},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3603":2130,"_31001":2119,"_5":31336,"_21481":57266,"_28188":57267,"_3059":57268},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3603":2131,"_31001":2119,"_21481":57270,"_5":14758,"_28188":2119,"_3059":57271},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3603":2132,"_31001":2119,"_21481":57273,"_5":14758,"_28188":57235,"_3059":57274},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3603":2133,"_31001":2119,"_21481":57276,"_5":14758,"_28188":57239,"_3059":57277},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3603":2134,"_31001":2119,"_21481":57279,"_5":14758,"_28188":57243,"_3059":57280},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3603":2135,"_31001":2119,"_21481":57282,"_5":14758,"_28188":57247,"_3059":57283},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3603":2136,"_31001":2119,"_21481":57285,"_5":14758,"_28188":57251,"_3059":57286},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3603":2137,"_31001":2119,"_21481":57288,"_5":14758,"_28188":57255,"_3059":57289},[],"Lamassu persists four X.509 states:",{"_3603":2138,"_31001":2119,"_21481":57291,"_5":14758,"_28188":57255,"_3059":57292},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3603":2139,"_31001":2119,"_21481":57294,"_5":14758,"_28188":57255,"_3059":57295},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3603":2140,"_31001":2119,"_21481":57297,"_5":14758,"_28188":57255,"_3059":57298},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3603":2141,"_31001":2119,"_21481":57300,"_5":14758,"_28188":57255,"_3059":57301},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3603":2142,"_31001":2119,"_21481":57303,"_5":14758,"_28188":57255,"_3059":57304},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3603":2143,"_31001":2119,"_21481":57306,"_5":14758,"_28188":57259,"_3059":57307},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3603":2144,"_31001":2119,"_21481":57309,"_5":14758,"_28188":57259,"_3059":57310},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3603":2145,"_31001":2119,"_21481":57312,"_5":14758,"_28188":57259,"_3059":57313},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3603":2146,"_31001":2119,"_21481":57315,"_5":14758,"_28188":57263,"_3059":57316},[],"Revoking a CA starts a cascade that attempts to revoke descendants with `CessationOfOperation`. It may end with partial failures and is not undone by reactivating the parent. Read Hierarchy and rotation for conditions and checks.",{"_3603":2147,"_31001":2119,"_21481":57318,"_5":14758,"_28188":57263,"_3059":57319},[],"Before confirming:",{"_3603":2148,"_31001":2119,"_21481":57321,"_5":14758,"_28188":57263,"_3059":57322},[],"Identify DMSs, devices and services that trust that chain.",{"_3603":2149,"_31001":2119,"_21481":57324,"_5":14758,"_28188":57263,"_3059":57325},[],"Distribute the new chain of trust.",{"_3603":2150,"_31001":2119,"_21481":57327,"_5":14758,"_28188":57263,"_3059":57328},[],"Reissue the necessary identities.",{"_3603":2151,"_31001":2119,"_21481":57330,"_5":14758,"_28188":57263,"_3059":57331},[],"Check OCSP and CRL from a real consumer.",{"_3603":2152,"_31001":2119,"_21481":57333,"_5":14758,"_28188":57263,"_3059":57334},[],"Revoke the old CA once no legitimate traffic remains.",{"_3603":2153,"_31001":2119,"_21481":57336,"_5":14758,"_28188":57263,"_3059":57337},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3603":2154,"_31001":2119,"_21481":57339,"_5":14758,"_28188":57267,"_3059":57340},[],"Certificates entering the preventive or critical renewal window.",{"_3603":2155,"_31001":2119,"_21481":57342,"_5":14758,"_28188":57267,"_3059":57343},[],"Repeated enrollment or re-enrollment failures.",{"_3603":2156,"_31001":2119,"_21481":57345,"_5":14758,"_28188":57267,"_3059":57346},[],"Status changes and revocation reasons.",{"_3603":2157,"_31001":2119,"_21481":57348,"_5":14758,"_28188":57267,"_3059":57349},[],"OCSP and CRL publication and validity.",{"_3603":2158,"_31001":2119,"_21481":57351,"_5":14758,"_28188":57267,"_3059":57352},[],"Dependencies still presenting a replaced certificate.",{"_3603":2159,"_31001":2119,"_21481":57354,"_5":14758,"_28188":57267,"_3059":57355},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3603":2160,"_31001":2160,"_5":15118,"_3059":57357,"_31339":57358,"_21481":57359,"_28188":2160},"Trust model",[50643,52155,56318,57224],[],{"_3603":2161,"_31001":2160,"_21481":57361,"_5":14758,"_28188":2160,"_3059":57362},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3603":2162,"_31001":2160,"_5":31336,"_21481":57364,"_28188":57365,"_3059":57366},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3603":2163,"_31001":2160,"_5":31336,"_21481":57368,"_28188":57369,"_3059":57370},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3603":2164,"_31001":2160,"_5":31336,"_21481":57372,"_28188":57373,"_3059":57374},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3603":2165,"_31001":2160,"_5":31336,"_21481":57376,"_28188":57377,"_3059":57378},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3603":2166,"_31001":2160,"_5":31336,"_21481":57380,"_28188":57381,"_3059":57382},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3603":2167,"_31001":2160,"_5":31336,"_21481":57384,"_28188":57385,"_3059":57386},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3603":2168,"_31001":2160,"_5":31336,"_21481":57388,"_28188":57389,"_3059":57390},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3603":2169,"_31001":2160,"_5":31336,"_21481":57392,"_28188":57393,"_3059":57394},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3603":2170,"_31001":2160,"_5":31336,"_21481":57396,"_28188":57397,"_3059":57398},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3603":2171,"_31001":2160,"_5":31336,"_21481":57400,"_28188":57401,"_3059":57402},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3603":2172,"_31001":2160,"_21481":57404,"_5":14758,"_28188":2160,"_3059":57405},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3603":2173,"_31001":2160,"_21481":57407,"_5":14758,"_28188":57369,"_3059":57408},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3603":2174,"_31001":2160,"_21481":57410,"_5":14758,"_28188":57373,"_3059":57411},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3603":2175,"_31001":2160,"_21481":57413,"_5":14758,"_28188":57377,"_3059":57414},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3603":2176,"_31001":2160,"_21481":57416,"_5":14758,"_28188":57381,"_3059":57417},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3603":2177,"_31001":2160,"_21481":57419,"_5":14758,"_28188":57385,"_3059":57420},[],"The device proves it can enroll according to the DMS policy.",{"_3603":2178,"_31001":2160,"_21481":57422,"_5":14758,"_28188":57385,"_3059":57423},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3603":2179,"_31001":2160,"_21481":57425,"_5":14758,"_28188":57385,"_3059":57426},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3603":2180,"_31001":2160,"_21481":57428,"_5":14758,"_28188":57385,"_3059":57429},[],"The device installs the certificate and the chain it needs.",{"_3603":2181,"_31001":2160,"_21481":57431,"_5":14758,"_28188":57385,"_3059":57432},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3603":2182,"_31001":2160,"_21481":57434,"_5":14758,"_28188":57385,"_3059":57435},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3603":2183,"_31001":2160,"_21481":57437,"_5":14758,"_28188":57389,"_3059":57438},[],"A DMS relates three sets that are worth designing separately:",{"_3603":2184,"_31001":2160,"_21481":57440,"_5":14758,"_28188":57389,"_3059":57441},[],"**Enrollment CA:** signs the new identities.",{"_3603":2185,"_31001":2160,"_21481":57443,"_5":14758,"_28188":57389,"_3059":57444},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3603":2186,"_31001":2160,"_21481":57446,"_5":14758,"_28188":57389,"_3059":57447},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3603":2187,"_31001":2160,"_21481":57449,"_5":14758,"_28188":57389,"_3059":57450},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3603":2188,"_31001":2160,"_21481":57452,"_5":14758,"_28188":57393,"_3059":57453},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3603":2189,"_31001":2160,"_21481":57455,"_5":14758,"_28188":57393,"_3059":57456},[],"that the current date is between `Not Before` and `Not After`;",{"_3603":2190,"_31001":2160,"_21481":57458,"_5":14758,"_28188":57393,"_3059":57459},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3603":2191,"_31001":2160,"_21481":57461,"_5":14758,"_28188":57393,"_3059":57462},[],"that names, SANs and subject match the expected identity;",{"_3603":2192,"_31001":2160,"_21481":57464,"_5":14758,"_28188":57393,"_3059":57465},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3603":2193,"_31001":2160,"_21481":57467,"_5":14758,"_28188":57393,"_3059":57468},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3603":2194,"_31001":2160,"_21481":57470,"_5":14758,"_28188":57393,"_3059":57471},[],"During the mTLS authentication of a DMS, Lamassu attempts to check revocation. If the certificate does not contain enough information to perform that check, the backend logs a warning and continues treating it as not revoked. Design your profiles and distribution points to avoid that situation in production.",{"_3603":2195,"_31001":2160,"_21481":57473,"_5":14758,"_28188":57397,"_3059":57474},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3603":2196,"_31001":2160,"_21481":57476,"_5":14758,"_28188":57401,"_3059":57477},[],"Keep the root out of daily operations, or with very restricted access.",{"_3603":2197,"_31001":2160,"_21481":57479,"_5":14758,"_28188":57401,"_3059":57480},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3603":2198,"_31001":2160,"_21481":57482,"_5":14758,"_28188":57401,"_3059":57483},[],"Assign explicit profiles to every use case.",{"_3603":2199,"_31001":2160,"_21481":57485,"_5":14758,"_28188":57401,"_3059":57486},[],"Distribute the new trust before starting a rotation.",{"_3603":2200,"_31001":2160,"_21481":57488,"_5":14758,"_28188":57401,"_3059":57489},[],"Keep enough overlap to renew a disconnected fleet.",{"_3603":2201,"_31001":2160,"_21481":57491,"_5":14758,"_28188":57401,"_3059":57492},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3603":2202,"_31001":2160,"_21481":57494,"_5":14758,"_28188":57401,"_3059":57495},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3603":2203,"_31001":2203,"_5":15118,"_3059":57497,"_31339":57498,"_21481":57499,"_28188":2203},"Revocation lists (CRL)",[50643,52155,56318,56969],[],{"_3603":2204,"_31001":2203,"_21481":57501,"_5":14758,"_28188":2203,"_3059":57502},[],"Generate and distribute signed lists to validate certificates offline.",{"_3603":2205,"_31001":2203,"_5":31336,"_21481":57504,"_28188":57505,"_3059":57506},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3603":2206,"_31001":2203,"_5":31336,"_21481":57508,"_28188":57509,"_3059":57510},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3603":2207,"_31001":2203,"_5":31336,"_21481":57512,"_28188":57513,"_3059":57514},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3603":2208,"_31001":2203,"_5":31336,"_21481":57516,"_28188":57517,"_3059":57518},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3603":2209,"_31001":2203,"_5":31336,"_21481":57520,"_28188":57521,"_3059":57522},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3603":2210,"_31001":2203,"_5":31336,"_21481":57524,"_28188":57525,"_3059":57526},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3603":2211,"_31001":2203,"_5":31336,"_21481":57528,"_28188":57529,"_3059":57530},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3603":2212,"_31001":2203,"_5":31336,"_21481":57532,"_28188":57533,"_3059":57534},[],"/docs/platform/pki/crl#references","References",{"_3603":2213,"_31001":2203,"_21481":57536,"_5":14758,"_28188":2203,"_3059":57537},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3603":2214,"_31001":2203,"_21481":57539,"_5":14758,"_28188":57505,"_3059":57540},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3603":2215,"_31001":2203,"_21481":57542,"_5":14758,"_28188":57505,"_3059":57543},[],"Field",{"_3603":2216,"_31001":2203,"_21481":57545,"_5":14758,"_28188":57505,"_3059":51033},[],{"_3603":2217,"_31001":2203,"_21481":57547,"_5":14758,"_28188":57505,"_3059":52275},[],{"_3603":2218,"_31001":2203,"_21481":57549,"_5":14758,"_28188":57505,"_3059":57550},[],"ID of the CA the settings belong to.",{"_3603":2219,"_31001":2203,"_21481":57552,"_5":14758,"_28188":57505,"_3059":57553},[],"`status`",{"_3603":2220,"_31001":2203,"_21481":57555,"_5":14758,"_28188":57505,"_3059":57556},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3603":2221,"_31001":2203,"_21481":57558,"_5":14758,"_28188":57505,"_3059":57559},[],"`legacy_ski`",{"_3603":2222,"_31001":2203,"_21481":57561,"_5":14758,"_28188":57505,"_3059":57562},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3603":2223,"_31001":2203,"_21481":57564,"_5":14758,"_28188":57505,"_3059":57565},[],"`latest_crl`",{"_3603":2224,"_31001":2203,"_21481":57567,"_5":14758,"_28188":57505,"_3059":57568},[],"Version, validity start and end of the last published list. Read-only.",{"_3603":2225,"_31001":2203,"_21481":57570,"_5":14758,"_28188":57505,"_3059":57571},[],"`crl_options` field",{"_3603":2226,"_31001":2203,"_21481":57573,"_5":14758,"_28188":57505,"_3059":51033},[],{"_3603":2227,"_31001":2203,"_21481":57575,"_5":14758,"_28188":57505,"_3059":57576},[],"Initial value",{"_3603":2228,"_31001":2203,"_21481":57578,"_5":14758,"_28188":57505,"_3059":57579},[],"`validity`",{"_3603":2229,"_31001":2203,"_21481":57581,"_5":14758,"_28188":57505,"_3059":57582},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3603":2230,"_31001":2203,"_21481":57584,"_5":14758,"_28188":57505,"_3059":57585},[],"7 days.",{"_3603":2231,"_31001":2203,"_21481":57587,"_5":14758,"_28188":57505,"_3059":57588},[],"`refresh_interval`",{"_3603":2232,"_31001":2203,"_21481":57590,"_5":14758,"_28188":57505,"_3059":57591},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3603":2233,"_31001":2203,"_21481":57593,"_5":14758,"_28188":57505,"_3059":57594},[],"6 days and 23 hours.",{"_3603":2234,"_31001":2203,"_21481":57596,"_5":14758,"_28188":57505,"_3059":57597},[],"`regenerate_on_revoke`",{"_3603":2235,"_31001":2203,"_21481":57599,"_5":14758,"_28188":57505,"_3059":57600},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3603":2236,"_31001":2203,"_21481":57602,"_5":14758,"_28188":57505,"_3059":57603},[],"`true`.",{"_3603":2237,"_31001":2203,"_21481":57605,"_5":14758,"_28188":57505,"_3059":57606},[],"`signer_serial_number`",{"_3603":2238,"_31001":2203,"_21481":57608,"_5":14758,"_28188":57505,"_3059":57609},[],"Serial number of the existing certificate that signs the CRL.",{"_3603":2239,"_31001":2203,"_21481":57611,"_5":14758,"_28188":57505,"_3059":57612},[],"Serial number of the CA’s current certificate.",{"_3603":2240,"_31001":2203,"_21481":57614,"_5":14758,"_28188":57505,"_3059":57615},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3603":2241,"_31001":2203,"_21481":57617,"_5":14758,"_28188":57505,"_3059":57618},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3603":2242,"_31001":2203,"_21481":57620,"_5":14758,"_28188":57505,"_3059":57621},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3603":2243,"_31001":2203,"_21481":57623,"_5":14758,"_28188":57505,"_3059":57624},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3603":2244,"_31001":2203,"_21481":57626,"_5":14758,"_28188":57505,"_3059":57627},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3603":2245,"_31001":2203,"_21481":57629,"_5":14758,"_28188":57505,"_3059":57630},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3603":2246,"_31001":2203,"_21481":57632,"_5":14758,"_28188":57505,"_3059":57633},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3603":2247,"_31001":2203,"_21481":57635,"_5":14758,"_28188":57505,"_3059":57636},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3603":2248,"_31001":2203,"_21481":57638,"_5":14758,"_28188":57505,"_3059":57639},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3603":2249,"_31001":2203,"_21481":57641,"_5":14758,"_28188":57505,"_3059":57642},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3603":2250,"_31001":2203,"_21481":57644,"_5":14758,"_28188":57505,"_3059":57645},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3603":2251,"_31001":2203,"_21481":57647,"_5":14758,"_28188":57509,"_3059":57648},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3603":2252,"_31001":2203,"_21481":57650,"_5":14758,"_28188":57509,"_3059":57651},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3603":2253,"_31001":2203,"_21481":57653,"_5":14758,"_28188":57509,"_3059":57654},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3603":2254,"_31001":2203,"_21481":57656,"_5":14758,"_28188":57509,"_3059":57657},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3603":2255,"_31001":2203,"_21481":57659,"_5":14758,"_28188":57513,"_3059":57660},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3603":2256,"_31001":2203,"_21481":57662,"_5":14758,"_28188":57513,"_3059":57663},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3603":2257,"_31001":2203,"_21481":57665,"_5":14758,"_28188":57513,"_3059":57666},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3603":2258,"_31001":2203,"_21481":57668,"_5":14758,"_28188":57513,"_3059":57669},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3603":2259,"_31001":2203,"_21481":57671,"_5":14758,"_28188":57513,"_3059":57672},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3603":2260,"_31001":2203,"_21481":57674,"_5":14758,"_28188":57513,"_3059":57675},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3603":2261,"_31001":2203,"_21481":57677,"_5":14758,"_28188":57513,"_3059":57678},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3603":2262,"_31001":2203,"_21481":57680,"_5":14758,"_28188":57513,"_3059":57681},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3603":2263,"_31001":2203,"_21481":57683,"_5":14758,"_28188":57513,"_3059":57684},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3603":2264,"_31001":2203,"_21481":57686,"_5":14758,"_28188":57517,"_3059":57687},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3603":2265,"_31001":2203,"_21481":57689,"_5":14758,"_28188":57517,"_3059":57690},[],"The list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with configured distribution URLs. Check that your client interprets this extension and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3603":2266,"_31001":2203,"_21481":57692,"_5":14758,"_28188":57521,"_3059":57693},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3603":2267,"_31001":2203,"_21481":57695,"_5":14758,"_28188":57521,"_3059":57696},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3603":2268,"_31001":2203,"_21481":57698,"_5":14758,"_28188":57521,"_3059":57699},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3603":2269,"_31001":2203,"_21481":57701,"_5":14758,"_28188":57521,"_3059":57702},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3603":2270,"_31001":2203,"_21481":57704,"_5":14758,"_28188":57521,"_3059":57705},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3603":2271,"_31001":2203,"_21481":57707,"_5":14758,"_28188":57525,"_3059":57708},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3603":2272,"_31001":2203,"_21481":57710,"_5":14758,"_28188":57525,"_3059":54083},[],{"_3603":2273,"_31001":2203,"_21481":57712,"_5":14758,"_28188":57525,"_3059":57713},[],"Relative path",{"_3603":2274,"_31001":2203,"_21481":57715,"_5":14758,"_28188":57525,"_3059":54080},[],{"_3603":2275,"_31001":2203,"_21481":57717,"_5":14758,"_28188":57525,"_3059":57718},[],"`GET`",{"_3603":2276,"_31001":2203,"_21481":57720,"_5":14758,"_28188":57525,"_3059":57721},[],"`/v1/crl-settings`",{"_3603":2277,"_31001":2203,"_21481":57723,"_5":14758,"_28188":57525,"_3059":57724},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3603":2278,"_31001":2203,"_21481":57726,"_5":14758,"_28188":57525,"_3059":57718},[],{"_3603":2279,"_31001":2203,"_21481":57728,"_5":14758,"_28188":57525,"_3059":57729},[],"`/v1/crl-settings/{ca-id}`",{"_3603":2280,"_31001":2203,"_21481":57731,"_5":14758,"_28188":57525,"_3059":57732},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3603":2281,"_31001":2203,"_21481":57734,"_5":14758,"_28188":57525,"_3059":57735},[],"`PUT`",{"_3603":2282,"_31001":2203,"_21481":57737,"_5":14758,"_28188":57525,"_3059":57729},[],{"_3603":2283,"_31001":2203,"_21481":57739,"_5":14758,"_28188":57525,"_3059":57740},[],"Replace the CRL configuration of a CA.",{"_3603":2284,"_31001":2203,"_21481":57742,"_5":14758,"_28188":57525,"_3059":57743},[],"`DELETE`",{"_3603":2285,"_31001":2203,"_21481":57745,"_5":14758,"_28188":57525,"_3059":57729},[],{"_3603":2286,"_31001":2203,"_21481":57747,"_5":14758,"_28188":57525,"_3059":57748},[],"Remove the archived CRL settings of a CA.",{"_3603":2287,"_31001":2203,"_21481":57750,"_5":14758,"_28188":57525,"_3059":57751},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3603":2288,"_31001":2203,"_21481":57753,"_5":14758,"_28188":57525,"_3059":57754},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3603":2289,"_31001":2203,"_21481":57756,"_5":14758,"_28188":57525,"_3059":57757},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3603":2290,"_31001":2203,"_21481":57759,"_5":14758,"_28188":57529,"_3059":57760},[],"Symptom",{"_3603":2291,"_31001":2203,"_21481":57762,"_5":14758,"_28188":57529,"_3059":57763},[],"Cause",{"_3603":2292,"_31001":2203,"_21481":57765,"_5":14758,"_28188":57529,"_3059":57766},[],"Action",{"_3603":2293,"_31001":2203,"_21481":57768,"_5":14758,"_28188":57529,"_3059":57769},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3603":2294,"_31001":2203,"_21481":57771,"_5":14758,"_28188":57529,"_3059":57772},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3603":2295,"_31001":2203,"_21481":57774,"_5":14758,"_28188":57529,"_3059":57775},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3603":2296,"_31001":2203,"_21481":57777,"_5":14758,"_28188":57529,"_3059":57778},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3603":2297,"_31001":2203,"_21481":57780,"_5":14758,"_28188":57529,"_3059":57781},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3603":2298,"_31001":2203,"_21481":57783,"_5":14758,"_28188":57529,"_3059":57784},[],"Delete the CA first; deleting it archives its settings.",{"_3603":2299,"_31001":2203,"_21481":57786,"_5":14758,"_28188":57529,"_3059":57787},[],"`PUT` returns 400.",{"_3603":2300,"_31001":2203,"_21481":57789,"_5":14758,"_28188":57529,"_3059":57790},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3603":2301,"_31001":2203,"_21481":57792,"_5":14758,"_28188":57529,"_3059":57793},[],"Set the serial number of a valid certificate of that CA.",{"_3603":2302,"_31001":2203,"_21481":57795,"_5":14758,"_28188":57529,"_3059":57796},[],"`PUT` returns 404.",{"_3603":2303,"_31001":2203,"_21481":57798,"_5":14758,"_28188":57529,"_3059":57799},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3603":2304,"_31001":2203,"_21481":57801,"_5":14758,"_28188":57529,"_3059":57802},[],"Check the CA ID and the signer serial number.",{"_3603":2305,"_31001":2203,"_21481":57804,"_5":14758,"_28188":57529,"_3059":57805},[],"`PUT` returns 400 from a 3.x client.",{"_3603":2306,"_31001":2203,"_21481":57807,"_5":14758,"_28188":57529,"_3059":57808},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3603":2307,"_31001":2203,"_21481":57810,"_5":14758,"_28188":57529,"_3059":57811},[],"Update the client to send the new field.",{"_3603":2308,"_31001":2203,"_21481":57813,"_5":14758,"_28188":57529,"_3059":57814},[],"The CRL does not change after revoking a certificate.",{"_3603":2309,"_31001":2203,"_21481":57816,"_5":14758,"_28188":57529,"_3059":57817},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3603":2310,"_31001":2203,"_21481":57819,"_5":14758,"_28188":57529,"_3059":57820},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3603":2311,"_31001":2203,"_21481":57822,"_5":14758,"_28188":57529,"_3059":57823},[],"A verifier rejects the CRL because of the issuer.",{"_3603":2312,"_31001":2203,"_21481":57825,"_5":14758,"_28188":57529,"_3059":57826},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3603":2313,"_31001":2203,"_21481":57828,"_5":14758,"_28188":57529,"_3059":57829},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3603":2314,"_31001":2203,"_21481":57831,"_5":14758,"_28188":57533,"_3059":57832},[],"RFC 5280: X.509 and CRL profile.",{"_3603":2315,"_31001":2203,"_21481":57834,"_5":14758,"_28188":57533,"_3059":57835},[],"OpenSSL: openssl-crl.",{"_3603":2316,"_31001":2203,"_21481":57837,"_5":14758,"_28188":57533,"_3059":57838},[],"OpenSSL: openssl-verify.",{"_3603":2317,"_31001":2203,"_21481":57840,"_5":14758,"_28188":57533,"_3059":57841},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3603":2318,"_31001":2203,"_21481":57843,"_5":14758,"_28188":57533,"_3059":57844},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3603":2319,"_31001":2319,"_5":15118,"_3059":57846,"_31339":57847,"_21481":57848,"_28188":2319},"Keys and cryptographic engines",[50643,52155,56318,56319],[],{"_3603":2320,"_31001":2319,"_21481":57850,"_5":14758,"_28188":2319,"_3059":57851},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3603":2321,"_31001":2319,"_5":31336,"_21481":57853,"_28188":57854,"_3059":57855},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3603":2322,"_31001":2319,"_5":31336,"_21481":57857,"_28188":57858,"_3059":57859},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3603":2323,"_31001":2319,"_5":31336,"_21481":57861,"_28188":57862,"_3059":57863},[],"/docs/platform/pki/key-management#file-system","File System",{"_3603":2324,"_31001":2319,"_5":31336,"_21481":57865,"_28188":57866,"_3059":57867},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3603":2325,"_31001":2319,"_5":31336,"_21481":57869,"_28188":57870,"_3059":57871},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3603":2326,"_31001":2319,"_5":31336,"_21481":57873,"_28188":57874,"_3059":57875},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3603":2327,"_31001":2319,"_5":31336,"_21481":57877,"_28188":57878,"_3059":57879},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3603":2328,"_31001":2319,"_5":31336,"_21481":57881,"_28188":57882,"_3059":57883},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3603":2329,"_31001":2319,"_5":31336,"_21481":57885,"_28188":57886,"_3059":57887},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3603":2330,"_31001":2319,"_5":31336,"_21481":57889,"_28188":57890,"_3059":57891},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3603":2331,"_31001":2319,"_5":31336,"_21481":57893,"_28188":57894,"_3059":57895},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3603":2332,"_31001":2319,"_5":31336,"_21481":57897,"_28188":57898,"_3059":57899},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3603":2333,"_31001":2319,"_5":31336,"_21481":57901,"_28188":57902,"_3059":57903},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3603":2334,"_31001":2319,"_5":31336,"_21481":57905,"_28188":57906,"_3059":57907},[],"/docs/platform/pki/key-management#view-details","View details",{"_3603":2335,"_31001":2319,"_5":31336,"_21481":57909,"_28188":57910,"_3059":57911},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3603":2336,"_31001":2319,"_5":31336,"_21481":57913,"_28188":57914,"_3059":57915},[],"/docs/platform/pki/key-management#sign","Sign",{"_3603":2337,"_31001":2319,"_5":31336,"_21481":57917,"_28188":57918,"_3059":57919},[],"/docs/platform/pki/key-management#verify","Verify",{"_3603":2338,"_31001":2319,"_5":31336,"_21481":57921,"_28188":57922,"_3059":57923},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3603":2339,"_31001":2319,"_5":31336,"_21481":57925,"_28188":57926,"_3059":57927},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3603":2340,"_31001":2319,"_5":31336,"_21481":57929,"_28188":57930,"_3059":57931},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3603":2341,"_31001":2319,"_21481":57933,"_5":14758,"_28188":2319,"_3059":57934},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3603":2342,"_31001":2319,"_21481":57936,"_5":14758,"_28188":2319,"_3059":57937},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3603":2343,"_31001":2319,"_21481":57939,"_5":14758,"_28188":57854,"_3059":57940},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3603":2344,"_31001":2319,"_21481":57942,"_5":14758,"_28188":57854,"_3059":57943},[],"In practice, it lets you:",{"_3603":2345,"_31001":2319,"_21481":57945,"_5":14758,"_28188":57854,"_3059":57946},[],"Generate new key pairs from Lamassu IoT.",{"_3603":2346,"_31001":2319,"_21481":57948,"_5":14758,"_28188":57854,"_3059":57949},[],"Import keys created externally.",{"_3603":2347,"_31001":2319,"_21481":57951,"_5":14758,"_28188":57854,"_3059":57952},[],"Delegate custody and cryptographic operations to external engines.",{"_3603":2348,"_31001":2319,"_21481":57954,"_5":14758,"_28188":57854,"_3059":57955},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3603":2349,"_31001":2319,"_21481":57957,"_5":14758,"_28188":57858,"_3059":57958},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3603":2350,"_31001":2319,"_21481":57960,"_5":14758,"_28188":57858,"_3059":57961},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3603":2351,"_31001":2319,"_21481":57963,"_5":14758,"_28188":57858,"_3059":57964},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3603":2352,"_31001":2319,"_21481":57966,"_5":14758,"_28188":57862,"_3059":57967},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3603":2353,"_31001":2319,"_21481":57969,"_5":14758,"_28188":57866,"_3059":57970},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3603":2354,"_31001":2319,"_21481":57972,"_5":14758,"_28188":57866,"_3059":57973},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3603":2355,"_31001":2319,"_21481":57975,"_5":14758,"_28188":57870,"_3059":57976},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3603":2356,"_31001":2319,"_21481":57978,"_5":14758,"_28188":57874,"_3059":57979},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3603":2357,"_31001":2319,"_21481":57981,"_5":14758,"_28188":57878,"_3059":57982},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3603":2358,"_31001":2319,"_21481":57984,"_5":14758,"_28188":57882,"_3059":57985},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3603":2359,"_31001":2319,"_21481":57987,"_5":14758,"_28188":57882,"_3059":57988},[],"Lamassu shows the enabled engines in the console.",{"_3603":2360,"_31001":2319,"_21481":57990,"_5":14758,"_28188":57882,"_3059":57991},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3603":2361,"_31001":2319,"_21481":57993,"_5":14758,"_28188":57882,"_3059":57994},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3603":2362,"_31001":2319,"_21481":57996,"_5":14758,"_28188":57886,"_3059":57997},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3603":2363,"_31001":2319,"_21481":57999,"_5":14758,"_28188":57886,"_3059":58000},[],"The table includes the following fields:",{"_3603":2364,"_31001":2319,"_21481":58002,"_5":14758,"_28188":57886,"_3059":58003},[],"**Name**: descriptive name of the key.",{"_3603":2365,"_31001":2319,"_21481":58005,"_5":14758,"_28188":57886,"_3059":58006},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3603":2366,"_31001":2319,"_21481":58008,"_5":14758,"_28188":57886,"_3059":58009},[],"**Strength**: visual indicator of cryptographic strength.",{"_3603":2367,"_31001":2319,"_21481":58011,"_5":14758,"_28188":57886,"_3059":58012},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3603":2368,"_31001":2319,"_21481":58014,"_5":14758,"_28188":57886,"_3059":58015},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3603":2369,"_31001":2319,"_21481":58017,"_5":14758,"_28188":57886,"_3059":58018},[],"**Aliases**: alternative names associated with the key.",{"_3603":2370,"_31001":2319,"_21481":58020,"_5":14758,"_28188":57886,"_3059":58021},[],"**Tags**: labels for classification and search.",{"_3603":2371,"_31001":2319,"_21481":58023,"_5":14758,"_28188":57886,"_3059":58024},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3603":2372,"_31001":2319,"_21481":58026,"_5":14758,"_28188":57886,"_3059":58027},[],"From this view you also reach the most common actions:",{"_3603":2373,"_31001":2319,"_21481":58029,"_5":14758,"_28188":57886,"_3059":58030},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3603":2374,"_31001":2319,"_21481":58032,"_5":14758,"_28188":57886,"_3059":58033},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3603":2375,"_31001":2319,"_21481":58035,"_5":14758,"_28188":57886,"_3059":58036},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3603":2376,"_31001":2319,"_21481":58038,"_5":14758,"_28188":57886,"_3059":58039},[],"**Delete Key** to remove the key from the system.",{"_3603":2377,"_31001":2319,"_21481":58041,"_5":14758,"_28188":57890,"_3059":58042},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3603":2378,"_31001":2319,"_21481":58044,"_5":14758,"_28188":57894,"_3059":58045},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3603":2379,"_31001":2319,"_21481":58047,"_5":14758,"_28188":57894,"_3059":58048},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3603":2380,"_31001":2319,"_21481":58050,"_5":14758,"_28188":57894,"_3059":58051},[],"**Key Name**: unique and descriptive name.",{"_3603":2381,"_31001":2319,"_21481":58053,"_5":14758,"_28188":57894,"_3059":58054},[],"**Crypto Engine**: engine that will keep the key.",{"_3603":2382,"_31001":2319,"_21481":58056,"_5":14758,"_28188":57894,"_3059":58057},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3603":2383,"_31001":2319,"_21481":58059,"_5":14758,"_28188":57894,"_3059":58060},[],"**Tags**: metadata to classify the key.",{"_3603":2384,"_31001":2319,"_21481":58062,"_5":14758,"_28188":57894,"_3059":58063},[],"**Metadata**: additional information for advanced uses.",{"_3603":2385,"_31001":2319,"_21481":58065,"_5":14758,"_28188":57898,"_3059":58066},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3603":2386,"_31001":2319,"_21481":58068,"_5":14758,"_28188":57898,"_3059":58069},[],"When you have an exportable private key and the destination engine supports import.",{"_3603":2387,"_31001":2319,"_21481":58071,"_5":14758,"_28188":57898,"_3059":58072},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3603":2388,"_31001":2319,"_21481":58074,"_5":14758,"_28188":57898,"_3059":58075},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3603":2389,"_31001":2319,"_21481":58077,"_5":14758,"_28188":57898,"_3059":58078},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3603":2390,"_31001":2319,"_21481":58080,"_5":14758,"_28188":57898,"_3059":58081},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3603":2391,"_31001":2319,"_21481":58083,"_5":14758,"_28188":57898,"_3059":58084},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3603":2392,"_31001":2319,"_21481":58086,"_5":14758,"_28188":57898,"_3059":58087},[],"**Tags**: labels for organization and search.",{"_3603":2393,"_31001":2319,"_21481":58089,"_5":14758,"_28188":57898,"_3059":58090},[],"**Metadata**: additional optional information.",{"_3603":2394,"_31001":2319,"_21481":58092,"_5":14758,"_28188":57898,"_3059":58093},[],"**Private Key (PEM)**: private key in PEM format.",{"_3603":2395,"_31001":2319,"_21481":58095,"_5":14758,"_28188":57898,"_3059":58096},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3603":2396,"_31001":2319,"_21481":58098,"_5":14758,"_28188":57902,"_3059":58099},[],"Each registered key has a detail view and several operational actions.",{"_3603":2397,"_31001":2319,"_21481":58101,"_5":14758,"_28188":57906,"_3059":58102},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3603":2398,"_31001":2319,"_21481":58104,"_5":14758,"_28188":57906,"_3059":58105},[],"The **Overview** tab shows, among others, these fields:",{"_3603":2399,"_31001":2319,"_21481":58107,"_5":14758,"_28188":57906,"_3059":58108},[],"**Key Name**: descriptive name.",{"_3603":2400,"_31001":2319,"_21481":58110,"_5":14758,"_28188":57906,"_3059":58111},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3603":2401,"_31001":2319,"_21481":58113,"_5":14758,"_28188":57906,"_3059":58114},[],"**Tags**: associated labels.",{"_3603":2402,"_31001":2319,"_21481":58116,"_5":14758,"_28188":57906,"_3059":58117},[],"**Aliases**: alternative names.",{"_3603":2403,"_31001":2319,"_21481":58119,"_5":14758,"_28188":57906,"_3059":58120},[],"**Crypto Engine**: engine where the key resides.",{"_3603":2404,"_31001":2319,"_21481":58122,"_5":14758,"_28188":57906,"_3059":58123},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3603":2405,"_31001":2319,"_21481":58125,"_5":14758,"_28188":57906,"_3059":58126},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3603":2406,"_31001":2319,"_21481":58128,"_5":14758,"_28188":57906,"_3059":58129},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3603":2407,"_31001":2319,"_21481":58131,"_5":14758,"_28188":57910,"_3059":58132},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3603":2408,"_31001":2319,"_21481":58134,"_5":14758,"_28188":57910,"_3059":58135},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3603":2409,"_31001":2319,"_21481":58137,"_5":14758,"_28188":57910,"_3059":58138},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3603":2410,"_31001":2319,"_21481":58140,"_5":14758,"_28188":57914,"_3059":58141},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3603":2411,"_31001":2319,"_21481":58143,"_5":14758,"_28188":57914,"_3059":58144},[],"Main fields:",{"_3603":2412,"_31001":2319,"_21481":58146,"_5":14758,"_28188":57914,"_3059":58147},[],"**Algorithm**: signing algorithm available for the key type.",{"_3603":2413,"_31001":2319,"_21481":58149,"_5":14758,"_28188":57914,"_3059":58150},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3603":2414,"_31001":2319,"_21481":58152,"_5":14758,"_28188":57914,"_3059":58153},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3603":2415,"_31001":2319,"_21481":58155,"_5":14758,"_28188":57914,"_3059":58156},[],"**Message**: content to sign.",{"_3603":2416,"_31001":2319,"_21481":58158,"_5":14758,"_28188":57914,"_3059":58159},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3603":2417,"_31001":2319,"_21481":58161,"_5":14758,"_28188":57918,"_3059":58162},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3603":2418,"_31001":2319,"_21481":58164,"_5":14758,"_28188":57918,"_3059":58144},[],{"_3603":2419,"_31001":2319,"_21481":58166,"_5":14758,"_28188":57918,"_3059":58167},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3603":2420,"_31001":2319,"_21481":58169,"_5":14758,"_28188":57918,"_3059":58170},[],"**Message Type**: `Raw` or `Digest`.",{"_3603":2421,"_31001":2319,"_21481":58172,"_5":14758,"_28188":57918,"_3059":58173},[],"**Payload Encoding**: encoding of the message.",{"_3603":2422,"_31001":2319,"_21481":58175,"_5":14758,"_28188":57918,"_3059":58176},[],"**Message**: original message or hash.",{"_3603":2423,"_31001":2319,"_21481":58178,"_5":14758,"_28188":57918,"_3059":58179},[],"**Signature**: signature to check.",{"_3603":2424,"_31001":2319,"_21481":58181,"_5":14758,"_28188":57918,"_3059":58182},[],"**Result**: indicator of the validation result.",{"_3603":2425,"_31001":2319,"_21481":58184,"_5":14758,"_28188":57922,"_3059":58185},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3603":2426,"_31001":2319,"_21481":58187,"_5":14758,"_28188":57922,"_3059":58188},[],"This flow is useful for:",{"_3603":2427,"_31001":2319,"_21481":58190,"_5":14758,"_28188":57922,"_3059":58191},[],"Requesting certificates from an external CA.",{"_3603":2428,"_31001":2319,"_21481":58193,"_5":14758,"_28188":57922,"_3059":58194},[],"Renewing an identity while keeping the same key.",{"_3603":2429,"_31001":2319,"_21481":58196,"_5":14758,"_28188":57922,"_3059":58197},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3603":2430,"_31001":2319,"_21481":58199,"_5":14758,"_28188":57922,"_3059":58200},[],"**Common Name (CN)**: main name of the identity.",{"_3603":2431,"_31001":2319,"_21481":58202,"_5":14758,"_28188":57922,"_3059":58203},[],"**Organization (O)**: organization or company.",{"_3603":2432,"_31001":2319,"_21481":58205,"_5":14758,"_28188":57922,"_3059":58206},[],"**Organizational Unit (OU)**: department or unit.",{"_3603":2433,"_31001":2319,"_21481":58208,"_5":14758,"_28188":57922,"_3059":58209},[],"**Country (C)**: two-letter country code.",{"_3603":2434,"_31001":2319,"_21481":58211,"_5":14758,"_28188":57922,"_3059":58212},[],"**State / Province (ST)**: state or province.",{"_3603":2435,"_31001":2319,"_21481":58214,"_5":14758,"_28188":57922,"_3059":58215},[],"**Locality (L)**: city or locality.",{"_3603":2436,"_31001":2319,"_21481":58217,"_5":14758,"_28188":57922,"_3059":58218},[],"**Email Address**: contact email.",{"_3603":2437,"_31001":2319,"_21481":58220,"_5":14758,"_28188":57922,"_3059":58221},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3603":2438,"_31001":2319,"_21481":58223,"_5":14758,"_28188":57922,"_3059":58224},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3603":2439,"_31001":2319,"_21481":58226,"_5":14758,"_28188":57926,"_3059":58227},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3603":2440,"_31001":2319,"_21481":58229,"_5":14758,"_28188":57926,"_3059":58230},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3603":2441,"_31001":2319,"_21481":58232,"_5":14758,"_28188":57930,"_3059":58233},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3603":2442,"_31001":2319,"_21481":58235,"_5":14758,"_28188":57930,"_3059":58236},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3603":2443,"_31001":2443,"_5":15118,"_3059":58238,"_31339":58239,"_21481":58240,"_28188":2443},"Online validation with OCSP",[50643,52155,56318,56969],[],{"_3603":2444,"_31001":2443,"_21481":58242,"_5":14758,"_28188":2443,"_3059":58243},[],"Query signed status and verify the responder’s response.",{"_3603":2445,"_31001":2443,"_5":31336,"_21481":58245,"_28188":58246,"_3059":58247},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3603":2446,"_31001":2443,"_5":31336,"_21481":58249,"_28188":58250,"_3059":58251},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3603":2447,"_31001":2443,"_5":31336,"_21481":58253,"_28188":58254,"_3059":58255},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3603":2448,"_31001":2443,"_5":31336,"_21481":58257,"_28188":58258,"_3059":58259},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3603":2449,"_31001":2443,"_5":31336,"_21481":58261,"_28188":58262,"_3059":58263},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3603":2450,"_31001":2443,"_5":31336,"_21481":58265,"_28188":58266,"_3059":57534},[],"/docs/platform/pki/ocsp#references",{"_3603":2451,"_31001":2443,"_21481":58268,"_5":14758,"_28188":2443,"_3059":58269},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3603":2452,"_31001":2443,"_21481":58271,"_5":14758,"_28188":58246,"_3059":58272},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3603":2453,"_31001":2443,"_21481":58274,"_5":14758,"_28188":58246,"_3059":58275},[],"Record status",{"_3603":2454,"_31001":2443,"_21481":58277,"_5":14758,"_28188":58246,"_3059":58278},[],"Signed response",{"_3603":2455,"_31001":2443,"_21481":58280,"_5":14758,"_28188":58246,"_3059":55455},[],{"_3603":2456,"_31001":2443,"_21481":58282,"_5":14758,"_28188":58246,"_3059":58283},[],"`Good`.",{"_3603":2457,"_31001":2443,"_21481":58285,"_5":14758,"_28188":58246,"_3059":55472},[],{"_3603":2458,"_31001":2443,"_21481":58287,"_5":14758,"_28188":58246,"_3059":58288},[],"`Revoked`, with revocation reason and timestamp.",{"_3603":2459,"_31001":2443,"_21481":58290,"_5":14758,"_28188":58246,"_3059":58291},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3603":2460,"_31001":2443,"_21481":58293,"_5":14758,"_28188":58246,"_3059":58294},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3603":2461,"_31001":2443,"_21481":58296,"_5":14758,"_28188":58246,"_3059":58297},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3603":2462,"_31001":2443,"_21481":58299,"_5":14758,"_28188":58246,"_3059":58300},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3603":2463,"_31001":2443,"_21481":58302,"_5":14758,"_28188":58246,"_3059":58303},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3603":2464,"_31001":2443,"_21481":58305,"_5":14758,"_28188":58250,"_3059":58306},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3603":2465,"_31001":2443,"_21481":58308,"_5":14758,"_28188":58250,"_3059":58309},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3603":2466,"_31001":2443,"_21481":58311,"_5":14758,"_28188":58254,"_3059":58312},[],"The service accepts:",{"_3603":2467,"_31001":2443,"_21481":58314,"_5":14758,"_28188":58254,"_3059":54083},[],{"_3603":2468,"_31001":2443,"_21481":58316,"_5":14758,"_28188":58254,"_3059":58317},[],"VA service path",{"_3603":2469,"_31001":2443,"_21481":58319,"_5":14758,"_28188":58254,"_3059":58320},[],"Format",{"_3603":2470,"_31001":2443,"_21481":58322,"_5":14758,"_28188":58254,"_3059":58323},[],"`POST`",{"_3603":2471,"_31001":2443,"_21481":58325,"_5":14758,"_28188":58254,"_3059":58326},[],"`/ocsp`",{"_3603":2472,"_31001":2443,"_21481":58328,"_5":14758,"_28188":58254,"_3059":58329},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3603":2473,"_31001":2443,"_21481":58331,"_5":14758,"_28188":58254,"_3059":57718},[],{"_3603":2474,"_31001":2443,"_21481":58333,"_5":14758,"_28188":58254,"_3059":58334},[],"`/ocsp/{ocsp_request}`",{"_3603":2475,"_31001":2443,"_21481":58336,"_5":14758,"_28188":58254,"_3059":58337},[],"DER request encoded using padded URL Base64.",{"_3603":2476,"_31001":2443,"_21481":58339,"_5":14758,"_28188":58254,"_3059":58340},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3603":2477,"_31001":2443,"_21481":58342,"_5":14758,"_28188":58258,"_3059":58343},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3603":2478,"_31001":2443,"_21481":58345,"_5":14758,"_28188":58258,"_3059":58346},[],"Generate the request:",{"_3603":2479,"_31001":2443,"_21481":58348,"_5":14758,"_28188":58258,"_3059":58349},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3603":2480,"_31001":2443,"_21481":58351,"_5":14758,"_28188":58258,"_3059":58352},[],"Replace the example URL with the inspected endpoint:",{"_3603":2481,"_31001":2443,"_21481":58354,"_5":14758,"_28188":58258,"_3059":58355},[],"Verify the returned DER:",{"_3603":2482,"_31001":2443,"_21481":58357,"_5":14758,"_28188":58258,"_3059":58358},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3603":2483,"_31001":2443,"_21481":58360,"_5":14758,"_28188":58262,"_3059":58361},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3603":2484,"_31001":2443,"_21481":58363,"_5":14758,"_28188":58262,"_3059":58364},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3603":2485,"_31001":2443,"_21481":58366,"_5":14758,"_28188":58266,"_3059":58367},[],"RFC 6960: OCSP.",{"_3603":2486,"_31001":2443,"_21481":58369,"_5":14758,"_28188":58266,"_3059":58370},[],"OpenSSL: openssl-ocsp.",{"_3603":2487,"_31001":2443,"_21481":58372,"_5":14758,"_28188":58266,"_3059":58373},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3603":2488,"_31001":2443,"_21481":58375,"_5":14758,"_28188":58266,"_3059":57844},[],{"_3603":2489,"_31001":2489,"_5":15118,"_3059":56318,"_31339":58377,"_21481":58378,"_28188":2489},[50643,52155,56318],[],{"_3603":2490,"_31001":2489,"_21481":58380,"_5":14758,"_28188":2489,"_3059":58381},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3603":2491,"_31001":2489,"_5":31336,"_21481":58383,"_28188":58384,"_3059":55630},[],"/docs/platform/pki/overview#start-here",{"_3603":2492,"_31001":2489,"_5":31336,"_21481":58386,"_28188":58387,"_3059":58388},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3603":2493,"_31001":2489,"_5":31336,"_21481":58390,"_28188":58391,"_3059":56162},[],"/docs/platform/pki/overview#core-capabilities",{"_3603":2494,"_31001":2489,"_5":31336,"_21481":58393,"_28188":58394,"_3059":56166},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3603":2495,"_31001":2489,"_5":31336,"_21481":58396,"_28188":58397,"_3059":56170},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3603":2496,"_31001":2489,"_5":31336,"_21481":58399,"_28188":58400,"_3059":56174},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3603":2497,"_31001":2489,"_5":31336,"_21481":58402,"_28188":58403,"_3059":56182},[],"/docs/platform/pki/overview#publish-validation-status",{"_3603":2498,"_31001":2489,"_5":31336,"_21481":58405,"_28188":58406,"_3059":58407},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3603":2499,"_31001":2489,"_5":31336,"_21481":58409,"_28188":58410,"_3059":57136},[],"/docs/platform/pki/overview#continue",{"_3603":2500,"_31001":2489,"_21481":58412,"_5":14758,"_28188":2489,"_3059":58413},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3603":2501,"_31001":2489,"_21481":58415,"_5":14758,"_28188":58384,"_3059":58416},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3603":2502,"_31001":2489,"_21481":58418,"_5":14758,"_28188":58384,"_3059":58419},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3603":2503,"_31001":2489,"_21481":58421,"_5":14758,"_28188":58387,"_3059":58422},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3603":2504,"_31001":2489,"_21481":58424,"_5":14758,"_28188":58387,"_3059":58425},[],"An available cryptographic engine to keep the authority's key.",{"_3603":2505,"_31001":2489,"_21481":58427,"_5":14758,"_28188":58387,"_3059":58428},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3603":2506,"_31001":2489,"_21481":58430,"_5":14758,"_28188":58387,"_3059":58431},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3603":2507,"_31001":2489,"_21481":58433,"_5":14758,"_28188":58387,"_3059":58434},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3603":2508,"_31001":2489,"_21481":58436,"_5":14758,"_28188":58394,"_3059":58437},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3603":2509,"_31001":2489,"_21481":58439,"_5":14758,"_28188":58397,"_3059":58440},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3603":2510,"_31001":2489,"_21481":58442,"_5":14758,"_28188":58400,"_3059":58443},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3603":2511,"_31001":2489,"_21481":58445,"_5":14758,"_28188":58403,"_3059":58446},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3603":2512,"_31001":2489,"_21481":58448,"_5":14758,"_28188":58406,"_3059":58449},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3603":2513,"_31001":2489,"_21481":58451,"_5":14758,"_28188":58406,"_3059":58452},[],"its subject and extensions identify the expected client;",{"_3603":2514,"_31001":2489,"_21481":58454,"_5":14758,"_28188":58406,"_3059":58455},[],"its public key matches the client's private key;",{"_3603":2515,"_31001":2489,"_21481":58457,"_5":14758,"_28188":58406,"_3059":58458},[],"its chain reaches a root trusted by the consumer;",{"_3603":2516,"_31001":2489,"_21481":58460,"_5":14758,"_28188":58406,"_3059":58461},[],"its dates and usages allow the operation;",{"_3603":2517,"_31001":2489,"_21481":58463,"_5":14758,"_28188":58406,"_3059":58464},[],"the consumer applies revocation checks and authorization.",{"_3603":2518,"_31001":2489,"_21481":58466,"_5":14758,"_28188":58406,"_3059":58467},[],"The issuance path includes the first independent checks.",{"_3603":2519,"_31001":2489,"_21481":58469,"_5":14758,"_28188":58410,"_3059":58470},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3603":2520,"_31001":2489,"_21481":58472,"_5":14758,"_28188":58410,"_3059":58473},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3603":2521,"_31001":2489,"_21481":58475,"_5":14758,"_28188":58410,"_3059":58476},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3603":2522,"_31001":2522,"_5":15118,"_3059":58478,"_31339":58479,"_21481":58480,"_28188":2522},"Create your first CA",[50643,52155,56318,55755],[],{"_3603":2523,"_31001":2522,"_21481":58482,"_5":14758,"_28188":2522,"_3059":58483},[],"Create an evaluation root and check its certificate before issuing.",{"_3603":2524,"_31001":2522,"_5":31336,"_21481":58485,"_28188":58486,"_3059":50653},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3603":2525,"_31001":2522,"_5":31336,"_21481":58488,"_28188":58489,"_3059":58490},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3603":2526,"_31001":2522,"_5":31336,"_21481":58492,"_28188":58493,"_3059":58494},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3603":2527,"_31001":2522,"_5":31336,"_21481":58496,"_28188":58497,"_3059":58498},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3603":2528,"_31001":2522,"_5":31336,"_21481":58500,"_28188":58501,"_3059":58502},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3603":2529,"_31001":2522,"_5":31336,"_21481":58504,"_28188":58505,"_3059":58506},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3603":2530,"_31001":2522,"_5":31336,"_21481":58508,"_28188":58509,"_3059":58510},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3603":2531,"_31001":2522,"_5":31336,"_21481":58512,"_28188":58513,"_3059":56012},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3603":2532,"_31001":2522,"_5":31336,"_21481":58515,"_28188":58516,"_3059":50677},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3603":2533,"_31001":2522,"_21481":58518,"_5":14758,"_28188":2522,"_3059":58519},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3603":2534,"_31001":2522,"_21481":58521,"_5":14758,"_28188":58486,"_3059":58522},[],"Console access and permission to create keys and authorities.",{"_3603":2535,"_31001":2522,"_21481":58524,"_5":14758,"_28188":58486,"_3059":58525},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3603":2536,"_31001":2522,"_21481":58527,"_5":14758,"_28188":58486,"_3059":58528},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3603":2537,"_31001":2522,"_21481":58530,"_5":14758,"_28188":58486,"_3059":58531},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3603":2538,"_31001":2522,"_21481":58533,"_5":14758,"_28188":58489,"_3059":58534},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3603":2539,"_31001":2522,"_21481":58536,"_5":14758,"_28188":58489,"_3059":58537},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3603":2540,"_31001":2522,"_21481":58539,"_5":14758,"_28188":58493,"_3059":58540},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3603":2541,"_31001":2522,"_21481":58542,"_5":14758,"_28188":58493,"_3059":58543},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3603":2542,"_31001":2522,"_21481":58545,"_5":14758,"_28188":58497,"_3059":58546},[],"Select **Root CA** and complete:",{"_3603":2543,"_31001":2522,"_21481":58548,"_5":14758,"_28188":58497,"_3059":58549},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3603":2544,"_31001":2522,"_21481":58551,"_5":14758,"_28188":58497,"_3059":58552},[],"**Subject**: organization and country details for your evaluation.",{"_3603":2545,"_31001":2522,"_21481":58554,"_5":14758,"_28188":58497,"_3059":58555},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3603":2546,"_31001":2522,"_21481":58557,"_5":14758,"_28188":58497,"_3059":58558},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3603":2547,"_31001":2522,"_21481":58560,"_5":14758,"_28188":58497,"_3059":58561},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3603":2548,"_31001":2522,"_21481":58563,"_5":14758,"_28188":58501,"_3059":58564},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3603":2549,"_31001":2522,"_21481":58566,"_5":14758,"_28188":58505,"_3059":58567},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3603":2550,"_31001":2522,"_21481":58569,"_5":14758,"_28188":58505,"_3059":58570},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3603":2551,"_31001":2522,"_21481":58572,"_5":14758,"_28188":58509,"_3059":58573},[],"Run from the directory where you saved `ca.pem`:",{"_3603":2552,"_31001":2522,"_21481":58575,"_5":14758,"_28188":58509,"_3059":58576},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3603":2553,"_31001":2522,"_21481":58578,"_5":14758,"_28188":58509,"_3059":58579},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3603":2554,"_31001":2522,"_21481":58581,"_5":14758,"_28188":58513,"_3059":58582},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3603":2555,"_31001":2522,"_21481":58584,"_5":14758,"_28188":58513,"_3059":58585},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3603":2556,"_31001":2522,"_21481":58587,"_5":14758,"_28188":58513,"_3059":58588},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3603":2557,"_31001":2522,"_21481":58590,"_5":14758,"_28188":58513,"_3059":58591},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3603":2558,"_31001":2522,"_21481":58593,"_5":14758,"_28188":58516,"_3059":58594},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3603":2559,"_31001":2559,"_5":15118,"_3059":58596,"_31339":58597,"_21481":58598,"_28188":2559},"Issue and verify a certificate",[50643,52155,56318,55755],[],{"_3603":2560,"_31001":2559,"_21481":58600,"_5":14758,"_28188":2559,"_3059":58601},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3603":2561,"_31001":2559,"_5":31336,"_21481":58603,"_28188":58604,"_3059":50653},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3603":2562,"_31001":2559,"_5":31336,"_21481":58606,"_28188":58607,"_3059":58608},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3603":2563,"_31001":2559,"_5":31336,"_21481":58610,"_28188":58611,"_3059":58612},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3603":2564,"_31001":2559,"_5":31336,"_21481":58614,"_28188":58615,"_3059":58616},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3603":2565,"_31001":2559,"_5":31336,"_21481":58618,"_28188":58619,"_3059":58620},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3603":2566,"_31001":2559,"_5":31336,"_21481":58622,"_28188":58623,"_3059":58624},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3603":2567,"_31001":2559,"_5":31336,"_21481":58626,"_28188":58627,"_3059":58628},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3603":2568,"_31001":2559,"_5":31336,"_21481":58630,"_28188":58631,"_3059":58632},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3603":2569,"_31001":2559,"_5":31336,"_21481":58634,"_28188":58635,"_3059":58636},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3603":2570,"_31001":2559,"_5":31336,"_21481":58638,"_28188":58639,"_3059":58640},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3603":2571,"_31001":2559,"_5":31336,"_21481":58642,"_28188":58643,"_3059":56012},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3603":2572,"_31001":2559,"_5":31336,"_21481":58645,"_28188":58646,"_3059":50677},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3603":2573,"_31001":2559,"_21481":58648,"_5":14758,"_28188":2559,"_3059":58649},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3603":2574,"_31001":2559,"_21481":58651,"_5":14758,"_28188":58604,"_3059":58652},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3603":2575,"_31001":2559,"_21481":58654,"_5":14758,"_28188":58604,"_3059":58655},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3603":2576,"_31001":2559,"_21481":58657,"_5":14758,"_28188":58604,"_3059":58658},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3603":2577,"_31001":2559,"_21481":58660,"_5":14758,"_28188":58604,"_3059":58661},[],"A client identifier: here we use `device-001`.",{"_3603":2578,"_31001":2559,"_21481":58663,"_5":14758,"_28188":58604,"_3059":58664},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3603":2579,"_31001":2559,"_21481":58666,"_5":14758,"_28188":58607,"_3059":58667},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3603":2580,"_31001":2559,"_21481":58669,"_5":14758,"_28188":58611,"_3059":58670},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3603":2581,"_31001":2559,"_21481":58672,"_5":14758,"_28188":58611,"_3059":58673},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3603":2582,"_31001":2559,"_21481":58675,"_5":14758,"_28188":58615,"_3059":58676},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3603":2583,"_31001":2559,"_21481":58678,"_5":14758,"_28188":58615,"_3059":58679},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3603":2584,"_31001":2559,"_21481":58681,"_5":14758,"_28188":58619,"_3059":58682},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3603":2585,"_31001":2559,"_21481":58684,"_5":14758,"_28188":58619,"_3059":58685},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3603":2586,"_31001":2559,"_21481":58687,"_5":14758,"_28188":58623,"_3059":58688},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3603":2587,"_31001":2559,"_21481":58690,"_5":14758,"_28188":58627,"_3059":58691},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3603":2588,"_31001":2559,"_21481":58693,"_5":14758,"_28188":58631,"_3059":58694},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3603":2589,"_31001":2559,"_21481":58696,"_5":14758,"_28188":58635,"_3059":58697},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3603":2590,"_31001":2559,"_21481":58699,"_5":14758,"_28188":58635,"_3059":58700},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3603":2591,"_31001":2559,"_21481":58702,"_5":14758,"_28188":58635,"_3059":58703},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3603":2592,"_31001":2559,"_21481":58705,"_5":14758,"_28188":58639,"_3059":58706},[],"In Bash, compare the two public-key digests:",{"_3603":2593,"_31001":2559,"_21481":58708,"_5":14758,"_28188":58639,"_3059":58709},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3603":2594,"_31001":2559,"_21481":58711,"_5":14758,"_28188":58639,"_3059":58712},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3603":2595,"_31001":2559,"_21481":58714,"_5":14758,"_28188":58643,"_3059":56096},[],{"_3603":2596,"_31001":2559,"_21481":58716,"_5":14758,"_28188":58643,"_3059":58717},[],"What to review",{"_3603":2597,"_31001":2559,"_21481":58719,"_5":14758,"_28188":58643,"_3059":58720},[],"The CA rejects issuance",{"_3603":2598,"_31001":2559,"_21481":58722,"_5":14758,"_28188":58643,"_3059":58723},[],"Permissions, CA state and key, algorithm and profile.",{"_3603":2599,"_31001":2559,"_21481":58725,"_5":14758,"_28188":58643,"_3059":58726},[],"Different subject or usages",{"_3603":2600,"_31001":2559,"_21481":58728,"_5":14758,"_28188":58643,"_3059":58729},[],"Applied profile and requested values.",{"_3603":2601,"_31001":2559,"_21481":58731,"_5":14758,"_28188":58643,"_3059":58732},[],"Issuer cannot be found",{"_3603":2602,"_31001":2559,"_21481":58734,"_5":14758,"_28188":58643,"_3059":58735},[],"Downloaded CA and required intermediate chain.",{"_3603":2603,"_31001":2559,"_21481":58737,"_5":14758,"_28188":58643,"_3059":58738},[],"Validity fails",{"_3603":2604,"_31001":2559,"_21481":58740,"_5":14758,"_28188":58643,"_3059":58741},[],"Certificate and CA dates, and the computer's clock.",{"_3603":2605,"_31001":2559,"_21481":58743,"_5":14758,"_28188":58643,"_3059":58744},[],"Public-key digests differ",{"_3603":2606,"_31001":2559,"_21481":58746,"_5":14758,"_28188":58643,"_3059":58747},[],"Certificate and key files from the same issuance.",{"_3603":2607,"_31001":2559,"_21481":58749,"_5":14758,"_28188":58643,"_3059":58750},[],"See PKI diagnostics to narrow an issuance failure.",{"_3603":2608,"_31001":2559,"_21481":58752,"_5":14758,"_28188":58646,"_3059":58753},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3603":2609,"_31001":2559,"_21481":58755,"_5":14758,"_28188":58646,"_3059":58756},[],"Manage certificates for inspection, status and revocation.",{"_3603":2610,"_31001":2559,"_21481":58758,"_5":14758,"_28188":58646,"_3059":58759},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3603":2611,"_31001":2559,"_21481":58761,"_5":14758,"_28188":58646,"_3059":58762},[],"Prepare EST for the device to request its next identities.",{"_3603":2612,"_31001":2559,"_21481":58764,"_5":14758,"_28188":58646,"_3059":58765},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3603":2613,"_31001":2613,"_5":15118,"_3059":58767,"_31339":58768,"_21481":58769,"_28188":2613},"PKI getting started",[50643,52155,56318,55755],[],{"_3603":2614,"_31001":2613,"_21481":58771,"_5":14758,"_28188":2613,"_3059":58772},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3603":2615,"_31001":2613,"_5":31336,"_21481":58774,"_28188":58775,"_3059":50653},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3603":2616,"_31001":2613,"_5":31336,"_21481":58777,"_28188":58778,"_3059":58779},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3603":2617,"_31001":2613,"_5":31336,"_21481":58781,"_28188":58782,"_3059":55947},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3603":2618,"_31001":2613,"_5":31336,"_21481":58784,"_28188":58785,"_3059":58786},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3603":2619,"_31001":2613,"_21481":58788,"_5":14758,"_28188":2613,"_3059":58789},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3603":2620,"_31001":2613,"_21481":58791,"_5":14758,"_28188":58775,"_3059":58792},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3603":2621,"_31001":2613,"_21481":58794,"_5":14758,"_28188":58775,"_3059":58795},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3603":2622,"_31001":2613,"_21481":58797,"_5":14758,"_28188":58775,"_3059":58798},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3603":2623,"_31001":2613,"_21481":58800,"_5":14758,"_28188":58775,"_3059":58801},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3603":2624,"_31001":2613,"_21481":58803,"_5":14758,"_28188":58775,"_3059":58804},[],"A working directory with restricted access for the downloaded key.",{"_3603":2625,"_31001":2613,"_21481":58806,"_5":14758,"_28188":58778,"_3059":58807},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3603":2626,"_31001":2613,"_21481":58809,"_5":14758,"_28188":58778,"_3059":58810},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3603":2627,"_31001":2613,"_21481":58812,"_5":14758,"_28188":58778,"_3059":58813},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3603":2628,"_31001":2613,"_21481":58815,"_5":14758,"_28188":58778,"_3059":58816},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3603":2629,"_31001":2613,"_21481":58818,"_5":14758,"_28188":58782,"_3059":58819},[],"File or resource",{"_3603":2630,"_31001":2613,"_21481":58821,"_5":14758,"_28188":58782,"_3059":55944},[],{"_3603":2631,"_31001":2613,"_21481":58823,"_5":14758,"_28188":58782,"_3059":58824},[],"Active root CA and `ca.pem`",{"_3603":2632,"_31001":2613,"_21481":58826,"_5":14758,"_28188":58782,"_3059":58827},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3603":2633,"_31001":2613,"_21481":58829,"_5":14758,"_28188":58782,"_3059":58830},[],"End-entity certificate and `device.crt`",{"_3603":2634,"_31001":2613,"_21481":58832,"_5":14758,"_28188":58782,"_3059":58833},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3603":2635,"_31001":2613,"_21481":58835,"_5":14758,"_28188":58782,"_3059":58836},[],"Private key `device.key`",{"_3603":2636,"_31001":2613,"_21481":58838,"_5":14758,"_28188":58782,"_3059":58839},[],"Its public key matches the one included in `device.crt`.",{"_3603":2637,"_31001":2613,"_21481":58841,"_5":14758,"_28188":58782,"_3059":58842},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3603":2638,"_31001":2613,"_21481":58844,"_5":14758,"_28188":58785,"_3059":58845},[],"To operate certificates, continue with Certificates and Validation.",{"_3603":2639,"_31001":2613,"_21481":58847,"_5":14758,"_28188":58785,"_3059":58848},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3603":2640,"_31001":2613,"_21481":58850,"_5":14758,"_28188":58785,"_3059":58851},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3603":2641,"_31001":2641,"_5":15118,"_3059":58853,"_31339":58854,"_21481":58855,"_28188":2641},"PKI troubleshooting",[50643,52155,56318,54893],[],{"_3603":2642,"_31001":2641,"_21481":58857,"_5":14758,"_28188":2641,"_3059":58858},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3603":2643,"_31001":2641,"_5":31336,"_21481":58860,"_28188":58861,"_3059":58862},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3603":2644,"_31001":2641,"_5":31336,"_21481":58864,"_28188":58865,"_3059":58866},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3603":2645,"_31001":2641,"_5":31336,"_21481":58868,"_28188":58869,"_3059":58870},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3603":2646,"_31001":2641,"_21481":58872,"_5":14758,"_28188":2641,"_3059":58873},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3603":2647,"_31001":2641,"_21481":58875,"_5":14758,"_28188":2641,"_3059":58876},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3603":2648,"_31001":2641,"_21481":58878,"_5":14758,"_28188":58861,"_3059":55944},[],{"_3603":2649,"_31001":2641,"_21481":58880,"_5":14758,"_28188":58861,"_3059":58881},[],"What to inspect",{"_3603":2650,"_31001":2641,"_21481":58883,"_5":14758,"_28188":58861,"_3059":50677},[],{"_3603":2651,"_31001":2641,"_21481":58885,"_5":14758,"_28188":58861,"_3059":55160},[],{"_3603":2652,"_31001":2641,"_21481":58887,"_5":14758,"_28188":58861,"_3059":58888},[],"Exists, is active and has usable dates.",{"_3603":2653,"_31001":2641,"_21481":58890,"_5":14758,"_28188":58861,"_3059":58891},[],"Authorities.",{"_3603":2654,"_31001":2641,"_21481":58893,"_5":14758,"_28188":58861,"_3059":58894},[],"Key",{"_3603":2655,"_31001":2641,"_21481":58896,"_5":14758,"_28188":58861,"_3059":58897},[],"The record has a usable private key and the engine can sign.",{"_3603":2656,"_31001":2641,"_21481":58899,"_5":14758,"_28188":58861,"_3059":58900},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3603":2657,"_31001":2641,"_21481":58902,"_5":14758,"_28188":58861,"_3059":58903},[],"CSR",{"_3603":2658,"_31001":2641,"_21481":58905,"_5":14758,"_28188":58861,"_3059":58906},[],"Correct PEM and verifiable signature.",{"_3603":2659,"_31001":2641,"_21481":58908,"_5":14758,"_28188":58861,"_3059":58909},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3603":2660,"_31001":2641,"_21481":58911,"_5":14758,"_28188":58861,"_3059":58912},[],"Profile",{"_3603":2661,"_31001":2641,"_21481":58914,"_5":14758,"_28188":58861,"_3059":58915},[],"Selected source, existing ID, allowed algorithm and size.",{"_3603":2662,"_31001":2641,"_21481":58917,"_5":14758,"_28188":58861,"_3059":58918},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3603":2663,"_31001":2641,"_21481":58920,"_5":14758,"_28188":58861,"_3059":56096},[],{"_3603":2664,"_31001":2641,"_21481":58922,"_5":14758,"_28188":58861,"_3059":58923},[],"Appropriate subject, SAN, usages and dates.",{"_3603":2665,"_31001":2641,"_21481":58925,"_5":14758,"_28188":58861,"_3059":58926},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3603":2666,"_31001":2641,"_21481":58928,"_5":14758,"_28188":58861,"_3059":58929},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3603":2667,"_31001":2641,"_21481":58931,"_5":14758,"_28188":58861,"_3059":58932},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3603":2668,"_31001":2641,"_21481":58934,"_5":14758,"_28188":58861,"_3059":58935},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3603":2669,"_31001":2641,"_21481":58937,"_5":14758,"_28188":58865,"_3059":58938},[],"Check each boundary independently:",{"_3603":2670,"_31001":2641,"_21481":58940,"_5":14758,"_28188":58865,"_3059":58941},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3603":2671,"_31001":2641,"_21481":58943,"_5":14758,"_28188":58865,"_3059":58944},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3603":2672,"_31001":2641,"_21481":58946,"_5":14758,"_28188":58865,"_3059":58947},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3603":2673,"_31001":2641,"_21481":58949,"_5":14758,"_28188":58865,"_3059":58950},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3603":2674,"_31001":2641,"_21481":58952,"_5":14758,"_28188":58865,"_3059":58953},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3603":2675,"_31001":2641,"_21481":58955,"_5":14758,"_28188":58865,"_3059":58956},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. Reactivating a CA does not restore its descendant cascade; inspect every status and individual operation failure.",{"_3603":2676,"_31001":2641,"_21481":58958,"_5":14758,"_28188":58869,"_3059":58959},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3603":2677,"_31001":2641,"_21481":58961,"_5":14758,"_28188":58869,"_3059":58962},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3603":2678,"_31001":2678,"_5":15118,"_3059":58964,"_31339":58965,"_21481":58966,"_28188":2678},"Security",[50643],[],{"_3603":2679,"_31001":2678,"_21481":58968,"_5":14758,"_28188":2678,"_3059":58969},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3603":2680,"_31001":2678,"_5":31336,"_21481":58971,"_28188":58972,"_3059":58973},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3603":2681,"_31001":2678,"_5":31336,"_21481":58975,"_28188":58976,"_3059":58977},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3603":2682,"_31001":2678,"_5":31336,"_21481":58979,"_28188":58980,"_3059":58981},[],"/docs/security#supported-versions","Supported versions",{"_3603":2683,"_31001":2678,"_5":31336,"_21481":58983,"_28188":58984,"_3059":58985},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3603":2684,"_31001":2678,"_21481":58987,"_5":14758,"_28188":2678,"_3059":58988},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3603":2685,"_31001":2678,"_21481":58990,"_5":14758,"_28188":58972,"_3059":58991},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3603":2686,"_31001":2678,"_21481":58993,"_5":14758,"_28188":58972,"_3059":58994},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3603":2687,"_31001":2678,"_21481":58996,"_5":14758,"_28188":58972,"_3059":15396},[],{"_3603":2688,"_31001":2678,"_21481":58998,"_5":14758,"_28188":58972,"_3059":15325},[],{"_3603":2689,"_31001":2678,"_21481":59000,"_5":14758,"_28188":58972,"_3059":15383},[],{"_3603":2690,"_31001":2678,"_21481":59002,"_5":14758,"_28188":58972,"_3059":59003},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3603":2691,"_31001":2678,"_21481":59005,"_5":14758,"_28188":58972,"_3059":59006},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3603":2692,"_31001":2678,"_21481":59008,"_5":14758,"_28188":58976,"_3059":59009},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3603":2693,"_31001":2678,"_21481":59011,"_5":14758,"_28188":58976,"_3059":59012},[],"Do not include in the report:",{"_3603":2694,"_31001":2678,"_21481":59014,"_5":14758,"_28188":58976,"_3059":59015},[],"Credentials, tokens, or private keys",{"_3603":2695,"_31001":2678,"_21481":59017,"_5":14758,"_28188":58976,"_3059":59018},[],"Customer data or customer-identifiable information",{"_3603":2696,"_31001":2678,"_21481":59020,"_5":14758,"_28188":58976,"_3059":59021},[],"Confidential architecture or internal infrastructure details",{"_3603":2697,"_31001":2678,"_21481":59023,"_5":14758,"_28188":58980,"_3059":59024},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3603":2698,"_31001":2678,"_21481":59026,"_5":14758,"_28188":58980,"_3059":59027},[],"For upgrade guidance, see Upgrades.",{"_3603":2699,"_31001":2678,"_21481":59029,"_5":14758,"_28188":58984,"_3059":59030},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3603":2700,"_31001":2678,"_21481":59032,"_5":14758,"_28188":58984,"_3059":59033},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3603":2701,"_31001":2678,"_21481":59035,"_5":14758,"_28188":58984,"_3059":59036},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3603":2702,"_31001":2678,"_21481":59038,"_5":14758,"_28188":58984,"_3059":59039},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3603":2703,"_31001":2678,"_21481":59041,"_5":14758,"_28188":58984,"_3059":59042},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3603":2704,"_31001":2704,"_5":15118,"_3059":59044,"_31339":59045,"_21481":59047,"_28188":2704},"3.8.0 to 4.0.0",[50643,59046],"Upgrades",[],{"_3603":2705,"_31001":2704,"_21481":59049,"_5":14758,"_28188":2704,"_3059":59050},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3603":2706,"_31001":2704,"_5":31336,"_21481":59052,"_28188":59053,"_3059":59054},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3603":2707,"_31001":2704,"_5":31336,"_21481":59056,"_28188":59057,"_3059":59058},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3603":2708,"_31001":2704,"_5":31336,"_21481":59060,"_28188":59061,"_3059":59062},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3603":2709,"_31001":2704,"_5":31336,"_21481":59064,"_28188":59065,"_3059":59066},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3603":2710,"_31001":2704,"_5":31336,"_21481":59068,"_28188":59069,"_3059":59070},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3603":2711,"_31001":2704,"_5":31336,"_21481":59072,"_28188":59073,"_3059":59074},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3603":2712,"_31001":2704,"_5":31336,"_21481":59076,"_28188":59077,"_3059":59078},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3603":2713,"_31001":2704,"_5":31336,"_21481":59080,"_28188":59081,"_3059":59082},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3603":2714,"_31001":2704,"_5":31336,"_21481":59084,"_28188":59085,"_3059":59086},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3603":2715,"_31001":2704,"_5":31336,"_21481":59088,"_28188":59089,"_3059":59090},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3603":2716,"_31001":2704,"_5":31336,"_21481":59092,"_28188":59093,"_3059":51281},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3603":2717,"_31001":2704,"_5":31336,"_21481":59095,"_28188":59096,"_3059":59097},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3603":2718,"_31001":2704,"_5":31336,"_21481":59099,"_28188":59100,"_3059":59101},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3603":2719,"_31001":2704,"_5":31336,"_21481":59103,"_28188":59104,"_3059":59105},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3603":2720,"_31001":2704,"_5":31336,"_21481":59107,"_28188":59108,"_3059":59109},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3603":2721,"_31001":2704,"_5":31336,"_21481":59111,"_28188":59112,"_3059":59113},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3603":2722,"_31001":2704,"_5":31336,"_21481":59115,"_28188":59116,"_3059":59117},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3603":2723,"_31001":2704,"_5":31336,"_21481":59119,"_28188":59120,"_3059":59121},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3603":2724,"_31001":2704,"_5":31336,"_21481":59123,"_28188":59124,"_3059":59125},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3603":2725,"_31001":2704,"_5":31336,"_21481":59127,"_28188":59128,"_3059":59129},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3603":2726,"_31001":2704,"_5":31336,"_21481":59131,"_28188":59132,"_3059":59133},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3603":2727,"_31001":2704,"_5":31336,"_21481":59135,"_28188":59136,"_3059":59137},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3603":2728,"_31001":2704,"_5":31336,"_21481":59139,"_28188":59140,"_3059":59141},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3603":2729,"_31001":2704,"_5":31336,"_21481":59143,"_28188":59144,"_3059":59145},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3603":2730,"_31001":2704,"_5":31336,"_21481":59147,"_28188":59148,"_3059":59149},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3603":2731,"_31001":2704,"_5":31336,"_21481":59151,"_28188":59152,"_3059":59153},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3603":2732,"_31001":2704,"_5":31336,"_21481":59155,"_28188":59156,"_3059":59157},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3603":2733,"_31001":2704,"_5":31336,"_21481":59159,"_28188":59160,"_3059":59161},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3603":2734,"_31001":2704,"_5":31336,"_21481":59163,"_28188":59164,"_3059":59165},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3603":2735,"_31001":2704,"_5":31336,"_21481":59167,"_28188":59168,"_3059":59169},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3603":2736,"_31001":2704,"_5":31336,"_21481":59171,"_28188":59172,"_3059":59173},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3603":2737,"_31001":2704,"_5":31336,"_21481":59175,"_28188":59176,"_3059":59177},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3603":2738,"_31001":2704,"_5":31336,"_21481":59179,"_28188":59180,"_3059":59181},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3603":2739,"_31001":2704,"_5":31336,"_21481":59183,"_28188":59184,"_3059":59185},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3603":2740,"_31001":2704,"_5":31336,"_21481":59187,"_28188":59188,"_3059":59189},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3603":2741,"_31001":2704,"_5":31336,"_21481":59191,"_28188":59192,"_3059":59193},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3603":2742,"_31001":2704,"_5":31336,"_21481":59195,"_28188":59196,"_3059":59197},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3603":2743,"_31001":2704,"_5":31336,"_21481":59199,"_28188":59200,"_3059":59201},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3603":2744,"_31001":2704,"_5":31336,"_21481":59203,"_28188":59204,"_3059":59205},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3603":2745,"_31001":2704,"_5":31336,"_21481":59207,"_28188":59208,"_3059":59209},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3603":2746,"_31001":2704,"_5":31336,"_21481":59211,"_28188":59212,"_3059":59213},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3603":2747,"_31001":2704,"_5":31336,"_21481":59215,"_28188":59216,"_3059":59217},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3603":2748,"_31001":2704,"_5":31336,"_21481":59219,"_28188":59220,"_3059":54893},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3603":2749,"_31001":2704,"_5":31336,"_21481":59222,"_28188":59223,"_3059":59224},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3603":2750,"_31001":2704,"_5":31336,"_21481":59226,"_28188":59227,"_3059":59228},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3603":2751,"_31001":2704,"_21481":59230,"_5":14758,"_28188":2704,"_3059":59231},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3603":2752,"_31001":2704,"_21481":59233,"_5":14758,"_28188":2704,"_3059":59234},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3603":2753,"_31001":2704,"_21481":59236,"_5":14758,"_28188":2704,"_3059":59237},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3603":2754,"_31001":2704,"_21481":59239,"_5":14758,"_28188":2704,"_3059":59240},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3603":2755,"_31001":2704,"_21481":59242,"_5":14758,"_28188":2704,"_3059":59243},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3603":2756,"_31001":2704,"_21481":59245,"_5":14758,"_28188":2704,"_3059":59246},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3603":2757,"_31001":2704,"_21481":59248,"_5":14758,"_28188":2704,"_3059":59249},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3603":2758,"_31001":2704,"_21481":59251,"_5":14758,"_28188":59057,"_3059":59252},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3603":2759,"_31001":2704,"_21481":59254,"_5":14758,"_28188":59057,"_3059":59255},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3603":2760,"_31001":2704,"_21481":59257,"_5":14758,"_28188":59061,"_3059":59258},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3603":2761,"_31001":2704,"_21481":59260,"_5":14758,"_28188":59061,"_3059":59261},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3603":2762,"_31001":2704,"_21481":59263,"_5":14758,"_28188":59065,"_3059":59264},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3603":2763,"_31001":2704,"_21481":59266,"_5":14758,"_28188":59069,"_3059":59267},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3603":2764,"_31001":2704,"_21481":59269,"_5":14758,"_28188":59069,"_3059":59270},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3603":2765,"_31001":2704,"_21481":59272,"_5":14758,"_28188":59069,"_3059":59273},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3603":2766,"_31001":2704,"_21481":59275,"_5":14758,"_28188":59069,"_3059":59276},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3603":2767,"_31001":2704,"_21481":59278,"_5":14758,"_28188":59069,"_3059":59279},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3603":2768,"_31001":2704,"_21481":59281,"_5":14758,"_28188":59073,"_3059":59282},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3603":2769,"_31001":2704,"_21481":59284,"_5":14758,"_28188":59073,"_3059":59285},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3603":2770,"_31001":2704,"_21481":59287,"_5":14758,"_28188":59073,"_3059":59288},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3603":2771,"_31001":2704,"_21481":59290,"_5":14758,"_28188":59073,"_3059":59291},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3603":2772,"_31001":2704,"_21481":59293,"_5":14758,"_28188":59073,"_3059":59294},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3603":2773,"_31001":2704,"_21481":59296,"_5":14758,"_28188":59073,"_3059":59297},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3603":2774,"_31001":2704,"_21481":59299,"_5":14758,"_28188":59077,"_3059":59300},[],"Change",{"_3603":2775,"_31001":2704,"_21481":59302,"_5":14758,"_28188":59077,"_3059":59303},[],"Who is affected",{"_3603":2776,"_31001":2704,"_21481":59305,"_5":14758,"_28188":59077,"_3059":59306},[],"Severity",{"_3603":2777,"_31001":2704,"_21481":59308,"_5":14758,"_28188":59077,"_3059":57766},[],{"_3603":2778,"_31001":2704,"_21481":59310,"_5":14758,"_28188":59077,"_3059":59086},[],{"_3603":2779,"_31001":2704,"_21481":59312,"_5":14758,"_28188":59077,"_3059":59313},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3603":2780,"_31001":2704,"_21481":59315,"_5":14758,"_28188":59077,"_3059":59316},[],"High: KMS and VA start on empty volumes",{"_3603":2781,"_31001":2704,"_21481":59318,"_5":14758,"_28188":59077,"_3059":59319},[],"Copy the data into the new volumes",{"_3603":2782,"_31001":2704,"_21481":59321,"_5":14758,"_28188":59077,"_3059":59090},[],{"_3603":2783,"_31001":2704,"_21481":59323,"_5":14758,"_28188":59077,"_3059":59324},[],"Every Helm release",{"_3603":2784,"_31001":2704,"_21481":59326,"_5":14758,"_28188":59077,"_3059":59327},[],"High: `helm upgrade` fails",{"_3603":2785,"_31001":2704,"_21481":59329,"_5":14758,"_28188":59077,"_3059":59330},[],"Remove or rename legacy keys",{"_3603":2786,"_31001":2704,"_21481":59332,"_5":14758,"_28188":59077,"_3059":51281},[],{"_3603":2787,"_31001":2704,"_21481":59334,"_5":14758,"_28188":59077,"_3059":59324},[],{"_3603":2788,"_31001":2704,"_21481":59336,"_5":14758,"_28188":59077,"_3059":59337},[],"High: `helm upgrade` fails on inline credentials",{"_3603":2789,"_31001":2704,"_21481":59339,"_5":14758,"_28188":59077,"_3059":59340},[],"Create the Secrets first; see Step 2",{"_3603":2790,"_31001":2704,"_21481":59342,"_5":14758,"_28188":59077,"_3059":59097},[],{"_3603":2791,"_31001":2704,"_21481":59344,"_5":14758,"_28188":59077,"_3059":59345},[],"Every deployment",{"_3603":2792,"_31001":2704,"_21481":59347,"_5":14758,"_28188":59077,"_3059":59348},[],"High: without a bootstrap principal there is no administrator",{"_3603":2793,"_31001":2704,"_21481":59350,"_5":14758,"_28188":59077,"_3059":59351},[],"Configure `services.authz`",{"_3603":2794,"_31001":2704,"_21481":59353,"_5":14758,"_28188":59077,"_3059":59101},[],{"_3603":2795,"_31001":2704,"_21481":59355,"_5":14758,"_28188":59077,"_3059":59324},[],{"_3603":2796,"_31001":2704,"_21481":59357,"_5":14758,"_28188":59077,"_3059":59358},[],"High: `helm upgrade` fails on the old keys",{"_3603":2797,"_31001":2704,"_21481":59360,"_5":14758,"_28188":59077,"_3059":59361},[],"Move JWKS and roles into `services.authz`",{"_3603":2798,"_31001":2704,"_21481":59363,"_5":14758,"_28188":59077,"_3059":59121},[],{"_3603":2799,"_31001":2704,"_21481":59365,"_5":14758,"_28188":59077,"_3059":59366},[],"3.8.0 deployments with per-service databases",{"_3603":2800,"_31001":2704,"_21481":59368,"_5":14758,"_28188":59077,"_3059":59369},[],"High: services find no data, or a migration aborts",{"_3603":2801,"_31001":2704,"_21481":59371,"_5":14758,"_28188":59077,"_3059":59372},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3603":2802,"_31001":2704,"_21481":59374,"_5":14758,"_28188":59077,"_3059":59125},[],{"_3603":2803,"_31001":2704,"_21481":59376,"_5":14758,"_28188":59077,"_3059":59377},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3603":2804,"_31001":2704,"_21481":59379,"_5":14758,"_28188":59077,"_3059":59380},[],"High: the backend no longer starts with them",{"_3603":2805,"_31001":2704,"_21481":59382,"_5":14758,"_28188":59077,"_3059":59383},[],"Move to PostgreSQL before upgrading",{"_3603":2806,"_31001":2704,"_21481":59385,"_5":14758,"_28188":59077,"_3059":59169},[],{"_3603":2807,"_31001":2704,"_21481":59387,"_5":14758,"_28188":59077,"_3059":59388},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3603":2808,"_31001":2704,"_21481":59390,"_5":14758,"_28188":59077,"_3059":59391},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3603":2809,"_31001":2704,"_21481":59393,"_5":14758,"_28188":59077,"_3059":59394},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3603":2810,"_31001":2704,"_21481":59396,"_5":14758,"_28188":59077,"_3059":59397},[],"Webhooks with file references",{"_3603":2811,"_31001":2704,"_21481":59399,"_5":14758,"_28188":59077,"_3059":59400},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3603":2812,"_31001":2704,"_21481":59402,"_5":14758,"_28188":59077,"_3059":59403},[],"High: enrollments calling the webhook fail",{"_3603":2813,"_31001":2704,"_21481":59405,"_5":14758,"_28188":59077,"_3059":59406},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3603":2814,"_31001":2704,"_21481":59408,"_5":14758,"_28188":59077,"_3059":59105},[],{"_3603":2815,"_31001":2704,"_21481":59410,"_5":14758,"_28188":59077,"_3059":59411},[],"Releases with per-service identity overrides or mounted key material",{"_3603":2816,"_31001":2704,"_21481":59413,"_5":14758,"_28188":59077,"_3059":59414},[],"Medium: services cannot read their files",{"_3603":2817,"_31001":2704,"_21481":59416,"_5":14758,"_28188":59077,"_3059":59417},[],"Remove the overrides and fix volume ownership",{"_3603":2818,"_31001":2704,"_21481":59419,"_5":14758,"_28188":59077,"_3059":59109},[],{"_3603":2819,"_31001":2704,"_21481":59421,"_5":14758,"_28188":59077,"_3059":59422},[],"Releases that set `amqp.tls`",{"_3603":2820,"_31001":2704,"_21481":59424,"_5":14758,"_28188":59077,"_3059":59425},[],"Medium: clients connect to the wrong port",{"_3603":2821,"_31001":2704,"_21481":59427,"_5":14758,"_28188":59077,"_3059":59428},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3603":2822,"_31001":2704,"_21481":59430,"_5":14758,"_28188":59077,"_3059":59129},[],{"_3603":2823,"_31001":2704,"_21481":59432,"_5":14758,"_28188":59077,"_3059":59433},[],"Installations whose CA keys predate the KMS",{"_3603":2824,"_31001":2704,"_21481":59435,"_5":14758,"_28188":59077,"_3059":59436},[],"Medium: CA keys stay unmanaged",{"_3603":2825,"_31001":2704,"_21481":59438,"_5":14758,"_28188":59077,"_3059":59439},[],"Run the CA-to-KMS migration",{"_3603":2826,"_31001":2704,"_21481":59441,"_5":14758,"_28188":59077,"_3059":59442},[],"Receiver certificate verification",{"_3603":2827,"_31001":2704,"_21481":59444,"_5":14758,"_28188":59077,"_3059":59445},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3603":2828,"_31001":2704,"_21481":59447,"_5":14758,"_28188":59077,"_3059":59448},[],"Medium: credentials go to an unverified receiver",{"_3603":2829,"_31001":2704,"_21481":59450,"_5":14758,"_28188":59077,"_3059":59451},[],"Set `insecure_skip_verify` to `false`",{"_3603":2830,"_31001":2704,"_21481":59453,"_5":14758,"_28188":59077,"_3059":59145},[],{"_3603":2831,"_31001":2704,"_21481":59455,"_5":14758,"_28188":59077,"_3059":59456},[],"Scripts and consoles that edit DMSs through the API",{"_3603":2832,"_31001":2704,"_21481":59458,"_5":14758,"_28188":59077,"_3059":59459},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3603":2833,"_31001":2704,"_21481":59461,"_5":14758,"_28188":59077,"_3059":59462},[],"Read the DMS before editing and use the new field",{"_3603":2834,"_31001":2704,"_21481":59464,"_5":14758,"_28188":59077,"_3059":59165},[],{"_3603":2835,"_31001":2704,"_21481":59466,"_5":14758,"_28188":59077,"_3059":59467},[],"Clients that create or update CRL settings through the API",{"_3603":2836,"_31001":2704,"_21481":59469,"_5":14758,"_28188":59077,"_3059":59470},[],"Medium: requests with the old field return an error",{"_3603":2837,"_31001":2704,"_21481":59472,"_5":14758,"_28188":59077,"_3059":59473},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3603":2838,"_31001":2704,"_21481":59475,"_5":14758,"_28188":59077,"_3059":59173},[],{"_3603":2839,"_31001":2704,"_21481":59477,"_5":14758,"_28188":59077,"_3059":59478},[],"Alert subscriptions and consumers of the VA events",{"_3603":2840,"_31001":2704,"_21481":59480,"_5":14758,"_28188":59077,"_3059":59481},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3603":2841,"_31001":2704,"_21481":59483,"_5":14758,"_28188":59077,"_3059":59484},[],"Review conditions filtering on the old event payload or subject",{"_3603":2842,"_31001":2704,"_21481":59486,"_5":14758,"_28188":59077,"_3059":59161},[],{"_3603":2843,"_31001":2704,"_21481":59488,"_5":14758,"_28188":59077,"_3059":59489},[],"Consumers that read the device `events` field",{"_3603":2844,"_31001":2704,"_21481":59491,"_5":14758,"_28188":59077,"_3059":59492},[],"Medium: the field disappears",{"_3603":2845,"_31001":2704,"_21481":59494,"_5":14758,"_28188":59077,"_3059":59495},[],"Use the new event endpoints",{"_3603":2846,"_31001":2704,"_21481":59497,"_5":14758,"_28188":59077,"_3059":59185},[],{"_3603":2847,"_31001":2704,"_21481":59499,"_5":14758,"_28188":59077,"_3059":59500},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3603":2848,"_31001":2704,"_21481":59502,"_5":14758,"_28188":59077,"_3059":59503},[],"Medium: the VA migration aborts",{"_3603":2849,"_31001":2704,"_21481":59505,"_5":14758,"_28188":59077,"_3059":59506},[],"Fix the affected roles before upgrading",{"_3603":2850,"_31001":2704,"_21481":59508,"_5":14758,"_28188":59077,"_3059":59113},[],{"_3603":2851,"_31001":2704,"_21481":59510,"_5":14758,"_28188":59077,"_3059":59511},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3603":2852,"_31001":2704,"_21481":59513,"_5":14758,"_28188":59077,"_3059":59514},[],"Low to medium: validation errors or changed defaults",{"_3603":2853,"_31001":2704,"_21481":59516,"_5":14758,"_28188":59077,"_3059":59517},[],"Update the values file",{"_3603":2854,"_31001":2704,"_21481":59519,"_5":14758,"_28188":59077,"_3059":59153},[],{"_3603":2855,"_31001":2704,"_21481":59521,"_5":14758,"_28188":59077,"_3059":59522},[],"Clients that send the DMS ID in the update body",{"_3603":2856,"_31001":2704,"_21481":59524,"_5":14758,"_28188":59077,"_3059":59525},[],"Low: the ID in the URL wins",{"_3603":2857,"_31001":2704,"_21481":59527,"_5":14758,"_28188":59077,"_3059":59528},[],"Send the ID in the URL",{"_3603":2858,"_31001":2704,"_21481":59530,"_5":14758,"_28188":59077,"_3059":59177},[],{"_3603":2859,"_31001":2704,"_21481":59532,"_5":14758,"_28188":59077,"_3059":59533},[],"Clients that send an `id` when creating or importing CAs",{"_3603":2860,"_31001":2704,"_21481":59535,"_5":14758,"_28188":59077,"_3059":59536},[],"Low: the ID in the body is ignored, and the field is removed",{"_3603":2861,"_31001":2704,"_21481":59538,"_5":14758,"_28188":59077,"_3059":59539},[],"Let the backend assign the ID and use the returned one",{"_3603":2862,"_31001":2704,"_21481":59541,"_5":14758,"_28188":59077,"_3059":59181},[],{"_3603":2863,"_31001":2704,"_21481":59543,"_5":14758,"_28188":59077,"_3059":59544},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3603":2864,"_31001":2704,"_21481":59546,"_5":14758,"_28188":59077,"_3059":59547},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3603":2865,"_31001":2704,"_21481":59549,"_5":14758,"_28188":59077,"_3059":59550},[],"Use the KMS `sign` and `verify` operations",{"_3603":2866,"_31001":2704,"_21481":59552,"_5":14758,"_28188":59077,"_3059":59157},[],{"_3603":2867,"_31001":2704,"_21481":59554,"_5":14758,"_28188":59077,"_3059":59555},[],"Consumers that match on certificate `type`",{"_3603":2868,"_31001":2704,"_21481":59557,"_5":14758,"_28188":59077,"_3059":59558},[],"Low: two values are renamed",{"_3603":2869,"_31001":2704,"_21481":59560,"_5":14758,"_28188":59077,"_3059":59561},[],"Adapt consumers",{"_3603":2870,"_31001":2704,"_21481":59563,"_5":14758,"_28188":59077,"_3059":59149},[],{"_3603":2871,"_31001":2704,"_21481":59565,"_5":14758,"_28188":59077,"_3059":59566},[],"Any DMS",{"_3603":2872,"_31001":2704,"_21481":59568,"_5":14758,"_28188":59077,"_3059":59569},[],"Low: informational",{"_3603":2873,"_31001":2704,"_21481":59571,"_5":14758,"_28188":59077,"_3059":59572},[],"Read both blocks before editing",{"_3603":2874,"_31001":2704,"_21481":59574,"_5":14758,"_28188":59085,"_3059":59575},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3603":2875,"_31001":2704,"_21481":59577,"_5":14758,"_28188":59085,"_3059":59578},[],"Step 4 of the migration guide copies the data.",{"_3603":2876,"_31001":2704,"_21481":59580,"_5":14758,"_28188":59089,"_3059":59581},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3603":2877,"_31001":2704,"_21481":59583,"_5":14758,"_28188":59093,"_3059":59584},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3603":2878,"_31001":2704,"_21481":59586,"_5":14758,"_28188":59093,"_3059":59587},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3603":2879,"_31001":2704,"_21481":59589,"_5":14758,"_28188":59096,"_3059":59590},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3603":2880,"_31001":2704,"_21481":59592,"_5":14758,"_28188":59100,"_3059":59593},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3603":2881,"_31001":2704,"_21481":59595,"_5":14758,"_28188":59104,"_3059":59596},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3603":2882,"_31001":2704,"_21481":59598,"_5":14758,"_28188":59104,"_3059":59599},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3603":2883,"_31001":2704,"_21481":59601,"_5":14758,"_28188":59104,"_3059":59602},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3603":2884,"_31001":2704,"_21481":59604,"_5":14758,"_28188":59108,"_3059":59605},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3603":2885,"_31001":2704,"_21481":59607,"_5":14758,"_28188":59112,"_3059":59608},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3603":2886,"_31001":2704,"_21481":59610,"_5":14758,"_28188":59112,"_3059":59611},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3603":2887,"_31001":2704,"_21481":59613,"_5":14758,"_28188":59112,"_3059":59614},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3603":2888,"_31001":2704,"_21481":59616,"_5":14758,"_28188":59112,"_3059":59617},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3603":2889,"_31001":2704,"_21481":59619,"_5":14758,"_28188":59112,"_3059":59620},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3603":2890,"_31001":2704,"_21481":59622,"_5":14758,"_28188":59112,"_3059":59623},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3603":2891,"_31001":2704,"_21481":59625,"_5":14758,"_28188":59120,"_3059":59626},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3603":2892,"_31001":2704,"_21481":59628,"_5":14758,"_28188":59120,"_3059":59629},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3603":2893,"_31001":2704,"_21481":59631,"_5":14758,"_28188":59120,"_3059":59632},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3603":2894,"_31001":2704,"_21481":59634,"_5":14758,"_28188":59120,"_3059":59635},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3603":2895,"_31001":2704,"_21481":59637,"_5":14758,"_28188":59120,"_3059":59638},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3603":2896,"_31001":2704,"_21481":59640,"_5":14758,"_28188":59124,"_3059":59641},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3603":2897,"_31001":2704,"_21481":59643,"_5":14758,"_28188":59128,"_3059":59644},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3603":2898,"_31001":2704,"_21481":59646,"_5":14758,"_28188":59128,"_3059":59647},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3603":2899,"_31001":2704,"_21481":59649,"_5":14758,"_28188":59128,"_3059":59650},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3603":2900,"_31001":2704,"_21481":59652,"_5":14758,"_28188":59128,"_3059":59653},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3603":2901,"_31001":2704,"_21481":59655,"_5":14758,"_28188":59128,"_3059":59656},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3603":2902,"_31001":2704,"_21481":59658,"_5":14758,"_28188":59128,"_3059":59659},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3603":2903,"_31001":2704,"_21481":59661,"_5":14758,"_28188":59128,"_3059":59662},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3603":2904,"_31001":2704,"_21481":59664,"_5":14758,"_28188":59128,"_3059":59665},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3603":2905,"_31001":2704,"_21481":59667,"_5":14758,"_28188":59132,"_3059":59668},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3603":2906,"_31001":2704,"_21481":59670,"_5":14758,"_28188":59140,"_3059":59671},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3603":2907,"_31001":2704,"_21481":59673,"_5":14758,"_28188":59140,"_3059":59674},[],"Field in 3.8.0",{"_3603":2908,"_31001":2704,"_21481":59676,"_5":14758,"_28188":59140,"_3059":59677},[],"Field in 4.0.0",{"_3603":2909,"_31001":2704,"_21481":59679,"_5":14758,"_28188":59140,"_3059":59680},[],"`validate_server_cert`",{"_3603":2910,"_31001":2704,"_21481":59682,"_5":14758,"_28188":59140,"_3059":59683},[],"`insecure_skip_verify` (value negated)",{"_3603":2911,"_31001":2704,"_21481":59685,"_5":14758,"_28188":59140,"_3059":59686},[],"`oidc`",{"_3603":2912,"_31001":2704,"_21481":59688,"_5":14758,"_28188":59140,"_3059":59689},[],"`jwt_options`",{"_3603":2913,"_31001":2704,"_21481":59691,"_5":14758,"_28188":59140,"_3059":59692},[],"`apikey`",{"_3603":2914,"_31001":2704,"_21481":59694,"_5":14758,"_28188":59140,"_3059":59695},[],"`apikey_options`",{"_3603":2915,"_31001":2704,"_21481":59697,"_5":14758,"_28188":59140,"_3059":59698},[],"`mtls`",{"_3603":2916,"_31001":2704,"_21481":59700,"_5":14758,"_28188":59140,"_3059":59701},[],"`mtls_options`",{"_3603":2917,"_31001":2704,"_21481":59703,"_5":14758,"_28188":59140,"_3059":59704},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3603":2918,"_31001":2704,"_21481":59706,"_5":14758,"_28188":59140,"_3059":59707},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3603":2919,"_31001":2704,"_21481":59709,"_5":14758,"_28188":59140,"_3059":59710},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3603":2920,"_31001":2704,"_21481":59712,"_5":14758,"_28188":59144,"_3059":59713},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3603":2921,"_31001":2704,"_21481":59715,"_5":14758,"_28188":59144,"_3059":59716},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3603":2922,"_31001":2704,"_21481":59718,"_5":14758,"_28188":59144,"_3059":59719},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3603":2923,"_31001":2704,"_21481":59721,"_5":14758,"_28188":59148,"_3059":59722},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3603":2924,"_31001":2704,"_21481":59724,"_5":14758,"_28188":59152,"_3059":59725},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3603":2925,"_31001":2704,"_21481":59727,"_5":14758,"_28188":59156,"_3059":59728},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3603":2926,"_31001":2704,"_21481":59730,"_5":14758,"_28188":59160,"_3059":59731},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3603":2927,"_31001":2704,"_21481":59733,"_5":14758,"_28188":59160,"_3059":59734},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3603":2928,"_31001":2704,"_21481":59736,"_5":14758,"_28188":59160,"_3059":59737},[],"`POST /v1/devices/:id/events` creates an event.",{"_3603":2929,"_31001":2704,"_21481":59739,"_5":14758,"_28188":59160,"_3059":59740},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3603":2930,"_31001":2704,"_21481":59742,"_5":14758,"_28188":59164,"_3059":59743},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3603":2931,"_31001":2704,"_21481":59745,"_5":14758,"_28188":59168,"_3059":59746},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3603":2932,"_31001":2704,"_21481":59748,"_5":14758,"_28188":59168,"_3059":59749},[],"Route",{"_3603":2933,"_31001":2704,"_21481":59751,"_5":14758,"_28188":59168,"_3059":54080},[],{"_3603":2934,"_31001":2704,"_21481":59753,"_5":14758,"_28188":59168,"_3059":59754},[],"`GET /v1/crl-settings`",{"_3603":2935,"_31001":2704,"_21481":59756,"_5":14758,"_28188":59168,"_3059":59757},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3603":2936,"_31001":2704,"_21481":59759,"_5":14758,"_28188":59168,"_3059":59760},[],"`GET /v1/crl-settings/{ca-id}`",{"_3603":2937,"_31001":2704,"_21481":59762,"_5":14758,"_28188":59168,"_3059":59763},[],"Reads the settings of a CA.",{"_3603":2938,"_31001":2704,"_21481":59765,"_5":14758,"_28188":59168,"_3059":59766},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3603":2939,"_31001":2704,"_21481":59768,"_5":14758,"_28188":59168,"_3059":59769},[],"Replaces `crl_options`.",{"_3603":2940,"_31001":2704,"_21481":59771,"_5":14758,"_28188":59168,"_3059":59772},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3603":2941,"_31001":2704,"_21481":59774,"_5":14758,"_28188":59168,"_3059":59775},[],"Removes the archived settings of a CA.",{"_3603":2942,"_31001":2704,"_21481":59777,"_5":14758,"_28188":59168,"_3059":59778},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3603":2943,"_31001":2704,"_21481":59780,"_5":14758,"_28188":59168,"_3059":59781},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3603":2944,"_31001":2704,"_21481":59783,"_5":14758,"_28188":59168,"_3059":59784},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3603":2945,"_31001":2704,"_21481":59786,"_5":14758,"_28188":59168,"_3059":59787},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3603":2946,"_31001":2704,"_21481":59789,"_5":14758,"_28188":59168,"_3059":59790},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3603":2947,"_31001":2704,"_21481":59792,"_5":14758,"_28188":59168,"_3059":59793},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3603":2948,"_31001":2704,"_21481":59795,"_5":14758,"_28188":59168,"_3059":59796},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3603":2949,"_31001":2704,"_21481":59798,"_5":14758,"_28188":59168,"_3059":59799},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3603":2950,"_31001":2704,"_21481":59801,"_5":14758,"_28188":59168,"_3059":59802},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3603":2951,"_31001":2704,"_21481":59804,"_5":14758,"_28188":59168,"_3059":59805},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3603":2952,"_31001":2704,"_21481":59807,"_5":14758,"_28188":59168,"_3059":59808},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3603":2953,"_31001":2704,"_21481":59810,"_5":14758,"_28188":59172,"_3059":59811},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3603":2954,"_31001":2704,"_21481":59813,"_5":14758,"_28188":59176,"_3059":59814},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3603":2955,"_31001":2704,"_21481":59816,"_5":14758,"_28188":59180,"_3059":59817},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3603":2956,"_31001":2704,"_21481":59819,"_5":14758,"_28188":59180,"_3059":59820},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3603":2957,"_31001":2704,"_21481":59822,"_5":14758,"_28188":59184,"_3059":59823},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3603":2958,"_31001":2704,"_21481":59825,"_5":14758,"_28188":59188,"_3059":59826},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3603":2959,"_31001":2704,"_21481":59828,"_5":14758,"_28188":59192,"_3059":59829},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3603":2960,"_31001":2704,"_21481":59831,"_5":14758,"_28188":59192,"_3059":59832},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3603":2961,"_31001":2704,"_21481":59834,"_5":14758,"_28188":59192,"_3059":59835},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3603":2962,"_31001":2704,"_21481":59837,"_5":14758,"_28188":59192,"_3059":59838},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3603":2963,"_31001":2704,"_21481":59840,"_5":14758,"_28188":59192,"_3059":59841},[],"Record the names of your local-storage PVCs:",{"_3603":2964,"_31001":2704,"_21481":59843,"_5":14758,"_28188":59192,"_3059":59844},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3603":2965,"_31001":2704,"_21481":59846,"_5":14758,"_28188":59196,"_3059":59847},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3603":2966,"_31001":2704,"_21481":59849,"_5":14758,"_28188":59196,"_3059":59850},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3603":2967,"_31001":2704,"_21481":59852,"_5":14758,"_28188":59196,"_3059":59853},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3603":2968,"_31001":2704,"_21481":59855,"_5":14758,"_28188":59196,"_3059":59856},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3603":2969,"_31001":2704,"_21481":59858,"_5":14758,"_28188":59196,"_3059":59859},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3603":2970,"_31001":2704,"_21481":59861,"_5":14758,"_28188":59200,"_3059":59862},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3603":2971,"_31001":2704,"_21481":59864,"_5":14758,"_28188":59200,"_3059":59865},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3603":2972,"_31001":2704,"_21481":59867,"_5":14758,"_28188":59200,"_3059":59868},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3603":2973,"_31001":2704,"_21481":59870,"_5":14758,"_28188":59200,"_3059":59871},[],"Secret (`existingSecret`)",{"_3603":2974,"_31001":2704,"_21481":59873,"_5":14758,"_28188":59200,"_3059":59874},[],"Required data keys",{"_3603":2975,"_31001":2704,"_21481":59876,"_5":14758,"_28188":59200,"_3059":59877},[],"When",{"_3603":2976,"_31001":2704,"_21481":59879,"_5":14758,"_28188":59200,"_3059":59880},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3603":2977,"_31001":2704,"_21481":59882,"_5":14758,"_28188":59200,"_3059":59883},[],"`username`, `password`",{"_3603":2978,"_31001":2704,"_21481":59885,"_5":14758,"_28188":59200,"_3059":59886},[],"Always",{"_3603":2979,"_31001":2704,"_21481":59888,"_5":14758,"_28188":59200,"_3059":59889},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3603":2980,"_31001":2704,"_21481":59891,"_5":14758,"_28188":59200,"_3059":59883},[],{"_3603":2981,"_31001":2704,"_21481":59893,"_5":14758,"_28188":59200,"_3059":59886},[],{"_3603":2982,"_31001":2704,"_21481":59895,"_5":14758,"_28188":59200,"_3059":59896},[],"`services.alerts.smtp_server.existingSecret`",{"_3603":2983,"_31001":2704,"_21481":59898,"_5":14758,"_28188":59200,"_3059":59883},[],{"_3603":2984,"_31001":2704,"_21481":59900,"_5":14758,"_28188":59200,"_3059":59901},[],"Only when SMTP authentication is enabled",{"_3603":2985,"_31001":2704,"_21481":59903,"_5":14758,"_28188":59200,"_3059":59904},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3603":2986,"_31001":2704,"_21481":59906,"_5":14758,"_28188":59200,"_3059":59907},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3603":2987,"_31001":2704,"_21481":59909,"_5":14758,"_28188":59200,"_3059":59910},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3603":2988,"_31001":2704,"_21481":59912,"_5":14758,"_28188":59200,"_3059":59913},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3603":2989,"_31001":2704,"_21481":59915,"_5":14758,"_28188":59200,"_3059":59916},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3603":2990,"_31001":2704,"_21481":59918,"_5":14758,"_28188":59200,"_3059":59919},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3603":2991,"_31001":2704,"_21481":59921,"_5":14758,"_28188":59200,"_3059":59922},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3603":2992,"_31001":2704,"_21481":59924,"_5":14758,"_28188":59200,"_3059":59925},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3603":2993,"_31001":2704,"_21481":59927,"_5":14758,"_28188":59200,"_3059":59928},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3603":2994,"_31001":2704,"_21481":59930,"_5":14758,"_28188":59200,"_3059":59931},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3603":2995,"_31001":2704,"_21481":59933,"_5":14758,"_28188":59200,"_3059":59934},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3603":2996,"_31001":2704,"_21481":59936,"_5":14758,"_28188":59200,"_3059":59937},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3603":2997,"_31001":2704,"_21481":59939,"_5":14758,"_28188":59200,"_3059":59940},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3603":2998,"_31001":2704,"_21481":59942,"_5":14758,"_28188":59200,"_3059":59943},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3603":2999,"_31001":2704,"_21481":59945,"_5":14758,"_28188":59200,"_3059":59946},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3603":3000,"_31001":2704,"_21481":59948,"_5":14758,"_28188":59204,"_3059":59949},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3603":3001,"_31001":2704,"_21481":59951,"_5":14758,"_28188":59204,"_3059":59952},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3603":3002,"_31001":2704,"_21481":59954,"_5":14758,"_28188":59208,"_3059":59955},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3603":3003,"_31001":2704,"_21481":59957,"_5":14758,"_28188":59208,"_3059":59958},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3603":3004,"_31001":2704,"_21481":59960,"_5":14758,"_28188":59208,"_3059":59961},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3603":3005,"_31001":2704,"_21481":59963,"_5":14758,"_28188":59208,"_3059":59964},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3603":3006,"_31001":2704,"_21481":59966,"_5":14758,"_28188":59208,"_3059":59967},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3603":3007,"_31001":2704,"_21481":59969,"_5":14758,"_28188":59208,"_3059":59970},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3603":3008,"_31001":2704,"_21481":59972,"_5":14758,"_28188":59208,"_3059":59973},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3603":3009,"_31001":2704,"_21481":59975,"_5":14758,"_28188":59208,"_3059":59976},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3603":3010,"_31001":2704,"_21481":59978,"_5":14758,"_28188":59208,"_3059":59979},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3603":3011,"_31001":2704,"_21481":59981,"_5":14758,"_28188":59208,"_3059":59982},[],"**Remove the helper and restore the recorded replica counts:**",{"_3603":3012,"_31001":2704,"_21481":59984,"_5":14758,"_28188":59208,"_3059":59985},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3603":3013,"_31001":2704,"_21481":59987,"_5":14758,"_28188":59212,"_3059":59988},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3603":3014,"_31001":2704,"_21481":59990,"_5":14758,"_28188":59212,"_3059":59991},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3603":3015,"_31001":2704,"_21481":59993,"_5":14758,"_28188":59216,"_3059":59994},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3603":3016,"_31001":2704,"_21481":59996,"_5":14758,"_28188":59216,"_3059":59997},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3603":3017,"_31001":2704,"_21481":59999,"_5":14758,"_28188":59216,"_3059":60000},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3603":3018,"_31001":2704,"_21481":60002,"_5":14758,"_28188":59216,"_3059":60003},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3603":3019,"_31001":2704,"_21481":60005,"_5":14758,"_28188":59216,"_3059":60006},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3603":3020,"_31001":2704,"_21481":60008,"_5":14758,"_28188":59216,"_3059":60009},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3603":3021,"_31001":2704,"_21481":60011,"_5":14758,"_28188":59216,"_3059":60012},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3603":3022,"_31001":2704,"_21481":60014,"_5":14758,"_28188":59216,"_3059":60015},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3603":3023,"_31001":2704,"_21481":60017,"_5":14758,"_28188":59220,"_3059":60018},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3603":3024,"_31001":2704,"_21481":60020,"_5":14758,"_28188":59220,"_3059":60021},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3603":3025,"_31001":2704,"_21481":60023,"_5":14758,"_28188":59220,"_3059":60024},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3603":3026,"_31001":2704,"_21481":60026,"_5":14758,"_28188":59220,"_3059":60027},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3603":3027,"_31001":2704,"_21481":60029,"_5":14758,"_28188":59220,"_3059":60030},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3603":3028,"_31001":2704,"_21481":60032,"_5":14758,"_28188":59220,"_3059":60033},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3603":3029,"_31001":2704,"_21481":60035,"_5":14758,"_28188":59220,"_3059":60036},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3603":3030,"_31001":2704,"_21481":60038,"_5":14758,"_28188":59220,"_3059":60039},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3603":3031,"_31001":2704,"_21481":60041,"_5":14758,"_28188":59220,"_3059":60042},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3603":3032,"_31001":2704,"_21481":60044,"_5":14758,"_28188":59220,"_3059":60045},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3603":3033,"_31001":2704,"_21481":60047,"_5":14758,"_28188":59220,"_3059":60048},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3603":3034,"_31001":2704,"_21481":60050,"_5":14758,"_28188":59223,"_3059":60051},[],"After the upgrade, check in this order:",{"_3603":3035,"_31001":2704,"_21481":60053,"_5":14758,"_28188":59223,"_3059":60054},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3603":3036,"_31001":2704,"_21481":60056,"_5":14758,"_28188":59223,"_3059":60057},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3603":3037,"_31001":2704,"_21481":60059,"_5":14758,"_28188":59223,"_3059":60060},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3603":3038,"_31001":2704,"_21481":60062,"_5":14758,"_28188":59223,"_3059":60063},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3603":3039,"_31001":2704,"_21481":60065,"_5":14758,"_28188":59223,"_3059":60066},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3603":3040,"_31001":2704,"_21481":60068,"_5":14758,"_28188":59223,"_3059":60069},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3603":3041,"_31001":2704,"_21481":60071,"_5":14758,"_28188":59223,"_3059":60072},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3603":3042,"_31001":2704,"_21481":60074,"_5":14758,"_28188":59223,"_3059":60075},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3603":3043,"_31001":2704,"_21481":60077,"_5":14758,"_28188":59223,"_3059":60078},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3603":3044,"_31001":2704,"_21481":60080,"_5":14758,"_28188":59223,"_3059":60081},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3603":3045,"_31001":2704,"_21481":60083,"_5":14758,"_28188":59223,"_3059":60084},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3603":3046,"_31001":2704,"_21481":60086,"_5":14758,"_28188":59223,"_3059":60087},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3603":3047,"_31001":2704,"_21481":60089,"_5":14758,"_28188":59223,"_3059":60090},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3603":3048,"_31001":2704,"_21481":60092,"_5":14758,"_28188":59223,"_3059":60093},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3603":3049,"_31001":2704,"_21481":60095,"_5":14758,"_28188":59223,"_3059":60096},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3603":3050,"_31001":2704,"_21481":60098,"_5":14758,"_28188":59227,"_3059":60099},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3603":3051,"_31001":2704,"_21481":60101,"_5":14758,"_28188":59227,"_3059":60102},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3603":3052,"_31001":2704,"_21481":60104,"_5":14758,"_28188":59227,"_3059":60105},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3603":3053,"_31001":2704,"_21481":60107,"_5":14758,"_28188":59227,"_3059":60108},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3603":3054,"_31001":2704,"_21481":60110,"_5":14758,"_28188":59227,"_3059":60111},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60114":60115,"_60116":60117,"_60118":60119,"_60120":60121,"_18606":3094,"_72295":3094},"language","english","sortableProperties",[3059,31001,5,28188],"sortablePropertiesWithTypes",{"_3059":25639,"_31001":25639,"_5":25639,"_28188":25639},"sorts",{"_3059":60122,"_31001":63166,"_5":66209,"_28188":69252},{"_4801":60123,"_60124":60125,"_5":25639},{"_14834":6174,"_15217":11092,"_15236":7178,"_30000":5326,"_15223":3860,"_20388":5293,"_14855":5337,"_14862":8115,"_29942":5358,"_30356":4218,"_30377":17133,"_29976":7164,"_35368":3312,"_30079":7768,"_30421":5098,"_35375":30592,"_35378":6860,"_35381":26630,"_35384":6814,"_30823":11297,"_35389":13257,"_35391":4320,"_30858":8948,"_15232":3350,"_35395":3448,"_35398":7168,"_35400":6405,"_30405":3271,"_30843":3558,"_30871":5155,"_35405":10410,"_35407":29517,"_35409":6196,"_30096":3159,"_35412":7194,"_35414":7175,"_35416":10160,"_35418":3784,"_35420":8862,"_30013":6769,"_35423":7502,"_35425":3458,"_30007":17999,"_30442":20891,"_35429":3309,"_35431":7438,"_35434":10970,"_30053":17463,"_35438":5128,"_29933":17734,"_35441":6043,"_29981":3477,"_35444":4554,"_35446":11296,"_35449":7883,"_15226":9056,"_35452":7268,"_35454":10498,"_35457":3557,"_35459":16008,"_35461":11644,"_35463":7908,"_35465":10409,"_20391":5346,"_35468":7737,"_35470":6141,"_29954":4911,"_30399":5347,"_35474":4769,"_35476":4353,"_35478":5220,"_30888":6504,"_35481":11919,"_35483":6237,"_35485":4880,"_30981":12631,"_30458":9680,"_35489":3531,"_35491":3367,"_29991":6584,"_35494":3124,"_35496":17146,"_35498":24213,"_30904":6372,"_30073":10776,"_29453":4939,"_35503":6515,"_35505":4883,"_35507":6709,"_30122":22256,"_35511":7668,"_30393":16205,"_35515":10761,"_35517":4461,"_35519":14682,"_35521":5211,"_35523":3384,"_35525":5218,"_30111":5109,"_30361":24840,"_35529":3901,"_35531":21916,"_35533":15091,"_35536":3514,"_35538":8697,"_35540":9344,"_35542":17262,"_35544":10431,"_35546":9108,"_35548":21430,"_35551":5314,"_35553":3394,"_35555":3774,"_35557":4925,"_35559":12341,"_35562":3320,"_35564":6191,"_35567":3168,"_35570":7308,"_35572":20693,"_35574":7834,"_35576":4536,"_35578":7143,"_355