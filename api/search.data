eployment/aws-marketplace#configure-the-instance","Configure the instance",{"_3634":21,"_31209":15,"_5":31544,"_21628":51023,"_28401":51024,"_3085":51025},[],"/docs/deployment/aws-marketplace#limit-network-access","Limit network access",{"_3634":22,"_31209":15,"_5":31544,"_21628":51027,"_28401":51028,"_3085":51029},[],"/docs/deployment/aws-marketplace#launch-and-verify","Launch and verify",{"_3634":23,"_31209":15,"_5":31544,"_21628":51031,"_28401":51032,"_3085":51033},[],"/docs/deployment/aws-marketplace#next-step","Next step",{"_3634":24,"_31209":15,"_21628":51035,"_5":14884,"_28401":15,"_3085":51036},[],"The AWS Marketplace offering reduces initial setup to an EC2 instance inside your account. You keep control of the network, storage and operation of the machine.",{"_3634":25,"_31209":15,"_21628":51038,"_5":14884,"_28401":51008,"_3085":51039},[],"Permissions to subscribe to AWS Marketplace products and launch EC2 instances.",{"_3634":26,"_31209":15,"_21628":51041,"_5":14884,"_28401":51008,"_3085":51042},[],"A VPC and a subnet from which administrators and devices can reach the instance.",{"_3634":27,"_31209":15,"_21628":51044,"_5":14884,"_28401":51008,"_3085":51045},[],"A security group allowing the necessary endpoints.",{"_3634":28,"_31209":15,"_21628":51047,"_5":14884,"_28401":51012,"_3085":51048},[],"**Compute:** a `t3.large` instance at minimum. Use `t3.xlarge` or higher when the load requires it.",{"_3634":29,"_31209":15,"_21628":51050,"_5":14884,"_28401":51012,"_3085":51051},[],"**Storage:** an EBS `gp3` volume of at least 50 GB, sized to your inventory and retention needs.",{"_3634":30,"_31209":15,"_21628":51053,"_5":14884,"_28401":51012,"_3085":51054},[],"**Network:** HTTPS access from the necessary consumers, restricted to trusted networks.",{"_3634":31,"_31209":15,"_21628":51056,"_5":14884,"_28401":51016,"_3085":51057},[],"Go to Lamassu IoT on AWS Marketplace and review the terms before subscribing.",{"_3634":32,"_31209":15,"_21628":51059,"_5":14884,"_28401":51020,"_3085":51060},[],"Select `t3.large` or higher, assign at least 50 GB of `gp3` storage and choose the target VPC and subnet.",{"_3634":33,"_31209":15,"_21628":51062,"_5":14884,"_28401":51024,"_3085":51063},[],"Configure the security group for ports `443`, `8443` and `9443`. Restrict the origins to the administrative and device networks that really need to connect.",{"_3634":34,"_31209":15,"_21628":51065,"_5":14884,"_28401":51028,"_3085":51066},[],"Start the instance and open the console at `https://<public-ip>`. Check you can authenticate before continuing.",{"_3634":35,"_31209":15,"_21628":51068,"_5":14884,"_28401":51032,"_3085":51069},[],"Continue with Create your first CA to validate the instance's cryptographic configuration.",{"_3634":36,"_31209":36,"_5":15244,"_3085":51071,"_31547":51072,"_21628":51073,"_28401":36},"Deploy Lamassu",[50999,51000],[],{"_3634":37,"_31209":36,"_21628":51075,"_5":14884,"_28401":36,"_3085":51076},[],"Choose the operating model that fits your infrastructure and control requirements.",{"_3634":38,"_31209":36,"_5":31544,"_21628":51078,"_28401":51079,"_3085":51080},[],"/docs/deployment/overview#choose-a-model","Choose a model",{"_3634":39,"_31209":36,"_5":31544,"_21628":51082,"_28401":51083,"_3085":51084},[],"/docs/deployment/overview#just-want-to-evaluate-the-platform","Just want to evaluate the platform?",{"_3634":40,"_31209":36,"_5":31544,"_21628":51086,"_28401":51087,"_3085":51088},[],"/docs/deployment/overview#after-deployment","After deployment",{"_3634":41,"_31209":36,"_21628":51090,"_5":14884,"_28401":36,"_3085":51091},[],"You can run Lamassu on your own Kubernetes cluster, deploy a prebuilt image from AWS Marketplace or consume the platform as a managed service.",{"_3634":42,"_31209":36,"_21628":51093,"_5":14884,"_28401":51079,"_3085":51094},[],"Model",{"_3634":43,"_31209":36,"_21628":51096,"_5":14884,"_28401":51079,"_3085":51097},[],"Recommended for",{"_3634":44,"_31209":36,"_21628":51099,"_5":14884,"_28401":51079,"_3085":51100},[],"Who operates the infrastructure",{"_3634":45,"_31209":36,"_21628":51102,"_5":14884,"_28401":51079,"_3085":51103},[],"Starting point",{"_3634":46,"_31209":36,"_21628":51105,"_5":14884,"_28401":51079,"_3085":51106},[],"Kubernetes self-managed",{"_3634":47,"_31209":36,"_21628":51108,"_5":14884,"_28401":51079,"_3085":51109},[],"Production, regulated environments and custom deployments",{"_3634":48,"_31209":36,"_21628":51111,"_5":14884,"_28401":51079,"_3085":51112},[],"Your team",{"_3634":49,"_31209":36,"_21628":51114,"_5":14884,"_28401":51079,"_3085":51115},[],"Helm or Fastlane",{"_3634":50,"_31209":36,"_21628":51117,"_5":14884,"_28401":51079,"_3085":51118},[],"AWS Marketplace",{"_3634":51,"_31209":36,"_21628":51120,"_5":14884,"_28401":51079,"_3085":51121},[],"Evaluation or a dedicated deployment inside an AWS account",{"_3634":52,"_31209":36,"_21628":51123,"_5":14884,"_28401":51079,"_3085":51112},[],{"_3634":53,"_31209":36,"_21628":51125,"_5":14884,"_28401":51079,"_3085":51126},[],"Preconfigured image on EC2",{"_3634":54,"_31209":36,"_21628":51128,"_5":14884,"_28401":51079,"_3085":51129},[],"SaaS",{"_3634":55,"_31209":36,"_21628":51131,"_5":14884,"_28401":51079,"_3085":51132},[],"Teams that want to use the platform without operating it",{"_3634":56,"_31209":36,"_21628":51134,"_5":14884,"_28401":51079,"_3085":51135},[],"Lamassu",{"_3634":57,"_31209":36,"_21628":51137,"_5":14884,"_28401":51079,"_3085":51138},[],"Managed subscription",{"_3634":58,"_31209":36,"_21628":51140,"_5":14884,"_28401":51079,"_3085":51141},[],"<Card title=\"Kubernetes self-managed\" description=\"Control network, storage, keys, dependencies and the upgrade cycle.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3634":59,"_31209":36,"_21628":51143,"_5":14884,"_28401":51079,"_3085":51144},[],"<Card title=\"AWS Marketplace\" description=\"Launch a preconfigured Lamassu instance on AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3634":60,"_31209":36,"_21628":51146,"_5":14884,"_28401":51079,"_3085":51147},[],"<Card title=\"Lamassu SaaS\" description=\"Use an operated and updated instance as a managed service.\" href=\"/docs/deployment/saas\" />",{"_3634":61,"_31209":36,"_21628":51149,"_5":14884,"_28401":51083,"_3085":51150},[],"Use Fastlane to bring up PostgreSQL, Keycloak, RabbitMQ and Lamassu on a Kubernetes cluster through a single flow. It is intended for labs, demos and bootstrap; for production, configure dependencies and Helm values explicitly.",{"_3634":62,"_31209":36,"_21628":51152,"_5":14884,"_28401":51087,"_3085":51153},[],"Once the console is available, continue with Create your first CA. That quickstart verifies the cryptographic engine and issuance work correctly.",{"_3634":63,"_31209":63,"_5":15244,"_3085":51155,"_31547":51156,"_21628":51157,"_28401":63},"Use Lamassu as SaaS",[50999,51000,51001],[],{"_3634":64,"_31209":63,"_21628":51159,"_5":14884,"_28401":63,"_3085":51160},[],"Consume Lamassu as a managed service without operating your own infrastructure.",{"_3634":65,"_31209":63,"_5":31544,"_21628":51162,"_28401":51163,"_3085":51164},[],"/docs/deployment/saas#what-the-service-manages","What the service manages",{"_3634":66,"_31209":63,"_5":31544,"_21628":51166,"_28401":51167,"_3085":51168},[],"/docs/deployment/saas#plans","Plans",{"_3634":67,"_31209":63,"_5":31544,"_21628":51170,"_28401":51171,"_3085":51172},[],"/docs/deployment/saas#request-access","Request access",{"_3634":68,"_31209":63,"_21628":51174,"_5":14884,"_28401":63,"_3085":51175},[],"Lamassu SaaS offers the platform's capabilities in a managed environment. It is the right option when your team wants to focus on PKI and device identities, not on maintaining the infrastructure that supports them.",{"_3634":69,"_31209":63,"_21628":51177,"_5":14884,"_28401":51163,"_3085":51178},[],"Platform availability and maintenance.",{"_3634":70,"_31209":63,"_21628":51180,"_5":14884,"_28401":51163,"_3085":51181},[],"Automatic backups.",{"_3634":71,"_31209":63,"_21628":51183,"_5":14884,"_28401":51163,"_3085":51184},[],"Version upgrades.",{"_3634":72,"_31209":63,"_21628":51186,"_5":14884,"_28401":51163,"_3085":51187},[],"Technical support and SLA according to your plan.",{"_3634":73,"_31209":63,"_21628":51189,"_5":14884,"_28401":51167,"_3085":51190},[],"Plan",{"_3634":74,"_31209":63,"_21628":51192,"_5":14884,"_28401":51167,"_3085":51193},[],"Devices",{"_3634":75,"_31209":63,"_21628":51195,"_5":14884,"_28401":51167,"_3085":51196},[],"Support",{"_3634":76,"_31209":63,"_21628":51198,"_5":14884,"_28401":51167,"_3085":51199},[],"SLA",{"_3634":77,"_31209":63,"_21628":51201,"_5":14884,"_28401":51167,"_3085":51202},[],"Starter",{"_3634":78,"_31209":63,"_21628":51204,"_5":14884,"_28401":51167,"_3085":51205},[],"Up to 1,000",{"_3634":79,"_31209":63,"_21628":51207,"_5":14884,"_28401":51167,"_3085":51208},[],"Email",{"_3634":80,"_31209":63,"_21628":51210,"_5":14884,"_28401":51167,"_3085":51211},[],"99.5 %",{"_3634":81,"_31209":63,"_21628":51213,"_5":14884,"_28401":51167,"_3085":51214},[],"Professional",{"_3634":82,"_31209":63,"_21628":51216,"_5":14884,"_28401":51167,"_3085":51217},[],"Up to 10,000",{"_3634":83,"_31209":63,"_21628":51219,"_5":14884,"_28401":51167,"_3085":51220},[],"Email and chat",{"_3634":84,"_31209":63,"_21628":51222,"_5":14884,"_28401":51167,"_3085":51223},[],"99.9 %",{"_3634":85,"_31209":63,"_21628":51225,"_5":14884,"_28401":51167,"_3085":51226},[],"Enterprise",{"_3634":86,"_31209":63,"_21628":51228,"_5":14884,"_28401":51167,"_3085":51229},[],"Unlimited",{"_3634":87,"_31209":63,"_21628":51231,"_5":14884,"_28401":51167,"_3085":51232},[],"Dedicated",{"_3634":88,"_31209":63,"_21628":51234,"_5":14884,"_28401":51167,"_3085":51235},[],"99.99 %",{"_3634":89,"_31209":63,"_21628":51237,"_5":14884,"_28401":51171,"_3085":51238},[],"Contact the Lamassu team through lamassu.io to request a demo or choose a plan.",{"_3634":90,"_31209":63,"_21628":51240,"_5":14884,"_28401":51171,"_3085":51241},[],"When you receive your instance's credentials, continue with Get started.",{"_3634":91,"_31209":91,"_5":15244,"_3085":51243,"_31547":51244,"_21628":51245,"_28401":91},"Fastlane",[50999,51000,51106],[],{"_3634":92,"_31209":91,"_21628":51247,"_5":14884,"_28401":91,"_3085":51248},[],"Bootstrap a complete Lamassu evaluation or lab environment on an existing Kubernetes cluster.",{"_3634":93,"_31209":91,"_5":31544,"_21628":51250,"_28401":51251,"_3085":51252},[],"/docs/deployment/self-hosted/fastlane#deploy-with-fastlane","Deploy with Fastlane",{"_3634":94,"_31209":91,"_5":31544,"_21628":51254,"_28401":51255,"_3085":51256},[],"/docs/deployment/self-hosted/fastlane#what-fastlane-adds","What Fastlane adds",{"_3634":95,"_31209":91,"_5":31544,"_21628":51258,"_28401":51259,"_3085":51009},[],"/docs/deployment/self-hosted/fastlane#before-you-begin",{"_3634":96,"_31209":91,"_5":31544,"_21628":51261,"_28401":51262,"_3085":51263},[],"/docs/deployment/self-hosted/fastlane#quick-start","Quick start",{"_3634":97,"_31209":91,"_5":31544,"_21628":51265,"_28401":51266,"_3085":51267},[],"/docs/deployment/self-hosted/fastlane#gateway-address-selection","Gateway address selection",{"_3634":98,"_31209":91,"_5":31544,"_21628":51269,"_28401":51270,"_3085":51271},[],"/docs/deployment/self-hosted/fastlane#command-line-options","Command-line options",{"_3634":99,"_31209":91,"_5":31544,"_21628":51273,"_28401":51274,"_3085":51275},[],"/docs/deployment/self-hosted/fastlane#development-mode","Development mode",{"_3634":100,"_31209":91,"_5":31544,"_21628":51277,"_28401":51278,"_3085":51279},[],"/docs/deployment/self-hosted/fastlane#what-the-script-configures","What the script configures",{"_3634":101,"_31209":91,"_5":31544,"_21628":51281,"_28401":51282,"_3085":51283},[],"/docs/deployment/self-hosted/fastlane#tls-behavior","TLS behavior",{"_3634":102,"_31209":91,"_5":31544,"_21628":51285,"_28401":51286,"_3085":51287},[],"/docs/deployment/self-hosted/fastlane#credentials-and-generated-files","Credentials and generated files",{"_3634":103,"_31209":91,"_5":31544,"_21628":51289,"_28401":51290,"_3085":51291},[],"/docs/deployment/self-hosted/fastlane#verify-the-installation","Verify the installation",{"_3634":104,"_31209":91,"_21628":51293,"_5":14884,"_28401":51251,"_3085":51294},[],"Fastlane is the automated path for evaluations, demos, CI and small lab clusters. It installs PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu, then configures them to work together.",{"_3634":105,"_31209":91,"_21628":51296,"_5":14884,"_28401":51251,"_3085":51297},[],"For production, use Helm so database, identity, credentials, certificates, storage and upgrades remain explicit.",{"_3634":106,"_31209":91,"_21628":51299,"_5":14884,"_28401":51255,"_3085":51300},[],"Fastlane closes some of the gaps intentionally left by the application chart:",{"_3634":107,"_31209":91,"_21628":51302,"_5":14884,"_28401":51255,"_3085":51303},[],"Fastlane installs or configures",{"_3634":108,"_31209":91,"_21628":51305,"_5":14884,"_28401":51255,"_3085":51306},[],"You still provide",{"_3634":109,"_31209":91,"_21628":51308,"_5":14884,"_28401":51255,"_3085":51309},[],"PostgreSQL, RabbitMQ and Keycloak instances for evaluation",{"_3634":110,"_31209":91,"_21628":51311,"_5":14884,"_28401":51255,"_3085":51312},[],"The Kubernetes cluster, nodes and persistent storage",{"_3634":111,"_31209":91,"_21628":51314,"_5":14884,"_28401":51255,"_3085":51315},[],"Envoy Gateway 1.8 and the `eg` `GatewayClass`",{"_3634":112,"_31209":91,"_21628":51317,"_5":14884,"_28401":51255,"_3085":51318},[],"cert-manager, external network reachability, DNS and firewall/NAT rules",{"_3634":113,"_31209":91,"_21628":51320,"_5":14884,"_28401":51255,"_3085":51321},[],"A self-signed Lamassu certificate flow, dependency credentials stored in Kubernetes Secrets (through the External Secrets Operator) and an initial user",{"_3634":114,"_31209":91,"_21628":51323,"_5":14884,"_28401":51255,"_3085":51324},[],"Client trust for the self-signed CA, or a trusted certificate passed to the script",{"_3634":115,"_31209":91,"_21628":51326,"_5":14884,"_28401":51255,"_3085":51327},[],"Optional observability and lab HSM components",{"_3634":116,"_31209":91,"_21628":51329,"_5":14884,"_28401":51255,"_3085":51330},[],"Production monitoring retention, backups, HA and a production HSM/key service",{"_3634":117,"_31209":91,"_21628":51332,"_5":14884,"_28401":51255,"_3085":51333},[],"Fastlane does not turn the resulting stack into a production service: it does not create the cluster, public DNS, firewall rules, backups, high availability or a trusted public certificate.",{"_3634":118,"_31209":91,"_21628":51335,"_5":14884,"_28401":51259,"_3085":51336},[],"You need:",{"_3634":119,"_31209":91,"_21628":51338,"_5":14884,"_28401":51259,"_3085":51339},[],"an existing Kubernetes cluster",{"_3634":120,"_31209":91,"_21628":51341,"_5":14884,"_28401":51259,"_3085":51342},[],"`kubectl` and Helm, or the MicroK8s CLI",{"_3634":121,"_31209":91,"_21628":51344,"_5":14884,"_28401":51259,"_3085":51345},[],"`yq`",{"_3634":122,"_31209":91,"_21628":51347,"_5":14884,"_28401":51259,"_3085":24441},[],{"_3634":123,"_31209":91,"_21628":51349,"_5":14884,"_28401":51259,"_3085":51350},[],"`jq` only when using `--sample-data` or `--development`",{"_3634":124,"_31209":91,"_21628":51352,"_5":14884,"_28401":51259,"_3085":51353},[],"`ssh-keygen` only when using `--with-hsm`",{"_3634":125,"_31209":91,"_21628":51355,"_5":14884,"_28401":51259,"_3085":51356},[],"free external ports 80 and 443 on a single-node K3s host",{"_3634":126,"_31209":91,"_21628":51358,"_5":14884,"_28401":51259,"_3085":51359},[],"Fastlane detects MicroK8s, K3s, kind or a standard kubeconfig. Use `--context` when the intended cluster is not the current context.",{"_3634":127,"_31209":91,"_21628":51361,"_5":14884,"_28401":51259,"_3085":51362},[],"Fastlane installs several components and creates credentials. Check `kubectl config current-context` or pass `--context` before running it.",{"_3634":128,"_31209":91,"_21628":51364,"_5":14884,"_28401":51262,"_3085":51365},[],"Run the script from a clone of the Helm repository:",{"_3634":129,"_31209":91,"_21628":51367,"_5":14884,"_28401":51262,"_3085":51368},[],"Create a DNS record for the chosen domain before testing from another machine. For a small VM, point it at the VM or load-balancer address that actually receives ports 80 and 443.",{"_3634":130,"_31209":91,"_21628":51370,"_5":14884,"_28401":51266,"_3085":51371},[],"By default, Fastlane runs `hostname -I` and writes the returned addresses to `gateway.addresses` and to the self-signed certificate's IP SANs.",{"_3634":131,"_31209":91,"_21628":51373,"_5":14884,"_28401":51266,"_3085":51374},[],"On a single-homed lab VM this can select the expected node address. On hosts with Docker, VPN, WireGuard or several interfaces it can also select addresses clients cannot reach. Override the result explicitly:",{"_3634":132,"_31209":91,"_21628":51376,"_5":14884,"_28401":51266,"_3085":51377},[],"The value must be an address handled on the Kubernetes side of the traffic path. If a public EC2 address forwards through WireGuard to the cluster, pass the reachable cluster/VM address, not the EC2 public address.",{"_3634":133,"_31209":91,"_21628":51379,"_5":14884,"_28401":51266,"_3085":51380},[],"See Expose the Gateway for K3s port conflicts, VIPs, external NAT and multi-Gateway designs.",{"_3634":134,"_31209":91,"_21628":51382,"_5":14884,"_28401":51270,"_3085":51383},[],"Option",{"_3634":135,"_31209":91,"_21628":51385,"_5":14884,"_28401":51270,"_3085":51386},[],"Default",{"_3634":136,"_31209":91,"_21628":51388,"_5":14884,"_28401":51270,"_3085":51389},[],"Purpose",{"_3634":137,"_31209":91,"_21628":51391,"_5":14884,"_28401":51270,"_3085":51392},[],"`-h`, `--help`",{"_3634":138,"_31209":91,"_21628":51394,"_5":14884,"_28401":51270,"_3085":51395},[],"—",{"_3634":139,"_31209":91,"_21628":51397,"_5":14884,"_28401":51270,"_3085":51398},[],"Show help",{"_3634":140,"_31209":91,"_21628":51400,"_5":14884,"_28401":51270,"_3085":51401},[],"`-c`, `--context`",{"_3634":141,"_31209":91,"_21628":51403,"_5":14884,"_28401":51270,"_3085":51404},[],"current context",{"_3634":142,"_31209":91,"_21628":51406,"_5":14884,"_28401":51270,"_3085":51407},[],"Select the kubeconfig context for kubectl and Helm",{"_3634":143,"_31209":91,"_21628":51409,"_5":14884,"_28401":51270,"_3085":51410},[],"`-n`, `--non-interactive`",{"_3634":144,"_31209":91,"_21628":51412,"_5":14884,"_28401":51270,"_3085":6806},[],{"_3634":145,"_31209":91,"_21628":51414,"_5":14884,"_28401":51270,"_3085":51415},[],"Skip prompts and generate dependency credentials",{"_3634":146,"_31209":91,"_21628":51417,"_5":14884,"_28401":51270,"_3085":51418},[],"`-ns`, `--namespace`",{"_3634":147,"_31209":91,"_21628":51420,"_5":14884,"_28401":51270,"_3085":51421},[],"`lamassu-dev`",{"_3634":148,"_31209":91,"_21628":51423,"_5":14884,"_28401":51270,"_3085":51424},[],"Namespace for the installation",{"_3634":149,"_31209":91,"_21628":51426,"_5":14884,"_28401":51270,"_3085":51427},[],"`-d`, `--domain`",{"_3634":150,"_31209":91,"_21628":51429,"_5":14884,"_28401":51270,"_3085":51430},[],"`dev.lamassu.io`",{"_3634":151,"_31209":91,"_21628":51432,"_5":14884,"_28401":51270,"_3085":51433},[],"Domain used by the UI, OIDC and certificate",{"_3634":152,"_31209":91,"_21628":51435,"_5":14884,"_28401":51270,"_3085":51436},[],"`-v`, `--version`",{"_3634":153,"_31209":91,"_21628":51438,"_5":14884,"_28401":51270,"_3085":15596},[],{"_3634":154,"_31209":91,"_21628":51440,"_5":14884,"_28401":51270,"_3085":51441},[],"Lamassu chart version",{"_3634":155,"_31209":91,"_21628":51443,"_5":14884,"_28401":51270,"_3085":51444},[],"`--https-port`",{"_3634":156,"_31209":91,"_21628":51446,"_5":14884,"_28401":51270,"_3085":51447},[],"`443`",{"_3634":157,"_31209":91,"_21628":51449,"_5":14884,"_28401":51270,"_3085":51450},[],"Gateway HTTPS listener port",{"_3634":158,"_31209":91,"_21628":51452,"_5":14884,"_28401":51270,"_3085":51453},[],"`--http-port`",{"_3634":159,"_31209":91,"_21628":51455,"_5":14884,"_28401":51270,"_3085":51456},[],"`80`",{"_3634":160,"_31209":91,"_21628":51458,"_5":14884,"_28401":51270,"_3085":51459},[],"Gateway HTTP listener port",{"_3634":161,"_31209":91,"_21628":51461,"_5":14884,"_28401":51270,"_3085":51462},[],"`--tls-crt`",{"_3634":162,"_31209":91,"_21628":51464,"_5":14884,"_28401":51270,"_3085":51395},[],{"_3634":163,"_31209":91,"_21628":51466,"_5":14884,"_28401":51270,"_3085":51467},[],"PEM certificate for downstream TLS",{"_3634":164,"_31209":91,"_21628":51469,"_5":14884,"_28401":51270,"_3085":51470},[],"`--tls-key`",{"_3634":165,"_31209":91,"_21628":51472,"_5":14884,"_28401":51270,"_3085":51395},[],{"_3634":166,"_31209":91,"_21628":51474,"_5":14884,"_28401":51270,"_3085":51475},[],"PEM private key for downstream TLS",{"_3634":167,"_31209":91,"_21628":51477,"_5":14884,"_28401":51270,"_3085":51478},[],"`-l`, `--local-chart-path`",{"_3634":168,"_31209":91,"_21628":51480,"_5":14884,"_28401":51270,"_3085":51481},[],"repository chart",{"_3634":169,"_31209":91,"_21628":51483,"_5":14884,"_28401":51270,"_3085":51484},[],"Use an unpacked local Lamassu chart",{"_3634":170,"_31209":91,"_21628":51486,"_5":14884,"_28401":51270,"_3085":51487},[],"`-ip`, `--gateway-ip`",{"_3634":171,"_31209":91,"_21628":51489,"_5":14884,"_28401":51270,"_3085":9102},[],{"_3634":172,"_31209":91,"_21628":51491,"_5":14884,"_28401":51270,"_3085":51492},[],"Override the address written to `gateway.addresses`",{"_3634":173,"_31209":91,"_21628":51494,"_5":14884,"_28401":51270,"_3085":51495},[],"`--otel`",{"_3634":174,"_31209":91,"_21628":51497,"_5":14884,"_28401":51270,"_3085":6806},[],{"_3634":175,"_31209":91,"_21628":51499,"_5":14884,"_28401":51270,"_3085":51500},[],"Install Victoria Logs, VictoriaTraces, Jaeger and an OpenTelemetry Collector",{"_3634":176,"_31209":91,"_21628":51502,"_5":14884,"_28401":51270,"_3085":51503},[],"`--development`",{"_3634":177,"_31209":91,"_21628":51505,"_5":14884,"_28401":51270,"_3085":6806},[],{"_3634":178,"_31209":91,"_21628":51507,"_5":14884,"_28401":51270,"_3085":51508},[],"Development mode: fully provisions the Keycloak `lamassu` user (fixed `lamassu`/`lamassu` password, no first-login steps) and lets the `frontend` client accept any redirect URI or web origin. Not for production",{"_3634":179,"_31209":91,"_21628":51510,"_5":14884,"_28401":51270,"_3085":51511},[],"`--sample-data`",{"_3634":180,"_31209":91,"_21628":51513,"_5":14884,"_28401":51270,"_3085":6806},[],{"_3634":181,"_31209":91,"_21628":51515,"_5":14884,"_28401":51270,"_3085":51516},[],"Create sample CAs, profiles, certificates, DMS data and devices",{"_3634":182,"_31209":91,"_21628":51518,"_5":14884,"_28401":51270,"_3085":51519},[],"`--with-hsm`",{"_3634":183,"_31209":91,"_21628":51521,"_5":14884,"_28401":51270,"_3085":6806},[],{"_3634":184,"_31209":91,"_21628":51523,"_5":14884,"_28401":51270,"_3085":51524},[],"Install lab HSM components and configure KMS for PKCS#11",{"_3634":185,"_31209":91,"_21628":51526,"_5":14884,"_28401":51270,"_3085":51527},[],"`--softhsm-chart-path`",{"_3634":186,"_31209":91,"_21628":51529,"_5":14884,"_28401":51270,"_3085":51530},[],"`./charts/softhsm`",{"_3634":187,"_31209":91,"_21628":51532,"_5":14884,"_28401":51270,"_3085":51533},[],"Use a different local SoftHSM chart",{"_3634":188,"_31209":91,"_21628":51535,"_5":14884,"_28401":51270,"_3085":51536},[],"Fastlane does not provide an offline mode. Use the manual Helm workflow and a prepared registry/chart mirror for disconnected environments.",{"_3634":189,"_31209":91,"_21628":51538,"_5":14884,"_28401":51274,"_3085":51539},[],"`--development` adjusts the Keycloak `lamassu` realm generated by Fastlane for a disposable evaluation environment:",{"_3634":190,"_31209":91,"_21628":51541,"_5":14884,"_28401":51274,"_3085":51542},[],"the `lamassu` user is fully provisioned (first name Lamassu, last name Admin, email `lamassu@lamassu.io`, verified): there are no profile setup or password change steps on first login",{"_3634":191,"_31209":91,"_21628":51544,"_5":14884,"_28401":51274,"_3085":51545},[],"the well-known `lamassu`/`lamassu` password is fixed and permanent: it is never rotated and grants the `pki-admin` role, including non-interactive tokens through the `frontend` client",{"_3634":192,"_31209":91,"_21628":51547,"_5":14884,"_28401":51274,"_3085":51548},[],"the `frontend` client accepts any redirect URI and any web origin (`*`) instead of the original `/*` patterns",{"_3634":193,"_31209":91,"_21628":51550,"_5":14884,"_28401":51274,"_3085":51551},[],"With `--development`, the fixed `lamassu`/`lamassu` password grants `pki-admin` access to anyone who can reach the installation. Never use it on anything exposed beyond a development machine or a network-reachable host.",{"_3634":194,"_31209":91,"_21628":51553,"_5":14884,"_28401":51274,"_3085":51554},[],"`--development` applies when the `lamassu` realm is first imported. It does not modify an existing cluster. It can be combined with `--sample-data`: the development transform runs first, then sample data is added to the same realm configuration.",{"_3634":195,"_31209":91,"_21628":51556,"_5":14884,"_28401":51278,"_3085":51557},[],"Fastlane:",{"_3634":196,"_31209":91,"_21628":51559,"_5":14884,"_28401":51278,"_3085":51560},[],"validates local tools and the selected cluster",{"_3634":197,"_31209":91,"_21628":51562,"_5":14884,"_28401":51278,"_3085":51563},[],"installs or upgrades Envoy Gateway 1.8 and creates the `eg` `GatewayClass`",{"_3634":198,"_31209":91,"_21628":51565,"_5":14884,"_28401":51278,"_3085":51566},[],"creates the namespace",{"_3634":199,"_31209":91,"_21628":51568,"_5":14884,"_28401":51278,"_3085":51569},[],"installs the External Secrets Operator and creates the PostgreSQL, RabbitMQ and Keycloak administrator credentials as Secrets through a Fake `ClusterSecretStore`",{"_3634":200,"_31209":91,"_21628":51571,"_5":14884,"_28401":51278,"_3085":51572},[],"installs PostgreSQL and creates the required databases",{"_3634":201,"_31209":91,"_21628":51574,"_5":14884,"_28401":51278,"_3085":51575},[],"installs Keycloak and creates the `lamassu` realm, frontend client, admin role and initial user",{"_3634":202,"_31209":91,"_21628":51577,"_5":14884,"_28401":51278,"_3085":51578},[],"installs RabbitMQ",{"_3634":203,"_31209":91,"_21628":51580,"_5":14884,"_28401":51278,"_3085":51581},[],"optionally installs observability and lab HSM components",{"_3634":204,"_31209":91,"_21628":51583,"_5":14884,"_28401":51278,"_3085":51584},[],"generates `lamassu.yaml`, which references the Secrets instead of inline credentials, and installs the Lamassu chart",{"_3634":205,"_31209":91,"_21628":51586,"_5":14884,"_28401":51278,"_3085":51587},[],"optionally loads sample data",{"_3634":206,"_31209":91,"_21628":51589,"_5":14884,"_28401":51278,"_3085":51590},[],"The generated configuration exposes Keycloak at `/auth` through the same Gateway and bootstraps the initial `lamassu` user as a Lamassu super administrator.",{"_3634":207,"_31209":91,"_21628":51592,"_5":14884,"_28401":51282,"_3085":51593},[],"With both `--tls-crt` and `--tls-key`, Fastlane creates the `downstream-provided-crt` Secret and configures `tls.type: external`.",{"_3634":208,"_31209":91,"_21628":51595,"_5":14884,"_28401":51282,"_3085":51596},[],"Without them, it configures cert-manager with a self-signed issuer. This is suitable for a lab but will not be trusted by clients until you distribute the CA. Use Helm when you need a corporate Issuer, public ACME issuer or an existing Secret managed by another system.",{"_3634":209,"_31209":91,"_21628":51598,"_5":14884,"_28401":51286,"_3085":51599},[],"Non-interactive mode generates random PostgreSQL, RabbitMQ and Keycloak administrator passwords and stores them in Kubernetes Secrets through the External Secrets Operator's Fake `ClusterSecretStore`. Fastlane writes `lamassu.yaml` in the current directory referencing those Secrets — the values file no longer contains the credentials.",{"_3634":210,"_31209":91,"_21628":51601,"_5":14884,"_28401":51286,"_3085":51602},[],"The Keycloak administrator password is not printed by the script. Retrieve it from the Secret when needed:",{"_3634":211,"_31209":91,"_21628":51604,"_5":14884,"_28401":51286,"_3085":51605},[],"The initial Lamassu login is `lamassu` / `lamassu` and requires a password change on first use, unless `--development` was used: in that case the password stays fixed and permanent.",{"_3634":212,"_31209":91,"_21628":51607,"_5":14884,"_28401":51286,"_3085":51608},[],"The Fake `ClusterSecretStore` stores the credentials in plain text and is for lab use only: replace it with a real ESO provider for anything beyond a throwaway environment. Protect the generated values file, record the generated credentials in an appropriate secret store and do not reuse the evaluation identity setup in production.",{"_3634":213,"_31209":91,"_21628":51610,"_5":14884,"_28401":51290,"_3085":51611},[],"Then open `https://pki.example.com` and sign in with the initial user. If the Gateway is programmed but the URL is unreachable, follow the checks in Expose the Gateway.",{"_3634":214,"_31209":214,"_5":15244,"_3085":51613,"_31547":51614,"_21628":51615,"_28401":214},"Install with Helm",[50999,51000,51106],[],{"_3634":215,"_31209":214,"_21628":51617,"_5":14884,"_28401":214,"_3085":51618},[],"Prepare dependencies, configure the Lamassu chart and verify a controlled Kubernetes deployment.",{"_3634":216,"_31209":214,"_5":31544,"_21628":51620,"_28401":51621,"_3085":51622},[],"/docs/deployment/self-hosted/helm#install-lamassu-with-helm","Install Lamassu with Helm",{"_3634":217,"_31209":214,"_5":31544,"_21628":51624,"_28401":51625,"_3085":51009},[],"/docs/deployment/self-hosted/helm#before-you-begin",{"_3634":218,"_31209":214,"_5":31544,"_21628":51627,"_28401":51628,"_3085":51629},[],"/docs/deployment/self-hosted/helm#1-install-the-gateway-prerequisites","1\\. Install the Gateway prerequisites",{"_3634":219,"_31209":214,"_5":31544,"_21628":51631,"_28401":51632,"_3085":51633},[],"/docs/deployment/self-hosted/helm#2-create-a-values-file","2\\. Create a values file",{"_3634":220,"_31209":214,"_5":31544,"_21628":51635,"_28401":51636,"_3085":51637},[],"/docs/deployment/self-hosted/helm#credentials-in-kubernetes-secrets","Credentials in Kubernetes Secrets",{"_3634":221,"_31209":214,"_5":31544,"_21628":51639,"_28401":51640,"_3085":51641},[],"/docs/deployment/self-hosted/helm#tls-with-an-existing-secret","TLS with an existing Secret",{"_3634":222,"_31209":214,"_5":31544,"_21628":51643,"_28401":51644,"_3085":51645},[],"/docs/deployment/self-hosted/helm#amqp-tls-amqps","AMQP TLS (AMQPS)",{"_3634":223,"_31209":214,"_5":31544,"_21628":51647,"_28401":51648,"_3085":51649},[],"/docs/deployment/self-hosted/helm#provision-the-first-administrator","Provision the first administrator",{"_3634":224,"_31209":214,"_5":31544,"_21628":51651,"_28401":51652,"_3085":51653},[],"/docs/deployment/self-hosted/helm#3-install-lamassu","3\\. Install Lamassu",{"_3634":225,"_31209":214,"_5":31544,"_21628":51655,"_28401":51656,"_3085":51657},[],"/docs/deployment/self-hosted/helm#4-verify-the-deployment","4\\. Verify the deployment",{"_3634":226,"_31209":214,"_5":31544,"_21628":51659,"_28401":51660,"_3085":51661},[],"/docs/deployment/self-hosted/helm#upgrading-lamassu","Upgrading Lamassu",{"_3634":227,"_31209":214,"_5":31544,"_21628":51663,"_28401":51664,"_3085":51665},[],"/docs/deployment/self-hosted/helm#production-decisions","Production decisions",{"_3634":228,"_31209":214,"_21628":51667,"_5":14884,"_28401":51621,"_3085":51668},[],"Use the Helm workflow when you need explicit control over identity, databases, messaging, certificates, storage and upgrades. For an evaluation environment where the script can make those choices for you, use Fastlane.",{"_3634":229,"_31209":214,"_21628":51670,"_5":14884,"_28401":51625,"_3085":51671},[],"Prepare the platform services that are deliberately outside the Lamassu chart:",{"_3634":230,"_31209":214,"_21628":51673,"_5":14884,"_28401":51625,"_3085":51674},[],"a Kubernetes 1.24+ cluster and Helm 3.2+",{"_3634":231,"_31209":214,"_21628":51676,"_5":14884,"_28401":51625,"_3085":51677},[],"a reachable PostgreSQL server and a role allowed to create databases and schemas",{"_3634":232,"_31209":214,"_21628":51679,"_5":14884,"_28401":51625,"_3085":51680},[],"a reachable RabbitMQ broker and credentials",{"_3634":233,"_31209":214,"_21628":51682,"_5":14884,"_28401":51625,"_3085":51683},[],"Kubernetes Secrets in the release namespace holding the PostgreSQL and RabbitMQ credentials (and SMTP credentials when SMTP authentication is required) — the chart reads credentials from Secrets and rejects inline values (see Credentials in Kubernetes Secrets)",{"_3634":234,"_31209":214,"_21628":51685,"_5":14884,"_28401":51625,"_3085":51686},[],"an OIDC provider, normally Keycloak, with a realm/tenant and client for Lamassu",{"_3634":235,"_31209":214,"_21628":51688,"_5":14884,"_28401":51625,"_3085":51689},[],"Envoy Gateway 1.8+ and a `GatewayClass`",{"_3634":236,"_31209":214,"_21628":51691,"_5":14884,"_28401":51625,"_3085":51692},[],"cert-manager 1.14+ (only for the default `tls.type: certManager` mode); for trusted TLS, either a trusted issuer or a Kubernetes TLS Secret",{"_3634":237,"_31209":214,"_21628":51694,"_5":14884,"_28401":51625,"_3085":51695},[],"a StorageClass and an external traffic design",{"_3634":238,"_31209":214,"_21628":51697,"_5":14884,"_28401":51625,"_3085":51698},[],"The chart defaults to a `GatewayClass` named `eg`. Change `gateway.className` if your platform team uses another name.",{"_3634":239,"_31209":214,"_21628":51700,"_5":14884,"_28401":51625,"_3085":51701},[],"You provide the PostgreSQL server. The chart's pre-install job connects with the supplied credentials, creates the required `pki`, `authz` and `wfx` databases and service schemas, runs migrations, and applies `services.authz.bootstrap`.",{"_3634":240,"_31209":214,"_21628":51703,"_5":14884,"_28401":51625,"_3085":51704},[],"The chart has no Helm dependencies that install PostgreSQL, RabbitMQ, an OIDC provider, Envoy Gateway or cert-manager.",{"_3634":241,"_31209":214,"_21628":51706,"_5":14884,"_28401":51628,"_3085":51707},[],"Install or upgrade the Envoy Gateway CRDs before its controller. The commands below match the version used by the Lamassu Helm repository:",{"_3634":242,"_31209":214,"_21628":51709,"_5":14884,"_28401":51628,"_3085":51710},[],"Create the default `GatewayClass` if it does not already exist. Save this manifest as `gateway-class.yaml`:",{"_3634":243,"_31209":214,"_21628":51712,"_5":14884,"_28401":51628,"_3085":51713},[],"Install cert-manager separately before Lamassu, but only for the default `tls.type: certManager` mode. In that mode the chart renders its self-signed Issuer and CA Certificate resources regardless of whether `tls.certManagerOptions.clusterIssuer` is set, so cert-manager stays a prerequisite. With `tls.type: external`, the chart renders no cert-manager resources and the Gateway terminates TLS with an existing Secret you provide instead.",{"_3634":244,"_31209":214,"_21628":51715,"_5":14884,"_28401":51632,"_3085":51716},[],"Start with the chart defaults and override the environment-specific values. This example assumes PostgreSQL, RabbitMQ and Keycloak are reachable through Kubernetes DNS, and exposes Keycloak at `/auth` through the shared Lamassu Gateway:",{"_3634":245,"_31209":214,"_21628":51718,"_5":14884,"_28401":51632,"_3085":51719},[],"Do not add `gateway.addresses` by default. Leave address assignment to the load-balancer implementation unless your network design requires a specific Kubernetes-side VIP. The public IP of an upstream NAT gateway or reverse proxy does not belong in this value.",{"_3634":246,"_31209":214,"_21628":51721,"_5":14884,"_28401":51632,"_3085":51722},[],"If Keycloak is external and already has its own reachable URL, point the OIDC settings at it and omit the `/auth` entry from `gateway.extraRouting`.",{"_3634":247,"_31209":214,"_21628":51724,"_5":14884,"_28401":51632,"_3085":51725},[],"If your values file still carries the legacy gateway JWT validation settings — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` or `auth.authorization.roles.admin` — remove them. The migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documents their removal with no compatibility aliases, and `values.schema.json` rejects the leftover blocks instead of silently ignoring them. The replacements are `services.authz.jwkUrl` and `services.authz.bootstrap`, already shown in the example above.",{"_3634":248,"_31209":214,"_21628":51727,"_5":14884,"_28401":51636,"_3085":51728},[],"The chart reads the PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace. Reference them with `existingSecret` plus the `usernameKey` and `passwordKey` data keys; inline `username` and `password` values are removed and rejected by `values.schema.json`.",{"_3634":249,"_31209":214,"_21628":51730,"_5":14884,"_28401":51636,"_3085":51731},[],"The Secrets must exist before you install or upgrade: the pre-install and pre-upgrade migration job connects to PostgreSQL with the PostgreSQL Secret, and the service containers read the AMQP and SMTP credentials when they start.",{"_3634":250,"_31209":214,"_21628":51733,"_5":14884,"_28401":51636,"_3085":51734},[],"`postgres.existingSecret` (default `lamassu-postgres`) and `amqp.existingSecret` (default `lamassu-amqp`) are always required.",{"_3634":251,"_31209":214,"_21628":51736,"_5":14884,"_28401":51636,"_3085":51737},[],"`services.alerts.smtp_server.existingSecret` is empty by default, which means SMTP without authentication. Set it, together with its key names, only when your SMTP server requires authentication.",{"_3634":252,"_31209":214,"_21628":51739,"_5":14884,"_28401":51636,"_3085":51740},[],"Each `services.authz.credentials` entry names its `database` and uses the global PostgreSQL Secret — `postgres.existingSecret` with its configured key names — unless the entry sets its own `existingSecret`.",{"_3634":253,"_31209":214,"_21628":51742,"_5":14884,"_28401":51636,"_3085":51743},[],"Changing a Secret's contents does not roll the pods that consume it: the services read the credentials when they start. Restart the affected pods after rotating a credential.",{"_3634":254,"_31209":214,"_21628":51745,"_5":14884,"_28401":51636,"_3085":51746},[],"For production, manage the Secrets with the External Secrets Operator (ESO), which the chart does not install. The `charts/lamassu/README.md` in the Helm repository documents a complete working example in its *Secret management* section: installing external-secrets 0.20.2, a test `ClusterSecretStore`, the `ExternalSecret` resources and the wait before installing the chart. Its Fake provider is for testing only — replace it with your provider's configuration for anything beyond a throwaway environment; AWS Secrets Manager, Vault, Azure Key Vault, GCP Secret Manager and other providers are documented at external-secrets.io.",{"_3634":255,"_31209":214,"_21628":51748,"_5":14884,"_28401":51636,"_3085":51749},[],"Only these credentials moved into Secrets: other values, such as connector and crypto-engine settings, are still configured through the values file.",{"_3634":256,"_31209":214,"_21628":51751,"_5":14884,"_28401":51640,"_3085":51752},[],"Create a Secret containing `tls.crt` and `tls.key`, then reference it. The Secret must already exist before installing: in `external` mode the chart renders no cert-manager resources and never creates this Secret.",{"_3634":257,"_31209":214,"_21628":51754,"_5":14884,"_28401":51644,"_3085":51755},[],"`amqp.tls: true` selects AMQPS in every event-bus configuration block. The default port stays `5672` and does not change automatically when TLS is enabled, so set `amqp.port` to the broker's TLS listener, commonly `5671`.",{"_3634":258,"_31209":214,"_21628":51757,"_5":14884,"_28401":51644,"_3085":51758},[],"With no CA Secret configured, the event-bus clients use the system-trusted CAs. To trust a private CA, create a Secret in the release namespace containing the CA certificate in PEM format and set `amqp.ca.secretName` (and `amqp.ca.certificateKey` if the data key is not `ca.crt`).",{"_3634":259,"_31209":214,"_21628":51760,"_5":14884,"_28401":51644,"_3085":51761},[],"For brokers that require mutual TLS, create a Secret containing the client certificate and private key and set `amqp.client.secretName` (with `amqp.client.certificateKey` and `amqp.client.privateKeyKey` if the data keys are not `tls.crt` and `tls.key`).",{"_3634":260,"_31209":214,"_21628":51763,"_5":14884,"_28401":51644,"_3085":51764},[],"The chart mounts configured Secrets read-only into every AMQP-consuming workload: the CA certificate under `/etc/lamassu/amqp/ca` and the client certificate and key under `/etc/lamassu/amqp/client`. The mounted file names are always `ca.crt`, `tls.crt` and `tls.key` — the `certificateKey` and `privateKeyKey` values rename only the Secret data keys, never the on-disk paths. The client private key is mounted with restrictive permissions (`defaultMode: 0440`; the CA volume uses `0444`), which works because the chart adds `fsGroup` to the pod security context when `amqp.client.secretName` is set — the chart's default pod security context already sets `fsGroup: 65532` for every service pod, so this top-up applies only when an explicit `podSecurityContext` without `fsGroup` was overridden and an AMQP client Secret is configured — and it uses the container `runAsGroup` (default `65532`) when `fsGroup` is not already set.",{"_3634":261,"_31209":214,"_21628":51766,"_5":14884,"_28401":51644,"_3085":51767},[],"Both Secret options require `amqp.tls: true`: `values.schema.json` rejects a non-empty `secretName` when `tls` is false, rejects unknown keys and rejects data-key names outside `^[A-Za-z0-9._-]+$`. The referenced Secret must exist in the release namespace or the consuming pods fail to start.",{"_3634":262,"_31209":214,"_21628":51769,"_5":14884,"_28401":51644,"_3085":51770},[],"The AMQP client loads certificates at startup, so restart the consuming pods after updating either Secret. Changing any `amqp` value rolls the consuming pods through the `checksum/config` annotation, but a change to Secret content alone does not trigger a rollout.",{"_3634":263,"_31209":214,"_21628":51772,"_5":14884,"_28401":51644,"_3085":51773},[],"Per the migration guide `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: in 3.8.0 `amqp.tls` was not applied and event-bus clients used plaintext AMQP; from 4.0.0, `amqp.tls: true` switches them to AMQPS. Set `amqp.port` to the broker TLS listener before upgrading, or set `amqp.tls: false` to keep plaintext AMQP. `amqp.tls: false` sends the broker credentials and all event-bus traffic in cleartext.",{"_3634":264,"_31209":214,"_21628":51775,"_5":14884,"_28401":51648,"_3085":51776},[],"There is no implicit superuser. Create the role or group expected by `services.authz.bootstrap` in the OIDC provider and assign it to at least one administrator before exposing Lamassu.",{"_3634":265,"_31209":214,"_21628":51778,"_5":14884,"_28401":51648,"_3085":51779},[],"The pre-install and pre-upgrade job applies the bootstrap idempotently: existing principals are preserved and missing grants are added.",{"_3634":266,"_31209":214,"_21628":51781,"_5":14884,"_28401":51648,"_3085":51782},[],"Test both an authorized identity and a denied identity. If no token matches an active bootstrap principal, nobody can administer the PKI.",{"_3634":267,"_31209":214,"_21628":51784,"_5":14884,"_28401":51648,"_3085":51785},[],"See Access control for the principal and policy model.",{"_3634":268,"_31209":214,"_21628":51787,"_5":14884,"_28401":51652,"_3085":51788},[],"To install a local checkout instead:",{"_3634":269,"_31209":214,"_21628":51790,"_5":14884,"_28401":51656,"_3085":51791},[],"The Gateway should report `PROGRAMMED=True`. If it is programmed but has no usable address, continue with Expose the Gateway.",{"_3634":270,"_31209":214,"_21628":51793,"_5":14884,"_28401":51656,"_3085":51794},[],"The Helm test checks the CA, DMS Manager, Device Manager and VA health endpoints and verifies the UI response.",{"_3634":271,"_31209":214,"_21628":51796,"_5":14884,"_28401":51660,"_3085":51797},[],"Version-specific upgrade steps live in `charts/lamassu/CHANGELOG/` in the Helm repository. The chart also ships an optional pre-upgrade Job that migrates existing CA private keys into the KMS engine configured for the release. It is off by default (`migrations.caToKms.enabled: false`) and is only needed when upgrading from a version prior to 3.7.0.",{"_3634":272,"_31209":214,"_21628":51799,"_5":14884,"_28401":51660,"_3085":51800},[],"While the flag is enabled, every `helm upgrade` creates the `<chart fullname>-ca-to-kms-migration` Job (`lamassu-ca-to-kms-migration` for release `lamassu`); a fresh install does not create it. Its hook weight is `-10`, so it runs before the other pre-upgrade hooks: the authorization bootstrap configuration (weight `-4`) and the database-migration Job (weight `-3`).",{"_3634":273,"_31209":214,"_21628":51802,"_5":14884,"_28401":51660,"_3085":51803},[],"The Job consumes the same KMS service configuration the chart renders into the KMS ConfigMap, including the engines from `services.kms.cryptoEngines`, and runs the migration tool defined in `migrations.caToKms.image`. It mounts that configuration read-only at `/etc/lamassuiot/config.yml` from the ConfigMap key `config`, so configure the destination engine in your values before the upgrade that performs the migration.",{"_3634":274,"_31209":214,"_21628":51805,"_5":14884,"_28401":51660,"_3085":51806},[],"The Job resolves its configuration through a projected volume with two optional sources: the release-scoped `<chart fullname>-kms-config` (`lamassu-kms-config` for release `lamassu`, `prod-lamassu-kms-config` for release `prod`) and the legacy unscoped `kms-config` created by chart versions before release-scoped naming. The legacy configuration remains authoritative while it is still present, and the release-scoped one is used once the legacy one is gone. Both sources are optional, so a missing ConfigMap never leaves the upgrade pod in `ContainerCreating`.",{"_3634":275,"_31209":214,"_21628":51808,"_5":14884,"_28401":51660,"_3085":51809},[],"Keep `migrations.caToKms.enabled: true` for the upgrade that performs the migration, then remove the flag from your values once the migration completes; it defaults to `false`.",{"_3634":276,"_31209":214,"_21628":51811,"_5":14884,"_28401":51664,"_3085":51812},[],"Before going live, review:",{"_3634":277,"_31209":214,"_21628":51814,"_5":14884,"_28401":51664,"_3085":51815},[],"backup and recovery for PostgreSQL and persistent volumes",{"_3634":278,"_31209":214,"_21628":51817,"_5":14884,"_28401":51664,"_3085":51818},[],"a production KMS engine; the default filesystem engine is not an HA design",{"_3634":279,"_31209":214,"_21628":51820,"_5":14884,"_28401":51664,"_3085":51821},[],"shared VA storage before increasing VA replicas",{"_3634":280,"_31209":214,"_21628":51823,"_5":14884,"_28401":51664,"_3085":51824},[],"managed OIDC roles and removal of evaluation credentials",{"_3634":281,"_31209":214,"_21628":51826,"_5":14884,"_28401":51664,"_3085":51827},[],"a trusted TLS issuer or externally managed certificate",{"_3634":282,"_31209":214,"_21628":51829,"_5":14884,"_28401":51664,"_3085":51830},[],"resource requests, replicas, autoscaling, disruption budgets and placement",{"_3634":283,"_31209":214,"_21628":51832,"_5":14884,"_28401":51664,"_3085":51833},[],"SMTP, observability and alert delivery",{"_3634":284,"_31209":214,"_21628":51835,"_5":14884,"_28401":51664,"_3085":51836},[],"the version upgrade guides and migration notes in `charts/lamassu/CHANGELOG/` before every upgrade, including the optional CA-to-KMS migration hook described above",{"_3634":285,"_31209":214,"_21628":51838,"_5":14884,"_28401":51664,"_3085":51839},[],"The complete values reference is maintained in `charts/lamassu/VALUES.md` in the Helm repository.",{"_3634":286,"_31209":286,"_5":15244,"_3085":51841,"_31547":51842,"_21628":51843,"_28401":286},"Expose the Gateway",[50999,51000,51106],[],{"_3634":287,"_31209":286,"_21628":51845,"_5":14884,"_28401":286,"_3085":51846},[],"Choose how clients reach Lamassu, when to set gateway.addresses and how to design multiple Gateways.",{"_3634":288,"_31209":286,"_5":31544,"_21628":51848,"_28401":51849,"_3085":51850},[],"/docs/deployment/self-hosted/networking#expose-the-lamassu-gateway","Expose the Lamassu Gateway",{"_3634":289,"_31209":286,"_5":31544,"_21628":51852,"_28401":51853,"_3085":51854},[],"/docs/deployment/self-hosted/networking#do-you-need-gatewayaddresses","Do you need `gateway.addresses`?",{"_3634":290,"_31209":286,"_5":31544,"_21628":51856,"_28401":51857,"_3085":51858},[],"/docs/deployment/self-hosted/networking#recommended-single-node-design","Recommended single-node design",{"_3634":291,"_31209":286,"_5":31544,"_21628":51860,"_28401":51861,"_3085":51862},[],"/docs/deployment/self-hosted/networking#k3s","K3s",{"_3634":292,"_31209":286,"_5":31544,"_21628":51864,"_28401":51865,"_3085":51866},[],"/docs/deployment/self-hosted/networking#bare-metal-with-metallb-or-kube-vip","Bare metal with MetalLB or kube-vip",{"_3634":293,"_31209":286,"_5":31544,"_21628":51868,"_28401":51869,"_3085":51870},[],"/docs/deployment/self-hosted/networking#external-reverse-proxy-nat-or-vpn","External reverse proxy, NAT or VPN",{"_3634":294,"_31209":286,"_5":31544,"_21628":51872,"_28401":51873,"_3085":51874},[],"/docs/deployment/self-hosted/networking#what-if-you-need-three-gateways","What if you need three Gateways?",{"_3634":295,"_31209":286,"_5":31544,"_21628":51876,"_28401":51877,"_3085":51878},[],"/docs/deployment/self-hosted/networking#client-certificates-and-identity-headers","Client certificates and identity headers",{"_3634":296,"_31209":286,"_5":31544,"_21628":51880,"_28401":51881,"_3085":51882},[],"/docs/deployment/self-hosted/networking#decision-guide","Decision guide",{"_3634":297,"_31209":286,"_5":31544,"_21628":51884,"_28401":51885,"_3085":51886},[],"/docs/deployment/self-hosted/networking#egress-proxy","Egress proxy",{"_3634":298,"_31209":286,"_5":31544,"_21628":51888,"_28401":51889,"_3085":51890},[],"/docs/deployment/self-hosted/networking#verify-the-traffic-path","Verify the traffic path",{"_3634":299,"_31209":286,"_21628":51892,"_5":14884,"_28401":51849,"_3085":51893},[],"The Lamassu chart creates one shared Gateway with HTTP and HTTPS listeners. Envoy Gateway normally creates a dedicated proxy deployment and a `LoadBalancer` Service for it.",{"_3634":300,"_31209":286,"_21628":51895,"_5":14884,"_28401":51849,"_3085":51896},[],"External reachability is the result of the whole path. A `Gateway` resource alone does not configure your router, firewall, DNS, cloud load balancer or upstream NAT.",{"_3634":301,"_31209":286,"_21628":51898,"_5":14884,"_28401":51853,"_3085":51899},[],"Usually, no. If you omit it, the Gateway controller and the cluster load-balancer implementation can assign an address and report it in `Gateway.status.addresses` and the generated Service status.",{"_3634":302,"_31209":286,"_21628":51901,"_5":14884,"_28401":51853,"_3085":51902},[],"Set it only when:",{"_3634":303,"_31209":286,"_21628":51904,"_5":14884,"_28401":51853,"_3085":51905},[],"your cloud or bare-metal load balancer supports requesting a specific address",{"_3634":304,"_31209":286,"_21628":51907,"_5":14884,"_28401":51853,"_3085":51908},[],"that address is allocated to this Gateway",{"_3634":305,"_31209":286,"_21628":51910,"_5":14884,"_28401":51853,"_3085":51911},[],"the surrounding network already routes traffic for it to the cluster",{"_3634":306,"_31209":286,"_21628":51913,"_5":14884,"_28401":51853,"_3085":51914},[],"This requests `192.168.1.50`; it does not claim the IP on your LAN or make it reachable.",{"_3634":307,"_31209":286,"_21628":51916,"_5":14884,"_28401":51853,"_3085":51917},[],"Keep these two settings separate:",{"_3634":308,"_31209":286,"_21628":51919,"_5":14884,"_28401":51853,"_3085":51920},[],"`gateway.addresses` requests an address for the Gateway.",{"_3634":309,"_31209":286,"_21628":51922,"_5":14884,"_28401":51853,"_3085":51923},[],"`tls.certManagerOptions.certSpec.addresses` adds IP subject alternative names to the TLS certificate.",{"_3634":310,"_31209":286,"_21628":51925,"_5":14884,"_28401":51853,"_3085":51926},[],"If users connect by DNS name, put that name in `tls.certManagerOptions.certSpec.hostnames`. Do not copy an upstream proxy's public IP into `gateway.addresses`.",{"_3634":311,"_31209":286,"_21628":51928,"_5":14884,"_28401":51857,"_3085":51929},[],"For a small VM running K3s or MicroK8s, use one external Lamassu Gateway and route every Lamassu endpoint through it:",{"_3634":312,"_31209":286,"_21628":51931,"_5":14884,"_28401":51857,"_3085":51932},[],"This design uses one IP, one TLS entry point and one pair of ports. The chart already creates the required routes.",{"_3634":313,"_31209":286,"_21628":51934,"_5":14884,"_28401":51861,"_3085":51935},[],"K3s ServiceLB implements each `LoadBalancer` Service with pods that reserve the Service ports on the node. On a single node, only one Service can therefore own port 80 and one can own port 443. The default K3s Traefik Service may already hold both ports.",{"_3634":314,"_31209":286,"_21628":51937,"_5":14884,"_28401":51861,"_3085":51938},[],"For the recommended design:",{"_3634":315,"_31209":286,"_21628":51940,"_5":14884,"_28401":51861,"_3085":51941},[],"Use only one externally exposed Lamassu Gateway.",{"_3634":316,"_31209":286,"_21628":51943,"_5":14884,"_28401":51861,"_3085":51944},[],"Ensure ports 80 and 443 are free. Disable or reconfigure Traefik if it is not part of your traffic path.",{"_3634":317,"_31209":286,"_21628":51946,"_5":14884,"_28401":51861,"_3085":51947},[],"Allow those ports through the VM firewall and any upstream security group.",{"_3634":318,"_31209":286,"_21628":51949,"_5":14884,"_28401":51861,"_3085":51950},[],"Point DNS at the VM's reachable address.",{"_3634":319,"_31209":286,"_21628":51952,"_5":14884,"_28401":51861,"_3085":51953},[],"See the K3s ServiceLB documentation for its host-port behavior and how to replace it with another load-balancer implementation.",{"_3634":320,"_31209":286,"_21628":51955,"_5":14884,"_28401":51865,"_3085":51956},[],"Allocate a VIP from an address pool reachable on your LAN. You may request that VIP with `gateway.addresses` if the selected implementation supports it. Confirm the assigned address in status rather than assuming the request succeeded.",{"_3634":321,"_31209":286,"_21628":51958,"_5":14884,"_28401":51869,"_3085":51959},[],"An external public address can forward TCP 80 and 443 to the VM or to a Kubernetes-side VIP:",{"_3634":322,"_31209":286,"_21628":51961,"_5":14884,"_28401":51869,"_3085":51962},[],"The public IP belongs to the external device. Leave `gateway.addresses` unset or set it to the actual Kubernetes-side address, never to an address that the cluster cannot bind.",{"_3634":323,"_31209":286,"_21628":51964,"_5":14884,"_28401":51873,"_3085":51965},[],"First decide whether you need three independent data planes or only three hostnames.",{"_3634":324,"_31209":286,"_21628":51967,"_5":14884,"_28401":51873,"_3085":51968},[],"Requirement",{"_3634":325,"_31209":286,"_21628":51970,"_5":14884,"_28401":51873,"_3085":51971},[],"Recommended design",{"_3634":326,"_31209":286,"_21628":51973,"_5":14884,"_28401":51873,"_3085":51974},[],"Consequence",{"_3634":327,"_31209":286,"_21628":51976,"_5":14884,"_28401":51873,"_3085":51977},[],"Several Lamassu URLs or services",{"_3634":328,"_31209":286,"_21628":51979,"_5":14884,"_28401":51873,"_3085":51980},[],"One Gateway with multiple routes",{"_3634":329,"_31209":286,"_21628":51982,"_5":14884,"_28401":51873,"_3085":51983},[],"One IP and one proxy fleet; this is the chart default",{"_3634":330,"_31209":286,"_21628":51985,"_5":14884,"_28401":51873,"_3085":51986},[],"Independent Gateways and separate external IPs",{"_3634":331,"_31209":286,"_21628":51988,"_5":14884,"_28401":51873,"_3085":51989},[],"One VIP per Gateway",{"_3634":332,"_31209":286,"_21628":51991,"_5":14884,"_28401":51873,"_3085":51992},[],"All Gateways can use 80/443; requires a load balancer with an address pool",{"_3634":333,"_31209":286,"_21628":51994,"_5":14884,"_28401":51873,"_3085":51995},[],"Independent Gateways on one node and one IP",{"_3634":334,"_31209":286,"_21628":51997,"_5":14884,"_28401":51873,"_3085":51998},[],"Use different external ports",{"_3634":335,"_31209":286,"_21628":52000,"_5":14884,"_28401":51873,"_3085":52001},[],"Clients must include non-standard ports",{"_3634":336,"_31209":286,"_21628":52003,"_5":14884,"_28401":51873,"_3085":52004},[],"Separate TLS/mTLS termination behind one IP",{"_3634":337,"_31209":286,"_21628":52006,"_5":14884,"_28401":51873,"_3085":52007},[],"Front-door SNI routing to internal Gateways",{"_3634":338,"_31209":286,"_21628":52009,"_5":14884,"_28401":51873,"_3085":52010},[],"Advanced design; the front door uses TLS passthrough and each internal Gateway terminates its own TLS",{"_3634":339,"_31209":286,"_21628":52012,"_5":14884,"_28401":51873,"_3085":52013},[],"Separate Gateway resources but shared proxy infrastructure",{"_3634":340,"_31209":286,"_21628":52015,"_5":14884,"_28401":51873,"_3085":52016},[],"Envoy merged-Gateway mode",{"_3634":341,"_31209":286,"_21628":52018,"_5":14884,"_28401":51873,"_3085":52019},[],"Logical separation only; listeners must have unique port, protocol and hostname tuples",{"_3634":342,"_31209":286,"_21628":52021,"_5":14884,"_28401":51873,"_3085":52022},[],"Three independent `LoadBalancer` Services cannot all reserve the same node ports 80 and 443 through K3s ServiceLB. Use one shared Gateway, allocate distinct VIPs with another load-balancer implementation, or use different ports.",{"_3634":343,"_31209":286,"_21628":52024,"_5":14884,"_28401":51873,"_3085":52025},[],"Envoy Gateway normally provisions a proxy fleet per `Gateway`. Its merged-Gateway mode can share one fleet and address, but it is not a drop-in switch for multiple Lamassu releases: the generated Lamassu listeners use the same ports and protocols without distinct hostnames, so they conflict unless you deliberately customize the listener design.",{"_3634":344,"_31209":286,"_21628":52027,"_5":14884,"_28401":51873,"_3085":52028},[],"Use a front-door SNI design only when the internal Gateways must retain independent TLS or mTLS policy:",{"_3634":345,"_31209":286,"_21628":52030,"_5":14884,"_28401":51873,"_3085":52031},[],"This requires distinct SNI hostnames and cluster networking outside the Lamassu chart.",{"_3634":346,"_31209":286,"_21628":52033,"_5":14884,"_28401":51877,"_3085":52034},[],"The chart renders a `ClientTrafficPolicy` named `enable-mtls` on its shared Gateway automatically; no Helm value enables or disables it. TLS termination accepts requests with or without a client certificate: devices may present one, but they are not required to. Before forwarding a request, the Gateway removes identity and certificate headers that a client could otherwise supply itself: `X-Principal-Id`, `X-Lms-Source`, `X-Forwarded-Client-Cert`, `X-Forwarded-Cert`, `X-Forwarded-Tls-Client-Cert` (the Traefik spelling), `Ssl-Client-Cert` and `X-Amzn-Mtls-Clientcert`. The Traefik spelling is included because backends that accept `X-Forwarded-Tls-Client-Cert` directly would otherwise receive certificate identity data supplied by the client itself, without a client certificate having been presented. After stripping, Envoy adds its own `X-Forwarded-Client-Cert` carrying the presented certificate and its chain, so services that read certificate identity receive only gateway-generated values. No Helm value changes the list of stripped headers. The Access control page describes how `authz` uses this protection to keep `X-Principal-ID` out of reach of clients.",{"_3634":347,"_31209":286,"_21628":52036,"_5":14884,"_28401":51881,"_3085":52037},[],"If one Gateway can own TLS and routing, use the chart default.",{"_3634":348,"_31209":286,"_21628":52039,"_5":14884,"_28401":51881,"_3085":52040},[],"If Gateways need independent policy and you can allocate IPs, use one VIP per Gateway.",{"_3634":349,"_31209":286,"_21628":52042,"_5":14884,"_28401":51881,"_3085":52043},[],"If only the Kubernetes resources need separation, evaluate merged-Gateway mode and make every listener tuple unique.",{"_3634":350,"_31209":286,"_21628":52045,"_5":14884,"_28401":51881,"_3085":52046},[],"If data planes and TLS termination must stay independent behind one IP, add a front-door SNI passthrough layer.",{"_3634":351,"_31209":286,"_21628":52048,"_5":14884,"_28401":51881,"_3085":52049},[],"If none of those are possible, use different external ports or change the external network design.",{"_3634":352,"_31209":286,"_21628":52051,"_5":14884,"_28401":51885,"_3085":52052},[],"Internal Lamassu clients — the Vault engine connection, service-to-service calls and webhook deliveries — honor the `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables. The exception is the authorization-engine connector: it uses its own transport and does not consult these proxy variables. If your deployment routes egress through a proxy, list in-cluster service names in `NO_PROXY` (for example `.svc,.cluster.local`) so internal traffic stays inside the cluster. Loopback traffic is never sent through a proxy.",{"_3634":353,"_31209":286,"_21628":52054,"_5":14884,"_28401":51885,"_3085":52055},[],"The default transport of these clients bounds the dial timeout (30 seconds), the TLS handshake (10 seconds) and idle connection reuse (90 seconds) so an unreachable dependency fails fast instead of hanging; these values are Go transport defaults, not Lamassu settings. HTTP/2 is negotiated when the peer supports it. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call.",{"_3634":354,"_31209":286,"_21628":52057,"_5":14884,"_28401":51889,"_3085":52058},[],"Check, in order:",{"_3634":355,"_31209":286,"_21628":52060,"_5":14884,"_28401":51889,"_3085":52061},[],"`Gateway` has `Accepted=True` and `Programmed=True`.",{"_3634":356,"_31209":286,"_21628":52063,"_5":14884,"_28401":51889,"_3085":52064},[],"Its status contains the expected address.",{"_3634":357,"_31209":286,"_21628":52066,"_5":14884,"_28401":51889,"_3085":52067},[],"The generated `LoadBalancer` Service has a usable external address.",{"_3634":358,"_31209":286,"_21628":52069,"_5":14884,"_28401":51889,"_3085":52070},[],"Port 443 reaches that address from the client network.",{"_3634":359,"_31209":286,"_21628":52072,"_5":14884,"_28401":51889,"_3085":52073},[],"DNS resolves to the externally reachable endpoint.",{"_3634":360,"_31209":286,"_21628":52075,"_5":14884,"_28401":51889,"_3085":52076},[],"The certificate contains the DNS name or IP used by the client.",{"_3634":361,"_31209":286,"_21628":52078,"_5":14884,"_28401":51889,"_3085":52079},[],"The Gateway API treats addresses as desired state that a controller may assign or reject; see the Gateway API overview for the resource model.",{"_3634":362,"_31209":362,"_5":15244,"_3085":51106,"_31547":52081,"_21628":52082,"_28401":362},[50999,51000,51106],[],{"_3634":363,"_31209":362,"_21628":52084,"_5":14884,"_28401":362,"_3085":52085},[],"Choose an installation workflow and network architecture for Lamassu on your Kubernetes cluster.",{"_3634":364,"_31209":362,"_5":31544,"_21628":52087,"_28401":52088,"_3085":52089},[],"/docs/deployment/self-hosted/overview#self-managed-kubernetes-deployment","Self-managed Kubernetes deployment",{"_3634":365,"_31209":362,"_5":31544,"_21628":52091,"_28401":52092,"_3085":52093},[],"/docs/deployment/self-hosted/overview#choose-an-installation-workflow","Choose an installation workflow",{"_3634":366,"_31209":362,"_5":31544,"_21628":52095,"_28401":52096,"_3085":52097},[],"/docs/deployment/self-hosted/overview#what-the-lamassu-chart-provides","What the Lamassu chart provides",{"_3634":367,"_31209":362,"_5":31544,"_21628":52099,"_28401":52100,"_3085":52101},[],"/docs/deployment/self-hosted/overview#how-the-deployment-fits-together","How the deployment fits together",{"_3634":368,"_31209":362,"_5":31544,"_21628":52103,"_28401":52104,"_3085":52105},[],"/docs/deployment/self-hosted/overview#platform-requirements","Platform requirements",{"_3634":369,"_31209":362,"_5":31544,"_21628":52107,"_28401":52108,"_3085":52109},[],"/docs/deployment/self-hosted/overview#choose-the-next-page","Choose the next page",{"_3634":370,"_31209":362,"_21628":52111,"_5":14884,"_28401":52088,"_3085":52112},[],"Run Lamassu in a Kubernetes cluster operated by your team. The Helm chart deploys the Lamassu services and their routing resources; you provide the cluster, persistent storage, identity provider, PostgreSQL, RabbitMQ and the network path used by clients.",{"_3634":371,"_31209":362,"_21628":52114,"_5":14884,"_28401":52092,"_3085":52115},[],"Workflow",{"_3634":372,"_31209":362,"_21628":52117,"_5":14884,"_28401":52092,"_3085":52118},[],"Use it for",{"_3634":373,"_31209":362,"_21628":52120,"_5":14884,"_28401":52092,"_3085":52121},[],"What it installs",{"_3634":374,"_31209":362,"_21628":52123,"_5":14884,"_28401":52092,"_3085":52124},[],"Helm",{"_3634":375,"_31209":362,"_21628":52126,"_5":14884,"_28401":52092,"_3085":52127},[],"Production and controlled environments",{"_3634":376,"_31209":362,"_21628":52129,"_5":14884,"_28401":52092,"_3085":52130},[],"Lamassu services and Gateway API resources",{"_3634":377,"_31209":362,"_21628":52132,"_5":14884,"_28401":52092,"_3085":51243},[],{"_3634":378,"_31209":362,"_21628":52134,"_5":14884,"_28401":52092,"_3085":52135},[],"Evaluation, demos, CI and small lab clusters",{"_3634":379,"_31209":362,"_21628":52137,"_5":14884,"_28401":52092,"_3085":52138},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway and Lamassu",{"_3634":380,"_31209":362,"_21628":52140,"_5":14884,"_28401":52096,"_3085":52141},[],"The Lamassu chart is an **application chart**, not a cluster bootstrap chart. It creates the Kubernetes resources that run and configure Lamassu, but it expects the platform services those resources depend on to exist.",{"_3634":381,"_31209":362,"_21628":52143,"_5":14884,"_28401":52096,"_3085":52144},[],"Area",{"_3634":382,"_31209":362,"_21628":52146,"_5":14884,"_28401":52096,"_3085":52147},[],"The Lamassu chart provides",{"_3634":383,"_31209":362,"_21628":52149,"_5":14884,"_28401":52096,"_3085":52150},[],"You provide",{"_3634":384,"_31209":362,"_21628":52152,"_5":14884,"_28401":52096,"_3085":52153},[],"Lamassu applications",{"_3634":385,"_31209":362,"_21628":52155,"_5":14884,"_28401":52096,"_3085":52156},[],"Deployments and StatefulSets for the UI and APIs, internal Services, ConfigMaps, a ServiceAccount, and optional HPAs and PDBs",{"_3634":386,"_31209":362,"_21628":52158,"_5":14884,"_28401":52096,"_3085":52159},[],"A working Kubernetes cluster, compute capacity and access to the container images",{"_3634":387,"_31209":362,"_21628":52161,"_5":14884,"_28401":52096,"_3085":52162},[],"PostgreSQL data",{"_3634":388,"_31209":362,"_21628":52164,"_5":14884,"_28401":52096,"_3085":52165},[],"A pre-install/pre-upgrade job that creates the required databases and schemas, runs migrations and applies the authorization bootstrap",{"_3634":389,"_31209":362,"_21628":52167,"_5":14884,"_28401":52096,"_3085":52168},[],"A reachable PostgreSQL server, credentials allowed to create databases and schemas, and backup/HA operations",{"_3634":390,"_31209":362,"_21628":52170,"_5":14884,"_28401":52096,"_3085":52171},[],"Messaging",{"_3634":391,"_31209":362,"_21628":52173,"_5":14884,"_28401":52096,"_3085":52174},[],"RabbitMQ connection configuration for the Lamassu services; the connection can use AMQPS, with an optional private CA and an optional client certificate, both set through chart values",{"_3634":392,"_31209":362,"_21628":52176,"_5":14884,"_28401":52096,"_3085":52177},[],"A reachable RabbitMQ broker, credentials and its lifecycle",{"_3634":393,"_31209":362,"_21628":52179,"_5":14884,"_28401":52096,"_3085":52180},[],"Identity",{"_3634":394,"_31209":362,"_21628":52182,"_5":14884,"_28401":52096,"_3085":52183},[],"OIDC/JWT and external-authorization configuration, plus initial Lamassu authorization principals",{"_3634":395,"_31209":362,"_21628":52185,"_5":14884,"_28401":52096,"_3085":52186},[],"An OIDC provider, realm/tenant, client, users, groups and roles",{"_3634":396,"_31209":362,"_21628":52188,"_5":14884,"_28401":52096,"_3085":52189},[],"External routing",{"_3634":397,"_31209":362,"_21628":52191,"_5":14884,"_28401":52096,"_3085":52192},[],"One `Gateway`, `HTTPRoute` resources, an `EnvoyProxy` configuration and Envoy security policies",{"_3634":398,"_31209":362,"_21628":52194,"_5":14884,"_28401":52096,"_3085":52195},[],"Gateway API and Envoy CRDs, the Envoy Gateway controller, a `GatewayClass`, a load-balancer implementation and the external network path",{"_3634":399,"_31209":362,"_21628":52197,"_5":14884,"_28401":52096,"_3085":52198},[],"TLS",{"_3634":400,"_31209":362,"_21628":52200,"_5":14884,"_28401":52096,"_3085":52201},[],"In the default `tls.type: certManager` mode, cert-manager `Issuer` and CA `Certificate` resources and a chart-managed downstream `Certificate`; in the `tls.type: external` mode, a reference to your TLS Secret",{"_3634":401,"_31209":362,"_21628":52203,"_5":14884,"_28401":52096,"_3085":52204},[],"cert-manager only for the default `tls.type: certManager` mode; for trusted TLS, a trusted issuer or a populated TLS Secret",{"_3634":402,"_31209":362,"_21628":52206,"_5":14884,"_28401":52096,"_3085":52207},[],"Persistent application data",{"_3634":403,"_31209":362,"_21628":52209,"_5":14884,"_28401":52096,"_3085":52210},[],"PersistentVolumeClaims required by the default local KMS and VA storage",{"_3634":404,"_31209":362,"_21628":52212,"_5":14884,"_28401":52096,"_3085":52213},[],"A StorageClass, physical storage, backups and a shared/external backend when scaling requires one",{"_3634":405,"_31209":362,"_21628":52215,"_5":14884,"_28401":52096,"_3085":52216},[],"Optional integrations",{"_3634":406,"_31209":362,"_21628":52218,"_5":14884,"_28401":52096,"_3085":52219},[],"Configuration hooks for observability, AWS connectors and PKCS#11/HSM connectivity",{"_3634":407,"_31209":362,"_21628":52221,"_5":14884,"_28401":52096,"_3085":52222},[],"The observability backends, cloud credentials and production HSM or external key service",{"_3634":408,"_31209":362,"_21628":52224,"_5":14884,"_28401":52096,"_3085":52225},[],"The chart creates Lamassu's `Gateway` and routes. It does not install the Envoy Gateway controller or make the generated `LoadBalancer` Service reachable from your network.",{"_3634":409,"_31209":362,"_21628":52227,"_5":14884,"_28401":52096,"_3085":52228},[],"Use one Lamassu Gateway on ports 80 and 443 and let its HTTPRoutes dispatch traffic to every Lamassu service. Give that Gateway one externally reachable endpoint through the cluster load balancer, or forward traffic to it from an external proxy or NAT device. You do not need one Gateway per service.",{"_3634":410,"_31209":362,"_21628":52230,"_5":14884,"_28401":52100,"_3085":52231},[],"The chart creates one shared `Gateway` per Helm release. All chart-managed `HTTPRoute` resources attach to it. Envoy Gateway provisions the proxy data plane and a Kubernetes `LoadBalancer` Service for that Gateway.",{"_3634":411,"_31209":362,"_21628":52233,"_5":14884,"_28401":52100,"_3085":52234},[],"The `gateway.addresses` value is only an address request to the Gateway controller. It does not make an IP routable, open a firewall, configure DNS or create NAT. See Expose the Gateway before setting it.",{"_3634":412,"_31209":362,"_21628":52236,"_5":14884,"_28401":52104,"_3085":52237},[],"Kubernetes 1.24 or newer",{"_3634":413,"_31209":362,"_21628":52239,"_5":14884,"_28401":52104,"_3085":52240},[],"Helm 3.2 or newer",{"_3634":414,"_31209":362,"_21628":52242,"_5":14884,"_28401":52104,"_3085":52243},[],"Envoy Gateway 1.8 or newer and a `GatewayClass`",{"_3634":415,"_31209":362,"_21628":52245,"_5":14884,"_28401":52104,"_3085":52246},[],"cert-manager 1.14 or newer; required only for the default `tls.type: certManager` TLS mode, not for `tls.type: external`",{"_3634":416,"_31209":362,"_21628":52248,"_5":14884,"_28401":52104,"_3085":52249},[],"persistent storage suitable for the selected PostgreSQL, RabbitMQ, VA and KMS configuration",{"_3634":417,"_31209":362,"_21628":52251,"_5":14884,"_28401":52104,"_3085":52252},[],"a load-balancer implementation or another deliberate path from clients to the Gateway",{"_3634":418,"_31209":362,"_21628":52254,"_5":14884,"_28401":52104,"_3085":52255},[],"KMS deployments using the native PKCS#11 sidecar require Kubernetes 1.29 or newer. Prebuilt Lamassu container images are published for `linux/amd64` and `linux/arm64`, and the KMS PKCS#11 client module (`p11-kit-client.so`) is installed at the target architecture's Debian library path: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` on amd64 and `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` on arm64. The x86\\_64 path is retained as a compatibility alias for existing configurations.",{"_3634":419,"_31209":362,"_21628":52257,"_5":14884,"_28401":52108,"_3085":52258},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values, install and verify a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3634":420,"_31209":362,"_21628":52260,"_5":14884,"_28401":52108,"_3085":52261},[],"<Card title=\"Upgrade from 3.8.0\" description=\"Upgrade an existing Helm release to 4.0.0: architecture changes, breaking changes, migration steps and validation.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3634":421,"_31209":362,"_21628":52263,"_5":14884,"_28401":52108,"_3085":52264},[],"<Card title=\"Expose the Gateway\" description=\"Choose an external traffic design, understand gateway.addresses and handle multiple Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3634":422,"_31209":362,"_21628":52266,"_5":14884,"_28401":52108,"_3085":52267},[],"<Card title=\"Use Fastlane\" description=\"Bootstrap a complete evaluation or lab environment with one script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3634":423,"_31209":423,"_5":15244,"_3085":52269,"_31547":52270,"_21628":52272,"_28401":423},"Deployment troubleshooting",[50999,51000,52271],"Operations",[],{"_3634":424,"_31209":423,"_21628":52274,"_5":14884,"_28401":423,"_3085":52275},[],"Diagnose access, service health and infrastructure dependencies.",{"_3634":425,"_31209":423,"_5":31544,"_21628":52277,"_28401":52278,"_3085":52279},[],"/docs/deployment/troubleshooting#diagnostic-sequence","Diagnostic sequence",{"_3634":426,"_31209":423,"_5":31544,"_21628":52281,"_28401":52282,"_3085":52283},[],"/docs/deployment/troubleshooting#reproduce-a-single-operation","Reproduce a single operation",{"_3634":427,"_31209":423,"_5":31544,"_21628":52285,"_28401":52286,"_3085":52287},[],"/docs/deployment/troubleshooting#separate-client-gateway-and-service","Separate client, Gateway and service",{"_3634":428,"_31209":423,"_5":31544,"_21628":52289,"_28401":52290,"_3085":52291},[],"/docs/deployment/troubleshooting#review-kubernetes-status","Review Kubernetes status",{"_3634":429,"_31209":423,"_5":31544,"_21628":52293,"_28401":52294,"_3085":52295},[],"/docs/deployment/troubleshooting#query-the-affected-service","Query the affected service",{"_3634":430,"_31209":423,"_5":31544,"_21628":52297,"_28401":52298,"_3085":52299},[],"/docs/deployment/troubleshooting#validate-the-result-from-outside","Validate the result from outside",{"_3634":431,"_31209":423,"_5":31544,"_21628":52301,"_28401":52302,"_3085":52303},[],"/docs/deployment/troubleshooting#minimal-evidence-collection","Minimal evidence collection",{"_3634":432,"_31209":423,"_5":31544,"_21628":52305,"_28401":52306,"_3085":52307},[],"/docs/deployment/troubleshooting#i-cannot-sign-in","I cannot sign in",{"_3634":433,"_31209":423,"_5":31544,"_21628":52309,"_28401":52310,"_3085":52311},[],"/docs/deployment/troubleshooting#everything-returns-403-or-5xx","Everything returns 403 or 5xx",{"_3634":434,"_31209":423,"_5":31544,"_21628":52313,"_28401":52314,"_3085":52315},[],"/docs/deployment/troubleshooting#api-500-errors","API 500 errors",{"_3634":435,"_31209":423,"_5":31544,"_21628":52317,"_28401":52318,"_3085":52319},[],"/docs/deployment/troubleshooting#a-pod-is-not-ready","A pod is not Ready",{"_3634":436,"_31209":423,"_5":31544,"_21628":52321,"_28401":52322,"_3085":52323},[],"/docs/deployment/troubleshooting#events-are-not-arriving","Events are not arriving",{"_3634":437,"_31209":423,"_5":31544,"_21628":52325,"_28401":52326,"_3085":52327},[],"/docs/deployment/troubleshooting#observability","Observability",{"_3634":438,"_31209":423,"_21628":52329,"_5":14884,"_28401":423,"_3085":52330},[],"Start by locating the failing layer. A Gateway response and an unready pod require different evidence. For rejected issuance or validation results, see PKI troubleshooting; for enrollment, see EST diagnostics.",{"_3634":439,"_31209":423,"_21628":52332,"_5":14884,"_28401":52282,"_3085":52333},[],"Note the time in UTC, user or principal, resource, endpoint and result. Avoid repeating a destructive action such as revocation or deletion.",{"_3634":440,"_31209":423,"_21628":52335,"_5":14884,"_28401":52286,"_3085":52336},[],"Check the HTTP status. A 401 points to authentication; a 403, to authorization; a 404, to route or resource; a 5xx, to the service or a dependency.",{"_3634":441,"_31209":423,"_21628":52338,"_5":14884,"_28401":52290,"_3085":52339},[],"Locate unready pods, restarts, recent events and the state of the release.",{"_3634":442,"_31209":423,"_21628":52341,"_5":14884,"_28401":52294,"_3085":52342},[],"Review its /health endpoint and its logs in the same time window. Then follow the indicated dependency: PostgreSQL, RabbitMQ, the OIDC provider or the cryptographic engine.",{"_3634":443,"_31209":423,"_21628":52344,"_5":14884,"_28401":52298,"_3085":52345},[],"For PKI, check the certificate, the chain, OCSP or CRL with the same type of client production uses.",{"_3634":444,"_31209":423,"_21628":52347,"_5":14884,"_28401":52302,"_3085":52348},[],"Replace the placeholders with your real release, namespace and deployment.",{"_3634":445,"_31209":423,"_21628":52350,"_5":14884,"_28401":52302,"_3085":52351},[],"Also run the chart's connectivity test:",{"_3634":446,"_31209":423,"_21628":52353,"_5":14884,"_28401":52302,"_3085":52354},[],"The test checks the health of CA, DMS Manager, Device Manager and VA, and verifies that the UI returns HTML. A passing test confirms basic connectivity, not a full issuance flow.",{"_3634":447,"_31209":423,"_21628":52356,"_5":14884,"_28401":52302,"_3085":52357},[],"The chart's services expose startup, readiness and liveness probes over /health. A pod can be running but receive no traffic if the readiness probe fails.",{"_3634":448,"_31209":423,"_21628":52359,"_5":14884,"_28401":52306,"_3085":52360},[],"If you receive a 401:",{"_3634":449,"_31209":423,"_21628":52362,"_5":14884,"_28401":52306,"_3085":52363},[],"check that the UI's OIDC authority is reachable from the browser;",{"_3634":450,"_31209":423,"_21628":52365,"_5":14884,"_28401":52306,"_3085":52366},[],"verify issuer, audience and expiration of the token;",{"_3634":451,"_31209":423,"_21628":52368,"_5":14884,"_28401":52306,"_3085":52369},[],"confirm the Gateway can fetch the keys from the JWKS URI;",{"_3634":452,"_31209":423,"_21628":52371,"_5":14884,"_28401":52306,"_3085":52372},[],"check that the provider's public and internal routes point to the same realm.",{"_3634":453,"_31209":423,"_21628":52374,"_5":14884,"_28401":52306,"_3085":52375},[],"If login succeeds but the APIs return 403:",{"_3634":454,"_31209":423,"_21628":52377,"_5":14884,"_28401":52306,"_3085":52378},[],"inspect the token's real claims;",{"_3634":455,"_31209":423,"_21628":52380,"_5":14884,"_28401":52306,"_3085":52381},[],"confirm they match an active principal;",{"_3634":456,"_31209":423,"_21628":52383,"_5":14884,"_28401":52306,"_3085":52384},[],"review the policies granted to that principal;",{"_3634":457,"_31209":423,"_21628":52386,"_5":14884,"_28401":52306,"_3085":52387},[],"verify that authz reaches PostgreSQL and its JWKS.",{"_3634":458,"_31209":423,"_21628":52389,"_5":14884,"_28401":52306,"_3085":52390},[],"On a fresh installation, confirm the migration Job finished. That Job creates schemas, migrates authz, preloads policies and provisions the principals defined in services.authz.bootstrap.",{"_3634":459,"_31209":423,"_21628":52392,"_5":14884,"_28401":52310,"_3085":52393},[],"External authorization fails closed by default. If authz is unavailable, protected routes are blocked.",{"_3634":460,"_31209":423,"_21628":52395,"_5":14884,"_28401":52310,"_3085":52396},[],"Locate the authz pod and Service.",{"_3634":461,"_31209":423,"_21628":52398,"_5":14884,"_28401":52310,"_3085":52399},[],"Check /health, logs and its database connection.",{"_3634":462,"_31209":423,"_21628":52401,"_5":14884,"_28401":52310,"_3085":52402},[],"Verify the DNS and port configured in externalAuthorization.",{"_3634":463,"_31209":423,"_21628":52404,"_5":14884,"_28401":52310,"_3085":52405},[],"Check the check route is /v1/ext\\_authz/check.",{"_3634":464,"_31209":423,"_21628":52407,"_5":14884,"_28401":52310,"_3085":52408},[],"Do not switch to failOpen: true as a permanent workaround: it would allow traffic without authorization during the outage.",{"_3634":465,"_31209":423,"_21628":52410,"_5":14884,"_28401":52314,"_3085":52411},[],"A 500 indicates an internal failure, such as an unavailable database. The `{\"err\": ...}` body currently includes the text of the internal error, which can contain schema, table and constraint names and, on connection failures, the database host and user (not the password). Find the cause in the service log using the request time, and do not forward the body to third parties or show it to end users. This is a known information-disclosure defect: generic messages are planned for 500 responses, keeping the detail only in the service log (tracked in lamassuiot#814). The authorization connector also returns the internal error, in the `details.error` field. Some request errors, such as a key size the engine does not support, are also returned as 500.",{"_3634":466,"_31209":423,"_21628":52413,"_5":14884,"_28401":52318,"_3085":52414},[],"Review kubectl describe pod first. Common causes are:",{"_3634":467,"_31209":423,"_21628":52416,"_5":14884,"_28401":52318,"_3085":52417},[],"wrong credentials or DNS for PostgreSQL or RabbitMQ;",{"_3634":468,"_31209":423,"_21628":52419,"_5":14884,"_28401":52318,"_3085":52420},[],"a missing AMQP CA or client certificate Secret referenced by `amqp.ca.secretName` or `amqp.client.secretName`;",{"_3634":469,"_31209":423,"_21628":52422,"_5":14884,"_28401":52318,"_3085":52423},[],"unbound persistent volume;",{"_3634":470,"_31209":423,"_21628":52425,"_5":14884,"_28401":52318,"_3085":52426},[],"inaccessible image or incorrect pull policy;",{"_3634":471,"_31209":423,"_21628":52428,"_5":14884,"_28401":52318,"_3085":52429},[],"invalid cryptographic engine configuration;",{"_3634":472,"_31209":423,"_21628":52431,"_5":14884,"_28401":52318,"_3085":52432},[],"CPU or memory limits set too low;",{"_3634":473,"_31209":423,"_21628":52434,"_5":14884,"_28401":52318,"_3085":52435},[],"an incomplete prior migration.",{"_3634":474,"_31209":423,"_21628":52437,"_5":14884,"_28401":52318,"_3085":52438},[],"Generic values request 100 mCPU and 128 MiB and limit to 500 mCPU and 512 MiB. Tune per service when you see OOMKills, throttling or slow startups.",{"_3634":475,"_31209":423,"_21628":52440,"_5":14884,"_28401":52318,"_3085":52441},[],"Filesystem-based KMS engines and VA local storage use exclusive-access volumes. Keep a single replica or migrate to shared backends before enabling autoscaling.",{"_3634":476,"_31209":423,"_21628":52443,"_5":14884,"_28401":52318,"_3085":52444},[],"Internal calls now fail fast instead of hanging for the clients covered by Egress proxy: connection attempts time out after 30 seconds and TLS handshakes after 10 seconds. The authorization-engine connector keeps its own transport without these dial and handshake timeouts; only its overall 30-second request timeout bounds each call. If an egress proxy handles the cluster's outbound traffic, check the pod's `HTTP_PROXY`, `HTTPS_PROXY` and `NO_PROXY` environment variables and list in-cluster service names in `NO_PROXY`.",{"_3634":477,"_31209":423,"_21628":52446,"_5":14884,"_28401":52322,"_3085":52447},[],"Domain and audit events depend on the bus publisher:",{"_3634":478,"_31209":423,"_21628":52449,"_5":14884,"_28401":52322,"_3085":52450},[],"verify it is enabled in the emitting service;",{"_3634":479,"_31209":423,"_21628":52452,"_5":14884,"_28401":52322,"_3085":52453},[],"check AMQP connectivity and credentials;",{"_3634":480,"_31209":423,"_21628":52455,"_5":14884,"_28401":52322,"_3085":52456},[],"review exchange, routing key, queues and consumers;",{"_3634":481,"_31209":423,"_21628":52458,"_5":14884,"_28401":52322,"_3085":52459},[],"inspect dead-letter queues;",{"_3634":482,"_31209":423,"_21628":52461,"_5":14884,"_28401":52322,"_3085":52462},[],"alert on orphan durable queues and backlog growth.",{"_3634":483,"_31209":423,"_21628":52464,"_5":14884,"_28401":52322,"_3085":52465},[],"If `amqp.tls` is enabled, verify the TLS side as well:",{"_3634":484,"_31209":423,"_21628":52467,"_5":14884,"_28401":52322,"_3085":52468},[],"confirm the broker listener speaks AMQPS on the configured port — the default port stays `5672` and does not follow TLS automatically;",{"_3634":485,"_31209":423,"_21628":52470,"_5":14884,"_28401":52322,"_3085":52471},[],"if you set `amqp.ca.secretName`, confirm the Secret exists in the release namespace and its data key matches `amqp.ca.certificateKey` (default `ca.crt`); if `amqp.ca.secretName` is not set, the clients trust the system CAs;",{"_3634":486,"_31209":423,"_21628":52473,"_5":14884,"_28401":52322,"_3085":52474},[],"remember that a missing referenced Secret prevents the consuming pods from starting;",{"_3634":487,"_31209":423,"_21628":52476,"_5":14884,"_28401":52322,"_3085":52477},[],"after updating the CA or client certificate Secret, restart the consuming pods: the AMQP client loads certificates at startup.",{"_3634":488,"_31209":423,"_21628":52479,"_5":14884,"_28401":52322,"_3085":52480},[],"See AMQP TLS (AMQPS) for the full configuration.",{"_3634":489,"_31209":423,"_21628":52482,"_5":14884,"_28401":52322,"_3085":52483},[],"A consumer outage does not always prevent the main operation from completing. That is why you must monitor RabbitMQ and independently verify the persistence of audit logs.",{"_3634":490,"_31209":423,"_21628":52485,"_5":14884,"_28401":52326,"_3085":52486},[],"The chart can enable OpenTelemetry instrumentation for the services that support it, including authz; it does not configure OpenTelemetry for AWS Connector, wfx or the UI. Traces are exported over OTLP HTTP and logs can be directed to a compatible endpoint, such as VictoriaLogs. Use a correlation identifier and the same time window to join Gateway, service and dependency.",{"_3634":491,"_31209":423,"_21628":52488,"_5":14884,"_28401":52326,"_3085":52489},[],"Before closing an incident, record:",{"_3634":492,"_31209":423,"_21628":52491,"_5":14884,"_28401":52326,"_3085":52492},[],"the confirmed cause;",{"_3634":493,"_31209":423,"_21628":52494,"_5":14884,"_28401":52326,"_3085":52495},[],"the time scope and affected resources;",{"_3634":494,"_31209":423,"_21628":52497,"_5":14884,"_28401":52326,"_3085":52498},[],"the commands or queries used;",{"_3634":495,"_31209":423,"_21628":52500,"_5":14884,"_28401":52326,"_3085":52501},[],"the applied change and how to revert it;",{"_3634":496,"_31209":423,"_21628":52503,"_5":14884,"_28401":52326,"_3085":52504},[],"validation from a consumer;",{"_3634":497,"_31209":423,"_21628":52506,"_5":14884,"_28401":52326,"_3085":52507},[],"the preventive action and its owner.",{"_3634":498,"_31209":498,"_5":15244,"_3085":52509,"_31547":52510,"_21628":52514,"_28401":498},"Data model",[50999,52511,52512,52513],"Platform","Administration","Access control",[],{"_3634":499,"_31209":498,"_21628":52516,"_5":14884,"_28401":498,"_3085":52517},[],"Entities and relationships from the pki.json schema that authz uses to evaluate access policies.",{"_3634":500,"_31209":498,"_5":31544,"_21628":52519,"_28401":52520,"_3085":52521},[],"/docs/platform/administration/access-control/data-model#schema-relationships","Schema relationships",{"_3634":501,"_31209":498,"_5":31544,"_21628":52523,"_28401":52524,"_3085":52525},[],"/docs/platform/administration/access-control/data-model#schema-entities","Schema entities",{"_3634":502,"_31209":498,"_21628":52527,"_5":14884,"_28401":498,"_3085":52528},[],"The `connectors/authz/pki.json` schema defines the entities in the `pki` authorization namespace. A policy identifies a resource type through `namespace: pki`, `schema_name` and `entity_type`. For example, `ca.certificate` identifies the `certificate` entity type in the `ca` schema.",{"_3634":503,"_31209":498,"_21628":52530,"_5":14884,"_28401":52520,"_3085":52531},[],"Each arrow starts at the entity that declares the relationship and points to its `target_entity`. The value of `foreign_key`, the source column, appears below the label. In `pki.json`, each relationship's `name` matches that column. Select the diagram to enlarge it and scroll through it.",{"_3634":504,"_31209":498,"_21628":52533,"_5":14884,"_28401":52520,"_3085":52534},[],"A policy can propagate actions from the referenced entity to the one that declares the relationship. For example, to grant read access to a DMS's devices, a rule starts from `dmsmanager.dms`, targets `devicemanager.device` and specifies `via: dms_owner`.",{"_3634":505,"_31209":498,"_21628":52536,"_5":14884,"_28401":52520,"_3085":52537},[],"When filtering inherited access, `authz` matches the `foreign_key` column against the first `primary_key` column of the referenced entity. For example, it matches `subject_common_name` to `device.id`, `issuer_meta_serial_number` to `ca_certificate.id` and the links to `kms_key` to `kms_key.key_id`.",{"_3634":506,"_31209":498,"_21628":52539,"_5":14884,"_28401":52524,"_3085":52540},[],"Entity (`schema_name.entity_type`)",{"_3634":507,"_31209":498,"_21628":52542,"_5":14884,"_28401":52524,"_3085":52543},[],"Table (`table_name`)",{"_3634":508,"_31209":498,"_21628":52545,"_5":14884,"_28401":52524,"_3085":52546},[],"Key (`primary_key`)",{"_3634":509,"_31209":498,"_21628":52548,"_5":14884,"_28401":52524,"_3085":52549},[],"`alerts.event`",{"_3634":510,"_31209":498,"_21628":52551,"_5":14884,"_28401":52524,"_3085":52552},[],"`events`",{"_3634":511,"_31209":498,"_21628":52554,"_5":14884,"_28401":52524,"_3085":52555},[],"`event_type`",{"_3634":512,"_31209":498,"_21628":52557,"_5":14884,"_28401":52524,"_3085":52558},[],"`alerts.subscription`",{"_3634":513,"_31209":498,"_21628":52560,"_5":14884,"_28401":52524,"_3085":52561},[],"`subscriptions`",{"_3634":514,"_31209":498,"_21628":52563,"_5":14884,"_28401":52524,"_3085":52564},[],"`id`",{"_3634":515,"_31209":498,"_21628":52566,"_5":14884,"_28401":52524,"_3085":52567},[],"`ca.ca_certificate`",{"_3634":516,"_31209":498,"_21628":52569,"_5":14884,"_28401":52524,"_3085":52570},[],"`ca_certificates`",{"_3634":517,"_31209":498,"_21628":52572,"_5":14884,"_28401":52524,"_3085":52564},[],{"_3634":518,"_31209":498,"_21628":52574,"_5":14884,"_28401":52524,"_3085":52575},[],"`ca.certificate`",{"_3634":519,"_31209":498,"_21628":52577,"_5":14884,"_28401":52524,"_3085":52578},[],"`certificates`",{"_3634":520,"_31209":498,"_21628":52580,"_5":14884,"_28401":52524,"_3085":52581},[],"`serial_number`",{"_3634":521,"_31209":498,"_21628":52583,"_5":14884,"_28401":52524,"_3085":52584},[],"`ca.issuance_profile`",{"_3634":522,"_31209":498,"_21628":52586,"_5":14884,"_28401":52524,"_3085":52587},[],"`issuance_profiles`",{"_3634":523,"_31209":498,"_21628":52589,"_5":14884,"_28401":52524,"_3085":52564},[],{"_3634":524,"_31209":498,"_21628":52591,"_5":14884,"_28401":52524,"_3085":52592},[],"`devicemanager.device_group`",{"_3634":525,"_31209":498,"_21628":52594,"_5":14884,"_28401":52524,"_3085":52595},[],"`device_groups`",{"_3634":526,"_31209":498,"_21628":52597,"_5":14884,"_28401":52524,"_3085":52564},[],{"_3634":527,"_31209":498,"_21628":52599,"_5":14884,"_28401":52524,"_3085":52600},[],"`devicemanager.device`",{"_3634":528,"_31209":498,"_21628":52602,"_5":14884,"_28401":52524,"_3085":52603},[],"`devices`",{"_3634":529,"_31209":498,"_21628":52605,"_5":14884,"_28401":52524,"_3085":52564},[],{"_3634":530,"_31209":498,"_21628":52607,"_5":14884,"_28401":52524,"_3085":52608},[],"`dmsmanager.dms`",{"_3634":531,"_31209":498,"_21628":52610,"_5":14884,"_28401":52524,"_3085":52611},[],"`dms`",{"_3634":532,"_31209":498,"_21628":52613,"_5":14884,"_28401":52524,"_3085":52564},[],{"_3634":533,"_31209":498,"_21628":52615,"_5":14884,"_28401":52524,"_3085":52616},[],"`kms.kms_key`",{"_3634":534,"_31209":498,"_21628":52618,"_5":14884,"_28401":52524,"_3085":52619},[],"`kms_keys`",{"_3634":535,"_31209":498,"_21628":52621,"_5":14884,"_28401":52524,"_3085":52622},[],"`key_id`, `engine_id`",{"_3634":536,"_31209":498,"_21628":52624,"_5":14884,"_28401":52524,"_3085":52625},[],"`va.crl_settings`",{"_3634":537,"_31209":498,"_21628":52627,"_5":14884,"_28401":52524,"_3085":52628},[],"`crl_settings`",{"_3634":538,"_31209":498,"_21628":52630,"_5":14884,"_28401":52524,"_3085":52631},[],"`ca_id`",{"_3634":539,"_31209":498,"_21628":52633,"_5":14884,"_28401":52524,"_3085":52634},[],"Events, subscriptions and device groups have their own actions and filters. Their `relations` lists are empty and they have zero incoming references in the schema. For `ca.certificate`, `view_tables` also lists `certificates_view`.",{"_3634":540,"_31209":498,"_21628":52636,"_5":14884,"_28401":52524,"_3085":52637},[],"Each entity declares instance-level operations in `atomic_actions`, operations that require no resource ID in `global_actions`, and the columns and types accepted by `column_filters` in `filterable`.",{"_3634":541,"_31209":498,"_21628":52639,"_5":14884,"_28401":52524,"_3085":52640},[],"<Card title=\"Access inherited through relations\" href=\"/docs/platform/administration/access-control#access-inherited-through-relations\" />",{"_3634":542,"_31209":542,"_5":15244,"_3085":52642,"_31547":52643,"_21628":52644,"_28401":542},"Access control overview",[50999,52511,52512,52513],[],{"_3634":543,"_31209":542,"_21628":52646,"_5":14884,"_28401":542,"_3085":52647},[],"Design who can access Lamassu through principals, policies, resource permissions and HTTP route authorization.",{"_3634":544,"_31209":542,"_5":31544,"_21628":52649,"_28401":52650,"_3085":52651},[],"/docs/platform/administration/access-control#essential-concepts","Essential concepts",{"_3634":545,"_31209":542,"_5":31544,"_21628":52653,"_28401":52654,"_3085":52655},[],"/docs/platform/administration/access-control#two-decision-systems","Two decision systems",{"_3634":546,"_31209":542,"_5":31544,"_21628":52657,"_28401":52658,"_3085":52659},[],"/docs/platform/administration/access-control#integrated-or-external-http-services","Integrated or external HTTP services",{"_3634":547,"_31209":542,"_5":31544,"_21628":52661,"_28401":52662,"_3085":52663},[],"/docs/platform/administration/access-control#authentication-only-routes-and-unmapped-paths","Authentication-only routes and unmapped paths",{"_3634":548,"_31209":542,"_5":31544,"_21628":52665,"_28401":52666,"_3085":52667},[],"/docs/platform/administration/access-control#services-developed-by-lamassu","Services developed by Lamassu",{"_3634":549,"_31209":542,"_5":31544,"_21628":52669,"_28401":52670,"_3085":52671},[],"/docs/platform/administration/access-control#how-the-two-paths-relate","How the two paths relate",{"_3634":550,"_31209":542,"_5":31544,"_21628":52673,"_28401":52674,"_3085":52675},[],"/docs/platform/administration/access-control#oidc-principals","OIDC principals",{"_3634":551,"_31209":542,"_5":31544,"_21628":52677,"_28401":52678,"_3085":52679},[],"/docs/platform/administration/access-control#x509-principals","X.509 principals",{"_3634":552,"_31209":542,"_5":31544,"_21628":52681,"_28401":52682,"_3085":52683},[],"/docs/platform/administration/access-control#when-several-principals-match","When several principals match",{"_3634":553,"_31209":542,"_5":31544,"_21628":52685,"_28401":52686,"_3085":52687},[],"/docs/platform/administration/access-control#how-policies-express-access","How policies express access",{"_3634":554,"_31209":542,"_5":31544,"_21628":52689,"_28401":52690,"_3085":52691},[],"/docs/platform/administration/access-control#global-and-direct-access","Global and direct access",{"_3634":555,"_31209":542,"_5":31544,"_21628":52693,"_28401":52694,"_3085":52695},[],"/docs/platform/administration/access-control#access-inherited-through-relations","Access inherited through relations",{"_3634":556,"_31209":542,"_5":31544,"_21628":52697,"_28401":52698,"_3085":52699},[],"/docs/platform/administration/access-control#attribute-filtered-access","Attribute-filtered access",{"_3634":557,"_31209":542,"_5":31544,"_21628":52701,"_28401":52702,"_3085":52703},[],"/docs/platform/administration/access-control#http-rules","HTTP rules",{"_3634":558,"_31209":542,"_5":31544,"_21628":52705,"_28401":52706,"_3085":52707},[],"/docs/platform/administration/access-control#included-policies","Included policies",{"_3634":559,"_31209":542,"_5":31544,"_21628":52709,"_28401":52710,"_3085":51649},[],"/docs/platform/administration/access-control#provision-the-first-administrator",{"_3634":560,"_31209":542,"_5":31544,"_21628":52712,"_28401":52713,"_3085":52714},[],"/docs/platform/administration/access-control#prepare-the-identity-provider","Prepare the identity provider",{"_3634":561,"_31209":542,"_5":31544,"_21628":52716,"_28401":52717,"_3085":52718},[],"/docs/platform/administration/access-control#configure-token-validation","Configure token validation",{"_3634":562,"_31209":542,"_5":31544,"_21628":52720,"_28401":52721,"_3085":52722},[],"/docs/platform/administration/access-control#install-and-verify-administrative-access","Install and verify administrative access",{"_3634":563,"_31209":542,"_5":31544,"_21628":52724,"_28401":52725,"_3085":52726},[],"/docs/platform/administration/access-control#test-an-unprivileged-identity","Test an unprivileged identity",{"_3634":564,"_31209":542,"_5":31544,"_21628":52728,"_28401":52729,"_3085":52730},[],"/docs/platform/administration/access-control#reduce-use-of-the-bootstrap-administrator","Reduce use of the bootstrap administrator",{"_3634":565,"_31209":542,"_5":31544,"_21628":52732,"_28401":52733,"_3085":52734},[],"/docs/platform/administration/access-control#fastlane-bootstrap","Fastlane bootstrap",{"_3634":566,"_31209":542,"_5":31544,"_21628":52736,"_28401":52737,"_3085":52738},[],"/docs/platform/administration/access-control#design-least-privilege-roles","Design least-privilege roles",{"_3634":567,"_31209":542,"_5":31544,"_21628":52740,"_28401":52741,"_3085":52742},[],"/docs/platform/administration/access-control#changes-and-access-revocation","Changes and access revocation",{"_3634":568,"_31209":542,"_5":31544,"_21628":52744,"_28401":52745,"_3085":52746},[],"/docs/platform/administration/access-control#operational-checklist","Operational checklist",{"_3634":569,"_31209":542,"_5":31544,"_21628":52748,"_28401":52749,"_3085":52750},[],"/docs/platform/administration/access-control#diagnostics","Diagnostics",{"_3634":570,"_31209":542,"_5":31544,"_21628":52752,"_28401":52753,"_3085":52754},[],"/docs/platform/administration/access-control#the-response-is-401","The response is 401",{"_3634":571,"_31209":542,"_5":31544,"_21628":52756,"_28401":52757,"_3085":52758},[],"/docs/platform/administration/access-control#the-response-is-403","The response is 403",{"_3634":572,"_31209":542,"_5":31544,"_21628":52760,"_28401":52761,"_3085":52762},[],"/docs/platform/administration/access-control#everything-returns-403","Everything returns 403",{"_3634":573,"_31209":542,"_5":31544,"_21628":52764,"_28401":52765,"_3085":52766},[],"/docs/platform/administration/access-control#access-appears-without-a-policy-grant","Access appears without a policy grant",{"_3634":574,"_31209":542,"_5":31544,"_21628":52768,"_28401":52769,"_3085":52770},[],"/docs/platform/administration/access-control#everything-fails-when-authz-is-unavailable","Everything fails when authz is unavailable",{"_3634":575,"_31209":542,"_21628":52772,"_5":14884,"_28401":542,"_3085":52773},[],"Lamassu access control turns an authenticated identity into concrete permissions. The OIDC provider or the client certificate proves **who** makes a request; the `authz` service decides **what that identity can do** and **over which resources**.",{"_3634":576,"_31209":542,"_21628":52775,"_5":14884,"_28401":542,"_3085":52776},[],"Lamassu does not assign permissions directly to users. The full chain is:",{"_3634":577,"_31209":542,"_21628":52778,"_5":14884,"_28401":542,"_3085":52779},[],"This model lets you represent people, identity-provider groups, service accounts and devices without coupling authorization to a specific provider.",{"_3634":578,"_31209":542,"_21628":52781,"_5":14884,"_28401":52650,"_3085":52782},[],"A **principal** connects a credential to Lamassu. It defines how to recognize an OIDC or X.509 identity and can be active or disabled.",{"_3634":579,"_31209":542,"_21628":52784,"_5":14884,"_28401":52650,"_3085":52785},[],"A **policy** groups reusable permissions. It can be granted to several principals and can contain rules about Lamassu entities, rules about HTTP routes or both.",{"_3634":580,"_31209":542,"_21628":52787,"_5":14884,"_28401":52650,"_3085":52788},[],"An **entity rule** grants actions over resources such as certification authorities, certificates, issuance profiles, devices, DMSs, keys or alert subscriptions. It can cover all resources of a type or be limited by identifier, relation or attribute.",{"_3634":581,"_31209":542,"_21628":52790,"_5":14884,"_28401":52650,"_3085":52791},[],"An **HTTP rule** grants actions associated with API routes. It is the mechanism the Gateway uses to decide whether a request may cross the perimeter.",{"_3634":582,"_31209":542,"_21628":52793,"_5":14884,"_28401":52650,"_3085":52794},[],"A **grant** is the association between a principal and a policy. Removing the grant removes all permissions contributed by that policy, without modifying it for other principals.",{"_3634":583,"_31209":542,"_21628":52796,"_5":14884,"_28401":52650,"_3085":52797},[],"A valid JWT or a valid client certificate does not grant access by itself. The credential must match at least one active principal and, unless the HTTP schema exempts the route, one of its policies must allow the requested operation. See *Authentication-only routes and unmapped paths* for those exemptions.",{"_3634":584,"_31209":542,"_21628":52799,"_5":14884,"_28401":52654,"_3085":52800},[],"Lamassu uses two authorization paths depending on who implements the protected service. They share principals, policies and grants, but they do not interpret the rules the same way.",{"_3634":585,"_31209":542,"_21628":52802,"_5":14884,"_28401":52654,"_3085":52803},[],"An external service can be protected without knowing Lamassu's internal authorization model. A service developed by Lamassu embeds the authorization engine and can decide on concrete resources and filter its queries.",{"_3634":586,"_31209":542,"_21628":52805,"_5":14884,"_28401":52658,"_3085":52806},[],"This path protects APIs that join the platform through the Gateway but do not natively implement Lamassu's authorization SDK. Job Manager is the current example. The same pattern allows integrating other HTTP services as long as their routes are described in an `authz` HTTP schema.",{"_3634":587,"_31209":542,"_21628":52808,"_5":14884,"_28401":52658,"_3085":52809},[],"The decision is made **before forwarding the request to the service**:",{"_3634":588,"_31209":542,"_21628":52811,"_5":14884,"_28401":52658,"_3085":52812},[],"Envoy Gateway authenticates the request, usually validating a JWT against the OIDC provider's JWKS.",{"_3634":589,"_31209":542,"_21628":52814,"_5":14884,"_28401":52658,"_3085":52815},[],"For a protected route, Envoy sends the method, URL, headers and required data to `/v1/ext_authz/check`.",{"_3634":590,"_31209":542,"_21628":52817,"_5":14884,"_28401":52658,"_3085":52818},[],"`authz` extracts the credential and resolves all active principals matching it.",{"_3634":591,"_31209":542,"_21628":52820,"_5":14884,"_28401":52658,"_3085":52821},[],"It separately loads the policies granted to each principal.",{"_3634":592,"_31209":542,"_21628":52823,"_5":14884,"_28401":52658,"_3085":52824},[],"The HTTP schema translates the method and route combination into a logical action, such as `nbi-job-read` or `nbi-workflow-create`.",{"_3634":593,"_31209":542,"_21628":52826,"_5":14884,"_28401":52658,"_3085":52827},[],"`authz` looks for an HTTP rule granting that action.",{"_3634":594,"_31209":542,"_21628":52829,"_5":14884,"_28401":52658,"_3085":52830},[],"If the route declares constraints, it compares request data with the normalized attributes of the same principal contributing the policy; the policy's own `param_constraints` also pin the granted action to literal request values.",{"_3634":595,"_31209":542,"_21628":52832,"_5":14884,"_28401":52658,"_3085":52833},[],"A satisfying result lets Envoy forward the request; any other response blocks it at the Gateway.",{"_3634":596,"_31209":542,"_21628":52835,"_5":14884,"_28401":52658,"_3085":52836},[],"When it allows access, `authz` returns the selected principal in the `X-Principal-ID` response header. The Gateway can propagate that header to the service to preserve the identity context. Clients cannot forge this header: the Gateway removes client-supplied `X-Principal-Id` (and the other forwarded identity and certificate headers) before forwarding, so only `authz` can set it. See Expose the Gateway for the full list of stripped headers.",{"_3634":597,"_31209":542,"_21628":52838,"_5":14884,"_28401":52658,"_3085":52839},[],"HTTP rules primarily answer &#x2A;*\"can this identity call this API operation?\"**. On their own they do not produce filters over the external service's database. To limit a route to a specific device, tenant or client, either the schema declares a constraint relating a request value to a normalized attribute of the principal, or the policy pins the request value to a literal with `param_constraints`. The first scopes each identity to its own resources through a single grant; the second restricts a grant to a fixed value regardless of who holds it.",{"_3634":598,"_31209":542,"_21628":52841,"_5":14884,"_28401":52662,"_3085":52842},[],"Two schema-level settings cover endpoints that policies do not mention:",{"_3634":599,"_31209":542,"_21628":52844,"_5":14884,"_28401":52662,"_3085":52845},[],"**`skip_authz: true` on a route** allows any identity that matches an active principal to reach it, even one with no granted policies. Use it for paths such as `/openapi.json` or `/health` that every authenticated caller should be able to access. The request still has to authenticate successfully: a credential that fails validation or matches no active principal is rejected before this setting is considered. A `skip_authz` route cannot declare constraints, and it wins over any other schema's route or default action for the same request.",{"_3634":600,"_31209":542,"_21628":52847,"_5":14884,"_28401":52662,"_3085":52848},[],"**`default_action` with `base_paths`** decides what happens when a request falls under a path prefix the schema owns but no explicit route matches. `deny` — the value the Job Manager schema ships with — turns the implicit denial of unmapped paths into an explicit, auditable statement; `allow` opens unmapped endpoints under that prefix to any identity that matches an active principal.",{"_3634":601,"_31209":542,"_21628":52850,"_5":14884,"_28401":52662,"_3085":52851},[],"These are decisions of the schema, not of a policy: `skip_authz` removes the grant check for that route, even when another schema maps the same request to an action that requires a grant, and `default_action` only covers requests that no explicit route in any schema matches. Keep three rules in mind:",{"_3634":602,"_31209":542,"_21628":52853,"_5":14884,"_28401":52662,"_3085":52854},[],"`default_action` requires at least one `base_paths` entry, and base paths are absolute paths such as `/api/wfx/nbi/v1`.",{"_3634":603,"_31209":542,"_21628":52856,"_5":14884,"_28401":52662,"_3085":52857},[],"An explicit route in any schema takes precedence: the fallback only decides requests that no schema's routes cover. When the prefixes of two schemas overlap, the longest matching prefix decides.",{"_3634":604,"_31209":542,"_21628":52859,"_5":14884,"_28401":52662,"_3085":52860},[],"Two schemas cannot claim the same base path with different default actions; the conflicting schema fails to load.",{"_3634":605,"_31209":542,"_21628":52862,"_5":14884,"_28401":52662,"_3085":52863},[],"A `skip_authz` route and a `default_action: \"allow\"` prefix grant access without consulting any policy. Every identity that matches an active principal can reach what they open, including identities with no granted policies. A `skip_authz` route in one schema also opens a request that another schema maps to a grant-protected action. Review these settings whenever you add or upgrade an integrated service.",{"_3634":606,"_31209":542,"_21628":52865,"_5":14884,"_28401":52662,"_3085":52866},[],"A schema can also make an individual route accept the credential from the URL. **`query_token: true` on a route** makes it accept the OIDC access token from the `access_token` query parameter, but only when the request carries neither an `Authorization: Bearer` header nor a client-certificate header: a credential in a header always wins. The token is validated and authorized exactly like a Bearer token, so the route's action still requires a policy grant, and routes that do not opt in never read the query parameter. The dashboard's experimental browser terminal uses this mechanism, because the WebSocket connection its browser client opens cannot set request headers.",{"_3634":607,"_31209":542,"_21628":52868,"_5":14884,"_28401":52662,"_3085":52869},[],"Query strings are often recorded. `authz` replaces the `access_token` value with `REDACTED` in its own decision logs, but other logs that capture the URL — the Gateway access log, service request logs, tracing — are not redacted. Keep `query_token` for WebSocket routes and short-lived tokens.",{"_3634":608,"_31209":542,"_21628":52871,"_5":14884,"_28401":52666,"_3085":52872},[],"Lamassu's native services embed authorization in their middleware and know the entities they operate on: certificates, CAs, issuance profiles, keys, devices, DMSs or subscriptions, among others.",{"_3634":609,"_31209":542,"_21628":52874,"_5":14884,"_28401":52666,"_3085":52875},[],"The decision is made with the domain operation context:",{"_3634":610,"_31209":542,"_21628":52877,"_5":14884,"_28401":52666,"_3085":52878},[],"The middleware extracts the credential and resolves the matching principals.",{"_3634":611,"_31209":542,"_21628":52880,"_5":14884,"_28401":52666,"_3085":52881},[],"The endpoint identifies the action, the entity type and, when applicable, the key of the requested resource.",{"_3634":612,"_31209":542,"_21628":52883,"_5":14884,"_28401":52666,"_3085":52884},[],"`authz` gathers the entity rules of the granted policies.",{"_3634":613,"_31209":542,"_21628":52886,"_5":14884,"_28401":52666,"_3085":52887},[],"The engine evaluates direct grants, attribute filters and relations with other entities.",{"_3634":614,"_31209":542,"_21628":52889,"_5":14884,"_28401":52666,"_3085":52890},[],"For an individual operation, it checks that the concrete resource satisfies the computed scope.",{"_3634":615,"_31209":542,"_21628":52892,"_5":14884,"_28401":52666,"_3085":52893},[],"For a listing, it generates a SQL filter that the service adds to its own query.",{"_3634":616,"_31209":542,"_21628":52895,"_5":14884,"_28401":52666,"_3085":52896},[],"Here the engine answers &#x2A;*\"can this identity perform this action on this concrete resource?\"**.",{"_3634":617,"_31209":542,"_21628":52898,"_5":14884,"_28401":52666,"_3085":52899},[],"Actions fall into two groups:",{"_3634":618,"_31209":542,"_21628":52901,"_5":14884,"_28401":52666,"_3085":52902},[],"**Global actions** do not need a resource identifier. `create`, `import` or access to a console section are common examples.",{"_3634":619,"_31209":542,"_21628":52904,"_5":14884,"_28401":52666,"_3085":52905},[],"**Atomic actions** are evaluated on a concrete instance. For certificates these include `read`, `metadata-update`, `status-update` and `delete`; for a CA there are also `sign`, `reissue` and other lifecycle operations.",{"_3634":620,"_31209":542,"_21628":52907,"_5":14884,"_28401":52666,"_3085":52908},[],"Filtering inside the service prevents leaks in listings: unauthorized resources are excluded from the SQL query instead of being fetched and hidden later in the interface.",{"_3634":621,"_31209":542,"_21628":52910,"_5":14884,"_28401":52670,"_3085":52911},[],"They are not two equivalent controls applied twice. HTTP rules protect the perimeter of an integrated service; entity rules express permissions over the data model of the native services.",{"_3634":622,"_31209":542,"_21628":52913,"_5":14884,"_28401":52670,"_3085":52914},[],"A policy can contain both rule types when an identity needs to operate Lamassu resources and also call an integrated API. Granting an entity rule does not automatically grant an HTTP action, nor does an HTTP rule create access over an entity.",{"_3634":623,"_31209":542,"_21628":52916,"_5":14884,"_28401":52670,"_3085":52917},[],"If no combination of principal, policy and rule allows the operation, Lamassu denies it, unless the HTTP schema declares `skip_authz` on the route or `default_action: allow` on a base path that covers it (see *Authentication-only routes and unmapped paths*). Additionally, `auth.externalAuthorization.failOpen` is `false` by default: if `authz` is unavailable, the Gateway blocks protected routes.",{"_3634":624,"_31209":542,"_21628":52919,"_5":14884,"_28401":52674,"_3085":52920},[],"An OIDC principal matches the claims of a validated JWT. It is appropriate for human users, corporate groups, IdP roles and service accounts that obtain tokens.",{"_3634":625,"_31209":542,"_21628":52922,"_5":14884,"_28401":52674,"_3085":52923},[],"The following principal represents any identity holding the `pki-operators` role in Keycloak:",{"_3634":626,"_31209":542,"_21628":52925,"_5":14884,"_28401":52674,"_3085":52926},[],"Claim paths can be nested, such as `realm_access.roles`. Within a single principal, **all** conditions must hold. This lets you require, for example, a group and an organizational audience at the same time.",{"_3634":627,"_31209":542,"_21628":52928,"_5":14884,"_28401":52674,"_3085":52929},[],"The implemented operators are:",{"_3634":628,"_31209":542,"_21628":52931,"_5":14884,"_28401":52674,"_3085":52932},[],"`equals`, for exact equality;",{"_3634":629,"_31209":542,"_21628":52934,"_5":14884,"_28401":52674,"_3085":52935},[],"`contains`, to check membership in a list or the presence of text in a scalar value.",{"_3634":630,"_31209":542,"_21628":52937,"_5":14884,"_28401":52674,"_3085":52938},[],"Design matching with stable attributes. For people, it is usually better to bind permissions to centrally managed groups or roles than to the email or username. For a service account, a stable `sub` keeps its permissions from mixing with a human operator's.",{"_3634":631,"_31209":542,"_21628":52940,"_5":14884,"_28401":52674,"_3085":52941},[],"Although the model recognizes the operator name `matches`, the current implementation does not evaluate regular expressions and the condition never matches. Use `equals` or `contains`.",{"_3634":632,"_31209":542,"_21628":52943,"_5":14884,"_28401":52678,"_3085":52944},[],"An X.509 principal lets you recognize a workload or a device by its client certificate. Lamassu checks the certificate signature against the configured CA and, depending on the mode, also its serial number or Common Name.",{"_3634":633,"_31209":542,"_21628":52946,"_5":14884,"_28401":52678,"_3085":52947},[],"The available modes are:",{"_3634":634,"_31209":542,"_21628":52949,"_5":14884,"_28401":52678,"_3085":52950},[],"`serial_and_ca`: an exact certificate, identified by serial number and CA;",{"_3634":635,"_31209":542,"_21628":52952,"_5":14884,"_28401":52678,"_3085":52953},[],"`cn_and_ca`: an exact or wildcard Common Name and a specific CA;",{"_3634":636,"_31209":542,"_21628":52955,"_5":14884,"_28401":52678,"_3085":52956},[],"`any_from_ca`: any certificate issued directly by the given CA.",{"_3634":637,"_31209":542,"_21628":52958,"_5":14884,"_28401":52678,"_3085":52959},[],"This example recognizes certificates whose CN starts with `factory-a-` and that are signed by the configured CA:",{"_3634":638,"_31209":542,"_21628":52961,"_5":14884,"_28401":52678,"_3085":52962},[],"`ca_trust.identity_type` accepts `fingerprint` or `authority_key_id`. In both cases you must provide the CA certificate in `ca_trust.pem`; Lamassu verifies both the signature and the expected identity of the CA.",{"_3634":639,"_31209":542,"_21628":52964,"_5":14884,"_28401":52678,"_3085":52965},[],"Use `any_from_ca` only when every identity issued by that CA should share the same permissions. If a CA issues certificates for different populations, separate access by serial or CN, or use different issuing CAs.",{"_3634":640,"_31209":542,"_21628":52967,"_5":14884,"_28401":52682,"_3085":52968},[],"A single credential can match more than one principal. It is common for a user to match a principal of their team and another of their operational function.",{"_3634":641,"_31209":542,"_21628":52970,"_5":14884,"_28401":52682,"_3085":52971},[],"For entity permissions, Lamassu combines permissions with OR logic: it is enough that one policy of one of the principals allows the action. Listings contain the union of the resources visible to all of them.",{"_3634":642,"_31209":542,"_21628":52973,"_5":14884,"_28401":52682,"_3085":52974},[],"HTTP routes with constraints are stricter. The same principal contributing the policy must also satisfy the attributes required by the route. Lamassu does not combine one principal's policy with an attribute belonging to another.",{"_3634":643,"_31209":542,"_21628":52976,"_5":14884,"_28401":52682,"_3085":52977},[],"For this reason, adding a matching principal can only broaden access. Before creating overlapping rules, review the full set of policies a real identity will receive.",{"_3634":644,"_31209":542,"_21628":52979,"_5":14884,"_28401":52690,"_3085":52980},[],"A rule identifies the domain (`namespace`), the data schema (`schema_name`) and the entity type (`entity_type`). `actions` lists the allowed operations.",{"_3634":645,"_31209":542,"_21628":52982,"_5":14884,"_28401":52690,"_3085":52983},[],"`direct_grants` limits the rule to concrete identifiers. The value `*` covers all instances of the type. A superadministrator policy uses wildcards in schema, entity, actions and grants; a least-privilege policy should avoid them whenever possible.",{"_3634":646,"_31209":542,"_21628":52985,"_5":14884,"_28401":52694,"_3085":52986},[],"Rules can follow relations declared between entities. For example, the schema knows the relation of a certificate to its issuing CA, of a device to its DMS and of a certificate to the KMS key that stores its private key, so a grant on the key also covers the certificates that use it. A policy can grant access to a parent resource and propagate selected actions to its related resources.",{"_3634":647,"_31209":542,"_21628":52988,"_5":14884,"_28401":52694,"_3085":52989},[],"This lets you express models like \"can operate the devices of this DMS\" without maintaining an individual list of every device. When a resource is added under that relation, it inherits the scope planned by the policy.",{"_3634":648,"_31209":542,"_21628":52991,"_5":14884,"_28401":52694,"_3085":52992},[],"The data model shows how the resources used in entity rules are connected.",{"_3634":649,"_31209":542,"_21628":52994,"_5":14884,"_28401":52694,"_3085":52995},[],"A rule can only follow relations that the data schema declares between its two entities. You can reference the relation by its name or by its foreign-key column — both spellings are equivalent, and it is the schema that decides which column the query uses. When you save a policy, `authz` checks every relation against the loaded schemas: one that no schema declares, or one pointing at an entity that is not loaded, is rejected at that moment.",{"_3634":650,"_31209":542,"_21628":52997,"_5":14884,"_28401":52694,"_3085":52998},[],"Policies stored before this validation may still carry relations the schemas do not declare. Such a relation grants nothing: `authz` logs a warning, `skipping relation that grants nothing`, naming the policy and the relation, and continues evaluating the rest of the policy. The reference is always resolved against the schema before any query is built, so an undeclared relation can never alter it. If inherited access narrows after an upgrade, check the `authz` logs for this warning and correct the relation of the affected policy.",{"_3634":651,"_31209":542,"_21628":53000,"_5":14884,"_28401":52698,"_3085":53001},[],"`column_filters` applies conditions to columns the schema has declared filterable. All filters of the same rule are combined with AND.",{"_3634":652,"_31209":542,"_21628":53003,"_5":14884,"_28401":52698,"_3085":53004},[],"For example, this rule allows reading active certificates issued by a specific CA:",{"_3634":653,"_31209":542,"_21628":53006,"_5":14884,"_28401":52698,"_3085":53007},[],"The available operators are `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` and `like`. Use comparisons consistent with the column type: `like` for text, ordering comparisons for numbers or dates and `in` when there is a collection of accepted values.",{"_3634":654,"_31209":542,"_21628":53009,"_5":14884,"_28401":52702,"_3085":53010},[],"HTTP rules do not point directly at tables. They reference a route schema and grant its logical actions. Job Manager's policies are an example: they distinguish reading, creating, updating and deleting workflows or jobs.",{"_3634":655,"_31209":542,"_21628":53012,"_5":14884,"_28401":52702,"_3085":53013},[],"Some routes also compare a request value — taken from the path, query, header or JSON body — with a normalized attribute of the principal. This way you can verify that a device only queries jobs addressed to its own `client_id`.",{"_3634":656,"_31209":542,"_21628":53015,"_5":14884,"_28401":52702,"_3085":53016},[],"Normalized attributes decouple the policy from the authentication mechanism. `subject_attribute_mappings` can derive, for example, `device_id` from `oidc.claim.device_id` or from `x509.subject.cn`. The rule consumes `device_id` in both cases.",{"_3634":657,"_31209":542,"_21628":53018,"_5":14884,"_28401":52702,"_3085":53019},[],"An HTTP rule can also pin a granted action to a literal value carried by the request itself through `param_constraints`. It extracts the value with the same sources as route constraints — `path_regex_group`, `query`, `header` or `json_body` — but compares it against an `equals` literal written into the policy rather than against a subject attribute. The grant then depends only on the request, not on who holds the policy:",{"_3634":658,"_31209":542,"_21628":53021,"_5":14884,"_28401":52702,"_3085":53022},[],"Combined with a schema route such as `^/api/mysvc/system/([^/]+)/info$`, this grants `GET /api/mysvc/system/1/info` and denies the same call for system `2`, regardless of the principal's attributes. The same mechanism pins query parameters, headers or JSON body fields, for example `{ \"source\": \"query\", \"name\": \"tenant_id\" }` with `\"equals\": \"1\"` to accept only requests carrying `?tenant_id=1`.",{"_3634":659,"_31209":542,"_21628":53024,"_5":14884,"_28401":52702,"_3085":53025},[],"Note that:",{"_3634":660,"_31209":542,"_21628":53027,"_5":14884,"_28401":52702,"_3085":53028},[],"`action` must be one of the actions granted by the rule; `equals` is required; `path_regex_group` needs an `index` greater than zero, `query` and `header` need a `name`, and `json_body` needs a `path` such as `$.tenant_id`.",{"_3634":661,"_31209":542,"_21628":53030,"_5":14884,"_28401":52702,"_3085":53031},[],"`param_constraints` are not cross-checked against the schema when the policy is loaded. A reference the route cannot satisfy — for instance a `path_regex_group` on a route without capture groups — simply never matches, and the request is denied.",{"_3634":662,"_31209":542,"_21628":53033,"_5":14884,"_28401":52702,"_3085":53034},[],"Several `param_constraints` for the same action combine with AND. A rule without them keeps the usual behavior: the action is granted wherever the route matches and the subject constraints pass.",{"_3634":663,"_31209":542,"_21628":53036,"_5":14884,"_28401":52706,"_3085":53037},[],"The `authz` preload installs reusable policies for the main domains. Among them are:",{"_3634":664,"_31209":542,"_21628":53039,"_5":14884,"_28401":52706,"_3085":53040},[],"full and read-only access to certificates and authorities;",{"_3634":665,"_31209":542,"_21628":53042,"_5":14884,"_28401":52706,"_3085":53043},[],"full and read-only access to the KMS;",{"_3634":666,"_31209":542,"_21628":53045,"_5":14884,"_28401":52706,"_3085":53046},[],"full and read-only access to Device Manager, DMS Manager, Validation Authority and alerts;",{"_3634":667,"_31209":542,"_21628":53048,"_5":14884,"_28401":52706,"_3085":53049},[],"an `Auditor` policy with PKI read access and authorization visibility;",{"_3634":668,"_31209":542,"_21628":53051,"_5":14884,"_28401":52706,"_3085":53052},[],"console access;",{"_3634":669,"_31209":542,"_21628":53054,"_5":14884,"_28401":52706,"_3085":53055},[],"administration and observation policies for the Job Manager NBI and SBI APIs;",{"_3634":670,"_31209":542,"_21628":53057,"_5":14884,"_28401":52706,"_3085":53058},[],"access to the dashboard's experimental terminal (Terminal Network);",{"_3634":671,"_31209":542,"_21628":53060,"_5":14884,"_28401":52706,"_3085":53061},[],"`SUPER ADMIN`, which grants all actions over the `authz` and `pki` domains.",{"_3634":672,"_31209":542,"_21628":53063,"_5":14884,"_28401":52706,"_3085":53064},[],"Start with these policies before creating others. If none reflects the boundary you need, create a specific, small policy instead of copying `SUPER ADMIN` and informally removing permissions.",{"_3634":673,"_31209":542,"_21628":53066,"_5":14884,"_28401":52706,"_3085":53067},[],"The Terminal Network policy is created by the `authz` preload the next time `authz` starts after the upgrade. Preloaded policies are system policies — their ids begin with `lamassu.` — and cannot be edited through the API.",{"_3634":674,"_31209":542,"_21628":53069,"_5":14884,"_28401":52710,"_3085":53070},[],"An installation without a principal matching your identity is left with nobody able to administer authorization. Configure the IdP and the bootstrap before exposing the platform.",{"_3634":675,"_31209":542,"_21628":53072,"_5":14884,"_28401":52710,"_3085":53073},[],"The chart includes a bootstrap principal that looks for the OIDC role `pki-admin` in `realm_access.roles`. It grants it `SUPER ADMIN` and, when Job Manager is enabled, the administrative policy of its NBI API.",{"_3634":676,"_31209":542,"_21628":53075,"_5":14884,"_28401":52710,"_3085":53076},[],"The pre-install and pre-upgrade Helm Job runs the `authz` migrations, preloads the policies and creates the bootstrap principals before the services start. If the principal already exists, it does not replace it: it only adds the configured grants that are still missing. You can keep the entry in `values.yaml` across upgrades.",{"_3634":677,"_31209":542,"_21628":53078,"_5":14884,"_28401":52713,"_3085":53079},[],"Create the role or group you will use to administer Lamassu. Assign it to at least two controlled human identities. If your provider does not use `realm_access.roles`, adapt the claim path in both the frontend and `auth_config.claims`.",{"_3634":678,"_31209":542,"_21628":53081,"_5":14884,"_28401":52717,"_3085":53082},[],"`authz` validates every token against `services.authz.jwkUrl`, which is fetched from the `authz` pod. The Gateway does not validate tokens itself: Lamassu services authorize each request through `authz`, and routes labeled `auth=external`, such as the Job Manager ones, are checked by the Gateway through `authz` when `auth.externalAuthorization` is enabled. The endpoint must serve the keys of the issuer configured in `auth.oidc.frontend.authority`.",{"_3634":679,"_31209":542,"_21628":53084,"_5":14884,"_28401":52717,"_3085":53085},[],"Releases upgraded from 3.8.0 must remove `auth.oidc.apiGateway` and `auth.authorization`, which the 4.0.0 chart rejects. See 3.8.0 to 4.0.0.",{"_3634":680,"_31209":542,"_21628":53087,"_5":14884,"_28401":52721,"_3085":53088},[],"Sign in with an identity holding `pki-admin`. Confirm it can access authorization administration and perform a non-destructive read operation.",{"_3634":681,"_31209":542,"_21628":53090,"_5":14884,"_28401":52725,"_3085":53091},[],"Use a second user without the role and confirm the same operation is denied. This test catches misread claims, overly broad policies and accidental `failOpen` configurations.",{"_3634":682,"_31209":542,"_21628":53093,"_5":14884,"_28401":52729,"_3085":53094},[],"Create operational principals with narrower policies. Reserve `pki-admin` for authorization administration and recovery, not for daily work.",{"_3634":683,"_31209":542,"_21628":53096,"_5":14884,"_28401":52733,"_3085":53097},[],"Fastlane installs a Keycloak realm for the lab and creates the user `lamassu` with the temporary password `lamassu`, the role `pki-admin` and a mandatory password change. Its bootstrap principal matches through `preferred_username=lamassu`.",{"_3634":684,"_31209":542,"_21628":53099,"_5":14884,"_28401":52733,"_3085":53100},[],"Change the password on first login. Do not reuse the Fastlane user, password or IdP as a production design.",{"_3634":685,"_31209":542,"_21628":53102,"_5":14884,"_28401":52737,"_3085":53103},[],"Avoid reproducing your company's internal structure with dozens of nearly identical policies. Start from the responsibilities that actually need access:",{"_3634":686,"_31209":542,"_21628":53105,"_5":14884,"_28401":52737,"_3085":53106},[],"**Authorization administration**: manages principals, policies and grants. It should belong to a small, separate group.",{"_3634":687,"_31209":542,"_21628":53108,"_5":14884,"_28401":52737,"_3085":53109},[],"**PKI operation**: administers CAs, profiles and certificates, but not necessarily who gets access.",{"_3634":688,"_31209":542,"_21628":53111,"_5":14884,"_28401":52737,"_3085":53112},[],"**Device registration**: operates devices and DMSs without receiving permissions over keys or authorization configuration.",{"_3634":689,"_31209":542,"_21628":53114,"_5":14884,"_28401":52737,"_3085":53115},[],"**Audit**: reviews configuration and activity without creating, modifying, signing, revoking or deleting.",{"_3634":690,"_31209":542,"_21628":53117,"_5":14884,"_28401":52737,"_3085":53118},[],"**Automation**: uses a technical account or a separate certificate, with permissions limited to the flow and resources it controls.",{"_3634":691,"_31209":542,"_21628":53120,"_5":14884,"_28401":52737,"_3085":53121},[],"For each role, separate \"view\" from \"change\", limit resources through grants, relations or attributes and avoid `*` unless the role must automatically cover future actions.",{"_3634":692,"_31209":542,"_21628":53123,"_5":14884,"_28401":52737,"_3085":53124},[],"A rule with `actions: [\"*\"]` expands to every action defined by the schema. When a new version adds an action, a wildcard policy may start granting it. Review these policies on every upgrade.",{"_3634":693,"_31209":542,"_21628":53126,"_5":14884,"_28401":52741,"_3085":53127},[],"To revoke access immediately, disable the principal or revoke its grants. Disabling a principal keeps its configuration and associations for investigation or restoration, but it stops taking part in matching.",{"_3634":694,"_31209":542,"_21628":53129,"_5":14884,"_28401":52741,"_3085":53130},[],"Deleting a role or group in the IdP prevents new tokens from containing the claim, but an already-issued token may remain valid until it expires. If removal is urgent, combine the IdP change with disabling the principal in Lamassu and revoking sessions or tokens at the provider.",{"_3634":695,"_31209":542,"_21628":53132,"_5":14884,"_28401":52741,"_3085":53133},[],"When you edit a shared policy, remember the change affects all its principals. To test a new scope, create a separate policy, grant it to a test identity and validate allowed and denied operations before replacing the old one.",{"_3634":696,"_31209":542,"_21628":53135,"_5":14884,"_28401":52745,"_3085":53136},[],"Keep `failOpen: false` unless a documented risk assessment justifies otherwise.",{"_3634":697,"_31209":542,"_21628":53138,"_5":14884,"_28401":52745,"_3085":53139},[],"Use groups or stable roles for people and independent identities for automations.",{"_3634":698,"_31209":542,"_21628":53141,"_5":14884,"_28401":52745,"_3085":53142},[],"Keep at least two recovery administrators and test their access periodically.",{"_3634":699,"_31209":542,"_21628":53144,"_5":14884,"_28401":52745,"_3085":53145},[],"Review active principals, their matches and their grants after IdP changes.",{"_3634":700,"_31209":542,"_21628":53147,"_5":14884,"_28401":52745,"_3085":53148},[],"Search for wildcards in policies before upgrading Lamassu.",{"_3634":701,"_31209":542,"_21628":53150,"_5":14884,"_28401":52745,"_3085":53151},[],"Review `skip_authz` routes and `default_action` settings in HTTP schemas when integrating or upgrading a service.",{"_3634":702,"_31209":542,"_21628":53153,"_5":14884,"_28401":52745,"_3085":53154},[],"Always test one allowed and one denied operation for each role.",{"_3634":703,"_31209":542,"_21628":53156,"_5":14884,"_28401":52745,"_3085":53157},[],"Correlate changes to principals, policies and grants with the audit logs.",{"_3634":704,"_31209":542,"_21628":53159,"_5":14884,"_28401":52753,"_3085":53160},[],"Authentication failed before permissions were evaluated. Check the JWT signature and expiration, issuer, audience and the availability of the JWKS configured in the Gateway. For X.509, check that the client certificate reaches the point that extracts the credential.",{"_3634":705,"_31209":542,"_21628":53162,"_5":14884,"_28401":52757,"_3085":53163},[],"The credential could be processed but did not produce a positive authorization. Review in this order:",{"_3634":706,"_31209":542,"_21628":53165,"_5":14884,"_28401":52757,"_3085":53166},[],"that an active principal of the correct type exists;",{"_3634":707,"_31209":542,"_21628":53168,"_5":14884,"_28401":52757,"_3085":53169},[],"that the claim paths and values match the real token exactly;",{"_3634":708,"_31209":542,"_21628":53171,"_5":14884,"_28401":52757,"_3085":53172},[],"that all of the principal's conditions hold;",{"_3634":709,"_31209":542,"_21628":53174,"_5":14884,"_28401":52757,"_3085":53175},[],"that the principal has the expected policy granted;",{"_3634":710,"_31209":542,"_21628":53177,"_5":14884,"_28401":52757,"_3085":53178},[],"that the policy includes the action and the requested resource type or route;",{"_3634":711,"_31209":542,"_21628":53180,"_5":14884,"_28401":52757,"_3085":53181},[],"that the identifier, relation, column filter or HTTP constraint includes the real resource.",{"_3634":712,"_31209":542,"_21628":53183,"_5":14884,"_28401":52757,"_3085":53184},[],"In the `authz` logs, an external endpoint decision includes `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` and the status code. These fields let you separate a matching failure from a permissions failure. With OpenTelemetry tracing enabled, a request that reaches the policy engine produces an `engine.CheckHTTPRequest` span whose attributes record `authz.allowed`, the matched policy and the matched principal. Correlation with the Gateway trace requires trace context to be propagated to authz.",{"_3634":713,"_31209":542,"_21628":53186,"_5":14884,"_28401":52757,"_3085":53187},[],"If a policy that relied on inherited access stopped granting it after an upgrade, look in the `authz` logs for `skipping relation that grants nothing`: the warning names the policy and the relation the schemas no longer declare. Correct that policy's relation so it matches the current schemas.",{"_3634":714,"_31209":542,"_21628":53189,"_5":14884,"_28401":52761,"_3085":53190},[],"Check that the bootstrap principal was created and that the policies were preloaded by the migration Job. Also verify that `services.authz.jwkUrl` is reachable from the `authz` pod; do not assume that a URL accessible from the browser also works inside the cluster.",{"_3634":715,"_31209":542,"_21628":53192,"_5":14884,"_28401":52765,"_3085":53193},[],"The path may be covered by a schema-level decision rather than by a policy: routes marked `skip_authz` allow any identity that matches an active principal, and a request under a `base_paths` prefix whose schema sets `default_action: allow` is likewise allowed without consulting policies. Confirm which of the two applies before looking for missing or misassigned grants.",{"_3634":716,"_31209":542,"_21628":53195,"_5":14884,"_28401":52769,"_3085":53196},[],"This is the expected behavior with `failOpen: false`. Restore the service, its PostgreSQL connection and its JWKS connectivity. Do not temporarily switch to `failOpen: true` without accepting that protected routes could become accessible without an authorization decision.",{"_3634":717,"_31209":542,"_21628":53198,"_5":14884,"_28401":52769,"_3085":53199},[],"Continue with Audit logs to investigate configuration changes or with Troubleshooting to diagnose the deployment.",{"_3634":718,"_31209":718,"_5":15244,"_3085":53201,"_31547":53202,"_21628":53203,"_28401":718},"Alerts and subscriptions",[50999,52511,52512],[],{"_3634":719,"_31209":718,"_21628":53205,"_5":14884,"_28401":718,"_3085":53206},[],"Send PKI events to people and external systems.",{"_3634":720,"_31209":718,"_5":31544,"_21628":53208,"_28401":53209,"_3085":53210},[],"/docs/platform/administration/alerts#how-it-works","How it works",{"_3634":721,"_31209":718,"_5":31544,"_21628":53212,"_28401":53213,"_3085":53214},[],"/docs/platform/administration/alerts#available-channels","Available channels",{"_3634":722,"_31209":718,"_5":31544,"_21628":53216,"_28401":53217,"_3085":53218},[],"/docs/platform/administration/alerts#create-a-subscription","Create a subscription",{"_3634":723,"_31209":718,"_5":31544,"_21628":53220,"_28401":53221,"_3085":53222},[],"/docs/platform/administration/alerts#choose-the-event","Choose the event",{"_3634":724,"_31209":718,"_5":31544,"_21628":53224,"_28401":53225,"_3085":53226},[],"/docs/platform/administration/alerts#configure-the-destination","Configure the destination",{"_3634":725,"_31209":718,"_5":31544,"_21628":53228,"_28401":53229,"_3085":53230},[],"/docs/platform/administration/alerts#limit-the-notifications","Limit the notifications",{"_3634":726,"_31209":718,"_5":31544,"_21628":53232,"_28401":53233,"_3085":53234},[],"/docs/platform/administration/alerts#review-and-activate","Review and activate",{"_3634":727,"_31209":718,"_5":31544,"_21628":53236,"_28401":53237,"_3085":53238},[],"/docs/platform/administration/alerts#configure-the-webhook-http-client","Configure the webhook HTTP client",{"_3634":728,"_31209":718,"_5":31544,"_21628":53240,"_28401":53241,"_3085":53242},[],"/docs/platform/administration/alerts#webhook-delivery-rules","Webhook delivery rules",{"_3634":729,"_31209":718,"_5":31544,"_21628":53244,"_28401":53245,"_3085":53246},[],"/docs/platform/administration/alerts#manage-a-subscription","Manage a subscription",{"_3634":730,"_31209":718,"_5":31544,"_21628":53248,"_28401":53249,"_3085":53250},[],"/docs/platform/administration/alerts#event-families","Event families",{"_3634":731,"_31209":718,"_21628":53252,"_5":14884,"_28401":718,"_3085":53253},[],"Subscriptions turn Lamassu events into actionable notifications. You can alert a team, feed an incident system or trigger an automation when a CA, certificate or device changes.",{"_3634":732,"_31209":718,"_21628":53255,"_5":14884,"_28401":53209,"_3085":53256},[],"A service publishes a domain event.",{"_3634":733,"_31209":718,"_21628":53258,"_5":14884,"_28401":53209,"_3085":53259},[],"Lamassu evaluates the subscriptions associated with that event type.",{"_3634":734,"_31209":718,"_21628":53261,"_5":14884,"_28401":53209,"_3085":53262},[],"Each subscription's filter decides whether it should be notified.",{"_3634":735,"_31209":718,"_21628":53264,"_5":14884,"_28401":53209,"_3085":53265},[],"Lamassu delivers the event to the configured channel.",{"_3634":736,"_31209":718,"_21628":53267,"_5":14884,"_28401":53209,"_3085":53268},[],"The event inventory shows when each type was last observed, how many times it has occurred and how many subscriptions it has. You can expand an event to inspect an example of its JSON payload before creating the filter.",{"_3634":737,"_31209":718,"_21628":53270,"_5":14884,"_28401":53213,"_3085":53271},[],"**Email** sends alerts to a person or an operational list. It only requires the destination address. Event content is rendered as HTML-escaped text, never as markup.",{"_3634":738,"_31209":718,"_21628":53273,"_5":14884,"_28401":53213,"_3085":53274},[],"**Microsoft Teams** posts the notification to a channel through its webhook URL.",{"_3634":739,"_31209":718,"_21628":53276,"_5":14884,"_28401":53213,"_3085":53277},[],"**Webhook** delivers the event to an automation, SIEM or incident system via `POST` or `PUT`.",{"_3634":740,"_31209":718,"_21628":53279,"_5":14884,"_28401":53213,"_3085":53280},[],"The Microsoft Teams and Webhook channels accept an optional `http_client` block that authenticates the call to the receiver. `auth_mode` selects `noauth` (the default), `apikey`, `jwt` or `mtls`; each mode requires its own options:",{"_3634":741,"_31209":718,"_21628":53282,"_5":14884,"_28401":53213,"_3085":53283},[],"`apikey_options` requires `header` and `key`.",{"_3634":742,"_31209":718,"_21628":53285,"_5":14884,"_28401":53213,"_3085":53286},[],"`jwt_options` requires `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3634":743,"_31209":718,"_21628":53288,"_5":14884,"_28401":53213,"_3085":53289},[],"`mtls_options` requires `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted. Values that reference files on the server are rejected, and the pair must decode to a matching certificate and private key.",{"_3634":744,"_31209":718,"_21628":53291,"_5":14884,"_28401":53213,"_3085":53292},[],"The alerts API reference documents the full `http_client` schema.",{"_3634":745,"_31209":718,"_21628":53294,"_5":14884,"_28401":53221,"_3085":53295},[],"Open **Alerts**, locate the event type and select **Subscribe**. Review the latest JSON example to identify the fields you will need to filter on.",{"_3634":746,"_31209":718,"_21628":53297,"_5":14884,"_28401":53225,"_3085":53298},[],"Select Email, Microsoft Teams or Webhook and enter the channel details.",{"_3634":747,"_31209":718,"_21628":53300,"_5":14884,"_28401":53229,"_3085":53301},[],"Add a filter if you don't want to receive every instance of the event.",{"_3634":748,"_31209":718,"_21628":53303,"_5":14884,"_28401":53229,"_3085":53304},[],"**None** notifies all instances of the event.",{"_3634":749,"_31209":718,"_21628":53306,"_5":14884,"_28401":53229,"_3085":53307},[],"**JSON Path** evaluates one or more specific fields.",{"_3634":750,"_31209":718,"_21628":53309,"_5":14884,"_28401":53229,"_3085":53310},[],"**JSON Schema** accepts only payloads with a particular structure.",{"_3634":751,"_31209":718,"_21628":53312,"_5":14884,"_28401":53229,"_3085":53313},[],"**JavaScript** lets you express custom logic. Each filter runs for at most 100 milliseconds; a filter that exceeds this limit fails the condition and the notification is skipped with the error `javascript filter execution timed out`.",{"_3634":752,"_31209":718,"_21628":53315,"_5":14884,"_28401":53229,"_3085":53316},[],"For example, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limits a subscription to devices without an identity.",{"_3634":753,"_31209":718,"_21628":53318,"_5":14884,"_28401":53229,"_3085":53319},[],"The console evaluates the filter against the JSON shown in the **Input Event** editor, which is prefilled with the latest event, and reports whether it matches. For JSON Path and JavaScript filters, it shows **The filter matches this Cloud Event** or **The filter does not match this Cloud Event**. JSON Path expressions are evaluated against the full Cloud Event, so the default `$.data` selects the event's `data` field, and the expression must start with `$`.",{"_3634":754,"_31209":718,"_21628":53321,"_5":14884,"_28401":53233,"_3085":53322},[],"Check the event, channel and filter in the summary. Select **Confirm Subscription** to start delivery.",{"_3634":755,"_31209":718,"_21628":53324,"_5":14884,"_28401":53237,"_3085":53325},[],"The Webhook and Microsoft Teams channels show this configuration in the subscribe form, at the channel step, and again when editing a subscription; Email does not use it. The fields map to the optional `http_client` block described above:",{"_3634":756,"_31209":718,"_21628":53327,"_5":14884,"_28401":53237,"_3085":53328},[],"**Log Level** selects `debug`, `info`, `warn` or `error`; `info` is the default.",{"_3634":757,"_31209":718,"_21628":53330,"_5":14884,"_28401":53237,"_3085":53331},[],"**Call Timeout** defaults to 10 seconds. The console rejects a value above 30 seconds with `Webhook timeout must be at most 30s.`; the API clamps the same value to the cap instead (see Calls are bounded).",{"_3634":758,"_31209":718,"_21628":53333,"_5":14884,"_28401":53237,"_3085":53334},[],"There is no TLS-verification switch for these channels, because the service always verifies the receiver certificate (see TLS is always verified).",{"_3634":759,"_31209":718,"_21628":53336,"_5":14884,"_28401":53237,"_3085":53337},[],"**HTTP Authentication** selects `No Authentication` (the default), `API Key` (API key value and Header Name, `X-API-Key` by default), `OIDC Client Credentials` (Client ID, Client Secret and Well-Known URL) or `Mutual TLS` (Client Certificate and Client Private Key pasted as PEM). A stored private key stays hidden until you select **Show**.",{"_3634":760,"_31209":718,"_21628":53339,"_5":14884,"_28401":53237,"_3085":53340},[],"A `http://` URL shows the console warning `Unencrypted HTTP connection` (see the Credentials over http\\:// callout below).",{"_3634":761,"_31209":718,"_21628":53342,"_5":14884,"_28401":53237,"_3085":53343},[],"The form validates inline against the same delivery rules: the webhook URL and the OIDC Well-Known URL must be absolute `http` or `https` URLs, an API-key header may not use a reserved name, and the mTLS certificate and key must be PEM content, not file paths.",{"_3634":762,"_31209":718,"_21628":53345,"_5":14884,"_28401":53237,"_3085":53346},[],"The summary in the Confirm step shows the authentication as `None`, `OIDC client credentials`, `API key` or `Mutual TLS`. The subscription details show the authentication, the API key header name (never the value), the OIDC issuer URL, mTLS as `Configured` and a fixed `TLS verification: Verified` row. The API key, client secret and private key are not shown in the subscription details.",{"_3634":763,"_31209":718,"_21628":53348,"_5":14884,"_28401":53241,"_3085":53349},[],"Notifications delivered through the Microsoft Teams and Webhook channels follow a fixed HTTP policy:",{"_3634":764,"_31209":718,"_21628":53351,"_5":14884,"_28401":53241,"_3085":53352},[],"**TLS is always verified.** The receiver certificate is checked against the system trust store. `insecure_skip_verify` is enforced as `false` — including when it is set to `true` — so self-signed or otherwise untrusted receivers fail delivery.",{"_3634":765,"_31209":718,"_21628":53354,"_5":14884,"_28401":53241,"_3085":53355},[],"**Redirects are not followed.** A `3xx` response fails with `unexpected status code: <n>: redirects are not followed`. Configure `webhook_url` with the final absolute `http` or `https` URL: an `http://` address that an ingress redirects to `https://` stops working.",{"_3634":766,"_31209":718,"_21628":53357,"_5":14884,"_28401":53241,"_3085":53358},[],"**Calls are bounded.** A call defaults to a 10 second timeout; a configured `call_timeout` is capped at 30 seconds. Values above the cap are clamped, not rejected.",{"_3634":767,"_31209":718,"_21628":53360,"_5":14884,"_28401":53241,"_3085":53361},[],"**The response body is ignored.** Delivery checks the status code only, so the receiver may answer with any body.",{"_3634":768,"_31209":718,"_21628":53363,"_5":14884,"_28401":53241,"_3085":53364},[],"**API-key headers are restricted.** A custom `apikey_options.header` may not use names that the platform or receiving services trust — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-`. Comparisons are case-insensitive.",{"_3634":769,"_31209":718,"_21628":53366,"_5":14884,"_28401":53241,"_3085":53367},[],"**Invalid configurations are rejected at subscribe time.** A channel configuration that would fail on every delivery returns HTTP 400 with a body that starts with `struct validation error:`, and the subscription is not created.",{"_3634":770,"_31209":718,"_21628":53369,"_5":14884,"_28401":53241,"_3085":53370},[],"Credentials are sent regardless of the URL scheme. With an `http://` `webhook_url`, the API key or bearer token travels in cleartext and mTLS has no effect. Prefer `https://` for `webhook_url`, `oidc_well_known` and the token endpoint it advertises.",{"_3634":771,"_31209":718,"_21628":53372,"_5":14884,"_28401":53245,"_3085":53373},[],"Open an existing subscription to review its destination and filter, modify the configuration or select **Unsubscribe**. Remove subscriptions that no longer have an operational owner to avoid ignored deliveries or stale endpoints.",{"_3634":772,"_31209":718,"_21628":53375,"_5":14884,"_28401":53245,"_3085":53376},[],"Subscriptions created with older console versions may store the webhook target under `url` and `method` instead of `webhook_url` and `webhook_method`. The service delivers only through `webhook_url` and `webhook_method`, so such a subscription does not deliver even though the subscription details show the stored target. Open the subscription and save it again: the edit form prefills the stored target, and saving rewrites the channel configuration in the current layout.",{"_3634":773,"_31209":718,"_21628":53378,"_5":14884,"_28401":53249,"_3085":53379},[],"**Authorities:** `ca.create`, `ca.import`, `ca.reissue` and `ca.delete`.",{"_3634":774,"_31209":718,"_21628":53381,"_5":14884,"_28401":53249,"_3085":53382},[],"**Certificates:** `ca.sign.certificate` and `certificate.delete`.",{"_3634":775,"_31209":718,"_21628":53384,"_5":14884,"_28401":53249,"_3085":53385},[],"**Profiles:** `profile.issuance.create`, `profile.issuance.update` and `profile.issuance.delete`.",{"_3634":776,"_31209":718,"_21628":53387,"_5":14884,"_28401":53249,"_3085":53388},[],"**Enrollment:** `dms.create`, `dms.update`, `dms.enroll` and `dms.reenroll`.",{"_3634":777,"_31209":718,"_21628":53390,"_5":14884,"_28401":53249,"_3085":53391},[],"**Devices:** `device.create`, `device.identity.update` and `device.status.update`.",{"_3634":778,"_31209":718,"_21628":53393,"_5":14884,"_28401":53249,"_3085":53394},[],"**Validation:** `va.role.crl.create`, `va.crl-settings.init`, `va.crl-settings.update`, `va.crl-settings.finalize`, `va.crl-settings.archive` and `va.crl-settings.delete`.",{"_3634":779,"_31209":718,"_21628":53396,"_5":14884,"_28401":53249,"_3085":53397},[],"**Keys:** `kms.create`, `kms.import`, `kms.sign` and `kms.delete`.",{"_3634":780,"_31209":718,"_21628":53399,"_5":14884,"_28401":53249,"_3085":53400},[],"Use the catalog shown in the console as the source for the types available in your deployed version.",{"_3634":781,"_31209":718,"_21628":53402,"_5":14884,"_28401":53249,"_3085":53403},[],"Since 4.0.0, `va.crl-settings.init` and `va.crl-settings.update` carry the CRL settings of a CA (`ca_id`) and replace `va.role.crl.init` and `va.role.update`. The upgrade migration renames the types of existing subscriptions automatically, but it does not rewrite their conditions: review filters that read the old payload or the old `crl/<ski>` subject, including filters for `va.role.crl.create` (see 3.8.0 to 4.0.0).",{"_3634":782,"_31209":718,"_21628":53405,"_5":14884,"_28401":53249,"_3085":53406},[],"The VA also publishes `va.crl-settings.finalize` when a CA is revoked permanently or expires, `va.crl-settings.archive` when the CA is deleted, and `va.crl-settings.delete` when archived settings are removed.",{"_3634":783,"_31209":783,"_5":15244,"_3085":53408,"_31547":53409,"_21628":53410,"_28401":783},"Audit logs",[50999,52511,52512],[],{"_3634":784,"_31209":783,"_21628":53412,"_5":14884,"_28401":783,"_3085":53413},[],"Understand which audit events Lamassu generates and how to turn them into a durable trail.",{"_3634":785,"_31209":783,"_5":31544,"_21628":53415,"_28401":53416,"_3085":53417},[],"/docs/platform/administration/audit-logs#what-an-event-contains","What an event contains",{"_3634":786,"_31209":783,"_5":31544,"_21628":53419,"_28401":53420,"_3085":53421},[],"/docs/platform/administration/audit-logs#coverage","Coverage",{"_3634":787,"_31209":783,"_5":31544,"_21628":53423,"_28401":53424,"_3085":53425},[],"/docs/platform/administration/audit-logs#publication-and-persistence","Publication and persistence",{"_3634":788,"_31209":783,"_5":31544,"_21628":53427,"_28401":53428,"_3085":53429},[],"/docs/platform/administration/audit-logs#sensitive-data","Sensitive data",{"_3634":789,"_31209":783,"_5":31544,"_21628":53431,"_28401":53432,"_3085":53433},[],"/docs/platform/administration/audit-logs#a-reproducible-investigation","A reproducible investigation",{"_3634":790,"_31209":783,"_5":31544,"_21628":53435,"_28401":53436,"_3085":53437},[],"/docs/platform/administration/audit-logs#bound-the-interval","Bound the interval",{"_3634":791,"_31209":783,"_5":31544,"_21628":53439,"_28401":53440,"_3085":53441},[],"/docs/platform/administration/audit-logs#identify-the-operation","Identify the operation",{"_3634":792,"_31209":783,"_5":31544,"_21628":53443,"_28401":53444,"_3085":53445},[],"/docs/platform/administration/audit-logs#attribute-the-principal","Attribute the principal",{"_3634":793,"_31209":783,"_5":31544,"_21628":53447,"_28401":53448,"_3085":53449},[],"/docs/platform/administration/audit-logs#compare-intent-and-result","Compare intent and result",{"_3634":794,"_31209":783,"_5":31544,"_21628":53451,"_28401":53452,"_3085":53453},[],"/docs/platform/administration/audit-logs#follow-the-effect","Follow the effect",{"_3634":795,"_31209":783,"_5":31544,"_21628":53455,"_28401":53456,"_3085":53457},[],"/docs/platform/administration/audit-logs#periodic-verification","Periodic verification",{"_3634":796,"_31209":783,"_21628":53459,"_5":14884,"_28401":783,"_3085":53460},[],"Lamassu instruments the mutable operations of its services with audit events. Each event describes the operation, the principals that matched, the input, the result and whether it ended in error.",{"_3634":797,"_31209":783,"_21628":53462,"_5":14884,"_28401":53416,"_3085":53463},[],"The audit body includes:",{"_3634":798,"_31209":783,"_21628":53465,"_5":14884,"_28401":53416,"_3085":53466},[],"input: data received by the operation;",{"_3634":799,"_31209":783,"_21628":53468,"_5":14884,"_28401":53416,"_3085":53469},[],"has\\_error: whether the service returned an error;",{"_3634":800,"_31209":783,"_21628":53471,"_5":14884,"_28401":53416,"_3085":53472},[],"output: produced result or error message;",{"_3634":801,"_31209":783,"_21628":53474,"_5":14884,"_28401":53416,"_3085":53475},[],"principals: identifiers of the principals that matched the request.",{"_3634":802,"_31209":783,"_21628":53477,"_5":14884,"_28401":53416,"_3085":53478},[],"Successful operations use a type prefixed with audit.. Failures publish the operation type suffixed with .error. The CloudEvents event additionally adds source, identifier, date and type.",{"_3634":803,"_31209":783,"_21628":53480,"_5":14884,"_28401":53416,"_3085":53481},[],"The middlewares publish the record after executing the operation, whether it succeeded or returned an error. This lets you investigate attempts as well as confirmed changes.",{"_3634":804,"_31209":783,"_21628":53483,"_5":14884,"_28401":53420,"_3085":53484},[],"The backend applies auditing to mutations of:",{"_3634":805,"_31209":783,"_21628":53486,"_5":14884,"_28401":53420,"_3085":53487},[],"authorities, certificates and issuance profiles;",{"_3634":806,"_31209":783,"_21628":53489,"_5":14884,"_28401":53420,"_3085":53490},[],"keys and KMS engines;",{"_3634":807,"_31209":783,"_21628":53492,"_5":14884,"_28401":53420,"_3085":53493},[],"devices and identities;",{"_3634":808,"_31209":783,"_21628":53495,"_5":14884,"_28401":53420,"_3085":53496},[],"DMSs and enrollment operations;",{"_3634":809,"_31209":783,"_21628":53498,"_5":14884,"_28401":53420,"_3085":53499},[],"validation functions and CRL;",{"_3634":810,"_31209":783,"_21628":53501,"_5":14884,"_28401":53420,"_3085":53502},[],"principals, policies and authorization grants.",{"_3634":811,"_31209":783,"_21628":53504,"_5":14884,"_28401":53420,"_3085":53505},[],"Do not confuse these events with domain events. A domain event announces that a resource changed so another component can react; the audit event keeps input, output and principal context for investigation.",{"_3634":812,"_31209":783,"_21628":53507,"_5":14884,"_28401":53424,"_3085":53508},[],"Services publish audit records to the event bus when their PublisherEventBus is enabled. The backend code does not, by itself, implement a queryable, durable audit file.",{"_3634":813,"_31209":783,"_21628":53510,"_5":14884,"_28401":53424,"_3085":53511},[],"If you need retention, search, tamper protection or regulatory export, connect a consumer that persists the events into the system approved by your organization.",{"_3634":814,"_31209":783,"_21628":53513,"_5":14884,"_28401":53424,"_3085":53514},[],"Design the consumer to:",{"_3634":815,"_31209":783,"_21628":53516,"_5":14884,"_28401":53424,"_3085":53517},[],"subscribe to the audit.# types and also to operation types ending in .error;",{"_3634":816,"_31209":783,"_21628":53519,"_5":14884,"_28401":53424,"_3085":53520},[],"keep the complete CloudEvent unmodified;",{"_3634":817,"_31209":783,"_21628":53522,"_5":14884,"_28401":53424,"_3085":53523},[],"record the ingestion time and detect duplicates by ID;",{"_3634":818,"_31209":783,"_21628":53525,"_5":14884,"_28401":53424,"_3085":53526},[],"encrypt in transit and at rest;",{"_3634":819,"_31209":783,"_21628":53528,"_5":14884,"_28401":53424,"_3085":53529},[],"restrict reading and deletion to a role separate from the PKI operator;",{"_3634":820,"_31209":783,"_21628":53531,"_5":14884,"_28401":53424,"_3085":53532},[],"apply an explicit retention and legal hold policy;",{"_3634":821,"_31209":783,"_21628":53534,"_5":14884,"_28401":53424,"_3085":53535},[],"alert if it stops consuming or the pending queue grows.",{"_3634":822,"_31209":783,"_21628":53537,"_5":14884,"_28401":53428,"_3085":53538},[],"The input and output fields can contain subjects, metadata, public material, configuration or error messages. Evaluate their classification before sending them to an external platform.",{"_3634":823,"_31209":783,"_21628":53540,"_5":14884,"_28401":53428,"_3085":53541},[],"Do not log private keys, provider secrets or full tokens in automations around Lamassu. Restrict export and apply redaction at the destination without destroying the fields needed for attribution.",{"_3634":824,"_31209":783,"_21628":53543,"_5":14884,"_28401":53436,"_3085":53544},[],"Start from the reported time and normalize every source to UTC.",{"_3634":825,"_31209":783,"_21628":53546,"_5":14884,"_28401":53440,"_3085":53547},[],"Filter by event type, service source and resource identifier.",{"_3634":826,"_31209":783,"_21628":53549,"_5":14884,"_28401":53444,"_3085":53550},[],"Review principals and correlate them with the OIDC provider or the X.509 identity valid at that moment.",{"_3634":827,"_31209":783,"_21628":53552,"_5":14884,"_28401":53448,"_3085":53553},[],"Contrast input, has\\_error and output. A failed attempt does not mean the resource changed.",{"_3634":828,"_31209":783,"_21628":53555,"_5":14884,"_28401":53452,"_3085":53556},[],"Look for the domain events and service records that share resource and time window. In a CA revocation, include the cascading operations.",{"_3634":829,"_31209":783,"_21628":53558,"_5":14884,"_28401":53456,"_3085":53559},[],"Generate a controlled mutation in a test environment and check that:",{"_3634":830,"_31209":783,"_21628":53561,"_5":14884,"_28401":53456,"_3085":53562},[],"a successful audit event appears;",{"_3634":831,"_31209":783,"_21628":53564,"_5":14884,"_28401":53456,"_3085":53565},[],"the principal matches the identity used;",{"_3634":832,"_31209":783,"_21628":53567,"_5":14884,"_28401":53456,"_3085":53568},[],"the consumer persists it exactly once;",{"_3634":833,"_31209":783,"_21628":53570,"_5":14884,"_28401":53456,"_3085":53571},[],"it can be retrieved by resource, actor and period;",{"_3634":834,"_31209":783,"_21628":53573,"_5":14884,"_28401":53456,"_3085":53574},[],"a consumer outage raises an alert.",{"_3634":835,"_31209":783,"_21628":53576,"_5":14884,"_28401":53456,"_3085":53577},[],"For metrics, traces and technical logs of the deployment, see Troubleshooting. Audit answers \"who tried to change what\"; observability explains how the system behaved.",{"_3634":836,"_31209":836,"_5":15244,"_3085":53579,"_31547":53580,"_21628":53581,"_28401":836},"Platform architecture",[50999,52511],[],{"_3634":837,"_31209":836,"_21628":53583,"_5":14884,"_28401":836,"_3085":53584},[],"Lamassu components and how control, keys, issuance and devices relate.",{"_3634":838,"_31209":836,"_5":31544,"_21628":53586,"_28401":53587,"_3085":53588},[],"/docs/platform/concepts/architecture#control-plane","Control plane",{"_3634":839,"_31209":836,"_5":31544,"_21628":53590,"_28401":53591,"_3085":53592},[],"/docs/platform/concepts/architecture#key-custody-and-cryptographic-operations","Key custody and cryptographic operations",{"_3634":840,"_31209":836,"_5":31544,"_21628":53594,"_28401":53595,"_3085":53596},[],"/docs/platform/concepts/architecture#issuance-and-enrollment","Issuance and enrollment",{"_3634":841,"_31209":836,"_5":31544,"_21628":53598,"_28401":53599,"_3085":53600},[],"/docs/platform/concepts/architecture#status-and-validation","Status and validation",{"_3634":842,"_31209":836,"_5":31544,"_21628":53602,"_28401":53603,"_3085":53604},[],"/docs/platform/concepts/architecture#platform-dependencies","Platform dependencies",{"_3634":843,"_31209":836,"_21628":53606,"_5":14884,"_28401":836,"_3085":53607},[],"Lamassu deploys as a set of independent services. This separation keeps every component from needing direct access to private keys and lets each capability scale according to load.",{"_3634":844,"_31209":836,"_21628":53609,"_5":14884,"_28401":836,"_3085":53610},[],"Switch to the low level to see the internals of the Lamassu platform box (CA, KMS, DMS, Device Manager, VA, Alerts, AWS IoT connector, Job Manager and the console/API), and to medium to see it as a single platform alongside its external dependencies.",{"_3634":845,"_31209":836,"_21628":53612,"_5":14884,"_28401":53587,"_3085":53613},[],"The console and the APIs manage authorities, certificates, DMSs, devices, alerts and configuration. Domain events allow connectors and automations to react to changes without continuously polling the platform.",{"_3634":846,"_31209":836,"_21628":53615,"_5":14884,"_28401":53591,"_3085":53616},[],"The KMS offers a common interface over software engines, PKCS#11 and cloud providers. The selected engine keeps the key or delegates the cryptographic operation without the other services knowing its implementation.",{"_3634":847,"_31209":836,"_21628":53618,"_5":14884,"_28401":53595,"_3085":53619},[],"The CA service issues certificates and maintains the relationship with its authority. The DMS applies the enrollment rules and exposes the EST flows so a device can request or renew an identity.",{"_3634":848,"_31209":836,"_21628":53621,"_5":14884,"_28401":53599,"_3085":53622},[],"Device Manager keeps the operational view of the device and its history. The Validation Authority publishes OCSP and CRLs so other systems can decide whether to trust a presented certificate.",{"_3634":849,"_31209":836,"_21628":53624,"_5":14884,"_28401":53603,"_3085":53625},[],"In a self-managed deployment, Lamassu uses PostgreSQL for persistence, RabbitMQ for messaging and an OIDC provider for authentication. See the deployment architecture for how the services are published on Kubernetes.",{"_3634":850,"_31209":850,"_5":15244,"_3085":53627,"_31547":53628,"_21628":53629,"_28401":850},"How Lamassu works",[50999,52511],[],{"_3634":851,"_31209":850,"_21628":53631,"_5":14884,"_28401":850,"_3085":53632},[],"The mental model of trust, keys, certificates and devices.",{"_3634":852,"_31209":850,"_5":31544,"_21628":53634,"_28401":53635,"_3085":53636},[],"/docs/platform/concepts/overview#the-model-in-five-pieces","The model in five pieces",{"_3634":853,"_31209":850,"_5":31544,"_21628":53638,"_28401":53639,"_3085":53640},[],"/docs/platform/concepts/overview#from-onboarding-to-operation","From onboarding to operation",{"_3634":854,"_31209":850,"_21628":53642,"_5":14884,"_28401":850,"_3085":53643},[],"Lamassu connects three elements: a **root of trust**, an **issuance policy** and an **entity that needs to prove its identity**. The platform coordinates these elements throughout the certificate lifecycle.",{"_3634":855,"_31209":850,"_21628":53645,"_5":14884,"_28401":53635,"_3085":53646},[],"**Cryptographic engine.** Generates or safeguards keys and executes private-key operations without exposing key material to the rest of the services.",{"_3634":856,"_31209":850,"_21628":53648,"_5":14884,"_28401":53635,"_3085":53649},[],"**Certification Authority (CA).** Signs certificates and establishes the chain of trust.",{"_3634":857,"_31209":850,"_21628":53651,"_5":14884,"_28401":53635,"_3085":53652},[],"**Device Management Service (DMS).** Defines how the devices of a fleet are registered, authenticated and renewed.",{"_3634":858,"_31209":850,"_21628":53654,"_5":14884,"_28401":53635,"_3085":53655},[],"**Device.** Keeps its private key and presents the certificate to prove its identity.",{"_3634":859,"_31209":850,"_21628":53657,"_5":14884,"_28401":53635,"_3085":53658},[],"**Validation Authority (VA).** Publishes the status of certificates through OCSP and CRL.",{"_3634":860,"_31209":850,"_21628":53660,"_5":14884,"_28401":53639,"_3085":53661},[],"An administrator configures a cryptographic engine and creates or imports a CA.",{"_3634":861,"_31209":850,"_21628":53663,"_5":14884,"_28401":53639,"_3085":53664},[],"A DMS relates that CA to an enrollment policy.",{"_3634":862,"_31209":850,"_21628":53666,"_5":14884,"_28401":53639,"_3085":53667},[],"The device generates a key and requests a certificate through EST, or an operator assigns it an identity.",{"_3634":863,"_31209":850,"_21628":53669,"_5":14884,"_28401":53639,"_3085":53670},[],"Lamassu keeps the inventory, history and status of the identity.",{"_3634":864,"_31209":850,"_21628":53672,"_5":14884,"_28401":53639,"_3085":53673},[],"Consumers check the chain and query OCSP or a CRL when they need to know whether it is still valid.",{"_3634":865,"_31209":850,"_21628":53675,"_5":14884,"_28401":53639,"_3085":53676},[],"<Card title=\"Architecture\" description=\"Get to know the components and where each one's responsibility ends.\" href=\"/docs/platform/concepts/architecture\" />",{"_3634":866,"_31209":850,"_21628":53678,"_5":14884,"_28401":53639,"_3085":53679},[],"<Card title=\"Identity lifecycle\" description=\"Follow a certificate from enrollment to renewal or revocation.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3634":867,"_31209":867,"_5":15244,"_3085":53681,"_31547":53682,"_21628":53684,"_28401":867},"Devices and identities",[50999,52511,53683,53681],"IoT Fleets",[],{"_3634":868,"_31209":867,"_21628":53686,"_5":14884,"_28401":867,"_3085":53687},[],"Register, inspect and retire devices while checking their current identity and history.",{"_3634":869,"_31209":867,"_5":31544,"_21628":53689,"_28401":53690,"_3085":53691},[],"/docs/platform/iot-fleets/device-management#device-states","Device states",{"_3634":870,"_31209":867,"_5":31544,"_21628":53693,"_28401":53694,"_3085":53695},[],"/docs/platform/iot-fleets/device-management#inspect-a-device","Inspect a device",{"_3634":871,"_31209":867,"_5":31544,"_21628":53697,"_28401":53698,"_3085":53699},[],"/docs/platform/iot-fleets/device-management#register-a-device-manually","Register a device manually",{"_3634":872,"_31209":867,"_5":31544,"_21628":53701,"_28401":53702,"_3085":53703},[],"/docs/platform/iot-fleets/device-management#create-the-device","Create the device",{"_3634":873,"_31209":867,"_5":31544,"_21628":53705,"_28401":53706,"_3085":53707},[],"/docs/platform/iot-fleets/device-management#define-its-membership","Define its membership",{"_3634":874,"_31209":867,"_5":31544,"_21628":53709,"_28401":53710,"_3085":53711},[],"/docs/platform/iot-fleets/device-management#classify-the-device","Classify the device",{"_3634":875,"_31209":867,"_5":31544,"_21628":53713,"_28401":53714,"_3085":53715},[],"/docs/platform/iot-fleets/device-management#verify-the-registration","Verify the registration",{"_3634":876,"_31209":867,"_5":31544,"_21628":53717,"_28401":53718,"_3085":53719},[],"/docs/platform/iot-fleets/device-management#assign-an-identity-manually","Assign an identity manually",{"_3634":877,"_31209":867,"_5":31544,"_21628":53721,"_28401":53722,"_3085":53723},[],"/docs/platform/iot-fleets/device-management#revoke-the-current-identity","Revoke the current identity",{"_3634":878,"_31209":867,"_5":31544,"_21628":53725,"_28401":53726,"_3085":53727},[],"/docs/platform/iot-fleets/device-management#decommission-a-device","Decommission a device",{"_3634":879,"_31209":867,"_5":31544,"_21628":53729,"_28401":53730,"_3085":53731},[],"/docs/platform/iot-fleets/device-management#automate-enrollment","Automate enrollment",{"_3634":880,"_31209":867,"_21628":53733,"_5":14884,"_28401":867,"_3085":53734},[],"This guide is for a fleet operator. You need device, DMS and certificate permissions for the intended actions. A fleet is organized through these resources, tags and metadata; there is no separate “fleet” object to create.",{"_3634":881,"_31209":867,"_21628":53736,"_5":14884,"_28401":867,"_3085":53737},[],"Each device has a `Device ID`, one owning DMS (`dms_owner`) and, once provisioned, an identity slot with an active version and previous versions. In these flows, keep the CSR and certificate `Common Name` equal to `Device ID`: binding uses that CN to update the device.",{"_3634":882,"_31209":867,"_21628":53739,"_5":14884,"_28401":53690,"_3085":53740},[],"Operational view",{"_3634":883,"_31209":867,"_21628":53742,"_5":14884,"_28401":53690,"_3085":53743},[],"Meaning",{"_3634":884,"_31209":867,"_21628":53745,"_5":14884,"_28401":53690,"_3085":53746},[],"**No Identity**",{"_3634":885,"_31209":867,"_21628":53748,"_5":14884,"_28401":53690,"_3085":53749},[],"A record exists without an associated identity.",{"_3634":886,"_31209":867,"_21628":53751,"_5":14884,"_28401":53690,"_3085":53752},[],"**Active**",{"_3634":887,"_31209":867,"_21628":53754,"_5":14884,"_28401":53690,"_3085":53755},[],"The slot is active; also check certificate dates, status and usages.",{"_3634":888,"_31209":867,"_21628":53757,"_5":14884,"_28401":53690,"_3085":53758},[],"**Renewal Pending**",{"_3634":889,"_31209":867,"_21628":53760,"_5":14884,"_28401":53690,"_3085":53761},[],"The identity is in the operational renewal window.",{"_3634":890,"_31209":867,"_21628":53763,"_5":14884,"_28401":53690,"_3085":53764},[],"**Expiring Soon**",{"_3634":891,"_31209":867,"_21628":53766,"_5":14884,"_28401":53690,"_3085":53767},[],"Expiration is approaching according to configured thresholds.",{"_3634":892,"_31209":867,"_21628":53769,"_5":14884,"_28401":53690,"_3085":53770},[],"**Expired**",{"_3634":893,"_31209":867,"_21628":53772,"_5":14884,"_28401":53690,"_3085":53773},[],"The identity has expired.",{"_3634":894,"_31209":867,"_21628":53775,"_5":14884,"_28401":53690,"_3085":53776},[],"**Revoked**",{"_3634":895,"_31209":867,"_21628":53778,"_5":14884,"_28401":53690,"_3085":53779},[],"The identity is marked revoked. A hold cascaded from its CA shows here and is lifted when that CA is released.",{"_3634":896,"_31209":867,"_21628":53781,"_5":14884,"_28401":53690,"_3085":53782},[],"**Decommissioned**",{"_3634":897,"_31209":867,"_21628":53784,"_5":14884,"_28401":53690,"_3085":53785},[],"The record is retired and ordinary updates do not restore operation.",{"_3634":898,"_31209":867,"_21628":53787,"_5":14884,"_28401":53690,"_3085":53788},[],"Device, slot and certificate states are distinct. Events and jobs can update the view after saving a certificate; an **Active** label does not establish consumer acceptance.",{"_3634":899,"_31209":867,"_21628":53790,"_5":14884,"_28401":53694,"_3085":53791},[],"Filter the inventory by ID, tags and status. Open details and record the owning DMS, active version and current certificate serial.",{"_3634":900,"_31209":867,"_21628":53793,"_5":14884,"_28401":53694,"_3085":53794},[],"**Certificate History** relates previous and current versions. Replacing the slot does not by itself revoke every previous version.",{"_3634":901,"_31209":867,"_21628":53796,"_5":14884,"_28401":53694,"_3085":53797},[],"**Device Event Timeline** helps reconstruct registration, provisioning, renewal and status changes. A change may be saved even if event persistence fails; also inspect the record and certificates.",{"_3634":902,"_31209":867,"_21628":53799,"_5":14884,"_28401":53694,"_3085":53800},[],"Compare these values with the identity installed on the device. Updating a Lamassu slot does not install files on the remote equipment.",{"_3634":903,"_31209":867,"_21628":53802,"_5":14884,"_28401":53698,"_3085":53803},[],"Use this flow to prepare inventory or assign an identity through the console. You need an existing DMS.",{"_3634":904,"_31209":867,"_21628":53805,"_5":14884,"_28401":53702,"_3085":53806},[],"Open registration in **Managed Devices**. Confirm the ID does not already exist in another DMS: ID lookup is not restricted to a fleet.",{"_3634":905,"_31209":867,"_21628":53808,"_5":14884,"_28401":53706,"_3085":53809},[],"Enter **Device ID** and select its owning DMS. The console’s **Registration Authority** label refers to that DMS.",{"_3634":906,"_31209":867,"_21628":53811,"_5":14884,"_28401":53710,"_3085":53812},[],"Add model, environment or location tags and an icon according to your inventory.",{"_3634":907,"_31209":867,"_21628":53814,"_5":14884,"_28401":53714,"_3085":53815},[],"Read the device again: require the intended DMS and **No Identity**. Follow Manual registration to complete assignment.",{"_3634":908,"_31209":867,"_21628":53817,"_5":14884,"_28401":53714,"_3085":53818},[],"Preregistration does not establish that `/simpleenroll` will admit the request. Review its interaction with `enable_replaceable_enrollment` in Provisioning strategies.",{"_3634":909,"_31209":867,"_21628":53820,"_5":14884,"_28401":53718,"_3085":53821},[],"From **No Identity**, use **Assign Identity**:",{"_3634":910,"_31209":867,"_21628":53823,"_5":14884,"_28401":53718,"_3085":53824},[],"Select an active, current certificate suitable for the consumer, with `CN` exactly equal to `Device ID`.",{"_3634":911,"_31209":867,"_21628":53826,"_5":14884,"_28401":53718,"_3085":53827},[],"If unavailable, **Issue New Instead** starts issuance using the intended CA. Review the profile first.",{"_3634":912,"_31209":867,"_21628":53829,"_5":14884,"_28401":53718,"_3085":53830},[],"Confirm and read the serial, active version and history again.",{"_3634":913,"_31209":867,"_21628":53832,"_5":14884,"_28401":53718,"_3085":53833},[],"Install the key/certificate pair and required intermediates on the device and test usage.",{"_3634":914,"_31209":867,"_21628":53835,"_5":14884,"_28401":53718,"_3085":53836},[],"Issuing, binding and installing are separate steps. If an operation fails, check which steps persisted before repeating it.",{"_3634":915,"_31209":867,"_21628":53838,"_5":14884,"_28401":53722,"_3085":53839},[],"Locate the active serial in history and revoke it with an appropriate reason. Verify the record, OCSP/CRL publication and rejection of a new consumer connection using the certificate guide.",{"_3634":916,"_31209":867,"_21628":53841,"_5":14884,"_28401":53722,"_3085":53842},[],"Revocation does not remove the device. It does not automatically enable another enrollment either: recovery depends on its credential, status and DMS policy. `CertificateHold` can be reactivated under PKI conditions; other reasons block subsequent certificate changes.",{"_3634":917,"_31209":867,"_21628":53844,"_5":14884,"_28401":53722,"_3085":53845},[],"A certificate suspended by a CA hold cascade shows as **Revoked** and returns to active when the holding CA is released. If its certificate expired during the hold, the monitoring job marks it as expired again after the release. If you revoke a held identity yourself, that revocation is permanent.",{"_3634":918,"_31209":867,"_21628":53847,"_5":14884,"_28401":53726,"_3085":53848},[],"Before **Decommission**, inventory active and previous identities, connections and destination permissions. Prepare retirement in the consumer.",{"_3634":919,"_31209":867,"_21628":53850,"_5":14884,"_28401":53726,"_3085":53851},[],"The backend saves **Decommissioned** and attempts to revoke the active version’s certificate with `CessationOfOperation` if the slot was not expired or revoked. It does not traverse all history. Deferred revocation can fail after retirement is saved; check the result by serial.",{"_3634":920,"_31209":867,"_21628":53853,"_5":14884,"_28401":53726,"_3085":53854},[],"Retired status protects ordinary device and slot updates. It does not guarantee that every EST request is rejected before issuance: binding can skip a retired device without returning an error. Check for remaining usable certificates or permissions and block new admission in the relevant control.",{"_3634":921,"_31209":867,"_21628":53856,"_5":14884,"_28401":53726,"_3085":53857},[],"Retain records according to audit policy. Do not reuse a retired ID to hide an equipment change.",{"_3634":922,"_31209":867,"_21628":53859,"_5":14884,"_28401":53730,"_3085":53860},[],"<Card title=\"Enroll and connect a device\" description=\"Obtain an identity from the client and test mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3634":923,"_31209":867,"_21628":53862,"_5":14884,"_28401":53730,"_3085":53863},[],"<Card title=\"Renewal and recovery\" description=\"Install the successor and handle failures without losing known state.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3634":924,"_31209":924,"_5":15244,"_3085":53865,"_31547":53866,"_21628":53868,"_28401":924},"Bootstrap identity and authentication",[50999,52511,53683,53681,53867],"Enrollment with PKI",[],{"_3634":925,"_31209":924,"_21628":53870,"_5":14884,"_28401":924,"_3085":53871},[],"Prepare server trust and admission proofs for enroll and reenroll.",{"_3634":926,"_31209":924,"_5":31544,"_21628":53873,"_28401":53874,"_3085":53875},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#initial-server-trust","Initial server trust",{"_3634":927,"_31209":924,"_5":31544,"_21628":53877,"_28401":53878,"_3085":53879},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#bootstrap-credential","Bootstrap credential",{"_3634":928,"_31209":924,"_5":31544,"_21628":53881,"_28401":53882,"_3085":53883},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#modes-per-operation","Modes per operation",{"_3634":929,"_31209":924,"_5":31544,"_21628":53885,"_28401":53886,"_3085":53887},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#webhook-contract","Webhook contract",{"_3634":930,"_31209":924,"_5":31544,"_21628":53889,"_28401":53890,"_3085":53891},[],"/docs/platform/iot-fleets/enrollment/bootstrap-identity#revocation-and-checks","Revocation and checks",{"_3634":931,"_31209":924,"_21628":53893,"_5":14884,"_28401":924,"_3085":53894},[],"This guide connects the DMS administrator with device manufacturing and integration. Before requesting an operational identity, the client must authenticate the EST server and establish entitlement to request the intended ID.",{"_3634":932,"_31209":924,"_21628":53896,"_5":14884,"_28401":53874,"_3085":53897},[],"Install a previously verified root, chain or pin through a trusted channel: manufacturing, approved configuration or authenticated distribution. It enables TLS and server-name verification before downloading `/cacerts`.",{"_3634":933,"_31209":924,"_21628":53899,"_5":14884,"_28401":53874,"_3085":53900},[],"Your only trust proof cannot come from the same unauthenticated server. The EST server TLS certificate, bootstrap certificate and operational identity issuer may belong to different hierarchies.",{"_3634":934,"_31209":924,"_21628":53902,"_5":14884,"_28401":53878,"_3085":53903},[],"With `CLIENT_CERTIFICATE`, the device presents its initial certificate and proves key possession through TLS. The DMS validates it against admission CAs. The validator receives one leaf credential: configure and test the direct issuer for the simple case; sending more intermediates does not establish delivery to the service.",{"_3634":935,"_31209":924,"_21628":53905,"_5":14884,"_28401":53878,"_3085":53906},[],"Check dates, matching certificate/key and revocation before provisioning. A credential shared across equipment identifies that shared credential, not an individual device.",{"_3634":936,"_31209":924,"_21628":53908,"_5":14884,"_28401":53878,"_3085":53909},[],"Initial mTLS validation does not by itself compare bootstrap CN with the requested CSR CN. If a requester should only request its own `Device ID`, add a control binding credential to ID, such as the combined webhook, and test a request with another CN. Certificate re-enrollment does compare its CN to the CSR; subsequent checks use the registered active identity.",{"_3634":937,"_31209":924,"_21628":53911,"_5":14884,"_28401":53882,"_3085":53912},[],"Select the four modes independently for enrollment and re-enrollment in DMS. Renewal credentials depend on that block; do not assume the bootstrap is always used or the webhook disappears.",{"_3634":938,"_31209":924,"_21628":53914,"_5":14884,"_28401":53882,"_3085":53915},[],"An administrative OIDC token is not a native EST mode. A webhook may interpret an agreed credential header; that service then performs authorization. In NO\\_AUTH, sending a token does not add DMS authentication.",{"_3634":939,"_31209":924,"_21628":53917,"_5":14884,"_28401":53886,"_3085":53918},[],"The DMS sends operation context to the configured service. Method comes from configuration; agree the contract before selecting POST or PUT. Authorization wait defaults to 10 seconds, replaced by a configured positive timeout. The DMS verifies the receiver certificate unless `insecure_skip_verify` is enabled in the webhook config — verification is on by default — and does not follow redirects, so the configured URL must be the final one. The authorization response must be JSON of at most 1 MiB. With Lamassu-to-webhook authentication configured over `http://`, the API key or bearer token travels in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented; prefer `https://`. Configure those options in the webhook settings of the DMS guide.",{"_3634":940,"_31209":924,"_21628":53920,"_5":14884,"_28401":53886,"_3085":53921},[],"Example body:",{"_3634":941,"_31209":924,"_21628":53923,"_5":14884,"_28401":53886,"_3085":53924},[],"`csr` is **base64 of PEM**, unlike the EST body, which is base64 of DER. `http_request` contains URL and first header entries from available HTTP context. This body does not include an `operation` field; distinguish enroll and reenroll through the path and configured policy.",{"_3634":942,"_31209":924,"_21628":53926,"_5":14884,"_28401":53886,"_3085":53927},[],"The webhook should verify credential, its relationship to `device_cn`, DMS, operation and admission policy. Forwarded headers are not themselves trusted evidence. **Lamassu-to-webhook authentication** is a separate relationship configured in the server’s HTTP client.",{"_3634":943,"_31209":924,"_21628":53929,"_5":14884,"_28401":53886,"_3085":53930},[],"Continuation requires a successful HTTP response and JSON:",{"_3634":944,"_31209":924,"_21628":53932,"_5":14884,"_28401":53886,"_3085":53933},[],"A bodyless `204` does not satisfy the contract. Denial, transport error, uninterpretable response or timeout abort authorization. Combined mode validates the certificate first, then queries the webhook. See the webhook specification.",{"_3634":945,"_31209":924,"_21628":53935,"_5":14884,"_28401":53890,"_3085":53936},[],"The DMS first looks up the presented certificate in Lamassu; certificates it issued and manages are checked against their stored status. External certificates are checked through their OCSP servers and then their CRL distribution points. By default, unverifiable revocation is a rejection, not an acceptance: a certificate that is not managed by Lamassu and lists no OCSP or CRL endpoint is rejected unless `allow_unverifiable_revocation` is set in that operation's block (see Authentication per operation).",{"_3634":946,"_31209":924,"_21628":53938,"_5":14884,"_28401":53890,"_3085":53939},[],"A certificate that does list endpoints is held to a stricter standard, with or without the option: unreachable endpoints, stale or invalid evidence, or an inconclusive (unknown) status reject the certificate. The evidence must be fresh — `thisUpdate` not in the future, `nextUpdate` not passed, and an answer without `nextUpdate` accepted only while it is less than about 24 hours old — and OCSP responses must be signed by the certificate's issuer itself or by a delegated responder that carries the `id-kp-OCSPSigning` EKU and is within its validity. A revoked verdict is honored regardless of its age. Each OCSP or CRL request has a 10-second timeout.",{"_3634":947,"_31209":924,"_21628":53941,"_5":14884,"_28401":53890,"_3085":53942},[],"One caveat remains: a signed Good OCSP response or CRL captured before a revocation keeps validating until its `nextUpdate` (up to about 24 hours without `nextUpdate`). Revocation propagates to devices at the pace the responders publish evidence, not at the moment of revocation.",{"_3634":948,"_31209":924,"_21628":53944,"_5":14884,"_28401":53890,"_3085":53945},[],"Test an allowed certificate, an incorrect one, another CN, webhook denial, timeout and re-enrollment under its own policy. Keep results and schedule bootstrap credential retirement where appropriate. Continue with EST client.",{"_3634":949,"_31209":949,"_5":15244,"_3085":53947,"_31547":53948,"_21628":53949,"_28401":949},"Configure and operate the DMS",[50999,52511,53683,53681,53867],[],{"_3634":950,"_31209":949,"_21628":53951,"_5":14884,"_28401":949,"_3085":53952},[],"Define registration, authentication per operation, issuance, renewal and distributed trust.",{"_3634":951,"_31209":949,"_5":31544,"_21628":53954,"_28401":53955,"_3085":51009},[],"/docs/platform/iot-fleets/enrollment/dms#before-you-begin",{"_3634":952,"_31209":949,"_5":31544,"_21628":53957,"_28401":53958,"_3085":53959},[],"/docs/platform/iot-fleets/enrollment/dms#configure-a-dms","Configure a DMS",{"_3634":953,"_31209":949,"_5":31544,"_21628":53961,"_28401":53962,"_3085":53963},[],"/docs/platform/iot-fleets/enrollment/dms#identify-the-fleet","Identify the fleet",{"_3634":954,"_31209":949,"_5":31544,"_21628":53965,"_28401":53966,"_3085":53967},[],"/docs/platform/iot-fleets/enrollment/dms#select-the-enrollment-ca","Select the enrollment CA",{"_3634":955,"_31209":949,"_5":31544,"_21628":53969,"_28401":53970,"_3085":53971},[],"/docs/platform/iot-fleets/enrollment/dms#configure-est","Configure EST",{"_3634":956,"_31209":949,"_5":31544,"_21628":53973,"_28401":53974,"_3085":53975},[],"/docs/platform/iot-fleets/enrollment/dms#distribute-trust","Distribute trust",{"_3634":957,"_31209":949,"_5":31544,"_21628":53977,"_28401":53978,"_3085":53979},[],"/docs/platform/iot-fleets/enrollment/dms#verify-the-endpoints","Verify the endpoints",{"_3634":958,"_31209":949,"_5":31544,"_21628":53981,"_28401":53982,"_3085":53983},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-configuration","Enrollment configuration",{"_3634":959,"_31209":949,"_5":31544,"_21628":53985,"_28401":53986,"_3085":53987},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-device-registration","Enrollment Device Registration",{"_3634":960,"_31209":949,"_5":31544,"_21628":53989,"_28401":53990,"_3085":53991},[],"/docs/platform/iot-fleets/enrollment/dms#enrollment-settings","Enrollment Settings",{"_3634":961,"_31209":949,"_5":31544,"_21628":53993,"_28401":53994,"_3085":53995},[],"/docs/platform/iot-fleets/enrollment/dms#authentication-per-operation","Authentication per operation",{"_3634":962,"_31209":949,"_5":31544,"_21628":53997,"_28401":53998,"_3085":53999},[],"/docs/platform/iot-fleets/enrollment/dms#external-webhook-settings","External webhook settings",{"_3634":963,"_31209":949,"_5":31544,"_21628":54001,"_28401":54002,"_3085":54003},[],"/docs/platform/iot-fleets/enrollment/dms#issuance-profile","Issuance profile",{"_3634":964,"_31209":949,"_5":31544,"_21628":54005,"_28401":54006,"_3085":54007},[],"/docs/platform/iot-fleets/enrollment/dms#re-enrollment-configuration","Re-enrollment configuration",{"_3634":965,"_31209":949,"_5":31544,"_21628":54009,"_28401":54010,"_3085":54011},[],"/docs/platform/iot-fleets/enrollment/dms#serverkeygen","ServerKeyGen",{"_3634":966,"_31209":949,"_5":31544,"_21628":54013,"_28401":54014,"_3085":54015},[],"/docs/platform/iot-fleets/enrollment/dms#trust-distribution","Trust distribution",{"_3634":967,"_31209":949,"_5":31544,"_21628":54017,"_28401":54018,"_3085":54019},[],"/docs/platform/iot-fleets/enrollment/dms#operate-the-dms-inventory","Operate the DMS inventory",{"_3634":968,"_31209":949,"_5":31544,"_21628":54021,"_28401":54022,"_3085":54023},[],"/docs/platform/iot-fleets/enrollment/dms#integrate-the-devices","Integrate the devices",{"_3634":969,"_31209":949,"_21628":54025,"_5":14884,"_28401":949,"_3085":54026},[],"A &#x2A;*Device Management Service (DMS)** configures admission and identity lifecycle for its devices. It acts as a registration authority; the CA selected in `Enrollment CA` signs certificates. This guide is for the policy administrator.",{"_3634":970,"_31209":949,"_21628":54028,"_5":14884,"_28401":53955,"_3085":54029},[],"You need DMS management permissions, an active CA with a usable key and a tested issuance profile. Agree device ID, initial credential, consumer and renewal window with the integrator. Review Provisioning strategies before choosing registration and replacement.",{"_3634":971,"_31209":949,"_21628":54031,"_5":14884,"_28401":53955,"_3085":54032},[],"Prepare EST server trust and device connectivity through Deployment. Your operator’s administrative authentication does not replace device EST authentication.",{"_3634":972,"_31209":949,"_21628":54034,"_5":14884,"_28401":53962,"_3085":54035},[],"Create the DMS with a recognizable name and retain its ID. EST URLs use this identifier, not the display name. Each device retains one owning DMS.",{"_3634":973,"_31209":949,"_21628":54037,"_5":14884,"_28401":53966,"_3085":54038},[],"Choose **Enrollment CA** and an explicit profile appropriate for the end-entity identity. Keep CN compatible with `Device ID`. The test certificate should allow its intended purpose and expire within issuer validity.",{"_3634":974,"_31209":949,"_21628":54040,"_5":14884,"_28401":53970,"_3085":54041},[],"Select initial enrollment registration and authentication. Separately configure re-enrollment authentication, thresholds and previous certificate retirement. Leave ServerKeyGen disabled if the client generates its key.",{"_3634":975,"_31209":949,"_21628":54043,"_5":14884,"_28401":53974,"_3085":54044},[],"Select certificates returned by `/cacerts`. Explicitly include required intermediates and roots, keeping distribution distinct from automatic trust installation.",{"_3634":976,"_31209":949,"_21628":54046,"_5":14884,"_28401":53978,"_3085":54047},[],"Save and read configuration again. Query `/cacerts`, perform an allowed and a rejected enrollment, and inspect device, serial and history. Creating the DMS or downloading cacerts does not establish working authentication and issuance.",{"_3634":977,"_31209":949,"_21628":54049,"_5":14884,"_28401":53986,"_3085":54050},[],"`settings.enrollment_settings.registration_mode` accepts `JITP` or `PRE_REGISTRATION`. JITP creates an unknown device with the CSR CN as ID and the DMS as owner. `device_provisioning_profile` supplies tags, metadata and icon for that registration.",{"_3634":978,"_31209":949,"_21628":54052,"_5":14884,"_28401":53986,"_3085":54053},[],"PRE\\_REGISTRATION requires an existing ID. An existing device encounters replacement checks first, even without an identity. Review preregistration conditions before using this mode.",{"_3634":979,"_31209":949,"_21628":54055,"_5":14884,"_28401":53990,"_3085":54056},[],"`settings.enrollment_settings` field",{"_3634":980,"_31209":949,"_21628":54058,"_5":14884,"_28401":53990,"_3085":54059},[],"Decision",{"_3634":981,"_31209":949,"_21628":54061,"_5":14884,"_28401":53990,"_3085":54062},[],"`protocol`",{"_3634":982,"_31209":949,"_21628":54064,"_5":14884,"_28401":53990,"_3085":54065},[],"`EST_RFC7030` for these operations.",{"_3634":983,"_31209":949,"_21628":54067,"_5":14884,"_28401":53990,"_3085":54068},[],"`enrollment_ca`",{"_3634":984,"_31209":949,"_21628":54070,"_5":14884,"_28401":53990,"_3085":54071},[],"ID of the signing CA.",{"_3634":985,"_31209":949,"_21628":54073,"_5":14884,"_28401":53990,"_3085":54074},[],"`verify_csr_signature`",{"_3634":986,"_31209":949,"_21628":54076,"_5":14884,"_28401":53990,"_3085":54077},[],"Keep `true` to verify CSR key possession.",{"_3634":987,"_31209":949,"_21628":54079,"_5":14884,"_28401":53990,"_3085":54080},[],"`enable_replaceable_enrollment`",{"_3634":988,"_31209":949,"_21628":54082,"_5":14884,"_28401":53990,"_3085":54083},[],"Allows `/simpleenroll` for an existing ID in the same DMS. It can attempt previous certificate revocation even if a later phase fails; this is not atomic.",{"_3634":989,"_31209":949,"_21628":54085,"_5":14884,"_28401":53990,"_3085":54086},[],"`est_rfc7030_settings.auth_mode`",{"_3634":990,"_31209":949,"_21628":54088,"_5":14884,"_28401":53990,"_3085":54089},[],"One of the four authentication modes.",{"_3634":991,"_31209":949,"_21628":54091,"_5":14884,"_28401":53990,"_3085":54092},[],"Initial enrollment rejects an ID owned by another DMS. Do not automatically enable replacement in response to an error; Troubleshooting distinguishes repeated IDs, ownership and partial changes.",{"_3634":992,"_31209":949,"_21628":54094,"_5":14884,"_28401":53994,"_3085":54095},[],"The blocks are independent:",{"_3634":993,"_31209":949,"_21628":54097,"_5":14884,"_28401":53994,"_3085":54098},[],"`settings.enrollment_settings.est_rfc7030_settings` for `/simpleenroll` and `/serverkeygen`.",{"_3634":994,"_31209":949,"_21628":54100,"_5":14884,"_28401":53994,"_3085":54101},[],"`settings.reenrollment_settings.est_rfc7030_settings` for `/simplereenroll`.",{"_3634":995,"_31209":949,"_21628":54103,"_5":14884,"_28401":53994,"_3085":54104},[],"`auth_mode`",{"_3634":996,"_31209":949,"_21628":54106,"_5":14884,"_28401":53994,"_3085":54107},[],"Control applied in the configured operation",{"_3634":997,"_31209":949,"_21628":54109,"_5":14884,"_28401":53994,"_3085":54110},[],"`CLIENT_CERTIFICATE`",{"_3634":998,"_31209":949,"_21628":54112,"_5":14884,"_28401":53994,"_3085":54113},[],"Presented certificate validation.",{"_3634":999,"_31209":949,"_21628":54115,"_5":14884,"_28401":53994,"_3085":54116},[],"`EXTERNAL_WEBHOOK`",{"_3634":1000,"_31209":949,"_21628":54118,"_5":14884,"_28401":53994,"_3085":54119},[],"Configured webhook authorization.",{"_3634":1001,"_31209":949,"_21628":54121,"_5":14884,"_28401":53994,"_3085":54122},[],"`CLIENT_CERTIFICATE_AND_EXTERNAL_WEBHOOK`",{"_3634":1002,"_31209":949,"_21628":54124,"_5":14884,"_28401":53994,"_3085":54125},[],"Certificate validation followed by webhook approval.",{"_3634":1003,"_31209":949,"_21628":54127,"_5":14884,"_28401":53994,"_3085":54128},[],"`NO_AUTH`",{"_3634":1004,"_31209":949,"_21628":54130,"_5":14884,"_28401":53994,"_3085":54131},[],"No DMS requester authentication.",{"_3634":1005,"_31209":949,"_21628":54133,"_5":14884,"_28401":53994,"_3085":54134},[],"Webhook and combined modes also execute during re-enrollment when configured in its block. They do not implicitly degrade to NO\\_AUTH. An absent or unrecognized mode fails.",{"_3634":1006,"_31209":949,"_21628":54136,"_5":14884,"_28401":53994,"_3085":54137},[],"For initial mTLS, `client_certificate_settings` contains `validation_cas`, `allow_expired`, `chain_level_validation` and `allow_unverifiable_revocation`. The validator receives one certificate credential; the flow does not guarantee forwarding every handshake intermediate to it. For a direct case, configure the bootstrap’s direct issuer as validation CA and test the actual Gateway path.",{"_3634":1007,"_31209":949,"_21628":54139,"_5":14884,"_28401":53994,"_3085":54140},[],"The authentication editor offers an **Allow certificates without revocation information** switch (`allow_unverifiable_revocation`, off by default). When it is on, certificates — and intermediate CAs of the chain — that Lamassu does not manage and that list no OCSP or CRL endpoint are accepted; unreachable, stale or inconclusive revocation answers are always rejected. While the switch is on, the console shows an amber warning: **Revocation will not be verified** — a revoked certificate with no OCSP or CRL endpoint, and not managed by Lamassu, will be accepted, and this also applies to the intermediate CAs of the chain.",{"_3634":1008,"_31209":949,"_21628":54142,"_5":14884,"_28401":53994,"_3085":54143},[],"The same switch is offered in both the enrollment and re-enrollment authentication editors and is stored per block inside `est_rfc7030_settings.client_certificate_settings`; a DMS stored before this field existed loads with the switch off. The console also shows an amber warning alert whenever an authentication option is in its insecure state — **Allow expired certificates** on, **Allow expired renewal** on or **Verify CSR signature** off — and the No authentication note is presented as a warning alert too.",{"_3634":1009,"_31209":949,"_21628":54145,"_5":14884,"_28401":53994,"_3085":54146},[],"Revocation is checked for every presented certificate. In initial enrollment the client certificate **and** every intermediate CA between it and the validation CA are checked, each against its issuer; extra certificates the device sends in the handshake are ignored. A validation CA that is revoked in Lamassu rejects the operation: the first validation CA that validates the certificate is used, and a revoked one is not replaced by the remaining validation CAs. Certificates issued and managed by Lamassu are checked against their stored status. External certificates are checked through their OCSP and CRL endpoints, and the operation fails closed when revocation cannot be verified: only `allow_unverifiable_revocation` — `false` by default in both blocks — relaxes the case of an external certificate that lists no endpoint at all. Endpoints that exist but are unreachable, return stale or invalid evidence, or report an inconclusive status are always rejected, whatever the option says. The details and the evidence the endpoints must present are in Revocation and checks.",{"_3634":1010,"_31209":949,"_21628":54148,"_5":14884,"_28401":53994,"_3085":54149},[],"For certificate re-enrollment, the validator tries the enrollment CA first and then the CAs listed in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; those are the re-enrollment validation CAs. That list is optional because the enrollment CA is always trusted for re-enrollment, and each settings block consults only its own `validation_cas`. CAs listed only in the initial block's `validation_cas` do not extend re-enrollment acceptance; during a CA rotation, add the old issuance CA to the re-enrollment block's list. The re-enrollment validator compares the presented TLS leaf against those CAs; the re-enrollment block's `chain_level_validation` and `allow_expired` values are stored but not consulted, and expiry is governed by `enable_expired_renewal`. Re-enrollment checks revocation of the client certificate only; that check is governed by the re-enrollment block's own `allow_unverifiable_revocation`.",{"_3634":1011,"_31209":949,"_21628":54151,"_5":14884,"_28401":53994,"_3085":54152},[],"For a webhook, configure destination, Lamassu-to-service authentication, method and timeout. The authentication contract explains the device credential and request body. `NO_AUTH` does not establish ownership of the requested ID.",{"_3634":1012,"_31209":949,"_21628":54154,"_5":14884,"_28401":53998,"_3085":54155},[],"The webhook authentication modes read `external_webhook_settings` in the same `est_rfc7030_settings` block:",{"_3634":1013,"_31209":949,"_21628":54157,"_5":14884,"_28401":53998,"_3085":54158},[],"`external_webhook_settings` field",{"_3634":1014,"_31209":949,"_21628":54160,"_5":14884,"_28401":53998,"_3085":54059},[],{"_3634":1015,"_31209":949,"_21628":54162,"_5":14884,"_28401":53998,"_3085":54163},[],"`url`",{"_3634":1016,"_31209":949,"_21628":54165,"_5":14884,"_28401":53998,"_3085":54166},[],"Absolute `http` or `https` URL of the receiver. It must be the final URL; redirects are not followed.",{"_3634":1017,"_31209":949,"_21628":54168,"_5":14884,"_28401":53998,"_3085":54169},[],"`method`",{"_3634":1018,"_31209":949,"_21628":54171,"_5":14884,"_28401":53998,"_3085":54172},[],"`POST` or `PUT`; `POST` by default.",{"_3634":1019,"_31209":949,"_21628":54174,"_5":14884,"_28401":53998,"_3085":54175},[],"`name`",{"_3634":1020,"_31209":949,"_21628":54177,"_5":14884,"_28401":53998,"_3085":54178},[],"Label used in service logs.",{"_3634":1021,"_31209":949,"_21628":54180,"_5":14884,"_28401":53998,"_3085":54181},[],"`config.auth_mode`",{"_3634":1022,"_31209":949,"_21628":54183,"_5":14884,"_28401":53998,"_3085":54184},[],"`noauth`, `apikey`, `jwt` or `mtls`. An absent or unknown value behaves as `noauth`.",{"_3634":1023,"_31209":949,"_21628":54186,"_5":14884,"_28401":53998,"_3085":54187},[],"`config.log_level`",{"_3634":1024,"_31209":949,"_21628":54189,"_5":14884,"_28401":53998,"_3085":54190},[],"Log level of the webhook call: `debug`, `info`, `warn` or `error`; `info` by default.",{"_3634":1025,"_31209":949,"_21628":54192,"_5":14884,"_28401":53998,"_3085":54193},[],"`config.apikey_options`",{"_3634":1026,"_31209":949,"_21628":54195,"_5":14884,"_28401":53998,"_3085":54196},[],"Required for `apikey`: `header` and `key`. Reserved header names are rejected.",{"_3634":1027,"_31209":949,"_21628":54198,"_5":14884,"_28401":53998,"_3085":54199},[],"`config.jwt_options`",{"_3634":1028,"_31209":949,"_21628":54201,"_5":14884,"_28401":53998,"_3085":54202},[],"Required for `jwt`: `oidc_client_id`, `oidc_client_secret` and an absolute `http` or `https` `oidc_well_known`.",{"_3634":1029,"_31209":949,"_21628":54204,"_5":14884,"_28401":53998,"_3085":54205},[],"`config.mtls_options`",{"_3634":1030,"_31209":949,"_21628":54207,"_5":14884,"_28401":53998,"_3085":54208},[],"Required for `mtls`: `cert_content` and `key_content` as Base64-encoded PEM, like certificates elsewhere in the API; plain PEM is also accepted.",{"_3634":1031,"_31209":949,"_21628":54210,"_5":14884,"_28401":53998,"_3085":54211},[],"`config.insecure_skip_verify`",{"_3634":1032,"_31209":949,"_21628":54213,"_5":14884,"_28401":53998,"_3085":54214},[],"Skips verification of the receiver certificate when `true`. Verification is on by default. Unlike alert channels, this flag is honored here.",{"_3634":1033,"_31209":949,"_21628":54216,"_5":14884,"_28401":53998,"_3085":54217},[],"`config.call_timeout`",{"_3634":1034,"_31209":949,"_21628":54219,"_5":14884,"_28401":53998,"_3085":54220},[],"Maximum duration of the authorization call (for example `10s`); 10 seconds by default.",{"_3634":1035,"_31209":949,"_21628":54222,"_5":14884,"_28401":53998,"_3085":54223},[],"Rules for that configuration:",{"_3634":1036,"_31209":949,"_21628":54225,"_5":14884,"_28401":53998,"_3085":54226},[],"Creating or updating a DMS whose enrollment or reenrollment `auth_mode` uses the webhook validates the block and returns HTTP 400 — the body starts with `struct validation error:` and continues with `invalid enrollment external webhook config` or `invalid reenrollment external webhook config` — when the URL, method or options are invalid. That includes an `mtls_options.cert_content`/`key_content` pair that does not decode to a matching certificate and private key. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are always invalid: the service does not read files, so enter the certificate and key as Base64-encoded PEM in `mtls_options.cert_content` and `key_content`, or as plain PEM.",{"_3634":1037,"_31209":949,"_21628":54228,"_5":14884,"_28401":53998,"_3085":54229},[],"A custom `apikey_options.header` may not use names that the platform or the receiving service trusts — for example `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` or `Forwarded` — and no name may start with `X-Forwarded-`, `X-Envoy-` or `X-Lms-` (case-insensitive). The DMS API reference documents the `WebhookCall` and `WebhookCallHttpClient` schemas and that reserved API-key headers are rejected.",{"_3634":1038,"_31209":949,"_21628":54231,"_5":14884,"_28401":53998,"_3085":54232},[],"The nested `http_client` key exists only in alert channel configurations; in a DMS body it is ignored. The DMS key is `external_webhook_settings.config`.",{"_3634":1039,"_31209":949,"_21628":54234,"_5":14884,"_28401":53998,"_3085":54235},[],"A body with `config.auth_mode` set to `apikey`, `jwt` or `mtls` must carry its corresponding option block (`apikey_options`, `jwt_options` or `mtls_options`) — and nothing else. Bodies with those auth modes carrying only `apikey`, `oidc` or `mtls` fail validation with 400, and `validate_server_cert` is always ignored: use `insecure_skip_verify`. Only bodies without option blocks are accepted as `noauth`, and their credentials are dropped.",{"_3634":1040,"_31209":949,"_21628":54237,"_5":14884,"_28401":53998,"_3085":54238},[],"The authorization response must be JSON of at most 1 MiB; a larger body fails the call.",{"_3634":1041,"_31209":949,"_21628":54240,"_5":14884,"_28401":53998,"_3085":54241},[],"With credentials configured, they are sent regardless of the URL scheme: an `http://` webhook receives the API key or bearer token in cleartext, and mTLS has no effect because no TLS handshake takes place, so the client certificate is never presented. Prefer `https://` for `url`, `oidc_well_known` and the token endpoint it advertises.",{"_3634":1042,"_31209":949,"_21628":54243,"_5":14884,"_28401":53998,"_3085":54244},[],"Initial authentication and renewal settings are stored independently. If a DMS only has the initial authentication block, renewal reuses it: read both blocks before editing. The console exposes independent editors for the enrollment and re-enrollment authentication, with the same Log Level, Call Timeout, HTTP Authentication and credential fields as the webhook channels, plus a **Skip TLS Verification** switch (off by default, so verification stays on; the console warns when you enable it).",{"_3634":1043,"_31209":949,"_21628":54246,"_5":14884,"_28401":53998,"_3085":54247},[],"Webhook credentials must be stored as PEM content. File references (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) are never valid in a stored webhook config: delivery rejects any webhook config that references files, whatever its auth mode, so every enroll and reenroll that calls that webhook fails until the certificate and key are entered as Base64-encoded or plain PEM in `mtls_options.cert_content` and `key_content`, or the file fields are removed if the webhook does not use mTLS. If a stored config holds file paths in `mtls_options.cert_content` or `key_content`, every full settings update (`POST /v1/dms`, `PUT /v1/dms/:id`) fails validation — settings are replaced wholesale, so the stored config must be resent — until the values are replaced by PEM content or the webhook stops being used. Meanwhile, delivery of that webhook fails on every call; a metadata-only update through `PUT` or `PATCH` on `/v1/dms/:id/metadata` still succeeds. To fix it in the console, open the DMS, replace any file-path value with PEM content — the editor rejects file paths with an inline field error — and save. Saving rewrites `external_webhook_settings.config` with the current keys, and the console reads both plain and Base64-encoded PEM from migrated configurations and stores the material Base64-encoded. If your stored config previously relied on `validate_server_cert: false`, it now carries `insecure_skip_verify: true`: receiver-certificate verification stays skipped until you set that flag to `false`. See 3.8.0 to 4.0.0 for the upgrade notes and the operator checklist.",{"_3634":1044,"_31209":949,"_21628":54249,"_5":14884,"_28401":53998,"_3085":54250},[],"The re-enrollment trust set lives in `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. The flat field `reenrollment_settings.additional_validation_cas` is not part of the API: bodies that carry it are accepted but the value is silently ignored — unknown JSON fields are dropped — and GET responses do not include it. Read the DMS before sending API edits: an update body built with that flat field silently empties `validation_cas`.",{"_3634":1045,"_31209":949,"_21628":54252,"_5":14884,"_28401":54002,"_3085":54253},[],"`settings.issuance_profile_id` takes precedence over `settings.issuance_profile`; without either, the CA default profile is used. The resolved profile — including the CA default used as fallback when the DMS defines none — must define an end-entity certificate: a `Sign as CA` profile is rejected at enrollment and re-enrollment time. Rules are documented once in Profiles. DMS changes affect future requests; they do not modify signed certificates or install client trust.",{"_3634":1046,"_31209":949,"_21628":54255,"_5":14884,"_28401":54006,"_3085":54256},[],"`settings.reenrollment_settings` field",{"_3634":1047,"_31209":949,"_21628":54258,"_5":14884,"_28401":54006,"_3085":51389},[],{"_3634":1048,"_31209":949,"_21628":54260,"_5":14884,"_28401":54006,"_3085":54261},[],"`reenrollment_delta`",{"_3634":1049,"_31209":949,"_21628":54263,"_5":14884,"_28401":54006,"_3085":54264},[],"Opens the window at the active certificate’s `NotAfter` minus this delta.",{"_3634":1050,"_31209":949,"_21628":54266,"_5":14884,"_28401":54006,"_3085":54267},[],"`preventive_delta`",{"_3634":1051,"_31209":949,"_21628":54269,"_5":14884,"_28401":54006,"_3085":54270},[],"Preventive operational monitoring threshold.",{"_3634":1052,"_31209":949,"_21628":54272,"_5":14884,"_28401":54006,"_3085":54273},[],"`critical_delta`",{"_3634":1053,"_31209":949,"_21628":54275,"_5":14884,"_28401":54006,"_3085":54276},[],"Critical operational monitoring threshold.",{"_3634":1054,"_31209":949,"_21628":54278,"_5":14884,"_28401":54006,"_3085":54279},[],"`enable_expired_renewal`",{"_3634":1055,"_31209":949,"_21628":54281,"_5":14884,"_28401":54006,"_3085":54282},[],"Accepts an expired presented certificate in the renewal mTLS validator. Does not authorize another mode or remove Gateway constraints by itself.",{"_3634":1056,"_31209":949,"_21628":54284,"_5":14884,"_28401":54006,"_3085":54285},[],"`est_rfc7030_settings.client_certificate_settings.validation_cas`",{"_3634":1057,"_31209":949,"_21628":54287,"_5":14884,"_28401":54006,"_3085":54288},[],"Re-enrollment validation CAs for the renewal mTLS credential, tried after the enrollment CA; optional, because the enrollment CA is always trusted. Typically populated during CA rotation while old-CA cohorts renew.",{"_3634":1058,"_31209":949,"_21628":54290,"_5":14884,"_28401":54006,"_3085":54291},[],"`revoke_on_reenrollment`",{"_3634":1059,"_31209":949,"_21628":54293,"_5":14884,"_28401":54006,"_3085":54294},[],"If the previous certificate is ACTIVE, attempts Superseded revocation before binding its successor.",{"_3634":1060,"_31209":949,"_21628":54296,"_5":14884,"_28401":54006,"_3085":54297},[],"Monitoring does not renew: the client must schedule the request and installation. Webhook and NO\\_AUTH modes do not use the same mTLS expired-credential validator; the webhook must explicitly authorize permitted recovery. Review Renewal and recovery for operation order and partial failures.",{"_3634":1061,"_31209":949,"_21628":54299,"_5":14884,"_28401":54010,"_3085":54300},[],"`settings.server_keygen_settings.enabled` enables software key generation on the server. The console exposes it through an **Enable server-side key generation** switch and a **Key type** selection: `ECDSA` P-256, P-384 or P-521, or `RSA` with 2048, 3072 or 4096 bits; the defaults are P-256 for `ECDSA` and 4096 bit for `RSA`. Algorithm and size come from its `key` field, stored as `{type,bits}` where P-256, P-384 and P-521 map to `bits` 256, 384 and 521; `key` is omitted when disabled. The profile must permit them. The response contains an unencrypted PKCS#8 key inside TLS alongside the certificate. See format and extraction in EST reference.",{"_3634":1062,"_31209":949,"_21628":54302,"_5":14884,"_28401":54014,"_3085":51383},[],{"_3634":1063,"_31209":949,"_21628":54304,"_5":14884,"_28401":54014,"_3085":54305},[],"Published material",{"_3634":1064,"_31209":949,"_21628":54307,"_5":14884,"_28401":54014,"_3085":54308},[],"**Include Lamassu System CA**",{"_3634":1065,"_31209":949,"_21628":54310,"_5":14884,"_28401":54014,"_3085":54311},[],"Available downstream TLS certificate; it can be a leaf, not an issuing CA.",{"_3634":1066,"_31209":949,"_21628":54313,"_5":14884,"_28401":54014,"_3085":54314},[],"**Include Enrollment CA**",{"_3634":1067,"_31209":949,"_21628":54316,"_5":14884,"_28401":54014,"_3085":54317},[],"Selected issuing CA certificate.",{"_3634":1068,"_31209":949,"_21628":54319,"_5":14884,"_28401":54014,"_3085":54320},[],"**Managed CAs**",{"_3634":1069,"_31209":949,"_21628":54322,"_5":14884,"_28401":54014,"_3085":54323},[],"Explicitly selected CA certificates.",{"_3634":1070,"_31209":949,"_21628":54325,"_5":14884,"_28401":54014,"_3085":54326},[],"All ancestors are not added automatically. Trust distribution distinguishes trusted roots, intermediates and initial server trust.",{"_3634":1071,"_31209":949,"_21628":54328,"_5":14884,"_28401":54018,"_3085":54329},[],"**Edit** changes name, settings and metadata. Updates go through the DMS API. `PUT /v1/dms/{id}` always targets the DMS identified by the URL path: the body carries no `id` field, and any `id` or `creation_ts` in it is silently ignored — authorization is evaluated against the same URL identifier. The body must include a non-empty `name` and a `settings` object; missing either returns HTTP 400 and leaves the stored DMS unchanged. `name` and `settings` are always full replacements, so read the DMS before sending API edits to avoid losing fields. `metadata` is optional: omitting it or sending `null` keeps the stored metadata, a supplied object replaces it entirely, and `{}` clears it (a later GET returns an empty object, not `null`). Old-style bodies that carry the full DMS object keep working while they include `name` and `settings`; unknown fields are ignored. Updates reject an empty `name` with HTTP 400: a DMS whose stored name was zeroed by an earlier update must be renamed before any client round-trips it — the AWS IoT connector’s JITP writeback included. If the object does not include the AWS IoT connector key (`lamassu.io/iot/{connector_id}`), the connector ignores the DMS's later events.",{"_3634":1072,"_31209":949,"_21628":54331,"_5":14884,"_28401":54018,"_3085":54332},[],"**Go to DMS owned devices** restricts inventory by owner. **Show/Edit Metadata** contains operational and integration data; consult the integration guide before changing it. &#x2A;*EST (RFC-7030)** helps locate URLs.",{"_3634":1073,"_31209":949,"_21628":54334,"_5":14884,"_28401":54018,"_3085":54335},[],"**Delete** removes the DMS record and configuration; it does not itself cascade revocation across every device and certificate. Migrate dependencies and retain audit references before retirement.",{"_3634":1074,"_31209":949,"_21628":54337,"_5":14884,"_28401":54022,"_3085":54338},[],"Continue with EST client or the enrollment and mTLS tutorial. EST reference covers formats; Troubleshooting covers failures.",{"_3634":1075,"_31209":1075,"_5":15244,"_3085":54340,"_31547":54341,"_21628":54342,"_28401":1075},"Integrate the EST client",[50999,52511,53683,53681,53867],[],{"_3634":1076,"_31209":1075,"_21628":54344,"_5":14884,"_28401":1075,"_3085":54345},[],"Prepare trust, send a CSR and check the identity you receive.",{"_3634":1077,"_31209":1075,"_5":31544,"_21628":54347,"_28401":54348,"_3085":51009},[],"/docs/platform/iot-fleets/enrollment/est-client#before-you-begin",{"_3634":1078,"_31209":1075,"_5":31544,"_21628":54350,"_28401":54351,"_3085":54352},[],"/docs/platform/iot-fleets/enrollment/est-client#download-and-inspect-cacerts","Download and inspect cacerts",{"_3634":1079,"_31209":1075,"_5":31544,"_21628":54354,"_28401":54355,"_3085":54356},[],"/docs/platform/iot-fleets/enrollment/est-client#prepare-the-csr","Prepare the CSR",{"_3634":1080,"_31209":1075,"_5":31544,"_21628":54358,"_28401":54359,"_3085":54360},[],"/docs/platform/iot-fleets/enrollment/est-client#request-the-identity","Request the identity",{"_3634":1081,"_31209":1075,"_5":31544,"_21628":54362,"_28401":54363,"_3085":54364},[],"/docs/platform/iot-fleets/enrollment/est-client#check-and-install-the-result","Check and install the result",{"_3634":1082,"_31209":1075,"_5":31544,"_21628":54366,"_28401":54367,"_3085":54368},[],"/docs/platform/iot-fleets/enrollment/est-client#next-steps","Next steps",{"_3634":1083,"_31209":1075,"_21628":54370,"_5":14884,"_28401":1075,"_3085":54371},[],"This guide is for those implementing the device client. The administrator must have prepared the DMS policy. For a complete first run, follow Enroll and connect your first device.",{"_3634":1084,"_31209":1075,"_21628":54373,"_5":14884,"_28401":54348,"_3085":54374},[],"You need the public HTTPS DMS URL, server trust obtained through an approved channel, the operation's authentication mode and an admitted identifier. The examples use Bash, OpenSSL 3.x and curl with `--fail-with-body`; use a private working directory and compatible versions of these tools.",{"_3634":1085,"_31209":1075,"_21628":54376,"_5":14884,"_28401":54348,"_3085":54377},[],"Prepare `est-trust.pem` to verify the EST server, `bootstrap.crt` and `bootstrap.key` for initial certificate authentication, and `device-root.pem` as the approved root of the device issuer. The two trust files can contain different roots. For another authentication mode, adapt the credentials according to Bootstrap identity.",{"_3634":1086,"_31209":1075,"_21628":54379,"_5":14884,"_28401":54348,"_3085":54380},[],"Replace the host and `REPLACE_DMS_ID` with those of your installation. The URL's APS is the DMS identifier, not its display name.",{"_3634":1087,"_31209":1075,"_21628":54382,"_5":14884,"_28401":54351,"_3085":54383},[],"The default content is Base64-encoded DER PKCS#7. It is not a direct PEM file.",{"_3634":1088,"_31209":1075,"_21628":54385,"_5":14884,"_28401":54351,"_3085":54386},[],"Check fingerprints, issuers and dates against the trust distribution policy. The response can contain a selection of CAs and Lamassu's TLS certificate. Do not turn the entire bundle into trusted roots or use it to authenticate its own initial download. HTTP 200 here does not prove that authentication or issuance works.",{"_3634":1089,"_31209":1075,"_21628":54388,"_5":14884,"_28401":54355,"_3085":54389},[],"The example generates a new EC P-256 key and uses `est-device-001`, which must be available if the DMS registers automatically. The `Common Name` becomes the device identifier. Check that the profile permits the selected key and subject.",{"_3634":1090,"_31209":1075,"_21628":54391,"_5":14884,"_28401":54355,"_3085":54392},[],"An implementation using hardware or its own store must produce the CSR through its resident key. `simpleenroll` sends the request and retains the key in the client. Honor Extensions does not authorize every requested attribute: see Profiles.",{"_3634":1091,"_31209":1075,"_21628":54394,"_5":14884,"_28401":54359,"_3085":54395},[],"With initial `CLIENT_CERTIFICATE` authentication, send the Base64-encoded DER CSR using `Content-Type: application/pkcs10`:",{"_3634":1092,"_31209":1075,"_21628":54397,"_5":14884,"_28401":54359,"_3085":54398},[],"Stop if curl fails. Retain the HTTP code, headers and body for diagnosis; an error response is not decoded as a certificate. The Bash example stops before that conversion. A timeout leaves the operation's result to be checked in Lamassu: do not automatically repeat issuance.",{"_3634":1093,"_31209":1075,"_21628":54400,"_5":14884,"_28401":54363,"_3085":54401},[],"For a root that issues directly:",{"_3634":1094,"_31209":1075,"_21628":54403,"_5":14884,"_28401":54363,"_3085":54404},[],"Also verify that the CN is correct, the certificate is a leaf, its uses permit your application and its dates satisfy the profile. `cmp` must exit with code 0. With intermediates, provide the chain through `-untrusted` as described in PKI validation.",{"_3634":1095,"_31209":1075,"_21628":54406,"_5":14884,"_28401":54363,"_3085":54407},[],"Query the device: the owning DMS, current serial number and history must match the result. Protect the key/certificate pair and install both using the device's mechanism. Association in Lamassu does not install files in the client. Check a real connection before considering the process complete.",{"_3634":1096,"_31209":1075,"_21628":54409,"_5":14884,"_28401":54367,"_3085":54410},[],"Implement renewal and recovery and trust updates. The EST reference covers endpoints, formats and ServerKeyGen; troubleshooting helps distinguish transport, admission and persistence failures.",{"_3634":1097,"_31209":1097,"_5":15244,"_3085":54412,"_31547":54413,"_21628":54414,"_28401":1097},"EST reference",[50999,52511,53683,53681,53867],[],{"_3634":1098,"_31209":1097,"_21628":54416,"_5":14884,"_28401":1097,"_3085":54417},[],"Look up Lamassu routes, formats, authentication and multipart responses.",{"_3634":1099,"_31209":1097,"_5":31544,"_21628":54419,"_28401":54420,"_3085":54421},[],"/docs/platform/iot-fleets/enrollment/est-reference#endpoint-reference","Endpoint reference",{"_3634":1100,"_31209":1097,"_5":31544,"_21628":54423,"_28401":54424,"_3085":23431},[],"/docs/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3634":1101,"_31209":1097,"_5":31544,"_21628":54426,"_28401":54427,"_3085":26946},[],"/docs/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3634":1102,"_31209":1097,"_5":31544,"_21628":54429,"_28401":54430,"_3085":26953},[],"/docs/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3634":1103,"_31209":1097,"_5":31544,"_21628":54432,"_28401":54433,"_3085":26215},[],"/docs/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3634":1104,"_31209":1097,"_5":31544,"_21628":54435,"_28401":54436,"_3085":54437},[],"/docs/platform/iot-fleets/enrollment/est-reference#response-format","Response format",{"_3634":1105,"_31209":1097,"_5":31544,"_21628":54439,"_28401":54440,"_3085":54441},[],"/docs/platform/iot-fleets/enrollment/est-reference#request-and-extraction","Request and extraction",{"_3634":1106,"_31209":1097,"_5":31544,"_21628":54443,"_28401":54444,"_3085":54445},[],"/docs/platform/iot-fleets/enrollment/est-reference#compatibility-notes","Compatibility notes",{"_3634":1107,"_31209":1097,"_21628":54447,"_5":14884,"_28401":1097,"_3085":54448},[],"Reference for the Lamassu EST service, based on RFC 7030. Use EST client for the procedure and DMS to configure policy.",{"_3634":1108,"_31209":1097,"_21628":54450,"_5":14884,"_28401":54420,"_3085":54451},[],"Public route in the examples: `/.well-known/est/{APS}/{operation}`. `APS` is the DMS ID. The router admits routes without that segment, but the controller requires it; do not use them as a default service. Gateway configuration determines the public host and route.",{"_3634":1109,"_31209":1097,"_21628":54453,"_5":14884,"_28401":54420,"_3085":54454},[],"Operation",{"_3634":1110,"_31209":1097,"_21628":54456,"_5":14884,"_28401":54420,"_3085":54457},[],"Method",{"_3634":1111,"_31209":1097,"_21628":54459,"_5":14884,"_28401":54420,"_3085":54460},[],"Authentication and condition",{"_3634":1112,"_31209":1097,"_21628":54462,"_5":14884,"_28401":54420,"_3085":54463},[],"`/cacerts`",{"_3634":1113,"_31209":1097,"_21628":54465,"_5":14884,"_28401":54420,"_3085":54466},[],"GET",{"_3634":1114,"_31209":1097,"_21628":54468,"_5":14884,"_28401":54420,"_3085":54469},[],"DMS reading does not require an EST credential; HTTPS and infrastructure controls still apply.",{"_3634":1115,"_31209":1097,"_21628":54471,"_5":14884,"_28401":54420,"_3085":54472},[],"`/simpleenroll`",{"_3634":1116,"_31209":1097,"_21628":54474,"_5":14884,"_28401":54420,"_3085":54475},[],"POST",{"_3634":1117,"_31209":1097,"_21628":54477,"_5":14884,"_28401":54420,"_3085":54478},[],"Initial authentication and DMS registration/replacement policy.",{"_3634":1118,"_31209":1097,"_21628":54480,"_5":14884,"_28401":54420,"_3085":54481},[],"`/simplereenroll`",{"_3634":1119,"_31209":1097,"_21628":54483,"_5":14884,"_28401":54420,"_3085":54475},[],{"_3634":1120,"_31209":1097,"_21628":54485,"_5":14884,"_28401":54420,"_3085":54486},[],"Renewal authentication, existing identity, subject, revocation and window.",{"_3634":1121,"_31209":1097,"_21628":54488,"_5":14884,"_28401":54420,"_3085":54489},[],"`/serverkeygen`",{"_3634":1122,"_31209":1097,"_21628":54491,"_5":14884,"_28401":54420,"_3085":54475},[],{"_3634":1123,"_31209":1097,"_21628":54493,"_5":14884,"_28401":54420,"_3085":54494},[],"Initial authentication and admission; server generation enabled.",{"_3634":1124,"_31209":1097,"_21628":54496,"_5":14884,"_28401":54420,"_3085":54497},[],"These routes do not implement `/csrattrs` or `/fullcmc`. There is no native JWT EST authentication mode; a webhook can interpret a request credential according to its own contract.",{"_3634":1125,"_31209":1097,"_21628":54499,"_5":14884,"_28401":54424,"_3085":54500},[],"The default response has `Content-Type: application/pkcs7-mime; smime-type=certs-only` and `Content-Transfer-Encoding: base64`. The body is Base64-encoded DER PKCS#7 with lines of up to 76 characters. It includes the certificates selected by the DMS, not necessarily every ancestor.",{"_3634":1126,"_31209":1097,"_21628":54502,"_5":14884,"_28401":54424,"_3085":54503},[],"`Accept: application/x-pem-file` requests the bundle in PEM through a Lamassu extension. Inspect and approve its contents before modifying trusted roots.",{"_3634":1127,"_31209":1097,"_21628":54505,"_5":14884,"_28401":54427,"_3085":54506},[],"Send a Base64-encoded DER PKCS#10 CSR with `Content-Type: application/pkcs10`. The controller compares that media type literally; avoid adding parameters such as charset. The CN identifies the device and the CSR signature must be verified through DMS policy.",{"_3634":1128,"_31209":1097,"_21628":54508,"_5":14884,"_28401":54427,"_3085":54509},[],"The default response uses the PKCS#7/Base64 format described for cacerts, but contains the issued certificate; do not assume it includes its entire chain. `Accept: application/x-pem-file` returns that certificate in PEM. The client retains the key that signed the CSR.",{"_3634":1129,"_31209":1097,"_21628":54511,"_5":14884,"_28401":54430,"_3085":54512},[],"Use the same request and certificate response formats. Authentication comes from the independent `reenrollment_settings.est_rfc7030_settings` block. With a client certificate, its CN must match the CSR CN; the subject is also checked against the current certificate.",{"_3634":1130,"_31209":1097,"_21628":54514,"_5":14884,"_28401":54430,"_3085":54515},[],"In mTLS mode, the enrollment CA always validates the re-enrollment credential; certificates from other issuers are accepted only if they are listed as validation CAs in the re-enrollment block. The expiry check through `enable_expired_renewal` belongs to that validator. A revoked current certificate and a request before the window are rejected. With default settings, a client certificate whose revocation cannot be verified is also rejected; the DMS guide describes `allow_unverifiable_revocation`. See Renewal for installation and recovery.",{"_3634":1131,"_31209":1097,"_21628":54517,"_5":14884,"_28401":54433,"_3085":54518},[],"The server generates a software key, rebuilds the CSR with that key and performs initial enrollment. The flag must be enabled and the algorithm permitted by the profile. This operation's key does not become a hardware key because the CA is hosted in an HSM.",{"_3634":1132,"_31209":1097,"_21628":54520,"_5":14884,"_28401":54433,"_3085":54521},[],"The code supports RSA and ECDSA, and the `bits` value of the DMS key setting means something different for each. For ECDSA it selects the curve: 224, 256, 384 or 521 map to P-224, P-256, P-384 and P-521, and an unrecognized size falls back to P-256, so explicitly select a compatible size and check the resulting key. For RSA it is used directly as the modulus size; the console offers 2048, 3072 and 4096 bits. Do not reuse an enrolled ID to test this operation without reviewing replacement.",{"_3634":1133,"_31209":1097,"_21628":54523,"_5":14884,"_28401":54436,"_3085":54524},[],"The body is **MIME multipart/mixed**, with the boundary specified in `Content-Type`. It contains two parts:",{"_3634":1134,"_31209":1097,"_21628":54526,"_5":14884,"_28401":54436,"_3085":54527},[],"Part",{"_3634":1135,"_31209":1097,"_21628":54529,"_5":14884,"_28401":54436,"_3085":54530},[],"Content after decoding its Base64",{"_3634":1136,"_31209":1097,"_21628":54532,"_5":14884,"_28401":54436,"_3085":54533},[],"`application/pkcs8`",{"_3634":1137,"_31209":1097,"_21628":54535,"_5":14884,"_28401":54436,"_3085":54536},[],"Unencrypted DER PKCS#8 private key.",{"_3634":1138,"_31209":1097,"_21628":54538,"_5":14884,"_28401":54436,"_3085":54539},[],"`application/pkcs7-mime; smime-type=certs-only`",{"_3634":1139,"_31209":1097,"_21628":54541,"_5":14884,"_28401":54436,"_3085":54542},[],"DER PKCS#7 containing the issued certificate.",{"_3634":1140,"_31209":1097,"_21628":54544,"_5":14884,"_28401":54436,"_3085":54545},[],"The controller also adds `Content-Transfer-Encoding: base64` to the outer header, although the outer body is MIME text. &#x2A;*Do not Base64-decode the entire body.** Read the actual boundary and decode each part according to its headers.",{"_3634":1141,"_31209":1097,"_21628":54547,"_5":14884,"_28401":54440,"_3085":54548},[],"In a Bash session with `set -euo pipefail` and `umask 077`, use `EST_BASE` and the trust/bootstrap files from EST client. Select an available and admitted `est-serverkeygen-001`. The `server-request.key` only signs the input CSR; the received identity uses the server-generated key.",{"_3634":1142,"_31209":1097,"_21628":54550,"_5":14884,"_28401":54440,"_3085":54551},[],"Save this Python 3 extractor. It validates both parts before writing and rejects existing output files:",{"_3634":1143,"_31209":1097,"_21628":54553,"_5":14884,"_28401":54440,"_3085":54554},[],"Convert and check the result:",{"_3634":1144,"_31209":1097,"_21628":54556,"_5":14884,"_28401":54440,"_3085":54557},[],"Inspect the CN, serial, dates and uses; check association in Lamassu before installing. Protect the DER and PEM files containing the key and remove temporary copies according to the device's storage mechanism. See openssl-pkcs8 and the Python MIME parser.",{"_3634":1145,"_31209":1097,"_21628":54559,"_5":14884,"_28401":54444,"_3085":54560},[],"Do not interpret every 500 as a transient failure. Invalid input typically produces 400; service denials and errors typically produce 500 with a JSON `err` body. Gateway errors and some controller paths can have another format. Retain headers and body before decoding and see troubleshooting.",{"_3634":1146,"_31209":1097,"_21628":54562,"_5":14884,"_28401":54444,"_3085":54563},[],"The examples use openssl-pkcs7 to extract certificates and openssl-x509 to prepare renewal. Check your version's capabilities and responses before integrating a generic EST client.",{"_3634":1147,"_31209":1147,"_5":15244,"_3085":53867,"_31547":54565,"_21628":54566,"_28401":1147},[50999,52511,53683,53681,53867],[],{"_3634":1148,"_31209":1147,"_21628":54568,"_5":14884,"_28401":1147,"_3085":54569},[],"Choose admission policy and connect DMS, initial trust and the EST client.",{"_3634":1149,"_31209":1147,"_5":31544,"_21628":54571,"_28401":54572,"_3085":54573},[],"/docs/platform/iot-fleets/enrollment/overview#the-journey","The journey",{"_3634":1150,"_31209":1147,"_5":31544,"_21628":54575,"_28401":54576,"_3085":54577},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-administrator","For the administrator",{"_3634":1151,"_31209":1147,"_5":31544,"_21628":54579,"_28401":54580,"_3085":54581},[],"/docs/platform/iot-fleets/enrollment/overview#for-the-integrator","For the integrator",{"_3634":1152,"_31209":1147,"_21628":54583,"_5":14884,"_28401":1147,"_3085":54584},[],"Enrollment with PKI covers the path from device admission to identity installation and renewal. The DMS acts as a registration authority: it authenticates the request, applies registration policy and asks the CA to sign. The client keeps or receives the key, installs the result and presents it to the consumer.",{"_3634":1153,"_31209":1147,"_21628":54586,"_5":14884,"_28401":54572,"_3085":54587},[],"The administrator prepares the CA, issuance profile and DMS.",{"_3634":1154,"_31209":1147,"_21628":54589,"_5":14884,"_28401":54572,"_3085":54590},[],"The integrator installs initial EST server trust and an admission credential.",{"_3634":1155,"_31209":1147,"_21628":54592,"_5":14884,"_28401":54572,"_3085":54593},[],"The client requests an identity for its `Device ID` through EST.",{"_3634":1156,"_31209":1147,"_21628":54595,"_5":14884,"_28401":54572,"_3085":54596},[],"Certificate, device binding and key/certificate installation are checked.",{"_3634":1157,"_31209":1147,"_21628":54598,"_5":14884,"_28401":54572,"_3085":54599},[],"The consumer validates and authorizes the identity; the client schedules renewal and recovery.",{"_3634":1158,"_31209":1147,"_21628":54601,"_5":14884,"_28401":54572,"_3085":54602},[],"EST uses `/.well-known/est/{DMS_ID}`. Administrative APIs and manual assignment remain separate paths. Enroll and connect a device completes an initial mTLS test.",{"_3634":1159,"_31209":1147,"_21628":54604,"_5":14884,"_28401":54576,"_3085":54605},[],"<Card title=\"Provisioning strategies\" description=\"Choose automatic registration, preregistration or manual assignment.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3634":1160,"_31209":1147,"_21628":54607,"_5":14884,"_28401":54576,"_3085":54608},[],"<Card title=\"Configure the DMS\" description=\"Separate admission, authentication per operation, profiles and distribution.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":1161,"_31209":1147,"_21628":54610,"_5":14884,"_28401":54576,"_3085":54611},[],"<Card title=\"Bootstrap identity and authentication\" description=\"Decide which proof allows requesting the first identity.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3634":1162,"_31209":1147,"_21628":54613,"_5":14884,"_28401":54576,"_3085":54614},[],"<Card title=\"Trust distribution\" description=\"Update roots and chains with verified overlap.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3634":1163,"_31209":1147,"_21628":54616,"_5":14884,"_28401":54580,"_3085":54617},[],"<Card title=\"EST client\" description=\"Prepare the request, verify the response and install the identity.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3634":1164,"_31209":1147,"_21628":54619,"_5":14884,"_28401":54580,"_3085":54620},[],"<Card title=\"Renewal and recovery\" description=\"Generate the successor and handle expired or lost credentials.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3634":1165,"_31209":1147,"_21628":54622,"_5":14884,"_28401":54580,"_3085":54623},[],"<Card title=\"EST reference\" description=\"Look up paths, formats, authentication and ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3634":1166,"_31209":1147,"_21628":54625,"_5":14884,"_28401":54580,"_3085":54626},[],"<Card title=\"Troubleshooting\" description=\"Distinguish transport, policy, issuance and installation failures.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3634":1167,"_31209":1147,"_21628":54628,"_5":14884,"_28401":54580,"_3085":54629},[],"Gateway, TLS, provider and service configuration belongs to Deployment. Identity use in AWS or other destinations belongs to Integrations.",{"_3634":1168,"_31209":1168,"_5":15244,"_3085":54631,"_31547":54632,"_21628":54633,"_28401":1168},"Provisioning strategies",[50999,52511,53683,53681,53867],[],{"_3634":1169,"_31209":1168,"_21628":54635,"_5":14884,"_28401":1168,"_3085":54636},[],"Choose device registration, identity authorization and key generation.",{"_3634":1170,"_31209":1168,"_5":31544,"_21628":54638,"_28401":54639,"_3085":54640},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-registration","Choose registration",{"_3634":1171,"_31209":1168,"_5":31544,"_21628":54642,"_28401":54643,"_3085":54644},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#preregistration-and-replacement","Preregistration and replacement",{"_3634":1172,"_31209":1168,"_5":31544,"_21628":54646,"_28401":54647,"_3085":54648},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-authentication","Choose authentication",{"_3634":1173,"_31209":1168,"_5":31544,"_21628":54650,"_28401":54651,"_3085":54652},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#choose-custody","Choose custody",{"_3634":1174,"_31209":1168,"_5":31544,"_21628":54654,"_28401":54655,"_3085":54656},[],"/docs/platform/iot-fleets/enrollment/provisioning-strategies#check-the-decision","Check the decision",{"_3634":1175,"_31209":1168,"_21628":54658,"_5":14884,"_28401":1168,"_3085":54659},[],"This guide helps the provisioning administrator choose a path before configuring the DMS. Separate three decisions: when the device exists, how its request is authorized and who generates its key. None grants destination access by itself.",{"_3634":1176,"_31209":1168,"_21628":54661,"_5":14884,"_28401":54639,"_3085":54662},[],"Path",{"_3634":1177,"_31209":1168,"_21628":54664,"_5":14884,"_28401":54639,"_3085":54665},[],"When the device exists",{"_3634":1178,"_31209":1168,"_21628":54667,"_5":14884,"_28401":54639,"_3085":54668},[],"What to check",{"_3634":1179,"_31209":1168,"_21628":54670,"_5":14884,"_28401":54639,"_3085":54671},[],"Manual assignment",{"_3634":1180,"_31209":1168,"_21628":54673,"_5":14884,"_28401":54639,"_3085":54674},[],"An operator creates it before associating a certificate.",{"_3634":1181,"_31209":1168,"_21628":54676,"_5":14884,"_28401":54639,"_3085":54677},[],"ID, owning DMS, certificate CN and bound serial.",{"_3634":1182,"_31209":1168,"_21628":54679,"_5":14884,"_28401":54639,"_3085":54680},[],"EST with `JITP`",{"_3634":1183,"_31209":1168,"_21628":54682,"_5":14884,"_28401":54639,"_3085":54683},[],"Created for an unknown CN during `/simpleenroll`.",{"_3634":1184,"_31209":1168,"_21628":54685,"_5":14884,"_28401":54639,"_3085":54686},[],"Authorized credential, unused ID, profile, resulting registration and identity.",{"_3634":1185,"_31209":1168,"_21628":54688,"_5":14884,"_28401":54639,"_3085":54689},[],"EST with `PRE_REGISTRATION`",{"_3634":1186,"_31209":1168,"_21628":54691,"_5":14884,"_28401":54639,"_3085":54692},[],"Must exist before `/simpleenroll`.",{"_3634":1187,"_31209":1168,"_21628":54694,"_5":14884,"_28401":54639,"_3085":54695},[],"Approved record, same DMS and replacement conditions for your version.",{"_3634":1188,"_31209":1168,"_21628":54697,"_5":14884,"_28401":54639,"_3085":54698},[],"Lamassu `JITP` creates inventory and identity in Lamassu. AWS JITP provisions a destination in AWS; these are separate decisions.",{"_3634":1189,"_31209":1168,"_21628":54700,"_5":14884,"_28401":54639,"_3085":54701},[],"For an initial client test, use Enroll and connect a device. To prepare inventory without EST, follow Manual registration.",{"_3634":1190,"_31209":1168,"_21628":54703,"_5":14884,"_28401":54643,"_3085":54704},[],"Finding any device owned by the same DMS triggers the `enable_replaceable_enrollment` check before PRE\\_REGISTRATION. With the flag disabled, a preregistered device can receive `forbiddenNewEnrollment` even in **No Identity**. Selecting PRE\\_REGISTRATION alone therefore does not establish a working path.",{"_3634":1191,"_31209":1168,"_21628":54706,"_5":14884,"_28401":54643,"_3085":54707},[],"Enabling the flag permits repeated `/simpleenroll` for an existing ID. The backend schedules a deferred attempt to revoke the previous certificate with `Superseded`; it can also run if later issuance or binding fails. Without an identity, that attempt can fail because no serial exists. The flag does not provide a replacement transaction or guarantee restoration of previous state.",{"_3634":1192,"_31209":1168,"_21628":54709,"_5":14884,"_28401":54643,"_3085":54710},[],"Test the exact case on your version before enabling it for a population. For an operational identity with authorized renewal, use `/simplereenroll`; for recovery, follow Renewal and recovery and check persisted state before retrying.",{"_3634":1193,"_31209":1168,"_21628":54712,"_5":14884,"_28401":54647,"_3085":54713},[],"Decide initial enrollment and re-enrollment separately:",{"_3634":1194,"_31209":1168,"_21628":54715,"_5":14884,"_28401":54647,"_3085":54716},[],"**Client certificate:** useful when each device has an initial credential whose key it controls.",{"_3634":1195,"_31209":1168,"_21628":54718,"_5":14884,"_28401":54647,"_3085":54719},[],"**Webhook:** useful when another authority knows inventory, credentials or entitlement to a requested ID.",{"_3634":1196,"_31209":1168,"_21628":54721,"_5":14884,"_28401":54647,"_3085":54722},[],"**Certificate and webhook:** requires both controls in the configured operation.",{"_3634":1197,"_31209":1168,"_21628":54724,"_5":14884,"_28401":54647,"_3085":54725},[],"**NO\\_AUTH:** does not establish requester identity; appropriate only when admission is deliberately controlled outside that DMS.",{"_3634":1198,"_31209":1168,"_21628":54727,"_5":14884,"_28401":54647,"_3085":54728},[],"Authenticating an initial certificate does not itself establish entitlement to choose any CSR CN. Define that authorization in Bootstrap identity and authentication.",{"_3634":1199,"_31209":1168,"_21628":54730,"_5":14884,"_28401":54651,"_3085":51383},[],{"_3634":1200,"_31209":1168,"_21628":54732,"_5":14884,"_28401":54651,"_3085":54733},[],"Material crossing EST",{"_3634":1201,"_31209":1168,"_21628":54735,"_5":14884,"_28401":54651,"_3085":54736},[],"Device-generated key",{"_3634":1202,"_31209":1168,"_21628":54738,"_5":14884,"_28401":54651,"_3085":54739},[],"Public CSR and certificate; the key stays on the client.",{"_3634":1203,"_31209":1168,"_21628":54741,"_5":14884,"_28401":54651,"_3085":54742},[],"Existing device key",{"_3634":1204,"_31209":1168,"_21628":54744,"_5":14884,"_28401":54651,"_3085":54745},[],"CSR signed with that key and a new certificate.",{"_3634":1205,"_31209":1168,"_21628":54747,"_5":14884,"_28401":54651,"_3085":54011},[],{"_3634":1206,"_31209":1168,"_21628":54749,"_5":14884,"_28401":54651,"_3085":54750},[],"Private PKCS#8 key and certificate in a TLS-protected multipart response.",{"_3634":1207,"_31209":1168,"_21628":54752,"_5":14884,"_28401":54651,"_3085":54753},[],"ServerKeyGen does not automatically use the CA’s HSM or KMS for the device key. Review its contract and extraction and the device’s ability to install the material.",{"_3634":1208,"_31209":1168,"_21628":54755,"_5":14884,"_28401":54655,"_3085":54756},[],"Before expanding the flow, test allowed registration, incorrect credentials, an ID owned by another DMS, repeated requests and recovery after failure. Keep ID, serial, active version and error. Also test consumer acceptance and rejection; issuance does not imply destination registration or permission to operate.",{"_3634":1209,"_31209":1209,"_5":15244,"_3085":54758,"_31547":54759,"_21628":54760,"_28401":1209},"Renewal and recovery",[50999,52511,53683,53681,53867],[],{"_3634":1210,"_31209":1209,"_21628":54762,"_5":14884,"_28401":1209,"_3085":54763},[],"Renew without losing the identity and recover devices according to their actual state.",{"_3634":1211,"_31209":1209,"_5":31544,"_21628":54765,"_28401":54766,"_3085":54767},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#prepare-renewal","Prepare renewal",{"_3634":1212,"_31209":1209,"_5":31544,"_21628":54769,"_28401":54770,"_3085":54771},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#request-the-successor-certificate","Request the successor certificate",{"_3634":1213,"_31209":1209,"_5":31544,"_21628":54773,"_28401":54774,"_3085":54775},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#install-and-check-the-new-pair","Install and check the new pair",{"_3634":1214,"_31209":1209,"_5":31544,"_21628":54777,"_28401":54778,"_3085":54779},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#recover-according-to-state","Recover according to state",{"_3634":1215,"_31209":1209,"_5":31544,"_21628":54781,"_28401":54782,"_3085":54783},[],"/docs/platform/iot-fleets/enrollment/renewal-and-recovery#continuous-operation","Continuous operation",{"_3634":1216,"_31209":1209,"_21628":54785,"_5":14884,"_28401":1209,"_3085":54786},[],"Renewal retains the device identifier and requests a successor certificate. The client must complete the process: check the response, install the matching pair and demonstrate that the consumer accepts it. Lamassu alerts notify you; they do not perform those steps.",{"_3634":1217,"_31209":1209,"_21628":54788,"_5":14884,"_28401":54766,"_3085":54789},[],"Query the current certificate in Lamassu and compare it with the installed certificate. You need its subject, serial and dates, as well as the client key.",{"_3634":1218,"_31209":1209,"_21628":54791,"_5":14884,"_28401":54766,"_3085":54792},[],"Check the **re-enrollment** authentication mode: it is independent of initial authentication. With `CLIENT_CERTIFICATE`, use the current identity; do not assume the bootstrap credential is admitted.",{"_3634":1219,"_31209":1209,"_21628":54794,"_5":14884,"_28401":54766,"_3085":54795},[],"Calculate the window's start: the current certificate's `NotAfter` minus `reenrollment_delta`. Preventive and critical thresholds produce states/notifications; they do not extend that window.",{"_3634":1220,"_31209":1209,"_21628":54797,"_5":14884,"_28401":54766,"_3085":54798},[],"Review **Revoke on Re-enrollment** and recovery if installation fails. When enabled, Lamassu can revoke the previous identity before the client installs the new one.",{"_3634":1221,"_31209":1209,"_21628":54800,"_5":14884,"_28401":54770,"_3085":54801},[],"The example continues the EST tutorial, in the same Bash session with `set -euo pipefail`, `umask 077` and `EST_BASE`. Use a new key compatible with the profile. Conversion from the certificate preserves the subject and copies only SAN when present; check the subject and requested names before sending it. The backend checks the subject against the current identity: it attempts RawSubject equality and then compares CN, OU, O, L, ST and C. Rebuilding only the CN can lose required attributes.",{"_3634":1222,"_31209":1209,"_21628":54803,"_5":14884,"_28401":54770,"_3085":54804},[],"The request authenticates with `device.crt` and `device.key`; the CSR contains the new public key. Also check extensions, dates and correspondence of the serial with the current slot in Lamassu. Do not resubmit a failed request without querying that state: issuance, previous revocation and successor binding can have partial results.",{"_3634":1223,"_31209":1209,"_21628":54806,"_5":14884,"_28401":54774,"_3085":54807},[],"Keep the result as `device.next.crt` and `device.next.key` until verified. Switch the pair through a coordinated operation in the device store or configuration; avoid temporarily exposing a certificate with another version's key.",{"_3634":1224,"_31209":1209,"_21628":54809,"_5":14884,"_28401":54774,"_3085":54810},[],"Test mTLS with the consumer and verify that it uses the new serial. Confirm the history and current certificate in Lamassu. If **Revoke on Re-enrollment** was disabled, the previous identity can remain valid: retire it according to PKI policy after testing the successor, and check revocation publication and consumption.",{"_3634":1225,"_31209":1209,"_21628":54812,"_5":14884,"_28401":54774,"_3085":54813},[],"If the previous identity is already revoked, retaining its files does not restore a valid connection. Recovery requires an admitted credential and authorized intervention according to the situation.",{"_3634":1226,"_31209":1209,"_21628":54815,"_5":14884,"_28401":54778,"_3085":54816},[],"Situation",{"_3634":1227,"_31209":1209,"_21628":54818,"_5":14884,"_28401":54778,"_3085":54819},[],"Procedure",{"_3634":1228,"_31209":1209,"_21628":54821,"_5":14884,"_28401":54778,"_3085":54822},[],"Valid certificate, outside the window",{"_3634":1229,"_31209":1209,"_21628":54824,"_5":14884,"_28401":54778,"_3085":54825},[],"Schedule the request within the window. Do not use `simpleenroll` to bypass it.",{"_3634":1230,"_31209":1209,"_21628":54827,"_5":14884,"_28401":54778,"_3085":54828},[],"Expired certificate, key available",{"_3634":1231,"_31209":1209,"_21628":54830,"_5":14884,"_28401":54778,"_3085":54831},[],"With certificate authentication, review `enable_expired_renewal` and whether Gateway permits presenting that credential. Revocation, subject and the remaining checks still apply.",{"_3634":1232,"_31209":1209,"_21628":54833,"_5":14884,"_28401":54778,"_3085":54834},[],"Renewal through webhook or `NO_AUTH`",{"_3634":1233,"_31209":1209,"_21628":54836,"_5":14884,"_28401":54778,"_3085":54837},[],"The mTLS expiry check does not run in these modes. Define expiry and authorization policy in the corresponding admission process; the flag is not a universal prohibition.",{"_3634":1234,"_31209":1209,"_21628":54839,"_5":14884,"_28401":54778,"_3085":54840},[],"Lost or inaccessible key",{"_3634":1235,"_31209":1209,"_21628":54842,"_5":14884,"_28401":54778,"_3085":54843},[],"You cannot prove possession of the previous identity. Authorize new admission and, if appropriate, controlled replacement; revoke the compromised identity.",{"_3634":1236,"_31209":1209,"_21628":54845,"_5":14884,"_28401":54778,"_3085":54846},[],"Current identity revoked",{"_3634":1237,"_31209":1209,"_21628":54848,"_5":14884,"_28401":54778,"_3085":54849},[],"`simplereenroll` rejects the revoked current certificate. Investigate the reason and prepare an authorized readmission procedure; do not disable authentication to force it.",{"_3634":1238,"_31209":1209,"_21628":54851,"_5":14884,"_28401":54778,"_3085":54852},[],"Device without an identity",{"_3634":1239,"_31209":1209,"_21628":54854,"_5":14884,"_28401":54778,"_3085":54855},[],"Use initial enrollment. For an existing entry, check the replacement restriction in provisioning.",{"_3634":1240,"_31209":1209,"_21628":54857,"_5":14884,"_28401":54778,"_3085":54858},[],"Retired device",{"_3634":1241,"_31209":1209,"_21628":54860,"_5":14884,"_28401":54778,"_3085":54861},[],"Review the operational decision before readmission. Decommissioned state and revocation of the entire history are not equivalent.",{"_3634":1242,"_31209":1209,"_21628":54863,"_5":14884,"_28401":54778,"_3085":54864},[],"Timeout, HTTP 500 or installation failure",{"_3634":1243,"_31209":1209,"_21628":54866,"_5":14884,"_28401":54778,"_3085":54867},[],"Inspect the device, issued certificates and history before retrying. A successor may have been issued or the previous identity revoked.",{"_3634":1244,"_31209":1209,"_21628":54869,"_5":14884,"_28401":54782,"_3085":54870},[],"Schedule renewal with time for disconnections, trust distribution and consumer checks. Stagger requests across the population and bound retries within the window; authentication, subject and policy errors require correcting their cause. Maintain an admitted and tested recovery mechanism for lost keys and pairs that could not be installed.",{"_3634":1245,"_31209":1209,"_21628":54872,"_5":14884,"_28401":54782,"_3085":54873},[],"Continue with Trust distribution, Devices and identities and Troubleshooting.",{"_3634":1246,"_31209":1246,"_5":15244,"_3085":54875,"_31547":54876,"_21628":54877,"_28401":1246},"Enrollment troubleshooting",[50999,52511,53683,53681,53867],[],{"_3634":1247,"_31209":1246,"_21628":54879,"_5":14884,"_28401":1246,"_3085":54880},[],"Locate transport, authentication, registration, issuance and installation failures.",{"_3634":1248,"_31209":1246,"_5":31544,"_21628":54882,"_28401":54883,"_3085":54884},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#diagnostics-and-compatibility","Diagnostics and compatibility",{"_3634":1249,"_31209":1246,"_5":31544,"_21628":54886,"_28401":54887,"_3085":54888},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#error-codes-and-diagnostics","Error codes and diagnostics",{"_3634":1250,"_31209":1246,"_5":31544,"_21628":54890,"_28401":54891,"_3085":54445},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#compatibility-notes",{"_3634":1251,"_31209":1246,"_5":31544,"_21628":54893,"_28401":54894,"_3085":54895},[],"/docs/platform/iot-fleets/enrollment/troubleshooting#est-enrollment-fails","EST enrollment fails",{"_3634":1252,"_31209":1246,"_21628":54897,"_5":14884,"_28401":1246,"_3085":54898},[],"Diagnose one operation and device at a time. Record the DMS/APS, endpoint, time, HTTP code, presented serial and CSR CN. Retain the response without including private keys or webhook credentials in the report.",{"_3634":1253,"_31209":1246,"_21628":54900,"_5":14884,"_28401":54887,"_3085":54901},[],"The EST controller normally returns 400 when rejecting input and 500 when the service rejects or fails the operation. A 500 can also represent a policy denial; it does not mean retrying is safe. Gateway can produce its own codes and bodies. Examine the actual body and persisted result.",{"_3634":1254,"_31209":1246,"_21628":54903,"_5":14884,"_28401":54887,"_3085":54904},[],"Symptom or message",{"_3634":1255,"_31209":1246,"_21628":54906,"_5":14884,"_28401":54887,"_3085":54668},[],{"_3634":1256,"_31209":1246,"_21628":54908,"_5":14884,"_28401":54887,"_3085":54909},[],"curl rejects TLS, name or issuer",{"_3634":1257,"_31209":1246,"_21628":54911,"_5":14884,"_28401":54887,"_3085":54912},[],"URL, clock, server SAN and approved root in `est-trust.pem`. Resolve trust in Deployment; do not skip verification.",{"_3634":1258,"_31209":1246,"_21628":54914,"_5":14884,"_28401":54887,"_3085":54915},[],"404 or missing APS",{"_3634":1259,"_31209":1246,"_21628":54917,"_5":14884,"_28401":54887,"_3085":54918},[],"Public route `/.well-known/est/{DMS_ID}/{operation}` and existing DMS. APS is not the service name.",{"_3634":1260,"_31209":1246,"_21628":54920,"_5":14884,"_28401":54887,"_3085":54921},[],"400, CSR or format error",{"_3634":1261,"_31209":1246,"_21628":54923,"_5":14884,"_28401":54887,"_3085":54924},[],"`Content-Type: application/pkcs10`, Base64 of DER, valid signature and a body preserved without double encoding.",{"_3634":1262,"_31209":1246,"_21628":54926,"_5":14884,"_28401":54887,"_3085":54927},[],"Missing credential or invalid certificate",{"_3634":1263,"_31209":1246,"_21628":54929,"_5":14884,"_28401":54887,"_3085":54930},[],"Operation mode, validating CA, dates, revocation and credential delivery by Gateway. Do not confuse server TLS trust with the bootstrap CA.",{"_3634":1264,"_31209":1246,"_21628":54932,"_5":14884,"_28401":54887,"_3085":54933},[],"Enroll or re-enroll rejects a certificate for unverifiable revocation",{"_3634":1265,"_31209":1246,"_21628":54935,"_5":14884,"_28401":54887,"_3085":54936},[],"Whether the certificate is managed by Lamassu, whether its OCSP/CRL endpoints are configured and reachable from the service, and whether `allow_unverifiable_revocation` is set for that operation's block. See DMS and Revocation and checks.",{"_3634":1266,"_31209":1246,"_21628":54938,"_5":14884,"_28401":54887,"_3085":54939},[],"Webhook denies, times out or responds without authorization",{"_3634":1267,"_31209":1246,"_21628":54941,"_5":14884,"_28401":54887,"_3085":54942},[],"Configuration, connectivity and JSON response with `authorized: true`. There is no automatic fallback to `NO_AUTH`.",{"_3634":1268,"_31209":1246,"_21628":54944,"_5":14884,"_28401":54887,"_3085":54945},[],"`unexpected status code: <n>: redirects are not followed`",{"_3634":1269,"_31209":1246,"_21628":54947,"_5":14884,"_28401":54887,"_3085":54948},[],"The webhook answered with a redirect. Configure the final absolute `http` or `https` URL in the webhook config; redirects are never followed.",{"_3634":1270,"_31209":1246,"_21628":54950,"_5":14884,"_28401":54887,"_3085":54951},[],"`webhook response exceeds 1048576 bytes`",{"_3634":1271,"_31209":1246,"_21628":54953,"_5":14884,"_28401":54887,"_3085":54954},[],"The receiver returned more than 1 MiB of JSON. Reduce the response of the authorization webhook.",{"_3634":1272,"_31209":1246,"_21628":54956,"_5":14884,"_28401":54887,"_3085":54957},[],"`webhook config must not reference files`",{"_3634":1273,"_31209":1246,"_21628":54959,"_5":14884,"_28401":54887,"_3085":54960},[],"The webhook config points to files (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). For mTLS, enter the certificate and key as Base64-encoded PEM in `cert_content` and `key_content`, or as plain PEM; remove any other file field, including `ca_cert_file`, which has no inline equivalent (the receiver certificate must chain to the system trust store). See the webhook credentials guidance in DMS.",{"_3634":1274,"_31209":1246,"_21628":54962,"_5":14884,"_28401":54887,"_3085":54963},[],"`mtls_options.cert_content must be base64-encoded PEM`",{"_3634":1275,"_31209":1246,"_21628":54965,"_5":14884,"_28401":54887,"_3085":54966},[],"The value is neither Base64-encoded PEM nor plain PEM: it is a file path or Base64 of non-PEM data. Enter the certificate and key as Base64-encoded PEM, like certificates elsewhere in the API, or as plain PEM (see the webhook settings in DMS). The same message names `mtls_options.key_content` when the key is the offending value.",{"_3634":1276,"_31209":1246,"_21628":54968,"_5":14884,"_28401":54887,"_3085":54969},[],"`webhook mTLS certificate and key are invalid: …`",{"_3634":1277,"_31209":1246,"_21628":54971,"_5":14884,"_28401":54887,"_3085":54972},[],"The certificate and key do not form a matching pair. Enter both values from the same pair; the check runs when the DMS is saved and again on every webhook call.",{"_3634":1278,"_31209":1246,"_21628":54974,"_5":14884,"_28401":54887,"_3085":54975},[],"400 `struct validation error` creating or updating a DMS",{"_3634":1279,"_31209":1246,"_21628":54977,"_5":14884,"_28401":54887,"_3085":54978},[],"The webhook config of the operation that uses it is invalid. Review `external_webhook_settings` in DMS.",{"_3634":1280,"_31209":1246,"_21628":54980,"_5":14884,"_28401":54887,"_3085":54981},[],"HTTP 500 with an `err` body on enroll or reenroll",{"_3634":1281,"_31209":1246,"_21628":54983,"_5":14884,"_28401":54887,"_3085":54984},[],"Service failures reach the EST client as 500 with a body of `err` plus the message; webhook authorization errors are named there.",{"_3634":1282,"_31209":1246,"_21628":54986,"_5":14884,"_28401":54887,"_3085":54987},[],"`device not preregistered`",{"_3634":1283,"_31209":1246,"_21628":54989,"_5":14884,"_28401":54887,"_3085":54990},[],"PRE\\_REGISTRATION requires an existing inventory entry.",{"_3634":1284,"_31209":1246,"_21628":54992,"_5":14884,"_28401":54887,"_3085":54993},[],"`forbiddenNewEnrollment`",{"_3634":1285,"_31209":1246,"_21628":54995,"_5":14884,"_28401":54887,"_3085":54996},[],"An existing device requires replacement to be enabled, even in No Identity. Investigate before enabling the flag.",{"_3634":1286,"_31209":1246,"_21628":54998,"_5":14884,"_28401":54887,"_3085":54999},[],"Different owning DMS",{"_3634":1287,"_31209":1246,"_21628":55001,"_5":14884,"_28401":54887,"_3085":55002},[],"CN/ID, global inventory and owning DMS; do not reuse an ID from another context.",{"_3634":1288,"_31209":1246,"_21628":55004,"_5":14884,"_28401":54887,"_3085":55005},[],"`invalid RawSubject bytes`",{"_3634":1289,"_31209":1246,"_21628":55007,"_5":14884,"_28401":54887,"_3085":55008},[],"CSR subject versus the current certificate. Preserve its attributes as well as its CN.",{"_3634":1290,"_31209":1246,"_21628":55010,"_5":14884,"_28401":54887,"_3085":55011},[],"`invalid reenroll window`",{"_3634":1291,"_31209":1246,"_21628":55013,"_5":14884,"_28401":54887,"_3085":55014},[],"Current identity's NotAfter and reenrollment\\_delta. Alert thresholds do not change that window.",{"_3634":1292,"_31209":1246,"_21628":55016,"_5":14884,"_28401":54887,"_3085":55017},[],"Current certificate revoked",{"_3634":1293,"_31209":1246,"_21628":55019,"_5":14884,"_28401":54887,"_3085":55020},[],"Renewal rejected; prepare authorized recovery according to the cause.",{"_3634":1294,"_31209":1246,"_21628":55022,"_5":14884,"_28401":54887,"_3085":55023},[],"CA, profile or signing error",{"_3634":1295,"_31209":1246,"_21628":55025,"_5":14884,"_28401":54887,"_3085":55026},[],"Active CA, available key, selected profile and restrictions. Successful cacerts does not prove issuance.",{"_3634":1296,"_31209":1246,"_21628":55028,"_5":14884,"_28401":54887,"_3085":55029},[],"HTTP 200 without a device connection",{"_3634":1297,"_31209":1246,"_21628":55031,"_5":14884,"_28401":54887,"_3085":55032},[],"Installed pair, chain, uses, consumer trust and permissions. Also check the slot and history.",{"_3634":1298,"_31209":1246,"_21628":55034,"_5":14884,"_28401":54887,"_3085":55035},[],"Timeout or error after issuance",{"_3634":1299,"_31209":1246,"_21628":55037,"_5":14884,"_28401":54887,"_3085":55038},[],"New certificates, current slot and previous identity's state before retrying.",{"_3634":1300,"_31209":1246,"_21628":55040,"_5":14884,"_28401":54891,"_3085":55041},[],"Check the saved renewal mode and Gateway behavior with expired certificates and the bootstrap CA.",{"_3634":1301,"_31209":1246,"_21628":55043,"_5":14884,"_28401":54891,"_3085":55044},[],"The default response is Base64-encoded DER PKCS#7; PEM through `Accept: application/x-pem-file` is a Lamassu extension. ServerKeyGen returns multipart and requires handling each part separately. See the EST reference.",{"_3634":1302,"_31209":1246,"_21628":55046,"_5":14884,"_28401":54894,"_3085":55047},[],"Check HTTPS with the approved root and query cacerts for the correct APS.",{"_3634":1303,"_31209":1246,"_21628":55049,"_5":14884,"_28401":54894,"_3085":55050},[],"Review the saved DMS: protocol, registration, authentication for that operation, CA, profile and window.",{"_3634":1304,"_31209":1246,"_21628":55052,"_5":14884,"_28401":54894,"_3085":55053},[],"Verify the CSR locally and relate its CN to the inventory.",{"_3634":1305,"_31209":1246,"_21628":55055,"_5":14884,"_28401":54894,"_3085":55056},[],"Make one request, save headers/body and query the device and certificates.",{"_3634":1306,"_31209":1246,"_21628":55058,"_5":14884,"_28401":54894,"_3085":55059},[],"If you receive an identity, check the key, subject, use and connection with the consumer.",{"_3634":1307,"_31209":1246,"_21628":55061,"_5":14884,"_28401":54894,"_3085":55062},[],"External bootstrap revocation checks fail closed: a certificate whose revocation cannot be verified — including an OCSP Unknown status — is rejected by default. Only `allow_unverifiable_revocation` in that operation's block (see DMS) relaxes it, and only for certificates that carry no OCSP/CRL endpoint at all; unreachable, stale or inconclusive endpoints are rejected whatever the option says. See Revocation and checks. An intermediate CA in the TLS chain does not prove that the entire chain reached the DMS validator either.",{"_3634":1308,"_31209":1246,"_21628":55064,"_5":14884,"_28401":54894,"_3085":55065},[],"For logs, networking, pods or Gateway headers, continue in Deployment troubleshooting. For identities issued, revoked or bound partially, use Renewal and recovery and Devices and identities.",{"_3634":1309,"_31209":1309,"_5":15244,"_3085":55067,"_31547":55068,"_21628":55069,"_28401":1309},"Trust distribution and updates",[50999,52511,53683,53681,53867],[],{"_3634":1310,"_31209":1309,"_21628":55071,"_5":14884,"_28401":1309,"_3085":55072},[],"Separate roots, intermediates and initial TLS trust when distributing or migrating certificates.",{"_3634":1311,"_31209":1309,"_5":31544,"_21628":55074,"_28401":55075,"_3085":55076},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#three-trust-relationships","Three trust relationships",{"_3634":1312,"_31209":1309,"_5":31544,"_21628":55078,"_28401":55079,"_3085":55080},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#what-cacerts-returns","What cacerts returns",{"_3634":1313,"_31209":1309,"_5":31544,"_21628":55082,"_28401":55083,"_3085":55084},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#install-the-required-material","Install the required material",{"_3634":1314,"_31209":1309,"_5":31544,"_21628":55086,"_28401":55087,"_3085":55088},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#migrate-trust","Migrate trust",{"_3634":1315,"_31209":1309,"_5":31544,"_21628":55090,"_28401":55091,"_3085":55092},[],"/docs/platform/iot-fleets/enrollment/trust-distribution#check-the-update","Check the update",{"_3634":1316,"_31209":1309,"_21628":55094,"_5":14884,"_28401":1309,"_3085":55095},[],"This guide is for device and consumer trust administrators. You need issuer inventory, trust-store access and an authenticated update channel. Distributing certificates is separate from choosing trusted anchors.",{"_3634":1317,"_31209":1309,"_21628":55097,"_5":14884,"_28401":55075,"_3085":55098},[],"Relationship",{"_3634":1318,"_31209":1309,"_21628":55100,"_5":14884,"_28401":55075,"_3085":55101},[],"Material prepared by its owner",{"_3634":1319,"_31209":1309,"_21628":55103,"_5":14884,"_28401":55075,"_3085":55104},[],"Device → EST server",{"_3634":1320,"_31209":1309,"_21628":55106,"_5":14884,"_28401":55075,"_3085":55107},[],"Previously verified server root, chain or pin and TLS name.",{"_3634":1321,"_31209":1309,"_21628":55109,"_5":14884,"_28401":55075,"_3085":55110},[],"DMS → requester",{"_3634":1322,"_31209":1309,"_21628":55112,"_5":14884,"_28401":55075,"_3085":55113},[],"CAs and rules authorizing initial or renewal credentials.",{"_3634":1323,"_31209":1309,"_21628":55115,"_5":14884,"_28401":55075,"_3085":55116},[],"Consumer → device",{"_3634":1324,"_31209":1309,"_21628":55118,"_5":14884,"_28401":55075,"_3085":55119},[],"Operational identity roots, intermediates, validation and permissions.",{"_3634":1325,"_31209":1309,"_21628":55121,"_5":14884,"_28401":55075,"_3085":55122},[],"Obtaining a certificate does not automatically configure these relationships in third parties. Review the Trust model.",{"_3634":1326,"_31209":1309,"_21628":55124,"_5":14884,"_28401":55079,"_3085":55125},[],"The DMS may include the available downstream TLS certificate, selected Managed CAs and enrollment CA. Selecting the issuer does not include every ancestor. The set may contain leaves, roots and intermediates, including multiple hierarchies during migration.",{"_3634":1327,"_31209":1309,"_21628":55127,"_5":14884,"_28401":55079,"_3085":55128},[],"Position does not define the chain. Identify certificates by subject, issuer, AKI/SKI, signature and constraints. Download and inspect using EST client.",{"_3634":1328,"_31209":1309,"_21628":55130,"_5":14884,"_28401":55083,"_3085":55131},[],"Keep initial EST server trust separate from identity consumer trust.",{"_3634":1329,"_31209":1309,"_21628":55133,"_5":14884,"_28401":55083,"_3085":55134},[],"Select policy-approved roots as anchors.",{"_3634":1330,"_31209":1309,"_21628":55136,"_5":14884,"_28401":55083,"_3085":55137},[],"Retain intermediates for chain building or presentation; do not automatically turn them into roots.",{"_3634":1331,"_31209":1309,"_21628":55139,"_5":14884,"_28401":55083,"_3085":55140},[],"Present the leaf and required intermediates in mTLS. Normally the peer already trusts its root and does not need it sent.",{"_3634":1332,"_31209":1309,"_21628":55142,"_5":14884,"_28401":55083,"_3085":55143},[],"Verify chain, dates, names, usages and revocation from the consumer.",{"_3634":1333,"_31209":1309,"_21628":55145,"_5":14884,"_28401":55083,"_3085":55146},[],"Do not indiscriminately use all of `cacerts.pem` as `-CAfile`: this can expand trusted authorities, hide missing intermediates or trust a TLS leaf intended for another purpose.",{"_3634":1334,"_31209":1309,"_21628":55148,"_5":14884,"_28401":55087,"_3085":55149},[],"Before changing Enrollment CA, inventory disconnected equipment, bootstrap and operational certificates, and consumers. Distribute the new root and required intermediates; check that a cohort accepts both old and new chains.",{"_3634":1335,"_31209":1309,"_21628":55151,"_5":14884,"_28401":55087,"_3085":55152},[],"In the DMS, separate distributed CAs from the re-enrollment validation CAs at `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, used for re-enrollment credentials. That list is optional because the enrollment CA always validates re-enrollment credentials, but when switching the enrollment CA, add the previous issuance CA to it so old-CA identities keep re-enrolling during overlap. The validator tries the enrollment CA followed by those CAs against the received leaf; accepting a multilevel chain requires checking what reaches the service and which issuer is configured.",{"_3634":1336,"_31209":1309,"_21628":55154,"_5":14884,"_28401":55087,"_3085":55155},[],"Switch issuance, renew in cohorts and compare the installed serial with the active slot. Remove previous trust once no legitimate equipment needs it and policy permits ending overlap. Follow Hierarchy and rotation for the PKI operation.",{"_3634":1337,"_31209":1309,"_21628":55157,"_5":14884,"_28401":55091,"_3085":55158},[],"Test an old identity allowed during overlap, a new one, an unknown chain and the result after removing old trust. Keep trust-store version, approved set, date and result. Reachable `/cacerts` establishes distribution only; it does not establish installation or acceptance across every device.",{"_3634":1338,"_31209":1338,"_5":15244,"_3085":55160,"_31547":55161,"_21628":55163,"_28401":1338},"AWS IoT Core",[50999,52511,53683,53681,55162],"Integrations",[],{"_3634":1339,"_31209":1338,"_21628":55165,"_5":14884,"_28401":1338,"_3085":55166},[],"Lamassu's connector for AWS IoT Core syncs device identities with the AWS platform, handling CA registration, Thing provisioning and certificate lifecycle automatically and event-driven.",{"_3634":1340,"_31209":1338,"_5":31544,"_21628":55168,"_28401":55169,"_3085":55170},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#connector-architecture","Connector architecture",{"_3634":1341,"_31209":1338,"_5":31544,"_21628":55172,"_28401":55173,"_3085":55174},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#prerequisites","Prerequisites",{"_3634":1342,"_31209":1338,"_5":31544,"_21628":55176,"_28401":55177,"_3085":55178},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#required-iam-permissions","Required IAM permissions",{"_3634":1343,"_31209":1338,"_5":31544,"_21628":55180,"_28401":55181,"_3085":55182},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#configuration-parameters","Configuration parameters",{"_3634":1344,"_31209":1338,"_5":31544,"_21628":55184,"_28401":55185,"_3085":55186},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#events-and-aws-resources","Events and AWS resources",{"_3634":1345,"_31209":1338,"_5":31544,"_21628":55188,"_28401":55189,"_3085":55190},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-in-aws-iot-core","CA registration in AWS IoT Core",{"_3634":1346,"_31209":1338,"_5":31544,"_21628":55192,"_28401":55193,"_3085":55194},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#how-to-request-registration","How to request registration",{"_3634":1347,"_31209":1338,"_5":31544,"_21628":55196,"_28401":55197,"_3085":55198},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#ca-registration-states","CA registration states",{"_3634":1348,"_31209":1338,"_5":31544,"_21628":55200,"_28401":55201,"_3085":55202},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#primary-account","Primary Account",{"_3634":1349,"_31209":1338,"_5":31544,"_21628":55204,"_28401":55205,"_3085":55206},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only","Secondary Account (SNI-only)",{"_3634":1350,"_31209":1338,"_5":31544,"_21628":55208,"_28401":55209,"_3085":55210},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-configuration","DMS configuration",{"_3634":1351,"_31209":1338,"_5":31544,"_21628":55212,"_28401":55213,"_3085":55214},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#none-mode","`none` mode",{"_3634":1352,"_31209":1338,"_5":31544,"_21628":55216,"_28401":55217,"_3085":55218},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#auto-mode","`auto` mode",{"_3634":1353,"_31209":1338,"_5":31544,"_21628":55220,"_28401":55221,"_3085":55222},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#jitp-mode","`jitp` mode",{"_3634":1354,"_31209":1338,"_5":31544,"_21628":55224,"_28401":55225,"_3085":55226},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#dms-registration-mode-states","DMS registration-mode states",{"_3634":1355,"_31209":1338,"_5":31544,"_21628":55228,"_28401":55229,"_3085":55230},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-automatic-mode","Device provisioning (automatic mode)",{"_3634":1356,"_31209":1338,"_5":31544,"_21628":55232,"_28401":55233,"_3085":55234},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#thing-lifecycle","Thing lifecycle",{"_3634":1357,"_31209":1338,"_5":31544,"_21628":55236,"_28401":55237,"_3085":55238},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-provisioning-jitp-mode","Device provisioning (JITP mode)",{"_3634":1358,"_31209":1338,"_5":31544,"_21628":55240,"_28401":55241,"_3085":55242},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-synchronization","Certificate status synchronization",{"_3634":1359,"_31209":1338,"_5":31544,"_21628":55244,"_28401":55245,"_3085":55246},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#certificate-status-states","Certificate status states",{"_3634":1360,"_31209":1338,"_5":31544,"_21628":55248,"_28401":55249,"_3085":55250},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#forced-disconnect-on-revocation","Forced disconnect on revocation",{"_3634":1361,"_31209":1338,"_5":31544,"_21628":55252,"_28401":55253,"_3085":55254},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#device-shadow-and-automation","Device Shadow and automation",{"_3634":1362,"_31209":1338,"_5":31544,"_21628":55256,"_28401":55257,"_3085":55258},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#what-the-connector-writes-to-the-shadow","What the connector writes to the shadow",{"_3634":1363,"_31209":1338,"_5":31544,"_21628":55260,"_28401":55261,"_3085":55262},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#aws-iot-policies","AWS IoT policies",{"_3634":1364,"_31209":1338,"_5":31544,"_21628":55264,"_28401":55265,"_3085":55266},[],"/docs/platform/iot-fleets/integrations/aws-iot-core#troubleshooting","Troubleshooting",{"_3634":1365,"_31209":1338,"_21628":55268,"_5":14884,"_28401":1338,"_3085":55269},[],"Lamassu's integration with AWS IoT Core bridges the PKI managed by Lamassu and AWS's connectivity platform. When a device obtains its certificate through the EST enrollment process, the connector ensures that certificate and its associated identity are recognized in AWS IoT Core without manual intervention. The result is that the device can authenticate directly to AWS with the same X.509 certificate Lamassu issued.",{"_3634":1366,"_31209":1338,"_21628":55271,"_5":14884,"_28401":1338,"_3085":55272},[],"From a protocol standpoint, the device authenticates to AWS IoT Core via mutual TLS (mTLS): it presents its Lamassu-issued X.509 certificate as the client certificate, and AWS IoT Core verifies the certificate chain up to the CA registered in the account. Lamassu acts as the certification authority (CA); the connector ensures that CA is registered in AWS and that the device's certificate is known to the platform before the device attempts to connect (in `auto` mode) or on its first connection (in JITP mode).",{"_3634":1367,"_31209":1338,"_21628":55274,"_5":14884,"_28401":1338,"_3085":55275},[],"This document is aimed both at the PKI administrator, who needs to configure the connector and register CAs, and at the device firmware developer, who needs to understand how Things are named, how the Device Shadow works and what happens when a certificate is revoked. For the firmware developer, the most important fact is that **the AWS Thing name (ThingName) always corresponds to the Common Name (CN) of the certificate issued by Lamassu**, regardless of the provisioning mode.",{"_3634":1368,"_31209":1338,"_21628":55277,"_5":14884,"_28401":55169,"_3085":55278},[],"The AWS IoT Core connector is an independent Go process, a binary or container separate from Lamassu's core. In a monolithic deployment it is compiled by default (build tag `!noaws`) and activated with `aws_iot_manager.enabled: true` in the configuration file. In distributed deployments, it runs as its own container with access to Lamassu's CA, DMS Manager and Device Manager services over HTTP.",{"_3634":1369,"_31209":1338,"_21628":55280,"_5":14884,"_28401":55169,"_3085":55281},[],"The connector does not poll Lamassu's services periodically. Instead, it **subscribes to Lamassu's internal event bus** (AMQP or AWS SQS/SNS, configurable) and reacts to the events it cares about: CA creation or update, DMS creation or update, device identity binding, certificate status change, certificate metadata update and device metadata update. This event-driven model ensures synchronization with AWS is nearly immediate and produces no polling load.",{"_3634":1370,"_31209":1338,"_21628":55283,"_5":14884,"_28401":55169,"_3085":55284},[],"To avoid infinite loops, the connector ignores any event whose CloudEvent `source` field matches its own origin URI. This prevents the metadata writes the connector itself performs from re-triggering the same flow.",{"_3634":1371,"_31209":1338,"_21628":55286,"_5":14884,"_28401":55169,"_3085":55287},[],"When several connectors run in parallel, for example for different AWS accounts, each instance has its own `connector_id`. All metadata the connector writes to Lamassu is stored under the key `lamassu.io/iot/{connector_id}`, allowing coexistence without collisions.",{"_3634":1372,"_31209":1338,"_21628":55289,"_5":14884,"_28401":55173,"_3085":55290},[],"Before enabling the connector you need an AWS account with the proper IAM permissions and the connector correctly configured. The deployment process (Docker Compose, Kubernetes or binary) is described in the deployment documentation.",{"_3634":1373,"_31209":1338,"_21628":55292,"_5":14884,"_28401":55177,"_3085":55293},[],"The IAM identity operating the connector needs at minimum the following permissions on the target account's resources:",{"_3634":1374,"_31209":1338,"_21628":55295,"_5":14884,"_28401":55177,"_3085":55296},[],"IAM action",{"_3634":1375,"_31209":1338,"_21628":55298,"_5":14884,"_28401":55177,"_3085":51389},[],{"_3634":1376,"_31209":1338,"_21628":55300,"_5":14884,"_28401":55177,"_3085":55301},[],"`iot:GetRegistrationCode`",{"_3634":1377,"_31209":1338,"_21628":55303,"_5":14884,"_28401":55177,"_3085":55304},[],"Obtain the verification code for CA registration in the Primary Account",{"_3634":1378,"_31209":1338,"_21628":55306,"_5":14884,"_28401":55177,"_3085":55307},[],"`iot:RegisterCACertificate`",{"_3634":1379,"_31209":1338,"_21628":55309,"_5":14884,"_28401":55177,"_3085":55310},[],"Register the CA in AWS IoT",{"_3634":1380,"_31209":1338,"_21628":55312,"_5":14884,"_28401":55177,"_3085":55313},[],"`iot:DescribeCACertificate`",{"_3634":1381,"_31209":1338,"_21628":55315,"_5":14884,"_28401":55177,"_3085":55316},[],"Check the CA registration status",{"_3634":1382,"_31209":1338,"_21628":55318,"_5":14884,"_28401":55177,"_3085":55319},[],"`iot:CreateThing` / `iot:UpdateThing`",{"_3634":1383,"_31209":1338,"_21628":55321,"_5":14884,"_28401":55177,"_3085":55322},[],"Create or update Things in IoT Core",{"_3634":1384,"_31209":1338,"_21628":55324,"_5":14884,"_28401":55177,"_3085":55325},[],"`iot:RegisterThing`",{"_3634":1385,"_31209":1338,"_21628":55327,"_5":14884,"_28401":55177,"_3085":55328},[],"Provision Things through a template",{"_3634":1386,"_31209":1338,"_21628":55330,"_5":14884,"_28401":55177,"_3085":55331},[],"`iot:RegisterCertificate`",{"_3634":1387,"_31209":1338,"_21628":55333,"_5":14884,"_28401":55177,"_3085":55334},[],"Register device certificates",{"_3634":1388,"_31209":1338,"_21628":55336,"_5":14884,"_28401":55177,"_3085":55337},[],"`iot:UpdateCertificate`",{"_3634":1389,"_31209":1338,"_21628":55339,"_5":14884,"_28401":55177,"_3085":55340},[],"Change a certificate's status (ACTIVE / INACTIVE / REVOKED)",{"_3634":1390,"_31209":1338,"_21628":55342,"_5":14884,"_28401":55177,"_3085":55343},[],"`iot:CreatePolicy` / `iot:AttachPolicy`",{"_3634":1391,"_31209":1338,"_21628":55345,"_5":14884,"_28401":55177,"_3085":55346},[],"Create and attach IoT policies",{"_3634":1392,"_31209":1338,"_21628":55348,"_5":14884,"_28401":55177,"_3085":55349},[],"`iot:CreateThingGroup` / `iot:AddThingToThingGroup`",{"_3634":1393,"_31209":1338,"_21628":55351,"_5":14884,"_28401":55177,"_3085":55352},[],"Manage Thing groups",{"_3634":1394,"_31209":1338,"_21628":55354,"_5":14884,"_28401":55177,"_3085":55355},[],"`iot:CreateProvisioningTemplate`",{"_3634":1395,"_31209":1338,"_21628":55357,"_5":14884,"_28401":55177,"_3085":55358},[],"Create JITP templates",{"_3634":1396,"_31209":1338,"_21628":55360,"_5":14884,"_28401":55177,"_3085":55361},[],"`iotdata:GetThingShadow` / `iotdata:UpdateThingShadow`",{"_3634":1397,"_31209":1338,"_21628":55363,"_5":14884,"_28401":55177,"_3085":55364},[],"Read and write the Device Shadow",{"_3634":1398,"_31209":1338,"_21628":55366,"_5":14884,"_28401":55177,"_3085":55367},[],"The forced-disconnect mechanism after revocation also requires access to the AWS IoT data plane API (`iot:Connect` with SigV4 over WebSocket), negotiated implicitly with the connector's credentials.",{"_3634":1399,"_31209":1338,"_21628":55369,"_5":14884,"_28401":55181,"_3085":55370},[],"Parameter",{"_3634":1400,"_31209":1338,"_21628":55372,"_5":14884,"_28401":55181,"_3085":55373},[],"Type",{"_3634":1401,"_31209":1338,"_21628":55375,"_5":14884,"_28401":55181,"_3085":55376},[],"Required",{"_3634":1402,"_31209":1338,"_21628":55378,"_5":14884,"_28401":55181,"_3085":55379},[],"Description",{"_3634":1403,"_31209":1338,"_21628":55381,"_5":14884,"_28401":55181,"_3085":55382},[],"`connector_id`",{"_3634":1404,"_31209":1338,"_21628":55384,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1405,"_31209":1338,"_21628":55386,"_5":14884,"_28401":55181,"_3085":55387},[],"Yes",{"_3634":1406,"_31209":1338,"_21628":55389,"_5":14884,"_28401":55181,"_3085":55390},[],"Unique identifier of this connector instance. Used as the metadata namespace: `lamassu.io/iot/{connector_id}`.",{"_3634":1407,"_31209":1338,"_21628":55392,"_5":14884,"_28401":55181,"_3085":55393},[],"`aws_config.region`",{"_3634":1408,"_31209":1338,"_21628":55395,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1409,"_31209":1338,"_21628":55397,"_5":14884,"_28401":55181,"_3085":55387},[],{"_3634":1410,"_31209":1338,"_21628":55399,"_5":14884,"_28401":55181,"_3085":55400},[],"AWS region where the connector operates.",{"_3634":1411,"_31209":1338,"_21628":55402,"_5":14884,"_28401":55181,"_3085":55403},[],"`aws_config.auth_method`",{"_3634":1412,"_31209":1338,"_21628":55405,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1413,"_31209":1338,"_21628":55407,"_5":14884,"_28401":55181,"_3085":55387},[],{"_3634":1414,"_31209":1338,"_21628":55409,"_5":14884,"_28401":55181,"_3085":55410},[],"Authentication method: `static`, `role` or empty (SDK default credential chain).",{"_3634":1415,"_31209":1338,"_21628":55412,"_5":14884,"_28401":55181,"_3085":55413},[],"`aws_config.access_key_id`",{"_3634":1416,"_31209":1338,"_21628":55415,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1417,"_31209":1338,"_21628":55417,"_5":14884,"_28401":55181,"_3085":55418},[],"Only with `auth_method=static`",{"_3634":1418,"_31209":1338,"_21628":55420,"_5":14884,"_28401":55181,"_3085":55421},[],"AWS access key.",{"_3634":1419,"_31209":1338,"_21628":55423,"_5":14884,"_28401":55181,"_3085":55424},[],"`aws_config.secret_access_key`",{"_3634":1420,"_31209":1338,"_21628":55426,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1421,"_31209":1338,"_21628":55428,"_5":14884,"_28401":55181,"_3085":55418},[],{"_3634":1422,"_31209":1338,"_21628":55430,"_5":14884,"_28401":55181,"_3085":55431},[],"AWS secret key.",{"_3634":1423,"_31209":1338,"_21628":55433,"_5":14884,"_28401":55181,"_3085":55434},[],"`aws_config.session_token`",{"_3634":1424,"_31209":1338,"_21628":55436,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1425,"_31209":1338,"_21628":55438,"_5":14884,"_28401":55181,"_3085":55439},[],"No",{"_3634":1426,"_31209":1338,"_21628":55441,"_5":14884,"_28401":55181,"_3085":55442},[],"Session token (with `auth_method=static`).",{"_3634":1427,"_31209":1338,"_21628":55444,"_5":14884,"_28401":55181,"_3085":55445},[],"`aws_config.role_arn`",{"_3634":1428,"_31209":1338,"_21628":55447,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1429,"_31209":1338,"_21628":55449,"_5":14884,"_28401":55181,"_3085":55450},[],"Only with `auth_method=role`",{"_3634":1430,"_31209":1338,"_21628":55452,"_5":14884,"_28401":55181,"_3085":55453},[],"ARN of the role to assume.",{"_3634":1431,"_31209":1338,"_21628":55455,"_5":14884,"_28401":55181,"_3085":55456},[],"`aws_config.endpoint_url`",{"_3634":1432,"_31209":1338,"_21628":55458,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1433,"_31209":1338,"_21628":55460,"_5":14884,"_28401":55181,"_3085":55439},[],{"_3634":1434,"_31209":1338,"_21628":55462,"_5":14884,"_28401":55181,"_3085":55463},[],"Alternative URL for all AWS services (useful with LocalStack in tests).",{"_3634":1435,"_31209":1338,"_21628":55465,"_5":14884,"_28401":55181,"_3085":55466},[],"`subscriber_event_bus`",{"_3634":1436,"_31209":1338,"_21628":55468,"_5":14884,"_28401":55181,"_3085":18241},[],{"_3634":1437,"_31209":1338,"_21628":55470,"_5":14884,"_28401":55181,"_3085":55387},[],{"_3634":1438,"_31209":1338,"_21628":55472,"_5":14884,"_28401":55181,"_3085":55473},[],"Configuration of the event bus the connector subscribes to (AMQP or AWS SQS/SNS).",{"_3634":1439,"_31209":1338,"_21628":55475,"_5":14884,"_28401":55181,"_3085":55476},[],"`dms_manager_client`",{"_3634":1440,"_31209":1338,"_21628":55478,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1441,"_31209":1338,"_21628":55480,"_5":14884,"_28401":55181,"_3085":55387},[],{"_3634":1442,"_31209":1338,"_21628":55482,"_5":14884,"_28401":55181,"_3085":55483},[],"HTTP URL of Lamassu's DMS Manager service.",{"_3634":1443,"_31209":1338,"_21628":55485,"_5":14884,"_28401":55181,"_3085":55486},[],"`device_manager_client`",{"_3634":1444,"_31209":1338,"_21628":55488,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1445,"_31209":1338,"_21628":55490,"_5":14884,"_28401":55181,"_3085":55387},[],{"_3634":1446,"_31209":1338,"_21628":55492,"_5":14884,"_28401":55181,"_3085":55493},[],"HTTP URL of Lamassu's Device Manager.",{"_3634":1447,"_31209":1338,"_21628":55495,"_5":14884,"_28401":55181,"_3085":55496},[],"`ca_client`",{"_3634":1448,"_31209":1338,"_21628":55498,"_5":14884,"_28401":55181,"_3085":25815},[],{"_3634":1449,"_31209":1338,"_21628":55500,"_5":14884,"_28401":55181,"_3085":55387},[],{"_3634":1450,"_31209":1338,"_21628":55502,"_5":14884,"_28401":55181,"_3085":55503},[],"HTTP URL of Lamassu's CA service.",{"_3634":1451,"_31209":1338,"_21628":55505,"_5":14884,"_28401":55185,"_3085":55506},[],"The connector owns the AWS side of four resource types — CAs, DMS provisioning templates (JITP), device certificates and Things. This section maps the bus events the connector consumes to the AWS resources they touch and to the AWS calls each flow performs. The state machine of each resource lives next to its detailed explanation; the last column links to it. AWS resources are referenced with the notation `IoTCore/<resource>`.",{"_3634":1452,"_31209":1338,"_21628":55508,"_5":14884,"_28401":55185,"_3085":55509},[],"The **CloudEvent type** column lists the event name on Lamassu's internal event bus; the **IAM actions** column lists the exact AWS SDK operations each flow invokes, so the required permissions can be derived directly from this table.",{"_3634":1453,"_31209":1338,"_21628":55511,"_5":14884,"_28401":55185,"_3085":55512},[],"CloudEvent type",{"_3634":1454,"_31209":1338,"_21628":55514,"_5":14884,"_28401":55185,"_3085":55515},[],"Lamassu resource",{"_3634":1455,"_31209":1338,"_21628":55517,"_5":14884,"_28401":55185,"_3085":55518},[],"AWS Resource",{"_3634":1456,"_31209":1338,"_21628":55520,"_5":14884,"_28401":55185,"_3085":55521},[],"IAM actions",{"_3634":1457,"_31209":1338,"_21628":55523,"_5":14884,"_28401":55185,"_3085":55524},[],"AWS calls and effect",{"_3634":1458,"_31209":1338,"_21628":55526,"_5":14884,"_28401":55185,"_3085":55527},[],"Where in this page",{"_3634":1459,"_31209":1338,"_21628":55529,"_5":14884,"_28401":55185,"_3085":55530},[],"`EventCreateCAKey` / `EventImportCAKey` / `EventUpdateCAMetadataKey`",{"_3634":1460,"_31209":1338,"_21628":55532,"_5":14884,"_28401":55185,"_3085":55533},[],"CA",{"_3634":1461,"_31209":1338,"_21628":55535,"_5":14884,"_28401":55185,"_3085":55536},[],"`IoTCore/CACertificate`",{"_3634":1462,"_31209":1338,"_21628":55538,"_5":14884,"_28401":55185,"_3085":55539},[],"`iot:GetRegistrationCode`, `iot:RegisterCACertificate`, `iot:DescribeCACertificate`, `iot:ListCACertificates`",{"_3634":1463,"_31209":1338,"_21628":55541,"_5":14884,"_28401":55185,"_3085":55542},[],"Loads the CA into connector state; a `registration.status = REQUESTED` write fires the registration flow (Primary with verification certificate, or SNI-only) and writes `SUCCEEDED` or `FAILED` back to the CA's metadata.",{"_3634":1464,"_31209":1338,"_21628":55544,"_5":14884,"_28401":55185,"_3085":55198},[],{"_3634":1465,"_31209":1338,"_21628":55546,"_5":14884,"_28401":55185,"_3085":55547},[],"`EventCreateDMSKey` / `EventUpdateDMSKey`",{"_3634":1466,"_31209":1338,"_21628":55549,"_5":14884,"_28401":55185,"_3085":55550},[],"DMS",{"_3634":1467,"_31209":1338,"_21628":55552,"_5":14884,"_28401":55185,"_3085":55553},[],"`IoTCore/ProvisioningTemplate`",{"_3634":1468,"_31209":1338,"_21628":55555,"_5":14884,"_28401":55185,"_3085":55556},[],"`iot:CreateProvisioningTemplate`, `iot:UpdateCACertificate`",{"_3634":1469,"_31209":1338,"_21628":55558,"_5":14884,"_28401":55185,"_3085":55559},[],"In `jitp` mode, attempts to create the provisioning template and attaches it to the registered CA. Non-idempotent: a `PUT /v1/dms/{id}` edit retries the creation and lands in `lamassu-dlq` after 3 retries. Idempotent for `none` and `auto` (configuration only).",{"_3634":1470,"_31209":1338,"_21628":55561,"_5":14884,"_28401":55185,"_3085":55226},[],{"_3634":1471,"_31209":1338,"_21628":55563,"_5":14884,"_28401":55185,"_3085":55564},[],"`EventBindDeviceIdentityKey`",{"_3634":1472,"_31209":1338,"_21628":55566,"_5":14884,"_28401":55185,"_3085":55567},[],"Device",{"_3634":1473,"_31209":1338,"_21628":55569,"_5":14884,"_28401":55185,"_3085":55570},[],"`IoTCore/Policy`, `IoTCore/ThingGroup`, `IoTCore/Thing`",{"_3634":1474,"_31209":1338,"_21628":55572,"_5":14884,"_28401":55185,"_3085":55573},[],"`iot:CreatePolicy` / `iot:DeletePolicyVersion`, `iot:GetPolicy` / `iot:ListPolicyVersions`, `iot:CreateThingGroup`, `iot:DescribeThing` / `iot:ListThingPrincipals`, `iot:RegisterThing`",{"_3634":1475,"_31209":1338,"_21628":55575,"_5":14884,"_28401":55185,"_3085":55576},[],"In `auto` mode: creates/updates policies, ensures Thing groups, revokes stale principals and provisions the Thing via `iot:RegisterThing`. In `jitp` mode: no AWS calls; AWS runs the JITP template on first connection.",{"_3634":1476,"_31209":1338,"_21628":55578,"_5":14884,"_28401":55185,"_3085":55234},[],{"_3634":1477,"_31209":1338,"_21628":55580,"_5":14884,"_28401":55185,"_3085":55581},[],"`EventUpdateCertificateStatusKey`",{"_3634":1478,"_31209":1338,"_21628":55583,"_5":14884,"_28401":55185,"_3085":55584},[],"Certificate",{"_3634":1479,"_31209":1338,"_21628":55586,"_5":14884,"_28401":55185,"_3085":55587},[],"`IoTCore/Certificate`",{"_3634":1480,"_31209":1338,"_21628":55589,"_5":14884,"_28401":55185,"_3085":55590},[],"`iot:UpdateCertificate`, `iot:Connect` (data plane)",{"_3634":1481,"_31209":1338,"_21628":55592,"_5":14884,"_28401":55185,"_3085":55593},[],"Maps status to AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), calls `iot:UpdateCertificate` and forces an MQTT disconnect on revoke.",{"_3634":1482,"_31209":1338,"_21628":55595,"_5":14884,"_28401":55185,"_3085":55246},[],{"_3634":1483,"_31209":1338,"_21628":55597,"_5":14884,"_28401":55185,"_3085":55598},[],"`EventUpdateCertificateMetadataKey` / `EventUpdateDeviceMetadataKey`",{"_3634":1484,"_31209":1338,"_21628":55600,"_5":14884,"_28401":55185,"_3085":55601},[],"Certificate / Device",{"_3634":1485,"_31209":1338,"_21628":55603,"_5":14884,"_28401":55185,"_3085":55604},[],"`IoTCore/Certificate`, `IoTCore/Thing`",{"_3634":1486,"_31209":1338,"_21628":55606,"_5":14884,"_28401":55185,"_3085":51395},[],{"_3634":1487,"_31209":1338,"_21628":55608,"_5":14884,"_28401":55185,"_3085":55609},[],"Refreshes internal state; the connector ignores events whose CloudEvent `source` matches its own URI to avoid self-triggered loops.",{"_3634":1488,"_31209":1338,"_21628":55611,"_5":14884,"_28401":55185,"_3085":55254},[],{"_3634":1489,"_31209":1338,"_21628":55613,"_5":14884,"_28401":55189,"_3085":55614},[],"For devices to authenticate to AWS IoT Core with certificates issued by a Lamassu CA, that CA must first be registered in the AWS account. The connector handles this registration automatically in response to the `EventCreateCAKey`, `EventImportCAKey` and `EventUpdateCAMetadataKey` events, but the operation **only fires when the administrator explicitly requests it** through the CA metadata field.",{"_3634":1490,"_31209":1338,"_21628":55616,"_5":14884,"_28401":55193,"_3085":55617},[],"Registration is triggered by setting `registration.status = \"REQUESTED\"` on the `lamassu.io/iot/{connector_id}` key of the CA's metadata. This can be done from the Lamassu console in the CA management section or through the API.",{"_3634":1491,"_31209":1338,"_21628":55619,"_5":14884,"_28401":55193,"_3085":55620},[],"Once the event is received, the connector attempts to register the CA in AWS and updates the `registration.status` field in the CA's metadata with the result: `\"SUCCEEDED\"` if registration was successful, or `\"FAILED\"` with an error message otherwise. The process is asynchronous, so you must periodically check the metadata status until the operation completes.",{"_3634":1492,"_31209":1338,"_21628":55622,"_5":14884,"_28401":55197,"_3085":55623},[],"The CA registration flow is driven by the `registration.status` field of the CA's connector metadata:",{"_3634":1493,"_31209":1338,"_21628":55625,"_5":14884,"_28401":55197,"_3085":55626},[],"Transition",{"_3634":1494,"_31209":1338,"_21628":55628,"_5":14884,"_28401":55197,"_3085":55629},[],"AWS calls",{"_3634":1495,"_31209":1338,"_21628":55631,"_5":14884,"_28401":55197,"_3085":55632},[],"`NotRegistered` → `Requested`",{"_3634":1496,"_31209":1338,"_21628":55634,"_5":14884,"_28401":55197,"_3085":55635},[],"none (metadata write only)",{"_3634":1497,"_31209":1338,"_21628":55637,"_5":14884,"_28401":55197,"_3085":55638},[],"`Requested` → `Registering`",{"_3634":1498,"_31209":1338,"_21628":55640,"_5":14884,"_28401":55197,"_3085":55641},[],"`iot:GetRegistrationCode` (Primary Account only)",{"_3634":1499,"_31209":1338,"_21628":55643,"_5":14884,"_28401":55197,"_3085":55644},[],"`Registering` → `Succeeded`",{"_3634":1500,"_31209":1338,"_21628":55646,"_5":14884,"_28401":55197,"_3085":55647},[],"`iot:RegisterCACertificate` (Primary: proof-of-possession with an ephemeral key; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3634":1501,"_31209":1338,"_21628":55649,"_5":14884,"_28401":55197,"_3085":55650},[],"`Registering` → `Failed`",{"_3634":1502,"_31209":1338,"_21628":55652,"_5":14884,"_28401":55197,"_3085":55653},[],"failed `iot:RegisterCACertificate`; the error detail is written to the CA's metadata",{"_3634":1503,"_31209":1338,"_21628":55655,"_5":14884,"_28401":55197,"_3085":55656},[],"`Failed` / `Succeeded` → `Requested`",{"_3634":1504,"_31209":1338,"_21628":55658,"_5":14884,"_28401":55197,"_3085":55659},[],"none (a new `REQUESTED` write re-runs the flow)",{"_3634":1505,"_31209":1338,"_21628":55661,"_5":14884,"_28401":55201,"_3085":55662},[],"When the `primary_account` parameter is `true`, the connector runs the full registration flow with proof-of-possession of the private key:",{"_3634":1506,"_31209":1338,"_21628":55664,"_5":14884,"_28401":55201,"_3085":55665},[],"It calls `iot:GetRegistrationCode` to obtain AWS's verification code.",{"_3634":1507,"_31209":1338,"_21628":55667,"_5":14884,"_28401":55201,"_3085":55668},[],"The connector internally generates an ephemeral RSA-2048 key pair and builds a CSR whose Common Name is exactly that registration code. It then calls Lamassu's signing service so the registered CA issues a real X.509 verification certificate signing that CSR. The ephemeral private key is used only for this purpose and is neither stored nor sent to AWS.",{"_3634":1508,"_31209":1338,"_21628":55670,"_5":14884,"_28401":55201,"_3085":55671},[],"It sends the CA (in PEM) and the verification certificate to AWS via `iot:RegisterCACertificate`, enabling registration with `AllowAutoRegistration: true`.",{"_3634":1509,"_31209":1338,"_21628":55673,"_5":14884,"_28401":55201,"_3085":55674},[],"Only one account can own a CA in a given AWS region. If the CA is already registered with the same serial number, the connector silently skips the step.",{"_3634":1510,"_31209":1338,"_21628":55676,"_5":14884,"_28401":55201,"_3085":55677},[],"The tags AWS IoT Core applies to the registered CA certificate are `LMS.CA.ID`, `LMS.CA.SN` and `LMS.CA.CN`.",{"_3634":1511,"_31209":1338,"_21628":55679,"_5":14884,"_28401":55205,"_3085":55680},[],"When `primary_account` is `false`, the connector registers the CA using `CertificateMode: SNI_ONLY`. This mode requires no verification code or access to the CA's private key, so it is the right choice when the CA is managed from another AWS account or when the administrator does not hold the private key. It is the usual method to register the same CA in several AWS accounts simultaneously.",{"_3634":1512,"_31209":1338,"_21628":55682,"_5":14884,"_28401":55209,"_3085":55683},[],"Each DMS participating in the AWS IoT Core integration must have the metadata key `lamassu.io/iot/{connector_id}` configured. The most important field of that configuration is `registration_mode`, which determines how devices are provisioned in AWS.",{"_3634":1513,"_31209":1338,"_21628":55685,"_5":14884,"_28401":55209,"_3085":55686},[],"There are three registration modes, and the choice among them depends on the fleet's provisioning strategy.",{"_3634":1514,"_31209":1338,"_21628":55688,"_5":14884,"_28401":55213,"_3085":55689},[],"In this mode the connector **creates no Things, groups or policies** in AWS IoT Core. It only syncs certificate status (active, revoked, suspended) as it changes in Lamassu. It is the right mode when Thing provisioning in AWS is managed by an external system and Lamassu only needs to keep certificate status up to date.",{"_3634":1515,"_31209":1338,"_21628":55691,"_5":14884,"_28401":55217,"_3085":55692},[],"`auto` mode delegates full device provisioning in AWS to Lamassu at enrollment time. When the device successfully completes its EST enrollment and Lamassu emits the `EventBindDeviceIdentityKey` event, the connector automatically executes the following sequence:",{"_3634":1516,"_31209":1338,"_21628":55694,"_5":14884,"_28401":55217,"_3085":55695},[],"Creates or updates the IoT policies configured in the DMS.",{"_3634":1517,"_31209":1338,"_21628":55697,"_5":14884,"_28401":55217,"_3085":55698},[],"Creates the root group `LAMASSU` in the AWS account (if it does not exist) and the child groups configured in the DMS as subgroups of `LAMASSU`. If the groups already exist, the `ResourceAlreadyExistsException` error is ignored, making the operation idempotent.",{"_3634":1518,"_31209":1338,"_21628":55700,"_5":14884,"_28401":55217,"_3085":55701},[],"If the Thing already existed in AWS IoT Core, the connector iterates all certificates (principals) currently attached to that Thing and marks them as `REVOKED` in AWS, ensuring previous certificates cannot keep being used to authenticate.",{"_3634":1519,"_31209":1338,"_21628":55703,"_5":14884,"_28401":55217,"_3085":55704},[],"Calls `iot:RegisterThing` with a CloudFormation-style provisioning template that creates the Thing, registers the device's certificate (PEM of the device certificate and of the issuing CA certificate) and attaches the configured policies.",{"_3634":1520,"_31209":1338,"_21628":55706,"_5":14884,"_28401":55217,"_3085":55707},[],"Once provisioning completes, the connector stores the resulting certificate's ARN in the Lamassu certificate's metadata under the key `lamassu.io/iot/{connector_id}` and marks the device as `Registered: true` in Device Manager.",{"_3634":1521,"_31209":1338,"_21628":55709,"_5":14884,"_28401":55217,"_3085":55710},[],"**The Thing name in AWS is the Common Name (CN) of the device's certificate.** This convention is fundamental for the firmware developer: the `/CN=` value the device includes in its CSR when enrolling becomes the ThingName it must identify itself with in all MQTT operations against AWS IoT Core.",{"_3634":1522,"_31209":1338,"_21628":55712,"_5":14884,"_28401":55221,"_3085":55713},[],"Just-In-Time Provisioning (JITP) mode delegates provisioning to AWS instead of the connector doing it directly. When the connector detects the DMS is in `jitp` mode, it creates a JITP provisioning template in AWS IoT Core and attaches it to the registered CA certificate. The connector attempts to create this template when the DMS is created and again on every full DMS edit (`PUT /v1/dms/{id}`) — not at device enrollment time. The attempt is not idempotent: when a template named after the DMS ID already exists, the creation call fails, the event is retried three times and finally lands in the `lamassu-dlq` poison queue (see Troubleshooting). The template is created once; later DMS edits never update its content. A DMS update that omits `metadata` or sends `null` keeps the stored metadata, so the connector key `lamassu.io/iot/{connector_id}` remains present and the attempt is still triggered. A body that supplies a `metadata` object replaces the stored metadata entirely: if that object does not carry the connector key, the key is dropped and the connector silently skips the DMS's future events. Once the template is attached, when a device with a certificate issued by that CA connects to AWS IoT Core for the first time, AWS executes the template automatically: it creates the Thing, registers the certificate and activates it.",{"_3634":1523,"_31209":1338,"_21628":55715,"_5":14884,"_28401":55221,"_3085":55716},[],"The connector creates the template, named after the DMS ID, only once. Each later edit of the DMS that keeps the connector key tries to create it again and fails, because the connector does not update existing templates. Later changes to `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` or to the groups and policies the template references must be applied by hand in AWS IoT Core.",{"_3634":1524,"_31209":1338,"_21628":55718,"_5":14884,"_28401":55221,"_3085":55719},[],"The failed event is retried and ends in `lamassu-dlq`. Groups and policies are registered before the failure, but the assignment of the template to the registered CA, the write-back of the ARN to the DMS and the shadow update when `ManagedCAs` changes are skipped.",{"_3634":1525,"_31209":1338,"_21628":55721,"_5":14884,"_28401":55221,"_3085":55722},[],"The Thing name in the JITP template is derived from `AWS::IoT::Certificate::CommonName`, which corresponds to the device certificate's CN — the same convention as `auto` mode.",{"_3634":1526,"_31209":1338,"_21628":55724,"_5":14884,"_28401":55221,"_3085":55725},[],"This mode requires the `jitp_config.provisioning_role_arn` field to be configured with the ARN of an IAM role AWS IoT Core can assume to execute the template. If not configured, the connector uses the default `arn:aws:iam::{account}:role/JITPRole` and logs a warning. The administrator must ensure that role exists in the account and has the necessary permissions before enabling JITP mode.",{"_3634":1527,"_31209":1338,"_21628":55727,"_5":14884,"_28401":55225,"_3085":55728},[],"The DMS's `registration_mode` determines what the connector does on the AWS side when the DMS is created or fully edited:",{"_3634":1528,"_31209":1338,"_21628":55730,"_5":14884,"_28401":55225,"_3085":55626},[],{"_3634":1529,"_31209":1338,"_21628":55732,"_5":14884,"_28401":55225,"_3085":55629},[],{"_3634":1530,"_31209":1338,"_21628":55734,"_5":14884,"_28401":55225,"_3085":55735},[],"`Unconfigured` → `None` / `Auto`",{"_3634":1531,"_31209":1338,"_21628":55737,"_5":14884,"_28401":55225,"_3085":55738},[],"none (configuration only)",{"_3634":1532,"_31209":1338,"_21628":55740,"_5":14884,"_28401":55225,"_3085":55741},[],"`None` ↔ `Auto`",{"_3634":1533,"_31209":1338,"_21628":55743,"_5":14884,"_28401":55225,"_3085":55738},[],{"_3634":1534,"_31209":1338,"_21628":55745,"_5":14884,"_28401":55225,"_3085":55746},[],"Any → `Jitp`",{"_3634":1535,"_31209":1338,"_21628":55748,"_5":14884,"_28401":55225,"_3085":55749},[],"`iot:CreateProvisioningTemplate` (non-idempotent: it fails when the template already exists; after 3 retries the event lands in `lamassu-dlq`)",{"_3634":1536,"_31209":1338,"_21628":55751,"_5":14884,"_28401":55225,"_3085":55752},[],"`Jitp` → `None` / `Auto`",{"_3634":1537,"_31209":1338,"_21628":55754,"_5":14884,"_28401":55225,"_3085":55755},[],"none (the template stays in the AWS account)",{"_3634":1538,"_31209":1338,"_21628":55757,"_5":14884,"_28401":55229,"_3085":55758},[],"For the firmware developer, `auto` mode is transparent: the device performs its EST enrollment as usual and, as a side effect, it is provisioned in AWS IoT Core with no additional step.",{"_3634":1539,"_31209":1338,"_21628":55760,"_5":14884,"_28401":55229,"_3085":55761},[],"The full flow from the device's perspective is:",{"_3634":1540,"_31209":1338,"_21628":55763,"_5":14884,"_28401":55229,"_3085":55764},[],"Once the connector completes provisioning, the device can connect to the AWS IoT Core MQTT endpoint using its private key and the certificate issued by Lamassu. The ThingName it must identify itself with in AWS is exactly the certificate's CN.",{"_3634":1541,"_31209":1338,"_21628":55766,"_5":14884,"_28401":55233,"_3085":55767},[],"Things only exist under `auto` mode; in `jitp` mode AWS creates the Thing itself when the device first connects. The Thing name is always the device certificate's CN:",{"_3634":1542,"_31209":1338,"_21628":55769,"_5":14884,"_28401":55233,"_3085":55626},[],{"_3634":1543,"_31209":1338,"_21628":55771,"_5":14884,"_28401":55233,"_3085":55629},[],{"_3634":1544,"_31209":1338,"_21628":55773,"_5":14884,"_28401":55233,"_3085":55774},[],"`Absent` → `Provisioned`",{"_3634":1545,"_31209":1338,"_21628":55776,"_5":14884,"_28401":55233,"_3085":55777},[],"policies created/updated, Thing groups ensured, `iot:RegisterThing` (creates the Thing, registers the certificate, attaches policies)",{"_3634":1546,"_31209":1338,"_21628":55779,"_5":14884,"_28401":55233,"_3085":55780},[],"`Provisioned` → `Provisioned` (re-enrollment)",{"_3634":1547,"_31209":1338,"_21628":55782,"_5":14884,"_28401":55233,"_3085":55783},[],"stale principals marked `REVOKED`, new `iot:RegisterThing` run; the new certificate ARN replaces the old one in Lamassu metadata",{"_3634":1548,"_31209":1338,"_21628":55785,"_5":14884,"_28401":55233,"_3085":55786},[],"In `jitp` mode the connector makes no provisioning calls: AWS executes the JITP template on the device's first connection and creates the Thing, registers the certificate and activates it on its own.",{"_3634":1549,"_31209":1338,"_21628":55788,"_5":14884,"_28401":55237,"_3085":55789},[],"In JITP mode the device also performs its EST enrollment conventionally and obtains its certificate from Lamassu. The difference is that AWS IoT Core does not know the device until it attempts its first connection.",{"_3634":1550,"_31209":1338,"_21628":55791,"_5":14884,"_28401":55237,"_3085":55792},[],"When the device establishes its first MQTT connection to AWS IoT Core presenting the Lamassu-issued certificate, AWS detects that the certificate belongs to a CA registered with a JITP template, executes that template and creates the Thing automatically. The initial connection may fail or be delayed while the template runs; firmware must be prepared to retry the connection.",{"_3634":1551,"_31209":1338,"_21628":55794,"_5":14884,"_28401":55237,"_3085":55795},[],"For the JITP flow to work correctly:",{"_3634":1552,"_31209":1338,"_21628":55797,"_5":14884,"_28401":55237,"_3085":55798},[],"The CA must be registered in AWS in Primary Account mode (SNI-only mode does not support JITP).",{"_3634":1553,"_31209":1338,"_21628":55800,"_5":14884,"_28401":55237,"_3085":55801},[],"The IAM role configured in `jitp_config.provisioning_role_arn` must exist and have permissions to create Things, register certificates and attach policies in the AWS account.",{"_3634":1554,"_31209":1338,"_21628":55803,"_5":14884,"_28401":55237,"_3085":55804},[],"The device must present both its certificate and the issuing CA's certificate in the TLS handshake with AWS IoT Core.",{"_3634":1555,"_31209":1338,"_21628":55806,"_5":14884,"_28401":55237,"_3085":55807},[],"Certificates provisioned via JITP **do not have the connector's metadata key** (`lamassu.io/iot/{connector_id}`) in Lamassu. As a consequence, status changes of those certificates in Lamassu are not automatically synced to AWS through the state synchronization mechanism described in the next section.",{"_3634":1556,"_31209":1338,"_21628":55809,"_5":14884,"_28401":55241,"_3085":55810},[],"The connector listens for the `EventUpdateCertificateStatusKey` event and, when a certificate holding the connector's metadata key changes status in Lamassu, replicates that change in AWS IoT Core. The following table shows the status mapping:",{"_3634":1557,"_31209":1338,"_21628":55812,"_5":14884,"_28401":55241,"_3085":55813},[],"Status in Lamassu",{"_3634":1558,"_31209":1338,"_21628":55815,"_5":14884,"_28401":55241,"_3085":55816},[],"Revocation reason",{"_3634":1559,"_31209":1338,"_21628":55818,"_5":14884,"_28401":55241,"_3085":55819},[],"Status in AWS IoT Core",{"_3634":1560,"_31209":1338,"_21628":55821,"_5":14884,"_28401":55241,"_3085":55822},[],"`Active`",{"_3634":1561,"_31209":1338,"_21628":55824,"_5":14884,"_28401":55241,"_3085":55825},[],"None",{"_3634":1562,"_31209":1338,"_21628":55827,"_5":14884,"_28401":55241,"_3085":55828},[],"`ACTIVE`",{"_3634":1563,"_31209":1338,"_21628":55830,"_5":14884,"_28401":55241,"_3085":55831},[],"`Revoked`",{"_3634":1564,"_31209":1338,"_21628":55833,"_5":14884,"_28401":55241,"_3085":55834},[],"`certificateHold`",{"_3634":1565,"_31209":1338,"_21628":55836,"_5":14884,"_28401":55241,"_3085":55837},[],"`INACTIVE`",{"_3634":1566,"_31209":1338,"_21628":55839,"_5":14884,"_28401":55241,"_3085":55831},[],{"_3634":1567,"_31209":1338,"_21628":55841,"_5":14884,"_28401":55241,"_3085":55842},[],"Any other reason",{"_3634":1568,"_31209":1338,"_21628":55844,"_5":14884,"_28401":55241,"_3085":55845},[],"`REVOKED`",{"_3634":1569,"_31209":1338,"_21628":55847,"_5":14884,"_28401":55241,"_3085":55848},[],"Only the `Active` and `Revoked` states produce a call to `iot:UpdateCertificate`. The other lifecycle states of Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) are not synced to AWS IoT Core; the certificate status in AWS remains unchanged until the status in Lamassu becomes `Active` or `Revoked`.",{"_3634":1570,"_31209":1338,"_21628":55850,"_5":14884,"_28401":55245,"_3085":55851},[],"Certificates holding the connector's metadata key sync their status; certificates provisioned via JITP have no metadata key and stay out of this machine:",{"_3634":1571,"_31209":1338,"_21628":55853,"_5":14884,"_28401":55245,"_3085":55626},[],{"_3634":1572,"_31209":1338,"_21628":55855,"_5":14884,"_28401":55245,"_3085":55629},[],{"_3634":1573,"_31209":1338,"_21628":55857,"_5":14884,"_28401":55245,"_3085":55858},[],"`NotSynced` → `Active`",{"_3634":1574,"_31209":1338,"_21628":55860,"_5":14884,"_28401":55245,"_3085":55337},[],{"_3634":1575,"_31209":1338,"_21628":55862,"_5":14884,"_28401":55245,"_3085":55863},[],"`Active` → `Inactive`",{"_3634":1576,"_31209":1338,"_21628":55865,"_5":14884,"_28401":55245,"_3085":55866},[],"`iot:UpdateCertificate` + forced MQTT disconnect",{"_3634":1577,"_31209":1338,"_21628":55868,"_5":14884,"_28401":55245,"_3085":55869},[],"`Active` → `Revoked`",{"_3634":1578,"_31209":1338,"_21628":55871,"_5":14884,"_28401":55245,"_3085":55866},[],{"_3634":1579,"_31209":1338,"_21628":55873,"_5":14884,"_28401":55245,"_3085":55874},[],"`Inactive` / `Revoked` → `Active`",{"_3634":1580,"_31209":1338,"_21628":55876,"_5":14884,"_28401":55245,"_3085":55337},[],{"_3634":1581,"_31209":1338,"_21628":55878,"_5":14884,"_28401":55245,"_3085":55879},[],"`RenewalWindow` / `AboutToExpire` / `Expired`",{"_3634":1582,"_31209":1338,"_21628":55881,"_5":14884,"_28401":55245,"_3085":55882},[],"none (these states are not synced to AWS)",{"_3634":1583,"_31209":1338,"_21628":55884,"_5":14884,"_28401":55249,"_3085":55885},[],"When the connector marks a certificate as `REVOKED` or `INACTIVE` in AWS, it additionally performs a forced disconnect of the device. To do so it opens an MQTT connection over WebSocket (with SigV4 authentication using the connector's credentials) to the AWS IoT Core data endpoint, using the certificate's CN as the MQTT client identifier, and closes it immediately. This terminates any active MQTT session the device may have at that moment.",{"_3634":1584,"_31209":1338,"_21628":55887,"_5":14884,"_28401":55249,"_3085":55888},[],"This forced disconnect happens at the moment Lamassu records the status change. If the device tries to reconnect after the disconnect, AWS IoT Core will reject the connection because the certificate is already listed as `REVOKED` or `INACTIVE`.",{"_3634":1585,"_31209":1338,"_21628":55890,"_5":14884,"_28401":55249,"_3085":55891},[],"Certificates provisioned in JITP mode do not have this automatic sync, since they lack the connector's metadata key.",{"_3634":1586,"_31209":1338,"_21628":55893,"_5":14884,"_28401":55253,"_3085":55894},[],"The connector can write to the AWS IoT Core Device Shadow to send action signals to the device firmware. This feature is enabled per DMS with `shadow_config.enable: true`.",{"_3634":1587,"_31209":1338,"_21628":55896,"_5":14884,"_28401":55253,"_3085":55897},[],"If `shadow_config.shadow_name` holds a value, the connector uses a Named Shadow with that name; otherwise it uses the Classic Shadow (the Thing's default shadow).",{"_3634":1588,"_31209":1338,"_21628":55899,"_5":14884,"_28401":55257,"_3085":55900},[],"The connector writes to the `desired.identity_actions` field of the shadow document. Each entry contains a Unix timestamp in milliseconds. The device firmware must read this field and act accordingly.",{"_3634":1589,"_31209":1338,"_21628":55902,"_5":14884,"_28401":55257,"_3085":55903},[],"There are two action types:",{"_3634":1590,"_31209":1338,"_21628":55905,"_5":14884,"_28401":55257,"_3085":55906},[],"**`UPDATE_CERTIFICATE`**: written when a certificate's preventive renewal window activates — that is, when the `triggered` field of the preventive renewal delta flips from `false` to `true`. This action tells the device it must start the re-enrollment process to renew its certificate before it expires.",{"_3634":1591,"_31209":1338,"_21628":55908,"_5":14884,"_28401":55257,"_3085":55909},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: written to all devices of a DMS when the DMS's `ManagedCAs` list changes. This action tells the device it must update its trusted CA store.",{"_3634":1592,"_31209":1338,"_21628":55911,"_5":14884,"_28401":55257,"_3085":55912},[],"The shadow write process consists of reading the current shadow (`iotdata:GetThingShadow`), merging the new actions with the existing ones and writing the result (`iotdata:UpdateThingShadow`). If the shadow does not exist, the connector creates it. After a successful write, the list of pending actions in the device's metadata in Lamassu is cleared.",{"_3634":1593,"_31209":1338,"_21628":55914,"_5":14884,"_28401":55261,"_3085":55915},[],"The connector creates and attaches the policies configured in the DMS. A typical policy for a device using MQTT and the Device Shadow has this structure:",{"_3634":1594,"_31209":1338,"_21628":55917,"_5":14884,"_28401":55261,"_3085":55918},[],"In the policy above, the `<AWS_REGION>` and `<AWS_ACCOUNT_ID>` placeholders must be replaced with the AWS region and the twelve-digit account identifier of the target account before applying the policy. The `${iot:Connection.Thing.ThingName}` variable automatically limits each permission to the Thing the device is connected as, following the principle of least privilege. The `${ShadowName}` variable in the shadow ARNs is a placeholder that must be replaced with the `shadow_config.shadow_name` value configured in the DMS; if the Classic Shadow is used, it can be simplified by removing the `name/${ShadowName}/` segment. AWS IoT policies do not support regex alternation; the `[name/${ShadowName}/]*` notation represents the optionality of that segment within ARN syntax constraints.",{"_3634":1595,"_31209":1338,"_21628":55920,"_5":14884,"_28401":55261,"_3085":55921},[],"The first statement lets the device connect using its ThingName as the MQTT identifier. The second authorizes publishing to the Thing's generic MQTT topic and to the shadow topics, needed so the device can update its reported state. The last two statements grant subscribe and receive permissions over the same topics, letting the device receive shadow updates (for example, the `UPDATE_CERTIFICATE` and `UPDATE_TRUST_ANCHOR_LIST` actions written by the connector).",{"_3634":1596,"_31209":1338,"_21628":55923,"_5":14884,"_28401":55265,"_3085":55924},[],"**Symptom:** The CA registration stays in `REQUESTED` indefinitely.",{"_3634":1597,"_31209":1338,"_21628":55926,"_5":14884,"_28401":55265,"_3085":55927},[],"**Cause:** The connector is not running or is not subscribed to the event bus. It can also indicate incorrect IAM credentials, insufficient permissions or that the metadata key was written with a wrong `connector_id`.",{"_3634":1598,"_31209":1338,"_21628":55929,"_5":14884,"_28401":55265,"_3085":55930},[],"**Resolution:** Verify the connector process is active and the logs show no AWS communication errors. Check the metadata field was written under the exact key `lamassu.io/iot/{connector_id}`. If the error persists, the connector will update the status to `FAILED` with a descriptive message in the CA metadata.",{"_3634":1599,"_31209":1338,"_21628":55932,"_5":14884,"_28401":55265,"_3085":55933},[],"**Symptom:** A certificate's status is not synced to AWS after a revocation.",{"_3634":1600,"_31209":1338,"_21628":55935,"_5":14884,"_28401":55265,"_3085":55936},[],"**Cause:** Most commonly the certificate was provisioned in JITP mode. JITP certificates lack the connector's metadata key and are outside the state synchronization mechanism. If the DMS is in `auto` mode, it may indicate the initial provisioning did not complete correctly and the AWS ARN was not stored in the certificate metadata.",{"_3634":1601,"_31209":1338,"_21628":55938,"_5":14884,"_28401":55265,"_3085":55939},[],"**Resolution:** For JITP certificates, migrate the DMS to `auto` mode and re-provision the affected devices. For `auto` mode certificates, verify the certificate has the AWS ARN stored in its metadata; if not, repeat the provisioning.",{"_3634":1602,"_31209":1338,"_21628":55941,"_5":14884,"_28401":55265,"_3085":55942},[],"**Symptom:** The forced disconnect does not terminate the device's MQTT session after revocation.",{"_3634":1603,"_31209":1338,"_21628":55944,"_5":14884,"_28401":55265,"_3085":55945},[],"**Cause:** The device uses an MQTT client ID different from the certificate's CN. The forced disconnect opens a connection using the CN as client ID; if the firmware uses another identifier, the disconnect does not affect that session.",{"_3634":1604,"_31209":1338,"_21628":55947,"_5":14884,"_28401":55265,"_3085":55948},[],"**Resolution:** Make sure the firmware uses exactly the certificate's CN as the MQTT client identifier. That CN matches the ThingName in AWS IoT Core.",{"_3634":1605,"_31209":1338,"_21628":55950,"_5":14884,"_28401":55265,"_3085":55951},[],"**Symptom:** The device receives `CLIENT_ID_REJECTED` when connecting to AWS IoT Core.",{"_3634":1606,"_31209":1338,"_21628":55953,"_5":14884,"_28401":55265,"_3085":55954},[],"**Cause:** The MQTT client ID does not match the ThingName, which is always the CN of the certificate issued by Lamassu.",{"_3634":1607,"_31209":1338,"_21628":55956,"_5":14884,"_28401":55265,"_3085":55957},[],"**Resolution:** Verify the firmware uses exactly the value of the CN field included in the enrollment CSR as the MQTT client identifier.",{"_3634":1608,"_31209":1338,"_21628":55959,"_5":14884,"_28401":55265,"_3085":55960},[],"**Symptom:** The device's first MQTT connection in JITP mode fails or times out.",{"_3634":1609,"_31209":1338,"_21628":55962,"_5":14884,"_28401":55265,"_3085":55963},[],"**Cause:** This is expected behavior while AWS executes the JITP template on the device's first connection.",{"_3634":1610,"_31209":1338,"_21628":55965,"_5":14884,"_28401":55265,"_3085":55966},[],"**Resolution:** Firmware must implement retries with exponential backoff for the first connection. If the failure persists beyond a few minutes, verify the IAM role configured in `jitp_config.provisioning_role_arn` exists in the account and has permissions to create Things, register certificates and attach policies.",{"_3634":1611,"_31209":1338,"_21628":55968,"_5":14884,"_28401":55265,"_3085":55969},[],"**Symptom:** The Device Shadow is not updated when it should be.",{"_3634":1612,"_31209":1338,"_21628":55971,"_5":14884,"_28401":55265,"_3085":55972},[],"**Cause:** The shadow feature is disabled in the DMS configuration, the connector's credentials lack IoT data-plane permissions, or the firmware reads a different shadow than the configured one.",{"_3634":1613,"_31209":1338,"_21628":55974,"_5":14884,"_28401":55265,"_3085":55975},[],"**Resolution:** Check that `shadow_config.enable` is `true` in the connector metadata for the corresponding DMS. If a Named Shadow is used, verify `shadow_config.shadow_name` holds the correct name and that the firmware reads that Named Shadow and not the Classic Shadow. Confirm the connector's credentials have `iotdata:GetThingShadow` and `iotdata:UpdateThingShadow` permissions.",{"_3634":1614,"_31209":1338,"_21628":55977,"_5":14884,"_28401":55265,"_3085":55978},[],"**Symptom:** After editing a DMS in `jitp` mode, DMS update messages appear in `lamassu-dlq`, or JITP configuration changes have no effect in AWS.",{"_3634":1615,"_31209":1338,"_21628":55980,"_5":14884,"_28401":55265,"_3085":55981},[],"**Cause:** Every full DMS edit (`PUT /v1/dms/{id}`) triggers a `CreateProvisioningTemplate` attempt for the template named after the DMS ID, and the call is not idempotent: when the template already exists, it fails, the event is retried three times and finally lands in `lamassu-dlq`. The connector’s later steps are skipped.",{"_3634":1616,"_31209":1338,"_21628":55983,"_5":14884,"_28401":55265,"_3085":55984},[],"**Resolution:** Check that the template named with the DMS ID exists in AWS IoT Core and that JITP enrollment works. If the JITP configuration was changed, apply it by hand to the AWS template.",{"_3634":1617,"_31209":1338,"_21628":55986,"_5":14884,"_28401":55265,"_3085":55987},[],"<Card title=\"Configure a DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":1618,"_31209":1338,"_21628":55989,"_5":14884,"_28401":55265,"_3085":55990},[],"<Card title=\"Device enrollment (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3634":1619,"_31209":1338,"_21628":55992,"_5":14884,"_28401":55265,"_3085":55993},[],"<Card title=\"Certificate management\" href=\"/docs/platform/pki/certificates\" />",{"_3634":1620,"_31209":1620,"_5":15244,"_3085":53683,"_31547":55995,"_21628":55996,"_28401":1620},[50999,52511,53683],[],{"_3634":1621,"_31209":1620,"_21628":55998,"_5":14884,"_28401":1620,"_3085":55999},[],"Organize devices and their identities, prepare enrollment and integrate consumers.",{"_3634":1622,"_31209":1620,"_5":31544,"_21628":56001,"_28401":56002,"_3085":56003},[],"/docs/platform/iot-fleets/overview#start-here","Start here",{"_3634":1623,"_31209":1620,"_5":31544,"_21628":56005,"_28401":56006,"_3085":53681},[],"/docs/platform/iot-fleets/overview#devices-and-identities",{"_3634":1624,"_31209":1620,"_5":31544,"_21628":56008,"_28401":56009,"_3085":53867},[],"/docs/platform/iot-fleets/overview#enrollment-with-pki",{"_3634":1625,"_31209":1620,"_5":31544,"_21628":56011,"_28401":56012,"_3085":55162},[],"/docs/platform/iot-fleets/overview#integrations",{"_3634":1626,"_31209":1620,"_5":31544,"_21628":56014,"_28401":56015,"_3085":56016},[],"/docs/platform/iot-fleets/overview#who-prepares-each-part","Who prepares each part",{"_3634":1627,"_31209":1620,"_21628":56018,"_5":14884,"_28401":1620,"_3085":56019},[],"IoT Fleets applies PKI to the device lifecycle: registration, obtaining an identity, renewal and retirement. It is intended for those who administer a device population and those who integrate its enrollment client or the system that accepts it.",{"_3634":1628,"_31209":1620,"_21628":56021,"_5":14884,"_28401":56002,"_3085":56022},[],"Follow Enroll and connect your first device to prepare a DMS, obtain the identity from the client and demonstrate an mTLS connection. The automatic path includes initial trust, a CSR and result checks.",{"_3634":1629,"_31209":1620,"_21628":56024,"_5":14884,"_28401":56002,"_3085":56025},[],"To start with an existing certificate, use Register a device manually. You can then prepare enrollment and renewal for the next device.",{"_3634":1630,"_31209":1620,"_21628":56027,"_5":14884,"_28401":56006,"_3085":56028},[],"Resource",{"_3634":1631,"_31209":1620,"_21628":56030,"_5":14884,"_28401":56006,"_3085":56031},[],"What it represents",{"_3634":1632,"_31209":1620,"_21628":56033,"_5":14884,"_28401":56006,"_3085":56034},[],"**Device**",{"_3634":1633,"_31209":1620,"_21628":56036,"_5":14884,"_28401":56006,"_3085":56037},[],"An inventory entry with an identifier, owning DMS and classification.",{"_3634":1634,"_31209":1620,"_21628":56039,"_5":14884,"_28401":56006,"_3085":56040},[],"**Identity**",{"_3634":1635,"_31209":1620,"_21628":56042,"_5":14884,"_28401":56006,"_3085":56043},[],"The device's association with its certificates: an active version and a history.",{"_3634":1636,"_31209":1620,"_21628":56045,"_5":14884,"_28401":56006,"_3085":56046},[],"**DMS**",{"_3634":1637,"_31209":1620,"_21628":56048,"_5":14884,"_28401":56006,"_3085":56049},[],"The service that configures admission, enrollment, renewal and trust distribution.",{"_3634":1638,"_31209":1620,"_21628":56051,"_5":14884,"_28401":56006,"_3085":56052},[],"**Fleet**",{"_3634":1639,"_31209":1620,"_21628":56054,"_5":14884,"_28401":56006,"_3085":56055},[],"The population you operate, represented through devices, DMSs, tags and metadata.",{"_3634":1640,"_31209":1620,"_21628":56057,"_5":14884,"_28401":56006,"_3085":56058},[],"Each device has an owning DMS. You can organize a population through several DMSs when it needs different policies, and use tags to classify it. “Fleet” describes that operational context; the resources you create and query are DMSs and devices.",{"_3634":1641,"_31209":1620,"_21628":56060,"_5":14884,"_28401":56006,"_3085":56061},[],"Device management covers states, certificate history and identity actions. During renewal, retain the relationship with the device and check which certificate becomes the current identity.",{"_3634":1642,"_31209":1620,"_21628":56063,"_5":14884,"_28401":56009,"_3085":56064},[],"This section connects PKI rules to the device client. Preparation follows this order:",{"_3634":1643,"_31209":1620,"_21628":56066,"_5":14884,"_28401":56009,"_3085":56067},[],"**CA and profile:** prepare the issuer and certificate rules in PKI.",{"_3634":1644,"_31209":1620,"_21628":56069,"_5":14884,"_28401":56009,"_3085":56070},[],"**DMS policy:** define how the device is admitted, how requests authenticate and which trust is distributed.",{"_3634":1645,"_31209":1620,"_21628":56072,"_5":14884,"_28401":56009,"_3085":56073},[],"**Client:** prepare the initial credential, server trust, and key generation or custody.",{"_3634":1646,"_31209":1620,"_21628":56075,"_5":14884,"_28401":56009,"_3085":56076},[],"**Result:** request the certificate, install it and check its association with the device.",{"_3634":1647,"_31209":1620,"_21628":56078,"_5":14884,"_28401":56009,"_3085":56079},[],"**Continuity:** configure renewal, successor installation and recovery according to DMS policy.",{"_3634":1648,"_31209":1620,"_21628":56081,"_5":14884,"_28401":56009,"_3085":56082},[],"<Card title=\"Configure the DMS\" description=\"Prepare the CA, admission, authentication and renewal rules.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3634":1649,"_31209":1620,"_21628":56084,"_5":14884,"_28401":56009,"_3085":56085},[],"<Card title=\"Integrate the EST client\" description=\"Review the device endpoints, formats and checks.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3634":1650,"_31209":1620,"_21628":56087,"_5":14884,"_28401":56012,"_3085":56088},[],"An issued identity needs a consumer that trusts its issuer, validates the certificate and grants the device permissions. Prepare both the device's trust in the server and the server's trust in the device.",{"_3634":1651,"_31209":1620,"_21628":56090,"_5":14884,"_28401":56012,"_3085":56091},[],"The AWS IoT Core guide explains how to use the identity in that destination. Provisioning in Lamassu and provisioning in the destination are separate decisions; review the conditions of the chosen mode before expecting state synchronization.",{"_3634":1652,"_31209":1620,"_21628":56093,"_5":14884,"_28401":56015,"_3085":56094},[],"Participant",{"_3634":1653,"_31209":1620,"_21628":56096,"_5":14884,"_28401":56015,"_3085":56097},[],"Responsibility",{"_3634":1654,"_31209":1620,"_21628":56099,"_5":14884,"_28401":56015,"_3085":56100},[],"PKI administrator",{"_3634":1655,"_31209":1620,"_21628":56102,"_5":14884,"_28401":56015,"_3085":56103},[],"CA, issuance profile, chain and revocation publication.",{"_3634":1656,"_31209":1620,"_21628":56105,"_5":14884,"_28401":56015,"_3085":56106},[],"Provisioning administrator",{"_3634":1657,"_31209":1620,"_21628":56108,"_5":14884,"_28401":56015,"_3085":56109},[],"DMS, admission, authentication per operation and inventory.",{"_3634":1658,"_31209":1620,"_21628":56111,"_5":14884,"_28401":56015,"_3085":56112},[],"Device integrator",{"_3634":1659,"_31209":1620,"_21628":56114,"_5":14884,"_28401":56015,"_3085":56115},[],"Initial credential, key, EST client, trust and certificate installation.",{"_3634":1660,"_31209":1620,"_21628":56117,"_5":14884,"_28401":56015,"_3085":56118},[],"Consumer integrator",{"_3634":1661,"_31209":1620,"_21628":56120,"_5":14884,"_28401":56015,"_3085":56121},[],"Trusted issuers, validation and device permissions in the destination.",{"_3634":1662,"_31209":1620,"_21628":56123,"_5":14884,"_28401":56015,"_3085":56124},[],"Permissions and audit are shared with the rest of Platform. Prepare installation and instance connectivity in Deployment.",{"_3634":1663,"_31209":1663,"_5":15244,"_3085":56126,"_31547":56127,"_21628":56129,"_28401":1663},"Enroll and connect your first device",[50999,52511,53683,56128],"Getting started",[],{"_3634":1664,"_31209":1663,"_21628":56131,"_5":14884,"_28401":1663,"_3085":56132},[],"Obtain an identity through EST, verify its association and use it in an mTLS connection.",{"_3634":1665,"_31209":1663,"_5":31544,"_21628":56134,"_28401":56135,"_3085":51009},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#before-you-begin",{"_3634":1666,"_31209":1663,"_5":31544,"_21628":56137,"_28401":56138,"_3085":56139},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-bootstrap-credential","Prepare the bootstrap credential",{"_3634":1667,"_31209":1663,"_5":31544,"_21628":56141,"_28401":56142,"_3085":56143},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#configure-the-evaluation-dms","Configure the evaluation DMS",{"_3634":1668,"_31209":1663,"_5":31544,"_21628":56145,"_28401":56146,"_3085":56147},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#prepare-the-client-and-check-cacerts","Prepare the client and check cacerts",{"_3634":1669,"_31209":1663,"_5":31544,"_21628":56149,"_28401":56150,"_3085":56151},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#enroll-the-device","Enroll the device",{"_3634":1670,"_31209":1663,"_5":31544,"_21628":56153,"_28401":56154,"_3085":56155},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#verify-the-obtained-identity","Verify the obtained identity",{"_3634":1671,"_31209":1663,"_5":31544,"_21628":56157,"_28401":56158,"_3085":56159},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#demonstrate-an-mtls-connection","Demonstrate an mTLS connection",{"_3634":1672,"_31209":1663,"_5":31544,"_21628":56161,"_28401":56162,"_3085":56163},[],"/docs/platform/iot-fleets/quickstarts/enroll-device#result-and-continuity","Result and continuity",{"_3634":1673,"_31209":1663,"_21628":56165,"_5":14884,"_28401":1663,"_3085":56166},[],"Prepare an evaluation DMS, enroll `est-device-001` from the client and use its identity with a local consumer that requires a certificate. The path connects administrator policy to the material the device actually installs.",{"_3634":1674,"_31209":1663,"_21628":56168,"_5":14884,"_28401":56135,"_3085":56169},[],"A Lamassu instance accessible through HTTPS and permissions for CAs, profiles, DMSs and reading devices/certificates.",{"_3634":1675,"_31209":1663,"_21628":56171,"_5":14884,"_28401":56135,"_3085":56172},[],"Bash, OpenSSL 3.x, curl with `--fail-with-body` and two terminals on your computer. Work in a new directory with restricted access.",{"_3634":1676,"_31209":1663,"_21628":56174,"_5":14884,"_28401":56135,"_3085":56175},[],"An active root CA that issues directly, with an available key and sufficient validity. Follow Create your first CA. Save its verified public certificate as `device-root.pem`.",{"_3634":1677,"_31209":1663,"_21628":56177,"_5":14884,"_28401":56135,"_3085":56178},[],"Available global identifier `est-device-001`. This path uses automatic registration: do not create the device in the console first.",{"_3634":1678,"_31209":1663,"_21628":56180,"_5":14884,"_28401":56135,"_3085":56181},[],"The approved root for Lamassu HTTPS in `est-trust.pem`, obtained through an independent channel. It can differ from the device CA; prepare networking/TLS in Deployment.",{"_3634":1679,"_31209":1663,"_21628":56183,"_5":14884,"_28401":56138,"_3085":56184},[],"Issue a bootstrap leaf certificate with `CN=est-device-001`, its own key and Client Authentication use. Follow Issue and verify a certificate, changing its CN and saving the result as `bootstrap.crt` and `bootstrap.key`. Choose validity that covers this test and check the pair and chain.",{"_3634":1680,"_31209":1663,"_21628":56186,"_5":14884,"_28401":56138,"_3085":56187},[],"The same root CA can issue it for this isolated evaluation. The operational identity will have a different key and certificate. The matching CN makes the example easier to read; initial certificate authentication does not itself bind the bootstrap CN to the requested ID. Review admission before applying the policy to a population.",{"_3634":1681,"_31209":1663,"_21628":56189,"_5":14884,"_28401":56142,"_3085":56190},[],"Create an explicit leaf profile compatible with EC P-256, with **Honor Subject**, CN from the CSR, **Digital Signature**, **Client Authentication** and **1 hour** validity within the root's validity. Do not enable CA signing. Rules and precedence are explained in Profiles.",{"_3634":1682,"_31209":1663,"_21628":56192,"_5":14884,"_28401":56142,"_3085":56193},[],"Create the `Acme EST Evaluation` DMS with this configuration:",{"_3634":1683,"_31209":1663,"_21628":56195,"_5":14884,"_28401":56142,"_3085":56196},[],"Setting",{"_3634":1684,"_31209":1663,"_21628":56198,"_5":14884,"_28401":56142,"_3085":56199},[],"Evaluation value",{"_3634":1685,"_31209":1663,"_21628":56201,"_5":14884,"_28401":56142,"_3085":56202},[],"Enrollment CA",{"_3634":1686,"_31209":1663,"_21628":56204,"_5":14884,"_28401":56142,"_3085":56205},[],"Issuing root from `device-root.pem`.",{"_3634":1687,"_31209":1663,"_21628":56207,"_5":14884,"_28401":56142,"_3085":54003},[],{"_3634":1688,"_31209":1663,"_21628":56209,"_5":14884,"_28401":56142,"_3085":56210},[],"The 1-hour leaf profile you just prepared.",{"_3634":1689,"_31209":1663,"_21628":56212,"_5":14884,"_28401":56142,"_3085":56213},[],"Protocol / Registration Mode",{"_3634":1690,"_31209":1663,"_21628":56215,"_5":14884,"_28401":56142,"_3085":56216},[],"`EST_RFC7030` / `JITP`.",{"_3634":1691,"_31209":1663,"_21628":56218,"_5":14884,"_28401":56142,"_3085":56219},[],"Verify CSR Signature",{"_3634":1692,"_31209":1663,"_21628":56221,"_5":14884,"_28401":56142,"_3085":56222},[],"Enabled.",{"_3634":1693,"_31209":1663,"_21628":56224,"_5":14884,"_28401":56142,"_3085":56225},[],"Enable Replaceable Enrollment",{"_3634":1694,"_31209":1663,"_21628":56227,"_5":14884,"_28401":56142,"_3085":56228},[],"Disabled; the ID must be new.",{"_3634":1695,"_31209":1663,"_21628":56230,"_5":14884,"_28401":56142,"_3085":56231},[],"Initial authentication",{"_3634":1696,"_31209":1663,"_21628":56233,"_5":14884,"_28401":56142,"_3085":56234},[],"`CLIENT_CERTIFICATE`; Validation CAs includes the direct bootstrap issuer; no expired certificates.",{"_3634":1697,"_31209":1663,"_21628":56236,"_5":14884,"_28401":56142,"_3085":56237},[],"Renewal authentication",{"_3634":1698,"_31209":1663,"_21628":56239,"_5":14884,"_28401":56142,"_3085":56240},[],"`CLIENT_CERTIFICATE`, configured in the independent re-enrollment block.",{"_3634":1699,"_31209":1663,"_21628":56242,"_5":14884,"_28401":56142,"_3085":56243},[],"Re-enrollment Validation CAs / Enable Expired Renewal",{"_3634":1700,"_31209":1663,"_21628":56245,"_5":14884,"_28401":56142,"_3085":56246},[],"Not needed for this direct issuance; the Enrollment CA is always trusted for re-enrollment / disabled.",{"_3634":1701,"_31209":1663,"_21628":56248,"_5":14884,"_28401":56142,"_3085":56249},[],"Re-enrollment Delta",{"_3634":1702,"_31209":1663,"_21628":56251,"_5":14884,"_28401":56142,"_3085":56252},[],"1 hour.",{"_3634":1703,"_31209":1663,"_21628":56254,"_5":14884,"_28401":56142,"_3085":56255},[],"Preventive / Critical Delta",{"_3634":1704,"_31209":1663,"_21628":56257,"_5":14884,"_28401":56142,"_3085":56258},[],"30 minutes / 10 minutes.",{"_3634":1705,"_31209":1663,"_21628":56260,"_5":14884,"_28401":56142,"_3085":56261},[],"Revoke on Re-enrollment",{"_3634":1706,"_31209":1663,"_21628":56263,"_5":14884,"_28401":56142,"_3085":56264},[],"Disabled to test the successor before retiring the previous identity.",{"_3634":1707,"_31209":1663,"_21628":56266,"_5":14884,"_28401":56142,"_3085":54011},[],{"_3634":1708,"_31209":1663,"_21628":56268,"_5":14884,"_28401":56142,"_3085":56269},[],"Disabled; the operational key is generated in the client.",{"_3634":1709,"_31209":1663,"_21628":56271,"_5":14884,"_28401":56142,"_3085":56272},[],"CA Distribution",{"_3634":1710,"_31209":1663,"_21628":56274,"_5":14884,"_28401":56142,"_3085":56275},[],"Include Enrollment CA enabled; Include Lamassu System CA disabled.",{"_3634":1711,"_31209":1663,"_21628":56277,"_5":14884,"_28401":56142,"_3085":56278},[],"Equal duration and window allow immediate renewal testing. These are evaluation values; size production settings according to connectivity and recovery times. Save, reread both authentication blocks and retain the DMS ID. The console exposes independent editors for the enrollment and re-enrollment authentication; the DMS guide describes their fields, and you can also check the resource through the DMS API.",{"_3634":1712,"_31209":1663,"_21628":56280,"_5":14884,"_28401":56146,"_3085":56281},[],"Place the four trust and bootstrap files in the new directory. Replace the URL with your installation's URL:",{"_3634":1713,"_31209":1663,"_21628":56283,"_5":14884,"_28401":56146,"_3085":56284},[],"The download must succeed and contain the expected enrollment root. Compare its fingerprint with `device-root.pem`. This check does not turn the response into initial trust or prove that you can issue.",{"_3634":1714,"_31209":1663,"_21628":56286,"_5":14884,"_28401":56150,"_3085":56287},[],"Generate a new key and CSR with the selected identifier:",{"_3634":1715,"_31209":1663,"_21628":56289,"_5":14884,"_28401":56150,"_3085":56290},[],"Request the identity with the bootstrap credential and extract the certificate from the default response:",{"_3634":1716,"_31209":1663,"_21628":56292,"_5":14884,"_28401":56150,"_3085":56293},[],"If curl fails, use Troubleshooting with the saved body. Do not convert it or repeat the request without querying inventory: a timeout or error can follow persisted issuance.",{"_3634":1717,"_31209":1663,"_21628":56295,"_5":14884,"_28401":56154,"_3085":56296},[],"Expect `device.crt: OK` and exit code 0 from `cmp`. Check the CN, serial, dates, Digital Signature and Client Authentication. The certificate must be a leaf: it must not declare `CA:TRUE` or Certificate Sign use. Check that its validity matches the one-hour profile.",{"_3634":1718,"_31209":1663,"_21628":56298,"_5":14884,"_28401":56154,"_3085":56299},[],"In Lamassu, open `est-device-001`. It must be created with the intended owning DMS, a current identity and the received certificate in its history. Compare the local serial with the slot; thresholds can show a renewal state rather than simply Active.",{"_3634":1719,"_31209":1663,"_21628":56301,"_5":14884,"_28401":56158,"_3085":56302},[],"In a second terminal, enter the same directory and run `umask 077`. Create a local server certificate and start a test consumer. This server trusts `device-root.pem` and requires a valid client identity:",{"_3634":1720,"_31209":1663,"_21628":56304,"_5":14884,"_28401":56158,"_3085":56305},[],"Leave it running. In the first terminal, connect using the obtained identity:",{"_3634":1721,"_31209":1663,"_21628":56307,"_5":14884,"_28401":56158,"_3085":56308},[],"Expect HTTP `200`. The client's trust in this local server is its self-signed `consumer.crt`; the server verifies the device against `device-root.pem`. The HTML file displays OpenSSL diagnostic information.",{"_3634":1722,"_31209":1663,"_21628":56310,"_5":14884,"_28401":56158,"_3085":56311},[],"With the same server still running, test that a request without a client certificate is rejected:",{"_3634":1723,"_31209":1663,"_21628":56313,"_5":14884,"_28401":56158,"_3085":56314},[],"Rejection must correspond to a missing certificate at the server, not a stopped server. Stop the consumer with Ctrl+C after the test. This exercise demonstrates TLS authentication and key possession; your application must also define authorization and revocation consumption. Server options are described in openssl-s\\_server.",{"_3634":1724,"_31209":1663,"_21628":56316,"_5":14884,"_28401":56162,"_3085":56317},[],"Check",{"_3634":1725,"_31209":1663,"_21628":56319,"_5":14884,"_28401":56162,"_3085":56320},[],"Expected result",{"_3634":1726,"_31209":1663,"_21628":56322,"_5":14884,"_28401":56162,"_3085":56323},[],"Registration",{"_3634":1727,"_31209":1663,"_21628":56325,"_5":14884,"_28401":56162,"_3085":56326},[],"ID created automatically and correct DMS.",{"_3634":1728,"_31209":1663,"_21628":56328,"_5":14884,"_28401":56162,"_3085":55584},[],{"_3634":1729,"_31209":1663,"_21628":56330,"_5":14884,"_28401":56162,"_3085":56331},[],"CN, profile, serial and key verified.",{"_3634":1730,"_31209":1663,"_21628":56333,"_5":14884,"_28401":56162,"_3085":56334},[],"Inventory",{"_3634":1731,"_31209":1663,"_21628":56336,"_5":14884,"_28401":56162,"_3085":56337},[],"Received serial visible as the current identity and in history.",{"_3634":1732,"_31209":1663,"_21628":56339,"_5":14884,"_28401":56162,"_3085":56340},[],"Consumer",{"_3634":1733,"_31209":1663,"_21628":56342,"_5":14884,"_28401":56162,"_3085":56343},[],"mTLS responds 200 with the identity and rejects a missing certificate.",{"_3634":1734,"_31209":1663,"_21628":56345,"_5":14884,"_28401":56162,"_3085":56346},[],"Continue with Renewal and recovery to request a successor pair within the window, install it and repeat the mTLS check. The consumer must use the new files in that test. After checking the successor, retire the previous certificate according to PKI policy; the example does not revoke it automatically.",{"_3634":1735,"_31209":1663,"_21628":56348,"_5":14884,"_28401":56162,"_3085":56349},[],"Devices and identities explains retirement and the limits of historical revocation. For a real destination, prepare consumer trust, validation and permissions; AWS IoT Core is an available integration.",{"_3634":1736,"_31209":1736,"_5":15244,"_3085":53699,"_31547":56351,"_21628":56352,"_28401":1736},[50999,52511,53683,56128],[],{"_3634":1737,"_31209":1736,"_21628":56354,"_5":14884,"_28401":1736,"_3085":56355},[],"Prepare a DMS, register a device and associate a verified certificate with its identity.",{"_3634":1738,"_31209":1736,"_5":31544,"_21628":56357,"_28401":56358,"_3085":51009},[],"/docs/platform/iot-fleets/quickstarts/register-device#before-you-begin",{"_3634":1739,"_31209":1736,"_5":31544,"_21628":56360,"_28401":56361,"_3085":56362},[],"/docs/platform/iot-fleets/quickstarts/register-device#prepare-the-dms","Prepare the DMS",{"_3634":1740,"_31209":1736,"_5":31544,"_21628":56364,"_28401":56365,"_3085":56366},[],"/docs/platform/iot-fleets/quickstarts/register-device#register-the-device","Register the device",{"_3634":1741,"_31209":1736,"_5":31544,"_21628":56368,"_28401":56369,"_3085":56370},[],"/docs/platform/iot-fleets/quickstarts/register-device#check-the-initial-status","Check the initial status",{"_3634":1742,"_31209":1736,"_5":31544,"_21628":56372,"_28401":56373,"_3085":56374},[],"/docs/platform/iot-fleets/quickstarts/register-device#assign-an-identity","Assign an identity",{"_3634":1743,"_31209":1736,"_5":31544,"_21628":56376,"_28401":56377,"_3085":56378},[],"/docs/platform/iot-fleets/quickstarts/register-device#verify-the-device","Verify the device",{"_3634":1744,"_31209":1736,"_5":31544,"_21628":56380,"_28401":56381,"_3085":56320},[],"/docs/platform/iot-fleets/quickstarts/register-device#expected-result",{"_3634":1745,"_31209":1736,"_5":31544,"_21628":56383,"_28401":56384,"_3085":56385},[],"/docs/platform/iot-fleets/quickstarts/register-device#if-the-result-fails","If the result fails",{"_3634":1746,"_31209":1736,"_5":31544,"_21628":56387,"_28401":56388,"_3085":56389},[],"/docs/platform/iot-fleets/quickstarts/register-device#automate-the-next-device","Automate the next device",{"_3634":1747,"_31209":1736,"_21628":56391,"_5":14884,"_28401":1736,"_3085":56392},[],"This path is intended for those starting to administer device identities. You will register `device-001` and assign an existing certificate to check the relationship between device, DMS and identity history.",{"_3634":1748,"_31209":1736,"_21628":56394,"_5":14884,"_28401":1736,"_3085":56395},[],"Assignment updates Lamassu's inventory. Install the key and certificate separately on the device; check the connection to a consumer in that destination's integration.",{"_3634":1749,"_31209":1736,"_21628":56397,"_5":14884,"_28401":56358,"_3085":56398},[],"An accessible instance and permission to administer DMSs, devices and certificate associations.",{"_3634":1750,"_31209":1736,"_21628":56400,"_5":14884,"_28401":56358,"_3085":56401},[],"An active CA with an available key. If one does not exist yet, follow Create your first CA.",{"_3634":1751,"_31209":1736,"_21628":56403,"_5":14884,"_28401":56358,"_3085":56404},[],"An active end-entity certificate from that CA whose `Common Name` is exactly `device-001`, together with its private key. Follow Issue and verify a certificate to obtain and check both.",{"_3634":1752,"_31209":1736,"_21628":56406,"_5":14884,"_28401":56358,"_3085":56407},[],"The identifier `device-001` available in the inventory. If you already used it, choose another and issue the certificate with that same `Common Name`.",{"_3634":1753,"_31209":1736,"_21628":56409,"_5":14884,"_28401":56361,"_3085":56410},[],"A DMS must exist before registering the device. If you already have a suitable one, check its CA and note its identifier; to create one:",{"_3634":1754,"_31209":1736,"_21628":56412,"_5":14884,"_28401":56361,"_3085":56413},[],"Open the DMS inventory and its creation action. Assign a recognizable name, such as `Acme Evaluation DMS`.",{"_3634":1755,"_31209":1736,"_21628":56415,"_5":14884,"_28401":56361,"_3085":56416},[],"In **Enrollment CA**, select the CA that issued `device.crt`.",{"_3634":1756,"_31209":1736,"_21628":56418,"_5":14884,"_28401":56361,"_3085":56419},[],"In **Registration Mode**, select `PRE_REGISTRATION` for the path that starts with explicit registration.",{"_3634":1757,"_31209":1736,"_21628":56421,"_5":14884,"_28401":56361,"_3085":56422},[],"In the authentication section, enable **Require client certificate** and leave **Call external webhook** off. Under **Require client certificate**, add the CA whose initial certificates you will accept to **Validation CAs**; for this evaluation, it can be the same CA. Keep **Verify CSR Signature** enabled and leave **Enable server-side key generation** off if you will not use it.",{"_3634":1758,"_31209":1736,"_21628":56424,"_5":14884,"_28401":56361,"_3085":56425},[],"Review renewal and trust distribution settings with the DMS guide, save the service and note its identifier.",{"_3634":1759,"_31209":1736,"_21628":56427,"_5":14884,"_28401":56361,"_3085":56428},[],"Reopen the DMS and confirm that the enrollment CA is the expected one and the service appears in inventory.",{"_3634":1760,"_31209":1736,"_21628":56430,"_5":14884,"_28401":56361,"_3085":56431},[],"These settings prepare DMS policy. The next steps register and assign through the console; they do not send an EST request or test admission through that protocol.",{"_3634":1761,"_31209":1736,"_21628":56433,"_5":14884,"_28401":56365,"_3085":56434},[],"Open **Managed Devices** and the registration action. Complete:",{"_3634":1762,"_31209":1736,"_21628":56436,"_5":14884,"_28401":56365,"_3085":56437},[],"**Device ID**: `device-001`.",{"_3634":1763,"_31209":1736,"_21628":56439,"_5":14884,"_28401":56365,"_3085":56440},[],"**Registration Authority**: the DMS you just prepared; this label identifies the service fulfilling the registration authority role.",{"_3634":1764,"_31209":1736,"_21628":56442,"_5":14884,"_28401":56365,"_3085":56443},[],"**Icon** and **Tags**: optional classification.",{"_3634":1765,"_31209":1736,"_21628":56445,"_5":14884,"_28401":56365,"_3085":56446},[],"Confirm registration.",{"_3634":1766,"_31209":1736,"_21628":56448,"_5":14884,"_28401":56369,"_3085":56449},[],"Open the device. It should appear in **No Identity** and show the selected owning DMS.",{"_3634":1767,"_31209":1736,"_21628":56451,"_5":14884,"_28401":56369,"_3085":56452},[],"Registration creates the inventory entry; the certificate must still be associated.",{"_3634":1768,"_31209":1736,"_21628":56454,"_5":14884,"_28401":56373,"_3085":56455},[],"Select **Assign Identity** and the existing certificate with `CN=device-001`. Check its serial number, issuer and validity against the certificate you verified in PKI.",{"_3634":1769,"_31209":1736,"_21628":56457,"_5":14884,"_28401":56373,"_3085":56458},[],"Confirm the association. The **Issue New Instead** alternative is explained in Devices and identities.",{"_3634":1770,"_31209":1736,"_21628":56460,"_5":14884,"_28401":56377,"_3085":56461},[],"Check that it has an active identity. In **Certificate History**, verify the associated serial number; in **Device Event Timeline**, find the assignment event.",{"_3634":1771,"_31209":1736,"_21628":56463,"_5":14884,"_28401":56377,"_3085":56464},[],"Keep the device identifier, owning DMS and serial number as references for the result.",{"_3634":1772,"_31209":1736,"_21628":56466,"_5":14884,"_28401":56381,"_3085":56317},[],{"_3634":1773,"_31209":1736,"_21628":56468,"_5":14884,"_28401":56381,"_3085":56469},[],"Result",{"_3634":1774,"_31209":1736,"_21628":56471,"_5":14884,"_28401":56381,"_3085":55567},[],{"_3634":1775,"_31209":1736,"_21628":56473,"_5":14884,"_28401":56381,"_3085":56474},[],"`device-001` appears in inventory with the expected DMS.",{"_3634":1776,"_31209":1736,"_21628":56476,"_5":14884,"_28401":56381,"_3085":56477},[],"Current identity",{"_3634":1777,"_31209":1736,"_21628":56479,"_5":14884,"_28401":56381,"_3085":56480},[],"The associated certificate matches the one you verified in PKI.",{"_3634":1778,"_31209":1736,"_21628":56482,"_5":14884,"_28401":56381,"_3085":56483},[],"History",{"_3634":1779,"_31209":1736,"_21628":56485,"_5":14884,"_28401":56381,"_3085":56486},[],"The associated issuance appears with its serial number and dates.",{"_3634":1780,"_31209":1736,"_21628":56488,"_5":14884,"_28401":56381,"_3085":56489},[],"Key and certificate",{"_3634":1781,"_31209":1736,"_21628":56491,"_5":14884,"_28401":56381,"_3085":56492},[],"You have the verified pair ready to install on the device.",{"_3634":1782,"_31209":1736,"_21628":56494,"_5":14884,"_28401":56384,"_3085":56495},[],"If you cannot select the DMS, confirm its creation and your read permissions.",{"_3634":1783,"_31209":1736,"_21628":56497,"_5":14884,"_28401":56384,"_3085":56498},[],"If no eligible certificate appears, check that its `Common Name` matches the `Device ID` exactly, it is active and it was issued by the expected CA.",{"_3634":1784,"_31209":1736,"_21628":56500,"_5":14884,"_28401":56384,"_3085":56501},[],"If assignment fails, review permissions and operation diagnostics before repeating it. Query the device and its history again to find the persisted result.",{"_3634":1785,"_31209":1736,"_21628":56503,"_5":14884,"_28401":56384,"_3085":56504},[],"If an expiration or renewal state appears, check certificate dates and DMS thresholds in Devices and identities.",{"_3634":1786,"_31209":1736,"_21628":56506,"_5":14884,"_28401":56388,"_3085":56507},[],"Continue with DMS and EST for the device to request and renew certificates. Prepare server trust, the initial credential and policies for each operation before implementing the client.",{"_3634":1787,"_31209":1736,"_21628":56509,"_5":14884,"_28401":56388,"_3085":56510},[],"For a path from the client through mTLS, follow Enroll and connect your first device with a new ID.",{"_3634":1788,"_31209":1736,"_21628":56512,"_5":14884,"_28401":56388,"_3085":56513},[],"To use the identity in AWS IoT Core, also prepare trust and permissions in the destination. Check the connection from the device after installing the required key, certificate and chain.",{"_3634":1789,"_31209":1789,"_5":15244,"_3085":56515,"_31547":56516,"_21628":56517,"_28401":1789},"Lamassu IoT Platform",[50999,52511],[],{"_3634":1790,"_31209":1789,"_21628":56519,"_5":14884,"_28401":1789,"_3085":56520},[],"Build a PKI and apply its certificates to your devices' lifecycle.",{"_3634":1791,"_31209":1789,"_5":31544,"_21628":56522,"_28401":56523,"_3085":56003},[],"/docs/platform/overview#start-here",{"_3634":1792,"_31209":1789,"_5":31544,"_21628":56525,"_28401":56526,"_3085":56527},[],"/docs/platform/overview#choose-your-path","Choose your path",{"_3634":1793,"_31209":1789,"_5":31544,"_21628":56529,"_28401":56530,"_3085":56531},[],"/docs/platform/overview#architecture-at-a-glance","Architecture at a glance",{"_3634":1794,"_31209":1789,"_5":31544,"_21628":56533,"_28401":56534,"_3085":56535},[],"/docs/platform/overview#core-capabilities","Core capabilities",{"_3634":1795,"_31209":1789,"_5":31544,"_21628":56537,"_28401":56538,"_3085":56539},[],"/docs/platform/overview#build-your-trust-hierarchy","Build your trust hierarchy",{"_3634":1796,"_31209":1789,"_5":31544,"_21628":56541,"_28401":56542,"_3085":56543},[],"/docs/platform/overview#protect-cryptographic-keys","Protect cryptographic keys",{"_3634":1797,"_31209":1789,"_5":31544,"_21628":56545,"_28401":56546,"_3085":56547},[],"/docs/platform/overview#issue-and-control-certificates","Issue and control certificates",{"_3634":1798,"_31209":1789,"_5":31544,"_21628":56549,"_28401":56550,"_3085":56551},[],"/docs/platform/overview#automate-device-identities","Automate device identities",{"_3634":1799,"_31209":1789,"_5":31544,"_21628":56553,"_28401":56554,"_3085":56555},[],"/docs/platform/overview#publish-validation-status","Publish validation status",{"_3634":1800,"_31209":1789,"_5":31544,"_21628":56557,"_28401":56558,"_3085":56559},[],"/docs/platform/overview#react-to-events","React to events",{"_3634":1801,"_31209":1789,"_5":31544,"_21628":56561,"_28401":56562,"_3085":56563},[],"/docs/platform/overview#operational-reference","Operational reference",{"_3634":1802,"_31209":1789,"_21628":56565,"_5":14884,"_28401":1789,"_3085":56566},[],"Lamassu IoT lets you administer a private PKI and use it to issue, renew and revoke X.509 device identities. The Platform documentation follows two paths: **PKI**, for authorities and certificates, and **IoT Fleets**, for applying those identities to a device population.",{"_3634":1803,"_31209":1789,"_21628":56568,"_5":14884,"_28401":56523,"_3085":56569},[],"Choose the result you need:",{"_3634":1804,"_31209":1789,"_21628":56571,"_5":14884,"_28401":56523,"_3085":56572},[],"<Card title=\"Issue and verify a certificate\" description=\"Prepare a CA, issue an X.509 identity and check its chain and key.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3634":1805,"_31209":1789,"_21628":56574,"_5":14884,"_28401":56523,"_3085":56575},[],"<Card title=\"Enroll and connect a device\" description=\"Prepare the DMS, request an identity through EST and check an mTLS connection.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3634":1806,"_31209":1789,"_21628":56577,"_5":14884,"_28401":56523,"_3085":56578},[],"If you are still preparing the instance, start in Deployment. The Platform paths assume an accessible console and permission to perform the operations.",{"_3634":1807,"_31209":1789,"_21628":56580,"_5":14884,"_28401":56526,"_3085":56581},[],"Section",{"_3634":1808,"_31209":1789,"_21628":56583,"_5":14884,"_28401":56526,"_3085":56584},[],"What you manage",{"_3634":1809,"_31209":1789,"_21628":56586,"_5":14884,"_28401":56526,"_3085":56587},[],"Entry point",{"_3634":1810,"_31209":1789,"_21628":56589,"_5":14884,"_28401":56526,"_3085":56590},[],"**PKI**",{"_3634":1811,"_31209":1789,"_21628":56592,"_5":14884,"_28401":56526,"_3085":56593},[],"Keys, authorities, profiles, certificates and publication of revocation status.",{"_3634":1812,"_31209":1789,"_21628":56595,"_5":14884,"_28401":56526,"_3085":56596},[],"PKI overview",{"_3634":1813,"_31209":1789,"_21628":56598,"_5":14884,"_28401":56526,"_3085":56599},[],"**IoT Fleets**",{"_3634":1814,"_31209":1789,"_21628":56601,"_5":14884,"_28401":56526,"_3085":56602},[],"Devices, identity history, DMS policies, EST enrollment and integrations.",{"_3634":1815,"_31209":1789,"_21628":56604,"_5":14884,"_28401":56526,"_3085":56605},[],"IoT Fleets overview",{"_3634":1816,"_31209":1789,"_21628":56607,"_5":14884,"_28401":56526,"_3085":56608},[],"**Administration**",{"_3634":1817,"_31209":1789,"_21628":56610,"_5":14884,"_28401":56526,"_3085":56611},[],"Operator permissions, audit and event subscriptions.",{"_3634":1818,"_31209":1789,"_21628":56613,"_5":14884,"_28401":56526,"_3085":52513},[],{"_3634":1819,"_31209":1789,"_21628":56615,"_5":14884,"_28401":56526,"_3085":56616},[],"A CA determines who signs, and a profile defines what can be issued. The DMS applies admission and enrollment policy. The device retains its association with certificates, and the external consumer decides which identity it accepts.",{"_3634":1820,"_31209":1789,"_21628":56618,"_5":14884,"_28401":56530,"_3085":56619},[],"An identity's journey connects four responsibilities:",{"_3634":1821,"_31209":1789,"_21628":56621,"_5":14884,"_28401":56530,"_3085":56622},[],"The PKI administrator prepares the authority, its key and issuance rules.",{"_3634":1822,"_31209":1789,"_21628":56624,"_5":14884,"_28401":56530,"_3085":56625},[],"The provisioning administrator configures the DMS and initial trust.",{"_3634":1823,"_31209":1789,"_21628":56627,"_5":14884,"_28401":56530,"_3085":56628},[],"The device client requests a certificate and installs it with the matching key.",{"_3634":1824,"_31209":1789,"_21628":56630,"_5":14884,"_28401":56530,"_3085":56631},[],"The consumer validates the identity and applies its access permissions.",{"_3634":1825,"_31209":1789,"_21628":56633,"_5":14884,"_28401":56530,"_3085":56634},[],"See How Lamassu works to understand the resources and platform architecture for the services. Installation, network exposure and dependencies are explained in Deployment.",{"_3634":1826,"_31209":1789,"_21628":56636,"_5":14884,"_28401":56538,"_3085":56637},[],"Create or incorporate authorities and organize their relationships in PKI. The hierarchy and its rotation determine which chains consumers must recognize.",{"_3634":1827,"_31209":1789,"_21628":56639,"_5":14884,"_28401":56542,"_3085":56640},[],"Choose the engine that keeps authority keys and control who can use them. See Keys and engines; provider setup belongs to deployment.",{"_3634":1828,"_31209":1789,"_21628":56642,"_5":14884,"_28401":56546,"_3085":56643},[],"Define issuance profiles, sign requests and review the certificate inventory. Check the issued certificate from the client that will use it.",{"_3634":1829,"_31209":1789,"_21628":56645,"_5":14884,"_28401":56550,"_3085":56646},[],"Configure a DMS and use EST to request and renew certificates. Preparing the initial credential and installing the result belong to device integration.",{"_3634":1830,"_31209":1789,"_21628":56648,"_5":14884,"_28401":56554,"_3085":56649},[],"Use OCSP and CRL to publish revocation status. Each consumer must configure how it retrieves and applies that information.",{"_3634":1831,"_31209":1789,"_21628":56651,"_5":14884,"_28401":56558,"_3085":56652},[],"Use audit logs to investigate changes and configure alerts and subscriptions to react to lifecycle events.",{"_3634":1832,"_31209":1789,"_21628":56654,"_5":14884,"_28401":56562,"_3085":56097},[],{"_3634":1833,"_31209":1789,"_21628":56656,"_5":14884,"_28401":56562,"_3085":56657},[],"What it prepares or checks",{"_3634":1834,"_31209":1789,"_21628":56659,"_5":14884,"_28401":56562,"_3085":56100},[],{"_3634":1835,"_31209":1789,"_21628":56661,"_5":14884,"_28401":56562,"_3085":56662},[],"Key custody, CA hierarchy, profiles and validation.",{"_3634":1836,"_31209":1789,"_21628":56664,"_5":14884,"_28401":56562,"_3085":56665},[],"Fleet administrator",{"_3634":1837,"_31209":1789,"_21628":56667,"_5":14884,"_28401":56562,"_3085":56668},[],"DMS, device admission, renewal policy and inventory.",{"_3634":1838,"_31209":1789,"_21628":56670,"_5":14884,"_28401":56562,"_3085":56112},[],{"_3634":1839,"_31209":1789,"_21628":56672,"_5":14884,"_28401":56562,"_3085":56673},[],"Initial credential, server trust, EST client, and key and certificate storage.",{"_3634":1840,"_31209":1789,"_21628":56675,"_5":14884,"_28401":56562,"_3085":56118},[],{"_3634":1841,"_31209":1789,"_21628":56677,"_5":14884,"_28401":56562,"_3085":56678},[],"Issuer trust, certificate validation and permissions in the destination.",{"_3634":1842,"_31209":1789,"_21628":56680,"_5":14884,"_28401":56562,"_3085":56681},[],"Infrastructure operator",{"_3634":1843,"_31209":1789,"_21628":56683,"_5":14884,"_28401":56562,"_3085":56684},[],"Installation, network, availability, dependencies and deployment diagnosis.",{"_3634":1844,"_31209":1789,"_21628":56686,"_5":14884,"_28401":56562,"_3085":56687},[],"The API reference contains contracts for automating operations. To investigate a failure, start in the affected section: PKI, EST or Deployment.",{"_3634":1845,"_31209":1845,"_5":15244,"_3085":56689,"_31547":56690,"_21628":56693,"_28401":1845},"CA hierarchy and rotation",[50999,52511,56691,56692],"PKI","Keys, authorities and certificates",[],{"_3634":1846,"_31209":1845,"_21628":56695,"_5":14884,"_28401":1845,"_3085":56696},[],"Design root and intermediate authorities and replace certificates or keys without breaking trust.",{"_3634":1847,"_31209":1845,"_5":31544,"_21628":56698,"_28401":56699,"_3085":56700},[],"/docs/platform/pki/ca-hierarchy-and-rotation#design-the-hierarchy","Design the hierarchy",{"_3634":1848,"_31209":1845,"_5":31544,"_21628":56702,"_28401":56703,"_3085":56704},[],"/docs/platform/pki/ca-hierarchy-and-rotation#reissuance-and-rotation-are-not-the-same","Reissuance and rotation are not the same",{"_3634":1849,"_31209":1845,"_5":31544,"_21628":56706,"_28401":56707,"_3085":56708},[],"/docs/platform/pki/ca-hierarchy-and-rotation#when-to-choose-each-operation","When to choose each operation",{"_3634":1850,"_31209":1845,"_5":31544,"_21628":56710,"_28401":56711,"_3085":56712},[],"/docs/platform/pki/ca-hierarchy-and-rotation#key-rotation-procedure","Key rotation procedure",{"_3634":1851,"_31209":1845,"_5":31544,"_21628":56714,"_28401":56715,"_3085":56716},[],"/docs/platform/pki/ca-hierarchy-and-rotation#inventory-the-dependencies","Inventory the dependencies",{"_3634":1852,"_31209":1845,"_5":31544,"_21628":56718,"_28401":56719,"_3085":56720},[],"/docs/platform/pki/ca-hierarchy-and-rotation#create-the-successor-ca","Create the successor CA",{"_3634":1853,"_31209":1845,"_5":31544,"_21628":56722,"_28401":56723,"_3085":56724},[],"/docs/platform/pki/ca-hierarchy-and-rotation#distribute-the-new-trust","Distribute the new trust",{"_3634":1854,"_31209":1845,"_5":31544,"_21628":56726,"_28401":56727,"_3085":56728},[],"/docs/platform/pki/ca-hierarchy-and-rotation#switch-issuance","Switch issuance",{"_3634":1855,"_31209":1845,"_5":31544,"_21628":56730,"_28401":56731,"_3085":56732},[],"/docs/platform/pki/ca-hierarchy-and-rotation#renew-in-batches","Renew in batches",{"_3634":1856,"_31209":1845,"_5":31544,"_21628":56734,"_28401":56735,"_3085":56736},[],"/docs/platform/pki/ca-hierarchy-and-rotation#close-the-overlap","Close the overlap",{"_3634":1857,"_31209":1845,"_5":31544,"_21628":56738,"_28401":56739,"_3085":56740},[],"/docs/platform/pki/ca-hierarchy-and-rotation#cascading-revocation","Cascading revocation",{"_3634":1858,"_31209":1845,"_5":31544,"_21628":56742,"_28401":56743,"_3085":56744},[],"/docs/platform/pki/ca-hierarchy-and-rotation#checks-after-the-change","Checks after the change",{"_3634":1859,"_31209":1845,"_21628":56746,"_5":14884,"_28401":1845,"_3085":56747},[],"The hierarchy determines the blast radius of any error or compromise. A root signs intermediate CAs; intermediates issue the identities used by devices and services. This separation lets you isolate environments and rotate a branch without replacing all trust.",{"_3634":1860,"_31209":1845,"_21628":56749,"_5":14884,"_28401":1845,"_3085":56750},[],"This procedure is for the PKI operator replacing an authority in use. You need access to CAs, keys and profiles, a dependency inventory and coordination with trust-store and device owners. Before switching issuance, prepare a test cohort and decide the criterion for ending overlap.",{"_3634":1861,"_31209":1845,"_21628":56752,"_5":14884,"_28401":56699,"_3085":56753},[],"For a production installation, use a very restricted root and one or more operational intermediates. Separate intermediates when any of these boundaries change:",{"_3634":1862,"_31209":1845,"_21628":56755,"_5":14884,"_28401":56699,"_3085":56756},[],"environment, such as production and preproduction;",{"_3634":1863,"_31209":1845,"_21628":56758,"_5":14884,"_28401":56699,"_3085":56759},[],"owner or operating team;",{"_3634":1864,"_31209":1845,"_21628":56761,"_5":14884,"_28401":56699,"_3085":56762},[],"device family or manufacturing process;",{"_3634":1865,"_31209":1845,"_21628":56764,"_5":14884,"_28401":56699,"_3085":56765},[],"region or regulatory requirement;",{"_3634":1866,"_31209":1845,"_21628":56767,"_5":14884,"_28401":56699,"_3085":56768},[],"cryptographic engine or key policy;",{"_3634":1867,"_31209":1845,"_21628":56770,"_5":14884,"_28401":56699,"_3085":56771},[],"maintenance window and renewal cadence.",{"_3634":1868,"_31209":1845,"_21628":56773,"_5":14884,"_28401":56699,"_3085":56774},[],"Avoid deep hierarchies without a concrete need. Each level adds chain distribution, validation and one more certificate you must renew.",{"_3634":1869,"_31209":1845,"_21628":56776,"_5":14884,"_28401":56699,"_3085":56777},[],"A child CA and its end-entity certificates must expire before their issuer. Reserve a margin that allows distributing another chain and renewing dependent certificates.",{"_3634":1870,"_31209":1845,"_21628":56779,"_5":14884,"_28401":56703,"_3085":56780},[],"**Reissuing a CA** creates a new certificate over the existing key. Lamassu generates a CSR with that key, self-signs it if it is a root or asks the parent CA to sign it if it is subordinate. The new certificate becomes active and the CA points to its serial number; the old and new certificates are linked through metadata.",{"_3634":1871,"_31209":1845,"_21628":56782,"_5":14884,"_28401":56703,"_3085":56783},[],"If the CRL settings of the CA are signed by the superseded CA certificate, reissuing moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. Otherwise, and for settings signed by a different certificate, the signer is kept, so check the new certificate’s key usage after reissuing. A CA with no CRL settings — for example, one imported without its key or without `cRLSign` — has them initialized by the reissue when the new certificate carries `cRLSign`; otherwise it keeps none. See the CRL guide.",{"_3634":1872,"_31209":1845,"_21628":56785,"_5":14884,"_28401":56703,"_3085":56786},[],"**Rotating a CA** creates a successor key and authority. It is the right choice in the face of compromise, a cryptographic change, an engine migration or non-exportable key policies.",{"_3634":1873,"_31209":1845,"_21628":56788,"_5":14884,"_28401":56703,"_3085":56789},[],"Lamassu does not allow reissuing an already-revoked CA or a CA whose expiration date has passed. A subordinate CA is signed by its parent, so the parent must also be `ACTIVE` and inside its validity period; otherwise the reissue fails with `400`. Plan ahead for these conditions.",{"_3634":1874,"_31209":1845,"_21628":56791,"_5":14884,"_28401":56707,"_3085":56792},[],"Reissue if the key is still trustworthy and you only need another validity period or an updated certificate.",{"_3634":1875,"_31209":1845,"_21628":56794,"_5":14884,"_28401":56707,"_3085":56795},[],"Rotate the key if compromise is suspected, the algorithm changes or you want to move custody to another engine.",{"_3634":1876,"_31209":1845,"_21628":56797,"_5":14884,"_28401":56707,"_3085":56798},[],"Create a parallel branch if you cannot update all consumers at the same time.",{"_3634":1877,"_31209":1845,"_21628":56800,"_5":14884,"_28401":56707,"_3085":56801},[],"Revoke immediately only when the risk of keeping the CA outweighs the impact of interrupting the fleet.",{"_3634":1878,"_31209":1845,"_21628":56803,"_5":14884,"_28401":56715,"_3085":56804},[],"Locate child CAs, issued certificates, DMSs, connectors and external trust stores. Include devices that may stay offline for weeks or months.",{"_3634":1879,"_31209":1845,"_21628":56806,"_5":14884,"_28401":56719,"_3085":56807},[],"Generate a new key in the planned engine, create the CA and assign it an explicit profile. Do not reuse the operational identifier to hide that it is a different generation.",{"_3634":1880,"_31209":1845,"_21628":56809,"_5":14884,"_28401":56723,"_3085":56810},[],"Add the new root or chain to consumers before issuing with it. If distributing through EST `/cacerts`, explicitly include the required managed CAs and inspect the content; including the issuer does not automatically include every intermediate. Install the new trust in a cohort and verify that it still accepts the previous identity.",{"_3634":1881,"_31209":1845,"_21628":56812,"_5":14884,"_28401":56727,"_3085":56813},[],"Update the enrollment CA and profile of the DMSs. While old-CA cohorts still renew, add the previous enrollment CA to each DMS's re-enrollment validation CAs (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`): the new enrollment CA is trusted automatically, but the old one was the enrollment CA and appears in no re-enrollment trust list, so without that entry its certificates can no longer renew. The DMS guide documents the setting.",{"_3634":1882,"_31209":1845,"_21628":56815,"_5":14884,"_28401":56731,"_3085":56816},[],"Migrate a small cohort, validate mTLS, OCSP and CRL from the consumer and expand progressively. Monitor which devices still present the old chain.",{"_3634":1883,"_31209":1845,"_21628":56818,"_5":14884,"_28401":56735,"_3085":56819},[],"Once no legitimate consumer depends on the previous authority, remove it from issuance, from the re-enrollment validation CAs and from the distributed CAs. Revoke it if policy requires it.",{"_3634":1884,"_31209":1845,"_21628":56821,"_5":14884,"_28401":56739,"_3085":56822},[],"Lamassu saves the CA’s revocation, then applies the same revocation to child CAs and issued certificates. Propagation continues recursively through child CAs. This is not a transaction over the whole hierarchy: some resources may have changed while other updates failed.",{"_3634":1885,"_31209":1845,"_21628":56824,"_5":14884,"_28401":56739,"_3085":56825},[],"Resources in `EXPIRED` state and resources already revoked for a final reason reject further status transitions. Per-descendant failures are logged; review the inventory and logs even when the parent operation completes.",{"_3634":1886,"_31209":1845,"_21628":56827,"_5":14884,"_28401":56739,"_3085":56828},[],"`CertificateHold` is the reversible exception. Holding a CA suspends its active sub-CAs and issued certificates with `CertificateHold` and marks them as suspended by that CA. Releasing the CA — to `ACTIVE` or to any other non-revoked status such as `EXPIRED` — reactivates exactly the descendants still on hold that carry that mark. Holds placed manually before or after the cascade are left untouched, and any later status change of a descendant clears the mark. Revoking a held CA with any other reason remains permanent: descendants are revoked with `CessationOfOperation` and cannot be restored.",{"_3634":1887,"_31209":1845,"_21628":56830,"_5":14884,"_28401":56739,"_3085":56831},[],"Before closing the change, compare the original dependency inventory with final states and verify revocation publication for each issuer. Do not use revocation as the ordinary mechanism to stop issuance: complete migration and remove the CA from operational flows.",{"_3634":1888,"_31209":1845,"_21628":56833,"_5":14884,"_28401":56743,"_3085":56834},[],"The new chain ends in an anchor installed by the consumer.",{"_3634":1889,"_31209":1845,"_21628":56836,"_5":14884,"_28401":56743,"_3085":56837},[],"New certificates contain the expected AKI, SKI, KU, EKU and SAN.",{"_3634":1890,"_31209":1845,"_21628":56839,"_5":14884,"_28401":56743,"_3085":56840},[],"The DMS delivers the correct chain through EST `/cacerts`.",{"_3634":1891,"_31209":1845,"_21628":56842,"_5":14884,"_28401":56743,"_3085":56843},[],"Re-enrollment accepts the old identity during the planned period.",{"_3634":1892,"_31209":1845,"_21628":56845,"_5":14884,"_28401":56743,"_3085":56846},[],"OCSP and CRL respond for the authorities that remain active.",{"_3634":1893,"_31209":1845,"_21628":56848,"_5":14884,"_28401":56743,"_3085":56849},[],"No DMS is left accidentally issuing from the old CA.",{"_3634":1894,"_31209":1845,"_21628":56851,"_5":14884,"_28401":56743,"_3085":56852},[],"See the Trust model to understand the DMS's CA sets and Certificate lifecycle for states and revocation effects.",{"_3634":1895,"_31209":1895,"_5":15244,"_3085":56854,"_31547":56855,"_21628":56856,"_28401":1895},"Certification authorities",[50999,52511,56691,56692],[],{"_3634":1896,"_31209":1895,"_21628":56858,"_5":14884,"_28401":1895,"_3085":56859},[],"Create, import and operate the authorities that establish your PKI's trust.",{"_3634":1897,"_31209":1895,"_5":31544,"_21628":56861,"_28401":56862,"_3085":56863},[],"/docs/platform/pki/certificate-authorities#choose-a-flow","Choose a flow",{"_3634":1898,"_31209":1895,"_5":31544,"_21628":56865,"_28401":56866,"_3085":56867},[],"/docs/platform/pki/certificate-authorities#create-a-new-authority","Create a new authority",{"_3634":1899,"_31209":1895,"_5":31544,"_21628":56869,"_28401":56870,"_3085":51009},[],"/docs/platform/pki/certificate-authorities#before-you-begin",{"_3634":1900,"_31209":1895,"_5":31544,"_21628":56872,"_28401":56873,"_3085":56874},[],"/docs/platform/pki/certificate-authorities#open-the-wizard","Open the wizard",{"_3634":1901,"_31209":1895,"_5":31544,"_21628":56876,"_28401":56877,"_3085":56878},[],"/docs/platform/pki/certificate-authorities#configure-the-key","Configure the key",{"_3634":1902,"_31209":1895,"_5":31544,"_21628":56880,"_28401":56881,"_3085":56882},[],"/docs/platform/pki/certificate-authorities#choose-the-ca-type","Choose the CA type",{"_3634":1903,"_31209":1895,"_5":31544,"_21628":56884,"_28401":56885,"_3085":56886},[],"/docs/platform/pki/certificate-authorities#define-the-identity","Define the identity",{"_3634":1904,"_31209":1895,"_5":31544,"_21628":56888,"_28401":56889,"_3085":56890},[],"/docs/platform/pki/certificate-authorities#configure-validity-and-uses","Configure validity and uses",{"_3634":1905,"_31209":1895,"_5":31544,"_21628":56892,"_28401":56893,"_3085":56894},[],"/docs/platform/pki/certificate-authorities#create-and-verify","Create and verify",{"_3634":1906,"_31209":1895,"_5":31544,"_21628":56896,"_28401":56897,"_3085":56898},[],"/docs/platform/pki/certificate-authorities#use-a-key-from-the-kms","Use a key from the KMS",{"_3634":1907,"_31209":1895,"_5":31544,"_21628":56900,"_28401":56901,"_3085":56902},[],"/docs/platform/pki/certificate-authorities#import-an-external-ca","Import an external CA",{"_3634":1908,"_31209":1895,"_5":31544,"_21628":56904,"_28401":56905,"_3085":56906},[],"/docs/platform/pki/certificate-authorities#select-the-engine","Select the engine",{"_3634":1909,"_31209":1895,"_5":31544,"_21628":56908,"_28401":56909,"_3085":56910},[],"/docs/platform/pki/certificate-authorities#load-the-material","Load the material",{"_3634":1910,"_31209":1895,"_5":31544,"_21628":56912,"_28401":56913,"_3085":56914},[],"/docs/platform/pki/certificate-authorities#define-the-default-issuance","Define the default issuance",{"_3634":1911,"_31209":1895,"_5":31544,"_21628":56916,"_28401":56917,"_3085":56918},[],"/docs/platform/pki/certificate-authorities#verify-the-import","Verify the import",{"_3634":1912,"_31209":1895,"_5":31544,"_21628":56920,"_28401":56921,"_3085":56922},[],"/docs/platform/pki/certificate-authorities#ca-states","CA states",{"_3634":1913,"_31209":1895,"_5":31544,"_21628":56924,"_28401":56925,"_3085":56926},[],"/docs/platform/pki/certificate-authorities#inspect-an-authority","Inspect an authority",{"_3634":1914,"_31209":1895,"_5":31544,"_21628":56928,"_28401":56929,"_3085":56930},[],"/docs/platform/pki/certificate-authorities#issue-certificates","Issue certificates",{"_3634":1915,"_31209":1895,"_5":31544,"_21628":56932,"_28401":56933,"_3085":56934},[],"/docs/platform/pki/certificate-authorities#revoke-a-ca","Revoke a CA",{"_3634":1916,"_31209":1895,"_5":31544,"_21628":56936,"_28401":56937,"_3085":56938},[],"/docs/platform/pki/certificate-authorities#assess-the-impact","Assess the impact",{"_3634":1917,"_31209":1895,"_5":31544,"_21628":56940,"_28401":56941,"_3085":56942},[],"/docs/platform/pki/certificate-authorities#start-the-revocation","Start the revocation",{"_3634":1918,"_31209":1895,"_5":31544,"_21628":56944,"_28401":56945,"_3085":56946},[],"/docs/platform/pki/certificate-authorities#confirm-the-identity","Confirm the identity",{"_3634":1919,"_31209":1895,"_5":31544,"_21628":56948,"_28401":56949,"_3085":56950},[],"/docs/platform/pki/certificate-authorities#check-the-publication","Check the publication",{"_3634":1920,"_31209":1895,"_5":31544,"_21628":56952,"_28401":56953,"_3085":56954},[],"/docs/platform/pki/certificate-authorities#delete-a-ca","Delete a CA",{"_3634":1921,"_31209":1895,"_21628":56956,"_5":14884,"_28401":1895,"_3085":56957},[],"A certification authority (CA) binds identities to public keys through signed certificates. In Lamassu you can create a new hierarchy, use a key already in the KMS or incorporate an external CA.",{"_3634":1922,"_31209":1895,"_21628":56959,"_5":14884,"_28401":1895,"_3085":56960},[],"To design a full chain or replace an authority in production, see CA hierarchy and rotation. If you need to standardize what each authority can sign, use Certificate profiles.",{"_3634":1923,"_31209":1895,"_21628":56962,"_5":14884,"_28401":1895,"_3085":56963},[],"To administer CAs, you need authority and key permissions, a reachable engine and a reviewed profile. An external consumer does not trust a CA merely because it appears in this inventory: agree root and chain distribution separately.",{"_3634":1924,"_31209":1895,"_21628":56965,"_5":14884,"_28401":56862,"_3085":56966},[],"**New CA with a new key:** create a root of trust from scratch. Lamassu generates and keeps the key pair.",{"_3634":1925,"_31209":1895,"_21628":56968,"_5":14884,"_28401":56862,"_3085":56969},[],"**New CA from the KMS:** reuse a key already registered in the platform.",{"_3634":1926,"_31209":1895,"_21628":56971,"_5":14884,"_28401":56862,"_3085":56972},[],"**Import a CA with its private key:** incorporate an external authority that Lamassu can issue with.",{"_3634":1927,"_31209":1895,"_21628":56974,"_5":14884,"_28401":56862,"_3085":56975},[],"**Import only the certificate:** register public material. If Lamassu finds its key in the KMS, it can associate it; otherwise, the CA has no usable key for issuance.",{"_3634":1928,"_31209":1895,"_21628":56977,"_5":14884,"_28401":56862,"_3085":56978},[],"First time here? Follow Create your first CA to complete the minimal journey.",{"_3634":1929,"_31209":1895,"_21628":56980,"_5":14884,"_28401":56870,"_3085":56981},[],"Decide whether the CA will be a root or an intermediate.",{"_3634":1930,"_31209":1895,"_21628":56983,"_5":14884,"_28401":56870,"_3085":56984},[],"Choose the engine that will keep the key.",{"_3634":1931,"_31209":1895,"_21628":56986,"_5":14884,"_28401":56870,"_3085":56987},[],"Define a validity longer than that of the certificates it will issue.",{"_3634":1932,"_31209":1895,"_21628":56989,"_5":14884,"_28401":56870,"_3085":56990},[],"For an intermediate CA, make sure the parent CA is active.",{"_3634":1933,"_31209":1895,"_21628":56992,"_5":14884,"_28401":56873,"_3085":56993},[],"In **Certification Authorities**, select **Create New CA** and choose to generate a new key pair.",{"_3634":1934,"_31209":1895,"_21628":56995,"_5":14884,"_28401":56877,"_3085":56996},[],"Select the cryptographic engine, the algorithm and the size or curve. Lamassu supports RSA and EC keys according to the engine's capabilities.",{"_3634":1935,"_31209":1895,"_21628":56998,"_5":14884,"_28401":56877,"_3085":56999},[],"Use only sizes and curves supported by the engine and the profile’s cryptographic policy. Read Keys and engines before reusing external material.",{"_3634":1936,"_31209":1895,"_21628":57001,"_5":14884,"_28401":56881,"_3085":57002},[],"Select **Root CA** for a self-signed authority or **Intermediate CA** for an authority signed by another CA. In the latter case, choose the issuing CA.",{"_3634":1937,"_31209":1895,"_21628":57004,"_5":14884,"_28401":56885,"_3085":57005},[],"Enter a unique **CA Name**. This name becomes the certificate's `Common Name`. Complete the Distinguished Name fields your policy requires:",{"_3634":1938,"_31209":1895,"_21628":57007,"_5":14884,"_28401":56885,"_3085":57008},[],"`C`: two-letter ISO 3166-1 country code.",{"_3634":1939,"_31209":1895,"_21628":57010,"_5":14884,"_28401":56885,"_3085":57011},[],"`ST`: state or province.",{"_3634":1940,"_31209":1895,"_21628":57013,"_5":14884,"_28401":56885,"_3085":57014},[],"`L`: locality.",{"_3634":1941,"_31209":1895,"_21628":57016,"_5":14884,"_28401":56885,"_3085":57017},[],"`O`: organization.",{"_3634":1942,"_31209":1895,"_21628":57019,"_5":14884,"_28401":56885,"_3085":57020},[],"`OU`: organizational unit.",{"_3634":1943,"_31209":1895,"_21628":57022,"_5":14884,"_28401":56885,"_3085":57023},[],"The CA's internal identifier is generated automatically and cannot be changed.",{"_3634":1944,"_31209":1895,"_21628":57025,"_5":14884,"_28401":56889,"_3085":57026},[],"Define **CA Certificate Expiration** and **Default End-Entity Certificate Issuance Expiration**. You can express a duration (`5y 8w 4d`), pick a date or use the maximum allowed date.",{"_3634":1945,"_31209":1895,"_21628":57028,"_5":14884,"_28401":56889,"_3085":57029},[],"Review the CA’s own certificate separately from the default profile for certificates it will issue later. Choose an explicit issuance policy; do not assume the form’s initial values suit your consumers.",{"_3634":1946,"_31209":1895,"_21628":57031,"_5":14884,"_28401":56893,"_3085":57032},[],"Confirm the form and open the CA. Check status, issuer, dates, associated engine and key. Download the certificate: it should contain `CA:TRUE` and a usage permitting certificate signing. Verify the self-signature for a root or the chain to your root for an intermediate. Complete a test issuance to check that the key can actually sign.",{"_3634":1947,"_31209":1895,"_21628":57034,"_5":14884,"_28401":56893,"_3085":57035},[],"Plan and verify expiration using the Profiles rules. Issuance does not automatically clamp validity to the issuer’s expiration; leave time to replace the authority and renew identities.",{"_3634":1948,"_31209":1895,"_21628":57037,"_5":14884,"_28401":56897,"_3085":57038},[],"Select &#x2A;*Create New CA (Existing Key)** when the key is already registered in Lamassu. The wizard first asks for the backing key and then shows the same configuration of type, identity, validity and profile.",{"_3634":1949,"_31209":1895,"_21628":57040,"_5":14884,"_28401":56897,"_3085":57041},[],"This flow is useful when the key was previously created in an HSM, imported through BYOK or must be reused under a specific custody policy.",{"_3634":1950,"_31209":1895,"_21628":57043,"_5":14884,"_28401":56901,"_3085":57044},[],"You need the CA certificate in PEM, its chain to a known root and, when importing it, an exportable private key. Before uploading material, verify signature, dates, `CA:TRUE`, signing usages (including `cRLSign`, without which the CA cannot publish its CRL) and public-key correspondence. The key verification procedure also compares a CA key and certificate.",{"_3634":1951,"_31209":1895,"_21628":57046,"_5":14884,"_28401":56901,"_3085":57047},[],"The backend rejects an import whose certificate lacks the CA basic constraint (`basicConstraints cA flag is not set`), whose serial number matches a stored certificate with different contents, or whose identical certificate already belongs to an existing CA. A deleted CA's certificate record is kept and can be reused when re-importing the same certificate, including its previous status. Re-importing a different certificate with that serial number is rejected; check the certificate and status after re-importing.",{"_3634":1952,"_31209":1895,"_21628":57049,"_5":14884,"_28401":56901,"_3085":57050},[],"A certificate whose validity period has already ended, such as that of a retired external authority, is accepted and, when Lamassu has no stored record of that certificate yet, the CA is stored as `EXPIRED` from the start, as happens when importing a plain certificate. If the import reuses the record of a deleted CA (see above and Delete a CA), the previous status is kept instead, even if the certificate has expired in the meantime. An `EXPIRED` CA rejects status changes; see certificate lifecycle.",{"_3634":1953,"_31209":1895,"_21628":57052,"_5":14884,"_28401":56901,"_3085":57053},[],"Deleting a CA releases the key references of its own current certificate and linked reissued certificates, while keeping those records for its issuer's CRL and OCSP. It then attempts to delete the key; the KMS keeps it if other certificates still reference it, such as another CA sharing the key. Revoking certificates issued by the deleted CA does not release their own key references.",{"_3634":1954,"_31209":1895,"_21628":57055,"_5":14884,"_28401":56905,"_3085":57056},[],"Check the installation’s default engine before importing a CA with a key. CA import delegates key import to that engine; it does not guarantee arbitrary provider selection from the form. To select an engine while importing the key separately, use the KMS.",{"_3634":1955,"_31209":1895,"_21628":57058,"_5":14884,"_28401":56909,"_3085":57059},[],"Import the certificate and, when applicable, its PEM key. Register the CAs needed to identify the issuer. Registering a CA does not install it in external trust stores.",{"_3634":1956,"_31209":1895,"_21628":57061,"_5":14884,"_28401":56909,"_3085":57062},[],"The backend validates before importing any key: a duplicate CA ID and a certificate that is not a CA (missing `basicConstraints` `cA=TRUE`) are rejected, the latter with `400` `certificate is not a CA: basicConstraints cA flag is not set`. If a failure occurs after the key was imported, the key is kept in the KMS and a warning tells you to delete it manually.",{"_3634":1957,"_31209":1895,"_21628":57064,"_5":14884,"_28401":56913,"_3085":57065},[],"Associate an explicit issuance profile if the CA will sign. Check usages and dates using Profiles.",{"_3634":1958,"_31209":1895,"_21628":57067,"_5":14884,"_28401":56917,"_3085":57068},[],"Review the registered type, associated key and engine, and issuer relationship. Certificate-only import may associate an existing KMS key using the certificate’s key identifier. Without a usable key, the CA is public material and cannot sign.",{"_3634":1959,"_31209":1895,"_21628":57070,"_5":14884,"_28401":56917,"_3085":57071},[],"An imported CA whose key is in the KMS and whose certificate carries `cRLSign` receives its CRL settings and first CRL automatically; without a key in the KMS or without `cRLSign` it receives none, and this is not an import error (see CRL).",{"_3634":1960,"_31209":1895,"_21628":57073,"_5":14884,"_28401":56917,"_3085":57074},[],"For an issuing CA, complete a test issuance and check OCSP and CRL. Creating the record alone does not establish key availability, complete chain consistency or status publication.",{"_3634":1961,"_31209":1895,"_21628":57076,"_5":14884,"_28401":56921,"_3085":57077},[],"A CA only signs in `ACTIVE`. From there it can move to `EXPIRED` or to `REVOKED`, and it leaves those states only by deletion, with one exception: a revocation with `CertificateHold` can be undone.",{"_3634":1962,"_31209":1895,"_21628":57079,"_5":14884,"_28401":56921,"_3085":57080},[],"**Expiry.** The expiry monitor marks as `EXPIRED` the `ACTIVE` CAs whose validity period has ended. Until it runs, the CA already does not sign, because Lamassu checks the dates (Issue certificates).",{"_3634":1963,"_31209":1895,"_21628":57082,"_5":14884,"_28401":56921,"_3085":57083},[],"**Revocation.** Revoking with the `CertificateHold` reason is reversible. A revocation with any other reason, like `EXPIRED`, rejects every later status change. Revoking, also with `CertificateHold`, additionally acts on the subordinate CAs and the certificates it issued: Revoke a CA.",{"_3634":1964,"_31209":1895,"_21628":57085,"_5":14884,"_28401":56921,"_3085":57086},[],"**Deletion.** Only a CA revoked with another reason, or an expired one, can be deleted; an imported CA without a key can be deleted from any state. Conditions and effects in Delete a CA.",{"_3634":1965,"_31209":1895,"_21628":57088,"_5":14884,"_28401":56925,"_3085":57089},[],"Open a CA from the inventory to review:",{"_3634":1966,"_31209":1895,"_21628":57091,"_5":14884,"_28401":56925,"_3085":57092},[],"Status and validity period.",{"_3634":1967,"_31209":1895,"_21628":57094,"_5":14884,"_28401":56925,"_3085":57095},[],"Certificate and chain in PEM format.",{"_3634":1968,"_31209":1895,"_21628":57097,"_5":14884,"_28401":56925,"_3085":57098},[],"Number of active, expired and revoked certificates.",{"_3634":1969,"_31209":1895,"_21628":57100,"_5":14884,"_28401":56925,"_3085":57101},[],"Certificates issued in **Issued Certificates**.",{"_3634":1970,"_31209":1895,"_21628":57103,"_5":14884,"_28401":56925,"_3085":57104},[],"The CRL linked to the authority.",{"_3634":1971,"_31209":1895,"_21628":57106,"_5":14884,"_28401":56925,"_3085":57107},[],"Metadata and the associated cryptographic engine.",{"_3634":1972,"_31209":1895,"_21628":57109,"_5":14884,"_28401":56925,"_3085":57110},[],"You can filter the inventory by name, status and CA type.",{"_3634":1973,"_31209":1895,"_21628":57112,"_5":14884,"_28401":56929,"_3085":57113},[],"You can start an issuance from **Issued Certificates**, from a CA's action menu or from the global certificate inventory.",{"_3634":1974,"_31209":1895,"_21628":57115,"_5":14884,"_28401":56929,"_3085":57116},[],"**Generate Key & CSR in Browser** is useful for a manual operation or a quick test. The browser generates the key and you must download it at the end.",{"_3634":1975,"_31209":1895,"_21628":57118,"_5":14884,"_28401":56929,"_3085":57119},[],"**Upload Existing CSR** is the right option when the key must remain on the target system. Lamassu receives the request but never the private key.",{"_3634":1976,"_31209":1895,"_21628":57121,"_5":14884,"_28401":56929,"_3085":57122},[],"Follow Issue your first certificate for the guided flow. Certificate management explains the inventory, inspection and revocation.",{"_3634":1977,"_31209":1895,"_21628":57124,"_5":14884,"_28401":56929,"_3085":57125},[],"A CA key signs certificates only. The CA API has no endpoint to sign or verify arbitrary data. To sign and verify a message with a key, use the KMS operations described in Key management, subject to their own permissions.",{"_3634":1978,"_31209":1895,"_21628":57127,"_5":14884,"_28401":56929,"_3085":57128},[],"A CA signs only while its status is `ACTIVE` and the current time falls inside the validity period of its certificate. Lamassu checks both, because the stored status can lag behind the dates until the expiration monitor runs. Otherwise the request fails with `400` and the message `CA Status inconsistent`, before the KMS is called. The same check applies when the CA signs the certificate of a subordinate CA, including when you create or reissue it.",{"_3634":1979,"_31209":1895,"_21628":57130,"_5":14884,"_28401":56933,"_3085":57131},[],"Revoking a CA prevents issuance and may interrupt its entire branch. With `CertificateHold` the cascade is reversible: descendants are suspended on hold and are restored when you release the CA. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Follow the cascading revocation conditions.",{"_3634":1980,"_31209":1895,"_21628":57133,"_5":14884,"_28401":56937,"_3085":57134},[],"Identify the certificates, devices and consumers that depend on the CA. Prepare a replacement authority and chain when necessary.",{"_3634":1981,"_31209":1895,"_21628":57136,"_5":14884,"_28401":56941,"_3085":57137},[],"Open the authority and select **Revoke CA**. Choose the reason that describes the incident, for example `KeyCompromise`, `CACompromise`, `Superseded` or `CessationOfOperation`.",{"_3634":1982,"_31209":1895,"_21628":57139,"_5":14884,"_28401":56945,"_3085":57140},[],"Type the CA's name exactly to enable **Confirm Revocation**.",{"_3634":1983,"_31209":1895,"_21628":57142,"_5":14884,"_28401":56949,"_3085":57143},[],"Check **REVOKED** on the CA and review descendants individually; propagation permits partial failures. Independently verify OCSP and CRL publication and consumer rejection. A revoked record does not guarantee that an existing session closes.",{"_3634":1984,"_31209":1895,"_21628":57145,"_5":14884,"_28401":56953,"_3085":57146},[],"Permanent deletion is only available with the CA revoked or expired; a CA imported without a key can be deleted in any state. Delete the record only when your retention and audit policy allows it.",{"_3634":1985,"_31209":1895,"_21628":57148,"_5":14884,"_28401":56953,"_3085":57149},[],"What the deletion does to what the CA issued depends on its status. Deleting an active CA imported without a key whose validity period has not ended only removes the record from Lamassu: the CA, its descendants and the certificates it issued keep their status, since the CA keeps operating outside Lamassu — its key was never in Lamassu. But if the validity period has already ended while the stored status still says `ACTIVE` — the stored status can lag behind the dates until the expiration monitor runs — the CA counts as expired for deletion. Deleting a revoked or expired CA revokes what it issued with `CessationOfOperation`, the same cascade as when revoking a CA. To retire an active keyless CA together with everything it issued, revoke it first with `POST /v1/cas/:id/status` and then delete it.",{"_3634":1986,"_31209":1895,"_21628":57151,"_5":14884,"_28401":56953,"_3085":57152},[],"The CA’s CRL settings are kept. A deletion is refused with a `409` error while they are still `ACTIVE`: the VA must first publish the CA’s final CRL, which can take up to about an hour after revocation with the default job schedule, so retry after the final CRL is published. An expired CA is finalized without a final CRL, and a CA on hold (`CertificateHold`) is refused with a message asking you to revoke it permanently first. The deletion is also refused with a `409` when the CA’s key signs the CRLs of another CA: the error names that CA, so change its CRL signer, or delete or revoke it, before deleting this one. The CA and all its descendants are checked before anything is deleted; nothing changes if any of them cannot be deleted.",{"_3634":1987,"_31209":1895,"_21628":57154,"_5":14884,"_28401":56953,"_3085":57155},[],"After the deletion, the settings are archived and the last CRL keeps being served but is never regenerated; you can remove them once no certificate issued by the CA still needs revocation evidence, using `DELETE /v1/crl-settings/{ca-id}` or the console's **Verification Authorities** page. Deleting them stops the CRL from being served and cannot be undone. Adjust the validity and signer before revoking or deleting the CA (see CRL). The CA’s key is released, but the KMS keeps it while other certificates still reference it.",{"_3634":1988,"_31209":1895,"_21628":57157,"_5":14884,"_28401":56953,"_3085":57158},[],"Lamassu keeps the certificate record of a deleted CA. If that same certificate is imported again, the import succeeds and reuses the record: it updates the type, issuer and key but keeps the status, so the CA reappears in the state it had when deleted (normally revoked or expired). A different certificate with the same serial number is rejected with a 400 error, and a certificate that already belongs to an existing CA with a 409 error. To avoid inheriting the previous status, use a certificate with a different serial number and check the result after importing. The reimported CA is registered under a new, backend-generated CA ID and does not inherit the CRL settings of the deleted CA: until those settings are deleted, those keep serving their last CRL at the CA ID URL, and at `/crl/<ski>` — the URL that certificates issued before the 4.0.0 upgrade carry — when the settings were migrated by that upgrade; when they are archived, they can no longer be edited (see CRL).",{"_3634":1989,"_31209":1989,"_5":15244,"_3085":57160,"_31547":57161,"_21628":57162,"_28401":1989},"Certificate profiles",[50999,52511,56691,56692],[],{"_3634":1990,"_31209":1989,"_21628":57164,"_5":14884,"_28401":1989,"_3085":57165},[],"Define reusable policies to issue consistent certificates and constrain accepted keys.",{"_3634":1991,"_31209":1989,"_5":31544,"_21628":57167,"_28401":57168,"_3085":57169},[],"/docs/platform/pki/certificate-profiles#what-a-profile-controls","What a profile controls",{"_3634":1992,"_31209":1989,"_5":31544,"_21628":57171,"_28401":57172,"_3085":57173},[],"/docs/platform/pki/certificate-profiles#validity","Validity",{"_3634":1993,"_31209":1989,"_5":31544,"_21628":57175,"_28401":57176,"_3085":57177},[],"/docs/platform/pki/certificate-profiles#ca-certificate-or-end-entity-certificate","CA certificate or end-entity certificate",{"_3634":1994,"_31209":1989,"_5":31544,"_21628":57179,"_28401":57180,"_3085":57181},[],"/docs/platform/pki/certificate-profiles#key-usage-and-extended-key-usage","Key Usage and Extended Key Usage",{"_3634":1995,"_31209":1989,"_5":31544,"_21628":57183,"_28401":57184,"_3085":57185},[],"/docs/platform/pki/certificate-profiles#subject","Subject",{"_3634":1996,"_31209":1989,"_5":31544,"_21628":57187,"_28401":57188,"_3085":57189},[],"/docs/platform/pki/certificate-profiles#csr-extensions","CSR extensions",{"_3634":1997,"_31209":1989,"_5":31544,"_21628":57191,"_28401":57192,"_3085":57193},[],"/docs/platform/pki/certificate-profiles#cryptographic-constraints","Cryptographic constraints",{"_3634":1998,"_31209":1989,"_5":31544,"_21628":57195,"_28401":57196,"_3085":57197},[],"/docs/platform/pki/certificate-profiles#profile-precedence","Profile precedence",{"_3634":1999,"_31209":1989,"_5":31544,"_21628":57199,"_28401":57200,"_3085":57201},[],"/docs/platform/pki/certificate-profiles#create-a-profile","Create a profile",{"_3634":2000,"_31209":1989,"_5":31544,"_21628":57203,"_28401":57204,"_3085":57205},[],"/docs/platform/pki/certificate-profiles#define-a-single-purpose","Define a single purpose",{"_3634":2001,"_31209":1989,"_5":31544,"_21628":57207,"_28401":57208,"_3085":57209},[],"/docs/platform/pki/certificate-profiles#choose-the-validity","Choose the validity",{"_3634":2002,"_31209":1989,"_5":31544,"_21628":57211,"_28401":57212,"_3085":57213},[],"/docs/platform/pki/certificate-profiles#fix-usages-and-subject","Fix usages and subject",{"_3634":2003,"_31209":1989,"_5":31544,"_21628":57215,"_28401":57216,"_3085":57217},[],"/docs/platform/pki/certificate-profiles#constrain-the-keys","Constrain the keys",{"_3634":2004,"_31209":1989,"_5":31544,"_21628":57219,"_28401":57220,"_3085":57221},[],"/docs/platform/pki/certificate-profiles#attach-it-and-test","Attach it and test",{"_3634":2005,"_31209":1989,"_5":31544,"_21628":57223,"_28401":57224,"_3085":57225},[],"/docs/platform/pki/certificate-profiles#design-examples","Design examples",{"_3634":2006,"_31209":1989,"_5":31544,"_21628":57227,"_28401":57228,"_3085":57229},[],"/docs/platform/pki/certificate-profiles#changes-and-deletion","Changes and deletion",{"_3634":2007,"_31209":1989,"_21628":57231,"_5":14884,"_28401":1989,"_3085":57232},[],"An issuance profile turns a certificate policy into reusable configuration. Instead of deciding validity, subject, extensions and algorithms on every request, you define once what is allowed and attach the profile to a CA, a DMS or a specific issuance.",{"_3634":2008,"_31209":1989,"_21628":57234,"_5":14884,"_28401":1989,"_3085":57235},[],"This guide is for the PKI administrator defining issuance policy. You need permissions to manage profiles and associate them with the intended CA or DMS, plus a test consumer with known identity and purpose requirements.",{"_3634":2009,"_31209":1989,"_21628":57237,"_5":14884,"_28401":57172,"_3085":57238},[],"You can express the lifetime as a duration from the moment of issuance or as a fixed end date. A duration works well for recurring identities; a common date is useful to make a whole batch end before a migration or retirement.",{"_3634":2010,"_31209":1989,"_21628":57240,"_5":14884,"_28401":57172,"_3085":57241},[],"Plan the end date within the issuing CA’s validity and leave a renewal margin. The signer calculates the date from the profile; it does not automatically clamp validity to the issuer’s expiration. Check both dates in the resulting certificate. A fixed date in the past does not produce a usable identity either.",{"_3634":2011,"_31209":1989,"_21628":57243,"_5":14884,"_28401":57176,"_3085":57244},[],"`Sign as CA` sets `IsCA` and the basic constraints needed for an authority. Lamassu enforces this: a profile with `Sign as CA` is consumed only when creating or reissuing a CA. Any signing request that resolves to such a profile is rejected — direct signing with a CA, including certificate issuance requests on it, and DMS enrollment or re-enrollment. Nothing validates the profile when it is saved: if a CA's default profile or a DMS profile has `Sign as CA` enabled, the problem appears on the first signing request that resolves to it — for a DMS profile, when a device tries to enroll or re-enroll — and renewal stays blocked until the profile is changed.",{"_3634":2012,"_31209":1989,"_21628":57246,"_5":14884,"_28401":57180,"_3085":57247},[],"The profile can enforce usages such as `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` or `OCSPSigning`.",{"_3634":2013,"_31209":1989,"_21628":57249,"_5":14884,"_28401":57180,"_3085":57250},[],"If you enable **Honor Key Usage** or **Honor Extended Key Usages**, Lamassu keeps the values requested by the CSR. If you disable them, it replaces them with the ones defined in the profile.",{"_3634":2014,"_31209":1989,"_21628":57252,"_5":14884,"_28401":57180,"_3085":57253},[],"Do not enable the `Honor…` options for untrusted requests unless another component validates those fields. Otherwise, the requester may choose broader capabilities than intended.",{"_3634":2015,"_31209":1989,"_21628":57255,"_5":14884,"_28401":57184,"_3085":57256},[],"With **Honor Subject**, the certificate keeps the subject of the CSR. Without that option, Lamassu applies the profile's `CN`, `O`, `OU`, `C`, `ST` and `L`. If the profile does not define a `Common Name`, the requested CN is kept.",{"_3634":2016,"_31209":1989,"_21628":57258,"_5":14884,"_28401":57188,"_3085":57259},[],"With **Honor Extensions**, Lamassu filters the additional requested extensions and keeps only SAN. Without that option, it discards the CSR's additional extensions.",{"_3634":2017,"_31209":1989,"_21628":57261,"_5":14884,"_28401":57188,"_3085":57262},[],"This preserves SAN, but does not establish that the requester is entitled to those DNS names, IP addresses, emails or URIs. Validate that authorization before issuing. OCSP and CRL locations come from the issuance service configuration; `Honor Extensions` does not copy CSR distribution points.",{"_3634":2018,"_31209":1989,"_21628":57264,"_5":14884,"_28401":57192,"_3085":57265},[],"The cryptographic enforcement can:",{"_3634":2019,"_31209":1989,"_21628":57267,"_5":14884,"_28401":57192,"_3085":57268},[],"allow or block RSA keys;",{"_3634":2020,"_31209":1989,"_21628":57270,"_5":14884,"_28401":57192,"_3085":57271},[],"limit the supported RSA sizes;",{"_3634":2021,"_31209":1989,"_21628":57273,"_5":14884,"_28401":57192,"_3085":57274},[],"allow or block ECDSA keys;",{"_3634":2022,"_31209":1989,"_21628":57276,"_5":14884,"_28401":57192,"_3085":57277},[],"limit the supported ECDSA sizes or curves.",{"_3634":2023,"_31209":1989,"_21628":57279,"_5":14884,"_28401":57192,"_3085":57280},[],"When it is enabled, Lamassu checks the public key before creating a CA or signing a CSR. A key whose type or size is not listed in the profile is rejected.",{"_3634":2024,"_31209":1989,"_21628":57282,"_5":14884,"_28401":57196,"_3085":57283},[],"Resolution depends on the entry point. One complete profile is selected; its fields are not merged with the CA’s profile.",{"_3634":2025,"_31209":1989,"_21628":57285,"_5":14884,"_28401":57196,"_3085":54454},[],{"_3634":2026,"_31209":1989,"_21628":57287,"_5":14884,"_28401":57196,"_3085":57288},[],"First choice",{"_3634":2027,"_31209":1989,"_21628":57290,"_5":14884,"_28401":57196,"_3085":57291},[],"Second choice",{"_3634":2028,"_31209":1989,"_21628":57293,"_5":14884,"_28401":57196,"_3085":57294},[],"If neither is supplied",{"_3634":2029,"_31209":1989,"_21628":57296,"_5":14884,"_28401":57196,"_3085":57297},[],"Direct signing with a CA",{"_3634":2030,"_31209":1989,"_21628":57299,"_5":14884,"_28401":57196,"_3085":57300},[],"`issuance_profile` embedded in the request",{"_3634":2031,"_31209":1989,"_21628":57302,"_5":14884,"_28401":57196,"_3085":57303},[],"Request `issuance_profile_id`",{"_3634":2032,"_31209":1989,"_21628":57305,"_5":14884,"_28401":57196,"_3085":57306},[],"CA default profile (`profile_id`).",{"_3634":2033,"_31209":1989,"_21628":57308,"_5":14884,"_28401":57196,"_3085":57309},[],"Issuance through a DMS",{"_3634":2034,"_31209":1989,"_21628":57311,"_5":14884,"_28401":57196,"_3085":57312},[],"`settings.issuance_profile_id`",{"_3634":2035,"_31209":1989,"_21628":57314,"_5":14884,"_28401":57196,"_3085":57315},[],"`settings.issuance_profile` embedded in the DMS",{"_3634":2036,"_31209":1989,"_21628":57317,"_5":14884,"_28401":57196,"_3085":57318},[],"Enrollment CA default profile.",{"_3634":2037,"_31209":1989,"_21628":57320,"_5":14884,"_28401":57196,"_3085":57321},[],"If the selected identifier cannot be resolved, the operation fails; it does not silently fall back to the CA’s profile. Avoid setting both options at once. Recording which profile was selected helps explain why a certificate differs from its CSR.",{"_3634":2038,"_31209":1989,"_21628":57323,"_5":14884,"_28401":57196,"_3085":57324},[],"Several fleets can share a CA while keeping different profiles through their DMSs. Requester authentication and device registration policy are configured separately in DMS.",{"_3634":2039,"_31209":1989,"_21628":57326,"_5":14884,"_28401":57204,"_3085":57327},[],"Separate, for example, mTLS devices, servers and intermediate CAs. A small, specific profile is easier to review than one that allows every use.",{"_3634":2040,"_31209":1989,"_21628":57329,"_5":14884,"_28401":57208,"_3085":57330},[],"Align the duration with the fleet's real renewal capacity. Leave margin against the CA's expiration.",{"_3634":2041,"_31209":1989,"_21628":57332,"_5":14884,"_28401":57212,"_3085":57333},[],"For a device that authenticates as a client, the usual starting point is `DigitalSignature` and `ClientAuth`. Add `ServerAuth` or `KeyEncipherment` only if the protocol needs it.",{"_3634":2042,"_31209":1989,"_21628":57335,"_5":14884,"_28401":57216,"_3085":57336},[],"Enable cryptographic enforcement and list only algorithms and sizes compatible with your policy and your devices.",{"_3634":2043,"_31209":1989,"_21628":57338,"_5":14884,"_28401":57220,"_3085":57339},[],"Attach the profile to a CA or DMS and check the precedence above. Issue a CSR with known usages and SAN; inspect the result with `openssl x509 -in device.crt -noout -text`. Check subject, SAN, KU, EKU and dates. For an end-entity identity, disable `Sign as CA`, require no `CA:TRUE` or `Certificate Sign`, and require `CA:FALSE` if Basic Constraints is present.",{"_3634":2044,"_31209":1989,"_21628":57341,"_5":14884,"_28401":57220,"_3085":57342},[],"Also try a key excluded by policy: issuance should fail. Follow the certificate verification and test acceptance in the intended consumer.",{"_3634":2045,"_31209":1989,"_21628":57344,"_5":14884,"_28401":57224,"_3085":57345},[],"**mTLS device**\\\nEnd-entity certificate, short validity, `DigitalSignature`, `ClientAuth`, subject controlled by the DMS and SAN allowed when it identifies the device.",{"_3634":2046,"_31209":1989,"_21628":57347,"_5":14884,"_28401":57224,"_3085":57348},[],"**TLS server**\\\nEnd-entity certificate, `DigitalSignature`, `ServerAuth` and mandatory SAN with the names clients will use.",{"_3634":2047,"_31209":1989,"_21628":57350,"_5":14884,"_28401":57224,"_3085":57351},[],"**Intermediate CA**\\\n`Sign as CA`, `CertSign` and `CRLSign`, validity longer than its end-entity certificates and stricter cryptographic constraints.",{"_3634":2048,"_31209":1989,"_21628":57353,"_5":14884,"_28401":57224,"_3085":57354},[],"These patterns express design decisions. Enabling `Honor Extensions` does not require a CSR to contain SAN or validate its names; enforce that in the request workflow. A profile does not install trust or grant permissions in the consumer.",{"_3634":2049,"_31209":1989,"_21628":57356,"_5":14884,"_28401":57228,"_3085":57357},[],"Updating a profile affects future issuances; it does not modify already-signed certificates. Test changes before applying them to a CA in production and keep the operational justification.",{"_3634":2050,"_31209":1989,"_21628":57359,"_5":14884,"_28401":57228,"_3085":57360},[],"Before deleting a profile, check that no CA or DMS depends on it. If you want to replace it, create the new version, update the references and perform a test issuance before retiring the old one.",{"_3634":2051,"_31209":2051,"_5":15244,"_3085":57362,"_31547":57363,"_21628":57365,"_28401":2051},"Certificate validation",[50999,52511,56691,57364],"Validation",[],{"_3634":2052,"_31209":2051,"_21628":57367,"_5":14884,"_28401":2051,"_3085":57368},[],"Check chain, identity, purpose and revocation from the consumer.",{"_3634":2053,"_31209":2051,"_5":31544,"_21628":57370,"_28401":57371,"_3085":57372},[],"/docs/platform/pki/certificate-validation#before-querying-status","Before querying status",{"_3634":2054,"_31209":2051,"_5":31544,"_21628":57374,"_28401":57375,"_3085":57376},[],"/docs/platform/pki/certificate-validation#choose-a-mechanism","Choose a mechanism",{"_3634":2055,"_31209":2051,"_5":31544,"_21628":57378,"_28401":57379,"_3085":57380},[],"/docs/platform/pki/certificate-validation#check-consumer-behavior","Check consumer behavior",{"_3634":2056,"_31209":2051,"_21628":57382,"_5":14884,"_28401":2051,"_3085":57383},[],"This guide brings together the checks needed when integrating a certificate consumer. You need the presented certificate, intermediates and roots that your application has deliberately chosen to trust. Lamassu publishes status; the consumer applies acceptance policy.",{"_3634":2057,"_31209":2051,"_21628":57385,"_5":14884,"_28401":57371,"_3085":57386},[],"Verify these criteria together:",{"_3634":2058,"_31209":2051,"_21628":57388,"_5":14884,"_28401":57371,"_3085":56317},[],{"_3634":2059,"_31209":2051,"_21628":57390,"_5":14884,"_28401":57371,"_3085":57391},[],"Required result",{"_3634":2060,"_31209":2051,"_21628":57393,"_5":14884,"_28401":57371,"_3085":57394},[],"Chain and signature",{"_3634":2061,"_31209":2051,"_21628":57396,"_5":14884,"_28401":57371,"_3085":57397},[],"Valid chain to a root deliberately installed in the consumer.",{"_3634":2062,"_31209":2051,"_21628":57399,"_5":14884,"_28401":57371,"_3085":57400},[],"Dates",{"_3634":2063,"_31209":2051,"_21628":57402,"_5":14884,"_28401":57371,"_3085":57403},[],"Current time between `Not Before` and `Not After`, including the CAs in the chain.",{"_3634":2064,"_31209":2051,"_21628":57405,"_5":14884,"_28401":57371,"_3085":52180},[],{"_3634":2065,"_31209":2051,"_21628":57407,"_5":14884,"_28401":57371,"_3085":57408},[],"Name, SAN or identifier matches the expected peer.",{"_3634":2066,"_31209":2051,"_21628":57410,"_5":14884,"_28401":57371,"_3085":51389},[],{"_3634":2067,"_31209":2051,"_21628":57412,"_5":14884,"_28401":57371,"_3085":57413},[],"KU, EKU and constraints permit the specific operation.",{"_3634":2068,"_31209":2051,"_21628":57415,"_5":14884,"_28401":57371,"_3085":57416},[],"Revocation",{"_3634":2069,"_31209":2051,"_21628":57418,"_5":14884,"_28401":57371,"_3085":57419},[],"Signed, current evidence corresponding to the queried issuer and certificate.",{"_3634":2070,"_31209":2051,"_21628":57421,"_5":14884,"_28401":57371,"_3085":57422},[],"Authorization",{"_3634":2071,"_31209":2051,"_21628":57424,"_5":14884,"_28401":57371,"_3085":57425},[],"The application permits that identity to perform the action.",{"_3634":2072,"_31209":2051,"_21628":57427,"_5":14884,"_28401":57371,"_3085":57428},[],"The issuance walkthrough checks chain and purpose with OpenSSL. That check does not automatically query OCSP or download a CRL. Inventory presence or an OCSP `Good` response does not replace the other criteria.",{"_3634":2073,"_31209":2051,"_21628":57430,"_5":14884,"_28401":57375,"_3085":57431},[],"Mechanism",{"_3634":2074,"_31209":2051,"_21628":57433,"_5":14884,"_28401":57375,"_3085":57434},[],"When to use it",{"_3634":2075,"_31209":2051,"_21628":57436,"_5":14884,"_28401":57375,"_3085":57437},[],"What you must maintain",{"_3634":2076,"_31209":2051,"_21628":57439,"_5":14884,"_28401":57375,"_3085":57440},[],"OCSP",{"_3634":2077,"_31209":2051,"_21628":57442,"_5":14884,"_28401":57375,"_3085":57443},[],"Status query for a specific certificate.",{"_3634":2078,"_31209":2051,"_21628":57445,"_5":14884,"_28401":57375,"_3085":57446},[],"Responder access, signature verification and cache/freshness policy.",{"_3634":2079,"_31209":2051,"_21628":57448,"_5":14884,"_28401":57375,"_3085":57449},[],"CRL",{"_3634":2080,"_31209":2051,"_21628":57451,"_5":14884,"_28401":57375,"_3085":57452},[],"Local checks for many certificates or offline operation.",{"_3634":2081,"_31209":2051,"_21628":57454,"_5":14884,"_28401":57375,"_3085":57455},[],"Periodic download of an issuer-signed list and rejection of expired lists.",{"_3634":2082,"_31209":2051,"_21628":57457,"_5":14884,"_28401":57375,"_3085":57458},[],"OCSP can also return a response reusable until `nextUpdate`; a CRL changes when a new version is published. Neither mechanism alone guarantees that a consumer learns a revocation at the moment it is saved.",{"_3634":2083,"_31209":2051,"_21628":57460,"_5":14884,"_28401":57375,"_3085":57461},[],"If using both, define when fallback is allowed and what the client does when retrieval, signature or freshness checks fail, or the result is `Unknown`. Accepting an identity when its status cannot be checked must be an explicit application decision.",{"_3634":2084,"_31209":2051,"_21628":57463,"_5":14884,"_28401":57379,"_3085":57464},[],"Accept a current, authorized certificate with a known chain.",{"_3634":2085,"_31209":2051,"_21628":57466,"_5":14884,"_28401":57379,"_3085":57467},[],"Reject another certificate with an unknown root or incompatible purpose.",{"_3634":2086,"_31209":2051,"_21628":57469,"_5":14884,"_28401":57379,"_3085":57470},[],"Revoke a test certificate and verify the OCSP response or new CRL.",{"_3634":2087,"_31209":2051,"_21628":57472,"_5":14884,"_28401":57379,"_3085":57473},[],"Check that a new connection with that identity is rejected.",{"_3634":2088,"_31209":2051,"_21628":57475,"_5":14884,"_28401":57379,"_3085":57476},[],"Simulate an unreachable endpoint and expired evidence; observe whether the result matches policy.",{"_3634":2089,"_31209":2051,"_21628":57478,"_5":14884,"_28401":57379,"_3085":57479},[],"Keep the serial number, issuer, revocation reason, query time and evidence timestamps. An existing session may need explicit closure or reauthentication in the consumer; publishing revocation does not automatically close it.",{"_3634":2090,"_31209":2051,"_21628":57481,"_5":14884,"_28401":57379,"_3085":57482},[],"For a chain with intermediates, validate their status according to consumer policy as well. An end-entity issuer’s CRL does not replace checks on every CA in the chain.",{"_3634":2091,"_31209":2051,"_21628":57484,"_5":14884,"_28401":57379,"_3085":57485},[],"<Card title=\"Online validation with OCSP\" description=\"Generate a query and verify signature, status and timestamps.\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":2092,"_31209":2051,"_21628":57487,"_5":14884,"_28401":57379,"_3085":57488},[],"<Card title=\"Revocation lists\" description=\"Download, inspect and use an issuer’s CRL.\" href=\"/docs/platform/pki/crl\" />",{"_3634":2093,"_31209":2093,"_5":15244,"_3085":57490,"_31547":57491,"_21628":57492,"_28401":2093},"Certificates",[50999,52511,56691,56692],[],{"_3634":2094,"_31209":2093,"_21628":57494,"_5":14884,"_28401":2093,"_3085":57495},[],"Inspect, download and revoke the certificates issued by Lamassu.",{"_3634":2095,"_31209":2093,"_5":31544,"_21628":57497,"_28401":57498,"_3085":57499},[],"/docs/platform/pki/certificates#find-a-certificate","Find a certificate",{"_3634":2096,"_31209":2093,"_5":31544,"_21628":57501,"_28401":57502,"_3085":57503},[],"/docs/platform/pki/certificates#download-the-certificate","Download the certificate",{"_3634":2097,"_31209":2093,"_5":31544,"_21628":57505,"_28401":57506,"_3085":57507},[],"/docs/platform/pki/certificates#issue-from-an-existing-csr","Issue from an existing CSR",{"_3634":2098,"_31209":2093,"_5":31544,"_21628":57509,"_28401":57510,"_3085":57511},[],"/docs/platform/pki/certificates#revoke-a-certificate","Revoke a certificate",{"_3634":2099,"_31209":2093,"_5":31544,"_21628":57513,"_28401":57514,"_3085":57515},[],"/docs/platform/pki/certificates#open-the-action","Open the action",{"_3634":2100,"_31209":2093,"_5":31544,"_21628":57517,"_28401":57518,"_3085":57519},[],"/docs/platform/pki/certificates#choose-a-reason","Choose a reason",{"_3634":2101,"_31209":2093,"_5":31544,"_21628":57521,"_28401":57522,"_3085":57523},[],"/docs/platform/pki/certificates#confirm-and-verify","Confirm and verify",{"_3634":2102,"_31209":2093,"_5":31544,"_21628":57525,"_28401":57526,"_3085":57527},[],"/docs/platform/pki/certificates#reactivate-a-hold","Reactivate a hold",{"_3634":2103,"_31209":2093,"_5":31544,"_21628":57529,"_28401":57530,"_3085":57531},[],"/docs/platform/pki/certificates#continue","Continue",{"_3634":2104,"_31209":2093,"_21628":57533,"_5":14884,"_28401":2093,"_3085":57534},[],"This guide is for a PKI operator inspecting or retiring an issued identity. You need inventory access and, to change states, permissions on the certificate. Open **Certificates** for a global view or **Issued Certificates** within a CA to restrict it to that issuer.",{"_3634":2105,"_31209":2093,"_21628":57536,"_5":14884,"_28401":57498,"_3085":57537},[],"Filter by `Common Name`, serial, status and issuer. A certificate does not contain its private key, so the private-key surfaces answer which certificates have their key held in Lamassu’s KMS:",{"_3634":2106,"_31209":2093,"_21628":57539,"_5":14884,"_28401":57498,"_3085":57540},[],"The advanced **Private Key** filter, available on the Certificates page and on a CA’s **Issued Certificates** tab, narrows the list to **All Certificates**, **With Private Key** or **Without Private Key**.",{"_3634":2107,"_31209":2093,"_21628":57542,"_5":14884,"_28401":57498,"_3085":57543},[],"The sortable **Private Key** column — shown by default, hidden on narrow screens — marks a key held in the KMS with a green check mark and otherwise shows `-`.",{"_3634":2108,"_31209":2093,"_21628":57545,"_5":14884,"_28401":57498,"_3085":57546},[],"In certificate details, the **Information** tab shows a **Private Key** row in the **Key & Signature** section. When the certificate reports a private key and its KMS engine and key IDs are available, the row links to the key (tooltip: **Open private key in KMS**). Otherwise, it shows **Present** if the certificate reports a private key, or **Not available** if it does not. This does not establish whether a key exists outside Lamassu.",{"_3634":2109,"_31209":2093,"_21628":57548,"_5":14884,"_28401":57498,"_3085":57549},[],"Use **Quick Inspect** for a quick review or **View Details** for subject, SAN, usages, chain, dates and metadata.",{"_3634":2110,"_31209":2093,"_21628":57551,"_5":14884,"_28401":57498,"_3085":57552},[],"Certificate records expose `key_id` (the KMS key that holds the private key, empty when the KMS does not hold it) and `has_private_key` (derived at read time from the KMS). Certificate and CA listings accept a `has_private_key` filter, which is useful, for example, to check the result of the CA-to-KMS migration of the 4.0.0 upgrade.",{"_3634":2111,"_31209":2093,"_21628":57554,"_5":14884,"_28401":57498,"_3085":57555},[],"Identify a certificate by issuer and serial; a name can correspond to several renewals. Check which certificate the consumer actually uses and which occupies the device’s active identity. Identity history and the certificate inventory answer different questions.",{"_3634":2112,"_31209":2093,"_21628":57557,"_5":14884,"_28401":57502,"_3085":57558},[],"Download the PEM and inspect it:",{"_3634":2113,"_31209":2093,"_21628":57560,"_5":14884,"_28401":57502,"_3085":57561},[],"Check issuance policy, chain and usages with the verification walkthrough. A certificate does not contain its private key. For an external CSR, the key remains where it was generated; for the browser flow, retain the file downloaded upon issuance. If the key is lost, plan a new identity rather than expecting recovery from the certificate.",{"_3634":2114,"_31209":2093,"_21628":57563,"_5":14884,"_28401":57506,"_3085":57564},[],"Use this flow when the identity’s key must remain on the system that generated it. You need an active CA with a usable key, a PEM CSR and a suitable profile.",{"_3634":2115,"_31209":2093,"_21628":57566,"_5":14884,"_28401":57506,"_3085":57567},[],"Verify the request with `openssl req -in request.csr -noout -verify -text`. Review subject, SAN and algorithm, and authorize the requested identity.",{"_3634":2116,"_31209":2093,"_21628":57569,"_5":14884,"_28401":57506,"_3085":57570},[],"Start issuance from the CA or inventory and select **Upload Existing CSR**.",{"_3634":2117,"_31209":2093,"_21628":57572,"_5":14884,"_28401":57506,"_3085":57573},[],"Confirm the CA and profile resolved according to Profiles; the request does not guarantee that every field is retained.",{"_3634":2118,"_31209":2093,"_21628":57575,"_5":14884,"_28401":57506,"_3085":57576},[],"Download the certificate and inspect dates, issuer, subject, SAN, KU and EKU. Check correspondence with the private key on the originating system.",{"_3634":2119,"_31209":2093,"_21628":57578,"_5":14884,"_28401":57506,"_3085":57579},[],"Install certificate and chain in the intended consumer and test a connection. Issuance alone does not register a device or grant access in an integration.",{"_3634":2120,"_31209":2093,"_21628":57581,"_5":14884,"_28401":57506,"_3085":57582},[],"For browser key generation, follow Issue your first certificate.",{"_3634":2121,"_31209":2093,"_21628":57584,"_5":14884,"_28401":57510,"_3085":57585},[],"Revoke when the key is compromised, the subject is no longer authorized or the identity must stop being accepted before expiration. Before changing status, identify consumers and prepare any required replacement.",{"_3634":2122,"_31209":2093,"_21628":57587,"_5":14884,"_28401":57514,"_3085":57588},[],"Locate the correct issuer and serial and select **Revoke Certificate**. `EXPIRED` records and records revoked for a final reason reject subsequent status changes.",{"_3634":2123,"_31209":2093,"_21628":57590,"_5":14884,"_28401":57518,"_3085":57591},[],"Select the incident reason. `CertificateHold` represents a reversible certificate suspension; other reasons block later changes. Do not use a suspension to address a compromised key.",{"_3634":2124,"_31209":2093,"_21628":57593,"_5":14884,"_28401":57522,"_3085":57594},[],"Save the change and read the record again: require **REVOKED**, reason and timestamp. Then verify a fresh OCSP query and, if using CRL, its published version and the serial’s presence. Finally check rejection of a new connection in the consumer.",{"_3634":2125,"_31209":2093,"_21628":57596,"_5":14884,"_28401":57522,"_3085":57597},[],"Revocation does not erase the certificate, delete the key or guarantee closure of existing sessions. Status and publication are separate steps.",{"_3634":2126,"_31209":2093,"_21628":57599,"_5":14884,"_28401":57522,"_3085":57600},[],"A certificate revoked with `CertificateHold` can be reactivated if it is not in `EXPIRED` state. Its dates and consumer trust remain mandatory.",{"_3634":2127,"_31209":2093,"_21628":57602,"_5":14884,"_28401":57526,"_3085":57603},[],"Check that the saved reason is `CertificateHold` and the identity still satisfies policy. Request `ACTIVE` through the status update operation exposed by your installation; consult the API reference. Do not assume changing consumer permissions also changes status in Lamassu.",{"_3634":2128,"_31209":2093,"_21628":57605,"_5":14884,"_28401":57526,"_3085":57606},[],"Read the record and query OCSP again. With `regenerate_on_revoke` enabled, the reactivation event requests CRL regeneration: check that the new list omits the serial. An earlier list can still mark it revoked until the client refreshes its copy.",{"_3634":2129,"_31209":2093,"_21628":57608,"_5":14884,"_28401":57526,"_3085":57609},[],"This does not undo permanent revocation or the cascade of a CA revoked for good; the hold cascaded by a CA is lifted by releasing that CA.",{"_3634":2130,"_31209":2093,"_21628":57611,"_5":14884,"_28401":57530,"_3085":57612},[],"<Card title=\"Validate with OCSP\" description=\"Query and verify a certificate’s signed status.\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":2131,"_31209":2093,"_21628":57614,"_5":14884,"_28401":57530,"_3085":57615},[],"<Card title=\"Distribute a CRL\" description=\"Publish status for local validation.\" href=\"/docs/platform/pki/crl\" />",{"_3634":2132,"_31209":2132,"_5":15244,"_3085":57617,"_31547":57618,"_21628":57620,"_28401":2132},"Certificate lifecycle",[50999,52511,56691,57619],"Concepts",[],{"_3634":2133,"_31209":2132,"_21628":57622,"_5":14884,"_28401":2132,"_3085":57623},[],"Issuance, use, renewal, revocation and retirement of certificates in Lamassu.",{"_3634":2134,"_31209":2132,"_5":31544,"_21628":57625,"_28401":57626,"_3085":57627},[],"/docs/platform/pki/concepts/certificate-lifecycle#the-full-journey","The full journey",{"_3634":2135,"_31209":2132,"_5":31544,"_21628":57629,"_28401":57630,"_3085":57631},[],"/docs/platform/pki/concepts/certificate-lifecycle#request","Request",{"_3634":2136,"_31209":2132,"_5":31544,"_21628":57633,"_28401":57634,"_3085":57635},[],"/docs/platform/pki/concepts/certificate-lifecycle#issuance","Issuance",{"_3634":2137,"_31209":2132,"_5":31544,"_21628":57637,"_28401":57638,"_3085":57639},[],"/docs/platform/pki/concepts/certificate-lifecycle#use-and-monitoring","Use and monitoring",{"_3634":2138,"_31209":2132,"_5":31544,"_21628":57641,"_28401":57642,"_3085":57643},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-or-re-enrollment","Renewal or re-enrollment",{"_3634":2139,"_31209":2132,"_5":31544,"_21628":57645,"_28401":57646,"_3085":57647},[],"/docs/platform/pki/concepts/certificate-lifecycle#revocation-or-retirement","Revocation or retirement",{"_3634":2140,"_31209":2132,"_5":31544,"_21628":57649,"_28401":57650,"_3085":57651},[],"/docs/platform/pki/concepts/certificate-lifecycle#certificate-states","Certificate states",{"_3634":2141,"_31209":2132,"_5":31544,"_21628":57653,"_28401":57654,"_3085":57655},[],"/docs/platform/pki/concepts/certificate-lifecycle#renewal-and-revocation-are-not-equivalent","Renewal and revocation are not equivalent",{"_3634":2142,"_31209":2132,"_5":31544,"_21628":57657,"_28401":57658,"_3085":57659},[],"/docs/platform/pki/concepts/certificate-lifecycle#effect-of-revoking-a-ca","Effect of revoking a CA",{"_3634":2143,"_31209":2132,"_5":31544,"_21628":57661,"_28401":57662,"_3085":57663},[],"/docs/platform/pki/concepts/certificate-lifecycle#what-you-should-watch","What you should watch",{"_3634":2144,"_31209":2132,"_21628":57665,"_5":14884,"_28401":2132,"_3085":57666},[],"Issuing a certificate is only the beginning. During its useful life you must check its validity, renew it before it expires and retire it when it stops being trustworthy. Lamassu keeps the certificate, its issuing CA, its status and, when it belongs to a device, the identity it is linked to.",{"_3634":2145,"_31209":2132,"_21628":57668,"_5":14884,"_28401":57630,"_3085":57669},[],"The requester generates a key and a CSR. In the recommended flows, the private key stays in the device, browser or cryptographic engine that created it.",{"_3634":2146,"_31209":2132,"_21628":57671,"_5":14884,"_28401":57634,"_3085":57672},[],"The CA signs the CSR. The issuance profile determines the validity, uses, subject, allowed extensions and cryptographic constraints.",{"_3634":2147,"_31209":2132,"_21628":57674,"_5":14884,"_28401":57638,"_3085":57675},[],"The certificate enters the `ACTIVE` state. Lamassu monitors its `Not After` date; the cryptographic monitoring job marks certificates that have expired as `EXPIRED`.",{"_3634":2148,"_31209":2132,"_21628":57677,"_5":14884,"_28401":57642,"_3085":57678},[],"A new certificate is issued before the previous one expires. In a DMS you can open preventive and critical windows so the device re-enrolls through EST.",{"_3634":2149,"_31209":2132,"_21628":57680,"_5":14884,"_28401":57646,"_3085":57681},[],"If the identity stops being trustworthy, Lamassu records the reason and time of revocation. OCSP and CRLs let consumers learn that status.",{"_3634":2150,"_31209":2132,"_21628":57683,"_5":14884,"_28401":57650,"_3085":57684},[],"Lamassu persists four X.509 states:",{"_3634":2151,"_31209":2132,"_21628":57686,"_5":14884,"_28401":57650,"_3085":57687},[],"**`ACTIVE`**: the record is enabled. Also check `Not Before` and `Not After`: this state does not establish time validity.",{"_3634":2152,"_31209":2132,"_21628":57689,"_5":14884,"_28401":57650,"_3085":57690},[],"**`EXPIRED`**: it has passed its expiration date. The monitor detects this periodically; it is not a state that should be assigned manually.",{"_3634":2153,"_31209":2132,"_21628":57692,"_5":14884,"_28401":57650,"_3085":57693},[],"**`REVOKED`**: it was invalidated before expiring, with a reason and a timestamp.",{"_3634":2154,"_31209":2132,"_21628":57695,"_5":14884,"_28401":57650,"_3085":57696},[],"**`INACTIVE`**: it is disabled without representing a definitive revocation.",{"_3634":2155,"_31209":2132,"_21628":57698,"_5":14884,"_28401":57650,"_3085":57699},[],"The device view may add operational states such as missing identity, pending renewal, expiring soon or decommissioned. These are an interpretation of the device's status and its certificates, not new X.509 states.",{"_3634":2156,"_31209":2132,"_21628":57701,"_5":14884,"_28401":57654,"_3085":57702},[],"**Renewal** creates a successor certificate for an identity that remains valid. **Revocation** communicates that the current certificate must no longer be accepted. Renew to maintain continuity; revoke in response to compromise, retirement or a change that invalidates the identity.",{"_3634":2157,"_31209":2132,"_21628":57704,"_5":14884,"_28401":57654,"_3085":57705},[],"Only `CertificateHold` allows reactivating a revoked certificate that is not in `EXPIRED` state. Revocation for another reason blocks subsequent status changes. `EXPIRED` records also reject changes; the consumer must check dates even before the monitor updates the state. Certificates explains how to verify revocation and reactivation.",{"_3634":2158,"_31209":2132,"_21628":57707,"_5":14884,"_28401":57654,"_3085":57708},[],"The **Reissue CA** operation generates another certificate for the same key and links both serial numbers through metadata. It is not a key rotation. To change the key, create a successor CA and perform a migration with an overlapping period.",{"_3634":2159,"_31209":2132,"_21628":57710,"_5":14884,"_28401":57658,"_3085":57711},[],"Revoking a CA starts a cascade that attempts to revoke descendants. A `CertificateHold` cascade suspends them reversibly: releasing the CA restores those still on hold. Any other revocation reason revokes descendants permanently with `CessationOfOperation`. Read Hierarchy and rotation for conditions and checks.",{"_3634":2160,"_31209":2132,"_21628":57713,"_5":14884,"_28401":57658,"_3085":57714},[],"Before confirming:",{"_3634":2161,"_31209":2132,"_21628":57716,"_5":14884,"_28401":57658,"_3085":57717},[],"Identify DMSs, devices and services that trust that chain.",{"_3634":2162,"_31209":2132,"_21628":57719,"_5":14884,"_28401":57658,"_3085":57720},[],"Distribute the new chain of trust.",{"_3634":2163,"_31209":2132,"_21628":57722,"_5":14884,"_28401":57658,"_3085":57723},[],"Reissue the necessary identities.",{"_3634":2164,"_31209":2132,"_21628":57725,"_5":14884,"_28401":57658,"_3085":57726},[],"Check OCSP and CRL from a real consumer.",{"_3634":2165,"_31209":2132,"_21628":57728,"_5":14884,"_28401":57658,"_3085":57729},[],"Revoke the old CA once no legitimate traffic remains.",{"_3634":2166,"_31209":2132,"_21628":57731,"_5":14884,"_28401":57658,"_3085":57732},[],"Device retirement belongs to the IoT Fleets lifecycle. It affects the active identity; it does not automatically traverse and revoke every historical certificate. Review previous identities and consumer permissions separately in Device management.",{"_3634":2167,"_31209":2132,"_21628":57734,"_5":14884,"_28401":57662,"_3085":57735},[],"Certificates entering the preventive or critical renewal window.",{"_3634":2168,"_31209":2132,"_21628":57737,"_5":14884,"_28401":57662,"_3085":57738},[],"Repeated enrollment or re-enrollment failures.",{"_3634":2169,"_31209":2132,"_21628":57740,"_5":14884,"_28401":57662,"_3085":57741},[],"Status changes and revocation reasons.",{"_3634":2170,"_31209":2132,"_21628":57743,"_5":14884,"_28401":57662,"_3085":57744},[],"OCSP and CRL publication and validity.",{"_3634":2171,"_31209":2132,"_21628":57746,"_5":14884,"_28401":57662,"_3085":57747},[],"Dependencies still presenting a replaced certificate.",{"_3634":2172,"_31209":2132,"_21628":57749,"_5":14884,"_28401":57662,"_3085":57750},[],"The device history relates its previous and current identities. For administrative changes and mutation errors, see Audit logs.",{"_3634":2173,"_31209":2173,"_5":15244,"_3085":57752,"_31547":57753,"_21628":57754,"_28401":2173},"Trust model",[50999,52511,56691,57619],[],{"_3634":2174,"_31209":2173,"_21628":57756,"_5":14884,"_28401":2173,"_3085":57757},[],"Understand where trust originates, how it is distributed and what each component validates.",{"_3634":2175,"_31209":2173,"_5":31544,"_21628":57759,"_28401":57760,"_3085":57761},[],"/docs/platform/pki/concepts/trust-model#the-four-trust-decisions","The four trust decisions",{"_3634":2176,"_31209":2173,"_5":31544,"_21628":57763,"_28401":57764,"_3085":57765},[],"/docs/platform/pki/concepts/trust-model#who-can-issue","Who can issue",{"_3634":2177,"_31209":2173,"_5":31544,"_21628":57767,"_28401":57768,"_3085":57769},[],"/docs/platform/pki/concepts/trust-model#what-can-be-issued","What can be issued",{"_3634":2178,"_31209":2173,"_5":31544,"_21628":57771,"_28401":57772,"_3085":57773},[],"/docs/platform/pki/concepts/trust-model#who-can-request-it","Who can request it",{"_3634":2179,"_31209":2173,"_5":31544,"_21628":57775,"_28401":57776,"_3085":57777},[],"/docs/platform/pki/concepts/trust-model#who-accepts-the-result","Who accepts the result",{"_3634":2180,"_31209":2173,"_5":31544,"_21628":57779,"_28401":57780,"_3085":57781},[],"/docs/platform/pki/concepts/trust-model#identity-flow","Identity flow",{"_3634":2181,"_31209":2173,"_5":31544,"_21628":57783,"_28401":57784,"_3085":57785},[],"/docs/platform/pki/concepts/trust-model#enrollment-validation-and-distribution-cas","Enrollment, validation and distribution CAs",{"_3634":2182,"_31209":2173,"_5":31544,"_21628":57787,"_28401":57788,"_3085":57789},[],"/docs/platform/pki/concepts/trust-model#validation-and-revocation","Validation and revocation",{"_3634":2183,"_31209":2173,"_5":31544,"_21628":57791,"_28401":57792,"_3085":57793},[],"/docs/platform/pki/concepts/trust-model#custody-limits","Custody limits",{"_3634":2184,"_31209":2173,"_5":31544,"_21628":57795,"_28401":57796,"_3085":57797},[],"/docs/platform/pki/concepts/trust-model#recommended-pattern","Recommended pattern",{"_3634":2185,"_31209":2173,"_21628":57799,"_5":14884,"_28401":2173,"_3085":57800},[],"In Lamassu, trust does not simply mean that a certificate exists in the inventory. A consumer trusts an identity when it can build a chain to a root it recognizes, check that the certificate is fit for the intended use and verify that it is still valid.",{"_3634":2186,"_31209":2173,"_21628":57802,"_5":14884,"_28401":57764,"_3085":57803},[],"The CA hierarchy defines which authorities can sign. A root CA establishes the anchor of trust; intermediate CAs separate operating domains and avoid using the root for every issuance.",{"_3634":2187,"_31209":2173,"_21628":57805,"_5":14884,"_28401":57768,"_3085":57806},[],"Certificate profiles limit validity, subject, uses, extensions and cryptographic parameters. Possessing a CA does not replace an issuance policy.",{"_3634":2188,"_31209":2173,"_21628":57808,"_5":14884,"_28401":57772,"_3085":57809},[],"The DMS acts as the enrollment point. It can authenticate an EST request with a client certificate, an external webhook or a combination of both. CAs configured to validate the requester do not have to be the CA that will issue the new identity.",{"_3634":2189,"_31209":2173,"_21628":57811,"_5":14884,"_28401":57776,"_3085":57812},[],"The consumer keeps its own trust store. EST `/cacerts` can distribute the service TLS certificate, the enrollment CA and selected managed CAs. Initial trust for authenticating that service must come from an already trusted channel. Download and inspect the contents: do not assume they form a complete chain or install every entry as a root.",{"_3634":2190,"_31209":2173,"_21628":57814,"_5":14884,"_28401":57780,"_3085":57815},[],"The device proves it can enroll according to the DMS policy.",{"_3634":2191,"_31209":2173,"_21628":57817,"_5":14884,"_28401":57780,"_3085":57818},[],"The DMS validates the request and forwards the CSR to the enrollment CA.",{"_3634":2192,"_31209":2173,"_21628":57820,"_5":14884,"_28401":57780,"_3085":57821},[],"In the device-generated CSR flow, the CA applies the profile and signs without receiving the device’s private key.",{"_3634":2193,"_31209":2173,"_21628":57823,"_5":14884,"_28401":57780,"_3085":57824},[],"The device installs the certificate and the chain it needs.",{"_3634":2194,"_31209":2173,"_21628":57826,"_5":14884,"_28401":57780,"_3085":57827},[],"The system that trusts the device validates the chain, dates, uses and revocation status.",{"_3634":2195,"_31209":2173,"_21628":57829,"_5":14884,"_28401":57780,"_3085":57830},[],"OIDC or X.509 identifies the operator calling Lamassu. The authorization service decides which actions it may perform. The X.509 hierarchy, on the other hand, determines whether a certificate presented by a device is trustworthy.",{"_3634":2196,"_31209":2173,"_21628":57832,"_5":14884,"_28401":57784,"_3085":57833},[],"A DMS relates three sets that are worth designing separately:",{"_3634":2197,"_31209":2173,"_21628":57835,"_5":14884,"_28401":57784,"_3085":57836},[],"**Enrollment CA:** signs the new identities.",{"_3634":2198,"_31209":2173,"_21628":57838,"_5":14884,"_28401":57784,"_3085":57839},[],"**Validation CAs:** authenticate the client certificates used for enrollment or migration. During re-enrollment, the enrollment CA is always trusted and Lamassu then tries the validation CAs configured in the re-enrollment block; those are optional.",{"_3634":2199,"_31209":2173,"_21628":57841,"_5":14884,"_28401":57784,"_3085":57842},[],"**Distributed CAs:** form the content the device obtains through EST `/cacerts`. You can include the service TLS certificate, the enrollment CA and an explicit list of managed CAs. Including the issuer does not automatically add all its ancestors.",{"_3634":2200,"_31209":2173,"_21628":57844,"_5":14884,"_28401":57784,"_3085":57845},[],"This separation makes it possible to migrate a fleet: you temporarily accept certificates from the old hierarchy, issue with the new one and distribute both chains during the overlap.",{"_3634":2201,"_31209":2173,"_21628":57847,"_5":14884,"_28401":57788,"_3085":57848},[],"A valid chain does not by itself guarantee that a certificate should be accepted. The consumer must also check:",{"_3634":2202,"_31209":2173,"_21628":57850,"_5":14884,"_28401":57788,"_3085":57851},[],"that the current date is between `Not Before` and `Not After`;",{"_3634":2203,"_31209":2173,"_21628":57853,"_5":14884,"_28401":57788,"_3085":57854},[],"that `Key Usage` and `Extended Key Usage` allow the operation;",{"_3634":2204,"_31209":2173,"_21628":57856,"_5":14884,"_28401":57788,"_3085":57857},[],"that names, SANs and subject match the expected identity;",{"_3634":2205,"_31209":2173,"_21628":57859,"_5":14884,"_28401":57788,"_3085":57860},[],"that the certificate does not appear revoked in OCSP or a CRL.",{"_3634":2206,"_31209":2173,"_21628":57862,"_5":14884,"_28401":57788,"_3085":57863},[],"An OCSP `Good` status does not replace chain, date, usage and identity checks either; Validation brings those criteria together.",{"_3634":2207,"_31209":2173,"_21628":57865,"_5":14884,"_28401":57788,"_3085":57866},[],"During the mTLS authentication of a DMS, Lamassu checks revocation and fails closed: a certificate whose revocation cannot be verified is rejected by default. The `allow_unverifiable_revocation` option of the DMS (see DMS) is the opt-out, and it only relaxes certificates that carry no OCSP/CRL endpoint at all. Design your profiles and distribution points so that the check succeeds.",{"_3634":2208,"_31209":2173,"_21628":57868,"_5":14884,"_28401":57792,"_3085":57869},[],"The KMS keeps the reference to the key and delegates the operation to the configured engine. With an HSM or a cloud KMS, the private key can remain non-exportable. That protects custody, but it does not by itself prevent misuse: you still must restrict who can request a signature and audit those operations.",{"_3634":2209,"_31209":2173,"_21628":57871,"_5":14884,"_28401":57796,"_3085":57872},[],"Keep the root out of daily operations, or with very restricted access.",{"_3634":2210,"_31209":2173,"_21628":57874,"_5":14884,"_28401":57796,"_3085":57875},[],"Issue from intermediate CAs separated by environment or risk domain.",{"_3634":2211,"_31209":2173,"_21628":57877,"_5":14884,"_28401":57796,"_3085":57878},[],"Assign explicit profiles to every use case.",{"_3634":2212,"_31209":2173,"_21628":57880,"_5":14884,"_28401":57796,"_3085":57881},[],"Distribute the new trust before starting a rotation.",{"_3634":2213,"_31209":2173,"_21628":57883,"_5":14884,"_28401":57796,"_3085":57884},[],"Keep enough overlap to renew a disconnected fleet.",{"_3634":2214,"_31209":2173,"_21628":57886,"_5":14884,"_28401":57796,"_3085":57887},[],"Validate from the consuming system, not only from the Lamassu console.",{"_3634":2215,"_31209":2173,"_21628":57889,"_5":14884,"_28401":57796,"_3085":57890},[],"Continue with CA hierarchy and rotation to turn this model into an operating procedure.",{"_3634":2216,"_31209":2216,"_5":15244,"_3085":57892,"_31547":57893,"_21628":57894,"_28401":2216},"Revocation lists (CRL)",[50999,52511,56691,57364],[],{"_3634":2217,"_31209":2216,"_21628":57896,"_5":14884,"_28401":2216,"_3085":57897},[],"Generate and distribute signed lists to validate certificates offline.",{"_3634":2218,"_31209":2216,"_5":31544,"_21628":57899,"_28401":57900,"_3085":57901},[],"/docs/platform/pki/crl#crl-settings","CRL settings",{"_3634":2219,"_31209":2216,"_5":31544,"_21628":57903,"_28401":57904,"_3085":57905},[],"/docs/platform/pki/crl#cas-that-share-a-key","CAs that share a key",{"_3634":2220,"_31209":2216,"_5":31544,"_21628":57907,"_28401":57908,"_3085":57909},[],"/docs/platform/pki/crl#periodic-and-automatic-regeneration","Periodic and automatic regeneration",{"_3634":2221,"_31209":2216,"_5":31544,"_21628":57911,"_28401":57912,"_3085":57913},[],"/docs/platform/pki/crl#crl-contents","CRL contents",{"_3634":2222,"_31209":2216,"_5":31544,"_21628":57915,"_28401":57916,"_3085":57917},[],"/docs/platform/pki/crl#public-download-endpoint","Public download endpoint",{"_3634":2223,"_31209":2216,"_5":31544,"_21628":57919,"_28401":57920,"_3085":57921},[],"/docs/platform/pki/crl#crl-settings-api","CRL settings API",{"_3634":2224,"_31209":2216,"_5":31544,"_21628":57923,"_28401":57924,"_3085":57925},[],"/docs/platform/pki/crl#common-crl-settings-errors","Common CRL settings errors",{"_3634":2225,"_31209":2216,"_5":31544,"_21628":57927,"_28401":57928,"_3085":57929},[],"/docs/platform/pki/crl#references","References",{"_3634":2226,"_31209":2216,"_21628":57931,"_5":14884,"_28401":2216,"_3085":57932},[],"A CRL is an issuer-signed list of revoked certificates. This guide is for an operator publishing lists and an integrator using them locally. You need the issuing CA certificate, its CA ID and access to the published endpoint. The client must maintain a current copy: offline operation still requires refreshing evidence.",{"_3634":2227,"_31209":2216,"_21628":57934,"_5":14884,"_28401":57900,"_3085":57935},[],"The CRL settings of a CA store the configuration and metadata of its latest published list. Each CA has its own settings, keyed by its CA ID — even when two CAs share a key: they share the SKI, not the CRL. The VA creates them when a CA is created; when a CA is imported whose key is in the KMS — either imported with the private key or already held by the KMS — and whose certificate carries `cRLSign`: such a CA publishes its first CRL immediately, like a created one; and when a CA without settings is reissued with a certificate that can sign CRLs. An imported CA whose key is not in the KMS, or whose certificate lacks `cRLSign`, receives no settings: the import succeeds without error, and the CA's CRL endpoints report the settings as missing. Settings are never created retroactively: a CA that has none keeps none until it is reissued. Generation requires a usable issuer key; do not assume an imported CA without a key has an available CRL.",{"_3634":2228,"_31209":2216,"_21628":57937,"_5":14884,"_28401":57900,"_3085":57938},[],"Field",{"_3634":2229,"_31209":2216,"_21628":57940,"_5":14884,"_28401":57900,"_3085":51389},[],{"_3634":2230,"_31209":2216,"_21628":57942,"_5":14884,"_28401":57900,"_3085":52631},[],{"_3634":2231,"_31209":2216,"_21628":57944,"_5":14884,"_28401":57900,"_3085":57945},[],"ID of the CA the settings belong to.",{"_3634":2232,"_31209":2216,"_21628":57947,"_5":14884,"_28401":57900,"_3085":57948},[],"`status`",{"_3634":2233,"_31209":2216,"_21628":57950,"_5":14884,"_28401":57900,"_3085":57951},[],"Lifecycle of the settings. `ACTIVE` ones generate CRLs. `FINAL` ones belong to a CA revoked permanently or expired: the first publishes one final CRL, valid until the CA's current certificate expires, and the second is turned `FINAL` without one. `ARCHIVED` ones belong to a deleted CA: their last CRL is still served, but never regenerated.",{"_3634":2234,"_31209":2216,"_21628":57953,"_5":14884,"_28401":57900,"_3085":57954},[],"`legacy_ski`",{"_3634":2235,"_31209":2216,"_21628":57956,"_5":14884,"_28401":57900,"_3085":57957},[],"Read-only. SKI the settings were keyed by before the 4.0.0 migration; only migrated settings have it, and `/crl/<ski>` keeps resolving to them.",{"_3634":2236,"_31209":2216,"_21628":57959,"_5":14884,"_28401":57900,"_3085":57960},[],"`latest_crl`",{"_3634":2237,"_31209":2216,"_21628":57962,"_5":14884,"_28401":57900,"_3085":57963},[],"Version, validity start and end of the last published list. Read-only.",{"_3634":2238,"_31209":2216,"_21628":57965,"_5":14884,"_28401":57900,"_3085":57966},[],"`crl_options` field",{"_3634":2239,"_31209":2216,"_21628":57968,"_5":14884,"_28401":57900,"_3085":51389},[],{"_3634":2240,"_31209":2216,"_21628":57970,"_5":14884,"_28401":57900,"_3085":57971},[],"Initial value",{"_3634":2241,"_31209":2216,"_21628":57973,"_5":14884,"_28401":57900,"_3085":57974},[],"`validity`",{"_3634":2242,"_31209":2216,"_21628":57976,"_5":14884,"_28401":57900,"_3085":57977},[],"Time from `thisUpdate` to `nextUpdate`.",{"_3634":2243,"_31209":2216,"_21628":57979,"_5":14884,"_28401":57900,"_3085":57980},[],"7 days.",{"_3634":2244,"_31209":2216,"_21628":57982,"_5":14884,"_28401":57900,"_3085":57983},[],"`refresh_interval`",{"_3634":2245,"_31209":2216,"_21628":57985,"_5":14884,"_28401":57900,"_3085":57986},[],"Time since the issuance of the latest published CRL that triggers scheduled renewal; `0` disables only this trigger. The effective granularity is bounded by the job frequency (see Periodic and automatic regeneration).",{"_3634":2246,"_31209":2216,"_21628":57988,"_5":14884,"_28401":57900,"_3085":57989},[],"6 days and 23 hours.",{"_3634":2247,"_31209":2216,"_21628":57991,"_5":14884,"_28401":57900,"_3085":57992},[],"`regenerate_on_revoke`",{"_3634":2248,"_31209":2216,"_21628":57994,"_5":14884,"_28401":57900,"_3085":57995},[],"Request regeneration on revocation or reactivation from `CertificateHold` events.",{"_3634":2249,"_31209":2216,"_21628":57997,"_5":14884,"_28401":57900,"_3085":57998},[],"`true`.",{"_3634":2250,"_31209":2216,"_21628":58000,"_5":14884,"_28401":57900,"_3085":58001},[],"`signer_serial_number`",{"_3634":2251,"_31209":2216,"_21628":58003,"_5":14884,"_28401":57900,"_3085":58004},[],"Serial number of the existing certificate that signs the CRL.",{"_3634":2252,"_31209":2216,"_21628":58006,"_5":14884,"_28401":57900,"_3085":58007},[],"Serial number of the CA’s current certificate.",{"_3634":2253,"_31209":2216,"_21628":58009,"_5":14884,"_28401":57900,"_3085":58010},[],"The signer must be an existing certificate with the `cRLSign` key usage and the same subject and public key as the CA. Certificates from before a reissue qualify. A delegated signer is not supported: a certificate with the CA’s subject but a different key is rejected.",{"_3634":2254,"_31209":2216,"_21628":58012,"_5":14884,"_28401":57900,"_3085":58013},[],"When a CA is reissued and the signer is the superseded CA certificate, the VA moves the signer to the new certificate — provided it carries `cRLSign` — and republishes the CRL. If the new certificate lacks `cRLSign`, the VA keeps the previous signer and logs a warning. If the signer is any other certificate with the CA’s subject and key, it is deliberately left unchanged; the previous certificate then cannot be deleted while the settings use it (the API returns `409` `certificate is in use`), and to retire it you update the signer with `PUT`.",{"_3634":2255,"_31209":2216,"_21628":58015,"_5":14884,"_28401":57900,"_3085":58016},[],"The CRL lifecycle decisions — when publication stops and when the final CRL expires — use only the CA's current certificate. If a reissued certificate expires earlier than an older certificate that is still valid, CRL publication can stop, or the final CRL can expire, while the older certificate is still valid. This is an accepted limitation of the current behavior.",{"_3634":2256,"_31209":2216,"_21628":58018,"_5":14884,"_28401":57900,"_3085":58019},[],"A CA whose signer lacks `cRLSign` cannot generate its CRL, and an update that selects a signer without `cRLSign` is rejected (400 error). Since 4.0 the VA requires this usage. Check before importing with `openssl x509 -noout -ext keyUsage` and, if it is missing, obtain a certificate for the same CA and key that includes it and update the settings to use it as the signer. A CA that has no settings at all — for example, one imported without `cRLSign` — has nothing to update: the only way to obtain them is to reissue the CA with a certificate that carries `cRLSign`. After reissuing a CA, also check the key usage of the new certificate: it may not keep the original’s usages, and without `cRLSign` the settings keep their previous signer.",{"_3634":2257,"_31209":2216,"_21628":58021,"_5":14884,"_28401":57900,"_3085":58022},[],"Deleting a CA keeps its CRL settings; they remain until you delete the archived ones through the API or from the console's Verification Authorities page (see CRL settings API). What happens to them depends on how the CA ended:",{"_3634":2258,"_31209":2216,"_21628":58024,"_5":14884,"_28401":57900,"_3085":58025},[],"The 4.0.0 upgrade migration archives the settings of the CAs that had been deleted before the upgrade. Their `status` is `ARCHIVED` and their `ca_id` is `legacy-<ski>`: the last CRL keeps being served, but it is never regenerated, any `PUT` returns 409, and there is no API way back to `ACTIVE`.",{"_3634":2259,"_31209":2216,"_21628":58027,"_5":14884,"_28401":57900,"_3085":58028},[],"Revoking a CA permanently or letting it expire finalizes its settings: their `status` becomes `FINAL`, any `PUT` returns 409, and no new CRL is generated. A permanently revoked CA publishes one final CRL, valid until the CA's current certificate expires; an expired CA gets none. Deleting the CA afterwards archives its settings, which then behave like the archived ones of the migration.",{"_3634":2260,"_31209":2216,"_21628":58030,"_5":14884,"_28401":57900,"_3085":58031},[],"The settings can no longer be edited while their `status` is not `ACTIVE`. Adjust validity and signer before revoking or deleting a CA.",{"_3634":2261,"_31209":2216,"_21628":58033,"_5":14884,"_28401":57900,"_3085":58034},[],"`PUT` validates the signer only when the request changes it. If the stored signer is no longer valid, the other options can still be edited, but the CRL cannot be regenerated until a valid signer is set.",{"_3634":2262,"_31209":2216,"_21628":58036,"_5":14884,"_28401":57900,"_3085":58037},[],"Sharing a key between CAs is a migration blocker: the 4.0.0 upgrade aborts while an SKI belongs to more than one CA. See CAs that share a key.",{"_3634":2263,"_31209":2216,"_21628":58039,"_5":14884,"_28401":57900,"_3085":58040},[],"CRL versions are kept as PEM in object storage at `pki/va/crl/<ca-id>/<version>.crl`; the public endpoint returns DER. CRLs published before the 4.0.0 upgrade remain at `pki/va/crl/<ski>/<version>.crl` and keep being served.",{"_3634":2264,"_31209":2216,"_21628":58042,"_5":14884,"_28401":57904,"_3085":58043},[],"Since 4.0.0, each CA publishes its own CRL even when its key is shared: two CAs with the same key have the same SKI, but each has its own CRL settings and its own list, signed by a certificate with that CA’s identity.",{"_3634":2265,"_31209":2216,"_21628":58045,"_5":14884,"_28401":57904,"_3085":58046},[],"Certificates issued from now on carry `/crl/<ca-id>` distribution points, so each CA’s certificates resolve to its own list. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points: that URL keeps resolving to the settings the upgrade migrated, and always serves the list of the CA that owned that SKI when the upgrade ran. It is never rebound to a CA created later with the same key. After regeneration, the migrated list includes both URLs in its *Issuing Distribution Point* (OID `2.5.29.28`), so a verifier that compares the IDP with the CDP of the certificate accepts either form. Until the VA scheduled CRL job successfully regenerates it, the pre-upgrade list contains only the legacy `/crl/<ski>` IDP; IDP-checking verifiers cannot validate newly issued certificates with `/crl/<ca-id>` CDPs. The first run can take up to about an hour with the default schedule, and failures can extend the window.",{"_3634":2266,"_31209":2216,"_21628":58048,"_5":14884,"_28401":57904,"_3085":58049},[],"Sharing an SKI between CAs blocks the upgrade: the migration aborts and names the SKIs. To detect the problem before upgrading, compare the SKI of the CAs in the inventory: two with the same SKI are affected. To fix it, create a CA with its own key and reissue its certificates; those already issued keep the old URL and are not corrected until reissued.",{"_3634":2267,"_31209":2216,"_21628":58051,"_5":14884,"_28401":57904,"_3085":58052},[],"Lamassu takes the SKI of an imported certificate as-is and does not check that it corresponds to its public key. Until Lamassu rejects imports whose SKI collides with an existing CA — proposed in lamassuiot#834, together with the per-CA CRL that 4.0.0 implements — restrict the permission to import CAs as an interim control; it covers only the import path. Creating a CA with &#x2A;*Create New CA (Existing Key)** on a KMS key another CA already uses produces the same SKI collision, so avoid reusing keys across CAs.",{"_3634":2268,"_31209":2216,"_21628":58054,"_5":14884,"_28401":57908,"_3085":58055},[],"The VA scheduled job checks the CRL settings of every CA on each run and requests a new list when either of these conditions is met:",{"_3634":2269,"_31209":2216,"_21628":58057,"_5":14884,"_28401":57908,"_3085":58058},[],"**The list is about to expire:** the remaining validity of `latest_crl` is less than the interval between job runs. This condition always applies and cannot be disabled.",{"_3634":2270,"_31209":2216,"_21628":58060,"_5":14884,"_28401":57908,"_3085":58061},[],"**The refresh interval has elapsed:** the time since the issuance of the latest published CRL reaches `refresh_interval`. Setting `refresh_interval` to `0` disables only this condition; the list is still regenerated when it is about to expire.",{"_3634":2271,"_31209":2216,"_21628":58063,"_5":14884,"_28401":57908,"_3085":58064},[],"Setting `refresh_interval` to `0` therefore does not freeze regeneration. With the default 7-day validity and an hourly job, a CRL is renewed up to an hour before it expires even if `refresh_interval` is `0`. Because the job runs on its own schedule, `refresh_interval` is honored only as precisely as the job frequency allows.",{"_3634":2272,"_31209":2216,"_21628":58066,"_5":14884,"_28401":57908,"_3085":58067},[],"The job frequency is set in Helm with `services.va.job.crl.frequency` (default `0 * * * *`) and accepts a duration (`1h`) or a cron expression. A cron expression is converted into a constant interval equal to the time left until its next firing when the service starts, so it is not aligned with the clock. Keep `validity` well above that interval: with a shorter validity, the list is regenerated on every cycle.",{"_3634":2273,"_31209":2216,"_21628":58069,"_5":14884,"_28401":57908,"_3085":58070},[],"If generation fails (for example, because the CA cannot be resolved or the signer is invalid), the job logs the warning `something went wrong while calculating CRL for CA <ca-id>` and retries on the next cycle. There is no other renewal path until the cause is fixed, and the last published list keeps being served until it expires. All of this depends on working jobs, storage and signing.",{"_3634":2274,"_31209":2216,"_21628":58072,"_5":14884,"_28401":57908,"_3085":58073},[],"Settings whose `status` is not `ACTIVE` — `FINAL` or `ARCHIVED` — are skipped: nothing regenerates their CRL.",{"_3634":2275,"_31209":2216,"_21628":58075,"_5":14884,"_28401":57908,"_3085":58076},[],"With `regenerate_on_revoke`, the event handler requests a new CRL upon revocation or reactivation from `CertificateHold` to `ACTIVE`. This happens after the status change and has its own failure paths: if generation fails (for example, because of an invalid signer), the event is retried and, once retries are exhausted, moves to the failed-events queue. If the issuing CA has no CRL settings, there is no CRL to regenerate: the event is acknowledged without retry, the VA logs a warning, and nothing appears in the failed-events queue. Confirming revocation does not establish that the new CRL is already published or that all clients have downloaded it.",{"_3634":2276,"_31209":2216,"_21628":58078,"_5":14884,"_28401":57908,"_3085":58079},[],"Compare CRL numbers and timestamps before and after a change. Monitor expired lists and generation failures; clients must apply policy when current evidence is unavailable.",{"_3634":2277,"_31209":2216,"_21628":58081,"_5":14884,"_28401":57912,"_3085":58082},[],"Each entry contains serial number, revocation time and reason. The generator queries certificates in `REVOKED` state for the selected CA. A reactivated certificate disappears when the list is recalculated; an earlier downloaded copy retains its contents.",{"_3634":2278,"_31209":2216,"_21628":58084,"_5":14884,"_28401":57912,"_3085":58085},[],"When the VA has configured domains, the list contains a critical *Issuing Distribution Point* (OID `2.5.29.28`) with those distribution URLs; a VA with no configured domains publishes the list without an IDP, and a CRL without an IDP covers every certificate of its CA. When the extension is present, check that your client interprets it and that it matches the list’s scope. If rejected, investigate format and scope; ignoring a critical extension is not successful validation.",{"_3634":2279,"_31209":2216,"_21628":58087,"_5":14884,"_28401":57916,"_3085":58088},[],"The VA service exposes `GET /crl/{id}` without management authorization. Use the **issuing CA’s** ID, not the end-entity certificate’s ID or serial. Certificates issued before the 4.0.0 upgrade carry `/crl/<ski>` URLs with the SKI of the CA key; that form keeps resolving. First inspect the certificate’s CDP:",{"_3634":2280,"_31209":2216,"_21628":58090,"_5":14884,"_28401":57916,"_3085":58091},[],"Replace the following URL with the CDP URL and review exposure in Deployment:",{"_3634":2281,"_31209":2216,"_21628":58093,"_5":14884,"_28401":57916,"_3085":58094},[],"You need OpenSSL 3.x and `issuer.pem` containing the direct issuer’s certificate. An accepted signer certificate has the same subject and public key as the CA, so this signature check also works when the settings point to an earlier certificate for that CA and key. Require a valid signature, current timestamps and the expected issuer. For a root that issues directly:",{"_3634":2282,"_31209":2216,"_21628":58096,"_5":14884,"_28401":57916,"_3085":58097},[],"`roots.pem` contains deliberately trusted roots. For intermediates, add `-untrusted intermediates.pem` before the `device.crt` argument. `-crl_check` checks the end-entity certificate’s revocation against the local list; it does not download other lists or establish the status of the whole chain. A complete chain check needs the corresponding CRLs and a policy requiring them.",{"_3634":2283,"_31209":2216,"_21628":58099,"_5":14884,"_28401":57916,"_3085":58100},[],"The test should accept an allowed certificate absent from the list and reject it with `certificate revoked` after publishing and using the list containing its serial.",{"_3634":2284,"_31209":2216,"_21628":58102,"_5":14884,"_28401":57920,"_3085":58103},[],"The following paths are relative to the VA service; confirm the public prefix in the Gateway. They are not the URLs of the public OCSP and CRL endpoints.",{"_3634":2285,"_31209":2216,"_21628":58105,"_5":14884,"_28401":57920,"_3085":54457},[],{"_3634":2286,"_31209":2216,"_21628":58107,"_5":14884,"_28401":57920,"_3085":58108},[],"Relative path",{"_3634":2287,"_31209":2216,"_21628":58110,"_5":14884,"_28401":57920,"_3085":54454},[],{"_3634":2288,"_31209":2216,"_21628":58112,"_5":14884,"_28401":57920,"_3085":58113},[],"`GET`",{"_3634":2289,"_31209":2216,"_21628":58115,"_5":14884,"_28401":57920,"_3085":58116},[],"`/v1/crl-settings`",{"_3634":2290,"_31209":2216,"_21628":58118,"_5":14884,"_28401":57920,"_3085":58119},[],"List the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3634":2291,"_31209":2216,"_21628":58121,"_5":14884,"_28401":57920,"_3085":58113},[],{"_3634":2292,"_31209":2216,"_21628":58123,"_5":14884,"_28401":57920,"_3085":58124},[],"`/v1/crl-settings/{ca-id}`",{"_3634":2293,"_31209":2216,"_21628":58126,"_5":14884,"_28401":57920,"_3085":58127},[],"Read the `crl_options` and `latest_crl` of a CA.",{"_3634":2294,"_31209":2216,"_21628":58129,"_5":14884,"_28401":57920,"_3085":58130},[],"`PUT`",{"_3634":2295,"_31209":2216,"_21628":58132,"_5":14884,"_28401":57920,"_3085":58124},[],{"_3634":2296,"_31209":2216,"_21628":58134,"_5":14884,"_28401":57920,"_3085":58135},[],"Replace the CRL configuration of a CA.",{"_3634":2297,"_31209":2216,"_21628":58137,"_5":14884,"_28401":57920,"_3085":58138},[],"`DELETE`",{"_3634":2298,"_31209":2216,"_21628":58140,"_5":14884,"_28401":57920,"_3085":58124},[],{"_3634":2299,"_31209":2216,"_21628":58142,"_5":14884,"_28401":57920,"_3085":58143},[],"Remove the archived CRL settings of a CA.",{"_3634":2300,"_31209":2216,"_21628":58145,"_5":14884,"_28401":57920,"_3085":58146},[],"You need authentication and CRL settings read, update or delete permissions. Consult your installation’s API reference and Access control. Read current configuration before updating and send the full object expected by the contract — `refresh_interval`, `validity`, `signer_serial_number` and `regenerate_on_revoke`: the backend replaces all four; it does not merge omitted fields. `status`, `legacy_ski` and `latest_crl` are read-only. A `PUT` returns 409 when the settings are not `ACTIVE`, validates the signer only when it changes, and does not regenerate the CRL.",{"_3634":2301,"_31209":2216,"_21628":58148,"_5":14884,"_28401":57920,"_3085":58149},[],"Archived settings, whose CA no longer exists, can be removed with `DELETE`: the call returns 204 on success, 404 when the CA has no settings and 409 while the settings are not yet archived. After the deletion, the public `/crl/{id}` endpoint and any legacy `/crl/<ski>` endpoint stop serving the CA’s list, although the published CRL files remain in the bucket. Keep the archived settings while any certificate issued by the CA may still need revocation evidence: `DELETE` stops serving the list immediately, regardless of `latest_crl` validity. The action cannot be undone.",{"_3634":2302,"_31209":2216,"_21628":58151,"_5":14884,"_28401":57920,"_3085":58152},[],"After a change, check saved configuration and the next list actually published. Updating the settings alone does not establish regeneration or client acceptance.",{"_3634":2303,"_31209":2216,"_21628":58154,"_5":14884,"_28401":57924,"_3085":58155},[],"Symptom",{"_3634":2304,"_31209":2216,"_21628":58157,"_5":14884,"_28401":57924,"_3085":58158},[],"Cause",{"_3634":2305,"_31209":2216,"_21628":58160,"_5":14884,"_28401":57924,"_3085":58161},[],"Action",{"_3634":2306,"_31209":2216,"_21628":58163,"_5":14884,"_28401":57924,"_3085":58164},[],"`PUT /v1/crl-settings/{ca-id}` returns 409.",{"_3634":2307,"_31209":2216,"_21628":58166,"_5":14884,"_28401":57924,"_3085":58167},[],"The settings are not `ACTIVE`: revoking the CA permanently or letting it expire finalized them, or the migration archived them because their CA was deleted before the upgrade.",{"_3634":2308,"_31209":2216,"_21628":58169,"_5":14884,"_28401":57924,"_3085":58170},[],"There is no API way back to `ACTIVE`. The last CRL keeps being served.",{"_3634":2309,"_31209":2216,"_21628":58172,"_5":14884,"_28401":57924,"_3085":58173},[],"`DELETE /v1/crl-settings/{ca-id}` returns 409.",{"_3634":2310,"_31209":2216,"_21628":58175,"_5":14884,"_28401":57924,"_3085":58176},[],"The settings are not yet `ARCHIVED`: the CA has not been deleted.",{"_3634":2311,"_31209":2216,"_21628":58178,"_5":14884,"_28401":57924,"_3085":58179},[],"Delete the CA first; deleting it archives its settings.",{"_3634":2312,"_31209":2216,"_21628":58181,"_5":14884,"_28401":57924,"_3085":58182},[],"`PUT` returns 400.",{"_3634":2313,"_31209":2216,"_21628":58184,"_5":14884,"_28401":57924,"_3085":58185},[],"The new signer lacks `cRLSign`, or its subject and public key do not match the CA.",{"_3634":2314,"_31209":2216,"_21628":58187,"_5":14884,"_28401":57924,"_3085":58188},[],"Set the serial number of a valid certificate of that CA.",{"_3634":2315,"_31209":2216,"_21628":58190,"_5":14884,"_28401":57924,"_3085":58191},[],"`PUT` returns 404.",{"_3634":2316,"_31209":2216,"_21628":58193,"_5":14884,"_28401":57924,"_3085":58194},[],"The CA or the new signer certificate does not exist, or the CA has no CRL settings, for example because it was imported without its key or its certificate lacks `cRLSign`.",{"_3634":2317,"_31209":2216,"_21628":58196,"_5":14884,"_28401":57924,"_3085":58197},[],"Check the CA ID and the signer serial number.",{"_3634":2318,"_31209":2216,"_21628":58199,"_5":14884,"_28401":57924,"_3085":58200},[],"`PUT` returns 400 from a 3.x client.",{"_3634":2319,"_31209":2216,"_21628":58202,"_5":14884,"_28401":57924,"_3085":58203},[],"`crl_options.subject_key_id_signer` was replaced by `crl_options.signer_serial_number`, which is required.",{"_3634":2320,"_31209":2216,"_21628":58205,"_5":14884,"_28401":57924,"_3085":58206},[],"Update the client to send the new field.",{"_3634":2321,"_31209":2216,"_21628":58208,"_5":14884,"_28401":57924,"_3085":58209},[],"The CRL does not change after revoking a certificate.",{"_3634":2322,"_31209":2216,"_21628":58211,"_5":14884,"_28401":57924,"_3085":58212},[],"`regenerate_on_revoke` is `false`, the issuing CA has no CRL settings, or generation failed because of an invalid signer.",{"_3634":2323,"_31209":2216,"_21628":58214,"_5":14884,"_28401":57924,"_3085":58215},[],"Check the VA logs. Missing settings only produce a warning (no retry, no failed-events entry); an invalid signer also leaves the event in the failed-events queue, so fix the signer.",{"_3634":2324,"_31209":2216,"_21628":58217,"_5":14884,"_28401":57924,"_3085":58218},[],"A verifier rejects the CRL because of the issuer.",{"_3634":2325,"_31209":2216,"_21628":58220,"_5":14884,"_28401":57924,"_3085":58221},[],"The list was fetched through a legacy `/crl/<ski>` URL and belongs to the CA that owned that SKI when the upgrade ran.",{"_3634":2326,"_31209":2216,"_21628":58223,"_5":14884,"_28401":57924,"_3085":58224},[],"Use the CDP of the certificate being validated: certificates issued in 4.0.0 carry `/crl/<ca-id>` URLs.",{"_3634":2327,"_31209":2216,"_21628":58226,"_5":14884,"_28401":57928,"_3085":58227},[],"RFC 5280: X.509 and CRL profile.",{"_3634":2328,"_31209":2216,"_21628":58229,"_5":14884,"_28401":57928,"_3085":58230},[],"OpenSSL: openssl-crl.",{"_3634":2329,"_31209":2216,"_21628":58232,"_5":14884,"_28401":57928,"_3085":58233},[],"OpenSSL: openssl-verify.",{"_3634":2330,"_31209":2216,"_21628":58235,"_5":14884,"_28401":57928,"_3085":58236},[],"<Card title=\"OCSP service\" href=\"/docs/platform/pki/ocsp\" />",{"_3634":2331,"_31209":2216,"_21628":58238,"_5":14884,"_28401":57928,"_3085":58239},[],"<Card title=\"Certificate validation\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3634":2332,"_31209":2332,"_5":15244,"_3085":58241,"_31547":58242,"_21628":58243,"_28401":2332},"Keys and cryptographic engines",[50999,52511,56691,56692],[],{"_3634":2333,"_31209":2332,"_21628":58245,"_5":14884,"_28401":2332,"_3085":58246},[],"Generate, import and operate keys without coupling the PKI to a specific provider.",{"_3634":2334,"_31209":2332,"_5":31544,"_21628":58248,"_28401":58249,"_3085":58250},[],"/docs/platform/pki/key-management#what-the-kms-solves","What the KMS solves",{"_3634":2335,"_31209":2332,"_5":31544,"_21628":58252,"_28401":58253,"_3085":58254},[],"/docs/platform/pki/key-management#cryptographic-engines","Cryptographic engines",{"_3634":2336,"_31209":2332,"_5":31544,"_21628":58256,"_28401":58257,"_3085":58258},[],"/docs/platform/pki/key-management#file-system","File System",{"_3634":2337,"_31209":2332,"_5":31544,"_21628":58260,"_28401":58261,"_3085":58262},[],"/docs/platform/pki/key-management#hashicorp-vault","HashiCorp Vault",{"_3634":2338,"_31209":2332,"_5":31544,"_21628":58264,"_28401":58265,"_3085":58266},[],"/docs/platform/pki/key-management#aws-secrets-manager","AWS Secrets Manager",{"_3634":2339,"_31209":2332,"_5":31544,"_21628":58268,"_28401":58269,"_3085":58270},[],"/docs/platform/pki/key-management#aws-kms","AWS KMS",{"_3634":2340,"_31209":2332,"_5":31544,"_21628":58272,"_28401":58273,"_3085":58274},[],"/docs/platform/pki/key-management#pkcs11","PKCS#11",{"_3634":2341,"_31209":2332,"_5":31544,"_21628":58276,"_28401":58277,"_3085":58278},[],"/docs/platform/pki/key-management#azure-key-vault","Azure Key Vault",{"_3634":2342,"_31209":2332,"_5":31544,"_21628":58280,"_28401":58281,"_3085":58282},[],"/docs/platform/pki/key-management#key-inventory","Key inventory",{"_3634":2343,"_31209":2332,"_5":31544,"_21628":58284,"_28401":58285,"_3085":58286},[],"/docs/platform/pki/key-management#create-or-import-keys","Create or import keys",{"_3634":2344,"_31209":2332,"_5":31544,"_21628":58288,"_28401":58289,"_3085":58290},[],"/docs/platform/pki/key-management#generate-a-new-key-pair","Generate a new key pair",{"_3634":2345,"_31209":2332,"_5":31544,"_21628":58292,"_28401":58293,"_3085":58294},[],"/docs/platform/pki/key-management#import-an-existing-pair","Import an existing pair",{"_3634":2346,"_31209":2332,"_5":31544,"_21628":58296,"_28401":58297,"_3085":58298},[],"/docs/platform/pki/key-management#operations-on-a-key","Operations on a key",{"_3634":2347,"_31209":2332,"_5":31544,"_21628":58300,"_28401":58301,"_3085":58302},[],"/docs/platform/pki/key-management#view-details","View details",{"_3634":2348,"_31209":2332,"_5":31544,"_21628":58304,"_28401":58305,"_3085":58306},[],"/docs/platform/pki/key-management#sign-and-verify","Sign and verify",{"_3634":2349,"_31209":2332,"_5":31544,"_21628":58308,"_28401":58309,"_3085":58310},[],"/docs/platform/pki/key-management#sign","Sign",{"_3634":2350,"_31209":2332,"_5":31544,"_21628":58312,"_28401":58313,"_3085":58314},[],"/docs/platform/pki/key-management#verify","Verify",{"_3634":2351,"_31209":2332,"_5":31544,"_21628":58316,"_28401":58317,"_3085":58318},[],"/docs/platform/pki/key-management#generate-a-csr","Generate a CSR",{"_3634":2352,"_31209":2332,"_5":31544,"_21628":58320,"_28401":58321,"_3085":58322},[],"/docs/platform/pki/key-management#sign-locally-with-pkcs11","Sign locally with PKCS#11",{"_3634":2353,"_31209":2332,"_5":31544,"_21628":58324,"_28401":58325,"_3085":58326},[],"/docs/platform/pki/key-management#before-deleting-a-key","Before deleting a key",{"_3634":2354,"_31209":2332,"_21628":58328,"_5":14884,"_28401":2332,"_3085":58329},[],"The Cryptographic Key Management Service (KMS) of Lamassu IoT centralizes the generation, import, custody and use of the platform's keys. This is where you manage the keys that support the CAs and the rest of the signing operations that depend on the PKI.",{"_3634":2355,"_31209":2332,"_21628":58331,"_5":14884,"_28401":2332,"_3085":58332},[],"In the current configuration, Lamassu IoT works exclusively with asymmetric keys, such as RSA and elliptic curves. These keys are used to issue X.509 certificates, sign requests and perform authentication and validation operations within the system.",{"_3634":2356,"_31209":2332,"_21628":58334,"_5":14884,"_28401":58249,"_3085":58335},[],"The KMS unifies key lifecycle management and prevents every service from having to integrate directly with a specific cryptographic provider.",{"_3634":2357,"_31209":2332,"_21628":58337,"_5":14884,"_28401":58249,"_3085":58338},[],"In practice, it lets you:",{"_3634":2358,"_31209":2332,"_21628":58340,"_5":14884,"_28401":58249,"_3085":58341},[],"Generate new key pairs from Lamassu IoT.",{"_3634":2359,"_31209":2332,"_21628":58343,"_5":14884,"_28401":58249,"_3085":58344},[],"Import keys created externally.",{"_3634":2360,"_31209":2332,"_21628":58346,"_5":14884,"_28401":58249,"_3085":58347},[],"Delegate custody and cryptographic operations to external engines.",{"_3634":2361,"_31209":2332,"_21628":58349,"_5":14884,"_28401":58249,"_3085":58350},[],"Reuse existing keys for CAs, CSRs and signing or verification tasks.",{"_3634":2362,"_31209":2332,"_21628":58352,"_5":14884,"_28401":58253,"_3085":58353},[],"Lamassu can work with different cryptographic engines depending on deployment requirements. In some environments a software engine is enough; in others custody must be delegated to an HSM, a cloud service or a specialized platform.",{"_3634":2363,"_31209":2332,"_21628":58355,"_5":14884,"_28401":58253,"_3085":58356},[],"A single instance can have several engines configured at the same time, including multiple instances of the same type. This lets you adapt operations to different security, cost and regulatory requirements.",{"_3634":2364,"_31209":2332,"_21628":58358,"_5":14884,"_28401":58253,"_3085":58359},[],"This guide is for the PKI operator: select and use an already enabled engine. Installation, credentials, persistent storage and connectivity belong to Deployment. Before generating a CA, check the default engine, advertised algorithms and a test signature. Availability in your installation depends on its version and configuration.",{"_3634":2365,"_31209":2332,"_21628":58361,"_5":14884,"_28401":58257,"_3085":58362},[],"Generates software keys and stores private material in files. Custody depends on installation permissions, storage and backups. Before using it for an operational CA, agree how the key will be recovered and how replicas will access it; the KMS record does not replace those files.",{"_3634":2366,"_31209":2332,"_21628":58364,"_5":14884,"_28401":58261,"_3085":58365},[],"The adapter uses KV storage for private material. This is not signing within Vault Transit: someone able to read the secret can recover the key. Review read permissions, availability and recovery with the deployment owner.",{"_3634":2367,"_31209":2332,"_21628":58367,"_5":14884,"_28401":58261,"_3085":58368},[],"The adapter reaches Vault over its configured HTTP(S) endpoint. The Vault server certificate is verified against the system trust store; a Vault signed by a private CA is trusted by adding its CA certificate to the engine's `ca_cert_file` (PEM-encoded). `insecure_skip_verify=true` disables verification and is a last resort; agree the transport settings with the deployment owner.",{"_3634":2368,"_31209":2332,"_21628":58370,"_5":14884,"_28401":58265,"_3085":58371},[],"Offers encrypted persistence in AWS at a cost. It protects the key at rest, but an authorized administrator can recover it; it does not provide the same extraction resistance as a KMS or HSM.",{"_3634":2369,"_31209":2332,"_21628":58373,"_5":14884,"_28401":58269,"_3085":58374},[],"Delegates signing to AWS KMS. The adapter also implements external material import, subject to provider capabilities and permissions. A key generated outside the service has already existed outside its custody; importing it does not remove those copies. Check generation, import and signing as separate operations.",{"_3634":2370,"_31209":2332,"_21628":58376,"_5":14884,"_28401":58273,"_3085":58377},[],"Allows integrating local HSMs, isolated environments and *Key as a Service* offerings. Generation, persistence and extraction resistance depend on the specific device or provider. It is the most flexible option when policy requires hardware custody.",{"_3634":2371,"_31209":2332,"_21628":58379,"_5":14884,"_28401":58277,"_3085":58380},[],"The backend also provides adapters for **Key Vault Keys** and **Key Vault Secrets**. The former delegates signing to the key service; the latter stores private material as secrets and signs using that material. These are different custody models. Confirm which adapter is enabled in your installation and test the required operations.",{"_3634":2372,"_31209":2332,"_21628":58382,"_5":14884,"_28401":58277,"_3085":58383},[],"Lamassu shows the enabled engines in the console.",{"_3634":2373,"_31209":2332,"_21628":58385,"_5":14884,"_28401":58277,"_3085":58386},[],"Each engine defines which algorithms it supports, such as RSA or ECC/ECDSA, and which key sizes it can generate.",{"_3634":2374,"_31209":2332,"_21628":58388,"_5":14884,"_28401":58277,"_3085":58389},[],"Confirm with the deployment operator which engine is configured as the default. That engine will be used when a process needs to create or persist a key and the user has not selected a specific one, for example when creating or importing a CA.",{"_3634":2375,"_31209":2332,"_21628":58391,"_5":14884,"_28401":58281,"_3085":58392},[],"The main KMS screen shows the complete inventory of keys registered in the system. It is the reference view for reviewing which keys exist, where they are kept and which entities they relate to.",{"_3634":2376,"_31209":2332,"_21628":58394,"_5":14884,"_28401":58281,"_3085":58395},[],"The table includes the following fields:",{"_3634":2377,"_31209":2332,"_21628":58397,"_5":14884,"_28401":58281,"_3085":58398},[],"**Name**: descriptive name of the key.",{"_3634":2378,"_31209":2332,"_21628":58400,"_5":14884,"_28401":58281,"_3085":58401},[],"**Type**: algorithm and key size, for example RSA 2048 or EC P-256.",{"_3634":2379,"_31209":2332,"_21628":58403,"_5":14884,"_28401":58281,"_3085":58404},[],"**Strength**: visual indicator of cryptographic strength.",{"_3634":2380,"_31209":2332,"_21628":58406,"_5":14884,"_28401":58281,"_3085":58407},[],"**Public/Private**: whether Lamassu manages the full pair or only the public key.",{"_3634":2381,"_31209":2332,"_21628":58409,"_5":14884,"_28401":58281,"_3085":58410},[],"**Crypto Engine**: cryptographic engine keeping the key.",{"_3634":2382,"_31209":2332,"_21628":58412,"_5":14884,"_28401":58281,"_3085":58413},[],"**Aliases**: alternative names associated with the key.",{"_3634":2383,"_31209":2332,"_21628":58415,"_5":14884,"_28401":58281,"_3085":58416},[],"**Tags**: labels for classification and search.",{"_3634":2384,"_31209":2332,"_21628":58418,"_5":14884,"_28401":58281,"_3085":58419},[],"**Related Entities**: certificates or other entities linked to that key.",{"_3634":2385,"_31209":2332,"_21628":58421,"_5":14884,"_28401":58281,"_3085":58422},[],"From this view you also reach the most common actions:",{"_3634":2386,"_31209":2332,"_21628":58424,"_5":14884,"_28401":58281,"_3085":58425},[],"**View Details** to inspect metadata, identifiers and relationships.",{"_3634":2387,"_31209":2332,"_21628":58427,"_5":14884,"_28401":58281,"_3085":58428},[],"**Generate CSR** to create a PKCS#10 request with the selected key.",{"_3634":2388,"_31209":2332,"_21628":58430,"_5":14884,"_28401":58281,"_3085":58431},[],"**Sign / Verify** to test cryptographic operations on the key.",{"_3634":2389,"_31209":2332,"_21628":58433,"_5":14884,"_28401":58281,"_3085":58434},[],"**Delete Key** to remove the key from the system.",{"_3634":2390,"_31209":2332,"_21628":58436,"_5":14884,"_28401":58285,"_3085":58437},[],"You need key administration permissions and a reachable engine. The issuance profile must allow the chosen algorithm if the key will be used in a CA or CSR. Open **Create New Key** and choose generation or import.",{"_3634":2391,"_31209":2332,"_21628":58439,"_5":14884,"_28401":58289,"_3085":58440},[],"If the key will be born inside Lamassu, the recommended flow is to generate a new pair managed directly by one of the configured engines.",{"_3634":2392,"_31209":2332,"_21628":58442,"_5":14884,"_28401":58289,"_3085":58443},[],"On the wizard's first screen, choose **Generate New Key Pair** and then define the main parameters:",{"_3634":2393,"_31209":2332,"_21628":58445,"_5":14884,"_28401":58289,"_3085":58446},[],"**Key Name**: unique and descriptive name.",{"_3634":2394,"_31209":2332,"_21628":58448,"_5":14884,"_28401":58289,"_3085":58449},[],"**Crypto Engine**: engine that will keep the key.",{"_3634":2395,"_31209":2332,"_21628":58451,"_5":14884,"_28401":58289,"_3085":58452},[],"**Key Type** and **Key Size**: algorithm and size or curve.",{"_3634":2396,"_31209":2332,"_21628":58454,"_5":14884,"_28401":58289,"_3085":58455},[],"**Tags**: metadata to classify the key.",{"_3634":2397,"_31209":2332,"_21628":58457,"_5":14884,"_28401":58289,"_3085":58458},[],"**Metadata**: additional information for advanced uses.",{"_3634":2398,"_31209":2332,"_21628":58460,"_5":14884,"_28401":58293,"_3085":58461},[],"Importing lets you register in Lamassu a key generated outside the platform. It is the usual flow in BYOK scenarios, migrations or integration with cryptographic material already in production.",{"_3634":2399,"_31209":2332,"_21628":58463,"_5":14884,"_28401":58293,"_3085":58464},[],"When you have an exportable private key and the destination engine supports import.",{"_3634":2400,"_31209":2332,"_21628":58466,"_5":14884,"_28401":58293,"_3085":58467},[],"When an existing PKI needs to be migrated without reissuing certificates.",{"_3634":2401,"_31209":2332,"_21628":58469,"_5":14884,"_28401":58293,"_3085":58470},[],"When Lamassu must operate with a root of trust created by a third party.",{"_3634":2402,"_31209":2332,"_21628":58472,"_5":14884,"_28401":58293,"_3085":58473},[],"In the wizard, choose **Import Existing Key Pair** and complete the requested fields:",{"_3634":2403,"_31209":2332,"_21628":58475,"_5":14884,"_28401":58293,"_3085":58476},[],"**Key Name**: descriptive name within Lamassu IoT.",{"_3634":2404,"_31209":2332,"_21628":58478,"_5":14884,"_28401":58293,"_3085":58479},[],"**Crypto Engine**: engine that will keep the imported key.",{"_3634":2405,"_31209":2332,"_21628":58481,"_5":14884,"_28401":58293,"_3085":58482},[],"**Tags**: labels for organization and search.",{"_3634":2406,"_31209":2332,"_21628":58484,"_5":14884,"_28401":58293,"_3085":58485},[],"**Metadata**: additional optional information.",{"_3634":2407,"_31209":2332,"_21628":58487,"_5":14884,"_28401":58293,"_3085":58488},[],"**Private Key (PEM)**: private key in PEM format.",{"_3634":2408,"_31209":2332,"_21628":58490,"_5":14884,"_28401":58293,"_3085":58491},[],"After a successful import, open the record, check the engine and public key, and perform a test signature. A non-exportable HSM key cannot be uploaded through this PEM form: configure engine access and check how the existing key is registered. Review dependencies and any provider resources already created if an operation fails partway through.",{"_3634":2409,"_31209":2332,"_21628":58493,"_5":14884,"_28401":58297,"_3085":58494},[],"Each registered key has a detail view and several operational actions.",{"_3634":2410,"_31209":2332,"_21628":58496,"_5":14884,"_28401":58301,"_3085":58497},[],"The **View Details** screen concentrates the technical and administrative information of the key.",{"_3634":2411,"_31209":2332,"_21628":58499,"_5":14884,"_28401":58301,"_3085":58500},[],"The **Overview** tab shows, among others, these fields:",{"_3634":2412,"_31209":2332,"_21628":58502,"_5":14884,"_28401":58301,"_3085":58503},[],"**Key Name**: descriptive name.",{"_3634":2413,"_31209":2332,"_21628":58505,"_5":14884,"_28401":58301,"_3085":58506},[],"**Key Identifier**: unique system identifier. Lamassu uses PKCS11-based ID formats.",{"_3634":2414,"_31209":2332,"_21628":58508,"_5":14884,"_28401":58301,"_3085":58509},[],"**Tags**: associated labels.",{"_3634":2415,"_31209":2332,"_21628":58511,"_5":14884,"_28401":58301,"_3085":58512},[],"**Aliases**: alternative names.",{"_3634":2416,"_31209":2332,"_21628":58514,"_5":14884,"_28401":58301,"_3085":58515},[],"**Crypto Engine**: engine where the key resides.",{"_3634":2417,"_31209":2332,"_21628":58517,"_5":14884,"_28401":58301,"_3085":58518},[],"**Algorithm, Key Size & Strength**: algorithm, parameters and strength level.",{"_3634":2418,"_31209":2332,"_21628":58520,"_5":14884,"_28401":58301,"_3085":58521},[],"The **Related Entities** section shows which Lamassu objects depend on that key.",{"_3634":2419,"_31209":2332,"_21628":58523,"_5":14884,"_28401":58301,"_3085":58524},[],"The **Public Key** tab shows public material in PEM. The record’s identifier and URI locate the key; a PKCS#11-formatted URI does not establish that the engine is an HSM or that a local module can access it.",{"_3634":2420,"_31209":2332,"_21628":58526,"_5":14884,"_28401":58305,"_3085":58527},[],"The **Sign / Verify** action validates that the key and the cryptographic engine work correctly.",{"_3634":2421,"_31209":2332,"_21628":58529,"_5":14884,"_28401":58305,"_3085":58530},[],"Sign a test message, save the signature and verify it using the same public key, algorithm and encoding. Then change the message: verification should fail. This tests one operation; it does not establish every engine capability or a CA’s chain.",{"_3634":2422,"_31209":2332,"_21628":58532,"_5":14884,"_28401":58305,"_3085":58533},[],"When you open it, two areas appear: **Sign** and **Verify**.",{"_3634":2423,"_31209":2332,"_21628":58535,"_5":14884,"_28401":58309,"_3085":58536},[],"This tab uses the private key to generate a digital signature over a message or an already computed *digest*.",{"_3634":2424,"_31209":2332,"_21628":58538,"_5":14884,"_28401":58309,"_3085":58539},[],"Main fields:",{"_3634":2425,"_31209":2332,"_21628":58541,"_5":14884,"_28401":58309,"_3085":58542},[],"**Algorithm**: signing algorithm available for the key type.",{"_3634":2426,"_31209":2332,"_21628":58544,"_5":14884,"_28401":58309,"_3085":58545},[],"**Message Type**: `Raw` for clear data or `Digest` for a precomputed hash.",{"_3634":2427,"_31209":2332,"_21628":58547,"_5":14884,"_28401":58309,"_3085":58548},[],"**Payload Encoding**: input encoding, such as UTF-8, Hex or Base64.",{"_3634":2428,"_31209":2332,"_21628":58550,"_5":14884,"_28401":58309,"_3085":58551},[],"**Message**: content to sign.",{"_3634":2429,"_31209":2332,"_21628":58553,"_5":14884,"_28401":58309,"_3085":58554},[],"**Signature**: result of the operation, shown in hexadecimal.",{"_3634":2430,"_31209":2332,"_21628":58556,"_5":14884,"_28401":58313,"_3085":58557},[],"This tab checks whether a signature corresponds to the associated public key.",{"_3634":2431,"_31209":2332,"_21628":58559,"_5":14884,"_28401":58313,"_3085":58539},[],{"_3634":2432,"_31209":2332,"_21628":58561,"_5":14884,"_28401":58313,"_3085":58562},[],"**Algorithm**: must match the algorithm used for the signature.",{"_3634":2433,"_31209":2332,"_21628":58564,"_5":14884,"_28401":58313,"_3085":58565},[],"**Message Type**: `Raw` or `Digest`.",{"_3634":2434,"_31209":2332,"_21628":58567,"_5":14884,"_28401":58313,"_3085":58568},[],"**Payload Encoding**: encoding of the message.",{"_3634":2435,"_31209":2332,"_21628":58570,"_5":14884,"_28401":58313,"_3085":58571},[],"**Message**: original message or hash.",{"_3634":2436,"_31209":2332,"_21628":58573,"_5":14884,"_28401":58313,"_3085":58574},[],"**Signature**: signature to check.",{"_3634":2437,"_31209":2332,"_21628":58576,"_5":14884,"_28401":58313,"_3085":58577},[],"**Result**: indicator of the validation result.",{"_3634":2438,"_31209":2332,"_21628":58579,"_5":14884,"_28401":58317,"_3085":58580},[],"The **Generate CSR** action creates a PKCS#10 request signed with the private key kept in Lamassu, without exposing it outside the cryptographic engine.",{"_3634":2439,"_31209":2332,"_21628":58582,"_5":14884,"_28401":58317,"_3085":58583},[],"This flow is useful for:",{"_3634":2440,"_31209":2332,"_21628":58585,"_5":14884,"_28401":58317,"_3085":58586},[],"Requesting certificates from an external CA.",{"_3634":2441,"_31209":2332,"_21628":58588,"_5":14884,"_28401":58317,"_3085":58589},[],"Renewing an identity while keeping the same key.",{"_3634":2442,"_31209":2332,"_21628":58591,"_5":14884,"_28401":58317,"_3085":58592},[],"When you open the form, it asks for the subject data and the main certificate attributes:",{"_3634":2443,"_31209":2332,"_21628":58594,"_5":14884,"_28401":58317,"_3085":58595},[],"**Common Name (CN)**: main name of the identity.",{"_3634":2444,"_31209":2332,"_21628":58597,"_5":14884,"_28401":58317,"_3085":58598},[],"**Organization (O)**: organization or company.",{"_3634":2445,"_31209":2332,"_21628":58600,"_5":14884,"_28401":58317,"_3085":58601},[],"**Organizational Unit (OU)**: department or unit.",{"_3634":2446,"_31209":2332,"_21628":58603,"_5":14884,"_28401":58317,"_3085":58604},[],"**Country (C)**: two-letter country code.",{"_3634":2447,"_31209":2332,"_21628":58606,"_5":14884,"_28401":58317,"_3085":58607},[],"**State / Province (ST)**: state or province.",{"_3634":2448,"_31209":2332,"_21628":58609,"_5":14884,"_28401":58317,"_3085":58610},[],"**Locality (L)**: city or locality.",{"_3634":2449,"_31209":2332,"_21628":58612,"_5":14884,"_28401":58317,"_3085":58613},[],"**Email Address**: contact email.",{"_3634":2450,"_31209":2332,"_21628":58615,"_5":14884,"_28401":58317,"_3085":58616},[],"**Subject Alternative Names (SANs)**: alternative names or identifiers, such as DNS or IP.",{"_3634":2451,"_31209":2332,"_21628":58618,"_5":14884,"_28401":58317,"_3085":58619},[],"Download the CSR and run `openssl req -in request.csr -noout -verify -text`. Check signature, subject and SAN before sending it. A CSR does not determine the final certificate by itself: issuance policy can replace its fields.",{"_3634":2452,"_31209":2332,"_21628":58621,"_5":14884,"_28401":58321,"_3085":58622},[],"Lamassu also offers specific help for local integrations through **Sign locally with OpenSSL & PKCS11 tools**.",{"_3634":2453,"_31209":2332,"_21628":58624,"_5":14884,"_28401":58321,"_3085":58625},[],"It requires the module, token and permissions of the corresponding provider. Check that the Lamassu identifier matches the object accessible from that module. Module configuration belongs to the client environment or Deployment.",{"_3634":2454,"_31209":2332,"_21628":58627,"_5":14884,"_28401":58325,"_3085":58628},[],"Review **Related Entities** and locate CAs, certificates and validation processes that still need signatures. Revoking a CA does not remove the need to publish status during its retention period. Deleting a key does not automatically revoke its certificates either. Plan replacement and retention before using **Delete Key**; provider deletion behavior depends on the engine.",{"_3634":2455,"_31209":2332,"_21628":58630,"_5":14884,"_28401":58325,"_3085":58631},[],"The KMS refuses to delete a key that certificates still reference, with `409` `key is in use`. Revoking a certificate or letting it expire does not release its key reference. Deleting a CA releases the references from its own current certificate and linked reissued certificates, which stay in place to back the CRL and OCSP, and then attempts to delete the key. If other certificates still reference the key, such as another CA sharing it, the KMS keeps it. The certificates the CA issued keep their own key references, even when revoked. The API lets you delete such a certificate only once its issuer CA no longer exists, and deleting it removes it from the CRL and OCSP responses, so keep revoked certificates for their retention period and delete only expired or superseded ones. The KMS also refuses to delete a key that signs the CRL of a CA whose CRL settings are still `ACTIVE`, with the same `409` `key is in use`; that reference is released when the settings are finalized, after the CA is revoked permanently or expires (see CRL). Legacy references retained by the upgrade migration are described in the upgrade guide.",{"_3634":2456,"_31209":2456,"_5":15244,"_3085":58633,"_31547":58634,"_21628":58635,"_28401":2456},"Online validation with OCSP",[50999,52511,56691,57364],[],{"_3634":2457,"_31209":2456,"_21628":58637,"_5":14884,"_28401":2456,"_3085":58638},[],"Query signed status and verify the responder’s response.",{"_3634":2458,"_31209":2456,"_5":31544,"_21628":58640,"_28401":58641,"_3085":58642},[],"/docs/platform/pki/ocsp#how-the-responder-works-in-lamassu","How the responder works in Lamassu",{"_3634":2459,"_31209":2456,"_5":31544,"_21628":58644,"_28401":58645,"_3085":58646},[],"/docs/platform/pki/ocsp#embedding-in-issued-certificates","Embedding in issued certificates",{"_3634":2460,"_31209":2456,"_5":31544,"_21628":58648,"_28401":58649,"_3085":58650},[],"/docs/platform/pki/ocsp#http-endpoints","HTTP endpoints",{"_3634":2461,"_31209":2456,"_5":31544,"_21628":58652,"_28401":58653,"_3085":58654},[],"/docs/platform/pki/ocsp#generate-and-verify-a-query","Generate and verify a query",{"_3634":2462,"_31209":2456,"_5":31544,"_21628":58656,"_28401":58657,"_3085":58658},[],"/docs/platform/pki/ocsp#check-from-the-interface","Check from the interface",{"_3634":2463,"_31209":2456,"_5":31544,"_21628":58660,"_28401":58661,"_3085":57929},[],"/docs/platform/pki/ocsp#references",{"_3634":2464,"_31209":2456,"_21628":58663,"_5":14884,"_28401":2456,"_3085":58664},[],"OCSP queries a certificate’s status and returns a signed response. This guide is for an integrator checking what Lamassu publishes and how the consumer must verify it. For complete identity validation, follow Certificate validation.",{"_3634":2465,"_31209":2456,"_21628":58666,"_5":14884,"_28401":58641,"_3085":58667},[],"The responder retrieves the certificate by serial number and locates its issuing CA in the inventory. It translates persisted status as follows:",{"_3634":2466,"_31209":2456,"_21628":58669,"_5":14884,"_28401":58641,"_3085":58670},[],"Record status",{"_3634":2467,"_31209":2456,"_21628":58672,"_5":14884,"_28401":58641,"_3085":58673},[],"Signed response",{"_3634":2468,"_31209":2456,"_21628":58675,"_5":14884,"_28401":58641,"_3085":55828},[],{"_3634":2469,"_31209":2456,"_21628":58677,"_5":14884,"_28401":58641,"_3085":58678},[],"`Good`.",{"_3634":2470,"_31209":2456,"_21628":58680,"_5":14884,"_28401":58641,"_3085":55845},[],{"_3634":2471,"_31209":2456,"_21628":58682,"_5":14884,"_28401":58641,"_3085":58683},[],"`Revoked`, with revocation reason and timestamp.",{"_3634":2472,"_31209":2456,"_21628":58685,"_5":14884,"_28401":58641,"_3085":58686},[],"Other states, including `INACTIVE` and `EXPIRED`",{"_3634":2473,"_31209":2456,"_21628":58688,"_5":14884,"_28401":58641,"_3085":58689},[],"`Unknown` if the certificate and issuer can be retrieved.",{"_3634":2474,"_31209":2456,"_21628":58691,"_5":14884,"_28401":58641,"_3085":58692},[],"An absent serial number causes a lookup error; it does not guarantee a signed `Unknown` response. Lookup or signing errors produce an HTTP failure. Treat that as unavailable evidence according to consumer policy.",{"_3634":2475,"_31209":2456,"_21628":58694,"_5":14884,"_28401":58641,"_3085":58695},[],"The issuing CA itself signs the response through its KMS-associated key. A delegated OCSP signing certificate is not used. An imported CA without a usable key cannot sign responses.",{"_3634":2476,"_31209":2456,"_21628":58697,"_5":14884,"_28401":58641,"_3085":58698},[],"The implementation sets `thisUpdate` approximately one day before response generation and `nextUpdate` one day after: the declared window is about 48 hours. Inspect received values and apply your freshness policy. The response reflects stored status when queried; a previously cached copy does not change upon revocation.",{"_3634":2477,"_31209":2456,"_21628":58700,"_5":14884,"_28401":58645,"_3085":58701},[],"The signer constructs OCSP URLs from configured VA domains and adds them to AIA. Without domains, there is no URL to add; an imported certificate retains its original extensions. Inspect the actual certificate:",{"_3634":2478,"_31209":2456,"_21628":58703,"_5":14884,"_28401":58645,"_3085":58704},[],"Check that the consumer can reach this URL. DNS, endpoint exposure and domain configuration belong to Deployment. Changing configuration does not modify already signed certificates.",{"_3634":2479,"_31209":2456,"_21628":58706,"_5":14884,"_28401":58649,"_3085":58707},[],"The service accepts:",{"_3634":2480,"_31209":2456,"_21628":58709,"_5":14884,"_28401":58649,"_3085":54457},[],{"_3634":2481,"_31209":2456,"_21628":58711,"_5":14884,"_28401":58649,"_3085":58712},[],"VA service path",{"_3634":2482,"_31209":2456,"_21628":58714,"_5":14884,"_28401":58649,"_3085":58715},[],"Format",{"_3634":2483,"_31209":2456,"_21628":58717,"_5":14884,"_28401":58649,"_3085":58718},[],"`POST`",{"_3634":2484,"_31209":2456,"_21628":58720,"_5":14884,"_28401":58649,"_3085":58721},[],"`/ocsp`",{"_3634":2485,"_31209":2456,"_21628":58723,"_5":14884,"_28401":58649,"_3085":58724},[],"DER request, `Content-Type: application/ocsp-request`.",{"_3634":2486,"_31209":2456,"_21628":58726,"_5":14884,"_28401":58649,"_3085":58113},[],{"_3634":2487,"_31209":2456,"_21628":58728,"_5":14884,"_28401":58649,"_3085":58729},[],"`/ocsp/{ocsp_request}`",{"_3634":2488,"_31209":2456,"_21628":58731,"_5":14884,"_28401":58649,"_3085":58732},[],"DER request encoded using padded URL Base64.",{"_3634":2489,"_31209":2456,"_21628":58734,"_5":14884,"_28401":58649,"_3085":58735},[],"Use POST to avoid client encoding differences. A successful response has `Content-Type: application/ocsp-response` and a DER body. The public prefix depends on the Gateway; use the URL published in the certificate and checked by the operator.",{"_3634":2490,"_31209":2456,"_21628":58737,"_5":14884,"_28401":58653,"_3085":58738},[],"You need OpenSSL 3.x, `device.crt`, its direct issuer’s certificate `issuer.pem` and the consumer’s trusted roots in `roots.pem`. For an intermediate issuer, also prepare `intermediates.pem` containing the intermediate CAs.",{"_3634":2491,"_31209":2456,"_21628":58740,"_5":14884,"_28401":58653,"_3085":58741},[],"Generate the request:",{"_3634":2492,"_31209":2456,"_21628":58743,"_5":14884,"_28401":58653,"_3085":58744},[],"This example omits the nonce because the responder does not echo it. Verification relies on signature, response correspondence and timestamps; it does not demonstrate freshness through a nonce.",{"_3634":2493,"_31209":2456,"_21628":58746,"_5":14884,"_28401":58653,"_3085":58747},[],"Replace the example URL with the inspected endpoint:",{"_3634":2494,"_31209":2456,"_21628":58749,"_5":14884,"_28401":58653,"_3085":58750},[],"Verify the returned DER:",{"_3634":2495,"_31209":2456,"_21628":58752,"_5":14884,"_28401":58653,"_3085":58753},[],"For intermediates, add `-verify_other intermediates.pem`. Require successful response verification and inspect the status corresponding to `device.crt`, issuer, serial, `thisUpdate` and `nextUpdate`. `Response verify OK` validates the response only: also observe `good`, `revoked` or `unknown`. Do not accept an identity based only on the command’s exit code.",{"_3634":2496,"_31209":2456,"_21628":58755,"_5":14884,"_28401":58657,"_3085":58756},[],"**OCSP Check** shows what Lamassu returns for a selected certificate. Complete the check from the consumer’s network and trust store: a console query does not establish its validation configuration.",{"_3634":2497,"_31209":2456,"_21628":58758,"_5":14884,"_28401":58657,"_3085":58759},[],"To check a change, save an earlier response, revoke a test certificate and request another response. The new query should reflect persisted status; compare timestamps to rule out reuse of an earlier response. If it fails, follow PKI troubleshooting.",{"_3634":2498,"_31209":2456,"_21628":58761,"_5":14884,"_28401":58661,"_3085":58762},[],"RFC 6960: OCSP.",{"_3634":2499,"_31209":2456,"_21628":58764,"_5":14884,"_28401":58661,"_3085":58765},[],"OpenSSL: openssl-ocsp.",{"_3634":2500,"_31209":2456,"_21628":58767,"_5":14884,"_28401":58661,"_3085":58768},[],"<Card title=\"CRL service\" href=\"/docs/platform/pki/crl\" />",{"_3634":2501,"_31209":2456,"_21628":58770,"_5":14884,"_28401":58661,"_3085":58239},[],{"_3634":2502,"_31209":2502,"_5":15244,"_3085":56691,"_31547":58772,"_21628":58773,"_28401":2502},[50999,52511,56691],[],{"_3634":2503,"_31209":2502,"_21628":58775,"_5":14884,"_28401":2502,"_3085":58776},[],"Administer keys and authorities, define issuance and verify the resulting certificates.",{"_3634":2504,"_31209":2502,"_5":31544,"_21628":58778,"_28401":58779,"_3085":56003},[],"/docs/platform/pki/overview#start-here",{"_3634":2505,"_31209":2502,"_5":31544,"_21628":58781,"_28401":58782,"_3085":58783},[],"/docs/platform/pki/overview#what-you-need","What you need",{"_3634":2506,"_31209":2502,"_5":31544,"_21628":58785,"_28401":58786,"_3085":56535},[],"/docs/platform/pki/overview#core-capabilities",{"_3634":2507,"_31209":2502,"_5":31544,"_21628":58788,"_28401":58789,"_3085":56539},[],"/docs/platform/pki/overview#build-your-trust-hierarchy",{"_3634":2508,"_31209":2502,"_5":31544,"_21628":58791,"_28401":58792,"_3085":56543},[],"/docs/platform/pki/overview#protect-cryptographic-keys",{"_3634":2509,"_31209":2502,"_5":31544,"_21628":58794,"_28401":58795,"_3085":56547},[],"/docs/platform/pki/overview#issue-and-control-certificates",{"_3634":2510,"_31209":2502,"_5":31544,"_21628":58797,"_28401":58798,"_3085":56555},[],"/docs/platform/pki/overview#publish-validation-status",{"_3634":2511,"_31209":2502,"_5":31544,"_21628":58800,"_28401":58801,"_3085":58802},[],"/docs/platform/pki/overview#how-to-check-the-result","How to check the result",{"_3634":2512,"_31209":2502,"_5":31544,"_21628":58804,"_28401":58805,"_3085":57531},[],"/docs/platform/pki/overview#continue",{"_3634":2513,"_31209":2502,"_21628":58807,"_5":14884,"_28401":2502,"_3085":58808},[],"The PKI section explains how to build and operate X.509 trust in Lamassu: which authorities issue, which rules apply and how to check certificates. It is intended for PKI administrators and anyone who needs to use certificates in a consuming system.",{"_3634":2514,"_31209":2502,"_21628":58810,"_5":14884,"_28401":58779,"_3085":58811},[],"Follow PKI getting started to create a CA, issue a client certificate and verify it with OpenSSL. The result is a certificate, its private key and a verified chain.",{"_3634":2515,"_31209":2502,"_21628":58813,"_5":14884,"_28401":58779,"_3085":58814},[],"You can complete that path before managing devices. When you need to associate the identity with an inventory or automate its enrollment, continue in IoT Fleets.",{"_3634":2516,"_31209":2502,"_21628":58816,"_5":14884,"_28401":58782,"_3085":58817},[],"An accessible instance and permission to manage the keys, CAs and certificates you will use.",{"_3634":2517,"_31209":2502,"_21628":58819,"_5":14884,"_28401":58782,"_3085":58820},[],"An available cryptographic engine to keep the authority's key.",{"_3634":2518,"_31209":2502,"_21628":58822,"_5":14884,"_28401":58782,"_3085":58823},[],"The certificate's purpose, such as authenticating a client through mTLS.",{"_3634":2519,"_31209":2502,"_21628":58825,"_5":14884,"_28401":58782,"_3085":58826},[],"Consumer requirements: accepted issuers, algorithms, names and permitted usages.",{"_3634":2520,"_31209":2502,"_21628":58828,"_5":14884,"_28401":58782,"_3085":58829},[],"Prepare the instance and cryptographic provider in Deployment. The trust model explains hierarchy choices.",{"_3634":2521,"_31209":2502,"_21628":58831,"_5":14884,"_28401":58789,"_3085":58832},[],"Authorities sign certificates. A root establishes the trust anchor, and an intermediate separates issuance by environment or purpose. Hierarchy and rotation explains how to maintain trust when replacing an authority.",{"_3634":2522,"_31209":2502,"_21628":58834,"_5":14884,"_28401":58792,"_3085":58835},[],"CA signing keys are managed through KMS and cryptographic engines. A client that generates a CSR can keep its own key: preserve that custody when choosing the issuance method.",{"_3634":2523,"_31209":2502,"_21628":58837,"_5":14884,"_28401":58795,"_3085":58838},[],"A profile establishes subject, validity, usage and key restrictions. The CA applies issuance configuration and signs the certificate. In the inventory, you can inspect the result, download it and manage its status.",{"_3634":2524,"_31209":2502,"_21628":58840,"_5":14884,"_28401":58798,"_3085":58841},[],"Validation covers the chain, validity, usages and revocation status. Lamassu publishes status through OCSP and CRL; the consumer configures which issuers it recognizes and how it checks that status.",{"_3634":2525,"_31209":2502,"_21628":58843,"_5":14884,"_28401":58801,"_3085":58844},[],"An active certificate in the console is one part of the check. Also verify that:",{"_3634":2526,"_31209":2502,"_21628":58846,"_5":14884,"_28401":58801,"_3085":58847},[],"its subject and extensions identify the expected client;",{"_3634":2527,"_31209":2502,"_21628":58849,"_5":14884,"_28401":58801,"_3085":58850},[],"its public key matches the client's private key;",{"_3634":2528,"_31209":2502,"_21628":58852,"_5":14884,"_28401":58801,"_3085":58853},[],"its chain reaches a root trusted by the consumer;",{"_3634":2529,"_31209":2502,"_21628":58855,"_5":14884,"_28401":58801,"_3085":58856},[],"its dates and usages allow the operation;",{"_3634":2530,"_31209":2502,"_21628":58858,"_5":14884,"_28401":58801,"_3085":58859},[],"the consumer applies revocation checks and authorization.",{"_3634":2531,"_31209":2502,"_21628":58861,"_5":14884,"_28401":58801,"_3085":58862},[],"The issuance path includes the first independent checks.",{"_3634":2532,"_31209":2502,"_21628":58864,"_5":14884,"_28401":58805,"_3085":58865},[],"<Card title=\"PKI getting started\" description=\"Create a CA, then issue and verify a client certificate.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3634":2533,"_31209":2502,"_21628":58867,"_5":14884,"_28401":58805,"_3085":58868},[],"<Card title=\"Apply PKI to devices\" description=\"Associate certificates with inventory and prepare enrollment.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3634":2534,"_31209":2502,"_21628":58870,"_5":14884,"_28401":58805,"_3085":58871},[],"<Card title=\"PKI diagnostics\" description=\"Check issuance, OCSP and CRL when the result fails.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3634":2535,"_31209":2535,"_5":15244,"_3085":58873,"_31547":58874,"_21628":58875,"_28401":2535},"Create your first CA",[50999,52511,56691,56128],[],{"_3634":2536,"_31209":2535,"_21628":58877,"_5":14884,"_28401":2535,"_3085":58878},[],"Create an evaluation root and check its certificate before issuing.",{"_3634":2537,"_31209":2535,"_5":31544,"_21628":58880,"_28401":58881,"_3085":51009},[],"/docs/platform/pki/quickstarts/create-certificate-authority#before-you-begin",{"_3634":2538,"_31209":2535,"_5":31544,"_21628":58883,"_28401":58884,"_3085":58885},[],"/docs/platform/pki/quickstarts/create-certificate-authority#open-the-creation-wizard-toc","Open the creation wizard [!toc]",{"_3634":2539,"_31209":2535,"_5":31544,"_21628":58887,"_28401":58888,"_3085":58889},[],"/docs/platform/pki/quickstarts/create-certificate-authority#select-the-key-toc","Select the key [!toc]",{"_3634":2540,"_31209":2535,"_5":31544,"_21628":58891,"_28401":58892,"_3085":58893},[],"/docs/platform/pki/quickstarts/create-certificate-authority#define-the-authority-toc","Define the authority [!toc]",{"_3634":2541,"_31209":2535,"_5":31544,"_21628":58895,"_28401":58896,"_3085":58897},[],"/docs/platform/pki/quickstarts/create-certificate-authority#review-and-create-the-ca-toc","Review and create the CA [!toc]",{"_3634":2542,"_31209":2535,"_5":31544,"_21628":58899,"_28401":58900,"_3085":58901},[],"/docs/platform/pki/quickstarts/create-certificate-authority#verify-the-result-toc","Verify the result [!toc]",{"_3634":2543,"_31209":2535,"_5":31544,"_21628":58903,"_28401":58904,"_3085":58905},[],"/docs/platform/pki/quickstarts/create-certificate-authority#check-the-ca-certificate","Check the CA certificate",{"_3634":2544,"_31209":2535,"_5":31544,"_21628":58907,"_28401":58908,"_3085":56385},[],"/docs/platform/pki/quickstarts/create-certificate-authority#if-the-result-fails",{"_3634":2545,"_31209":2535,"_5":31544,"_21628":58910,"_28401":58911,"_3085":51033},[],"/docs/platform/pki/quickstarts/create-certificate-authority#next-step",{"_3634":2546,"_31209":2535,"_21628":58913,"_5":14884,"_28401":2535,"_3085":58914},[],"You will create a root authority with a new key kept by a Lamassu engine. The result is an active CA and its public certificate in `ca.pem`, ready to verify issuance in the next path.",{"_3634":2547,"_31209":2535,"_21628":58916,"_5":14884,"_28401":58881,"_3085":58917},[],"Console access and permission to create keys and authorities.",{"_3634":2548,"_31209":2535,"_21628":58919,"_5":14884,"_28401":58881,"_3085":58920},[],"An available cryptographic engine that supports the chosen algorithm.",{"_3634":2549,"_31209":2535,"_21628":58922,"_5":14884,"_28401":58881,"_3085":58923},[],"OpenSSL 3.x to check the downloaded certificate.",{"_3634":2550,"_31209":2535,"_21628":58925,"_5":14884,"_28401":58881,"_3085":58926},[],"Use an evaluation instance or an authority intended for these tests. The example creates a root that issues directly; to design an operational hierarchy, see Hierarchy and rotation.",{"_3634":2551,"_31209":2535,"_21628":58928,"_5":14884,"_28401":58884,"_3085":58929},[],"In **Certification Authorities**, select **Create New CA** and choose to create a CA with a new key pair.",{"_3634":2552,"_31209":2535,"_21628":58931,"_5":14884,"_28401":58884,"_3085":58932},[],"The &#x2A;*Create New CA (Existing Key)** flow is explained in the authorities guide.",{"_3634":2553,"_31209":2535,"_21628":58934,"_5":14884,"_28401":58888,"_3085":58935},[],"Choose the engine that will keep the key and an algorithm its capabilities allow. For this example, you can use **EC P-384** if available.",{"_3634":2554,"_31209":2535,"_21628":58937,"_5":14884,"_28401":58888,"_3085":58938},[],"The CA private key is used through the engine. In this path, you will download only the authority's public certificate.",{"_3634":2555,"_31209":2535,"_21628":58940,"_5":14884,"_28401":58892,"_3085":58941},[],"Select **Root CA** and complete:",{"_3634":2556,"_31209":2535,"_21628":58943,"_5":14884,"_28401":58892,"_3085":58944},[],"**CA Name**: `Acme Evaluation Root CA`.",{"_3634":2557,"_31209":2535,"_21628":58946,"_5":14884,"_28401":58892,"_3085":58947},[],"**Subject**: organization and country details for your evaluation.",{"_3634":2558,"_31209":2535,"_21628":58949,"_5":14884,"_28401":58892,"_3085":58950},[],"**CA Certificate Expiration**: for example, one year from creation.",{"_3634":2559,"_31209":2535,"_21628":58952,"_5":14884,"_28401":58892,"_3085":58953},[],"**Default End-Entity Certificate Issuance Expiration**: for example, 90 days, within the CA's lifetime.",{"_3634":2560,"_31209":2535,"_21628":58955,"_5":14884,"_28401":58892,"_3085":58956},[],"The CA name becomes its `Common Name`. Keep the CA usages needed to sign certificates and CRLs.",{"_3634":2561,"_31209":2535,"_21628":58958,"_5":14884,"_28401":58896,"_3085":58959},[],"Check the engine, algorithm, subject, root type and dates. Confirm creation and note the authority identifier so you can recognize it in the DMS or API.",{"_3634":2562,"_31209":2535,"_21628":58961,"_5":14884,"_28401":58900,"_3085":58962},[],"Open the new CA. It should appear active, show its certificate and allow access to **Issued Certificates**.",{"_3634":2563,"_31209":2535,"_21628":58964,"_5":14884,"_28401":58900,"_3085":58965},[],"Download or copy the authority's PEM certificate and save it as `ca.pem`. Check that the file contains the complete block, including `BEGIN CERTIFICATE` and `END CERTIFICATE`.",{"_3634":2564,"_31209":2535,"_21628":58967,"_5":14884,"_28401":58904,"_3085":58968},[],"Run from the directory where you saved `ca.pem`:",{"_3634":2565,"_31209":2535,"_21628":58970,"_5":14884,"_28401":58904,"_3085":58971},[],"Check that the subject and issuer match the root you created, the dates include the current time, **Basic Constraints** contains `CA:TRUE` and **Key Usage** allows certificate signing. The last command should return `ca.pem: OK`.",{"_3634":2566,"_31209":2535,"_21628":58973,"_5":14884,"_28401":58904,"_3085":58974},[],"You explicitly selected `ca.pem` as the trust anchor for this test. A valid self-signature does not install that trust in other consumers. See the openssl-verify reference for verification options.",{"_3634":2567,"_31209":2535,"_21628":58976,"_5":14884,"_28401":58908,"_3085":58977},[],"If creation fails, check permissions, engine availability and the selected algorithm.",{"_3634":2568,"_31209":2535,"_21628":58979,"_5":14884,"_28401":58908,"_3085":58980},[],"If OpenSSL cannot read the file, copy the complete PEM block again.",{"_3634":2569,"_31209":2535,"_21628":58982,"_5":14884,"_28401":58908,"_3085":58983},[],"If signature or date checks fail, check that you downloaded this CA's certificate and that your computer's clock is correct.",{"_3634":2570,"_31209":2535,"_21628":58985,"_5":14884,"_28401":58908,"_3085":58986},[],"PKI diagnostics covers issuance checks and cryptographic dependencies.",{"_3634":2571,"_31209":2535,"_21628":58988,"_5":14884,"_28401":58911,"_3085":58989},[],"Continue with Issue and verify a certificate, using this authority and `ca.pem`.",{"_3634":2572,"_31209":2572,"_5":15244,"_3085":58991,"_31547":58992,"_21628":58993,"_28401":2572},"Issue and verify a certificate",[50999,52511,56691,56128],[],{"_3634":2573,"_31209":2572,"_21628":58995,"_5":14884,"_28401":2572,"_3085":58996},[],"Issue a client certificate and check content, chain and key correspondence.",{"_3634":2574,"_31209":2572,"_5":31544,"_21628":58998,"_28401":58999,"_3085":51009},[],"/docs/platform/pki/quickstarts/issue-certificate#before-you-begin",{"_3634":2575,"_31209":2572,"_5":31544,"_21628":59001,"_28401":59002,"_3085":59003},[],"/docs/platform/pki/quickstarts/issue-certificate#start-the-issuance","Start the issuance",{"_3634":2576,"_31209":2572,"_5":31544,"_21628":59005,"_28401":59006,"_3085":59007},[],"/docs/platform/pki/quickstarts/issue-certificate#choose-the-method","Choose the method",{"_3634":2577,"_31209":2572,"_5":31544,"_21628":59009,"_28401":59010,"_3085":59011},[],"/docs/platform/pki/quickstarts/issue-certificate#identify-the-certificate","Identify the certificate",{"_3634":2578,"_31209":2572,"_5":31544,"_21628":59013,"_28401":59014,"_3085":59015},[],"/docs/platform/pki/quickstarts/issue-certificate#configure-key-and-uses","Configure key and uses",{"_3634":2579,"_31209":2572,"_5":31544,"_21628":59017,"_28401":59018,"_3085":59019},[],"/docs/platform/pki/quickstarts/issue-certificate#issue-and-download","Issue and download",{"_3634":2580,"_31209":2572,"_5":31544,"_21628":59021,"_28401":59022,"_3085":59023},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-result","Verify the result",{"_3634":2581,"_31209":2572,"_5":31544,"_21628":59025,"_28401":59026,"_3085":59027},[],"/docs/platform/pki/quickstarts/issue-certificate#inspect-content-and-dates","Inspect content and dates",{"_3634":2582,"_31209":2572,"_5":31544,"_21628":59029,"_28401":59030,"_3085":59031},[],"/docs/platform/pki/quickstarts/issue-certificate#verify-the-chain","Verify the chain",{"_3634":2583,"_31209":2572,"_5":31544,"_21628":59033,"_28401":59034,"_3085":59035},[],"/docs/platform/pki/quickstarts/issue-certificate#check-that-the-key-matches","Check that the key matches",{"_3634":2584,"_31209":2572,"_5":31544,"_21628":59037,"_28401":59038,"_3085":56385},[],"/docs/platform/pki/quickstarts/issue-certificate#if-the-result-fails",{"_3634":2585,"_31209":2572,"_5":31544,"_21628":59040,"_28401":59041,"_3085":51033},[],"/docs/platform/pki/quickstarts/issue-certificate#next-step",{"_3634":2586,"_31209":2572,"_21628":59043,"_5":14884,"_28401":2572,"_3085":59044},[],"You will issue an end-entity certificate for `device-001` using browser key and CSR generation. The result is `device.crt`, `device.key` and the issuing root's public certificate, `ca.pem`.",{"_3634":2587,"_31209":2572,"_21628":59046,"_5":14884,"_28401":58999,"_3085":59047},[],"An active root CA with an available signing key and permission to issue. If one does not exist yet, follow Create your first CA.",{"_3634":2588,"_31209":2572,"_21628":59049,"_5":14884,"_28401":58999,"_3085":59050},[],"Its public certificate in `ca.pem`; this example uses the root created in the previous path.",{"_3634":2589,"_31209":2572,"_21628":59052,"_5":14884,"_28401":58999,"_3085":59053},[],"OpenSSL 3.x and a working directory with restricted access.",{"_3634":2590,"_31209":2572,"_21628":59055,"_5":14884,"_28401":58999,"_3085":59056},[],"A client identifier: here we use `device-001`.",{"_3634":2591,"_31209":2572,"_21628":59058,"_5":14884,"_28401":58999,"_3085":59059},[],"In this flow, the client's key is generated in the browser and must be downloaded when issuance finishes. If you lose it, you must generate a key and issue another certificate. The certificate inventory lets you download the public certificate, but cannot recover this key.",{"_3634":2592,"_31209":2572,"_21628":59061,"_5":14884,"_28401":59002,"_3085":59062},[],"Open the CA from the previous path, go to **Issued Certificates** and select **Issue New**.",{"_3634":2593,"_31209":2572,"_21628":59064,"_5":14884,"_28401":59006,"_3085":59065},[],"Select **Generate Key & CSR in Browser** to follow this example.",{"_3634":2594,"_31209":2572,"_21628":59067,"_5":14884,"_28401":59006,"_3085":59068},[],"If the key must be generated and kept on the destination system, use **Upload Existing CSR**, described in the authorities guide.",{"_3634":2595,"_31209":2572,"_21628":59070,"_5":14884,"_28401":59010,"_3085":59071},[],"Enter `device-001` as the `Common Name`. Add subject details required by your policy and SANs if the consumer uses them to identify the client.",{"_3634":2596,"_31209":2572,"_21628":59073,"_5":14884,"_28401":59010,"_3085":59074},[],"If you continue with manual registration, the `Device ID` will be exactly `device-001`.",{"_3634":2597,"_31209":2572,"_21628":59076,"_5":14884,"_28401":59014,"_3085":59077},[],"Choose an algorithm and size allowed by the profile; for example, ECDSA P-256 if permitted. For this client certificate, select **Digital Signature** and **Client Authentication**, and issue it as an end-entity certificate.",{"_3634":2598,"_31209":2572,"_21628":59079,"_5":14884,"_28401":59014,"_3085":59080},[],"Request, for example, 30 days of validity, always within the CA's lifetime. Review the issuance profile if the resulting content differs from the request.",{"_3634":2599,"_31209":2572,"_21628":59082,"_5":14884,"_28401":59018,"_3085":59083},[],"Confirm issuance. Save the PEM certificate as `device.crt` and the private key as `device.key` in your prepared directory.",{"_3634":2600,"_31209":2572,"_21628":59085,"_5":14884,"_28401":59022,"_3085":59086},[],"Check in **Issued Certificates** that the certificate appears active. Note its serial number and verify the downloaded material using the checks below.",{"_3634":2601,"_31209":2572,"_21628":59088,"_5":14884,"_28401":59026,"_3085":59089},[],"Check `CN=device-001`, the expected issuer, current validity, **Digital Signature** and the extended usage **TLS Web Client Authentication**. It must be an end-entity certificate: it must not declare `CA:TRUE` or enable **Certificate Sign**. If **Basic Constraints** is present, it must indicate `CA:FALSE`. If you requested SANs, check that the expected identifiers appear in the certificate.",{"_3634":2602,"_31209":2572,"_21628":59091,"_5":14884,"_28401":59030,"_3085":59092},[],"The expected result is `device.crt: OK`. This check uses your explicit root and evaluates the chain, dates and compatibility with the TLS client purpose. Also check for the expected usages and names through the inspection above.",{"_3634":2603,"_31209":2572,"_21628":59094,"_5":14884,"_28401":59030,"_3085":59095},[],"If you use an intermediate CA, the trusted root must be in `ca.pem` and you must supply the intermediates with `-untrusted intermediates.pem`. This variant is covered in the trust model.",{"_3634":2604,"_31209":2572,"_21628":59097,"_5":14884,"_28401":59030,"_3085":59098},[],"The command does not query OCSP or CRL. For revocation checks, continue with Certificate validation. See the openssl-verify reference for its options.",{"_3634":2605,"_31209":2572,"_21628":59100,"_5":14884,"_28401":59034,"_3085":59101},[],"In Bash, compare the two public-key digests:",{"_3634":2606,"_31209":2572,"_21628":59103,"_5":14884,"_28401":59034,"_3085":59104},[],"Both commands must finish successfully and show the same SHA-256 digest. If they differ, the private key does not match the selected certificate. Find the correct pair before installing it.",{"_3634":2607,"_31209":2572,"_21628":59106,"_5":14884,"_28401":59034,"_3085":59107},[],"The options used are documented in openssl-x509 and openssl-pkey.",{"_3634":2608,"_31209":2572,"_21628":59109,"_5":14884,"_28401":59038,"_3085":56469},[],{"_3634":2609,"_31209":2572,"_21628":59111,"_5":14884,"_28401":59038,"_3085":59112},[],"What to review",{"_3634":2610,"_31209":2572,"_21628":59114,"_5":14884,"_28401":59038,"_3085":59115},[],"The CA rejects issuance",{"_3634":2611,"_31209":2572,"_21628":59117,"_5":14884,"_28401":59038,"_3085":59118},[],"Permissions, CA state and key, algorithm and profile.",{"_3634":2612,"_31209":2572,"_21628":59120,"_5":14884,"_28401":59038,"_3085":59121},[],"Different subject or usages",{"_3634":2613,"_31209":2572,"_21628":59123,"_5":14884,"_28401":59038,"_3085":59124},[],"Applied profile and requested values.",{"_3634":2614,"_31209":2572,"_21628":59126,"_5":14884,"_28401":59038,"_3085":59127},[],"Issuer cannot be found",{"_3634":2615,"_31209":2572,"_21628":59129,"_5":14884,"_28401":59038,"_3085":59130},[],"Downloaded CA and required intermediate chain.",{"_3634":2616,"_31209":2572,"_21628":59132,"_5":14884,"_28401":59038,"_3085":59133},[],"Validity fails",{"_3634":2617,"_31209":2572,"_21628":59135,"_5":14884,"_28401":59038,"_3085":59136},[],"Certificate and CA dates, and the computer's clock.",{"_3634":2618,"_31209":2572,"_21628":59138,"_5":14884,"_28401":59038,"_3085":59139},[],"Public-key digests differ",{"_3634":2619,"_31209":2572,"_21628":59141,"_5":14884,"_28401":59038,"_3085":59142},[],"Certificate and key files from the same issuance.",{"_3634":2620,"_31209":2572,"_21628":59144,"_5":14884,"_28401":59038,"_3085":59145},[],"See PKI diagnostics to narrow an issuance failure.",{"_3634":2621,"_31209":2572,"_21628":59147,"_5":14884,"_28401":59041,"_3085":59148},[],"You have completed the PKI path when the certificate verifies and the key matches. Choose how to use it:",{"_3634":2622,"_31209":2572,"_21628":59150,"_5":14884,"_28401":59041,"_3085":59151},[],"Manage certificates for inspection, status and revocation.",{"_3634":2623,"_31209":2572,"_21628":59153,"_5":14884,"_28401":59041,"_3085":59154},[],"Register a device manually to associate this identity with Lamassu's inventory.",{"_3634":2624,"_31209":2572,"_21628":59156,"_5":14884,"_28401":59041,"_3085":59157},[],"Prepare EST for the device to request its next identities.",{"_3634":2625,"_31209":2572,"_21628":59159,"_5":14884,"_28401":59041,"_3085":59160},[],"Acceptance by a consumer requires configuring its trust, revocation checks and permissions granted to the identity.",{"_3634":2626,"_31209":2626,"_5":15244,"_3085":59162,"_31547":59163,"_21628":59164,"_28401":2626},"PKI getting started",[50999,52511,56691,56128],[],{"_3634":2627,"_31209":2626,"_21628":59166,"_5":14884,"_28401":2626,"_3085":59167},[],"Create a CA, issue a client certificate and check its chain and key.",{"_3634":2628,"_31209":2626,"_5":31544,"_21628":59169,"_28401":59170,"_3085":51009},[],"/docs/platform/pki/quickstarts/overview#before-you-begin",{"_3634":2629,"_31209":2626,"_5":31544,"_21628":59172,"_28401":59173,"_3085":59174},[],"/docs/platform/pki/quickstarts/overview#recommended-path","Recommended path",{"_3634":2630,"_31209":2626,"_5":31544,"_21628":59176,"_28401":59177,"_3085":56320},[],"/docs/platform/pki/quickstarts/overview#expected-result",{"_3634":2631,"_31209":2626,"_5":31544,"_21628":59179,"_28401":59180,"_3085":59181},[],"/docs/platform/pki/quickstarts/overview#continue-according-to-your-goal","Continue according to your goal",{"_3634":2632,"_31209":2626,"_21628":59183,"_5":14884,"_28401":2626,"_3085":59184},[],"This path is intended for those starting to administer PKI or needing a first X.509 client identity. It ends with three files: a root CA certificate, an end-entity certificate and the client's private key.",{"_3634":2633,"_31209":2626,"_21628":59186,"_5":14884,"_28401":59170,"_3085":59187},[],"A Lamassu instance accessible from your browser. To prepare one, see Deployment.",{"_3634":2634,"_31209":2626,"_21628":59189,"_5":14884,"_28401":59170,"_3085":59190},[],"Permission to manage keys, authorities and issuance. See Access control if an operation is blocked.",{"_3634":2635,"_31209":2626,"_21628":59192,"_5":14884,"_28401":59170,"_3085":59193},[],"An available cryptographic engine for the CA key; check the keys and engines inventory.",{"_3634":2636,"_31209":2626,"_21628":59195,"_5":14884,"_28401":59170,"_3085":59196},[],"OpenSSL 3.x on the computer where you will verify the files.",{"_3634":2637,"_31209":2626,"_21628":59198,"_5":14884,"_28401":59170,"_3085":59199},[],"A working directory with restricted access for the downloaded key.",{"_3634":2638,"_31209":2626,"_21628":59201,"_5":14884,"_28401":59173,"_3085":59202},[],"<Card title=\"1. Create your first CA\" description=\"Create an evaluation root and save its public certificate as ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3634":2639,"_31209":2626,"_21628":59204,"_5":14884,"_28401":59173,"_3085":59205},[],"<Card title=\"2. Issue and verify a certificate\" description=\"Issue for device-001 and check content, chain and key correspondence.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3634":2640,"_31209":2626,"_21628":59207,"_5":14884,"_28401":59173,"_3085":59208},[],"We use `Acme Evaluation Root CA` and `device-001` as example names. If you replace them, keep the same client identifier in the steps you want to connect.",{"_3634":2641,"_31209":2626,"_21628":59210,"_5":14884,"_28401":59173,"_3085":59211},[],"The root in this path signs the end-entity certificate directly to simplify evaluation. Before designing an operational PKI, review the trust model and CA hierarchy.",{"_3634":2642,"_31209":2626,"_21628":59213,"_5":14884,"_28401":59177,"_3085":59214},[],"File or resource",{"_3634":2643,"_31209":2626,"_21628":59216,"_5":14884,"_28401":59177,"_3085":56317},[],{"_3634":2644,"_31209":2626,"_21628":59218,"_5":14884,"_28401":59177,"_3085":59219},[],"Active root CA and `ca.pem`",{"_3634":2645,"_31209":2626,"_21628":59221,"_5":14884,"_28401":59177,"_3085":59222},[],"It is a CA certificate, is currently valid and its self-signature verifies.",{"_3634":2646,"_31209":2626,"_21628":59224,"_5":14884,"_28401":59177,"_3085":59225},[],"End-entity certificate and `device.crt`",{"_3634":2647,"_31209":2626,"_21628":59227,"_5":14884,"_28401":59177,"_3085":59228},[],"It identifies `device-001`, supports client authentication and verifies against `ca.pem`.",{"_3634":2648,"_31209":2626,"_21628":59230,"_5":14884,"_28401":59177,"_3085":59231},[],"Private key `device.key`",{"_3634":2649,"_31209":2626,"_21628":59233,"_5":14884,"_28401":59177,"_3085":59234},[],"Its public key matches the one included in `device.crt`.",{"_3634":2650,"_31209":2626,"_21628":59236,"_5":14884,"_28401":59177,"_3085":59237},[],"These checks validate the issued material. Acceptance by a service also requires its trust, authorization and revocation configuration.",{"_3634":2651,"_31209":2626,"_21628":59239,"_5":14884,"_28401":59180,"_3085":59240},[],"To operate certificates, continue with Certificates and Validation.",{"_3634":2652,"_31209":2626,"_21628":59242,"_5":14884,"_28401":59180,"_3085":59243},[],"To manage a device identity in Lamassu, follow Manual registration. That path includes DMS preparation.",{"_3634":2653,"_31209":2626,"_21628":59245,"_5":14884,"_28401":59180,"_3085":59246},[],"For the device to request its certificate, prepare the DMS and EST client.",{"_3634":2654,"_31209":2654,"_5":15244,"_3085":59248,"_31547":59249,"_21628":59250,"_28401":2654},"PKI troubleshooting",[50999,52511,56691,55266],[],{"_3634":2655,"_31209":2654,"_21628":59252,"_5":14884,"_28401":2654,"_3085":59253},[],"Diagnose certificate issuance, OCSP and CRL.",{"_3634":2656,"_31209":2654,"_5":31544,"_21628":59255,"_28401":59256,"_3085":59257},[],"/docs/platform/pki/troubleshooting#issuance-fails","Issuance fails",{"_3634":2657,"_31209":2654,"_5":31544,"_21628":59259,"_28401":59260,"_3085":59261},[],"/docs/platform/pki/troubleshooting#ocsp-or-crl-do-not-reflect-a-change","OCSP or CRL do not reflect a change",{"_3634":2658,"_31209":2654,"_5":31544,"_21628":59263,"_28401":59264,"_3085":59265},[],"/docs/platform/pki/troubleshooting#the-chain-validates-but-the-connection-fails","The chain validates but the connection fails",{"_3634":2659,"_31209":2654,"_21628":59267,"_5":14884,"_28401":2654,"_3085":59268},[],"This guide helps a PKI operator locate issuance and status publication failures. Keep the Lamassu version, operation, CA, issuer, serial, time and returned error. Do not include private keys or tokens in diagnostics.",{"_3634":2660,"_31209":2654,"_21628":59270,"_5":14884,"_28401":2654,"_3085":59271},[],"For Gateway, sign-in, pods, dependencies and messaging, see Deployment troubleshooting. For device enrollment, see EST diagnostics.",{"_3634":2661,"_31209":2654,"_21628":59273,"_5":14884,"_28401":59256,"_3085":56317},[],{"_3634":2662,"_31209":2654,"_21628":59275,"_5":14884,"_28401":59256,"_3085":59276},[],"What to inspect",{"_3634":2663,"_31209":2654,"_21628":59278,"_5":14884,"_28401":59256,"_3085":51033},[],{"_3634":2664,"_31209":2654,"_21628":59280,"_5":14884,"_28401":59256,"_3085":55533},[],{"_3634":2665,"_31209":2654,"_21628":59282,"_5":14884,"_28401":59256,"_3085":59283},[],"Exists, is active and has usable dates.",{"_3634":2666,"_31209":2654,"_21628":59285,"_5":14884,"_28401":59256,"_3085":59286},[],"Authorities.",{"_3634":2667,"_31209":2654,"_21628":59288,"_5":14884,"_28401":59256,"_3085":59289},[],"Key",{"_3634":2668,"_31209":2654,"_21628":59291,"_5":14884,"_28401":59256,"_3085":59292},[],"The record has a usable private key and the engine can sign.",{"_3634":2669,"_31209":2654,"_21628":59294,"_5":14884,"_28401":59256,"_3085":59295},[],"Try **Sign / Verify** in KMS; check provider permissions and availability.",{"_3634":2670,"_31209":2654,"_21628":59297,"_5":14884,"_28401":59256,"_3085":59298},[],"CSR",{"_3634":2671,"_31209":2654,"_21628":59300,"_5":14884,"_28401":59256,"_3085":59301},[],"Correct PEM and verifiable signature.",{"_3634":2672,"_31209":2654,"_21628":59303,"_5":14884,"_28401":59256,"_3085":59304},[],"`openssl req -in request.csr -noout -verify -text`.",{"_3634":2673,"_31209":2654,"_21628":59306,"_5":14884,"_28401":59256,"_3085":59307},[],"Profile",{"_3634":2674,"_31209":2654,"_21628":59309,"_5":14884,"_28401":59256,"_3085":59310},[],"Selected source, existing ID, allowed algorithm and size.",{"_3634":2675,"_31209":2654,"_21628":59312,"_5":14884,"_28401":59256,"_3085":59313},[],"Check Profiles precedence; CA and DMS resolve differently.",{"_3634":2676,"_31209":2654,"_21628":59315,"_5":14884,"_28401":59256,"_3085":56469},[],{"_3634":2677,"_31209":2654,"_21628":59317,"_5":14884,"_28401":59256,"_3085":59318},[],"Appropriate subject, SAN, usages and dates.",{"_3634":2678,"_31209":2654,"_21628":59320,"_5":14884,"_28401":59256,"_3085":59321},[],"Compare CSR, profile and certificate; successful issuance does not establish consumer acceptance.",{"_3634":2679,"_31209":2654,"_21628":59323,"_5":14884,"_28401":59256,"_3085":59324},[],"For unexpected certificate fields, review `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` and `Honor Extensions`. The latter preserves SAN only, without validating entitlement to those names. Validity is not automatically clamped to CA expiration.",{"_3634":2680,"_31209":2654,"_21628":59326,"_5":14884,"_28401":59256,"_3085":59327},[],"If issuance fails with `400` and `CA Status inconsistent`, the issuing CA is not `ACTIVE` or is outside the validity period of its certificate. The stored status can lag behind the dates until the expiration monitor runs, so check the dates too. Reissue the CA while it is still valid, or issue from another CA.",{"_3634":2681,"_31209":2654,"_21628":59329,"_5":14884,"_28401":59256,"_3085":59330},[],"For CA reissuance failures, check revocation and date: reissuance is not supported for a revoked or already expired CA. For a subordinate CA, also check the status and dates of its parent. To change its key, use Hierarchy and rotation.",{"_3634":2682,"_31209":2654,"_21628":59332,"_5":14884,"_28401":59260,"_3085":59333},[],"Check each boundary independently:",{"_3634":2683,"_31209":2654,"_21628":59335,"_5":14884,"_28401":59260,"_3085":59336},[],"**Record:** read the correct certificate again by serial and issuer. Confirm status, reason and time; expired or permanently revoked records reject further transitions.",{"_3634":2684,"_31209":2654,"_21628":59338,"_5":14884,"_28401":59260,"_3085":59339},[],"**Endpoint:** inspect AIA and CDP. Query those URLs from the consumer’s network; an old route or incorrect issuer can explain a discrepancy.",{"_3634":2685,"_31209":2654,"_21628":59341,"_5":14884,"_28401":59260,"_3085":59342},[],"**OCSP:** save a fresh response, verify signature and timestamps, and observe status. An HTTP error for an absent serial does not mean `Good` or guarantee a signed `Unknown`.",{"_3634":2686,"_31209":2654,"_21628":59344,"_5":14884,"_28401":59260,"_3085":59345},[],"**CRL:** compare `latest_crl`, number and timestamps with the downloaded list. Check the serial in its contents. If unchanged, review `regenerate_on_revoke`, event delivery, jobs, signing and storage with the deployment operator.",{"_3634":2687,"_31209":2654,"_21628":59347,"_5":14884,"_28401":59260,"_3085":59348},[],"**Client:** check cache, policy for expired or unavailable evidence, critical IDP extension and rejection of a new connection.",{"_3634":2688,"_31209":2654,"_21628":59350,"_5":14884,"_28401":59260,"_3085":59351},[],"Reactivation from `CertificateHold` needs a new CRL for the client to stop seeing the hold. A hold cascaded from a CA is lifted by releasing that CA; a cascade from a CA revoked for good is not. Inspect every status and individual operation failure.",{"_3634":2689,"_31209":2654,"_21628":59353,"_5":14884,"_28401":59264,"_3085":59354},[],"Check expected identity, SAN, KU/EKU, matching key, presented intermediates and consumer permissions. Distinguish server TLS trust, client authentication and action authorization. Follow Validation for positive and rejection tests.",{"_3634":2690,"_31209":2654,"_21628":59356,"_5":14884,"_28401":59264,"_3085":59357},[],"When escalating a problem, provide identifiers, error and relevant public evidence, including query timestamps and version. This distinguishes issuance, publication and consumer application failures.",{"_3634":2691,"_31209":2691,"_5":15244,"_3085":59359,"_31547":59360,"_21628":59361,"_28401":2691},"Security",[50999],[],{"_3634":2692,"_31209":2691,"_21628":59363,"_5":14884,"_28401":2691,"_3085":59364},[],"How to report a security vulnerability in Lamassu privately, what to include in a report and which releases receive security fixes.",{"_3634":2693,"_31209":2691,"_5":31544,"_21628":59366,"_28401":59367,"_3085":59368},[],"/docs/security#report-a-vulnerability","Report a vulnerability",{"_3634":2694,"_31209":2691,"_5":31544,"_21628":59370,"_28401":59371,"_3085":59372},[],"/docs/security#what-to-include-in-a-report","What to include in a report",{"_3634":2695,"_31209":2691,"_5":31544,"_21628":59374,"_28401":59375,"_3085":59376},[],"/docs/security#supported-versions","Supported versions",{"_3634":2696,"_31209":2691,"_5":31544,"_21628":59378,"_28401":59379,"_3085":59380},[],"/docs/security#responsible-disclosure","Responsible disclosure",{"_3634":2697,"_31209":2691,"_21628":59382,"_5":14884,"_28401":2691,"_3085":59383},[],"Found a security vulnerability in lamassuiot, lamassu-dashboard, or lamassu-helm? This page explains how to report it privately, what to include in your report and which releases receive security fixes.",{"_3634":2698,"_31209":2691,"_21628":59385,"_5":14884,"_28401":59367,"_3085":59386},[],"Do not report security vulnerabilities through public GitHub issues, discussions, or pull requests. Public reports disclose the problem before maintainers can fix it.",{"_3634":2699,"_31209":2691,"_21628":59388,"_5":14884,"_28401":59367,"_3085":59389},[],"Instead, report privately using GitHub Security Advisories for the affected repository:",{"_3634":2700,"_31209":2691,"_21628":59391,"_5":14884,"_28401":59367,"_3085":15523},[],{"_3634":2701,"_31209":2691,"_21628":59393,"_5":14884,"_28401":59367,"_3085":15452},[],{"_3634":2702,"_31209":2691,"_21628":59395,"_5":14884,"_28401":59367,"_3085":15510},[],{"_3634":2703,"_31209":2691,"_21628":59397,"_5":14884,"_28401":59367,"_3085":59398},[],"This lets maintainers assess and address the issue before it is publicly disclosed.",{"_3634":2704,"_31209":2691,"_21628":59400,"_5":14884,"_28401":59367,"_3085":59401},[],"If private vulnerability reporting is not enabled for that repository, report the vulnerability privately to lamassuiot\\@lksnext.com before disclosing any details publicly.",{"_3634":2705,"_31209":2691,"_21628":59403,"_5":14884,"_28401":59371,"_3085":59404},[],"Describe the vulnerability, its potential impact, and steps to reproduce it using non-sensitive, redacted examples.",{"_3634":2706,"_31209":2691,"_21628":59406,"_5":14884,"_28401":59371,"_3085":59407},[],"Do not include in the report:",{"_3634":2707,"_31209":2691,"_21628":59409,"_5":14884,"_28401":59371,"_3085":59410},[],"Credentials, tokens, or private keys",{"_3634":2708,"_31209":2691,"_21628":59412,"_5":14884,"_28401":59371,"_3085":59413},[],"Customer data or customer-identifiable information",{"_3634":2709,"_31209":2691,"_21628":59415,"_5":14884,"_28401":59371,"_3085":59416},[],"Confidential architecture or internal infrastructure details",{"_3634":2710,"_31209":2691,"_21628":59418,"_5":14884,"_28401":59375,"_3085":59419},[],"Only the latest stable release receives security support. Support for a stable release ends when the next stable release is published. Older releases and pre-releases are not supported.",{"_3634":2711,"_31209":2691,"_21628":59421,"_5":14884,"_28401":59375,"_3085":59422},[],"For upgrade guidance, see Upgrades.",{"_3634":2712,"_31209":2691,"_21628":59424,"_5":14884,"_28401":59379,"_3085":59425},[],"Give maintainers reasonable time to investigate and address a reported vulnerability before any public disclosure.",{"_3634":2713,"_31209":2691,"_21628":59427,"_5":14884,"_28401":59379,"_3085":59428},[],"Avoid privacy violations, data destruction, and service disruption while researching a vulnerability.",{"_3634":2714,"_31209":2691,"_21628":59430,"_5":14884,"_28401":59379,"_3085":59431},[],"Only interact with accounts or data you own, or for which you have explicit permission.",{"_3634":2715,"_31209":2691,"_21628":59433,"_5":14884,"_28401":59379,"_3085":59434},[],"Maintainers acknowledge reports in a timely manner and keep you informed of remediation progress.",{"_3634":2716,"_31209":2691,"_21628":59436,"_5":14884,"_28401":59379,"_3085":59437},[],"This policy covers the source code, configuration, and CI/CD workflows of the lamassuiot, lamassu-dashboard, and lamassu-helm repositories.",{"_3634":2717,"_31209":2717,"_5":15244,"_3085":59439,"_31547":59440,"_21628":59442,"_28401":2717},"3.8.0 to 4.0.0",[50999,59441],"Upgrades",[],{"_3634":2718,"_31209":2717,"_21628":59444,"_5":14884,"_28401":2717,"_3085":59445},[],"What changes in the 4.0.0 architecture, which changes break a 3.8.0 deployment, how to upgrade a Helm release step by step and how to validate the result.",{"_3634":2719,"_31209":2717,"_5":31544,"_21628":59447,"_28401":59448,"_3085":59449},[],"/docs/upgrades/3-8-0-to-4-0-0#architecture-changes","Architecture changes",{"_3634":2720,"_31209":2717,"_5":31544,"_21628":59451,"_28401":59452,"_3085":59453},[],"/docs/upgrades/3-8-0-to-4-0-0#one-postgresql-database-with-schemas","One PostgreSQL database with schemas",{"_3634":2721,"_31209":2717,"_5":31544,"_21628":59455,"_28401":59456,"_3085":59457},[],"/docs/upgrades/3-8-0-to-4-0-0#authorization-moves-into-the-authz-service","Authorization moves into the authz service",{"_3634":2722,"_31209":2717,"_5":31544,"_21628":59459,"_28401":59460,"_3085":59461},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events-get-their-own-store","Device events get their own store",{"_3634":2723,"_31209":2717,"_5":31544,"_21628":59463,"_28401":59464,"_3085":59465},[],"/docs/upgrades/3-8-0-to-4-0-0#a-hardened-helm-chart","A hardened Helm chart",{"_3634":2724,"_31209":2717,"_5":31544,"_21628":59467,"_28401":59468,"_3085":59469},[],"/docs/upgrades/3-8-0-to-4-0-0#what-the-upgrade-migrates-automatically","What the upgrade migrates automatically",{"_3634":2725,"_31209":2717,"_5":31544,"_21628":59471,"_28401":59472,"_3085":59473},[],"/docs/upgrades/3-8-0-to-4-0-0#breaking-changes","Breaking changes",{"_3634":2726,"_31209":2717,"_5":31544,"_21628":59475,"_28401":59476,"_3085":59477},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-chart-and-values","Helm chart and values",{"_3634":2727,"_31209":2717,"_5":31544,"_21628":59479,"_28401":59480,"_3085":59481},[],"/docs/upgrades/3-8-0-to-4-0-0#release-scoped-resource-names","Release-scoped resource names",{"_3634":2728,"_31209":2717,"_5":31544,"_21628":59483,"_28401":59484,"_3085":59485},[],"/docs/upgrades/3-8-0-to-4-0-0#strict-values-validation","Strict values validation",{"_3634":2729,"_31209":2717,"_5":31544,"_21628":59487,"_28401":59488,"_3085":51637},[],"/docs/upgrades/3-8-0-to-4-0-0#credentials-in-kubernetes-secrets",{"_3634":2730,"_31209":2717,"_5":31544,"_21628":59490,"_28401":59491,"_3085":59492},[],"/docs/upgrades/3-8-0-to-4-0-0#required-authorization-configuration","Required authorization configuration",{"_3634":2731,"_31209":2717,"_5":31544,"_21628":59494,"_28401":59495,"_3085":59496},[],"/docs/upgrades/3-8-0-to-4-0-0#gateway-token-validation-removed","Gateway token validation removed",{"_3634":2732,"_31209":2717,"_5":31544,"_21628":59498,"_28401":59499,"_3085":59500},[],"/docs/upgrades/3-8-0-to-4-0-0#non-root-containers","Non-root containers",{"_3634":2733,"_31209":2717,"_5":31544,"_21628":59502,"_28401":59503,"_3085":59504},[],"/docs/upgrades/3-8-0-to-4-0-0#amqp-over-tls","AMQP over TLS",{"_3634":2734,"_31209":2717,"_5":31544,"_21628":59506,"_28401":59507,"_3085":59508},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-and-reshaped-values","Renamed and reshaped values",{"_3634":2735,"_31209":2717,"_5":31544,"_21628":59510,"_28401":59511,"_3085":59512},[],"/docs/upgrades/3-8-0-to-4-0-0#data-and-storage","Data and storage",{"_3634":2736,"_31209":2717,"_5":31544,"_21628":59514,"_28401":59515,"_3085":59516},[],"/docs/upgrades/3-8-0-to-4-0-0#postgresql-consolidation","PostgreSQL consolidation",{"_3634":2737,"_31209":2717,"_5":31544,"_21628":59518,"_28401":59519,"_3085":59520},[],"/docs/upgrades/3-8-0-to-4-0-0#sqlite-storage-removed","SQLite storage removed",{"_3634":2738,"_31209":2717,"_5":31544,"_21628":59522,"_28401":59523,"_3085":59524},[],"/docs/upgrades/3-8-0-to-4-0-0#legacy-ca-keys-in-the-kms","Legacy CA keys in the KMS",{"_3634":2739,"_31209":2717,"_5":31544,"_21628":59526,"_28401":59527,"_3085":59528},[],"/docs/upgrades/3-8-0-to-4-0-0#references-between-certificates-keys-and-crl-settings","References between certificates, keys and CRL settings",{"_3634":2740,"_31209":2717,"_5":31544,"_21628":59530,"_28401":59531,"_3085":59532},[],"/docs/upgrades/3-8-0-to-4-0-0#apis-and-stored-configuration","APIs and stored configuration",{"_3634":2741,"_31209":2717,"_5":31544,"_21628":59534,"_28401":59535,"_3085":59536},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-webhooks","DMS webhooks",{"_3634":2742,"_31209":2717,"_5":31544,"_21628":59538,"_28401":59539,"_3085":59540},[],"/docs/upgrades/3-8-0-to-4-0-0#re-enrollment-trust-set","Re-enrollment trust set",{"_3634":2743,"_31209":2717,"_5":31544,"_21628":59542,"_28401":59543,"_3085":59544},[],"/docs/upgrades/3-8-0-to-4-0-0#fail-closed-revocation-checks","Fail-closed revocation checks",{"_3634":2744,"_31209":2717,"_5":31544,"_21628":59546,"_28401":59547,"_3085":59548},[],"/docs/upgrades/3-8-0-to-4-0-0#independent-re-enrollment-authentication","Independent re-enrollment authentication",{"_3634":2745,"_31209":2717,"_5":31544,"_21628":59550,"_28401":59551,"_3085":59552},[],"/docs/upgrades/3-8-0-to-4-0-0#dms-update-api","DMS update API",{"_3634":2746,"_31209":2717,"_5":31544,"_21628":59554,"_28401":59555,"_3085":59556},[],"/docs/upgrades/3-8-0-to-4-0-0#certificate-type-values","Certificate type values",{"_3634":2747,"_31209":2717,"_5":31544,"_21628":59558,"_28401":59559,"_3085":59560},[],"/docs/upgrades/3-8-0-to-4-0-0#device-events","Device events",{"_3634":2748,"_31209":2717,"_5":31544,"_21628":59562,"_28401":59563,"_3085":59564},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-signer-field","CRL signer field",{"_3634":2749,"_31209":2717,"_5":31544,"_21628":59566,"_28401":59567,"_3085":59568},[],"/docs/upgrades/3-8-0-to-4-0-0#crl-settings-keyed-by-ca-id","CRL settings keyed by CA ID",{"_3634":2750,"_31209":2717,"_5":31544,"_21628":59570,"_28401":59571,"_3085":59572},[],"/docs/upgrades/3-8-0-to-4-0-0#renamed-va-events","Renamed VA events",{"_3634":2751,"_31209":2717,"_5":31544,"_21628":59574,"_28401":59575,"_3085":59576},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed","CA signature endpoints removed",{"_3634":2752,"_31209":2717,"_5":31544,"_21628":59578,"_28401":59579,"_3085":59580},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-ids-are-always-assigned-by-the-backend","CA IDs are always assigned by the backend",{"_3634":2753,"_31209":2717,"_5":31544,"_21628":59582,"_28401":59583,"_3085":59576},[],"/docs/upgrades/3-8-0-to-4-0-0#ca-signature-endpoints-removed-1",{"_3634":2754,"_31209":2717,"_5":31544,"_21628":59585,"_28401":59586,"_3085":59587},[],"/docs/upgrades/3-8-0-to-4-0-0#va-crl-signer","VA CRL signer",{"_3634":2755,"_31209":2717,"_5":31544,"_21628":59589,"_28401":59590,"_3085":59591},[],"/docs/upgrades/3-8-0-to-4-0-0#helm-migration-guide","Helm migration guide",{"_3634":2756,"_31209":2717,"_5":31544,"_21628":59593,"_28401":59594,"_3085":59595},[],"/docs/upgrades/3-8-0-to-4-0-0#step-1-prepare","Step 1: Prepare",{"_3634":2757,"_31209":2717,"_5":31544,"_21628":59597,"_28401":59598,"_3085":59599},[],"/docs/upgrades/3-8-0-to-4-0-0#pre-upgrade-check","Pre-upgrade check",{"_3634":2758,"_31209":2717,"_5":31544,"_21628":59601,"_28401":59602,"_3085":59603},[],"/docs/upgrades/3-8-0-to-4-0-0#step-2-update-the-values-file","Step 2: Update the values file",{"_3634":2759,"_31209":2717,"_5":31544,"_21628":59605,"_28401":59606,"_3085":59607},[],"/docs/upgrades/3-8-0-to-4-0-0#step-3-run-the-upgrade","Step 3: Run the upgrade",{"_3634":2760,"_31209":2717,"_5":31544,"_21628":59609,"_28401":59610,"_3085":59611},[],"/docs/upgrades/3-8-0-to-4-0-0#step-4-migrate-the-kms-and-va-data","Step 4: Migrate the KMS and VA data",{"_3634":2761,"_31209":2717,"_5":31544,"_21628":59613,"_28401":59614,"_3085":59615},[],"/docs/upgrades/3-8-0-to-4-0-0#step-5-remove-the-one-off-migration-values","Step 5: Remove the one-off migration values",{"_3634":2762,"_31209":2717,"_5":31544,"_21628":59617,"_28401":59618,"_3085":59619},[],"/docs/upgrades/3-8-0-to-4-0-0#deployments-without-helm","Deployments without Helm",{"_3634":2763,"_31209":2717,"_5":31544,"_21628":59621,"_28401":59622,"_3085":55266},[],"/docs/upgrades/3-8-0-to-4-0-0#troubleshooting",{"_3634":2764,"_31209":2717,"_5":31544,"_21628":59624,"_28401":59625,"_3085":59626},[],"/docs/upgrades/3-8-0-to-4-0-0#validation-checklist","Validation checklist",{"_3634":2765,"_31209":2717,"_5":31544,"_21628":59628,"_28401":59629,"_3085":59630},[],"/docs/upgrades/3-8-0-to-4-0-0#delete-the-old-volumes","Delete the old volumes",{"_3634":2766,"_31209":2717,"_21628":59632,"_5":14884,"_28401":2717,"_3085":59633},[],"Lamassu 4.0.0 is a major release. Storage consolidates into a single PostgreSQL database, a new `authz` service authorizes every request, the Helm chart is hardened, and several APIs and stored configurations change shape. Most data converts automatically during the upgrade, but some changes need operator action before, during or after it.",{"_3634":2767,"_31209":2717,"_21628":59635,"_5":14884,"_28401":2717,"_3085":59636},[],"This page is organized in four parts. Read them in order before you upgrade production:",{"_3634":2768,"_31209":2717,"_21628":59638,"_5":14884,"_28401":2717,"_3085":59639},[],"Architecture changes: what is different in 4.0.0 and what the upgrade migrates on its own.",{"_3634":2769,"_31209":2717,"_21628":59641,"_5":14884,"_28401":2717,"_3085":59642},[],"Breaking changes: every change that can break a 3.8.0 deployment, who it affects and what to do.",{"_3634":2770,"_31209":2717,"_21628":59644,"_5":14884,"_28401":2717,"_3085":59645},[],"Helm migration guide: the step-by-step procedure for a Helm-managed release.",{"_3634":2771,"_31209":2717,"_21628":59647,"_5":14884,"_28401":2717,"_3085":59648},[],"Validation checklist: how to confirm the upgrade worked before you remove the old data.",{"_3634":2772,"_31209":2717,"_21628":59650,"_5":14884,"_28401":2717,"_3085":59651},[],"The 4.0.0 release is upcoming and the backend migration steps on this page are provisional. Verify each procedure against the final release artifacts before upgrading production.",{"_3634":2773,"_31209":2717,"_21628":59653,"_5":14884,"_28401":59452,"_3085":59654},[],"3.8.0 gave each service its own database. The 4.0.0 backend connects to a single PostgreSQL database named `pki` and isolates each service in a schema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`. The `authz` service keeps its principals, grants and policies in a separate `authz` database (the development monolith uses an `authz` schema inside `pki` instead), and WFX keeps its own `wfx` database.",{"_3634":2774,"_31209":2717,"_21628":59656,"_5":14884,"_28401":59452,"_3085":59657},[],"PostgreSQL is now the only storage engine. SQLite support is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0.",{"_3634":2775,"_31209":2717,"_21628":59659,"_5":14884,"_28401":59456,"_3085":59660},[],"In 3.8.0 the API Gateway validated tokens: a JWT policy on every private route checked the signature and only let through tokens that carried the administrator role. Every route was open to any token that passed that check.",{"_3634":2776,"_31209":2717,"_21628":59662,"_5":14884,"_28401":59456,"_3085":59663},[],"4.0.0 removes the gateway policy. The `/api/*` routes reach the services directly, and each service authorizes every request through `authz`, which validates the token against the identity provider's JWKS endpoint and applies fine-grained, entity-level policies to CAs, certificates, devices, DMSs, KMS keys and CRL settings. There is no implicit superuser: the first administrator comes from a bootstrap principal that you configure. The access control page documents principals, policies and the first administrator.",{"_3634":2777,"_31209":2717,"_21628":59665,"_5":14884,"_28401":59460,"_3085":59666},[],"Historical device events move from the `devices.events` column to a dedicated `device_events` store with their own endpoints. The events endpoint can also stream events over Server-Sent Events (SSE); to fan events out across service instances, each Device Manager instance binds its own durable AMQP queue.",{"_3634":2778,"_31209":2717,"_21628":59668,"_5":14884,"_28401":59464,"_3085":59669},[],"Version 4.0.0 of the chart is a security-hardening release:",{"_3634":2779,"_31209":2717,"_21628":59671,"_5":14884,"_28401":59464,"_3085":59672},[],"**Release-scoped resource names.** Every chart-managed resource is named `<release>-lamassu-<component>` instead of the fixed names used in 3.8.0 (`kms`, `va`, `ca`, ...). With a release named `prod` the StatefulSets become `prod-lamassu-kms` and `prod-lamassu-va`. The `nameOverride` and `fullnameOverride` values change the prefix.",{"_3634":2780,"_31209":2717,"_21628":59674,"_5":14884,"_28401":59464,"_3085":59675},[],"**Non-root containers.** Every workload runs as the numeric user `65532:65532` with a `RuntimeDefault` seccomp profile and dropped capabilities. Pods do not mount the service-account token by default, and the chart creates a dedicated ServiceAccount.",{"_3634":2781,"_31209":2717,"_21628":59677,"_5":14884,"_28401":59464,"_3085":59678},[],"**Strict values validation.** `values.schema.json` rejects unknown keys, so leftover 3.8.0 blocks fail `helm lint` and `helm upgrade` instead of being silently ignored.",{"_3634":2782,"_31209":2717,"_21628":59680,"_5":14884,"_28401":59464,"_3085":59681},[],"**No injected scheduling rules.** The chart no longer adds pod anti-affinity or topology spread constraints on its own.",{"_3634":2783,"_31209":2717,"_21628":59683,"_5":14884,"_28401":59468,"_3085":59684},[],"Several migrations run without intervention when you upgrade a Helm release:",{"_3634":2784,"_31209":2717,"_21628":59686,"_5":14884,"_28401":59468,"_3085":59687},[],"Before any service starts, the chart's pre-install/pre-upgrade job prepares PostgreSQL. It creates the `pki`, `authz` and `wfx` databases when they do not exist, creates one schema per service inside `pki`, and imports each 3.8.0 per-service database into its schema. Each import runs as a single transaction, so a failed import leaves no partial schema and a retried job imports again. The job then runs the database migrations for every schema, migrates `authz`, preloads its policies and seeds the `services.authz.bootstrap` principals. It is idempotent and requires a PostgreSQL role allowed to create databases and schemas, as described in Install with Helm.",{"_3634":2785,"_31209":2717,"_21628":59689,"_5":14884,"_28401":59468,"_3085":59690},[],"Stored DMS configuration is rewritten to the 4.0.0 layout, and historical device events are transformed into the new store.",{"_3634":2786,"_31209":2717,"_21628":59692,"_5":14884,"_28401":59468,"_3085":59693},[],"The KMS migration removes the stale `lamassu.io/kms/binded-resources` key metadata, and the VA migration resolves each role's CRL signer (see VA CRL signer).",{"_3634":2787,"_31209":2717,"_21628":59695,"_5":14884,"_28401":59468,"_3085":59696},[],"When `migrations.caToKms.enabled` is set, a pre-upgrade hook registers legacy CA keys in the KMS.",{"_3634":2788,"_31209":2717,"_21628":59698,"_5":14884,"_28401":59468,"_3085":59699},[],"Two things never migrate on their own: the KMS and VA data on local volumes, which stays on volumes the upgraded pods no longer use, and the values file, which you update by hand. Deployments that do not use the Helm chart also have to move their database data themselves; see Deployments without Helm.",{"_3634":2789,"_31209":2717,"_21628":59701,"_5":14884,"_28401":59472,"_3085":59702},[],"Change",{"_3634":2790,"_31209":2717,"_21628":59704,"_5":14884,"_28401":59472,"_3085":59705},[],"Who is affected",{"_3634":2791,"_31209":2717,"_21628":59707,"_5":14884,"_28401":59472,"_3085":59708},[],"Severity",{"_3634":2792,"_31209":2717,"_21628":59710,"_5":14884,"_28401":59472,"_3085":58161},[],{"_3634":2793,"_31209":2717,"_21628":59712,"_5":14884,"_28401":59472,"_3085":59481},[],{"_3634":2794,"_31209":2717,"_21628":59714,"_5":14884,"_28401":59472,"_3085":59715},[],"Helm releases with a filesystem KMS engine or local VA CRL storage",{"_3634":2795,"_31209":2717,"_21628":59717,"_5":14884,"_28401":59472,"_3085":59718},[],"High: KMS and VA start on empty volumes",{"_3634":2796,"_31209":2717,"_21628":59720,"_5":14884,"_28401":59472,"_3085":59721},[],"Copy the data into the new volumes",{"_3634":2797,"_31209":2717,"_21628":59723,"_5":14884,"_28401":59472,"_3085":59485},[],{"_3634":2798,"_31209":2717,"_21628":59725,"_5":14884,"_28401":59472,"_3085":59726},[],"Every Helm release",{"_3634":2799,"_31209":2717,"_21628":59728,"_5":14884,"_28401":59472,"_3085":59729},[],"High: `helm upgrade` fails",{"_3634":2800,"_31209":2717,"_21628":59731,"_5":14884,"_28401":59472,"_3085":59732},[],"Remove or rename legacy keys",{"_3634":2801,"_31209":2717,"_21628":59734,"_5":14884,"_28401":59472,"_3085":51637},[],{"_3634":2802,"_31209":2717,"_21628":59736,"_5":14884,"_28401":59472,"_3085":59726},[],{"_3634":2803,"_31209":2717,"_21628":59738,"_5":14884,"_28401":59472,"_3085":59739},[],"High: `helm upgrade` fails on inline credentials",{"_3634":2804,"_31209":2717,"_21628":59741,"_5":14884,"_28401":59472,"_3085":59742},[],"Create the Secrets first; see Step 2",{"_3634":2805,"_31209":2717,"_21628":59744,"_5":14884,"_28401":59472,"_3085":59492},[],{"_3634":2806,"_31209":2717,"_21628":59746,"_5":14884,"_28401":59472,"_3085":59747},[],"Every deployment",{"_3634":2807,"_31209":2717,"_21628":59749,"_5":14884,"_28401":59472,"_3085":59750},[],"High: without a bootstrap principal there is no administrator",{"_3634":2808,"_31209":2717,"_21628":59752,"_5":14884,"_28401":59472,"_3085":59753},[],"Configure `services.authz`",{"_3634":2809,"_31209":2717,"_21628":59755,"_5":14884,"_28401":59472,"_3085":59496},[],{"_3634":2810,"_31209":2717,"_21628":59757,"_5":14884,"_28401":59472,"_3085":59726},[],{"_3634":2811,"_31209":2717,"_21628":59759,"_5":14884,"_28401":59472,"_3085":59760},[],"High: `helm upgrade` fails on the old keys",{"_3634":2812,"_31209":2717,"_21628":59762,"_5":14884,"_28401":59472,"_3085":59763},[],"Move JWKS and roles into `services.authz`",{"_3634":2813,"_31209":2717,"_21628":59765,"_5":14884,"_28401":59472,"_3085":59516},[],{"_3634":2814,"_31209":2717,"_21628":59767,"_5":14884,"_28401":59472,"_3085":59768},[],"3.8.0 deployments with per-service databases",{"_3634":2815,"_31209":2717,"_21628":59770,"_5":14884,"_28401":59472,"_3085":59771},[],"High: services find no data, or a migration aborts",{"_3634":2816,"_31209":2717,"_21628":59773,"_5":14884,"_28401":59472,"_3085":59774},[],"Clean duplicate CA IDs and empty `engine_id` values first; move data manually outside Helm",{"_3634":2817,"_31209":2717,"_21628":59776,"_5":14884,"_28401":59472,"_3085":59520},[],{"_3634":2818,"_31209":2717,"_21628":59778,"_5":14884,"_28401":59472,"_3085":59779},[],"Deployments on SQLite, `couch_db` or `dynamo_db`",{"_3634":2819,"_31209":2717,"_21628":59781,"_5":14884,"_28401":59472,"_3085":59782},[],"High: the backend no longer starts with them",{"_3634":2820,"_31209":2717,"_21628":59784,"_5":14884,"_28401":59472,"_3085":59785},[],"Move to PostgreSQL before upgrading",{"_3634":2821,"_31209":2717,"_21628":59787,"_5":14884,"_28401":59472,"_3085":59568},[],{"_3634":2822,"_31209":2717,"_21628":59789,"_5":14884,"_28401":59472,"_3085":59790},[],"Every deployment; API clients, custom policies and alert subscriptions are also affected",{"_3634":2823,"_31209":2717,"_21628":59792,"_5":14884,"_28401":59472,"_3085":59793},[],"High: the `/v1/roles` routes are removed and the migration is irreversible",{"_3634":2824,"_31209":2717,"_21628":59795,"_5":14884,"_28401":59472,"_3085":59796},[],"Fix the data the migration aborts on, and back up the database and the CRL bucket",{"_3634":2825,"_31209":2717,"_21628":59798,"_5":14884,"_28401":59472,"_3085":59799},[],"Webhooks with file references",{"_3634":2826,"_31209":2717,"_21628":59801,"_5":14884,"_28401":59472,"_3085":59802},[],"DMSs whose webhook mTLS certificate or key were file paths",{"_3634":2827,"_31209":2717,"_21628":59804,"_5":14884,"_28401":59472,"_3085":59805},[],"High: enrollments calling the webhook fail",{"_3634":2828,"_31209":2717,"_21628":59807,"_5":14884,"_28401":59472,"_3085":59808},[],"Re-enter certificate and key as PEM, or remove the file fields",{"_3634":2829,"_31209":2717,"_21628":59810,"_5":14884,"_28401":59472,"_3085":59500},[],{"_3634":2830,"_31209":2717,"_21628":59812,"_5":14884,"_28401":59472,"_3085":59813},[],"Releases with per-service identity overrides or mounted key material",{"_3634":2831,"_31209":2717,"_21628":59815,"_5":14884,"_28401":59472,"_3085":59816},[],"Medium: services cannot read their files",{"_3634":2832,"_31209":2717,"_21628":59818,"_5":14884,"_28401":59472,"_3085":59819},[],"Remove the overrides and fix volume ownership",{"_3634":2833,"_31209":2717,"_21628":59821,"_5":14884,"_28401":59472,"_3085":59504},[],{"_3634":2834,"_31209":2717,"_21628":59823,"_5":14884,"_28401":59472,"_3085":59824},[],"Releases that set `amqp.tls`",{"_3634":2835,"_31209":2717,"_21628":59826,"_5":14884,"_28401":59472,"_3085":59827},[],"Medium: clients connect to the wrong port",{"_3634":2836,"_31209":2717,"_21628":59829,"_5":14884,"_28401":59472,"_3085":59830},[],"Point `amqp.port` at the TLS listener, or disable TLS",{"_3634":2837,"_31209":2717,"_21628":59832,"_5":14884,"_28401":59472,"_3085":59524},[],{"_3634":2838,"_31209":2717,"_21628":59834,"_5":14884,"_28401":59472,"_3085":59835},[],"Installations whose CA keys predate the KMS",{"_3634":2839,"_31209":2717,"_21628":59837,"_5":14884,"_28401":59472,"_3085":59838},[],"Medium: CA keys stay unmanaged",{"_3634":2840,"_31209":2717,"_21628":59840,"_5":14884,"_28401":59472,"_3085":59841},[],"Run the CA-to-KMS migration",{"_3634":2841,"_31209":2717,"_21628":59843,"_5":14884,"_28401":59472,"_3085":59844},[],"Receiver certificate verification",{"_3634":2842,"_31209":2717,"_21628":59846,"_5":14884,"_28401":59472,"_3085":59847},[],"DMSs whose webhook had `validate_server_cert: false`",{"_3634":2843,"_31209":2717,"_21628":59849,"_5":14884,"_28401":59472,"_3085":59850},[],"Medium: credentials go to an unverified receiver",{"_3634":2844,"_31209":2717,"_21628":59852,"_5":14884,"_28401":59472,"_3085":59853},[],"Set `insecure_skip_verify` to `false`",{"_3634":2845,"_31209":2717,"_21628":59855,"_5":14884,"_28401":59472,"_3085":59540},[],{"_3634":2846,"_31209":2717,"_21628":59857,"_5":14884,"_28401":59472,"_3085":59858},[],"Scripts and consoles that edit DMSs through the API",{"_3634":2847,"_31209":2717,"_21628":59860,"_5":14884,"_28401":59472,"_3085":59861},[],"Medium: an old-layout edit silently empties `validation_cas`",{"_3634":2848,"_31209":2717,"_21628":59863,"_5":14884,"_28401":59472,"_3085":59864},[],"Read the DMS before editing and use the new field",{"_3634":2849,"_31209":2717,"_21628":59866,"_5":14884,"_28401":59472,"_3085":59544},[],{"_3634":2850,"_31209":2717,"_21628":59868,"_5":14884,"_28401":59472,"_3085":59869},[],"Every deployment with devices presenting certificates not managed by Lamassu",{"_3634":2851,"_31209":2717,"_21628":59871,"_5":14884,"_28401":59472,"_3085":59872},[],"Medium: enrollment or re-enrollment of those devices fails",{"_3634":2852,"_31209":2717,"_21628":59874,"_5":14884,"_28401":59472,"_3085":59875},[],"Set `allow_unverifiable_revocation` to `true` in the affected DMS blocks, or make sure the certificates carry reachable OCSP/CRL distribution points",{"_3634":2853,"_31209":2717,"_21628":59877,"_5":14884,"_28401":59472,"_3085":59564},[],{"_3634":2854,"_31209":2717,"_21628":59879,"_5":14884,"_28401":59472,"_3085":59880},[],"Clients that create or update CRL settings through the API",{"_3634":2855,"_31209":2717,"_21628":59882,"_5":14884,"_28401":59472,"_3085":59883},[],"Medium: requests with the old field return an error",{"_3634":2856,"_31209":2717,"_21628":59885,"_5":14884,"_28401":59472,"_3085":59886},[],"Replace `crl_options.subject_key_id_signer` with the required `crl_options.signer_serial_number`",{"_3634":2857,"_31209":2717,"_21628":59888,"_5":14884,"_28401":59472,"_3085":59572},[],{"_3634":2858,"_31209":2717,"_21628":59890,"_5":14884,"_28401":59472,"_3085":59891},[],"Alert subscriptions and consumers of the VA events",{"_3634":2859,"_31209":2717,"_21628":59893,"_5":14884,"_28401":59472,"_3085":59894},[],"Medium: subscription types are renamed automatically, their conditions are not",{"_3634":2860,"_31209":2717,"_21628":59896,"_5":14884,"_28401":59472,"_3085":59897},[],"Review conditions filtering on the old event payload or subject",{"_3634":2861,"_31209":2717,"_21628":59899,"_5":14884,"_28401":59472,"_3085":59576},[],{"_3634":2862,"_31209":2717,"_21628":59901,"_5":14884,"_28401":59472,"_3085":59902},[],"Clients that sign or verify arbitrary data through the CA API or the Go SDK, and alert subscriptions on the `ca.sign.signature` event",{"_3634":2863,"_31209":2717,"_21628":59904,"_5":14884,"_28401":59472,"_3085":59905},[],"Medium: the endpoints, the SDK methods and the event no longer exist",{"_3634":2864,"_31209":2717,"_21628":59907,"_5":14884,"_28401":59472,"_3085":59908},[],"Sign and verify with KMS keys instead; remove subscriptions on the event",{"_3634":2865,"_31209":2717,"_21628":59910,"_5":14884,"_28401":59472,"_3085":59560},[],{"_3634":2866,"_31209":2717,"_21628":59912,"_5":14884,"_28401":59472,"_3085":59913},[],"Consumers that read the device `events` field",{"_3634":2867,"_31209":2717,"_21628":59915,"_5":14884,"_28401":59472,"_3085":59916},[],"Medium: the field disappears",{"_3634":2868,"_31209":2717,"_21628":59918,"_5":14884,"_28401":59472,"_3085":59919},[],"Use the new event endpoints",{"_3634":2869,"_31209":2717,"_21628":59921,"_5":14884,"_28401":59472,"_3085":59587},[],{"_3634":2870,"_31209":2717,"_21628":59923,"_5":14884,"_28401":59472,"_3085":59924},[],"Deployments with VA roles whose signer cannot be resolved uniquely",{"_3634":2871,"_31209":2717,"_21628":59926,"_5":14884,"_28401":59472,"_3085":59927},[],"Medium: the VA migration aborts",{"_3634":2872,"_31209":2717,"_21628":59929,"_5":14884,"_28401":59472,"_3085":59930},[],"Fix the affected roles before upgrading",{"_3634":2873,"_31209":2717,"_21628":59932,"_5":14884,"_28401":59472,"_3085":59508},[],{"_3634":2874,"_31209":2717,"_21628":59934,"_5":14884,"_28401":59472,"_3085":59935},[],"Releases that override `toolbox`, `services.connectors`, ports, probes or scheduling",{"_3634":2875,"_31209":2717,"_21628":59937,"_5":14884,"_28401":59472,"_3085":59938},[],"Low to medium: validation errors or changed defaults",{"_3634":2876,"_31209":2717,"_21628":59940,"_5":14884,"_28401":59472,"_3085":59941},[],"Update the values file",{"_3634":2877,"_31209":2717,"_21628":59943,"_5":14884,"_28401":59472,"_3085":59552},[],{"_3634":2878,"_31209":2717,"_21628":59945,"_5":14884,"_28401":59472,"_3085":59946},[],"Clients that send the DMS ID in the update body",{"_3634":2879,"_31209":2717,"_21628":59948,"_5":14884,"_28401":59472,"_3085":59949},[],"Low: the ID in the URL wins",{"_3634":2880,"_31209":2717,"_21628":59951,"_5":14884,"_28401":59472,"_3085":59952},[],"Send the ID in the URL",{"_3634":2881,"_31209":2717,"_21628":59954,"_5":14884,"_28401":59472,"_3085":59580},[],{"_3634":2882,"_31209":2717,"_21628":59956,"_5":14884,"_28401":59472,"_3085":59957},[],"Clients that send an `id` when creating or importing CAs",{"_3634":2883,"_31209":2717,"_21628":59959,"_5":14884,"_28401":59472,"_3085":59960},[],"Low: the ID in the body is ignored, and the field is removed",{"_3634":2884,"_31209":2717,"_21628":59962,"_5":14884,"_28401":59472,"_3085":59963},[],"Let the backend assign the ID and use the returned one",{"_3634":2885,"_31209":2717,"_21628":59965,"_5":14884,"_28401":59472,"_3085":59576},[],{"_3634":2886,"_31209":2717,"_21628":59967,"_5":14884,"_28401":59472,"_3085":59968},[],"API and SDK clients that call `/v1/cas/{id}/signature/sign` or `/verify`, and alert subscriptions on `ca.sign.signature`",{"_3634":2887,"_31209":2717,"_21628":59970,"_5":14884,"_28401":59472,"_3085":59971},[],"Medium: the calls return `404` and the subscriptions never fire",{"_3634":2888,"_31209":2717,"_21628":59973,"_5":14884,"_28401":59472,"_3085":59974},[],"Use the KMS `sign` and `verify` operations",{"_3634":2889,"_31209":2717,"_21628":59976,"_5":14884,"_28401":59472,"_3085":59556},[],{"_3634":2890,"_31209":2717,"_21628":59978,"_5":14884,"_28401":59472,"_3085":59979},[],"Consumers that match on certificate `type`",{"_3634":2891,"_31209":2717,"_21628":59981,"_5":14884,"_28401":59472,"_3085":59982},[],"Low: two values are renamed",{"_3634":2892,"_31209":2717,"_21628":59984,"_5":14884,"_28401":59472,"_3085":59985},[],"Adapt consumers",{"_3634":2893,"_31209":2717,"_21628":59987,"_5":14884,"_28401":59472,"_3085":59548},[],{"_3634":2894,"_31209":2717,"_21628":59989,"_5":14884,"_28401":59472,"_3085":59990},[],"Any DMS",{"_3634":2895,"_31209":2717,"_21628":59992,"_5":14884,"_28401":59472,"_3085":59993},[],"Low: informational",{"_3634":2896,"_31209":2717,"_21628":59995,"_5":14884,"_28401":59472,"_3085":59996},[],"Read both blocks before editing",{"_3634":2897,"_31209":2717,"_21628":59998,"_5":14884,"_28401":59480,"_3085":59999},[],"Kubernetes derives a StatefulSet's PVC name from its pod name (`<volumeClaimTemplate>-<pod-name>`). Renaming the `kms` and `va` StatefulSets means `helm upgrade` binds brand-new, empty PVCs instead of the existing ones. The KMS key material and VA CRLs are not deleted — the old PVCs are orphaned, not removed — but the upgraded pods fail with `no such file or directory` (KMS) or `code=NotFound` (VA) until you copy the data across. This affects KMS when `services.kms.cryptoEngines` uses a `filesystem` engine and VA when `services.va.fileStore.type` is `local`. Every other renamed resource is stateless and is recreated without data-loss risk.",{"_3634":2898,"_31209":2717,"_21628":60001,"_5":14884,"_28401":59480,"_3085":60002},[],"Step 4 of the migration guide copies the data.",{"_3634":2899,"_31209":2717,"_21628":60004,"_5":14884,"_28401":59484,"_3085":60005},[],"`values.schema.json` rejects unknown keys, so every block that 4.0.0 removed or renamed — `toolbox`, `auth.oidc.apiGateway`, `auth.authorization` and others — fails `helm lint` and `helm upgrade` outright. Step 2 lists every change.",{"_3634":2900,"_31209":2717,"_21628":60007,"_5":14884,"_28401":59488,"_3085":60008},[],"In 4.0.0 the chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets in the release namespace instead of inline values: `postgres.existingSecret`, `amqp.existingSecret` and — when SMTP authentication is configured — `services.alerts.smtp_server.existingSecret`, each with `usernameKey` and `passwordKey` naming the Secret data keys. The inline `postgres.username`/`postgres.password` and `amqp.username`/`amqp.password` values are removed and rejected by `values.schema.json`, so a 3.8.0 values file fails `helm lint` and `helm upgrade` until the credentials move into Secrets.",{"_3634":2901,"_31209":2717,"_21628":60010,"_5":14884,"_28401":59488,"_3085":60011},[],"The Secrets must exist before `helm upgrade` runs: the pre-upgrade database job connects to PostgreSQL with them. Step 2 creates them through the External Secrets Operator.",{"_3634":2902,"_31209":2717,"_21628":60013,"_5":14884,"_28401":59491,"_3085":60014},[],"3.8.0 had no authorization service, so a 3.8.0 values file has nothing to migrate from: you must add the `services.authz` configuration yourself. It needs the JWKS endpoint of your identity provider, the database mappings the authorization engine uses, and a bootstrap principal that matches how your provider assigns the administrator role. Without a matching principal nobody can administer the PKI.",{"_3634":2903,"_31209":2717,"_21628":60016,"_5":14884,"_28401":59495,"_3085":60017},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` and `auth.authorization.roles.admin` are removed with no compatibility aliases, and the schema rejects them. Their settings move into `services.authz`: the JWKS URL becomes `services.authz.jwkUrl`, and the role claim and administrator role become a claim rule of the bootstrap principal. `auth.oidc.frontend` is unchanged.",{"_3634":2904,"_31209":2717,"_21628":60019,"_5":14884,"_28401":59499,"_3085":60020},[],"Service images run on a distroless base as the numeric user `65532`; the `authz` image is Ubuntu with a non-root user that has the same UID. The per-service overrides `services.kms.securityContext.runAsGroup: 0` and `services.authz.securityContext.runAsUser`/`runAsGroup: 999` are removed; group access to the KMS volume and PKCS#11 socket is now handled by the pod-level `fsGroup: 65532`.",{"_3634":2905,"_31209":2717,"_21628":60022,"_5":14884,"_28401":59499,"_3085":60023},[],"3.8.0 did not pin a container identity, so existing files can carry any UID. Any volume that holds keys or CRLs must be owned by `65532:65532`, or at least readable (and, where needed, writable) by that identity.",{"_3634":2906,"_31209":2717,"_21628":60025,"_5":14884,"_28401":59499,"_3085":60026},[],"Pods now carry a pod-level `fsGroup: 65532` with `fsGroupChangePolicy: OnRootMismatch`, which skips recursive ownership changes when the volume root already has the expected group. If your backup helpers or jobs run with a different GID, verify they can still access the volumes they need.",{"_3634":2907,"_31209":2717,"_21628":60028,"_5":14884,"_28401":59503,"_3085":60029},[],"In 3.8.0 `amqp.tls` was not applied and event-bus clients always connected over plaintext. In 4.0.0 `amqp.tls: true` switches them to AMQPS. The default `amqp.port` stays `5672` and does not change when TLS is enabled, so a values file that already set `amqp.tls: true` must point `amqp.port` at the broker's TLS listener (`amqps`, commonly `5671`), or set `amqp.tls: false` to keep plaintext. Clients must also trust the broker's certificate.",{"_3634":2908,"_31209":2717,"_21628":60031,"_5":14884,"_28401":59507,"_3085":60032},[],"`toolbox` is renamed to `connectivityTest`, and the `helm test` hook uses the upstream `curlimages/curl` image pinned by digest.",{"_3634":2909,"_31209":2717,"_21628":60034,"_5":14884,"_28401":59507,"_3085":60035},[],"`services.connectors` is a map keyed by connector ID instead of a list.",{"_3634":2910,"_31209":2717,"_21628":60037,"_5":14884,"_28401":59507,"_3085":60038},[],"The `services.ui.port` default is `8085`, the unprivileged port of the rootless image.",{"_3634":2911,"_31209":2717,"_21628":60040,"_5":14884,"_28401":59507,"_3085":60041},[],"The shared `probes:` block is replaced by independent `livenessProbe`, `readinessProbe` and `startupProbe` blocks.",{"_3634":2912,"_31209":2717,"_21628":60043,"_5":14884,"_28401":59507,"_3085":60044},[],"With `tls.certManagerOptions.issuer` empty, the chart creates a release-scoped self-signed issuer, for example `lamassu-downstream-ca-selfsigned-issuer`. The legacy literal `downstream-ca-selfsigned-issuer` is still accepted and resolves to it.",{"_3634":2913,"_31209":2717,"_21628":60046,"_5":14884,"_28401":59507,"_3085":60047},[],"Anti-affinity and topology spread must be configured explicitly through `affinity` and `topologySpreadConstraints`.",{"_3634":2914,"_31209":2717,"_21628":60049,"_5":14884,"_28401":59515,"_3085":60050},[],"Every 3.8.0 per-service database must end up as a schema of `pki`, keeping its structure, indexes, constraints, data and migration history. The Helm chart does this automatically; deployments without Helm do it by hand (see Deployments without Helm).",{"_3634":2915,"_31209":2717,"_21628":60052,"_5":14884,"_28401":59515,"_3085":60053},[],"Two schema migrations abort on data that 3.8.0 allowed, so clean the data before upgrading:",{"_3634":2916,"_31209":2717,"_21628":60055,"_5":14884,"_28401":59515,"_3085":60056},[],"The CA migration adds a UNIQUE constraint on `ca_certificates.id` and aborts if duplicate CA IDs exist. Imports already reject duplicates with `409`, so new ones cannot normally appear.",{"_3634":2917,"_31209":2717,"_21628":60058,"_5":14884,"_28401":59515,"_3085":60059},[],"The KMS migration promotes the primary key to `(key_id, engine_id)` and aborts with `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` when `kms_keys` rows lack `engine_id`. Backfill `engine_id` first.",{"_3634":2918,"_31209":2717,"_21628":60061,"_5":14884,"_28401":59515,"_3085":60062},[],"The same KMS migration deletes, with a `NOTICE`, aliases that equal an existing key ID, because identifiers now resolve as a key ID before an alias. Affected aliases are dropped, not redirected.",{"_3634":2919,"_31209":2717,"_21628":60064,"_5":14884,"_28401":59519,"_3085":60065},[],"The SQLite storage engine is removed, and the `couch_db` and `dynamo_db` engines are not registered in 4.0.0: their configuration constants remain, but they select no engine. Deployments on any of them must move to PostgreSQL and consolidate their data into the `pki` schemas before upgrading.",{"_3634":2920,"_31209":2717,"_21628":60067,"_5":14884,"_28401":59523,"_3085":60068},[],"CA certificates of type `MANAGED` or `IMPORTED_WITH_KEY` whose private keys predate the KMS service have the key stored only in the crypto engine, under the certificate's `subject_key_id`, with no KMS record. The `ca-to-kms-migration` tool registers them:",{"_3634":2921,"_31209":2717,"_21628":60070,"_5":14884,"_28401":59523,"_3085":60071},[],"The `key_id` is the certificate's `subject_key_id`; it matches the SHA-256 digest of the public key only when the SKI was computed that way.",{"_3634":2922,"_31209":2717,"_21628":60073,"_5":14884,"_28401":59523,"_3085":60074},[],"The tool is idempotent: keys already in the KMS are skipped, so it can be run several times.",{"_3634":2923,"_31209":2717,"_21628":60076,"_5":14884,"_28401":59523,"_3085":60077},[],"Certificates that cannot be read, or lack an engine or a subject key ID, are skipped with a warning. Review the logs and resolve the affected records.",{"_3634":2924,"_31209":2717,"_21628":60079,"_5":14884,"_28401":59523,"_3085":60080},[],"When CA certificates sharing a `subject_key_id` declare conflicting `engine_id`s, the tool fails that key and exits with code `1`, which fails a Helm pre-upgrade hook. Resolve the conflict manually before rerunning.",{"_3634":2925,"_31209":2717,"_21628":60082,"_5":14884,"_28401":59523,"_3085":60083},[],"Once the keys are registered, certificates reference them in the database and the KMS refuses to delete a key that a certificate still uses (`409` `key is in use`). Deleting a certificate record removes it from the CRL and OCSP, so read Before deleting a key before freeing a key.",{"_3634":2926,"_31209":2717,"_21628":60085,"_5":14884,"_28401":59523,"_3085":60086},[],"Optionally, installations with imported CAs from before 3.7 can start the KMS once with `crypto_engines.migrate_keys_format: true`: the KMS renames those SKI-named legacy keys to the SHA-256 digest of their public key (the old name is kept as an alias, and the certificate references follow automatically). Run it once and disable the option again; running it again is safe.",{"_3634":2927,"_31209":2717,"_21628":60088,"_5":14884,"_28401":59523,"_3085":60089},[],"With Helm, enable the hook for the upgrade in step 2; without Helm, run the tool by hand.",{"_3634":2928,"_31209":2717,"_21628":60091,"_5":14884,"_28401":59527,"_3085":60092},[],"Certificates now reference their KMS key, and CRL settings reference their signer certificate, so a key or certificate in use cannot be deleted. The KMS migration drops the legacy `lamassu.io/kms/binded-resources` key metadata. Before 4.0.0, deleting a CA could remove its key while leaving key references in its retained certificate records. The CA migration registers those missing keys in the KMS with only their public key to satisfy the retained references. These entries cannot be deleted while the retained certificates reference them; they do not restore the private key. In 4.0.0, deleting a CA releases the references from its own current certificate and linked reissued certificates before attempting to delete the key; other certificates that still reference it prevent deletion.",{"_3634":2929,"_31209":2717,"_21628":60094,"_5":14884,"_28401":59535,"_3085":60095},[],"Stored webhook configs are rewritten to the current layout and their fields renamed:",{"_3634":2930,"_31209":2717,"_21628":60097,"_5":14884,"_28401":59535,"_3085":60098},[],"Field in 3.8.0",{"_3634":2931,"_31209":2717,"_21628":60100,"_5":14884,"_28401":59535,"_3085":60101},[],"Field in 4.0.0",{"_3634":2932,"_31209":2717,"_21628":60103,"_5":14884,"_28401":59535,"_3085":60104},[],"`validate_server_cert`",{"_3634":2933,"_31209":2717,"_21628":60106,"_5":14884,"_28401":59535,"_3085":60107},[],"`insecure_skip_verify` (value negated)",{"_3634":2934,"_31209":2717,"_21628":60109,"_5":14884,"_28401":59535,"_3085":60110},[],"`oidc`",{"_3634":2935,"_31209":2717,"_21628":60112,"_5":14884,"_28401":59535,"_3085":60113},[],"`jwt_options`",{"_3634":2936,"_31209":2717,"_21628":60115,"_5":14884,"_28401":59535,"_3085":60116},[],"`apikey`",{"_3634":2937,"_31209":2717,"_21628":60118,"_5":14884,"_28401":59535,"_3085":60119},[],"`apikey_options`",{"_3634":2938,"_31209":2717,"_21628":60121,"_5":14884,"_28401":59535,"_3085":60122},[],"`mtls`",{"_3634":2939,"_31209":2717,"_21628":60124,"_5":14884,"_28401":59535,"_3085":60125},[],"`mtls_options`",{"_3634":2940,"_31209":2717,"_21628":60127,"_5":14884,"_28401":59535,"_3085":60128},[],"When the legacy mTLS certificate and key are both PEM, they move into `mtls_options.cert_content` and `mtls_options.key_content` and need no action. Two cases do need it.",{"_3634":2941,"_31209":2717,"_21628":60130,"_5":14884,"_28401":59535,"_3085":60131},[],"**Webhooks with file references.** A mixed config, with a PEM certificate and a file-path key, is migrated to `mtls_options.cert_file` and `mtls_options.key_file`. Webhook delivery rejects those fields on every call, whatever the configured authentication mode, so every enroll and re-enroll that calls that webhook fails until the config is fixed. If the webhook uses mTLS, re-enter the certificate and key as Base64-encoded or plain PEM; if it does not, remove the leftover file fields. Metadata-only updates keep working in the meantime (`PUT` or `PATCH` on `/v1/dms/:id/metadata`). In a variant of the same problem, a stored config with file paths inside `mtls_options.cert_content` or `mtls_options.key_content` makes every full settings update (`POST /v1/dms` or `PUT /v1/dms/:id`) fail validation; settings are replaced wholesale, so resend the config with the certificate and key as PEM.",{"_3634":2942,"_31209":2717,"_21628":60133,"_5":14884,"_28401":59535,"_3085":60134},[],"**Receiver certificate verification.** A config with `validate_server_cert: false` becomes `insecure_skip_verify: true`, so receiver verification stays skipped until that field is set to `false`. Correct it on every migrated config: the webhook authorization channel carries the API key or bearer token, and skipping verification exposes those credentials to a network-positioned attacker. Keep `insecure_skip_verify: true` only when the receiver certificate is deliberately unverifiable.",{"_3634":2943,"_31209":2717,"_21628":60136,"_5":14884,"_28401":59539,"_3085":60137},[],"The flat field `reenrollment_settings.additional_validation_cas` moves into the nested field `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3634":2944,"_31209":2717,"_21628":60139,"_5":14884,"_28401":59539,"_3085":60140},[],"The effective trust set does not change, because the nested value was never consulted when validating re-enrollments. If the flat list was missing or null, it becomes an empty list.",{"_3634":2945,"_31209":2717,"_21628":60142,"_5":14884,"_28401":59539,"_3085":60143},[],"What changes is how API requests are handled. Bodies that still carry `additional_validation_cas` are accepted, but the value is silently dropped because unknown JSON fields are ignored, and GET responses no longer include it. An update body built from the old layout therefore empties `validation_cas` without any error. Always read the DMS before sending an edit and reuse the layout the API returns.",{"_3634":2946,"_31209":2717,"_21628":60145,"_5":14884,"_28401":59543,"_3085":60146},[],"Enrollment and re-enrollment now verify the revocation of the presented certificates and fail closed when it cannot be verified. There is no migration: every pre-existing DMS has the new `allow_unverifiable_revocation` option at its default `false`, so a certificate that is not managed by Lamassu and carries no OCSP or CRL distribution points is rejected until the option is set to `true` in the affected block, independently for the enrollment and the re-enrollment block.",{"_3634":2947,"_31209":2717,"_21628":60148,"_5":14884,"_28401":59543,"_3085":60149},[],"Certificates that do carry endpoints are still strictly checked: unreachable endpoints, stale or inconclusive answers reject the certificate even when `allow_unverifiable_revocation` is enabled, and certificates managed by Lamassu are unaffected because their stored status is used. A validation CA revoked in Lamassu also rejects the operation, without falling back to the remaining validation CAs. See the DMS guide and Revocation and checks.",{"_3634":2948,"_31209":2717,"_21628":60151,"_5":14884,"_28401":59547,"_3085":60152},[],"Re-enrollment authentication settings are now stored independently from initial authentication. Nothing needs migrating, but read both blocks before editing a DMS so that you do not modify one while believing you are editing the other. The console exposes independent editors for both blocks; the DMS guide describes their fields, and you can also edit them through the DMS API.",{"_3634":2949,"_31209":2717,"_21628":60154,"_5":14884,"_28401":59551,"_3085":60155},[],"`PUT /v1/dms/:id` takes the DMS ID from the URL and validates the request body. An ID in the body is ignored, so update clients that relied on it.",{"_3634":2950,"_31209":2717,"_21628":60157,"_5":14884,"_28401":59555,"_3085":60158},[],"Stored certificate type values are renamed: `IMPORTED` becomes `IMPORTED_WITH_KEY` and `EXTERNAL` becomes `IMPORTED_WITHOUT_KEY`. `MANAGED` is unchanged. Adapt consumers that read or match on those values.",{"_3634":2951,"_31209":2717,"_21628":60160,"_5":14884,"_28401":59559,"_3085":60161},[],"The `events` field no longer appears in the device representation. Point consumers at the new endpoints:",{"_3634":2952,"_31209":2717,"_21628":60163,"_5":14884,"_28401":59559,"_3085":60164},[],"`GET /v1/devices/:id/events` returns a device's events.",{"_3634":2953,"_31209":2717,"_21628":60166,"_5":14884,"_28401":59559,"_3085":60167},[],"`POST /v1/devices/:id/events` creates an event.",{"_3634":2954,"_31209":2717,"_21628":60169,"_5":14884,"_28401":59559,"_3085":60170},[],"When the request `Accept` header includes `text/event-stream`, the events endpoint streams over SSE with a keepalive every 15 seconds, and returns `501` when SSE is disabled in the deployment. Each Device Manager instance binds a durable AMQP queue named after its service ID, `device-manager-sse-<uuid>`. Queues from crashed or replaced instances linger until removed, so configure an expiration or cleanup policy on the broker.",{"_3634":2955,"_31209":2717,"_21628":60172,"_5":14884,"_28401":59563,"_3085":60173},[],"`crl_options.subject_key_id_signer` is replaced by the required `crl_options.signer_serial_number`, the serial number of the existing certificate that signs the CRL. A new CA's initial value is the serial number of its current certificate. Requests that still carry `subject_key_id_signer` return an error. The authorization entity that holds these settings is also renamed; see CRL settings keyed by CA ID.",{"_3634":2956,"_31209":2717,"_21628":60175,"_5":14884,"_28401":59567,"_3085":60176},[],"In 3.8.0 the VA keyed each CRL by the CA's SKI, and `GET`/`PUT /v1/roles/{ca-ski}` read and updated it. In 4.0.0 the CRL settings of a CA are keyed by its CA ID, and every CA has its own, even when two CAs share a key:",{"_3634":2957,"_31209":2717,"_21628":60178,"_5":14884,"_28401":59567,"_3085":60179},[],"Route",{"_3634":2958,"_31209":2717,"_21628":60181,"_5":14884,"_28401":59567,"_3085":54454},[],{"_3634":2959,"_31209":2717,"_21628":60183,"_5":14884,"_28401":59567,"_3085":60184},[],"`GET /v1/crl-settings`",{"_3634":2960,"_31209":2717,"_21628":60186,"_5":14884,"_28401":59567,"_3085":60187},[],"Lists the CRL settings; filterable at least by `ca_id`, `status` and `legacy_ski`.",{"_3634":2961,"_31209":2717,"_21628":60189,"_5":14884,"_28401":59567,"_3085":60190},[],"`GET /v1/crl-settings/{ca-id}`",{"_3634":2962,"_31209":2717,"_21628":60192,"_5":14884,"_28401":59567,"_3085":60193},[],"Reads the settings of a CA.",{"_3634":2963,"_31209":2717,"_21628":60195,"_5":14884,"_28401":59567,"_3085":60196},[],"`PUT /v1/crl-settings/{ca-id}`",{"_3634":2964,"_31209":2717,"_21628":60198,"_5":14884,"_28401":59567,"_3085":60199},[],"Replaces `crl_options`.",{"_3634":2965,"_31209":2717,"_21628":60201,"_5":14884,"_28401":59567,"_3085":60202},[],"`DELETE /v1/crl-settings/{ca-id}`",{"_3634":2966,"_31209":2717,"_21628":60204,"_5":14884,"_28401":59567,"_3085":60205},[],"Removes the archived settings of a CA.",{"_3634":2967,"_31209":2717,"_21628":60207,"_5":14884,"_28401":59567,"_3085":60208},[],"The options keep their meaning and their defaults: 7 days of `validity`, 6 days and 23 hours of `refresh_interval`, and `regenerate_on_revoke` `true`. `status` (`ACTIVE`, `FINAL` or `ARCHIVED`), `legacy_ski` and `latest_crl` are read-only. A `PUT` validates the signer only when it changes, does not regenerate the CRL, and returns `409` when the settings are not `ACTIVE`.",{"_3634":2968,"_31209":2717,"_21628":60210,"_5":14884,"_28401":59567,"_3085":60211},[],"The public endpoint `GET /crl/{id}` takes the CA ID — the form the CDPs of newly issued certificates use — and keeps resolving the SKI form of certificates issued before the upgrade. Certificates issued before the upgrade keep their `/crl/<ski>` distribution points; newly issued ones carry `/crl/<ca-id>`, and both resolve to the same settings. The VA scheduled CRL job requests a new list on its first run, and the new list includes both URLs in its *Issuing Distribution Point*. Until it succeeds, the old list has only the legacy `/crl/<ski>` IDP: verifiers that compare it with the CDP of newly issued certificates cannot validate those certificates. The default schedule can delay the first run by up to about an hour; failures can extend the window.",{"_3634":2969,"_31209":2717,"_21628":60213,"_5":14884,"_28401":59567,"_3085":60214},[],"The migration that turns VA roles into CRL settings cannot be rolled back: its rollback does nothing. CRLs generated after the upgrade are stored under the CA ID, where 3.8.0 does not look for them, and the archived settings of CAs deleted before the upgrade have no signer to go back to. Returning to 3.8.0 requires restoring both the database and the CRL bucket — the object storage that holds the published lists — from the backups taken before the upgrade.",{"_3634":2970,"_31209":2717,"_21628":60216,"_5":14884,"_28401":59567,"_3085":60217},[],"The migration aborts, and the upgrade fails, on five kinds of data:",{"_3634":2971,"_31209":2717,"_21628":60219,"_5":14884,"_28401":59567,"_3085":60220},[],"CA IDs containing `/`: they cannot be used in CRL URLs. Recreate those CAs with a different ID.",{"_3634":2972,"_31209":2717,"_21628":60222,"_5":14884,"_28401":59567,"_3085":60223},[],"An SKI shared by more than one CA: the error names the SKIs and asks you to recreate all but one of them on a different key.",{"_3634":2973,"_31209":2717,"_21628":60225,"_5":14884,"_28401":59567,"_3085":60226},[],"A VA role whose signer certificate has no key: point the role to a signer with a key, or fix the key reference of the certificate, before upgrading.",{"_3634":2974,"_31209":2717,"_21628":60228,"_5":14884,"_28401":59567,"_3085":60229},[],"A CA whose ID equals the `legacy-<ski>` ID the migration reserves for the archived settings of another role whose CA was deleted: recreate that CA with a different ID.",{"_3634":2975,"_31209":2717,"_21628":60231,"_5":14884,"_28401":59567,"_3085":60232},[],"A CA ID equal to the SKI of another VA role: their CRL URLs would be ambiguous.",{"_3634":2976,"_31209":2717,"_21628":60234,"_5":14884,"_28401":59567,"_3085":60235},[],"The settings of a CA deleted before the upgrade are migrated as `ARCHIVED`, with a `legacy-<ski>` ID and no signer: their last CRL is still served, but never regenerated, and `PUT` returns `409`. There is no API way back to `ACTIVE`. The CRL guide describes the full behavior.",{"_3634":2977,"_31209":2717,"_21628":60237,"_5":14884,"_28401":59567,"_3085":60238},[],"**Custom authorization policies.** The entity `va_role` is renamed to `crl_settings`, with `ca_id` as its primary key and `signer_serial_number` as its relation to certificates. Update policies referencing the old entity. The entity gains the `delete` atomic action, a `signer_key_id` relation to KMS keys, and the filterable columns `signer_engine_id` and `signer_key_id`; grant the new action to whoever may delete archived CRL settings. Replace the 3.8.0 signer filter `crl_subject_key_id_signer` (or `crl_signer_certificate_serial_number` if used by an intermediate version) with `signer_serial_number`. Replace SKI filter values with the corresponding certificate serial numbers; renaming the filter alone is insufficient.",{"_3634":2978,"_31209":2717,"_21628":60240,"_5":14884,"_28401":59571,"_3085":60241},[],"`va.role.update` becomes `va.crl-settings.update` and `va.role.crl.init` becomes `va.crl-settings.init`; `va.role.crl.create` keeps its name and its payload. Every subject changes from `crl/<ski>` to `crl/<ca-id>`, and the payload of the renamed events changes from the old VA role to the CRL settings of the CA, with `ca_id` instead of `ca_ski`. The alerts migration renames the event types of existing subscriptions automatically, but it does not rewrite their conditions — JSON Path, JSON Schema or JavaScript: review conditions that filter on the old payload or on the old `crl/<ski>` subject, including those for `va.role.crl.create`. Direct event-bus consumers and audit searches must adopt the new names and payload themselves.",{"_3634":2979,"_31209":2717,"_21628":60243,"_5":14884,"_28401":59575,"_3085":60244},[],"`POST /v1/cas/{id}/signature/sign` and `POST /v1/cas/{id}/signature/verify` no longer exist: the CA service no longer signs or verifies arbitrary data, so a CA's private key only signs certificates. The Go SDK's `CAService.SignatureSign` and `CAService.SignatureVerify` methods are removed too, and the `ca.sign.signature` event is no longer published, so alert subscriptions and event-bus consumers that rely on it never fire again — remove those subscriptions and point consumers elsewhere. Sign and verify arbitrary data with a KMS key instead, through `POST /api/kms/v1/keys/{id}/sign` and `POST /api/kms/v1/keys/{id}/verify` (the Go SDK's `KMSService.SignMessage` and `KMSService.VerifySignature`); the console equivalent is described in Sign and verify. A CA is also only accepted for signing when its validity window includes the current time, even if its stored status still reads `ACTIVE`.",{"_3634":2980,"_31209":2717,"_21628":60246,"_5":14884,"_28401":59579,"_3085":60247},[],"Creating or importing a CA registers it under a backend-generated UUID. Any `id` sent in the request body is ignored, and the field is removed from the create and import bodies. Scripts that supplied their own IDs and addressed CAs by them must read the ID the backend returns instead.",{"_3634":2981,"_31209":2717,"_21628":60249,"_5":14884,"_28401":59583,"_3085":60250},[],"A CA key now signs only certificates. 3.8.0 let a client sign arbitrary data with a CA key through `POST /v1/cas/{id}/signature/sign` and check the result with `POST /v1/cas/{id}/signature/verify`. 4.0.0 removes both endpoints, the matching `SignatureSign` and `SignatureVerify` methods of the Go SDK `CAService`, and the `ca.sign.signature` event. An alert subscription on that event no longer fires: delete it or move it to another event.",{"_3634":2982,"_31209":2717,"_21628":60252,"_5":14884,"_28401":59583,"_3085":60253},[],"To sign and verify data, use the KMS operations `POST /v1/keys/{id}/sign` and `POST /v1/keys/{id}/verify`, which have their own authorization. Signing a certificate with a CA that is not `ACTIVE` or whose validity period does not include the current time now fails with `400`, even if the stored status has not yet changed to `EXPIRED`: see Certificate authorities.",{"_3634":2983,"_31209":2717,"_21628":60255,"_5":14884,"_28401":59586,"_3085":60256},[],"The VA migration resolves each role's signer from its stored SKI. It first looks for CA certificates with that SKI; if several match, it selects the oldest CA and logs a warning. If no CA certificate matches, it looks among all certificates with that SKI. The migration aborts with `cannot resolve signer certificate for VA role <ca-ski>, SKI <ski>` if that fallback finds zero or multiple candidates. Fix affected roles before upgrading.",{"_3634":2984,"_31209":2717,"_21628":60258,"_5":14884,"_28401":59590,"_3085":60259},[],"The upgrade runs in a fixed order: prepare the data and values, run `helm upgrade`, then copy the KMS and VA data into the new volumes. The copy must run after the upgrade, because the destination StatefulSets and PVCs do not exist before it. If you are not upgrading an existing release, go straight to Install with Helm.",{"_3634":2985,"_31209":2717,"_21628":60261,"_5":14884,"_28401":59594,"_3085":60262},[],"Take a verifiable backup of PostgreSQL and of the CRL object storage — the VA bucket, or the local volume that holds the CRLs — and schedule downtime. The upgrade moves every service's data into `pki`, and the VA migration is irreversible: returning to 3.8.0 needs both backups (see CRL settings keyed by CA ID).",{"_3634":2986,"_31209":2717,"_21628":60264,"_5":14884,"_28401":59594,"_3085":60265},[],"If the deployment runs on SQLite, `couch_db` or `dynamo_db`, move it to PostgreSQL first.",{"_3634":2987,"_31209":2717,"_21628":60267,"_5":14884,"_28401":59594,"_3085":60268},[],"Resolve duplicate CA IDs and backfill `engine_id` in `kms_keys`, as described in PostgreSQL consolidation.",{"_3634":2988,"_31209":2717,"_21628":60270,"_5":14884,"_28401":59594,"_3085":60271},[],"Optionally, run the pre-upgrade check against the consolidated 3.8.0 data before applying the migrations.",{"_3634":2989,"_31209":2717,"_21628":60273,"_5":14884,"_28401":59594,"_3085":60274},[],"Record the names of your local-storage PVCs:",{"_3634":2990,"_31209":2717,"_21628":60276,"_5":14884,"_28401":59594,"_3085":60277},[],"`helm upgrade` does not touch or delete the old PVCs, but nothing references them after the upgrade. You need their names to copy the data and to clean up later.",{"_3634":2991,"_31209":2717,"_21628":60279,"_5":14884,"_28401":59598,"_3085":60280},[],"The 4.0.0 database migrations refuse data they cannot migrate safely: they abort and name the offending objects. The `upgrade-check` tool reports all of those problems before the upgrade, in one run, with the same wording the migration would use. It is read-only: it never writes database rows or keys.",{"_3634":2992,"_31209":2717,"_21628":60282,"_5":14884,"_28401":59598,"_3085":60283},[],"Image: `ghcr.io/lamassuiot/lamassu-upgrade-check`. Configure it with a KMS-style YAML file passed through `LAMASSU_CONFIG_FILE`; only the `postgres` storage provider is supported.",{"_3634":2993,"_31209":2717,"_21628":60285,"_5":14884,"_28401":59598,"_3085":60286},[],"Run it on the 3.8.0 data after it has been consolidated into the `pki` schemas, and before any 4.0.0 migration runs or any 4.0.0 service starts.",{"_3634":2994,"_31209":2717,"_21628":60288,"_5":14884,"_28401":59598,"_3085":60289},[],"Exit codes: `0` means no problems were found, `1` means at least one problem was found, and `2` means the command could not run (bad configuration, unreachable database, or a database that is not a 3.8.0 one), or a check could not run.",{"_3634":2995,"_31209":2717,"_21628":60291,"_5":14884,"_28401":59598,"_3085":60292},[],"It covers the VA migrations only: an all-clear does not prove that the CA and KMS migration guards pass, so it does not replace the duplicate CA ID and `engine_id` checks described in PostgreSQL consolidation.",{"_3634":2996,"_31209":2717,"_21628":60294,"_5":14884,"_28401":59602,"_3085":60295},[],"**Create the credential Secrets.** The 4.0.0 chart reads PostgreSQL, AMQP and SMTP credentials from Kubernetes Secrets, and the pre-upgrade database job needs them before the upgrade runs. Copy the 3.8.0 credentials into your secret-management provider and create the Secrets with the External Secrets Operator (ESO), which the chart does not install:",{"_3634":2997,"_31209":2717,"_21628":60297,"_5":14884,"_28401":59602,"_3085":60298},[],"Configure ESO and its provider (`SecretStore` or `ClusterSecretStore`).",{"_3634":2998,"_31209":2717,"_21628":60300,"_5":14884,"_28401":59602,"_3085":60301},[],"Create an `ExternalSecret` for each credential set you use. Its target Secret must live in the release namespace, be named after the corresponding `existingSecret` value, and contain these keys:",{"_3634":2999,"_31209":2717,"_21628":60303,"_5":14884,"_28401":59602,"_3085":60304},[],"Secret (`existingSecret`)",{"_3634":3000,"_31209":2717,"_21628":60306,"_5":14884,"_28401":59602,"_3085":60307},[],"Required data keys",{"_3634":3001,"_31209":2717,"_21628":60309,"_5":14884,"_28401":59602,"_3085":60310},[],"When",{"_3634":3002,"_31209":2717,"_21628":60312,"_5":14884,"_28401":59602,"_3085":60313},[],"`lamassu-postgres` (default of `postgres.existingSecret`)",{"_3634":3003,"_31209":2717,"_21628":60315,"_5":14884,"_28401":59602,"_3085":60316},[],"`username`, `password`",{"_3634":3004,"_31209":2717,"_21628":60318,"_5":14884,"_28401":59602,"_3085":60319},[],"Always",{"_3634":3005,"_31209":2717,"_21628":60321,"_5":14884,"_28401":59602,"_3085":60322},[],"`lamassu-amqp` (default of `amqp.existingSecret`)",{"_3634":3006,"_31209":2717,"_21628":60324,"_5":14884,"_28401":59602,"_3085":60316},[],{"_3634":3007,"_31209":2717,"_21628":60326,"_5":14884,"_28401":59602,"_3085":60319},[],{"_3634":3008,"_31209":2717,"_21628":60328,"_5":14884,"_28401":59602,"_3085":60329},[],"`services.alerts.smtp_server.existingSecret`",{"_3634":3009,"_31209":2717,"_21628":60331,"_5":14884,"_28401":59602,"_3085":60316},[],{"_3634":3010,"_31209":2717,"_21628":60333,"_5":14884,"_28401":59602,"_3085":60334},[],"Only when SMTP authentication is enabled",{"_3634":3011,"_31209":2717,"_21628":60336,"_5":14884,"_28401":59602,"_3085":60337},[],"Wait for every `ExternalSecret` to be Ready and verify the generated Secrets before running the upgrade.",{"_3634":3012,"_31209":2717,"_21628":60339,"_5":14884,"_28401":59602,"_3085":60340},[],"Do not change the database or broker passwords as part of this migration: ESO synchronizes credentials into Secrets, but it does not update the users configured on the PostgreSQL server or the broker. Removing credentials from the values file does not undo past exposure — if they were ever committed to Git, rotate them after the migration is complete.",{"_3634":3013,"_31209":2717,"_21628":60342,"_5":14884,"_28401":59602,"_3085":60343},[],"The `charts/lamassu/README.md` in the Helm repository documents a full worked example in its *Secret management* section: installing external-secrets 0.20.2, a test Fake `ClusterSecretStore`, the `ExternalSecret` resources and the wait for synchronization. Its Fake provider is for testing only; for production, replace it with your provider's configuration.",{"_3634":3014,"_31209":2717,"_21628":60345,"_5":14884,"_28401":59602,"_3085":60346},[],"**Add `services.authz`.** Configure the JWKS endpoint, the database mappings and the bootstrap principal:",{"_3634":3015,"_31209":2717,"_21628":60348,"_5":14884,"_28401":59602,"_3085":60349},[],"`jwkUrl` is fetched from the `authz` pod, not from the gateway, so a Service in the release namespace can be referenced by its short name. The default points at a Keycloak Service named `auth-keycloak`; set it explicitly if your identity provider lives anywhere else.",{"_3634":3016,"_31209":2717,"_21628":60351,"_5":14884,"_28401":59602,"_3085":60352},[],"`authz` is the authorization service's own storage for principals, grants and policies. `pki` is the database the authorization engine queries when it evaluates policies against entities. Only the `database` field of each entry is required; per-schema `hostname` and `port` values remain accepted but are ignored — the connection always uses the global `postgres.hostname` and `postgres.port` with the global PostgreSQL credential Secret, `postgres.existingSecret` with its configured key names, unless the entry sets its own `existingSecret` (with optional `usernameKey` and `passwordKey`).",{"_3634":3017,"_31209":2717,"_21628":60354,"_5":14884,"_28401":59602,"_3085":60355},[],"If you kept the 3.8.0 role defaults (`realm_access.roles` and `pki-admin`), the default `services.authz.bootstrap` already matches them.",{"_3634":3018,"_31209":2717,"_21628":60357,"_5":14884,"_28401":59602,"_3085":60358},[],"**Delete the gateway token validation blocks.** Remove `auth.oidc.apiGateway` and `auth.authorization` once their settings are in `services.authz`:",{"_3634":3019,"_31209":2717,"_21628":60360,"_5":14884,"_28401":59602,"_3085":60361},[],"**Rename `toolbox` to `connectivityTest`:**",{"_3634":3020,"_31209":2717,"_21628":60363,"_5":14884,"_28401":59602,"_3085":60364},[],"**Remove the per-service identity overrides** `services.kms.securityContext.runAsGroup` and `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3634":3021,"_31209":2717,"_21628":60366,"_5":14884,"_28401":59602,"_3085":60367},[],"**Convert `services.connectors` to a map** keyed by connector ID, each entry with its `type` and `image`:",{"_3634":3022,"_31209":2717,"_21628":60369,"_5":14884,"_28401":59602,"_3085":60370},[],"**Check AMQP.** If you set `amqp.tls: true`, also set `amqp.port` to the broker's TLS listener (commonly `5671`), or set `amqp.tls: false` to stay on plaintext.",{"_3634":3023,"_31209":2717,"_21628":60372,"_5":14884,"_28401":59602,"_3085":60373},[],"**Enable the CA-to-KMS migration** if your CA keys predate the KMS:",{"_3634":3024,"_31209":2717,"_21628":60375,"_5":14884,"_28401":59602,"_3085":60376},[],"**Review the remaining values:** overrides that pinned `services.ui.port` to `80`, the old `probes:` block, the TLS issuer, and explicit `affinity` and `topologySpreadConstraints` where your cluster needs them. Renamed and reshaped values describes each one.",{"_3634":3025,"_31209":2717,"_21628":60378,"_5":14884,"_28401":59602,"_3085":60379},[],"Run `helm lint` with the new values before upgrading; the strict schema reports any key that is still unknown. Before running Step 3, confirm every credential `ExternalSecret` is Ready and the generated Secrets contain the expected keys.",{"_3634":3026,"_31209":2717,"_21628":60381,"_5":14884,"_28401":59606,"_3085":60382},[],"Helm runs the pre-upgrade hooks — the CA-to-KMS migration when enabled, and the database job — before applying any workload, so services never start against an unprepared database. If validation rejects unknown values, fix the values file and re-run.",{"_3634":3027,"_31209":2717,"_21628":60384,"_5":14884,"_28401":59606,"_3085":60385},[],"If the deployment uses local KMS or VA storage, those pods fail until you complete step 4, so `--wait` cannot succeed: Helm waits for them to become ready, times out, exits with an error and marks the release `failed`. The hooks have already run by then, and every manifest, including the new StatefulSets and their PVCs, has been applied. Helm does not roll anything back without `--atomic`. Continue with step 4, then re-run the same `helm upgrade` command so it completes and Helm records the release as `deployed`. Both hooks are idempotent, so they are safe to run again.",{"_3634":3028,"_31209":2717,"_21628":60387,"_5":14884,"_28401":59610,"_3085":60388},[],"Skip this step when `services.kms.cryptoEngines` never used a `filesystem` engine and `services.va.fileStore.type` was never `local`.",{"_3634":3029,"_31209":2717,"_21628":60390,"_5":14884,"_28401":59610,"_3085":60391},[],"**Find the new StatefulSets and PVCs.** Their names depend on the release name and any `nameOverride` or `fullnameOverride`; the PVC name is `<volumeClaimTemplate>-<StatefulSet name>-0`:",{"_3634":3030,"_31209":2717,"_21628":60393,"_5":14884,"_28401":59610,"_3085":60394},[],"With release `lamassu` and the default chart name, the new PVCs are `golang-engine-storage-lamassu-kms-0` and `local-crl-file-storage-lamassu-va-0`; with release `prod` they are `golang-engine-storage-prod-lamassu-kms-0` and `local-crl-file-storage-prod-lamassu-va-0`. Confirm both old and new PVCs exist before continuing. If `claims_ok` prints `ABORT`, the block stops before listing the claims: either a StatefulSet lookup failed, or a new claim resolves to the 3.8.0 claim. In the second case the copy would verify against itself and the final cleanup would delete the live volume. The chart always appends `-kms` and `-va` to the release-scoped name, so a collision means the claims are not what this guide expects; investigate before going on. Item 3 runs the same check and refuses to create the helper pod, so nothing touches the volumes. The check returns instead of calling `exit`, which would close your shell and lose the variables set so far. If you only migrate one of the two services, drop the other one's claims from the commands that follow.",{"_3634":3031,"_31209":2717,"_21628":60396,"_5":14884,"_28401":59610,"_3085":60397},[],"**Record the replica counts, scale the new StatefulSets down and wait for every pod that uses the claims to exit**, so nothing writes to either volume while you copy. Helm removes the 3.8.0 `kms` and `va` StatefulSets during the upgrade, but their pods `kms-0` and `va-0` can still be terminating and holding the old claims. While they run, the helper pod either cannot attach the claims or copies a volume that is still being written. The `wait` returns at once for pods that are already gone:",{"_3634":3032,"_31209":2717,"_21628":60399,"_5":14884,"_28401":59610,"_3085":60400},[],"**Run a short-lived helper pod** that mounts all four claims. It runs as root so it can change file ownership, so pin its image by digest and do not mount the service-account token:",{"_3634":3033,"_31209":2717,"_21628":60402,"_5":14884,"_28401":59610,"_3085":60403},[],"**Inspect before writing** so you do not clobber data the new pods may already have written:",{"_3634":3034,"_31209":2717,"_21628":60405,"_5":14884,"_28401":59610,"_3085":60406},[],"An empty result is the common case: a StatefulSet's own pod rarely gets far enough to write anything when its dependent data is missing. If the output is not empty, record the files and confirm with the service owner that they are disposable before you run the copy; do not overlay the 3.8.0 data onto an unknown store.",{"_3634":3035,"_31209":2717,"_21628":60408,"_5":14884,"_28401":59610,"_3085":60409},[],"**Copy the data, align ownership and verify the copy.** The second command must print `copy verified`; any `diff` output means the copy is incomplete, so do not continue:",{"_3634":3036,"_31209":2717,"_21628":60411,"_5":14884,"_28401":59610,"_3085":60412},[],"The `chown` is required even if the old files already look non-root-owned, because 4.0.0 requires exactly `65532:65532` and does not fall back to whatever the image declares.",{"_3634":3037,"_31209":2717,"_21628":60414,"_5":14884,"_28401":59610,"_3085":60415},[],"**Remove the helper and restore the recorded replica counts:**",{"_3634":3038,"_31209":2717,"_21628":60417,"_5":14884,"_28401":59610,"_3085":60418},[],"**Re-run the step 3 `helm upgrade` command.** The KMS and VA pods now start against the copied data, so `--wait` succeeds and the release moves from `failed` to `deployed`.",{"_3634":3039,"_31209":2717,"_21628":60420,"_5":14884,"_28401":59614,"_3085":60421},[],"After the upgrade that performed the CA-to-KMS migration succeeds, remove `migrations.caToKms.enabled` from your values (it defaults to `false`). The hook reads the legacy 3.8.0 `kms-config` ConfigMap while it still exists and falls back to the release-scoped `<release>-lamassu-kms-config` once it is gone.",{"_3634":3040,"_31209":2717,"_21628":60423,"_5":14884,"_28401":59614,"_3085":60424},[],"Then go through the validation checklist. Keep the old PVCs until it passes.",{"_3634":3041,"_31209":2717,"_21628":60426,"_5":14884,"_28401":59618,"_3085":60427},[],"Without the chart's database job, no tool moves data between databases: the migration tooling only applies migrations to a schema that already exists. Move each per-service database into its `pki` schema yourself, preserving structure, indexes, constraints, data and migration history, with writes stopped and a verified backup in hand.",{"_3634":3042,"_31209":2717,"_21628":60429,"_5":14884,"_28401":59618,"_3085":60430},[],"Run the migrations in the required order, one schema at a time: `kms` first, then the `ca-to-kms-migration` tool (needed only for legacy deployments whose CA keys are named by SKI), then `ca`, then `va`. The `devicemanager`, `dmsmanager` and `alerts` schemas are independent and can be migrated in any order. With Helm, the chart's pre-install job applies the schemas in the correct order automatically.",{"_3634":3043,"_31209":2717,"_21628":60432,"_5":14884,"_28401":59618,"_3085":60433},[],"If `kms` has not been migrated, the `ca` migration fails with `kms schema not found: migrate the kms schema before the ca schema`. The `va` migration requires `ca` and `kms` to be migrated first: it fails with `ca schema not found: migrate the ca schema before the va schema` or `kms schema not found: migrate the kms schema before the va schema` if one of them is missing.",{"_3634":3044,"_31209":2717,"_21628":60435,"_5":14884,"_28401":59618,"_3085":60436},[],"The schemas reference each other, so the PostgreSQL role running the migrations needs cross-schema privileges: the `ca` schema needs `USAGE` on `kms` plus `SELECT`, `REFERENCES` and `INSERT` on `kms.kms_keys`, and the `va` schema needs `USAGE` on `ca` plus `SELECT` and `REFERENCES` on `ca.certificates`, `SELECT` on `ca.ca_certificates`, and `USAGE` on `kms` plus `SELECT` and `REFERENCES` on `kms.kms_keys`. Without them the migration aborts; grant the missing privileges and rerun the failed schema. After migrating `ca`, if the CA service runs as a different user than the migration user, grant it `SELECT` on `ca.certificates_view` (`GRANT SELECT ON ca.certificates_view TO service_user`). Without this grant, certificate and CA reads fail with `permission denied for table certificates_view`. After migrating `va`, if the CA service runs as a different user, grant it `USAGE` on the `va` schema and `SELECT` on `va.crl_settings` (`GRANT USAGE ON SCHEMA va TO service_user; GRANT SELECT ON va.crl_settings TO service_user`): the CA service reads `va.crl_settings` when it deletes a CA, and without these grants every deletion of a CA that has a crypto engine fails with `permission denied for schema va` (or `for table crl_settings`).",{"_3634":3045,"_31209":2717,"_21628":60438,"_5":14884,"_28401":59618,"_3085":60439},[],"To apply migrations by hand, `goose-lamassu` must run against the `pki` database with `search_path=<schema>` in the connection string. The binary validates only `search_path`, not the database name, so check `dbname=pki` before running it, and repeat for `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` and `alerts`:",{"_3634":3046,"_31209":2717,"_21628":60441,"_5":14884,"_28401":59618,"_3085":60442},[],"Run `ca-to-kms-migration` first with `--dry-run`, which reports without writing to KMS storage, and then for real:",{"_3634":3047,"_31209":2717,"_21628":60444,"_5":14884,"_28401":59618,"_3085":60445},[],"Point the tool's `storage` configuration at the `pki` database, where the CA and KMS data now live in the `ca` and `kms` schemas. The tool's options are described in `backend/cmd/ca-to-kms-migration/README.md` in the `lamassuiot` repository.",{"_3634":3048,"_31209":2717,"_21628":60447,"_5":14884,"_28401":59618,"_3085":60448},[],"Both tools' READMEs document the 4.0.0 `pki` layout and match this page: `goose-lamassu` uses `dbname=pki` examples and does not validate the database name, and the `ca-to-kms-migration` README describes the single `pki` database and the migration order.",{"_3634":3049,"_31209":2717,"_21628":60450,"_5":14884,"_28401":59622,"_3085":60451},[],"**KMS or VA pods crash with `no such file or directory` or `code=NotFound` right after the upgrade.** The pods are bound to the new, empty PVCs and the data migration has not run yet, or was copied into the wrong PVC. Follow step 4 and check that all four claims exist.",{"_3634":3050,"_31209":2717,"_21628":60453,"_5":14884,"_28401":59622,"_3085":60454},[],"**`helm upgrade --wait` times out and `helm status` reports the release as `failed`.** With local KMS or VA storage this is expected on the first run: the new pods cannot become ready before their data is copied. The hooks ran and the manifests and PVCs were applied, so complete step 4 and re-run the same `helm upgrade` command. If other pods are also not ready, check their logs, because something else is wrong.",{"_3634":3051,"_31209":2717,"_21628":60456,"_5":14884,"_28401":59622,"_3085":60457},[],"**The helper pod stays `Pending` or `ContainerCreating` and `kubectl wait` times out.** Another pod still holds one of the claims; on block storage `kubectl describe pod pvc-migrate-helper` shows a `Multi-Attach error`. Check with `kubectl get pods -n $NAMESPACE` that `kms-0`, `va-0` and the new KMS and VA pods are gone, then re-run the wait.",{"_3634":3052,"_31209":2717,"_21628":60459,"_5":14884,"_28401":59622,"_3085":60460},[],"**`helm upgrade` fails with an unknown-key validation error.** Remove or rename the legacy values — typically `toolbox`, `auth.oidc.apiGateway` or `auth.authorization` — because the strict schema rejects keys it does not know.",{"_3634":3053,"_31209":2717,"_21628":60462,"_5":14884,"_28401":59622,"_3085":60463},[],"**The upgrade fails at the database job.** The PostgreSQL role cannot create databases or schemas, or a schema migration aborted: on duplicate CA IDs or missing `engine_id` values, or in the VA schema on a CA ID containing `/`, an SKI shared by more than one CA (the error asks you to recreate all but one of them on a different key), a role whose signer certificate has no key, a CA ID reserved for the archived settings of another role, or a CA ID equal to another role's SKI. The abort message names the offending objects; fix them and re-run the upgrade.",{"_3634":3054,"_31209":2717,"_21628":60465,"_5":14884,"_28401":59622,"_3085":60466},[],"**The upgrade fails at the CA-to-KMS hook.** CA certificates that share a `subject_key_id` declare conflicting `engine_id`s. Resolve the conflict and re-run.",{"_3634":3055,"_31209":2717,"_21628":60468,"_5":14884,"_28401":59622,"_3085":60469},[],"**Nobody can log in after the upgrade.** Check that `services.authz.jwkUrl` is reachable from the `authz` pod, that `services.authz.bootstrap` matches a role your OIDC provider actually assigns, and that the database job completed.",{"_3634":3056,"_31209":2717,"_21628":60471,"_5":14884,"_28401":59622,"_3085":60472},[],"**A migration aborts with `kms schema not found`.** The schemas must be migrated in order: run the `kms` schema migration before the `ca` and `va` schema migrations.",{"_3634":3057,"_31209":2717,"_21628":60474,"_5":14884,"_28401":59622,"_3085":60475},[],"**A migration aborts with `ca schema not found`.** Run the `ca` schema migration before the `va` schema migration.",{"_3634":3058,"_31209":2717,"_21628":60477,"_5":14884,"_28401":59622,"_3085":60478},[],"**The VA migration fails with `cannot resolve signer certificate for VA role ... N candidates`.** The migration cannot uniquely identify a signer certificate from the SKI stored on the role. Review the SKI and candidate certificates reported in the error; correct the pre-migration data with a verified backup and rerun the migration. The new `signer_serial_number` field is created during that migration, so it cannot be set through the VA API while the migration is failing.",{"_3634":3059,"_31209":2717,"_21628":60480,"_5":14884,"_28401":59622,"_3085":60481},[],"**A migration or service fails with `permission denied for table ...` or `permission denied for schema ...`.** The PostgreSQL role is missing the cross-schema privileges listed in Deployments without Helm; this includes `certificates_view` when the post-migration `GRANT SELECT` was skipped, and `permission denied for schema va` (or `for table crl_settings`) when deleting a CA without the `va` grants. Grant the missing privileges and re-run.",{"_3634":3060,"_31209":2717,"_21628":60483,"_5":14884,"_28401":59625,"_3085":60484},[],"After the upgrade, check in this order:",{"_3634":3061,"_31209":2717,"_21628":60486,"_5":14884,"_28401":59625,"_3085":60487},[],"**Databases.** Each service reads the `pki` database with its own schema, `authz` and `wfx` data are reachable, and the migration status is registered per schema, including the CA unique-ID and KMS composite-key migrations and the foreign-key migrations that run per schema in the required order.",{"_3634":3062,"_31209":2717,"_21628":60489,"_5":14884,"_28401":59625,"_3085":60490},[],"**KMS and VA start cleanly.** Their logs show no `no such file or directory` or `code=NotFound` errors.",{"_3634":3063,"_31209":2717,"_21628":60492,"_5":14884,"_28401":59625,"_3085":60493},[],"**Existing KMS keys work.** Issue a certificate from a CA that existed before the upgrade. None of the other checks reads a KMS key, so this is the only one that proves the key material was copied.",{"_3634":3064,"_31209":2717,"_21628":60495,"_5":14884,"_28401":59625,"_3085":60496},[],"**Existing CRLs are served.** `GET /crl/<ca-id>` on VA returns a previously issued CRL, and `GET /crl/<ca-ski>` with the legacy SKI of a certificate issued before the upgrade also resolves. The VA scheduled CRL job has issued a new list under the CA ID with both URLs in its IDP; check its logs if regeneration has not succeeded.",{"_3634":3065,"_31209":2717,"_21628":60498,"_5":14884,"_28401":59625,"_3085":60499},[],"**Renamed VA events.** Alert subscriptions to `va.role.update` and `va.role.crl.init` now subscribe to `va.crl-settings.update` and `va.crl-settings.init`, and conditions for all VA events, including `va.role.crl.create`, have been reviewed against the new payload (`ca_id` instead of `ca_ski`) and subject (`crl/<ca-id>` instead of `crl/<ski>`). Direct consumers and audit searches use the new event names.",{"_3634":3066,"_31209":2717,"_21628":60501,"_5":14884,"_28401":59625,"_3085":60502},[],"**Legacy CA keys.** If the CA-to-KMS migration ran, review its report and warnings and confirm the expected keys appear in the KMS. Migrated CA certificates now report `key_id` and `has_private_key`, which you can use to confirm the registration.",{"_3634":3067,"_31209":2717,"_21628":60504,"_5":14884,"_28401":59625,"_3085":60505},[],"**Connectivity.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` passes; the hook checks the CA, DMS Manager, Device Manager and VA health endpoints and the UI response.",{"_3634":3068,"_31209":2717,"_21628":60507,"_5":14884,"_28401":59625,"_3085":60508},[],"**Authorization.** Sign in as the bootstrap principal and confirm administration works, check that an identity without permissions receives `403`, and review client and integration permissions.",{"_3634":3069,"_31209":2717,"_21628":60510,"_5":14884,"_28401":59625,"_3085":60511},[],"**AMQP.** The backend connects to the broker with the expected TLS settings, and the cleanup policy for SSE queues is in place.",{"_3634":3070,"_31209":2717,"_21628":60513,"_5":14884,"_28401":59625,"_3085":60514},[],"**Device events.** `GET /v1/devices/:id/events` returns the historical events of a device that had them.",{"_3634":3071,"_31209":2717,"_21628":60516,"_5":14884,"_28401":59625,"_3085":60517},[],"**Webhooks without file fields.** For each DMS that uses a webhook for enrollment or re-enrollment, the `config` block carries `insecure_skip_verify` and the expected option block (`apikey_options`, `jwt_options` or `mtls_options`), with the certificate and key as PEM and no `cert_file` or `key_file`.",{"_3634":3072,"_31209":2717,"_21628":60519,"_5":14884,"_28401":59625,"_3085":60520},[],"**Receiver verification.** `insecure_skip_verify` is `false`, unless the receiver certificate is intentionally unverified.",{"_3634":3073,"_31209":2717,"_21628":60522,"_5":14884,"_28401":59625,"_3085":60523},[],"**Webhook delivery.** One enroll or re-enroll through each migrated webhook completes its authorization call.",{"_3634":3074,"_31209":2717,"_21628":60525,"_5":14884,"_28401":59625,"_3085":60526},[],"**Trust set.** `est_rfc7030_settings.client_certificate_settings.validation_cas` holds the expected CAs, in particular those of the old CA during rotation overlaps.",{"_3634":3075,"_31209":2717,"_21628":60528,"_5":14884,"_28401":59625,"_3085":60529},[],"**API clients.** Scripts and consoles no longer use the old DMS layout (flat `additional_validation_cas`, or the legacy `mtls`, `apikey` and `oidc` fields), send DMS updates with the ID in the URL, and match on the new certificate `type` values.",{"_3634":3076,"_31209":2717,"_21628":60531,"_5":14884,"_28401":59629,"_3085":60532},[],"Only once every check passes, delete the orphaned 3.8.0 volumes to reclaim storage. The delete is irreversible and the old KMS volume may hold the last copy of your CA key material, so take a `VolumeSnapshot` or a backup of both old PVCs first and keep it until you are confident the upgraded deployment is healthy. These are the fixed 3.8.0 names recorded in step 1; before deleting, confirm that neither is mounted by a running pod, for example with `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, where `Used By` must be `<none>`:",{"_3634":3077,"_31209":2717,"_21628":60534,"_5":14884,"_28401":59629,"_3085":60535},[],"The 3.8.0 per-service databases are no longer used either. Drop them only after the same checks pass and your PostgreSQL backup is verified.",{"_3634":3078,"_31209":2717,"_21628":60537,"_5":14884,"_28401":59629,"_3085":60538},[],"<Card title=\"Install with Helm\" description=\"Prepare dependencies, configure values and install a controlled deployment.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3634":3079,"_31209":2717,"_21628":60540,"_5":14884,"_28401":59629,"_3085":60541},[],"<Card title=\"Access control\" description=\"Principals, policies and the first administrator.\" href=\"/docs/platform/administration/access-control\" />",{"_3634":3080,"_31209":2717,"_21628":60543,"_5":14884,"_28401":59629,"_3085":60544},[],"<Card title=\"Configure a DMS\" description=\"Enrollment, re-enrollment and webhook settings.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />","sorting",{"_60547":60548,"_60549":60550,"_60551":60552,"_60553":60554,"_18765":3120,"_72832":3120},"language","english","sortableProperties",[3085,31209,5,28401],"sortablePropertiesWithTypes",{"_3085":25815,"_31209":25815,"_5":25815,"_28401":25815},"sorts",{"_3085":60555,"_31209":63625,"_5":66694,"_28401":69763},{"_4839":60556,"_60557":60558,"_5":25815},{"_14965":3686,"_15344":7291,"_15363":3253,"_30209":3468,"_15350":4592,"_20540":6743,"_14986":8166,"_14993":4244,"_30151":18626,"_30559":6996,"_30586":4181,"_30185":7510,"_35592":3341,"_30288":7837,"_30630":5635,"_35599":15415,"_35602":5247,"_35605":6078,"_35608":12899,"_31032":6080,"_35613":4168,"_35615":7906,"_31067":4769,"_15359":18790,"_35619":5375,"_35622":4553,"_35624":6450,"_30614":6991,"_31052":7964,"_31080":5195,"_35629":21806,"_35631":3601,"_35633":5048,"_30299":3186,"_35636":3433,"_35638":8524,"_35640":5517,"_35642":3815,"_35644":6146,"_30222":4845,"_35647":3522,"_35649":7