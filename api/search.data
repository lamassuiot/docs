121984,"_39448":121987,"_39450":121990,"_39452":121993,"_39454":121996,"_39456":121999,"_39458":122002,"_39460":122005,"_39462":122008,"_39464":122011,"_39466":122014,"_39468":122017,"_39470":122020,"_39472":122023,"_39474":122026,"_39476":122029,"_39478":122032,"_39480":122035,"_39482":122038,"_39484":122041,"_39486":122044,"_39488":122047,"_39490":122050,"_39492":122053,"_39494":122056,"_39496":122059,"_39499":122062,"_39501":122065,"_39503":122068},{"_3376":68401,"_29549":68401,"_5":14445,"_2862":113385,"_29881":113386,"_20523":113389,"_26884":68401},"Despliega desde AWS Marketplace",[48111,113387,113388],"Despliegue","Otros modelos",[],{"_3376":68402,"_29549":68401,"_20523":113391,"_5":14087,"_26884":68401,"_2862":113392},[],"Ejecuta una instancia preconfigurada de Lamassu IoT en Amazon EC2.",{"_3376":68403,"_29549":68401,"_5":29878,"_20523":113394,"_26884":113395,"_2862":113396},[],"/docs/es/deployment/aws-marketplace#antes-de-empezar","Antes de empezar",{"_3376":68404,"_29549":68401,"_5":29878,"_20523":113398,"_26884":113399,"_2862":113400},[],"/docs/es/deployment/aws-marketplace#requisitos-de-infraestructura","Requisitos de infraestructura",{"_3376":68405,"_29549":68401,"_5":29878,"_20523":113402,"_26884":113403,"_2862":113404},[],"/docs/es/deployment/aws-marketplace#abre-la-oferta","Abre la oferta",{"_3376":68406,"_29549":68401,"_5":29878,"_20523":113406,"_26884":113407,"_2862":113408},[],"/docs/es/deployment/aws-marketplace#configura-la-instancia","Configura la instancia",{"_3376":68407,"_29549":68401,"_5":29878,"_20523":113410,"_26884":113411,"_2862":113412},[],"/docs/es/deployment/aws-marketplace#limita-el-acceso-de-red","Limita el acceso de red",{"_3376":68408,"_29549":68401,"_5":29878,"_20523":113414,"_26884":113415,"_2862":113416},[],"/docs/es/deployment/aws-marketplace#lanza-y-verifica","Lanza y verifica",{"_3376":68409,"_29549":68401,"_5":29878,"_20523":113418,"_26884":113419,"_2862":113420},[],"/docs/es/deployment/aws-marketplace#siguiente-paso","Siguiente paso",{"_3376":68410,"_29549":68401,"_20523":113422,"_5":14087,"_26884":68401,"_2862":113423},[],"La oferta de AWS Marketplace reduce la preparación inicial a una instancia EC2 dentro de tu cuenta. Tú mantienes el control de la red, el almacenamiento y la operación de la máquina.",{"_3376":68411,"_29549":68401,"_20523":113425,"_5":14087,"_26884":113395,"_2862":113426},[],"Permisos para suscribirte a productos de AWS Marketplace y lanzar instancias EC2.",{"_3376":68412,"_29549":68401,"_20523":113428,"_5":14087,"_26884":113395,"_2862":113429},[],"Una VPC y una subred desde la que puedan acceder administradores y dispositivos.",{"_3376":68413,"_29549":68401,"_20523":113431,"_5":14087,"_26884":113395,"_2862":113432},[],"Un grupo de seguridad que permita los endpoints necesarios.",{"_3376":68414,"_29549":68401,"_20523":113434,"_5":14087,"_26884":113399,"_2862":113435},[],"**Cómputo:** una instancia `t3.large` como mínimo. Utiliza `t3.xlarge` o superior cuando la carga lo requiera.",{"_3376":68415,"_29549":68401,"_20523":113437,"_5":14087,"_26884":113399,"_2862":113438},[],"**Almacenamiento:** un volumen EBS `gp3` de al menos 50 GB, ajustado al tamaño del inventario y la retención.",{"_3376":68416,"_29549":68401,"_20523":113440,"_5":14087,"_26884":113399,"_2862":113441},[],"**Red:** acceso HTTPS desde los consumidores necesarios, restringido a redes de confianza.",{"_3376":68417,"_29549":68401,"_20523":113443,"_5":14087,"_26884":113403,"_2862":113444},[],"Accede a Lamassu IoT en AWS Marketplace y revisa las condiciones antes de suscribirte.",{"_3376":68418,"_29549":68401,"_20523":113446,"_5":14087,"_26884":113407,"_2862":113447},[],"Selecciona `t3.large` o superior, asigna al menos 50 GB de almacenamiento `gp3` y elige la VPC y subred de destino.",{"_3376":68419,"_29549":68401,"_20523":113449,"_5":14087,"_26884":113411,"_2862":113450},[],"Configura el grupo de seguridad para los puertos `443`, `8443` y `9443`. Restringe los orígenes a las redes administrativas y de dispositivos que realmente necesiten conectarse.",{"_3376":68420,"_29549":68401,"_20523":113452,"_5":14087,"_26884":113415,"_2862":113453},[],"Inicia la instancia y abre la consola en `https://<ip-publica>`. Comprueba que puedes autenticarte antes de continuar.",{"_3376":68421,"_29549":68401,"_20523":113455,"_5":14087,"_26884":113419,"_2862":113456},[],"Continúa con Crea tu primera CA para validar la configuración criptográfica de la instancia.",{"_3376":68422,"_29549":68422,"_5":14445,"_2862":113458,"_29881":113459,"_20523":113460,"_26884":68422},"Despliega Lamassu",[48111,113387],[],{"_3376":68423,"_29549":68422,"_20523":113462,"_5":14087,"_26884":68422,"_2862":113463},[],"Elige el modelo operativo que encaja con tu infraestructura y requisitos de control.",{"_3376":68424,"_29549":68422,"_5":29878,"_20523":113465,"_26884":113466,"_2862":113467},[],"/docs/es/deployment/overview#elige-un-modelo","Elige un modelo",{"_3376":68425,"_29549":68422,"_5":29878,"_20523":113469,"_26884":113470,"_2862":113471},[],"/docs/es/deployment/overview#solo-quieres-evaluar-la-plataforma","¿Solo quieres evaluar la plataforma?",{"_3376":68426,"_29549":68422,"_5":29878,"_20523":113473,"_26884":113474,"_2862":113475},[],"/docs/es/deployment/overview#después-del-despliegue","Después del despliegue",{"_3376":68427,"_29549":68422,"_20523":113477,"_5":14087,"_26884":68422,"_2862":113478},[],"Puedes ejecutar Lamassu en tu propio clúster Kubernetes, desplegar una imagen preparada desde AWS Marketplace o consumir la plataforma como servicio gestionado.",{"_3376":68428,"_29549":68422,"_20523":113480,"_5":14087,"_26884":113466,"_2862":113481},[],"Modelo",{"_3376":68429,"_29549":68422,"_20523":113483,"_5":14087,"_26884":113466,"_2862":113484},[],"Recomendado para",{"_3376":68430,"_29549":68422,"_20523":113486,"_5":14087,"_26884":113466,"_2862":113487},[],"Quién opera la infraestructura",{"_3376":68431,"_29549":68422,"_20523":113489,"_5":14087,"_26884":113466,"_2862":113490},[],"Punto de partida",{"_3376":68432,"_29549":68422,"_20523":113492,"_5":14087,"_26884":113466,"_2862":48218},[],{"_3376":68433,"_29549":68422,"_20523":113494,"_5":14087,"_26884":113466,"_2862":113495},[],"Producción, entornos regulados y despliegues personalizados",{"_3376":68434,"_29549":68422,"_20523":113497,"_5":14087,"_26884":113466,"_2862":113498},[],"Tu equipo",{"_3376":68435,"_29549":68422,"_20523":113500,"_5":14087,"_26884":113466,"_2862":113501},[],"Helm o Fastlane",{"_3376":68436,"_29549":68422,"_20523":113503,"_5":14087,"_26884":113466,"_2862":48230},[],{"_3376":68437,"_29549":68422,"_20523":113505,"_5":14087,"_26884":113466,"_2862":113506},[],"Evaluación o despliegue dedicado dentro de una cuenta AWS",{"_3376":68438,"_29549":68422,"_20523":113508,"_5":14087,"_26884":113466,"_2862":113498},[],{"_3376":68439,"_29549":68422,"_20523":113510,"_5":14087,"_26884":113466,"_2862":113511},[],"Imagen preconfigurada en EC2",{"_3376":68440,"_29549":68422,"_20523":113513,"_5":14087,"_26884":113466,"_2862":48241},[],{"_3376":68441,"_29549":68422,"_20523":113515,"_5":14087,"_26884":113466,"_2862":113516},[],"Equipos que quieren utilizar la plataforma sin operarla",{"_3376":68442,"_29549":68422,"_20523":113518,"_5":14087,"_26884":113466,"_2862":48247},[],{"_3376":68443,"_29549":68422,"_20523":113520,"_5":14087,"_26884":113466,"_2862":113521},[],"Suscripción gestionada",{"_3376":68444,"_29549":68422,"_20523":113523,"_5":14087,"_26884":113466,"_2862":113524},[],"<Card title=\"Kubernetes self-managed\" description=\"Controla red, almacenamiento, claves, dependencias y ciclo de actualización.\" href=\"/docs/deployment/self-hosted/overview\" />",{"_3376":68445,"_29549":68422,"_20523":113526,"_5":14087,"_26884":113466,"_2862":113527},[],"<Card title=\"AWS Marketplace\" description=\"Lanza una instancia preconfigurada de Lamassu en AWS EC2.\" href=\"/docs/deployment/aws-marketplace\" />",{"_3376":68446,"_29549":68422,"_20523":113529,"_5":14087,"_26884":113466,"_2862":113530},[],"<Card title=\"Lamassu SaaS\" description=\"Utiliza una instancia operada y actualizada como servicio gestionado.\" href=\"/docs/deployment/saas\" />",{"_3376":68447,"_29549":68422,"_20523":113532,"_5":14087,"_26884":113470,"_2862":113533},[],"Usa Fastlane para levantar PostgreSQL, Keycloak, RabbitMQ y Lamassu en un clúster Kubernetes mediante un único flujo. Está pensado para laboratorios, demos y bootstrap; para producción, configura las dependencias y los valores Helm de forma explícita.",{"_3376":68448,"_29549":68422,"_20523":113535,"_5":14087,"_26884":113474,"_2862":113536},[],"Cuando la consola esté disponible, continúa con Crea tu primera CA. Ese quickstart verifica que el motor criptográfico y la emisión funcionan correctamente.",{"_3376":68449,"_29549":68449,"_5":14445,"_2862":113538,"_29881":113539,"_20523":113540,"_26884":68449},"Utiliza Lamassu como SaaS",[48111,113387,113388],[],{"_3376":68450,"_29549":68449,"_20523":113542,"_5":14087,"_26884":68449,"_2862":113543},[],"Consume Lamassu como servicio gestionado sin operar infraestructura propia.",{"_3376":68451,"_29549":68449,"_5":29878,"_20523":113545,"_26884":113546,"_2862":113547},[],"/docs/es/deployment/saas#qué-gestiona-el-servicio","Qué gestiona el servicio",{"_3376":68452,"_29549":68449,"_5":29878,"_20523":113549,"_26884":113550,"_2862":113551},[],"/docs/es/deployment/saas#planes","Planes",{"_3376":68453,"_29549":68449,"_5":29878,"_20523":113553,"_26884":113554,"_2862":113555},[],"/docs/es/deployment/saas#solicita-acceso","Solicita acceso",{"_3376":68454,"_29549":68449,"_20523":113557,"_5":14087,"_26884":68449,"_2862":113558},[],"Lamassu SaaS ofrece las capacidades de la plataforma en un entorno administrado. Es la opción indicada cuando tu equipo quiere centrarse en la PKI y las identidades de los dispositivos, no en mantener la infraestructura que las soporta.",{"_3376":68455,"_29549":68449,"_20523":113560,"_5":14087,"_26884":113546,"_2862":113561},[],"Disponibilidad y mantenimiento de la plataforma.",{"_3376":68456,"_29549":68449,"_20523":113563,"_5":14087,"_26884":113546,"_2862":113564},[],"Copias de seguridad automáticas.",{"_3376":68457,"_29549":68449,"_20523":113566,"_5":14087,"_26884":113546,"_2862":113567},[],"Actualizaciones de versión.",{"_3376":68458,"_29549":68449,"_20523":113569,"_5":14087,"_26884":113546,"_2862":113570},[],"Soporte técnico y SLA según el plan contratado.",{"_3376":68459,"_29549":68449,"_20523":113572,"_5":14087,"_26884":113550,"_2862":48302},[],{"_3376":68460,"_29549":68449,"_20523":113574,"_5":14087,"_26884":113550,"_2862":113575},[],"Dispositivos",{"_3376":68461,"_29549":68449,"_20523":113577,"_5":14087,"_26884":113550,"_2862":113578},[],"Soporte",{"_3376":68462,"_29549":68449,"_20523":113580,"_5":14087,"_26884":113550,"_2862":48311},[],{"_3376":68463,"_29549":68449,"_20523":113582,"_5":14087,"_26884":113550,"_2862":48314},[],{"_3376":68464,"_29549":68449,"_20523":113584,"_5":14087,"_26884":113550,"_2862":113585},[],"Hasta 1.000",{"_3376":68465,"_29549":68449,"_20523":113587,"_5":14087,"_26884":113550,"_2862":48320},[],{"_3376":68466,"_29549":68449,"_20523":113589,"_5":14087,"_26884":113550,"_2862":113590},[],"99,5 %",{"_3376":68467,"_29549":68449,"_20523":113592,"_5":14087,"_26884":113550,"_2862":48326},[],{"_3376":68468,"_29549":68449,"_20523":113594,"_5":14087,"_26884":113550,"_2862":113595},[],"Hasta 10.000",{"_3376":68469,"_29549":68449,"_20523":113597,"_5":14087,"_26884":113550,"_2862":113598},[],"Email y chat",{"_3376":68470,"_29549":68449,"_20523":113600,"_5":14087,"_26884":113550,"_2862":113601},[],"99,9 %",{"_3376":68471,"_29549":68449,"_20523":113603,"_5":14087,"_26884":113550,"_2862":48338},[],{"_3376":68472,"_29549":68449,"_20523":113605,"_5":14087,"_26884":113550,"_2862":113606},[],"Ilimitados",{"_3376":68473,"_29549":68449,"_20523":113608,"_5":14087,"_26884":113550,"_2862":113609},[],"Dedicado",{"_3376":68474,"_29549":68449,"_20523":113611,"_5":14087,"_26884":113550,"_2862":113612},[],"99,99 %",{"_3376":68475,"_29549":68449,"_20523":113614,"_5":14087,"_26884":113554,"_2862":113615},[],"Contacta con el equipo de Lamassu a través de lamassu.io para solicitar una demo o elegir un plan.",{"_3376":68476,"_29549":68449,"_20523":113617,"_5":14087,"_26884":113554,"_2862":113618},[],"Cuando recibas las credenciales de tu instancia, continúa con Primeros pasos.",{"_3376":68477,"_29549":68477,"_5":14445,"_2862":48355,"_29881":113620,"_20523":113622,"_26884":68477},[48111,113387,113621],"Kubernetes autogestionado",[],{"_3376":68478,"_29549":68477,"_20523":113624,"_5":14087,"_26884":68477,"_2862":113625},[],"Arranca un entorno completo de evaluación o laboratorio de Lamassu en un clúster Kubernetes existente.",{"_3376":68479,"_29549":68477,"_5":29878,"_20523":113627,"_26884":113628,"_2862":113629},[],"/docs/es/deployment/self-hosted/fastlane#despliega-con-fastlane","Despliega con Fastlane",{"_3376":68480,"_29549":68477,"_5":29878,"_20523":113631,"_26884":113632,"_2862":113633},[],"/docs/es/deployment/self-hosted/fastlane#qué-añade-fastlane","Qué añade Fastlane",{"_3376":68481,"_29549":68477,"_5":29878,"_20523":113635,"_26884":113636,"_2862":113637},[],"/docs/es/deployment/self-hosted/fastlane#antes-de-comenzar","Antes de comenzar",{"_3376":68482,"_29549":68477,"_5":29878,"_20523":113639,"_26884":113640,"_2862":113641},[],"/docs/es/deployment/self-hosted/fastlane#inicio-rápido","Inicio rápido",{"_3376":68483,"_29549":68477,"_5":29878,"_20523":113643,"_26884":113644,"_2862":113645},[],"/docs/es/deployment/self-hosted/fastlane#selección-de-la-dirección-del-gateway","Selección de la dirección del Gateway",{"_3376":68484,"_29549":68477,"_5":29878,"_20523":113647,"_26884":113648,"_2862":113649},[],"/docs/es/deployment/self-hosted/fastlane#opciones-de-línea-de-comandos","Opciones de línea de comandos",{"_3376":68485,"_29549":68477,"_5":29878,"_20523":113651,"_26884":113652,"_2862":113653},[],"/docs/es/deployment/self-hosted/fastlane#modo-de-desarrollo","Modo de desarrollo",{"_3376":68486,"_29549":68477,"_5":29878,"_20523":113655,"_26884":113656,"_2862":113657},[],"/docs/es/deployment/self-hosted/fastlane#qué-configura-el-script","Qué configura el script",{"_3376":68487,"_29549":68477,"_5":29878,"_20523":113659,"_26884":113660,"_2862":113661},[],"/docs/es/deployment/self-hosted/fastlane#comportamiento-tls","Comportamiento TLS",{"_3376":68488,"_29549":68477,"_5":29878,"_20523":113663,"_26884":113664,"_2862":113665},[],"/docs/es/deployment/self-hosted/fastlane#credenciales-y-archivos-generados","Credenciales y archivos generados",{"_3376":68489,"_29549":68477,"_5":29878,"_20523":113667,"_26884":113668,"_2862":113669},[],"/docs/es/deployment/self-hosted/fastlane#verifica-la-instalación","Verifica la instalación",{"_3376":68490,"_29549":68477,"_20523":113671,"_5":14087,"_26884":113628,"_2862":113672},[],"Fastlane es el camino automatizado para evaluaciones, demos, CI y pequeños clústeres de laboratorio. Instala PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu, y los configura para trabajar juntos.",{"_3376":68491,"_29549":68477,"_20523":113674,"_5":14087,"_26884":113628,"_2862":113675},[],"Para producción, usa Helm para mantener explícitas las decisiones de base de datos, identidad, credenciales, certificados, almacenamiento y upgrades.",{"_3376":68492,"_29549":68477,"_20523":113677,"_5":14087,"_26884":113632,"_2862":113678},[],"Fastlane cubre algunas de las dependencias que el chart de aplicación deja deliberadamente fuera:",{"_3376":68493,"_29549":68477,"_20523":113680,"_5":14087,"_26884":113632,"_2862":113681},[],"Fastlane instala o configura",{"_3376":68494,"_29549":68477,"_20523":113683,"_5":14087,"_26884":113632,"_2862":113684},[],"Tú sigues proporcionando",{"_3376":68495,"_29549":68477,"_20523":113686,"_5":14087,"_26884":113632,"_2862":113687},[],"Instancias de PostgreSQL, RabbitMQ y Keycloak para evaluación",{"_3376":68496,"_29549":68477,"_20523":113689,"_5":14087,"_26884":113632,"_2862":113690},[],"El clúster Kubernetes, sus nodos y el almacenamiento persistente",{"_3376":68497,"_29549":68477,"_20523":113692,"_5":14087,"_26884":113632,"_2862":113693},[],"Envoy Gateway 1.8 y la `GatewayClass` `eg`",{"_3376":68498,"_29549":68477,"_20523":113695,"_5":14087,"_26884":113632,"_2862":113696},[],"cert-manager, accesibilidad desde la red externa, DNS y reglas de firewall/NAT",{"_3376":68499,"_29549":68477,"_20523":113698,"_5":14087,"_26884":113632,"_2862":113699},[],"Un flujo de certificado self-signed para Lamassu, credenciales generadas para las dependencias y un usuario inicial",{"_3376":68500,"_29549":68477,"_20523":113701,"_5":14087,"_26884":113632,"_2862":113702},[],"Confianza de los clientes en la CA self-signed, o un certificado de confianza pasado al script",{"_3376":68501,"_29549":68477,"_20523":113704,"_5":14087,"_26884":113632,"_2862":113705},[],"Componentes opcionales de observabilidad y HSM de laboratorio",{"_3376":68502,"_29549":68477,"_20523":113707,"_5":14087,"_26884":113632,"_2862":113708},[],"Retención de monitorización, backups, HA y un HSM/servicio de claves de producción",{"_3376":68503,"_29549":68477,"_20523":113710,"_5":14087,"_26884":113632,"_2862":113711},[],"Fastlane no convierte el stack en un servicio de producción: no crea el clúster, DNS público, reglas de firewall, backups, alta disponibilidad ni un certificado público de confianza.",{"_3376":68504,"_29549":68477,"_20523":113713,"_5":14087,"_26884":113636,"_2862":113714},[],"Necesitas:",{"_3376":68505,"_29549":68477,"_20523":113716,"_5":14087,"_26884":113636,"_2862":113717},[],"un clúster Kubernetes existente",{"_3376":68506,"_29549":68477,"_20523":113719,"_5":14087,"_26884":113636,"_2862":113720},[],"`kubectl` y Helm, o la CLI de MicroK8s",{"_3376":68507,"_29549":68477,"_20523":113722,"_5":14087,"_26884":113636,"_2862":48457},[],{"_3376":68508,"_29549":68477,"_20523":113724,"_5":14087,"_26884":113636,"_2862":23204},[],{"_3376":68509,"_29549":68477,"_20523":113726,"_5":14087,"_26884":113636,"_2862":113727},[],"`jq` solo si usas `--sample-data` o `--development`",{"_3376":68510,"_29549":68477,"_20523":113729,"_5":14087,"_26884":113636,"_2862":113730},[],"`ssh-keygen` solo si usas `--with-hsm`",{"_3376":68511,"_29549":68477,"_20523":113732,"_5":14087,"_26884":113636,"_2862":113733},[],"los puertos externos 80 y 443 libres en un host K3s de un único nodo",{"_3376":68512,"_29549":68477,"_20523":113735,"_5":14087,"_26884":113636,"_2862":113736},[],"Fastlane detecta MicroK8s, K3s, kind o un kubeconfig estándar. Usa `--context` cuando el clúster deseado no sea el contexto actual.",{"_3376":68513,"_29549":68477,"_20523":113738,"_5":14087,"_26884":113636,"_2862":113739},[],"Fastlane instala varios componentes y crea credenciales. Comprueba `kubectl config current-context` o pasa `--context` antes de ejecutarlo.",{"_3376":68514,"_29549":68477,"_20523":113741,"_5":14087,"_26884":113640,"_2862":113742},[],"Ejecuta el script desde un clon del repositorio Helm:",{"_3376":68515,"_29549":68477,"_20523":113744,"_5":14087,"_26884":113640,"_2862":113745},[],"Crea un registro DNS para el dominio elegido antes de probar desde otra máquina. En una VM pequeña, apúntalo a la dirección de la VM o del balanceador que realmente recibe los puertos 80 y 443.",{"_3376":68516,"_29549":68477,"_20523":113747,"_5":14087,"_26884":113644,"_2862":113748},[],"Por defecto, Fastlane ejecuta `hostname -I` y escribe las direcciones devueltas en `gateway.addresses` y en los SAN IP del certificado self-signed.",{"_3376":68517,"_29549":68477,"_20523":113750,"_5":14087,"_26884":113644,"_2862":113751},[],"En una VM de laboratorio con una única interfaz puede seleccionar la dirección esperada. En hosts con Docker, VPN, WireGuard o varias interfaces también puede elegir direcciones inaccesibles para los clientes. Sobrescribe el resultado:",{"_3376":68518,"_29549":68477,"_20523":113753,"_5":14087,"_26884":113644,"_2862":113754},[],"El valor debe ser una dirección gestionada en el lado Kubernetes de la ruta. Si una IP pública de EC2 reenvía tráfico por WireGuard, pasa la dirección accesible de la VM o clúster, no la IP pública de EC2.",{"_3376":68519,"_29549":68477,"_20523":113756,"_5":14087,"_26884":113644,"_2862":113757},[],"Consulta Expón el Gateway para los conflictos de puertos de K3s, VIP, NAT externo y diseños con varios Gateways.",{"_3376":68520,"_29549":68477,"_20523":113759,"_5":14087,"_26884":113648,"_2862":113760},[],"Opción",{"_3376":68521,"_29549":68477,"_20523":113762,"_5":14087,"_26884":113648,"_2862":113763},[],"Valor predeterminado",{"_3376":68522,"_29549":68477,"_20523":113765,"_5":14087,"_26884":113648,"_2862":113766},[],"Propósito",{"_3376":68523,"_29549":68477,"_20523":113768,"_5":14087,"_26884":113648,"_2862":48504},[],{"_3376":68524,"_29549":68477,"_20523":113770,"_5":14087,"_26884":113648,"_2862":48507},[],{"_3376":68525,"_29549":68477,"_20523":113772,"_5":14087,"_26884":113648,"_2862":113773},[],"Muestra la ayuda",{"_3376":68526,"_29549":68477,"_20523":113775,"_5":14087,"_26884":113648,"_2862":48513},[],{"_3376":68527,"_29549":68477,"_20523":113777,"_5":14087,"_26884":113648,"_2862":113778},[],"contexto actual",{"_3376":68528,"_29549":68477,"_20523":113780,"_5":14087,"_26884":113648,"_2862":113781},[],"Selecciona el contexto de kubeconfig para kubectl y Helm",{"_3376":68529,"_29549":68477,"_20523":113783,"_5":14087,"_26884":113648,"_2862":48522},[],{"_3376":68530,"_29549":68477,"_20523":113785,"_5":14087,"_26884":113648,"_2862":6381},[],{"_3376":68531,"_29549":68477,"_20523":113787,"_5":14087,"_26884":113648,"_2862":113788},[],"Omite prompts y genera credenciales para las dependencias",{"_3376":68532,"_29549":68477,"_20523":113790,"_5":14087,"_26884":113648,"_2862":48530},[],{"_3376":68533,"_29549":68477,"_20523":113792,"_5":14087,"_26884":113648,"_2862":48533},[],{"_3376":68534,"_29549":68477,"_20523":113794,"_5":14087,"_26884":113648,"_2862":113795},[],"Namespace de la instalación",{"_3376":68535,"_29549":68477,"_20523":113797,"_5":14087,"_26884":113648,"_2862":48539},[],{"_3376":68536,"_29549":68477,"_20523":113799,"_5":14087,"_26884":113648,"_2862":48542},[],{"_3376":68537,"_29549":68477,"_20523":113801,"_5":14087,"_26884":113648,"_2862":113802},[],"Dominio usado por la UI, OIDC y el certificado",{"_3376":68538,"_29549":68477,"_20523":113804,"_5":14087,"_26884":113648,"_2862":48548},[],{"_3376":68539,"_29549":68477,"_20523":113806,"_5":14087,"_26884":113648,"_2862":14774},[],{"_3376":68540,"_29549":68477,"_20523":113808,"_5":14087,"_26884":113648,"_2862":113809},[],"Versión del chart de Lamassu",{"_3376":68541,"_29549":68477,"_20523":113811,"_5":14087,"_26884":113648,"_2862":48556},[],{"_3376":68542,"_29549":68477,"_20523":113813,"_5":14087,"_26884":113648,"_2862":48559},[],{"_3376":68543,"_29549":68477,"_20523":113815,"_5":14087,"_26884":113648,"_2862":113816},[],"Puerto del listener HTTPS",{"_3376":68544,"_29549":68477,"_20523":113818,"_5":14087,"_26884":113648,"_2862":48565},[],{"_3376":68545,"_29549":68477,"_20523":113820,"_5":14087,"_26884":113648,"_2862":48568},[],{"_3376":68546,"_29549":68477,"_20523":113822,"_5":14087,"_26884":113648,"_2862":113823},[],"Puerto del listener HTTP",{"_3376":68547,"_29549":68477,"_20523":113825,"_5":14087,"_26884":113648,"_2862":48574},[],{"_3376":68548,"_29549":68477,"_20523":113827,"_5":14087,"_26884":113648,"_2862":48507},[],{"_3376":68549,"_29549":68477,"_20523":113829,"_5":14087,"_26884":113648,"_2862":113830},[],"Certificado PEM para TLS downstream",{"_3376":68550,"_29549":68477,"_20523":113832,"_5":14087,"_26884":113648,"_2862":48582},[],{"_3376":68551,"_29549":68477,"_20523":113834,"_5":14087,"_26884":113648,"_2862":48507},[],{"_3376":68552,"_29549":68477,"_20523":113836,"_5":14087,"_26884":113648,"_2862":113837},[],"Clave privada PEM para TLS downstream",{"_3376":68553,"_29549":68477,"_20523":113839,"_5":14087,"_26884":113648,"_2862":48590},[],{"_3376":68554,"_29549":68477,"_20523":113841,"_5":14087,"_26884":113648,"_2862":113842},[],"chart del repositorio",{"_3376":68555,"_29549":68477,"_20523":113844,"_5":14087,"_26884":113648,"_2862":113845},[],"Usa un chart local de Lamassu sin empaquetar",{"_3376":68556,"_29549":68477,"_20523":113847,"_5":14087,"_26884":113648,"_2862":48599},[],{"_3376":68557,"_29549":68477,"_20523":113849,"_5":14087,"_26884":113648,"_2862":113850},[],"detección automática",{"_3376":68558,"_29549":68477,"_20523":113852,"_5":14087,"_26884":113648,"_2862":113853},[],"Sobrescribe la dirección escrita en `gateway.addresses`",{"_3376":68559,"_29549":68477,"_20523":113855,"_5":14087,"_26884":113648,"_2862":48607},[],{"_3376":68560,"_29549":68477,"_20523":113857,"_5":14087,"_26884":113648,"_2862":6381},[],{"_3376":68561,"_29549":68477,"_20523":113859,"_5":14087,"_26884":113648,"_2862":113860},[],"Instala Victoria Logs, VictoriaTraces, Jaeger y un OpenTelemetry Collector",{"_3376":68562,"_29549":68477,"_20523":113862,"_5":14087,"_26884":113648,"_2862":48615},[],{"_3376":68563,"_29549":68477,"_20523":113864,"_5":14087,"_26884":113648,"_2862":6381},[],{"_3376":68564,"_29549":68477,"_20523":113866,"_5":14087,"_26884":113648,"_2862":113867},[],"Modo desarrollo: provisiona completamente el usuario `lamassu` de Keycloak (contraseña fija `lamassu`/`lamassu`, sin pasos en el primer inicio) y permite al cliente `frontend` aceptar cualquier redirect URI u origen web. No es para producción",{"_3376":68565,"_29549":68477,"_20523":113869,"_5":14087,"_26884":113648,"_2862":48623},[],{"_3376":68566,"_29549":68477,"_20523":113871,"_5":14087,"_26884":113648,"_2862":6381},[],{"_3376":68567,"_29549":68477,"_20523":113873,"_5":14087,"_26884":113648,"_2862":113874},[],"Crea CA, perfiles, certificados, DMS y dispositivos de ejemplo",{"_3376":68568,"_29549":68477,"_20523":113876,"_5":14087,"_26884":113648,"_2862":48631},[],{"_3376":68569,"_29549":68477,"_20523":113878,"_5":14087,"_26884":113648,"_2862":6381},[],{"_3376":68570,"_29549":68477,"_20523":113880,"_5":14087,"_26884":113648,"_2862":113881},[],"Instala componentes HSM de laboratorio y configura KMS con PKCS#11",{"_3376":68571,"_29549":68477,"_20523":113883,"_5":14087,"_26884":113648,"_2862":48639},[],{"_3376":68572,"_29549":68477,"_20523":113885,"_5":14087,"_26884":113648,"_2862":48642},[],{"_3376":68573,"_29549":68477,"_20523":113887,"_5":14087,"_26884":113648,"_2862":113888},[],"Usa otro chart local de SoftHSM",{"_3376":68574,"_29549":68477,"_20523":113890,"_5":14087,"_26884":113648,"_2862":113891},[],"Fastlane no ofrece un modo offline. Para entornos sin conexión, usa el flujo manual con Helm y prepara un registro y mirror de charts.",{"_3376":68575,"_29549":68477,"_20523":113893,"_5":14087,"_26884":113652,"_2862":113894},[],"`--development` ajusta el realm `lamassu` de Keycloak que genera Fastlane para un entorno de evaluación desechable:",{"_3376":68576,"_29549":68477,"_20523":113896,"_5":14087,"_26884":113652,"_2862":113897},[],"el usuario `lamassu` queda completamente provisionado (nombre Lamassu, apellido Admin, email `lamassu@lamassu.io`, verificado): no hay pasos de perfil ni de cambio de contraseña en el primer inicio de sesión",{"_3376":68577,"_29549":68477,"_20523":113899,"_5":14087,"_26884":113652,"_2862":113900},[],"la contraseña conocida `lamassu`/`lamassu` es fija y permanente: no se rota nunca y concede el rol `pki-admin`, incluidos tokens no interactivos a través del cliente `frontend`",{"_3376":68578,"_29549":68477,"_20523":113902,"_5":14087,"_26884":113652,"_2862":113903},[],"el cliente `frontend` acepta cualquier redirect URI y cualquier origen web (`*`) en lugar de los patrones `/*` originales",{"_3376":68579,"_29549":68477,"_20523":113905,"_5":14087,"_26884":113652,"_2862":113906},[],"Con `--development`, la contraseña fija `lamassu`/`lamassu` concede acceso `pki-admin` a cualquiera que alcance la instalación. No lo uses nunca en nada expuesto más allá de una máquina de desarrollo o de un host accesible por red.",{"_3376":68580,"_29549":68477,"_20523":113908,"_5":14087,"_26884":113652,"_2862":113909},[],"`--development` se aplica cuando el realm `lamassu` se importa por primera vez. No modifica un clúster existente. Puede combinarse con `--sample-data`: la transformación de desarrollo se ejecuta primero y después se añaden los datos de ejemplo a la misma configuración del realm.",{"_3376":68581,"_29549":68477,"_20523":113911,"_5":14087,"_26884":113656,"_2862":48669},[],{"_3376":68582,"_29549":68477,"_20523":113913,"_5":14087,"_26884":113656,"_2862":113914},[],"valida las herramientas locales y el clúster seleccionado",{"_3376":68583,"_29549":68477,"_20523":113916,"_5":14087,"_26884":113656,"_2862":113917},[],"instala o actualiza Envoy Gateway 1.8 y crea la `GatewayClass` `eg`",{"_3376":68584,"_29549":68477,"_20523":113919,"_5":14087,"_26884":113656,"_2862":113920},[],"crea el namespace",{"_3376":68585,"_29549":68477,"_20523":113922,"_5":14087,"_26884":113656,"_2862":113923},[],"instala PostgreSQL y crea las bases de datos necesarias",{"_3376":68586,"_29549":68477,"_20523":113925,"_5":14087,"_26884":113656,"_2862":113926},[],"instala Keycloak y crea el realm `lamassu`, el cliente frontend, el rol administrador y el usuario inicial",{"_3376":68587,"_29549":68477,"_20523":113928,"_5":14087,"_26884":113656,"_2862":113929},[],"instala RabbitMQ",{"_3376":68588,"_29549":68477,"_20523":113931,"_5":14087,"_26884":113656,"_2862":113932},[],"instala opcionalmente observabilidad y componentes HSM de laboratorio",{"_3376":68589,"_29549":68477,"_20523":113934,"_5":14087,"_26884":113656,"_2862":113935},[],"genera `lamassu.yaml` e instala el chart de Lamassu",{"_3376":68590,"_29549":68477,"_20523":113937,"_5":14087,"_26884":113656,"_2862":113938},[],"carga datos de ejemplo opcionalmente",{"_3376":68591,"_29549":68477,"_20523":113940,"_5":14087,"_26884":113656,"_2862":113941},[],"La configuración generada expone Keycloak en `/auth` a través del mismo Gateway y provisiona al usuario inicial `lamassu` como superadministrador de Lamassu.",{"_3376":68592,"_29549":68477,"_20523":113943,"_5":14087,"_26884":113660,"_2862":113944},[],"Al proporcionar `--tls-crt` y `--tls-key`, Fastlane crea el Secret `downstream-provided-crt` y configura `tls.type: external`.",{"_3376":68593,"_29549":68477,"_20523":113946,"_5":14087,"_26884":113660,"_2862":113947},[],"Sin ellos, configura cert-manager con un emisor self-signed. Es adecuado para laboratorio, pero los clientes no confiarán en él hasta que distribuyas la CA. Usa Helm si necesitas un Issuer corporativo, un emisor ACME público o un Secret existente gestionado por otro sistema.",{"_3376":68594,"_29549":68477,"_20523":113949,"_5":14087,"_26884":113664,"_2862":113950},[],"El modo no interactivo genera contraseñas aleatorias para los administradores de PostgreSQL, RabbitMQ y Keycloak. El acceso inicial a Lamassu es `lamassu` / `lamassu` y obliga a cambiar la contraseña en el primer uso, salvo que se haya usado `--development`: en ese caso la contraseña permanece fija y permanente.",{"_3376":68595,"_29549":68477,"_20523":113952,"_5":14087,"_26884":113664,"_2862":113953},[],"Fastlane escribe `lamassu.yaml` en el directorio actual e incluye credenciales en él.",{"_3376":68596,"_29549":68477,"_20523":113955,"_5":14087,"_26884":113664,"_2862":113956},[],"Protege el archivo de valores generado, guarda las credenciales en un almacén de secretos apropiado y no reutilices la configuración de identidad de evaluación en producción.",{"_3376":68597,"_29549":68477,"_20523":113958,"_5":14087,"_26884":113668,"_2862":113959},[],"Abre `https://pki.example.com` e inicia sesión con el usuario inicial. Si el Gateway está programado pero la URL no es accesible, sigue las comprobaciones de Expón el Gateway.",{"_3376":68598,"_29549":68598,"_5":14445,"_2862":113961,"_29881":113962,"_20523":113963,"_26884":68598},"Instala con Helm",[48111,113387,113621],[],{"_3376":68599,"_29549":68598,"_20523":113965,"_5":14087,"_26884":68598,"_2862":113966},[],"Prepara las dependencias, configura el chart de Lamassu y verifica un despliegue controlado en Kubernetes.",{"_3376":68600,"_29549":68598,"_5":29878,"_20523":113968,"_26884":113969,"_2862":113970},[],"/docs/es/deployment/self-hosted/helm#instala-lamassu-con-helm","Instala Lamassu con Helm",{"_3376":68601,"_29549":68598,"_5":29878,"_20523":113972,"_26884":113973,"_2862":113637},[],"/docs/es/deployment/self-hosted/helm#antes-de-comenzar",{"_3376":68602,"_29549":68598,"_5":29878,"_20523":113975,"_26884":113976,"_2862":113977},[],"/docs/es/deployment/self-hosted/helm#1-instala-los-requisitos-del-gateway","1\\. Instala los requisitos del Gateway",{"_3376":68603,"_29549":68598,"_5":29878,"_20523":113979,"_26884":113980,"_2862":113981},[],"/docs/es/deployment/self-hosted/helm#2-crea-un-archivo-de-valores","2\\. Crea un archivo de valores",{"_3376":68604,"_29549":68598,"_5":29878,"_20523":113983,"_26884":113984,"_2862":113985},[],"/docs/es/deployment/self-hosted/helm#tls-con-un-secret-existente","TLS con un Secret existente",{"_3376":68605,"_29549":68598,"_5":29878,"_20523":113987,"_26884":113988,"_2862":113989},[],"/docs/es/deployment/self-hosted/helm#tls-de-amqp-amqps","TLS de AMQP (AMQPS)",{"_3376":68606,"_29549":68598,"_5":29878,"_20523":113991,"_26884":113992,"_2862":113993},[],"/docs/es/deployment/self-hosted/helm#provisiona-el-primer-administrador","Provisiona el primer administrador",{"_3376":68607,"_29549":68598,"_5":29878,"_20523":113995,"_26884":113996,"_2862":113997},[],"/docs/es/deployment/self-hosted/helm#3-instala-lamassu","3\\. Instala Lamassu",{"_3376":68608,"_29549":68598,"_5":29878,"_20523":113999,"_26884":114000,"_2862":114001},[],"/docs/es/deployment/self-hosted/helm#4-verifica-el-despliegue","4\\. Verifica el despliegue",{"_3376":68609,"_29549":68598,"_5":29878,"_20523":114003,"_26884":114004,"_2862":114005},[],"/docs/es/deployment/self-hosted/helm#actualiza-lamassu","Actualiza Lamassu",{"_3376":68610,"_29549":68598,"_5":29878,"_20523":114007,"_26884":114008,"_2862":114009},[],"/docs/es/deployment/self-hosted/helm#decisiones-para-producción","Decisiones para producción",{"_3376":68611,"_29549":68598,"_20523":114011,"_5":14087,"_26884":113969,"_2862":114012},[],"Usa Helm cuando necesites control explícito sobre identidad, bases de datos, mensajería, certificados, almacenamiento y upgrades. Para un entorno de evaluación en el que el script pueda tomar esas decisiones, usa Fastlane.",{"_3376":68612,"_29549":68598,"_20523":114014,"_5":14087,"_26884":113973,"_2862":114015},[],"Prepara los servicios de plataforma que quedan deliberadamente fuera del chart de Lamassu:",{"_3376":68613,"_29549":68598,"_20523":114017,"_5":14087,"_26884":113973,"_2862":114018},[],"un clúster Kubernetes 1.24+ y Helm 3.2+",{"_3376":68614,"_29549":68598,"_20523":114020,"_5":14087,"_26884":113973,"_2862":114021},[],"un servidor PostgreSQL accesible y un rol autorizado para crear bases de datos y schemas",{"_3376":68615,"_29549":68598,"_20523":114023,"_5":14087,"_26884":113973,"_2862":114024},[],"un broker RabbitMQ accesible y sus credenciales",{"_3376":68616,"_29549":68598,"_20523":114026,"_5":14087,"_26884":113973,"_2862":114027},[],"un proveedor OIDC, normalmente Keycloak, con un realm/tenant y un cliente para Lamassu",{"_3376":68617,"_29549":68598,"_20523":114029,"_5":14087,"_26884":113973,"_2862":114030},[],"Envoy Gateway 1.8+ y una `GatewayClass`",{"_3376":68618,"_29549":68598,"_20523":114032,"_5":14087,"_26884":113973,"_2862":114033},[],"cert-manager 1.14+ (solo para el modo predeterminado `tls.type: certManager`); para TLS de confianza, un emisor de confianza o un Secret TLS de Kubernetes",{"_3376":68619,"_29549":68598,"_20523":114035,"_5":14087,"_26884":113973,"_2862":114036},[],"una StorageClass y un diseño de tráfico externo",{"_3376":68620,"_29549":68598,"_20523":114038,"_5":14087,"_26884":113973,"_2862":114039},[],"El chart usa por defecto una `GatewayClass` llamada `eg`. Cambia `gateway.className` si tu equipo de plataforma utiliza otro nombre.",{"_3376":68621,"_29549":68598,"_20523":114041,"_5":14087,"_26884":113973,"_2862":114042},[],"Tú proporcionas el servidor PostgreSQL. El job de pre-install del chart se conecta con las credenciales indicadas, crea las bases de datos `pki`, `authz` y `wfx` y los schemas de los servicios, ejecuta las migraciones y aplica `services.authz.bootstrap`.",{"_3376":68622,"_29549":68598,"_20523":114044,"_5":14087,"_26884":113973,"_2862":114045},[],"El chart no tiene dependencias Helm que instalen PostgreSQL, RabbitMQ, un proveedor OIDC, Envoy Gateway ni cert-manager.",{"_3376":68623,"_29549":68598,"_20523":114047,"_5":14087,"_26884":113976,"_2862":114048},[],"Instala o actualiza las CRD de Envoy Gateway antes de su controlador. Estos comandos usan la misma versión que el repositorio Helm de Lamassu:",{"_3376":68624,"_29549":68598,"_20523":114050,"_5":14087,"_26884":113976,"_2862":114051},[],"Crea la `GatewayClass` predeterminada si todavía no existe. Guarda este manifiesto como `gateway-class.yaml`:",{"_3376":68625,"_29549":68598,"_20523":114053,"_5":14087,"_26884":113976,"_2862":114054},[],"Instala cert-manager por separado antes de Lamassu, pero solo para el modo predeterminado `tls.type: certManager`. En ese modo el chart renderiza sus recursos de Issuer self-signed y Certificate CA tanto si `tls.certManagerOptions.clusterIssuer` está definido como si no, por lo que cert-manager sigue siendo un requisito. Con `tls.type: external`, el chart no renderiza recursos de cert-manager y el Gateway termina el TLS con un Secret existente que tú proporcionas.",{"_3376":68626,"_29549":68598,"_20523":114056,"_5":14087,"_26884":113980,"_2862":114057},[],"Parte de los valores predeterminados del chart y sobrescribe los específicos del entorno. Este ejemplo supone que PostgreSQL, RabbitMQ y Keycloak son accesibles mediante DNS de Kubernetes y expone Keycloak en `/auth` a través del Gateway compartido:",{"_3376":68627,"_29549":68598,"_20523":114059,"_5":14087,"_26884":113980,"_2862":114060},[],"No añadas `gateway.addresses` por defecto. Deja la asignación de dirección a la implementación del balanceador salvo que tu diseño de red requiera una VIP concreta en Kubernetes. La IP pública de un NAT o proxy upstream no corresponde a este valor.",{"_3376":68628,"_29549":68598,"_20523":114062,"_5":14087,"_26884":113980,"_2862":114063},[],"Si Keycloak es externo y ya tiene una URL accesible, apunta la configuración OIDC hacia él y omite la entrada `/auth` de `gateway.extraRouting`.",{"_3376":68629,"_29549":68598,"_20523":114065,"_5":14087,"_26884":113980,"_2862":114066},[],"Si tu archivo de valores aún contiene los ajustes heredados de validación JWT del Gateway — `auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` o `auth.authorization.roles.admin` — elimínalos. La guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md` documenta su eliminación sin alias de compatibilidad, y `values.schema.json` rechaza los bloques residuales en lugar de ignorarlos silenciosamente. Los reemplazos son `services.authz.jwkUrl` y `services.authz.bootstrap`, que ya aparecen en el ejemplo anterior.",{"_3376":68630,"_29549":68598,"_20523":114068,"_5":14087,"_26884":113984,"_2862":114069},[],"Crea un Secret con `tls.crt` y `tls.key` y referéncialo. El Secret debe existir antes de instalar: en modo `external` el chart no renderiza recursos de cert-manager ni crea nunca este Secret.",{"_3376":68631,"_29549":68598,"_20523":114071,"_5":14087,"_26884":113988,"_2862":114072},[],"`amqp.tls: true` selecciona AMQPS en todos los bloques de configuración del bus de eventos. El puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS, así que define `amqp.port` con el listener TLS del broker, normalmente `5671`.",{"_3376":68632,"_29549":68598,"_20523":114074,"_5":14087,"_26884":113988,"_2862":114075},[],"Sin un Secret de CA configurado, los clientes del bus de eventos usan las CA de confianza del sistema. Para confiar en una CA privada, crea un Secret en el namespace del release con el certificado de la CA en formato PEM y define `amqp.ca.secretName` (y `amqp.ca.certificateKey` si la clave de datos no es `ca.crt`).",{"_3376":68633,"_29549":68598,"_20523":114077,"_5":14087,"_26884":113988,"_2862":114078},[],"Para brokers que exijan TLS mutuo, crea un Secret con el certificado de cliente y su clave privada y define `amqp.client.secretName` (con `amqp.client.certificateKey` y `amqp.client.privateKeyKey` si las claves de datos no son `tls.crt` y `tls.key`).",{"_3376":68634,"_29549":68598,"_20523":114080,"_5":14087,"_26884":113988,"_2862":114081},[],"El chart monta los Secrets configurados en modo de solo lectura en todas las cargas de trabajo que consumen AMQP: el certificado de la CA en `/etc/lamassu/amqp/ca` y el certificado y la clave de cliente en `/etc/lamassu/amqp/client`. Los nombres de los archivos montados son siempre `ca.crt`, `tls.crt` y `tls.key` — los valores `certificateKey` y `privateKeyKey` renombran solo las claves de datos del Secret, nunca las rutas en disco. La clave privada del cliente se monta con permisos restrictivos (`defaultMode: 0440`; el volumen de la CA usa `0444`), que funcionan porque el chart añade `fsGroup` al security context del pod cuando `amqp.client.secretName` está definido — usa el `runAsGroup` del contenedor (por defecto `65532`) cuando `fsGroup` no está ya definido.",{"_3376":68635,"_29549":68598,"_20523":114083,"_5":14087,"_26884":113988,"_2862":114084},[],"Ambas opciones de Secret exigen `amqp.tls: true`: `values.schema.json` rechaza un `secretName` no vacío cuando `tls` es false, rechaza claves desconocidas y rechaza nombres de clave de datos fuera de `^[A-Za-z0-9._-]+$`. El Secret referenciado debe existir en el namespace del release o los pods consumidores no llegan a arrancar.",{"_3376":68636,"_29549":68598,"_20523":114086,"_5":14087,"_26884":113988,"_2862":114087},[],"El cliente AMQP carga los certificados al arrancar, así que reinicia los pods consumidores tras actualizar cualquiera de los dos Secrets. Cambiar cualquier valor de `amqp` reinicia las cargas de trabajo consumidoras mediante la anotación `checksum/config`, pero cambiar solo el contenido de un Secret no desencadena un rollout.",{"_3376":68637,"_29549":68598,"_20523":114089,"_5":14087,"_26884":113988,"_2862":114090},[],"Según la guía de migración `charts/lamassu/CHANGELOG/3.8.0->4.0.0.md`: en 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos usaban AMQP en claro; desde 4.0.0, `amqp.tls: true` los cambia a AMQPS. Define `amqp.port` con el listener TLS del broker antes del upgrade, o usa `amqp.tls: false` para mantener AMQP en claro. `amqp.tls: false` envía las credenciales del broker y todo el tráfico del bus de eventos en claro.",{"_3376":68638,"_29549":68598,"_20523":114092,"_5":14087,"_26884":113992,"_2862":114093},[],"No existe un superusuario implícito. Crea en el proveedor OIDC el rol o grupo esperado por `services.authz.bootstrap` y asígnalo al menos a un administrador antes de exponer Lamassu.",{"_3376":68639,"_29549":68598,"_20523":114095,"_5":14087,"_26884":113992,"_2862":114096},[],"El job de pre-install y pre-upgrade aplica el bootstrap de forma idempotente: conserva los principales existentes y añade los grants que falten.",{"_3376":68640,"_29549":68598,"_20523":114098,"_5":14087,"_26884":113992,"_2862":114099},[],"Prueba una identidad autorizada y otra denegada. Si ningún token coincide con un principal activo del bootstrap, nadie podrá administrar la PKI.",{"_3376":68641,"_29549":68598,"_20523":114101,"_5":14087,"_26884":113992,"_2862":114102},[],"Consulta Control de acceso para conocer el modelo de principales y políticas.",{"_3376":68642,"_29549":68598,"_20523":114104,"_5":14087,"_26884":113996,"_2862":114105},[],"Para instalar un checkout local:",{"_3376":68643,"_29549":68598,"_20523":114107,"_5":14087,"_26884":114000,"_2862":114108},[],"El Gateway debe mostrar `PROGRAMMED=True`. Si está programado pero no tiene una dirección utilizable, continúa con Expón el Gateway.",{"_3376":68644,"_29549":68598,"_20523":114110,"_5":14087,"_26884":114000,"_2862":114111},[],"El test de Helm comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y verifica la respuesta de la UI.",{"_3376":68645,"_29549":68598,"_20523":114113,"_5":14087,"_26884":114004,"_2862":114114},[],"Los pasos de upgrade específicos de cada versión se mantienen en `charts/lamassu/CHANGELOG/` dentro del repositorio Helm. El chart también incluye un job de pre-upgrade opcional que migra las claves privadas de CA existentes al motor KMS configurado para el release. Está desactivado por defecto (`migrations.caToKms.enabled: false`) y solo es necesario cuando actualizas desde una versión anterior a 3.7.0.",{"_3376":68646,"_29549":68598,"_20523":114116,"_5":14087,"_26884":114004,"_2862":114117},[],"Mientras el flag esté activo, cada `helm upgrade` crea el job `<chart fullname>-ca-to-kms-migration` (`lamassu-ca-to-kms-migration` para el release `lamassu`); una instalación nueva no lo crea. Su hook weight es `-10`, por lo que se ejecuta antes de los otros hooks de pre-upgrade: la configuración de bootstrap de autorización (peso `-4`) y el job de migración de base de datos (peso `-3`).",{"_3376":68647,"_29549":68598,"_20523":114119,"_5":14087,"_26884":114004,"_2862":114120},[],"El job consume la misma configuración del servicio KMS que el chart renderiza en el ConfigMap de KMS, incluidos los motores de `services.kms.cryptoEngines`, y ejecuta la imagen de la herramienta de migración definida en `migrations.caToKms.image`. La monta en modo read-only en `/etc/lamassuiot/config.yml` desde la clave `config` del ConfigMap, así que configura el motor de destino en tus valores antes del upgrade que realiza la migración.",{"_3376":68648,"_29549":68598,"_20523":114122,"_5":14087,"_26884":114004,"_2862":114123},[],"El job resuelve su configuración mediante un volumen proyectado con dos fuentes opcionales: el ConfigMap `<chart fullname>-kms-config`, cuyo nombre incorpora el release (`lamassu-kms-config` para el release `lamassu`, `prod-lamassu-kms-config` para el release `prod`), y el ConfigMap legacy `kms-config`, sin el nombre del release, creado por versiones anteriores del chart. La configuración legacy mantiene la autoridad mientras siga presente y el job usa el ConfigMap del release una vez el legacy desaparece. Ambas fuentes son opcionales, por lo que un ConfigMap ausente nunca deja el pod del upgrade en `ContainerCreating`.",{"_3376":68649,"_29549":68598,"_20523":114125,"_5":14087,"_26884":114004,"_2862":114126},[],"Mantén `migrations.caToKms.enabled: true` en el upgrade que realiza la migración y elimina después el flag de tus valores una vez completada la migración; su valor por defecto es `false`.",{"_3376":68650,"_29549":68598,"_20523":114128,"_5":14087,"_26884":114008,"_2862":114129},[],"Antes de pasar a producción, revisa:",{"_3376":68651,"_29549":68598,"_20523":114131,"_5":14087,"_26884":114008,"_2862":114132},[],"backup y recuperación de PostgreSQL y volúmenes persistentes",{"_3376":68652,"_29549":68598,"_20523":114134,"_5":14087,"_26884":114008,"_2862":114135},[],"un motor KMS de producción; el motor filesystem predeterminado no ofrece alta disponibilidad",{"_3376":68653,"_29549":68598,"_20523":114137,"_5":14087,"_26884":114008,"_2862":114138},[],"almacenamiento compartido para VA antes de aumentar sus réplicas",{"_3376":68654,"_29549":68598,"_20523":114140,"_5":14087,"_26884":114008,"_2862":114141},[],"roles OIDC gestionados y eliminación de credenciales de evaluación",{"_3376":68655,"_29549":68598,"_20523":114143,"_5":14087,"_26884":114008,"_2862":114144},[],"un emisor TLS de confianza o un certificado gestionado externamente",{"_3376":68656,"_29549":68598,"_20523":114146,"_5":14087,"_26884":114008,"_2862":114147},[],"recursos, réplicas, autoscaling, disruption budgets y placement",{"_3376":68657,"_29549":68598,"_20523":114149,"_5":14087,"_26884":114008,"_2862":114150},[],"SMTP, observabilidad y entrega de alertas",{"_3376":68658,"_29549":68598,"_20523":114152,"_5":14087,"_26884":114008,"_2862":114153},[],"las guías de actualización entre versiones y las notas de migración de `charts/lamassu/CHANGELOG/` antes de cada upgrade, incluido el hook opcional de migración CA-to-KMS descrito arriba",{"_3376":68659,"_29549":68598,"_20523":114155,"_5":14087,"_26884":114008,"_2862":114156},[],"La referencia completa de valores se mantiene en `charts/lamassu/VALUES.md` dentro del repositorio Helm.",{"_3376":68660,"_29549":68660,"_5":14445,"_2862":114158,"_29881":114159,"_20523":114160,"_26884":68660},"Expón el Gateway",[48111,113387,113621],[],{"_3376":68661,"_29549":68660,"_20523":114162,"_5":14087,"_26884":68660,"_2862":114163},[],"Elige cómo llegan los clientes a Lamassu, cuándo definir gateway.addresses y cómo diseñar varios Gateways.",{"_3376":68662,"_29549":68660,"_5":29878,"_20523":114165,"_26884":114166,"_2862":114167},[],"/docs/es/deployment/self-hosted/networking#expón-el-gateway-de-lamassu","Expón el Gateway de Lamassu",{"_3376":68663,"_29549":68660,"_5":29878,"_20523":114169,"_26884":114170,"_2862":114171},[],"/docs/es/deployment/self-hosted/networking#necesitas-gatewayaddresses","¿Necesitas `gateway.addresses`?",{"_3376":68664,"_29549":68660,"_5":29878,"_20523":114173,"_26884":114174,"_2862":114175},[],"/docs/es/deployment/self-hosted/networking#diseño-recomendado-para-un-solo-nodo","Diseño recomendado para un solo nodo",{"_3376":68665,"_29549":68660,"_5":29878,"_20523":114177,"_26884":114178,"_2862":48937},[],"/docs/es/deployment/self-hosted/networking#k3s",{"_3376":68666,"_29549":68660,"_5":29878,"_20523":114180,"_26884":114181,"_2862":114182},[],"/docs/es/deployment/self-hosted/networking#bare-metal-con-metallb-o-kube-vip","Bare metal con MetalLB o kube-vip",{"_3376":68667,"_29549":68660,"_5":29878,"_20523":114184,"_26884":114185,"_2862":114186},[],"/docs/es/deployment/self-hosted/networking#proxy-externo-nat-o-vpn","Proxy externo, NAT o VPN",{"_3376":68668,"_29549":68660,"_5":29878,"_20523":114188,"_26884":114189,"_2862":114190},[],"/docs/es/deployment/self-hosted/networking#qué-ocurre-si-necesitas-tres-gateways","¿Qué ocurre si necesitas tres Gateways?",{"_3376":68669,"_29549":68660,"_5":29878,"_20523":114192,"_26884":114193,"_2862":114194},[],"/docs/es/deployment/self-hosted/networking#guía-de-decisión","Guía de decisión",{"_3376":68670,"_29549":68660,"_5":29878,"_20523":114196,"_26884":114197,"_2862":114198},[],"/docs/es/deployment/self-hosted/networking#proxy-de-salida","Proxy de salida",{"_3376":68671,"_29549":68660,"_5":29878,"_20523":114200,"_26884":114201,"_2862":114202},[],"/docs/es/deployment/self-hosted/networking#verifica-la-ruta-de-tráfico","Verifica la ruta de tráfico",{"_3376":68672,"_29549":68660,"_20523":114204,"_5":14087,"_26884":114166,"_2862":114205},[],"El chart de Lamassu crea un Gateway compartido con listeners HTTP y HTTPS. Envoy Gateway crea normalmente un deployment de proxy dedicado y un Service `LoadBalancer`.",{"_3376":68673,"_29549":68660,"_20523":114207,"_5":14087,"_26884":114166,"_2862":114208},[],"La accesibilidad externa depende de toda la ruta. Un recurso `Gateway` no configura por sí mismo el router, firewall, DNS, balanceador cloud ni NAT upstream.",{"_3376":68674,"_29549":68660,"_20523":114210,"_5":14087,"_26884":114170,"_2862":114211},[],"Normalmente no. Si lo omites, el controlador del Gateway y la implementación del balanceador pueden asignar una dirección y publicarla en `Gateway.status.addresses` y en el estado del Service generado.",{"_3376":68675,"_29549":68660,"_20523":114213,"_5":14087,"_26884":114170,"_2862":114214},[],"Defínelo únicamente cuando:",{"_3376":68676,"_29549":68660,"_20523":114216,"_5":14087,"_26884":114170,"_2862":114217},[],"tu balanceador cloud o bare metal permite solicitar una dirección concreta",{"_3376":68677,"_29549":68660,"_20523":114219,"_5":14087,"_26884":114170,"_2862":114220},[],"esa dirección está asignada a este Gateway",{"_3376":68678,"_29549":68660,"_20523":114222,"_5":14087,"_26884":114170,"_2862":114223},[],"la red ya enruta el tráfico de esa dirección hasta el clúster",{"_3376":68679,"_29549":68660,"_20523":114225,"_5":14087,"_26884":114170,"_2862":114226},[],"Esto solicita `192.168.1.50`; no reclama la IP en tu LAN ni la vuelve accesible.",{"_3376":68680,"_29549":68660,"_20523":114228,"_5":14087,"_26884":114170,"_2862":114229},[],"No confundas estos valores:",{"_3376":68681,"_29549":68660,"_20523":114231,"_5":14087,"_26884":114170,"_2862":114232},[],"`gateway.addresses` solicita una dirección para el Gateway.",{"_3376":68682,"_29549":68660,"_20523":114234,"_5":14087,"_26884":114170,"_2862":114235},[],"`tls.certManagerOptions.certSpec.addresses` añade direcciones IP a los SAN del certificado TLS.",{"_3376":68683,"_29549":68660,"_20523":114237,"_5":14087,"_26884":114170,"_2862":114238},[],"Si los usuarios se conectan por DNS, añade el nombre a `tls.certManagerOptions.certSpec.hostnames`. No copies la IP pública de un proxy upstream en `gateway.addresses`.",{"_3376":68684,"_29549":68660,"_20523":114240,"_5":14087,"_26884":114174,"_2862":114241},[],"Para una VM pequeña con K3s o MicroK8s, usa un único Gateway externo de Lamassu y enruta todos los endpoints a través de él:",{"_3376":68685,"_29549":68660,"_20523":114243,"_5":14087,"_26884":114174,"_2862":114244},[],"Este diseño utiliza una IP, un punto de entrada TLS y un único par de puertos. El chart ya crea las rutas necesarias.",{"_3376":68686,"_29549":68660,"_20523":114246,"_5":14087,"_26884":114178,"_2862":114247},[],"K3s ServiceLB implementa cada Service `LoadBalancer` mediante pods que reservan los puertos del Service en el nodo. En un único nodo, solo un Service puede ocupar el puerto 80 y otro el 443. El Service Traefik que K3s instala por defecto puede estar ocupando ambos.",{"_3376":68687,"_29549":68660,"_20523":114249,"_5":14087,"_26884":114178,"_2862":114250},[],"Para el diseño recomendado:",{"_3376":68688,"_29549":68660,"_20523":114252,"_5":14087,"_26884":114178,"_2862":114253},[],"Usa un único Gateway de Lamassu expuesto externamente.",{"_3376":68689,"_29549":68660,"_20523":114255,"_5":14087,"_26884":114178,"_2862":114256},[],"Comprueba que los puertos 80 y 443 están libres. Deshabilita o reconfigura Traefik si no forma parte de la ruta de tráfico.",{"_3376":68690,"_29549":68660,"_20523":114258,"_5":14087,"_26884":114178,"_2862":114259},[],"Permite esos puertos en el firewall de la VM y en cualquier security group upstream.",{"_3376":68691,"_29549":68660,"_20523":114261,"_5":14087,"_26884":114178,"_2862":114262},[],"Apunta DNS a la dirección accesible de la VM.",{"_3376":68692,"_29549":68660,"_20523":114264,"_5":14087,"_26884":114178,"_2862":114265},[],"Consulta la documentación de K3s ServiceLB para conocer el uso de host ports y cómo sustituirlo por otro balanceador.",{"_3376":68693,"_29549":68660,"_20523":114267,"_5":14087,"_26884":114181,"_2862":114268},[],"Asigna una VIP de un pool accesible desde la LAN. Puedes solicitarla con `gateway.addresses` si la implementación lo permite. Confirma la dirección asignada en el estado en lugar de asumir que la solicitud tuvo éxito.",{"_3376":68694,"_29549":68660,"_20523":114270,"_5":14087,"_26884":114185,"_2862":114271},[],"Una dirección pública externa puede reenviar TCP 80 y 443 a la VM o a una VIP de Kubernetes:",{"_3376":68695,"_29549":68660,"_20523":114273,"_5":14087,"_26884":114185,"_2862":114274},[],"La IP pública pertenece al dispositivo externo. Deja `gateway.addresses` sin definir o usa la dirección real del lado de Kubernetes, nunca una IP que el clúster no pueda asociar.",{"_3376":68696,"_29549":68660,"_20523":114276,"_5":14087,"_26884":114189,"_2862":114277},[],"Primero decide si necesitas tres data planes independientes o solo tres nombres de host.",{"_3376":68697,"_29549":68660,"_20523":114279,"_5":14087,"_26884":114189,"_2862":114280},[],"Requisito",{"_3376":68698,"_29549":68660,"_20523":114282,"_5":14087,"_26884":114189,"_2862":114283},[],"Diseño recomendado",{"_3376":68699,"_29549":68660,"_20523":114285,"_5":14087,"_26884":114189,"_2862":114286},[],"Consecuencia",{"_3376":68700,"_29549":68660,"_20523":114288,"_5":14087,"_26884":114189,"_2862":114289},[],"Varias URL o servicios de Lamassu",{"_3376":68701,"_29549":68660,"_20523":114291,"_5":14087,"_26884":114189,"_2862":114292},[],"Un Gateway con varias rutas",{"_3376":68702,"_29549":68660,"_20523":114294,"_5":14087,"_26884":114189,"_2862":114295},[],"Una IP y un proxy fleet; es el comportamiento predeterminado del chart",{"_3376":68703,"_29549":68660,"_20523":114297,"_5":14087,"_26884":114189,"_2862":114298},[],"Gateways independientes e IP externas distintas",{"_3376":68704,"_29549":68660,"_20523":114300,"_5":14087,"_26884":114189,"_2862":114301},[],"Una VIP por Gateway",{"_3376":68705,"_29549":68660,"_20523":114303,"_5":14087,"_26884":114189,"_2862":114304},[],"Todos pueden usar 80/443; requiere un balanceador con un pool de direcciones",{"_3376":68706,"_29549":68660,"_20523":114306,"_5":14087,"_26884":114189,"_2862":114307},[],"Gateways independientes, un nodo y una IP",{"_3376":68707,"_29549":68660,"_20523":114309,"_5":14087,"_26884":114189,"_2862":114310},[],"Puertos externos diferentes",{"_3376":68708,"_29549":68660,"_20523":114312,"_5":14087,"_26884":114189,"_2862":114313},[],"Los clientes deben indicar puertos no estándar",{"_3376":68709,"_29549":68660,"_20523":114315,"_5":14087,"_26884":114189,"_2862":114316},[],"Terminación TLS/mTLS separada detrás de una IP",{"_3376":68710,"_29549":68660,"_20523":114318,"_5":14087,"_26884":114189,"_2862":114319},[],"Front door con enrutamiento SNI hacia Gateways internos",{"_3376":68711,"_29549":68660,"_20523":114321,"_5":14087,"_26884":114189,"_2862":114322},[],"Diseño avanzado; el front door usa TLS passthrough y cada Gateway termina su propio TLS",{"_3376":68712,"_29549":68660,"_20523":114324,"_5":14087,"_26884":114189,"_2862":114325},[],"Recursos Gateway separados pero proxy compartido",{"_3376":68713,"_29549":68660,"_20523":114327,"_5":14087,"_26884":114189,"_2862":114328},[],"Modo merged Gateway de Envoy",{"_3376":68714,"_29549":68660,"_20523":114330,"_5":14087,"_26884":114189,"_2862":114331},[],"Solo separación lógica; cada listener necesita una tupla única de puerto, protocolo y hostname",{"_3376":68715,"_29549":68660,"_20523":114333,"_5":14087,"_26884":114189,"_2862":114334},[],"Tres Services `LoadBalancer` independientes no pueden reservar a la vez los mismos puertos 80 y 443 mediante K3s ServiceLB. Usa un Gateway compartido, asigna VIP distintas con otro balanceador o utiliza puertos diferentes.",{"_3376":68716,"_29549":68660,"_20523":114336,"_5":14087,"_26884":114189,"_2862":114337},[],"Envoy Gateway provisiona normalmente un proxy fleet por `Gateway`. Su modo merged Gateway puede compartir un fleet y una dirección, pero no es un cambio directo para varias releases de Lamassu: los listeners generados usan los mismos puertos y protocolos sin hostnames distintos, por lo que entran en conflicto salvo que personalices el diseño.",{"_3376":68717,"_29549":68660,"_20523":114339,"_5":14087,"_26884":114189,"_2862":114340},[],"Usa un front door con SNI solo cuando los Gateways internos deban mantener políticas TLS o mTLS independientes:",{"_3376":68718,"_29549":68660,"_20523":114342,"_5":14087,"_26884":114189,"_2862":114343},[],"Esto requiere hostnames SNI distintos y configuración de red externa al chart de Lamassu.",{"_3376":68719,"_29549":68660,"_20523":114345,"_5":14087,"_26884":114193,"_2862":114346},[],"Si un Gateway puede gestionar TLS y el enrutamiento, usa el valor predeterminado del chart.",{"_3376":68720,"_29549":68660,"_20523":114348,"_5":14087,"_26884":114193,"_2862":114349},[],"Si los Gateways necesitan políticas independientes y puedes asignar IP, usa una VIP por Gateway.",{"_3376":68721,"_29549":68660,"_20523":114351,"_5":14087,"_26884":114193,"_2862":114352},[],"Si solo necesitas separar los recursos Kubernetes, evalúa merged Gateway y usa tuplas de listener únicas.",{"_3376":68722,"_29549":68660,"_20523":114354,"_5":14087,"_26884":114193,"_2862":114355},[],"Si los data planes y la terminación TLS deben ser independientes detrás de una IP, añade un front door con TLS passthrough y SNI.",{"_3376":68723,"_29549":68660,"_20523":114357,"_5":14087,"_26884":114193,"_2862":114358},[],"Si nada de lo anterior es posible, usa puertos externos distintos o cambia el diseño de red.",{"_3376":68724,"_29549":68660,"_20523":114360,"_5":14087,"_26884":114197,"_2862":114361},[],"Los clientes internos de Lamassu — la conexión con el motor de Vault, las llamadas entre servicios y los webhooks salientes — respetan las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY`. La excepción es el conector del motor de autorización: usa su propio transporte y no consulta estas variables de proxy. Si tu despliegue enruta el tráfico de salida por un proxy, incluye los nombres de servicio internos del clúster en `NO_PROXY` (por ejemplo `.svc,.cluster.local`) para que el tráfico interno permanezca dentro del clúster. El tráfico de loopback nunca se envía por un proxy.",{"_3376":68725,"_29549":68660,"_20523":114363,"_5":14087,"_26884":114197,"_2862":114364},[],"El transporte predeterminado de estos clientes acota el timeout de conexión (30 segundos), el handshake TLS (10 segundos) y la reutilización de conexiones inactivas (90 segundos), de modo que una dependencia inalcanzable falla rápido en lugar de bloquearse; estos valores son los predeterminados del transporte de Go, no configuración de Lamassu. HTTP/2 se negocia cuando el otro extremo lo soporta. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada.",{"_3376":68726,"_29549":68660,"_20523":114366,"_5":14087,"_26884":114201,"_2862":114367},[],"Comprueba, en orden:",{"_3376":68727,"_29549":68660,"_20523":114369,"_5":14087,"_26884":114201,"_2862":114370},[],"El `Gateway` muestra `Accepted=True` y `Programmed=True`.",{"_3376":68728,"_29549":68660,"_20523":114372,"_5":14087,"_26884":114201,"_2862":114373},[],"Su estado contiene la dirección esperada.",{"_3376":68729,"_29549":68660,"_20523":114375,"_5":14087,"_26884":114201,"_2862":114376},[],"El Service `LoadBalancer` generado tiene una dirección externa utilizable.",{"_3376":68730,"_29549":68660,"_20523":114378,"_5":14087,"_26884":114201,"_2862":114379},[],"El puerto 443 de esa dirección es accesible desde la red del cliente.",{"_3376":68731,"_29549":68660,"_20523":114381,"_5":14087,"_26884":114201,"_2862":114382},[],"DNS resuelve al endpoint accesible externamente.",{"_3376":68732,"_29549":68660,"_20523":114384,"_5":14087,"_26884":114201,"_2862":114385},[],"El certificado contiene el nombre DNS o la IP usada por el cliente.",{"_3376":68733,"_29549":68660,"_20523":114387,"_5":14087,"_26884":114201,"_2862":114388},[],"Gateway API trata las direcciones como estado deseado que el controlador puede asignar o rechazar; consulta la introducción a Gateway API para conocer el modelo.",{"_3376":68734,"_29549":68734,"_5":14445,"_2862":48218,"_29881":114390,"_20523":114391,"_26884":68734},[48111,113387,113621],[],{"_3376":68735,"_29549":68734,"_20523":114393,"_5":14087,"_26884":68734,"_2862":114394},[],"Elige un flujo de instalación y una arquitectura de red para Lamassu en tu clúster Kubernetes.",{"_3376":68736,"_29549":68734,"_5":29878,"_20523":114396,"_26884":114397,"_2862":114398},[],"/docs/es/deployment/self-hosted/overview#despliegue-self-managed-con-kubernetes","Despliegue self-managed con Kubernetes",{"_3376":68737,"_29549":68734,"_5":29878,"_20523":114400,"_26884":114401,"_2862":114402},[],"/docs/es/deployment/self-hosted/overview#elige-un-flujo-de-instalación","Elige un flujo de instalación",{"_3376":68738,"_29549":68734,"_5":29878,"_20523":114404,"_26884":114405,"_2862":114406},[],"/docs/es/deployment/self-hosted/overview#qué-proporciona-el-chart-de-lamassu","Qué proporciona el chart de Lamassu",{"_3376":68739,"_29549":68734,"_5":29878,"_20523":114408,"_26884":114409,"_2862":114410},[],"/docs/es/deployment/self-hosted/overview#cómo-encaja-el-despliegue","Cómo encaja el despliegue",{"_3376":68740,"_29549":68734,"_5":29878,"_20523":114412,"_26884":114413,"_2862":114414},[],"/docs/es/deployment/self-hosted/overview#requisitos-de-plataforma","Requisitos de plataforma",{"_3376":68741,"_29549":68734,"_5":29878,"_20523":114416,"_26884":114417,"_2862":114418},[],"/docs/es/deployment/self-hosted/overview#elige-la-siguiente-página","Elige la siguiente página",{"_3376":68742,"_29549":68734,"_20523":114420,"_5":14087,"_26884":114397,"_2862":114421},[],"Ejecuta Lamassu en un clúster Kubernetes operado por tu equipo. El chart Helm despliega los servicios de Lamassu y sus recursos de enrutamiento; tú proporcionas el clúster, el almacenamiento persistente, el proveedor de identidad, PostgreSQL, RabbitMQ y la ruta de red utilizada por los clientes.",{"_3376":68743,"_29549":68734,"_20523":114423,"_5":14087,"_26884":114401,"_2862":114424},[],"Flujo",{"_3376":68744,"_29549":68734,"_20523":114426,"_5":14087,"_26884":114401,"_2862":114427},[],"Úsalo para",{"_3376":68745,"_29549":68734,"_20523":114429,"_5":14087,"_26884":114401,"_2862":114430},[],"Qué instala",{"_3376":68746,"_29549":68734,"_20523":114432,"_5":14087,"_26884":114401,"_2862":49192},[],{"_3376":68747,"_29549":68734,"_20523":114434,"_5":14087,"_26884":114401,"_2862":114435},[],"Producción y entornos controlados",{"_3376":68748,"_29549":68734,"_20523":114437,"_5":14087,"_26884":114401,"_2862":114438},[],"Servicios de Lamassu y recursos de Gateway API",{"_3376":68749,"_29549":68734,"_20523":114440,"_5":14087,"_26884":114401,"_2862":48355},[],{"_3376":68750,"_29549":68734,"_20523":114442,"_5":14087,"_26884":114401,"_2862":114443},[],"Evaluación, demos, CI y pequeños clústeres de laboratorio",{"_3376":68751,"_29549":68734,"_20523":114445,"_5":14087,"_26884":114401,"_2862":114446},[],"PostgreSQL, Keycloak, RabbitMQ, Envoy Gateway y Lamassu",{"_3376":68752,"_29549":68734,"_20523":114448,"_5":14087,"_26884":114405,"_2862":114449},[],"El chart de Lamassu es un **chart de aplicación**, no un chart de bootstrap del clúster. Crea los recursos Kubernetes que ejecutan y configuran Lamassu, pero espera que ya existan los servicios de plataforma de los que dependen.",{"_3376":68753,"_29549":68734,"_20523":114451,"_5":14087,"_26884":114405,"_2862":114452},[],"Área",{"_3376":68754,"_29549":68734,"_20523":114454,"_5":14087,"_26884":114405,"_2862":114455},[],"El chart de Lamassu proporciona",{"_3376":68755,"_29549":68734,"_20523":114457,"_5":14087,"_26884":114405,"_2862":114458},[],"Tú proporcionas",{"_3376":68756,"_29549":68734,"_20523":114460,"_5":14087,"_26884":114405,"_2862":114461},[],"Aplicaciones Lamassu",{"_3376":68757,"_29549":68734,"_20523":114463,"_5":14087,"_26884":114405,"_2862":114464},[],"Deployments y StatefulSets para la UI y las APIs, Services internos, ConfigMaps, una ServiceAccount y HPA/PDB opcionales",{"_3376":68758,"_29549":68734,"_20523":114466,"_5":14087,"_26884":114405,"_2862":114467},[],"Un clúster Kubernetes operativo, capacidad de cómputo y acceso a las imágenes",{"_3376":68759,"_29549":68734,"_20523":114469,"_5":14087,"_26884":114405,"_2862":114470},[],"Datos PostgreSQL",{"_3376":68760,"_29549":68734,"_20523":114472,"_5":14087,"_26884":114405,"_2862":114473},[],"Un job de pre-install/pre-upgrade que crea las bases de datos y schemas necesarios, ejecuta migraciones y aplica el bootstrap de autorización",{"_3376":68761,"_29549":68734,"_20523":114475,"_5":14087,"_26884":114405,"_2862":114476},[],"Un servidor PostgreSQL accesible, credenciales autorizadas para crear bases de datos y schemas, y operaciones de backup/HA",{"_3376":68762,"_29549":68734,"_20523":114478,"_5":14087,"_26884":114405,"_2862":114479},[],"Mensajería",{"_3376":68763,"_29549":68734,"_20523":114481,"_5":14087,"_26884":114405,"_2862":114482},[],"Configuración de conexión a RabbitMQ para los servicios Lamassu; la conexión puede usar AMQPS, con una CA privada y un certificado de cliente opcionales, definidos mediante valores del chart",{"_3376":68764,"_29549":68734,"_20523":114484,"_5":14087,"_26884":114405,"_2862":114485},[],"Un broker RabbitMQ accesible, credenciales y la gestión de su ciclo de vida",{"_3376":68765,"_29549":68734,"_20523":114487,"_5":14087,"_26884":114405,"_2862":114488},[],"Identidad",{"_3376":68766,"_29549":68734,"_20523":114490,"_5":14087,"_26884":114405,"_2862":114491},[],"Configuración OIDC/JWT y de autorización externa, además de los principales iniciales de Lamassu",{"_3376":68767,"_29549":68734,"_20523":114493,"_5":14087,"_26884":114405,"_2862":114494},[],"Un proveedor OIDC, realm/tenant, cliente, usuarios, grupos y roles",{"_3376":68768,"_29549":68734,"_20523":114496,"_5":14087,"_26884":114405,"_2862":114497},[],"Enrutamiento externo",{"_3376":68769,"_29549":68734,"_20523":114499,"_5":14087,"_26884":114405,"_2862":114500},[],"Un `Gateway`, recursos `HTTPRoute`, una configuración `EnvoyProxy` y políticas de seguridad de Envoy",{"_3376":68770,"_29549":68734,"_20523":114502,"_5":14087,"_26884":114405,"_2862":114503},[],"Las CRD de Gateway API y Envoy, el controlador Envoy Gateway, una `GatewayClass`, un balanceador y la ruta de red externa",{"_3376":68771,"_29549":68734,"_20523":114505,"_5":14087,"_26884":114405,"_2862":49266},[],{"_3376":68772,"_29549":68734,"_20523":114507,"_5":14087,"_26884":114405,"_2862":114508},[],"En el modo predeterminado `tls.type: certManager`, recursos `Issuer` y `Certificate` CA de cert-manager y un `Certificate` downstream gestionado por el chart; en el modo `tls.type: external`, una referencia a tu Secret TLS",{"_3376":68773,"_29549":68734,"_20523":114510,"_5":14087,"_26884":114405,"_2862":114511},[],"cert-manager solo para el modo predeterminado `tls.type: certManager`; para TLS de confianza, un emisor de confianza o un Secret TLS ya poblado",{"_3376":68774,"_29549":68734,"_20523":114513,"_5":14087,"_26884":114405,"_2862":114514},[],"Datos persistentes de la aplicación",{"_3376":68775,"_29549":68734,"_20523":114516,"_5":14087,"_26884":114405,"_2862":114517},[],"PersistentVolumeClaims necesarios para el almacenamiento local predeterminado de KMS y VA",{"_3376":68776,"_29549":68734,"_20523":114519,"_5":14087,"_26884":114405,"_2862":114520},[],"Una StorageClass, almacenamiento físico, backups y un backend compartido/externo cuando el escalado lo requiera",{"_3376":68777,"_29549":68734,"_20523":114522,"_5":14087,"_26884":114405,"_2862":114523},[],"Integraciones opcionales",{"_3376":68778,"_29549":68734,"_20523":114525,"_5":14087,"_26884":114405,"_2862":114526},[],"Puntos de configuración para observabilidad, conectores AWS y conectividad PKCS#11/HSM",{"_3376":68779,"_29549":68734,"_20523":114528,"_5":14087,"_26884":114405,"_2862":114529},[],"Los backends de observabilidad, credenciales cloud y un HSM de producción o servicio externo de claves",{"_3376":68780,"_29549":68734,"_20523":114531,"_5":14087,"_26884":114405,"_2862":114532},[],"El chart crea el `Gateway` y las rutas de Lamassu. No instala el controlador Envoy Gateway ni hace que el Service `LoadBalancer` generado sea accesible desde tu red.",{"_3376":68781,"_29549":68734,"_20523":114534,"_5":14087,"_26884":114405,"_2862":114535},[],"Usa un único Gateway de Lamassu en los puertos 80 y 443 y deja que sus HTTPRoutes distribuyan el tráfico a todos los servicios. Proporciona a ese Gateway un único endpoint accesible mediante el balanceador del clúster, o reenvía tráfico desde un proxy externo o un dispositivo NAT. No necesitas un Gateway por servicio.",{"_3376":68782,"_29549":68734,"_20523":114537,"_5":14087,"_26884":114409,"_2862":114538},[],"El chart crea un `Gateway` compartido por cada release de Helm. Todos los recursos `HTTPRoute` gestionados por el chart se conectan a él. Envoy Gateway provisiona el data plane del proxy y un Service `LoadBalancer` de Kubernetes para ese Gateway.",{"_3376":68783,"_29549":68734,"_20523":114540,"_5":14087,"_26884":114409,"_2862":114541},[],"El valor `gateway.addresses` solo solicita una dirección al controlador del Gateway. No hace que una IP sea enrutable, abre un firewall, configura DNS ni crea NAT. Consulta Expón el Gateway antes de definirlo.",{"_3376":68784,"_29549":68734,"_20523":114543,"_5":14087,"_26884":114413,"_2862":114544},[],"Kubernetes 1.24 o posterior",{"_3376":68785,"_29549":68734,"_20523":114546,"_5":14087,"_26884":114413,"_2862":114547},[],"Helm 3.2 o posterior",{"_3376":68786,"_29549":68734,"_20523":114549,"_5":14087,"_26884":114413,"_2862":114550},[],"Envoy Gateway 1.8 o posterior y una `GatewayClass`",{"_3376":68787,"_29549":68734,"_20523":114552,"_5":14087,"_26884":114413,"_2862":114553},[],"cert-manager 1.14 o posterior; necesario solo para el modo TLS predeterminado `tls.type: certManager`, no para `tls.type: external`",{"_3376":68788,"_29549":68734,"_20523":114555,"_5":14087,"_26884":114413,"_2862":114556},[],"almacenamiento persistente adecuado para la configuración elegida de PostgreSQL, RabbitMQ, VA y KMS",{"_3376":68789,"_29549":68734,"_20523":114558,"_5":14087,"_26884":114413,"_2862":114559},[],"una implementación de balanceador o alguna otra ruta deliberada desde los clientes hasta el Gateway",{"_3376":68790,"_29549":68734,"_20523":114561,"_5":14087,"_26884":114413,"_2862":114562},[],"Los despliegues KMS que usan el sidecar PKCS#11 nativo requieren Kubernetes 1.29 o posterior. Las imágenes de contenedor precompiladas de Lamassu se publican para `linux/amd64` y `linux/arm64`, y el módulo cliente PKCS#11 del KMS (`p11-kit-client.so`) se instala en la ruta de biblioteca Debian de la arquitectura destino: `/usr/lib/x86_64-linux-gnu/pkcs11/p11-kit-client.so` en amd64 y `/usr/lib/aarch64-linux-gnu/pkcs11/p11-kit-client.so` en arm64. La ruta x86\\_64 se conserva como alias de compatibilidad para configuraciones existentes.",{"_3376":68791,"_29549":68734,"_20523":114564,"_5":14087,"_26884":114417,"_2862":114565},[],"<Card title=\"Instala con Helm\" description=\"Prepara dependencias, configura valores, instala y verifica un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3376":68792,"_29549":68734,"_20523":114567,"_5":14087,"_26884":114417,"_2862":114568},[],"<Card title=\"Actualiza desde 3.8.0\" description=\"Actualiza una release de Helm existente a 4.0.0: cambios de arquitectura, breaking changes, pasos de migración y validación.\" href=\"/docs/upgrades/3-8-0-to-4-0-0\" />",{"_3376":68793,"_29549":68734,"_20523":114570,"_5":14087,"_26884":114417,"_2862":114571},[],"<Card title=\"Expón el Gateway\" description=\"Elige un diseño de tráfico externo, comprende gateway.addresses y gestiona varios Gateways.\" href=\"/docs/deployment/self-hosted/networking\" />",{"_3376":68794,"_29549":68734,"_20523":114573,"_5":14087,"_26884":114417,"_2862":114574},[],"<Card title=\"Usa Fastlane\" description=\"Arranca un entorno completo de evaluación o laboratorio con un script.\" href=\"/docs/deployment/self-hosted/fastlane\" />",{"_3376":68795,"_29549":68795,"_5":14445,"_2862":114576,"_29881":114577,"_20523":114579,"_26884":68795},"Resolución de problemas de despliegue",[48111,113387,114578],"Operación",[],{"_3376":68796,"_29549":68795,"_20523":114581,"_5":14087,"_26884":68795,"_2862":114582},[],"Diagnostica acceso, salud de los servicios y dependencias de infraestructura.",{"_3376":68797,"_29549":68795,"_5":29878,"_20523":114584,"_26884":114585,"_2862":114586},[],"/docs/es/deployment/troubleshooting#secuencia-de-diagnóstico","Secuencia de diagnóstico",{"_3376":68798,"_29549":68795,"_5":29878,"_20523":114588,"_26884":114589,"_2862":114590},[],"/docs/es/deployment/troubleshooting#reproduce-una-sola-operación","Reproduce una sola operación",{"_3376":68799,"_29549":68795,"_5":29878,"_20523":114592,"_26884":114593,"_2862":114594},[],"/docs/es/deployment/troubleshooting#separa-cliente-gateway-y-servicio","Separa cliente, Gateway y servicio",{"_3376":68800,"_29549":68795,"_5":29878,"_20523":114596,"_26884":114597,"_2862":114598},[],"/docs/es/deployment/troubleshooting#revisa-el-estado-de-kubernetes","Revisa el estado de Kubernetes",{"_3376":68801,"_29549":68795,"_5":29878,"_20523":114600,"_26884":114601,"_2862":114602},[],"/docs/es/deployment/troubleshooting#consulta-el-servicio-afectado","Consulta el servicio afectado",{"_3376":68802,"_29549":68795,"_5":29878,"_20523":114604,"_26884":114605,"_2862":114606},[],"/docs/es/deployment/troubleshooting#valida-el-resultado-desde-fuera","Valida el resultado desde fuera",{"_3376":68803,"_29549":68795,"_5":29878,"_20523":114608,"_26884":114609,"_2862":114610},[],"/docs/es/deployment/troubleshooting#recogida-mínima-de-evidencias","Recogida mínima de evidencias",{"_3376":68804,"_29549":68795,"_5":29878,"_20523":114612,"_26884":114613,"_2862":114614},[],"/docs/es/deployment/troubleshooting#no-puedo-iniciar-sesión","No puedo iniciar sesión",{"_3376":68805,"_29549":68795,"_5":29878,"_20523":114616,"_26884":114617,"_2862":114618},[],"/docs/es/deployment/troubleshooting#todo-devuelve-403-o-5xx","Todo devuelve 403 o 5xx",{"_3376":68806,"_29549":68795,"_5":29878,"_20523":114620,"_26884":114621,"_2862":114622},[],"/docs/es/deployment/troubleshooting#errores-500-de-la-api","Errores 500 de la API",{"_3376":68807,"_29549":68795,"_5":29878,"_20523":114624,"_26884":114625,"_2862":114626},[],"/docs/es/deployment/troubleshooting#un-pod-no-está-ready","Un pod no está Ready",{"_3376":68808,"_29549":68795,"_5":29878,"_20523":114628,"_26884":114629,"_2862":114630},[],"/docs/es/deployment/troubleshooting#los-eventos-no-llegan","Los eventos no llegan",{"_3376":68809,"_29549":68795,"_5":29878,"_20523":114632,"_26884":114633,"_2862":114634},[],"/docs/es/deployment/troubleshooting#observabilidad","Observabilidad",{"_3376":68810,"_29549":68795,"_20523":114636,"_5":14087,"_26884":68795,"_2862":114637},[],"Empieza por localizar la capa que falla. Una respuesta del Gateway y un pod no preparado requieren evidencias distintas. Para emisión rechazada o resultados de validación, consulta el diagnóstico PKI; para enrolamiento, el diagnóstico EST.",{"_3376":68811,"_29549":68795,"_20523":114639,"_5":14087,"_26884":114589,"_2862":114640},[],"Anota hora en UTC, usuario o principal, recurso, endpoint y resultado. Evita repetir una acción destructiva como revocación o eliminación.",{"_3376":68812,"_29549":68795,"_20523":114642,"_5":14087,"_26884":114593,"_2862":114643},[],"Comprueba el código HTTP. Un 401 apunta a autenticación; un 403, a autorización; un 404, a ruta o recurso; un 5xx, al servicio o una dependencia.",{"_3376":68813,"_29549":68795,"_20523":114645,"_5":14087,"_26884":114597,"_2862":114646},[],"Localiza pods no preparados, reinicios, eventos recientes y el estado del release.",{"_3376":68814,"_29549":68795,"_20523":114648,"_5":14087,"_26884":114601,"_2862":114649},[],"Revisa su endpoint /health y sus logs en la misma ventana temporal. Después sigue la dependencia indicada: PostgreSQL, RabbitMQ, proveedor OIDC o motor criptográfico.",{"_3376":68815,"_29549":68795,"_20523":114651,"_5":14087,"_26884":114605,"_2862":114652},[],"Para PKI, comprueba el certificado, la cadena, OCSP o CRL con el mismo tipo de cliente que utiliza producción.",{"_3376":68816,"_29549":68795,"_20523":114654,"_5":14087,"_26884":114609,"_2862":114655},[],"Sustituye los marcadores por tu release, namespace y deployment reales.",{"_3376":68817,"_29549":68795,"_20523":114657,"_5":14087,"_26884":114609,"_2862":114658},[],"Ejecuta también la prueba de conectividad del chart:",{"_3376":68818,"_29549":68795,"_20523":114660,"_5":14087,"_26884":114609,"_2862":114661},[],"El test consulta la salud de CA, DMS Manager, Device Manager y VA, y comprueba que la UI devuelve HTML. Un test correcto confirma conectividad básica, no un flujo completo de emisión.",{"_3376":68819,"_29549":68795,"_20523":114663,"_5":14087,"_26884":114609,"_2862":114664},[],"Los servicios del chart exponen sondas de inicio, disponibilidad y vida sobre /health. Un pod puede estar ejecutándose pero no recibir tráfico si la readiness probe falla.",{"_3376":68820,"_29549":68795,"_20523":114666,"_5":14087,"_26884":114613,"_2862":114667},[],"Si recibes un 401:",{"_3376":68821,"_29549":68795,"_20523":114669,"_5":14087,"_26884":114613,"_2862":114670},[],"comprueba que la autoridad OIDC de la UI sea accesible desde el navegador;",{"_3376":68822,"_29549":68795,"_20523":114672,"_5":14087,"_26884":114613,"_2862":114673},[],"verifica emisor, audiencia y expiración del token;",{"_3376":68823,"_29549":68795,"_20523":114675,"_5":14087,"_26884":114613,"_2862":114676},[],"confirma que el Gateway puede obtener las claves de la URI JWKS;",{"_3376":68824,"_29549":68795,"_20523":114678,"_5":14087,"_26884":114613,"_2862":114679},[],"revisa que la ruta pública e interna del proveedor apunten al mismo realm.",{"_3376":68825,"_29549":68795,"_20523":114681,"_5":14087,"_26884":114613,"_2862":114682},[],"Si el login termina pero las APIs devuelven 403:",{"_3376":68826,"_29549":68795,"_20523":114684,"_5":14087,"_26884":114613,"_2862":114685},[],"inspecciona los claims reales del token;",{"_3376":68827,"_29549":68795,"_20523":114687,"_5":14087,"_26884":114613,"_2862":114688},[],"confirma que coinciden con un principal activo;",{"_3376":68828,"_29549":68795,"_20523":114690,"_5":14087,"_26884":114613,"_2862":114691},[],"revisa las políticas concedidas al principal;",{"_3376":68829,"_29549":68795,"_20523":114693,"_5":14087,"_26884":114613,"_2862":114694},[],"verifica que authz alcanza PostgreSQL y su JWKS.",{"_3376":68830,"_29549":68795,"_20523":114696,"_5":14087,"_26884":114613,"_2862":114697},[],"En una instalación nueva, confirma que el Job de migración terminó. Ese Job crea esquemas, migra authz, precarga políticas y provisiona los principales definidos en services.authz.bootstrap.",{"_3376":68831,"_29549":68795,"_20523":114699,"_5":14087,"_26884":114617,"_2862":114700},[],"La autorización externa falla cerrada por defecto. Si authz no está disponible, las rutas protegidas se bloquean.",{"_3376":68832,"_29549":68795,"_20523":114702,"_5":14087,"_26884":114617,"_2862":114703},[],"Localiza el pod y Service de authz.",{"_3376":68833,"_29549":68795,"_20523":114705,"_5":14087,"_26884":114617,"_2862":114706},[],"Comprueba /health, logs y conexión a su base de datos.",{"_3376":68834,"_29549":68795,"_20523":114708,"_5":14087,"_26884":114617,"_2862":114709},[],"Verifica el DNS y puerto configurados en externalAuthorization.",{"_3376":68835,"_29549":68795,"_20523":114711,"_5":14087,"_26884":114617,"_2862":114712},[],"Comprueba que la ruta del check es /v1/ext\\_authz/check.",{"_3376":68836,"_29549":68795,"_20523":114714,"_5":14087,"_26884":114617,"_2862":114715},[],"No cambies a failOpen: true como solución permanente: permitiría tráfico sin autorización durante la caída.",{"_3376":68837,"_29549":68795,"_20523":114717,"_5":14087,"_26884":114621,"_2862":114718},[],"Un 500 indica un fallo interno, como una base de datos no disponible. El cuerpo `{\"err\": ...}` incluye hoy el texto del error interno, que puede contener nombres de esquema, tabla y restricción y, en fallos de conexión, el host y el usuario de la base de datos (no la contraseña). Localiza la causa en el log del servicio con la hora de la petición, y no reenvíes el cuerpo a terceros ni lo muestres a usuarios finales. Es un defecto conocido de divulgación de información: está previsto devolver un mensaje genérico en los 500 y dejar el detalle solo en el log del servicio (seguimiento en lamassuiot#814). El conector de autorización también devuelve el error interno, en el campo `details.error`. Algunos errores de petición, como un tamaño de clave que el motor no admite, se devuelven también como 500.",{"_3376":68838,"_29549":68795,"_20523":114720,"_5":14087,"_26884":114625,"_2862":114721},[],"Revisa primero kubectl describe pod. Las causas habituales son:",{"_3376":68839,"_29549":68795,"_20523":114723,"_5":14087,"_26884":114625,"_2862":114724},[],"credenciales o DNS incorrectos para PostgreSQL o RabbitMQ;",{"_3376":68840,"_29549":68795,"_20523":114726,"_5":14087,"_26884":114625,"_2862":114727},[],"un Secret de CA o de certificado de cliente de AMQP inexistente referenciado por `amqp.ca.secretName` o `amqp.client.secretName`;",{"_3376":68841,"_29549":68795,"_20523":114729,"_5":14087,"_26884":114625,"_2862":114730},[],"volumen persistente sin enlazar;",{"_3376":68842,"_29549":68795,"_20523":114732,"_5":14087,"_26884":114625,"_2862":114733},[],"imagen inaccesible o política de pull incorrecta;",{"_3376":68843,"_29549":68795,"_20523":114735,"_5":14087,"_26884":114625,"_2862":114736},[],"configuración inválida del motor criptográfico;",{"_3376":68844,"_29549":68795,"_20523":114738,"_5":14087,"_26884":114625,"_2862":114739},[],"límites de CPU o memoria demasiado bajos;",{"_3376":68845,"_29549":68795,"_20523":114741,"_5":14087,"_26884":114625,"_2862":114742},[],"migración previa incompleta.",{"_3376":68846,"_29549":68795,"_20523":114744,"_5":14087,"_26884":114625,"_2862":114745},[],"Los valores genéricos solicitan 100 mCPU y 128 MiB y limitan a 500 mCPU y 512 MiB. Ajusta por servicio cuando haya OOMKills, throttling o arranques lentos.",{"_3376":68847,"_29549":68795,"_20523":114747,"_5":14087,"_26884":114625,"_2862":114748},[],"Los motores KMS basados en filesystem y el almacenamiento local de VA utilizan volúmenes de acceso exclusivo. Mantén una réplica o migra a backends compartidos antes de habilitar autoscaling.",{"_3376":68848,"_29549":68795,"_20523":114750,"_5":14087,"_26884":114625,"_2862":114751},[],"Las llamadas internas ahora fallan rápido en lugar de bloquearse para los clientes cubiertos por Proxy de salida: los intentos de conexión agotan el tiempo tras 30 segundos y los handshakes TLS tras 10 segundos. El conector del motor de autorización mantiene su propio transporte sin estos timeouts de conexión ni de handshake TLS; solo su timeout global de petición de 30 segundos acota cada llamada. Si un proxy de salida gestiona el tráfico de salida del clúster, comprueba las variables de entorno `HTTP_PROXY`, `HTTPS_PROXY` y `NO_PROXY` del pod e incluye los nombres de servicio internos en `NO_PROXY`.",{"_3376":68849,"_29549":68795,"_20523":114753,"_5":14087,"_26884":114629,"_2862":114754},[],"Los eventos de dominio y auditoría dependen del publisher del bus:",{"_3376":68850,"_29549":68795,"_20523":114756,"_5":14087,"_26884":114629,"_2862":114757},[],"verifica que esté habilitado en el servicio emisor;",{"_3376":68851,"_29549":68795,"_20523":114759,"_5":14087,"_26884":114629,"_2862":114760},[],"comprueba conectividad y credenciales AMQP;",{"_3376":68852,"_29549":68795,"_20523":114762,"_5":14087,"_26884":114629,"_2862":114763},[],"revisa exchange, routing key, colas y consumidores;",{"_3376":68853,"_29549":68795,"_20523":114765,"_5":14087,"_26884":114629,"_2862":114766},[],"inspecciona dead-letter queues;",{"_3376":68854,"_29549":68795,"_20523":114768,"_5":14087,"_26884":114629,"_2862":114769},[],"alerta sobre colas durables huérfanas y crecimiento de backlog.",{"_3376":68855,"_29549":68795,"_20523":114771,"_5":14087,"_26884":114629,"_2862":114772},[],"Si `amqp.tls` está habilitado, revisa también la parte TLS:",{"_3376":68856,"_29549":68795,"_20523":114774,"_5":14087,"_26884":114629,"_2862":114775},[],"confirma que el listener del broker hable AMQPS en el puerto configurado — el puerto por defecto sigue siendo `5672` y no cambia automáticamente al habilitar TLS;",{"_3376":68857,"_29549":68795,"_20523":114777,"_5":14087,"_26884":114629,"_2862":114778},[],"si defines `amqp.ca.secretName`, confirma que el Secret exista en el namespace del release y que su clave de datos coincida con `amqp.ca.certificateKey` (por defecto `ca.crt`); si no defines `amqp.ca.secretName`, los clientes confían en las CA del sistema;",{"_3376":68858,"_29549":68795,"_20523":114780,"_5":14087,"_26884":114629,"_2862":114781},[],"recuerda que un Secret referenciado inexistente impide arrancar los pods consumidores;",{"_3376":68859,"_29549":68795,"_20523":114783,"_5":14087,"_26884":114629,"_2862":114784},[],"tras actualizar el Secret de la CA o del certificado de cliente, reinicia los pods consumidores: el cliente AMQP carga los certificados al arrancar.",{"_3376":68860,"_29549":68795,"_20523":114786,"_5":14087,"_26884":114629,"_2862":114787},[],"Consulta TLS de AMQP (AMQPS) para la configuración completa.",{"_3376":68861,"_29549":68795,"_20523":114789,"_5":14087,"_26884":114629,"_2862":114790},[],"Una caída del consumidor no siempre impide que la operación principal termine. Por eso debes monitorizar RabbitMQ y verificar de forma independiente la persistencia de auditoría.",{"_3376":68862,"_29549":68795,"_20523":114792,"_5":14087,"_26884":114633,"_2862":114793},[],"El chart puede habilitar la instrumentación OpenTelemetry para los servicios que la admiten, incluido authz; no configura OpenTelemetry para el AWS Connector, wfx ni la UI. Las trazas se exportan por OTLP HTTP y los logs pueden dirigirse a un endpoint compatible, como VictoriaLogs. Usa un identificador de correlación y la misma ventana temporal para unir Gateway, servicio y dependencia.",{"_3376":68863,"_29549":68795,"_20523":114795,"_5":14087,"_26884":114633,"_2862":114796},[],"Antes de cerrar una incidencia, guarda:",{"_3376":68864,"_29549":68795,"_20523":114798,"_5":14087,"_26884":114633,"_2862":114799},[],"causa confirmada;",{"_3376":68865,"_29549":68795,"_20523":114801,"_5":14087,"_26884":114633,"_2862":114802},[],"alcance temporal y recursos afectados;",{"_3376":68866,"_29549":68795,"_20523":114804,"_5":14087,"_26884":114633,"_2862":114805},[],"comandos o consultas utilizados;",{"_3376":68867,"_29549":68795,"_20523":114807,"_5":14087,"_26884":114633,"_2862":114808},[],"cambio aplicado y forma de revertirlo;",{"_3376":68868,"_29549":68795,"_20523":114810,"_5":14087,"_26884":114633,"_2862":114811},[],"validación desde un consumidor;",{"_3376":68869,"_29549":68795,"_20523":114813,"_5":14087,"_26884":114633,"_2862":114814},[],"acción preventiva y propietario.",{"_3376":68870,"_29549":68870,"_5":14445,"_2862":114816,"_29881":114817,"_20523":114820,"_26884":68870},"Control de acceso",[48111,114818,114819],"Plataforma","Administración",[],{"_3376":68871,"_29549":68870,"_20523":114822,"_5":14087,"_26884":68870,"_2862":114823},[],"Diseña quién puede acceder a Lamassu mediante principales, políticas, permisos sobre recursos y autorización de rutas HTTP.",{"_3376":68872,"_29549":68870,"_5":29878,"_20523":114825,"_26884":114826,"_2862":114827},[],"/docs/es/platform/administration/access-control#conceptos-esenciales","Conceptos esenciales",{"_3376":68873,"_29549":68870,"_5":29878,"_20523":114829,"_26884":114830,"_2862":114831},[],"/docs/es/platform/administration/access-control#dos-sistemas-de-decisión","Dos sistemas de decisión",{"_3376":68874,"_29549":68870,"_5":29878,"_20523":114833,"_26884":114834,"_2862":114835},[],"/docs/es/platform/administration/access-control#servicios-http-integrados-o-externos","Servicios HTTP integrados o externos",{"_3376":68875,"_29549":68870,"_5":29878,"_20523":114837,"_26884":114838,"_2862":114839},[],"/docs/es/platform/administration/access-control#rutas-solo-de-autenticación-y-rutas-no-mapeadas","Rutas solo de autenticación y rutas no mapeadas",{"_3376":68876,"_29549":68870,"_5":29878,"_20523":114841,"_26884":114842,"_2862":114843},[],"/docs/es/platform/administration/access-control#servicios-desarrollados-por-lamassu","Servicios desarrollados por Lamassu",{"_3376":68877,"_29549":68870,"_5":29878,"_20523":114845,"_26884":114846,"_2862":114847},[],"/docs/es/platform/administration/access-control#cómo-se-relacionan-ambos-caminos","Cómo se relacionan ambos caminos",{"_3376":68878,"_29549":68870,"_5":29878,"_20523":114849,"_26884":114850,"_2862":114851},[],"/docs/es/platform/administration/access-control#principales-oidc","Principales OIDC",{"_3376":68879,"_29549":68870,"_5":29878,"_20523":114853,"_26884":114854,"_2862":114855},[],"/docs/es/platform/administration/access-control#principales-x509","Principales X.509",{"_3376":68880,"_29549":68870,"_5":29878,"_20523":114857,"_26884":114858,"_2862":114859},[],"/docs/es/platform/administration/access-control#cuando-coinciden-varios-principales","Cuando coinciden varios principales",{"_3376":68881,"_29549":68870,"_5":29878,"_20523":114861,"_26884":114862,"_2862":114863},[],"/docs/es/platform/administration/access-control#cómo-expresan-acceso-las-políticas","Cómo expresan acceso las políticas",{"_3376":68882,"_29549":68870,"_5":29878,"_20523":114865,"_26884":114866,"_2862":114867},[],"/docs/es/platform/administration/access-control#acceso-global-y-acceso-directo","Acceso global y acceso directo",{"_3376":68883,"_29549":68870,"_5":29878,"_20523":114869,"_26884":114870,"_2862":114871},[],"/docs/es/platform/administration/access-control#acceso-heredado-por-relaciones","Acceso heredado por relaciones",{"_3376":68884,"_29549":68870,"_5":29878,"_20523":114873,"_26884":114874,"_2862":114875},[],"/docs/es/platform/administration/access-control#acceso-filtrado-por-atributos","Acceso filtrado por atributos",{"_3376":68885,"_29549":68870,"_5":29878,"_20523":114877,"_26884":114878,"_2862":114879},[],"/docs/es/platform/administration/access-control#reglas-http","Reglas HTTP",{"_3376":68886,"_29549":68870,"_5":29878,"_20523":114881,"_26884":114882,"_2862":114883},[],"/docs/es/platform/administration/access-control#políticas-incluidas","Políticas incluidas",{"_3376":68887,"_29549":68870,"_5":29878,"_20523":114885,"_26884":114886,"_2862":113993},[],"/docs/es/platform/administration/access-control#provisiona-el-primer-administrador",{"_3376":68888,"_29549":68870,"_5":29878,"_20523":114888,"_26884":114889,"_2862":114890},[],"/docs/es/platform/administration/access-control#prepara-el-proveedor-de-identidad","Prepara el proveedor de identidad",{"_3376":68889,"_29549":68870,"_5":29878,"_20523":114892,"_26884":114893,"_2862":114894},[],"/docs/es/platform/administration/access-control#configura-la-validación-de-tokens","Configura la validación de tokens",{"_3376":68890,"_29549":68870,"_5":29878,"_20523":114896,"_26884":114897,"_2862":114898},[],"/docs/es/platform/administration/access-control#instala-y-verifica-el-acceso-administrativo","Instala y verifica el acceso administrativo",{"_3376":68891,"_29549":68870,"_5":29878,"_20523":114900,"_26884":114901,"_2862":114902},[],"/docs/es/platform/administration/access-control#prueba-una-identidad-sin-privilegios","Prueba una identidad sin privilegios",{"_3376":68892,"_29549":68870,"_5":29878,"_20523":114904,"_26884":114905,"_2862":114906},[],"/docs/es/platform/administration/access-control#reduce-el-uso-del-administrador-de-bootstrap","Reduce el uso del administrador de bootstrap",{"_3376":68893,"_29549":68870,"_5":29878,"_20523":114908,"_26884":114909,"_2862":114910},[],"/docs/es/platform/administration/access-control#bootstrap-de-fastlane","Bootstrap de Fastlane",{"_3376":68894,"_29549":68870,"_5":29878,"_20523":114912,"_26884":114913,"_2862":114914},[],"/docs/es/platform/administration/access-control#diseña-roles-de-mínimo-privilegio","Diseña roles de mínimo privilegio",{"_3376":68895,"_29549":68870,"_5":29878,"_20523":114916,"_26884":114917,"_2862":114918},[],"/docs/es/platform/administration/access-control#cambios-y-revocación-de-acceso","Cambios y revocación de acceso",{"_3376":68896,"_29549":68870,"_5":29878,"_20523":114920,"_26884":114921,"_2862":114922},[],"/docs/es/platform/administration/access-control#lista-de-comprobación-operativa","Lista de comprobación operativa",{"_3376":68897,"_29549":68870,"_5":29878,"_20523":114924,"_26884":114925,"_2862":114926},[],"/docs/es/platform/administration/access-control#diagnóstico","Diagnóstico",{"_3376":68898,"_29549":68870,"_5":29878,"_20523":114928,"_26884":114929,"_2862":114930},[],"/docs/es/platform/administration/access-control#la-respuesta-es-401","La respuesta es 401",{"_3376":68899,"_29549":68870,"_5":29878,"_20523":114932,"_26884":114933,"_2862":114934},[],"/docs/es/platform/administration/access-control#la-respuesta-es-403","La respuesta es 403",{"_3376":68900,"_29549":68870,"_5":29878,"_20523":114936,"_26884":114937,"_2862":114938},[],"/docs/es/platform/administration/access-control#todo-devuelve-403","Todo devuelve 403",{"_3376":68901,"_29549":68870,"_5":29878,"_20523":114940,"_26884":114941,"_2862":114942},[],"/docs/es/platform/administration/access-control#aparece-acceso-sin-política-concedida","Aparece acceso sin política concedida",{"_3376":68902,"_29549":68870,"_5":29878,"_20523":114944,"_26884":114945,"_2862":114946},[],"/docs/es/platform/administration/access-control#todo-falla-cuando-authz-no-está-disponible","Todo falla cuando authz no está disponible",{"_3376":68903,"_29549":68870,"_20523":114948,"_5":14087,"_26884":68870,"_2862":114949},[],"El control de acceso de Lamassu transforma una identidad autenticada en permisos concretos. El proveedor OIDC o el certificado cliente demuestra **quién** realiza una petición; el servicio `authz` decide **qué puede hacer** esa identidad y **sobre qué recursos**.",{"_3376":68904,"_29549":68870,"_20523":114951,"_5":14087,"_26884":68870,"_2862":114952},[],"Lamassu no asigna permisos directamente a usuarios. La cadena completa es:",{"_3376":68905,"_29549":68870,"_20523":114954,"_5":14087,"_26884":68870,"_2862":114955},[],"Este modelo permite representar personas, grupos del proveedor de identidad, cuentas de servicio y dispositivos sin acoplar la autorización a un proveedor concreto.",{"_3376":68906,"_29549":68870,"_20523":114957,"_5":14087,"_26884":114826,"_2862":114958},[],"Un **principal** conecta una credencial con Lamassu. Define cómo reconocer una identidad OIDC o X.509 y puede estar activo o desactivado.",{"_3376":68907,"_29549":68870,"_20523":114960,"_5":14087,"_26884":114826,"_2862":114961},[],"Una **política** agrupa permisos reutilizables. Puede concederse a varios principales y puede contener reglas sobre entidades de Lamassu, reglas sobre rutas HTTP o ambas.",{"_3376":68908,"_29549":68870,"_20523":114963,"_5":14087,"_26884":114826,"_2862":114964},[],"Una **regla de entidad** concede acciones sobre recursos como autoridades certificadoras, certificados, perfiles de emisión, dispositivos, DMS, claves o suscripciones de alertas. Puede abarcar todos los recursos de un tipo o limitarse por identificador, relación o atributo.",{"_3376":68909,"_29549":68870,"_20523":114966,"_5":14087,"_26884":114826,"_2862":114967},[],"Una **regla HTTP** concede acciones asociadas a rutas de una API. Es el mecanismo que utiliza el Gateway para decidir si una petición puede atravesar el perímetro.",{"_3376":68910,"_29549":68870,"_20523":114969,"_5":14087,"_26884":114826,"_2862":114970},[],"Un **grant** es la asociación entre un principal y una política. Quitar el grant elimina todos los permisos aportados por esa política, sin modificarla para los demás principales.",{"_3376":68911,"_29549":68870,"_20523":114972,"_5":14087,"_26884":114826,"_2862":114973},[],"Un JWT válido o un certificado cliente válido no concede acceso por sí mismo. La credencial debe coincidir con al menos un principal activo y, salvo que el esquema HTTP exima la ruta, alguna de sus políticas debe permitir la operación solicitada. Consulta *Rutas solo de autenticación y rutas no mapeadas* para esas excepciones.",{"_3376":68912,"_29549":68870,"_20523":114975,"_5":14087,"_26884":114830,"_2862":114976},[],"Lamassu utiliza dos caminos de autorización según quién implementa el servicio protegido. Comparten principales, políticas y grants, pero no interpretan las reglas de la misma manera.",{"_3376":68913,"_29549":68870,"_20523":114978,"_5":14087,"_26884":114830,"_2862":114979},[],"Un servicio externo puede quedar protegido sin conocer el modelo interno de autorización de Lamassu. Un servicio desarrollado por Lamassu integra el motor de autorización y puede decidir sobre recursos concretos y filtrar sus consultas.",{"_3376":68914,"_29549":68870,"_20523":114981,"_5":14087,"_26884":114834,"_2862":114982},[],"Este camino protege APIs que se incorporan a la plataforma a través del Gateway pero que no implementan de forma nativa el SDK de autorización de Lamassu. Job Manager es el ejemplo actual. El mismo patrón permite integrar otros servicios HTTP siempre que sus rutas estén descritas en un esquema HTTP de `authz`.",{"_3376":68915,"_29549":68870,"_20523":114984,"_5":14087,"_26884":114834,"_2862":114985},[],"La decisión se toma **antes de reenviar la petición al servicio**:",{"_3376":68916,"_29549":68870,"_20523":114987,"_5":14087,"_26884":114834,"_2862":114988},[],"Envoy Gateway autentica la petición, normalmente validando un JWT contra el JWKS del proveedor OIDC.",{"_3376":68917,"_29549":68870,"_20523":114990,"_5":14087,"_26884":114834,"_2862":114991},[],"Para una ruta protegida, Envoy envía el método, la URL, las cabeceras y los datos necesarios a `/v1/ext_authz/check`.",{"_3376":68918,"_29549":68870,"_20523":114993,"_5":14087,"_26884":114834,"_2862":114994},[],"`authz` extrae la credencial y resuelve todos los principales activos que coinciden con ella.",{"_3376":68919,"_29549":68870,"_20523":114996,"_5":14087,"_26884":114834,"_2862":114997},[],"Carga por separado las políticas concedidas a cada principal.",{"_3376":68920,"_29549":68870,"_20523":114999,"_5":14087,"_26884":114834,"_2862":115000},[],"El esquema HTTP traduce la combinación de método y ruta a una acción lógica, como `nbi-job-read` o `nbi-workflow-create`.",{"_3376":68921,"_29549":68870,"_20523":115002,"_5":14087,"_26884":114834,"_2862":115003},[],"`authz` busca una regla HTTP que conceda esa acción.",{"_3376":68922,"_29549":68870,"_20523":115005,"_5":14087,"_26884":114834,"_2862":115006},[],"Si la ruta declara restricciones, compara datos de la petición con los atributos normalizados del mismo principal que aporta la política; los `param_constraints` de la propia política también fijan la acción concedida a valores literales de la petición.",{"_3376":68923,"_29549":68870,"_20523":115008,"_5":14087,"_26884":114834,"_2862":115009},[],"Un resultado satisfactorio permite a Envoy reenviar la petición; cualquier otra respuesta la bloquea en el Gateway.",{"_3376":68924,"_29549":68870,"_20523":115011,"_5":14087,"_26884":114834,"_2862":115012},[],"Cuando permite el acceso, `authz` devuelve el principal seleccionado en la cabecera de respuesta `X-Principal-ID`. El Gateway puede propagar esa cabecera al servicio para conservar el contexto de identidad.",{"_3376":68925,"_29549":68870,"_20523":115014,"_5":14087,"_26884":114834,"_2862":115015},[],"Las reglas HTTP responden principalmente a &#x2A;*“¿puede esta identidad llamar a esta operación de la API?”**. Por sí solas no generan filtros sobre la base de datos del servicio externo. Para limitar una ruta a un dispositivo, tenant o cliente concreto, o bien el esquema declara una restricción que relaciona un valor de la petición con un atributo normalizado del principal, o bien la política fija ese valor de la petición a un literal con `param_constraints`. Lo primero limita cada identidad a sus propios recursos con un único grant; lo segundo restringe un grant a un valor fijo, sin importar quién lo posea.",{"_3376":68926,"_29549":68870,"_20523":115017,"_5":14087,"_26884":114838,"_2862":115018},[],"Dos ajustes del propio esquema cubren endpoints que las políticas no mencionan:",{"_3376":68927,"_29549":68870,"_20523":115020,"_5":14087,"_26884":114838,"_2862":115021},[],"**`skip_authz: true` en una ruta** permite alcanzarla a cualquier identidad que coincida con un principal activo, aunque no tenga políticas concedidas. Úsalo para rutas como `/openapi.json` o `/health` que todo cliente autenticado debería poder consultar. La petición sigue necesitando una autenticación válida: una credencial que no supera la validación o no coincide con ningún principal activo se rechaza antes de considerar este ajuste. Una ruta con `skip_authz` no puede declarar restricciones, y prevalece sobre la ruta o la acción por defecto de cualquier otro esquema para la misma petición.",{"_3376":68928,"_29549":68870,"_20523":115023,"_5":14087,"_26884":114838,"_2862":115024},[],"**`default_action` con `base_paths`** decide qué ocurre cuando una petición cae bajo un prefijo de ruta que el esquema posee pero ninguna ruta explícita coincide. `deny` — el valor con el que se entrega el esquema del Job Manager — convierte la denegación implícita de las rutas no mapeadas en una declaración explícita y auditable; `allow` abre los endpoints no mapeados bajo ese prefijo a cualquier identidad que coincida con un principal activo.",{"_3376":68929,"_29549":68870,"_20523":115026,"_5":14087,"_26884":114838,"_2862":115027},[],"Son decisiones del esquema, no de una política: `skip_authz` elimina la comprobación del grant para esa ruta, incluso cuando otro esquema asigna la misma petición a una acción que exige un grant, y `default_action` solo cubre las peticiones que ninguna ruta explícita de ningún esquema cubre. Ten en cuenta tres reglas:",{"_3376":68930,"_29549":68870,"_20523":115029,"_5":14087,"_26884":114838,"_2862":115030},[],"`default_action` exige al menos una entrada en `base_paths`, y las rutas base son rutas absolutas como `/api/wfx/nbi/v1`.",{"_3376":68931,"_29549":68870,"_20523":115032,"_5":14087,"_26884":114838,"_2862":115033},[],"Una ruta explícita de cualquier esquema tiene prioridad: la acción por defecto solo decide peticiones que ninguna ruta de ningún esquema cubre. Cuando los prefijos de dos esquemas se solapan, decide el prefijo coincidente más largo.",{"_3376":68932,"_29549":68870,"_20523":115035,"_5":14087,"_26884":114838,"_2862":115036},[],"Dos esquemas no pueden reclamar la misma ruta base con acciones por defecto distintas; el esquema en conflicto no llega a cargar.",{"_3376":68933,"_29549":68870,"_20523":115038,"_5":14087,"_26884":114838,"_2862":115039},[],"Una ruta con `skip_authz` y un prefijo con `default_action: \"allow\"` conceden acceso sin consultar ninguna política. Cualquier identidad que coincida con un principal activo puede alcanzar lo que abran, incluidas las identidades sin políticas concedidas. Una ruta con `skip_authz` en un esquema también abre una petición que otro esquema asigna a una acción protegida por un grant. Revisa estos ajustes cada vez que integres o actualices un servicio.",{"_3376":68934,"_29549":68870,"_20523":115041,"_5":14087,"_26884":114842,"_2862":115042},[],"Los servicios nativos de Lamassu integran autorización en su middleware y conocen las entidades sobre las que operan: certificados, CAs, perfiles de emisión, claves, dispositivos, DMS o suscripciones, entre otras.",{"_3376":68935,"_29549":68870,"_20523":115044,"_5":14087,"_26884":114842,"_2862":115045},[],"La decisión se toma con el contexto de la operación de dominio:",{"_3376":68936,"_29549":68870,"_20523":115047,"_5":14087,"_26884":114842,"_2862":115048},[],"El middleware extrae la credencial y resuelve los principales coincidentes.",{"_3376":68937,"_29549":68870,"_20523":115050,"_5":14087,"_26884":114842,"_2862":115051},[],"El endpoint identifica la acción, el tipo de entidad y, cuando corresponde, la clave del recurso solicitado.",{"_3376":68938,"_29549":68870,"_20523":115053,"_5":14087,"_26884":114842,"_2862":115054},[],"`authz` reúne las reglas de entidad de las políticas concedidas.",{"_3376":68939,"_29549":68870,"_20523":115056,"_5":14087,"_26884":114842,"_2862":115057},[],"El motor evalúa grants directos, filtros por atributos y relaciones con otras entidades.",{"_3376":68940,"_29549":68870,"_20523":115059,"_5":14087,"_26884":114842,"_2862":115060},[],"Para una operación individual, comprueba que el recurso concreto satisface el alcance calculado.",{"_3376":68941,"_29549":68870,"_20523":115062,"_5":14087,"_26884":114842,"_2862":115063},[],"Para un listado, genera un filtro SQL que el servicio añade a su propia consulta.",{"_3376":68942,"_29549":68870,"_20523":115065,"_5":14087,"_26884":114842,"_2862":115066},[],"Aquí el motor responde a &#x2A;*“¿puede esta identidad realizar esta acción sobre este recurso concreto?”**.",{"_3376":68943,"_29549":68870,"_20523":115068,"_5":14087,"_26884":114842,"_2862":115069},[],"Las acciones se dividen en dos grupos:",{"_3376":68944,"_29549":68870,"_20523":115071,"_5":14087,"_26884":114842,"_2862":115072},[],"Las **acciones globales** no necesitan un identificador de recurso. `create`, `import` o el acceso a una sección de la interfaz son ejemplos habituales.",{"_3376":68945,"_29549":68870,"_20523":115074,"_5":14087,"_26884":114842,"_2862":115075},[],"Las **acciones atómicas** se evalúan sobre una instancia concreta. En certificados aparecen `read`, `metadata-update`, `status-update` y `delete`; para una CA también existen `sign`, `reissue` y otras operaciones de ciclo de vida.",{"_3376":68946,"_29549":68870,"_20523":115077,"_5":14087,"_26884":114842,"_2862":115078},[],"El filtrado dentro del servicio evita fugas en listados: los recursos no autorizados quedan fuera de la consulta SQL en lugar de recuperarse y ocultarse después en la interfaz.",{"_3376":68947,"_29549":68870,"_20523":115080,"_5":14087,"_26884":114846,"_2862":115081},[],"No son dos controles equivalentes aplicados dos veces. Las reglas HTTP protegen el perímetro de un servicio integrado; las reglas de entidad expresan permisos sobre el modelo de datos de los servicios nativos.",{"_3376":68948,"_29549":68870,"_20523":115083,"_5":14087,"_26884":114846,"_2862":115084},[],"Una política puede contener ambos tipos de reglas cuando una identidad necesita operar recursos de Lamassu y también llamar a una API integrada. Conceder una regla de entidad no concede automáticamente una acción HTTP, ni una regla HTTP crea acceso sobre una entidad.",{"_3376":68949,"_29549":68870,"_20523":115086,"_5":14087,"_26884":114846,"_2862":115087},[],"Si ninguna combinación de principal, política y regla permite la operación, Lamassu la deniega, salvo que el esquema HTTP declare `skip_authz` en la ruta o `default_action: allow` en una ruta base que la cubra (consulta *Rutas solo de autenticación y rutas no mapeadas*). Además, `auth.externalAuthorization.failOpen` vale `false` por defecto: si `authz` no está disponible, el Gateway bloquea las rutas protegidas.",{"_3376":68950,"_29549":68870,"_20523":115089,"_5":14087,"_26884":114850,"_2862":115090},[],"Un principal OIDC coincide con los claims de un JWT validado. Es apropiado para usuarios humanos, grupos corporativos, roles del IdP y cuentas de servicio que obtienen tokens.",{"_3376":68951,"_29549":68870,"_20523":115092,"_5":14087,"_26884":114850,"_2862":115093},[],"El siguiente principal representa a cualquier identidad que tenga el rol `pki-operators` en Keycloak:",{"_3376":68952,"_29549":68870,"_20523":115095,"_5":14087,"_26884":114850,"_2862":115096},[],"Las rutas de claims pueden estar anidadas, como `realm_access.roles`. Dentro de un mismo principal, **todas** las condiciones deben cumplirse. Esto permite exigir, por ejemplo, un grupo y una audiencia organizativa a la vez.",{"_3376":68953,"_29549":68870,"_20523":115098,"_5":14087,"_26884":114850,"_2862":115099},[],"Los operadores implementados son:",{"_3376":68954,"_29549":68870,"_20523":115101,"_5":14087,"_26884":114850,"_2862":115102},[],"`equals`, para igualdad exacta;",{"_3376":68955,"_29549":68870,"_20523":115104,"_5":14087,"_26884":114850,"_2862":115105},[],"`contains`, para comprobar la pertenencia a una lista o la presencia de texto en un valor escalar.",{"_3376":68956,"_29549":68870,"_20523":115107,"_5":14087,"_26884":114850,"_2862":115108},[],"Diseña la coincidencia con atributos estables. Para personas, suele ser mejor enlazar permisos a grupos o roles gestionados centralmente que al correo o al nombre de usuario. Para una cuenta de servicio, un `sub` estable evita que sus permisos se mezclen con los de un operador humano.",{"_3376":68957,"_29549":68870,"_20523":115110,"_5":14087,"_26884":114850,"_2862":115111},[],"Aunque el modelo reconoce el nombre de operador `matches`, la implementación actual no evalúa expresiones regulares y la condición nunca coincide. Usa `equals` o `contains`.",{"_3376":68958,"_29549":68870,"_20523":115113,"_5":14087,"_26884":114854,"_2862":115114},[],"Un principal X.509 permite reconocer una carga de trabajo o un dispositivo mediante su certificado cliente. Lamassu comprueba la firma del certificado contra la CA configurada y, según el modo, también su número de serie o Common Name.",{"_3376":68959,"_29549":68870,"_20523":115116,"_5":14087,"_26884":114854,"_2862":115117},[],"Los modos disponibles son:",{"_3376":68960,"_29549":68870,"_20523":115119,"_5":14087,"_26884":114854,"_2862":115120},[],"`serial_and_ca`: un certificado exacto, identificado por número de serie y CA;",{"_3376":68961,"_29549":68870,"_20523":115122,"_5":14087,"_26884":114854,"_2862":115123},[],"`cn_and_ca`: un Common Name exacto o con comodines y una CA concreta;",{"_3376":68962,"_29549":68870,"_20523":115125,"_5":14087,"_26884":114854,"_2862":115126},[],"`any_from_ca`: cualquier certificado emitido directamente por la CA indicada.",{"_3376":68963,"_29549":68870,"_20523":115128,"_5":14087,"_26884":114854,"_2862":115129},[],"Este ejemplo reconoce certificados cuyo CN comienza por `factory-a-` y que están firmados por la CA configurada:",{"_3376":68964,"_29549":68870,"_20523":115131,"_5":14087,"_26884":114854,"_2862":115132},[],"`ca_trust.identity_type` acepta `fingerprint` o `authority_key_id`. En ambos casos debes aportar el certificado de la CA en `ca_trust.pem`; Lamassu verifica tanto la firma como la identidad esperada de la CA.",{"_3376":68965,"_29549":68870,"_20523":115134,"_5":14087,"_26884":114854,"_2862":115135},[],"Usa `any_from_ca` únicamente cuando todas las identidades emitidas por esa CA deban compartir los mismos permisos. Si una CA emite certificados para poblaciones distintas, separa el acceso por serie o CN, o utiliza CAs de emisión diferentes.",{"_3376":68966,"_29549":68870,"_20523":115137,"_5":14087,"_26884":114858,"_2862":115138},[],"Una misma credencial puede coincidir con más de un principal. Es habitual que un usuario coincida con un principal de su equipo y con otro de su función operativa.",{"_3376":68967,"_29549":68870,"_20523":115140,"_5":14087,"_26884":114858,"_2862":115141},[],"Para permisos de entidad, Lamassu combina los permisos con lógica OR: basta con que una de las políticas de uno de los principales permita la acción. Los listados contienen la unión de los recursos visibles para todos ellos.",{"_3376":68968,"_29549":68870,"_20523":115143,"_5":14087,"_26884":114858,"_2862":115144},[],"Las rutas HTTP con restricciones son más estrictas. El mismo principal que aporta la política debe satisfacer también los atributos exigidos por la ruta. Lamassu no combina la política de un principal con un atributo perteneciente a otro.",{"_3376":68969,"_29549":68870,"_20523":115146,"_5":14087,"_26884":114858,"_2862":115147},[],"Por esta razón, añadir un principal coincidente solo puede ampliar el acceso. Antes de crear reglas solapadas, revisa el conjunto completo de políticas que recibirá una identidad real.",{"_3376":68970,"_29549":68870,"_20523":115149,"_5":14087,"_26884":114866,"_2862":115150},[],"Una regla identifica el dominio (`namespace`), el esquema de datos (`schema_name`) y el tipo de entidad (`entity_type`). `actions` enumera las operaciones permitidas.",{"_3376":68971,"_29549":68870,"_20523":115152,"_5":14087,"_26884":114866,"_2862":115153},[],"`direct_grants` limita la regla a identificadores concretos. El valor `*` abarca todas las instancias del tipo. Una política de superadministrador utiliza comodines en esquema, entidad, acciones y grants; una política de mínimo privilegio debe evitarlos siempre que sea posible.",{"_3376":68972,"_29549":68870,"_20523":115155,"_5":14087,"_26884":114870,"_2862":115156},[],"Las reglas pueden seguir relaciones declaradas entre entidades. Por ejemplo, el esquema conoce la relación de un certificado con su CA emisora y la de un dispositivo con su DMS. Una política puede conceder acceso a un recurso padre y propagar acciones seleccionadas hacia sus recursos relacionados.",{"_3376":68973,"_29549":68870,"_20523":115158,"_5":14087,"_26884":114870,"_2862":115159},[],"Esto permite expresar modelos como “puede operar los dispositivos de este DMS” sin mantener una lista individual de cada dispositivo. Cuando se añade un recurso bajo esa relación, hereda el alcance previsto por la política.",{"_3376":68974,"_29549":68870,"_20523":115161,"_5":14087,"_26884":114874,"_2862":115162},[],"`column_filters` aplica condiciones a columnas que el esquema haya declarado como filtrables. Todos los filtros de una misma regla se combinan con AND.",{"_3376":68975,"_29549":68870,"_20523":115164,"_5":14087,"_26884":114874,"_2862":115165},[],"Por ejemplo, esta regla permite leer certificados activos emitidos por una CA concreta:",{"_3376":68976,"_29549":68870,"_20523":115167,"_5":14087,"_26884":114874,"_2862":115168},[],"Los operadores disponibles son `eq`, `neq`, `gt`, `gte`, `lt`, `lte`, `in` y `like`. Usa comparaciones coherentes con el tipo de columna: `like` para texto, comparaciones de orden para números o fechas y `in` cuando haya una colección de valores aceptados.",{"_3376":68977,"_29549":68870,"_20523":115170,"_5":14087,"_26884":114878,"_2862":115171},[],"Las reglas HTTP no apuntan directamente a tablas. Referencian un esquema de rutas y conceden sus acciones lógicas. Las políticas del Job Manager son un ejemplo: distinguen lectura, creación, actualización y eliminación de workflows o jobs.",{"_3376":68978,"_29549":68870,"_20523":115173,"_5":14087,"_26884":114878,"_2862":115174},[],"Algunas rutas también comparan un valor de la petición —extraído de la ruta, query, cabecera o cuerpo JSON— con un atributo normalizado del principal. Así puede verificarse que un dispositivo solo consulte trabajos dirigidos a su propio `client_id`.",{"_3376":68979,"_29549":68870,"_20523":115176,"_5":14087,"_26884":114878,"_2862":115177},[],"Los atributos normalizados desacoplan la política del mecanismo de autenticación. `subject_attribute_mappings` puede derivar, por ejemplo, `device_id` desde `oidc.claim.device_id` o desde `x509.subject.cn`. La regla consume `device_id` en ambos casos.",{"_3376":68980,"_29549":68870,"_20523":115179,"_5":14087,"_26884":114878,"_2862":115180},[],"Una regla HTTP también puede fijar una acción concedida a un valor literal que la propia petición transporte, mediante `param_constraints`. Extrae el valor con las mismas fuentes que las restricciones de ruta —`path_regex_group`, `query`, `header` o `json_body`— pero lo compara con un literal `equals` escrito en la política, no con un atributo del principal. El grant depende entonces solo de la petición, no de quién posea la política:",{"_3376":68981,"_29549":68870,"_20523":115182,"_5":14087,"_26884":114878,"_2862":115183},[],"Combinada con una ruta del esquema como `^/api/mysvc/system/([^/]+)/info$`, concede `GET /api/mysvc/system/1/info` y deniega la misma llamada para el sistema `2`, con independencia de los atributos del principal. El mismo mecanismo fija parámetros de query, cabeceras o campos del cuerpo JSON, por ejemplo `{ \"source\": \"query\", \"name\": \"tenant_id\" }` con `\"equals\": \"1\"` para aceptar solo peticiones que lleven `?tenant_id=1`.",{"_3376":68982,"_29549":68870,"_20523":115185,"_5":14087,"_26884":114878,"_2862":115186},[],"Ten en cuenta que:",{"_3376":68983,"_29549":68870,"_20523":115188,"_5":14087,"_26884":114878,"_2862":115189},[],"`action` debe estar entre las acciones concedidas por la regla; `equals` es obligatorio; `path_regex_group` necesita un `index` mayor que cero, `query` y `header` un `name`, y `json_body` un `path` como `$.tenant_id`.",{"_3376":68984,"_29549":68870,"_20523":115191,"_5":14087,"_26884":114878,"_2862":115192},[],"`param_constraints` no se coteja con el esquema al cargar la política. Una referencia que la ruta no puede satisfacer —por ejemplo, un `path_regex_group` sobre una ruta sin grupos de captura— simplemente nunca coincide y la petición se deniega.",{"_3376":68985,"_29549":68870,"_20523":115194,"_5":14087,"_26884":114878,"_2862":115195},[],"Varios `param_constraints` para la misma acción se combinan con AND. Una regla sin ellos conserva el comportamiento habitual: la acción se concede donde la ruta coincida y las restricciones del principal se cumplan.",{"_3376":68986,"_29549":68870,"_20523":115197,"_5":14087,"_26884":114882,"_2862":115198},[],"La precarga de `authz` instala políticas reutilizables para los dominios principales. Entre ellas se encuentran:",{"_3376":68987,"_29549":68870,"_20523":115200,"_5":14087,"_26884":114882,"_2862":115201},[],"acceso completo y de solo lectura a certificados y autoridades;",{"_3376":68988,"_29549":68870,"_20523":115203,"_5":14087,"_26884":114882,"_2862":115204},[],"acceso completo y de solo lectura a KMS;",{"_3376":68989,"_29549":68870,"_20523":115206,"_5":14087,"_26884":114882,"_2862":115207},[],"acceso completo y de solo lectura a Device Manager, DMS Manager, Validation Authority y alertas;",{"_3376":68990,"_29549":68870,"_20523":115209,"_5":14087,"_26884":114882,"_2862":115210},[],"una política `Auditor` de lectura de PKI y visibilidad de autorización;",{"_3376":68991,"_29549":68870,"_20523":115212,"_5":14087,"_26884":114882,"_2862":115213},[],"acceso a la interfaz;",{"_3376":68992,"_29549":68870,"_20523":115215,"_5":14087,"_26884":114882,"_2862":115216},[],"políticas de administración y observación para las APIs NBI y SBI del Job Manager;",{"_3376":68993,"_29549":68870,"_20523":115218,"_5":14087,"_26884":114882,"_2862":115219},[],"`SUPER ADMIN`, que concede todas las acciones sobre los dominios `authz` y `pki`.",{"_3376":68994,"_29549":68870,"_20523":115221,"_5":14087,"_26884":114882,"_2862":115222},[],"Empieza por estas políticas antes de crear otras. Si ninguna refleja el límite que necesitas, crea una política específica y pequeña en lugar de copiar `SUPER ADMIN` y retirar permisos de forma informal.",{"_3376":68995,"_29549":68870,"_20523":115224,"_5":14087,"_26884":114886,"_2862":115225},[],"Una instalación sin un principal que coincida con tu identidad queda sin nadie capaz de administrar la autorización. Configura el IdP y el bootstrap antes de exponer la plataforma.",{"_3376":68996,"_29549":68870,"_20523":115227,"_5":14087,"_26884":114886,"_2862":115228},[],"El chart incluye un principal de bootstrap que busca el rol OIDC `pki-admin` en `realm_access.roles`. Le concede `SUPER ADMIN` y, cuando Job Manager está habilitado, la política administrativa de su API NBI.",{"_3376":68997,"_29549":68870,"_20523":115230,"_5":14087,"_26884":114886,"_2862":115231},[],"El Job Helm de preinstalación y preactualización ejecuta las migraciones de `authz`, precarga las políticas y crea los principales de bootstrap antes de iniciar los servicios. Si el principal ya existe, no lo reemplaza: añade únicamente los grants configurados que todavía falten. Puedes conservar la entrada en `values.yaml` durante las actualizaciones.",{"_3376":68998,"_29549":68870,"_20523":115233,"_5":14087,"_26884":114889,"_2862":115234},[],"Crea el rol o grupo que utilizarás para recuperar y administrar Lamassu. Asígnalo al menos a dos identidades humanas controladas. Si tu proveedor no usa `realm_access.roles`, adapta la ruta del claim tanto en el frontend como en `auth_config.claims`.",{"_3376":68999,"_29549":68870,"_20523":115236,"_5":14087,"_26884":114893,"_2862":115237},[],"`authz` valida cada token contra `services.authz.jwkUrl`, que se consulta desde el pod de `authz`. El Gateway no valida los tokens por sí mismo: los servicios de Lamassu autorizan cada petición a través de `authz`, y las rutas con la etiqueta `auth=external`, como las de Job Manager, las comprueba el Gateway a través de `authz` cuando `auth.externalAuthorization` está habilitado. El endpoint debe servir las claves del emisor configurado en `auth.oidc.frontend.authority`.",{"_3376":69000,"_29549":68870,"_20523":115239,"_5":14087,"_26884":114893,"_2862":115240},[],"Las releases actualizadas desde 3.8.0 deben eliminar `auth.oidc.apiGateway` y `auth.authorization`, que el chart 4.0.0 rechaza. Consulta 3.8.0 a 4.0.0.",{"_3376":69001,"_29549":68870,"_20523":115242,"_5":14087,"_26884":114897,"_2862":115243},[],"Inicia sesión con una identidad que tenga `pki-admin`. Confirma que puede acceder a la administración de autorización y realizar una operación de lectura no destructiva.",{"_3376":69002,"_29549":68870,"_20523":115245,"_5":14087,"_26884":114901,"_2862":115246},[],"Usa un segundo usuario sin el rol y confirma que la misma operación queda denegada. Esta prueba detecta claims mal interpretados, políticas demasiado amplias y configuraciones `failOpen` accidentales.",{"_3376":69003,"_29549":68870,"_20523":115248,"_5":14087,"_26884":114905,"_2862":115249},[],"Crea principales operativos con políticas de menor alcance. Reserva `pki-admin` para administración de autorización y recuperación, no para el trabajo diario.",{"_3376":69004,"_29549":68870,"_20523":115251,"_5":14087,"_26884":114909,"_2862":115252},[],"Fastlane instala un realm de Keycloak para laboratorio y crea el usuario `lamassu` con contraseña temporal `lamassu`, rol `pki-admin` y cambio de contraseña obligatorio. Su principal de bootstrap coincide mediante `preferred_username=lamassu`.",{"_3376":69005,"_29549":68870,"_20523":115254,"_5":14087,"_26884":114909,"_2862":115255},[],"Cambia la contraseña en el primer acceso. No reutilices el usuario, la contraseña ni el IdP de Fastlane como diseño de producción.",{"_3376":69006,"_29549":68870,"_20523":115257,"_5":14087,"_26884":114913,"_2862":115258},[],"Evita reproducir la estructura interna de tu empresa con decenas de políticas casi idénticas. Empieza por las responsabilidades que realmente necesitan acceso:",{"_3376":69007,"_29549":68870,"_20523":115260,"_5":14087,"_26884":114913,"_2862":115261},[],"**Administración de autorización**: gestiona principales, políticas y grants. Debe pertenecer a un grupo pequeño y separado.",{"_3376":69008,"_29549":68870,"_20523":115263,"_5":14087,"_26884":114913,"_2862":115264},[],"**Operación de PKI**: administra CAs, perfiles y certificados, pero no necesariamente puede modificar quién obtiene acceso.",{"_3376":69009,"_29549":68870,"_20523":115266,"_5":14087,"_26884":114913,"_2862":115267},[],"**Registro de dispositivos**: opera dispositivos y DMS sin recibir permisos sobre claves o configuración de autorización.",{"_3376":69010,"_29549":68870,"_20523":115269,"_5":14087,"_26884":114913,"_2862":115270},[],"**Auditoría**: consulta configuración y actividad sin crear, modificar, firmar, revocar ni eliminar.",{"_3376":69011,"_29549":68870,"_20523":115272,"_5":14087,"_26884":114913,"_2862":115273},[],"**Automatización**: utiliza una cuenta técnica o certificado independiente, con permisos limitados al flujo y recursos que controla.",{"_3376":69012,"_29549":68870,"_20523":115275,"_5":14087,"_26884":114913,"_2862":115276},[],"Para cada rol, separa “ver” de “cambiar”, limita los recursos mediante grants, relaciones o atributos y evita `*` salvo que el rol deba abarcar futuras acciones automáticamente.",{"_3376":69013,"_29549":68870,"_20523":115278,"_5":14087,"_26884":114913,"_2862":115279},[],"Una regla con `actions: [\"*\"]` se expande a todas las acciones definidas por el esquema. Cuando una versión nueva añade una acción, una política con comodín puede empezar a concederla. Revisa estas políticas durante cada actualización.",{"_3376":69014,"_29549":68870,"_20523":115281,"_5":14087,"_26884":114917,"_2862":115282},[],"Para retirar acceso de inmediato, desactiva el principal o revoca sus grants. Desactivar un principal conserva su configuración y asociaciones para investigación o restauración, pero deja de participar en la coincidencia.",{"_3376":69015,"_29549":68870,"_20523":115284,"_5":14087,"_26884":114917,"_2862":115285},[],"Eliminar un rol o grupo en el IdP evita que nuevos tokens contengan el claim, pero un token ya emitido puede seguir siendo válido hasta expirar. Si la retirada es urgente, combina el cambio en el IdP con la desactivación del principal en Lamassu y la revocación de sesiones o tokens en el proveedor.",{"_3376":69016,"_29549":68870,"_20523":115287,"_5":14087,"_26884":114917,"_2862":115288},[],"Cuando edites una política compartida, recuerda que el cambio afecta a todos sus principales. Para probar un nuevo alcance, crea una política separada, concédela a una identidad de prueba y valida operaciones permitidas y denegadas antes de sustituir la anterior.",{"_3376":69017,"_29549":68870,"_20523":115290,"_5":14087,"_26884":114921,"_2862":115291},[],"Mantén `failOpen: false` salvo que una evaluación de riesgo documentada justifique lo contrario.",{"_3376":69018,"_29549":68870,"_20523":115293,"_5":14087,"_26884":114921,"_2862":115294},[],"Usa grupos o roles estables para personas e identidades independientes para automatizaciones.",{"_3376":69019,"_29549":68870,"_20523":115296,"_5":14087,"_26884":114921,"_2862":115297},[],"Conserva al menos dos administradores de recuperación y prueba su acceso periódicamente.",{"_3376":69020,"_29549":68870,"_20523":115299,"_5":14087,"_26884":114921,"_2862":115300},[],"Revisa los principales activos, sus coincidencias y sus grants después de cambios en el IdP.",{"_3376":69021,"_29549":68870,"_20523":115302,"_5":14087,"_26884":114921,"_2862":115303},[],"Busca comodines en políticas antes de actualizar Lamassu.",{"_3376":69022,"_29549":68870,"_20523":115305,"_5":14087,"_26884":114921,"_2862":115306},[],"Revisa las rutas `skip_authz` y los ajustes de `default_action` de los esquemas HTTP al integrar o actualizar un servicio.",{"_3376":69023,"_29549":68870,"_20523":115308,"_5":14087,"_26884":114921,"_2862":115309},[],"Prueba siempre una operación permitida y otra denegada para cada rol.",{"_3376":69024,"_29549":68870,"_20523":115311,"_5":14087,"_26884":114921,"_2862":115312},[],"Correlaciona los cambios de principales, políticas y grants con los registros de auditoría.",{"_3376":69025,"_29549":68870,"_20523":115314,"_5":14087,"_26884":114929,"_2862":115315},[],"La autenticación falló antes de evaluar permisos. Comprueba la firma y expiración del JWT, el emisor, la audiencia y la disponibilidad del JWKS configurado en el Gateway. Para X.509, revisa que el certificado cliente llegue hasta el punto que extrae la credencial.",{"_3376":69026,"_29549":68870,"_20523":115317,"_5":14087,"_26884":114933,"_2862":115318},[],"La credencial pudo procesarse, pero no produjo una autorización positiva. Revisa en este orden:",{"_3376":69027,"_29549":68870,"_20523":115320,"_5":14087,"_26884":114933,"_2862":115321},[],"que exista un principal activo del tipo correcto;",{"_3376":69028,"_29549":68870,"_20523":115323,"_5":14087,"_26884":114933,"_2862":115324},[],"que las rutas de claims y sus valores coincidan exactamente con el token real;",{"_3376":69029,"_29549":68870,"_20523":115326,"_5":14087,"_26884":114933,"_2862":115327},[],"que todas las condiciones del principal se cumplan;",{"_3376":69030,"_29549":68870,"_20523":115329,"_5":14087,"_26884":114933,"_2862":115330},[],"que el principal tenga concedida la política esperada;",{"_3376":69031,"_29549":68870,"_20523":115332,"_5":14087,"_26884":114933,"_2862":115333},[],"que la política incluya la acción y el tipo de recurso o ruta solicitados;",{"_3376":69032,"_29549":68870,"_20523":115335,"_5":14087,"_26884":114933,"_2862":115336},[],"que el identificador, relación, filtro de columna o restricción HTTP incluya el recurso real.",{"_3376":69033,"_29549":68870,"_20523":115338,"_5":14087,"_26884":114933,"_2862":115339},[],"En los logs de `authz`, una decisión del endpoint externo incluye `allowed`, `reason`, `matched_principals`, `evaluated_policy_ids`, `matched_policy_id` y el código de estado. Estos campos permiten separar un fallo de coincidencia de un fallo de permisos. Con las trazas OpenTelemetry habilitadas, una solicitud que llega al motor de políticas genera un span `engine.CheckHTTPRequest` cuyos atributos registran `authz.allowed`, la política coincidente y el principal coincidente. Para correlacionarlo con la traza del Gateway, el contexto de traza debe propagarse hasta authz.",{"_3376":69034,"_29549":68870,"_20523":115341,"_5":14087,"_26884":114937,"_2862":115342},[],"Comprueba que el principal de bootstrap fue creado y que las políticas fueron precargadas por el Job de migración. Verifica también que `services.authz.jwkUrl` sea alcanzable desde el pod de `authz`; no asumas que una URL pública accesible desde el navegador también funciona dentro del clúster.",{"_3376":69035,"_29549":68870,"_20523":115344,"_5":14087,"_26884":114941,"_2862":115345},[],"La ruta puede estar cubierta por una decisión del esquema y no por una política: las rutas marcadas con `skip_authz` permiten el paso a cualquier identidad que coincida con un principal activo, y una petición bajo un prefijo de `base_paths` cuyo esquema fija `default_action: allow` también se concede sin consultar políticas. Comprueba cuál de las dos situaciones aplica antes de buscar grants ausentes o mal asignados.",{"_3376":69036,"_29549":68870,"_20523":115347,"_5":14087,"_26884":114945,"_2862":115348},[],"Es el comportamiento esperado con `failOpen: false`. Restaura el servicio, su conexión con PostgreSQL y su conectividad con el JWKS. No cambies temporalmente a `failOpen: true` sin aceptar que las rutas protegidas podrían quedar accesibles sin decisión de autorización.",{"_3376":69037,"_29549":68870,"_20523":115350,"_5":14087,"_26884":114945,"_2862":115351},[],"Continúa con Registros de auditoría para investigar cambios de configuración o con Resolución de problemas para diagnosticar el despliegue.",{"_3376":69038,"_29549":69038,"_5":14445,"_2862":115353,"_29881":115354,"_20523":115355,"_26884":69038},"Alertas y suscripciones",[48111,114818,114819],[],{"_3376":69039,"_29549":69038,"_20523":115357,"_5":14087,"_26884":69038,"_2862":115358},[],"Envía eventos de la PKI a personas y sistemas externos.",{"_3376":69040,"_29549":69038,"_5":29878,"_20523":115360,"_26884":115361,"_2862":115362},[],"/docs/es/platform/administration/alerts#cómo-funciona","Cómo funciona",{"_3376":69041,"_29549":69038,"_5":29878,"_20523":115364,"_26884":115365,"_2862":115366},[],"/docs/es/platform/administration/alerts#canales-disponibles","Canales disponibles",{"_3376":69042,"_29549":69038,"_5":29878,"_20523":115368,"_26884":115369,"_2862":115370},[],"/docs/es/platform/administration/alerts#crea-una-suscripción","Crea una suscripción",{"_3376":69043,"_29549":69038,"_5":29878,"_20523":115372,"_26884":115373,"_2862":115374},[],"/docs/es/platform/administration/alerts#elige-el-evento","Elige el evento",{"_3376":69044,"_29549":69038,"_5":29878,"_20523":115376,"_26884":115377,"_2862":115378},[],"/docs/es/platform/administration/alerts#configura-el-destino","Configura el destino",{"_3376":69045,"_29549":69038,"_5":29878,"_20523":115380,"_26884":115381,"_2862":115382},[],"/docs/es/platform/administration/alerts#limita-las-notificaciones","Limita las notificaciones",{"_3376":69046,"_29549":69038,"_5":29878,"_20523":115384,"_26884":115385,"_2862":115386},[],"/docs/es/platform/administration/alerts#revisa-y-activa","Revisa y activa",{"_3376":69047,"_29549":69038,"_5":29878,"_20523":115388,"_26884":115389,"_2862":115390},[],"/docs/es/platform/administration/alerts#configura-el-cliente-http-del-webhook","Configura el cliente HTTP del webhook",{"_3376":69048,"_29549":69038,"_5":29878,"_20523":115392,"_26884":115393,"_2862":115394},[],"/docs/es/platform/administration/alerts#reglas-de-entrega-del-webhook","Reglas de entrega del webhook",{"_3376":69049,"_29549":69038,"_5":29878,"_20523":115396,"_26884":115397,"_2862":115398},[],"/docs/es/platform/administration/alerts#gestiona-una-suscripción","Gestiona una suscripción",{"_3376":69050,"_29549":69038,"_5":29878,"_20523":115400,"_26884":115401,"_2862":115402},[],"/docs/es/platform/administration/alerts#familias-de-eventos","Familias de eventos",{"_3376":69051,"_29549":69038,"_20523":115404,"_5":14087,"_26884":69038,"_2862":115405},[],"Las suscripciones convierten los eventos de Lamassu en notificaciones accionables. Puedes avisar a un equipo, alimentar un sistema de incidentes o activar una automatización cuando cambia una CA, un certificado o un dispositivo.",{"_3376":69052,"_29549":69038,"_20523":115407,"_5":14087,"_26884":115361,"_2862":115408},[],"Un servicio publica un evento de dominio.",{"_3376":69053,"_29549":69038,"_20523":115410,"_5":14087,"_26884":115361,"_2862":115411},[],"Lamassu evalúa las suscripciones asociadas a ese tipo de evento.",{"_3376":69054,"_29549":69038,"_20523":115413,"_5":14087,"_26884":115361,"_2862":115414},[],"El filtro de cada suscripción decide si debe notificarse.",{"_3376":69055,"_29549":69038,"_20523":115416,"_5":14087,"_26884":115361,"_2862":115417},[],"Lamassu entrega el evento al canal configurado.",{"_3376":69056,"_29549":69038,"_20523":115419,"_5":14087,"_26884":115361,"_2862":115420},[],"El inventario de eventos muestra cuándo se observó cada tipo por última vez, cuántas veces ha ocurrido y cuántas suscripciones tiene. Puedes expandir un evento para inspeccionar un ejemplo de su payload JSON antes de crear el filtro.",{"_3376":69057,"_29549":69038,"_20523":115422,"_5":14087,"_26884":115365,"_2862":115423},[],"**Email** envía avisos a una persona o lista operativa. Solo requiere la dirección de destino. El contenido del evento se entrega como texto HTML escapado, nunca como marcado.",{"_3376":69058,"_29549":69038,"_20523":115425,"_5":14087,"_26884":115365,"_2862":115426},[],"**Microsoft Teams** publica la notificación en un canal mediante su URL de webhook.",{"_3376":69059,"_29549":69038,"_20523":115428,"_5":14087,"_26884":115365,"_2862":115429},[],"**Webhook** entrega el evento a una automatización, SIEM o sistema de incidentes mediante `POST` o `PUT`.",{"_3376":69060,"_29549":69038,"_20523":115431,"_5":14087,"_26884":115365,"_2862":115432},[],"Los canales Microsoft Teams y Webhook aceptan un bloque opcional `http_client` que autentica la llamada al receptor. `auth_mode` selecciona `noauth` (por defecto), `apikey`, `jwt` o `mtls`; cada modo exige sus propias opciones:",{"_3376":69061,"_29549":69038,"_20523":115434,"_5":14087,"_26884":115365,"_2862":115435},[],"`apikey_options` necesita `header` y `key`.",{"_3376":69062,"_29549":69038,"_20523":115437,"_5":14087,"_26884":115365,"_2862":115438},[],"`jwt_options` necesita `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3376":69063,"_29549":69038,"_20523":115440,"_5":14087,"_26884":115365,"_2862":115441},[],"`mtls_options` necesita `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro. Los valores que referencian archivos del servidor se rechazan, y el par debe corresponder a un certificado y una clave privada coincidentes.",{"_3376":69064,"_29549":69038,"_20523":115443,"_5":14087,"_26884":115365,"_2862":115444},[],"La referencia de la API de Alerts documenta el esquema completo de `http_client`.",{"_3376":69065,"_29549":69038,"_20523":115446,"_5":14087,"_26884":115373,"_2862":115447},[],"Abre **Alerts**, localiza el tipo de evento y selecciona **Subscribe**. Revisa el último ejemplo JSON para identificar los campos que necesitarás filtrar.",{"_3376":69066,"_29549":69038,"_20523":115449,"_5":14087,"_26884":115377,"_2862":115450},[],"Selecciona Email, Microsoft Teams o Webhook e introduce los datos del canal.",{"_3376":69067,"_29549":69038,"_20523":115452,"_5":14087,"_26884":115381,"_2862":115453},[],"Añade un filtro si no quieres recibir todas las instancias del evento.",{"_3376":69068,"_29549":69038,"_20523":115455,"_5":14087,"_26884":115381,"_2862":115456},[],"**None** notifica todas las instancias del evento.",{"_3376":69069,"_29549":69038,"_20523":115458,"_5":14087,"_26884":115381,"_2862":115459},[],"**JSON Path** evalúa uno o varios campos concretos.",{"_3376":69070,"_29549":69038,"_20523":115461,"_5":14087,"_26884":115381,"_2862":115462},[],"**JSON Schema** acepta únicamente payloads con una estructura determinada.",{"_3376":69071,"_29549":69038,"_20523":115464,"_5":14087,"_26884":115381,"_2862":115465},[],"**JavaScript** permite expresar lógica personalizada. Cada filtro se ejecuta como máximo durante 100 milisegundos; un filtro que supera ese límite hace fallar la condición y la notificación se omite con el error `javascript filter execution timed out`.",{"_3376":69072,"_29549":69038,"_20523":115467,"_5":14087,"_26884":115381,"_2862":115468},[],"Por ejemplo, `function (event) { return event.data.status == \"NO_IDENTITY\"; }` limita una suscripción a dispositivos sin identidad.",{"_3376":69073,"_29549":69038,"_20523":115470,"_5":14087,"_26884":115381,"_2862":115471},[],"La consola evalúa el filtro contra el JSON del editor **Input Event**, que está prellenado con el último evento, e indica si coincide. Para los filtros JSON Path y JavaScript, muestra **The filter matches this Cloud Event** o **The filter does not match this Cloud Event**. Las expresiones JSON Path se evalúan sobre el Cloud Event completo, así que el valor por defecto, `$.data`, selecciona el campo `data` del evento, y la expresión debe empezar por `$`.",{"_3376":69074,"_29549":69038,"_20523":115473,"_5":14087,"_26884":115385,"_2862":115474},[],"Comprueba el evento, el canal y el filtro en el resumen. Selecciona **Confirm Subscription** para comenzar la entrega.",{"_3376":69075,"_29549":69038,"_20523":115476,"_5":14087,"_26884":115389,"_2862":115477},[],"Los canales Webhook y Microsoft Teams muestran esta configuración en el formulario de suscripción, en el paso del canal, y de nuevo al editar una suscripción; Email no la utiliza. Los campos se corresponden con el bloque opcional `http_client` descrito arriba:",{"_3376":69076,"_29549":69038,"_20523":115479,"_5":14087,"_26884":115389,"_2862":115480},[],"**Log Level** selecciona `debug`, `info`, `warn` o `error`; `info` es el valor por defecto.",{"_3376":69077,"_29549":69038,"_20523":115482,"_5":14087,"_26884":115389,"_2862":115483},[],"**Call Timeout** es de 10 segundos por defecto. La consola rechaza un valor superior a 30 segundos con `Webhook timeout must be at most 30s.`; la API ajusta ese mismo valor al tope en lugar de rechazarlo (ver Las llamadas están limitadas).",{"_3376":69078,"_29549":69038,"_20523":115485,"_5":14087,"_26884":115389,"_2862":115486},[],"No hay interruptor de verificación TLS para estos canales, porque el servicio siempre verifica el certificado del receptor (ver TLS siempre se verifica).",{"_3376":69079,"_29549":69038,"_20523":115488,"_5":14087,"_26884":115389,"_2862":115489},[],"**HTTP Authentication** selecciona `No Authentication` (por defecto), `API Key` (valor de la API key y Header Name, `X-API-Key` por defecto), `OIDC Client Credentials` (Client ID, Client Secret y Well-Known URL) o `Mutual TLS` (Client Certificate y Client Private Key pegados como PEM). Una clave privada guardada permanece oculta hasta que seleccionas **Show**.",{"_3376":69080,"_29549":69038,"_20523":115491,"_5":14087,"_26884":115389,"_2862":115492},[],"Una URL `http://` muestra en la consola la advertencia `Unencrypted HTTP connection` (ver la llamada Credenciales sobre http\\:// más abajo).",{"_3376":69081,"_29549":69038,"_20523":115494,"_5":14087,"_26884":115389,"_2862":115495},[],"Los campos se validan en línea con las mismas reglas de entrega: la URL del webhook y la Well-Known URL de OIDC deben ser URLs absolutas `http` o `https`, una cabecera API-key no puede usar un nombre reservado y el certificado y la clave mTLS deben ser contenido PEM, no rutas de ficheros.",{"_3376":69082,"_29549":69038,"_20523":115497,"_5":14087,"_26884":115389,"_2862":115498},[],"El resumen del paso de confirmación muestra la autenticación como `None`, `OIDC client credentials`, `API key` o `Mutual TLS`. Los detalles de la suscripción muestran la autenticación, el nombre de la cabecera API-key (nunca el valor), la URL del emisor OIDC, mTLS como `Configured` y una fila fija `TLS verification: Verified`. La API key, el client secret y la clave privada no se muestran en los detalles de la suscripción.",{"_3376":69083,"_29549":69038,"_20523":115500,"_5":14087,"_26884":115393,"_2862":115501},[],"Las notificaciones enviadas por los canales Microsoft Teams y Webhook siguen una política HTTP fija:",{"_3376":69084,"_29549":69038,"_20523":115503,"_5":14087,"_26884":115393,"_2862":115504},[],"**TLS siempre se verifica.** El certificado del receptor se comprueba contra el almacén de confianza del sistema. `insecure_skip_verify` se aplica siempre como `false` — también cuando se establece en `true` — así que un receptor con certificado propio o no confiable falla la entrega.",{"_3376":69085,"_29549":69038,"_20523":115506,"_5":14087,"_26884":115393,"_2862":115507},[],"**No se siguen redirecciones.** Una respuesta `3xx` falla con `unexpected status code: <n>: redirects are not followed`. Configura `webhook_url` con la URL final absoluta `http` o `https`: una dirección `http://` que un ingress redirige a `https://` deja de funcionar.",{"_3376":69086,"_29549":69038,"_20523":115509,"_5":14087,"_26884":115393,"_2862":115510},[],"**Las llamadas están limitadas.** Una llamada tiene por defecto un timeout de 10 segundos; un `call_timeout` configurado se limita a 30 segundos. Los valores por encima del tope se ajustan, no se rechazan.",{"_3376":69087,"_29549":69038,"_20523":115512,"_5":14087,"_26884":115393,"_2862":115513},[],"**El cuerpo de la respuesta se ignora.** La entrega comprueba solo el código de estado, así que el receptor puede responder con cualquier cuerpo.",{"_3376":69088,"_29549":69038,"_20523":115515,"_5":14087,"_26884":115393,"_2862":115516},[],"**Las cabeceras API-key están restringidas.** Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o los servicios receptores confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-`. La comparación no distingue mayúsculas.",{"_3376":69089,"_29549":69038,"_20523":115518,"_5":14087,"_26884":115393,"_2862":115519},[],"**Las configuraciones inválidas se rechazan al suscribir.** Una configuración de canal que fallaría en cada entrega devuelve HTTP 400 con un cuerpo que empieza por `struct validation error:` y la suscripción no se crea.",{"_3376":69090,"_29549":69038,"_20523":115521,"_5":14087,"_26884":115393,"_2862":115522},[],"Las credenciales se envían sea cual sea el esquema de la URL. Con un `webhook_url` `http://`, la API key o el bearer token viajan en texto claro y mTLS no tiene efecto. Prefiere `https://` para `webhook_url`, `oidc_well_known` y el token endpoint que anuncia.",{"_3376":69091,"_29549":69038,"_20523":115524,"_5":14087,"_26884":115397,"_2862":115525},[],"Abre una suscripción existente para consultar su destino y filtro, modificar la configuración o seleccionar **Unsubscribe**. Elimina las suscripciones que ya no tengan un propietario operativo para evitar entregas ignoradas o endpoints obsoletos.",{"_3376":69092,"_29549":69038,"_20523":115527,"_5":14087,"_26884":115397,"_2862":115528},[],"Las suscripciones creadas con versiones anteriores de la consola pueden guardar el destino del webhook en `url` y `method` en lugar de `webhook_url` y `webhook_method`. El servicio entrega solo a través de `webhook_url` y `webhook_method`, así que una suscripción así no entrega aunque los detalles de la suscripción muestren el destino guardado. Abre la suscripción y vuelve a guardarla: el formulario de edición precarga el destino guardado, y al guardar se reescribe la configuración del canal con el formato actual.",{"_3376":69093,"_29549":69038,"_20523":115530,"_5":14087,"_26884":115401,"_2862":115531},[],"**Autoridades:** `ca.create`, `ca.import`, `ca.reissue` y `ca.delete`.",{"_3376":69094,"_29549":69038,"_20523":115533,"_5":14087,"_26884":115401,"_2862":115534},[],"**Certificados:** `ca.sign.certificate` y `certificate.delete`.",{"_3376":69095,"_29549":69038,"_20523":115536,"_5":14087,"_26884":115401,"_2862":115537},[],"**Perfiles:** `profile.issuance.create`, `profile.issuance.update` y `profile.issuance.delete`.",{"_3376":69096,"_29549":69038,"_20523":115539,"_5":14087,"_26884":115401,"_2862":115540},[],"**Enrolamiento:** `dms.create`, `dms.update`, `dms.enroll` y `dms.reenroll`.",{"_3376":69097,"_29549":69038,"_20523":115542,"_5":14087,"_26884":115401,"_2862":115543},[],"**Dispositivos:** `device.create`, `device.identity.update` y `device.status.update`.",{"_3376":69098,"_29549":69038,"_20523":115545,"_5":14087,"_26884":115401,"_2862":115546},[],"**Validación:** `va.role.crl.create`.",{"_3376":69099,"_29549":69038,"_20523":115548,"_5":14087,"_26884":115401,"_2862":115549},[],"**Claves:** `kms.create`, `kms.import`, `kms.sign` y `kms.delete`.",{"_3376":69100,"_29549":69038,"_20523":115551,"_5":14087,"_26884":115401,"_2862":115552},[],"Utiliza el catálogo que muestra la consola como fuente para los tipos disponibles en la versión que tienes desplegada.",{"_3376":69101,"_29549":69101,"_5":14445,"_2862":115554,"_29881":115555,"_20523":115556,"_26884":69101},"Registros de auditoría",[48111,114818,114819],[],{"_3376":69102,"_29549":69101,"_20523":115558,"_5":14087,"_26884":69101,"_2862":115559},[],"Entiende qué eventos de auditoría genera Lamassu y cómo convertirlos en una pista durable.",{"_3376":69103,"_29549":69101,"_5":29878,"_20523":115561,"_26884":115562,"_2862":115563},[],"/docs/es/platform/administration/audit-logs#qué-contiene-un-evento","Qué contiene un evento",{"_3376":69104,"_29549":69101,"_5":29878,"_20523":115565,"_26884":115566,"_2862":115567},[],"/docs/es/platform/administration/audit-logs#cobertura","Cobertura",{"_3376":69105,"_29549":69101,"_5":29878,"_20523":115569,"_26884":115570,"_2862":115571},[],"/docs/es/platform/administration/audit-logs#publicación-y-persistencia","Publicación y persistencia",{"_3376":69106,"_29549":69101,"_5":29878,"_20523":115573,"_26884":115574,"_2862":115575},[],"/docs/es/platform/administration/audit-logs#datos-sensibles","Datos sensibles",{"_3376":69107,"_29549":69101,"_5":29878,"_20523":115577,"_26884":115578,"_2862":115579},[],"/docs/es/platform/administration/audit-logs#una-investigación-reproducible","Una investigación reproducible",{"_3376":69108,"_29549":69101,"_5":29878,"_20523":115581,"_26884":115582,"_2862":115583},[],"/docs/es/platform/administration/audit-logs#acota-el-intervalo","Acota el intervalo",{"_3376":69109,"_29549":69101,"_5":29878,"_20523":115585,"_26884":115586,"_2862":115587},[],"/docs/es/platform/administration/audit-logs#identifica-la-operación","Identifica la operación",{"_3376":69110,"_29549":69101,"_5":29878,"_20523":115589,"_26884":115590,"_2862":115591},[],"/docs/es/platform/administration/audit-logs#atribuye-el-principal","Atribuye el principal",{"_3376":69111,"_29549":69101,"_5":29878,"_20523":115593,"_26884":115594,"_2862":115595},[],"/docs/es/platform/administration/audit-logs#compara-intención-y-resultado","Compara intención y resultado",{"_3376":69112,"_29549":69101,"_5":29878,"_20523":115597,"_26884":115598,"_2862":115599},[],"/docs/es/platform/administration/audit-logs#sigue-el-efecto","Sigue el efecto",{"_3376":69113,"_29549":69101,"_5":29878,"_20523":115601,"_26884":115602,"_2862":115603},[],"/docs/es/platform/administration/audit-logs#verificación-periódica","Verificación periódica",{"_3376":69114,"_29549":69101,"_20523":115605,"_5":14087,"_26884":69101,"_2862":115606},[],"Lamassu instrumenta las operaciones mutables de sus servicios con eventos de auditoría. Cada evento describe la operación, los principales que coincidieron, la entrada, el resultado y si terminó con error.",{"_3376":69115,"_29549":69101,"_20523":115608,"_5":14087,"_26884":115562,"_2862":115609},[],"El cuerpo de auditoría incluye:",{"_3376":69116,"_29549":69101,"_20523":115611,"_5":14087,"_26884":115562,"_2862":115612},[],"input: datos recibidos por la operación;",{"_3376":69117,"_29549":69101,"_20523":115614,"_5":14087,"_26884":115562,"_2862":115615},[],"has\\_error: indica si el servicio devolvió un error;",{"_3376":69118,"_29549":69101,"_20523":115617,"_5":14087,"_26884":115562,"_2862":115618},[],"output: resultado producido o mensaje de error;",{"_3376":69119,"_29549":69101,"_20523":115620,"_5":14087,"_26884":115562,"_2862":115621},[],"principals: identificadores de los principales que coincidieron con la petición.",{"_3376":69120,"_29549":69101,"_20523":115623,"_5":14087,"_26884":115562,"_2862":115624},[],"Las operaciones correctas usan un tipo con prefijo audit.. Los fallos publican el tipo de operación con sufijo .error. El evento CloudEvents añade, además, fuente, identificador, fecha y tipo.",{"_3376":69121,"_29549":69101,"_20523":115626,"_5":14087,"_26884":115562,"_2862":115627},[],"Los middlewares publican el registro después de ejecutar la operación, tanto si tuvo éxito como si devolvió un error. Esto permite investigar intentos además de cambios confirmados.",{"_3376":69122,"_29549":69101,"_20523":115629,"_5":14087,"_26884":115566,"_2862":115630},[],"El backend aplica auditoría a mutaciones de:",{"_3376":69123,"_29549":69101,"_20523":115632,"_5":14087,"_26884":115566,"_2862":115633},[],"autoridades, certificados y perfiles de emisión;",{"_3376":69124,"_29549":69101,"_20523":115635,"_5":14087,"_26884":115566,"_2862":115636},[],"claves y motores KMS;",{"_3376":69125,"_29549":69101,"_20523":115638,"_5":14087,"_26884":115566,"_2862":115639},[],"dispositivos e identidades;",{"_3376":69126,"_29549":69101,"_20523":115641,"_5":14087,"_26884":115566,"_2862":115642},[],"DMS y operaciones de enrolamiento;",{"_3376":69127,"_29549":69101,"_20523":115644,"_5":14087,"_26884":115566,"_2862":115645},[],"funciones de validación y CRL;",{"_3376":69128,"_29549":69101,"_20523":115647,"_5":14087,"_26884":115566,"_2862":115648},[],"principales, políticas y concesiones de autorización.",{"_3376":69129,"_29549":69101,"_20523":115650,"_5":14087,"_26884":115566,"_2862":115651},[],"No confundas estos eventos con los eventos de dominio. Un evento de dominio comunica que un recurso cambió para que otro componente reaccione; el evento de auditoría conserva contexto de entrada, salida y principal para investigación.",{"_3376":69130,"_29549":69101,"_20523":115653,"_5":14087,"_26884":115570,"_2862":115654},[],"Los servicios publican auditoría en el bus de eventos cuando su PublisherEventBus está habilitado. El código del backend no implementa un archivo de auditoría consultable y durable por sí solo.",{"_3376":69131,"_29549":69101,"_20523":115656,"_5":14087,"_26884":115570,"_2862":115657},[],"Si necesitas retención, búsquedas, protección contra alteraciones o exportación regulatoria, conecta un consumidor que persista los eventos en el sistema aprobado por tu organización.",{"_3376":69132,"_29549":69101,"_20523":115659,"_5":14087,"_26884":115570,"_2862":115660},[],"Diseña el consumidor para:",{"_3376":69133,"_29549":69101,"_20523":115662,"_5":14087,"_26884":115570,"_2862":115663},[],"suscribirse a los tipos audit.# y también a los tipos de operación terminados en .error;",{"_3376":69134,"_29549":69101,"_20523":115665,"_5":14087,"_26884":115570,"_2862":115666},[],"conservar el CloudEvent completo sin modificar;",{"_3376":69135,"_29549":69101,"_20523":115668,"_5":14087,"_26884":115570,"_2862":115669},[],"registrar el momento de ingestión y detectar duplicados por ID;",{"_3376":69136,"_29549":69101,"_20523":115671,"_5":14087,"_26884":115570,"_2862":115672},[],"cifrar en tránsito y en reposo;",{"_3376":69137,"_29549":69101,"_20523":115674,"_5":14087,"_26884":115570,"_2862":115675},[],"limitar lectura y borrado a un rol separado del operador de PKI;",{"_3376":69138,"_29549":69101,"_20523":115677,"_5":14087,"_26884":115570,"_2862":115678},[],"aplicar una política explícita de retención y legal hold;",{"_3376":69139,"_29549":69101,"_20523":115680,"_5":14087,"_26884":115570,"_2862":115681},[],"alertar si deja de consumir o aumenta la cola pendiente.",{"_3376":69140,"_29549":69101,"_20523":115683,"_5":14087,"_26884":115574,"_2862":115684},[],"Los campos input y output pueden contener sujetos, metadatos, material público, configuración o mensajes de error. Evalúa su clasificación antes de enviarlos a una plataforma externa.",{"_3376":69141,"_29549":69101,"_20523":115686,"_5":14087,"_26884":115574,"_2862":115687},[],"No registres claves privadas, secretos de proveedores ni tokens completos en automatizaciones que rodean a Lamassu. Restringe la exportación y aplica redacción en el destino sin destruir los campos necesarios para atribución.",{"_3376":69142,"_29549":69101,"_20523":115689,"_5":14087,"_26884":115582,"_2862":115690},[],"Parte de la hora reportada y normaliza todas las fuentes a UTC.",{"_3376":69143,"_29549":69101,"_20523":115692,"_5":14087,"_26884":115586,"_2862":115693},[],"Filtra por tipo de evento, fuente de servicio e identificador del recurso.",{"_3376":69144,"_29549":69101,"_20523":115695,"_5":14087,"_26884":115590,"_2862":115696},[],"Revisa principals y correlaciónalo con el proveedor OIDC o la identidad X.509 vigente en ese momento.",{"_3376":69145,"_29549":69101,"_20523":115698,"_5":14087,"_26884":115594,"_2862":115699},[],"Contrasta input, has\\_error y output. Un intento fallido no implica que el recurso haya cambiado.",{"_3376":69146,"_29549":69101,"_20523":115701,"_5":14087,"_26884":115598,"_2862":115702},[],"Busca los eventos de dominio y registros del servicio que compartan recurso y ventana temporal. En una revocación de CA, incluye las operaciones en cascada.",{"_3376":69147,"_29549":69101,"_20523":115704,"_5":14087,"_26884":115602,"_2862":115705},[],"Genera una mutación controlada en un entorno de prueba y comprueba que:",{"_3376":69148,"_29549":69101,"_20523":115707,"_5":14087,"_26884":115602,"_2862":115708},[],"aparece un evento de auditoría correcto;",{"_3376":69149,"_29549":69101,"_20523":115710,"_5":14087,"_26884":115602,"_2862":115711},[],"el principal coincide con la identidad utilizada;",{"_3376":69150,"_29549":69101,"_20523":115713,"_5":14087,"_26884":115602,"_2862":115714},[],"el consumidor lo persiste una sola vez;",{"_3376":69151,"_29549":69101,"_20523":115716,"_5":14087,"_26884":115602,"_2862":115717},[],"puede recuperarse por recurso, actor y periodo;",{"_3376":69152,"_29549":69101,"_20523":115719,"_5":14087,"_26884":115602,"_2862":115720},[],"una interrupción del consumidor produce una alerta.",{"_3376":69153,"_29549":69101,"_20523":115722,"_5":14087,"_26884":115602,"_2862":115723},[],"Para métricas, trazas y logs técnicos del despliegue, consulta Resolución de problemas. La auditoría responde a “quién intentó cambiar qué”; la observabilidad explica cómo se comportó el sistema.",{"_3376":69154,"_29549":69154,"_5":14445,"_2862":115725,"_29881":115726,"_20523":115727,"_26884":69154},"Arquitectura de la plataforma",[48111,114818],[],{"_3376":69155,"_29549":69154,"_20523":115729,"_5":14087,"_26884":69154,"_2862":115730},[],"Componentes de Lamassu y relación entre control, claves, emisión y dispositivos.",{"_3376":69156,"_29549":69154,"_5":29878,"_20523":115732,"_26884":115733,"_2862":115734},[],"/docs/es/platform/concepts/architecture#plano-de-control","Plano de control",{"_3376":69157,"_29549":69154,"_5":29878,"_20523":115736,"_26884":115737,"_2862":115738},[],"/docs/es/platform/concepts/architecture#custodia-y-operaciones-criptográficas","Custodia y operaciones criptográficas",{"_3376":69158,"_29549":69154,"_5":29878,"_20523":115740,"_26884":115741,"_2862":115742},[],"/docs/es/platform/concepts/architecture#emisión-y-enrolamiento","Emisión y enrolamiento",{"_3376":69159,"_29549":69154,"_5":29878,"_20523":115744,"_26884":115745,"_2862":115746},[],"/docs/es/platform/concepts/architecture#estado-y-validación","Estado y validación",{"_3376":69160,"_29549":69154,"_5":29878,"_20523":115748,"_26884":115749,"_2862":115750},[],"/docs/es/platform/concepts/architecture#dependencias-de-la-plataforma","Dependencias de la plataforma",{"_3376":69161,"_29549":69154,"_20523":115752,"_5":14087,"_26884":69154,"_2862":115753},[],"Lamassu se despliega como un conjunto de servicios independientes. La separación evita que todos los componentes necesiten acceso directo a las claves privadas y permite escalar cada capacidad según la carga.",{"_3376":69162,"_29549":69154,"_20523":115755,"_5":14087,"_26884":69154,"_2862":115756},[],"Cambia al nivel bajo para ver el interior de la caja de la plataforma Lamassu (CA, KMS, DMS, Device Manager, VA, Alerts, el conector de AWS IoT, Job Manager y la consola/API), y al nivel medio para verla como una única plataforma junto a sus dependencias externas.",{"_3376":69163,"_29549":69154,"_20523":115758,"_5":14087,"_26884":115733,"_2862":115759},[],"La consola y las APIs administran autoridades, certificados, DMS, dispositivos, alertas y configuración. Los eventos de dominio permiten que conectores y automatizaciones reaccionen a los cambios sin sondear continuamente la plataforma.",{"_3376":69164,"_29549":69154,"_20523":115761,"_5":14087,"_26884":115737,"_2862":115762},[],"El KMS ofrece una interfaz común sobre motores software, PKCS#11 y proveedores cloud. El motor seleccionado conserva la clave o delega la operación criptográfica sin que los demás servicios conozcan su implementación.",{"_3376":69165,"_29549":69154,"_20523":115764,"_5":14087,"_26884":115741,"_2862":115765},[],"El servicio de CA emite certificados y mantiene la relación con su autoridad. El DMS aplica las reglas de enrolamiento y expone los flujos EST para que un dispositivo solicite o renueve una identidad.",{"_3376":69166,"_29549":69154,"_20523":115767,"_5":14087,"_26884":115745,"_2862":115768},[],"Device Manager conserva la vista operativa del dispositivo y su historial. Validation Authority publica OCSP y CRLs para que otros sistemas decidan si deben confiar en un certificado presentado.",{"_3376":69167,"_29549":69154,"_20523":115770,"_5":14087,"_26884":115749,"_2862":115771},[],"En un despliegue autogestionado, Lamassu utiliza PostgreSQL para persistencia, RabbitMQ para mensajería y un proveedor OIDC para autenticación. Consulta la arquitectura de despliegue para ver cómo se publican los servicios en Kubernetes.",{"_3376":69168,"_29549":69168,"_5":14445,"_2862":115773,"_29881":115774,"_20523":115775,"_26884":69168},"Cómo funciona Lamassu",[48111,114818],[],{"_3376":69169,"_29549":69168,"_20523":115777,"_5":14087,"_26884":69168,"_2862":115778},[],"El modelo mental de confianza, claves, certificados y dispositivos.",{"_3376":69170,"_29549":69168,"_5":29878,"_20523":115780,"_26884":115781,"_2862":115782},[],"/docs/es/platform/concepts/overview#el-modelo-en-cinco-piezas","El modelo en cinco piezas",{"_3376":69171,"_29549":69168,"_5":29878,"_20523":115784,"_26884":115785,"_2862":115786},[],"/docs/es/platform/concepts/overview#del-alta-a-la-operación","Del alta a la operación",{"_3376":69172,"_29549":69168,"_20523":115788,"_5":14087,"_26884":69168,"_2862":115789},[],"Lamassu conecta tres elementos: una **raíz de confianza**, una **política de emisión** y una **entidad que necesita demostrar su identidad**. La plataforma coordina esos elementos durante todo el ciclo de vida del certificado.",{"_3376":69173,"_29549":69168,"_20523":115791,"_5":14087,"_26884":115781,"_2862":115792},[],"**Motor criptográfico.** Genera o custodia claves y ejecuta las operaciones privadas sin exponer el material criptográfico al resto de servicios.",{"_3376":69174,"_29549":69168,"_20523":115794,"_5":14087,"_26884":115781,"_2862":115795},[],"**Autoridad de certificación (CA).** Firma certificados y establece la cadena de confianza.",{"_3376":69175,"_29549":69168,"_20523":115797,"_5":14087,"_26884":115781,"_2862":115798},[],"**Device Management Service (DMS).** Define cómo se registran, autentican y renuevan los dispositivos de una flota.",{"_3376":69176,"_29549":69168,"_20523":115800,"_5":14087,"_26884":115781,"_2862":115801},[],"**Dispositivo.** Conserva su clave privada y presenta el certificado para demostrar su identidad.",{"_3376":69177,"_29549":69168,"_20523":115803,"_5":14087,"_26884":115781,"_2862":115804},[],"**Validation Authority (VA).** Publica el estado de los certificados mediante OCSP y CRL.",{"_3376":69178,"_29549":69168,"_20523":115806,"_5":14087,"_26884":115785,"_2862":115807},[],"Un administrador configura un motor criptográfico y crea o importa una CA.",{"_3376":69179,"_29549":69168,"_20523":115809,"_5":14087,"_26884":115785,"_2862":115810},[],"Un DMS relaciona esa CA con una política de enrolamiento.",{"_3376":69180,"_29549":69168,"_20523":115812,"_5":14087,"_26884":115785,"_2862":115813},[],"El dispositivo genera una clave y solicita un certificado mediante EST, o un operador le asigna una identidad.",{"_3376":69181,"_29549":69168,"_20523":115815,"_5":14087,"_26884":115785,"_2862":115816},[],"Lamassu conserva el inventario, el historial y el estado de la identidad.",{"_3376":69182,"_29549":69168,"_20523":115818,"_5":14087,"_26884":115785,"_2862":115819},[],"Los consumidores comprueban la cadena y consultan OCSP o una CRL cuando necesitan conocer su vigencia.",{"_3376":69183,"_29549":69168,"_20523":115821,"_5":14087,"_26884":115785,"_2862":115822},[],"<Card title=\"Arquitectura\" description=\"Conoce los componentes y dónde termina la responsabilidad de cada uno.\" href=\"/docs/platform/concepts/architecture\" />",{"_3376":69184,"_29549":69168,"_20523":115824,"_5":14087,"_26884":115785,"_2862":115825},[],"<Card title=\"Ciclo de vida de una identidad\" description=\"Sigue un certificado desde el enrolamiento hasta la renovación o revocación.\" href=\"/docs/platform/pki/concepts/certificate-lifecycle\" />",{"_3376":69185,"_29549":69185,"_5":14445,"_2862":115827,"_29881":115828,"_20523":115829,"_26884":69185},"Dispositivos e identidades",[48111,114818,50590,115827],[],{"_3376":69186,"_29549":69185,"_20523":115831,"_5":14087,"_26884":69185,"_2862":115832},[],"Registra, inspecciona y retira dispositivos comprobando su identidad actual y su historial.",{"_3376":69187,"_29549":69185,"_5":29878,"_20523":115834,"_26884":115835,"_2862":115836},[],"/docs/es/platform/iot-fleets/device-management#estados-del-dispositivo","Estados del dispositivo",{"_3376":69188,"_29549":69185,"_5":29878,"_20523":115838,"_26884":115839,"_2862":115840},[],"/docs/es/platform/iot-fleets/device-management#inspecciona-un-dispositivo","Inspecciona un dispositivo",{"_3376":69189,"_29549":69185,"_5":29878,"_20523":115842,"_26884":115843,"_2862":115844},[],"/docs/es/platform/iot-fleets/device-management#registra-un-dispositivo-manualmente","Registra un dispositivo manualmente",{"_3376":69190,"_29549":69185,"_5":29878,"_20523":115846,"_26884":115847,"_2862":115848},[],"/docs/es/platform/iot-fleets/device-management#crea-el-dispositivo","Crea el dispositivo",{"_3376":69191,"_29549":69185,"_5":29878,"_20523":115850,"_26884":115851,"_2862":115852},[],"/docs/es/platform/iot-fleets/device-management#define-su-pertenencia","Define su pertenencia",{"_3376":69192,"_29549":69185,"_5":29878,"_20523":115854,"_26884":115855,"_2862":115856},[],"/docs/es/platform/iot-fleets/device-management#clasifica-el-dispositivo","Clasifica el dispositivo",{"_3376":69193,"_29549":69185,"_5":29878,"_20523":115858,"_26884":115859,"_2862":115860},[],"/docs/es/platform/iot-fleets/device-management#verifica-el-alta","Verifica el alta",{"_3376":69194,"_29549":69185,"_5":29878,"_20523":115862,"_26884":115863,"_2862":115864},[],"/docs/es/platform/iot-fleets/device-management#asigna-una-identidad-manualmente","Asigna una identidad manualmente",{"_3376":69195,"_29549":69185,"_5":29878,"_20523":115866,"_26884":115867,"_2862":115868},[],"/docs/es/platform/iot-fleets/device-management#revoca-la-identidad-actual","Revoca la identidad actual",{"_3376":69196,"_29549":69185,"_5":29878,"_20523":115870,"_26884":115871,"_2862":115872},[],"/docs/es/platform/iot-fleets/device-management#retira-un-dispositivo","Retira un dispositivo",{"_3376":69197,"_29549":69185,"_5":29878,"_20523":115874,"_26884":115875,"_2862":115876},[],"/docs/es/platform/iot-fleets/device-management#automatiza-el-enrolamiento","Automatiza el enrolamiento",{"_3376":69198,"_29549":69185,"_20523":115878,"_5":14087,"_26884":69185,"_2862":115879},[],"Esta guía se dirige al operador de una flota. Necesitas permisos sobre dispositivos, DMS y certificados para las acciones que vayas a realizar. Una flota se organiza mediante esos recursos, etiquetas y metadatos; no se crea un objeto independiente de «flota».",{"_3376":69199,"_29549":69185,"_20523":115881,"_5":14087,"_26884":69185,"_2862":115882},[],"Cada dispositivo tiene un `Device ID`, un DMS propietario (`dms_owner`) y, cuando está aprovisionado, un slot de identidad con una versión activa y versiones anteriores. En los flujos descritos, mantén el `Common Name` de la CSR y del certificado igual al `Device ID`: la vinculación utiliza ese CN para actualizar el dispositivo.",{"_3376":69200,"_29549":69185,"_20523":115884,"_5":14087,"_26884":115835,"_2862":115885},[],"Vista operativa",{"_3376":69201,"_29549":69185,"_20523":115887,"_5":14087,"_26884":115835,"_2862":115888},[],"Interpretación",{"_3376":69202,"_29549":69185,"_20523":115890,"_5":14087,"_26884":115835,"_2862":50653},[],{"_3376":69203,"_29549":69185,"_20523":115892,"_5":14087,"_26884":115835,"_2862":115893},[],"Hay registro, pero todavía no hay identidad asociada.",{"_3376":69204,"_29549":69185,"_20523":115895,"_5":14087,"_26884":115835,"_2862":50659},[],{"_3376":69205,"_29549":69185,"_20523":115897,"_5":14087,"_26884":115835,"_2862":115898},[],"El slot está activo; comprueba además las fechas, estado y usos del certificado.",{"_3376":69206,"_29549":69185,"_20523":115900,"_5":14087,"_26884":115835,"_2862":50665},[],{"_3376":69207,"_29549":69185,"_20523":115902,"_5":14087,"_26884":115835,"_2862":115903},[],"La identidad está en la ventana operativa de renovación.",{"_3376":69208,"_29549":69185,"_20523":115905,"_5":14087,"_26884":115835,"_2862":50671},[],{"_3376":69209,"_29549":69185,"_20523":115907,"_5":14087,"_26884":115835,"_2862":115908},[],"Se aproxima al vencimiento según los umbrales configurados.",{"_3376":69210,"_29549":69185,"_20523":115910,"_5":14087,"_26884":115835,"_2862":50677},[],{"_3376":69211,"_29549":69185,"_20523":115912,"_5":14087,"_26884":115835,"_2862":115913},[],"La identidad ha vencido.",{"_3376":69212,"_29549":69185,"_20523":115915,"_5":14087,"_26884":115835,"_2862":50683},[],{"_3376":69213,"_29549":69185,"_20523":115917,"_5":14087,"_26884":115835,"_2862":115918},[],"La identidad está marcada como revocada.",{"_3376":69214,"_29549":69185,"_20523":115920,"_5":14087,"_26884":115835,"_2862":50689},[],{"_3376":69215,"_29549":69185,"_20523":115922,"_5":14087,"_26884":115835,"_2862":115923},[],"El registro está retirado y no vuelve al estado operativo mediante una actualización normal.",{"_3376":69216,"_29549":69185,"_20523":115925,"_5":14087,"_26884":115835,"_2862":115926},[],"Los estados de dispositivo, slot y certificado son distintos. Los eventos y trabajos pueden actualizar la vista después de guardar el certificado; una etiqueta **Active** no prueba aceptación por un consumidor.",{"_3376":69217,"_29549":69185,"_20523":115928,"_5":14087,"_26884":115839,"_2862":115929},[],"Filtra el inventario por ID, etiquetas y estado. Abre el detalle y registra DMS propietario, versión activa y serie del certificado actual.",{"_3376":69218,"_29549":69185,"_20523":115931,"_5":14087,"_26884":115839,"_2862":115932},[],"**Certificate History** relaciona versiones anteriores y actuales. Sustituir el slot no revoca por sí solo todas las versiones anteriores.",{"_3376":69219,"_29549":69185,"_20523":115934,"_5":14087,"_26884":115839,"_2862":115935},[],"**Device Event Timeline** ayuda a reconstruir altas, aprovisionamientos, renovaciones y cambios de estado. Un cambio puede haberse guardado aunque falle la persistencia de su evento; contrasta también el registro y los certificados.",{"_3376":69220,"_29549":69185,"_20523":115937,"_5":14087,"_26884":115839,"_2862":115938},[],"Compara esos datos con la identidad instalada en el dispositivo. Un slot actualizado en Lamassu no instala archivos en el equipo remoto.",{"_3376":69221,"_29549":69185,"_20523":115940,"_5":14087,"_26884":115843,"_2862":115941},[],"Utiliza este flujo para preparar inventario o asignar una identidad desde la consola. Necesitas un DMS existente.",{"_3376":69222,"_29549":69185,"_20523":115943,"_5":14087,"_26884":115847,"_2862":115944},[],"Desde **Managed Devices**, abre el registro. Confirma que el ID no exista en otro DMS: la búsqueda por ID no está limitada a una flota.",{"_3376":69223,"_29549":69185,"_20523":115946,"_5":14087,"_26884":115851,"_2862":115947},[],"Introduce el **Device ID** y selecciona el DMS que será su propietario. La etiqueta **Registration Authority** de la consola se refiere a ese DMS.",{"_3376":69224,"_29549":69185,"_20523":115949,"_5":14087,"_26884":115855,"_2862":115950},[],"Añade icono y etiquetas de modelo, entorno o ubicación según tu inventario.",{"_3376":69225,"_29549":69185,"_20523":115952,"_5":14087,"_26884":115859,"_2862":115953},[],"Vuelve a leer el dispositivo: debe tener el DMS previsto y estar en **No Identity**. Sigue Registro manual para completar la asignación.",{"_3376":69226,"_29549":69185,"_20523":115955,"_5":14087,"_26884":115859,"_2862":115956},[],"Prerregistrar no demuestra que `/simpleenroll` vaya a admitir la solicitud. Revisa la interacción con `enable_replaceable_enrollment` en Estrategias de aprovisionamiento.",{"_3376":69227,"_29549":69185,"_20523":115958,"_5":14087,"_26884":115863,"_2862":115959},[],"Desde **No Identity**, utiliza **Assign Identity**:",{"_3376":69228,"_29549":69185,"_20523":115961,"_5":14087,"_26884":115863,"_2862":115962},[],"Elige un certificado activo, vigente y adecuado para el consumidor, con `CN` exactamente igual al `Device ID`.",{"_3376":69229,"_29549":69185,"_20523":115964,"_5":14087,"_26884":115863,"_2862":115965},[],"Si no existe, **Issue New Instead** permite iniciar una emisión con la CA prevista. Revisa primero el perfil.",{"_3376":69230,"_29549":69185,"_20523":115967,"_5":14087,"_26884":115863,"_2862":115968},[],"Confirma y vuelve a consultar serie, versión activa e historial.",{"_3376":69231,"_29549":69185,"_20523":115970,"_5":14087,"_26884":115863,"_2862":115971},[],"Instala la pareja clave/certificado y las intermedias necesarias en el dispositivo, y prueba su uso.",{"_3376":69232,"_29549":69185,"_20523":115973,"_5":14087,"_26884":115863,"_2862":115974},[],"Emitir, vincular e instalar son pasos distintos. Si falla la operación, comprueba cuáles se guardaron antes de repetirla.",{"_3376":69233,"_29549":69185,"_20523":115976,"_5":14087,"_26884":115867,"_2862":115977},[],"Localiza la serie activa en el historial y revócala con una razón apropiada. Comprueba registro, publicación OCSP/CRL y rechazo de una conexión nueva en el consumidor con la guía de certificados.",{"_3376":69234,"_29549":69185,"_20523":115979,"_5":14087,"_26884":115867,"_2862":115980},[],"La revocación no elimina el dispositivo. Tampoco habilita automáticamente una nueva inscripción: la recuperación depende de su credencial, estado y política DMS. `CertificateHold` puede reactivarse bajo las condiciones de PKI; otras razones bloquean cambios posteriores del certificado.",{"_3376":69235,"_29549":69185,"_20523":115982,"_5":14087,"_26884":115871,"_2862":115983},[],"Antes de **Decommission**, inventaría identidades activas y anteriores, conexiones y permisos del destino. Prepara su retirada en el consumidor.",{"_3376":69236,"_29549":69185,"_20523":115985,"_5":14087,"_26884":115871,"_2862":115986},[],"El backend guarda **Decommissioned** e intenta revocar el certificado de la versión activa con `CessationOfOperation` si el slot no estaba expirado o revocado. No recorre todo el historial. La revocación diferida puede fallar después de guardar la baja; verifica su resultado por serie.",{"_3376":69237,"_29549":69185,"_20523":115988,"_5":14087,"_26884":115871,"_2862":115989},[],"El estado retirado protege las actualizaciones normales del dispositivo y su slot. No constituye una garantía de que toda solicitud EST sea rechazada antes de emitir: la vinculación puede omitir un dispositivo retirado sin devolver error. Confirma que no quedan certificados o permisos utilizables y bloquea nuevas admisiones en el control correspondiente.",{"_3376":69238,"_29549":69185,"_20523":115991,"_5":14087,"_26884":115871,"_2862":115992},[],"Conserva los registros según tu política de auditoría. No reutilices un ID retirado para ocultar el cambio de equipo.",{"_3376":69239,"_29549":69185,"_20523":115994,"_5":14087,"_26884":115875,"_2862":115995},[],"<Card title=\"Enrola y conecta un dispositivo\" description=\"Obtén una identidad desde el cliente y prueba mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3376":69240,"_29549":69185,"_20523":115997,"_5":14087,"_26884":115875,"_2862":115998},[],"<Card title=\"Renovación y recuperación\" description=\"Instala el sucesor y trata fallos sin perder el estado conocido.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3376":69241,"_29549":69241,"_5":14445,"_2862":116000,"_29881":116001,"_20523":116003,"_26884":69241},"Identidad inicial y autenticación",[48111,114818,50590,115827,116002],"Enrolamiento con PKI",[],{"_3376":69242,"_29549":69241,"_20523":116005,"_5":14087,"_26884":69241,"_2862":116006},[],"Prepara confianza del servidor y pruebas de admisión para enroll y reenroll.",{"_3376":69243,"_29549":69241,"_5":29878,"_20523":116008,"_26884":116009,"_2862":116010},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#confianza-inicial-del-servidor","Confianza inicial del servidor",{"_3376":69244,"_29549":69241,"_5":29878,"_20523":116012,"_26884":116013,"_2862":116014},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#credencial-bootstrap","Credencial bootstrap",{"_3376":69245,"_29549":69241,"_5":29878,"_20523":116016,"_26884":116017,"_2862":116018},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#modos-por-operación","Modos por operación",{"_3376":69246,"_29549":69241,"_5":29878,"_20523":116020,"_26884":116021,"_2862":116022},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#contrato-del-webhook","Contrato del webhook",{"_3376":69247,"_29549":69241,"_5":29878,"_20523":116024,"_26884":116025,"_2862":116026},[],"/docs/es/platform/iot-fleets/enrollment/bootstrap-identity#revocación-y-comprobaciones","Revocación y comprobaciones",{"_3376":69248,"_29549":69241,"_20523":116028,"_5":14087,"_26884":69241,"_2862":116029},[],"Esta guía conecta al administrador DMS con quien fabrica o integra el dispositivo. Antes de solicitar su identidad operativa, el cliente debe poder autenticar al servidor EST y demostrar que tiene derecho a solicitar el ID previsto.",{"_3376":69249,"_29549":69241,"_20523":116031,"_5":14087,"_26884":116009,"_2862":116032},[],"Instala una raíz, cadena o pin previamente verificado mediante un canal confiable: fabricación, configuración aprobada o distribución autenticada. Ese material permite verificar TLS y el nombre del servidor antes de descargar `/cacerts`.",{"_3376":69250,"_29549":69241,"_20523":116034,"_5":14087,"_26884":116009,"_2862":116035},[],"No puedes obtener tu única prueba de confianza del mismo servidor todavía no autenticado. El certificado TLS del servidor EST, el certificado bootstrap y la CA emisora de la identidad operativa pueden pertenecer a jerarquías distintas.",{"_3376":69251,"_29549":69241,"_20523":116037,"_5":14087,"_26884":116013,"_2862":116038},[],"Con `CLIENT_CERTIFICATE`, el dispositivo presenta su certificado inicial y demuestra posesión de su clave en TLS. El DMS lo valida frente a sus CAs de admisión. En el flujo examinado, el validador recibe una credencial de hoja: configura y prueba el emisor directo para el caso sencillo; enviar más intermedias desde el cliente no demuestra que lleguen al servicio.",{"_3376":69252,"_29549":69241,"_20523":116040,"_5":14087,"_26884":116013,"_2862":116041},[],"Comprueba fechas, certificado y clave correspondientes y estado de revocación antes de provisionarlos. Una credencial compartida entre equipos identifica esa credencial compartida, no a un equipo concreto.",{"_3376":69253,"_29549":69241,"_20523":116043,"_5":14087,"_26884":116013,"_2862":116044},[],"En el primer enrolamiento, la validación mTLS no compara por sí sola el CN del bootstrap con el CN solicitado en la CSR. Si necesitas que un solicitante solo pueda pedir su propio `Device ID`, añade un control que vincule credencial e ID, por ejemplo el webhook combinado, y prueba una solicitud con otro CN. En reenrolamiento con certificado sí se compara su CN con el de la CSR; las comprobaciones posteriores utilizan la identidad activa registrada.",{"_3376":69254,"_29549":69241,"_20523":116046,"_5":14087,"_26884":116017,"_2862":116047},[],"Los cuatro modos se seleccionan independientemente para enrolamiento y reenrolamiento en DMS. La credencial utilizada al renovar depende de ese bloque; no presupongas que siempre será el bootstrap o que el webhook desaparezca.",{"_3376":69255,"_29549":69241,"_20523":116049,"_5":14087,"_26884":116017,"_2862":116050},[],"Un token OIDC de administración no es un modo EST nativo. Un webhook puede interpretar una cabecera de credencial que acuerdes con él; en ese caso la autorización la realiza ese servicio. En NO\\_AUTH, enviar un token no añade autenticación al DMS.",{"_3376":69256,"_29549":69241,"_20523":116052,"_5":14087,"_26884":116021,"_2862":116053},[],"El DMS envía el contexto de la operación al servicio configurado. El método procede de la configuración; acuerda su contrato antes de seleccionar POST o PUT. La espera de autorización tiene un valor inicial de 10 segundos, sustituido por un timeout positivo configurado. El DMS verifica el certificado del receptor salvo que se active `insecure_skip_verify` en la configuración del webhook — por defecto se verifica — y no sigue redirecciones, así que la URL configurada debe ser la final. La respuesta de autorización debe ser JSON de como máximo 1 MiB. Con la autenticación de Lamassu hacia el webhook configurada sobre `http://`, la API key o el bearer token viajan en texto claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta; prefiere `https://`. Configura esas opciones en los ajustes del webhook externo de la guía DMS.",{"_3376":69257,"_29549":69241,"_20523":116055,"_5":14087,"_26884":116021,"_2862":116056},[],"Ejemplo de cuerpo:",{"_3376":69258,"_29549":69241,"_20523":116058,"_5":14087,"_26884":116021,"_2862":116059},[],"`csr` contiene **base64 del PEM**, a diferencia del cuerpo EST, que contiene base64 del DER. `http_request` recoge URL y primeras entradas de cabeceras del contexto HTTP disponible. El campo `operation` no se envía en este cuerpo; distingue enroll y reenroll mediante la ruta y la política configurada.",{"_3376":69259,"_29549":69241,"_20523":116061,"_5":14087,"_26884":116021,"_2862":116062},[],"El webhook debe verificar la credencial, su relación con `device_cn`, DMS, operación y política de admisión. Las cabeceras transportadas no son por sí mismas evidencia de confianza. La autenticación de **Lamassu hacia el webhook** es otra relación distinta que se configura en el cliente HTTP del servidor.",{"_3376":69260,"_29549":69241,"_20523":116064,"_5":14087,"_26884":116021,"_2862":116065},[],"La continuación requiere respuesta HTTP satisfactoria y JSON:",{"_3376":69261,"_29549":69241,"_20523":116067,"_5":14087,"_26884":116021,"_2862":116068},[],"Un `204` sin cuerpo no cumple el contrato. Rechazo, error de transporte, respuesta no interpretable o timeout abortan la autorización. En modo combinado, primero se valida el certificado y después se consulta el webhook. Consulta la especificación del webhook.",{"_3376":69262,"_29549":69241,"_20523":116070,"_5":14087,"_26884":116025,"_2862":116071},[],"El DMS busca primero el certificado en Lamassu; para uno externo intenta OCSP y CRL. Si no logra comprobar revocación, los validadores pueden continuar tratándolo como no revocado. El código tampoco permite asumir que todo estado externo distinto de Good se rechace. Verifica el comportamiento requerido con tu credencial y endpoint reales; no presentes esta comprobación como una política estricta garantizada para todas las fuentes.",{"_3376":69263,"_29549":69241,"_20523":116073,"_5":14087,"_26884":116025,"_2862":116074},[],"Prueba certificado permitido, certificado incorrecto, CN ajeno, webhook denegado, timeout y reenrolamiento bajo su propia política. Conserva el resultado y programa la retirada de las credenciales bootstrap cuando corresponda. Continúa con Cliente EST.",{"_3376":69264,"_29549":69264,"_5":14445,"_2862":116076,"_29881":116077,"_20523":116078,"_26884":69264},"Configura y opera el DMS",[48111,114818,50590,115827,116002],[],{"_3376":69265,"_29549":69264,"_20523":116080,"_5":14087,"_26884":69264,"_2862":116081},[],"Define registro, autenticación por operación, emisión, renovación y confianza distribuida.",{"_3376":69266,"_29549":69264,"_5":29878,"_20523":116083,"_26884":116084,"_2862":113396},[],"/docs/es/platform/iot-fleets/enrollment/dms#antes-de-empezar",{"_3376":69267,"_29549":69264,"_5":29878,"_20523":116086,"_26884":116087,"_2862":116088},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-un-dms","Configura un DMS",{"_3376":69268,"_29549":69264,"_5":29878,"_20523":116090,"_26884":116091,"_2862":116092},[],"/docs/es/platform/iot-fleets/enrollment/dms#identifica-la-flota","Identifica la flota",{"_3376":69269,"_29549":69264,"_5":29878,"_20523":116094,"_26884":116095,"_2862":116096},[],"/docs/es/platform/iot-fleets/enrollment/dms#selecciona-la-ca-de-enrolamiento","Selecciona la CA de enrolamiento",{"_3376":69270,"_29549":69264,"_5":29878,"_20523":116098,"_26884":116099,"_2862":116100},[],"/docs/es/platform/iot-fleets/enrollment/dms#configura-est","Configura EST",{"_3376":69271,"_29549":69264,"_5":29878,"_20523":116102,"_26884":116103,"_2862":116104},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribuye-la-confianza","Distribuye la confianza",{"_3376":69272,"_29549":69264,"_5":29878,"_20523":116106,"_26884":116107,"_2862":116108},[],"/docs/es/platform/iot-fleets/enrollment/dms#verifica-los-endpoints","Verifica los endpoints",{"_3376":69273,"_29549":69264,"_5":29878,"_20523":116110,"_26884":116111,"_2862":116112},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-enrollment","Configuración de enrollment",{"_3376":69274,"_29549":69264,"_5":29878,"_20523":116114,"_26884":116115,"_2862":50885},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-device-registration",{"_3376":69275,"_29549":69264,"_5":29878,"_20523":116117,"_26884":116118,"_2862":50889},[],"/docs/es/platform/iot-fleets/enrollment/dms#enrollment-settings",{"_3376":69276,"_29549":69264,"_5":29878,"_20523":116120,"_26884":116121,"_2862":116122},[],"/docs/es/platform/iot-fleets/enrollment/dms#autenticación-por-operación","Autenticación por operación",{"_3376":69277,"_29549":69264,"_5":29878,"_20523":116124,"_26884":116125,"_2862":116126},[],"/docs/es/platform/iot-fleets/enrollment/dms#ajustes-del-webhook-externo","Ajustes del webhook externo",{"_3376":69278,"_29549":69264,"_5":29878,"_20523":116128,"_26884":116129,"_2862":116130},[],"/docs/es/platform/iot-fleets/enrollment/dms#perfil-de-emisión","Perfil de emisión",{"_3376":69279,"_29549":69264,"_5":29878,"_20523":116132,"_26884":116133,"_2862":116134},[],"/docs/es/platform/iot-fleets/enrollment/dms#configuración-de-re-enrollment","Configuración de re-enrollment",{"_3376":69280,"_29549":69264,"_5":29878,"_20523":116136,"_26884":116137,"_2862":50909},[],"/docs/es/platform/iot-fleets/enrollment/dms#serverkeygen",{"_3376":69281,"_29549":69264,"_5":29878,"_20523":116139,"_26884":116140,"_2862":116141},[],"/docs/es/platform/iot-fleets/enrollment/dms#distribución-de-confianza","Distribución de confianza",{"_3376":69282,"_29549":69264,"_5":29878,"_20523":116143,"_26884":116144,"_2862":116145},[],"/docs/es/platform/iot-fleets/enrollment/dms#opera-el-inventario-de-dms","Opera el inventario de DMS",{"_3376":69283,"_29549":69264,"_5":29878,"_20523":116147,"_26884":116148,"_2862":116149},[],"/docs/es/platform/iot-fleets/enrollment/dms#integra-los-dispositivos","Integra los dispositivos",{"_3376":69284,"_29549":69264,"_20523":116151,"_5":14087,"_26884":69264,"_2862":116152},[],"Un &#x2A;*Device Management Service (DMS)** configura la admisión y el ciclo de identidad de sus dispositivos. Actúa como autoridad de registro; la CA indicada en `Enrollment CA` firma los certificados. Esta guía se dirige a quien administra esa política.",{"_3376":69285,"_29549":69264,"_20523":116154,"_5":14087,"_26884":116084,"_2862":116155},[],"Necesitas permisos para gestionar DMS, una CA activa con clave utilizable y un perfil de emisión probado. Acuerda con el integrador ID del dispositivo, credencial inicial, consumidor y ventana de renovación. Revisa la estrategia de aprovisionamiento antes de elegir registro y sustitución.",{"_3376":69286,"_29549":69264,"_20523":116157,"_5":14087,"_26884":116084,"_2862":116158},[],"Prepara confianza del servidor EST y acceso desde el dispositivo con Despliegue. La autenticación administrativa de tu operador no sustituye la autenticación EST del dispositivo.",{"_3376":69287,"_29549":69264,"_20523":116160,"_5":14087,"_26884":116091,"_2862":116161},[],"Crea el DMS con un nombre reconocible y conserva su ID. Las URLs EST utilizan ese identificador, no el nombre visible. Cada dispositivo conserva un DMS propietario.",{"_3376":69288,"_29549":69264,"_20523":116163,"_5":14087,"_26884":116095,"_2862":116164},[],"Elige **Enrollment CA** y un perfil explícito apropiado para la identidad final. Mantén CN compatible con `Device ID`. El certificado de prueba debe permitir el uso previsto y terminar dentro de la vigencia del emisor.",{"_3376":69289,"_29549":69264,"_20523":116166,"_5":14087,"_26884":116099,"_2862":116167},[],"Selecciona registro y autenticación del primer enrolamiento. Configura por separado la autenticación de reenrolamiento, sus umbrales y la retirada del certificado anterior. Deja ServerKeyGen deshabilitado si el cliente genera su clave.",{"_3376":69290,"_29549":69264,"_20523":116169,"_5":14087,"_26884":116103,"_2862":116170},[],"Selecciona los certificados que devolverá `/cacerts`. Incluye explícitamente las intermedias y raíces necesarias, sin confundir distribución con instalación automática de confianza.",{"_3376":69291,"_29549":69264,"_20523":116172,"_5":14087,"_26884":116107,"_2862":116173},[],"Guarda y vuelve a leer la configuración. Consulta `/cacerts`, realiza un enrolamiento permitido y otro rechazado, y comprueba dispositivo, serie e historial. Crear el DMS o descargar cacerts no demuestra que autenticación y emisión funcionen.",{"_3376":69292,"_29549":69264,"_20523":116175,"_5":14087,"_26884":116115,"_2862":116176},[],"`settings.enrollment_settings.registration_mode` permite `JITP` o `PRE_REGISTRATION`. En JITP se crea el dispositivo desconocido con el CN de la CSR como ID y el DMS como propietario. El `device_provisioning_profile` aporta etiquetas, metadatos e icono a ese alta.",{"_3376":69293,"_29549":69264,"_20523":116178,"_5":14087,"_26884":116115,"_2862":116179},[],"En PRE\\_REGISTRATION, el ID debe existir previamente. En el código examinado, un dispositivo existente pasa antes por el control de sustitución, incluso si no tiene identidad. Consulta las condiciones de prerregistro antes de utilizar este modo.",{"_3376":69294,"_29549":69264,"_20523":116181,"_5":14087,"_26884":116118,"_2862":116182},[],"Campo de `settings.enrollment_settings`",{"_3376":69295,"_29549":69264,"_20523":116184,"_5":14087,"_26884":116118,"_2862":116185},[],"Decisión",{"_3376":69296,"_29549":69264,"_20523":116187,"_5":14087,"_26884":116118,"_2862":50960},[],{"_3376":69297,"_29549":69264,"_20523":116189,"_5":14087,"_26884":116118,"_2862":116190},[],"`EST_RFC7030` para estas operaciones.",{"_3376":69298,"_29549":69264,"_20523":116192,"_5":14087,"_26884":116118,"_2862":50966},[],{"_3376":69299,"_29549":69264,"_20523":116194,"_5":14087,"_26884":116118,"_2862":116195},[],"ID de la CA que firmará.",{"_3376":69300,"_29549":69264,"_20523":116197,"_5":14087,"_26884":116118,"_2862":50972},[],{"_3376":69301,"_29549":69264,"_20523":116199,"_5":14087,"_26884":116118,"_2862":116200},[],"Mantén `true` para comprobar posesión de la clave de la CSR.",{"_3376":69302,"_29549":69264,"_20523":116202,"_5":14087,"_26884":116118,"_2862":50978},[],{"_3376":69303,"_29549":69264,"_20523":116204,"_5":14087,"_26884":116118,"_2862":116205},[],"Permite `/simpleenroll` para un ID existente del mismo DMS. Puede intentar revocar el anterior incluso si falla una fase posterior; no es un cambio atómico.",{"_3376":69304,"_29549":69264,"_20523":116207,"_5":14087,"_26884":116118,"_2862":50984},[],{"_3376":69305,"_29549":69264,"_20523":116209,"_5":14087,"_26884":116118,"_2862":116210},[],"Uno de los cuatro modos de autenticación.",{"_3376":69306,"_29549":69264,"_20523":116212,"_5":14087,"_26884":116118,"_2862":116213},[],"Si el ID pertenece a otro DMS, el enrolamiento inicial se rechaza. No actives sustitución como respuesta automática a un error; el diagnóstico distingue ID repetido, propiedad y cambios parciales.",{"_3376":69307,"_29549":69264,"_20523":116215,"_5":14087,"_26884":116121,"_2862":116216},[],"Los bloques son independientes:",{"_3376":69308,"_29549":69264,"_20523":116218,"_5":14087,"_26884":116121,"_2862":116219},[],"`settings.enrollment_settings.est_rfc7030_settings` para `/simpleenroll` y `/serverkeygen`.",{"_3376":69309,"_29549":69264,"_20523":116221,"_5":14087,"_26884":116121,"_2862":116222},[],"`settings.reenrollment_settings.est_rfc7030_settings` para `/simplereenroll`.",{"_3376":69310,"_29549":69264,"_20523":116224,"_5":14087,"_26884":116121,"_2862":51002},[],{"_3376":69311,"_29549":69264,"_20523":116226,"_5":14087,"_26884":116121,"_2862":116227},[],"Control aplicado en la operación configurada",{"_3376":69312,"_29549":69264,"_20523":116229,"_5":14087,"_26884":116121,"_2862":51008},[],{"_3376":69313,"_29549":69264,"_20523":116231,"_5":14087,"_26884":116121,"_2862":116232},[],"Validación del certificado presentado.",{"_3376":69314,"_29549":69264,"_20523":116234,"_5":14087,"_26884":116121,"_2862":51014},[],{"_3376":69315,"_29549":69264,"_20523":116236,"_5":14087,"_26884":116121,"_2862":116237},[],"Autorización del webhook configurado.",{"_3376":69316,"_29549":69264,"_20523":116239,"_5":14087,"_26884":116121,"_2862":51020},[],{"_3376":69317,"_29549":69264,"_20523":116241,"_5":14087,"_26884":116121,"_2862":116242},[],"Validación del certificado y, después, aprobación del webhook.",{"_3376":69318,"_29549":69264,"_20523":116244,"_5":14087,"_26884":116121,"_2862":51026},[],{"_3376":69319,"_29549":69264,"_20523":116246,"_5":14087,"_26884":116121,"_2862":116247},[],"Sin autenticación del solicitante por el DMS.",{"_3376":69320,"_29549":69264,"_20523":116249,"_5":14087,"_26884":116121,"_2862":116250},[],"Webhook y modo combinado también se ejecutan en reenrolamiento si se configuran en su bloque. No hay una degradación implícita a NO\\_AUTH en esos casos. Un modo ausente o no reconocido falla.",{"_3376":69321,"_29549":69264,"_20523":116252,"_5":14087,"_26884":116121,"_2862":116253},[],"Para mTLS inicial, `client_certificate_settings` contiene `validation_cas`, `allow_expired` y `chain_level_validation`. El flujo examinado recibe una credencial de certificado, no garantiza transportar todas las intermedias del handshake al validador. Para el caso directo, configura como CA de validación el emisor directo del bootstrap y prueba la ruta real del Gateway.",{"_3376":69322,"_29549":69264,"_20523":116255,"_5":14087,"_26884":116121,"_2862":116256},[],"En el reenrolamiento con certificado, el validador prueba primero la CA de enrolamiento y después las CAs listadas en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`; esas son las CAs de validación de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre es confiable en el reenrolamiento, y cada bloque de ajustes consulta solo su propia `validation_cas`. Las CAs presentes solo en la `validation_cas` del bloque inicial no amplían la aceptación en reenrolamiento; durante una rotación de CAs, añade la CA de emisión anterior a la lista del bloque de reenrolamiento. El validador de reenrolamiento compara la hoja TLS presentada con esas CAs; los valores `chain_level_validation` y `allow_expired` del bloque de reenrolamiento se almacenan pero no se consultan, y el vencimiento lo rige `enable_expired_renewal`.",{"_3376":69323,"_29549":69264,"_20523":116258,"_5":14087,"_26884":116121,"_2862":116259},[],"Para el webhook, configura destino, autenticación de Lamassu hacia ese servicio, método y timeout. El contrato de autenticación explica la credencial del dispositivo y el cuerpo de la llamada. `NO_AUTH` no acredita propiedad del ID solicitado.",{"_3376":69324,"_29549":69264,"_20523":116261,"_5":14087,"_26884":116125,"_2862":116262},[],"Los modos de autenticación por webhook leen `external_webhook_settings` en el mismo bloque `est_rfc7030_settings`:",{"_3376":69325,"_29549":69264,"_20523":116264,"_5":14087,"_26884":116125,"_2862":116265},[],"Campo de `external_webhook_settings`",{"_3376":69326,"_29549":69264,"_20523":116267,"_5":14087,"_26884":116125,"_2862":116185},[],{"_3376":69327,"_29549":69264,"_20523":116269,"_5":14087,"_26884":116125,"_2862":51052},[],{"_3376":69328,"_29549":69264,"_20523":116271,"_5":14087,"_26884":116125,"_2862":116272},[],"URL absoluta `http` o `https` del receptor. Debe ser la URL final; no se siguen redirecciones.",{"_3376":69329,"_29549":69264,"_20523":116274,"_5":14087,"_26884":116125,"_2862":51058},[],{"_3376":69330,"_29549":69264,"_20523":116276,"_5":14087,"_26884":116125,"_2862":116277},[],"`POST` o `PUT`; `POST` por defecto.",{"_3376":69331,"_29549":69264,"_20523":116279,"_5":14087,"_26884":116125,"_2862":51064},[],{"_3376":69332,"_29549":69264,"_20523":116281,"_5":14087,"_26884":116125,"_2862":116282},[],"Etiqueta usada en los logs del servicio.",{"_3376":69333,"_29549":69264,"_20523":116284,"_5":14087,"_26884":116125,"_2862":51070},[],{"_3376":69334,"_29549":69264,"_20523":116286,"_5":14087,"_26884":116125,"_2862":116287},[],"`noauth`, `apikey`, `jwt` o `mtls`. Un valor ausente o desconocido se comporta como `noauth`.",{"_3376":69335,"_29549":69264,"_20523":116289,"_5":14087,"_26884":116125,"_2862":51076},[],{"_3376":69336,"_29549":69264,"_20523":116291,"_5":14087,"_26884":116125,"_2862":116292},[],"Nivel de log de la llamada del webhook: `debug`, `info`, `warn` o `error`; `info` por defecto.",{"_3376":69337,"_29549":69264,"_20523":116294,"_5":14087,"_26884":116125,"_2862":51082},[],{"_3376":69338,"_29549":69264,"_20523":116296,"_5":14087,"_26884":116125,"_2862":116297},[],"Obligatorios para `apikey`: `header` y `key`. Los nombres de cabecera reservados se rechazan.",{"_3376":69339,"_29549":69264,"_20523":116299,"_5":14087,"_26884":116125,"_2862":51088},[],{"_3376":69340,"_29549":69264,"_20523":116301,"_5":14087,"_26884":116125,"_2862":116302},[],"Obligatorios para `jwt`: `oidc_client_id`, `oidc_client_secret` y un `oidc_well_known` absoluto `http` o `https`.",{"_3376":69341,"_29549":69264,"_20523":116304,"_5":14087,"_26884":116125,"_2862":51094},[],{"_3376":69342,"_29549":69264,"_20523":116306,"_5":14087,"_26884":116125,"_2862":116307},[],"Obligatorios para `mtls`: `cert_content` y `key_content` como PEM codificado en Base64, como el resto de certificados de la API; también se acepta el PEM en claro.",{"_3376":69343,"_29549":69264,"_20523":116309,"_5":14087,"_26884":116125,"_2862":51100},[],{"_3376":69344,"_29549":69264,"_20523":116311,"_5":14087,"_26884":116125,"_2862":116312},[],"Con `true`, omite la verificación del certificado del receptor. Por defecto se verifica. A diferencia de los canales de alertas, este ajuste se respeta aquí.",{"_3376":69345,"_29549":69264,"_20523":116314,"_5":14087,"_26884":116125,"_2862":51106},[],{"_3376":69346,"_29549":69264,"_20523":116316,"_5":14087,"_26884":116125,"_2862":116317},[],"Duración máxima de la llamada de autorización (por ejemplo `10s`); 10 segundos por defecto.",{"_3376":69347,"_29549":69264,"_20523":116319,"_5":14087,"_26884":116125,"_2862":116320},[],"Reglas de esa configuración:",{"_3376":69348,"_29549":69264,"_20523":116322,"_5":14087,"_26884":116125,"_2862":116323},[],"Crear o actualizar un DMS cuyo `auth_mode` de enrolamiento o reenrolamiento use el webhook valida el bloque y devuelve HTTP 400 — el cuerpo empieza por `struct validation error:` y continúa con `invalid enrollment external webhook config` o `invalid reenrollment external webhook config` — cuando la URL, el método o las opciones no son válidos. Eso incluye un par `mtls_options.cert_content`/`key_content` que no se corresponde con un certificado y una clave privada coincidentes. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) siempre son inválidas: el servicio no lee archivos, así que introduce el certificado y la clave como PEM codificado en Base64 en `mtls_options.cert_content` y `key_content`, o como PEM en claro.",{"_3376":69349,"_29549":69264,"_20523":116325,"_5":14087,"_26884":116125,"_2862":116326},[],"Un `apikey_options.header` propio no puede usar nombres en los que la plataforma o el servicio receptor confían — por ejemplo `X-Principal-Id`, `X-Request-Id`, `Host`, `Content-Type` o `Forwarded` — y ningún nombre puede empezar por `X-Forwarded-`, `X-Envoy-` o `X-Lms-` (sin distinguir mayúsculas). La referencia de la API DMS documenta los esquemas `WebhookCall` y `WebhookCallHttpClient` y que las cabeceras API-key reservadas se rechazan.",{"_3376":69350,"_29549":69264,"_20523":116328,"_5":14087,"_26884":116125,"_2862":116329},[],"La clave anidada `http_client` existe solo en las configuraciones de canales de alertas; en un cuerpo de DMS se ignora. La clave de DMS es `external_webhook_settings.config`.",{"_3376":69351,"_29549":69264,"_20523":116331,"_5":14087,"_26884":116125,"_2862":116332},[],"Un cuerpo con `config.auth_mode` establecido a `apikey`, `jwt` o `mtls` debe llevar su bloque de opciones correspondiente (`apikey_options`, `jwt_options` o `mtls_options`) — y nada más. Los cuerpos con esos modos de autenticación que solo contengan `apikey`, `oidc` o `mtls` fallan la validación con 400, y `validate_server_cert` siempre se ignora: usa `insecure_skip_verify`. Solo se aceptan como `noauth` los cuerpos sin bloques de opciones, y sus credenciales se descartan.",{"_3376":69352,"_29549":69264,"_20523":116334,"_5":14087,"_26884":116125,"_2862":116335},[],"La respuesta de autorización debe ser JSON de como máximo 1 MiB; un cuerpo mayor hace fallar la llamada.",{"_3376":69353,"_29549":69264,"_20523":116337,"_5":14087,"_26884":116125,"_2862":116338},[],"Si hay credenciales configuradas, se envían sea cual sea el esquema de la URL: un webhook `http://` recibe la API key o el bearer token en claro, y mTLS no tiene efecto porque no hay handshake TLS, así que el certificado de cliente nunca se presenta. Usa preferentemente `https://` en `url`, en `oidc_well_known` y en el endpoint de token que este anuncia.",{"_3376":69354,"_29549":69264,"_20523":116340,"_5":14087,"_26884":116125,"_2862":116341},[],"La autenticación inicial y los ajustes de renovación se almacenan por separado. Si un DMS solo tiene el bloque de autenticación inicial, la renovación lo reutiliza: lee ambos bloques antes de editar. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento, con los mismos campos Log Level, Call Timeout, HTTP Authentication y credenciales que los canales webhook, además de un interruptor **Skip TLS Verification** (desactivado por defecto, así que la verificación permanece activa; la consola avisa cuando lo activas).",{"_3376":69355,"_29549":69264,"_20523":116343,"_5":14087,"_26884":116125,"_2862":116344},[],"Las credenciales del webhook deben almacenarse como contenido PEM. Las referencias a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`) nunca son válidas en una configuración de webhook almacenada: la entrega rechaza cualquier configuración de webhook que haga referencia a archivos, sea cual sea su modo de autenticación, por lo que todos los enroll y reenroll que llaman a ese webhook fallan hasta que el certificado y la clave se introduzcan como contenido PEM, en Base64 o plano, en `mtls_options.cert_content` y `key_content`, o se eliminen los campos de archivo si el webhook no usa mTLS. Si una configuración almacenada guarda rutas de archivos en `mtls_options.cert_content` o `key_content`, toda actualización completa de ajustes (`POST /v1/dms`, `PUT /v1/dms/:id`) falla la validación — los ajustes se sustituyen al completo, así que la configuración almacenada debe reenviarse — hasta que esos valores se sustituyan por contenido PEM o el webhook deje de usarse. Mientras tanto, la entrega de ese webhook falla en cada llamada; una actualización solo de metadatos mediante `PUT` o `PATCH` en `/v1/dms/:id/metadata` sigue funcionando. Para corregirlo en la consola, abre el DMS, sustituye cualquier valor de ruta de fichero por contenido PEM — el editor rechaza las rutas de fichero con un error en el propio campo — y guarda. Al guardar se reescribe `external_webhook_settings.config` con las claves actuales, y la consola lee tanto el PEM sin codificar como el codificado en Base64 de las configuraciones migradas, y almacena el material codificado en Base64. Si tu configuración almacenada se apoyaba antes en `validate_server_cert: false`, ahora lleva `insecure_skip_verify: true`: la verificación del certificado del receptor sigue sin realizarse hasta que pongas ese flag a `false`. Consulta 3.8.0 a 4.0.0 para las notas de actualización y la lista de verificación del operador.",{"_3376":69356,"_29549":69264,"_20523":116346,"_5":14087,"_26884":116125,"_2862":116347},[],"El conjunto de confianza del reenrolamiento vive en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`. El campo plano `reenrollment_settings.additional_validation_cas` no forma parte de la API: los cuerpos que lo contienen se aceptan, pero su valor se ignora en silencio — los campos JSON desconocidos se descartan — y las respuestas GET no lo incluyen. Lee el DMS antes de enviar ediciones por API: un cuerpo de actualización construido con ese campo plano vacía en silencio `validation_cas`.",{"_3376":69357,"_29549":69264,"_20523":116349,"_5":14087,"_26884":116129,"_2862":116350},[],"`settings.issuance_profile_id` tiene precedencia sobre `settings.issuance_profile`; si ninguno existe, se utiliza el perfil predeterminado de la CA. Las reglas se documentan una sola vez en Perfiles. Cambiar un DMS afecta a solicitudes futuras; no modifica certificados ya firmados ni instala confianza en clientes.",{"_3376":69358,"_29549":69264,"_20523":116352,"_5":14087,"_26884":116133,"_2862":116353},[],"Campo de `settings.reenrollment_settings`",{"_3376":69359,"_29549":69264,"_20523":116355,"_5":14087,"_26884":116133,"_2862":116356},[],"Función",{"_3376":69360,"_29549":69264,"_20523":116358,"_5":14087,"_26884":116133,"_2862":51150},[],{"_3376":69361,"_29549":69264,"_20523":116360,"_5":14087,"_26884":116133,"_2862":116361},[],"La ventana abre en `NotAfter` del certificado activo menos este delta.",{"_3376":69362,"_29549":69264,"_20523":116363,"_5":14087,"_26884":116133,"_2862":51156},[],{"_3376":69363,"_29549":69264,"_20523":116365,"_5":14087,"_26884":116133,"_2862":116366},[],"Umbral operativo preventivo de monitorización.",{"_3376":69364,"_29549":69264,"_20523":116368,"_5":14087,"_26884":116133,"_2862":51162},[],{"_3376":69365,"_29549":69264,"_20523":116370,"_5":14087,"_26884":116133,"_2862":116371},[],"Umbral operativo crítico de monitorización.",{"_3376":69366,"_29549":69264,"_20523":116373,"_5":14087,"_26884":116133,"_2862":51168},[],{"_3376":69367,"_29549":69264,"_20523":116375,"_5":14087,"_26884":116133,"_2862":116376},[],"Aceptación de un certificado presentado vencido en el validador mTLS de renovación. No autoriza por sí solo otro modo ni elimina restricciones del Gateway.",{"_3376":69368,"_29549":69264,"_20523":116378,"_5":14087,"_26884":116133,"_2862":51174},[],{"_3376":69369,"_29549":69264,"_20523":116380,"_5":14087,"_26884":116133,"_2862":116381},[],"CAs de validación de reenrolamiento para la credencial mTLS de renovación, probadas después de la CA de enrolamiento; opcional, porque la CA de enrolamiento siempre es confiable. Suelen poblarse durante la rotación de CAs mientras las cohortes con certificados antiguos se renuevan.",{"_3376":69370,"_29549":69264,"_20523":116383,"_5":14087,"_26884":116133,"_2862":51180},[],{"_3376":69371,"_29549":69264,"_20523":116385,"_5":14087,"_26884":116133,"_2862":116386},[],"Si el certificado anterior está ACTIVE, intenta revocarlo con Superseded antes de vincular el sucesor.",{"_3376":69372,"_29549":69264,"_20523":116388,"_5":14087,"_26884":116133,"_2862":116389},[],"Monitorizar no renueva: el cliente debe programar la solicitud y la instalación. En modos webhook o NO\\_AUTH, la política de credencial vencida no pasa por el mismo validador mTLS; el webhook debe autorizar explícitamente la recuperación que admita. Revisa Renovación y recuperación para orden de operaciones y fallos parciales.",{"_3376":69373,"_29549":69264,"_20523":116391,"_5":14087,"_26884":116137,"_2862":116392},[],"`settings.server_keygen_settings.enabled` habilita generación software en el servidor. La consola lo expone mediante un interruptor **Enable server-side key generation** y una selección de **Key type**: `ECDSA` P-256, P-384 o P-521, o `RSA` de 2048, 3072 o 4096 bits; los valores predeterminados son P-256 para `ECDSA` y 4096 bits para `RSA`. Algoritmo y tamaño proceden de su campo `key`, que se guarda como `{type,bits}` donde P-256, P-384 y P-521 equivalen a `bits` 256, 384 y 521; `key` se omite cuando está deshabilitado. El perfil de emisión debe permitirlos. La respuesta contiene una clave PKCS#8 sin cifrar dentro de TLS, además del certificado. Consulta formato y extracción en Referencia EST.",{"_3376":69374,"_29549":69264,"_20523":116394,"_5":14087,"_26884":116140,"_2862":113760},[],{"_3376":69375,"_29549":69264,"_20523":116396,"_5":14087,"_26884":116140,"_2862":116397},[],"Qué publica",{"_3376":69376,"_29549":69264,"_20523":116399,"_5":14087,"_26884":116140,"_2862":51197},[],{"_3376":69377,"_29549":69264,"_20523":116401,"_5":14087,"_26884":116140,"_2862":116402},[],"Certificado TLS downstream disponible; puede ser una hoja, no una CA de emisión.",{"_3376":69378,"_29549":69264,"_20523":116404,"_5":14087,"_26884":116140,"_2862":51203},[],{"_3376":69379,"_29549":69264,"_20523":116406,"_5":14087,"_26884":116140,"_2862":116407},[],"Certificado de la CA emisora seleccionada.",{"_3376":69380,"_29549":69264,"_20523":116409,"_5":14087,"_26884":116140,"_2862":51209},[],{"_3376":69381,"_29549":69264,"_20523":116411,"_5":14087,"_26884":116140,"_2862":116412},[],"Certificados de las CAs elegidas explícitamente.",{"_3376":69382,"_29549":69264,"_20523":116414,"_5":14087,"_26884":116140,"_2862":116415},[],"No se añaden todos los ascendientes automáticamente. La distribución de confianza distingue raíces confiables, intermedias y confianza inicial del servidor.",{"_3376":69383,"_29549":69264,"_20523":116417,"_5":14087,"_26884":116144,"_2862":116418},[],"**Edit** cambia nombre, ajustes y metadatos. Las actualizaciones se realizan mediante la API de DMS. `PUT /v1/dms/{id}` siempre actúa sobre el DMS identificado en la ruta de la URL: el cuerpo no lleva campo `id`, y cualquier `id` o `creation_ts` que contenga se ignora silenciosamente; la autorización se evalúa contra ese mismo identificador de la ruta. El cuerpo debe incluir un `name` no vacío y un objeto `settings`; si falta alguno, la respuesta es HTTP 400 y el DMS almacenado no se modifica. `name` y `settings` se sustituyen siempre por completo, así que lee el DMS antes de enviar una edición por API para no perder campos. `metadata` es opcional: si se omite o se envía `null`, se conservan los metadatos almacenados; un objeto suministrado los sustituye por completo; `{}` los borra (una consulta GET posterior devuelve un objeto vacío, no `null`). Los cuerpos al estilo antiguo que transportan el DMS completo siguen funcionando mientras incluyan `name` y `settings`; los campos desconocidos se ignoran. La actualización rechaza un `name` vacío con HTTP 400: un DMS cuyo nombre almacenado quedó vacío por una actualización anterior debe renombrarse antes de que cualquier cliente lo vuelva a leer y reenviar, incluida la escritura de vuelta del conector de AWS IoT en modo JITP. Si el objeto no incluye la clave del conector de AWS IoT (`lamassu.io/iot/{connector_id}`), el conector ignora los eventos siguientes del DMS.",{"_3376":69384,"_29549":69264,"_20523":116420,"_5":14087,"_26884":116144,"_2862":116421},[],"**Go to DMS owned devices** limita el inventario al propietario. **Show/Edit Metadata** contiene datos operativos y de integraciones; consulta su guía antes de alterarlos. &#x2A;*EST (RFC-7030)** ayuda a localizar las URLs.",{"_3376":69385,"_29549":69264,"_20523":116423,"_5":14087,"_26884":116144,"_2862":116424},[],"**Delete** elimina el registro y la configuración del DMS; no realiza por sí solo una cascada de revocación sobre todos sus dispositivos y certificados. Migra dependencias y conserva las referencias de auditoría antes de retirarlo.",{"_3376":69386,"_29549":69264,"_20523":116426,"_5":14087,"_26884":116148,"_2862":116427},[],"Continúa con Cliente EST o el tutorial de enrolamiento y mTLS. La Referencia EST recoge formatos; Diagnóstico recoge fallos.",{"_3376":69387,"_29549":69387,"_5":14445,"_2862":116429,"_29881":116430,"_20523":116431,"_26884":69387},"Integra el cliente EST",[48111,114818,50590,115827,116002],[],{"_3376":69388,"_29549":69387,"_20523":116433,"_5":14087,"_26884":69387,"_2862":116434},[],"Prepara la confianza, envía una CSR y comprueba la identidad recibida.",{"_3376":69389,"_29549":69387,"_5":29878,"_20523":116436,"_26884":116437,"_2862":113396},[],"/docs/es/platform/iot-fleets/enrollment/est-client#antes-de-empezar",{"_3376":69390,"_29549":69387,"_5":29878,"_20523":116439,"_26884":116440,"_2862":116441},[],"/docs/es/platform/iot-fleets/enrollment/est-client#descarga-e-inspecciona-cacerts","Descarga e inspecciona cacerts",{"_3376":69391,"_29549":69387,"_5":29878,"_20523":116443,"_26884":116444,"_2862":116445},[],"/docs/es/platform/iot-fleets/enrollment/est-client#prepara-la-csr","Prepara la CSR",{"_3376":69392,"_29549":69387,"_5":29878,"_20523":116447,"_26884":116448,"_2862":116449},[],"/docs/es/platform/iot-fleets/enrollment/est-client#solicita-la-identidad","Solicita la identidad",{"_3376":69393,"_29549":69387,"_5":29878,"_20523":116451,"_26884":116452,"_2862":116453},[],"/docs/es/platform/iot-fleets/enrollment/est-client#comprueba-e-instala-el-resultado","Comprueba e instala el resultado",{"_3376":69394,"_29549":69387,"_5":29878,"_20523":116455,"_26884":116456,"_2862":116457},[],"/docs/es/platform/iot-fleets/enrollment/est-client#siguientes-pasos","Siguientes pasos",{"_3376":69395,"_29549":69387,"_20523":116459,"_5":14087,"_26884":69387,"_2862":116460},[],"Esta guía es para quien implementa el cliente del dispositivo. El administrador debe haber preparado la política DMS. Para una primera ejecución completa, sigue Enrola y conecta tu primer dispositivo.",{"_3376":69396,"_29549":69387,"_20523":116462,"_5":14087,"_26884":116437,"_2862":116463},[],"Necesitas el URL HTTPS público del DMS, la confianza del servidor obtenida por un canal aprobado, el modo de autenticación de la operación y un identificador admitido. Los ejemplos usan Bash, OpenSSL 3.x y curl con `--fail-with-body`; utiliza un directorio privado de trabajo y una versión compatible de esas herramientas.",{"_3376":69397,"_29549":69387,"_20523":116465,"_5":14087,"_26884":116437,"_2862":116466},[],"Prepara `est-trust.pem` para verificar al servidor EST, `bootstrap.crt` y `bootstrap.key` para la autenticación inicial por certificado, y `device-root.pem` como raíz aprobada del emisor de dispositivos. Los dos archivos de confianza pueden contener raíces distintas. Si usas otra autenticación, adapta las credenciales según Identidad inicial.",{"_3376":69398,"_29549":69387,"_20523":116468,"_5":14087,"_26884":116437,"_2862":116469},[],"Sustituye el host y `REPLACE_DMS_ID` por los de tu instalación. El APS del URL es el identificador del DMS, no su nombre visible.",{"_3376":69399,"_29549":69387,"_20523":116471,"_5":14087,"_26884":116440,"_2862":116472},[],"El contenido predeterminado es PKCS#7 DER codificado en Base64. No es un archivo PEM directo.",{"_3376":69400,"_29549":69387,"_20523":116474,"_5":14087,"_26884":116440,"_2862":116475},[],"Comprueba las huellas, emisores y fechas frente a la política de distribución de confianza. La respuesta puede contener una selección de CAs y el certificado TLS de Lamassu. No conviertas todo el contenido en raíces confiables ni lo utilices para autenticar la misma descarga inicial. Un HTTP 200 aquí no demuestra que la autenticación ni la emisión funcionen.",{"_3376":69401,"_29549":69387,"_20523":116477,"_5":14087,"_26884":116444,"_2862":116478},[],"El ejemplo genera una clave EC P-256 nueva y usa `est-device-001`, que debe estar libre si el DMS registra automáticamente. El `Common Name` será el identificador del dispositivo. Comprueba que el perfil permite la clave y el sujeto elegidos.",{"_3376":69402,"_29549":69387,"_20523":116480,"_5":14087,"_26884":116444,"_2862":116481},[],"Una implementación con hardware o almacén propio debe producir la CSR mediante su clave residente. `simpleenroll` envía la solicitud y conserva la clave en el cliente. Honor Extensions no autoriza todos los atributos pedidos: consulta Perfiles.",{"_3376":69403,"_29549":69387,"_20523":116483,"_5":14087,"_26884":116448,"_2862":116484},[],"Con autenticación inicial `CLIENT_CERTIFICATE`, envía la CSR DER en Base64 con `Content-Type: application/pkcs10`:",{"_3376":69404,"_29549":69387,"_20523":116486,"_5":14087,"_26884":116448,"_2862":116487},[],"Detén el proceso si curl falla. Conserva el código HTTP, cabeceras y cuerpo para el diagnóstico; una respuesta de error no se decodifica como certificado. El ejemplo Bash se detiene antes de esa conversión. Un timeout deja el resultado de la operación por comprobar en Lamassu: no repitas automáticamente una emisión.",{"_3376":69405,"_29549":69387,"_20523":116489,"_5":14087,"_26884":116452,"_2862":116490},[],"Para el caso de una raíz que emite directamente:",{"_3376":69406,"_29549":69387,"_20523":116492,"_5":14087,"_26884":116452,"_2862":116493},[],"Verifica además que el CN es el esperado, el certificado es final, los usos permiten tu aplicación y las fechas satisfacen el perfil. `cmp` debe terminar con código 0. Si hay intermedias, aporta la cadena con `-untrusted` según Validación PKI.",{"_3376":69407,"_29549":69387,"_20523":116495,"_5":14087,"_26884":116452,"_2862":116496},[],"Consulta el dispositivo: DMS propietario, número de serie actual e historial deben corresponder al resultado. Guarda la pareja clave/certificado de forma protegida e instala ambos mediante el mecanismo del dispositivo. La asociación en Lamassu no instala archivos en el cliente. Comprueba una conexión real antes de considerar terminado el proceso.",{"_3376":69408,"_29549":69387,"_20523":116498,"_5":14087,"_26884":116456,"_2862":116499},[],"Implementa renovación y recuperación y la actualización de confianza. La referencia EST recoge endpoints, formatos y ServerKeyGen; el diagnóstico ayuda a distinguir errores de transporte, admisión y persistencia.",{"_3376":69409,"_29549":69409,"_5":14445,"_2862":116501,"_29881":116502,"_20523":116503,"_26884":69409},"Referencia EST",[48111,114818,50590,115827,116002],[],{"_3376":69410,"_29549":69409,"_20523":116505,"_5":14087,"_26884":69409,"_2862":116506},[],"Consulta las rutas, formatos, autenticación y respuesta multipart de Lamassu.",{"_3376":69411,"_29549":69409,"_5":29878,"_20523":116508,"_26884":116509,"_2862":116510},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#referencia-de-endpoints","Referencia de endpoints",{"_3376":69412,"_29549":69409,"_5":29878,"_20523":116512,"_26884":116513,"_2862":22251},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#cacerts",{"_3376":69413,"_29549":69409,"_5":29878,"_20523":116515,"_26884":116516,"_2862":25531},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simpleenroll",{"_3376":69414,"_29549":69409,"_5":29878,"_20523":116518,"_26884":116519,"_2862":25538},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#simplereenroll",{"_3376":69415,"_29549":69409,"_5":29878,"_20523":116521,"_26884":116522,"_2862":24866},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#serverkeygen",{"_3376":69416,"_29549":69409,"_5":29878,"_20523":116524,"_26884":116525,"_2862":116526},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#formato-de-respuesta","Formato de respuesta",{"_3376":69417,"_29549":69409,"_5":29878,"_20523":116528,"_26884":116529,"_2862":116530},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#solicitud-y-extracción","Solicitud y extracción",{"_3376":69418,"_29549":69409,"_5":29878,"_20523":116532,"_26884":116533,"_2862":116534},[],"/docs/es/platform/iot-fleets/enrollment/est-reference#notas-de-compatibilidad","Notas de compatibilidad",{"_3376":69419,"_29549":69409,"_20523":116536,"_5":14087,"_26884":69409,"_2862":116537},[],"Referencia del contrato del backend examinado, basada en RFC 7030. Utiliza Cliente EST para el procedimiento y DMS para configurar la política.",{"_3376":69420,"_29549":69409,"_20523":116539,"_5":14087,"_26884":116509,"_2862":116540},[],"Ruta pública de los ejemplos: `/.well-known/est/{APS}/{operation}`. `APS` es el ID del DMS. El router admite rutas sin ese segmento, pero el controlador lo requiere; no las utilices como servicio predeterminado. La configuración del Gateway determina el host y la ruta públicos.",{"_3376":69421,"_29549":69409,"_20523":116542,"_5":14087,"_26884":116509,"_2862":114578},[],{"_3376":69422,"_29549":69409,"_20523":116544,"_5":14087,"_26884":116509,"_2862":116545},[],"Método",{"_3376":69423,"_29549":69409,"_20523":116547,"_5":14087,"_26884":116509,"_2862":116548},[],"Autenticación y condición",{"_3376":69424,"_29549":69409,"_20523":116550,"_5":14087,"_26884":116509,"_2862":51352},[],{"_3376":69425,"_29549":69409,"_20523":116552,"_5":14087,"_26884":116509,"_2862":51355},[],{"_3376":69426,"_29549":69409,"_20523":116554,"_5":14087,"_26884":116509,"_2862":116555},[],"La lectura DMS no exige credencial EST; HTTPS y controles de infraestructura siguen aplicándose.",{"_3376":69427,"_29549":69409,"_20523":116557,"_5":14087,"_26884":116509,"_2862":51361},[],{"_3376":69428,"_29549":69409,"_20523":116559,"_5":14087,"_26884":116509,"_2862":51364},[],{"_3376":69429,"_29549":69409,"_20523":116561,"_5":14087,"_26884":116509,"_2862":116562},[],"Autenticación inicial y política de registro/sustitución del DMS.",{"_3376":69430,"_29549":69409,"_20523":116564,"_5":14087,"_26884":116509,"_2862":51370},[],{"_3376":69431,"_29549":69409,"_20523":116566,"_5":14087,"_26884":116509,"_2862":51364},[],{"_3376":69432,"_29549":69409,"_20523":116568,"_5":14087,"_26884":116509,"_2862":116569},[],"Autenticación de renovación, identidad existente, sujeto, revocación y ventana.",{"_3376":69433,"_29549":69409,"_20523":116571,"_5":14087,"_26884":116509,"_2862":51378},[],{"_3376":69434,"_29549":69409,"_20523":116573,"_5":14087,"_26884":116509,"_2862":51364},[],{"_3376":69435,"_29549":69409,"_20523":116575,"_5":14087,"_26884":116509,"_2862":116576},[],"Autenticación y admisión iniciales; generación en servidor habilitada.",{"_3376":69436,"_29549":69409,"_20523":116578,"_5":14087,"_26884":116509,"_2862":116579},[],"Estas rutas no implementan `/csrattrs` ni `/fullcmc`. No hay un modo EST nativo de autenticación JWT; un webhook puede interpretar una credencial de la petición según su propio contrato.",{"_3376":69437,"_29549":69409,"_20523":116581,"_5":14087,"_26884":116513,"_2862":116582},[],"La respuesta predeterminada tiene `Content-Type: application/pkcs7-mime; smime-type=certs-only` y `Content-Transfer-Encoding: base64`. El cuerpo es PKCS#7 DER en Base64 con líneas de hasta 76 caracteres. Incluye los certificados seleccionados por el DMS, no necesariamente todos los ascendientes.",{"_3376":69438,"_29549":69409,"_20523":116584,"_5":14087,"_26884":116513,"_2862":116585},[],"`Accept: application/x-pem-file` solicita el conjunto en PEM mediante una extensión de Lamassu. Su contenido debe inspeccionarse y aprobarse antes de modificar raíces confiables.",{"_3376":69439,"_29549":69409,"_20523":116587,"_5":14087,"_26884":116516,"_2862":116588},[],"Envía una CSR PKCS#10 DER codificada en Base64, con `Content-Type: application/pkcs10`. El controlador examinado compara ese media type literalmente; evita añadir parámetros como charset. El CN identifica el dispositivo y la firma de la CSR debe verificarse mediante la política DMS.",{"_3376":69440,"_29549":69409,"_20523":116590,"_5":14087,"_26884":116516,"_2862":116591},[],"La respuesta predeterminada usa el formato PKCS#7/Base64 descrito para cacerts, pero contiene el certificado emitido; no presupongas que incluye toda su cadena. `Accept: application/x-pem-file` devuelve ese certificado en PEM. El cliente conserva la clave que firmó la CSR.",{"_3376":69441,"_29549":69409,"_20523":116593,"_5":14087,"_26884":116519,"_2862":116594},[],"Usa el mismo formato de solicitud y de certificado de respuesta. La autenticación se obtiene del bloque independiente `reenrollment_settings.est_rfc7030_settings`. Con certificado cliente, su CN debe coincidir con el CN de la CSR; también se comprueba el sujeto frente al certificado actual.",{"_3376":69442,"_29549":69409,"_20523":116596,"_5":14087,"_26884":116519,"_2862":116597},[],"En el modo mTLS, la CA de enrolamiento siempre valida la credencial de reenrolamiento; los certificados de otros emisores se aceptan solo si figuran como CAs de validación en el bloque de reenrolamiento. La comprobación de vencimiento por `enable_expired_renewal` corresponde a ese validador. El certificado actual revocado y una solicitud anterior a la ventana se rechazan. Consulta Renovación para instalación y recuperación.",{"_3376":69443,"_29549":69409,"_20523":116599,"_5":14087,"_26884":116522,"_2862":116600},[],"El servidor genera una clave software, reconstruye la CSR con esa clave y ejecuta el enrolamiento inicial. El flag debe estar habilitado y el algoritmo permitido por el perfil. La clave de esta operación no pasa a ser una clave hardware por utilizar una CA alojada en HSM.",{"_3376":69444,"_29549":69409,"_20523":116602,"_5":14087,"_26884":116522,"_2862":116603},[],"El código admite RSA y ECDSA, y el valor `bits` del ajuste de clave del DMS significa algo distinto en cada caso. En ECDSA selecciona la curva: 224, 256, 384 o 521 corresponden a P-224, P-256, P-384 y P-521, y un tamaño no reconocido produce fallback a P-256, así que elige explícitamente un tamaño compatible y comprueba la clave resultante. En RSA se usa directamente como tamaño del módulo; la consola ofrece 2048, 3072 y 4096 bits. No reutilices un ID enrolado para probar esta operación sin revisar sustitución.",{"_3376":69445,"_29549":69409,"_20523":116605,"_5":14087,"_26884":116525,"_2862":116606},[],"El cuerpo es **MIME multipart/mixed**, con boundary indicado en `Content-Type`. Tiene dos partes:",{"_3376":69446,"_29549":69409,"_20523":116608,"_5":14087,"_26884":116525,"_2862":116609},[],"Parte",{"_3376":69447,"_29549":69409,"_20523":116611,"_5":14087,"_26884":116525,"_2862":116612},[],"Contenido tras decodificar su Base64",{"_3376":69448,"_29549":69409,"_20523":116614,"_5":14087,"_26884":116525,"_2862":51422},[],{"_3376":69449,"_29549":69409,"_20523":116616,"_5":14087,"_26884":116525,"_2862":116617},[],"Clave privada PKCS#8 DER sin cifrar.",{"_3376":69450,"_29549":69409,"_20523":116619,"_5":14087,"_26884":116525,"_2862":51428},[],{"_3376":69451,"_29549":69409,"_20523":116621,"_5":14087,"_26884":116525,"_2862":116622},[],"PKCS#7 DER con el certificado emitido.",{"_3376":69452,"_29549":69409,"_20523":116624,"_5":14087,"_26884":116525,"_2862":116625},[],"El controlador también añade `Content-Transfer-Encoding: base64` en la cabecera exterior, aunque el cuerpo exterior es texto MIME. &#x2A;*No decodifiques el cuerpo completo como Base64.** Lee el boundary real y decodifica cada parte según sus cabeceras.",{"_3376":69453,"_29549":69409,"_20523":116627,"_5":14087,"_26884":116529,"_2862":116628},[],"En una sesión Bash con `set -euo pipefail` y `umask 077`, utiliza `EST_BASE` y los archivos de confianza/bootstrap de Cliente EST. Elige `est-serverkeygen-001` libre y admitido. La clave `server-request.key` solo firma la CSR de entrada; la identidad recibida utilizará la clave generada por el servidor.",{"_3376":69454,"_29549":69409,"_20523":116630,"_5":14087,"_26884":116529,"_2862":116631},[],"Guarda este extractor Python 3. Valida las dos partes antes de escribir y rechaza archivos de salida existentes:",{"_3376":69455,"_29549":69409,"_20523":116633,"_5":14087,"_26884":116529,"_2862":116634},[],"Convierte y comprueba el resultado:",{"_3376":69456,"_29549":69409,"_20523":116636,"_5":14087,"_26884":116529,"_2862":116637},[],"Inspecciona CN, serie, fechas y usos; comprueba la asociación en Lamassu antes de instalar. Protege los archivos DER y PEM que contienen la clave y elimina copias temporales según el almacenamiento del dispositivo. Consulta openssl-pkcs8 y el parser MIME de Python.",{"_3376":69457,"_29549":69409,"_20523":116639,"_5":14087,"_26884":116533,"_2862":116640},[],"No interpretes cualquier 500 como un fallo transitorio. La entrada inválida suele producir 400; rechazos y errores del servicio suelen producir 500 con un cuerpo JSON `err`. Los errores de Gateway y algunos caminos del controlador pueden tener otro formato. Conserva cabeceras y cuerpo antes de decodificar y consulta el diagnóstico.",{"_3376":69458,"_29549":69409,"_20523":116642,"_5":14087,"_26884":116533,"_2862":116643},[],"Los ejemplos utilizan openssl-pkcs7 para extraer certificados y openssl-x509 para preparar renovación. Comprueba capacidades y respuestas de tu versión antes de integrar un cliente EST genérico.",{"_3376":69459,"_29549":69459,"_5":14445,"_2862":116002,"_29881":116645,"_20523":116646,"_26884":69459},[48111,114818,50590,115827,116002],[],{"_3376":69460,"_29549":69459,"_20523":116648,"_5":14087,"_26884":69459,"_2862":116649},[],"Elige la política de admisión y conecta DMS, confianza inicial y cliente EST.",{"_3376":69461,"_29549":69459,"_5":29878,"_20523":116651,"_26884":116652,"_2862":116653},[],"/docs/es/platform/iot-fleets/enrollment/overview#el-recorrido","El recorrido",{"_3376":69462,"_29549":69459,"_5":29878,"_20523":116655,"_26884":116656,"_2862":116657},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-administrador","Para el administrador",{"_3376":69463,"_29549":69459,"_5":29878,"_20523":116659,"_26884":116660,"_2862":116661},[],"/docs/es/platform/iot-fleets/enrollment/overview#para-el-integrador","Para el integrador",{"_3376":69464,"_29549":69459,"_5":29878,"_20523":116663,"_26884":116664,"_2862":116665},[],"/docs/es/platform/iot-fleets/enrollment/overview#versión-del-contrato","Versión del contrato",{"_3376":69465,"_29549":69459,"_20523":116667,"_5":14087,"_26884":69459,"_2862":116668},[],"Enrollment with PKI reúne el recorrido desde la admisión del dispositivo hasta la instalación y renovación de su identidad. El DMS actúa como autoridad de registro: autentica la solicitud, aplica la política de registro y pide a la CA que firme. El cliente conserva o recibe la clave, instala el resultado y lo presenta al consumidor.",{"_3376":69466,"_29549":69459,"_20523":116670,"_5":14087,"_26884":116652,"_2862":116671},[],"El administrador prepara CA, perfil de emisión y DMS.",{"_3376":69467,"_29549":69459,"_20523":116673,"_5":14087,"_26884":116652,"_2862":116674},[],"El integrador instala confianza inicial en el servidor EST y una credencial de admisión.",{"_3376":69468,"_29549":69459,"_20523":116676,"_5":14087,"_26884":116652,"_2862":116677},[],"El cliente solicita una identidad para su `Device ID` mediante EST.",{"_3376":69469,"_29549":69459,"_20523":116679,"_5":14087,"_26884":116652,"_2862":116680},[],"Se comprueban certificado, vinculación al dispositivo e instalación de la pareja clave/certificado.",{"_3376":69470,"_29549":69459,"_20523":116682,"_5":14087,"_26884":116652,"_2862":116683},[],"El consumidor valida y autoriza la identidad; el cliente programa renovación y recuperación.",{"_3376":69471,"_29549":69459,"_20523":116685,"_5":14087,"_26884":116652,"_2862":116686},[],"EST utiliza `/.well-known/est/{DMS_ID}`. Las APIs administrativas y la asignación manual siguen siendo recorridos distintos. Enrola y conecta un dispositivo completa una primera prueba con mTLS.",{"_3376":69472,"_29549":69459,"_20523":116688,"_5":14087,"_26884":116656,"_2862":116689},[],"<Card title=\"Estrategias de aprovisionamiento\" description=\"Elige registro automático, prerregistro o asignación manual.\" href=\"/docs/platform/iot-fleets/enrollment/provisioning-strategies\" />",{"_3376":69473,"_29549":69459,"_20523":116691,"_5":14087,"_26884":116656,"_2862":116692},[],"<Card title=\"Configura el DMS\" description=\"Separa admisión, autenticación por operación, perfil y distribución.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":69474,"_29549":69459,"_20523":116694,"_5":14087,"_26884":116656,"_2862":116695},[],"<Card title=\"Identidad inicial y autenticación\" description=\"Decide qué prueba permite solicitar la primera identidad.\" href=\"/docs/platform/iot-fleets/enrollment/bootstrap-identity\" />",{"_3376":69475,"_29549":69459,"_20523":116697,"_5":14087,"_26884":116656,"_2862":116698},[],"<Card title=\"Distribución de confianza\" description=\"Actualiza raíces y cadenas con un solapamiento comprobado.\" href=\"/docs/platform/iot-fleets/enrollment/trust-distribution\" />",{"_3376":69476,"_29549":69459,"_20523":116700,"_5":14087,"_26884":116660,"_2862":116701},[],"<Card title=\"Cliente EST\" description=\"Prepara la solicitud, verifica la respuesta e instala la identidad.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3376":69477,"_29549":69459,"_20523":116703,"_5":14087,"_26884":116660,"_2862":116704},[],"<Card title=\"Renovación y recuperación\" description=\"Genera el sucesor y trata credenciales vencidas o perdidas.\" href=\"/docs/platform/iot-fleets/enrollment/renewal-and-recovery\" />",{"_3376":69478,"_29549":69459,"_20523":116706,"_5":14087,"_26884":116660,"_2862":116707},[],"<Card title=\"Referencia EST\" description=\"Consulta rutas, formatos, autenticación y ServerKeyGen.\" href=\"/docs/platform/iot-fleets/enrollment/est-reference\" />",{"_3376":69479,"_29549":69459,"_20523":116709,"_5":14087,"_26884":116660,"_2862":116710},[],"<Card title=\"Diagnóstico\" description=\"Distingue fallos de transporte, política, emisión e instalación.\" href=\"/docs/platform/iot-fleets/enrollment/troubleshooting\" />",{"_3376":69480,"_29549":69459,"_20523":116712,"_5":14087,"_26884":116664,"_2862":116713},[],"Este bloque describe el código de `main` examinado en el commit `8f42c47157f9a36bac3ed5caa3692aebebe19c4b`. El catálogo del sitio publica `main (unstable)`; no se atribuye este comportamiento a una release estable. Antes de utilizar otra versión, comprueba su contrato, especialmente la autenticación independiente de reenrolamiento. Las comprobaciones de cliente y las pruebas contra una instancia se distinguen en el plan de revisión.",{"_3376":69481,"_29549":69459,"_20523":116715,"_5":14087,"_26884":116664,"_2862":116716},[],"La configuración del Gateway, TLS, proveedores y servicios pertenece a Despliegue. El uso de la identidad en AWS u otros destinos corresponde a Integraciones.",{"_3376":69482,"_29549":69482,"_5":14445,"_2862":116718,"_29881":116719,"_20523":116720,"_26884":69482},"Estrategias de aprovisionamiento",[48111,114818,50590,115827,116002],[],{"_3376":69483,"_29549":69482,"_20523":116722,"_5":14087,"_26884":69482,"_2862":116723},[],"Elige cómo se registra el dispositivo, quién autoriza su identidad y dónde se genera la clave.",{"_3376":69484,"_29549":69482,"_5":29878,"_20523":116725,"_26884":116726,"_2862":116727},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-el-registro","Elige el registro",{"_3376":69485,"_29549":69482,"_5":29878,"_20523":116729,"_26884":116730,"_2862":116731},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#prerregistro-y-sustitución","Prerregistro y sustitución",{"_3376":69486,"_29549":69482,"_5":29878,"_20523":116733,"_26884":116734,"_2862":116735},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-autenticación","Elige la autenticación",{"_3376":69487,"_29549":69482,"_5":29878,"_20523":116737,"_26884":116738,"_2862":116739},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#elige-la-custodia","Elige la custodia",{"_3376":69488,"_29549":69482,"_5":29878,"_20523":116741,"_26884":116742,"_2862":116743},[],"/docs/es/platform/iot-fleets/enrollment/provisioning-strategies#comprueba-la-decisión","Comprueba la decisión",{"_3376":69489,"_29549":69482,"_20523":116745,"_5":14087,"_26884":69482,"_2862":116746},[],"Esta guía ayuda al administrador de aprovisionamiento a elegir un recorrido antes de configurar el DMS. Separa tres decisiones: cuándo existe el dispositivo, cómo se autoriza la solicitud y quién genera su clave. Ninguna de ellas concede por sí sola acceso en el destino.",{"_3376":69490,"_29549":69482,"_20523":116748,"_5":14087,"_26884":116726,"_2862":116749},[],"Recorrido",{"_3376":69491,"_29549":69482,"_20523":116751,"_5":14087,"_26884":116726,"_2862":116752},[],"Cuándo existe el dispositivo",{"_3376":69492,"_29549":69482,"_20523":116754,"_5":14087,"_26884":116726,"_2862":116755},[],"Qué compruebas",{"_3376":69493,"_29549":69482,"_20523":116757,"_5":14087,"_26884":116726,"_2862":116758},[],"Asignación manual",{"_3376":69494,"_29549":69482,"_20523":116760,"_5":14087,"_26884":116726,"_2862":116761},[],"El operador lo crea antes de asociar un certificado.",{"_3376":69495,"_29549":69482,"_20523":116763,"_5":14087,"_26884":116726,"_2862":116764},[],"ID, DMS propietario, CN del certificado y serie vinculada.",{"_3376":69496,"_29549":69482,"_20523":116766,"_5":14087,"_26884":116726,"_2862":116767},[],"EST con `JITP`",{"_3376":69497,"_29549":69482,"_20523":116769,"_5":14087,"_26884":116726,"_2862":116770},[],"Se crea para un CN desconocido durante `/simpleenroll`.",{"_3376":69498,"_29549":69482,"_20523":116772,"_5":14087,"_26884":116726,"_2862":116773},[],"Credencial autorizada, ID libre, perfil, alta e identidad resultantes.",{"_3376":69499,"_29549":69482,"_20523":116775,"_5":14087,"_26884":116726,"_2862":116776},[],"EST con `PRE_REGISTRATION`",{"_3376":69500,"_29549":69482,"_20523":116778,"_5":14087,"_26884":116726,"_2862":116779},[],"Debe existir antes de `/simpleenroll`.",{"_3376":69501,"_29549":69482,"_20523":116781,"_5":14087,"_26884":116726,"_2862":116782},[],"Registro aprobado, mismo DMS y condiciones de sustitución de tu versión.",{"_3376":69502,"_29549":69482,"_20523":116784,"_5":14087,"_26884":116726,"_2862":116785},[],"`JITP` de Lamassu crea inventario e identidad en Lamassu. JITP de AWS aprovisiona un destino en AWS; son decisiones diferentes.",{"_3376":69503,"_29549":69482,"_20523":116787,"_5":14087,"_26884":116726,"_2862":116788},[],"Para una primera prueba desde el cliente, utiliza Enrola y conecta un dispositivo. Para preparar inventario sin EST, sigue Registro manual.",{"_3376":69504,"_29549":69482,"_20523":116790,"_5":14087,"_26884":116730,"_2862":116791},[],"En el código examinado, encontrar cualquier dispositivo del mismo DMS activa el control `enable_replaceable_enrollment` antes de comprobar PRE\\_REGISTRATION. Con el flag desactivado, un dispositivo prerregistrado puede recibir `forbiddenNewEnrollment` incluso estando en **No Identity**. No se presenta ese recorrido como garantizado por seleccionar únicamente PRE\\_REGISTRATION.",{"_3376":69505,"_29549":69482,"_20523":116793,"_5":14087,"_26884":116730,"_2862":116794},[],"Activar el flag permite repetir `/simpleenroll` para un ID existente. El backend programa un intento diferido de revocación del certificado anterior con `Superseded`; también puede ejecutarlo si después falla la emisión o vinculación. Si no había identidad, el intento puede fallar por falta de serie. El flag no es una transacción de sustitución ni garantiza restaurar el estado anterior.",{"_3376":69506,"_29549":69482,"_20523":116796,"_5":14087,"_26884":116730,"_2862":116797},[],"Prueba el caso exacto de tu versión antes de habilitarlo en una población. Para una identidad ya operativa y una renovación autorizada, utiliza `/simplereenroll`; para recuperar una identidad, sigue Renovación y recuperación y confirma el estado persistido antes de reintentar.",{"_3376":69507,"_29549":69482,"_20523":116799,"_5":14087,"_26884":116734,"_2862":116800},[],"Decide por separado primer enrolamiento y reenrolamiento:",{"_3376":69508,"_29549":69482,"_20523":116802,"_5":14087,"_26884":116734,"_2862":116803},[],"**Certificado cliente:** útil cuando cada equipo dispone de una credencial inicial cuya clave controla.",{"_3376":69509,"_29549":69482,"_20523":116805,"_5":14087,"_26884":116734,"_2862":116806},[],"**Webhook:** útil cuando otra autoridad conoce inventario, credenciales o derecho a solicitar un ID.",{"_3376":69510,"_29549":69482,"_20523":116808,"_5":14087,"_26884":116734,"_2862":116809},[],"**Certificado y webhook:** exige ambos controles en la operación configurada.",{"_3376":69511,"_29549":69482,"_20523":116811,"_5":14087,"_26884":116734,"_2862":116812},[],"**NO\\_AUTH:** no acredita al solicitante; solo encaja cuando el control de admisión se resuelve de forma deliberada fuera de ese DMS.",{"_3376":69512,"_29549":69482,"_20523":116814,"_5":14087,"_26884":116734,"_2862":116815},[],"Autenticar un certificado inicial no demuestra por sí solo el derecho a elegir cualquier CN en la CSR. Define esa autorización en Identidad inicial y autenticación.",{"_3376":69513,"_29549":69482,"_20523":116817,"_5":14087,"_26884":116738,"_2862":113760},[],{"_3376":69514,"_29549":69482,"_20523":116819,"_5":14087,"_26884":116738,"_2862":116820},[],"Material que atraviesa EST",{"_3376":69515,"_29549":69482,"_20523":116822,"_5":14087,"_26884":116738,"_2862":116823},[],"Clave generada por el dispositivo",{"_3376":69516,"_29549":69482,"_20523":116825,"_5":14087,"_26884":116738,"_2862":116826},[],"CSR pública y certificado; la clave permanece en el cliente.",{"_3376":69517,"_29549":69482,"_20523":116828,"_5":14087,"_26884":116738,"_2862":116829},[],"Clave ya disponible en el dispositivo",{"_3376":69518,"_29549":69482,"_20523":116831,"_5":14087,"_26884":116738,"_2862":116832},[],"CSR firmada con la clave existente y certificado nuevo.",{"_3376":69519,"_29549":69482,"_20523":116834,"_5":14087,"_26884":116738,"_2862":50909},[],{"_3376":69520,"_29549":69482,"_20523":116836,"_5":14087,"_26884":116738,"_2862":116837},[],"Clave privada PKCS#8 y certificado en una respuesta multipart protegida por TLS.",{"_3376":69521,"_29549":69482,"_20523":116839,"_5":14087,"_26884":116738,"_2862":116840},[],"Elegir ServerKeyGen no utiliza automáticamente el HSM o KMS de la CA para la clave del dispositivo. Revisa su contrato y extracción y la capacidad del dispositivo para instalar el material.",{"_3376":69522,"_29549":69482,"_20523":116842,"_5":14087,"_26884":116742,"_2862":116843},[],"Antes de extender el flujo, prueba alta permitida, credencial incorrecta, ID de otro DMS, solicitud repetida y recuperación tras un fallo. Conserva ID, serie, versión activa y error. Comprueba también aceptación y rechazo en el consumidor; un certificado emitido no implica que el destino lo conozca o permita operar.",{"_3376":69523,"_29549":69523,"_5":14445,"_2862":116845,"_29881":116846,"_20523":116847,"_26884":69523},"Renovación y recuperación",[48111,114818,50590,115827,116002],[],{"_3376":69524,"_29549":69523,"_20523":116849,"_5":14087,"_26884":69523,"_2862":116850},[],"Renueva sin perder la identidad y recupera dispositivos según su estado real.",{"_3376":69525,"_29549":69523,"_5":29878,"_20523":116852,"_26884":116853,"_2862":116854},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#prepara-la-renovación","Prepara la renovación",{"_3376":69526,"_29549":69523,"_5":29878,"_20523":116856,"_26884":116857,"_2862":116858},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#solicita-el-certificado-sucesor","Solicita el certificado sucesor",{"_3376":69527,"_29549":69523,"_5":29878,"_20523":116860,"_26884":116861,"_2862":116862},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#instala-y-comprueba-la-nueva-pareja","Instala y comprueba la nueva pareja",{"_3376":69528,"_29549":69523,"_5":29878,"_20523":116864,"_26884":116865,"_2862":116866},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#recupera-según-el-estado","Recupera según el estado",{"_3376":69529,"_29549":69523,"_5":29878,"_20523":116868,"_26884":116869,"_2862":116870},[],"/docs/es/platform/iot-fleets/enrollment/renewal-and-recovery#operación-continua","Operación continua",{"_3376":69530,"_29549":69523,"_20523":116872,"_5":14087,"_26884":69523,"_2862":116873},[],"La renovación conserva el identificador del dispositivo y solicita un certificado sucesor. Es un proceso que debe completar el cliente: comprobar la respuesta, instalar la pareja correspondiente y demostrar que el consumidor la acepta. Las alertas de Lamassu avisan; no ejecutan esos pasos.",{"_3376":69531,"_29549":69523,"_20523":116875,"_5":14087,"_26884":116853,"_2862":116876},[],"Consulta el certificado actual en Lamassu y compáralo con el instalado. Necesitas su sujeto, serie y fechas, además de la clave del cliente.",{"_3376":69532,"_29549":69523,"_20523":116878,"_5":14087,"_26884":116853,"_2862":116879},[],"Comprueba el modo de autenticación de **re-enrollment**: es independiente del inicial. En `CLIENT_CERTIFICATE`, utiliza la identidad actual, no asumas que la credencial bootstrap está admitida.",{"_3376":69533,"_29549":69523,"_20523":116881,"_5":14087,"_26884":116853,"_2862":116882},[],"Calcula el inicio de la ventana: `NotAfter` del certificado actual menos `reenrollment_delta`. Los umbrales preventivo y crítico producen estados/avisos; no amplían esa ventana.",{"_3376":69534,"_29549":69523,"_20523":116884,"_5":14087,"_26884":116853,"_2862":116885},[],"Revisa **Revoke on Re-enrollment** y la recuperación si la instalación falla. Si está habilitado, Lamassu puede revocar la identidad anterior antes de que el cliente instale la nueva.",{"_3376":69535,"_29549":69523,"_20523":116887,"_5":14087,"_26884":116857,"_2862":116888},[],"El ejemplo continúa el tutorial EST, en la misma sesión Bash con `set -euo pipefail`, `umask 077` y `EST_BASE`. Usa una nueva clave compatible con el perfil. La conversión desde el certificado conserva el sujeto y copia solo SAN cuando existe; comprueba el sujeto y los nombres solicitados antes de enviarla. El backend comprueba el sujeto frente a la identidad actual: intenta igualdad de RawSubject y después compara CN, OU, O, L, ST y C. Volver a construir únicamente el CN puede perder atributos requeridos.",{"_3376":69536,"_29549":69523,"_20523":116890,"_5":14087,"_26884":116857,"_2862":116891},[],"La petición se autentica con `device.crt` y `device.key`; la CSR contiene la clave pública nueva. Comprueba también extensiones, fechas y correspondencia de serie con el slot actual en Lamassu. No vuelvas a enviar una solicitud que falló sin consultar ese estado: la emisión, la revocación anterior y la vinculación del sucesor pueden tener resultados parciales.",{"_3376":69537,"_29549":69523,"_20523":116893,"_5":14087,"_26884":116861,"_2862":116894},[],"Conserva el resultado como `device.next.crt` y `device.next.key` hasta verificarlo. Cambia la pareja mediante una operación coordinada del almacén o configuración del dispositivo; evita exponer temporalmente un certificado con la clave de otra versión.",{"_3376":69538,"_29549":69523,"_20523":116896,"_5":14087,"_26884":116861,"_2862":116897},[],"Prueba mTLS con el consumidor y verifica que utiliza la nueva serie. Confirma el historial y el certificado actual en Lamassu. Si **Revoke on Re-enrollment** estaba deshabilitado, la identidad anterior puede seguir válida: retírala conforme a la política de PKI después de probar el sucesor y comprueba la publicación y consumo de su revocación.",{"_3376":69539,"_29549":69523,"_20523":116899,"_5":14087,"_26884":116861,"_2862":116900},[],"Si la identidad anterior ya está revocada, conservar sus archivos no permite restaurar una conexión válida. La recuperación requiere una credencial admitida y una intervención autorizada según la situación.",{"_3376":69540,"_29549":69523,"_20523":116902,"_5":14087,"_26884":116865,"_2862":116903},[],"Situación",{"_3376":69541,"_29549":69523,"_20523":116905,"_5":14087,"_26884":116865,"_2862":116906},[],"Procedimiento",{"_3376":69542,"_29549":69523,"_20523":116908,"_5":14087,"_26884":116865,"_2862":116909},[],"Certificado vigente, fuera de ventana",{"_3376":69543,"_29549":69523,"_20523":116911,"_5":14087,"_26884":116865,"_2862":116912},[],"Programa la solicitud dentro de la ventana. No recurras a `simpleenroll` para saltarla.",{"_3376":69544,"_29549":69523,"_20523":116914,"_5":14087,"_26884":116865,"_2862":116915},[],"Certificado vencido, clave disponible",{"_3376":69545,"_29549":69523,"_20523":116917,"_5":14087,"_26884":116865,"_2862":116918},[],"Con autenticación por certificado, revisa `enable_expired_renewal` y que Gateway permita presentar esa credencial. Siguen aplicándose revocación, sujeto y el resto de comprobaciones.",{"_3376":69546,"_29549":69523,"_20523":116920,"_5":14087,"_26884":116865,"_2862":116921},[],"Renovación por webhook o `NO_AUTH`",{"_3376":69547,"_29549":69523,"_20523":116923,"_5":14087,"_26884":116865,"_2862":116924},[],"La comprobación mTLS de vencimiento no se ejecuta en esos modos. Define la política de vencimiento y autorización en la admisión correspondiente; el flag no constituye una prohibición universal.",{"_3376":69548,"_29549":69523,"_20523":116926,"_5":14087,"_26884":116865,"_2862":116927},[],"Clave perdida o inaccesible",{"_3376":69549,"_29549":69523,"_20523":116929,"_5":14087,"_26884":116865,"_2862":116930},[],"No puedes probar posesión de la identidad anterior. Autoriza una nueva admisión y, si procede, sustitución controlada; revoca la identidad comprometida.",{"_3376":69550,"_29549":69523,"_20523":116932,"_5":14087,"_26884":116865,"_2862":116933},[],"Identidad actual revocada",{"_3376":69551,"_29549":69523,"_20523":116935,"_5":14087,"_26884":116865,"_2862":116936},[],"`simplereenroll` rechaza el certificado actual revocado. Investiga la razón y prepara un procedimiento de readmisión autorizado; no desactives autenticación para forzarlo.",{"_3376":69552,"_29549":69523,"_20523":116938,"_5":14087,"_26884":116865,"_2862":116939},[],"Dispositivo sin identidad",{"_3376":69553,"_29549":69523,"_20523":116941,"_5":14087,"_26884":116865,"_2862":116942},[],"Usa el enrolamiento inicial. En un registro existente, comprueba la restricción de sustitución de aprovisionamiento.",{"_3376":69554,"_29549":69523,"_20523":116944,"_5":14087,"_26884":116865,"_2862":116945},[],"Dispositivo retirado",{"_3376":69555,"_29549":69523,"_20523":116947,"_5":14087,"_26884":116865,"_2862":116948},[],"Revisa la decisión operativa antes de readmitirlo. El estado Decommissioned y la revocación de todo el historial no son equivalentes.",{"_3376":69556,"_29549":69523,"_20523":116950,"_5":14087,"_26884":116865,"_2862":116951},[],"Timeout, HTTP 500 o fallo de instalación",{"_3376":69557,"_29549":69523,"_20523":116953,"_5":14087,"_26884":116865,"_2862":116954},[],"Inspecciona dispositivo, certificados emitidos e historial antes de reintentar. Puede haberse emitido un sucesor o revocado el anterior.",{"_3376":69558,"_29549":69523,"_20523":116956,"_5":14087,"_26884":116869,"_2862":116957},[],"Programa las renovaciones con margen para desconexiones, distribución de confianza y comprobación del consumidor. Escalona solicitudes de la población y limita los reintentos dentro de la ventana; los errores de autenticación, sujeto o política requieren corregir su causa. Conserva un mecanismo de recuperación admitido y probado para las claves perdidas y las parejas que no pudieron instalarse.",{"_3376":69559,"_29549":69523,"_20523":116959,"_5":14087,"_26884":116869,"_2862":116960},[],"Continúa con Distribución de confianza, Dispositivos e identidades y Diagnóstico.",{"_3376":69560,"_29549":69560,"_5":14445,"_2862":116962,"_29881":116963,"_20523":116964,"_26884":69560},"Diagnóstico de enrolamiento",[48111,114818,50590,115827,116002],[],{"_3376":69561,"_29549":69560,"_20523":116966,"_5":14087,"_26884":69560,"_2862":116967},[],"Localiza fallos de transporte, autenticación, registro, emisión e instalación.",{"_3376":69562,"_29549":69560,"_5":29878,"_20523":116969,"_26884":116970,"_2862":116971},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#diagnóstico-y-compatibilidad","Diagnóstico y compatibilidad",{"_3376":69563,"_29549":69560,"_5":29878,"_20523":116973,"_26884":116974,"_2862":116975},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#códigos-de-error-y-diagnóstico","Códigos de error y diagnóstico",{"_3376":69564,"_29549":69560,"_5":29878,"_20523":116977,"_26884":116978,"_2862":116534},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#notas-de-compatibilidad",{"_3376":69565,"_29549":69560,"_5":29878,"_20523":116980,"_26884":116981,"_2862":116982},[],"/docs/es/platform/iot-fleets/enrollment/troubleshooting#el-enrolamiento-est-falla","El enrolamiento EST falla",{"_3376":69566,"_29549":69560,"_20523":116984,"_5":14087,"_26884":69560,"_2862":116985},[],"Diagnostica una operación y un dispositivo cada vez. Anota DMS/APS, endpoint, hora, código HTTP, serie presentada y CN de la CSR. Conserva la respuesta sin incluir claves privadas ni credenciales de webhook en el informe.",{"_3376":69567,"_29549":69560,"_20523":116987,"_5":14087,"_26884":116974,"_2862":116988},[],"El controlador EST devuelve normalmente 400 al rechazar entrada y 500 cuando el servicio rechaza o falla la operación. Un 500 también puede representar una denegación de política; no implica que reintentar sea seguro. Gateway puede generar sus propios códigos y cuerpos. Revisa el cuerpo real y el resultado persistido.",{"_3376":69568,"_29549":69560,"_20523":116990,"_5":14087,"_26884":116974,"_2862":116991},[],"Síntoma o mensaje",{"_3376":69569,"_29549":69560,"_20523":116993,"_5":14087,"_26884":116974,"_2862":116994},[],"Qué revisar",{"_3376":69570,"_29549":69560,"_20523":116996,"_5":14087,"_26884":116974,"_2862":116997},[],"curl rechaza TLS, nombre o emisor",{"_3376":69571,"_29549":69560,"_20523":116999,"_5":14087,"_26884":116974,"_2862":117000},[],"URL, reloj, SAN del servidor y raíz aprobada en `est-trust.pem`. Resolver la confianza en Despliegue; no omitir la verificación.",{"_3376":69572,"_29549":69560,"_20523":117002,"_5":14087,"_26884":116974,"_2862":117003},[],"404 o APS ausente",{"_3376":69573,"_29549":69560,"_20523":117005,"_5":14087,"_26884":116974,"_2862":117006},[],"Ruta pública `/.well-known/est/{DMS_ID}/{operation}` y DMS existente. El APS no es el nombre del servicio.",{"_3376":69574,"_29549":69560,"_20523":117008,"_5":14087,"_26884":116974,"_2862":117009},[],"400, error de CSR o formato",{"_3376":69575,"_29549":69560,"_20523":117011,"_5":14087,"_26884":116974,"_2862":117012},[],"`Content-Type: application/pkcs10`, Base64 de DER, firma válida y cuerpo conservado sin doble codificación.",{"_3376":69576,"_29549":69560,"_20523":117014,"_5":14087,"_26884":116974,"_2862":117015},[],"Credencial ausente o certificado no válido",{"_3376":69577,"_29549":69560,"_20523":117017,"_5":14087,"_26884":116974,"_2862":117018},[],"Modo de la operación, CA validante, fechas, revocación y entrega de la credencial por Gateway. No confundir confianza TLS del servidor con CA de bootstrap.",{"_3376":69578,"_29549":69560,"_20523":117020,"_5":14087,"_26884":116974,"_2862":117021},[],"Webhook deniega, expira o responde sin autorización",{"_3376":69579,"_29549":69560,"_20523":117023,"_5":14087,"_26884":116974,"_2862":117024},[],"Configuración, conectividad y respuesta JSON con `authorized: true`. No hay degradación automática a `NO_AUTH`.",{"_3376":69580,"_29549":69560,"_20523":117026,"_5":14087,"_26884":116974,"_2862":51835},[],{"_3376":69581,"_29549":69560,"_20523":117028,"_5":14087,"_26884":116974,"_2862":117029},[],"El webhook respondió con una redirección. Configura la URL final absoluta `http` o `https` en la configuración del webhook; nunca se siguen redirecciones.",{"_3376":69582,"_29549":69560,"_20523":117031,"_5":14087,"_26884":116974,"_2862":51841},[],{"_3376":69583,"_29549":69560,"_20523":117033,"_5":14087,"_26884":116974,"_2862":117034},[],"El receptor devolvió más de 1 MiB de JSON. Reduce la respuesta del webhook de autorización.",{"_3376":69584,"_29549":69560,"_20523":117036,"_5":14087,"_26884":116974,"_2862":51847},[],{"_3376":69585,"_29549":69560,"_20523":117038,"_5":14087,"_26884":116974,"_2862":117039},[],"La configuración del webhook apunta a archivos (`ca_cert_file`, `mtls_options.cert_file`, `mtls_options.key_file`). Para mTLS, introduce el certificado y la clave como PEM codificado en Base64 en `cert_content` y `key_content`, o como PEM en claro; elimina cualquier otro campo de archivo, incluido `ca_cert_file`, que no tiene equivalente en línea (el certificado del receptor debe encadenar con el almacén de confianza del sistema). Consulta la guía de credenciales del webhook en DMS.",{"_3376":69586,"_29549":69560,"_20523":117041,"_5":14087,"_26884":116974,"_2862":51853},[],{"_3376":69587,"_29549":69560,"_20523":117043,"_5":14087,"_26884":116974,"_2862":117044},[],"El valor no es ni PEM codificado en Base64 ni PEM en claro: es una ruta de archivo o es Base64 de datos que no son PEM. Introduce el certificado y la clave como PEM codificado en Base64, como el resto de certificados de la API, o como PEM en claro (consulta los ajustes del webhook en DMS). El mismo mensaje nombra `mtls_options.key_content` cuando el valor no válido es la clave.",{"_3376":69588,"_29549":69560,"_20523":117046,"_5":14087,"_26884":116974,"_2862":51859},[],{"_3376":69589,"_29549":69560,"_20523":117048,"_5":14087,"_26884":116974,"_2862":117049},[],"El certificado y la clave no forman un par coincidente. Introduce ambos valores del mismo par; la comprobación se ejecuta al guardar el DMS y de nuevo en cada llamada del webhook.",{"_3376":69590,"_29549":69560,"_20523":117051,"_5":14087,"_26884":116974,"_2862":117052},[],"400 `struct validation error` al crear o actualizar un DMS",{"_3376":69591,"_29549":69560,"_20523":117054,"_5":14087,"_26884":116974,"_2862":117055},[],"La configuración del webhook de la operación que lo usa no es válida. Revisa `external_webhook_settings` en DMS.",{"_3376":69592,"_29549":69560,"_20523":117057,"_5":14087,"_26884":116974,"_2862":117058},[],"HTTP 500 con cuerpo `err` en enroll o reenroll",{"_3376":69593,"_29549":69560,"_20523":117060,"_5":14087,"_26884":116974,"_2862":117061},[],"Los fallos del servicio llegan al cliente EST como 500 con un cuerpo de `err` más el mensaje; los errores de autorización del webhook se nombran ahí.",{"_3376":69594,"_29549":69560,"_20523":117063,"_5":14087,"_26884":116974,"_2862":51877},[],{"_3376":69595,"_29549":69560,"_20523":117065,"_5":14087,"_26884":116974,"_2862":117066},[],"PRE\\_REGISTRATION requiere la entrada de inventario previa.",{"_3376":69596,"_29549":69560,"_20523":117068,"_5":14087,"_26884":116974,"_2862":51883},[],{"_3376":69597,"_29549":69560,"_20523":117070,"_5":14087,"_26884":116974,"_2862":117071},[],"Un dispositivo ya existente exige sustitución habilitada, incluso en No Identity. Investiga antes de activar el flag.",{"_3376":69598,"_29549":69560,"_20523":117073,"_5":14087,"_26884":116974,"_2862":117074},[],"DMS propietario distinto",{"_3376":69599,"_29549":69560,"_20523":117076,"_5":14087,"_26884":116974,"_2862":117077},[],"CN/ID, inventario global y DMS dueño; no reutilices un ID de otro contexto.",{"_3376":69600,"_29549":69560,"_20523":117079,"_5":14087,"_26884":116974,"_2862":51895},[],{"_3376":69601,"_29549":69560,"_20523":117081,"_5":14087,"_26884":116974,"_2862":117082},[],"Sujeto de la CSR frente al certificado actual. Conserva sus atributos, además del CN.",{"_3376":69602,"_29549":69560,"_20523":117084,"_5":14087,"_26884":116974,"_2862":51901},[],{"_3376":69603,"_29549":69560,"_20523":117086,"_5":14087,"_26884":116974,"_2862":117087},[],"NotAfter de la identidad actual y reenrollment\\_delta. Los umbrales de alerta no cambian esa ventana.",{"_3376":69604,"_29549":69560,"_20523":117089,"_5":14087,"_26884":116974,"_2862":117090},[],"Certificado actual revocado",{"_3376":69605,"_29549":69560,"_20523":117092,"_5":14087,"_26884":116974,"_2862":117093},[],"Renovación rechazada; prepara recuperación autorizada según la causa.",{"_3376":69606,"_29549":69560,"_20523":117095,"_5":14087,"_26884":116974,"_2862":117096},[],"Error de CA, perfil o firma",{"_3376":69607,"_29549":69560,"_20523":117098,"_5":14087,"_26884":116974,"_2862":117099},[],"CA activa, clave disponible, perfil seleccionado y restricciones. Un cacerts correcto no prueba emisión.",{"_3376":69608,"_29549":69560,"_20523":117101,"_5":14087,"_26884":116974,"_2862":117102},[],"HTTP 200 sin conexión del dispositivo",{"_3376":69609,"_29549":69560,"_20523":117104,"_5":14087,"_26884":116974,"_2862":117105},[],"Pareja instalada, cadena, usos, confianza y permisos del consumidor. Comprueba también el slot e historial.",{"_3376":69610,"_29549":69560,"_20523":117107,"_5":14087,"_26884":116974,"_2862":117108},[],"Timeout o error después de emitir",{"_3376":69611,"_29549":69560,"_20523":117110,"_5":14087,"_26884":116974,"_2862":117111},[],"Certificados nuevos, slot actual y estado de la identidad anterior antes de repetir.",{"_3376":69612,"_29549":69560,"_20523":117113,"_5":14087,"_26884":116978,"_2862":117114},[],"Los ejemplos usan el contrato del backend examinado. No atribuyas automáticamente ese comportamiento a otra release. Verifica el modo de renovación guardado y el comportamiento del Gateway con certificados vencidos y con la CA inicial.",{"_3376":69613,"_29549":69560,"_20523":117116,"_5":14087,"_26884":116978,"_2862":117117},[],"La respuesta predeterminada es PKCS#7 DER en Base64; el PEM por `Accept: application/x-pem-file` es una extensión de Lamassu. ServerKeyGen devuelve multipart y requiere tratar cada parte por separado. Consulta la referencia EST.",{"_3376":69614,"_29549":69560,"_20523":117119,"_5":14087,"_26884":116981,"_2862":117120},[],"Comprueba HTTPS con la raíz aprobada y consulta cacerts para el APS correcto.",{"_3376":69615,"_29549":69560,"_20523":117122,"_5":14087,"_26884":116981,"_2862":117123},[],"Revisa el DMS guardado: protocolo, registro, autenticación de esa operación, CA, perfil y ventana.",{"_3376":69616,"_29549":69560,"_20523":117125,"_5":14087,"_26884":116981,"_2862":117126},[],"Verifica la CSR localmente y relaciona su CN con el inventario.",{"_3376":69617,"_29549":69560,"_20523":117128,"_5":14087,"_26884":116981,"_2862":117129},[],"Ejecuta una solicitud, guarda cabeceras/cuerpo y consulta el dispositivo y los certificados.",{"_3376":69618,"_29549":69560,"_20523":117131,"_5":14087,"_26884":116981,"_2862":117132},[],"Si recibes identidad, comprueba clave, sujeto, uso y conexión con el consumidor.",{"_3376":69619,"_29549":69560,"_20523":117134,"_5":14087,"_26884":116981,"_2862":117135},[],"Las comprobaciones externas de revocación del bootstrap tienen límites: ausencia de evidencia puede aceptarse, y OCSP Unknown no produce el mismo rechazo que Revoked. No presupongas una política de rechazo ante cualquier incertidumbre. Una CA intermedia en la cadena TLS tampoco demuestra que toda la cadena haya llegado al validador DMS.",{"_3376":69620,"_29549":69560,"_20523":117137,"_5":14087,"_26884":116981,"_2862":117138},[],"Para logs, red, pods o cabeceras de Gateway, continúa en Diagnóstico de Despliegue. Para identidades emitidas, revocadas o vinculadas parcialmente, utiliza Renovación y recuperación y Dispositivos e identidades.",{"_3376":69621,"_29549":69621,"_5":14445,"_2862":117140,"_29881":117141,"_20523":117142,"_26884":69621},"Distribución y actualización de confianza",[48111,114818,50590,115827,116002],[],{"_3376":69622,"_29549":69621,"_20523":117144,"_5":14087,"_26884":69621,"_2862":117145},[],"Separa raíces, intermedias y confianza TLS inicial al distribuir o migrar certificados.",{"_3376":69623,"_29549":69621,"_5":29878,"_20523":117147,"_26884":117148,"_2862":117149},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#tres-relaciones-de-confianza","Tres relaciones de confianza",{"_3376":69624,"_29549":69621,"_5":29878,"_20523":117151,"_26884":117152,"_2862":117153},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#qué-devuelve-cacerts","Qué devuelve cacerts",{"_3376":69625,"_29549":69621,"_5":29878,"_20523":117155,"_26884":117156,"_2862":117157},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#instala-lo-necesario","Instala lo necesario",{"_3376":69626,"_29549":69621,"_5":29878,"_20523":117159,"_26884":117160,"_2862":117161},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#migra-la-confianza","Migra la confianza",{"_3376":69627,"_29549":69621,"_5":29878,"_20523":117163,"_26884":117164,"_2862":117165},[],"/docs/es/platform/iot-fleets/enrollment/trust-distribution#comprueba-la-actualización","Comprueba la actualización",{"_3376":69628,"_29549":69621,"_20523":117167,"_5":14087,"_26884":69621,"_2862":117168},[],"Esta guía se dirige a quien administra la confianza de dispositivos y consumidores. Necesitas inventario de emisores, acceso a los almacenes de confianza y un canal autenticado de actualización. Distribuir certificados es distinto de decidir cuáles serán anclas confiables.",{"_3376":69629,"_29549":69621,"_20523":117170,"_5":14087,"_26884":117148,"_2862":117171},[],"Relación",{"_3376":69630,"_29549":69621,"_20523":117173,"_5":14087,"_26884":117148,"_2862":117174},[],"Material que prepara el responsable",{"_3376":69631,"_29549":69621,"_20523":117176,"_5":14087,"_26884":117148,"_2862":117177},[],"Dispositivo → servidor EST",{"_3376":69632,"_29549":69621,"_20523":117179,"_5":14087,"_26884":117148,"_2862":117180},[],"Raíz, cadena o pin previamente verificado del servidor y su nombre TLS.",{"_3376":69633,"_29549":69621,"_20523":117182,"_5":14087,"_26884":117148,"_2862":117183},[],"DMS → solicitante",{"_3376":69634,"_29549":69621,"_20523":117185,"_5":14087,"_26884":117148,"_2862":117186},[],"CAs y reglas que autorizan la credencial inicial o de renovación.",{"_3376":69635,"_29549":69621,"_20523":117188,"_5":14087,"_26884":117148,"_2862":117189},[],"Consumidor → dispositivo",{"_3376":69636,"_29549":69621,"_20523":117191,"_5":14087,"_26884":117148,"_2862":117192},[],"Raíces de la identidad operativa, intermedias, validación y permisos.",{"_3376":69637,"_29549":69621,"_20523":117194,"_5":14087,"_26884":117148,"_2862":117195},[],"Un dispositivo que obtiene un certificado no configura automáticamente ninguna de esas relaciones en terceros. Revisa el modelo de confianza.",{"_3376":69638,"_29549":69621,"_20523":117197,"_5":14087,"_26884":117152,"_2862":117198},[],"El DMS puede incluir el certificado TLS downstream disponible, las Managed CAs elegidas y la CA de enrolamiento. No incorpora todos los ascendientes por seleccionar la emisora. El conjunto puede contener hojas, raíces e intermedias, incluso más de una jerarquía durante una migración.",{"_3376":69639,"_29549":69621,"_20523":117200,"_5":14087,"_26884":117152,"_2862":117201},[],"La posición no define la cadena. Identifica cada certificado por sujeto, emisor, AKI/SKI, firma y restricciones. Descarga e inspecciona con Cliente EST.",{"_3376":69640,"_29549":69621,"_20523":117203,"_5":14087,"_26884":117156,"_2862":117204},[],"Mantén por separado la confianza inicial del servidor EST y la del consumidor de identidades.",{"_3376":69641,"_29549":69621,"_20523":117206,"_5":14087,"_26884":117156,"_2862":117207},[],"Selecciona raíces que tu política haya aprobado como anclas.",{"_3376":69642,"_29549":69621,"_20523":117209,"_5":14087,"_26884":117156,"_2862":117210},[],"Conserva intermedias para construir o presentar cadenas; no las conviertas automáticamente en raíces.",{"_3376":69643,"_29549":69621,"_20523":117212,"_5":14087,"_26884":117156,"_2862":117213},[],"Presenta hoja e intermedias requeridas en mTLS. Normalmente no necesitas enviar la raíz al interlocutor que ya confía en ella.",{"_3376":69644,"_29549":69621,"_20523":117215,"_5":14087,"_26884":117156,"_2862":117216},[],"Verifica cadena, fechas, nombres, usos y revocación desde el consumidor.",{"_3376":69645,"_29549":69621,"_20523":117218,"_5":14087,"_26884":117156,"_2862":117219},[],"No uses indiscriminadamente todo `cacerts.pem` como `-CAfile`: eso puede ampliar el conjunto de autoridades confiadas, ocultar intermedias faltantes o confiar una hoja TLS que tenía otra finalidad.",{"_3376":69646,"_29549":69621,"_20523":117221,"_5":14087,"_26884":117160,"_2862":117222},[],"Antes de cambiar Enrollment CA, inventaría equipos desconectados, bootstrap, certificados operativos y consumidores. Distribuye la nueva raíz y las intermedias necesarias; comprueba que una cohorte acepta cadenas antigua y nueva.",{"_3376":69647,"_29549":69621,"_20523":117224,"_5":14087,"_26884":117160,"_2862":117225},[],"En el DMS, separa las CAs distribuidas de las CAs de validación de reenrolamiento en `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`, utilizadas para la credencial de reenrolamiento. Esa lista es opcional porque la CA de enrolamiento siempre valida las credenciales de reenrolamiento, pero al cambiar la CA de enrolamiento, añade a ella la CA de emisión anterior para que las identidades de la CA antigua sigan reenrolándose durante el solapamiento. El validador examinado prueba la CA de enrolamiento y después esas CAs con la hoja recibida; aceptar una cadena multinivel requiere verificar cómo llega al servicio y qué emisor está configurado.",{"_3376":69648,"_29549":69621,"_20523":117227,"_5":14087,"_26884":117160,"_2862":117228},[],"Cambia emisión, renueva por grupos y compara la serie instalada con el slot activo. Retira la confianza anterior cuando ningún equipo legítimo la necesite y tu política permita cerrar el solapamiento. Sigue Jerarquía y rotación para la operación PKI.",{"_3376":69649,"_29549":69621,"_20523":117230,"_5":14087,"_26884":117164,"_2862":117231},[],"Prueba una identidad antigua permitida durante el solapamiento, una nueva, una cadena desconocida y el resultado después de retirar la confianza antigua. Conserva versión del almacén, conjunto aprobado, fecha y resultado. `/cacerts` accesible solo demuestra distribución; no demuestra instalación ni aceptación por todos los dispositivos.",{"_3376":69650,"_29549":69650,"_5":14445,"_2862":52050,"_29881":117233,"_20523":117235,"_26884":69650},[48111,114818,50590,115827,117234],"Integraciones",[],{"_3376":69651,"_29549":69650,"_20523":117237,"_5":14087,"_26884":69650,"_2862":117238},[],"El conector de Lamassu para AWS IoT Core sincroniza las identidades de los dispositivos con la plataforma AWS, gestionando el registro de CAs, el aprovisionamiento de Things y el ciclo de vida de los certificados de forma automática y orientada a eventos.",{"_3376":69652,"_29549":69650,"_5":29878,"_20523":117240,"_26884":117241,"_2862":117242},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#arquitectura-del-conector","Arquitectura del conector",{"_3376":69653,"_29549":69650,"_5":29878,"_20523":117244,"_26884":117245,"_2862":117246},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#prerrequisitos","Prerrequisitos",{"_3376":69654,"_29549":69650,"_5":29878,"_20523":117248,"_26884":117249,"_2862":117250},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#permisos-iam-necesarios","Permisos IAM necesarios",{"_3376":69655,"_29549":69650,"_5":29878,"_20523":117252,"_26884":117253,"_2862":117254},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#parámetros-de-configuración","Parámetros de configuración",{"_3376":69656,"_29549":69650,"_5":29878,"_20523":117256,"_26884":117257,"_2862":117258},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#máquina-de-estados-de-los-recursos","Máquina de estados de los recursos",{"_3376":69657,"_29549":69650,"_5":29878,"_20523":117260,"_26884":117261,"_2862":117262},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#eventos-que-gestiona-el-conector","Eventos que gestiona el conector",{"_3376":69658,"_29549":69650,"_5":29878,"_20523":117264,"_26884":117265,"_2862":117266},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-registro-de-la-ca","Estados del registro de la CA",{"_3376":69659,"_29549":69650,"_5":29878,"_20523":117268,"_26884":117269,"_2862":117270},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-modo-de-registro-del-dms","Estados del modo de registro del DMS",{"_3376":69660,"_29549":69650,"_5":29878,"_20523":117272,"_26884":117273,"_2862":117274},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#estados-del-certificado","Estados del certificado",{"_3376":69661,"_29549":69650,"_5":29878,"_20523":117276,"_26884":117277,"_2862":117278},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#ciclo-de-vida-del-thing","Ciclo de vida del Thing",{"_3376":69662,"_29549":69650,"_5":29878,"_20523":117280,"_26884":117281,"_2862":117282},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#registro-de-la-ca-en-aws-iot-core","Registro de la CA en AWS IoT Core",{"_3376":69663,"_29549":69650,"_5":29878,"_20523":117284,"_26884":117285,"_2862":117286},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#cómo-solicitar-el-registro","Cómo solicitar el registro",{"_3376":69664,"_29549":69650,"_5":29878,"_20523":117288,"_26884":117289,"_2862":52108},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#primary-account",{"_3376":69665,"_29549":69650,"_5":29878,"_20523":117291,"_26884":117292,"_2862":52112},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#secondary-account-sni-only",{"_3376":69666,"_29549":69650,"_5":29878,"_20523":117294,"_26884":117295,"_2862":117296},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#configuración-del-dms","Configuración del DMS",{"_3376":69667,"_29549":69650,"_5":29878,"_20523":117298,"_26884":117299,"_2862":117300},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-none","Modo `none`",{"_3376":69668,"_29549":69650,"_5":29878,"_20523":117302,"_26884":117303,"_2862":117304},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-auto","Modo `auto`",{"_3376":69669,"_29549":69650,"_5":29878,"_20523":117306,"_26884":117307,"_2862":117308},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#modo-jitp","Modo `jitp`",{"_3376":69670,"_29549":69650,"_5":29878,"_20523":117310,"_26884":117311,"_2862":117312},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-automático","Aprovisionamiento de dispositivos (modo automático)",{"_3376":69671,"_29549":69650,"_5":29878,"_20523":117314,"_26884":117315,"_2862":117316},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#aprovisionamiento-de-dispositivos-modo-jitp","Aprovisionamiento de dispositivos (modo JITP)",{"_3376":69672,"_29549":69650,"_5":29878,"_20523":117318,"_26884":117319,"_2862":117320},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#sincronización-del-estado-del-certificado","Sincronización del estado del certificado",{"_3376":69673,"_29549":69650,"_5":29878,"_20523":117322,"_26884":117323,"_2862":117324},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#desconexión-forzada-al-revocar","Desconexión forzada al revocar",{"_3376":69674,"_29549":69650,"_5":29878,"_20523":117326,"_26884":117327,"_2862":117328},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#device-shadow-y-automatización","Device Shadow y automatización",{"_3376":69675,"_29549":69650,"_5":29878,"_20523":117330,"_26884":117331,"_2862":117332},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#qué-escribe-el-conector-en-el-shadow","Qué escribe el conector en el shadow",{"_3376":69676,"_29549":69650,"_5":29878,"_20523":117334,"_26884":117335,"_2862":117336},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#políticas-de-aws-iot","Políticas de AWS IoT",{"_3376":69677,"_29549":69650,"_5":29878,"_20523":117338,"_26884":117339,"_2862":117340},[],"/docs/es/platform/iot-fleets/integrations/aws-iot-core#solución-de-problemas","Solución de problemas",{"_3376":69678,"_29549":69650,"_20523":117342,"_5":14087,"_26884":69650,"_2862":117343},[],"La integración de Lamassu con AWS IoT Core cubre el puente entre la PKI gestionada por Lamassu y la plataforma de conectividad de AWS. Cuando un dispositivo obtiene su certificado a través del proceso de enrolamiento EST, el conector se encarga de que ese certificado y la identidad asociada sean reconocidos en AWS IoT Core sin intervención manual. El resultado es que el dispositivo puede autenticarse directamente en AWS con el mismo certificado X.509 que Lamassu emitió.",{"_3376":69679,"_29549":69650,"_20523":117345,"_5":14087,"_26884":69650,"_2862":117346},[],"Desde el punto de vista del protocolo, el dispositivo se autentica ante AWS IoT Core mediante TLS mutuo (mTLS): presenta su certificado X.509 emitido por Lamassu como certificado de cliente, y AWS IoT Core verifica la cadena de certificados hasta llegar a la CA registrada en la cuenta. Lamassu actúa como autoridad de certificación (CA); el conector se encarga de que esa CA esté registrada en AWS y de que el certificado del dispositivo sea conocido por la plataforma antes de que el dispositivo intente conectarse (en modo `auto`) o en su primera conexión (en modo JITP).",{"_3376":69680,"_29549":69650,"_20523":117348,"_5":14087,"_26884":69650,"_2862":117349},[],"Este documento está dirigido tanto al administrador PKI, que necesita configurar el conector y registrar las CAs, como al desarrollador de firmware de dispositivos, que necesita entender cómo se nombran los Things, cómo funciona el Device Shadow y qué ocurre cuando un certificado se revoca. Para el desarrollador de firmware, el dato más importante es que el **nombre del Thing en AWS (ThingName) corresponde siempre al Common Name (CN) del certificado emitido por Lamassu**, independientemente del modo de aprovisionamiento.",{"_3376":69681,"_29549":69650,"_20523":117351,"_5":14087,"_26884":117241,"_2862":117352},[],"El conector de AWS IoT Core es un proceso Go independiente, un binario o contenedor separado del núcleo de Lamassu. En un despliegue monolítico se compila por defecto (etiqueta de compilación `!noaws`) y se activa mediante `aws_iot_manager.enabled: true` en el fichero de configuración. En despliegues distribuidos, se ejecuta como un contenedor propio con acceso a los servicios de CA, DMS Manager y Device Manager de Lamassu a través de HTTP.",{"_3376":69682,"_29549":69650,"_20523":117354,"_5":14087,"_26884":117241,"_2862":117355},[],"El conector no sondea los servicios de Lamassu periódicamente. En su lugar, **se suscribe al bus de eventos interno** de Lamassu (AMQP o AWS SQS/SNS, configurable) y reacciona a los eventos que le interesan: creación o actualización de CAs, creación o actualización de DMS, vinculación de identidad de dispositivo, cambio de estado de certificado, actualización de metadatos de certificado y actualización de metadatos de dispositivo. Este modelo orientado a eventos garantiza que la sincronización con AWS sea casi inmediata y no genere carga de sondeo.",{"_3376":69683,"_29549":69650,"_20523":117357,"_5":14087,"_26884":117241,"_2862":117358},[],"Para evitar bucles infinitos, el conector ignora cualquier evento cuyo campo `source` de CloudEvent coincida con su propia URI de origen. Esto previene que las escrituras de metadatos que el propio conector realiza vuelvan a disparar el mismo flujo.",{"_3376":69684,"_29549":69650,"_20523":117360,"_5":14087,"_26884":117241,"_2862":117361},[],"Cuando se ejecutan varios conectores en paralelo, por ejemplo, para distintas cuentas de AWS, cada instancia tiene su propio `connector_id`. Todos los metadatos que el conector escribe en Lamassu se almacenan bajo la clave `lamassu.io/iot/{connector_id}`, lo que permite coexistencia sin colisiones.",{"_3376":69685,"_29549":69650,"_20523":117363,"_5":14087,"_26884":117245,"_2862":117364},[],"Antes de activar el conector es necesario disponer de una cuenta AWS con los permisos IAM adecuados y tener el conector correctamente configurado. El proceso de despliegue (Docker Compose, Kubernetes o binario) se describe en la documentación de despliegue.",{"_3376":69686,"_29549":69650,"_20523":117366,"_5":14087,"_26884":117249,"_2862":117367},[],"La identidad IAM con la que opera el conector debe tener al mínimo los siguientes permisos sobre los recursos de la cuenta destino:",{"_3376":69687,"_29549":69650,"_20523":117369,"_5":14087,"_26884":117249,"_2862":117370},[],"Acción IAM",{"_3376":69688,"_29549":69650,"_20523":117372,"_5":14087,"_26884":117249,"_2862":113766},[],{"_3376":69689,"_29549":69650,"_20523":117374,"_5":14087,"_26884":117249,"_2862":52195},[],{"_3376":69690,"_29549":69650,"_20523":117376,"_5":14087,"_26884":117249,"_2862":117377},[],"Obtener el código de verificación para el registro de CA en Primary Account",{"_3376":69691,"_29549":69650,"_20523":117379,"_5":14087,"_26884":117249,"_2862":52201},[],{"_3376":69692,"_29549":69650,"_20523":117381,"_5":14087,"_26884":117249,"_2862":117382},[],"Registrar la CA en AWS IoT",{"_3376":69693,"_29549":69650,"_20523":117384,"_5":14087,"_26884":117249,"_2862":52207},[],{"_3376":69694,"_29549":69650,"_20523":117386,"_5":14087,"_26884":117249,"_2862":117387},[],"Consultar el estado del registro de la CA",{"_3376":69695,"_29549":69650,"_20523":117389,"_5":14087,"_26884":117249,"_2862":52213},[],{"_3376":69696,"_29549":69650,"_20523":117391,"_5":14087,"_26884":117249,"_2862":117392},[],"Crear o actualizar Things en IoT Core",{"_3376":69697,"_29549":69650,"_20523":117394,"_5":14087,"_26884":117249,"_2862":52219},[],{"_3376":69698,"_29549":69650,"_20523":117396,"_5":14087,"_26884":117249,"_2862":117397},[],"Aprovisionar Things mediante plantilla",{"_3376":69699,"_29549":69650,"_20523":117399,"_5":14087,"_26884":117249,"_2862":52225},[],{"_3376":69700,"_29549":69650,"_20523":117401,"_5":14087,"_26884":117249,"_2862":117402},[],"Registrar certificados de dispositivo",{"_3376":69701,"_29549":69650,"_20523":117404,"_5":14087,"_26884":117249,"_2862":52231},[],{"_3376":69702,"_29549":69650,"_20523":117406,"_5":14087,"_26884":117249,"_2862":117407},[],"Cambiar el estado de un certificado (ACTIVE / INACTIVE / REVOKED)",{"_3376":69703,"_29549":69650,"_20523":117409,"_5":14087,"_26884":117249,"_2862":52237},[],{"_3376":69704,"_29549":69650,"_20523":117411,"_5":14087,"_26884":117249,"_2862":117412},[],"Crear y adjuntar políticas IoT",{"_3376":69705,"_29549":69650,"_20523":117414,"_5":14087,"_26884":117249,"_2862":52243},[],{"_3376":69706,"_29549":69650,"_20523":117416,"_5":14087,"_26884":117249,"_2862":117417},[],"Gestionar grupos de Things",{"_3376":69707,"_29549":69650,"_20523":117419,"_5":14087,"_26884":117249,"_2862":52249},[],{"_3376":69708,"_29549":69650,"_20523":117421,"_5":14087,"_26884":117249,"_2862":117422},[],"Crear plantillas JITP",{"_3376":69709,"_29549":69650,"_20523":117424,"_5":14087,"_26884":117249,"_2862":52255},[],{"_3376":69710,"_29549":69650,"_20523":117426,"_5":14087,"_26884":117249,"_2862":117427},[],"Leer y escribir el Device Shadow",{"_3376":69711,"_29549":69650,"_20523":117429,"_5":14087,"_26884":117249,"_2862":117430},[],"Para el mecanismo de desconexión forzada tras revocación también se requiere acceso a la API del plano de datos de AWS IoT (`iot:Connect` con SigV4 sobre WebSocket), que se negocia de forma implícita con las credenciales del conector.",{"_3376":69712,"_29549":69650,"_20523":117432,"_5":14087,"_26884":117253,"_2862":117433},[],"Parámetro",{"_3376":69713,"_29549":69650,"_20523":117435,"_5":14087,"_26884":117253,"_2862":117436},[],"Tipo",{"_3376":69714,"_29549":69650,"_20523":117438,"_5":14087,"_26884":117253,"_2862":117439},[],"Requerido",{"_3376":69715,"_29549":69650,"_20523":117441,"_5":14087,"_26884":117253,"_2862":117442},[],"Descripción",{"_3376":69716,"_29549":69650,"_20523":117444,"_5":14087,"_26884":117253,"_2862":52276},[],{"_3376":69717,"_29549":69650,"_20523":117446,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69718,"_29549":69650,"_20523":117448,"_5":14087,"_26884":117253,"_2862":117449},[],"Sí",{"_3376":69719,"_29549":69650,"_20523":117451,"_5":14087,"_26884":117253,"_2862":117452},[],"Identificador único de esta instancia del conector. Se usa como espacio de nombres para los metadatos: `lamassu.io/iot/{connector_id}`.",{"_3376":69720,"_29549":69650,"_20523":117454,"_5":14087,"_26884":117253,"_2862":52287},[],{"_3376":69721,"_29549":69650,"_20523":117456,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69722,"_29549":69650,"_20523":117458,"_5":14087,"_26884":117253,"_2862":117449},[],{"_3376":69723,"_29549":69650,"_20523":117460,"_5":14087,"_26884":117253,"_2862":117461},[],"Región AWS donde opera el conector.",{"_3376":69724,"_29549":69650,"_20523":117463,"_5":14087,"_26884":117253,"_2862":52297},[],{"_3376":69725,"_29549":69650,"_20523":117465,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69726,"_29549":69650,"_20523":117467,"_5":14087,"_26884":117253,"_2862":117449},[],{"_3376":69727,"_29549":69650,"_20523":117469,"_5":14087,"_26884":117253,"_2862":117470},[],"Método de autenticación: `static`, `role` o vacío (cadena de credenciales por defecto del SDK).",{"_3376":69728,"_29549":69650,"_20523":117472,"_5":14087,"_26884":117253,"_2862":52307},[],{"_3376":69729,"_29549":69650,"_20523":117474,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69730,"_29549":69650,"_20523":117476,"_5":14087,"_26884":117253,"_2862":117477},[],"Solo con `auth_method=static`",{"_3376":69731,"_29549":69650,"_20523":117479,"_5":14087,"_26884":117253,"_2862":117480},[],"Clave de acceso AWS.",{"_3376":69732,"_29549":69650,"_20523":117482,"_5":14087,"_26884":117253,"_2862":52318},[],{"_3376":69733,"_29549":69650,"_20523":117484,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69734,"_29549":69650,"_20523":117486,"_5":14087,"_26884":117253,"_2862":117477},[],{"_3376":69735,"_29549":69650,"_20523":117488,"_5":14087,"_26884":117253,"_2862":117489},[],"Clave secreta AWS.",{"_3376":69736,"_29549":69650,"_20523":117491,"_5":14087,"_26884":117253,"_2862":52328},[],{"_3376":69737,"_29549":69650,"_20523":117493,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69738,"_29549":69650,"_20523":117495,"_5":14087,"_26884":117253,"_2862":52333},[],{"_3376":69739,"_29549":69650,"_20523":117497,"_5":14087,"_26884":117253,"_2862":117498},[],"Token de sesión (con `auth_method=static`).",{"_3376":69740,"_29549":69650,"_20523":117500,"_5":14087,"_26884":117253,"_2862":52339},[],{"_3376":69741,"_29549":69650,"_20523":117502,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69742,"_29549":69650,"_20523":117504,"_5":14087,"_26884":117253,"_2862":117505},[],"Solo con `auth_method=role`",{"_3376":69743,"_29549":69650,"_20523":117507,"_5":14087,"_26884":117253,"_2862":117508},[],"ARN del rol a asumir.",{"_3376":69744,"_29549":69650,"_20523":117510,"_5":14087,"_26884":117253,"_2862":52350},[],{"_3376":69745,"_29549":69650,"_20523":117512,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69746,"_29549":69650,"_20523":117514,"_5":14087,"_26884":117253,"_2862":52333},[],{"_3376":69747,"_29549":69650,"_20523":117516,"_5":14087,"_26884":117253,"_2862":117517},[],"URL alternativa para todos los servicios AWS (útil con LocalStack en pruebas).",{"_3376":69748,"_29549":69650,"_20523":117519,"_5":14087,"_26884":117253,"_2862":52360},[],{"_3376":69749,"_29549":69650,"_20523":117521,"_5":14087,"_26884":117253,"_2862":87487},[],{"_3376":69750,"_29549":69650,"_20523":117523,"_5":14087,"_26884":117253,"_2862":117449},[],{"_3376":69751,"_29549":69650,"_20523":117525,"_5":14087,"_26884":117253,"_2862":117526},[],"Configuración del bus de eventos al que se suscribe el conector (AMQP o AWS SQS/SNS).",{"_3376":69752,"_29549":69650,"_20523":117528,"_5":14087,"_26884":117253,"_2862":52370},[],{"_3376":69753,"_29549":69650,"_20523":117530,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69754,"_29549":69650,"_20523":117532,"_5":14087,"_26884":117253,"_2862":117449},[],{"_3376":69755,"_29549":69650,"_20523":117534,"_5":14087,"_26884":117253,"_2862":117535},[],"URL HTTP del servicio DMS Manager de Lamassu.",{"_3376":69756,"_29549":69650,"_20523":117537,"_5":14087,"_26884":117253,"_2862":52380},[],{"_3376":69757,"_29549":69650,"_20523":117539,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69758,"_29549":69650,"_20523":117541,"_5":14087,"_26884":117253,"_2862":117449},[],{"_3376":69759,"_29549":69650,"_20523":117543,"_5":14087,"_26884":117253,"_2862":117544},[],"URL HTTP del Device Manager de Lamassu.",{"_3376":69760,"_29549":69650,"_20523":117546,"_5":14087,"_26884":117253,"_2862":52390},[],{"_3376":69761,"_29549":69650,"_20523":117548,"_5":14087,"_26884":117253,"_2862":24522},[],{"_3376":69762,"_29549":69650,"_20523":117550,"_5":14087,"_26884":117253,"_2862":117449},[],{"_3376":69763,"_29549":69650,"_20523":117552,"_5":14087,"_26884":117253,"_2862":117553},[],"URL HTTP del servicio de CA de Lamassu.",{"_3376":69764,"_29549":69650,"_20523":117555,"_5":14087,"_26884":117257,"_2862":117556},[],"El conector gestiona el lado AWS de cuatro tipos de recursos: CAs, plantillas de aprovisionamiento de DMS (JITP), certificados de dispositivo y Things. Esta sección mapea los eventos del bus que consume el conector a los recursos de AWS que toca y a las llamadas AWS que ejecuta cada transición. Los recursos de AWS se referencian con la notación `IoTCore/<recurso>`.",{"_3376":69765,"_29549":69650,"_20523":117558,"_5":14087,"_26884":117261,"_2862":117559},[],"La columna **Tipo de CloudEvent** lista el nombre del evento en el bus interno de Lamassu; la columna **Acciones IAM** lista las operaciones exactas del SDK de AWS que invoca cada flujo, para que los permisos necesarios se deriven directamente de esta tabla.",{"_3376":69766,"_29549":69650,"_20523":117561,"_5":14087,"_26884":117261,"_2862":117562},[],"Tipo de CloudEvent",{"_3376":69767,"_29549":69650,"_20523":117564,"_5":14087,"_26884":117261,"_2862":117565},[],"Recurso en Lamassu",{"_3376":69768,"_29549":69650,"_20523":117567,"_5":14087,"_26884":117261,"_2862":117568},[],"Recurso AWS",{"_3376":69769,"_29549":69650,"_20523":117570,"_5":14087,"_26884":117261,"_2862":117571},[],"Acciones IAM",{"_3376":69770,"_29549":69650,"_20523":117573,"_5":14087,"_26884":117261,"_2862":117574},[],"Llamadas AWS y efecto",{"_3376":69771,"_29549":69650,"_20523":117576,"_5":14087,"_26884":117261,"_2862":117577},[],"Dónde en esta página",{"_3376":69772,"_29549":69650,"_20523":117579,"_5":14087,"_26884":117261,"_2862":52424},[],{"_3376":69773,"_29549":69650,"_20523":117581,"_5":14087,"_26884":117261,"_2862":52427},[],{"_3376":69774,"_29549":69650,"_20523":117583,"_5":14087,"_26884":117261,"_2862":52430},[],{"_3376":69775,"_29549":69650,"_20523":117585,"_5":14087,"_26884":117261,"_2862":52433},[],{"_3376":69776,"_29549":69650,"_20523":117587,"_5":14087,"_26884":117261,"_2862":117588},[],"Carga la CA en el estado del conector; una escritura de `registration.status = REQUESTED` dispara el flujo de registro (Primary con certificado de verificación, o SNI-only) y escribe `SUCCEEDED` o `FAILED` en los metadatos de la CA.",{"_3376":69777,"_29549":69650,"_20523":117590,"_5":14087,"_26884":117261,"_2862":117266},[],{"_3376":69778,"_29549":69650,"_20523":117592,"_5":14087,"_26884":117261,"_2862":52441},[],{"_3376":69779,"_29549":69650,"_20523":117594,"_5":14087,"_26884":117261,"_2862":52444},[],{"_3376":69780,"_29549":69650,"_20523":117596,"_5":14087,"_26884":117261,"_2862":52447},[],{"_3376":69781,"_29549":69650,"_20523":117598,"_5":14087,"_26884":117261,"_2862":52450},[],{"_3376":69782,"_29549":69650,"_20523":117600,"_5":14087,"_26884":117261,"_2862":117601},[],"En modo `jitp`, intenta crear la plantilla de aprovisionamiento y la adjunta a la CA registrada. No idempotente: una edición `PUT /v1/dms/{id}` reintenta la creación y acaba en `lamassu-dlq` tras 3 reintentos. Idempotente para `none` y `auto` (solo configuración).",{"_3376":69783,"_29549":69650,"_20523":117603,"_5":14087,"_26884":117261,"_2862":117270},[],{"_3376":69784,"_29549":69650,"_20523":117605,"_5":14087,"_26884":117261,"_2862":52458},[],{"_3376":69785,"_29549":69650,"_20523":117607,"_5":14087,"_26884":117261,"_2862":117608},[],"Dispositivo",{"_3376":69786,"_29549":69650,"_20523":117610,"_5":14087,"_26884":117261,"_2862":52464},[],{"_3376":69787,"_29549":69650,"_20523":117612,"_5":14087,"_26884":117261,"_2862":52467},[],{"_3376":69788,"_29549":69650,"_20523":117614,"_5":14087,"_26884":117261,"_2862":117615},[],"En modo `auto`: crea/actualiza políticas, asegura los grupos de Things, revoca principals obsoletos y aprovisiona el Thing vía `iot:RegisterThing`. En modo `jitp`: no hay llamadas AWS; AWS ejecuta la plantilla JITP en la primera conexión.",{"_3376":69789,"_29549":69650,"_20523":117617,"_5":14087,"_26884":117261,"_2862":117278},[],{"_3376":69790,"_29549":69650,"_20523":117619,"_5":14087,"_26884":117261,"_2862":52475},[],{"_3376":69791,"_29549":69650,"_20523":117621,"_5":14087,"_26884":117261,"_2862":117622},[],"Certificado",{"_3376":69792,"_29549":69650,"_20523":117624,"_5":14087,"_26884":117261,"_2862":52481},[],{"_3376":69793,"_29549":69650,"_20523":117626,"_5":14087,"_26884":117261,"_2862":117627},[],"`iot:UpdateCertificate`, `iot:Connect` (plano de datos)",{"_3376":69794,"_29549":69650,"_20523":117629,"_5":14087,"_26884":117261,"_2862":117630},[],"Mapea el estado a AWS (`ACTIVE`, `INACTIVE`, `REVOKED`), llama a `iot:UpdateCertificate` y fuerza una desconexión MQTT al revocar.",{"_3376":69795,"_29549":69650,"_20523":117632,"_5":14087,"_26884":117261,"_2862":117274},[],{"_3376":69796,"_29549":69650,"_20523":117634,"_5":14087,"_26884":117261,"_2862":52492},[],{"_3376":69797,"_29549":69650,"_20523":117636,"_5":14087,"_26884":117261,"_2862":117637},[],"Certificado / Dispositivo",{"_3376":69798,"_29549":69650,"_20523":117639,"_5":14087,"_26884":117261,"_2862":52498},[],{"_3376":69799,"_29549":69650,"_20523":117641,"_5":14087,"_26884":117261,"_2862":48507},[],{"_3376":69800,"_29549":69650,"_20523":117643,"_5":14087,"_26884":117261,"_2862":117644},[],"Refresca el estado interno; el conector ignora los eventos cuyo campo CloudEvent `source` coincide con su propia URI para evitar bucles autodisparados.",{"_3376":69801,"_29549":69650,"_20523":117646,"_5":14087,"_26884":117261,"_2862":117328},[],{"_3376":69802,"_29549":69650,"_20523":117648,"_5":14087,"_26884":117265,"_2862":117649},[],"El flujo de registro de la CA se gobierna por el campo `registration.status` de los metadatos del conector en la CA:",{"_3376":69803,"_29549":69650,"_20523":117651,"_5":14087,"_26884":117265,"_2862":117652},[],"por el campo `registration.status` de los metadatos del conector en la CA:",{"_3376":69804,"_29549":69650,"_20523":117654,"_5":14087,"_26884":117265,"_2862":117655},[],"Transición",{"_3376":69805,"_29549":69650,"_20523":117657,"_5":14087,"_26884":117265,"_2862":117658},[],"Llamadas AWS",{"_3376":69806,"_29549":69650,"_20523":117660,"_5":14087,"_26884":117265,"_2862":117661},[],"`NoRegistrada` → `Solicitada`",{"_3376":69807,"_29549":69650,"_20523":117663,"_5":14087,"_26884":117265,"_2862":117664},[],"ninguna (solo escritura de metadatos)",{"_3376":69808,"_29549":69650,"_20523":117666,"_5":14087,"_26884":117265,"_2862":117667},[],"`Solicitada` → `Registrando`",{"_3376":69809,"_29549":69650,"_20523":117669,"_5":14087,"_26884":117265,"_2862":117670},[],"`iot:GetRegistrationCode` (solo Primary Account)",{"_3376":69810,"_29549":69650,"_20523":117672,"_5":14087,"_26884":117265,"_2862":117673},[],"`Registrando` → `Completada`",{"_3376":69811,"_29549":69650,"_20523":117675,"_5":14087,"_26884":117265,"_2862":117676},[],"`iot:RegisterCACertificate` (Primary: prueba de posesión con clave efímera; SNI-only: `CertificateMode: SNI_ONLY`)",{"_3376":69812,"_29549":69650,"_20523":117678,"_5":14087,"_26884":117265,"_2862":117679},[],"`Registrando` → `Fallida`",{"_3376":69813,"_29549":69650,"_20523":117681,"_5":14087,"_26884":117265,"_2862":117682},[],"`iot:RegisterCACertificate` fallida; el detalle del error se escribe en los metadatos de la CA",{"_3376":69814,"_29549":69650,"_20523":117684,"_5":14087,"_26884":117265,"_2862":117685},[],"`Fallida` / `Completada` → `Solicitada`",{"_3376":69815,"_29549":69650,"_20523":117687,"_5":14087,"_26884":117265,"_2862":117688},[],"ninguna (una nueva escritura `REQUESTED` reejecuta el flujo)",{"_3376":69816,"_29549":69650,"_20523":117690,"_5":14087,"_26884":117269,"_2862":117691},[],"El `registration_mode` del DMS determina qué hace el conector en el lado AWS cuando el DMS se crea o se edita por completo:",{"_3376":69817,"_29549":69650,"_20523":117693,"_5":14087,"_26884":117269,"_2862":117655},[],{"_3376":69818,"_29549":69650,"_20523":117695,"_5":14087,"_26884":117269,"_2862":117658},[],{"_3376":69819,"_29549":69650,"_20523":117697,"_5":14087,"_26884":117269,"_2862":117698},[],"`SinConfigurar` → `None` / `Auto`",{"_3376":69820,"_29549":69650,"_20523":117700,"_5":14087,"_26884":117269,"_2862":117701},[],"ninguna (solo configuración)",{"_3376":69821,"_29549":69650,"_20523":117703,"_5":14087,"_26884":117269,"_2862":52563},[],{"_3376":69822,"_29549":69650,"_20523":117705,"_5":14087,"_26884":117269,"_2862":117701},[],{"_3376":69823,"_29549":69650,"_20523":117707,"_5":14087,"_26884":117269,"_2862":117708},[],"Cualquiera → `Jitp`",{"_3376":69824,"_29549":69650,"_20523":117710,"_5":14087,"_26884":117269,"_2862":117711},[],"`iot:CreateProvisioningTemplate` (no idempotente: falla si la plantilla ya existe; tras 3 reintentos el evento acaba en `lamassu-dlq`)",{"_3376":69825,"_29549":69650,"_20523":117713,"_5":14087,"_26884":117269,"_2862":52574},[],{"_3376":69826,"_29549":69650,"_20523":117715,"_5":14087,"_26884":117269,"_2862":117716},[],"ninguna (la plantilla permanece en la cuenta AWS)",{"_3376":69827,"_29549":69650,"_20523":117718,"_5":14087,"_26884":117273,"_2862":117719},[],"Los certificados con la clave de metadatos del conector sincronizan su estado; los aprovisionados vía JITP no tienen clave de metadatos y quedan fuera de esta máquina:",{"_3376":69828,"_29549":69650,"_20523":117721,"_5":14087,"_26884":117273,"_2862":117655},[],{"_3376":69829,"_29549":69650,"_20523":117723,"_5":14087,"_26884":117273,"_2862":117658},[],{"_3376":69830,"_29549":69650,"_20523":117725,"_5":14087,"_26884":117273,"_2862":117726},[],"`NoSincronizado` → `Active`",{"_3376":69831,"_29549":69650,"_20523":117728,"_5":14087,"_26884":117273,"_2862":52231},[],{"_3376":69832,"_29549":69650,"_20523":117730,"_5":14087,"_26884":117273,"_2862":52592},[],{"_3376":69833,"_29549":69650,"_20523":117732,"_5":14087,"_26884":117273,"_2862":117733},[],"`iot:UpdateCertificate` + desconexión MQTT forzada",{"_3376":69834,"_29549":69650,"_20523":117735,"_5":14087,"_26884":117273,"_2862":52598},[],{"_3376":69835,"_29549":69650,"_20523":117737,"_5":14087,"_26884":117273,"_2862":117733},[],{"_3376":69836,"_29549":69650,"_20523":117739,"_5":14087,"_26884":117273,"_2862":52603},[],{"_3376":69837,"_29549":69650,"_20523":117741,"_5":14087,"_26884":117273,"_2862":52231},[],{"_3376":69838,"_29549":69650,"_20523":117743,"_5":14087,"_26884":117273,"_2862":52608},[],{"_3376":69839,"_29549":69650,"_20523":117745,"_5":14087,"_26884":117273,"_2862":117746},[],"ninguna (estos estados no se sincronizan con AWS)",{"_3376":69840,"_29549":69650,"_20523":117748,"_5":14087,"_26884":117277,"_2862":117749},[],"Los Things solo existen en modo `auto`; en modo `jitp` AWS crea el Thing por sí mismo cuando el dispositivo se conecta por primera vez. El nombre del Thing es siempre el CN del certificado del dispositivo:",{"_3376":69841,"_29549":69650,"_20523":117751,"_5":14087,"_26884":117277,"_2862":117655},[],{"_3376":69842,"_29549":69650,"_20523":117753,"_5":14087,"_26884":117277,"_2862":117658},[],{"_3376":69843,"_29549":69650,"_20523":117755,"_5":14087,"_26884":117277,"_2862":117756},[],"`Ausente` → `Aprovisionado`",{"_3376":69844,"_29549":69650,"_20523":117758,"_5":14087,"_26884":117277,"_2862":117759},[],"políticas creadas/actualizadas, grupos de Things asegurados, `iot:RegisterThing` (crea el Thing, registra el certificado, adjunta políticas)",{"_3376":69845,"_29549":69650,"_20523":117761,"_5":14087,"_26884":117277,"_2862":117762},[],"`Aprovisionado` → `Aprovisionado` (re-enrolamiento)",{"_3376":69846,"_29549":69650,"_20523":117764,"_5":14087,"_26884":117277,"_2862":117765},[],"principals obsoletos marcados como `REVOKED`, nueva ejecución de `iot:RegisterThing`; el nuevo ARN del certificado sustituye al anterior en los metadatos de Lamassu",{"_3376":69847,"_29549":69650,"_20523":117767,"_5":14087,"_26884":117277,"_2862":117768},[],"En modo `jitp` el conector no hace llamadas de aprovisionamiento: AWS ejecuta la plantilla JITP en la primera conexión del dispositivo y crea el Thing, registra el certificado y lo activa por su cuenta.",{"_3376":69848,"_29549":69650,"_20523":117770,"_5":14087,"_26884":117281,"_2862":117771},[],"Para que los dispositivos puedan autenticarse en AWS IoT Core con certificados emitidos por una CA de Lamassu, esa CA debe registrarse previamente en la cuenta AWS. El conector gestiona este registro de forma automática en respuesta a los eventos `EventCreateCAKey`, `EventImportCAKey` y `EventUpdateCAMetadataKey`, pero la operación **solo se dispara cuando el administrador la solicita explícitamente** mediante el campo de metadatos de la CA.",{"_3376":69849,"_29549":69650,"_20523":117773,"_5":14087,"_26884":117285,"_2862":117774},[],"El registro se desencadena estableciendo el valor `registration.status = \"REQUESTED\"` en la clave `lamassu.io/iot/{connector_id}` de los metadatos de la CA. Esto puede hacerse desde la consola de Lamassu en la sección de gestión de la CA o mediante la API.",{"_3376":69850,"_29549":69650,"_20523":117776,"_5":14087,"_26884":117285,"_2862":117777},[],"Una vez recibido el evento, el conector intenta registrar la CA en AWS y actualiza el campo `registration.status` en los metadatos de la CA con el resultado: `\"SUCCEEDED\"` si el registro fue correcto, o `\"FAILED\"` acompañado de un mensaje de error en caso contrario. El proceso es asíncrono, por lo que es necesario consultar periódicamente el estado de los metadatos hasta que la operación concluya.",{"_3376":69851,"_29549":69650,"_20523":117779,"_5":14087,"_26884":117289,"_2862":117780},[],"Cuando el parámetro `primary_account` es `true`, el conector ejecuta el flujo completo de registro con verificación de posesión de clave privada:",{"_3376":69852,"_29549":69650,"_20523":117782,"_5":14087,"_26884":117289,"_2862":117783},[],"Llama a `iot:GetRegistrationCode` para obtener el código de verificación de AWS.",{"_3376":69853,"_29549":69650,"_20523":117785,"_5":14087,"_26884":117289,"_2862":117786},[],"El conector genera internamente un par de claves RSA-2048 efímero y construye un CSR cuyo Common Name es exactamente ese código de registro. A continuación llama al servicio de firma de Lamassu para que la CA registrada emita un certificado de verificación X.509 real firmando ese CSR. La clave privada efímera se usa únicamente para este propósito y no se almacena ni se envía a AWS.",{"_3376":69854,"_29549":69650,"_20523":117788,"_5":14087,"_26884":117289,"_2862":117789},[],"Envía a AWS la CA (en PEM) y el certificado de verificación mediante `iot:RegisterCACertificate`, activando el registro con `AllowAutoRegistration: true`.",{"_3376":69855,"_29549":69650,"_20523":117791,"_5":14087,"_26884":117289,"_2862":117792},[],"Solo una cuenta puede ser propietaria de una CA en una región AWS dada. Si la CA ya está registrada con el mismo número de serie, el conector omite el paso silenciosamente.",{"_3376":69856,"_29549":69650,"_20523":117794,"_5":14087,"_26884":117289,"_2862":117795},[],"Los tags que AWS IoT Core aplica al certificado de CA registrado son `LMS.CA.ID`, `LMS.CA.SN` y `LMS.CA.CN`.",{"_3376":69857,"_29549":69650,"_20523":117797,"_5":14087,"_26884":117292,"_2862":117798},[],"Cuando `primary_account` es `false`, el conector registra la CA usando el modo `CertificateMode: SNI_ONLY`. Este modo no requiere código de verificación ni acceso a la clave privada de la CA, por lo que es la opción adecuada cuando la CA se gestiona desde otra cuenta de AWS o cuando el administrador no dispone de la clave privada. Es el método habitual para registrar la misma CA en varias cuentas de AWS simultáneamente.",{"_3376":69858,"_29549":69650,"_20523":117800,"_5":14087,"_26884":117295,"_2862":117801},[],"Cada DMS que participe en la integración con AWS IoT Core debe tener configurada la clave de metadatos `lamassu.io/iot/{connector_id}`. El campo más importante de esa configuración es `registration_mode`, que determina cómo se aprovisionan los dispositivos en AWS.",{"_3376":69859,"_29549":69650,"_20523":117803,"_5":14087,"_26884":117295,"_2862":117804},[],"Existen tres modos de registro, y la elección entre ellos depende de la estrategia de aprovisionamiento de la flota.",{"_3376":69860,"_29549":69650,"_20523":117806,"_5":14087,"_26884":117299,"_2862":117807},[],"En este modo el conector **no crea Things, grupos ni políticas** en AWS IoT Core. Se limita a sincronizar el estado de los certificados (activo, revocado, suspendido) a medida que cambian en Lamassu. Es el modo adecuado cuando el aprovisionamiento de Things en AWS se gestiona por un sistema externo y solo se necesita que Lamassu mantenga el estado de los certificados actualizado.",{"_3376":69861,"_29549":69650,"_20523":117809,"_5":14087,"_26884":117303,"_2862":117810},[],"El modo `auto` delega en Lamassu el aprovisionamiento completo del dispositivo en AWS en el momento del enrolamiento. Cuando el dispositivo completa con éxito su enrolamiento EST y Lamassu emite el evento `EventBindDeviceIdentityKey`, el conector ejecuta automáticamente la siguiente secuencia:",{"_3376":69862,"_29549":69650,"_20523":117812,"_5":14087,"_26884":117303,"_2862":117813},[],"Crea o actualiza las políticas IoT configuradas en el DMS.",{"_3376":69863,"_29549":69650,"_20523":117815,"_5":14087,"_26884":117303,"_2862":117816},[],"Crea el grupo raíz `LAMASSU` en la cuenta AWS (si no existe) y los grupos hijos configurados en el DMS como subgrupos de `LAMASSU`. Si los grupos ya existen, el error `ResourceAlreadyExistsException` se ignora, por lo que la operación es idempotente.",{"_3376":69864,"_29549":69650,"_20523":117818,"_5":14087,"_26884":117303,"_2862":117819},[],"Si el Thing ya existía en AWS IoT Core, el conector itera todos los certificados (principals) actualmente adjuntos a ese Thing y los marca como `REVOKED` en AWS, para garantizar que los certificados anteriores no puedan seguir siendo usados para autenticarse.",{"_3376":69865,"_29549":69650,"_20523":117821,"_5":14087,"_26884":117303,"_2862":117822},[],"Llama a `iot:RegisterThing` con una plantilla de aprovisionamiento de estilo CloudFormation que crea el Thing, registra el certificado del dispositivo (PEM del certificado del dispositivo y del certificado de la CA emisora) y adjunta las políticas configuradas.\nUna vez completado el aprovisionamiento, el conector almacena el ARN del certificado resultante en los metadatos del certificado de Lamassu bajo la clave `lamassu.io/iot/{connector_id}` y marca el dispositivo como `Registered: true` en Device Manager.",{"_3376":69866,"_29549":69650,"_20523":117824,"_5":14087,"_26884":117303,"_2862":117825},[],"**El nombre del Thing en AWS es el Common Name (CN) del certificado del dispositivo.** Esta convención es fundamental para el desarrollador de firmware: el valor `/CN=` que el dispositivo incluye en su CSR al enrolarse se convierte en el ThingName con el que deberá identificarse en todas las operaciones MQTT contra AWS IoT Core.",{"_3376":69867,"_29549":69650,"_20523":117827,"_5":14087,"_26884":117307,"_2862":117828},[],"El modo Just-In-Time Provisioning (JITP) delega el aprovisionamiento en AWS en lugar de hacerlo el conector directamente. Cuando el conector detecta que el DMS está en modo `jitp`, crea una plantilla de aprovisionamiento JITP en AWS IoT Core y la adjunta al certificado de CA registrado. El conector intenta crear esta plantilla cuando el DMS se crea y de nuevo en cada edición completa del DMS (`PUT /v1/dms/{id}`) - no en el momento del enrolamiento del dispositivo. El intento no es idempotente: cuando ya existe una plantilla nombrada con el ID del DMS, la llamada de creación falla, el evento se reintenta tres veces y acaba en la cola de mensajes fallidos `lamassu-dlq` (ver Solución de problemas). La plantilla se crea una sola vez; las ediciones posteriores nunca actualizan su contenido. Una actualización del DMS que omite `metadata` o envía `null` conserva los metadatos almacenados, así que la clave del conector `lamassu.io/iot/{connector_id}` sigue presente y el intento se sigue disparando. Un cuerpo que suministra un objeto `metadata` sustituye por completo los metadatos almacenados: si ese objeto no lleva la clave del conector, la clave se elimina y el conector omite silenciosamente los eventos futuros del DMS. Una vez adjuntada la plantilla, cuando un dispositivo con un certificado emitido por esa CA se conecta por primera vez a AWS IoT Core, AWS ejecuta la plantilla automáticamente: crea el Thing, registra el certificado y lo activa.",{"_3376":69868,"_29549":69650,"_20523":117830,"_5":14087,"_26884":117307,"_2862":117831},[],"El conector crea la plantilla, nombrada con el ID del DMS, una sola vez. Cada edición posterior del DMS que conserve la clave del conector intenta crearla de nuevo y falla, porque el conector no actualiza plantillas existentes. Los cambios posteriores en `jitp_config.provisioning_role_arn`, `jitp_config.enable_template` o en los grupos y políticas que la plantilla referencia deben aplicarse a mano en AWS IoT Core.",{"_3376":69869,"_29549":69650,"_20523":117833,"_5":14087,"_26884":117307,"_2862":117834},[],"El evento fallido se reintenta y termina en `lamassu-dlq`. Los grupos y las políticas se registran antes del fallo, pero se omiten la asignación de la plantilla a la CA registrada, la escritura del ARN en el DMS y la actualización de las shadows al cambiar `ManagedCAs`.",{"_3376":69870,"_29549":69650,"_20523":117836,"_5":14087,"_26884":117307,"_2862":117837},[],"El nombre del Thing en la plantilla JITP se deriva de `AWS::IoT::Certificate::CommonName`, que corresponde al CN del certificado del dispositivo - la misma convención que el modo `auto`.",{"_3376":69871,"_29549":69650,"_20523":117839,"_5":14087,"_26884":117307,"_2862":117840},[],"Este modo requiere que se configure el campo `jitp_config.provisioning_role_arn` con el ARN de un rol IAM que AWS IoT Core pueda asumir para ejecutar la plantilla. Si no se configura, el conector utiliza el valor por defecto `arn:aws:iam::{account}:role/JITPRole` y registra un aviso en el log. El administrador debe asegurarse de que ese rol existe en la cuenta y tiene los permisos necesarios antes de activar el modo JITP.",{"_3376":69872,"_29549":69650,"_20523":117842,"_5":14087,"_26884":117311,"_2862":117843},[],"Para el desarrollador de firmware, el modo `auto` es transparente: el dispositivo realiza su enrolamiento EST de la forma habitual y, como efecto secundario, queda aprovisionado en AWS IoT Core sin ningún paso adicional.",{"_3376":69873,"_29549":69650,"_20523":117845,"_5":14087,"_26884":117311,"_2862":117846},[],"El flujo completo desde el punto de vista del dispositivo es el siguiente:",{"_3376":69874,"_29549":69650,"_20523":117848,"_5":14087,"_26884":117311,"_2862":117849},[],"Una vez que el conector completa el aprovisionamiento, el dispositivo puede conectarse al endpoint AWS IoT Core de MQTT usando su clave privada y el certificado emitido por Lamassu. El ThingName con el que debe identificarse en AWS es exactamente el CN del certificado.",{"_3376":69875,"_29549":69650,"_20523":117851,"_5":14087,"_26884":117315,"_2862":117852},[],"En el modo JITP el dispositivo también realiza su enrolamiento EST de forma convencional y obtiene su certificado de Lamassu. La diferencia es que AWS IoT Core no conoce al dispositivo hasta que este intenta conectarse por primera vez.",{"_3376":69876,"_29549":69650,"_20523":117854,"_5":14087,"_26884":117315,"_2862":117855},[],"Cuando el dispositivo establece su primera conexión MQTT a AWS IoT Core presentando el certificado emitido por Lamassu, AWS detecta que el certificado pertenece a una CA registrada con una plantilla JITP, ejecuta esa plantilla y crea el Thing automáticamente. La conexión inicial puede fallar o demorarse mientras se ejecuta la plantilla; el firmware debe estar preparado para reintentar la conexión.",{"_3376":69877,"_29549":69650,"_20523":117857,"_5":14087,"_26884":117315,"_2862":117858},[],"Para que el flujo JITP funcione correctamente:",{"_3376":69878,"_29549":69650,"_20523":117860,"_5":14087,"_26884":117315,"_2862":117861},[],"La CA debe estar registrada en AWS en modo Primary Account (el modo SNI-only no admite JITP).",{"_3376":69879,"_29549":69650,"_20523":117863,"_5":14087,"_26884":117315,"_2862":117864},[],"El rol IAM configurado en `jitp_config.provisioning_role_arn` debe existir y tener permisos para crear Things, registrar certificados y adjuntar políticas en la cuenta AWS.",{"_3376":69880,"_29549":69650,"_20523":117866,"_5":14087,"_26884":117315,"_2862":117867},[],"El dispositivo debe presentar tanto su certificado como el certificado de la CA emisora en el handshake TLS con AWS IoT Core.",{"_3376":69881,"_29549":69650,"_20523":117869,"_5":14087,"_26884":117315,"_2862":117870},[],"Los certificados aprovisionados mediante JITP **no tienen asociada la clave de metadatos del conector** (`lamassu.io/iot/{connector_id}`) en Lamassu. Como consecuencia, los cambios de estado de esos certificados en Lamassu no se sincronizan automáticamente con AWS a través del mecanismo de sincronización de estado descrito en la siguiente sección.",{"_3376":69882,"_29549":69650,"_20523":117872,"_5":14087,"_26884":117319,"_2862":117873},[],"El conector escucha el evento `EventUpdateCertificateStatusKey` y, cuando un certificado que tiene la clave de metadatos del conector cambia de estado en Lamassu, replica ese cambio en AWS IoT Core. La tabla siguiente muestra la correspondencia de estados:",{"_3376":69883,"_29549":69650,"_20523":117875,"_5":14087,"_26884":117319,"_2862":117876},[],"Estado en Lamassu",{"_3376":69884,"_29549":69650,"_20523":117878,"_5":14087,"_26884":117319,"_2862":117879},[],"Razón de revocación",{"_3376":69885,"_29549":69650,"_20523":117881,"_5":14087,"_26884":117319,"_2862":117882},[],"Estado en AWS IoT Core",{"_3376":69886,"_29549":69650,"_20523":117884,"_5":14087,"_26884":117319,"_2862":52753},[],{"_3376":69887,"_29549":69650,"_20523":117886,"_5":14087,"_26884":117319,"_2862":117887},[],"Ninguna",{"_3376":69888,"_29549":69650,"_20523":117889,"_5":14087,"_26884":117319,"_2862":52759},[],{"_3376":69889,"_29549":69650,"_20523":117891,"_5":14087,"_26884":117319,"_2862":52762},[],{"_3376":69890,"_29549":69650,"_20523":117893,"_5":14087,"_26884":117319,"_2862":52765},[],{"_3376":69891,"_29549":69650,"_20523":117895,"_5":14087,"_26884":117319,"_2862":52768},[],{"_3376":69892,"_29549":69650,"_20523":117897,"_5":14087,"_26884":117319,"_2862":52762},[],{"_3376":69893,"_29549":69650,"_20523":117899,"_5":14087,"_26884":117319,"_2862":117900},[],"Cualquier otra razón",{"_3376":69894,"_29549":69650,"_20523":117902,"_5":14087,"_26884":117319,"_2862":52776},[],{"_3376":69895,"_29549":69650,"_20523":117904,"_5":14087,"_26884":117319,"_2862":117905},[],"Solo los estados `Active` y `Revoked` producen una llamada a `iot:UpdateCertificate`. Los demás estados del ciclo de vida de Lamassu (`RenewalWindow`, `AboutToExpire`, `Expired`) no se sincronizan con AWS IoT Core; el estado del certificado en AWS permanece sin cambios hasta que el estado en Lamassu sea `Active` o `Revoked`.",{"_3376":69896,"_29549":69650,"_20523":117907,"_5":14087,"_26884":117323,"_2862":117908},[],"Cuando el conector marca un certificado como `REVOKED` o `INACTIVE` en AWS, ejecuta adicionalmente una desconexión forzada del dispositivo. Para ello abre una conexión MQTT sobre WebSocket (con autenticación SigV4 con las credenciales del conector) al endpoint de datos de AWS IoT Core, usando el CN del certificado como identificador de cliente MQTT, y la cierra inmediatamente. Esto termina cualquier sesión MQTT activa que el dispositivo pueda tener en ese momento.",{"_3376":69897,"_29549":69650,"_20523":117910,"_5":14087,"_26884":117323,"_2862":117911},[],"Esta desconexión forzada se produce en el momento en que Lamassu registra el cambio de estado. Si el dispositivo vuelve a intentar conectarse tras la desconexión, AWS IoT Core rechazará la conexión porque el certificado ya figura como `REVOKED` o `INACTIVE`.",{"_3376":69898,"_29549":69650,"_20523":117913,"_5":14087,"_26884":117323,"_2862":117914},[],"Los certificados aprovisionados en modo JITP no disponen de esta sincronización automática, ya que no tienen la clave de metadatos del conector.",{"_3376":69899,"_29549":69650,"_20523":117916,"_5":14087,"_26884":117327,"_2862":117917},[],"El conector puede escribir en el Device Shadow de AWS IoT Core para enviar señales de acción al firmware del dispositivo. Esta funcionalidad se activa por DMS mediante `shadow_config.enable: true`.",{"_3376":69900,"_29549":69650,"_20523":117919,"_5":14087,"_26884":117327,"_2862":117920},[],"Si `shadow_config.shadow_name` contiene un valor, el conector usa un Named Shadow con ese nombre; en caso contrario, usa el Classic Shadow (shadow predeterminado del Thing).",{"_3376":69901,"_29549":69650,"_20523":117922,"_5":14087,"_26884":117331,"_2862":117923},[],"El conector escribe en el campo `desired.identity_actions` del documento shadow. Cada entrada contiene un timestamp Unix en milisegundos. El firmware del dispositivo debe leer este campo y actuar en consecuencia.",{"_3376":69902,"_29549":69650,"_20523":117925,"_5":14087,"_26884":117331,"_2862":117926},[],"Existen dos tipos de acciones:",{"_3376":69903,"_29549":69650,"_20523":117928,"_5":14087,"_26884":117331,"_2862":117929},[],"**`UPDATE_CERTIFICATE`**: se escribe cuando la ventana de renovación preventiva de un certificado se activa - es decir, cuando el campo `triggered` de la delta de renovación preventiva pasa de `false` a `true`. Esta acción indica al dispositivo que debe iniciar el proceso de re-enrolamiento para renovar su certificado antes de que expire.",{"_3376":69904,"_29549":69650,"_20523":117931,"_5":14087,"_26884":117331,"_2862":117932},[],"**`UPDATE_TRUST_ANCHOR_LIST`**: se escribe en todos los dispositivos de un DMS cuando la lista `ManagedCAs` del DMS cambia. Esta acción indica al dispositivo que debe actualizar su almacén de CAs de confianza.",{"_3376":69905,"_29549":69650,"_20523":117934,"_5":14087,"_26884":117331,"_2862":117935},[],"El proceso de escritura en el shadow consiste en leer el shadow actual (`iotdata:GetThingShadow`), combinar las nuevas acciones con las existentes y escribir el resultado (`iotdata:UpdateThingShadow`). Si el shadow no existe, el conector lo crea. Tras una escritura correcta, la lista de acciones pendientes en los metadatos del dispositivo en Lamassu se limpia.",{"_3376":69906,"_29549":69650,"_20523":117937,"_5":14087,"_26884":117335,"_2862":117938},[],"El conector crea y adjunta las políticas que se configuran en el DMS. Una política típica para un dispositivo que usa MQTT y Device Shadow tiene la siguiente estructura:",{"_3376":69907,"_29549":69650,"_20523":117940,"_5":14087,"_26884":117335,"_2862":117941},[],"En la política anterior, los marcadores `<AWS_REGION>` y `<AWS_ACCOUNT_ID>` deben reemplazarse por la región AWS y el identificador de cuenta de doce dígitos de la cuenta destino antes de aplicar la política. La variable `${iot:Connection.Thing.ThingName}` limita automáticamente cada permiso al Thing al que el dispositivo está conectado, siguiendo el principio de mínimo privilegio. La variable `${ShadowName}` en los ARN de shadow es un marcador que debe reemplazarse con el valor de `shadow_config.shadow_name` configurado en el DMS; si se usa el Classic Shadow, se puede simplificar eliminando el segmento `name/${ShadowName}/`. Las políticas de AWS IoT no admiten expresiones regulares con alternancia; la notación `[name/${ShadowName}/]*` representa la opcionalidad del segmento dentro de las restricciones de la sintaxis de ARN.",{"_3376":69908,"_29549":69650,"_20523":117943,"_5":14087,"_26884":117335,"_2862":117944},[],"El primer statement permite que el dispositivo se conecte usando su ThingName como identificador MQTT. El segundo autoriza la publicación en el topic MQTT genérico del Thing y en los topics del shadow, necesario para que el dispositivo pueda actualizar el estado reportado. Los dos últimos statements otorgan permisos de suscripción y recepción sobre los mismos topics, lo que permite al dispositivo recibir actualizaciones del shadow (por ejemplo, las acciones `UPDATE_CERTIFICATE` y `UPDATE_TRUST_ANCHOR_LIST` escritas por el conector).",{"_3376":69909,"_29549":69650,"_20523":117946,"_5":14087,"_26884":117339,"_2862":117947},[],"**Síntoma:** El registro de la CA permanece indefinidamente en estado `REQUESTED`.",{"_3376":69910,"_29549":69650,"_20523":117949,"_5":14087,"_26884":117339,"_2862":117950},[],"**Causa:** El conector no está en ejecución o no está suscrito al bus de eventos. También puede indicar credenciales IAM incorrectas, permisos insuficientes o que la clave de metadatos se escribió con un `connector_id` incorrecto.",{"_3376":69911,"_29549":69650,"_20523":117952,"_5":14087,"_26884":117339,"_2862":117953},[],"**Resolución:** Verificar que el proceso del conector está activo y que los logs no muestran errores de comunicación con AWS. Comprobar que el campo de metadatos se escribió bajo la clave exacta `lamassu.io/iot/{connector_id}`. Si el error persiste, el conector actualizará el estado a `FAILED` con un mensaje descriptivo en los metadatos de la CA.",{"_3376":69912,"_29549":69650,"_20523":117955,"_5":14087,"_26884":117339,"_2862":117956},[],"**Síntoma:** El estado de un certificado no se sincroniza con AWS tras una revocación.",{"_3376":69913,"_29549":69650,"_20523":117958,"_5":14087,"_26884":117339,"_2862":117959},[],"**Causa:** Lo más habitual es que el certificado fue aprovisionado en modo JITP. Los certificados JITP no tienen la clave de metadatos del conector y quedan fuera del mecanismo de sincronización de estado. Si el DMS está en modo `auto`, puede indicar que el aprovisionamiento inicial no completó correctamente y el ARN de AWS no se almacenó en los metadatos del certificado.",{"_3376":69914,"_29549":69650,"_20523":117961,"_5":14087,"_26884":117339,"_2862":117962},[],"**Resolución:** Para certificados JITP, migrar el DMS a modo `auto` y re-aprovisionar los dispositivos afectados. Para certificados en modo `auto`, verificar que el certificado tiene el ARN de AWS almacenado en sus metadatos; si no lo tiene, repetir el aprovisionamiento.",{"_3376":69915,"_29549":69650,"_20523":117964,"_5":14087,"_26884":117339,"_2862":117965},[],"**Síntoma:** La desconexión forzada no termina la sesión MQTT del dispositivo tras la revocación.",{"_3376":69916,"_29549":69650,"_20523":117967,"_5":14087,"_26884":117339,"_2862":117968},[],"**Causa:** El dispositivo usa un client ID MQTT diferente al CN del certificado. La desconexión forzada abre una conexión usando el CN como client ID; si el firmware usa otro identificador, la desconexión no afecta a esa sesión.",{"_3376":69917,"_29549":69650,"_20523":117970,"_5":14087,"_26884":117339,"_2862":117971},[],"**Resolución:** Asegurarse de que el firmware usa exactamente el CN del certificado como identificador de cliente MQTT. Ese CN coincide con el ThingName en AWS IoT Core.",{"_3376":69918,"_29549":69650,"_20523":117973,"_5":14087,"_26884":117339,"_2862":117974},[],"**Síntoma:** El dispositivo recibe `CLIENT_ID_REJECTED` al conectarse a AWS IoT Core.",{"_3376":69919,"_29549":69650,"_20523":117976,"_5":14087,"_26884":117339,"_2862":117977},[],"**Causa:** El client ID MQTT no coincide con el ThingName, que es siempre el CN del certificado emitido por Lamassu.",{"_3376":69920,"_29549":69650,"_20523":117979,"_5":14087,"_26884":117339,"_2862":117980},[],"**Resolución:** Verificar que el firmware usa exactamente el valor del campo CN incluido en el CSR de enrolamiento como identificador de cliente MQTT.",{"_3376":69921,"_29549":69650,"_20523":117982,"_5":14087,"_26884":117339,"_2862":117983},[],"**Síntoma:** La primera conexión MQTT del dispositivo en modo JITP falla o excede el tiempo de espera.",{"_3376":69922,"_29549":69650,"_20523":117985,"_5":14087,"_26884":117339,"_2862":117986},[],"**Causa:** Es el comportamiento esperado mientras AWS ejecuta la plantilla JITP en la primera conexión del dispositivo.",{"_3376":69923,"_29549":69650,"_20523":117988,"_5":14087,"_26884":117339,"_2862":117989},[],"**Resolución:** El firmware debe implementar reintentos con backoff exponencial para la primera conexión. Si el fallo persiste más allá de unos minutos, verificar que el rol IAM configurado en `jitp_config.provisioning_role_arn` existe en la cuenta y tiene permisos para crear Things, registrar certificados y adjuntar políticas.",{"_3376":69924,"_29549":69650,"_20523":117991,"_5":14087,"_26884":117339,"_2862":117992},[],"**Síntoma:** El Device Shadow no se actualiza cuando debería.",{"_3376":69925,"_29549":69650,"_20523":117994,"_5":14087,"_26884":117339,"_2862":117995},[],"**Causa:** La función de shadow está desactivada en la configuración del DMS, las credenciales del conector carecen de permisos sobre la API de datos de IoT, o el firmware lee un shadow diferente al configurado.",{"_3376":69926,"_29549":69650,"_20523":117997,"_5":14087,"_26884":117339,"_2862":117998},[],"**Resolución:** Comprobar que `shadow_config.enable` está a `true` en los metadatos del conector para el DMS correspondiente. Si se usa Named Shadow, verificar que `shadow_config.shadow_name` contiene el nombre correcto y que el firmware lee ese Named Shadow y no el Classic Shadow. Confirmar que las credenciales del conector tienen permisos `iotdata:GetThingShadow` y `iotdata:UpdateThingShadow`.",{"_3376":69927,"_29549":69650,"_20523":118000,"_5":14087,"_26884":117339,"_2862":118001},[],"**Síntoma:** Tras editar un DMS en modo `jitp`, aparecen mensajes de actualización del DMS en `lamassu-dlq`, o los cambios de configuración JITP no tienen efecto en AWS.",{"_3376":69928,"_29549":69650,"_20523":118003,"_5":14087,"_26884":117339,"_2862":118004},[],"**Causa:** Cada edición completa del DMS (`PUT /v1/dms/{id}`) dispara un nuevo intento de `CreateProvisioningTemplate` para la plantilla nombrada con el ID del DMS, y la llamada no es idempotente: cuando la plantilla ya existe, falla, el evento se reintenta tres veces y acaba en `lamassu-dlq`. Se omiten los pasos posteriores del conector.",{"_3376":69929,"_29549":69650,"_20523":118006,"_5":14087,"_26884":117339,"_2862":118007},[],"**Resolución:** Comprobar que la plantilla nombrada con el ID del DMS existe en AWS IoT Core y que el enrolamiento JITP funciona. Si se cambió la configuración JITP, aplicarla a mano en la plantilla de AWS.",{"_3376":69930,"_29549":69650,"_20523":118009,"_5":14087,"_26884":117339,"_2862":118010},[],"<Card title=\"Configurar un DMS\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":69931,"_29549":69650,"_20523":118012,"_5":14087,"_26884":117339,"_2862":118013},[],"<Card title=\"Enrolamiento de dispositivos (EST)\" href=\"/docs/platform/iot-fleets/enrollment/overview\" />",{"_3376":69932,"_29549":69650,"_20523":118015,"_5":14087,"_26884":117339,"_2862":118016},[],"<Card title=\"Gestión de certificados\" href=\"/docs/platform/pki/certificates\" />",{"_3376":69933,"_29549":69933,"_5":14445,"_2862":50590,"_29881":118018,"_20523":118019,"_26884":69933},[48111,114818,50590],[],{"_3376":69934,"_29549":69933,"_20523":118021,"_5":14087,"_26884":69933,"_2862":118022},[],"Organiza los dispositivos y sus identidades, prepara el enrolamiento e integra consumidores.",{"_3376":69935,"_29549":69933,"_5":29878,"_20523":118024,"_26884":118025,"_2862":118026},[],"/docs/es/platform/iot-fleets/overview#empieza-aquí","Empieza aquí",{"_3376":69936,"_29549":69933,"_5":29878,"_20523":118028,"_26884":118029,"_2862":115827},[],"/docs/es/platform/iot-fleets/overview#dispositivos-e-identidades",{"_3376":69937,"_29549":69933,"_5":29878,"_20523":118031,"_26884":118032,"_2862":116002},[],"/docs/es/platform/iot-fleets/overview#enrolamiento-con-pki",{"_3376":69938,"_29549":69933,"_5":29878,"_20523":118034,"_26884":118035,"_2862":117234},[],"/docs/es/platform/iot-fleets/overview#integraciones",{"_3376":69939,"_29549":69933,"_5":29878,"_20523":118037,"_26884":118038,"_2862":118039},[],"/docs/es/platform/iot-fleets/overview#quién-prepara-cada-parte","Quién prepara cada parte",{"_3376":69940,"_29549":69933,"_20523":118041,"_5":14087,"_26884":69933,"_2862":118042},[],"IoT Fleets aplica la PKI al ciclo de vida de dispositivos: registro, obtención de identidad, renovación y retirada. Está dirigido a quien administra una población de dispositivos y a quien integra su cliente de enrolamiento o el sistema que los acepta.",{"_3376":69941,"_29549":69933,"_20523":118044,"_5":14087,"_26884":118025,"_2862":118045},[],"Sigue Enrola y conecta tu primer dispositivo para preparar un DMS, obtener la identidad desde el cliente y demostrar una conexión mTLS. El recorrido automático incluye confianza inicial, CSR y comprobación del resultado.",{"_3376":69942,"_29549":69933,"_20523":118047,"_5":14087,"_26884":118025,"_2862":118048},[],"Si necesitas comenzar con un certificado existente, utiliza Registra un dispositivo manualmente. Después podrás preparar el enrolamiento y la renovación del siguiente dispositivo.",{"_3376":69943,"_29549":69933,"_20523":118050,"_5":14087,"_26884":118029,"_2862":118051},[],"Recurso",{"_3376":69944,"_29549":69933,"_20523":118053,"_5":14087,"_26884":118029,"_2862":118054},[],"Qué representa",{"_3376":69945,"_29549":69933,"_20523":118056,"_5":14087,"_26884":118029,"_2862":118057},[],"**Dispositivo**",{"_3376":69946,"_29549":69933,"_20523":118059,"_5":14087,"_26884":118029,"_2862":118060},[],"Una entrada de inventario con identificador, DMS propietario y clasificación.",{"_3376":69947,"_29549":69933,"_20523":118062,"_5":14087,"_26884":118029,"_2862":118063},[],"**Identidad**",{"_3376":69948,"_29549":69933,"_20523":118065,"_5":14087,"_26884":118029,"_2862":118066},[],"La asociación del dispositivo con sus certificados: una versión activa y un historial.",{"_3376":69949,"_29549":69933,"_20523":118068,"_5":14087,"_26884":118029,"_2862":52943},[],{"_3376":69950,"_29549":69933,"_20523":118070,"_5":14087,"_26884":118029,"_2862":118071},[],"El servicio que configura admisión, enrolamiento, renovación y distribución de confianza.",{"_3376":69951,"_29549":69933,"_20523":118073,"_5":14087,"_26884":118029,"_2862":118074},[],"**Flota**",{"_3376":69952,"_29549":69933,"_20523":118076,"_5":14087,"_26884":118029,"_2862":118077},[],"La población que operas, representada mediante dispositivos, DMS, etiquetas y metadatos.",{"_3376":69953,"_29549":69933,"_20523":118079,"_5":14087,"_26884":118029,"_2862":118080},[],"Cada dispositivo tiene un DMS propietario. Puedes organizar una población mediante varios DMS cuando necesita políticas distintas, y utilizar etiquetas para clasificarla. «Flota» describe ese contexto operativo; los recursos que creas y consultas son DMS y dispositivos.",{"_3376":69954,"_29549":69933,"_20523":118082,"_5":14087,"_26884":118029,"_2862":118083},[],"La gestión de dispositivos reúne estados, historial de certificados y acciones sobre la identidad. Al renovar, debes conservar la relación con el dispositivo y comprobar qué certificado pasa a ser la identidad actual.",{"_3376":69955,"_29549":69933,"_20523":118085,"_5":14087,"_26884":118032,"_2862":118086},[],"Este bloque conecta las reglas PKI con el cliente del dispositivo. La preparación sigue este orden:",{"_3376":69956,"_29549":69933,"_20523":118088,"_5":14087,"_26884":118032,"_2862":118089},[],"**CA y perfil:** prepara el emisor y las reglas del certificado en PKI.",{"_3376":69957,"_29549":69933,"_20523":118091,"_5":14087,"_26884":118032,"_2862":118092},[],"**Política DMS:** define cómo se admite el dispositivo, cómo se autentican sus solicitudes y qué confianza se distribuye.",{"_3376":69958,"_29549":69933,"_20523":118094,"_5":14087,"_26884":118032,"_2862":118095},[],"**Cliente:** prepara la credencial inicial, la confianza del servidor y la generación o custodia de la clave.",{"_3376":69959,"_29549":69933,"_20523":118097,"_5":14087,"_26884":118032,"_2862":118098},[],"**Resultado:** solicita el certificado, instálalo y comprueba su asociación con el dispositivo.",{"_3376":69960,"_29549":69933,"_20523":118100,"_5":14087,"_26884":118032,"_2862":118101},[],"**Continuidad:** configura renovación, instalación del sucesor y recuperación según la política del DMS.",{"_3376":69961,"_29549":69933,"_20523":118103,"_5":14087,"_26884":118032,"_2862":118104},[],"<Card title=\"Configura el DMS\" description=\"Prepara la CA, la admisión, la autenticación y las reglas de renovación.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_3376":69962,"_29549":69933,"_20523":118106,"_5":14087,"_26884":118032,"_2862":118107},[],"<Card title=\"Integra el cliente EST\" description=\"Consulta los endpoints, formatos y comprobaciones del dispositivo.\" href=\"/docs/platform/iot-fleets/enrollment/est-client\" />",{"_3376":69963,"_29549":69933,"_20523":118109,"_5":14087,"_26884":118035,"_2862":118110},[],"Una identidad emitida necesita un consumidor que confíe en su emisor, valide el certificado y conceda permisos al dispositivo. Prepara tanto la confianza del dispositivo en el servidor como la del servidor en el dispositivo.",{"_3376":69964,"_29549":69933,"_20523":118112,"_5":14087,"_26884":118035,"_2862":118113},[],"La guía de AWS IoT Core explica cómo utilizar la identidad en ese destino. El aprovisionamiento en Lamassu y el aprovisionamiento en el destino son decisiones distintas; revisa las condiciones del modo elegido antes de esperar sincronización de estados.",{"_3376":69965,"_29549":69933,"_20523":118115,"_5":14087,"_26884":118038,"_2862":118116},[],"Participante",{"_3376":69966,"_29549":69933,"_20523":118118,"_5":14087,"_26884":118038,"_2862":118119},[],"Responsabilidad",{"_3376":69967,"_29549":69933,"_20523":118121,"_5":14087,"_26884":118038,"_2862":118122},[],"Administrador PKI",{"_3376":69968,"_29549":69933,"_20523":118124,"_5":14087,"_26884":118038,"_2862":118125},[],"CA, perfil de emisión, cadena y publicación de revocación.",{"_3376":69969,"_29549":69933,"_20523":118127,"_5":14087,"_26884":118038,"_2862":118128},[],"Administrador del aprovisionamiento",{"_3376":69970,"_29549":69933,"_20523":118130,"_5":14087,"_26884":118038,"_2862":118131},[],"DMS, admisión, autenticación por operación e inventario.",{"_3376":69971,"_29549":69933,"_20523":118133,"_5":14087,"_26884":118038,"_2862":118134},[],"Integrador del dispositivo",{"_3376":69972,"_29549":69933,"_20523":118136,"_5":14087,"_26884":118038,"_2862":118137},[],"Credencial inicial, clave, cliente EST, confianza e instalación de certificados.",{"_3376":69973,"_29549":69933,"_20523":118139,"_5":14087,"_26884":118038,"_2862":118140},[],"Integrador del consumidor",{"_3376":69974,"_29549":69933,"_20523":118142,"_5":14087,"_26884":118038,"_2862":118143},[],"Emisores confiables, validación y permisos del dispositivo en el destino.",{"_3376":69975,"_29549":69933,"_20523":118145,"_5":14087,"_26884":118038,"_2862":118146},[],"Los permisos y la auditoría son compartidos con el resto de Plataforma. La instalación y la conectividad de la instancia se preparan en Despliegue.",{"_3376":69976,"_29549":69976,"_5":14445,"_2862":118148,"_29881":118149,"_20523":118151,"_26884":69976},"Enrola y conecta tu primer dispositivo",[48111,114818,50590,118150],"Primeros pasos",[],{"_3376":69977,"_29549":69976,"_20523":118153,"_5":14087,"_26884":69976,"_2862":118154},[],"Obtén una identidad por EST, verifica su asociación y úsala en una conexión mTLS.",{"_3376":69978,"_29549":69976,"_5":29878,"_20523":118156,"_26884":118157,"_2862":113396},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#antes-de-empezar",{"_3376":69979,"_29549":69976,"_5":29878,"_20523":118159,"_26884":118160,"_2862":118161},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-la-credencial-inicial","Prepara la credencial inicial",{"_3376":69980,"_29549":69976,"_5":29878,"_20523":118163,"_26884":118164,"_2862":118165},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#configura-el-dms-de-evaluación","Configura el DMS de evaluación",{"_3376":69981,"_29549":69976,"_5":29878,"_20523":118167,"_26884":118168,"_2862":118169},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#prepara-el-cliente-y-comprueba-cacerts","Prepara el cliente y comprueba cacerts",{"_3376":69982,"_29549":69976,"_5":29878,"_20523":118171,"_26884":118172,"_2862":118173},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#enrola-el-dispositivo","Enrola el dispositivo",{"_3376":69983,"_29549":69976,"_5":29878,"_20523":118175,"_26884":118176,"_2862":118177},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#verifica-la-identidad-obtenida","Verifica la identidad obtenida",{"_3376":69984,"_29549":69976,"_5":29878,"_20523":118179,"_26884":118180,"_2862":118181},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#demuestra-una-conexión-mtls","Demuestra una conexión mTLS",{"_3376":69985,"_29549":69976,"_5":29878,"_20523":118183,"_26884":118184,"_2862":118185},[],"/docs/es/platform/iot-fleets/quickstarts/enroll-device#resultado-y-continuidad","Resultado y continuidad",{"_3376":69986,"_29549":69976,"_20523":118187,"_5":14087,"_26884":69976,"_2862":118188},[],"Prepararás un DMS de evaluación, enrolarás `est-device-001` desde el cliente y usarás su identidad frente a un consumidor local que exige certificado. El recorrido conecta la política del administrador con el material que realmente instala el dispositivo.",{"_3376":69987,"_29549":69976,"_20523":118190,"_5":14087,"_26884":118157,"_2862":118191},[],"Instancia Lamassu accesible por HTTPS y permisos para CAs, perfiles, DMS y lectura de dispositivos/certificados.",{"_3376":69988,"_29549":69976,"_20523":118193,"_5":14087,"_26884":118157,"_2862":118194},[],"Bash, OpenSSL 3.x, curl con `--fail-with-body` y dos terminales en tu equipo. Trabaja en un directorio nuevo con acceso restringido.",{"_3376":69989,"_29549":69976,"_20523":118196,"_5":14087,"_26884":118157,"_2862":118197},[],"Una CA raíz activa que emita directamente, con clave disponible y vigencia suficiente. Sigue Crea tu primera CA. Guarda su certificado público verificado como `device-root.pem`.",{"_3376":69990,"_29549":69976,"_20523":118199,"_5":14087,"_26884":118157,"_2862":118200},[],"El identificador global `est-device-001` libre. Este recorrido utiliza registro automático: no crees primero el dispositivo desde la consola.",{"_3376":69991,"_29549":69976,"_20523":118202,"_5":14087,"_26884":118157,"_2862":118203},[],"La raíz aprobada para el HTTPS de Lamassu en `est-trust.pem`, obtenida por un canal independiente. Puede ser distinta de la CA de dispositivos; prepara red/TLS en Despliegue.",{"_3376":69992,"_29549":69976,"_20523":118205,"_5":14087,"_26884":118160,"_2862":118206},[],"Emite un certificado final bootstrap con `CN=est-device-001`, clave propia y uso Client Authentication. Puedes seguir Emite y verifica un certificado, sustituyendo su CN y guardando el resultado como `bootstrap.crt` y `bootstrap.key`. Elige una validez que cubra esta prueba y comprueba la pareja y la cadena.",{"_3376":69993,"_29549":69976,"_20523":118208,"_5":14087,"_26884":118160,"_2862":118209},[],"Para esta evaluación aislada puede emitirlo la misma CA raíz. La identidad operativa tendrá una clave y un certificado distintos. El CN igual facilita la lectura del ejemplo; la autenticación inicial por certificado no vincula por sí sola el CN del bootstrap con el ID pedido. Revisa la admisión antes de aplicar la política a una población.",{"_3376":69994,"_29549":69976,"_20523":118211,"_5":14087,"_26884":118164,"_2862":118212},[],"Crea un perfil final explícito, compatible con EC P-256, con **Honor Subject**, CN de la CSR, **Digital Signature**, **Client Authentication** y una validez de **1 hora** dentro de la vigencia de la raíz. No habilites firma como CA. Las reglas y precedencia se explican en Perfiles.",{"_3376":69995,"_29549":69976,"_20523":118214,"_5":14087,"_26884":118164,"_2862":118215},[],"Crea el DMS `Acme EST Evaluation` con esta configuración:",{"_3376":69996,"_29549":69976,"_20523":118217,"_5":14087,"_26884":118164,"_2862":118218},[],"Ajuste",{"_3376":69997,"_29549":69976,"_20523":118220,"_5":14087,"_26884":118164,"_2862":118221},[],"Valor de evaluación",{"_3376":69998,"_29549":69976,"_20523":118223,"_5":14087,"_26884":118164,"_2862":53099},[],{"_3376":69999,"_29549":69976,"_20523":118225,"_5":14087,"_26884":118164,"_2862":118226},[],"Raíz emisora de `device-root.pem`.",{"_3376":70000,"_29549":69976,"_20523":118228,"_5":14087,"_26884":118164,"_2862":116130},[],{"_3376":70001,"_29549":69976,"_20523":118230,"_5":14087,"_26884":118164,"_2862":118231},[],"Perfil final de 1 hora que acabas de preparar.",{"_3376":70002,"_29549":69976,"_20523":118233,"_5":14087,"_26884":118164,"_2862":53110},[],{"_3376":70003,"_29549":69976,"_20523":118235,"_5":14087,"_26884":118164,"_2862":53113},[],{"_3376":70004,"_29549":69976,"_20523":118237,"_5":14087,"_26884":118164,"_2862":53116},[],{"_3376":70005,"_29549":69976,"_20523":118239,"_5":14087,"_26884":118164,"_2862":118240},[],"Habilitado.",{"_3376":70006,"_29549":69976,"_20523":118242,"_5":14087,"_26884":118164,"_2862":53122},[],{"_3376":70007,"_29549":69976,"_20523":118244,"_5":14087,"_26884":118164,"_2862":118245},[],"Deshabilitado; el ID debe ser nuevo.",{"_3376":70008,"_29549":69976,"_20523":118247,"_5":14087,"_26884":118164,"_2862":118248},[],"Autenticación inicial",{"_3376":70009,"_29549":69976,"_20523":118250,"_5":14087,"_26884":118164,"_2862":118251},[],"`CLIENT_CERTIFICATE`; Validation CAs incluye el emisor directo del bootstrap; no aceptar vencidos.",{"_3376":70010,"_29549":69976,"_20523":118253,"_5":14087,"_26884":118164,"_2862":118254},[],"Autenticación de renovación",{"_3376":70011,"_29549":69976,"_20523":118256,"_5":14087,"_26884":118164,"_2862":118257},[],"`CLIENT_CERTIFICATE`, configurada en el bloque independiente de re-enrollment.",{"_3376":70012,"_29549":69976,"_20523":118259,"_5":14087,"_26884":118164,"_2862":53140},[],{"_3376":70013,"_29549":69976,"_20523":118261,"_5":14087,"_26884":118164,"_2862":118262},[],"No se necesitan para esta emisión directa; la CA de enrolamiento siempre es confiable en el reenrolamiento / deshabilitado.",{"_3376":70014,"_29549":69976,"_20523":118264,"_5":14087,"_26884":118164,"_2862":53146},[],{"_3376":70015,"_29549":69976,"_20523":118266,"_5":14087,"_26884":118164,"_2862":118267},[],"1 hora.",{"_3376":70016,"_29549":69976,"_20523":118269,"_5":14087,"_26884":118164,"_2862":53152},[],{"_3376":70017,"_29549":69976,"_20523":118271,"_5":14087,"_26884":118164,"_2862":118272},[],"30 minutos / 10 minutos.",{"_3376":70018,"_29549":69976,"_20523":118274,"_5":14087,"_26884":118164,"_2862":53158},[],{"_3376":70019,"_29549":69976,"_20523":118276,"_5":14087,"_26884":118164,"_2862":118277},[],"Deshabilitado para probar el sucesor antes de retirar el anterior.",{"_3376":70020,"_29549":69976,"_20523":118279,"_5":14087,"_26884":118164,"_2862":50909},[],{"_3376":70021,"_29549":69976,"_20523":118281,"_5":14087,"_26884":118164,"_2862":118282},[],"Deshabilitado; la clave operativa se genera en el cliente.",{"_3376":70022,"_29549":69976,"_20523":118284,"_5":14087,"_26884":118164,"_2862":53169},[],{"_3376":70023,"_29549":69976,"_20523":118286,"_5":14087,"_26884":118164,"_2862":118287},[],"Include Enrollment CA habilitado; Include Lamassu System CA deshabilitado.",{"_3376":70024,"_29549":69976,"_20523":118289,"_5":14087,"_26884":118164,"_2862":118290},[],"La duración y ventana iguales permiten probar renovación inmediatamente. Son valores de evaluación; dimensiona producción según conectividad y tiempos de recuperación. Guarda, vuelve a leer los dos bloques de autenticación y conserva el ID del DMS. La consola expone editores independientes para la autenticación de enrolamiento y de reenrolamiento; la guía DMS describe sus campos, y también puedes comprobar el recurso mediante la API DMS.",{"_3376":70025,"_29549":69976,"_20523":118292,"_5":14087,"_26884":118168,"_2862":118293},[],"En el directorio nuevo, coloca los cuatro archivos de confianza y bootstrap. Sustituye el URL por el de tu instalación:",{"_3376":70026,"_29549":69976,"_20523":118295,"_5":14087,"_26884":118168,"_2862":118296},[],"La descarga debe ser satisfactoria y contener la raíz de enrolamiento prevista. Compara su huella con `device-root.pem`. Esta comprobación no convierte la respuesta en confianza inicial ni demuestra que puedas emitir.",{"_3376":70027,"_29549":69976,"_20523":118298,"_5":14087,"_26884":118172,"_2862":118299},[],"Genera una clave nueva y una CSR con el identificador elegido:",{"_3376":70028,"_29549":69976,"_20523":118301,"_5":14087,"_26884":118172,"_2862":118302},[],"Solicita la identidad con la credencial inicial y extrae el certificado de la respuesta predeterminada:",{"_3376":70029,"_29549":69976,"_20523":118304,"_5":14087,"_26884":118172,"_2862":118305},[],"Si curl falla, consulta Diagnóstico con el cuerpo guardado. No ejecutes la conversión ni repitas la solicitud sin consultar el inventario: un timeout o error puede seguir a una emisión persistida.",{"_3376":70030,"_29549":69976,"_20523":118307,"_5":14087,"_26884":118176,"_2862":118308},[],"Espera `device.crt: OK` y código 0 de `cmp`. Comprueba CN, serie, fechas, Digital Signature y Client Authentication. El certificado debe ser final: no declarar `CA:TRUE` ni uso Certificate Sign. Revisa que su validez corresponda al perfil de una hora.",{"_3376":70031,"_29549":69976,"_20523":118310,"_5":14087,"_26884":118176,"_2862":118311},[],"En Lamassu, abre `est-device-001`. Debe estar creado con el DMS propietario previsto, una identidad actual y el certificado recibido en su historial. Compara la serie local con la del slot; los umbrales pueden mostrar un estado de renovación en vez de un simple Active.",{"_3376":70032,"_29549":69976,"_20523":118313,"_5":14087,"_26884":118180,"_2862":118314},[],"En una segunda terminal, entra en el mismo directorio y ejecuta `umask 077`. Crea un certificado local de servidor y arranca un consumidor de prueba. Este servidor confía en `device-root.pem` y exige una identidad cliente válida:",{"_3376":70033,"_29549":69976,"_20523":118316,"_5":14087,"_26884":118180,"_2862":118317},[],"Déjalo funcionando. En la primera terminal, realiza la conexión con la identidad obtenida:",{"_3376":70034,"_29549":69976,"_20523":118319,"_5":14087,"_26884":118180,"_2862":118320},[],"Espera HTTP `200`. La confianza del cliente en este servidor local es su certificado autofirmado `consumer.crt`; el servidor verifica al dispositivo contra `device-root.pem`. El archivo HTML muestra información de diagnóstico de OpenSSL.",{"_3376":70035,"_29549":69976,"_20523":118322,"_5":14087,"_26884":118180,"_2862":118323},[],"Con el mismo servidor todavía funcionando, prueba que una solicitud sin certificado cliente se rechaza:",{"_3376":70036,"_29549":69976,"_20523":118325,"_5":14087,"_26884":118180,"_2862":118326},[],"El rechazo debe corresponder a la falta de certificado en el servidor, no a un servidor detenido. Termina el consumidor con Ctrl+C después de la prueba. Este ejercicio demuestra autenticación TLS y posesión de la clave; tu aplicación debe definir además autorización y consumo de revocación. Las opciones del servidor se describen en openssl-s\\_server.",{"_3376":70037,"_29549":69976,"_20523":118328,"_5":14087,"_26884":118184,"_2862":118329},[],"Comprobación",{"_3376":70038,"_29549":69976,"_20523":118331,"_5":14087,"_26884":118184,"_2862":118332},[],"Resultado esperado",{"_3376":70039,"_29549":69976,"_20523":118334,"_5":14087,"_26884":118184,"_2862":118335},[],"Registro",{"_3376":70040,"_29549":69976,"_20523":118337,"_5":14087,"_26884":118184,"_2862":118338},[],"ID creado automáticamente y DMS correcto.",{"_3376":70041,"_29549":69976,"_20523":118340,"_5":14087,"_26884":118184,"_2862":117622},[],{"_3376":70042,"_29549":69976,"_20523":118342,"_5":14087,"_26884":118184,"_2862":118343},[],"CN, perfil, serie y clave verificados.",{"_3376":70043,"_29549":69976,"_20523":118345,"_5":14087,"_26884":118184,"_2862":118346},[],"Inventario",{"_3376":70044,"_29549":69976,"_20523":118348,"_5":14087,"_26884":118184,"_2862":118349},[],"Serie recibida visible como identidad actual y en el historial.",{"_3376":70045,"_29549":69976,"_20523":118351,"_5":14087,"_26884":118184,"_2862":118352},[],"Consumidor",{"_3376":70046,"_29549":69976,"_20523":118354,"_5":14087,"_26884":118184,"_2862":118355},[],"mTLS responde 200 con la identidad y rechaza falta de certificado.",{"_3376":70047,"_29549":69976,"_20523":118357,"_5":14087,"_26884":118184,"_2862":118358},[],"Continúa con Renovación y recuperación para solicitar una pareja sucesora dentro de la ventana, instalarla y repetir la comprobación mTLS. El consumidor debe utilizar los archivos nuevos en esa prueba. Después de comprobar el sucesor, retira el certificado anterior según la política PKI; el ejemplo no lo revoca automáticamente.",{"_3376":70048,"_29549":69976,"_20523":118360,"_5":14087,"_26884":118184,"_2862":118361},[],"Dispositivos e identidades explica la retirada y los límites de revocación del historial. Para un destino real, prepara confianza, validación y permisos del consumidor; AWS IoT Core es una integración disponible.",{"_3376":70049,"_29549":70049,"_5":14445,"_2862":115844,"_29881":118363,"_20523":118364,"_26884":70049},[48111,114818,50590,118150],[],{"_3376":70050,"_29549":70049,"_20523":118366,"_5":14087,"_26884":70049,"_2862":118367},[],"Prepara un DMS, registra un dispositivo y asocia un certificado comprobado a su identidad.",{"_3376":70051,"_29549":70049,"_5":29878,"_20523":118369,"_26884":118370,"_2862":113396},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#antes-de-empezar",{"_3376":70052,"_29549":70049,"_5":29878,"_20523":118372,"_26884":118373,"_2862":118374},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#prepara-el-dms","Prepara el DMS",{"_3376":70053,"_29549":70049,"_5":29878,"_20523":118376,"_26884":118377,"_2862":118378},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#registra-el-dispositivo","Registra el dispositivo",{"_3376":70054,"_29549":70049,"_5":29878,"_20523":118380,"_26884":118381,"_2862":118382},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#comprueba-el-estado-inicial","Comprueba el estado inicial",{"_3376":70055,"_29549":70049,"_5":29878,"_20523":118384,"_26884":118385,"_2862":118386},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#asigna-una-identidad","Asigna una identidad",{"_3376":70056,"_29549":70049,"_5":29878,"_20523":118388,"_26884":118389,"_2862":118390},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#verifica-el-dispositivo","Verifica el dispositivo",{"_3376":70057,"_29549":70049,"_5":29878,"_20523":118392,"_26884":118393,"_2862":118332},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#resultado-esperado",{"_3376":70058,"_29549":70049,"_5":29878,"_20523":118395,"_26884":118396,"_2862":118397},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#si-el-resultado-falla","Si el resultado falla",{"_3376":70059,"_29549":70049,"_5":29878,"_20523":118399,"_26884":118400,"_2862":118401},[],"/docs/es/platform/iot-fleets/quickstarts/register-device#automatiza-el-siguiente-dispositivo","Automatiza el siguiente dispositivo",{"_3376":70060,"_29549":70049,"_20523":118403,"_5":14087,"_26884":70049,"_2862":118404},[],"Este recorrido está dirigido a quien empieza a administrar identidades de dispositivos. Registrarás `device-001` y le asignarás un certificado existente para comprobar la relación entre dispositivo, DMS e historial de identidad.",{"_3376":70061,"_29549":70049,"_20523":118406,"_5":14087,"_26884":70049,"_2862":118407},[],"La asignación modifica el inventario de Lamassu. La clave y el certificado se instalan por separado en el dispositivo; la conexión con un consumidor se comprueba en la integración de ese destino.",{"_3376":70062,"_29549":70049,"_20523":118409,"_5":14087,"_26884":118370,"_2862":118410},[],"Una instancia accesible y permisos para administrar DMS, dispositivos y la asociación de certificados.",{"_3376":70063,"_29549":70049,"_20523":118412,"_5":14087,"_26884":118370,"_2862":118413},[],"Una CA activa con clave disponible. Si todavía no existe, sigue Crea tu primera CA.",{"_3376":70064,"_29549":70049,"_20523":118415,"_5":14087,"_26884":118370,"_2862":118416},[],"Un certificado final activo de esa CA cuyo `Common Name` sea exactamente `device-001`, con su clave privada. Sigue Emite y verifica un certificado para obtener y comprobar ambos.",{"_3376":70065,"_29549":70049,"_20523":118418,"_5":14087,"_26884":118370,"_2862":118419},[],"El identificador `device-001` libre en el inventario. Si ya lo usaste, elige otro y emite el certificado con ese mismo `Common Name`.",{"_3376":70066,"_29549":70049,"_20523":118421,"_5":14087,"_26884":118373,"_2862":118422},[],"Un DMS debe existir antes de registrar el dispositivo. Si ya tienes uno adecuado, comprueba su CA y anota su identificador; si necesitas crearlo:",{"_3376":70067,"_29549":70049,"_20523":118424,"_5":14087,"_26884":118373,"_2862":118425},[],"Abre el inventario de DMS y la acción de creación. Asigna un nombre reconocible, como `Acme Evaluation DMS`.",{"_3376":70068,"_29549":70049,"_20523":118427,"_5":14087,"_26884":118373,"_2862":118428},[],"En **Enrollment CA**, selecciona la CA que emitió `device.crt`.",{"_3376":70069,"_29549":70049,"_20523":118430,"_5":14087,"_26884":118373,"_2862":118431},[],"En **Registration Mode**, selecciona `PRE_REGISTRATION` para el recorrido que comienza con un alta explícita.",{"_3376":70070,"_29549":70049,"_20523":118433,"_5":14087,"_26884":118373,"_2862":118434},[],"En la sección de autenticación, activa **Require client certificate** y deja **Call external webhook** desactivado. Bajo **Require client certificate**, añade a **Validation CAs** la CA cuyos certificados iniciales aceptarás; para esta evaluación puede ser la misma CA. Mantén habilitada **Verify CSR Signature** y deja **Enable server-side key generation** desactivado si no lo vas a utilizar.",{"_3376":70071,"_29549":70049,"_20523":118436,"_5":14087,"_26884":118373,"_2862":118437},[],"Revisa los ajustes de renovación y distribución de confianza con la guía DMS, guarda el servicio y anota su identificador.",{"_3376":70072,"_29549":70049,"_20523":118439,"_5":14087,"_26884":118373,"_2862":118440},[],"Vuelve a abrir el DMS y confirma que la CA de enrolamiento es la prevista y que el servicio aparece en el inventario.",{"_3376":70073,"_29549":70049,"_20523":118442,"_5":14087,"_26884":118373,"_2862":118443},[],"Estos ajustes preparan la política DMS. Los pasos siguientes realizan el alta y la asignación desde la consola; no envían una solicitud EST ni prueban la admisión por ese protocolo.",{"_3376":70074,"_29549":70049,"_20523":118445,"_5":14087,"_26884":118377,"_2862":118446},[],"Abre **Managed Devices** y la acción de registro. Completa:",{"_3376":70075,"_29549":70049,"_20523":118448,"_5":14087,"_26884":118377,"_2862":53334},[],{"_3376":70076,"_29549":70049,"_20523":118450,"_5":14087,"_26884":118377,"_2862":118451},[],"**Registration Authority**: el DMS que acabas de preparar; la etiqueta identifica al servicio que cumple el rol de autoridad de registro.",{"_3376":70077,"_29549":70049,"_20523":118453,"_5":14087,"_26884":118377,"_2862":118454},[],"**Icon** y **Tags**: clasificación opcional.",{"_3376":70078,"_29549":70049,"_20523":118456,"_5":14087,"_26884":118377,"_2862":118457},[],"Confirma el registro.",{"_3376":70079,"_29549":70049,"_20523":118459,"_5":14087,"_26884":118381,"_2862":118460},[],"Abre el dispositivo. Debe aparecer en **No Identity** y mostrar el DMS propietario seleccionado.",{"_3376":70080,"_29549":70049,"_20523":118462,"_5":14087,"_26884":118381,"_2862":118463},[],"El registro crea la entrada de inventario; el certificado todavía debe asociarse.",{"_3376":70081,"_29549":70049,"_20523":118465,"_5":14087,"_26884":118385,"_2862":118466},[],"Selecciona **Assign Identity** y el certificado existente con `CN=device-001`. Comprueba su número de serie, emisor y vigencia frente al certificado que verificaste en PKI.",{"_3376":70082,"_29549":70049,"_20523":118468,"_5":14087,"_26884":118385,"_2862":118469},[],"Confirma la asociación. La alternativa **Issue New Instead** se explica en Dispositivos e identidades.",{"_3376":70083,"_29549":70049,"_20523":118471,"_5":14087,"_26884":118389,"_2862":118472},[],"Comprueba que tiene una identidad activa. En **Certificate History**, verifica el número de serie asociado; en **Device Event Timeline**, localiza el evento de asignación.",{"_3376":70084,"_29549":70049,"_20523":118474,"_5":14087,"_26884":118389,"_2862":118475},[],"Conserva el identificador del dispositivo, el DMS propietario y el número de serie como referencias del resultado.",{"_3376":70085,"_29549":70049,"_20523":118477,"_5":14087,"_26884":118393,"_2862":118329},[],{"_3376":70086,"_29549":70049,"_20523":118479,"_5":14087,"_26884":118393,"_2862":118480},[],"Resultado",{"_3376":70087,"_29549":70049,"_20523":118482,"_5":14087,"_26884":118393,"_2862":117608},[],{"_3376":70088,"_29549":70049,"_20523":118484,"_5":14087,"_26884":118393,"_2862":118485},[],"`device-001` aparece en el inventario con el DMS previsto.",{"_3376":70089,"_29549":70049,"_20523":118487,"_5":14087,"_26884":118393,"_2862":118488},[],"Identidad actual",{"_3376":70090,"_29549":70049,"_20523":118490,"_5":14087,"_26884":118393,"_2862":118491},[],"El certificado asociado coincide con el que verificaste en PKI.",{"_3376":70091,"_29549":70049,"_20523":118493,"_5":14087,"_26884":118393,"_2862":118494},[],"Historial",{"_3376":70092,"_29549":70049,"_20523":118496,"_5":14087,"_26884":118393,"_2862":118497},[],"La emisión asociada aparece con su número de serie y fechas.",{"_3376":70093,"_29549":70049,"_20523":118499,"_5":14087,"_26884":118393,"_2862":118500},[],"Clave y certificado",{"_3376":70094,"_29549":70049,"_20523":118502,"_5":14087,"_26884":118393,"_2862":118503},[],"Dispones de la pareja comprobada para instalarla en el dispositivo.",{"_3376":70095,"_29549":70049,"_20523":118505,"_5":14087,"_26884":118396,"_2862":118506},[],"Si el DMS no puede seleccionarse, confirma su creación y tus permisos de lectura.",{"_3376":70096,"_29549":70049,"_20523":118508,"_5":14087,"_26884":118396,"_2862":118509},[],"Si no aparece un certificado elegible, comprueba que su `Common Name` coincide exactamente con el `Device ID`, está activo y lo emitió la CA prevista.",{"_3376":70097,"_29549":70049,"_20523":118511,"_5":14087,"_26884":118396,"_2862":118512},[],"Si falla la asignación, revisa los permisos y el diagnóstico de la operación antes de repetirla. Vuelve a consultar el dispositivo y su historial para conocer el resultado persistido.",{"_3376":70098,"_29549":70049,"_20523":118514,"_5":14087,"_26884":118396,"_2862":118515},[],"Si aparece un estado relacionado con vencimiento o renovación, comprueba las fechas del certificado y los umbrales del DMS en Dispositivos e identidades.",{"_3376":70099,"_29549":70049,"_20523":118517,"_5":14087,"_26884":118400,"_2862":118518},[],"Continúa con DMS y EST para que el dispositivo solicite y renueve sus certificados. Prepara la confianza del servidor, la credencial inicial y las políticas de cada operación antes de implementar el cliente.",{"_3376":70100,"_29549":70049,"_20523":118520,"_5":14087,"_26884":118400,"_2862":118521},[],"Para un recorrido desde el cliente hasta mTLS, sigue Enrola y conecta tu primer dispositivo con un ID nuevo.",{"_3376":70101,"_29549":70049,"_20523":118523,"_5":14087,"_26884":118400,"_2862":118524},[],"Para utilizar la identidad en AWS IoT Core, prepara también la confianza y los permisos del destino. Comprueba la conexión desde el dispositivo después de instalar la clave, el certificado y la cadena necesarios.",{"_3376":70102,"_29549":70102,"_5":14445,"_2862":118526,"_29881":118527,"_20523":118528,"_26884":70102},"Plataforma Lamassu IoT",[48111,114818],[],{"_3376":70103,"_29549":70102,"_20523":118530,"_5":14087,"_26884":70102,"_2862":118531},[],"Construye una PKI y aplica sus certificados al ciclo de vida de tus dispositivos.",{"_3376":70104,"_29549":70102,"_5":29878,"_20523":118533,"_26884":118534,"_2862":118026},[],"/docs/es/platform/overview#empieza-aquí",{"_3376":70105,"_29549":70102,"_5":29878,"_20523":118536,"_26884":118537,"_2862":118538},[],"/docs/es/platform/overview#elige-tu-recorrido","Elige tu recorrido",{"_3376":70106,"_29549":70102,"_5":29878,"_20523":118540,"_26884":118541,"_2862":118542},[],"/docs/es/platform/overview#arquitectura-de-un-vistazo","Arquitectura de un vistazo",{"_3376":70107,"_29549":70102,"_5":29878,"_20523":118544,"_26884":118545,"_2862":118546},[],"/docs/es/platform/overview#capacidades-principales","Capacidades principales",{"_3376":70108,"_29549":70102,"_5":29878,"_20523":118548,"_26884":118549,"_2862":118550},[],"/docs/es/platform/overview#construye-tu-jerarquía-de-confianza","Construye tu jerarquía de confianza",{"_3376":70109,"_29549":70102,"_5":29878,"_20523":118552,"_26884":118553,"_2862":118554},[],"/docs/es/platform/overview#protege-las-claves-criptográficas","Protege las claves criptográficas",{"_3376":70110,"_29549":70102,"_5":29878,"_20523":118556,"_26884":118557,"_2862":118558},[],"/docs/es/platform/overview#emite-y-controla-certificados","Emite y controla certificados",{"_3376":70111,"_29549":70102,"_5":29878,"_20523":118560,"_26884":118561,"_2862":118562},[],"/docs/es/platform/overview#automatiza-identidades-de-dispositivos","Automatiza identidades de dispositivos",{"_3376":70112,"_29549":70102,"_5":29878,"_20523":118564,"_26884":118565,"_2862":118566},[],"/docs/es/platform/overview#publica-el-estado-de-validación","Publica el estado de validación",{"_3376":70113,"_29549":70102,"_5":29878,"_20523":118568,"_26884":118569,"_2862":118570},[],"/docs/es/platform/overview#reacciona-a-los-eventos","Reacciona a los eventos",{"_3376":70114,"_29549":70102,"_5":29878,"_20523":118572,"_26884":118573,"_2862":118574},[],"/docs/es/platform/overview#referencia-operativa","Referencia operativa",{"_3376":70115,"_29549":70102,"_20523":118576,"_5":14087,"_26884":70102,"_2862":118577},[],"Lamassu IoT permite administrar una PKI privada y utilizarla para emitir, renovar y revocar identidades X.509 de dispositivos. La documentación de Plataforma sigue dos recorridos: **PKI**, para gestionar las autoridades y los certificados, e **IoT Fleets**, para aplicar esas identidades a una población de dispositivos.",{"_3376":70116,"_29549":70102,"_20523":118579,"_5":14087,"_26884":118534,"_2862":118580},[],"Elige el resultado que necesitas obtener:",{"_3376":70117,"_29549":70102,"_20523":118582,"_5":14087,"_26884":118534,"_2862":118583},[],"<Card title=\"Emitir y verificar un certificado\" description=\"Prepara una CA, emite una identidad X.509 y comprueba su cadena y su clave.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3376":70118,"_29549":70102,"_20523":118585,"_5":14087,"_26884":118534,"_2862":118586},[],"<Card title=\"Enrolar y conectar un dispositivo\" description=\"Prepara el DMS, solicita la identidad por EST y comprueba una conexión mTLS.\" href=\"/docs/platform/iot-fleets/quickstarts/enroll-device\" />",{"_3376":70119,"_29549":70102,"_20523":118588,"_5":14087,"_26884":118534,"_2862":118589},[],"Si todavía estás preparando la instancia, empieza en Despliegue. Los recorridos de Plataforma parten de una consola accesible y de permisos para realizar las operaciones.",{"_3376":70120,"_29549":70102,"_20523":118591,"_5":14087,"_26884":118537,"_2862":118592},[],"Bloque",{"_3376":70121,"_29549":70102,"_20523":118594,"_5":14087,"_26884":118537,"_2862":118595},[],"Qué gestionas",{"_3376":70122,"_29549":70102,"_20523":118597,"_5":14087,"_26884":118537,"_2862":118598},[],"Punto de entrada",{"_3376":70123,"_29549":70102,"_20523":118600,"_5":14087,"_26884":118537,"_2862":53487},[],{"_3376":70124,"_29549":70102,"_20523":118602,"_5":14087,"_26884":118537,"_2862":118603},[],"Claves, autoridades, perfiles, certificados y publicación del estado de revocación.",{"_3376":70125,"_29549":70102,"_20523":118605,"_5":14087,"_26884":118537,"_2862":118606},[],"Visión general de PKI",{"_3376":70126,"_29549":70102,"_20523":118608,"_5":14087,"_26884":118537,"_2862":53496},[],{"_3376":70127,"_29549":70102,"_20523":118610,"_5":14087,"_26884":118537,"_2862":118611},[],"Dispositivos, historial de identidad, políticas DMS, enrolamiento EST e integraciones.",{"_3376":70128,"_29549":70102,"_20523":118613,"_5":14087,"_26884":118537,"_2862":118614},[],"Visión general de IoT Fleets",{"_3376":70129,"_29549":70102,"_20523":118616,"_5":14087,"_26884":118537,"_2862":118617},[],"**Administración**",{"_3376":70130,"_29549":70102,"_20523":118619,"_5":14087,"_26884":118537,"_2862":118620},[],"Permisos de operadores, auditoría y suscripciones a eventos.",{"_3376":70131,"_29549":70102,"_20523":118622,"_5":14087,"_26884":118537,"_2862":114816},[],{"_3376":70132,"_29549":70102,"_20523":118624,"_5":14087,"_26884":118537,"_2862":118625},[],"Una CA determina quién firma y un perfil establece qué puede emitirse. El DMS aplica la política de admisión y enrolamiento. El dispositivo conserva la asociación con sus certificados, y el consumidor externo decide qué identidad acepta.",{"_3376":70133,"_29549":70102,"_20523":118627,"_5":14087,"_26884":118541,"_2862":118628},[],"El recorrido de una identidad conecta cuatro responsabilidades:",{"_3376":70134,"_29549":70102,"_20523":118630,"_5":14087,"_26884":118541,"_2862":118631},[],"El administrador PKI prepara la autoridad, su clave y las reglas de emisión.",{"_3376":70135,"_29549":70102,"_20523":118633,"_5":14087,"_26884":118541,"_2862":118634},[],"El administrador del aprovisionamiento configura el DMS y la confianza inicial.",{"_3376":70136,"_29549":70102,"_20523":118636,"_5":14087,"_26884":118541,"_2862":118637},[],"El cliente del dispositivo solicita un certificado y lo instala junto con la clave que le corresponde.",{"_3376":70137,"_29549":70102,"_20523":118639,"_5":14087,"_26884":118541,"_2862":118640},[],"El consumidor valida la identidad y aplica sus permisos de acceso.",{"_3376":70138,"_29549":70102,"_20523":118642,"_5":14087,"_26884":118541,"_2862":118643},[],"Consulta Cómo funciona Lamassu para entender los recursos y la arquitectura de la plataforma para conocer los servicios. La instalación, la exposición de red y las dependencias se explican en Despliegue.",{"_3376":70139,"_29549":70102,"_20523":118645,"_5":14087,"_26884":118549,"_2862":118646},[],"Crea o incorpora autoridades y organiza sus relaciones en PKI. La jerarquía y su rotación determinan qué cadenas deberán reconocer los consumidores.",{"_3376":70140,"_29549":70102,"_20523":118648,"_5":14087,"_26884":118553,"_2862":118649},[],"Elige el motor que custodiará las claves de las autoridades y controla quién puede utilizarlas. Consulta Claves y motores; la preparación del proveedor forma parte del despliegue.",{"_3376":70141,"_29549":70102,"_20523":118651,"_5":14087,"_26884":118557,"_2862":118652},[],"Define perfiles de emisión, firma solicitudes y consulta el inventario de certificados. El certificado emitido debe comprobarse desde el cliente que lo utilizará.",{"_3376":70142,"_29549":70102,"_20523":118654,"_5":14087,"_26884":118561,"_2862":118655},[],"Configura un DMS y utiliza EST para solicitar y renovar certificados. La preparación de la credencial inicial y la instalación del resultado pertenecen a la integración del dispositivo.",{"_3376":70143,"_29549":70102,"_20523":118657,"_5":14087,"_26884":118565,"_2862":118658},[],"Utiliza OCSP y CRL para publicar el estado de revocación. Cada consumidor debe configurar cómo consulta y aplica esa información.",{"_3376":70144,"_29549":70102,"_20523":118660,"_5":14087,"_26884":118569,"_2862":118661},[],"Consulta auditoría para investigar cambios y configura alertas y suscripciones para reaccionar a eventos del ciclo de vida.",{"_3376":70145,"_29549":70102,"_20523":118663,"_5":14087,"_26884":118573,"_2862":118119},[],{"_3376":70146,"_29549":70102,"_20523":118665,"_5":14087,"_26884":118573,"_2862":118666},[],"Qué prepara o comprueba",{"_3376":70147,"_29549":70102,"_20523":118668,"_5":14087,"_26884":118573,"_2862":118122},[],{"_3376":70148,"_29549":70102,"_20523":118670,"_5":14087,"_26884":118573,"_2862":118671},[],"Custodia de claves, jerarquía de CAs, perfiles y validación.",{"_3376":70149,"_29549":70102,"_20523":118673,"_5":14087,"_26884":118573,"_2862":118674},[],"Administrador de la flota",{"_3376":70150,"_29549":70102,"_20523":118676,"_5":14087,"_26884":118573,"_2862":118677},[],"DMS, admisión de dispositivos, política de renovación e inventario.",{"_3376":70151,"_29549":70102,"_20523":118679,"_5":14087,"_26884":118573,"_2862":118134},[],{"_3376":70152,"_29549":70102,"_20523":118681,"_5":14087,"_26884":118573,"_2862":118682},[],"Credencial inicial, confianza en el servidor, cliente EST y almacenamiento de clave y certificado.",{"_3376":70153,"_29549":70102,"_20523":118684,"_5":14087,"_26884":118573,"_2862":118140},[],{"_3376":70154,"_29549":70102,"_20523":118686,"_5":14087,"_26884":118573,"_2862":118687},[],"Confianza en los emisores, validación de certificados y permisos en el destino.",{"_3376":70155,"_29549":70102,"_20523":118689,"_5":14087,"_26884":118573,"_2862":118690},[],"Operador de infraestructura",{"_3376":70156,"_29549":70102,"_20523":118692,"_5":14087,"_26884":118573,"_2862":118693},[],"Instalación, red, disponibilidad, dependencias y diagnóstico de despliegue.",{"_3376":70157,"_29549":70102,"_20523":118695,"_5":14087,"_26884":118573,"_2862":118696},[],"La Referencia API recoge los contratos para automatizar las operaciones. Para resolver un fallo, empieza en el bloque afectado: PKI, EST o Despliegue.",{"_3376":70158,"_29549":70158,"_5":14445,"_2862":118698,"_29881":118699,"_20523":118701,"_26884":70158},"Jerarquía y rotación de CAs",[48111,114818,53588,118700],"Claves, autoridades y certificados",[],{"_3376":70159,"_29549":70158,"_20523":118703,"_5":14087,"_26884":70158,"_2862":118704},[],"Diseña autoridades raíz e intermedias y sustituye certificados o claves sin romper la confianza.",{"_3376":70160,"_29549":70158,"_5":29878,"_20523":118706,"_26884":118707,"_2862":118708},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#diseña-la-jerarquía","Diseña la jerarquía",{"_3376":70161,"_29549":70158,"_5":29878,"_20523":118710,"_26884":118711,"_2862":118712},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#reemisión-y-rotación-no-son-lo-mismo","Reemisión y rotación no son lo mismo",{"_3376":70162,"_29549":70158,"_5":29878,"_20523":118714,"_26884":118715,"_2862":118716},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cuándo-elegir-cada-operación","Cuándo elegir cada operación",{"_3376":70163,"_29549":70158,"_5":29878,"_20523":118718,"_26884":118719,"_2862":118720},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#procedimiento-de-rotación-de-clave","Procedimiento de rotación de clave",{"_3376":70164,"_29549":70158,"_5":29878,"_20523":118722,"_26884":118723,"_2862":118724},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#inventaría-las-dependencias","Inventaría las dependencias",{"_3376":70165,"_29549":70158,"_5":29878,"_20523":118726,"_26884":118727,"_2862":118728},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#crea-la-ca-sucesora","Crea la CA sucesora",{"_3376":70166,"_29549":70158,"_5":29878,"_20523":118730,"_26884":118731,"_2862":118732},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#distribuye-la-nueva-confianza","Distribuye la nueva confianza",{"_3376":70167,"_29549":70158,"_5":29878,"_20523":118734,"_26884":118735,"_2862":118736},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cambia-la-emisión","Cambia la emisión",{"_3376":70168,"_29549":70158,"_5":29878,"_20523":118738,"_26884":118739,"_2862":118740},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#renueva-por-lotes","Renueva por lotes",{"_3376":70169,"_29549":70158,"_5":29878,"_20523":118742,"_26884":118743,"_2862":118744},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#cierra-el-solapamiento","Cierra el solapamiento",{"_3376":70170,"_29549":70158,"_5":29878,"_20523":118746,"_26884":118747,"_2862":118748},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#revocación-en-cascada","Revocación en cascada",{"_3376":70171,"_29549":70158,"_5":29878,"_20523":118750,"_26884":118751,"_2862":118752},[],"/docs/es/platform/pki/ca-hierarchy-and-rotation#comprobaciones-después-del-cambio","Comprobaciones después del cambio",{"_3376":70172,"_29549":70158,"_20523":118754,"_5":14087,"_26884":70158,"_2862":118755},[],"La jerarquía determina el alcance de cualquier error o compromiso. Una raíz firma CAs intermedias; las intermedias emiten las identidades que usan dispositivos y servicios. Esta separación permite aislar entornos y rotar una rama sin reemplazar toda la confianza.",{"_3376":70173,"_29549":70158,"_20523":118757,"_5":14087,"_26884":70158,"_2862":118758},[],"Este procedimiento se dirige al operador PKI que sustituye una autoridad en uso. Necesitas acceso a las CAs, claves y perfiles, un inventario de dependencias y coordinación con quienes gestionan los almacenes de confianza y dispositivos. Antes de cambiar la emisión, prepara una cohorte de prueba y decide el criterio para cerrar el solapamiento.",{"_3376":70174,"_29549":70158,"_20523":118760,"_5":14087,"_26884":118707,"_2862":118761},[],"Para una instalación de producción, utiliza una raíz muy restringida y una o más intermedias operativas. Separa intermedias cuando cambie alguno de estos límites:",{"_3376":70175,"_29549":70158,"_20523":118763,"_5":14087,"_26884":118707,"_2862":118764},[],"entorno, como producción y preproducción;",{"_3376":70176,"_29549":70158,"_20523":118766,"_5":14087,"_26884":118707,"_2862":118767},[],"propietario o equipo operador;",{"_3376":70177,"_29549":70158,"_20523":118769,"_5":14087,"_26884":118707,"_2862":118770},[],"familia de dispositivos o proceso de fabricación;",{"_3376":70178,"_29549":70158,"_20523":118772,"_5":14087,"_26884":118707,"_2862":118773},[],"región o requisito regulatorio;",{"_3376":70179,"_29549":70158,"_20523":118775,"_5":14087,"_26884":118707,"_2862":118776},[],"motor criptográfico o política de clave;",{"_3376":70180,"_29549":70158,"_20523":118778,"_5":14087,"_26884":118707,"_2862":118779},[],"ventana de mantenimiento y ritmo de renovación.",{"_3376":70181,"_29549":70158,"_20523":118781,"_5":14087,"_26884":118707,"_2862":118782},[],"Evita jerarquías profundas sin una necesidad concreta. Cada nivel añade distribución de cadena, validación y otro certificado que debes renovar.",{"_3376":70182,"_29549":70158,"_20523":118784,"_5":14087,"_26884":118707,"_2862":118785},[],"Una CA hija y los certificados finales deben expirar antes que su emisor. Reserva un margen que permita distribuir otra cadena y renovar los certificados dependientes.",{"_3376":70183,"_29549":70158,"_20523":118787,"_5":14087,"_26884":118711,"_2862":118788},[],"**Reemitir una CA** crea un certificado nuevo sobre la clave existente. Lamassu genera una CSR con esa clave, autofirma si es una raíz o pide a la CA padre que firme si es subordinada. El nuevo certificado queda activo y la CA apunta a su número de serie; los certificados anterior y nuevo quedan enlazados mediante metadatos.",{"_3376":70184,"_29549":70158,"_20523":118790,"_5":14087,"_26884":118711,"_2862":118791},[],"**Rotar una CA** crea una clave y una autoridad sucesoras. Es la opción adecuada ante compromiso, cambio criptográfico, migración de motor o política de claves no exportables.",{"_3376":70185,"_29549":70158,"_20523":118793,"_5":14087,"_26884":118711,"_2862":118794},[],"Lamassu no permite reemitir una CA ya revocada ni una CA cuya fecha de expiración haya pasado. Anticípate a ambas condiciones.",{"_3376":70186,"_29549":70158,"_20523":118796,"_5":14087,"_26884":118715,"_2862":118797},[],"Reemite si la clave sigue siendo confiable y solo necesitas otro periodo de validez o un certificado actualizado.",{"_3376":70187,"_29549":70158,"_20523":118799,"_5":14087,"_26884":118715,"_2862":118800},[],"Rota la clave si existe sospecha de compromiso, cambia el algoritmo o quieres mover la custodia a otro motor.",{"_3376":70188,"_29549":70158,"_20523":118802,"_5":14087,"_26884":118715,"_2862":118803},[],"Crea una rama paralela si no puedes actualizar todos los consumidores al mismo tiempo.",{"_3376":70189,"_29549":70158,"_20523":118805,"_5":14087,"_26884":118715,"_2862":118806},[],"Revoca inmediatamente solo cuando el riesgo de mantener la CA supera el impacto de interrumpir la flota.",{"_3376":70190,"_29549":70158,"_20523":118808,"_5":14087,"_26884":118723,"_2862":118809},[],"Localiza CAs hijas, certificados emitidos, DMS, conectores y almacenes de confianza externos. Incluye dispositivos que pueden permanecer desconectados durante semanas o meses.",{"_3376":70191,"_29549":70158,"_20523":118811,"_5":14087,"_26884":118727,"_2862":118812},[],"Genera una clave nueva en el motor previsto, crea la CA y asígnale un perfil explícito. No reutilices el identificador operativo para ocultar que es una generación distinta.",{"_3376":70192,"_29549":70158,"_20523":118814,"_5":14087,"_26884":118731,"_2862":118815},[],"Añade la nueva raíz o cadena a los consumidores antes de emitir con ella. Si distribuyes mediante EST `/cacerts`, incluye explícitamente las CAs gestionadas necesarias y comprueba el contenido; no presupongas que incluir la CA emisora añade todas sus intermedias. Instala la nueva confianza en una cohorte y verifica que también sigue aceptando la identidad anterior.",{"_3376":70193,"_29549":70158,"_20523":118817,"_5":14087,"_26884":118735,"_2862":118818},[],"Actualiza la CA de enrolamiento y el perfil de los DMS. Mientras sigan renovando cohortes con certificados antiguos, añade la CA de enrolamiento anterior a las CAs de validación de re-enrolamiento (`reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`) de cada DMS: la nueva CA de enrolamiento se considera confiable automáticamente, pero la antigua era la CA de enrolamiento y no figura en ninguna lista de confianza de re-enrolamiento, así que sin esa entrada sus certificados ya no podrán renovarse. La guía DMS documenta ese ajuste.",{"_3376":70194,"_29549":70158,"_20523":118820,"_5":14087,"_26884":118739,"_2862":118821},[],"Migra una cohorte pequeña, valida mTLS, OCSP y CRL desde el consumidor y amplía progresivamente. Supervisa qué dispositivos siguen presentando la cadena antigua.",{"_3376":70195,"_29549":70158,"_20523":118823,"_5":14087,"_26884":118743,"_2862":118824},[],"Cuando ningún consumidor legítimo dependa de la autoridad anterior, retírala de la emisión, de las CAs de validación de re-enrolamiento y de las CAs distribuidas. Revócala si la política lo exige.",{"_3376":70196,"_29549":70158,"_20523":118826,"_5":14087,"_26884":118747,"_2862":118827},[],"Lamassu guarda la revocación de la CA y después intenta revocar sus CAs hijas y certificados emitidos con `CessationOfOperation`. La propagación continúa recursivamente por las hijas. No es una transacción sobre toda la jerarquía: puede haber recursos ya modificados y otros cuya actualización haya fallado.",{"_3376":70197,"_29549":70158,"_20523":118829,"_5":14087,"_26884":118747,"_2862":118830},[],"Los recursos en estado `EXPIRED` y los ya revocados por una razón definitiva no admiten otra transición de estado. Los errores por descendiente se registran; revisa el inventario y los registros aunque la operación sobre el padre haya terminado.",{"_3376":70198,"_29549":70158,"_20523":118832,"_5":14087,"_26884":118747,"_2862":118833},[],"`CertificateHold` permite reactivar el padre mientras no esté expirado, pero no restaura las hijas ni los certificados revocados definitivamente durante la cascada. Por eso suspender una CA tampoco sirve como pausa reversible de toda la rama.",{"_3376":70199,"_29549":70158,"_20523":118835,"_5":14087,"_26884":118747,"_2862":118836},[],"Antes de cerrar el cambio, contrasta el listado de dependencias inicial con los estados finales y verifica la publicación de revocación en cada emisor. No utilices la revocación como mecanismo ordinario para dejar de emitir: completa la migración y retira la CA de los flujos operativos.",{"_3376":70200,"_29549":70158,"_20523":118838,"_5":14087,"_26884":118751,"_2862":118839},[],"La cadena nueva termina en un ancla instalada por el consumidor.",{"_3376":70201,"_29549":70158,"_20523":118841,"_5":14087,"_26884":118751,"_2862":118842},[],"Los certificados nuevos contienen AKI, SKI, KU, EKU y SAN esperados.",{"_3376":70202,"_29549":70158,"_20523":118844,"_5":14087,"_26884":118751,"_2862":118845},[],"El DMS entrega la cadena correcta mediante EST `/cacerts`.",{"_3376":70203,"_29549":70158,"_20523":118847,"_5":14087,"_26884":118751,"_2862":118848},[],"El re-enrolamiento acepta la identidad antigua durante el periodo previsto.",{"_3376":70204,"_29549":70158,"_20523":118850,"_5":14087,"_26884":118751,"_2862":118851},[],"OCSP y CRL responden para las autoridades que siguen activas.",{"_3376":70205,"_29549":70158,"_20523":118853,"_5":14087,"_26884":118751,"_2862":118854},[],"No quedan DMS emitiendo accidentalmente desde la CA anterior.",{"_3376":70206,"_29549":70158,"_20523":118856,"_5":14087,"_26884":118751,"_2862":118857},[],"Consulta el Modelo de confianza para entender los conjuntos de CAs del DMS y Ciclo de vida de un certificado para los estados y efectos de revocación.",{"_3376":70207,"_29549":70207,"_5":14445,"_2862":118859,"_29881":118860,"_20523":118861,"_26884":70207},"Autoridades de certificación",[48111,114818,53588,118700],[],{"_3376":70208,"_29549":70207,"_20523":118863,"_5":14087,"_26884":70207,"_2862":118864},[],"Crea, importa y opera las autoridades que establecen la confianza de tu PKI.",{"_3376":70209,"_29549":70207,"_5":29878,"_20523":118866,"_26884":118867,"_2862":118868},[],"/docs/es/platform/pki/certificate-authorities#elige-un-flujo","Elige un flujo",{"_3376":70210,"_29549":70207,"_5":29878,"_20523":118870,"_26884":118871,"_2862":118872},[],"/docs/es/platform/pki/certificate-authorities#crea-una-autoridad-nueva","Crea una autoridad nueva",{"_3376":70211,"_29549":70207,"_5":29878,"_20523":118874,"_26884":118875,"_2862":113396},[],"/docs/es/platform/pki/certificate-authorities#antes-de-empezar",{"_3376":70212,"_29549":70207,"_5":29878,"_20523":118877,"_26884":118878,"_2862":118879},[],"/docs/es/platform/pki/certificate-authorities#abre-el-asistente","Abre el asistente",{"_3376":70213,"_29549":70207,"_5":29878,"_20523":118881,"_26884":118882,"_2862":118883},[],"/docs/es/platform/pki/certificate-authorities#configura-la-clave","Configura la clave",{"_3376":70214,"_29549":70207,"_5":29878,"_20523":118885,"_26884":118886,"_2862":118887},[],"/docs/es/platform/pki/certificate-authorities#elige-el-tipo-de-ca","Elige el tipo de CA",{"_3376":70215,"_29549":70207,"_5":29878,"_20523":118889,"_26884":118890,"_2862":118891},[],"/docs/es/platform/pki/certificate-authorities#define-la-identidad","Define la identidad",{"_3376":70216,"_29549":70207,"_5":29878,"_20523":118893,"_26884":118894,"_2862":118895},[],"/docs/es/platform/pki/certificate-authorities#configura-validez-y-usos","Configura validez y usos",{"_3376":70217,"_29549":70207,"_5":29878,"_20523":118897,"_26884":118898,"_2862":118899},[],"/docs/es/platform/pki/certificate-authorities#crea-y-verifica","Crea y verifica",{"_3376":70218,"_29549":70207,"_5":29878,"_20523":118901,"_26884":118902,"_2862":118903},[],"/docs/es/platform/pki/certificate-authorities#utiliza-una-clave-del-kms","Utiliza una clave del KMS",{"_3376":70219,"_29549":70207,"_5":29878,"_20523":118905,"_26884":118906,"_2862":118907},[],"/docs/es/platform/pki/certificate-authorities#importa-una-ca-externa","Importa una CA externa",{"_3376":70220,"_29549":70207,"_5":29878,"_20523":118909,"_26884":118910,"_2862":118911},[],"/docs/es/platform/pki/certificate-authorities#selecciona-el-motor","Selecciona el motor",{"_3376":70221,"_29549":70207,"_5":29878,"_20523":118913,"_26884":118914,"_2862":118915},[],"/docs/es/platform/pki/certificate-authorities#carga-el-material","Carga el material",{"_3376":70222,"_29549":70207,"_5":29878,"_20523":118917,"_26884":118918,"_2862":118919},[],"/docs/es/platform/pki/certificate-authorities#define-la-emisión-predeterminada","Define la emisión predeterminada",{"_3376":70223,"_29549":70207,"_5":29878,"_20523":118921,"_26884":118922,"_2862":118923},[],"/docs/es/platform/pki/certificate-authorities#verifica-la-importación","Verifica la importación",{"_3376":70224,"_29549":70207,"_5":29878,"_20523":118925,"_26884":118926,"_2862":118927},[],"/docs/es/platform/pki/certificate-authorities#inspecciona-una-autoridad","Inspecciona una autoridad",{"_3376":70225,"_29549":70207,"_5":29878,"_20523":118929,"_26884":118930,"_2862":118931},[],"/docs/es/platform/pki/certificate-authorities#emite-certificados","Emite certificados",{"_3376":70226,"_29549":70207,"_5":29878,"_20523":118933,"_26884":118934,"_2862":118935},[],"/docs/es/platform/pki/certificate-authorities#revoca-una-ca","Revoca una CA",{"_3376":70227,"_29549":70207,"_5":29878,"_20523":118937,"_26884":118938,"_2862":118939},[],"/docs/es/platform/pki/certificate-authorities#evalúa-el-impacto","Evalúa el impacto",{"_3376":70228,"_29549":70207,"_5":29878,"_20523":118941,"_26884":118942,"_2862":118943},[],"/docs/es/platform/pki/certificate-authorities#inicia-la-revocación","Inicia la revocación",{"_3376":70229,"_29549":70207,"_5":29878,"_20523":118945,"_26884":118946,"_2862":118947},[],"/docs/es/platform/pki/certificate-authorities#confirma-la-identidad","Confirma la identidad",{"_3376":70230,"_29549":70207,"_5":29878,"_20523":118949,"_26884":118950,"_2862":118951},[],"/docs/es/platform/pki/certificate-authorities#comprueba-la-publicación","Comprueba la publicación",{"_3376":70231,"_29549":70207,"_5":29878,"_20523":118953,"_26884":118954,"_2862":118955},[],"/docs/es/platform/pki/certificate-authorities#elimina-una-ca","Elimina una CA",{"_3376":70232,"_29549":70207,"_20523":118957,"_5":14087,"_26884":70207,"_2862":118958},[],"Una autoridad de certificación (CA) vincula identidades con claves públicas mediante certificados firmados. En Lamassu puedes crear una jerarquía nueva, utilizar una clave que ya está en el KMS o incorporar una CA externa.",{"_3376":70233,"_29549":70207,"_20523":118960,"_5":14087,"_26884":70207,"_2862":118961},[],"Para diseñar una cadena completa o sustituir una autoridad en producción, consulta Jerarquía y rotación de CAs. Si necesitas estandarizar qué puede firmar cada autoridad, utiliza Perfiles de certificado.",{"_3376":70234,"_29549":70207,"_20523":118963,"_5":14087,"_26884":70207,"_2862":118964},[],"Para administrar CAs necesitas permisos sobre las autoridades y las claves, un motor accesible y un perfil revisado. La CA de un consumidor externo no queda confiada por aparecer en este inventario: acuerda por separado la distribución de su raíz y cadena.",{"_3376":70235,"_29549":70207,"_20523":118966,"_5":14087,"_26884":118867,"_2862":118967},[],"**Nueva CA y nueva clave:** crea una raíz de confianza desde cero. Lamassu genera y custodia el par de claves.",{"_3376":70236,"_29549":70207,"_20523":118969,"_5":14087,"_26884":118867,"_2862":118970},[],"**Nueva CA desde KMS:** reutiliza una clave que ya está registrada en la plataforma.",{"_3376":70237,"_29549":70207,"_20523":118972,"_5":14087,"_26884":118867,"_2862":118973},[],"**Importar CA con clave privada:** incorpora una autoridad externa con la que Lamassu podrá emitir.",{"_3376":70238,"_29549":70207,"_20523":118975,"_5":14087,"_26884":118867,"_2862":118976},[],"**Importar solo el certificado:** registra material público. Si Lamassu encuentra su clave en el KMS, puede asociarla; si no la encuentra, la CA queda sin clave utilizable para emitir.",{"_3376":70239,"_29549":70207,"_20523":118978,"_5":14087,"_26884":118867,"_2862":118979},[],"¿Es tu primera vez? Sigue Crea tu primera CA para completar el recorrido mínimo.",{"_3376":70240,"_29549":70207,"_20523":118981,"_5":14087,"_26884":118875,"_2862":118982},[],"Decide si la CA será raíz o intermedia.",{"_3376":70241,"_29549":70207,"_20523":118984,"_5":14087,"_26884":118875,"_2862":118985},[],"Elige el motor que custodiará la clave.",{"_3376":70242,"_29549":70207,"_20523":118987,"_5":14087,"_26884":118875,"_2862":118988},[],"Define una validez superior a la de los certificados que emitirá.",{"_3376":70243,"_29549":70207,"_20523":118990,"_5":14087,"_26884":118875,"_2862":118991},[],"Para una CA intermedia, asegúrate de que la CA padre esté activa.",{"_3376":70244,"_29549":70207,"_20523":118993,"_5":14087,"_26884":118878,"_2862":118994},[],"En **Certification Authorities**, selecciona **Create New CA** y elige generar un par de claves nuevo.",{"_3376":70245,"_29549":70207,"_20523":118996,"_5":14087,"_26884":118882,"_2862":118997},[],"Selecciona el motor criptográfico, el algoritmo y el tamaño o curva. Lamassu admite claves RSA y EC según las capacidades del motor.",{"_3376":70246,"_29549":70207,"_20523":118999,"_5":14087,"_26884":118882,"_2862":119000},[],"Utiliza únicamente tamaños y curvas admitidos por el motor y por la política criptográfica del perfil. Consulta Claves y motores antes de reutilizar material externo.",{"_3376":70247,"_29549":70207,"_20523":119002,"_5":14087,"_26884":118886,"_2862":119003},[],"Selecciona **Root CA** para una autoridad autofirmada o **Intermediate CA** para una autoridad firmada por otra CA. En el segundo caso, elige la CA emisora.",{"_3376":70248,"_29549":70207,"_20523":119005,"_5":14087,"_26884":118890,"_2862":119006},[],"Introduce un **CA Name** único. Este nombre se convierte en el `Common Name` del certificado. Completa los campos del Distinguished Name que necesite tu política:",{"_3376":70249,"_29549":70207,"_20523":119008,"_5":14087,"_26884":118890,"_2862":119009},[],"`C`: código de país ISO 3166-1 de dos letras.",{"_3376":70250,"_29549":70207,"_20523":119011,"_5":14087,"_26884":118890,"_2862":119012},[],"`ST`: estado o provincia.",{"_3376":70251,"_29549":70207,"_20523":119014,"_5":14087,"_26884":118890,"_2862":119015},[],"`L`: localidad.",{"_3376":70252,"_29549":70207,"_20523":119017,"_5":14087,"_26884":118890,"_2862":119018},[],"`O`: organización.",{"_3376":70253,"_29549":70207,"_20523":119020,"_5":14087,"_26884":118890,"_2862":119021},[],"`OU`: unidad organizativa.",{"_3376":70254,"_29549":70207,"_20523":119023,"_5":14087,"_26884":118890,"_2862":119024},[],"El identificador interno de la CA se genera automáticamente y no se puede modificar.",{"_3376":70255,"_29549":70207,"_20523":119026,"_5":14087,"_26884":118894,"_2862":119027},[],"Define **CA Certificate Expiration** y **Default End-Entity Certificate Issuance Expiration**. Puedes expresar una duración (`5y 8w 4d`), seleccionar una fecha o utilizar la fecha máxima permitida.",{"_3376":70256,"_29549":70207,"_20523":119029,"_5":14087,"_26884":118894,"_2862":119030},[],"Revisa por separado el certificado de la propia CA y el perfil predeterminado para lo que emitirá después. Elige una política explícita de emisión; no confíes en que los valores iniciales del formulario sean adecuados para tus consumidores.",{"_3376":70257,"_29549":70207,"_20523":119032,"_5":14087,"_26884":118898,"_2862":119033},[],"Confirma el formulario y abre la CA. Comprueba estado, emisor, fechas, motor y clave asociados. Descarga el certificado: debe tener `CA:TRUE` y un uso que permita firmar certificados. Verifica la autofirma para una raíz o la cadena hasta tu raíz para una intermedia. Completa una emisión de prueba para comprobar que la clave realmente puede firmar.",{"_3376":70258,"_29549":70207,"_20523":119035,"_5":14087,"_26884":118898,"_2862":119036},[],"Planifica y verifica los vencimientos con las reglas de Perfiles. La emisión no recorta automáticamente la validez al vencimiento del emisor; deja margen para sustituir la autoridad y renovar las identidades.",{"_3376":70259,"_29549":70207,"_20523":119038,"_5":14087,"_26884":118902,"_2862":119039},[],"Selecciona &#x2A;*Create New CA (Existing Key)** cuando la clave ya esté registrada en Lamassu. El asistente pide primero la clave de soporte y después muestra la misma configuración de tipo, identidad, validez y perfil.",{"_3376":70260,"_29549":70207,"_20523":119041,"_5":14087,"_26884":118902,"_2862":119042},[],"Este flujo resulta útil cuando la clave se creó previamente en un HSM, se importó mediante BYOK o debe reutilizarse con una política de custodia concreta.",{"_3376":70261,"_29549":70207,"_20523":119044,"_5":14087,"_26884":118906,"_2862":119045},[],"Necesitas el certificado de CA en PEM, su cadena hasta una raíz conocida y, si vas a importarla, una clave privada exportable. Antes de cargar el material, verifica firma, fechas, `CA:TRUE`, usos de firma (incluido `cRLSign`, sin el cual la CA no puede publicar su CRL) y correspondencia de la clave pública. El procedimiento de verificación de claves también sirve para comparar la clave y el certificado de una CA.",{"_3376":70262,"_29549":70207,"_20523":119047,"_5":14087,"_26884":118906,"_2862":119048},[],"El backend rechaza una importación cuyo certificado carece de la restricción básica de CA (`basicConstraints cA flag is not set`), cuyo número de serie coincide con el de un certificado almacenado con contenido distinto, o cuyo certificado idéntico ya pertenece a una CA existente. El registro de certificado de una CA eliminada se conserva y puede reutilizarse al reimportar el mismo certificado, incluido su estado anterior. Reimportar otro certificado con ese número de serie se rechaza; comprueba el certificado y su estado tras reimportarlo.",{"_3376":70263,"_29549":70207,"_20523":119050,"_5":14087,"_26884":118906,"_2862":119051},[],"Eliminar una CA libera las referencias a la clave de su propio certificado actual y de sus certificados reemitidos vinculados, pero conserva esos registros para la CRL y el OCSP de su emisor. Después intenta eliminar la clave; el KMS la conserva si otros certificados todavía la referencian, como los de otra CA que comparte la clave. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves.",{"_3376":70264,"_29549":70207,"_20523":119053,"_5":14087,"_26884":118910,"_2862":119054},[],"Comprueba el motor predeterminado de la instalación antes de importar una CA con clave. La operación de importación de CA delega la importación de la clave en ese motor; no garantiza selección de cualquier proveedor desde el formulario. Para seleccionar un motor al importar la clave por separado, utiliza el KMS.",{"_3376":70265,"_29549":70207,"_20523":119056,"_5":14087,"_26884":118914,"_2862":119057},[],"Importa el certificado y, cuando corresponda, su clave PEM. Registra las CAs de la cadena necesarias para identificar al emisor. Tener una CA en el inventario no la instala en los almacenes de confianza externos.",{"_3376":70266,"_29549":70207,"_20523":119059,"_5":14087,"_26884":118918,"_2862":119060},[],"Asocia un perfil de emisión explícito si la CA va a firmar. Comprueba sus usos y fechas según Perfiles.",{"_3376":70267,"_29549":70207,"_20523":119062,"_5":14087,"_26884":118922,"_2862":119063},[],"Revisa el tipo registrado, la clave y el motor asociados y la relación con el emisor. Una importación sin clave puede asociarse a una clave ya existente en KMS mediante el identificador de clave del certificado. Si no existe una clave utilizable, la CA sirve como material público pero no puede firmar.",{"_3376":70268,"_29549":70207,"_20523":119065,"_5":14087,"_26884":118922,"_2862":119066},[],"Para una CA emisora, completa una emisión de prueba y comprueba OCSP y CRL. El alta del registro por sí sola no demuestra disponibilidad de la clave, coherencia completa de la cadena ni publicación del estado.",{"_3376":70269,"_29549":70207,"_20523":119068,"_5":14087,"_26884":118926,"_2862":119069},[],"Abre una CA desde el inventario para consultar:",{"_3376":70270,"_29549":70207,"_20523":119071,"_5":14087,"_26884":118926,"_2862":119072},[],"Estado y periodo de validez.",{"_3376":70271,"_29549":70207,"_20523":119074,"_5":14087,"_26884":118926,"_2862":119075},[],"Certificado y cadena en formato PEM.",{"_3376":70272,"_29549":70207,"_20523":119077,"_5":14087,"_26884":118926,"_2862":119078},[],"Número de certificados activos, expirados y revocados.",{"_3376":70273,"_29549":70207,"_20523":119080,"_5":14087,"_26884":118926,"_2862":119081},[],"Certificados emitidos en **Issued Certificates**.",{"_3376":70274,"_29549":70207,"_20523":119083,"_5":14087,"_26884":118926,"_2862":119084},[],"CRL vinculada a la autoridad.",{"_3376":70275,"_29549":70207,"_20523":119086,"_5":14087,"_26884":118926,"_2862":119087},[],"Metadatos y motor criptográfico asociado.",{"_3376":70276,"_29549":70207,"_20523":119089,"_5":14087,"_26884":118926,"_2862":119090},[],"Puedes filtrar el inventario por nombre, estado y tipo de CA.",{"_3376":70277,"_29549":70207,"_20523":119092,"_5":14087,"_26884":118930,"_2862":119093},[],"Puedes iniciar una emisión desde **Issued Certificates**, desde la acción de una CA o desde el inventario global de certificados.",{"_3376":70278,"_29549":70207,"_20523":119095,"_5":14087,"_26884":118930,"_2862":119096},[],"**Generate Key & CSR in Browser** resulta útil para una operación manual o una prueba rápida. El navegador genera la clave y debes descargarla al finalizar.",{"_3376":70279,"_29549":70207,"_20523":119098,"_5":14087,"_26884":118930,"_2862":119099},[],"**Upload Existing CSR** es la opción adecuada cuando la clave debe permanecer en el sistema de destino. Lamassu recibe la solicitud, pero nunca la clave privada.",{"_3376":70280,"_29549":70207,"_20523":119101,"_5":14087,"_26884":118930,"_2862":119102},[],"Sigue Emite tu primer certificado para el flujo guiado. La gestión de certificados explica el inventario, la inspección y la revocación.",{"_3376":70281,"_29549":70207,"_20523":119104,"_5":14087,"_26884":118934,"_2862":119105},[],"Revocar una CA impide que emita y puede interrumpir toda su rama. Solo `CertificateHold` permite reactivar la propia CA si no está expirada. Sus descendientes se intentan revocar con `CessationOfOperation`; reactivar el padre no restaura esos descendientes. Sigue las condiciones de revocación en cascada.",{"_3376":70282,"_29549":70207,"_20523":119107,"_5":14087,"_26884":118938,"_2862":119108},[],"Identifica los certificados, dispositivos y consumidores que dependen de la CA. Prepara una autoridad y una cadena de sustitución cuando sea necesario.",{"_3376":70283,"_29549":70207,"_20523":119110,"_5":14087,"_26884":118942,"_2862":119111},[],"Abre la autoridad y selecciona **Revoke CA**. Elige la razón que describa el incidente, por ejemplo `KeyCompromise`, `CACompromise`, `Superseded` o `CessationOfOperation`.",{"_3376":70284,"_29549":70207,"_20523":119113,"_5":14087,"_26884":118946,"_2862":119114},[],"Escribe exactamente el nombre de la CA para habilitar **Confirm Revocation**.",{"_3376":70285,"_29549":70207,"_20523":119116,"_5":14087,"_26884":118950,"_2862":119117},[],"Comprueba **REVOKED** en la CA y revisa los descendientes uno a uno; la propagación admite fallos parciales. Verifica por separado la publicación de OCSP y CRL y el rechazo por los consumidores. Un registro revocado no garantiza que una sesión existente se cierre.",{"_3376":70286,"_29549":70207,"_20523":119119,"_5":14087,"_26884":118954,"_2862":119120},[],"La eliminación permanente solo está disponible con la CA revocada o caducada; una CA importada sin clave puede eliminarse en cualquier estado. Elimina el registro únicamente cuando la política de retención y auditoría lo permita.",{"_3376":70287,"_29549":70207,"_20523":119122,"_5":14087,"_26884":118954,"_2862":119123},[],"El rol VA de la CA se conserva. Si no queda otra CA con el mismo SKI, deja de ser editable (consulta CRL), así que ajusta antes su validez y su firmante. La clave de la CA se libera, pero el KMS la conserva mientras otros certificados la referencien.",{"_3376":70288,"_29549":70207,"_20523":119125,"_5":14087,"_26884":118954,"_2862":119126},[],"Lamassu conserva el registro del certificado de una CA eliminada. Si se importa de nuevo ese mismo certificado, la importación termina bien y reutiliza el registro: actualiza el tipo, el emisor y la clave, pero conserva el estado, así que la CA reaparece con el que tenía al eliminarse (normalmente revocada o caducada). Un certificado distinto con el mismo número de serie se rechaza con error 400, y un certificado que ya pertenece a una CA existente, con error 409. Para no heredar el estado anterior, usa un certificado con otro número de serie y comprueba el resultado tras importar. Si el certificado nuevo usa la misma clave, comparte el SKI con el rol VA retenido de la CA eliminada, cuyo firmante es el certificado antiguo: comprueba que la CRL se genera y, si no es así, asigna con `PUT` un firmante de la CA nueva (consulta CRL).",{"_3376":70289,"_29549":70289,"_5":14445,"_2862":119128,"_29881":119129,"_20523":119130,"_26884":70289},"Perfiles de certificado",[48111,114818,53588,118700],[],{"_3376":70290,"_29549":70289,"_20523":119132,"_5":14087,"_26884":70289,"_2862":119133},[],"Define políticas reutilizables para emitir certificados coherentes y limitar las claves aceptadas.",{"_3376":70291,"_29549":70289,"_5":29878,"_20523":119135,"_26884":119136,"_2862":119137},[],"/docs/es/platform/pki/certificate-profiles#qué-controla-un-perfil","Qué controla un perfil",{"_3376":70292,"_29549":70289,"_5":29878,"_20523":119139,"_26884":119140,"_2862":119141},[],"/docs/es/platform/pki/certificate-profiles#validez","Validez",{"_3376":70293,"_29549":70289,"_5":29878,"_20523":119143,"_26884":119144,"_2862":119145},[],"/docs/es/platform/pki/certificate-profiles#certificado-de-ca-o-certificado-final","Certificado de CA o certificado final",{"_3376":70294,"_29549":70289,"_5":29878,"_20523":119147,"_26884":119148,"_2862":119149},[],"/docs/es/platform/pki/certificate-profiles#key-usage-y-extended-key-usage","Key Usage y Extended Key Usage",{"_3376":70295,"_29549":70289,"_5":29878,"_20523":119151,"_26884":119152,"_2862":119153},[],"/docs/es/platform/pki/certificate-profiles#sujeto","Sujeto",{"_3376":70296,"_29549":70289,"_5":29878,"_20523":119155,"_26884":119156,"_2862":119157},[],"/docs/es/platform/pki/certificate-profiles#extensiones-de-la-csr","Extensiones de la CSR",{"_3376":70297,"_29549":70289,"_5":29878,"_20523":119159,"_26884":119160,"_2862":119161},[],"/docs/es/platform/pki/certificate-profiles#restricciones-criptográficas","Restricciones criptográficas",{"_3376":70298,"_29549":70289,"_5":29878,"_20523":119163,"_26884":119164,"_2862":119165},[],"/docs/es/platform/pki/certificate-profiles#precedencia-del-perfil","Precedencia del perfil",{"_3376":70299,"_29549":70289,"_5":29878,"_20523":119167,"_26884":119168,"_2862":119169},[],"/docs/es/platform/pki/certificate-profiles#crea-un-perfil","Crea un perfil",{"_3376":70300,"_29549":70289,"_5":29878,"_20523":119171,"_26884":119172,"_2862":119173},[],"/docs/es/platform/pki/certificate-profiles#define-un-único-propósito","Define un único propósito",{"_3376":70301,"_29549":70289,"_5":29878,"_20523":119175,"_26884":119176,"_2862":119177},[],"/docs/es/platform/pki/certificate-profiles#elige-la-validez","Elige la validez",{"_3376":70302,"_29549":70289,"_5":29878,"_20523":119179,"_26884":119180,"_2862":119181},[],"/docs/es/platform/pki/certificate-profiles#fija-usos-y-sujeto","Fija usos y sujeto",{"_3376":70303,"_29549":70289,"_5":29878,"_20523":119183,"_26884":119184,"_2862":119185},[],"/docs/es/platform/pki/certificate-profiles#restringe-las-claves","Restringe las claves",{"_3376":70304,"_29549":70289,"_5":29878,"_20523":119187,"_26884":119188,"_2862":119189},[],"/docs/es/platform/pki/certificate-profiles#asócialo-y-prueba","Asócialo y prueba",{"_3376":70305,"_29549":70289,"_5":29878,"_20523":119191,"_26884":119192,"_2862":119193},[],"/docs/es/platform/pki/certificate-profiles#ejemplos-de-diseño","Ejemplos de diseño",{"_3376":70306,"_29549":70289,"_5":29878,"_20523":119195,"_26884":119196,"_2862":119197},[],"/docs/es/platform/pki/certificate-profiles#cambios-y-eliminación","Cambios y eliminación",{"_3376":70307,"_29549":70289,"_20523":119199,"_5":14087,"_26884":70289,"_2862":119200},[],"Un perfil de emisión convierte una política de certificados en configuración reutilizable. En lugar de decidir validez, sujeto, extensiones y algoritmos en cada solicitud, defines una vez qué está permitido y asocias el perfil a una CA, un DMS o una emisión concreta.",{"_3376":70308,"_29549":70289,"_20523":119202,"_5":14087,"_26884":70289,"_2862":119203},[],"Esta guía se dirige al administrador PKI que define la política de emisión. Necesitas permisos para gestionar perfiles y asociarlos a la CA o DMS previstos, además de un consumidor de prueba con requisitos de identidad y uso conocidos.",{"_3376":70309,"_29549":70289,"_20523":119205,"_5":14087,"_26884":119140,"_2862":119206},[],"Puedes expresar la vigencia como una duración desde el momento de emisión o como una fecha final fija. Una duración funciona bien para identidades recurrentes; una fecha común sirve para hacer que todo un lote termine antes de una migración o retirada.",{"_3376":70310,"_29549":70289,"_20523":119208,"_5":14087,"_26884":119140,"_2862":119209},[],"Planifica la fecha final dentro de la vigencia de la CA emisora y deja margen para renovar. El firmador calcula la fecha desde el perfil; no recorta automáticamente la validez al vencimiento del emisor. Comprueba ambas fechas en el certificado resultante. Una fecha fija ya pasada tampoco representa una identidad utilizable.",{"_3376":70311,"_29549":70289,"_20523":119211,"_5":14087,"_26884":119144,"_2862":119212},[],"`Sign as CA` establece `IsCA` y las restricciones básicas necesarias para una autoridad. Actívalo solo en perfiles destinados a crear o reemitir CAs subordinadas.",{"_3376":70312,"_29549":70289,"_20523":119214,"_5":14087,"_26884":119148,"_2862":119215},[],"El perfil puede imponer usos como `DigitalSignature`, `KeyEncipherment`, `CertSign`, `CRLSign`, `ClientAuth`, `ServerAuth` u `OCSPSigning`.",{"_3376":70313,"_29549":70289,"_20523":119217,"_5":14087,"_26884":119148,"_2862":119218},[],"Si activas **Honor Key Usage** o **Honor Extended Key Usages**, Lamassu conserva los valores solicitados por la CSR. Si los desactivas, los sustituye por los definidos en el perfil.",{"_3376":70314,"_29549":70289,"_20523":119220,"_5":14087,"_26884":119148,"_2862":119221},[],"No habilites las opciones `Honor…` para solicitudes no confiables salvo que otro componente valide esos campos. De lo contrario, el solicitante puede elegir capacidades más amplias de las previstas.",{"_3376":70315,"_29549":70289,"_20523":119223,"_5":14087,"_26884":119152,"_2862":119224},[],"Con **Honor Subject**, el certificado conserva el sujeto de la CSR. Sin esa opción, Lamassu aplica `CN`, `O`, `OU`, `C`, `ST` y `L` del perfil. Si el perfil no define `Common Name`, se conserva el CN solicitado.",{"_3376":70316,"_29549":70289,"_20523":119226,"_5":14087,"_26884":119156,"_2862":119227},[],"Con **Honor Extensions**, Lamassu filtra las extensiones adicionales solicitadas y conserva únicamente SAN. Sin esa opción, descarta las extensiones adicionales de la CSR.",{"_3376":70317,"_29549":70289,"_20523":119229,"_5":14087,"_26884":119156,"_2862":119230},[],"Esto conserva SAN, pero no comprueba que el solicitante tenga derecho a utilizar esos DNS, IP, correos o URI. Valida esa autorización antes de emitir. Los puntos OCSP y CRL proceden de la configuración del servicio de emisión; `Honor Extensions` no copia los puntos de distribución de la CSR.",{"_3376":70318,"_29549":70289,"_20523":119232,"_5":14087,"_26884":119160,"_2862":119233},[],"La aplicación criptográfica puede:",{"_3376":70319,"_29549":70289,"_20523":119235,"_5":14087,"_26884":119160,"_2862":119236},[],"permitir o bloquear claves RSA;",{"_3376":70320,"_29549":70289,"_20523":119238,"_5":14087,"_26884":119160,"_2862":119239},[],"limitar los tamaños RSA admitidos;",{"_3376":70321,"_29549":70289,"_20523":119241,"_5":14087,"_26884":119160,"_2862":119242},[],"permitir o bloquear claves ECDSA;",{"_3376":70322,"_29549":70289,"_20523":119244,"_5":14087,"_26884":119160,"_2862":119245},[],"limitar los tamaños o curvas ECDSA admitidos.",{"_3376":70323,"_29549":70289,"_20523":119247,"_5":14087,"_26884":119160,"_2862":119248},[],"Cuando está habilitada, Lamassu comprueba la clave pública antes de crear una CA o firmar una CSR. Una clave cuyo tipo o tamaño no figure en el perfil se rechaza.",{"_3376":70324,"_29549":70289,"_20523":119250,"_5":14087,"_26884":119164,"_2862":119251},[],"La resolución depende del punto de entrada. Se selecciona un perfil completo; sus campos no se fusionan con los del perfil de la CA.",{"_3376":70325,"_29549":70289,"_20523":119253,"_5":14087,"_26884":119164,"_2862":114578},[],{"_3376":70326,"_29549":70289,"_20523":119255,"_5":14087,"_26884":119164,"_2862":119256},[],"Primera opción",{"_3376":70327,"_29549":70289,"_20523":119258,"_5":14087,"_26884":119164,"_2862":119259},[],"Segunda opción",{"_3376":70328,"_29549":70289,"_20523":119261,"_5":14087,"_26884":119164,"_2862":119262},[],"Si no hay ninguna",{"_3376":70329,"_29549":70289,"_20523":119264,"_5":14087,"_26884":119164,"_2862":119265},[],"Firma directa con una CA",{"_3376":70330,"_29549":70289,"_20523":119267,"_5":14087,"_26884":119164,"_2862":119268},[],"`issuance_profile` incluido en la solicitud",{"_3376":70331,"_29549":70289,"_20523":119270,"_5":14087,"_26884":119164,"_2862":119271},[],"`issuance_profile_id` de la solicitud",{"_3376":70332,"_29549":70289,"_20523":119273,"_5":14087,"_26884":119164,"_2862":119274},[],"Perfil predeterminado de la CA (`profile_id`).",{"_3376":70333,"_29549":70289,"_20523":119276,"_5":14087,"_26884":119164,"_2862":119277},[],"Emisión mediante DMS",{"_3376":70334,"_29549":70289,"_20523":119279,"_5":14087,"_26884":119164,"_2862":54169},[],{"_3376":70335,"_29549":70289,"_20523":119281,"_5":14087,"_26884":119164,"_2862":119282},[],"`settings.issuance_profile` incluido en el DMS",{"_3376":70336,"_29549":70289,"_20523":119284,"_5":14087,"_26884":119164,"_2862":119285},[],"Perfil predeterminado de la CA de enrolamiento.",{"_3376":70337,"_29549":70289,"_20523":119287,"_5":14087,"_26884":119164,"_2862":119288},[],"Si el identificador seleccionado no puede resolverse, la operación falla; no se sustituye silenciosamente por el perfil de la CA. Evita definir las dos opciones a la vez. Registrar qué perfil se seleccionó facilita explicar por qué el resultado difiere de la CSR.",{"_3376":70338,"_29549":70289,"_20523":119290,"_5":14087,"_26884":119164,"_2862":119291},[],"Varias flotas pueden compartir CA y mantener perfiles distintos mediante sus DMS. La autenticación del solicitante y la política de registro del dispositivo se configuran aparte en DMS.",{"_3376":70339,"_29549":70289,"_20523":119293,"_5":14087,"_26884":119172,"_2862":119294},[],"Separa, por ejemplo, dispositivos mTLS, servidores y CAs intermedias. Un perfil pequeño y específico es más fácil de revisar que uno que permita todos los usos.",{"_3376":70340,"_29549":70289,"_20523":119296,"_5":14087,"_26884":119176,"_2862":119297},[],"Alinea la duración con la capacidad real de renovación de la flota. Deja margen respecto a la expiración de la CA.",{"_3376":70341,"_29549":70289,"_20523":119299,"_5":14087,"_26884":119180,"_2862":119300},[],"Para un dispositivo que se autentica como cliente, el punto de partida habitual es `DigitalSignature` y `ClientAuth`. Añade `ServerAuth` o `KeyEncipherment` solo si el protocolo lo necesita.",{"_3376":70342,"_29549":70289,"_20523":119302,"_5":14087,"_26884":119184,"_2862":119303},[],"Habilita la aplicación criptográfica y enumera únicamente algoritmos y tamaños compatibles con tu política y tus dispositivos.",{"_3376":70343,"_29549":70289,"_20523":119305,"_5":14087,"_26884":119188,"_2862":119306},[],"Asocia el perfil a una CA o DMS y verifica la precedencia anterior. Emite una CSR con usos y SAN conocidos; inspecciona el resultado con `openssl x509 -in device.crt -noout -text`. Comprueba sujeto, SAN, KU, EKU y fechas. Para una identidad final, `Sign as CA` debe estar desactivado, no debe aparecer `CA:TRUE` ni `Certificate Sign`; si existe Basic Constraints, debe indicar `CA:FALSE`.",{"_3376":70344,"_29549":70289,"_20523":119308,"_5":14087,"_26884":119188,"_2862":119309},[],"Prueba también una clave excluida por la política: la emisión debe rechazarse. Sigue la verificación del certificado y prueba su aceptación en el consumidor previsto.",{"_3376":70345,"_29549":70289,"_20523":119311,"_5":14087,"_26884":119192,"_2862":119312},[],"**Dispositivo mTLS**\\\nCertificado final, validez corta, `DigitalSignature`, `ClientAuth`, sujeto controlado por el DMS y SAN permitido cuando identifica al dispositivo.",{"_3376":70346,"_29549":70289,"_20523":119314,"_5":14087,"_26884":119192,"_2862":119315},[],"**Servidor TLS**\\\nCertificado final, `DigitalSignature`, `ServerAuth` y SAN obligatorio con los nombres que utilizarán los clientes.",{"_3376":70347,"_29549":70289,"_20523":119317,"_5":14087,"_26884":119192,"_2862":119318},[],"**CA intermedia**\\\n`Sign as CA`, `CertSign` y `CRLSign`, validez superior a sus certificados finales y restricciones criptográficas más exigentes.",{"_3376":70348,"_29549":70289,"_20523":119320,"_5":14087,"_26884":119192,"_2862":119321},[],"Estos patrones expresan decisiones de diseño. Activar `Honor Extensions` no exige que la CSR incluya SAN ni valida sus nombres; debes hacer esa comprobación en el flujo de solicitud. El perfil tampoco instala confianza ni concede permisos en el consumidor.",{"_3376":70349,"_29549":70289,"_20523":119323,"_5":14087,"_26884":119196,"_2862":119324},[],"Actualizar un perfil afecta a emisiones futuras; no modifica certificados ya firmados. Prueba los cambios antes de aplicarlos a una CA en producción y conserva la justificación operativa.",{"_3376":70350,"_29549":70289,"_20523":119326,"_5":14087,"_26884":119196,"_2862":119327},[],"Antes de eliminar un perfil, comprueba que ninguna CA o DMS dependa de él. Si deseas sustituirlo, crea la versión nueva, actualiza las referencias y realiza una emisión de prueba antes de retirar el anterior.",{"_3376":70351,"_29549":70351,"_5":14445,"_2862":119329,"_29881":119330,"_20523":119332,"_26884":70351},"Validación de certificados",[48111,114818,53588,119331],"Validación",[],{"_3376":70352,"_29549":70351,"_20523":119334,"_5":14087,"_26884":70351,"_2862":119335},[],"Comprueba cadena, identidad, usos y revocación desde el consumidor.",{"_3376":70353,"_29549":70351,"_5":29878,"_20523":119337,"_26884":119338,"_2862":119339},[],"/docs/es/platform/pki/certificate-validation#antes-de-consultar-el-estado","Antes de consultar el estado",{"_3376":70354,"_29549":70351,"_5":29878,"_20523":119341,"_26884":119342,"_2862":119343},[],"/docs/es/platform/pki/certificate-validation#elige-un-mecanismo","Elige un mecanismo",{"_3376":70355,"_29549":70351,"_5":29878,"_20523":119345,"_26884":119346,"_2862":119347},[],"/docs/es/platform/pki/certificate-validation#comprueba-el-comportamiento-del-consumidor","Comprueba el comportamiento del consumidor",{"_3376":70356,"_29549":70351,"_20523":119349,"_5":14087,"_26884":70351,"_2862":119350},[],"Esta guía reúne las comprobaciones que necesita quien integra un consumidor de certificados. Necesitas el certificado presentado, las intermedias y las raíces que tu aplicación ha decidido confiar. Lamassu publica estado; el consumidor aplica la política de aceptación.",{"_3376":70357,"_29549":70351,"_20523":119352,"_5":14087,"_26884":119338,"_2862":119353},[],"Verifica estos criterios juntos:",{"_3376":70358,"_29549":70351,"_20523":119355,"_5":14087,"_26884":119338,"_2862":118329},[],{"_3376":70359,"_29549":70351,"_20523":119357,"_5":14087,"_26884":119338,"_2862":119358},[],"Resultado necesario",{"_3376":70360,"_29549":70351,"_20523":119360,"_5":14087,"_26884":119338,"_2862":119361},[],"Cadena y firma",{"_3376":70361,"_29549":70351,"_20523":119363,"_5":14087,"_26884":119338,"_2862":119364},[],"Cadena válida hasta una raíz instalada deliberadamente en el consumidor.",{"_3376":70362,"_29549":70351,"_20523":119366,"_5":14087,"_26884":119338,"_2862":119367},[],"Fechas",{"_3376":70363,"_29549":70351,"_20523":119369,"_5":14087,"_26884":119338,"_2862":119370},[],"Fecha actual entre `Not Before` y `Not After`, también para las CAs de la cadena.",{"_3376":70364,"_29549":70351,"_20523":119372,"_5":14087,"_26884":119338,"_2862":114488},[],{"_3376":70365,"_29549":70351,"_20523":119374,"_5":14087,"_26884":119338,"_2862":119375},[],"Nombre, SAN o identificador corresponden al interlocutor esperado.",{"_3376":70366,"_29549":70351,"_20523":119377,"_5":14087,"_26884":119338,"_2862":119378},[],"Uso",{"_3376":70367,"_29549":70351,"_20523":119380,"_5":14087,"_26884":119338,"_2862":119381},[],"KU, EKU y restricciones permiten la operación concreta.",{"_3376":70368,"_29549":70351,"_20523":119383,"_5":14087,"_26884":119338,"_2862":119384},[],"Revocación",{"_3376":70369,"_29549":70351,"_20523":119386,"_5":14087,"_26884":119338,"_2862":119387},[],"Evidencia firmada, vigente y correspondiente al emisor y certificado consultados.",{"_3376":70370,"_29549":70351,"_20523":119389,"_5":14087,"_26884":119338,"_2862":119390},[],"Autorización",{"_3376":70371,"_29549":70351,"_20523":119392,"_5":14087,"_26884":119338,"_2862":119393},[],"La aplicación permite la acción a esa identidad.",{"_3376":70372,"_29549":70351,"_20523":119395,"_5":14087,"_26884":119338,"_2862":119396},[],"El recorrido de emisión comprueba cadena y uso con OpenSSL. Esa comprobación no consulta automáticamente OCSP ni descarga una CRL. Un certificado presente en el inventario o una respuesta OCSP `Good` no sustituyen los demás criterios.",{"_3376":70373,"_29549":70351,"_20523":119398,"_5":14087,"_26884":119342,"_2862":119399},[],"Mecanismo",{"_3376":70374,"_29549":70351,"_20523":119401,"_5":14087,"_26884":119342,"_2862":119402},[],"Cuándo utilizarlo",{"_3376":70375,"_29549":70351,"_20523":119404,"_5":14087,"_26884":119342,"_2862":119405},[],"Qué debes mantener",{"_3376":70376,"_29549":70351,"_20523":119407,"_5":14087,"_26884":119342,"_2862":54297},[],{"_3376":70377,"_29549":70351,"_20523":119409,"_5":14087,"_26884":119342,"_2862":119410},[],"Consulta del estado de un certificado concreto.",{"_3376":70378,"_29549":70351,"_20523":119412,"_5":14087,"_26884":119342,"_2862":119413},[],"Acceso al respondedor, verificación de la firma y política de caché/vigencia.",{"_3376":70379,"_29549":70351,"_20523":119415,"_5":14087,"_26884":119342,"_2862":54306},[],{"_3376":70380,"_29549":70351,"_20523":119417,"_5":14087,"_26884":119342,"_2862":119418},[],"Consulta local de muchos certificados o funcionamiento offline.",{"_3376":70381,"_29549":70351,"_20523":119420,"_5":14087,"_26884":119342,"_2862":119421},[],"Descarga periódica de una lista firmada por el emisor y rechazo de listas vencidas.",{"_3376":70382,"_29549":70351,"_20523":119423,"_5":14087,"_26884":119342,"_2862":119424},[],"OCSP también puede devolver una respuesta reutilizable hasta `nextUpdate`; una CRL cambia al publicarse una versión nueva. Ninguno garantiza por sí solo que un consumidor conozca una revocación en el momento de guardarla.",{"_3376":70383,"_29549":70351,"_20523":119426,"_5":14087,"_26884":119342,"_2862":119427},[],"Si utilizas ambos, define cuándo se permite el mecanismo alternativo y qué hace el cliente si falla la descarga, la firma, la vigencia o devuelve `Unknown`. Aceptar una identidad cuando no puedes comprobar su estado debe ser una decisión explícita de tu aplicación.",{"_3376":70384,"_29549":70351,"_20523":119429,"_5":14087,"_26884":119346,"_2862":119430},[],"Acepta un certificado vigente, autorizado y con cadena conocida.",{"_3376":70385,"_29549":70351,"_20523":119432,"_5":14087,"_26884":119346,"_2862":119433},[],"Rechaza otro con raíz desconocida o uso incompatible.",{"_3376":70386,"_29549":70351,"_20523":119435,"_5":14087,"_26884":119346,"_2862":119436},[],"Revoca un certificado de prueba y verifica la respuesta OCSP o la nueva CRL.",{"_3376":70387,"_29549":70351,"_20523":119438,"_5":14087,"_26884":119346,"_2862":119439},[],"Comprueba que una conexión nueva con esa identidad se rechaza.",{"_3376":70388,"_29549":70351,"_20523":119441,"_5":14087,"_26884":119346,"_2862":119442},[],"Simula un endpoint inaccesible y evidencia vencida; observa si el resultado coincide con tu política.",{"_3376":70389,"_29549":70351,"_20523":119444,"_5":14087,"_26884":119346,"_2862":119445},[],"Conserva número de serie, emisor, razón de revocación, hora de consulta y tiempos de la evidencia. Una sesión ya abierta puede necesitar cierre o reautenticación explícita en el servicio consumidor; publicar revocación no la cierra automáticamente.",{"_3376":70390,"_29549":70351,"_20523":119447,"_5":14087,"_26884":119346,"_2862":119448},[],"Para una cadena con intermedias, valida también su estado según la política del consumidor. La CRL del emisor de una identidad final no reemplaza las comprobaciones de todas las CAs de la cadena.",{"_3376":70391,"_29549":70351,"_20523":119450,"_5":14087,"_26884":119346,"_2862":119451},[],"<Card title=\"Validación online con OCSP\" description=\"Genera una consulta y verifica firma, estado y tiempos.\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":70392,"_29549":70351,"_20523":119453,"_5":14087,"_26884":119346,"_2862":119454},[],"<Card title=\"Listas de revocación\" description=\"Descarga, inspecciona y utiliza una CRL del emisor.\" href=\"/docs/platform/pki/crl\" />",{"_3376":70393,"_29549":70393,"_5":14445,"_2862":119456,"_29881":119457,"_20523":119458,"_26884":70393},"Certificados",[48111,114818,53588,118700],[],{"_3376":70394,"_29549":70393,"_20523":119460,"_5":14087,"_26884":70393,"_2862":119461},[],"Consulta, descarga y revoca los certificados emitidos por Lamassu.",{"_3376":70395,"_29549":70393,"_5":29878,"_20523":119463,"_26884":119464,"_2862":119465},[],"/docs/es/platform/pki/certificates#busca-un-certificado","Busca un certificado",{"_3376":70396,"_29549":70393,"_5":29878,"_20523":119467,"_26884":119468,"_2862":119469},[],"/docs/es/platform/pki/certificates#descarga-el-certificado","Descarga el certificado",{"_3376":70397,"_29549":70393,"_5":29878,"_20523":119471,"_26884":119472,"_2862":119473},[],"/docs/es/platform/pki/certificates#emite-desde-una-csr-existente","Emite desde una CSR existente",{"_3376":70398,"_29549":70393,"_5":29878,"_20523":119475,"_26884":119476,"_2862":119477},[],"/docs/es/platform/pki/certificates#revoca-un-certificado","Revoca un certificado",{"_3376":70399,"_29549":70393,"_5":29878,"_20523":119479,"_26884":119480,"_2862":119481},[],"/docs/es/platform/pki/certificates#abre-la-acción","Abre la acción",{"_3376":70400,"_29549":70393,"_5":29878,"_20523":119483,"_26884":119484,"_2862":119485},[],"/docs/es/platform/pki/certificates#elige-una-razón","Elige una razón",{"_3376":70401,"_29549":70393,"_5":29878,"_20523":119487,"_26884":119488,"_2862":119489},[],"/docs/es/platform/pki/certificates#confirma-y-verifica","Confirma y verifica",{"_3376":70402,"_29549":70393,"_5":29878,"_20523":119491,"_26884":119492,"_2862":119493},[],"/docs/es/platform/pki/certificates#reactiva-una-suspensión","Reactiva una suspensión",{"_3376":70403,"_29549":70393,"_5":29878,"_20523":119495,"_26884":119496,"_2862":119497},[],"/docs/es/platform/pki/certificates#continúa","Continúa",{"_3376":70404,"_29549":70393,"_20523":119499,"_5":14087,"_26884":70393,"_2862":119500},[],"Esta guía sirve al operador PKI que necesita inspeccionar o retirar una identidad ya emitida. Necesitas acceso al inventario y, para cambiar estados, permisos sobre el certificado. Abre **Certificates** para una vista global o **Issued Certificates** dentro de una CA para limitarla a ese emisor.",{"_3376":70405,"_29549":70393,"_20523":119502,"_5":14087,"_26884":119464,"_2862":119503},[],"Filtra por `Common Name`, serie, estado y autoridad emisora. Usa **Quick Inspect** para una revisión rápida o **View Details** para sujeto, SAN, usos, cadena, fechas y metadatos. Los detalles del certificado incluyen la referencia a la clave (`key_id`) y si la clave privada está gestionada (`has_private_key`), y las listas de certificados pueden filtrarse por `has_private_key`.",{"_3376":70406,"_29549":70393,"_20523":119505,"_5":14087,"_26884":119464,"_2862":119506},[],"Identifica el certificado por emisor y número de serie; un nombre puede corresponder a varias renovaciones. Comprueba cuál utiliza realmente el consumidor y cuál ocupa la identidad activa del dispositivo. El historial de identidades y el inventario de certificados responden preguntas distintas.",{"_3376":70407,"_29549":70393,"_20523":119508,"_5":14087,"_26884":119468,"_2862":119509},[],"Descarga el PEM e inspecciónalo:",{"_3376":70408,"_29549":70393,"_20523":119511,"_5":14087,"_26884":119468,"_2862":119512},[],"Comprueba la política de emisión, cadena y usos con el recorrido de verificación. El certificado no contiene su clave privada. Para una CSR externa, esa clave permanece donde se generó; para el flujo de navegador, conserva el archivo descargado al completar la emisión. Si has perdido la clave, planifica una identidad nueva en lugar de esperar recuperarla desde el certificado.",{"_3376":70409,"_29549":70393,"_20523":119514,"_5":14087,"_26884":119472,"_2862":119515},[],"Utiliza este flujo cuando la clave de la identidad debe permanecer en el sistema que la generó. Necesitas una CA activa con clave utilizable, una CSR PEM y un perfil apropiado.",{"_3376":70410,"_29549":70393,"_20523":119517,"_5":14087,"_26884":119472,"_2862":119518},[],"Verifica la solicitud con `openssl req -in request.csr -noout -verify -text`. Revisa sujeto, SAN y algoritmo, y autoriza la identidad solicitada.",{"_3376":70411,"_29549":70393,"_20523":119520,"_5":14087,"_26884":119472,"_2862":119521},[],"Inicia la emisión desde la CA o el inventario y selecciona **Upload Existing CSR**.",{"_3376":70412,"_29549":70393,"_20523":119523,"_5":14087,"_26884":119472,"_2862":119524},[],"Confirma la CA y el perfil que se resolverá según Perfiles; la solicitud no garantiza que todos sus campos se conserven.",{"_3376":70413,"_29549":70393,"_20523":119526,"_5":14087,"_26884":119472,"_2862":119527},[],"Descarga el certificado e inspecciona fechas, emisor, sujeto, SAN, KU y EKU. Comprueba su correspondencia con la clave privada en el sistema de origen.",{"_3376":70414,"_29549":70393,"_20523":119529,"_5":14087,"_26884":119472,"_2862":119530},[],"Instala certificado y cadena en el consumidor previsto y prueba una conexión. Emitir no registra por sí solo un dispositivo ni concede acceso en una integración.",{"_3376":70415,"_29549":70393,"_20523":119532,"_5":14087,"_26884":119472,"_2862":119533},[],"Para generar la clave en el navegador, sigue Emite tu primer certificado.",{"_3376":70416,"_29549":70393,"_20523":119535,"_5":14087,"_26884":119476,"_2862":119536},[],"Revoca cuando la clave se haya comprometido, el sujeto ya no esté autorizado o la identidad deba dejar de aceptarse antes de expirar. Antes de cambiar el estado, identifica los consumidores y prepara la sustitución necesaria.",{"_3376":70417,"_29549":70393,"_20523":119538,"_5":14087,"_26884":119480,"_2862":119539},[],"Localiza emisor y serie correctos y selecciona **Revoke Certificate**. Los registros `EXPIRED` y los revocados por una razón definitiva no admiten posteriores cambios de estado.",{"_3376":70418,"_29549":70393,"_20523":119541,"_5":14087,"_26884":119484,"_2862":119542},[],"Selecciona la razón del incidente. `CertificateHold` representa una suspensión reversible del certificado; las demás razones bloquean cambios posteriores. No uses una suspensión para tratar una clave comprometida.",{"_3376":70419,"_29549":70393,"_20523":119544,"_5":14087,"_26884":119488,"_2862":119545},[],"Guarda el cambio y vuelve a consultar el registro: exige **REVOKED**, razón y fecha. Verifica después una consulta OCSP nueva y, si utilizas CRL, su versión publicada y presencia de la serie. Finalmente, comprueba el rechazo de una conexión nueva en el consumidor.",{"_3376":70420,"_29549":70393,"_20523":119547,"_5":14087,"_26884":119488,"_2862":119548},[],"La revocación no borra el certificado, no elimina la clave ni garantiza cierre de sesiones existentes. El estado y su publicación son pasos distintos.",{"_3376":70421,"_29549":70393,"_20523":119550,"_5":14087,"_26884":119488,"_2862":119551},[],"Un certificado revocado con `CertificateHold` puede reactivarse si no está en estado `EXPIRED`. Sus fechas y la confianza del consumidor siguen siendo obligatorias.",{"_3376":70422,"_29549":70393,"_20523":119553,"_5":14087,"_26884":119492,"_2862":119554},[],"Comprueba que la razón guardada es `CertificateHold` y que la identidad todavía cumple tu política. Solicita `ACTIVE` mediante la operación de actualización de estado que exponga tu instalación; consulta la Referencia API. No supongas que cambiar permisos del consumidor cambia también el estado en Lamassu.",{"_3376":70423,"_29549":70393,"_20523":119556,"_5":14087,"_26884":119492,"_2862":119557},[],"Vuelve a consultar el registro y OCSP. Con `regenerate_on_revoke` habilitado, el evento de reactivación solicita regeneración de la CRL: verifica que la nueva lista omite la serie. Una lista anterior puede seguir marcándola como revocada hasta que el cliente renueve su copia.",{"_3376":70424,"_29549":70393,"_20523":119559,"_5":14087,"_26884":119492,"_2862":119560},[],"Esto no revierte una revocación definitiva ni la cascada iniciada al revocar una CA.",{"_3376":70425,"_29549":70393,"_20523":119562,"_5":14087,"_26884":119496,"_2862":119563},[],"<Card title=\"Validar con OCSP\" description=\"Consulta y verifica el estado firmado de un certificado.\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":70426,"_29549":70393,"_20523":119565,"_5":14087,"_26884":119496,"_2862":119566},[],"<Card title=\"Distribuir una CRL\" description=\"Publica el estado para validación local.\" href=\"/docs/platform/pki/crl\" />",{"_3376":70427,"_29549":70427,"_5":14445,"_2862":119568,"_29881":119569,"_20523":119571,"_26884":70427},"Ciclo de vida de un certificado",[48111,114818,53588,119570],"Conceptos",[],{"_3376":70428,"_29549":70427,"_20523":119573,"_5":14087,"_26884":70427,"_2862":119574},[],"Emisión, uso, renovación, revocación y retirada de certificados en Lamassu.",{"_3376":70429,"_29549":70427,"_5":29878,"_20523":119576,"_26884":119577,"_2862":119578},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#el-recorrido-completo","El recorrido completo",{"_3376":70430,"_29549":70427,"_5":29878,"_20523":119580,"_26884":119581,"_2862":119582},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#solicitud","Solicitud",{"_3376":70431,"_29549":70427,"_5":29878,"_20523":119584,"_26884":119585,"_2862":119586},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#emisión","Emisión",{"_3376":70432,"_29549":70427,"_5":29878,"_20523":119588,"_26884":119589,"_2862":119590},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#uso-y-supervisión","Uso y supervisión",{"_3376":70433,"_29549":70427,"_5":29878,"_20523":119592,"_26884":119593,"_2862":119594},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-o-re-enrolamiento","Renovación o re-enrolamiento",{"_3376":70434,"_29549":70427,"_5":29878,"_20523":119596,"_26884":119597,"_2862":119598},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#revocación-o-retirada","Revocación o retirada",{"_3376":70435,"_29549":70427,"_5":29878,"_20523":119600,"_26884":119601,"_2862":117274},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#estados-del-certificado",{"_3376":70436,"_29549":70427,"_5":29878,"_20523":119603,"_26884":119604,"_2862":119605},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#renovación-y-revocación-no-son-equivalentes","Renovación y revocación no son equivalentes",{"_3376":70437,"_29549":70427,"_5":29878,"_20523":119607,"_26884":119608,"_2862":119609},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#efecto-de-revocar-una-ca","Efecto de revocar una CA",{"_3376":70438,"_29549":70427,"_5":29878,"_20523":119611,"_26884":119612,"_2862":119613},[],"/docs/es/platform/pki/concepts/certificate-lifecycle#qué-debes-observar","Qué debes observar",{"_3376":70439,"_29549":70427,"_20523":119615,"_5":14087,"_26884":70427,"_2862":119616},[],"Emitir un certificado es solo el comienzo. Durante su vida útil debes comprobar su vigencia, renovarlo antes de que caduque y retirarlo cuando deje de ser fiable. Lamassu conserva el certificado, su CA emisora, su estado y, cuando pertenece a un dispositivo, la identidad a la que está vinculado.",{"_3376":70440,"_29549":70427,"_20523":119618,"_5":14087,"_26884":119581,"_2862":119619},[],"El solicitante genera una clave y una CSR. En los flujos recomendados, la clave privada permanece en el dispositivo, navegador o motor criptográfico que la creó.",{"_3376":70441,"_29549":70427,"_20523":119621,"_5":14087,"_26884":119585,"_2862":119622},[],"La CA firma la CSR. El perfil de emisión determina la validez, los usos, el sujeto, las extensiones admitidas y las restricciones criptográficas.",{"_3376":70442,"_29549":70427,"_20523":119624,"_5":14087,"_26884":119589,"_2862":119625},[],"El certificado queda en estado `ACTIVE`. Lamassu monitoriza su fecha `Not After`; el trabajo de monitorización criptográfica marca como `EXPIRED` los certificados que han vencido.",{"_3376":70443,"_29549":70427,"_20523":119627,"_5":14087,"_26884":119593,"_2862":119628},[],"Se emite un certificado nuevo antes de que caduque el anterior. En un DMS puedes abrir ventanas preventiva y crítica para que el dispositivo se re-enrole mediante EST.",{"_3376":70444,"_29549":70427,"_20523":119630,"_5":14087,"_26884":119597,"_2862":119631},[],"Si la identidad deja de ser fiable, Lamassu registra la razón y la hora de revocación. OCSP y las CRLs permiten que los consumidores conozcan ese estado.",{"_3376":70445,"_29549":70427,"_20523":119633,"_5":14087,"_26884":119601,"_2862":119634},[],"Lamassu persiste cuatro estados X.509:",{"_3376":70446,"_29549":70427,"_20523":119636,"_5":14087,"_26884":119601,"_2862":119637},[],"**`ACTIVE`**: el registro está habilitado. Comprueba además `Not Before` y `Not After`: este estado no demuestra vigencia temporal.",{"_3376":70447,"_29549":70427,"_20523":119639,"_5":14087,"_26884":119601,"_2862":119640},[],"**`EXPIRED`**: ha superado su fecha de expiración. El monitor lo detecta de forma periódica; no es un estado que deba asignarse manualmente.",{"_3376":70448,"_29549":70427,"_20523":119642,"_5":14087,"_26884":119601,"_2862":119643},[],"**`REVOKED`**: fue invalidado antes de expirar, con una razón y una marca temporal.",{"_3376":70449,"_29549":70427,"_20523":119645,"_5":14087,"_26884":119601,"_2862":119646},[],"**`INACTIVE`**: está deshabilitado sin representar una revocación definitiva.",{"_3376":70450,"_29549":70427,"_20523":119648,"_5":14087,"_26884":119601,"_2862":119649},[],"La vista del dispositivo puede añadir estados operativos como ausencia de identidad, renovación pendiente, expiración próxima o baja. Son una interpretación del estado del dispositivo y de sus certificados, no nuevos estados X.509.",{"_3376":70451,"_29549":70427,"_20523":119651,"_5":14087,"_26884":119604,"_2862":119652},[],"La **renovación** crea un certificado sucesor para una identidad que continúa siendo válida. La **revocación** comunica que el certificado actual ya no debe aceptarse. Renueva para mantener continuidad; revoca ante compromiso, retirada o un cambio que invalide la identidad.",{"_3376":70452,"_29549":70427,"_20523":119654,"_5":14087,"_26884":119604,"_2862":119655},[],"Solo `CertificateHold` permite reactivar un certificado revocado que no esté en estado `EXPIRED`. Una revocación con otra razón bloquea posteriores cambios de estado. Los registros `EXPIRED` también rechazan cambios; el consumidor debe comprobar las fechas aunque el monitor todavía no haya actualizado el estado. Certificados explica cómo comprobar revocación y reactivación.",{"_3376":70453,"_29549":70427,"_20523":119657,"_5":14087,"_26884":119604,"_2862":119658},[],"La operación **Reissue CA** genera otro certificado para la misma clave y enlaza ambos números de serie mediante metadatos. No equivale a una rotación de clave. Para cambiar la clave, crea una CA sucesora y realiza una migración con periodo de solapamiento.",{"_3376":70454,"_29549":70427,"_20523":119660,"_5":14087,"_26884":119608,"_2862":119661},[],"Revocar una CA inicia una cascada que intenta revocar sus descendientes con `CessationOfOperation`. Puede terminar con fallos parciales y no se deshace al reactivar el padre. Consulta Jerarquía y rotación para sus condiciones y comprobaciones.",{"_3376":70455,"_29549":70427,"_20523":119663,"_5":14087,"_26884":119608,"_2862":119664},[],"Antes de confirmar:",{"_3376":70456,"_29549":70427,"_20523":119666,"_5":14087,"_26884":119608,"_2862":119667},[],"Identifica DMS, dispositivos y servicios que confían en esa cadena.",{"_3376":70457,"_29549":70427,"_20523":119669,"_5":14087,"_26884":119608,"_2862":119670},[],"Distribuye la nueva cadena de confianza.",{"_3376":70458,"_29549":70427,"_20523":119672,"_5":14087,"_26884":119608,"_2862":119673},[],"Reemite las identidades necesarias.",{"_3376":70459,"_29549":70427,"_20523":119675,"_5":14087,"_26884":119608,"_2862":119676},[],"Comprueba OCSP y CRL desde un consumidor real.",{"_3376":70460,"_29549":70427,"_20523":119678,"_5":14087,"_26884":119608,"_2862":119679},[],"Revoca la CA antigua cuando ya no exista tráfico legítimo.",{"_3376":70461,"_29549":70427,"_20523":119681,"_5":14087,"_26884":119608,"_2862":119682},[],"La baja de un dispositivo pertenece al ciclo de vida de IoT Fleets. Afecta a su identidad activa; no equivale a recorrer y revocar automáticamente todos los certificados del historial. Revisa por separado las identidades anteriores y los permisos del consumidor en Gestión de dispositivos.",{"_3376":70462,"_29549":70427,"_20523":119684,"_5":14087,"_26884":119612,"_2862":119685},[],"Certificados que entran en la ventana preventiva o crítica de renovación.",{"_3376":70463,"_29549":70427,"_20523":119687,"_5":14087,"_26884":119612,"_2862":119688},[],"Errores repetidos de enrolamiento o re-enrolamiento.",{"_3376":70464,"_29549":70427,"_20523":119690,"_5":14087,"_26884":119612,"_2862":119691},[],"Cambios de estado y razones de revocación.",{"_3376":70465,"_29549":70427,"_20523":119693,"_5":14087,"_26884":119612,"_2862":119694},[],"Publicación y vigencia de OCSP y CRLs.",{"_3376":70466,"_29549":70427,"_20523":119696,"_5":14087,"_26884":119612,"_2862":119697},[],"Dependencias que todavía presentan un certificado sustituido.",{"_3376":70467,"_29549":70427,"_20523":119699,"_5":14087,"_26884":119612,"_2862":119700},[],"El historial del dispositivo relaciona sus identidades anteriores y actuales. Para cambios administrativos y errores de mutación, consulta Registros de auditoría.",{"_3376":70468,"_29549":70468,"_5":14445,"_2862":119702,"_29881":119703,"_20523":119704,"_26884":70468},"Modelo de confianza",[48111,114818,53588,119570],[],{"_3376":70469,"_29549":70468,"_20523":119706,"_5":14087,"_26884":70468,"_2862":119707},[],"Entiende dónde nace la confianza, cómo se distribuye y qué valida cada componente.",{"_3376":70470,"_29549":70468,"_5":29878,"_20523":119709,"_26884":119710,"_2862":119711},[],"/docs/es/platform/pki/concepts/trust-model#las-cuatro-decisiones-de-confianza","Las cuatro decisiones de confianza",{"_3376":70471,"_29549":70468,"_5":29878,"_20523":119713,"_26884":119714,"_2862":119715},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-emitir","Quién puede emitir",{"_3376":70472,"_29549":70468,"_5":29878,"_20523":119717,"_26884":119718,"_2862":119719},[],"/docs/es/platform/pki/concepts/trust-model#qué-puede-emitirse","Qué puede emitirse",{"_3376":70473,"_29549":70468,"_5":29878,"_20523":119721,"_26884":119722,"_2862":119723},[],"/docs/es/platform/pki/concepts/trust-model#quién-puede-solicitarlo","Quién puede solicitarlo",{"_3376":70474,"_29549":70468,"_5":29878,"_20523":119725,"_26884":119726,"_2862":119727},[],"/docs/es/platform/pki/concepts/trust-model#quién-acepta-el-resultado","Quién acepta el resultado",{"_3376":70475,"_29549":70468,"_5":29878,"_20523":119729,"_26884":119730,"_2862":119731},[],"/docs/es/platform/pki/concepts/trust-model#flujo-de-una-identidad","Flujo de una identidad",{"_3376":70476,"_29549":70468,"_5":29878,"_20523":119733,"_26884":119734,"_2862":119735},[],"/docs/es/platform/pki/concepts/trust-model#cas-de-enrolamiento-validación-y-distribución","CAs de enrolamiento, validación y distribución",{"_3376":70477,"_29549":70468,"_5":29878,"_20523":119737,"_26884":119738,"_2862":119739},[],"/docs/es/platform/pki/concepts/trust-model#validación-y-revocación","Validación y revocación",{"_3376":70478,"_29549":70468,"_5":29878,"_20523":119741,"_26884":119742,"_2862":119743},[],"/docs/es/platform/pki/concepts/trust-model#límites-de-custodia","Límites de custodia",{"_3376":70479,"_29549":70468,"_5":29878,"_20523":119745,"_26884":119746,"_2862":119747},[],"/docs/es/platform/pki/concepts/trust-model#patrón-recomendado","Patrón recomendado",{"_3376":70480,"_29549":70468,"_20523":119749,"_5":14087,"_26884":70468,"_2862":119750},[],"En Lamassu, confianza no significa simplemente que un certificado exista en el inventario. Un consumidor confía en una identidad cuando puede construir una cadena hasta una raíz que reconoce, comprobar que el certificado sirve para el uso esperado y verificar que sigue vigente.",{"_3376":70481,"_29549":70468,"_20523":119752,"_5":14087,"_26884":119714,"_2862":119753},[],"La jerarquía de CAs define qué autoridades pueden firmar. Una CA raíz establece el ancla de confianza; las CAs intermedias separan ámbitos operativos y evitan utilizar la raíz para cada emisión.",{"_3376":70482,"_29549":70468,"_20523":119755,"_5":14087,"_26884":119718,"_2862":119756},[],"Los perfiles de certificado limitan validez, sujeto, usos, extensiones y parámetros criptográficos. La posesión de una CA no sustituye a una política de emisión.",{"_3376":70483,"_29549":70468,"_20523":119758,"_5":14087,"_26884":119722,"_2862":119759},[],"El DMS actúa como punto de enrolamiento. Puede autenticar una solicitud EST con certificado cliente, webhook externo o una combinación de ambos. Las CAs configuradas para validar al solicitante no tienen por qué ser la CA que emitirá la identidad nueva.",{"_3376":70484,"_29549":70468,"_20523":119761,"_5":14087,"_26884":119726,"_2862":119762},[],"El consumidor mantiene su propio almacén de confianza. EST `/cacerts` puede distribuir el certificado TLS del servicio, la CA de enrolamiento y CAs gestionadas seleccionadas. La confianza inicial para autenticar ese servicio debe proceder de un canal ya confiable. Descarga e inspecciona el contenido: no asumas que es una cadena completa ni instales todas las entradas como raíces.",{"_3376":70485,"_29549":70468,"_20523":119764,"_5":14087,"_26884":119730,"_2862":119765},[],"El dispositivo demuestra que puede enrolarse según la política del DMS.",{"_3376":70486,"_29549":70468,"_20523":119767,"_5":14087,"_26884":119730,"_2862":119768},[],"El DMS valida la solicitud y remite la CSR a la CA de enrolamiento.",{"_3376":70487,"_29549":70468,"_20523":119770,"_5":14087,"_26884":119730,"_2862":119771},[],"En el flujo con CSR generado en el dispositivo, la CA aplica el perfil y firma sin recibir su clave privada.",{"_3376":70488,"_29549":70468,"_20523":119773,"_5":14087,"_26884":119730,"_2862":119774},[],"El dispositivo instala el certificado y la cadena que necesita.",{"_3376":70489,"_29549":70468,"_20523":119776,"_5":14087,"_26884":119730,"_2862":119777},[],"El sistema que confía en el dispositivo valida cadena, fechas, usos y estado de revocación.",{"_3376":70490,"_29549":70468,"_20523":119779,"_5":14087,"_26884":119730,"_2862":119780},[],"OIDC o X.509 identifica al operador que llama a Lamassu. El servicio de autorización decide qué acciones puede realizar. La jerarquía X.509, en cambio, determina si un certificado presentado por un dispositivo es confiable.",{"_3376":70491,"_29549":70468,"_20523":119782,"_5":14087,"_26884":119734,"_2862":119783},[],"Un DMS relaciona tres conjuntos que conviene diseñar por separado:",{"_3376":70492,"_29549":70468,"_20523":119785,"_5":14087,"_26884":119734,"_2862":119786},[],"**CA de enrolamiento:** firma las nuevas identidades.",{"_3376":70493,"_29549":70468,"_20523":119788,"_5":14087,"_26884":119734,"_2862":119789},[],"**CAs de validación:** autentican certificados cliente usados para enrolamiento o migración. En re-enrolamiento, la CA de enrolamiento siempre es confiable y Lamassu prueba después las CAs de validación configuradas en el bloque de re-enrolamiento; estas son opcionales.",{"_3376":70494,"_29549":70468,"_20523":119791,"_5":14087,"_26884":119734,"_2862":119792},[],"**CAs distribuidas:** forman el contenido que el dispositivo obtiene mediante EST `/cacerts`. Puedes incluir el certificado TLS del servicio, la CA de enrolamiento y una lista explícita de CAs gestionadas. Incluir la CA emisora no añade automáticamente todos sus ascendientes.",{"_3376":70495,"_29549":70468,"_20523":119794,"_5":14087,"_26884":119734,"_2862":119795},[],"Esta separación permite migrar una flota: aceptas temporalmente certificados de la jerarquía anterior, emites con la nueva y distribuyes ambas cadenas durante el solapamiento.",{"_3376":70496,"_29549":70468,"_20523":119797,"_5":14087,"_26884":119738,"_2862":119798},[],"Una cadena válida no garantiza por sí sola que el certificado deba aceptarse. El consumidor también debe comprobar:",{"_3376":70497,"_29549":70468,"_20523":119800,"_5":14087,"_26884":119738,"_2862":119801},[],"que la fecha actual está entre `Not Before` y `Not After`;",{"_3376":70498,"_29549":70468,"_20523":119803,"_5":14087,"_26884":119738,"_2862":119804},[],"que `Key Usage` y `Extended Key Usage` permiten la operación;",{"_3376":70499,"_29549":70468,"_20523":119806,"_5":14087,"_26884":119738,"_2862":119807},[],"que nombres, SANs y sujeto coinciden con la identidad esperada;",{"_3376":70500,"_29549":70468,"_20523":119809,"_5":14087,"_26884":119738,"_2862":119810},[],"que el certificado no aparece revocado mediante OCSP o una CRL.",{"_3376":70501,"_29549":70468,"_20523":119812,"_5":14087,"_26884":119738,"_2862":119813},[],"El estado `Good` de OCSP tampoco sustituye la comprobación de cadena, fechas, uso e identidad; Validación reúne esos criterios.",{"_3376":70502,"_29549":70468,"_20523":119815,"_5":14087,"_26884":119738,"_2862":119816},[],"Durante la autenticación mTLS de un DMS, Lamassu intenta comprobar la revocación. Si el certificado no contiene información suficiente para efectuar esa comprobación, el backend registra una advertencia y continúa tratándolo como no revocado. Diseña los perfiles y puntos de distribución para evitar esa situación en producción.",{"_3376":70503,"_29549":70468,"_20523":119818,"_5":14087,"_26884":119742,"_2862":119819},[],"El KMS conserva la referencia de la clave y delega la operación al motor configurado. Con un HSM o un KMS cloud, la clave privada puede permanecer no exportable. Eso protege la custodia, pero no impide por sí solo el uso indebido: todavía debes restringir quién puede ordenar una firma y auditar esas operaciones.",{"_3376":70504,"_29549":70468,"_20523":119821,"_5":14087,"_26884":119746,"_2862":119822},[],"Mantén la raíz fuera de las operaciones diarias o con acceso muy restringido.",{"_3376":70505,"_29549":70468,"_20523":119824,"_5":14087,"_26884":119746,"_2862":119825},[],"Emite desde CAs intermedias separadas por entorno o dominio de riesgo.",{"_3376":70506,"_29549":70468,"_20523":119827,"_5":14087,"_26884":119746,"_2862":119828},[],"Asigna perfiles explícitos a cada caso de uso.",{"_3376":70507,"_29549":70468,"_20523":119830,"_5":14087,"_26884":119746,"_2862":119831},[],"Distribuye la nueva confianza antes de comenzar una rotación.",{"_3376":70508,"_29549":70468,"_20523":119833,"_5":14087,"_26884":119746,"_2862":119834},[],"Mantén solapamiento suficiente para renovar una flota desconectada.",{"_3376":70509,"_29549":70468,"_20523":119836,"_5":14087,"_26884":119746,"_2862":119837},[],"Valida desde el sistema consumidor, no solo desde la consola de Lamassu.",{"_3376":70510,"_29549":70468,"_20523":119839,"_5":14087,"_26884":119746,"_2862":119840},[],"Continúa con Jerarquía y rotación de CAs para convertir este modelo en un procedimiento operativo.",{"_3376":70511,"_29549":70511,"_5":14445,"_2862":119842,"_29881":119843,"_20523":119844,"_26884":70511},"Listas de revocación (CRL)",[48111,114818,53588,119331],[],{"_3376":70512,"_29549":70511,"_20523":119846,"_5":14087,"_26884":70511,"_2862":119847},[],"Genera y distribuye listas firmadas para validar certificados sin conexión.",{"_3376":70513,"_29549":70511,"_5":29878,"_20523":119849,"_26884":119850,"_2862":119851},[],"/docs/es/platform/pki/crl#rol-va-y-configuración-por-ca","Rol VA y configuración por CA",{"_3376":70514,"_29549":70511,"_5":29878,"_20523":119853,"_26884":119854,"_2862":119855},[],"/docs/es/platform/pki/crl#cas-que-comparten-clave","CAs que comparten clave",{"_3376":70515,"_29549":70511,"_5":29878,"_20523":119857,"_26884":119858,"_2862":119859},[],"/docs/es/platform/pki/crl#regeneración-periódica-y-automática","Regeneración periódica y automática",{"_3376":70516,"_29549":70511,"_5":29878,"_20523":119861,"_26884":119862,"_2862":119863},[],"/docs/es/platform/pki/crl#contenido-de-la-crl","Contenido de la CRL",{"_3376":70517,"_29549":70511,"_5":29878,"_20523":119865,"_26884":119866,"_2862":119867},[],"/docs/es/platform/pki/crl#endpoint-público-de-descarga","Endpoint público de descarga",{"_3376":70518,"_29549":70511,"_5":29878,"_20523":119869,"_26884":119870,"_2862":119871},[],"/docs/es/platform/pki/crl#api-de-gestión-del-rol-va","API de gestión del rol VA",{"_3376":70519,"_29549":70511,"_5":29878,"_20523":119873,"_26884":119874,"_2862":119875},[],"/docs/es/platform/pki/crl#errores-frecuentes-del-rol-va","Errores frecuentes del rol VA",{"_3376":70520,"_29549":70511,"_5":29878,"_20523":119877,"_26884":119878,"_2862":119879},[],"/docs/es/platform/pki/crl#desde-la-interfaz","Desde la interfaz",{"_3376":70521,"_29549":70511,"_5":29878,"_20523":119881,"_26884":119882,"_2862":119883},[],"/docs/es/platform/pki/crl#referencias","Referencias",{"_3376":70522,"_29549":70511,"_20523":119885,"_5":14087,"_26884":70511,"_2862":119886},[],"Una CRL es una lista firmada de certificados revocados por un emisor. Esta guía sirve al operador que publica listas y al integrador que las utiliza localmente. Necesitas el certificado de la CA emisora, su SKI y acceso al endpoint publicado. El cliente debe mantener una copia vigente: funcionar offline no elimina la necesidad de renovar la evidencia.",{"_3376":70523,"_29549":70511,"_20523":119888,"_5":14087,"_26884":119850,"_2862":119889},[],"El rol VA guarda la configuración y los metadatos de la última lista publicada para el SKI de una CA. La generación requiere una clave emisora utilizable; no presupongas que una CA importada sin clave tiene una CRL disponible.",{"_3376":70524,"_29549":70511,"_20523":119891,"_5":14087,"_26884":119850,"_2862":119892},[],"Campo de `crl_options`",{"_3376":70525,"_29549":70511,"_20523":119894,"_5":14087,"_26884":119850,"_2862":116356},[],{"_3376":70526,"_29549":70511,"_20523":119896,"_5":14087,"_26884":119850,"_2862":119897},[],"Valor inicial del backend",{"_3376":70527,"_29549":70511,"_20523":119899,"_5":14087,"_26884":119850,"_2862":54792},[],{"_3376":70528,"_29549":70511,"_20523":119901,"_5":14087,"_26884":119850,"_2862":119902},[],"Tiempo desde `thisUpdate` hasta `nextUpdate`.",{"_3376":70529,"_29549":70511,"_20523":119904,"_5":14087,"_26884":119850,"_2862":119905},[],"7 días.",{"_3376":70530,"_29549":70511,"_20523":119907,"_5":14087,"_26884":119850,"_2862":54801},[],{"_3376":70531,"_29549":70511,"_20523":119909,"_5":14087,"_26884":119850,"_2862":119910},[],"Se guarda y se devuelve por la API, pero la VA no lo utiliza: la renovación programada no depende de él (consulta Regeneración periódica y automática).",{"_3376":70532,"_29549":70511,"_20523":119912,"_5":14087,"_26884":119850,"_2862":119913},[],"6 días y 23 horas.",{"_3376":70533,"_29549":70511,"_20523":119915,"_5":14087,"_26884":119850,"_2862":54810},[],{"_3376":70534,"_29549":70511,"_20523":119917,"_5":14087,"_26884":119850,"_2862":119918},[],"Solicitar regeneración por eventos de revocación o reactivación desde `CertificateHold`.",{"_3376":70535,"_29549":70511,"_20523":119920,"_5":14087,"_26884":119850,"_2862":54816},[],{"_3376":70536,"_29549":70511,"_20523":119922,"_5":14087,"_26884":119850,"_2862":54819},[],{"_3376":70537,"_29549":70511,"_20523":119924,"_5":14087,"_26884":119850,"_2862":119925},[],"Número de serie del certificado existente que firma la CRL.",{"_3376":70538,"_29549":70511,"_20523":119927,"_5":14087,"_26884":119850,"_2862":119928},[],"Número de serie del certificado actual de la CA.",{"_3376":70539,"_29549":70511,"_20523":119930,"_5":14087,"_26884":119850,"_2862":119931},[],"El firmante debe ser un certificado existente con el uso `cRLSign`, el mismo sujeto y la misma clave pública que la CA. Quedan incluidos los certificados anteriores a una reemisión. No se admite un firmante delegado: un certificado con el sujeto de la CA pero con otra clave se rechaza.",{"_3376":70540,"_29549":70511,"_20523":119933,"_5":14087,"_26884":119850,"_2862":119934},[],"Al reemitir una CA, el rol sigue apuntando al certificado anterior. Las CRL siguen siendo válidas porque ambos certificados comparten sujeto y clave, pero el certificado anterior no puede eliminarse mientras el rol lo use. Para retirarlo, actualiza el firmante del rol.",{"_3376":70541,"_29549":70511,"_20523":119936,"_5":14087,"_26884":119850,"_2862":119937},[],"Al eliminar una CA, su rol VA se conserva y no puede borrarse por API. Si no queda ninguna otra CA con el mismo SKI, el rol puede consultarse pero cualquier `PUT` devuelve 404, y el trabajo de renovación registra un aviso en cada ciclo porque ya no encuentra la CA. La API no ofrece salida; solo se corrige editando la base de datos. Si queda otra CA con ese SKI, el rol sigue siendo editable (consulta CAs que comparten clave). Ajusta validez y firmante antes de eliminar la CA.",{"_3376":70542,"_29549":70511,"_20523":119939,"_5":14087,"_26884":119850,"_2862":119940},[],"Una CA cuyo certificado no tiene `cRLSign` no puede generar su CRL ni editar su rol (error 400). Desde 4.0 la VA exige este uso. Comprueba antes de importar con `openssl x509 -noout -ext keyUsage` y, si falta, obtén un certificado de la misma CA y clave que lo incluya y asígnalo como firmante con `PUT`. Tras reemitir una CA, comprueba también el uso de clave del certificado nuevo: puede no conservar los usos del original.",{"_3376":70543,"_29549":70511,"_20523":119942,"_5":14087,"_26884":119850,"_2862":119943},[],"El `PUT` valida siempre el firmante, aunque la petición no lo cambie. Si el firmante guardado ya no es válido, no se puede modificar ningún campo del rol, ni siquiera la validez, hasta asignar uno válido.",{"_3376":70544,"_29549":70511,"_20523":119945,"_5":14087,"_26884":119850,"_2862":119946},[],"Compartir una clave entre CA puede impedir la validación de las CRL. Consulta CAs que comparten clave.",{"_3376":70545,"_29549":70511,"_20523":119948,"_5":14087,"_26884":119850,"_2862":119949},[],"`latest_crl` contiene versión, inicio y fin de validez. Las versiones se conservan en el almacenamiento de objetos como PEM bajo `pki/va/crl/{subject_key_id}/{version}.crl`; el endpoint público entrega DER.",{"_3376":70546,"_29549":70511,"_20523":119951,"_5":14087,"_26884":119854,"_2862":119952},[],"La VA identifica cada CRL por el SKI de la CA, y el SKI se deriva de su clave. Dos CAs con la misma clave tienen el mismo SKI y comparten un único rol VA y una única CRL. Ocurre al crear una CA sobre una clave ya existente del KMS, o al importar una CA cuyo certificado declara un SKI en uso. Lamassu toma el SKI del certificado importado tal cual y no comprueba que corresponda a su clave pública. El rol lo crea la primera CA y las demás lo conservan.",{"_3376":70547,"_29549":70511,"_20523":119954,"_5":14087,"_26884":119854,"_2862":119955},[],"Los certificados de todas ellas apuntan a `/crl/{ski}`, pero la lista publicada tiene como emisor a la primera CA y solo incluye sus revocaciones. Un verificador compara el emisor de la CRL con el del certificado que valida (RFC 5280, §6.3.2) y rechaza la lista si no coinciden. Según su política, el certificado queda bloqueado (*hard-fail*) o se acepta aunque esté revocado (*soft-fail*). Las revocaciones de las CAs secundarias no aparecen en ninguna lista.",{"_3376":70548,"_29549":70511,"_20523":119957,"_5":14087,"_26884":119854,"_2862":119958},[],"Si la primera CA se elimina, la generación de CRL de la restante falla porque el firmante configurado ya no corresponde a una CA con ese nombre. Hasta que se actualice el firmante del rol a un certificado de la CA restante, se sigue sirviendo la última lista publicada hasta que venza (7 días por defecto).",{"_3376":70549,"_29549":70511,"_20523":119960,"_5":14087,"_26884":119854,"_2862":119961},[],"Antes de actualizar, revisa las CAs que comparten clave. Para detectar el problema, compara el SKI de las CAs en el inventario: dos con el mismo SKI están afectadas. Para resolverlo, crea una CA con clave propia y reemite sus certificados; los ya emitidos conservan la URL antigua y no se corrigen hasta reemitirlos. Una CA importada con un SKI ya en uso no sustituye a la existente como emisora de la CRL, porque el emisor se resuelve a partir del firmante del rol. Sin embargo, sus propios certificados apuntan a esa misma URL y sus revocaciones no se publican. Hasta que Lamassu rechace estas importaciones, limita el permiso de importar CAs como control provisional; cubre solo la vía de importación. Crear una CA con &#x2A;*Create New CA (Existing Key)** sobre una clave KMS que otra CA ya usa produce la misma colisión, así que tampoco reutilices claves entre CAs. Una CRL por CA y el rechazo de importaciones cuyo SKI colisiona con el de una CA existente están planteados en lamassuiot#834, y ninguno está implementado todavía.",{"_3376":70550,"_29549":70511,"_20523":119963,"_5":14087,"_26884":119858,"_2862":119964},[],"El trabajo programado de la VA revisa todos los roles en cada ejecución y solicita otra lista cuando a `latest_crl` le queda menos validez que el intervalo entre ejecuciones. La frecuencia se configura en Helm con `services.va.job.crl.frequency` (por defecto `0 * * * *`) y admite una duración (`1h`) o una expresión cron. Una expresión cron se convierte en un intervalo constante igual al tiempo que falta para su siguiente disparo cuando arranca el servicio, así que no se alinea con el reloj. `refresh_interval` no interviene. Mantén `validity` claramente por encima del intervalo: con una validez menor, la lista se regenera en cada ciclo.",{"_3376":70551,"_29549":70511,"_20523":119966,"_5":14087,"_26884":119858,"_2862":119967},[],"Si la generación falla (por ejemplo, por un rol sin CA o un firmante inválido), el trabajo registra el aviso `something went wrong while calculating CRL for CA <ski>` y lo reintenta en el ciclo siguiente. No hay otra vía de renovación hasta corregir la causa, y la última lista publicada se sigue sirviendo hasta vencer. Todo ello depende de que el trabajo, el almacenamiento y la firma funcionen.",{"_3376":70552,"_29549":70511,"_20523":119969,"_5":14087,"_26884":119858,"_2862":119970},[],"Con `regenerate_on_revoke`, el manejador de eventos solicita una nueva CRL cuando recibe una revocación o la reactivación de un certificado desde `CertificateHold` a `ACTIVE`. Es un paso posterior al cambio de estado, con sus propios posibles errores: si falla (rol inexistente, firmante inválido), el evento se reintenta y, agotados los reintentos, pasa a la cola de eventos fallidos. Confirmar la revocación no demuestra que la CRL nueva ya esté publicada ni que todos los clientes la hayan descargado.",{"_3376":70553,"_29549":70511,"_20523":119972,"_5":14087,"_26884":119858,"_2862":119973},[],"Comprueba el número de CRL y sus tiempos antes y después del cambio. Supervisa listas vencidas y fallos de generación; los clientes deben aplicar su política cuando no disponen de evidencia vigente.",{"_3376":70554,"_29549":70511,"_20523":119975,"_5":14087,"_26884":119862,"_2862":119976},[],"Cada entrada incluye serie, fecha de revocación y razón. El generador consulta certificados en estado `REVOKED` para la CA seleccionada. Un certificado reactivado deja de aparecer al recalcular la lista; una copia descargada anteriormente conserva su contenido.",{"_3376":70555,"_29549":70511,"_20523":119978,"_5":14087,"_26884":119862,"_2862":119979},[],"La lista incluye un *Issuing Distribution Point* crítico (OID `2.5.29.28`) con las URLs de distribución configuradas. Comprueba que tu cliente interpreta esa extensión y que corresponde al ámbito de la lista. Si la rechaza, investiga el formato y el alcance; ignorar una extensión crítica no es una validación satisfactoria.",{"_3376":70556,"_29549":70511,"_20523":119981,"_5":14087,"_26884":119866,"_2862":119982},[],"El servicio VA expone `GET /crl/{subject_key_id}` sin autorización de gestión. Usa el SKI de la **CA emisora**, no el SKI del certificado final ni su número de serie. Inspecciona primero el CDP del certificado:",{"_3376":70557,"_29549":70511,"_20523":119984,"_5":14087,"_26884":119866,"_2862":119985},[],"Sustituye la URL siguiente por la del CDP y revisa la exposición en Despliegue:",{"_3376":70558,"_29549":70511,"_20523":119987,"_5":14087,"_26884":119866,"_2862":119988},[],"Necesitas OpenSSL 3.x e `issuer.pem` con el certificado del emisor directo. Exige firma válida, tiempos vigentes y emisor esperado. Para una prueba con una raíz que emite directamente:",{"_3376":70559,"_29549":70511,"_20523":119990,"_5":14087,"_26884":119866,"_2862":119991},[],"`roots.pem` contiene las raíces deliberadamente confiables. Si hay intermedias, añade `-untrusted intermediates.pem` antes del argumento `device.crt`. `-crl_check` comprueba la revocación del certificado final usando la lista local; no descarga otras listas ni demuestra el estado de toda la cadena. Para comprobarla completa, necesitas las CRL correspondientes y una política que las exija.",{"_3376":70560,"_29549":70511,"_20523":119993,"_5":14087,"_26884":119866,"_2862":119994},[],"La prueba debe aceptar un certificado permitido que no esté en la lista y rechazarlo con `certificate revoked` después de publicar y utilizar la lista que contiene su serie.",{"_3376":70561,"_29549":70511,"_20523":119996,"_5":14087,"_26884":119870,"_2862":119997},[],"Los paths siguientes son relativos al servicio VA; el prefijo público debe confirmarse en el Gateway. No son las URLs de los endpoints públicos de OCSP y CRL.",{"_3376":70562,"_29549":70511,"_20523":119999,"_5":14087,"_26884":119870,"_2862":116545},[],{"_3376":70563,"_29549":70511,"_20523":120001,"_5":14087,"_26884":119870,"_2862":120002},[],"Path relativo",{"_3376":70564,"_29549":70511,"_20523":120004,"_5":14087,"_26884":119870,"_2862":114578},[],{"_3376":70565,"_29549":70511,"_20523":120006,"_5":14087,"_26884":119870,"_2862":54904},[],{"_3376":70566,"_29549":70511,"_20523":120008,"_5":14087,"_26884":119870,"_2862":54907},[],{"_3376":70567,"_29549":70511,"_20523":120010,"_5":14087,"_26884":119870,"_2862":120011},[],"Consultar `crl_options` y `latest_crl`.",{"_3376":70568,"_29549":70511,"_20523":120013,"_5":14087,"_26884":119870,"_2862":54913},[],{"_3376":70569,"_29549":70511,"_20523":120015,"_5":14087,"_26884":119870,"_2862":54907},[],{"_3376":70570,"_29549":70511,"_20523":120017,"_5":14087,"_26884":119870,"_2862":120018},[],"Sustituir la configuración de CRL.",{"_3376":70571,"_29549":70511,"_20523":120020,"_5":14087,"_26884":119870,"_2862":120021},[],"Necesitas autenticación y permisos de lectura o actualización del rol. Consulta la Referencia API y el control de acceso de tu instalación. Lee la configuración actual antes de actualizarla y envía el objeto completo esperado por el contrato: el backend sustituye `crl_options`; no fusiona campos omitidos.",{"_3376":70572,"_29549":70511,"_20523":120023,"_5":14087,"_26884":119870,"_2862":120024},[],"Después de un cambio, comprueba la configuración guardada y la siguiente lista efectivamente publicada. Modificar el rol no prueba por sí solo regeneración ni aceptación por el cliente.",{"_3376":70573,"_29549":70511,"_20523":120026,"_5":14087,"_26884":119874,"_2862":120027},[],"Síntoma",{"_3376":70574,"_29549":70511,"_20523":120029,"_5":14087,"_26884":119874,"_2862":120030},[],"Causa",{"_3376":70575,"_29549":70511,"_20523":120032,"_5":14087,"_26884":119874,"_2862":120033},[],"Acción",{"_3376":70576,"_29549":70511,"_20523":120035,"_5":14087,"_26884":119874,"_2862":120036},[],"`PUT /v1/roles/{ca-ski}` devuelve 404 y `GET` devuelve 200.",{"_3376":70577,"_29549":70511,"_20523":120038,"_5":14087,"_26884":119874,"_2862":120039},[],"Se eliminó la CA del rol y no queda otra con el mismo SKI.",{"_3376":70578,"_29549":70511,"_20523":120041,"_5":14087,"_26884":119874,"_2862":120042},[],"No hay salida por API; requiere intervención en la base de datos. Evítalo ajustando el rol antes de eliminar la CA.",{"_3376":70579,"_29549":70511,"_20523":120044,"_5":14087,"_26884":119874,"_2862":120045},[],"`PUT` devuelve 400.",{"_3376":70580,"_29549":70511,"_20523":120047,"_5":14087,"_26884":119874,"_2862":120048},[],"El firmante no tiene `cRLSign`, o su sujeto y su clave no coinciden con ninguna CA de ese SKI (por ejemplo, tras eliminar la primera de dos CAs que comparten clave).",{"_3376":70581,"_29549":70511,"_20523":120050,"_5":14087,"_26884":119874,"_2862":120051},[],"Asigna con `PUT` el número de serie de un certificado válido de la CA restante.",{"_3376":70582,"_29549":70511,"_20523":120053,"_5":14087,"_26884":119874,"_2862":120054},[],"`PUT` devuelve 400 desde un cliente de 3.x.",{"_3376":70583,"_29549":70511,"_20523":120056,"_5":14087,"_26884":119874,"_2862":120057},[],"`crl_options.subject_key_id_signer` se sustituyó por `signer_certificate_serial_number`, que es obligatorio.",{"_3376":70584,"_29549":70511,"_20523":120059,"_5":14087,"_26884":119874,"_2862":120060},[],"Actualiza el cliente para enviar el campo nuevo.",{"_3376":70585,"_29549":70511,"_20523":120062,"_5":14087,"_26884":119874,"_2862":120063},[],"La CRL no cambia tras revocar un certificado.",{"_3376":70586,"_29549":70511,"_20523":120065,"_5":14087,"_26884":119874,"_2862":120066},[],"`regenerate_on_revoke` es `false`, o el evento falló por falta de rol o por un firmante inválido.",{"_3376":70587,"_29549":70511,"_20523":120068,"_5":14087,"_26884":119874,"_2862":120069},[],"Revisa los logs de la VA y la cola de eventos fallidos; corrige el firmante.",{"_3376":70588,"_29549":70511,"_20523":120071,"_5":14087,"_26884":119874,"_2862":120072},[],"Un verificador rechaza la CRL por el emisor.",{"_3376":70589,"_29549":70511,"_20523":120074,"_5":14087,"_26884":119874,"_2862":120075},[],"Varias CAs comparten SKI.",{"_3376":70590,"_29549":70511,"_20523":120077,"_5":14087,"_26884":119874,"_2862":120078},[],"Consulta CAs que comparten clave.",{"_3376":70591,"_29549":70511,"_20523":120080,"_5":14087,"_26884":119878,"_2862":120081},[],"La vista de la CA permite inspeccionar y descargar la lista disponible. Compara versión, emisor y tiempos con la copia descargada desde el endpoint público. Para diagnosticar una diferencia, sigue Diagnóstico PKI.",{"_3376":70592,"_29549":70511,"_20523":120083,"_5":14087,"_26884":119882,"_2862":120084},[],"RFC 5280: perfil X.509 y CRL.",{"_3376":70593,"_29549":70511,"_20523":120086,"_5":14087,"_26884":119882,"_2862":54987},[],{"_3376":70594,"_29549":70511,"_20523":120088,"_5":14087,"_26884":119882,"_2862":54990},[],{"_3376":70595,"_29549":70511,"_20523":120090,"_5":14087,"_26884":119882,"_2862":120091},[],"<Card title=\"Servicio OCSP\" href=\"/docs/platform/pki/ocsp\" />",{"_3376":70596,"_29549":70511,"_20523":120093,"_5":14087,"_26884":119882,"_2862":120094},[],"<Card title=\"Validación de certificados\" href=\"/docs/platform/pki/certificate-validation\" />",{"_3376":70597,"_29549":70597,"_5":14445,"_2862":120096,"_29881":120097,"_20523":120098,"_26884":70597},"Claves y motores criptográficos",[48111,114818,53588,118700],[],{"_3376":70598,"_29549":70597,"_20523":120100,"_5":14087,"_26884":70597,"_2862":120101},[],"Genera, importa y opera claves sin acoplar la PKI a un proveedor concreto.",{"_3376":70599,"_29549":70597,"_5":29878,"_20523":120103,"_26884":120104,"_2862":120105},[],"/docs/es/platform/pki/key-management#qué-resuelve-el-kms","Qué resuelve el KMS",{"_3376":70600,"_29549":70597,"_5":29878,"_20523":120107,"_26884":120108,"_2862":120109},[],"/docs/es/platform/pki/key-management#motores-criptográficos","Motores criptográficos",{"_3376":70601,"_29549":70597,"_5":29878,"_20523":120111,"_26884":120112,"_2862":55015},[],"/docs/es/platform/pki/key-management#file-system",{"_3376":70602,"_29549":70597,"_5":29878,"_20523":120114,"_26884":120115,"_2862":55019},[],"/docs/es/platform/pki/key-management#hashicorp-vault",{"_3376":70603,"_29549":70597,"_5":29878,"_20523":120117,"_26884":120118,"_2862":55023},[],"/docs/es/platform/pki/key-management#aws-secrets-manager",{"_3376":70604,"_29549":70597,"_5":29878,"_20523":120120,"_26884":120121,"_2862":55027},[],"/docs/es/platform/pki/key-management#aws-kms",{"_3376":70605,"_29549":70597,"_5":29878,"_20523":120123,"_26884":120124,"_2862":55031},[],"/docs/es/platform/pki/key-management#pkcs11",{"_3376":70606,"_29549":70597,"_5":29878,"_20523":120126,"_26884":120127,"_2862":55035},[],"/docs/es/platform/pki/key-management#azure-key-vault",{"_3376":70607,"_29549":70597,"_5":29878,"_20523":120129,"_26884":120130,"_2862":120131},[],"/docs/es/platform/pki/key-management#inventario-de-claves","Inventario de claves",{"_3376":70608,"_29549":70597,"_5":29878,"_20523":120133,"_26884":120134,"_2862":120135},[],"/docs/es/platform/pki/key-management#crear-o-importar-claves","Crear o importar claves",{"_3376":70609,"_29549":70597,"_5":29878,"_20523":120137,"_26884":120138,"_2862":120139},[],"/docs/es/platform/pki/key-management#generar-un-nuevo-par-de-claves","Generar un nuevo par de claves",{"_3376":70610,"_29549":70597,"_5":29878,"_20523":120141,"_26884":120142,"_2862":120143},[],"/docs/es/platform/pki/key-management#importar-un-par-existente","Importar un par existente",{"_3376":70611,"_29549":70597,"_5":29878,"_20523":120145,"_26884":120146,"_2862":120147},[],"/docs/es/platform/pki/key-management#operaciones-sobre-una-clave","Operaciones sobre una clave",{"_3376":70612,"_29549":70597,"_5":29878,"_20523":120149,"_26884":120150,"_2862":120151},[],"/docs/es/platform/pki/key-management#ver-detalles","Ver detalles",{"_3376":70613,"_29549":70597,"_5":29878,"_20523":120153,"_26884":120154,"_2862":120155},[],"/docs/es/platform/pki/key-management#firmar-y-verificar","Firmar y verificar",{"_3376":70614,"_29549":70597,"_5":29878,"_20523":120157,"_26884":120158,"_2862":55067},[],"/docs/es/platform/pki/key-management#sign",{"_3376":70615,"_29549":70597,"_5":29878,"_20523":120160,"_26884":120161,"_2862":55071},[],"/docs/es/platform/pki/key-management#verify",{"_3376":70616,"_29549":70597,"_5":29878,"_20523":120163,"_26884":120164,"_2862":120165},[],"/docs/es/platform/pki/key-management#generar-un-csr","Generar un CSR",{"_3376":70617,"_29549":70597,"_5":29878,"_20523":120167,"_26884":120168,"_2862":120169},[],"/docs/es/platform/pki/key-management#firma-local-con-pkcs11","Firma local con PKCS#11",{"_3376":70618,"_29549":70597,"_5":29878,"_20523":120171,"_26884":120172,"_2862":120173},[],"/docs/es/platform/pki/key-management#antes-de-eliminar-una-clave","Antes de eliminar una clave",{"_3376":70619,"_29549":70597,"_20523":120175,"_5":14087,"_26884":70597,"_2862":120176},[],"El servicio de Gestión de Claves Criptográficas (KMS) de Lamassu IoT centraliza la generación, importación, custodia y uso de las claves de la plataforma. Desde aquí se gestionan las claves que soportan a las CAs y al resto de operaciones de firma que dependen de la PKI.",{"_3376":70620,"_29549":70597,"_20523":120178,"_5":14087,"_26884":70597,"_2862":120179},[],"En la configuración actual, Lamassu IoT trabaja exclusivamente con claves asimétricas, como RSA y curvas elípticas. Estas claves se usan para emitir certificados X.509, firmar solicitudes y realizar operaciones de autenticación y validación dentro del sistema.",{"_3376":70621,"_29549":70597,"_20523":120181,"_5":14087,"_26884":120104,"_2862":120182},[],"El KMS unifica la gestión del ciclo de vida de las claves y evita que cada servicio tenga que integrarse directamente con un proveedor criptográfico concreto.",{"_3376":70622,"_29549":70597,"_20523":120184,"_5":14087,"_26884":120104,"_2862":120185},[],"En la práctica, permite:",{"_3376":70623,"_29549":70597,"_20523":120187,"_5":14087,"_26884":120104,"_2862":120188},[],"Generar nuevos pares de claves desde Lamassu IoT.",{"_3376":70624,"_29549":70597,"_20523":120190,"_5":14087,"_26884":120104,"_2862":120191},[],"Importar claves creadas externamente.",{"_3376":70625,"_29549":70597,"_20523":120193,"_5":14087,"_26884":120104,"_2862":120194},[],"Delegar la custodia y las operaciones criptográficas en motores externos.",{"_3376":70626,"_29549":70597,"_20523":120196,"_5":14087,"_26884":120104,"_2862":120197},[],"Reutilizar claves ya existentes para CAs, CSR y tareas de firma o verificación.",{"_3376":70627,"_29549":70597,"_20523":120199,"_5":14087,"_26884":120108,"_2862":120200},[],"Lamassu puede trabajar con distintos motores criptográficos según los requisitos del despliegue. En algunos entornos bastará con un motor software; en otros será necesario delegar la custodia en un HSM, en un servicio cloud o en una plataforma especializada.",{"_3376":70628,"_29549":70597,"_20523":120202,"_5":14087,"_26884":120108,"_2862":120203},[],"Una misma instancia puede tener varios motores configurados al mismo tiempo, incluso varias instancias del mismo tipo. Esto permite adaptar la operación a distintos niveles de seguridad, coste y requisitos regulatorios.",{"_3376":70629,"_29549":70597,"_20523":120205,"_5":14087,"_26884":120108,"_2862":120206},[],"Esta guía se dirige al operador PKI: elige y utiliza un motor ya habilitado. La instalación, credenciales, almacenamiento persistente y conectividad corresponden a Despliegue. Antes de generar una CA, comprueba el motor predeterminado, los algoritmos publicados y que una firma de prueba funciona. La disponibilidad en tu instalación depende de su versión y configuración.",{"_3376":70630,"_29549":70597,"_20523":120208,"_5":14087,"_26884":120112,"_2862":120209},[],"Genera claves software y almacena el material privado en archivos. Su custodia depende de permisos, almacenamiento y copias de seguridad de la instalación. Antes de utilizarlo para una CA operativa, acuerda cómo se recuperará la clave y cómo accederán a ella las réplicas; el registro del KMS no sustituye esos archivos.",{"_3376":70631,"_29549":70597,"_20523":120211,"_5":14087,"_26884":120115,"_2862":120212},[],"El adaptador utiliza almacenamiento KV para el material privado. No equivale a una operación de firma dentro de Vault Transit: quien pueda leer el secreto puede recuperar la clave. Revisa los permisos de lectura, disponibilidad y recuperación con el responsable de Despliegue.",{"_3376":70632,"_29549":70597,"_20523":120214,"_5":14087,"_26884":120115,"_2862":120215},[],"El adaptador se comunica con Vault a través de su endpoint HTTP(S) configurado. El certificado del servidor de Vault se verifica contra el almacén de confianza del sistema; para confiar en un Vault con certificado emitido por una CA privada, añade ese certificado de CA al `ca_cert_file` del motor (codificado en PEM). `insecure_skip_verify=true` desactiva la verificación y es un último recurso; acuerda los ajustes de transporte con el responsable de Despliegue.",{"_3376":70633,"_29549":70597,"_20523":120217,"_5":14087,"_26884":120118,"_2862":120218},[],"Ofrece persistencia cifrada en AWS con coste asociado. Protege la clave en reposo, pero un administrador autorizado puede recuperarla; no proporciona la misma resistencia a la extracción que un KMS o HSM.",{"_3376":70634,"_29549":70597,"_20523":120220,"_5":14087,"_26884":120121,"_2862":120221},[],"Delega las firmas en el servicio AWS KMS. El adaptador también contempla importación de material externo, sujeta a las capacidades y permisos del proveedor. Una clave generada fuera del servicio ya ha existido fuera de su custodia; importarla no elimina esas copias. Comprueba generación, importación y firma como operaciones distintas.",{"_3376":70635,"_29549":70597,"_20523":120223,"_5":14087,"_26884":120124,"_2862":120224},[],"Permite integrar HSMs locales, entornos aislados y servicios *Key as a Service*. La generación, persistencia y resistencia a la extracción dependen del dispositivo o proveedor concreto. Es la opción más flexible cuando la política exige custodia hardware.",{"_3376":70636,"_29549":70597,"_20523":120226,"_5":14087,"_26884":120127,"_2862":120227},[],"El backend también dispone de adaptadores para **Key Vault Keys** y **Key Vault Secrets**. El primero delega firmas al servicio de claves; el segundo conserva material privado como secretos y firma con ese material. No intercambies ambos modelos de custodia. Confirma qué adaptador está habilitado en tu instalación y prueba las operaciones necesarias.",{"_3376":70637,"_29549":70597,"_20523":120229,"_5":14087,"_26884":120127,"_2862":120230},[],"Lamassu muestra en la consola el listado de motores habilitados.",{"_3376":70638,"_29549":70597,"_20523":120232,"_5":14087,"_26884":120127,"_2862":120233},[],"Cada motor define qué algoritmos soporta, como RSA o ECC/ECDSA, y qué tamaños de clave puede generar.",{"_3376":70639,"_29549":70597,"_20523":120235,"_5":14087,"_26884":120127,"_2862":120236},[],"Revisa con el operador de Despliegue qué motor está definido como predeterminado. Ese motor se utilizará cuando un proceso necesite crear o persistir una clave y el usuario no haya seleccionado uno específico, por ejemplo al crear o importar una CA.",{"_3376":70640,"_29549":70597,"_20523":120238,"_5":14087,"_26884":120130,"_2862":120239},[],"La pantalla principal de KMS muestra el inventario completo de claves registradas en el sistema. Es la vista de referencia para revisar qué claves existen, dónde están custodiadas y con qué entidades están relacionadas.",{"_3376":70641,"_29549":70597,"_20523":120241,"_5":14087,"_26884":120130,"_2862":120242},[],"La tabla incluye los siguientes campos:",{"_3376":70642,"_29549":70597,"_20523":120244,"_5":14087,"_26884":120130,"_2862":120245},[],"**Name**: nombre descriptivo de la clave.",{"_3376":70643,"_29549":70597,"_20523":120247,"_5":14087,"_26884":120130,"_2862":120248},[],"**Type**: algoritmo y tamaño de clave, por ejemplo RSA 2048 o EC P-256.",{"_3376":70644,"_29549":70597,"_20523":120250,"_5":14087,"_26884":120130,"_2862":120251},[],"**Strength**: indicador visual de fortaleza criptográfica.",{"_3376":70645,"_29549":70597,"_20523":120253,"_5":14087,"_26884":120130,"_2862":120254},[],"**Public/Private**: indica si Lamassu gestiona el par completo o solo la clave pública.",{"_3376":70646,"_29549":70597,"_20523":120256,"_5":14087,"_26884":120130,"_2862":120257},[],"**Crypto Engine**: motor criptográfico que custodia la clave.",{"_3376":70647,"_29549":70597,"_20523":120259,"_5":14087,"_26884":120130,"_2862":120260},[],"**Aliases**: nombres alternativos asociados a la clave.",{"_3376":70648,"_29549":70597,"_20523":120262,"_5":14087,"_26884":120130,"_2862":120263},[],"**Tags**: etiquetas para clasificación y búsqueda.",{"_3376":70649,"_29549":70597,"_20523":120265,"_5":14087,"_26884":120130,"_2862":120266},[],"**Related Entities**: certificados u otras entidades vinculadas a esa clave.",{"_3376":70650,"_29549":70597,"_20523":120268,"_5":14087,"_26884":120130,"_2862":120269},[],"Desde esta vista también se accede a las acciones más habituales:",{"_3376":70651,"_29549":70597,"_20523":120271,"_5":14087,"_26884":120130,"_2862":120272},[],"**View Details** para consultar metadatos, identificadores y relaciones.",{"_3376":70652,"_29549":70597,"_20523":120274,"_5":14087,"_26884":120130,"_2862":120275},[],"**Generate CSR** para crear una solicitud PKCS#10 con la clave seleccionada.",{"_3376":70653,"_29549":70597,"_20523":120277,"_5":14087,"_26884":120130,"_2862":120278},[],"**Sign / Verify** para probar operaciones criptográficas sobre la clave.",{"_3376":70654,"_29549":70597,"_20523":120280,"_5":14087,"_26884":120130,"_2862":120281},[],"**Delete Key** para eliminar la clave del sistema.",{"_3376":70655,"_29549":70597,"_20523":120283,"_5":14087,"_26884":120134,"_2862":120284},[],"Necesitas permisos de administración de claves y un motor accesible. El perfil de emisión debe admitir el algoritmo que eliges si la clave va a utilizarse en una CA o CSR. Abre **Create New Key** y elige generación o importación.",{"_3376":70656,"_29549":70597,"_20523":120286,"_5":14087,"_26884":120138,"_2862":120287},[],"Si la clave va a nacer dentro de Lamassu, el flujo recomendado es generar un nuevo par gestionado directamente por uno de los motores configurados.",{"_3376":70657,"_29549":70597,"_20523":120289,"_5":14087,"_26884":120138,"_2862":120290},[],"En la primera pantalla del asistente, elige **Generate New Key Pair** y después define los parámetros principales:",{"_3376":70658,"_29549":70597,"_20523":120292,"_5":14087,"_26884":120138,"_2862":120293},[],"**Key Name**: nombre único y descriptivo.",{"_3376":70659,"_29549":70597,"_20523":120295,"_5":14087,"_26884":120138,"_2862":120296},[],"**Crypto Engine**: motor que custodiará la clave.",{"_3376":70660,"_29549":70597,"_20523":120298,"_5":14087,"_26884":120138,"_2862":120299},[],"**Key Type** y **Key Size**: algoritmo y tamaño o curva.",{"_3376":70661,"_29549":70597,"_20523":120301,"_5":14087,"_26884":120138,"_2862":120302},[],"**Tags**: metadatos para clasificar la clave.",{"_3376":70662,"_29549":70597,"_20523":120304,"_5":14087,"_26884":120138,"_2862":120305},[],"**Metadata**: información adicional para usos avanzados.",{"_3376":70663,"_29549":70597,"_20523":120307,"_5":14087,"_26884":120142,"_2862":120308},[],"La importación permite registrar en Lamassu una clave generada fuera de la plataforma. Es el flujo habitual en escenarios BYOK, migraciones o integración con material criptográfico que ya está en producción.",{"_3376":70664,"_29549":70597,"_20523":120310,"_5":14087,"_26884":120142,"_2862":120311},[],"Cuando tienes una clave privada exportable y el motor de destino admite su importación.",{"_3376":70665,"_29549":70597,"_20523":120313,"_5":14087,"_26884":120142,"_2862":120314},[],"Cuando se necesita migrar una PKI existente sin reemitir certificados.",{"_3376":70666,"_29549":70597,"_20523":120316,"_5":14087,"_26884":120142,"_2862":120317},[],"Cuando Lamassu debe operar con una raíz de confianza creada por un tercero.",{"_3376":70667,"_29549":70597,"_20523":120319,"_5":14087,"_26884":120142,"_2862":120320},[],"En el asistente, elige **Import Existing Key Pair** y completa los campos solicitados:",{"_3376":70668,"_29549":70597,"_20523":120322,"_5":14087,"_26884":120142,"_2862":120323},[],"**Key Name**: nombre descriptivo dentro de Lamassu IoT.",{"_3376":70669,"_29549":70597,"_20523":120325,"_5":14087,"_26884":120142,"_2862":120326},[],"**Crypto Engine**: motor que custodiará la clave importada.",{"_3376":70670,"_29549":70597,"_20523":120328,"_5":14087,"_26884":120142,"_2862":120329},[],"**Tags**: etiquetas para organización y búsqueda.",{"_3376":70671,"_29549":70597,"_20523":120331,"_5":14087,"_26884":120142,"_2862":120332},[],"**Metadata**: información adicional opcional.",{"_3376":70672,"_29549":70597,"_20523":120334,"_5":14087,"_26884":120142,"_2862":120335},[],"**Private Key (PEM)**: clave privada en formato PEM.",{"_3376":70673,"_29549":70597,"_20523":120337,"_5":14087,"_26884":120142,"_2862":120338},[],"Si la importación termina correctamente, abre el registro, comprueba motor y clave pública y realiza una firma de prueba. Una clave no exportable en un HSM no puede cargarse mediante este formulario PEM: configura el acceso al motor y comprueba cómo se registra la clave existente. Revisa dependencias y recursos que puedan haberse creado en el proveedor si una operación falla a mitad.",{"_3376":70674,"_29549":70597,"_20523":120340,"_5":14087,"_26884":120146,"_2862":120341},[],"Cada clave registrada dispone de una vista de detalle y de varias acciones operativas.",{"_3376":70675,"_29549":70597,"_20523":120343,"_5":14087,"_26884":120150,"_2862":120344},[],"La pantalla **View Details** concentra la información técnica y administrativa de la clave.",{"_3376":70676,"_29549":70597,"_20523":120346,"_5":14087,"_26884":120150,"_2862":120347},[],"En la pestaña **Overview** se muestran, entre otros, estos campos:",{"_3376":70677,"_29549":70597,"_20523":120349,"_5":14087,"_26884":120150,"_2862":120350},[],"**Key Name**: nombre descriptivo.",{"_3376":70678,"_29549":70597,"_20523":120352,"_5":14087,"_26884":120150,"_2862":120353},[],"**Key Identifier**: identificador único del sistema. Lamassu utiliza formatos de ID basados en PKCS11.",{"_3376":70679,"_29549":70597,"_20523":120355,"_5":14087,"_26884":120150,"_2862":120356},[],"**Tags**: etiquetas asociadas.",{"_3376":70680,"_29549":70597,"_20523":120358,"_5":14087,"_26884":120150,"_2862":120359},[],"**Aliases**: nombres alternativos.",{"_3376":70681,"_29549":70597,"_20523":120361,"_5":14087,"_26884":120150,"_2862":120362},[],"**Crypto Engine**: motor en el que reside la clave.",{"_3376":70682,"_29549":70597,"_20523":120364,"_5":14087,"_26884":120150,"_2862":120365},[],"**Algorithm, Key Size & Strength**: algoritmo, parámetros y nivel de fortaleza.",{"_3376":70683,"_29549":70597,"_20523":120367,"_5":14087,"_26884":120150,"_2862":120368},[],"La sección **Related Entities** muestra qué objetos de Lamassu dependen de esa clave.",{"_3376":70684,"_29549":70597,"_20523":120370,"_5":14087,"_26884":120150,"_2862":120371},[],"La pestaña **Public Key** muestra el material público en PEM. El identificador y la URI del registro sirven para localizar la clave; una URI con formato PKCS#11 no demuestra que el motor sea un HSM ni que exista un módulo local para acceder a ella.",{"_3376":70685,"_29549":70597,"_20523":120373,"_5":14087,"_26884":120154,"_2862":120374},[],"La acción **Sign / Verify** sirve para validar que la clave y el motor criptográfico funcionan correctamente.",{"_3376":70686,"_29549":70597,"_20523":120376,"_5":14087,"_26884":120154,"_2862":120377},[],"Firma un mensaje de prueba, guarda la firma y verifícala con la misma clave pública, algoritmo y codificación. Cambia después el mensaje: la verificación debe fallar. Esto comprueba una operación concreta; no certifica todas las capacidades del motor ni la cadena de una CA.",{"_3376":70687,"_29549":70597,"_20523":120379,"_5":14087,"_26884":120154,"_2862":120380},[],"Al abrirla aparecen dos áreas: **Sign** y **Verify**.",{"_3376":70688,"_29549":70597,"_20523":120382,"_5":14087,"_26884":120158,"_2862":120383},[],"Esta pestaña usa la clave privada para generar una firma digital sobre un mensaje o sobre un *digest* ya calculado.",{"_3376":70689,"_29549":70597,"_20523":120385,"_5":14087,"_26884":120158,"_2862":120386},[],"Campos principales:",{"_3376":70690,"_29549":70597,"_20523":120388,"_5":14087,"_26884":120158,"_2862":120389},[],"**Algorithm**: algoritmo de firma disponible para el tipo de clave.",{"_3376":70691,"_29549":70597,"_20523":120391,"_5":14087,"_26884":120158,"_2862":120392},[],"**Message Type**: `Raw` para datos en claro o `Digest` para un hash precalculado.",{"_3376":70692,"_29549":70597,"_20523":120394,"_5":14087,"_26884":120158,"_2862":120395},[],"**Payload Encoding**: codificación de entrada, como UTF-8, Hex o Base64.",{"_3376":70693,"_29549":70597,"_20523":120397,"_5":14087,"_26884":120158,"_2862":120398},[],"**Message**: contenido que se va a firmar.",{"_3376":70694,"_29549":70597,"_20523":120400,"_5":14087,"_26884":120158,"_2862":120401},[],"**Signature**: resultado de la operación, mostrado en hexadecimal.",{"_3376":70695,"_29549":70597,"_20523":120403,"_5":14087,"_26884":120161,"_2862":120404},[],"Esta pestaña comprueba si una firma corresponde a la clave pública asociada.",{"_3376":70696,"_29549":70597,"_20523":120406,"_5":14087,"_26884":120161,"_2862":120386},[],{"_3376":70697,"_29549":70597,"_20523":120408,"_5":14087,"_26884":120161,"_2862":120409},[],"**Algorithm**: debe coincidir con el algoritmo usado para la firma.",{"_3376":70698,"_29549":70597,"_20523":120411,"_5":14087,"_26884":120161,"_2862":120412},[],"**Message Type**: `Raw` o `Digest`.",{"_3376":70699,"_29549":70597,"_20523":120414,"_5":14087,"_26884":120161,"_2862":120415},[],"**Payload Encoding**: codificación del mensaje.",{"_3376":70700,"_29549":70597,"_20523":120417,"_5":14087,"_26884":120161,"_2862":120418},[],"**Message**: mensaje original o hash.",{"_3376":70701,"_29549":70597,"_20523":120420,"_5":14087,"_26884":120161,"_2862":120421},[],"**Signature**: firma que se desea comprobar.",{"_3376":70702,"_29549":70597,"_20523":120423,"_5":14087,"_26884":120161,"_2862":120424},[],"**Result**: indicador del resultado de la validación.",{"_3376":70703,"_29549":70597,"_20523":120426,"_5":14087,"_26884":120164,"_2862":120427},[],"La acción **Generate CSR** crea una solicitud PKCS#10 firmada con la clave privada custodiada en Lamassu, sin exponerla fuera del motor criptográfico.",{"_3376":70704,"_29549":70597,"_20523":120429,"_5":14087,"_26884":120164,"_2862":120430},[],"Este flujo es útil para:",{"_3376":70705,"_29549":70597,"_20523":120432,"_5":14087,"_26884":120164,"_2862":120433},[],"Solicitar certificados a una CA externa.",{"_3376":70706,"_29549":70597,"_20523":120435,"_5":14087,"_26884":120164,"_2862":120436},[],"Renovar una identidad manteniendo la misma clave.",{"_3376":70707,"_29549":70597,"_20523":120438,"_5":14087,"_26884":120164,"_2862":120439},[],"Al abrir el formulario se solicitan los datos del sujeto y los atributos principales del certificado:",{"_3376":70708,"_29549":70597,"_20523":120441,"_5":14087,"_26884":120164,"_2862":120442},[],"**Common Name (CN)**: nombre principal de la identidad.",{"_3376":70709,"_29549":70597,"_20523":120444,"_5":14087,"_26884":120164,"_2862":120445},[],"**Organization (O)**: organización o empresa.",{"_3376":70710,"_29549":70597,"_20523":120447,"_5":14087,"_26884":120164,"_2862":120448},[],"**Organizational Unit (OU)**: departamento o unidad.",{"_3376":70711,"_29549":70597,"_20523":120450,"_5":14087,"_26884":120164,"_2862":120451},[],"**Country (C)**: código de país de dos letras.",{"_3376":70712,"_29549":70597,"_20523":120453,"_5":14087,"_26884":120164,"_2862":120454},[],"**State / Province (ST)**: estado o provincia.",{"_3376":70713,"_29549":70597,"_20523":120456,"_5":14087,"_26884":120164,"_2862":120457},[],"**Locality (L)**: ciudad o localidad.",{"_3376":70714,"_29549":70597,"_20523":120459,"_5":14087,"_26884":120164,"_2862":120460},[],"**Email Address**: correo de contacto.",{"_3376":70715,"_29549":70597,"_20523":120462,"_5":14087,"_26884":120164,"_2862":120463},[],"**Subject Alternative Names (SANs)**: nombres o identificadores alternativos, como DNS o IP.",{"_3376":70716,"_29549":70597,"_20523":120465,"_5":14087,"_26884":120164,"_2862":120466},[],"Descarga la CSR y ejecuta `openssl req -in request.csr -noout -verify -text`. Comprueba firma, sujeto y SAN antes de enviarla. La CSR no determina por sí sola el certificado final: la política de emisión puede sustituir sus campos.",{"_3376":70717,"_29549":70597,"_20523":120468,"_5":14087,"_26884":120168,"_2862":120469},[],"Lamassu también ofrece una ayuda específica para integraciones locales mediante **Sign locally with OpenSSL & PKCS11 tools**.",{"_3376":70718,"_29549":70597,"_20523":120471,"_5":14087,"_26884":120168,"_2862":120472},[],"Requiere el módulo, token y permisos del proveedor correspondiente. Comprueba que el identificador de Lamassu se corresponde con el objeto accesible desde ese módulo. La configuración del módulo pertenece al entorno del cliente o al Despliegue.",{"_3376":70719,"_29549":70597,"_20523":120474,"_5":14087,"_26884":120172,"_2862":120475},[],"Revisa **Related Entities** y localiza CAs, certificados y procesos de validación que siguen necesitando firmas. Revocar una CA no elimina la necesidad de publicar estado durante su periodo de retención. Eliminar una clave tampoco revoca automáticamente sus certificados. Planifica sustitución y retención antes de usar **Delete Key**; el efecto de borrado en el proveedor depende del motor.",{"_3376":70720,"_29549":70597,"_20523":120477,"_5":14087,"_26884":120172,"_2862":120478},[],"El KMS se niega a eliminar una clave que todavía está referenciada por certificados. Eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados, y después intenta eliminar la clave. Si otros certificados todavía la referencian, como los de otra CA que la comparte, el KMS la conserva. Revocar los certificados emitidos por la CA eliminada no libera sus propias referencias a claves. La guía de actualización describe las referencias heredadas que conserva la migración.",{"_3376":70721,"_29549":70721,"_5":14445,"_2862":120480,"_29881":120481,"_20523":120482,"_26884":70721},"Validación online con OCSP",[48111,114818,53588,119331],[],{"_3376":70722,"_29549":70721,"_20523":120484,"_5":14087,"_26884":70721,"_2862":120485},[],"Consulta el estado firmado y verifica la respuesta del respondedor.",{"_3376":70723,"_29549":70721,"_5":29878,"_20523":120487,"_26884":120488,"_2862":120489},[],"/docs/es/platform/pki/ocsp#cómo-funciona-el-respondedor-en-lamassu","Cómo funciona el respondedor en Lamassu",{"_3376":70724,"_29549":70721,"_5":29878,"_20523":120491,"_26884":120492,"_2862":120493},[],"/docs/es/platform/pki/ocsp#enlace-en-los-certificados-emitidos","Enlace en los certificados emitidos",{"_3376":70725,"_29549":70721,"_5":29878,"_20523":120495,"_26884":120496,"_2862":120497},[],"/docs/es/platform/pki/ocsp#endpoints-http","Endpoints HTTP",{"_3376":70726,"_29549":70721,"_5":29878,"_20523":120499,"_26884":120500,"_2862":120501},[],"/docs/es/platform/pki/ocsp#genera-y-verifica-una-consulta","Genera y verifica una consulta",{"_3376":70727,"_29549":70721,"_5":29878,"_20523":120503,"_26884":120504,"_2862":120505},[],"/docs/es/platform/pki/ocsp#comprobación-desde-la-interfaz","Comprobación desde la interfaz",{"_3376":70728,"_29549":70721,"_5":29878,"_20523":120507,"_26884":120508,"_2862":119883},[],"/docs/es/platform/pki/ocsp#referencias",{"_3376":70729,"_29549":70721,"_20523":120510,"_5":14087,"_26884":70721,"_2862":120511},[],"OCSP permite consultar el estado de un certificado y obtener una respuesta firmada. Esta guía sirve al integrador que necesita comprobar qué publica Lamassu y cómo debe verificarlo el consumidor. Para la validación completa de una identidad, sigue Validación de certificados.",{"_3376":70730,"_29549":70721,"_20523":120513,"_5":14087,"_26884":120488,"_2862":120514},[],"El respondedor obtiene el certificado por número de serie y localiza su CA emisora en el inventario. Traduce el estado persistido así:",{"_3376":70731,"_29549":70721,"_20523":120516,"_5":14087,"_26884":120488,"_2862":120517},[],"Estado del registro",{"_3376":70732,"_29549":70721,"_20523":120519,"_5":14087,"_26884":120488,"_2862":120520},[],"Respuesta firmada",{"_3376":70733,"_29549":70721,"_20523":120522,"_5":14087,"_26884":120488,"_2862":52759},[],{"_3376":70734,"_29549":70721,"_20523":120524,"_5":14087,"_26884":120488,"_2862":55435},[],{"_3376":70735,"_29549":70721,"_20523":120526,"_5":14087,"_26884":120488,"_2862":52776},[],{"_3376":70736,"_29549":70721,"_20523":120528,"_5":14087,"_26884":120488,"_2862":120529},[],"`Revoked`, con razón y fecha de revocación.",{"_3376":70737,"_29549":70721,"_20523":120531,"_5":14087,"_26884":120488,"_2862":120532},[],"Otros estados, incluidos `INACTIVE` y `EXPIRED`",{"_3376":70738,"_29549":70721,"_20523":120534,"_5":14087,"_26884":120488,"_2862":120535},[],"`Unknown` si puede obtener el certificado y su emisor.",{"_3376":70739,"_29549":70721,"_20523":120537,"_5":14087,"_26884":120488,"_2862":120538},[],"Un número de serie ausente provoca un error de búsqueda; no garantiza una respuesta firmada `Unknown`. Los errores de búsqueda o firma se devuelven como fallo HTTP. Trata ese fallo como falta de evidencia, según la política del consumidor.",{"_3376":70740,"_29549":70721,"_20523":120540,"_5":14087,"_26884":120488,"_2862":120541},[],"La propia CA emisora firma la respuesta mediante su clave asociada al KMS. No se utiliza un certificado delegado de firma OCSP. Una CA importada sin clave utilizable no puede firmar respuestas.",{"_3376":70741,"_29549":70721,"_20523":120543,"_5":14087,"_26884":120488,"_2862":120544},[],"La implementación establece `thisUpdate` aproximadamente un día antes de generar la respuesta y `nextUpdate` un día después: la ventana declarada es de unas 48 horas. Inspecciona los valores recibidos y aplica tu política de vigencia. La respuesta refleja el estado almacenado al consultarla; una copia anterior en caché no cambia al revocar.",{"_3376":70742,"_29549":70721,"_20523":120546,"_5":14087,"_26884":120492,"_2862":120547},[],"El firmador construye las URLs OCSP a partir de los dominios VA configurados y las añade a AIA. Si no hay dominios, no hay URL que añadir; un certificado importado conserva sus extensiones originales. Revisa el certificado real:",{"_3376":70743,"_29549":70721,"_20523":120549,"_5":14087,"_26884":120492,"_2862":120550},[],"Comprueba que esa URL es accesible desde el consumidor. DNS, exposición del endpoint y configuración de dominios pertenecen a Despliegue. Cambiar esa configuración no modifica certificados ya firmados.",{"_3376":70744,"_29549":70721,"_20523":120552,"_5":14087,"_26884":120496,"_2862":120553},[],"El servicio acepta:",{"_3376":70745,"_29549":70721,"_20523":120555,"_5":14087,"_26884":120496,"_2862":116545},[],{"_3376":70746,"_29549":70721,"_20523":120557,"_5":14087,"_26884":120496,"_2862":120558},[],"Ruta del servicio VA",{"_3376":70747,"_29549":70721,"_20523":120560,"_5":14087,"_26884":120496,"_2862":120561},[],"Formato",{"_3376":70748,"_29549":70721,"_20523":120563,"_5":14087,"_26884":120496,"_2862":55475},[],{"_3376":70749,"_29549":70721,"_20523":120565,"_5":14087,"_26884":120496,"_2862":55478},[],{"_3376":70750,"_29549":70721,"_20523":120567,"_5":14087,"_26884":120496,"_2862":120568},[],"Solicitud DER, `Content-Type: application/ocsp-request`.",{"_3376":70751,"_29549":70721,"_20523":120570,"_5":14087,"_26884":120496,"_2862":54904},[],{"_3376":70752,"_29549":70721,"_20523":120572,"_5":14087,"_26884":120496,"_2862":55486},[],{"_3376":70753,"_29549":70721,"_20523":120574,"_5":14087,"_26884":120496,"_2862":120575},[],"Solicitud DER codificada en Base64 URL con padding.",{"_3376":70754,"_29549":70721,"_20523":120577,"_5":14087,"_26884":120496,"_2862":120578},[],"Utiliza POST para evitar diferencias de codificación entre clientes. La respuesta correcta tiene `Content-Type: application/ocsp-response` y cuerpo DER. El prefijo público depende del Gateway; utiliza la URL publicada en el certificado y comprobada por el operador.",{"_3376":70755,"_29549":70721,"_20523":120580,"_5":14087,"_26884":120500,"_2862":120581},[],"Necesitas OpenSSL 3.x, `device.crt`, el certificado de su emisor directo `issuer.pem` y las raíces confiables del consumidor en `roots.pem`. Si el emisor es intermedio, prepara además `intermediates.pem` con las CAs intermedias.",{"_3376":70756,"_29549":70721,"_20523":120583,"_5":14087,"_26884":120500,"_2862":120584},[],"Genera la solicitud:",{"_3376":70757,"_29549":70721,"_20523":120586,"_5":14087,"_26884":120500,"_2862":120587},[],"Este ejemplo omite el nonce porque el respondedor no lo devuelve. La verificación depende de firma, correspondencia de la respuesta y tiempos; no demuestra frescura mediante un nonce.",{"_3376":70758,"_29549":70721,"_20523":120589,"_5":14087,"_26884":120500,"_2862":120590},[],"Sustituye la URL de ejemplo por el endpoint inspeccionado:",{"_3376":70759,"_29549":70721,"_20523":120592,"_5":14087,"_26884":120500,"_2862":120593},[],"Verifica el DER recibido:",{"_3376":70760,"_29549":70721,"_20523":120595,"_5":14087,"_26884":120500,"_2862":120596},[],"Si hay intermedias, añade `-verify_other intermediates.pem`. Exige verificación correcta de la respuesta y comprueba el estado correspondiente a `device.crt`, emisor, serie, `thisUpdate` y `nextUpdate`. Un resultado `Response verify OK` solo valida la respuesta: también debes observar `good`, `revoked` o `unknown`. No aceptes una identidad basándote únicamente en el código de salida del comando.",{"_3376":70761,"_29549":70721,"_20523":120598,"_5":14087,"_26884":120504,"_2862":120599},[],"**OCSP Check** permite observar lo que responde Lamassu para un certificado seleccionado. Completa la comprobación desde la red y el almacén de confianza del consumidor: la consulta de la consola no prueba su configuración de validación.",{"_3376":70762,"_29549":70721,"_20523":120601,"_5":14087,"_26884":120504,"_2862":120602},[],"Para comprobar un cambio, guarda una respuesta anterior, revoca un certificado de prueba y solicita otra. La consulta nueva debe reflejar el estado persistido; compara los tiempos para descartar reutilización de una respuesta anterior. Si falla, sigue Diagnóstico PKI.",{"_3376":70763,"_29549":70721,"_20523":120604,"_5":14087,"_26884":120508,"_2862":55519},[],{"_3376":70764,"_29549":70721,"_20523":120606,"_5":14087,"_26884":120508,"_2862":55522},[],{"_3376":70765,"_29549":70721,"_20523":120608,"_5":14087,"_26884":120508,"_2862":120609},[],"<Card title=\"Servicio CRL\" href=\"/docs/platform/pki/crl\" />",{"_3376":70766,"_29549":70721,"_20523":120611,"_5":14087,"_26884":120508,"_2862":120094},[],{"_3376":70767,"_29549":70767,"_5":14445,"_2862":53588,"_29881":120613,"_20523":120614,"_26884":70767},[48111,114818,53588],[],{"_3376":70768,"_29549":70767,"_20523":120616,"_5":14087,"_26884":70767,"_2862":120617},[],"Administra claves y autoridades, define la emisión y verifica los certificados resultantes.",{"_3376":70769,"_29549":70767,"_5":29878,"_20523":120619,"_26884":120620,"_2862":118026},[],"/docs/es/platform/pki/overview#empieza-aquí",{"_3376":70770,"_29549":70767,"_5":29878,"_20523":120622,"_26884":120623,"_2862":120624},[],"/docs/es/platform/pki/overview#qué-necesitas","Qué necesitas",{"_3376":70771,"_29549":70767,"_5":29878,"_20523":120626,"_26884":120627,"_2862":118546},[],"/docs/es/platform/pki/overview#capacidades-principales",{"_3376":70772,"_29549":70767,"_5":29878,"_20523":120629,"_26884":120630,"_2862":118550},[],"/docs/es/platform/pki/overview#construye-tu-jerarquía-de-confianza",{"_3376":70773,"_29549":70767,"_5":29878,"_20523":120632,"_26884":120633,"_2862":118554},[],"/docs/es/platform/pki/overview#protege-las-claves-criptográficas",{"_3376":70774,"_29549":70767,"_5":29878,"_20523":120635,"_26884":120636,"_2862":118558},[],"/docs/es/platform/pki/overview#emite-y-controla-certificados",{"_3376":70775,"_29549":70767,"_5":29878,"_20523":120638,"_26884":120639,"_2862":118566},[],"/docs/es/platform/pki/overview#publica-el-estado-de-validación",{"_3376":70776,"_29549":70767,"_5":29878,"_20523":120641,"_26884":120642,"_2862":120643},[],"/docs/es/platform/pki/overview#cómo-comprobar-el-resultado","Cómo comprobar el resultado",{"_3376":70777,"_29549":70767,"_5":29878,"_20523":120645,"_26884":120646,"_2862":119497},[],"/docs/es/platform/pki/overview#continúa",{"_3376":70778,"_29549":70767,"_20523":120648,"_5":14087,"_26884":70767,"_2862":120649},[],"El bloque PKI explica cómo construir y operar la confianza X.509 de Lamassu: qué autoridades emiten, qué reglas aplican y cómo se comprueban los certificados. Está dirigido al administrador PKI y a quien necesita utilizar certificados en un sistema consumidor.",{"_3376":70779,"_29549":70767,"_20523":120651,"_5":14087,"_26884":120620,"_2862":120652},[],"Sigue Primeros pasos de PKI para crear una CA, emitir un certificado de cliente y verificarlo con OpenSSL. El resultado es un certificado, su clave privada y una cadena comprobada.",{"_3376":70780,"_29549":70767,"_20523":120654,"_5":14087,"_26884":120620,"_2862":120655},[],"Puedes completar ese recorrido antes de gestionar dispositivos. Cuando necesites asociar la identidad a un inventario o automatizar su enrolamiento, continúa en IoT Fleets.",{"_3376":70781,"_29549":70767,"_20523":120657,"_5":14087,"_26884":120623,"_2862":120658},[],"Una instancia accesible y permisos para gestionar las claves, CAs y certificados que usarás.",{"_3376":70782,"_29549":70767,"_20523":120660,"_5":14087,"_26884":120623,"_2862":120661},[],"Un motor criptográfico disponible para custodiar la clave de la autoridad.",{"_3376":70783,"_29549":70767,"_20523":120663,"_5":14087,"_26884":120623,"_2862":120664},[],"El propósito del certificado: por ejemplo, autenticar un cliente mediante mTLS.",{"_3376":70784,"_29549":70767,"_20523":120666,"_5":14087,"_26884":120623,"_2862":120667},[],"Los requisitos del consumidor: emisores aceptados, algoritmos, nombres y usos permitidos.",{"_3376":70785,"_29549":70767,"_20523":120669,"_5":14087,"_26884":120623,"_2862":120670},[],"La configuración de la instancia y del proveedor criptográfico se prepara en Despliegue. La elección de jerarquía se explica en el modelo de confianza.",{"_3376":70786,"_29549":70767,"_20523":120672,"_5":14087,"_26884":120630,"_2862":120673},[],"Las autoridades firman certificados. Una raíz establece el ancla de confianza y una intermedia permite separar la emisión por entorno o propósito. La jerarquía y rotación explica cómo mantener esa confianza al sustituir una autoridad.",{"_3376":70787,"_29549":70767,"_20523":120675,"_5":14087,"_26884":120633,"_2862":120676},[],"Las claves de firma de las CAs se gestionan mediante KMS y motores criptográficos. La clave de un cliente que genera una CSR puede permanecer en ese cliente: conserva su custodia al elegir el método de emisión.",{"_3376":70788,"_29549":70767,"_20523":120678,"_5":14087,"_26884":120636,"_2862":120679},[],"Un perfil establece restricciones de sujeto, validez, usos y claves. La CA aplica la configuración de emisión y firma el certificado. En el inventario puedes inspeccionar el resultado, descargarlo y gestionar su estado.",{"_3376":70789,"_29549":70767,"_20523":120681,"_5":14087,"_26884":120639,"_2862":120682},[],"La validación reúne cadena, vigencia, usos y estado de revocación. Lamassu publica estado mediante OCSP y CRL; el consumidor configura qué emisores reconoce y cómo comprueba ese estado.",{"_3376":70790,"_29549":70767,"_20523":120684,"_5":14087,"_26884":120642,"_2862":120685},[],"Un certificado activo en la consola es una parte de la comprobación. Revisa también que:",{"_3376":70791,"_29549":70767,"_20523":120687,"_5":14087,"_26884":120642,"_2862":120688},[],"su sujeto y sus extensiones identifiquen al cliente esperado;",{"_3376":70792,"_29549":70767,"_20523":120690,"_5":14087,"_26884":120642,"_2862":120691},[],"su clave pública corresponda a la clave privada del cliente;",{"_3376":70793,"_29549":70767,"_20523":120693,"_5":14087,"_26884":120642,"_2862":120694},[],"su cadena alcance una raíz confiable para el consumidor;",{"_3376":70794,"_29549":70767,"_20523":120696,"_5":14087,"_26884":120642,"_2862":120697},[],"sus fechas y usos permitan la operación;",{"_3376":70795,"_29549":70767,"_20523":120699,"_5":14087,"_26884":120642,"_2862":120700},[],"el consumidor aplique la comprobación de revocación y su autorización.",{"_3376":70796,"_29549":70767,"_20523":120702,"_5":14087,"_26884":120642,"_2862":120703},[],"El recorrido de emisión incluye las primeras comprobaciones independientes.",{"_3376":70797,"_29549":70767,"_20523":120705,"_5":14087,"_26884":120646,"_2862":120706},[],"<Card title=\"Primeros pasos de PKI\" description=\"Crea una CA y emite y verifica un certificado de cliente.\" href=\"/docs/platform/pki/quickstarts/overview\" />",{"_3376":70798,"_29549":70767,"_20523":120708,"_5":14087,"_26884":120646,"_2862":120709},[],"<Card title=\"Aplica la PKI a dispositivos\" description=\"Asocia certificados al inventario y prepara el enrolamiento.\" href=\"/docs/platform/iot-fleets/overview\" />",{"_3376":70799,"_29549":70767,"_20523":120711,"_5":14087,"_26884":120646,"_2862":120712},[],"<Card title=\"Diagnóstico PKI\" description=\"Comprueba emisión, OCSP y CRL cuando el resultado falla.\" href=\"/docs/platform/pki/troubleshooting\" />",{"_3376":70800,"_29549":70800,"_5":14445,"_2862":120714,"_29881":120715,"_20523":120716,"_26884":70800},"Crea tu primera CA",[48111,114818,53588,118150],[],{"_3376":70801,"_29549":70800,"_20523":120718,"_5":14087,"_26884":70800,"_2862":120719},[],"Crea una raíz de evaluación y comprueba su certificado antes de emitir.",{"_3376":70802,"_29549":70800,"_5":29878,"_20523":120721,"_26884":120722,"_2862":113396},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#antes-de-empezar",{"_3376":70803,"_29549":70800,"_5":29878,"_20523":120724,"_26884":120725,"_2862":120726},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#abre-el-asistente-de-creación-toc","Abre el asistente de creación [!toc]",{"_3376":70804,"_29549":70800,"_5":29878,"_20523":120728,"_26884":120729,"_2862":120730},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#selecciona-la-clave-toc","Selecciona la clave [!toc]",{"_3376":70805,"_29549":70800,"_5":29878,"_20523":120732,"_26884":120733,"_2862":120734},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#define-la-autoridad-toc","Define la autoridad [!toc]",{"_3376":70806,"_29549":70800,"_5":29878,"_20523":120736,"_26884":120737,"_2862":120738},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#revisa-y-crea-la-ca-toc","Revisa y crea la CA [!toc]",{"_3376":70807,"_29549":70800,"_5":29878,"_20523":120740,"_26884":120741,"_2862":120742},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#verifica-el-resultado-toc","Verifica el resultado [!toc]",{"_3376":70808,"_29549":70800,"_5":29878,"_20523":120744,"_26884":120745,"_2862":120746},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#comprueba-el-certificado-de-ca","Comprueba el certificado de CA",{"_3376":70809,"_29549":70800,"_5":29878,"_20523":120748,"_26884":120749,"_2862":118397},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#si-el-resultado-falla",{"_3376":70810,"_29549":70800,"_5":29878,"_20523":120751,"_26884":120752,"_2862":113420},[],"/docs/es/platform/pki/quickstarts/create-certificate-authority#siguiente-paso",{"_3376":70811,"_29549":70800,"_20523":120754,"_5":14087,"_26884":70800,"_2862":120755},[],"Crearás una autoridad raíz con una clave nueva custodiada por un motor de Lamassu. Al terminar tendrás una CA activa y su certificado público en `ca.pem`, preparado para verificar la emisión del siguiente recorrido.",{"_3376":70812,"_29549":70800,"_20523":120757,"_5":14087,"_26884":120722,"_2862":120758},[],"Acceso a la consola y permisos para crear claves y autoridades.",{"_3376":70813,"_29549":70800,"_20523":120760,"_5":14087,"_26884":120722,"_2862":120761},[],"Un motor criptográfico disponible que admita el algoritmo elegido.",{"_3376":70814,"_29549":70800,"_20523":120763,"_5":14087,"_26884":120722,"_2862":120764},[],"OpenSSL 3.x para comprobar el certificado descargado.",{"_3376":70815,"_29549":70800,"_20523":120766,"_5":14087,"_26884":120722,"_2862":120767},[],"Utiliza una instancia de evaluación o una autoridad destinada a estas pruebas. El ejemplo crea una raíz que emite directamente; para diseñar una jerarquía operativa, consulta Jerarquía y rotación.",{"_3376":70816,"_29549":70800,"_20523":120769,"_5":14087,"_26884":120725,"_2862":120770},[],"En **Certification Authorities**, selecciona **Create New CA** y elige crear una CA con un par de claves nuevo.",{"_3376":70817,"_29549":70800,"_20523":120772,"_5":14087,"_26884":120725,"_2862":120773},[],"El flujo &#x2A;*Create New CA (Existing Key)** se explica en la guía de autoridades.",{"_3376":70818,"_29549":70800,"_20523":120775,"_5":14087,"_26884":120729,"_2862":120776},[],"Elige el motor que custodiará la clave y un algoritmo permitido por sus capacidades. Para este ejemplo puedes utilizar **EC P-384** si está disponible.",{"_3376":70819,"_29549":70800,"_20523":120778,"_5":14087,"_26884":120729,"_2862":120779},[],"La clave privada de la CA se utiliza a través del motor. En este recorrido descargarás únicamente el certificado público de la autoridad.",{"_3376":70820,"_29549":70800,"_20523":120781,"_5":14087,"_26884":120733,"_2862":120782},[],"Selecciona **Root CA** y completa:",{"_3376":70821,"_29549":70800,"_20523":120784,"_5":14087,"_26884":120733,"_2862":55701},[],{"_3376":70822,"_29549":70800,"_20523":120786,"_5":14087,"_26884":120733,"_2862":120787},[],"**Subject**: los datos de organización y país de tu evaluación.",{"_3376":70823,"_29549":70800,"_20523":120789,"_5":14087,"_26884":120733,"_2862":120790},[],"**CA Certificate Expiration**: por ejemplo, un año desde la creación.",{"_3376":70824,"_29549":70800,"_20523":120792,"_5":14087,"_26884":120733,"_2862":120793},[],"**Default End-Entity Certificate Issuance Expiration**: por ejemplo, 90 días, dentro de la vigencia de la CA.",{"_3376":70825,"_29549":70800,"_20523":120795,"_5":14087,"_26884":120733,"_2862":120796},[],"El nombre de la CA se utilizará como `Common Name`. Mantén los usos de CA necesarios para firmar certificados y CRLs.",{"_3376":70826,"_29549":70800,"_20523":120798,"_5":14087,"_26884":120737,"_2862":120799},[],"Comprueba motor, algoritmo, sujeto, tipo raíz y fechas. Confirma la creación y anota el identificador de la autoridad para reconocerla en el DMS o en la API.",{"_3376":70827,"_29549":70800,"_20523":120801,"_5":14087,"_26884":120741,"_2862":120802},[],"Abre la nueva CA. Debe aparecer activa, mostrar su certificado y permitir acceder a **Issued Certificates**.",{"_3376":70828,"_29549":70800,"_20523":120804,"_5":14087,"_26884":120741,"_2862":120805},[],"Descarga o copia el certificado PEM de la autoridad y guárdalo como `ca.pem`. Comprueba que el archivo contiene el bloque completo, incluidos `BEGIN CERTIFICATE` y `END CERTIFICATE`.",{"_3376":70829,"_29549":70800,"_20523":120807,"_5":14087,"_26884":120745,"_2862":120808},[],"Ejecuta desde el directorio donde guardaste `ca.pem`:",{"_3376":70830,"_29549":70800,"_20523":120810,"_5":14087,"_26884":120745,"_2862":120811},[],"Comprueba que sujeto y emisor corresponden a la raíz creada, las fechas incluyen el momento actual, **Basic Constraints** contiene `CA:TRUE` y **Key Usage** permite firmar certificados. El último comando debe devolver `ca.pem: OK`.",{"_3376":70831,"_29549":70800,"_20523":120813,"_5":14087,"_26884":120745,"_2862":120814},[],"Has elegido explícitamente `ca.pem` como ancla de esta prueba. Que la autofirma sea válida no instala esa confianza en otros consumidores. Consulta la referencia de openssl-verify para las opciones de comprobación.",{"_3376":70832,"_29549":70800,"_20523":120816,"_5":14087,"_26884":120749,"_2862":120817},[],"Si la creación falla, comprueba permisos, disponibilidad del motor y algoritmo seleccionado.",{"_3376":70833,"_29549":70800,"_20523":120819,"_5":14087,"_26884":120749,"_2862":120820},[],"Si OpenSSL no lee el archivo, vuelve a copiar el bloque PEM completo.",{"_3376":70834,"_29549":70800,"_20523":120822,"_5":14087,"_26884":120749,"_2862":120823},[],"Si fallan la firma o las fechas, revisa que hayas descargado el certificado de esta CA y que el reloj del equipo sea correcto.",{"_3376":70835,"_29549":70800,"_20523":120825,"_5":14087,"_26884":120749,"_2862":120826},[],"El diagnóstico PKI reúne las comprobaciones de emisión y dependencias criptográficas.",{"_3376":70836,"_29549":70800,"_20523":120828,"_5":14087,"_26884":120752,"_2862":120829},[],"Continúa con Emite y verifica un certificado, utilizando esta autoridad y `ca.pem`.",{"_3376":70837,"_29549":70837,"_5":14445,"_2862":120831,"_29881":120832,"_20523":120833,"_26884":70837},"Emite y verifica un certificado",[48111,114818,53588,118150],[],{"_3376":70838,"_29549":70837,"_20523":120835,"_5":14087,"_26884":70837,"_2862":120836},[],"Emite un certificado de cliente y comprueba contenido, cadena y correspondencia de clave.",{"_3376":70839,"_29549":70837,"_5":29878,"_20523":120838,"_26884":120839,"_2862":113396},[],"/docs/es/platform/pki/quickstarts/issue-certificate#antes-de-empezar",{"_3376":70840,"_29549":70837,"_5":29878,"_20523":120841,"_26884":120842,"_2862":120843},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inicia-la-emisión","Inicia la emisión",{"_3376":70841,"_29549":70837,"_5":29878,"_20523":120845,"_26884":120846,"_2862":120847},[],"/docs/es/platform/pki/quickstarts/issue-certificate#elige-el-método","Elige el método",{"_3376":70842,"_29549":70837,"_5":29878,"_20523":120849,"_26884":120850,"_2862":120851},[],"/docs/es/platform/pki/quickstarts/issue-certificate#identifica-el-certificado","Identifica el certificado",{"_3376":70843,"_29549":70837,"_5":29878,"_20523":120853,"_26884":120854,"_2862":120855},[],"/docs/es/platform/pki/quickstarts/issue-certificate#configura-clave-y-usos","Configura clave y usos",{"_3376":70844,"_29549":70837,"_5":29878,"_20523":120857,"_26884":120858,"_2862":120859},[],"/docs/es/platform/pki/quickstarts/issue-certificate#emite-y-descarga","Emite y descarga",{"_3376":70845,"_29549":70837,"_5":29878,"_20523":120861,"_26884":120862,"_2862":120863},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-el-resultado","Verifica el resultado",{"_3376":70846,"_29549":70837,"_5":29878,"_20523":120865,"_26884":120866,"_2862":120867},[],"/docs/es/platform/pki/quickstarts/issue-certificate#inspecciona-contenido-y-fechas","Inspecciona contenido y fechas",{"_3376":70847,"_29549":70837,"_5":29878,"_20523":120869,"_26884":120870,"_2862":120871},[],"/docs/es/platform/pki/quickstarts/issue-certificate#verifica-la-cadena","Verifica la cadena",{"_3376":70848,"_29549":70837,"_5":29878,"_20523":120873,"_26884":120874,"_2862":120875},[],"/docs/es/platform/pki/quickstarts/issue-certificate#comprueba-que-la-clave-corresponde","Comprueba que la clave corresponde",{"_3376":70849,"_29549":70837,"_5":29878,"_20523":120877,"_26884":120878,"_2862":118397},[],"/docs/es/platform/pki/quickstarts/issue-certificate#si-el-resultado-falla",{"_3376":70850,"_29549":70837,"_5":29878,"_20523":120880,"_26884":120881,"_2862":113420},[],"/docs/es/platform/pki/quickstarts/issue-certificate#siguiente-paso",{"_3376":70851,"_29549":70837,"_20523":120883,"_5":14087,"_26884":70837,"_2862":120884},[],"Emitirás un certificado final para `device-001` mediante el flujo de generación de clave y CSR en el navegador. Al terminar conservarás `device.crt`, `device.key` y el certificado público de la raíz emisora, `ca.pem`.",{"_3376":70852,"_29549":70837,"_20523":120886,"_5":14087,"_26884":120839,"_2862":120887},[],"Una CA raíz activa con clave de firma disponible y permisos para emitir. Si todavía no existe, sigue Crea tu primera CA.",{"_3376":70853,"_29549":70837,"_20523":120889,"_5":14087,"_26884":120839,"_2862":120890},[],"Su certificado público en `ca.pem`; este ejemplo utiliza la raíz creada en el recorrido anterior.",{"_3376":70854,"_29549":70837,"_20523":120892,"_5":14087,"_26884":120839,"_2862":120893},[],"OpenSSL 3.x y un directorio de trabajo con acceso restringido.",{"_3376":70855,"_29549":70837,"_20523":120895,"_5":14087,"_26884":120839,"_2862":120896},[],"Un identificador para el cliente: aquí usaremos `device-001`.",{"_3376":70856,"_29549":70837,"_20523":120898,"_5":14087,"_26884":120839,"_2862":120899},[],"En este flujo la clave del cliente se genera en el navegador y debes descargarla al finalizar. Si la pierdes, tendrás que generar una clave y emitir otro certificado. El inventario de certificados permite descargar el certificado público, pero no recuperar esta clave.",{"_3376":70857,"_29549":70837,"_20523":120901,"_5":14087,"_26884":120842,"_2862":120902},[],"Abre la CA del recorrido anterior, entra en **Issued Certificates** y selecciona **Issue New**.",{"_3376":70858,"_29549":70837,"_20523":120904,"_5":14087,"_26884":120846,"_2862":120905},[],"Selecciona **Generate Key & CSR in Browser** para seguir este ejemplo.",{"_3376":70859,"_29549":70837,"_20523":120907,"_5":14087,"_26884":120846,"_2862":120908},[],"Si la clave debe generarse y permanecer en el sistema de destino, utiliza **Upload Existing CSR**, descrito en la guía de autoridades.",{"_3376":70860,"_29549":70837,"_20523":120910,"_5":14087,"_26884":120850,"_2862":120911},[],"Introduce `device-001` como `Common Name`. Añade los datos de sujeto requeridos por tu política y SANs si el consumidor los utiliza para identificar al cliente.",{"_3376":70861,"_29549":70837,"_20523":120913,"_5":14087,"_26884":120850,"_2862":120914},[],"Si vas a continuar con el registro manual, el `Device ID` será exactamente `device-001`.",{"_3376":70862,"_29549":70837,"_20523":120916,"_5":14087,"_26884":120854,"_2862":120917},[],"Elige un algoritmo y tamaño admitidos por el perfil; por ejemplo, ECDSA P-256 si está permitido. Para este certificado de cliente, selecciona **Digital Signature** y **Client Authentication** y emite como certificado final.",{"_3376":70863,"_29549":70837,"_20523":120919,"_5":14087,"_26884":120854,"_2862":120920},[],"Solicita, por ejemplo, 30 días de validez, siempre dentro de la vigencia de la CA. Revisa el perfil de emisión si el contenido resultante difiere de lo solicitado.",{"_3376":70864,"_29549":70837,"_20523":120922,"_5":14087,"_26884":120858,"_2862":120923},[],"Confirma la emisión. Guarda el certificado PEM como `device.crt` y la clave privada como `device.key` en el directorio preparado.",{"_3376":70865,"_29549":70837,"_20523":120925,"_5":14087,"_26884":120862,"_2862":120926},[],"Comprueba en **Issued Certificates** que el certificado aparece activo. Anota su número de serie y verifica el material descargado con las comprobaciones siguientes.",{"_3376":70866,"_29549":70837,"_20523":120928,"_5":14087,"_26884":120866,"_2862":120929},[],"Comprueba `CN=device-001`, el emisor esperado, fechas vigentes, **Digital Signature** y el uso extendido **TLS Web Client Authentication**. Debe ser un certificado final: no debe declarar `CA:TRUE` ni habilitar **Certificate Sign**. Si **Basic Constraints** está presente, debe indicar `CA:FALSE`. Si solicitaste SANs, revisa que los identificadores esperados aparezcan en el certificado.",{"_3376":70867,"_29549":70837,"_20523":120931,"_5":14087,"_26884":120870,"_2862":120932},[],"El resultado esperado es `device.crt: OK`. Esta comprobación utiliza tu raíz explícita y evalúa la cadena, las fechas y la compatibilidad con el propósito de cliente TLS. La presencia de los usos y nombres esperados se comprueba también mediante la inspección anterior.",{"_3376":70868,"_29549":70837,"_20523":120934,"_5":14087,"_26884":120870,"_2862":120935},[],"Si utilizas una CA intermedia, la raíz confiable debe estar en `ca.pem` y debes aportar las intermedias mediante `-untrusted intermediates.pem`. Esta variante se desarrolla en el modelo de confianza.",{"_3376":70869,"_29549":70837,"_20523":120937,"_5":14087,"_26884":120870,"_2862":120938},[],"El comando no consulta OCSP ni CRL. Para comprobar revocación, continúa con Validación de certificados. Consulta la referencia de openssl-verify para sus opciones.",{"_3376":70870,"_29549":70837,"_20523":120940,"_5":14087,"_26884":120874,"_2862":120941},[],"En Bash, compara los dos resúmenes de clave pública:",{"_3376":70871,"_29549":70837,"_20523":120943,"_5":14087,"_26884":120874,"_2862":120944},[],"Ambos comandos deben terminar correctamente y mostrar el mismo resumen SHA-256. Si difieren, la clave privada no corresponde al certificado seleccionado. Vuelve a localizar la pareja correcta antes de instalarla.",{"_3376":70872,"_29549":70837,"_20523":120946,"_5":14087,"_26884":120874,"_2862":120947},[],"Las opciones utilizadas se recogen en openssl-x509 y openssl-pkey.",{"_3376":70873,"_29549":70837,"_20523":120949,"_5":14087,"_26884":120878,"_2862":118480},[],{"_3376":70874,"_29549":70837,"_20523":120951,"_5":14087,"_26884":120878,"_2862":116994},[],{"_3376":70875,"_29549":70837,"_20523":120953,"_5":14087,"_26884":120878,"_2862":120954},[],"La CA rechaza la emisión",{"_3376":70876,"_29549":70837,"_20523":120956,"_5":14087,"_26884":120878,"_2862":120957},[],"Permisos, estado y clave de la CA, algoritmo y perfil.",{"_3376":70877,"_29549":70837,"_20523":120959,"_5":14087,"_26884":120878,"_2862":120960},[],"Sujeto o usos diferentes",{"_3376":70878,"_29549":70837,"_20523":120962,"_5":14087,"_26884":120878,"_2862":120963},[],"Perfil aplicado y valores solicitados.",{"_3376":70879,"_29549":70837,"_20523":120965,"_5":14087,"_26884":120878,"_2862":120966},[],"No se encuentra el emisor",{"_3376":70880,"_29549":70837,"_20523":120968,"_5":14087,"_26884":120878,"_2862":120969},[],"CA descargada y cadena intermedia necesaria.",{"_3376":70881,"_29549":70837,"_20523":120971,"_5":14087,"_26884":120878,"_2862":120972},[],"Falla la vigencia",{"_3376":70882,"_29549":70837,"_20523":120974,"_5":14087,"_26884":120878,"_2862":120975},[],"Fechas del certificado y de la CA, y reloj del equipo.",{"_3376":70883,"_29549":70837,"_20523":120977,"_5":14087,"_26884":120878,"_2862":120978},[],"Los resúmenes de clave difieren",{"_3376":70884,"_29549":70837,"_20523":120980,"_5":14087,"_26884":120878,"_2862":120981},[],"Archivos de certificado y clave de la misma emisión.",{"_3376":70885,"_29549":70837,"_20523":120983,"_5":14087,"_26884":120878,"_2862":120984},[],"Consulta Diagnóstico PKI si necesitas acotar un fallo de emisión.",{"_3376":70886,"_29549":70837,"_20523":120986,"_5":14087,"_26884":120881,"_2862":120987},[],"Has completado el recorrido PKI cuando el certificado verifica y su clave corresponde. Elige cómo utilizarlo:",{"_3376":70887,"_29549":70837,"_20523":120989,"_5":14087,"_26884":120881,"_2862":120990},[],"Gestionar certificados para inspección, estado y revocación.",{"_3376":70888,"_29549":70837,"_20523":120992,"_5":14087,"_26884":120881,"_2862":120993},[],"Registrar un dispositivo manualmente para asociar esta identidad al inventario de Lamassu.",{"_3376":70889,"_29549":70837,"_20523":120995,"_5":14087,"_26884":120881,"_2862":120996},[],"Preparar EST para que el dispositivo solicite sus siguientes identidades.",{"_3376":70890,"_29549":70837,"_20523":120998,"_5":14087,"_26884":120881,"_2862":120999},[],"La aceptación en un consumidor requiere configurar su confianza, su comprobación de revocación y los permisos concedidos a la identidad.",{"_3376":70891,"_29549":70891,"_5":14445,"_2862":121001,"_29881":121002,"_20523":121003,"_26884":70891},"Primeros pasos de PKI",[48111,114818,53588,118150],[],{"_3376":70892,"_29549":70891,"_20523":121005,"_5":14087,"_26884":70891,"_2862":121006},[],"Crea una CA, emite un certificado de cliente y comprueba su cadena y su clave.",{"_3376":70893,"_29549":70891,"_5":29878,"_20523":121008,"_26884":121009,"_2862":113396},[],"/docs/es/platform/pki/quickstarts/overview#antes-de-empezar",{"_3376":70894,"_29549":70891,"_5":29878,"_20523":121011,"_26884":121012,"_2862":121013},[],"/docs/es/platform/pki/quickstarts/overview#ruta-recomendada","Ruta recomendada",{"_3376":70895,"_29549":70891,"_5":29878,"_20523":121015,"_26884":121016,"_2862":118332},[],"/docs/es/platform/pki/quickstarts/overview#resultado-esperado",{"_3376":70896,"_29549":70891,"_5":29878,"_20523":121018,"_26884":121019,"_2862":121020},[],"/docs/es/platform/pki/quickstarts/overview#continúa-según-tu-objetivo","Continúa según tu objetivo",{"_3376":70897,"_29549":70891,"_20523":121022,"_5":14087,"_26884":70891,"_2862":121023},[],"Este recorrido está dirigido a quien empieza a administrar la PKI o necesita una primera identidad X.509 de cliente. Termina con tres archivos: el certificado de una CA raíz, un certificado final y la clave privada de ese cliente.",{"_3376":70898,"_29549":70891,"_20523":121025,"_5":14087,"_26884":121009,"_2862":121026},[],"Una instancia de Lamassu accesible desde el navegador. Si necesitas prepararla, consulta Despliegue.",{"_3376":70899,"_29549":70891,"_20523":121028,"_5":14087,"_26884":121009,"_2862":121029},[],"Permisos para gestionar claves, autoridades y emisión. Consulta Control de acceso si una operación está bloqueada.",{"_3376":70900,"_29549":70891,"_20523":121031,"_5":14087,"_26884":121009,"_2862":121032},[],"Un motor criptográfico disponible para la clave de la CA; comprueba el inventario de claves y motores.",{"_3376":70901,"_29549":70891,"_20523":121034,"_5":14087,"_26884":121009,"_2862":121035},[],"OpenSSL 3.x en el equipo desde el que verificarás los archivos.",{"_3376":70902,"_29549":70891,"_20523":121037,"_5":14087,"_26884":121009,"_2862":121038},[],"Un directorio de trabajo con acceso restringido para custodiar la clave descargada.",{"_3376":70903,"_29549":70891,"_20523":121040,"_5":14087,"_26884":121012,"_2862":121041},[],"<Card title=\"1. Crea tu primera CA\" description=\"Crea una raíz de evaluación y guarda su certificado público como ca.pem.\" href=\"/docs/platform/pki/quickstarts/create-certificate-authority\" />",{"_3376":70904,"_29549":70891,"_20523":121043,"_5":14087,"_26884":121012,"_2862":121044},[],"<Card title=\"2. Emite y verifica un certificado\" description=\"Emite para device-001 y comprueba contenido, cadena y correspondencia de clave.\" href=\"/docs/platform/pki/quickstarts/issue-certificate\" />",{"_3376":70905,"_29549":70891,"_20523":121046,"_5":14087,"_26884":121012,"_2862":121047},[],"Usaremos `Acme Evaluation Root CA` y `device-001` como nombres de ejemplo. Si los sustituyes, conserva el mismo identificador de cliente en los pasos que quieras conectar.",{"_3376":70906,"_29549":70891,"_20523":121049,"_5":14087,"_26884":121012,"_2862":121050},[],"La raíz de este recorrido firma directamente el certificado final para facilitar la evaluación. Antes de diseñar una PKI operativa, revisa el modelo de confianza y la jerarquía de CAs.",{"_3376":70907,"_29549":70891,"_20523":121052,"_5":14087,"_26884":121016,"_2862":121053},[],"Archivo o recurso",{"_3376":70908,"_29549":70891,"_20523":121055,"_5":14087,"_26884":121016,"_2862":118329},[],{"_3376":70909,"_29549":70891,"_20523":121057,"_5":14087,"_26884":121016,"_2862":121058},[],"CA raíz activa y `ca.pem`",{"_3376":70910,"_29549":70891,"_20523":121060,"_5":14087,"_26884":121016,"_2862":121061},[],"Es un certificado de CA, está vigente y su autofirma se comprueba.",{"_3376":70911,"_29549":70891,"_20523":121063,"_5":14087,"_26884":121016,"_2862":121064},[],"Certificado final y `device.crt`",{"_3376":70912,"_29549":70891,"_20523":121066,"_5":14087,"_26884":121016,"_2862":121067},[],"Identifica a `device-001`, admite autenticación de cliente y verifica hasta `ca.pem`.",{"_3376":70913,"_29549":70891,"_20523":121069,"_5":14087,"_26884":121016,"_2862":121070},[],"Clave privada `device.key`",{"_3376":70914,"_29549":70891,"_20523":121072,"_5":14087,"_26884":121016,"_2862":121073},[],"Su clave pública coincide con la incluida en `device.crt`.",{"_3376":70915,"_29549":70891,"_20523":121075,"_5":14087,"_26884":121016,"_2862":121076},[],"Estas comprobaciones validan el material emitido. La aceptación en un servicio requiere además su configuración de confianza, autorización y revocación.",{"_3376":70916,"_29549":70891,"_20523":121078,"_5":14087,"_26884":121019,"_2862":121079},[],"Para operar certificados, continúa con Certificados y Validación.",{"_3376":70917,"_29549":70891,"_20523":121081,"_5":14087,"_26884":121019,"_2862":121082},[],"Para gestionar una identidad de dispositivo en Lamassu, sigue Registro manual. Ese recorrido incluye la preparación del DMS.",{"_3376":70918,"_29549":70891,"_20523":121084,"_5":14087,"_26884":121019,"_2862":121085},[],"Para que el dispositivo solicite su certificado, prepara el DMS y el cliente EST.",{"_3376":70919,"_29549":70919,"_5":14445,"_2862":121087,"_29881":121088,"_20523":121090,"_26884":70919},"Resolución de problemas PKI",[48111,114818,53588,121089],"Resolución de problemas",[],{"_3376":70920,"_29549":70919,"_20523":121092,"_5":14087,"_26884":70919,"_2862":121093},[],"Diagnostica emisión de certificados, OCSP y CRL.",{"_3376":70921,"_29549":70919,"_5":29878,"_20523":121095,"_26884":121096,"_2862":121097},[],"/docs/es/platform/pki/troubleshooting#la-emisión-falla","La emisión falla",{"_3376":70922,"_29549":70919,"_5":29878,"_20523":121099,"_26884":121100,"_2862":121101},[],"/docs/es/platform/pki/troubleshooting#ocsp-o-crl-no-reflejan-un-cambio","OCSP o CRL no reflejan un cambio",{"_3376":70923,"_29549":70919,"_5":29878,"_20523":121103,"_26884":121104,"_2862":121105},[],"/docs/es/platform/pki/troubleshooting#la-cadena-se-valida-pero-la-conexión-falla","La cadena se valida pero la conexión falla",{"_3376":70924,"_29549":70919,"_20523":121107,"_5":14087,"_26884":70919,"_2862":121108},[],"Esta guía ayuda al operador PKI a localizar fallos de emisión y publicación de estado. Conserva versión de Lamassu, operación, CA, emisor, serie, hora y error devuelto. No incluyas claves privadas ni tokens en el diagnóstico.",{"_3376":70925,"_29549":70919,"_20523":121110,"_5":14087,"_26884":70919,"_2862":121111},[],"Para Gateway, inicio de sesión, pods, dependencias y mensajería, consulta Diagnóstico de Despliegue. Para enrolamiento de dispositivos, consulta Diagnóstico EST.",{"_3376":70926,"_29549":70919,"_20523":121113,"_5":14087,"_26884":121096,"_2862":118329},[],{"_3376":70927,"_29549":70919,"_20523":121115,"_5":14087,"_26884":121096,"_2862":116994},[],{"_3376":70928,"_29549":70919,"_20523":121117,"_5":14087,"_26884":121096,"_2862":113420},[],{"_3376":70929,"_29549":70919,"_20523":121119,"_5":14087,"_26884":121096,"_2862":52427},[],{"_3376":70930,"_29549":70919,"_20523":121121,"_5":14087,"_26884":121096,"_2862":121122},[],"Existe, está activa y sus fechas son utilizables.",{"_3376":70931,"_29549":70919,"_20523":121124,"_5":14087,"_26884":121096,"_2862":121125},[],"Autoridades.",{"_3376":70932,"_29549":70919,"_20523":121127,"_5":14087,"_26884":121096,"_2862":121128},[],"Clave",{"_3376":70933,"_29549":70919,"_20523":121130,"_5":14087,"_26884":121096,"_2862":121131},[],"El registro tiene clave privada utilizable y el motor puede firmar.",{"_3376":70934,"_29549":70919,"_20523":121133,"_5":14087,"_26884":121096,"_2862":121134},[],"Prueba **Sign / Verify** en KMS; revisa permisos y disponibilidad del proveedor.",{"_3376":70935,"_29549":70919,"_20523":121136,"_5":14087,"_26884":121096,"_2862":56055},[],{"_3376":70936,"_29549":70919,"_20523":121138,"_5":14087,"_26884":121096,"_2862":121139},[],"PEM correcto y firma verificable.",{"_3376":70937,"_29549":70919,"_20523":121141,"_5":14087,"_26884":121096,"_2862":56061},[],{"_3376":70938,"_29549":70919,"_20523":121143,"_5":14087,"_26884":121096,"_2862":121144},[],"Perfil",{"_3376":70939,"_29549":70919,"_20523":121146,"_5":14087,"_26884":121096,"_2862":121147},[],"Fuente seleccionada, ID existente, algoritmo y tamaño admitidos.",{"_3376":70940,"_29549":70919,"_20523":121149,"_5":14087,"_26884":121096,"_2862":121150},[],"Revisa la precedencia de Perfiles; CA y DMS resuelven de forma distinta.",{"_3376":70941,"_29549":70919,"_20523":121152,"_5":14087,"_26884":121096,"_2862":118480},[],{"_3376":70942,"_29549":70919,"_20523":121154,"_5":14087,"_26884":121096,"_2862":121155},[],"Sujeto, SAN, usos y fechas adecuados.",{"_3376":70943,"_29549":70919,"_20523":121157,"_5":14087,"_26884":121096,"_2862":121158},[],"Compara CSR, perfil y certificado; emitir correctamente no demuestra aceptación por el consumidor.",{"_3376":70944,"_29549":70919,"_20523":121160,"_5":14087,"_26884":121096,"_2862":121161},[],"Si el certificado emitido tiene campos inesperados, revisa `Honor Subject`, `Honor Key Usage`, `Honor Extended Key Usages` y `Honor Extensions`. Esta última solo conserva SAN, sin validar el derecho a esos nombres. La validez no se recorta automáticamente al vencimiento de la CA.",{"_3376":70945,"_29549":70919,"_20523":121163,"_5":14087,"_26884":121096,"_2862":121164},[],"Si falla la reemisión de una CA, comprueba revocación y fecha: no se admite para una CA revocada o ya vencida. Para cambiar la clave, utiliza Jerarquía y rotación.",{"_3376":70946,"_29549":70919,"_20523":121166,"_5":14087,"_26884":121100,"_2862":121167},[],"Revisa cada frontera por separado:",{"_3376":70947,"_29549":70919,"_20523":121169,"_5":14087,"_26884":121100,"_2862":121170},[],"**Registro:** vuelve a leer el certificado correcto por serie y emisor. Confirma estado, razón y hora; los registros expirados o revocados definitivamente no admiten otra transición.",{"_3376":70948,"_29549":70919,"_20523":121172,"_5":14087,"_26884":121100,"_2862":121173},[],"**Endpoint:** inspecciona AIA y CDP del certificado. Consulta esas URLs desde la red del consumidor; una ruta antigua o un emisor incorrecto puede explicar la diferencia.",{"_3376":70949,"_29549":70919,"_20523":121175,"_5":14087,"_26884":121100,"_2862":121176},[],"**OCSP:** guarda una respuesta nueva, verifica firma y tiempos y observa su estado. Un error HTTP por una serie ausente no equivale a `Good` ni garantiza un `Unknown` firmado.",{"_3376":70950,"_29549":70919,"_20523":121178,"_5":14087,"_26884":121100,"_2862":121179},[],"**CRL:** compara `latest_crl`, número y tiempos de la lista descargada. Confirma la serie en el contenido. Si no cambia, revisa `regenerate_on_revoke`, entrega del evento, trabajos, firma y almacenamiento con el operador de Despliegue.",{"_3376":70951,"_29549":70919,"_20523":121181,"_5":14087,"_26884":121100,"_2862":121182},[],"**Cliente:** comprueba caché, política ante evidencia vencida o no disponible, extensión IDP crítica y rechazo de una conexión nueva.",{"_3376":70952,"_29549":70919,"_20523":121184,"_5":14087,"_26884":121100,"_2862":121185},[],"Una reactivación desde `CertificateHold` requiere una CRL nueva para que el cliente deje de ver la suspensión. Reactivar una CA no restaura su cascada de descendientes; revisa todos los estados y los errores individuales de la operación.",{"_3376":70953,"_29549":70919,"_20523":121187,"_5":14087,"_26884":121104,"_2862":121188},[],"Comprueba la identidad esperada, SAN, KU/EKU, clave correspondiente, intermedias enviadas y permisos del consumidor. Diferencia confianza TLS en el servidor, autenticación del cliente y autorización de la acción. Sigue Validación para una prueba positiva y otras de rechazo.",{"_3376":70954,"_29549":70919,"_20523":121190,"_5":14087,"_26884":121104,"_2862":121191},[],"Cuando necesites escalar un problema, entrega los identificadores, error y evidencia pública relevante, con tiempos de consulta y versión. Esto permite distinguir un fallo de emisión, de publicación o de la aplicación consumidora.",{"_3376":70955,"_29549":70955,"_5":14445,"_2862":121193,"_29881":121194,"_20523":121195,"_26884":70955},"Seguridad",[48111],[],{"_3376":70956,"_29549":70955,"_20523":121197,"_5":14087,"_26884":70955,"_2862":121198},[],"Cómo reportar de forma privada una vulnerabilidad de seguridad en Lamassu, qué incluir en el reporte y qué releases reciben correcciones de seguridad.",{"_3376":70957,"_29549":70955,"_5":29878,"_20523":121200,"_26884":121201,"_2862":121202},[],"/docs/es/security#cómo-reportar-una-vulnerabilidad","Cómo reportar una vulnerabilidad",{"_3376":70958,"_29549":70955,"_5":29878,"_20523":121204,"_26884":121205,"_2862":121206},[],"/docs/es/security#qué-incluir-en-un-reporte","Qué incluir en un reporte",{"_3376":70959,"_29549":70955,"_5":29878,"_20523":121208,"_26884":121209,"_2862":121210},[],"/docs/es/security#versiones-soportadas","Versiones soportadas",{"_3376":70960,"_29549":70955,"_5":29878,"_20523":121212,"_26884":121213,"_2862":121214},[],"/docs/es/security#divulgación-responsable","Divulgación responsable",{"_3376":70961,"_29549":70955,"_20523":121216,"_5":14087,"_26884":70955,"_2862":121217},[],"¿Has encontrado una vulnerabilidad de seguridad en lamassuiot, lamassu-dashboard o lamassu-helm? Esta página explica cómo reportarla de forma privada, qué incluir en tu reporte y qué releases reciben correcciones de seguridad.",{"_3376":70962,"_29549":70955,"_20523":121219,"_5":14087,"_26884":121201,"_2862":121220},[],"No reportes vulnerabilidades de seguridad mediante issues, discusiones o pull requests públicos de GitHub. Un reporte público divulga el problema antes de que los mantenedores puedan corregirlo.",{"_3376":70963,"_29549":70955,"_20523":121222,"_5":14087,"_26884":121201,"_2862":121223},[],"En su lugar, reporta de forma privada mediante GitHub Security Advisories para el repositorio afectado:",{"_3376":70964,"_29549":70955,"_20523":121225,"_5":14087,"_26884":121201,"_2862":14707},[],{"_3376":70965,"_29549":70955,"_20523":121227,"_5":14087,"_26884":121201,"_2862":14653},[],{"_3376":70966,"_29549":70955,"_20523":121229,"_5":14087,"_26884":121201,"_2862":14700},[],{"_3376":70967,"_29549":70955,"_20523":121231,"_5":14087,"_26884":121201,"_2862":121232},[],"Así los mantenedores pueden evaluar y resolver el problema antes de que se publique.",{"_3376":70968,"_29549":70955,"_20523":121234,"_5":14087,"_26884":121201,"_2862":121235},[],"Si el reporte privado de vulnerabilidades no está habilitado en ese repositorio, reporta la vulnerabilidad de forma privada a lamassuiot\\@lksnext.com antes de divulgar cualquier detalle públicamente.",{"_3376":70969,"_29549":70955,"_20523":121237,"_5":14087,"_26884":121205,"_2862":121238},[],"Describe la vulnerabilidad, su impacto potencial y los pasos para reproducirla usando ejemplos no sensibles y anonimizados.",{"_3376":70970,"_29549":70955,"_20523":121240,"_5":14087,"_26884":121205,"_2862":121241},[],"No incluyas en el reporte:",{"_3376":70971,"_29549":70955,"_20523":121243,"_5":14087,"_26884":121205,"_2862":121244},[],"Credenciales, tokens o claves privadas",{"_3376":70972,"_29549":70955,"_20523":121246,"_5":14087,"_26884":121205,"_2862":121247},[],"Datos de clientes o información identificable de clientes",{"_3376":70973,"_29549":70955,"_20523":121249,"_5":14087,"_26884":121205,"_2862":121250},[],"Detalles confidenciales de arquitectura o de infraestructura interna",{"_3376":70974,"_29549":70955,"_20523":121252,"_5":14087,"_26884":121209,"_2862":121253},[],"Solo el último release estable recibe soporte de seguridad. El soporte de un release estable termina cuando se publica el siguiente release estable. Los releases anteriores y los pre-releases no tienen soporte.",{"_3376":70975,"_29549":70955,"_20523":121255,"_5":14087,"_26884":121209,"_2862":121256},[],"Para saber cómo actualizar, consulta Actualizaciones.",{"_3376":70976,"_29549":70955,"_20523":121258,"_5":14087,"_26884":121213,"_2862":121259},[],"Da a los mantenedores un tiempo razonable para investigar y resolver la vulnerabilidad reportada antes de cualquier divulgación pública.",{"_3376":70977,"_29549":70955,"_20523":121261,"_5":14087,"_26884":121213,"_2862":121262},[],"Evita violaciones de privacidad, destrucción de datos e interrupciones de servicio mientras investigas la vulnerabilidad.",{"_3376":70978,"_29549":70955,"_20523":121264,"_5":14087,"_26884":121213,"_2862":121265},[],"Interactúa solo con cuentas o datos que sean tuyos o sobre los que tengas permiso explícito.",{"_3376":70979,"_29549":70955,"_20523":121267,"_5":14087,"_26884":121213,"_2862":121268},[],"Los mantenedores reconocen los reportes en un tiempo razonable y te mantienen informado del progreso de la remediación.",{"_3376":70980,"_29549":70955,"_20523":121270,"_5":14087,"_26884":121213,"_2862":121271},[],"Esta política cubre el código fuente, la configuración y los flujos de CI/CD de los repositorios lamassuiot, lamassu-dashboard y lamassu-helm.",{"_3376":70981,"_29549":70981,"_5":14445,"_2862":121273,"_29881":121274,"_20523":121276,"_26884":70981},"3.8.0 a 4.0.0",[48111,121275],"Actualizaciones",[],{"_3376":70982,"_29549":70981,"_20523":121278,"_5":14087,"_26884":70981,"_2862":121279},[],"Qué cambia en la arquitectura de 4.0.0, qué cambios rompen un despliegue 3.8.0, cómo actualizar paso a paso una release de Helm y cómo validar el resultado.",{"_3376":70983,"_29549":70981,"_5":29878,"_20523":121281,"_26884":121282,"_2862":121283},[],"/docs/es/upgrades/3-8-0-to-4-0-0#cambios-de-arquitectura","Cambios de arquitectura",{"_3376":70984,"_29549":70981,"_5":29878,"_20523":121285,"_26884":121286,"_2862":121287},[],"/docs/es/upgrades/3-8-0-to-4-0-0#una-única-base-de-datos-postgresql-con-esquemas","Una única base de datos PostgreSQL con esquemas",{"_3376":70985,"_29549":70981,"_5":29878,"_20523":121289,"_26884":121290,"_2862":121291},[],"/docs/es/upgrades/3-8-0-to-4-0-0#la-autorización-pasa-al-servicio-authz","La autorización pasa al servicio authz",{"_3376":70986,"_29549":70981,"_5":29878,"_20523":121293,"_26884":121294,"_2862":121295},[],"/docs/es/upgrades/3-8-0-to-4-0-0#los-eventos-de-dispositivo-tienen-almacenamiento-propio","Los eventos de dispositivo tienen almacenamiento propio",{"_3376":70987,"_29549":70981,"_5":29878,"_20523":121297,"_26884":121298,"_2862":121299},[],"/docs/es/upgrades/3-8-0-to-4-0-0#un-chart-de-helm-reforzado","Un chart de Helm reforzado",{"_3376":70988,"_29549":70981,"_5":29878,"_20523":121301,"_26884":121302,"_2862":121303},[],"/docs/es/upgrades/3-8-0-to-4-0-0#qué-migra-automáticamente-la-actualización","Qué migra automáticamente la actualización",{"_3376":70989,"_29549":70981,"_5":29878,"_20523":121305,"_26884":121306,"_2862":56227},[],"/docs/es/upgrades/3-8-0-to-4-0-0#breaking-changes",{"_3376":70990,"_29549":70981,"_5":29878,"_20523":121308,"_26884":121309,"_2862":121310},[],"/docs/es/upgrades/3-8-0-to-4-0-0#chart-de-helm-y-values","Chart de Helm y values",{"_3376":70991,"_29549":70981,"_5":29878,"_20523":121312,"_26884":121313,"_2862":121314},[],"/docs/es/upgrades/3-8-0-to-4-0-0#nombres-de-recursos-con-ámbito-de-release","Nombres de recursos con ámbito de release",{"_3376":70992,"_29549":70981,"_5":29878,"_20523":121316,"_26884":121317,"_2862":121318},[],"/docs/es/upgrades/3-8-0-to-4-0-0#validación-estricta-de-values","Validación estricta de values",{"_3376":70993,"_29549":70981,"_5":29878,"_20523":121320,"_26884":121321,"_2862":121322},[],"/docs/es/upgrades/3-8-0-to-4-0-0#configuración-de-autorización-obligatoria","Configuración de autorización obligatoria",{"_3376":70994,"_29549":70981,"_5":29878,"_20523":121324,"_26884":121325,"_2862":121326},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-la-validación-de-tokens-en-el-gateway","Retirada de la validación de tokens en el gateway",{"_3376":70995,"_29549":70981,"_5":29878,"_20523":121328,"_26884":121329,"_2862":121330},[],"/docs/es/upgrades/3-8-0-to-4-0-0#contenedores-sin-root","Contenedores sin root",{"_3376":70996,"_29549":70981,"_5":29878,"_20523":121332,"_26884":121333,"_2862":121334},[],"/docs/es/upgrades/3-8-0-to-4-0-0#amqp-sobre-tls","AMQP sobre TLS",{"_3376":70997,"_29549":70981,"_5":29878,"_20523":121336,"_26884":121337,"_2862":121338},[],"/docs/es/upgrades/3-8-0-to-4-0-0#values-renombrados-y-reestructurados","Values renombrados y reestructurados",{"_3376":70998,"_29549":70981,"_5":29878,"_20523":121340,"_26884":121341,"_2862":121342},[],"/docs/es/upgrades/3-8-0-to-4-0-0#datos-y-almacenamiento","Datos y almacenamiento",{"_3376":70999,"_29549":70981,"_5":29878,"_20523":121344,"_26884":121345,"_2862":121346},[],"/docs/es/upgrades/3-8-0-to-4-0-0#consolidación-en-postgresql","Consolidación en PostgreSQL",{"_3376":71000,"_29549":70981,"_5":29878,"_20523":121348,"_26884":121349,"_2862":121350},[],"/docs/es/upgrades/3-8-0-to-4-0-0#retirada-de-sqlite","Retirada de SQLite",{"_3376":71001,"_29549":70981,"_5":29878,"_20523":121352,"_26884":121353,"_2862":121354},[],"/docs/es/upgrades/3-8-0-to-4-0-0#claves-de-ca-heredadas-en-el-kms","Claves de CA heredadas en el KMS",{"_3376":71002,"_29549":70981,"_5":29878,"_20523":121356,"_26884":121357,"_2862":121358},[],"/docs/es/upgrades/3-8-0-to-4-0-0#referencias-entre-certificados-claves-y-roles-va","Referencias entre certificados, claves y roles VA",{"_3376":71003,"_29549":70981,"_5":29878,"_20523":121360,"_26884":121361,"_2862":121362},[],"/docs/es/upgrades/3-8-0-to-4-0-0#apis-y-configuración-almacenada","APIs y configuración almacenada",{"_3376":71004,"_29549":70981,"_5":29878,"_20523":121364,"_26884":121365,"_2862":121366},[],"/docs/es/upgrades/3-8-0-to-4-0-0#webhooks-del-dms","Webhooks del DMS",{"_3376":71005,"_29549":70981,"_5":29878,"_20523":121368,"_26884":121369,"_2862":121370},[],"/docs/es/upgrades/3-8-0-to-4-0-0#conjunto-de-confianza-del-reenrolamiento","Conjunto de confianza del reenrolamiento",{"_3376":71006,"_29549":70981,"_5":29878,"_20523":121372,"_26884":121373,"_2862":121374},[],"/docs/es/upgrades/3-8-0-to-4-0-0#autenticación-de-reenrolamiento-independiente","Autenticación de reenrolamiento independiente",{"_3376":71007,"_29549":70981,"_5":29878,"_20523":121376,"_26884":121377,"_2862":121378},[],"/docs/es/upgrades/3-8-0-to-4-0-0#api-de-actualización-del-dms","API de actualización del DMS",{"_3376":71008,"_29549":70981,"_5":29878,"_20523":121380,"_26884":121381,"_2862":121382},[],"/docs/es/upgrades/3-8-0-to-4-0-0#valores-de-tipo-de-certificado","Valores de tipo de certificado",{"_3376":71009,"_29549":70981,"_5":29878,"_20523":121384,"_26884":121385,"_2862":121386},[],"/docs/es/upgrades/3-8-0-to-4-0-0#eventos-de-dispositivo","Eventos de dispositivo",{"_3376":71010,"_29549":70981,"_5":29878,"_20523":121388,"_26884":121389,"_2862":121390},[],"/docs/es/upgrades/3-8-0-to-4-0-0#campo-firmante-del-rol-va","Campo firmante del rol VA",{"_3376":71011,"_29549":70981,"_5":29878,"_20523":121392,"_26884":121393,"_2862":121394},[],"/docs/es/upgrades/3-8-0-to-4-0-0#guía-de-migración-con-helm","Guía de migración con Helm",{"_3376":71012,"_29549":70981,"_5":29878,"_20523":121396,"_26884":121397,"_2862":121398},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-1-prepara","Paso 1: Prepara",{"_3376":71013,"_29549":70981,"_5":29878,"_20523":121400,"_26884":121401,"_2862":121402},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-2-actualiza-el-archivo-de-values","Paso 2: Actualiza el archivo de values",{"_3376":71014,"_29549":70981,"_5":29878,"_20523":121404,"_26884":121405,"_2862":121406},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-3-ejecuta-la-actualización","Paso 3: Ejecuta la actualización",{"_3376":71015,"_29549":70981,"_5":29878,"_20523":121408,"_26884":121409,"_2862":121410},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-4-migra-los-datos-del-kms-y-la-va","Paso 4: Migra los datos del KMS y la VA",{"_3376":71016,"_29549":70981,"_5":29878,"_20523":121412,"_26884":121413,"_2862":121414},[],"/docs/es/upgrades/3-8-0-to-4-0-0#paso-5-elimina-los-values-de-migración-puntual","Paso 5: Elimina los values de migración puntual",{"_3376":71017,"_29549":70981,"_5":29878,"_20523":121416,"_26884":121417,"_2862":121418},[],"/docs/es/upgrades/3-8-0-to-4-0-0#despliegues-sin-helm","Despliegues sin Helm",{"_3376":71018,"_29549":70981,"_5":29878,"_20523":121420,"_26884":121421,"_2862":117340},[],"/docs/es/upgrades/3-8-0-to-4-0-0#solución-de-problemas",{"_3376":71019,"_29549":70981,"_5":29878,"_20523":121423,"_26884":121424,"_2862":121425},[],"/docs/es/upgrades/3-8-0-to-4-0-0#checklist-de-validación","Checklist de validación",{"_3376":71020,"_29549":70981,"_5":29878,"_20523":121427,"_26884":121428,"_2862":121429},[],"/docs/es/upgrades/3-8-0-to-4-0-0#elimina-los-volúmenes-antiguos","Elimina los volúmenes antiguos",{"_3376":71021,"_29549":70981,"_20523":121431,"_5":14087,"_26884":70981,"_2862":121432},[],"Lamassu 4.0.0 es una versión mayor. El almacenamiento se consolida en una única base de datos PostgreSQL, un nuevo servicio `authz` autoriza cada petición, el chart de Helm se refuerza y varias APIs y configuraciones almacenadas cambian de forma. La mayoría de los datos se convierten automáticamente durante la actualización, pero algunos cambios requieren acción del operador antes, durante o después.",{"_3376":71022,"_29549":70981,"_20523":121434,"_5":14087,"_26884":70981,"_2862":121435},[],"La página se organiza en cuatro partes. Léelas en orden antes de actualizar producción:",{"_3376":71023,"_29549":70981,"_20523":121437,"_5":14087,"_26884":70981,"_2862":121438},[],"Cambios de arquitectura: qué es distinto en 4.0.0 y qué migra la actualización por sí sola.",{"_3376":71024,"_29549":70981,"_20523":121440,"_5":14087,"_26884":70981,"_2862":121441},[],"Breaking changes: cada cambio que puede romper un despliegue 3.8.0, a quién afecta y qué hacer.",{"_3376":71025,"_29549":70981,"_20523":121443,"_5":14087,"_26884":70981,"_2862":121444},[],"Guía de migración con Helm: el procedimiento paso a paso para una release gestionada con Helm.",{"_3376":71026,"_29549":70981,"_20523":121446,"_5":14087,"_26884":70981,"_2862":121447},[],"Checklist de validación: cómo confirmar que la actualización ha funcionado antes de eliminar los datos antiguos.",{"_3376":71027,"_29549":70981,"_20523":121449,"_5":14087,"_26884":70981,"_2862":121450},[],"La versión 4.0.0 está próxima y los pasos de migración del backend de esta página son provisionales. Verifica cada procedimiento con los artefactos definitivos de la versión antes de actualizar producción.",{"_3376":71028,"_29549":70981,"_20523":121452,"_5":14087,"_26884":121286,"_2862":121453},[],"En 3.8.0 cada servicio tenía su propia base de datos. El backend de 4.0.0 se conecta a una única base de datos PostgreSQL llamada `pki` y aísla cada servicio en un esquema: `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`. El servicio `authz` guarda sus principales, permisos y políticas en una base de datos `authz` separada (el monolítico de desarrollo usa en su lugar un esquema `authz` dentro de `pki`), y WFX conserva su propia base `wfx`.",{"_3376":71029,"_29549":70981,"_20523":121455,"_5":14087,"_26884":121286,"_2862":121456},[],"PostgreSQL pasa a ser el único motor de almacenamiento. Se elimina el soporte de SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0.",{"_3376":71030,"_29549":70981,"_20523":121458,"_5":14087,"_26884":121290,"_2862":121459},[],"En 3.8.0 el API Gateway validaba los tokens: una política JWT en cada ruta privada comprobaba la firma y solo dejaba pasar los tokens con el rol de administrador. Cualquier token que superase esa comprobación tenía acceso a todas las rutas.",{"_3376":71031,"_29549":70981,"_20523":121461,"_5":14087,"_26884":121290,"_2862":121462},[],"4.0.0 elimina la política del gateway. Las rutas `/api/*` llegan directamente a los servicios, y cada servicio autoriza cada petición a través de `authz`, que valida el token contra el endpoint JWKS del proveedor de identidad y aplica políticas de grano fino, a nivel de entidad, sobre CAs, certificados, dispositivos, DMS, claves del KMS y roles de la VA. No existe un superusuario implícito: el primer administrador sale de un principal de bootstrap que configuras tú. La página de control de acceso documenta los principales, las políticas y el primer administrador.",{"_3376":71032,"_29549":70981,"_20523":121464,"_5":14087,"_26884":121294,"_2862":121465},[],"Los eventos históricos de los dispositivos pasan de la columna `devices.events` a un almacenamiento dedicado, `device_events`, con sus propios endpoints. El endpoint de eventos también puede emitirlos mediante Server-Sent Events (SSE); para difundirlos entre las instancias del servicio, cada instancia de Device Manager enlaza su propia cola AMQP duradera.",{"_3376":71033,"_29549":70981,"_20523":121467,"_5":14087,"_26884":121298,"_2862":121468},[],"La versión 4.0.0 del chart refuerza la seguridad:",{"_3376":71034,"_29549":70981,"_20523":121470,"_5":14087,"_26884":121298,"_2862":121471},[],"**Nombres de recursos con ámbito de release.** Cada recurso gestionado por el chart se llama `<release>-lamassu-<componente>` en lugar de los nombres fijos de 3.8.0 (`kms`, `va`, `ca`...). Con una release llamada `prod`, los StatefulSets pasan a ser `prod-lamassu-kms` y `prod-lamassu-va`. Los values `nameOverride` y `fullnameOverride` cambian el prefijo.",{"_3376":71035,"_29549":70981,"_20523":121473,"_5":14087,"_26884":121298,"_2862":121474},[],"**Contenedores sin root.** Todas las cargas se ejecutan con el usuario numérico `65532:65532`, con un perfil seccomp `RuntimeDefault` y sin capabilities. Los pods no montan el token de la service account por defecto, y el chart crea una ServiceAccount dedicada.",{"_3376":71036,"_29549":70981,"_20523":121476,"_5":14087,"_26884":121298,"_2862":121477},[],"**Validación estricta de values.** `values.schema.json` rechaza las claves desconocidas, así que los bloques sobrantes de 3.8.0 hacen fallar `helm lint` y `helm upgrade` en lugar de ignorarse en silencio.",{"_3376":71037,"_29549":70981,"_20523":121479,"_5":14087,"_26884":121298,"_2862":121480},[],"**Sin reglas de planificación inyectadas.** El chart ya no añade por su cuenta reglas de anti-afinidad ni de topology spread.",{"_3376":71038,"_29549":70981,"_20523":121482,"_5":14087,"_26884":121302,"_2862":121483},[],"Al actualizar una release de Helm se ejecutan varias migraciones sin intervención:",{"_3376":71039,"_29549":70981,"_20523":121485,"_5":14087,"_26884":121302,"_2862":121486},[],"Antes de que arranque ningún servicio, el job de preinstalación y preactualización del chart prepara PostgreSQL. Crea las bases `pki`, `authz` y `wfx` si no existen, crea un esquema por servicio dentro de `pki` e importa cada base de datos por servicio de 3.8.0 en su esquema. Cada importación se ejecuta en una única transacción, de modo que una importación fallida no deja un esquema a medias y un reintento del job vuelve a importar. Después, el job ejecuta las migraciones de base de datos de cada esquema, migra `authz`, precarga sus políticas y da de alta los principales de `services.authz.bootstrap`. Es idempotente y necesita un rol de PostgreSQL con permiso para crear bases de datos y esquemas, como se describe en Instalar con Helm.",{"_3376":71040,"_29549":70981,"_20523":121488,"_5":14087,"_26884":121302,"_2862":121489},[],"La configuración almacenada de los DMS se reescribe al formato de 4.0.0, y los eventos históricos de los dispositivos se transforman al nuevo almacenamiento.",{"_3376":71041,"_29549":70981,"_20523":121491,"_5":14087,"_26884":121302,"_2862":121492},[],"Si se activa `migrations.caToKms.enabled`, un hook de preactualización registra en el KMS las claves de CA heredadas.",{"_3376":71042,"_29549":70981,"_20523":121494,"_5":14087,"_26884":121302,"_2862":121495},[],"Dos cosas nunca migran solas: los datos del KMS y de la VA en volúmenes locales, que se quedan en volúmenes que los pods actualizados ya no usan, y el archivo de values, que se actualiza a mano. Los despliegues que no usan el chart de Helm también tienen que mover ellos mismos los datos de la base de datos; consulta Despliegues sin Helm.",{"_3376":71043,"_29549":70981,"_20523":121497,"_5":14087,"_26884":121306,"_2862":121498},[],"Cambio",{"_3376":71044,"_29549":70981,"_20523":121500,"_5":14087,"_26884":121306,"_2862":121501},[],"A quién afecta",{"_3376":71045,"_29549":70981,"_20523":121503,"_5":14087,"_26884":121306,"_2862":121504},[],"Gravedad",{"_3376":71046,"_29549":70981,"_20523":121506,"_5":14087,"_26884":121306,"_2862":120033},[],{"_3376":71047,"_29549":70981,"_20523":121508,"_5":14087,"_26884":121306,"_2862":121314},[],{"_3376":71048,"_29549":70981,"_20523":121510,"_5":14087,"_26884":121306,"_2862":121511},[],"Releases de Helm con motor de KMS en sistema de archivos o CRLs de la VA en almacenamiento local",{"_3376":71049,"_29549":70981,"_20523":121513,"_5":14087,"_26884":121306,"_2862":121514},[],"Alta: KMS y VA arrancan con volúmenes vacíos",{"_3376":71050,"_29549":70981,"_20523":121516,"_5":14087,"_26884":121306,"_2862":121517},[],"Copiar los datos a los volúmenes nuevos",{"_3376":71051,"_29549":70981,"_20523":121519,"_5":14087,"_26884":121306,"_2862":121318},[],{"_3376":71052,"_29549":70981,"_20523":121521,"_5":14087,"_26884":121306,"_2862":121522},[],"Todas las releases de Helm",{"_3376":71053,"_29549":70981,"_20523":121524,"_5":14087,"_26884":121306,"_2862":121525},[],"Alta: `helm upgrade` falla",{"_3376":71054,"_29549":70981,"_20523":121527,"_5":14087,"_26884":121306,"_2862":121528},[],"Eliminar o renombrar las claves heredadas",{"_3376":71055,"_29549":70981,"_20523":121530,"_5":14087,"_26884":121306,"_2862":121322},[],{"_3376":71056,"_29549":70981,"_20523":121532,"_5":14087,"_26884":121306,"_2862":121533},[],"Todos los despliegues",{"_3376":71057,"_29549":70981,"_20523":121535,"_5":14087,"_26884":121306,"_2862":121536},[],"Alta: sin principal de bootstrap no hay administrador",{"_3376":71058,"_29549":70981,"_20523":121538,"_5":14087,"_26884":121306,"_2862":121539},[],"Configurar `services.authz`",{"_3376":71059,"_29549":70981,"_20523":121541,"_5":14087,"_26884":121306,"_2862":121326},[],{"_3376":71060,"_29549":70981,"_20523":121543,"_5":14087,"_26884":121306,"_2862":121522},[],{"_3376":71061,"_29549":70981,"_20523":121545,"_5":14087,"_26884":121306,"_2862":121546},[],"Alta: `helm upgrade` falla con las claves antiguas",{"_3376":71062,"_29549":70981,"_20523":121548,"_5":14087,"_26884":121306,"_2862":121549},[],"Mover JWKS y roles a `services.authz`",{"_3376":71063,"_29549":70981,"_20523":121551,"_5":14087,"_26884":121306,"_2862":121346},[],{"_3376":71064,"_29549":70981,"_20523":121553,"_5":14087,"_26884":121306,"_2862":121554},[],"Despliegues 3.8.0 con bases de datos por servicio",{"_3376":71065,"_29549":70981,"_20523":121556,"_5":14087,"_26884":121306,"_2862":121557},[],"Alta: los servicios no encuentran datos, o una migración aborta",{"_3376":71066,"_29549":70981,"_20523":121559,"_5":14087,"_26884":121306,"_2862":121560},[],"Limpiar antes IDs de CA duplicados y `engine_id` vacíos; fuera de Helm, mover los datos a mano",{"_3376":71067,"_29549":70981,"_20523":121562,"_5":14087,"_26884":121306,"_2862":121350},[],{"_3376":71068,"_29549":70981,"_20523":121564,"_5":14087,"_26884":121306,"_2862":121565},[],"Despliegues sobre SQLite, `couch_db` o `dynamo_db`",{"_3376":71069,"_29549":70981,"_20523":121567,"_5":14087,"_26884":121306,"_2862":121568},[],"Alta: el backend ya no arranca con ellos",{"_3376":71070,"_29549":70981,"_20523":121570,"_5":14087,"_26884":121306,"_2862":121571},[],"Pasar a PostgreSQL antes de actualizar",{"_3376":71071,"_29549":70981,"_20523":121573,"_5":14087,"_26884":121306,"_2862":121574},[],"Webhooks con referencias a archivos",{"_3376":71072,"_29549":70981,"_20523":121576,"_5":14087,"_26884":121306,"_2862":121577},[],"DMS cuyo certificado o clave mTLS del webhook eran rutas de archivo",{"_3376":71073,"_29549":70981,"_20523":121579,"_5":14087,"_26884":121306,"_2862":121580},[],"Alta: los enrolamientos que llaman al webhook fallan",{"_3376":71074,"_29549":70981,"_20523":121582,"_5":14087,"_26884":121306,"_2862":121583},[],"Volver a introducir certificado y clave como PEM, o eliminar los campos de archivo",{"_3376":71075,"_29549":70981,"_20523":121585,"_5":14087,"_26884":121306,"_2862":121330},[],{"_3376":71076,"_29549":70981,"_20523":121587,"_5":14087,"_26884":121306,"_2862":121588},[],"Releases con identidades por servicio o material de claves montado",{"_3376":71077,"_29549":70981,"_20523":121590,"_5":14087,"_26884":121306,"_2862":121591},[],"Media: los servicios no pueden leer sus archivos",{"_3376":71078,"_29549":70981,"_20523":121593,"_5":14087,"_26884":121306,"_2862":121594},[],"Eliminar las sobrescrituras y corregir la propiedad de los volúmenes",{"_3376":71079,"_29549":70981,"_20523":121596,"_5":14087,"_26884":121306,"_2862":121334},[],{"_3376":71080,"_29549":70981,"_20523":121598,"_5":14087,"_26884":121306,"_2862":121599},[],"Releases que definen `amqp.tls`",{"_3376":71081,"_29549":70981,"_20523":121601,"_5":14087,"_26884":121306,"_2862":121602},[],"Media: los clientes se conectan al puerto equivocado",{"_3376":71082,"_29549":70981,"_20523":121604,"_5":14087,"_26884":121306,"_2862":121605},[],"Apuntar `amqp.port` al listener TLS, o desactivar TLS",{"_3376":71083,"_29549":70981,"_20523":121607,"_5":14087,"_26884":121306,"_2862":121354},[],{"_3376":71084,"_29549":70981,"_20523":121609,"_5":14087,"_26884":121306,"_2862":121610},[],"Instalaciones cuyas claves de CA son anteriores al KMS",{"_3376":71085,"_29549":70981,"_20523":121612,"_5":14087,"_26884":121306,"_2862":121613},[],"Media: las claves de CA quedan sin gestionar",{"_3376":71086,"_29549":70981,"_20523":121615,"_5":14087,"_26884":121306,"_2862":121616},[],"Ejecutar la migración de CA a KMS",{"_3376":71087,"_29549":70981,"_20523":121618,"_5":14087,"_26884":121306,"_2862":121619},[],"Verificación del certificado del receptor",{"_3376":71088,"_29549":70981,"_20523":121621,"_5":14087,"_26884":121306,"_2862":121622},[],"DMS cuyo webhook tenía `validate_server_cert: false`",{"_3376":71089,"_29549":70981,"_20523":121624,"_5":14087,"_26884":121306,"_2862":121625},[],"Media: las credenciales viajan a un receptor sin verificar",{"_3376":71090,"_29549":70981,"_20523":121627,"_5":14087,"_26884":121306,"_2862":121628},[],"Poner `insecure_skip_verify` a `false`",{"_3376":71091,"_29549":70981,"_20523":121630,"_5":14087,"_26884":121306,"_2862":121370},[],{"_3376":71092,"_29549":70981,"_20523":121632,"_5":14087,"_26884":121306,"_2862":121633},[],"Scripts y consolas que editan DMS por API",{"_3376":71093,"_29549":70981,"_20523":121635,"_5":14087,"_26884":121306,"_2862":121636},[],"Media: una edición con el formato antiguo vacía `validation_cas` sin avisar",{"_3376":71094,"_29549":70981,"_20523":121638,"_5":14087,"_26884":121306,"_2862":121639},[],"Leer el DMS antes de editarlo y usar el campo nuevo",{"_3376":71095,"_29549":70981,"_20523":121641,"_5":14087,"_26884":121306,"_2862":121390},[],{"_3376":71096,"_29549":70981,"_20523":121643,"_5":14087,"_26884":121306,"_2862":121644},[],"Clientes que crean o actualizan roles VA por API",{"_3376":71097,"_29549":70981,"_20523":121646,"_5":14087,"_26884":121306,"_2862":121647},[],"Media: las peticiones con el campo antiguo devuelven un error",{"_3376":71098,"_29549":70981,"_20523":121649,"_5":14087,"_26884":121306,"_2862":121650},[],"Sustituir `crl_options.subject_key_id_signer` por el obligatorio `crl_options.signer_certificate_serial_number`",{"_3376":71099,"_29549":70981,"_20523":121652,"_5":14087,"_26884":121306,"_2862":121386},[],{"_3376":71100,"_29549":70981,"_20523":121654,"_5":14087,"_26884":121306,"_2862":121655},[],"Consumidores que leen el campo `events` del dispositivo",{"_3376":71101,"_29549":70981,"_20523":121657,"_5":14087,"_26884":121306,"_2862":121658},[],"Media: el campo desaparece",{"_3376":71102,"_29549":70981,"_20523":121660,"_5":14087,"_26884":121306,"_2862":121661},[],"Usar los nuevos endpoints de eventos",{"_3376":71103,"_29549":70981,"_20523":121663,"_5":14087,"_26884":121306,"_2862":121338},[],{"_3376":71104,"_29549":70981,"_20523":121665,"_5":14087,"_26884":121306,"_2862":121666},[],"Releases que sobrescriben `toolbox`, `services.connectors`, puertos, sondas o planificación",{"_3376":71105,"_29549":70981,"_20523":121668,"_5":14087,"_26884":121306,"_2862":121669},[],"Baja a media: errores de validación o cambios de valores por defecto",{"_3376":71106,"_29549":70981,"_20523":121671,"_5":14087,"_26884":121306,"_2862":121672},[],"Actualizar el archivo de values",{"_3376":71107,"_29549":70981,"_20523":121674,"_5":14087,"_26884":121306,"_2862":121378},[],{"_3376":71108,"_29549":70981,"_20523":121676,"_5":14087,"_26884":121306,"_2862":121677},[],"Clientes que envían el ID del DMS en el cuerpo de la actualización",{"_3376":71109,"_29549":70981,"_20523":121679,"_5":14087,"_26884":121306,"_2862":121680},[],"Baja: prevalece el ID de la URL",{"_3376":71110,"_29549":70981,"_20523":121682,"_5":14087,"_26884":121306,"_2862":121683},[],"Enviar el ID en la URL",{"_3376":71111,"_29549":70981,"_20523":121685,"_5":14087,"_26884":121306,"_2862":121382},[],{"_3376":71112,"_29549":70981,"_20523":121687,"_5":14087,"_26884":121306,"_2862":121688},[],"Consumidores que comparan el `type` del certificado",{"_3376":71113,"_29549":70981,"_20523":121690,"_5":14087,"_26884":121306,"_2862":121691},[],"Baja: dos valores cambian de nombre",{"_3376":71114,"_29549":70981,"_20523":121693,"_5":14087,"_26884":121306,"_2862":121694},[],"Adaptar los consumidores",{"_3376":71115,"_29549":70981,"_20523":121696,"_5":14087,"_26884":121306,"_2862":121374},[],{"_3376":71116,"_29549":70981,"_20523":121698,"_5":14087,"_26884":121306,"_2862":121699},[],"Cualquier DMS",{"_3376":71117,"_29549":70981,"_20523":121701,"_5":14087,"_26884":121306,"_2862":121702},[],"Baja: solo informativo",{"_3376":71118,"_29549":70981,"_20523":121704,"_5":14087,"_26884":121306,"_2862":121705},[],"Revisar ambos bloques antes de editar",{"_3376":71119,"_29549":70981,"_20523":121707,"_5":14087,"_26884":121313,"_2862":121708},[],"Kubernetes deriva el nombre del PVC de un StatefulSet a partir del nombre de su pod (`<volumeClaimTemplate>-<nombre-del-pod>`). Al renombrar los StatefulSets `kms` y `va`, `helm upgrade` enlaza PVC nuevos y vacíos en lugar de los existentes. El material de claves del KMS y las CRLs de la VA no se borran —los PVC antiguos quedan huérfanos, no eliminados—, pero los pods actualizados fallan con `no such file or directory` (KMS) o `code=NotFound` (VA) hasta que copies los datos. Afecta al KMS cuando `services.kms.cryptoEngines` usa un motor `filesystem` y a la VA cuando `services.va.fileStore.type` es `local`. El resto de recursos renombrados no tienen estado y se recrean sin riesgo de pérdida de datos.",{"_3376":71120,"_29549":70981,"_20523":121710,"_5":14087,"_26884":121313,"_2862":121711},[],"El paso 4 de la guía de migración copia los datos.",{"_3376":71121,"_29549":70981,"_20523":121713,"_5":14087,"_26884":121317,"_2862":121714},[],"`values.schema.json` rechaza las claves desconocidas, así que cualquier bloque que 4.0.0 haya eliminado o renombrado —`toolbox`, `auth.oidc.apiGateway`, `auth.authorization` y otros— hace fallar directamente `helm lint` y `helm upgrade`. El paso 2 recoge todos los cambios.",{"_3376":71122,"_29549":70981,"_20523":121716,"_5":14087,"_26884":121321,"_2862":121717},[],"3.8.0 no tenía servicio de autorización, así que un archivo de values de 3.8.0 no tiene nada desde lo que migrar: hay que añadir la configuración de `services.authz` a mano. Necesita el endpoint JWKS del proveedor de identidad, las bases de datos que usa el motor de autorización y un principal de bootstrap que coincida con la forma en que el proveedor asigna el rol de administrador. Sin un principal coincidente nadie puede administrar la PKI.",{"_3376":71123,"_29549":70981,"_20523":121719,"_5":14087,"_26884":121325,"_2862":121720},[],"`auth.oidc.apiGateway.jwks`, `auth.authorization.rolesClaim` y `auth.authorization.roles.admin` se eliminan sin alias de compatibilidad, y el schema los rechaza. Su configuración pasa a `services.authz`: la URL de JWKS se convierte en `services.authz.jwkUrl`, y el claim de roles y el rol de administrador pasan a ser una regla de claims del principal de bootstrap. `auth.oidc.frontend` no cambia.",{"_3376":71124,"_29549":70981,"_20523":121722,"_5":14087,"_26884":121329,"_2862":121723},[],"Las imágenes de servicio se basan en distroless y se ejecutan con el usuario numérico `65532`; la imagen de `authz` es Ubuntu con un usuario sin root que tiene el mismo UID. Se eliminan las sobrescrituras por servicio `services.kms.securityContext.runAsGroup: 0` y `services.authz.securityContext.runAsUser`/`runAsGroup: 999`; el acceso de grupo al volumen del KMS y al socket PKCS#11 lo gestiona ahora el `fsGroup: 65532` del pod.",{"_3376":71125,"_29549":70981,"_20523":121725,"_5":14087,"_26884":121329,"_2862":121726},[],"3.8.0 no fijaba la identidad del contenedor, por lo que los archivos existentes pueden tener cualquier UID. Todo volumen con claves o CRLs debe pertenecer a `65532:65532`, o al menos ser legible (y, si hace falta, escribible) por esa identidad.",{"_3376":71126,"_29549":70981,"_20523":121728,"_5":14087,"_26884":121333,"_2862":121729},[],"En 3.8.0 `amqp.tls` no se aplicaba y los clientes del bus de eventos se conectaban siempre en texto plano. En 4.0.0, `amqp.tls: true` los pasa a AMQPS. El valor por defecto de `amqp.port` sigue siendo `5672` y no cambia al activar TLS, así que un archivo de values que ya tuviera `amqp.tls: true` debe apuntar `amqp.port` al listener TLS del broker (`amqps`, habitualmente `5671`), o poner `amqp.tls: false` para seguir en texto plano. Los clientes deben además confiar en el certificado del broker.",{"_3376":71127,"_29549":70981,"_20523":121731,"_5":14087,"_26884":121337,"_2862":121732},[],"`toolbox` pasa a llamarse `connectivityTest`, y el hook de `helm test` usa la imagen upstream `curlimages/curl` fijada por digest.",{"_3376":71128,"_29549":70981,"_20523":121734,"_5":14087,"_26884":121337,"_2862":121735},[],"`services.connectors` pasa a ser un mapa indexado por ID de conector en lugar de una lista.",{"_3376":71129,"_29549":70981,"_20523":121737,"_5":14087,"_26884":121337,"_2862":121738},[],"El valor por defecto de `services.ui.port` es `8085`, el puerto sin privilegios de la imagen sin root.",{"_3376":71130,"_29549":70981,"_20523":121740,"_5":14087,"_26884":121337,"_2862":121741},[],"El bloque compartido `probes:` se sustituye por los bloques independientes `livenessProbe`, `readinessProbe` y `startupProbe`.",{"_3376":71131,"_29549":70981,"_20523":121743,"_5":14087,"_26884":121337,"_2862":121744},[],"Con `tls.certManagerOptions.issuer` vacío, el chart crea un issuer autofirmado con ámbito de release, por ejemplo `lamassu-downstream-ca-selfsigned-issuer`. El literal heredado `downstream-ca-selfsigned-issuer` se sigue aceptando y se resuelve a ese issuer.",{"_3376":71132,"_29549":70981,"_20523":121746,"_5":14087,"_26884":121337,"_2862":121747},[],"La anti-afinidad y el topology spread deben configurarse explícitamente con `affinity` y `topologySpreadConstraints`.",{"_3376":71133,"_29549":70981,"_20523":121749,"_5":14087,"_26884":121345,"_2862":121750},[],"Cada base de datos por servicio de 3.8.0 debe acabar como un esquema de `pki`, conservando su estructura, índices, restricciones, datos e historial de migraciones. El chart de Helm lo hace automáticamente; los despliegues sin Helm lo hacen a mano (consulta Despliegues sin Helm).",{"_3376":71134,"_29549":70981,"_20523":121752,"_5":14087,"_26884":121345,"_2862":121753},[],"Dos migraciones de esquema abortan con datos que 3.8.0 permitía, así que limpia los datos antes de actualizar:",{"_3376":71135,"_29549":70981,"_20523":121755,"_5":14087,"_26884":121345,"_2862":121756},[],"La migración de CA añade una restricción UNIQUE sobre `ca_certificates.id` y aborta si existen IDs de CA duplicados. Las importaciones ya rechazan los duplicados con `409`, así que normalmente no aparecen duplicados nuevos.",{"_3376":71136,"_29549":70981,"_20523":121758,"_5":14087,"_26884":121345,"_2862":121759},[],"La migración del KMS convierte la clave primaria en `(key_id, engine_id)` y aborta con `cannot promote (key_id, engine_id) to primary key: N row(s) have no engine_id; backfill them before migrating` cuando hay filas de `kms_keys` sin `engine_id`. Rellena antes `engine_id`.",{"_3376":71137,"_29549":70981,"_20523":121761,"_5":14087,"_26884":121345,"_2862":121762},[],"Esa misma migración del KMS elimina, con un `NOTICE`, los alias iguales a un ID de clave existente, porque los identificadores se resuelven ahora como ID de clave antes que como alias. Los alias afectados se descartan, no se redirigen.",{"_3376":71138,"_29549":70981,"_20523":121764,"_5":14087,"_26884":121349,"_2862":121765},[],"Se elimina el motor de almacenamiento SQLite, y los motores `couch_db` y `dynamo_db` no están registrados en 4.0.0: sus constantes de configuración siguen existiendo, pero no seleccionan ningún motor. Los despliegues sobre cualquiera de ellos deben pasar a PostgreSQL y consolidar sus datos en los esquemas de `pki` antes de actualizar.",{"_3376":71139,"_29549":70981,"_20523":121767,"_5":14087,"_26884":121353,"_2862":121768},[],"Los certificados de CA de tipo `MANAGED` o `IMPORTED_WITH_KEY` cuyas claves privadas son anteriores al servicio KMS tienen la clave guardada solo en el motor criptográfico, bajo el `subject_key_id` del certificado, sin registro en el KMS. La herramienta `ca-to-kms-migration` los registra:",{"_3376":71140,"_29549":70981,"_20523":121770,"_5":14087,"_26884":121353,"_2862":121771},[],"El `key_id` es el `subject_key_id` del certificado (SHA-256 de la clave pública).",{"_3376":71141,"_29549":70981,"_20523":121773,"_5":14087,"_26884":121353,"_2862":121774},[],"La herramienta es idempotente: las claves que ya están en el KMS se omiten, así que puede ejecutarse varias veces.",{"_3376":71142,"_29549":70981,"_20523":121776,"_5":14087,"_26884":121353,"_2862":121777},[],"Los certificados que no pueden leerse, o que carecen de motor o de ID de clave de sujeto, se omiten con un aviso. Revisa los logs y resuelve los registros afectados.",{"_3376":71143,"_29549":70981,"_20523":121779,"_5":14087,"_26884":121353,"_2862":121780},[],"Cuando certificados de CA que comparten un `subject_key_id` declaran `engine_id` en conflicto, la herramienta marca esa clave como fallida y sale con código `1`, lo que hace fallar un hook de preactualización de Helm. Resuelve el conflicto a mano antes de volver a ejecutarla.",{"_3376":71144,"_29549":70981,"_20523":121782,"_5":14087,"_26884":121353,"_2862":121783},[],"Con Helm, activa el hook para la actualización en el paso 2; sin Helm, ejecuta la herramienta a mano.",{"_3376":71145,"_29549":70981,"_20523":121785,"_5":14087,"_26884":121353,"_2862":121786},[],"Una vez registradas las claves heredadas, arrancar el KMS con la opción de configuración del backend `crypto_engines.migrate_keys_format` renombra las claves cuyo nombre no es el digest SHA-256 de la clave pública, conserva el nombre antiguo como alias y traslada consigo las referencias de certificados. Es seguro volver a ejecutarla y puede desactivarse después.",{"_3376":71146,"_29549":70981,"_20523":121788,"_5":14087,"_26884":121357,"_2862":121789},[],"Los certificados referencian ahora su clave del KMS, y los roles VA referencian su certificado firmante, de modo que no se puede eliminar una clave o un certificado en uso. La migración del KMS descarta los metadatos de clave heredados `lamassu.io/kms/binded-resources`. Antes de 4.0.0, eliminar una CA podía borrar su clave y dejar referencias a ella en los registros de certificado conservados. La migración de CA registra esas claves ausentes en el KMS solo con su clave pública para satisfacer las referencias conservadas. Estas entradas no pueden eliminarse mientras los certificados conservados las referencien; no recuperan la clave privada. En 4.0.0, eliminar una CA libera las referencias de su propio certificado actual y de sus certificados reemitidos vinculados antes de intentar eliminar la clave; los demás certificados que todavía la referencien impiden su eliminación.",{"_3376":71147,"_29549":70981,"_20523":121791,"_5":14087,"_26884":121365,"_2862":121792},[],"Las configuraciones de webhook almacenadas se reescriben al formato actual y sus campos se renombran:",{"_3376":71148,"_29549":70981,"_20523":121794,"_5":14087,"_26884":121365,"_2862":121795},[],"Campo en 3.8.0",{"_3376":71149,"_29549":70981,"_20523":121797,"_5":14087,"_26884":121365,"_2862":121798},[],"Campo en 4.0.0",{"_3376":71150,"_29549":70981,"_20523":121800,"_5":14087,"_26884":121365,"_2862":56722},[],{"_3376":71151,"_29549":70981,"_20523":121802,"_5":14087,"_26884":121365,"_2862":121803},[],"`insecure_skip_verify` (con el valor negado)",{"_3376":71152,"_29549":70981,"_20523":121805,"_5":14087,"_26884":121365,"_2862":56728},[],{"_3376":71153,"_29549":70981,"_20523":121807,"_5":14087,"_26884":121365,"_2862":56731},[],{"_3376":71154,"_29549":70981,"_20523":121809,"_5":14087,"_26884":121365,"_2862":56734},[],{"_3376":71155,"_29549":70981,"_20523":121811,"_5":14087,"_26884":121365,"_2862":56737},[],{"_3376":71156,"_29549":70981,"_20523":121813,"_5":14087,"_26884":121365,"_2862":56740},[],{"_3376":71157,"_29549":70981,"_20523":121815,"_5":14087,"_26884":121365,"_2862":56743},[],{"_3376":71158,"_29549":70981,"_20523":121817,"_5":14087,"_26884":121365,"_2862":121818},[],"Cuando el certificado y la clave mTLS heredados son ambos PEM, se trasladan a `mtls_options.cert_content` y `mtls_options.key_content` y no requieren acción. Hay dos casos que sí la requieren.",{"_3376":71159,"_29549":70981,"_20523":121820,"_5":14087,"_26884":121365,"_2862":121821},[],"**Webhooks con referencias a archivos.** Una configuración mixta, con el certificado en PEM y la clave como ruta de archivo, se migra a `mtls_options.cert_file` y `mtls_options.key_file`. La entrega del webhook rechaza esos campos en cada llamada, sea cual sea el modo de autenticación configurado, de modo que todos los enrolamientos y reenrolamientos que llaman a ese webhook fallan hasta corregir la configuración. Si el webhook usa mTLS, vuelve a introducir el certificado y la clave como PEM, en Base64 o en texto plano; si no lo usa, elimina los campos de archivo sobrantes. Mientras tanto, las actualizaciones de solo metadatos siguen funcionando (`PUT` o `PATCH` sobre `/v1/dms/:id/metadata`). En una variante del mismo problema, una configuración almacenada con rutas de archivo dentro de `mtls_options.cert_content` o `mtls_options.key_content` hace fallar la validación de toda actualización completa de ajustes (`POST /v1/dms` o `PUT /v1/dms/:id`); los ajustes se sustituyen al completo, así que reenvía la configuración con el certificado y la clave como PEM.",{"_3376":71160,"_29549":70981,"_20523":121823,"_5":14087,"_26884":121365,"_2862":121824},[],"**Verificación del certificado del receptor.** Una configuración con `validate_server_cert: false` pasa a `insecure_skip_verify: true`, así que la verificación del receptor sigue sin realizarse hasta que ese campo se ponga a `false`. Corrígelo en cada configuración migrada: el canal de autorización del webhook transporta la API key o el bearer token, y saltarse la verificación expone esas credenciales a un atacante con posición de red. Mantén `insecure_skip_verify: true` solo si el certificado del receptor no es verificable de forma deliberada.",{"_3376":71161,"_29549":70981,"_20523":121826,"_5":14087,"_26884":121369,"_2862":121827},[],"El campo plano `reenrollment_settings.additional_validation_cas` se traslada al campo anidado `reenrollment_settings.est_rfc7030_settings.client_certificate_settings.validation_cas`:",{"_3376":71162,"_29549":70981,"_20523":121829,"_5":14087,"_26884":121369,"_2862":121830},[],"El conjunto de confianza efectivo no cambia, porque el valor anidado nunca se consultó al validar reenrolamientos. Si la lista plana estaba ausente o era nula, pasa a ser una lista vacía.",{"_3376":71163,"_29549":70981,"_20523":121832,"_5":14087,"_26884":121369,"_2862":121833},[],"Lo que cambia es el tratamiento de las peticiones por API. Los cuerpos que aún contienen `additional_validation_cas` se aceptan, pero su valor se descarta en silencio porque los campos JSON desconocidos se ignoran, y las respuestas GET ya no lo incluyen. Por tanto, un cuerpo de actualización construido con el formato antiguo vacía `validation_cas` sin ningún error. Lee siempre el DMS antes de enviar una edición y reutiliza el formato que devuelve la API.",{"_3376":71164,"_29549":70981,"_20523":121835,"_5":14087,"_26884":121373,"_2862":121836},[],"Los ajustes de autenticación del reenrolamiento se almacenan ahora de forma independiente de los de la autenticación inicial. No hay nada que migrar, pero lee ambos bloques antes de editar un DMS para no modificar uno creyendo que editas el otro. La consola expone editores independientes para ambos bloques; la guía de DMS describe sus campos, y también puedes editarlos mediante la API DMS.",{"_3376":71165,"_29549":70981,"_20523":121838,"_5":14087,"_26884":121377,"_2862":121839},[],"`PUT /v1/dms/:id` toma el ID del DMS de la URL y valida el cuerpo de la petición. Un ID en el cuerpo se ignora, así que actualiza los clientes que dependían de él.",{"_3376":71166,"_29549":70981,"_20523":121841,"_5":14087,"_26884":121381,"_2862":121842},[],"Los valores de tipo de certificado almacenados cambian de nombre: `IMPORTED` pasa a `IMPORTED_WITH_KEY` y `EXTERNAL` pasa a `IMPORTED_WITHOUT_KEY`. `MANAGED` no cambia. Adapta los consumidores que leen o comparan esos valores.",{"_3376":71167,"_29549":70981,"_20523":121844,"_5":14087,"_26884":121385,"_2862":121845},[],"El campo `events` ya no aparece en la representación del dispositivo. Apunta los consumidores a los nuevos endpoints:",{"_3376":71168,"_29549":70981,"_20523":121847,"_5":14087,"_26884":121385,"_2862":121848},[],"`GET /v1/devices/:id/events` devuelve los eventos de un dispositivo.",{"_3376":71169,"_29549":70981,"_20523":121850,"_5":14087,"_26884":121385,"_2862":121851},[],"`POST /v1/devices/:id/events` crea un evento.",{"_3376":71170,"_29549":70981,"_20523":121853,"_5":14087,"_26884":121385,"_2862":121854},[],"Cuando la cabecera `Accept` de la petición incluye `text/event-stream`, el endpoint de eventos emite por SSE con un keepalive cada 15 segundos, y responde `501` cuando SSE está deshabilitado en el despliegue. Cada instancia de Device Manager enlaza una cola AMQP duradera con el nombre de su ID de servicio, `device-manager-sse-<uuid>`. Las colas de instancias caídas o reemplazadas permanecen hasta que se eliminan, así que configura en el broker una política de expiración o limpieza.",{"_3376":71171,"_29549":70981,"_20523":121856,"_5":14087,"_26884":121389,"_2862":121857},[],"`crl_options.subject_key_id_signer` se sustituye por el obligatorio `crl_options.signer_certificate_serial_number`, el número de serie del certificado existente que firma la CRL. El valor inicial de un rol nuevo es el número de serie del certificado actual de la CA. Las peticiones que aún contienen `subject_key_id_signer` devuelven un error. Las políticas de autorización personalizadas que filtran por el campo antiguo deben actualizarse: el filtro `crl_subject_key_id_signer` se renombra a `crl_signer_certificate_serial_number` y toma valores de número de serie.",{"_3376":71172,"_29549":70981,"_20523":121859,"_5":14087,"_26884":121393,"_2862":121860},[],"La actualización sigue un orden fijo: preparar los datos y los values, ejecutar `helm upgrade` y después copiar los datos del KMS y la VA a los volúmenes nuevos. La copia debe hacerse después de la actualización, porque los StatefulSets y PVC de destino no existen antes. Si no estás actualizando una release existente, ve directamente a Instalar con Helm.",{"_3376":71173,"_29549":70981,"_20523":121862,"_5":14087,"_26884":121397,"_2862":121863},[],"Haz una copia de seguridad verificable de PostgreSQL y programa una parada de servicio. La actualización mueve los datos de todos los servicios a `pki`.",{"_3376":71174,"_29549":70981,"_20523":121865,"_5":14087,"_26884":121397,"_2862":121866},[],"Si el despliegue usa SQLite, `couch_db` o `dynamo_db`, pásalo antes a PostgreSQL.",{"_3376":71175,"_29549":70981,"_20523":121868,"_5":14087,"_26884":121397,"_2862":121869},[],"Resuelve los IDs de CA duplicados y rellena `engine_id` en `kms_keys`, como se describe en Consolidación en PostgreSQL.",{"_3376":71176,"_29549":70981,"_20523":121871,"_5":14087,"_26884":121397,"_2862":121872},[],"Anota los nombres de tus PVC de almacenamiento local:",{"_3376":71177,"_29549":70981,"_20523":121874,"_5":14087,"_26884":121397,"_2862":121875},[],"`helm upgrade` no toca ni borra los PVC antiguos, pero tras la actualización nada los referencia. Necesitas sus nombres para copiar los datos y para limpiar más tarde.",{"_3376":71178,"_29549":70981,"_20523":121877,"_5":14087,"_26884":121401,"_2862":121878},[],"**Añade `services.authz`.** Configura el endpoint JWKS, las bases de datos y el principal de bootstrap:",{"_3376":71179,"_29549":70981,"_20523":121880,"_5":14087,"_26884":121401,"_2862":121881},[],"`jwkUrl` se consulta desde el pod de `authz`, no desde el gateway, así que un Service del namespace de la release puede referenciarse por su nombre corto. El valor por defecto apunta a un Service de Keycloak llamado `auth-keycloak`; defínelo explícitamente si tu proveedor de identidad está en otro sitio.",{"_3376":71180,"_29549":70981,"_20523":121883,"_5":14087,"_26884":121401,"_2862":121884},[],"`authz` es el almacenamiento propio del servicio de autorización para principales, permisos y políticas. `pki` es la base de datos que consulta el motor de autorización al evaluar las políticas sobre las entidades. Solo se lee el campo `database` de cada entrada; la conexión usa siempre los values globales `postgres.hostname`, `postgres.port`, `postgres.username` y `postgres.password`.",{"_3376":71181,"_29549":70981,"_20523":121886,"_5":14087,"_26884":121401,"_2862":121887},[],"Si mantuviste los roles por defecto de 3.8.0 (`realm_access.roles` y `pki-admin`), el `services.authz.bootstrap` por defecto ya coincide con ellos.",{"_3376":71182,"_29549":70981,"_20523":121889,"_5":14087,"_26884":121401,"_2862":121890},[],"**Elimina los bloques de validación de tokens del gateway.** Quita `auth.oidc.apiGateway` y `auth.authorization` una vez que su configuración esté en `services.authz`:",{"_3376":71183,"_29549":70981,"_20523":121892,"_5":14087,"_26884":121401,"_2862":121893},[],"**Renombra `toolbox` a `connectivityTest`:**",{"_3376":71184,"_29549":70981,"_20523":121895,"_5":14087,"_26884":121401,"_2862":121896},[],"**Elimina las sobrescrituras de identidad por servicio** `services.kms.securityContext.runAsGroup` y `services.authz.securityContext.runAsUser`/`runAsGroup`.",{"_3376":71185,"_29549":70981,"_20523":121898,"_5":14087,"_26884":121401,"_2862":121899},[],"**Convierte `services.connectors` en un mapa** indexado por ID de conector, con el `type` y la `image` de cada entrada:",{"_3376":71186,"_29549":70981,"_20523":121901,"_5":14087,"_26884":121401,"_2862":121902},[],"**Revisa AMQP.** Si defines `amqp.tls: true`, define también `amqp.port` con el listener TLS del broker (habitualmente `5671`), o pon `amqp.tls: false` para seguir en texto plano.",{"_3376":71187,"_29549":70981,"_20523":121904,"_5":14087,"_26884":121401,"_2862":121905},[],"**Activa la migración de CA a KMS** si tus claves de CA son anteriores al KMS:",{"_3376":71188,"_29549":70981,"_20523":121907,"_5":14087,"_26884":121401,"_2862":121908},[],"**Revisa el resto de values:** sobrescrituras que fijaban `services.ui.port` a `80`, el antiguo bloque `probes:`, el issuer de TLS, y `affinity` y `topologySpreadConstraints` explícitos donde tu clúster los necesite. Values renombrados y reestructurados describe cada uno.",{"_3376":71189,"_29549":70981,"_20523":121910,"_5":14087,"_26884":121401,"_2862":121911},[],"Ejecuta `helm lint` con los values nuevos antes de actualizar; el schema estricto informa de cualquier clave que siga siendo desconocida.",{"_3376":71190,"_29549":70981,"_20523":121913,"_5":14087,"_26884":121405,"_2862":121914},[],"Helm ejecuta los hooks de preactualización —la migración de CA a KMS si está activada y el job de base de datos— antes de aplicar ninguna carga, así que los servicios nunca arrancan contra una base de datos sin preparar. Si la validación rechaza values desconocidos, corrige el archivo y vuelve a ejecutar.",{"_3376":71191,"_29549":70981,"_20523":121916,"_5":14087,"_26884":121405,"_2862":121917},[],"Si el despliegue usa almacenamiento local en el KMS o la VA, esos pods fallan hasta que completes el paso 4, así que `--wait` no puede terminar bien: Helm espera a que estén listos, agota el tiempo, sale con error y marca la release como `failed`. Para entonces los hooks ya se han ejecutado y se han aplicado todos los manifiestos, incluidos los nuevos StatefulSets y sus PVC. Sin `--atomic`, Helm no revierte nada. Continúa con el paso 4 y después vuelve a lanzar el mismo comando `helm upgrade` para que termine y Helm registre la release como `deployed`. Los dos hooks son idempotentes, así que es seguro volver a ejecutarlos.",{"_3376":71192,"_29549":70981,"_20523":121919,"_5":14087,"_26884":121409,"_2862":121920},[],"Omite este paso si `services.kms.cryptoEngines` nunca usó un motor `filesystem` y `services.va.fileStore.type` nunca fue `local`.",{"_3376":71193,"_29549":70981,"_20523":121922,"_5":14087,"_26884":121409,"_2862":121923},[],"**Localiza los nuevos StatefulSets y PVC.** Sus nombres dependen del nombre de la release y de cualquier `nameOverride` o `fullnameOverride`; el nombre del PVC es `<volumeClaimTemplate>-<nombre del StatefulSet>-0`:",{"_3376":71194,"_29549":70981,"_20523":121925,"_5":14087,"_26884":121409,"_2862":121926},[],"Con la release `lamassu` y el nombre de chart por defecto, los nuevos PVC son `golang-engine-storage-lamassu-kms-0` y `local-crl-file-storage-lamassu-va-0`; con la release `prod` son `golang-engine-storage-prod-lamassu-kms-0` y `local-crl-file-storage-prod-lamassu-va-0`. Comprueba que existen los PVC antiguos y nuevos antes de continuar. Si `claims_ok` imprime `ABORT`, el bloque se detiene antes de listar las PVC: o falló la búsqueda de un StatefulSet, o una PVC nueva resuelve a la PVC de 3.8.0. En el segundo caso la copia se verificaría contra sí misma y la limpieza final borraría el volumen en uso. El chart siempre añade `-kms` y `-va` al nombre con ámbito de release, así que una colisión indica que las PVC no son las que esta guía espera; investiga antes de seguir. El punto 3 repite la comprobación y no crea el pod auxiliar, así que nada toca los volúmenes. La comprobación devuelve un error en lugar de llamar a `exit`, que cerraría tu shell y perdería las variables definidas hasta ahora. Si solo migras uno de los dos servicios, quita las PVC del otro de los comandos siguientes.",{"_3376":71195,"_29549":70981,"_20523":121928,"_5":14087,"_26884":121409,"_2862":121929},[],"**Anota el número de réplicas, reduce a cero los nuevos StatefulSets y espera a que terminen todos los pods que usan las PVC**, para que nada escriba en ninguno de los volúmenes mientras copias. Helm elimina los StatefulSets `kms` y `va` de 3.8.0 durante la actualización, pero sus pods `kms-0` y `va-0` pueden seguir terminando y reteniendo las PVC antiguas. Mientras sigan en marcha, el pod auxiliar no puede montar las PVC o copia un volumen en el que aún se escribe. El `wait` termina al instante para los pods que ya no existen:",{"_3376":71196,"_29549":70981,"_20523":121931,"_5":14087,"_26884":121409,"_2862":121932},[],"**Arranca un pod auxiliar efímero** que monte las cuatro PVC. Se ejecuta como root para poder cambiar la propiedad de los archivos, así que fija su imagen por digest y no montes el token de la service account:",{"_3376":71197,"_29549":70981,"_20523":121934,"_5":14087,"_26884":121409,"_2862":121935},[],"**Inspecciona antes de escribir** para no machacar datos que los pods nuevos pudieran haber escrito ya:",{"_3376":71198,"_29549":70981,"_20523":121937,"_5":14087,"_26884":121409,"_2862":121938},[],"Un resultado vacío es lo habitual: el pod propio de un StatefulSet rara vez llega a escribir nada cuando le faltan sus datos. Si la salida no está vacía, anota los archivos y confirma con el responsable del servicio que se pueden descartar antes de copiar; no superpongas los datos de 3.8.0 sobre un almacén desconocido.",{"_3376":71199,"_29549":70981,"_20523":121940,"_5":14087,"_26884":121409,"_2862":121941},[],"**Copia los datos, ajusta la propiedad y verifica la copia.** El segundo comando debe imprimir `copy verified`; cualquier salida de `diff` indica que la copia está incompleta, así que no continúes:",{"_3376":71200,"_29549":70981,"_20523":121943,"_5":14087,"_26884":121409,"_2862":121944},[],"El `chown` es obligatorio aunque los archivos antiguos ya parezcan pertenecer a un usuario sin root, porque 4.0.0 exige exactamente `65532:65532` y no recurre a lo que declare la imagen.",{"_3376":71201,"_29549":70981,"_20523":121946,"_5":14087,"_26884":121409,"_2862":121947},[],"**Elimina el auxiliar y restaura el número de réplicas anotado:**",{"_3376":71202,"_29549":70981,"_20523":121949,"_5":14087,"_26884":121409,"_2862":121950},[],"**Vuelve a lanzar el comando `helm upgrade` del paso 3.** Los pods del KMS y la VA arrancan ahora con los datos copiados, así que `--wait` termina bien y la release pasa de `failed` a `deployed`.",{"_3376":71203,"_29549":70981,"_20523":121952,"_5":14087,"_26884":121413,"_2862":121953},[],"Cuando la actualización que realizó la migración de CA a KMS termine correctamente, quita `migrations.caToKms.enabled` de tus values (su valor por defecto es `false`). El hook lee el ConfigMap heredado `kms-config` de 3.8.0 mientras existe y, cuando desaparece, recurre al ConfigMap con ámbito de release `<release>-lamassu-kms-config`.",{"_3376":71204,"_29549":70981,"_20523":121955,"_5":14087,"_26884":121413,"_2862":121956},[],"Después recorre el checklist de validación. Conserva los PVC antiguos hasta que lo superes.",{"_3376":71205,"_29549":70981,"_20523":121958,"_5":14087,"_26884":121417,"_2862":121959},[],"Sin el job de base de datos del chart, ninguna herramienta mueve datos entre bases de datos: las herramientas de migración solo aplican migraciones sobre un esquema que ya existe. Traslada tú cada base de datos por servicio a su esquema de `pki`, conservando estructura, índices, restricciones, datos e historial de migraciones, con las escrituras detenidas y una copia de seguridad verificada.",{"_3376":71206,"_29549":70981,"_20523":121961,"_5":14087,"_26884":121417,"_2862":121962},[],"Ejecuta las migraciones en el orden obligatorio, un esquema cada vez: primero `kms`, después la herramienta `ca-to-kms-migration` (necesaria solo en despliegues heredados cuyas claves de CA se nombran por SKI), luego `ca` y por último `va`. Los esquemas `devicemanager`, `dmsmanager` y `alerts` son independientes y pueden migrarse en cualquier orden. Con Helm, el job de preinstalación del chart aplica los esquemas en el orden correcto automáticamente.",{"_3376":71207,"_29549":70981,"_20523":121964,"_5":14087,"_26884":121417,"_2862":121965},[],"Los esquemas se referencian entre sí, así que el rol de PostgreSQL que ejecuta las migraciones necesita privilegios entre esquemas: el esquema `ca` necesita `USAGE` sobre `kms` más `SELECT`, `REFERENCES` e `INSERT` sobre `kms.kms_keys`, y el esquema `va` necesita `USAGE` sobre `ca` más `SELECT` y `REFERENCES` sobre `ca.certificates` y `SELECT` sobre `ca.ca_certificates`. Si tus servicios se conectan con un usuario distinto del que ejecutó las migraciones, concédele tras las migraciones `SELECT` sobre `ca.certificates_view`.",{"_3376":71208,"_29549":70981,"_20523":121967,"_5":14087,"_26884":121417,"_2862":121968},[],"Para aplicar las migraciones a mano, `goose-lamassu` debe ejecutarse contra la base `pki` con `search_path=<esquema>` en la cadena de conexión. El binario solo valida `search_path`, no el nombre de la base de datos, así que comprueba `dbname=pki` antes de ejecutarlo, y repítelo para `kms`, `ca`, `va`, `devicemanager`, `dmsmanager` y `alerts`:",{"_3376":71209,"_29549":70981,"_20523":121970,"_5":14087,"_26884":121417,"_2862":121971},[],"Ejecuta `ca-to-kms-migration` primero con `--dry-run`, que informa sin escribir en el almacenamiento del KMS, y después de forma real:",{"_3376":71210,"_29549":70981,"_20523":121973,"_5":14087,"_26884":121417,"_2862":121974},[],"Apunta la configuración `storage` de la herramienta a la base `pki`, donde los datos de CA y del KMS viven ahora en los esquemas `ca` y `kms`. Las opciones de la herramienta se describen en `backend/cmd/ca-to-kms-migration/README.md`, en el repositorio `lamassuiot`.",{"_3376":71211,"_29549":70981,"_20523":121976,"_5":14087,"_26884":121417,"_2862":121977},[],"Los README de ambas herramientas documentan el formato de 4.0.0 con la base `pki` y coinciden con esta página: `goose-lamassu` usa ejemplos con `dbname=pki` y no valida el nombre de la base de datos, y el README de `ca-to-kms-migration` describe la base única `pki` y el orden de migración.",{"_3376":71212,"_29549":70981,"_20523":121979,"_5":14087,"_26884":121421,"_2862":121980},[],"**Los pods del KMS o la VA fallan con `no such file or directory` o `code=NotFound` justo después de actualizar.** Los pods están enlazados a los PVC nuevos y vacíos y la migración de datos aún no se ha hecho, o se copió en el PVC equivocado. Sigue el paso 4 y comprueba que existen las cuatro PVC.",{"_3376":71213,"_29549":70981,"_20523":121982,"_5":14087,"_26884":121421,"_2862":121983},[],"**`helm upgrade --wait` agota el tiempo y `helm status` muestra la release como `failed`.** Con almacenamiento local en el KMS o la VA es lo esperado en la primera ejecución: los nuevos pods no pueden estar listos hasta que se copien sus datos. Los hooks se ejecutaron y los manifiestos y PVC se aplicaron, así que completa el paso 4 y vuelve a lanzar el mismo comando `helm upgrade`. Si otros pods tampoco están listos, revisa sus logs, porque falla algo más.",{"_3376":71214,"_29549":70981,"_20523":121985,"_5":14087,"_26884":121421,"_2862":121986},[],"**El pod auxiliar se queda en `Pending` o `ContainerCreating` y `kubectl wait` agota el tiempo.** Otro pod sigue reteniendo alguna de las PVC; en almacenamiento de bloque, `kubectl describe pod pvc-migrate-helper` muestra un `Multi-Attach error`. Comprueba con `kubectl get pods -n $NAMESPACE` que `kms-0`, `va-0` y los nuevos pods del KMS y la VA han desaparecido, y vuelve a ejecutar el wait.",{"_3376":71215,"_29549":70981,"_20523":121988,"_5":14087,"_26884":121421,"_2862":121989},[],"**`helm upgrade` falla con un error de validación por clave desconocida.** Elimina o renombra los values heredados —normalmente `toolbox`, `auth.oidc.apiGateway` o `auth.authorization`—, porque el schema estricto rechaza las claves que no conoce.",{"_3376":71216,"_29549":70981,"_20523":121991,"_5":14087,"_26884":121421,"_2862":121992},[],"**La actualización falla en el job de base de datos.** El rol de PostgreSQL no puede crear bases de datos o esquemas, o una migración de esquema abortó por IDs de CA duplicados o por valores de `engine_id` vacíos. Revisa los logs del job, corrige los permisos o los datos y vuelve a ejecutar la actualización.",{"_3376":71217,"_29549":70981,"_20523":121994,"_5":14087,"_26884":121421,"_2862":121995},[],"**La actualización falla en el hook de CA a KMS.** Hay certificados de CA que comparten un `subject_key_id` y declaran `engine_id` en conflicto. Resuelve el conflicto y vuelve a ejecutar.",{"_3376":71218,"_29549":70981,"_20523":121997,"_5":14087,"_26884":121421,"_2862":121998},[],"**Nadie puede iniciar sesión tras la actualización.** Comprueba que `services.authz.jwkUrl` es accesible desde el pod de `authz`, que `services.authz.bootstrap` coincide con un rol que tu proveedor OIDC asigna realmente y que el job de base de datos terminó.",{"_3376":71219,"_29549":70981,"_20523":122000,"_5":14087,"_26884":121421,"_2862":122001},[],"**Una migración aborta con `kms schema not found`.** Los esquemas deben migrarse en orden: ejecuta la migración del esquema `kms` antes que la del esquema `ca`.",{"_3376":71220,"_29549":70981,"_20523":122003,"_5":14087,"_26884":121421,"_2862":122004},[],"**Una migración aborta con `ca schema not found`.** Ejecuta la migración del esquema `ca` antes que la del esquema `va`.",{"_3376":71221,"_29549":70981,"_20523":122006,"_5":14087,"_26884":121421,"_2862":122007},[],"**La migración de VA falla con `cannot resolve signer certificate for VA role ... N candidates`.** La migración no puede identificar un certificado firmante de forma única a partir del SKI guardado en el rol. Revisa el SKI y los certificados candidatos indicados en el error; corrige los datos anteriores a la migración con una copia de seguridad verificada y vuelve a ejecutar la migración. El nuevo campo `signer_certificate_serial_number` se crea durante esa migración, por lo que no se puede configurar mediante la API de VA mientras esta falla.",{"_3376":71222,"_29549":70981,"_20523":122009,"_5":14087,"_26884":121421,"_2862":122010},[],"**Una migración o un servicio falla con `permission denied for table ...`.** Al rol de PostgreSQL le faltan los privilegios entre esquemas listados en Despliegues sin Helm; incluye `certificates_view` cuando se omitió el `GRANT SELECT` posterior a la migración. Concede los privilegios que falten y vuelve a ejecutar.",{"_3376":71223,"_29549":70981,"_20523":122012,"_5":14087,"_26884":121424,"_2862":122013},[],"Tras la actualización, comprueba en este orden:",{"_3376":71224,"_29549":70981,"_20523":122015,"_5":14087,"_26884":121424,"_2862":122016},[],"**Bases de datos.** Cada servicio lee la base `pki` con su propio esquema, los datos de `authz` y `wfx` son accesibles y el estado de las migraciones está registrado por esquema, incluidas las migraciones del ID único de CA y de la clave compuesta del KMS, y las migraciones de claves foráneas que se ejecutan por esquema en el orden obligatorio.",{"_3376":71225,"_29549":70981,"_20523":122018,"_5":14087,"_26884":121424,"_2862":122019},[],"**KMS y VA arrancan sin errores.** Sus logs no muestran errores `no such file or directory` ni `code=NotFound`.",{"_3376":71226,"_29549":70981,"_20523":122021,"_5":14087,"_26884":121424,"_2862":122022},[],"**Las claves existentes del KMS funcionan.** Emite un certificado desde una CA que ya existía antes de la actualización. Ninguna de las otras comprobaciones lee una clave del KMS, así que esta es la única que demuestra que el material de claves se ha copiado.",{"_3376":71227,"_29549":70981,"_20523":122024,"_5":14087,"_26884":121424,"_2862":122025},[],"**Las CRLs existentes se sirven.** `GET /crl/<ca-ski>` sobre la VA devuelve una CRL emitida anteriormente, y se emiten CRLs nuevas.",{"_3376":71228,"_29549":70981,"_20523":122027,"_5":14087,"_26884":121424,"_2862":122028},[],"**Claves de CA heredadas.** Si se ejecutó la migración de CA a KMS, revisa su informe y sus avisos y confirma que las claves esperadas aparecen en el KMS.",{"_3376":71229,"_29549":70981,"_20523":122030,"_5":14087,"_26884":121424,"_2862":122031},[],"**Conectividad.** `helm test \"$RELEASE\" -n $NAMESPACE --logs` pasa; el hook comprueba los endpoints de salud de CA, DMS Manager, Device Manager y VA, y la respuesta de la UI.",{"_3376":71230,"_29549":70981,"_20523":122033,"_5":14087,"_26884":121424,"_2862":122034},[],"**Autorización.** Inicia sesión con el principal de bootstrap y confirma que la administración funciona, comprueba que una identidad sin permisos recibe `403` y revisa los permisos de clientes e integraciones.",{"_3376":71231,"_29549":70981,"_20523":122036,"_5":14087,"_26884":121424,"_2862":122037},[],"**AMQP.** El backend se conecta al broker con la configuración TLS esperada, y la política de limpieza de las colas de SSE está en marcha.",{"_3376":71232,"_29549":70981,"_20523":122039,"_5":14087,"_26884":121424,"_2862":122040},[],"**Eventos de dispositivo.** `GET /v1/devices/:id/events` devuelve los eventos históricos de un dispositivo que los tenía.",{"_3376":71233,"_29549":70981,"_20523":122042,"_5":14087,"_26884":121424,"_2862":122043},[],"**Webhooks sin campos de archivo.** En cada DMS que usa webhook en enrolamiento o reenrolamiento, el bloque `config` incluye `insecure_skip_verify` y el bloque de opciones esperado (`apikey_options`, `jwt_options` o `mtls_options`), con el certificado y la clave en PEM y sin `cert_file` ni `key_file`.",{"_3376":71234,"_29549":70981,"_20523":122045,"_5":14087,"_26884":121424,"_2862":122046},[],"**Verificación del receptor.** `insecure_skip_verify` es `false`, salvo que el certificado del receptor no sea verificable de forma intencionada.",{"_3376":71235,"_29549":70981,"_20523":122048,"_5":14087,"_26884":121424,"_2862":122049},[],"**Entrega de webhooks.** Un enrolamiento o reenrolamiento a través de cada webhook migrado completa su llamada de autorización.",{"_3376":71236,"_29549":70981,"_20523":122051,"_5":14087,"_26884":121424,"_2862":122052},[],"**Conjunto de confianza.** `est_rfc7030_settings.client_certificate_settings.validation_cas` contiene las CAs esperadas, en particular las de la CA antigua durante los solapamientos de rotación.",{"_3376":71237,"_29549":70981,"_20523":122054,"_5":14087,"_26884":121424,"_2862":122055},[],"**Clientes de la API.** Los scripts y consolas ya no usan el formato antiguo del DMS (`additional_validation_cas` plano, o los campos heredados `mtls`, `apikey` y `oidc`), envían las actualizaciones del DMS con el ID en la URL y comparan con los nuevos valores de `type` del certificado.",{"_3376":71238,"_29549":70981,"_20523":122057,"_5":14087,"_26884":121428,"_2862":122058},[],"Solo cuando pasen todas las comprobaciones, elimina los volúmenes huérfanos de 3.8.0 para recuperar almacenamiento. El borrado es irreversible y el volumen antiguo del KMS puede contener la última copia del material de claves de tus CA, así que antes haz un `VolumeSnapshot` o una copia de seguridad de ambos PVC antiguos y consérvala hasta que confíes en que el despliegue actualizado funciona correctamente. Son los nombres fijos de 3.8.0 que anotaste en el paso 1; antes de borrarlos, confirma que ningún pod en marcha los monta, por ejemplo con `kubectl describe pvc -n $NAMESPACE golang-engine-storage-kms-0 local-crl-file-storage-va-0`, donde `Used By` debe ser `<none>`:",{"_3376":71239,"_29549":70981,"_20523":122060,"_5":14087,"_26884":121428,"_2862":122061},[],"Las bases de datos por servicio de 3.8.0 tampoco se usan ya. Elimínalas solo cuando pasen las mismas comprobaciones y tengas verificada la copia de seguridad de PostgreSQL.",{"_3376":71240,"_29549":70981,"_20523":122063,"_5":14087,"_26884":121428,"_2862":122064},[],"<Card title=\"Instalar con Helm\" description=\"Prepara las dependencias, configura los values e instala un despliegue controlado.\" href=\"/docs/deployment/self-hosted/helm\" />",{"_3376":71241,"_29549":70981,"_20523":122066,"_5":14087,"_26884":121428,"_2862":122067},[],"<Card title=\"Control de acceso\" description=\"Principales, políticas y el primer administrador.\" href=\"/docs/platform/administration/access-control\" />",{"_3376":71242,"_29549":70981,"_20523":122069,"_5":14087,"_26884":121428,"_2862":122070},[],"<Card title=\"Configurar un DMS\" description=\"Ajustes de enrolamiento, reenrolamiento y webhooks.\" href=\"/docs/platform/iot-fleets/enrollment/dms\" />",{"_57001":122072,"_57003":122073,"_57005":122074,"_57007":122075,"_17785":2897,"_68394":2897},"spanish",[2862,29549,5,26884],{"_2862":24522,"_29549":24522,"_5":24522,"_26884":24522},{"_2862":122076,"_29549":124921,"_5":127766,"_26884":130611},{"_4531":122077,"_57011":122078,"_5":24522},{"_14169":12909,"_14545":4434,"_14564":5818,"_28558":3788,"_14551":3951,"_19483":3331,"_14190":4628,"_14197":5852,"_28500":7487,"_28909":10234,"_28930":4435,"_28534":4102,"_33830":21015,"_28637":19941,"_28974":9658,"_33837":29077,"_33840":3891,"_33843":6434,"_33846":24869,"_29381":10773,"_33851":14011,"_33853":9804,"_29411":5842,"_14560":20661,"_33857":7325,"_33860":5837,"_33862":6007,"_28958":10035,"_29376":19945,"_29424":7468,"_33867":12051,"_33869":3263,"_33871":6835,"_28654":6864,"_33874":3420,"_33876":4209,"_33878":3222,"_33880":2971,"_33882":3342,"_28571":5443,"_33885":4615,"_33887":7433,"_28565":5042,"_28995":10201,"_33891":3046,"_33893":13878,"_33896":8835,"_28611":7389,"_33900":6192,"_28491":20742,"_33903":6839,"_28539":2942,"_33906":6858,"_33908":4284,"_33911":3168,"_14554":16951,"_33914":5810,"_33916":2954,"_33919":6074,"_33921":3169,"_33923":19946,"_33925":24631,"_33927":8888,"_19486":5402,"_33930":15495,"_33932":3595,"_28512":3854,"_28952":24873,"_33936":3625,"_33938":4054,"_33940":6321,"_29441":6805,"_33943":4996,"_33945":6765,"_33947":4991,"_29535":3598,